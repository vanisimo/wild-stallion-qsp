            *pl '— Слышал, в «Жеребце» девки сговорчивые, если монета звонкая, — ' + $HallLewdClientWho + '. — Кухня пустая?'
        else
            *pl '— Не первый раз тут... знаю угол у стола, — нагло ' + $HallLewdClientWho + '. — Или сегодня притворно скромничаешь?'
        end
    else
        if HallMissingRumorLine = 0:
            *pl '— Слышал, у вас девки не святые, — хрипло ' + $HallLewdClientWho + '. — В подсобку водят, как за пивом. Правда?'
        elseif HallMissingRumorLine = 1:
            *pl '— Говорят, ' + $RealName[$HallMissingGirl] + ' иногда пропадает из зала... — ' + $HallLewdClientWho + ' кивает на дверь. — Пойдём, «как все»?'
        elseif HallMissingRumorLine = 2:
            *pl '— Молва по городу: в «Диком Жеребце» можно больше, чем кружку, — ' + $HallLewdClientWho + ' звякает монетой. — Покажешь, за что слава?'
        else
            if HallMissingBargainExplicit = 1:
                *pl '— После того, что про вас шепчут, я не за элем пришёл, — прямо ' + $HallLewdClientWho + '. — Рот, руки, угол. Не ломайся.'
            else
                *pl '— Не притворяйся недотрогой, — ' + $HallLewdClientWho + '. — Уже слышал, какие у вас тут «особые» минуты за дверью.'
            end
        end
    end
    *pl ' '
