            if HallMissingBargainOffenseAnswered = 0:
                *pl '— Ах... ты прямо так сразу?.. — Аманда мгновенно заливается густым румянцем, но её глаза вспыхивают томным, бесстыдным азартом. Она с жарким вздохом прикусывает губку и оттягивает край выреза: — Идём скорее... только не ори на весь трактир, если Стефан рядом ходит! Руками трогать будешь уже там...'
            end

        ! Explicit=0 (до лица A5 / ранний интим):
        else
            if $c = 'traveler':
                *pl '— Да я только глазком гляну в твою тихую гавань... — ласково шепчет моряк. — На твою молодую грудь. Расшнуруй на пальчик, юбку не трону!'
            elseif $c = 'craftsman':
                *pl '— Да я только глазком гляну на твою молодую грудь, — ухмыляется местный. — Расшнуруй корсаж на пальчик, юбку не трону!'
            elseif $c = 'rich_merchant' or $c = 'merchant':
                *pl '— Расшнуруй вырез на пальчик — серебряный кину! — звякает монетами купец. — Только глазком гляну на твою грудь!'
            else
                *pl '— Да я только глазком гляну, — сально шепчет ' + $HallLewdClientWho + '. — На твою молодую грудь. Расшнуруй на пальчик. Юбку не трону — клянусь!'
            end
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Т-только посмотреть?.. А т-ты любишь, когда маленькие?.. — Аманда заливается румянцем, косясь на вырез.'
                    *pl '— Не маленькие, а аккуратненькие! — ухмыляется он, жадно глядя в вырез. — Как у моей первой любви...'
                    *pl '— Л-любишь, когда аккуратненькие?.. — она вспыхивает, но уже тянет его за рукав. — Шагай в подсобку... пока Стефан не заметил!'
                else
                    *pl '— Т-только посмотреть?.. Они же... маленькие, что там смотреть... — Аманда прижимает поднос к груди.'
                    *pl '— Не маленькие, — мягче, но жадно. — Аккуратненькие. Как у моей первой любви. Дай глянуть — и отпущу.'
