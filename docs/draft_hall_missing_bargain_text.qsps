#HallMissingBargainPrintAmanda_Block2
    $p = LCASE($HallMissingPromise)
    $c = LCASE($HallMissingClient)

    ! ================================================
    ! [B-AM-H0a] piggy_look: копилка / раковина / мамина
    ! ================================================
    if $p = 'piggy_look':
        if $c = 'traveler':
            *pl '— Такая молодая и красивая... — басит моряк. — Покажи укромный уголок, поможешь с моей проблемой. Покажи тихую гавань, где русалка поможет уставшему моряку, гляну на твою раковину!'
        elseif $c = 'craftsman':
            *pl '— Покажи укромный уголок, поможешь с моей проблемой! — запанибрата ремесленник. — Покажи тихий угол. Сильно ли твоя киска отличается от маминой? Просто любопытно!'
        elseif $c = 'rich_merchant' or $c = 'merchant':
            *pl '— Какая у тебя красивая копилка! — купец звякает кошельком. — Покажи укромный уголок, поможешь с моей проблемой — щедро рассчитаюсь!'
        else
            *pl '— Такая молодая и красивая... — ' + $HallLewdClientWho + '. — Покажи укромный уголок, поможешь с моей проблемой. Хочу посмотреть на твою копилку — и щедро рассчитаюсь.'
        end
        *pl ' '
        gs 'HallMissingBargainTryOffenseAnswer'
        if HallMissingBargainOffenseAnswered = 0:
            if $HallMissingInitiative = 'high':
                *pl '— В-вы так говорите... — Аманда алеет, но тянет к двери. — В подсобке... только тихо. И смотреть — не хватать сразу...'
            else
                *pl '— Ой... — Аманда вспыхивает. — Это же стыдно... Ладно... только глянуть. И никому ни слова.'
            end
        end

    ! ================================================
    ! [B-AM-H0b] piggy_cuni: губами к киске (post-mouth cuni)
    ! ================================================
    elseif $p = 'piggy_cuni':
        ! Explicit=1 (после лица A5):
        if HallMissingBargainExplicit = 1:
