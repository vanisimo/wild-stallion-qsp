# Скопируйте этот файл в .env и вставьте ваш ключ OpenRouter.
# Файл .env добавлен в .gitignore и не попадёт в Git.
# Ключ можно получить на https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Опционально: модели по умолчанию для scripts/generate_text.py
OPENROUTER_MODEL_NSFW=deepseek/deepseek-v4-pro
OPENROUTER_MODEL_DIALOG=deepseek/deepseek-v4-pro
OPENROUTER_MODEL_FAST=deepseek/deepseek-v4.1-flash
