


#InitDraupnir
    if DraupnirInitDone = 1:
        exit
    end
    DraupnirInitDone = 1

    $GuyName = 'draupnir'

    ! ====================== 1. ОСНОВНЫЕ ДАННЫЕ ======================
    $RealName[$GuyName]  = 'Драупнир'
    $RealName2[$GuyName] = 'Драупнира'
    $RealName3[$GuyName] = 'Драупниру'

    age[$GuyName] = 55
    attractiveness[$GuyName] = 45         
    ! Крепкий, но уже немолодой гном

    ! ====================== 2. ХАРАКТЕР И ИСТОРИЯ ======================
    Friends[$GuyName] = 22
    ! Отношения с другими гномами
    Reputation['dwarves'] = -35          
     ! Сильно отвергнут своими соплеменниками

    ! ====================== 3. ТЕКУЩЕЕ МЕСТОПОЛОЖЕНИЕ ======================
    $CurrentLoc[$GuyName] = 'CraftsmenQuarter'   
    ! Его столярная мастерская

    ! ====================== 4. ОПИСАНИЕ ВНЕШНОСТИ ======================
    $guytextdesc[$GuyName] = 'Драупнир — коренастый 55-летний гном с длинной, густой, уже сильно поседевшей бородой, заплетённой в несколько толстых кос. У него широкие плечи, мощные руки и суровое, изборождённое морщинами лицо. В его тёмно-серых глазах видна смесь упрямства и горечи от того, что его собственный народ отверг за "недостойную гнома" профессию столяра.'

    ! ====================== 5. НАВЫКИ ======================
    crafting[$GuyName]   = 85            
     ! Мастер-столяр
    trading[$GuyName]    = 60
    strength[$GuyName]   = 72
    charisma[$GuyName]   = 48


---

#DraupnirImportantCheck
    DraupnirImportantReady = 0
    $DraupnirImportantAction = ''

    ! 1. Накладная на партию оружия
    if PlayerHasWeaponShipmentInvoice = 1 and DraupnirBlackmailTalkDone = 0 and LOC('DraupnirBlackmailTalk') = 1:
        DraupnirImportantReady = 1
        $DraupnirImportantAction = 'blackmail'
        exit
    end

    ! 2. Разговор о штуке из сундука Сандры (с градацией)
    gs 'DraupnirGnomeDildoCalcTier'
    if DraupnirGnomeDildoAvailTier > DraupnirGnomeDildoTalkTier:
        DraupnirImportantReady = 1
        $DraupnirImportantAction = 'gnome_dildo'
        killvar 'DraupnirGnomeDildoAvailTier'
        exit
    end
    killvar 'DraupnirGnomeDildoAvailTier'

    ! 3. Визит в парадном облачении
    if StefanWearingNobleSuit = 1 and StefanNobleTourDraupnirDone = 0 and LOC('StefanNobleTourDraupnir') = 1:
        DraupnirImportantReady = 1
        $DraupnirImportantAction = 'noble_tour'
        exit
    end
---

#DraupnirRunImportantAction
    $DraupnirActionType = $ARGS[0]

    if $DraupnirActionType = 'blackmail':
        gt 'DraupnirBlackmailTalk'
    elseif $DraupnirActionType = 'gnome_dildo':
        gt 'DraupnirGnomeDildoTalk'
    elseif $DraupnirActionType = 'noble_tour':
        gt 'StefanNobleTourDraupnir'
    else:
        gt 'DraupnirShop'
    end
---

#DraupnirSmallTalk
    gt 'DraupnirTalk', 'DraupnirShop'
---

#DraupnirTalk
    $GuyName = 'draupnir'
    $DraupnirReturnLoc = $ARGS[0]

    if $DraupnirReturnLoc = '' or LOC($DraupnirReturnLoc) = 0:
        $DraupnirReturnLoc = 'DraupnirShop'
    end

    if LOC('InitDraupnir') = 1:
        gs 'InitDraupnir'
    end

    cls

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С ДРАУПНИРОМ'
    gs 'ShowImagePath', 'images/npc/town/draupnir/draupnir_talk', '', 'portrait', 'webp'

    gs 'DraupnirTalkIntroText'
    gs 'DraupnirBuildMainMenu'
    gs 'GetNpcMenuLinkHref', 'DraupnirMainMenu', 'Драупнир'

    *pl $NpcMenuLinkHref + ' встречает тебя в мастерской за рабочим столом.'
    killvar '$NpcMenuLinkHref'

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        $TmpLoc = $DraupnirReturnLoc
        killvar '$DraupnirReturnLoc'
        gt $TmpLoc
    end
---

#DraupnirBuildMainMenu
    gs 'Menu.Destroy', 'DraupnirMainMenu'
    gs 'Menu.Create', 'DraupnirMainMenu'

    gs 'DraupnirImportantCheck'
    if DraupnirImportantReady = 1:
        gs 'MenuUiAdd', 'DraupnirMainMenu', 'Важная беседа', 'important'
        gs 'Menu.AddModule', 'DraupnirMainMenu', {
            gt 'DraupnirImportantScreen', $DraupnirReturnLoc
        }
    end

    gs 'MenuUiAdd', 'DraupnirMainMenu', 'Разговор', 'talk'
    gs 'Menu.AddModule', 'DraupnirMainMenu', {
        gt 'DraupnirChatScreen', $DraupnirReturnLoc
    }

    gs 'DraupnirHasUpgradesAvailable'
    if DraupnirHasUpgradesAvailable = 1:
        gs 'MenuUiAdd', 'DraupnirMainMenu', 'Улучшения трактира', 'work'
        gs 'Menu.AddModule', 'DraupnirMainMenu', {
            gt 'DraupnirUpgradesShop'
        }
    end
    killvar 'DraupnirHasUpgradesAvailable'
---

#DraupnirImportantScreen
    $DraupnirReturnLoc = $ARGS[0]
    if $DraupnirReturnLoc = '' or LOC($DraupnirReturnLoc) = 0:
        $DraupnirReturnLoc = 'DraupnirShop'
    end

    cls
    gs 'ShowLocationScreenTitle', 'ВАЖНЫЙ РАЗГОВОР: ДРАУПНИР'
    gs 'ShowImagePath', 'images/npc/town/draupnir/draupnir_talk', '', 'portrait', 'webp'

    gs 'DraupnirBuildImportantMenu'
    gs 'GetNpcMenuLinkHref', 'DraupnirImportantMenu', 'Драупниру'

    *pl 'У тебя есть важное дело или разговор к мастеру ' + $NpcMenuLinkHref + '.'
    killvar '$NpcMenuLinkHref'

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $DraupnirReturnLoc
    end
---

#DraupnirBuildImportantMenu
    gs 'Menu.Destroy', 'DraupnirImportantMenu'
    gs 'Menu.Create', 'DraupnirImportantMenu'

    if PlayerHasWeaponShipmentInvoice = 1 and DraupnirBlackmailTalkDone = 0 and LOC('DraupnirBlackmailTalk') = 1:
        gs 'MenuUiAdd', 'DraupnirImportantMenu', 'Поговорить о накладной на оружие', 'talk'
        gs 'Menu.AddModule', 'DraupnirImportantMenu', {
            gt 'DraupnirBlackmailTalk'
        }
    end

    gs 'DraupnirGnomeDildoCalcTier'
    if DraupnirGnomeDildoAvailTier > DraupnirGnomeDildoTalkTier:
        gs 'MenuUiAdd', 'DraupnirImportantMenu', 'Спросить о штуке из сундука', 'talk'
        gs 'Menu.AddModule', 'DraupnirImportantMenu', {
            gt 'DraupnirGnomeDildoTalk', $DraupnirReturnLoc
        }
    end
    killvar 'DraupnirGnomeDildoAvailTier'

    if StefanWearingNobleSuit = 1 and StefanNobleTourDraupnirDone = 0 and LOC('StefanNobleTourDraupnir') = 1:
        gs 'MenuUiAdd', 'DraupnirImportantMenu', 'Визит в парадном облачении', 'craftsmen'
        gs 'Menu.AddModule', 'DraupnirImportantMenu', {
            gt 'StefanNobleTourDraupnir'
        }
    end
---

#DraupnirGnomeDildoCalcTier
    DraupnirGnomeDildoAvailTier = 0

    if SandraChestGnomeDildoFound <> 1:
        exit
    end

    DraupnirDildoKnows = 0
    if PlayerKnows_SandraDraupnirFriday = 1 or PlayerKnows_SandraDraupnirAffair = 1 or SandraCarpenterSecret = 1:
        DraupnirDildoKnows = 1
    end

    if DraupnirDildoKnows = 0:
        DraupnirGnomeDildoAvailTier = 1
    elseif Friends['draupnir'] >= 30 or FamilyCorruptionStage >= 3:
        DraupnirGnomeDildoAvailTier = 3
    else:
        DraupnirGnomeDildoAvailTier = 2
    end

    killvar 'DraupnirDildoKnows'
---

#DraupnirGnomeDildoTalk
    $DraupnirReturnLoc = $ARGS[0]
    if $DraupnirReturnLoc = '' or LOC($DraupnirReturnLoc) = 0:
        $DraupnirReturnLoc = 'DraupnirShop'
    end

    if LOC('InitDraupnir') = 1:
        gs 'InitDraupnir'
    end

    gs 'DraupnirGnomeDildoCalcTier'
    if DraupnirGnomeDildoAvailTier = 0:
        killvar 'DraupnirGnomeDildoAvailTier'
        gt $DraupnirReturnLoc
        exit
    end

    cls
    gs 'ShowLocationScreenTitle', 'ДРАУПНИР О ШТУКЕ ИЗ СУНДУКА'
    gs 'ShowImagePath', 'images/npc/town/draupnir/draupnir_talk', '', 'portrait', 'webp'

    gs 'DraupnirGnomeDildoTalkText', DraupnirGnomeDildoAvailTier

    if DraupnirGnomeDildoAvailTier > DraupnirGnomeDildoTalkTier:
        DraupnirGnomeDildoTalkTier = DraupnirGnomeDildoAvailTier
        if DraupnirGnomeDildoAvailTier >= 2 and Friends['draupnir'] < 45:
            Friends['draupnir'] += 1
        end
        Talked['draupnir'] += 1
    end

    killvar 'DraupnirGnomeDildoAvailTier'

    gs 'ActUiPrepare', 'Назад в мастерскую', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $DraupnirReturnLoc
    end
---

#DraupnirChatScreen
    $DraupnirReturnLoc = $ARGS[0]
    if $DraupnirReturnLoc = '' or LOC($DraupnirReturnLoc) = 0:
        $DraupnirReturnLoc = 'DraupnirShop'
    end

    cls
    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С ДРАУПНИРОМ'
    gs 'ShowImagePath', 'images/npc/town/draupnir/draupnir_talk', '', 'portrait', 'webp'

    gs 'DraupnirUnifiedTalkRun'
    *pl ' '

    gs 'UsefulTalkCheck', 'draupnir', 'draupnir_unified'
    if UsefulTalkResult = 1:
        gs 'DraupnirBuildMainMenu'
        gs 'GetNpcMenuLinkHref', 'DraupnirMainMenu', 'Драупнир'
        *pl $NpcMenuLinkHref + ' возвращается к резцу и дереву.'
        killvar '$NpcMenuLinkHref'
    else:
        *pl 'Драупнир возвращается к резцу и дереву.'
    end
    *pl ' '

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $DraupnirReturnLoc
    end
---

#DraupnirUnifiedTalkRun
    ! 1. Проверка лимита полезных разговоров
    gs 'UsefulTalkCheck', 'draupnir', 'draupnir_unified'
    if UsefulTalkResult = 0:
        gs 'DraupnirTalkLimitReachedText'
        exit
    end

    ! 2. Регистрация полезного разговора
    gs 'UsefulTalkRegister', 'draupnir', 'draupnir_unified'

    DraupnirKnowsAffairNow = 0
    if PlayerKnows_SandraDraupnirFriday = 1 or PlayerKnows_SandraDraupnirAffair = 1 or SandraCarpenterSecret = 1:
        DraupnirKnowsAffairNow = 1
    end

    ! 3. Прогрессивная иерархия тем (от бытовых бесед к личному пути, изгнанию и разговору о Сандре):
    if DraupnirDailyFirstDone = 0:
        DraupnirDailyFirstDone = 1
        gs 'DraupnirTalkSmalltalkRun'

    elseif DraupnirWorkshopFirstDone = 0:
        DraupnirWorkshopFirstDone = 1
        gs 'DraupnirTalkUpgradesRun'

    elseif DraupnirTownTalkFirstDone = 0:
        DraupnirTownTalkFirstDone = 1
        gs 'DraupnirTalkTownRun'

    elseif Friends['draupnir'] >= 25 and DraupnirPathStoryDone = 0:
        DraupnirPathStoryDone = 1
        gs 'DraupnirTalkPathRun'

    elseif Friends['draupnir'] >= 27 and DraupnirClanStoryDone = 0:
        DraupnirClanStoryDone = 1
        gs 'DraupnirTalkClanRun'

    elseif (Friends['draupnir'] >= 29 or DraupnirKnowsAffairNow = 1) and DraupnirSandraTalkFirstDone = 0:
        DraupnirSandraTalkFirstDone = 1
        if DraupnirKnowsAffairNow = 1:
            DraupnirSandraOpenTalkDone = 1
        end
        gs 'DraupnirTalkSandraRun'

    elseif DraupnirKnowsAffairNow = 1 and DraupnirSandraOpenTalkDone = 0:
        DraupnirSandraOpenTalkDone = 1
        gs 'DraupnirTalkSandraRun'

    ! 4. Циклическая ротация открытых тем (6 уровней)
    else:
        if DraupnirLorePoolCycle = 0:
            gs 'DraupnirTalkSmalltalkRun'
        elseif DraupnirLorePoolCycle = 1:
            gs 'DraupnirTalkUpgradesRun'
        elseif DraupnirLorePoolCycle = 2:
            gs 'DraupnirTalkTownRun'
        elseif DraupnirLorePoolCycle = 3:
            if Friends['draupnir'] >= 25:
                gs 'DraupnirTalkPathRun'
            else:
                DraupnirLorePoolCycle = 0
                gs 'DraupnirTalkSmalltalkRun'
            end
        elseif DraupnirLorePoolCycle = 4:
            if Friends['draupnir'] >= 27:
                gs 'DraupnirTalkClanRun'
            else:
                DraupnirLorePoolCycle = 0
                gs 'DraupnirTalkSmalltalkRun'
            end
        else:
            if Friends['draupnir'] >= 29 or DraupnirKnowsAffairNow = 1:
                gs 'DraupnirTalkSandraRun'
            else:
                DraupnirLorePoolCycle = 0
                gs 'DraupnirTalkSmalltalkRun'
            end
        end

        DraupnirLorePoolCycle += 1
        if DraupnirLorePoolCycle > 5:
            DraupnirLorePoolCycle = 0
        end
    end

    killvar 'DraupnirKnowsAffairNow'
---

#DraupnirTalkSmalltalkRun
    gs 'DraupnirTalkDailyText', DraupnirTopicVar['daily']
    DraupnirTopicVar['daily'] = 1 - DraupnirTopicVar['daily']
    if Friends['draupnir'] < 45:
        Friends['draupnir'] += 1
    end
    Talked['draupnir'] += 1
---

#DraupnirTalkUpgradesRun
    gs 'DraupnirTalkWorkshopText', DraupnirTopicVar['workshop']
    DraupnirTopicVar['workshop'] = 1 - DraupnirTopicVar['workshop']
    if Friends['draupnir'] < 45:
        Friends['draupnir'] += 1
    end
    Talked['draupnir'] += 1
---

#DraupnirTalkTownRun
    gs 'DraupnirTalkTradeText', DraupnirTopicVar['trade']
    DraupnirTopicVar['trade'] = 1 - DraupnirTopicVar['trade']
    if Friends['draupnir'] < 25:
        Friends['draupnir'] += 2
    elseif Friends['draupnir'] < 45:
        Friends['draupnir'] += 1
    end
    Talked['draupnir'] += 1
---

#DraupnirTalkPathRun
    gs 'DraupnirTalkPathText', DraupnirTopicVar['path']
    DraupnirTopicVar['path'] = 1 - DraupnirTopicVar['path']
    if Friends['draupnir'] < 45:
        Friends['draupnir'] += 2
    end
    Talked['draupnir'] += 1
---

#DraupnirTalkClanRun
    gs 'DraupnirTalkExileText', DraupnirTopicVar['clan']
    DraupnirTopicVar['clan'] = 1 - DraupnirTopicVar['clan']
    if Friends['draupnir'] < 45:
        Friends['draupnir'] += 2
    end
    Talked['draupnir'] += 1
---

#DraupnirTalkSandraRun
    gs 'DraupnirTalkSandraText', DraupnirTopicVar['sandra']
    DraupnirTopicVar['sandra'] = 1 - DraupnirTopicVar['sandra']
    if Friends['draupnir'] < 45:
        Friends['draupnir'] += 2
    end
    Talked['draupnir'] += 1
---
