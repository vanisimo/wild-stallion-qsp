! ================================================
! FILE: modules/npc/amanda/dance.qsps
! Танец с Амандой на пятничной рыночной площади
! Версия: FridayDance v4 / legacy gates
! Назначение:
! - танец -> талия -> попа -> сжать -> поцелуй -> подворотня (после HomeStage >= 1)
! - поболтать, отказ и обида по отношениям
!
! Тексты:
! modules/npc/amanda/amanda_dance_text.qsps
! ================================================

#AmandaDance
    *clr
    clr
    cla

    $AmandaDanceGirl = 'amanda'

    gs 'EnsureGirlData', $AmandaDanceGirl

    if $RealName[$AmandaDanceGirl] = '':
        $RealName[$AmandaDanceGirl] = 'Аманда'
    end

    if AmandaDanceDay <> day:
        gs 'AmandaDanceReset'
    end

    if AmandaDanceDressReady = 0:
        gt 'FridayDanceSisterLimited', 'amanda'
    end

    if AmandaDanceBlockedTonight = 1 and AmandaDanceEnded = 0:
        AmandaDanceEnded = 1
    end

    if LOC('ShowImage') = 1:
        gs 'ShowImage', 'amanda', 'dance', 'dance', 'normal'
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ТАНЕЦ С АМАНДОЙ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaDanceMainText') = 1:
        gs 'AmandaDanceMainText'
    else:
        if $AmandaDanceLastText <> '':
            *p $AmandaDanceLastText
        elseif AmandaDanceStage = 0:
            *p 'Аманда стоит у края площади и смотрит на танцующих.'
        else:
            *p 'Вы танцуете с Амандой на рыночной площади.'
        end
    end

    *pl ' '

    if debug = 1:
        *pl '[DEBUG AMANDA DANCE] Stage: ' + STR(AmandaDanceStage)
        *pl '[DEBUG AMANDA DANCE] BlockedTonight: ' + STR(AmandaDanceBlockedTonight)
        *pl '[DEBUG AMANDA DANCE] HomeStage: ' + STR(AmandaHomeStage)
        *pl ' '
    end

    if AmandaDanceEnded = 1:
        *p 'Танец с Амандой на сегодня уже закончен.'
        *pl ' '

        gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MarketDance'
        end

        exit
    end

    gs 'AmandaDanceBuildMenu'

    *p 'Что вы будете <a href="exec:gs ''Menu.Show'', ''AmandaDanceMenu''">делать</a>?'
---

#AmandaDanceReset
    AmandaDanceDay = day

    AmandaDanceStage = 0
    AmandaDanceStep = 0
    AmandaDanceEnded = 0

    AmandaDanceWaist = 0
    AmandaDanceAss = 0
    AmandaDanceAssGrip = 0
    AmandaDanceKiss = 0
    AmandaDanceAlley = 0

    AmandaDancePublicRisk = 0
    AmandaDanceMaxStep = 6

    $AmandaDanceHandPosition = ''
    $AmandaDanceLastText = ''
---

#AmandaDanceOffend
    AmandaDanceEnded = 1
    AmandaDanceBlockedTonight = 1
    AmandaRebellion += 1

    if Friends['amanda'] > 0:
        Friends['amanda'] -= 1
    end

    gs 'ClampGirlSocialStats', 'amanda'
---

#AmandaDanceBuildMenu
    gs 'Menu.Destroy', 'AmandaDanceMenu'
    gs 'Menu.Create', 'AmandaDanceMenu'

    if AmandaDanceStage = 0:
        gs 'MenuUiAdd', 'AmandaDanceMenu', 'Танец', ''
        gs 'Menu.AddModule', 'AmandaDanceMenu', {
            gt 'AmandaDanceAction', 'dance'
        }

        gs 'MenuUiAdd', 'AmandaDanceMenu', 'Поболтать', ''
        gs 'Menu.AddModule', 'AmandaDanceMenu', {
            gt 'AmandaDanceAction', 'talk'
        }
    else:
        gs 'MenuUiAdd', 'AmandaDanceMenu', 'Танец', ''
        gs 'Menu.AddModule', 'AmandaDanceMenu', {
            gt 'AmandaDanceAction', 'continue'
        }
    end

    if AmandaDanceStage >= 1 and AmandaDanceWaist = 0:
        gs 'MenuUiAdd', 'AmandaDanceMenu', 'Талия', ''
        gs 'Menu.AddModule', 'AmandaDanceMenu', {
            gt 'AmandaDanceAction', 'waist'
        }
    end

    if AmandaDanceWaist = 1 and AmandaDanceAss = 0:
        gs 'MenuUiAdd', 'AmandaDanceMenu', 'Попа', ''
        gs 'Menu.AddModule', 'AmandaDanceMenu', {
            gt 'AmandaDanceAction', 'ass'
        }
    end

    if AmandaDanceAss = 1 and AmandaDanceAssGrip = 0:
        gs 'MenuUiAdd', 'AmandaDanceMenu', 'Сжать попу', ''
        gs 'Menu.AddModule', 'AmandaDanceMenu', {
            gt 'AmandaDanceAction', 'grip'
        }
    end

    if AmandaDanceAssGrip = 1 and AmandaDanceKiss = 0:
        gs 'MenuUiAdd', 'AmandaDanceMenu', 'Поцелуй', ''
        gs 'Menu.AddModule', 'AmandaDanceMenu', {
            gt 'AmandaDanceAction', 'kiss'
        }
    end

    if AmandaDanceKiss = 1 and AmandaDanceAlley = 0 and AmandaHomeStage >= 1:
        gs 'AmandaDanceAlleyCanOffer'

        if AmandaDanceAlleyCanOffer = 1:
            gs 'MenuUiAdd', 'AmandaDanceMenu', 'Подворотня', ''
            gs 'Menu.AddModule', 'AmandaDanceMenu', {
                gt 'AmandaDanceAction', 'alley'
            }
        end

        killvar 'AmandaDanceAlleyCanOffer'
    end

    gs 'MenuUiAdd', 'AmandaDanceMenu', 'Закончить танец', ''
    gs 'Menu.AddModule', 'AmandaDanceMenu', {
        AmandaDanceEnded = 1
        gt 'MarketDance'
    }
---

#AmandaDanceAction
    $AmandaDanceAction = LCASE($ARGS[0])
    $AmandaDanceGirl = 'amanda'

    gs 'EnsureGirlData', $AmandaDanceGirl

    if $RealName[$AmandaDanceGirl] = '':
        $RealName[$AmandaDanceGirl] = 'Аманда'
    end

    if $AmandaDanceAction = 'talk':
        AmandaDanceEnded = 1

        if Friends[$AmandaDanceGirl] >= 7:
            $AmandaDanceLastText = 'Вы болтаете с Амандой о ерунде. Она слушает вежливо, но явно ждёт, когда музыка снова зазовёт её в круг.'
        else
            if RAND(1, 3) = 1:
                Friends[$AmandaDanceGirl] += 1
                $AmandaDanceLastText = 'Пустой разговор всё же сблизил вас — Аманда улыбается чуть теплее обычного.'
            else
                $AmandaDanceLastText = 'Вы болтаете с Амандой о пустяках. Весело, но ничего нового она вам не рассказала.'
            end
        end

        gs 'ClampGirlSocialStats', $AmandaDanceGirl
        killvar '$AmandaDanceAction'
        gt 'AmandaDance'
    end

    if $AmandaDanceAction = 'dance':
        if Friends[$AmandaDanceGirl] >= 8 and sluttiness[$AmandaDanceGirl] > 15:
            AmandaDanceStage = 1
            AmandaDanceStep = 1
            Friends[$AmandaDanceGirl] += 1
            AmandaPublicAttention += 1
            AmandaPlayerPath += 1
            $AmandaDanceLastText = 'Аманда с радостью принимает вашу руку, и вы вскоре закружились в танце.'
        elseif Friends[$AmandaDanceGirl] >= 5 and sluttiness[$AmandaDanceGirl] >= 5:
            AmandaDanceStage = 1
            AmandaDanceStep = 1
            Friends[$AmandaDanceGirl] += 1
            AmandaPublicAttention += 1
            AmandaPlayerPath += 1
            $AmandaDanceLastText = '«Ты же брат, зачем мне с тобой танцевать?» — но она всё-таки берёт вашу руку и вскоре кружится с вами.'
        else
            AmandaDanceEnded = 1
            $AmandaDanceLastText = '«Ты что, сдурел?!» — Аманда отступает. Расстроенный отказом, вы остаётесь у колоннады один.'
        end

    elseif $AmandaDanceAction = 'continue':
        AmandaDanceStep += 1

        if AmandaDanceStep > AmandaDanceMaxStep:
            AmandaDanceStep = AmandaDanceMaxStep
        end

        AmandaPublicAttention += 1
        $AmandaDanceLastText = 'Вы продолжаете кружиться в танце с Амандой.'

    elseif $AmandaDanceAction = 'waist':
        if Friends[$AmandaDanceGirl] >= 6 and sluttiness[$AmandaDanceGirl] > 10:
            AmandaDanceStage = 2
            AmandaDanceStep = 2
            AmandaDanceWaist = 1
            $AmandaDanceHandPosition = 'waist'
            Friends[$AmandaDanceGirl] += 1
            otkroven[$AmandaDanceGirl] += 1
            AmandaPublicAttention += 1
            $AmandaDanceLastText = 'Аманда улыбается и придвигается ближе, продолжая танец.'
        elseif Friends[$AmandaDanceGirl] >= 5 and sluttiness[$AmandaDanceGirl] >= 6:
            AmandaDanceStage = 2
            AmandaDanceStep = 2
            AmandaDanceWaist = 1
            $AmandaDanceHandPosition = 'waist'
            Friends[$AmandaDanceGirl] += 1
            otkroven[$AmandaDanceGirl] += 1
            AmandaPublicAttention += 1
            $AmandaDanceLastText = 'Аманда поморщилась, но возражать не стала.'
        else
            gs 'AmandaDanceOffend'
            $AmandaDanceLastText = '«Стефан, что ты такое делаешь?!» — кричит Аманда и уходит, оставив вас одного.'
        end

    elseif $AmandaDanceAction = 'ass':
        if Friends[$AmandaDanceGirl] >= 7 and sluttiness[$AmandaDanceGirl] > 18:
            AmandaDanceStage = 3
            AmandaDanceStep = 3
            AmandaDanceAss = 1
            $AmandaDanceHandPosition = 'ass'
            otkroven[$AmandaDanceGirl] += 1
            sluttiness[$AmandaDanceGirl] += 1
            AmandaPublicAttention += 1
            AmandaDancePublicRisk += 1
            $AmandaDanceLastText = 'Аманда улыбается и не убирает ваших рук.'
        elseif Friends[$AmandaDanceGirl] >= 6 and sluttiness[$AmandaDanceGirl] >= 12:
            AmandaDanceStage = 3
            AmandaDanceStep = 3
            AmandaDanceAss = 1
            $AmandaDanceHandPosition = 'ass'
            otkroven[$AmandaDanceGirl] += 1
            sluttiness[$AmandaDanceGirl] += 1
            AmandaPublicAttention += 1
            AmandaDancePublicRisk += 1
            $AmandaDanceLastText = '«Стефан, что ты делаешь?!» — шепчет она, но танцевать не перестаёт.'
        elseif Friends[$AmandaDanceGirl] >= 5 and sluttiness[$AmandaDanceGirl] >= 9:
            AmandaDanceStep += 1
            $AmandaDanceHandPosition = 'waist'
            otkroven[$AmandaDanceGirl] += 1
            $AmandaDanceLastText = '«Стефан, что ты делаешь?!» — Аманда передвигает ваши руки обратно на талию.'
        else
            gs 'AmandaDanceOffend'
            $AmandaDanceLastText = '«Я твоя сестра!» — Аманда даёт вам пощечину и уходит.'
        end

    elseif $AmandaDanceAction = 'grip':
        if Friends[$AmandaDanceGirl] >= 10 and sluttiness[$AmandaDanceGirl] > 20:
            AmandaDanceStage = 4
            AmandaDanceStep = 4
            AmandaDanceAssGrip = 1
            $AmandaDanceHandPosition = 'ass2'
            otkroven[$AmandaDanceGirl] += 1
            sluttiness[$AmandaDanceGirl] += 1
            AmandaPublicAttention += 1
            AmandaDancePublicRisk += 1
            $AmandaDanceLastText = 'Аманда прижимается ближе и не останавливает вас.'
        elseif Friends[$AmandaDanceGirl] >= 8 and sluttiness[$AmandaDanceGirl] >= 16:
            AmandaDanceStage = 4
            AmandaDanceStep = 4
            AmandaDanceAssGrip = 1
            $AmandaDanceHandPosition = 'ass2'
            otkroven[$AmandaDanceGirl] += 1
            sluttiness[$AmandaDanceGirl] += 1
            AmandaPublicAttention += 1
            AmandaDancePublicRisk += 1
            $AmandaDanceLastText = '«Стефанчик, мы же брат и сестра…» — шепчет она, но не отстраняется.'
        elseif Friends[$AmandaDanceGirl] >= 7 and sluttiness[$AmandaDanceGirl] >= 13:
            AmandaDanceStep += 1
            $AmandaDanceHandPosition = 'waist'
            $AmandaDanceLastText = '«Стефан, что ты делаешь?!» — Аманда возвращает ваши руки на талию.'
        else
            gs 'AmandaDanceOffend'
            $AmandaDanceLastText = '«Я твоя сестра!» — пощечина, и Аманда уходит с площади.'
        end

    elseif $AmandaDanceAction = 'kiss':
        if Friends[$AmandaDanceGirl] >= 10 and sluttiness[$AmandaDanceGirl] > 21:
            AmandaDanceStage = 5
            AmandaDanceStep = 5
            AmandaDanceKiss = 1
            love[$AmandaDanceGirl] += 1
            otkroven[$AmandaDanceGirl] += 1
            AmandaPlayerPath += 1
            AmandaPublicAttention += 1
            AmandaDancePublicRisk += 1
            $AmandaDanceLastText = 'Аманда страстно отвечает на поцелуй, едва не сбиваясь с ритма.'
        elseif Friends[$AmandaDanceGirl] >= 8 and sluttiness[$AmandaDanceGirl] >= 16:
            AmandaDanceStage = 5
            AmandaDanceStep = 5
            AmandaDanceKiss = 1
            love[$AmandaDanceGirl] += 1
            otkroven[$AmandaDanceGirl] += 1
            AmandaPlayerPath += 1
            AmandaPublicAttention += 1
            AmandaDancePublicRisk += 1
            $AmandaDanceLastText = 'Аманда откликается на поцелуй без особого энтузиазма, но не отстраняется.'
        elseif Friends[$AmandaDanceGirl] >= 7 and sluttiness[$AmandaDanceGirl] >= 13:
            AmandaDanceStep += 1
            $AmandaDanceLastText = '«Стефанчик, я же твоя сестра!» — Аманда отстраняется.'
        else
            gs 'AmandaDanceOffend'
            $AmandaDanceLastText = '«Я твоя сестра!» — пощечина, и Аманда уходит.'
        end

    elseif $AmandaDanceAction = 'alley':
        AmandaDanceStage = 6
        AmandaDanceStep = 6
        AmandaDanceAlley = 1
        AmandaDanceEnded = 1

        AmandaPlayerPath += 1
        AmandaSecretiveness += 1
        AmandaScandalLevel += 1

        gs 'ClampGirlSocialStats', $AmandaDanceGirl
        killvar '$AmandaDanceAction'
        gt 'AmandaDanceAlleyIntro'

    else:
        AmandaDanceStep += 1
    end

    gs 'ClampGirlSocialStats', $AmandaDanceGirl

    if LOC('AmandaDanceActionText') = 1 and $AmandaDanceAction <> 'dance' and $AmandaDanceAction <> 'talk' and $AmandaDanceAction <> 'continue' and $AmandaDanceAction <> 'waist' and $AmandaDanceAction <> 'ass' and $AmandaDanceAction <> 'grip' and $AmandaDanceAction <> 'kiss':
        gs 'AmandaDanceActionText', $AmandaDanceAction
    end

    killvar '$AmandaDanceAction'

    gt 'AmandaDance'
---

#AmandaDanceAlleyIntro
    *clr
    clr
    cla

    if LOC('ShowImage') = 1:
        gs 'ShowImage', 'amanda', 'dance', 'alley', 'intro'
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ПОДВОРОТНЯ У ПЛОЩАДИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaDanceAlleyText') = 1:
        gs 'AmandaDanceAlleyText'
    else:
        *p 'Вы уводите Аманду с шумной площади к тёмному проходу между домами.'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Продолжить в подворотне', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaDanceAlleyEvent'
    end

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---