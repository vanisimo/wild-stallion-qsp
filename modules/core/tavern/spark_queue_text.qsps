! ================================================
! FILE: modules/core/tavern/spark_queue_text.qsps
! MODULE: core/tavern
! Тексты очереди искр
! ================================================

#SparkQueueHallNoticeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $SparkQueueNoticeGirl = $GirlKey

    gs 'EnsureGirlData', $SparkQueueNoticeGirl

    if $SparkQueueNoticeGirl = 'amanda':
        $SparkQueueHallNotice = 'У стойки шумнее обычного: Аманда с подносом, рядом чужие руки. Стоит пройтись взглядом по залу.'
    elseif $SparkQueueNoticeGirl = 'melissa':
        $SparkQueueHallNotice = 'Мелисса за столом дольше, чем нужно, смех нервный. Похоже, там не просто заказ — стоит присмотреться.'
    else:
        $SparkQueueHallNotice = 'В зале что-то назревает у ' + $RealName[$SparkQueueNoticeGirl] + '. Стоит осмотреть зал.'
    end

    killvar '$SparkQueueNoticeGirl'
---

#SparkQueueKitchenNoticeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $SparkQueueNoticeGirl = $GirlKey

    gs 'EnsureGirlData', $SparkQueueNoticeGirl

    if $SparkQueueNoticeGirl = 'sandra':
        $SparkQueueKitchenNotice = 'С кухни доносится чужой мужской голос — громче, чем надо. Стоит заглянуть.'
    else:
        $SparkQueueKitchenNotice = 'С кухни доносится слишком громкий смех. Стоит осмотреть кухню.'
    end

    killvar '$SparkQueueNoticeGirl'
---