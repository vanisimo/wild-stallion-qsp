! ================================================
! FILE: modules/core/tavern/spark_queue_text.qsps
! MODULE: core/tavern
! Тексты очереди искр
! ================================================

#SparkQueueHallNoticeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $SparkQueueNoticeGirl = $GirlKey

    gs 'EnsureGirlData', $SparkQueueNoticeGirl

    if $SparkQueueNoticeGirl = 'amanda':
        $SparkQueueHallNotice = 'Аманда подносит поднос у стойки — и к ней снова лезут. Вы это не видели в момент, но зал уже запомнил.'
    elseif $SparkQueueNoticeGirl = 'melissa':
        $SparkQueueHallNotice = 'Мелисса задержалась у стола дольше, чем нужно. Смех слишком нервный — похоже, приставание не кончилось, пока вас не было.'
    else:
        $SparkQueueHallNotice = 'В зале что-то назревает: к ' + $RealName[$SparkQueueNoticeGirl] + ' пристают, пока вы не смотрите.'
    end

    killvar '$SparkQueueNoticeGirl'
---

#SparkQueueKitchenNoticeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $SparkQueueNoticeGirl = $GirlKey

    gs 'EnsureGirlData', $SparkQueueNoticeGirl

    if $SparkQueueNoticeGirl = 'sandra':
        $SparkQueueKitchenNotice = 'С кухни доносится слишком громкий голос мужчины. Сандра там одна — или почти одна. Похоже, неприятность не уладилась без вас.'
    else:
        $SparkQueueKitchenNotice = 'С кухни доносится слишком громкий смех. Похоже, ' + $RealName[$SparkQueueNoticeGirl] + ' снова влипла.'
    end

    killvar '$SparkQueueNoticeGirl'
---