! ================================================
! FILE: modules/core/tavern/spark_queue_text.qsps
! MODULE: core/tavern
! Тексты очереди искр
! ================================================

#SparkQueueHallNoticeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $SparkQueueNoticeGirl = $GirlKey
    gs 'EnsureGirlData', $SparkQueueNoticeGirl

    if $SparkQueueNoticeGirl = 'amanda':
        if FamilyCorruptionStage <= 1:
            $SparkQueueHallNotice = 'У стойки шумнее обычного: Аманда с подносом пытается увернуться от чужих рук. Похоже, ей нужна помощь брата.'
        elseif FamilyCorruptionStage <= 3:
            $SparkQueueHallNotice = 'Аманда звонко хохочет у стола. Клиент держит её за руку, а она и не думает её убирать — только вырез поправляет. Стоит глянуть.'
        else:
            $SparkQueueHallNotice = 'Аманда буквально прилипла к клиенту, шепча что-то ему на ухо. По залу вовсю гуляют слухи, а она только подмигивает тебе. Что там творится?'
        end
    elseif $SparkQueueNoticeGirl = 'melissa':
        if FamilyCorruptionStage <= 1:
            $SparkQueueHallNotice = 'Мелисса за столом дольше, чем нужно. Взгляд холодный, но клиент явно не понимает намёков. Стоит вмешаться, пока она не вылила на него вино.'
        elseif FamilyCorruptionStage <= 3:
            $SparkQueueHallNotice = 'Мелисса сдержанно улыбается гостю, позволяя ему поглаживать свою ладонь. Она явно ведёт свою игру. Стоит присмотреться.'
        else:
            $SparkQueueHallNotice = 'Мелисса спокойно стоит рядом с подвыпившим лордом, пока его рука смело исследует её бедро. Она лишь бросает на тебя короткий, оценивающий взгляд.'
        end
    else:
        $SparkQueueHallNotice = 'В зале что-то назревает у ' + $RealName[$SparkQueueNoticeGirl] + '. Стоит осмотреть зал.'
    end

    killvar '$SparkQueueNoticeGirl'
---

#SparkQueueKitchenNoticeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $SparkQueueNoticeGirl = $GirlKey
    gs 'EnsureGirlData', $SparkQueueNoticeGirl

    if $SparkQueueNoticeGirl = 'sandra':
        if FamilyCorruptionStage <= 1:
            $SparkQueueKitchenNotice = 'С кухни доносится наглый мужской голос. Мать отвечает резко, но гость не уходит. Стоит проверить, не зашёл ли кто лишний.'
        elseif FamilyCorruptionStage <= 3:
            $SparkQueueKitchenNotice = 'С кухни слышны приглушённые голоса и смех. Мать о чем-то доверительно беседует с кем-то из города. Подозрительно тихо...'
        else:
            $SparkQueueKitchenNotice = 'На кухне вовсю хозяйничает чужак, а мать лишь негромко вскрикивает, когда его руки находят цель. Дверь прикрыта, но не заперта.'
        end
    else:
        $SparkQueueKitchenNotice = 'С кухни доносится слишком громкий смех. Стоит осмотреть кухню.'
    end

    killvar '$SparkQueueNoticeGirl'
---