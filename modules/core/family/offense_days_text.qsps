! ================================================
! FILE: modules/core/family/offense_days_text.qsps
! MODULE: core/family
! Тексты обида-дней v7 (короткие реплики, Стефан на «ты»)
! ================================================

#OffenseDaysSoftMismatchNotice
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey
    $OffenseNoticeKind = LCASE($ARGS[1])
    OffenseNoticeCount = ARGS[2]

    if $RealName[$OffenseGirl] = '':
        $RealName[$OffenseGirl] = $OffenseGirl
    end

    if $OffenseNoticeKind = 'no_protect_low':
        $GirlTalkPendingNotice[$OffenseGirl] = $RealName[$OffenseGirl] + ' тихо вздыхает: «Опять ты за своё...»'
    elseif $OffenseNoticeKind = 'protect_high':
        $GirlTalkPendingNotice[$OffenseGirl] = $RealName[$OffenseGirl] + ' прищуривается: «Ну что, рыцарь, опять в доспехах?»'
    elseif $OffenseNoticeKind = 'policy_mismatch':
        $GirlTalkPendingNotice[$OffenseGirl] = $RealName[$OffenseGirl] + ' хлопает в ладоши: «У нас таверна или монастырь, Стефан?»'
    end

    killvar '$OffenseGirl'
    killvar '$OffenseNoticeKind'
    killvar 'OffenseNoticeCount'
---

#OffenseDaysTalkIntroText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey
    $OffenseReason = GirlOffenseReason[$OffenseGirl]

    if $OffenseReason = 'no_protect_low':
        *pl 'Ты ловишь её взгляд: «Ну ты чего, даже не смотришь?»'
        *pl $RealName[$OffenseGirl] + ' смотрит в потолок: «На что? На защитника? Когда в зале заварилось, ты слился с бочками. Обидно...»'
    elseif $OffenseReason = 'protect_high':
        *pl 'Ты разводишь руками: «Я же просто помочь хотел...»'
        *pl $RealName[$OffenseGirl] + ' закатывает глаза: «Помочь! Ты бы ещё латы на меня нацепил. Дай мне самой сдачи дать!»'
    elseif $OffenseReason = 'policy_mismatch':
        *pl 'Ты чешешь затылок: «Правила же для блага таверны...»'
        *pl $RealName[$OffenseGirl] + ' фыркает: «Для блага? Мы семья, а не ростовщики. Смягчай указы, бургомистр».'
    elseif $OffenseReason = 'intercept':
        *pl 'Ты оправдываешься: «Я просто мимо шёл, вижу — непорядок...»'
        *pl $RealName[$OffenseGirl] + ' качает головой: «Мимо! Влетел, будто конница за тобой. Хватит геройствовать без повода».'
    elseif $OffenseReason = 'ban_guys':
        *pl 'Ты садишься ближе: «Ну и почему молчим?»'
        *pl 'Аманда хмыкает: «Запретить мне говорить с парнями — гениально. Я думала, ты доверяешь».'
    elseif $OffenseReason = 'ban_minstrel':
        *pl 'Ты заглядываешь ей в лицо: «Мелисса, из-за музыканта ссориться...»'
        *pl 'Мелисса поднимает бровь: «Он поёт за кружку эля, а ты устроил светопреставление. И смешно, и обидно».'
    elseif $OffenseReason = 'ban_lizette':
        *pl 'Ты мягко качаешь головой: «Лизетта на тебя плохо влияет».'
        *pl 'Аманда всплескивает руками: «Плохо?! Мы пироги с очага таскаем. Верни мне подругу, Стефан!»'
    elseif $OffenseReason = 'daughter_no_protect':
        *pl 'Ты топчешься у двери: «Сандра, ну чего так строго?»'
        *pl 'Сандра качает головой: «Девочек в зале обижают, а защитник прячется за бочками. Не стыдно?»'
    else
        *pl 'Ты виновато улыбаешься: «Ну ладно тебе, давай мириться?»'
        *pl $RealName[$OffenseGirl] + ' отворачивается к окну, но плечи выдают: скоро оттает.'
    end

    killvar '$OffenseGirl'
    killvar '$OffenseReason'
---

#OffenseDaysTalkApologizeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    if GirlOffenseDays[$OffenseGirl] > 1:
        *pl 'Ты поднимаешь руки: «Каюсь. Был не прав. Простишь?»'
        *pl $RealName[$OffenseGirl] + ' прыскает: «Ладно, отпущение есть. Но я ещё чуть дуюсь — с тебя сбитень!»'
    else
        *pl 'Ты обнимаешь её за плечи: «Сдаюсь. Мир?»'
        *pl $RealName[$OffenseGirl] + ' утыкается тебе в плечо: «Ох... Как на тебя долго злиться? Иди сюда».'
    end

    killvar '$OffenseGirl'
---

#OffenseDaysTalkRightText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    *pl 'Ты упрямо: «Я всё равно считаю, что поступил правильно».'
    *pl $RealName[$OffenseGirl] + ' смотрит выразительно: «Ну конечно. Стой на своём, мудрец. Спорить сейчас бессмысленно».'
    *pl 'Она уходит. Между вами остаётся неловкая тишина.'

    killvar '$OffenseGirl'
---

#OffenseDaysTalkGiftCheapText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    *pl 'Ты протягиваешь небольшой подарок: «Дань, чтоб междоусобицы не было».'
    *pl $RealName[$OffenseGirl] + ' крутит его в руках: «Подкуп? Хм... Ладно, приняла. Приговор смягчим».'

    killvar '$OffenseGirl'
---

#OffenseDaysTalkGiftExpensiveText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    *pl 'Ты вручаешь коробочку: «Выкуп за вину».'
    *pl $RealName[$OffenseGirl] + ' округляет глаза: «Ого... Должна бы дуться, да не выходит!» Она смеётся: «Прощён. И способ мне нравится».'

    killvar '$OffenseGirl'
---

#OffenseDaysTalkClearText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    *pl 'Ты протягиваешь кувшин: «Разобьём раздор и помиримся?»'
    *pl $RealName[$OffenseGirl] + ' толкает тебя локтем: «Мир. Но ещё раз — сама не ручаюсь. Пошли пирог резать».'

    killvar '$OffenseGirl'
---
