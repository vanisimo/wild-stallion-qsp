! ================================================
! FILE: modules/core/family/offense_days_text.qsps
! MODULE: core/family
! Тексты обида-дней v7 (короткие реплики, Стефан на «ты»)
! ================================================

#OffenseDaysSoftMismatchNotice
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseNoticeGirl = $GirlKey
    $OffenseNoticeKind = LCASE($ARGS[1])
    OffenseNoticeCount = ARGS[2]

    if $OffenseNoticeGirl = '':
        killvar '$OffenseNoticeGirl'
        killvar '$OffenseNoticeKind'
        killvar 'OffenseNoticeCount'
        exit
    end

    if $RealName[$OffenseNoticeGirl] = '':
        $RealName[$OffenseNoticeGirl] = $OffenseNoticeGirl
    end

    if $OffenseNoticeKind = 'no_protect_low':
        $GirlTalkPendingNotice[$OffenseNoticeGirl] = $RealName[$OffenseNoticeGirl] + ' тихо вздыхает: «Опять ты за своё...»'
    elseif $OffenseNoticeKind = 'protect_high':
        $GirlTalkPendingNotice[$OffenseNoticeGirl] = $RealName[$OffenseNoticeGirl] + ' прищуривается: «Ну что, рыцарь, опять в доспехах?»'
    elseif $OffenseNoticeKind = 'policy_mismatch':
        $GirlTalkPendingNotice[$OffenseNoticeGirl] = $RealName[$OffenseNoticeGirl] + ' хлопает в ладоши: «У нас таверна или монастырь, Стефан?»'
    end

    ! полная обида — короткий якорь; полные реплики рисует OffenseDaysPrintSceneReaction
    if GirlOffenseDays[$OffenseNoticeGirl] > 0 and OffenseNoticeCount >= 3:
        $GirlTalkPendingNotice[$OffenseNoticeGirl] = ''
    end

    killvar '$OffenseNoticeGirl'
    killvar '$OffenseNoticeKind'
    killvar 'OffenseNoticeCount'
---

! ================================================
! Реакция на экране после harass / в начале talk:
! холод + (если был секс) отказ от близости
! ================================================

#OffenseDaysHasIntimateHistory
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseIntimGirl = $GirlKey
    OffenseDaysHasIntimate = 0

    if $OffenseIntimGirl = 'amanda':
        if AmandaHomeSex = 1 or IntimStage['amanda'] >= 3 or sexacts['amanda'] > 0:
            OffenseDaysHasIntimate = 1
        end
    elseif $OffenseIntimGirl = 'melissa':
        if MelissaHomeSex = 1 or IntimStage['melissa'] >= 3 or sexacts['melissa'] > 0:
            OffenseDaysHasIntimate = 1
        end
    elseif $OffenseIntimGirl = 'sandra':
        if SandraHomeSex = 1 or IntimStage['sandra'] >= 3 or sexacts['sandra'] > 0:
            OffenseDaysHasIntimate = 1
        end
    end

    killvar '$OffenseIntimGirl'
---

#OffenseDaysPrintSceneReaction
    ! ARGS[0] girl — полная обида (days>0) на after-screen / talk
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseSceneGirl = $GirlKey

    if $OffenseSceneGirl = '':
        killvar '$OffenseSceneGirl'
        exit
    end

    if GirlOffenseDays[$OffenseSceneGirl] <= 0:
        killvar '$OffenseSceneGirl'
        exit
    end

    if $RealName[$OffenseSceneGirl] = '':
        gs 'EnsureGirlData', $OffenseSceneGirl
    end

    *pl ' '

    if $OffenseSceneGirl = 'amanda':
        *pl 'Аманда отступает на шаг. Губы сжаты, глаза мокрые от злости, не от слёз.'
        *pl '«Всё. Я на тебя обиделась. Не подходи ко мне.»'
        *pl 'Она говорит тихо, но так, чтобы ты точно услышал: «Не смотри так. Не сейчас.»'
    elseif $OffenseSceneGirl = 'melissa':
        *pl 'Мелисса смотрит ровно и холодно, будто отмеряет расстояние.'
        *pl '«Я на тебя обиделась. Не подходи. Не надо глаз, не надо рук, не надо „Мелисса, послушай“.»'
        *pl '«Пока я сама не скажу — держись от меня подальше.»'
    elseif $OffenseSceneGirl = 'sandra':
        *pl 'Сандра вытирает руки о фартук медленно, как перед тяжёлым разговором.'
        *pl '«Я на тебя обиделась, Стефан. Не лезь. Не сейчас.»'
        *pl '«Не подходи с шутками и не делай вид, что ничего не было.»'
    else:
        *pl $RealName[$OffenseSceneGirl] + ' отворачивается: «Я обижена. Не подходи.»'
    end

    gs 'OffenseDaysHasIntimateHistory', $OffenseSceneGirl

    if OffenseDaysHasIntimate = 1:
        *pl ' '
        if $OffenseSceneGirl = 'amanda':
            *pl 'Она бросает через плечо, уже тише и злее:'
            *pl '«И на потрахушки можешь не рассчитывать. Пока я дуюсь — к постели пути нет.»'
        elseif $OffenseSceneGirl = 'melissa':
            *pl 'Мелисса чуть наклоняет голову — улыбки нет:'
            *pl '«Можешь не искать дорогу к моей пещерке. Ты отлучён от сладкого, нерыцарь.»'
        elseif $OffenseSceneGirl = 'sandra':
            *pl 'Сандра смотрит в упор, без крика:'
            *pl '«Ночью ко мне не приходи. Дверь будет закрыта. Понял?»'
        end
    end

    *pl ' '
    *pl '(Обида: ' + STR(GirlOffenseDays[$OffenseSceneGirl]) + ' дн. Разговор с ней начнётся с этого.)'

    killvar '$OffenseSceneGirl'
    killvar 'OffenseDaysHasIntimate'
---

#OffenseDaysTalkIntroText
    ! Не трогать $OffenseGirl — сессия talk/меню держит его до клика
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseTxtGirl = $GirlKey
    $OffenseTxtReason = $GirlOffenseReason[$OffenseTxtGirl]

    if $OffenseTxtReason = 'no_protect_low':
        *pl 'Ты ловишь её взгляд: «Ну ты чего, даже не смотришь?»'
        *pl $RealName[$OffenseTxtGirl] + ' смотрит в потолок: «На что? На защитника? Когда в зале заварилось, ты слился с бочками. Обидно...»'
    elseif $OffenseTxtReason = 'protect_high':
        *pl 'Ты разводишь руками: «Я же просто помочь хотел...»'
        *pl $RealName[$OffenseTxtGirl] + ' закатывает глаза: «Помочь! Ты бы ещё латы на меня нацепил. Дай мне самой сдачи дать!»'
    elseif $OffenseTxtReason = 'policy_mismatch':
        *pl 'Ты чешешь затылок: «Правила же для блага таверны...»'
        *pl $RealName[$OffenseTxtGirl] + ' фыркает: «Для блага? Мы семья, а не ростовщики. Смягчай указы, бургомистр».'
    elseif $OffenseTxtReason = 'intercept':
        *pl 'Ты оправдываешься: «Я просто мимо шёл, вижу — непорядок...»'
        *pl $RealName[$OffenseTxtGirl] + ' качает головой: «Мимо! Влетел, будто конница за тобой. Хватит геройствовать без повода».'
    elseif $OffenseTxtReason = 'ban_guys':
        *pl 'Ты садишься ближе: «Ну и почему молчим?»'
        *pl 'Аманда хмыкает: «Запретить мне говорить с парнями — гениально. Я думала, ты доверяешь».'
    elseif $OffenseTxtReason = 'ban_minstrel':
        *pl 'Ты заглядываешь ей в лицо: «Мелисса, из-за музыканта ссориться...»'
        *pl 'Мелисса поднимает бровь: «Он поёт за кружку эля, а ты устроил светопреставление. И смешно, и обидно».'
    elseif $OffenseTxtReason = 'ban_lizette':
        *pl 'Ты мягко качаешь головой: «Лизетта на тебя плохо влияет».'
        *pl 'Аманда всплескивает руками: «Плохо?! Мы пироги с очага таскаем. Верни мне подругу, Стефан!»'
    elseif $OffenseTxtReason = 'daughter_no_protect':
        *pl 'Ты топчешься у двери: «Сандра, ну чего так строго?»'
        *pl 'Сандра качает головой: «Девочек в зале обижают, а защитник прячется за бочками. Не стыдно?»'
    else
        *pl 'Ты виновато улыбаешься: «Ну ладно тебе, давай мириться?»'
        *pl $RealName[$OffenseTxtGirl] + ' отворачивается к окну, но плечи выдают: скоро оттает.'
    end

    gs 'OffenseDaysHasIntimateHistory', $OffenseTxtGirl

    if OffenseDaysHasIntimate = 1:
        *pl ' '
        if $OffenseTxtGirl = 'amanda':
            *pl '«И да: на потрахушки можешь не рассчитывать, пока я так.»'
        elseif $OffenseTxtGirl = 'melissa':
            *pl '«К моей пещерке дорогу забудь. Отлучён от сладкого, нерыцарь.»'
        elseif $OffenseTxtGirl = 'sandra':
            *pl '«Ночью ко мне не приходи. Пока обижена — дверь закрыта.»'
        end
    end

    killvar '$OffenseTxtGirl'
    killvar '$OffenseTxtReason'
    killvar 'OffenseDaysHasIntimate'
---

#OffenseDaysTalkApologizeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseTxtGirl = $GirlKey

    if GirlOffenseDays[$OffenseTxtGirl] > 1:
        *pl 'Ты поднимаешь руки: «Каюсь. Был не прав. Простишь?»'
        *pl $RealName[$OffenseTxtGirl] + ' прыскает: «Ладно, отпущение есть. Но я ещё чуть дуюсь — с тебя сбитень!»'
    else
        *pl 'Ты обнимаешь её за плечи: «Сдаюсь. Мир?»'
        *pl $RealName[$OffenseTxtGirl] + ' утыкается тебе в плечо: «Ох... Как на тебя долго злиться? Иди сюда».'
    end

    killvar '$OffenseTxtGirl'
---

#OffenseDaysTalkRightText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseTxtGirl = $GirlKey

    *pl 'Ты упрямо: «Я всё равно считаю, что поступил правильно».'
    *pl $RealName[$OffenseTxtGirl] + ' смотрит выразительно: «Ну конечно. Стой на своём, мудрец. Спорить сейчас бессмысленно».'
    *pl 'Она уходит. Между вами остаётся неловкая тишина.'

    killvar '$OffenseTxtGirl'
---

#OffenseDaysTalkGiftCheapText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseTxtGirl = $GirlKey

    *pl 'Ты протягиваешь небольшой подарок: «Дань, чтоб междоусобицы не было».'
    *pl $RealName[$OffenseTxtGirl] + ' крутит его в руках: «Подкуп? Хм... Ладно, приняла. Приговор смягчим».'

    killvar '$OffenseTxtGirl'
---

#OffenseDaysTalkGiftExpensiveText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseTxtGirl = $GirlKey

    *pl 'Ты вручаешь коробочку: «Выкуп за вину».'
    *pl $RealName[$OffenseTxtGirl] + ' округляет глаза: «Ого... Должна бы дуться, да не выходит!» Она смеётся: «Прощён. И способ мне нравится».'

    killvar '$OffenseTxtGirl'
---

#OffenseDaysTalkClearText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseTxtGirl = $GirlKey

    *pl 'Ты протягиваешь кувшин: «Разобьём раздор и помиримся?»'
    *pl $RealName[$OffenseTxtGirl] + ' толкает тебя локтем: «Мир. Но ещё раз — сама не ручаюсь. Пошли пирог резать».'

    killvar '$OffenseTxtGirl'
---
