! ================================================
! FILE: modules/core/family/offense_days_text.qsps
! MODULE: core/family
! Тексты обида-дней v6 (Средневековая таверна, Стефан, на «ты»)
! ================================================

#OffenseDaysSoftMismatchNotice
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey
    $OffenseNoticeKind = LCASE($ARGS[1])
    OffenseNoticeCount = ARGS[2]

    if $RealName[$OffenseGirl] = '':
        $RealName[$OffenseGirl] = $OffenseGirl
    end

    if $OffenseNoticeKind = 'no_protect_low':
        $GirlTalkPendingNotice[$OffenseGirl] = $RealName[$OffenseGirl] + ' ловит твой взгляд и тихонько вздыхает: «Опять ты за своё...»'
    elseif $OffenseNoticeKind = 'protect_high':
        $GirlTalkPendingNotice[$OffenseGirl] = $RealName[$OffenseGirl] + ' прищуривается, заметив тебя: «Так, храбрый рыцарь, опять смотришь на меня сквозь забрало заботы»'
    elseif $OffenseNoticeKind = 'policy_mismatch':
        $GirlTalkPendingNotice[$OffenseGirl] = $RealName[$OffenseGirl] + ' недовольно хлопает в ладоши на твои правила: «Слышь, Стефан, у нас тут весёлая таверна или монастырь строгого устава?»'
    end

    killvar '$OffenseGirl'
    killvar '$OffenseNoticeKind'
    killvar 'OffenseNoticeCount'
---

#OffenseDaysTalkIntroText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey
    $OffenseReason = GirlOffenseReason[$OffenseGirl]

    if $OffenseReason = 'no_protect_low':
        *pl 'Ты пытаешься поймать её взгляд: «Ну ты чего, даже не посмотришь на меня?»'
        *pl $RealName[$OffenseGirl] + ' упорно разглядывает закопчённые балки на потолке, хотя в уголках губ прячется грустная усмешка: «А на что смотреть? На великого защитника? Когда в зале заварилась каша, Стефан, ты так ловко слился с тенями за бочками, что я тебя с мешком муки спутала. Обидно вообще-то...»'
    elseif $OffenseReason = 'protect_high':
        *pl 'Ты примирительно разводишь руками: «Я же просто помочь хотел, мало ли что могло случиться...»'
        *pl $RealName[$OffenseGirl] + ' закатывает глаза и упирает руки в бока, забавно передразнивая тебя: «"Мало ли что!" Ты бы меня ещё в латы заковать приказал и соломой обложил для надёжности. Я ценю твои порывы спасти весь мир, правда, но дай мне хоть раз самой здешним забиякам сдачи дать!»'
    elseif $OffenseReason = 'policy_mismatch':
        *pl 'Ты виновато чешешь затылок: «Да ладно тебе, эти правила ведь для блага нашей таверны!»'
        *pl $RealName[$OffenseGirl] + ' только фыркает и качает головой: «Для блага? Давай ещё устав монастырский на воротах повесим и пошлину на вход в обеденный зал введём. Мы же семья, а не гильдия жадных ростовщиков. Отменяй давай свои указы, Стефан, грозный ты наш бургомистр».'
    elseif $OffenseReason = 'intercept':
        *pl 'Ты пытаешься оправдаться: «Да я просто мимо проходил, смотрю — непорядок...»'
        *pl $RealName[$OffenseGirl] + ' качает головой с улыбкой сквозь досаду: «Мимо он проходил! Влетел в круг с таким видом, будто за тобой королевская конница мчится и трубы трубят. Это очень мило, Стефан, конечно, но я со стороны выглядела как беспомощный мешок с овсом, который перетаскивают. Прекращай геройствовать без повода!»'
    elseif $OffenseReason = 'ban_guys':
        *pl 'Ты подсаживаешься поближе у очага: «Ну и почему мы упорно смотрим на угли?»'
        *pl 'Аманда хмыкает, ковыряя носком сапога половицу: «Да вот, боюсь ослепнуть от сияния твоей мудрости, Стефан. Запретить мне даже говорить с парнями в зале — это просто ход гения. Ты меня в погребе на цепь посадить не забыл для надёжности? Обидно, вообще-то. Я думала, ты мне доверяешь».'
    elseif $OffenseReason = 'ban_minstrel':
        *pl 'Ты заглядываешь ей в лицо: «Мелисса, ну перестань дуться. Из-за какого-то бродячего музыканта ссориться...»'
        *pl 'Мелисса приподнимает бровь, глядя на тебя с лёгкой иронией: «О, великий домашний цензор заговорил! Стефан, парень просто поёт баллады за кружку эля, а ты устроил светопреставление. Неужели правда испугался, что меня уведёт заезжий лютнист в цветастом плаще? И смешно, и обидно от твоей ревности».'
    elseif $OffenseReason = 'ban_lizette':
        *pl 'Ты мягко качаешь головой: «Я же просто считаю, что Лизетта на тебя плохо влияет».'
        *pl 'Аманда всплескивает руками и прыскает со смеху, хоть в глазах ещё и блестит обида: «Плохо влияет?! Да мы с ней максимум пироги с черникой по ночам с очага втихаря таскаем! Ты ведёшь себя как строгий лорд из старых хроник. Хватит играть в королевского пристава, Стефан, верни мне подругу!»'
    elseif $OffenseReason = 'daughter_no_protect':
        *pl 'Ты неловко топчешься у дубовой двери: «Сандра, ну ты чего так строго на меня смотришь?»'
        *pl 'Сандра качает головой, изо всех сил пытаясь сохранить суровое выражение лица: «Да вот смотрю и думаю: у нас в таверне завёлся невидимый дух. Девочек в зале обижают, а наш главный защитник, Стефан, так технично растворился за пивными бочками, что никто и не заметил. И не стыдно тебе, лесной разбойник?»'
    else
        *pl 'Ты виновато улыбаешься: «Ну ладно тебе, давай мириться?»'
        *pl $RealName[$OffenseGirl] + ' демонстративно отворачивается к окну, за которым шумит тракт, но по её плечам видно, что она едва сдерживает улыбку. Похоже, лёд скоро растает.'
    end

    killvar '$OffenseGirl'
    killvar '$OffenseReason'
---

#OffenseDaysTalkApologizeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    if GirlOffenseDays[$OffenseGirl] > 0:
        *pl 'Ты примирительно поднимаешь руки: «Ладно, каюсь. Был не прав по всем статьям, признаю свою вину, меру и степень. Простишь дурака?»'
        *pl $RealName[$OffenseGirl] + ' не выдерживает и прыскает со смеху: «Ладно, красноречивый, отпущение грехов ты заслужил. Но я всё ещё немного дуюсь для острастки, так что с тебя кружка горячего сбитня, Стефан!»'
    else
        *pl 'Ты аккуратно обнимаешь её со спины за плечи: «Всё, сдаюсь! Объявляю полную и безоговорочную капитуляцию. Мир?»'
        *pl $RealName[$OffenseGirl] + ' облегчённо вздыхает, расслабляется и утыкается тебе в плечо: «Ох, ладно... Ну как вообще на тебя можно долго злиться, Стефан? Иди сюда, горе моё...»'
    end

    killvar '$OffenseGirl'
---

#OffenseDaysTalkRightText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    *pl 'Ты упрямо поджимаешь губы: «Я всё равно считаю, что поступил правильно. И точка».'
    *pl $RealName[$OffenseGirl] + ' награждает тебя самым выразительным взглядом из своего арсенала: «Ну конечно, упрямый как трактирный осёл. Ладно, стой на своём, Стефан, великий мудрец. Спорить с тобой сейчас — только время терять».'
    *pl 'Она уходит по делам, оставив тебя наедине со своей «правотой», но на душе у обоих висит неловкая тишина.'

    killvar '$OffenseGirl'
---

#OffenseDaysTalkGiftCheapText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    *pl 'Ты с самым загадочным видом протягиваешь ей небольшой презент: «Это скромная дань во избежание дальнейших междоусобных войн в нашей таверне».'
    *pl $RealName[$OffenseGirl] + ' с улыбкой крутит подарок в руках: «Ого, подкуп стражи? Хм... Ну ладно, Стефан, дань принята — смягчим суровый приговор!» Обида явно уступает место хорошему настроению.'

    killvar '$OffenseGirl'
---

#OffenseDaysTalkGiftExpensiveText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    *pl 'Ты торжественно вручаешь красивую коробочку: «Спешу загладить свою вину королевским выкупом!»'
    *pl $RealName[$OffenseGirl] + ' удивлённо округляет глаза: «Ого! Ничего себе... Так, погоди, Стефан, я же должна держать обиженное лицо... Клянусь пресветлыми силами, не получается!» Она со смехом бросается тебе на шею: «Ладно, ты полностью прощён! Но твой способ заглаживать вину мне определённо нравится».'

    killvar '$OffenseGirl'
---

#OffenseDaysTalkClearText
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    *pl 'Ты шутливо протягиваешь ей кувшин: «Ну что, разобьём кувшин раздора и помиримся по-нашему?»'
    *pl $RealName[$OffenseGirl] + ' весело толкает тебя локтем в бок: «Ладно уж, мир! Но если ты, Стефан, ещё раз выкинешь что-то подобное — я за себя не ручаюсь. Пошли пирог резать, вредитель».'

    killvar '$OffenseGirl'
---