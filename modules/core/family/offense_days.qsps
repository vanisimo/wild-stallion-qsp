! ================================================
! FILE: modules/core/family/offense_days.qsps
! MODULE: core/family
! Обида-дни v1: движок + накопление dual protect/policy
! ================================================

! ВАЖНО: хелперы НЕ должны killvar '$OffenseGirl' родителя.
! Раньше GirlInEngine/StatBand убивали $OffenseGirl → Register писал в ключ '' → protectK всегда 0.

#OffenseDaysInitGirl
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseInitGirl = $GirlKey

    if $OffenseInitGirl = '':
        killvar '$OffenseInitGirl'
        exit
    end

    gs 'OffenseDaysGirlInEngine', $OffenseInitGirl

    if OffenseDaysGirlInEngine = 0:
        killvar '$OffenseInitGirl'
        exit
    end

    GirlOffenseDays[$OffenseInitGirl] = 0
    $GirlOffenseReason[$OffenseInitGirl] = ''
    GirlOffenseRightUsed[$OffenseInitGirl] = 0
    GirlOffenseApologizeDay[$OffenseInitGirl] = 0
    GirlOffenseMismatchProtect[$OffenseInitGirl] = 0
    GirlOffenseMismatchPolicy[$OffenseInitGirl] = 0
    GirlOffenseInterceptCount[$OffenseInitGirl] = 0
    GirlOffenseMismatchLastDay[$OffenseInitGirl] = 0

    killvar '$OffenseInitGirl'
---

#OffenseDaysGirlInEngine
    ! только флаг OffenseDaysGirlInEngine; ARGS[0] = girl key
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseEngGirl = $GirlKey
    OffenseDaysGirlInEngine = 0

    if $OffenseEngGirl = 'amanda' or $OffenseEngGirl = 'melissa' or $OffenseEngGirl = 'sandra':
        OffenseDaysGirlInEngine = 1
    end

    killvar '$OffenseEngGirl'
---

#OffenseDaysMismatchK
    OffenseDaysMismatchK = 3
---

#OffenseDaysInterceptK
    OffenseDaysInterceptK = 3
---

#OffenseDaysStart
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseStartGirl = $GirlKey
    $OffenseReason = LCASE($ARGS[1])

    if $OffenseStartGirl = '':
        killvar '$OffenseStartGirl'
        killvar '$OffenseReason'
        exit
    end

    gs 'OffenseDaysGirlInEngine', $OffenseStartGirl

    if OffenseDaysGirlInEngine = 0:
        killvar '$OffenseStartGirl'
        killvar '$OffenseReason'
        exit
    end

    if $OffenseReason = '':
        $OffenseReason = 'unknown'
    end

    GirlOffenseDays[$OffenseStartGirl] = 4
    $GirlOffenseReason[$OffenseStartGirl] = $OffenseReason
    GirlOffenseRightUsed[$OffenseStartGirl] = 0
    GirlOffenseApologizeDay[$OffenseStartGirl] = 0

    killvar '$OffenseStartGirl'
    killvar '$OffenseReason'
---

#OffenseDaysTalkCanStart
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseTalkGirl = $GirlKey
    OffenseDaysTalkCanStart = 0

    if $OffenseTalkGirl = '':
        killvar '$OffenseTalkGirl'
        exit
    end

    if GirlOffenseDays[$OffenseTalkGirl] > 0:
        OffenseDaysTalkCanStart = 1
    end

    killvar '$OffenseTalkGirl'
---

#OffenseDaysGirlStatBand
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseBandGirl = $GirlKey
    GirlOffenseStatBand = 0

    if $OffenseBandGirl = '':
        killvar '$OffenseBandGirl'
        exit
    end

    gs 'EnsureGirlData', $OffenseBandGirl

    OffenseBandLowScore = 0
    OffenseBandHighScore = 0

    if sluttiness[$OffenseBandGirl] < 28:
        OffenseBandLowScore += 1
    end

    if GirlWorkPolicy[$OffenseBandGirl] <= 1:
        OffenseBandLowScore += 1
    end

    if GirlPublicAttention[$OffenseBandGirl] < 22:
        OffenseBandLowScore += 1
    end

    if GirlWorkDiscipline[$OffenseBandGirl] >= 45:
        OffenseBandLowScore += 1
    end

    if sluttiness[$OffenseBandGirl] >= 32:
        OffenseBandHighScore += 1
    end

    if GirlWorkPolicy[$OffenseBandGirl] >= 3:
        OffenseBandHighScore += 1
    end

    if GirlPublicAttention[$OffenseBandGirl] >= 28:
        OffenseBandHighScore += 1
    end

    if GirlRebellion[$OffenseBandGirl] >= 5:
        OffenseBandHighScore += 1
    end

    if $OffenseBandGirl = 'amanda' and AmandaRebellion >= 5:
        OffenseBandHighScore += 1
    end

    if OffenseBandLowScore >= 2 and OffenseBandHighScore <= 1:
        GirlOffenseStatBand = 1
    elseif OffenseBandHighScore >= 2 and OffenseBandLowScore <= 1:
        GirlOffenseStatBand = 2
    end

    killvar 'OffenseBandLowScore'
    killvar 'OffenseBandHighScore'
    killvar '$OffenseBandGirl'
---

#OffenseDaysRegisterMismatchProtect
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseRegGirl = $GirlKey
    $OffenseMismatchKind = LCASE($ARGS[1])

    if $OffenseRegGirl = '':
        killvar '$OffenseRegGirl'
        killvar '$OffenseMismatchKind'
        exit
    end

    gs 'OffenseDaysGirlInEngine', $OffenseRegGirl

    if OffenseDaysGirlInEngine = 0:
        killvar '$OffenseRegGirl'
        killvar '$OffenseMismatchKind'
        exit
    end

    if GirlOffenseDays[$OffenseRegGirl] > 0:
        killvar '$OffenseRegGirl'
        killvar '$OffenseMismatchKind'
        exit
    end

    gs 'OffenseDaysMismatchK'
    GirlOffenseMismatchProtect[$OffenseRegGirl] += 1
    GirlOffenseMismatchLastDay[$OffenseRegGirl] = day

    if GirlOffenseMismatchProtect[$OffenseRegGirl] >= OffenseDaysMismatchK:
        gs 'OffenseDaysStart', $OffenseRegGirl, $OffenseMismatchKind
        if LOC('OffenseDaysSoftMismatchNotice') = 1:
            gs 'OffenseDaysSoftMismatchNotice', $OffenseRegGirl, $OffenseMismatchKind, OffenseDaysMismatchK
        end
        GirlOffenseMismatchProtect[$OffenseRegGirl] = 1
        killvar '$OffenseRegGirl'
        killvar '$OffenseMismatchKind'
        exit
    end

    if LOC('OffenseDaysSoftMismatchNotice') = 1:
        gs 'OffenseDaysSoftMismatchNotice', $OffenseRegGirl, $OffenseMismatchKind, GirlOffenseMismatchProtect[$OffenseRegGirl]
    end

    killvar '$OffenseRegGirl'
    killvar '$OffenseMismatchKind'
---

#OffenseDaysRegisterMismatchPolicy
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseRegGirl = $GirlKey

    if $OffenseRegGirl = '':
        killvar '$OffenseRegGirl'
        exit
    end

    gs 'OffenseDaysGirlInEngine', $OffenseRegGirl

    if OffenseDaysGirlInEngine = 0:
        killvar '$OffenseRegGirl'
        exit
    end

    if GirlOffenseDays[$OffenseRegGirl] > 0:
        killvar '$OffenseRegGirl'
        exit
    end

    gs 'OffenseDaysMismatchK'
    GirlOffenseMismatchPolicy[$OffenseRegGirl] += 1
    GirlOffenseMismatchLastDay[$OffenseRegGirl] = day

    if GirlOffenseMismatchPolicy[$OffenseRegGirl] >= OffenseDaysMismatchK:
        gs 'OffenseDaysStart', $OffenseRegGirl, 'policy_mismatch'
        if LOC('OffenseDaysSoftMismatchNotice') = 1:
            gs 'OffenseDaysSoftMismatchNotice', $OffenseRegGirl, 'policy_mismatch', OffenseDaysMismatchK
        end
        GirlOffenseMismatchPolicy[$OffenseRegGirl] = 1
        killvar '$OffenseRegGirl'
        exit
    end

    if LOC('OffenseDaysSoftMismatchNotice') = 1:
        gs 'OffenseDaysSoftMismatchNotice', $OffenseRegGirl, 'policy_mismatch', GirlOffenseMismatchPolicy[$OffenseRegGirl]
    end

    killvar '$OffenseRegGirl'
---

#OffenseDaysRegisterIntercept
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseRegGirl = $GirlKey

    if $OffenseRegGirl = '':
        killvar '$OffenseRegGirl'
        exit
    end

    gs 'OffenseDaysGirlInEngine', $OffenseRegGirl

    if OffenseDaysGirlInEngine = 0 or $OffenseRegGirl = 'sandra':
        killvar '$OffenseRegGirl'
        exit
    end

    if GirlOffenseDays[$OffenseRegGirl] > 0:
        killvar '$OffenseRegGirl'
        exit
    end

    gs 'OffenseDaysInterceptK'
    GirlOffenseInterceptCount[$OffenseRegGirl] += 1

    if GirlOffenseInterceptCount[$OffenseRegGirl] >= OffenseDaysInterceptK:
        gs 'OffenseDaysStart', $OffenseRegGirl, 'intercept'
        GirlOffenseInterceptCount[$OffenseRegGirl] = 0
    end

    killvar '$OffenseRegGirl'
---

#OffenseDaysHarassmentAfter
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseHarassGirl = $GirlKey
    $OffenseArea = LCASE($ARGS[1])
    $OffenseReaction = LCASE($ARGS[2])
    $OffenseTalkReaction = LCASE($ARGS[3])

    if $OffenseHarassGirl = '':
        killvar '$OffenseHarassGirl'
        killvar '$OffenseArea'
        killvar '$OffenseReaction'
        killvar '$OffenseTalkReaction'
        exit
    end

    if $OffenseHarassGirl <> 'amanda' and $OffenseHarassGirl <> 'melissa':
        killvar '$OffenseHarassGirl'
        killvar '$OffenseArea'
        killvar '$OffenseReaction'
        killvar '$OffenseTalkReaction'
        exit
    end

    gs 'OffenseDaysGirlStatBand', $OffenseHarassGirl

    ! band 2 = высокая: ignore/watch не копят no_protect
    ! band 0/1 = ждала защиты
    if $OffenseReaction = 'ignore':
        if GirlOffenseStatBand <> 2:
            gs 'OffenseDaysRegisterMismatchProtect', $OffenseHarassGirl, 'no_protect_low'
        end
    elseif $OffenseReaction = 'watch':
        if $OffenseTalkReaction = 'watch_bad' or $OffenseTalkReaction = 'watch_lewd':
            if GirlOffenseStatBand <> 2:
                gs 'OffenseDaysRegisterMismatchProtect', $OffenseHarassGirl, 'no_protect_low'
            end
        end
    elseif $OffenseReaction = 'protect_hard':
        if $OffenseTalkReaction = 'protect_dislike':
            if GirlOffenseStatBand = 2:
                gs 'OffenseDaysRegisterMismatchProtect', $OffenseHarassGirl, 'protect_high'
            end
        elseif $OffenseTalkReaction = 'protect_success':
            gs 'OffenseDaysRegisterIntercept', $OffenseHarassGirl
        end
    end

    gs 'OffenseDaysSandraDaughterAfterHarass', $OffenseHarassGirl, $OffenseReaction, $OffenseTalkReaction

    $HallHarassOffenseDebug = 'girl=' + $OffenseHarassGirl + ' react=' + $OffenseReaction + ' band=' + STR(GirlOffenseStatBand) + ' protectK=' + STR(GirlOffenseMismatchProtect[$OffenseHarassGirl]) + ' policyK=' + STR(GirlOffenseMismatchPolicy[$OffenseHarassGirl]) + ' days=' + STR(GirlOffenseDays[$OffenseHarassGirl]) + ' reason=' + $GirlOffenseReason[$OffenseHarassGirl]

    if debug = 1:
        *pl '[DEBUG OFFENSE HARASS] ' + $HallHarassOffenseDebug
    end

    killvar '$OffenseHarassGirl'
    killvar '$OffenseArea'
    killvar '$OffenseReaction'
    killvar '$OffenseTalkReaction'
    killvar 'GirlOffenseStatBand'
---

#OffenseDaysSandraDaughterAfterHarass
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseDaughter = $GirlKey
    $OffenseDaughterReact = LCASE($ARGS[1])
    $OffenseDaughterTalk = LCASE($ARGS[2])

    if $OffenseDaughter <> 'amanda' and $OffenseDaughter <> 'melissa':
        killvar '$OffenseDaughter'
        killvar '$OffenseDaughterReact'
        killvar '$OffenseDaughterTalk'
        exit
    end

    if GirlOffenseDays['sandra'] > 0:
        killvar '$OffenseDaughter'
        killvar '$OffenseDaughterReact'
        killvar '$OffenseDaughterTalk'
        exit
    end

    SandraDaughterOffenseRoll = 0

    if $OffenseDaughterReact = 'ignore':
        SandraDaughterOffenseRoll = 1
    elseif $OffenseDaughterReact = 'watch' and ($OffenseDaughterTalk = 'watch_bad' or $OffenseDaughterTalk = 'watch_lewd'):
        SandraDaughterOffenseRoll = 1
    end

    if SandraDaughterOffenseRoll = 0:
        killvar '$OffenseDaughter'
        killvar '$OffenseDaughterReact'
        killvar '$OffenseDaughterTalk'
        exit
    end

    SandraDaughterLearnRoll = RAND(1, 100)
    SandraDaughterLearnChance = 35 + SandraFamilyConcern * 5 + FamilyTension / 2

    if SandraDaughterLearnChance > 85:
        SandraDaughterLearnChance = 85
    end

    if SandraDaughterLearnRoll <= SandraDaughterLearnChance:
        gs 'OffenseDaysStart', 'sandra', 'daughter_no_protect'
    end

    killvar 'SandraDaughterOffenseRoll'
    killvar 'SandraDaughterLearnRoll'
    killvar 'SandraDaughterLearnChance'
    killvar '$OffenseDaughter'
    killvar '$OffenseDaughterReact'
    killvar '$OffenseDaughterTalk'
---

#OffenseDaysPolicyAfterAssign
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffensePolGirl = $GirlKey
    PolicyOffenseValue = ARGS[2]
    PolicyOffenseLevel = ARGS[3]

    if $OffensePolGirl = '':
        killvar '$OffensePolGirl'
        exit
    end

    gs 'OffenseDaysGirlInEngine', $OffensePolGirl

    if OffenseDaysGirlInEngine = 0:
        killvar '$OffensePolGirl'
        exit
    end

    if PolicyOffenseLevel <= 1:
        gs 'OffenseDaysRegisterMismatchPolicy', $OffensePolGirl
        killvar '$OffensePolGirl'
        exit
    end

    gs 'OffenseDaysGirlStatBand', $OffensePolGirl

    if PolicyOffenseValue = 1 and GirlOffenseStatBand = 2:
        gs 'OffenseDaysRegisterMismatchPolicy', $OffensePolGirl
    elseif PolicyOffenseValue = 3 and GirlOffenseStatBand = 1:
        gs 'OffenseDaysRegisterMismatchPolicy', $OffensePolGirl
    end

    killvar '$OffensePolGirl'
    killvar 'GirlOffenseStatBand'
---

#OffenseDaysBanImmediate
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseBanGirl = $GirlKey
    $OffenseBanReason = LCASE($ARGS[1])

    if $OffenseBanGirl = '':
        killvar '$OffenseBanGirl'
        killvar '$OffenseBanReason'
        exit
    end

    gs 'OffenseDaysGirlInEngine', $OffenseBanGirl

    if OffenseDaysGirlInEngine = 0:
        killvar '$OffenseBanGirl'
        killvar '$OffenseBanReason'
        exit
    end

    if $OffenseBanReason = '':
        $OffenseBanReason = 'ban_unknown'
    end

    gs 'OffenseDaysStart', $OffenseBanGirl, $OffenseBanReason

    killvar '$OffenseBanGirl'
    killvar '$OffenseBanReason'
---

#OffenseDaysTickDay
    gs 'OffenseDaysTickDecayMismatch'
    gs 'OffenseDaysTickDecayDays'
---

#OffenseDaysTickDecayDays
    $OffenseTickGirl = 'amanda'
    gs 'OffenseDaysTickGirlDay', $OffenseTickGirl
    $OffenseTickGirl = 'melissa'
    gs 'OffenseDaysTickGirlDay', $OffenseTickGirl
    $OffenseTickGirl = 'sandra'
    gs 'OffenseDaysTickGirlDay', $OffenseTickGirl
    killvar '$OffenseTickGirl'
---

#OffenseDaysTickGirlDay
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    if GirlOffenseDays[$OffenseGirl] > 0:
        GirlOffenseDays[$OffenseGirl] -= 1

        if GirlOffenseDays[$OffenseGirl] < 0:
            GirlOffenseDays[$OffenseGirl] = 0
        end

        if GirlOffenseDays[$OffenseGirl] = 0:
            $GirlOffenseReason[$OffenseGirl] = ''
            GirlOffenseRightUsed[$OffenseGirl] = 0
            GirlOffenseApologizeDay[$OffenseGirl] = 0
        end
    end

    killvar '$OffenseGirl'
---

#OffenseDaysTickDecayMismatch
    $OffenseTickGirl = 'amanda'
    gs 'OffenseDaysTickGirlMismatchDecay', $OffenseTickGirl
    $OffenseTickGirl = 'melissa'
    gs 'OffenseDaysTickGirlMismatchDecay', $OffenseTickGirl
    $OffenseTickGirl = 'sandra'
    gs 'OffenseDaysTickGirlMismatchDecay', $OffenseTickGirl
    killvar '$OffenseTickGirl'
---

#OffenseDaysTickGirlMismatchDecay
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey

    if GirlOffenseMismatchLastDay[$OffenseGirl] <= 0:
        killvar '$OffenseGirl'
        exit
    end

    if day - GirlOffenseMismatchLastDay[$OffenseGirl] >= 7:
        if GirlOffenseMismatchProtect[$OffenseGirl] > 0:
            GirlOffenseMismatchProtect[$OffenseGirl] -= 1
        end

        if GirlOffenseMismatchPolicy[$OffenseGirl] > 0:
            GirlOffenseMismatchPolicy[$OffenseGirl] -= 1
        end

        GirlOffenseMismatchLastDay[$OffenseGirl] = day
    end

    killvar '$OffenseGirl'
---

#OffenseDaysShowTalkImage
    ! ARGS[0] girl, ARGS[1] mood: angry|happy|calm|tired, ARGS[2] size
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseImgGirl = $GirlKey
    $OffenseImgMood = LCASE($ARGS[1])
    $OffenseImgSize = $ARGS[2]

    if $OffenseImgGirl = '':
        killvar '$OffenseImgGirl'
        killvar '$OffenseImgMood'
        killvar '$OffenseImgSize'
        exit
    end

    if $OffenseImgMood = '':
        $OffenseImgMood = 'angry'
    end

    if $OffenseImgSize = '':
        $OffenseImgSize = 'large'
    end

    if LOC('ShowImage') = 1:
        gs 'ShowImage', 'portrait', $OffenseImgGirl, 'talk_' + $OffenseImgMood, '', 'webp', $OffenseImgSize
    end

    if debug = 1 or debug_images = 1:
        *pl '[DEBUG OFFENSE IMG] ' + $OffenseImgGirl + ' talk_' + $OffenseImgMood + ' (' + $OffenseImgSize + ')'
    end

    killvar '$OffenseImgGirl'
    killvar '$OffenseImgMood'
    killvar '$OffenseImgSize'
---

#OffenseDaysTalkStart
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey
    $OffenseReturnLoc = $ARGS[1]

    if $OffenseGirl = '':
        killvar '$OffenseGirl'
        killvar '$OffenseReturnLoc'
        exit
    end

    if $OffenseReturnLoc = '':
        $OffenseReturnLoc = 'TavernMain'
    end

    if LOC($OffenseReturnLoc) = 0:
        $OffenseReturnLoc = 'TavernMain'
    end

    ! Сессия talk: тексты/меню не должны затирать контекст
    $OffenseSessionGirl = $OffenseGirl
    $OffenseSessionReturn = $OffenseReturnLoc

    gs 'EnsureGirlData', $OffenseGirl

    *clr
    clr
    cla

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $OffenseGirl
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ОБИДА: ' + $RealName[$OffenseGirl]
    *pl '══════════════════════════════════════════════'
    *pl ' '

    ! Обида: портрет talk_angry (images/portraits/{girl}/talk_angry.webp)
    gs 'OffenseDaysShowTalkImage', $OffenseGirl, 'angry', 'large'
    *pl ' '

    if LOC('OffenseDaysTalkIntroText') = 1:
        gs 'OffenseDaysTalkIntroText', $OffenseSessionGirl
    else:
        *p $RealName[$OffenseSessionGirl] + ' смотрит мимо. Разговор сейчас — только про то, что между вами треснуло.'
    end

    $OffenseGirl = $OffenseSessionGirl
    $OffenseReturnLoc = $OffenseSessionReturn

    *pl ' '

    if debug = 1:
        *pl '[DEBUG OFFENSE] days: ' + STR(GirlOffenseDays[$OffenseGirl])
        *pl '[DEBUG OFFENSE] reason: ' + $GirlOffenseReason[$OffenseGirl]
        *pl '[DEBUG OFFENSE] protect K: ' + STR(GirlOffenseMismatchProtect[$OffenseGirl])
        *pl '[DEBUG OFFENSE] policy K: ' + STR(GirlOffenseMismatchPolicy[$OffenseGirl])
        *pl ' '
    end

    gs 'OffenseDaysTalkBuildMenu', $OffenseSessionGirl, $OffenseSessionReturn

    *p 'Что будешь <a href="exec:gs ''Menu.Show'', ''OffenseDaysTalkMenu''">делать</a>?'
---

#OffenseDaysTalkBuildMenu
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey
    $OffenseReturnLoc = $ARGS[1]

    if $OffenseGirl = '':
        $OffenseGirl = $OffenseSessionGirl
    end

    if $OffenseReturnLoc = '':
        $OffenseReturnLoc = $OffenseSessionReturn
    end

    if $OffenseReturnLoc = '':
        $OffenseReturnLoc = 'TavernMain'
    end

    if LOC($OffenseReturnLoc) = 0:
        $OffenseReturnLoc = 'TavernMain'
    end

    if $OffenseGirl = '':
        exit
    end

    $OffenseSessionGirl = $OffenseGirl
    $OffenseSessionReturn = $OffenseReturnLoc

    gs 'Menu.Destroy', 'OffenseDaysTalkMenu'
    gs 'Menu.Create', 'OffenseDaysTalkMenu'

    ! Литералы в модуле: клик не зависит от живых $OffenseGirl
    ! Без «Вернуться» — выход с dropdown по уходу курсора (как GirlTalk)
    ! Извиниться — 1×/сутки; после извинения «я прав» скрыт (непоследовательность)
    if GirlOffenseApologizeDay[$OffenseGirl] <> day:
        $OffenseModCode = 'gt ''OffenseDaysTalkAction'', ''apologize'', ''' + $OffenseGirl + ''', ''' + $OffenseReturnLoc + ''''
        gs 'MenuUiAdd', 'OffenseDaysTalkMenu', 'Извиниться', ''
        gs 'Menu.AddModule', 'OffenseDaysTalkMenu', $OffenseModCode
    end

    if GirlOffenseRightUsed[$OffenseGirl] = 0 and GirlOffenseApologizeDay[$OffenseGirl] <> day:
        $OffenseModCode = 'gt ''OffenseDaysTalkAction'', ''right'', ''' + $OffenseGirl + ''', ''' + $OffenseReturnLoc + ''''
        gs 'MenuUiAdd', 'OffenseDaysTalkMenu', 'Я всё сделал правильно', ''
        gs 'Menu.AddModule', 'OffenseDaysTalkMenu', $OffenseModCode
    end

    ! «Подарить» → то же окно, только dropdown с типами подарка (без «Назад»)
    if GiftInventory['gift_cheap'] > 0 or GiftInventory['gift_expensive'] > 0:
        $OffenseModCode = 'gs ''OffenseDaysTalkShowGiftMenu'', ''' + $OffenseGirl + ''', ''' + $OffenseReturnLoc + ''''
        gs 'MenuUiAdd', 'OffenseDaysTalkMenu', 'Подарить', ''
        gs 'Menu.AddModule', 'OffenseDaysTalkMenu', $OffenseModCode
    end

    killvar '$OffenseModCode'
---

#OffenseDaysTalkShowGiftMenu
    ! Только пересобрать dropdown — экран обиды не трогаем (*clr нет)
    gs 'NormalizeGirlKey', $ARGS[0]
    $OffenseGirl = $GirlKey
    $OffenseReturnLoc = $ARGS[1]

    if $OffenseGirl = '':
        $OffenseGirl = $OffenseSessionGirl
    end

    if $OffenseReturnLoc = '':
        $OffenseReturnLoc = $OffenseSessionReturn
    end

    if $OffenseGirl = '':
        exit
    end

    if $OffenseReturnLoc = '':
        $OffenseReturnLoc = 'TavernMain'
    end

    if LOC($OffenseReturnLoc) = 0:
        $OffenseReturnLoc = 'TavernMain'
    end

    $OffenseSessionGirl = $OffenseGirl
    $OffenseSessionReturn = $OffenseReturnLoc

    gs 'Menu.Destroy', 'OffenseDaysGiftMenu'
    gs 'Menu.Create', 'OffenseDaysGiftMenu'

    if GiftInventory['gift_cheap'] > 0:
        $OffenseModCode = 'gt ''OffenseDaysTalkAction'', ''gift_cheap'', ''' + $OffenseGirl + ''', ''' + $OffenseReturnLoc + ''''
        gs 'MenuUiAdd', 'OffenseDaysGiftMenu', 'Обычный подарок', ''
        gs 'Menu.AddModule', 'OffenseDaysGiftMenu', $OffenseModCode
    end

    if GiftInventory['gift_expensive'] > 0:
        $OffenseModCode = 'gt ''OffenseDaysTalkAction'', ''gift_expensive'', ''' + $OffenseGirl + ''', ''' + $OffenseReturnLoc + ''''
        gs 'MenuUiAdd', 'OffenseDaysGiftMenu', 'Дорогой подарок', ''
        gs 'Menu.AddModule', 'OffenseDaysGiftMenu', $OffenseModCode
    end

    killvar '$OffenseModCode'
    gs 'Menu.Show', 'OffenseDaysGiftMenu'
---

#OffenseDaysTalkGiftMenu
    ! legacy alias
    gs 'OffenseDaysTalkShowGiftMenu', $ARGS[0], $ARGS[1]
---

#OffenseDaysTalkAction
    *clr
    clr
    cla

    $OffenseTalkChoice = LCASE($ARGS[0])
    gs 'NormalizeGirlKey', $ARGS[1]
    $OffenseGirl = $GirlKey
    $OffenseReturnLoc = $ARGS[2]

    if $OffenseGirl = '':
        gs 'NormalizeGirlKey', $OffenseSessionGirl
        $OffenseGirl = $GirlKey
    end

    if $OffenseReturnLoc = '':
        $OffenseReturnLoc = $OffenseSessionReturn
    end

    if $OffenseGirl = '':
        msg 'Ошибка: OffenseDaysTalkAction без имени девушки.'
        killvar '$OffenseTalkChoice'
        exit
    end

    if $OffenseReturnLoc = '':
        $OffenseReturnLoc = 'TavernMain'
    end

    if LOC($OffenseReturnLoc) = 0:
        $OffenseReturnLoc = 'TavernMain'
    end

    $OffenseSessionGirl = $OffenseGirl
    $OffenseSessionReturn = $OffenseReturnLoc
    $OffenseActionMood = 'angry'
    OffenseActionDoApologize = 0
    OffenseActionDoRight = 0
    OffenseActionDoGiftCheap = 0
    OffenseActionDoGiftExpensive = 0
    OffenseActionApologizeRepeat = 0

    gs 'EnsureGirlData', $OffenseGirl

    if $OffenseTalkChoice = 'apologize':
        if GirlOffenseApologizeDay[$OffenseGirl] = day:
            OffenseActionApologizeRepeat = 1
            $OffenseActionMood = 'angry'
        else:
            OffenseActionDoApologize = 1
            $OffenseActionMood = 'happy'
        end
    elseif $OffenseTalkChoice = 'right':
        OffenseActionDoRight = 1
        $OffenseActionMood = 'angry'
    elseif $OffenseTalkChoice = 'gift_cheap':
        if GiftInventory['gift_cheap'] > 0:
            OffenseActionDoGiftCheap = 1
            $OffenseActionMood = 'happy'
        end
    elseif $OffenseTalkChoice = 'gift_expensive':
        if GiftInventory['gift_expensive'] > 0:
            OffenseActionDoGiftExpensive = 1
            $OffenseActionMood = 'happy'
        end
    end

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $OffenseGirl
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ОБИДА: ' + $RealName[$OffenseGirl]
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'OffenseDaysShowTalkImage', $OffenseGirl, $OffenseActionMood, 'large'
    *pl ' '

    if OffenseActionApologizeRepeat = 1:
        *pl 'Ты уже извинялся сегодня. Ещё раз — завтра, или подарок / время.'
    elseif OffenseActionDoApologize = 1:
        GirlOffenseApologizeDay[$OffenseGirl] = day

        if LOC('OffenseDaysTalkApologizeText') = 1:
            gs 'OffenseDaysTalkApologizeText', $OffenseGirl
        end

        if GirlOffenseDays[$OffenseGirl] > 0:
            GirlOffenseDays[$OffenseGirl] -= 1
        end

        Friends[$OffenseGirl] += 1

        if $OffenseGirl = 'amanda':
            AmandaTrustStefan += 1
        elseif $OffenseGirl = 'melissa':
            MelissaTrustStefan += 1
        elseif $OffenseGirl = 'sandra':
            SandraTrust += 1
        end
    elseif OffenseActionDoRight = 1:
        GirlOffenseRightUsed[$OffenseGirl] = 1

        if LOC('OffenseDaysTalkRightText') = 1:
            gs 'OffenseDaysTalkRightText', $OffenseGirl
        end
    elseif OffenseActionDoGiftCheap = 1:
        GiftInventory['gift_cheap'] -= 1

        if GirlOffenseDays[$OffenseGirl] > 1:
            GirlOffenseDays[$OffenseGirl] -= 2
        else:
            GirlOffenseDays[$OffenseGirl] = 0
        end

        Friends[$OffenseGirl] += 1
        GirlGiftCount[$OffenseGirl] += 1

        ! Полная реакция подарка (в т.ч. «второй за день»), не короткий offense-only stub
        if LOC('GiftSimpleRegisterGive') = 1:
            gs 'GiftSimpleRegisterGive', $OffenseGirl, 'gift_cheap'
        end

        if LOC('GiftSimpleNarrative') = 1:
            gs 'GiftSimpleNarrative', $OffenseGirl, 'gift_cheap'
            if $GiftNarrativeText <> '':
                *pl $GiftNarrativeText
            end
            killvar '$GiftNarrativeText'
        end

        if LOC('GiftSimpleReactionText') = 1:
            gs 'GiftSimpleReactionText', $OffenseGirl, 'gift_cheap', GiftCheapStreakToday
            if $GiftReactionText <> '':
                *pl $GiftReactionText
            end
            killvar '$GiftReactionText'
        end

        if LOC('MenuGirlGiftValue') = 1:
            gs 'MenuGirlGiftValue', $OffenseGirl, 'gift_cheap'
            gs 'MenuGirlGiftApplyReaction', $OffenseGirl, GiftValue
            killvar 'GiftValue'
        end

        killvar 'GiftCheapStreakToday'
    elseif OffenseActionDoGiftExpensive = 1:
        GiftInventory['gift_expensive'] -= 1
        GirlOffenseDays[$OffenseGirl] = 0
        Friends[$OffenseGirl] += 1
        love[$OffenseGirl] += 1
        GirlGiftCount[$OffenseGirl] += 1

        if LOC('GiftSimpleRegisterGive') = 1:
            gs 'GiftSimpleRegisterGive', $OffenseGirl, 'gift_expensive'
        end

        if LOC('GiftSimpleNarrative') = 1:
            gs 'GiftSimpleNarrative', $OffenseGirl, 'gift_expensive'
            if $GiftNarrativeText <> '':
                *pl $GiftNarrativeText
            end
            killvar '$GiftNarrativeText'
        end

        if LOC('GiftSimpleReactionText') = 1:
            gs 'GiftSimpleReactionText', $OffenseGirl, 'gift_expensive', GiftCheapStreakToday
            if $GiftReactionText <> '':
                *pl $GiftReactionText
            end
            killvar '$GiftReactionText'
        end

        if LOC('MenuGirlGiftValue') = 1:
            gs 'MenuGirlGiftValue', $OffenseGirl, 'gift_expensive'
            gs 'MenuGirlGiftApplyReaction', $OffenseGirl, GiftValue
            killvar 'GiftValue'
        end

        killvar 'GiftCheapStreakToday'
    end

    if GirlOffenseDays[$OffenseGirl] <= 0:
        GirlOffenseDays[$OffenseGirl] = 0
        $GirlOffenseReason[$OffenseGirl] = ''
        GirlOffenseRightUsed[$OffenseGirl] = 0
        GirlOffenseApologizeDay[$OffenseGirl] = 0

        if LOC('OffenseDaysTalkClearText') = 1:
            gs 'OffenseDaysTalkClearText', $OffenseGirl
        end
    end

    gs 'ClampGirlSocialStats', $OffenseGirl
    gs 'GirlTalkSessionEnd'

    killvar 'OffenseActionDoApologize'
    killvar 'OffenseActionDoRight'
    killvar 'OffenseActionDoGiftCheap'
    killvar 'OffenseActionDoGiftExpensive'
    killvar 'OffenseActionApologizeRepeat'
    killvar '$OffenseActionMood'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        if $OffenseReturnLoc <> '' and LOC($OffenseReturnLoc) = 1:
            gt $OffenseReturnLoc
        elseif $OffenseSessionReturn <> '' and LOC($OffenseSessionReturn) = 1:
            gt $OffenseSessionReturn
        else:
            gt 'TavernMain'
        end
    end

    ! Не killvar $OffenseGirl / $OffenseReturnLoc / session — act «Вернуться» при клике
    killvar '$OffenseTalkChoice'
---

#OffenseDaysDebugReset
    gs 'OffenseDaysInitGirl', 'amanda'
    gs 'OffenseDaysInitGirl', 'melissa'
    gs 'OffenseDaysInitGirl', 'sandra'
---