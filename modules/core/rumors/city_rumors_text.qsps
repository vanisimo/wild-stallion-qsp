! ================================================
! FILE: modules/core/rumors/city_rumors_text.qsps
! MODULE: core/rumors
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.10.2026
! Тексты городских слухов по контекстам
! Версия: v6 / новые слухи: взлом/тревога склада, спасённый наёмник, дворянство, орки, Древо Жизни, примерки, Инга
! ================================================

#CityRumorsText
    $CityRumorKey = LCASE($ARGS[0])
    $CityRumorContext = LCASE($ARGS[1])
    $CityRumorText = ''

    if $CityRumorContext = '':
        $CityRumorContext = 'church'
    end

    ! ===========================================================
    ! 1. ВЕСТИ ИЗ СТОЛИЦЫ: РОД ЛЕРМОНТОВ И ОТЕЦ СТЕФАНА
    ! ===========================================================
    if $CityRumorKey = 'lermont_legacy':
        if $CityRumorContext = 'port':
            $CityRumorText = 'У трапа столичного судна шкипер негромко втолковывает купцу:<br><br>'
            $CityRumorText += '— Дом баронов Лермонтов в столице сейчас в силе. При королевском дворе с их словом все считаются. Жаль только, младший барон — лет двадцать назад отправился на южное побережье да сгинул без вести. Следы затерялись, а ведь достойный представитель рода был... Никто и не знает, осталась ли от него хоть капля благородной крови.'
        elseif $CityRumorContext = 'becky':
            $CityRumorText = 'Пожилая соседка у прилавка с солью тихо судачит:<br><br>'
            $CityRumorText += '— Помню я барона Лермонта, когда он в наши края наезжал... Высокий, осанистый, при золоте и бархате! Сандра-то трактирщица тогда молоденькая была, ох как вокруг него увивалась. А потом барон исчез как в воду канул, а род его в столице до сих пор правит и богатеет. Интересно, помнят ли там о пропавшем?'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'В перерыве между танцами двое зажиточных ремесленников потягивают вино из глиняных кружек:<br><br>'
            $CityRumorText += '— В столице дом баронов Лермонтов сейчас в великой силе у короля, казна ломится, вассалов не счесть. А ведь двадцать лет назад их младший наследник в наших краях как в воду канул. Говорили тогда, Сандра-трактирщица от него круглая ходила, да кто теперь правду сыщет... А ведь если наследник жив — знатный был бы господин.'
        else
            $CityRumorText = 'Два степенных горожанина негромко переговариваются вполголоса:<br><br>'
            $CityRumorText += '— В столице дом баронов Лермонтов по-прежнему в великом почёте у короля. Сильнейший дворянский род, богатства немереные... А ведь их родич много лет назад бесследно пропал на нашем побережье. Говорили тогда разное, да время всё смыло.'
        end

    ! ===========================================================
    ! 2. МЭР РОДРИГО БОРДЖИА И ПОРТНИХА ИРМА
    ! ===========================================================
    elseif $CityRumorKey = 'mayor_irma':
        if $CityRumorContext = 'becky':
            $CityRumorText = 'Кумушка на рынке делится свежими наблюдениями:<br><br>'
            $CityRumorText += '— Видала, как мэр Борджиа после танцев к портнихе шмыгнул? Ирма дверь на засов, шторы задёрнула, а огонёк до полуночи горел! Плащ он там, вишь ли, подшивает... Знаем мы эти швы, стоны даже через окно слышно!'
        elseif $CityRumorContext = 'port':
            $CityRumorText = 'Подвыпивший матрос у бочек смется:<br><br>'
            $CityRumorText += '— Мэр-то наш молодец, а по вечерам к модистке Ирме бегает! Та ему такие мерки снимает — без штанов! Молодец, таким и нужно быть, хороший мэр.'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'У помоста музыкантов две молодые горожанки хихикают, глядя в сторону закрытой лавки портнихи:<br><br>'
            $CityRumorText += '— Видала, мэр Борджиа речь отбарабанил — и опять к Ирме на заднее крыльцо поглядывает! Едва музыка стихнет, шмыгнёт «новую выкройку утверждать». Ирма-то у нас мастерица — мерку снимает так, что у старика колени трясутся!'
        else
            $CityRumorText = 'У задней двери две старухи шепчут о мэре и портнихе:<br><br>'
            $CityRumorText += '— ...после танцев... не первый раз в лавку заходит... да и творят там... в наше время таких не было... жаль... не то слово... — дальше очерчивают святой круг и замолкают, завидев чужих.'
        end

    ! ===========================================================
    ! 4. РАЗГУЛ И СПЛЕТНИ В ТРАКТИРЕ
    ! ===========================================================
    elseif $CityRumorKey = 'tavern_scandal':
        if $CityRumorContext = 'port':
            $CityRumorText = 'Матросы за кружкой эля довольно гудят:<br><br>'
            $CityRumorText += '— Слыхали про «Дикий Жеребец»? Кабак что надо! Девки так жопами крутят пока пиво носят, что пена в кружках закипает, а за пару серебряных можно договориться...!'
        elseif $CityRumorContext = 'becky':
            $CityRumorText = 'Соседка всплёскивает руками у прилавка:<br><br>'
            $CityRumorText += '— В трактире Лонгкоков совсем стыд потеряли! Клиенты девок за юбки хватают, по вечерам из комнат стоны на всю улицу, а Стефан только ухмыляется да монету считает!'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'Молодёжь у праздничного ларька перемигивается со смехом:<br><br>'
            $CityRumorText += '— Слыхали, что в «Диком Жеребце» творится? Подавальщицы юбки подтыкают так, что исподнее едва срам прикрывает, а в зальчиках такое вытворяют — пена в кружках закипает! Стефан заведение в настоящий вертеп превратил, весь город на ушах стоит!'
        else
            $CityRumorText = 'Степенные горожане за спиной негромко сокрушаются:<br><br>'
            $CityRumorText += '— В «Диком Жеребце» в последнее время совсем стыд потеряли. Девки разносят пиво в таких платьях, что у молодёжи глаза на лоб лезут, и в штанах тесно, а из подсобок по вечерам такие звуки несутся, будто там портовый вертеп. Стефан совсем за порядком не смотрит... Если так пойдёт дальше, отец Герхард прямо с алтаря их помянет.'
        end

    ! ===========================================================
    ! 5. АЛЬБЕР ЛЕГАРЕ И АМАНДА
    ! ===========================================================
    elseif $CityRumorKey = 'legare_amanda':
        if $CityRumorContext = 'becky':
            $CityRumorText = 'Торговка овощами хихикает:<br><br>'
            $CityRumorText += '— Альбер Легаре совсем голову потерял от юной Аманды! Кларисса-то его на людях лицо держит, а сама чернее тучи. А кобель этот чуть не каждый день в трактир бегает, всё норовит девчонку то за талию прихватить, то сладким вином угостить!'
        elseif $CityRumorContext = 'port':
            $CityRumorText = 'Грузчики пересмеиваются у склада:<br><br>'
            $CityRumorText += '— Виноторговец Легаре вокруг малолетки трактирной кругами ходит! Сам важный, а слюни текут как у дворового пса на свежее мясо.'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'У бочек с элем двое лавочников посмеиваются, косясь на нарядного купца:<br><br>'
            $CityRumorText += '— Альбер Легаре сегодня на площади глаз с юной Аманды не сводит! Кларисса рядом стоит, губы поджала, а этот кобель кругами ходит, всё норовит девчонку в хоровод затащить да за талию прижать. Совсем старый хрен стыд потерял от трактирной молодки!'
        else
            $CityRumorText = 'У колонны две кумушки бросают косые взгляды на стоящего неподалёку виноторговца:<br><br>'
            $CityRumorText += '— Видала, как Легаре на юную Аманду поглядывает? Сам с женой в церкви стоит, набожного корчит, а на прошлой неделе чуть не каждый день в «Жеребец» бегал. И всё норовит девчонку то за руку прихватить, то на танец позвать. Кларисса-то, бедняжка, лицо держит, а сама вся белая от обиды...'
        end

    ! ===========================================================
    ! 6. КУХНЯ САНДРЫ
    ! ===========================================================
    elseif $CityRumorKey = 'kitchen_sandra':
        if $CityRumorContext = 'becky':
            $CityRumorText = 'У ящиков с мукой две кумы перешёптываются со смешком:<br><br>'
            $CityRumorText += '— Сандра-то на кухне у печи жаром пышет! Мужики к ней заглядывают не только за пирогами — то один за талию прихватит, то другой за шторку протиснется. Вдова для вида шипит, а сама от мужских рук расцветает!'
        elseif $CityRumorContext = 'port':
            $CityRumorText = 'Портовый рабочий усмехается:<br><br>'
            $CityRumorText += '— На кухне у «Жеребца» хозяйка — огонь-баба. Строгая с виду, а кто подход знает — и похлёбку наваристую получит, и за жопу подержится!'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'Мужики в кругу хмельно балагурят:<br><br>'
            $CityRumorText += '— В «Жеребце» на кухне хозяйка — огонь-баба! Сандра перед гостями строгая, а кто подход знает — к ней за занавеску шастает за наваристой похлёбкой да тёплым боком. Знает вдова, как гостей привечать!'
        else
            $CityRumorText = 'Две прихожанки у входа осуждающе шепчутся:<br><br>'
            $CityRumorText += '— Слыхали, что на кухне трактира творится? Вдова гостей привечает прямо на кухне. Порядочной женщине негоже мужиков за перегородку пускать... Ильматер видит всё.'
        end

    ! ===========================================================
    ! 7. ВЫХОДКИ ДОЧЕРЕЙ (МЕЛИССА И АМАНДА)
    ! ===========================================================
    elseif $CityRumorKey = 'girls_behavior':
        if $CityRumorContext = 'becky':
            $CityRumorText = 'Рыночные торговки одобрительно цокают языками:<br><br>'
            $CityRumorText += '— Дочки трактирщицы-то времени зря не теряют! Младшая попой крутит — серебро рекой льётся, старшая книжница — язвит, а монету считает ловчее казначея. Знают девки, как из мужиков серебро выжимать!'
        elseif $CityRumorContext = 'port':
            $CityRumorText = 'Бывалые моряки спорят за кружкой:<br><br>'
            $CityRumorText += '— В таверне у Стефана сестрицы хороши! Одна вертится как юла, улыбается каждому, другая гордая как графиня, а за книжку редкую готова на вольности глаза закрыть.'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'Парочка парней у края площади жадно провожает взглядами сестёр Лонгкок:<br><br>'
            $CityRumorText += '— Сестрички из трактира сегодня разодеты — глаз не оторвать! Младшая бёдрами покачивает, улыбается направо и налево, старшая язвит, а взгляд такой, будто сама цену себе знает. Знают девки, как мужикам головы кружить!'
        else
            $CityRumorText = 'Пожилой ремесленник качает головой:<br><br>'
            $CityRumorText += '— Сестрички Лонгкок совсем страх потеряли. Одна бёдрами виляет перед гостями, другая язвит почтенным людям. И куда только мать смотрит? В наши времена за такое отец вожжами учил.'
        end

    ! ===========================================================
    ! 8. ПОЖЕРТВОВАНИЯ / ГРЕХИ СТЕФАНА В СОБОРЕ
    ! ===========================================================
    elseif $CityRumorKey = 'stefan_donation':
        if $CityRumorContext = 'becky':
            $CityRumorText = 'Старуха шепчет соседке:<br><br>'
            $CityRumorText += '— Стефан-то наш в собор мешочек серебра отнёс! Видать, замаливает грехи своего кабака. Отец Герхард монеты любит не меньше купцов — сразу грехи трактирщика отпустил!'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'Пожилой горожанин поучает приятеля у лавки с закусками:<br><br>'
            $CityRumorText += '— Стефан-то, хозяин «Жеребца», говорят, отцу Герхарду целый кошель отвалил на собор! Замаливает грешки своего заведения. Священник серебро принял и сразу проповеди о благочестии смягчил — перед Ильматером все равны, а щедрые равнее!'
        else
            $CityRumorText = 'Служка шепчет прихожанину:<br><br>'
            $CityRumorText += '— Отец Герхард благодарил тайного благодетеля за щедрый дар храму... В соборе все знают, что это хозяин «Жеребца» откупается за вольные нравы в своём заведении!'
        end

    ! ===========================================================
    ! 9. ЖОРЖЕТТА И ЛИЗЕТТА В ПОРТУ
    ! ===========================================================
    elseif $CityRumorKey = 'port_georgette_lizette':
        if $CityRumorContext = 'port':
            $CityRumorText = 'Шёпот у ночного причала:<br><br>'
            $CityRumorText += '— Лизетта с матерью дело держат крепко. Днём на пирсах смуглянка товары смотрит, а ночью в тёмных переулках с матросами делится лаской. Красива девка, вся в мать!'
        elseif $CityRumorContext = 'becky':
            $CityRumorText = 'Бабы судачат у ворот:<br><br>'
            $CityRumorText += '— Жоржетта дочку Лизетту совсем к рукам прибрала. Девушка юная, гибкая, все моряки к ней липнут. Говорят, в порту без неё ни одна ночь не обходится!'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'Молодые гуляки перешёптываются у фонарного столба:<br><br>'
            $CityRumorText += '— Жоржетта с дочкой Лизеттой порт под себя подмяли! Днём девка на причалах красуется, а ночью в переулках матросов привечает. Говорят, гибкая как лоза, вся в мать пошла!'
        else
            $CityRumorText = 'Матрос у колонны жалуется соседу:<br><br>'
            $CityRumorText += '— В порту ночью снова слишком много материнской заботы. Дочь-то красивее и моложе матери — и городу это не по нраву, все только о них и говорят.'
        end

    ! ===========================================================
    ! 10. ВЗГЛЯД СТЕФАНА
    ! ===========================================================
    elseif $CityRumorKey = 'stefan_gaze':
        if $CityRumorContext = 'becky':
            $CityRumorText = 'Соседка посмеивается:<br><br>'
            $CityRumorText += '— Стефан наш совсем заматерел! На девок так плотоядно зыркает, будто взглядом раздевает прямо посреди улицы. Настоящий «Жеребец»!'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'Две девицы на выданье переглядываются со смешком:<br><br>'
            $CityRumorText += '— Глянь, как Стефан из «Жеребца» на нас пялится! Глазищами так и раздевает посреди площади, аж мороз по коже. Настоящий жеребец, не зря кабак так назвал!'
        else
            $CityRumorText = 'Служка шепчет приходящему купцу:<br><br>'
            $CityRumorText += '— Хозяин «Жеребца» слишком часто смотрит не на проповедь, а на женские плечи и попы. Купец усмехается: в маленьком городе это тоже вера — в чужие слабости.'
        end

    ! ===========================================================
    ! 11. КОМНАТА ЧИСТЫХ СЕРДЕЦ У ГЕРХАРДА
    ! ===========================================================
    elseif $CityRumorKey = 'gerhard_clean_hearts':
        if $CityRumorContext = 'port':
            $CityRumorText = 'Матрос подмигивает приятелю:<br><br>'
            $CityRumorText += '— Святоша Герхард знает, как женщин утешать! Запирает прихожанок в комнате чистых сердец на час-другой, а выходят они оттуда с вспотевшие да с румянцем!'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'Женщина в чепце сплетничает с кумой у края хоровода:<br><br>'
            $CityRumorText += '— Отец Герхард сегодня на службу звал, про комнату чистых сердец вещал... Да только бабы оттуда выходят с горящими щеками и растрёпанными подолами. Знаем мы его чистоту сердечную!'
        else
            $CityRumorText = 'У боковой двери старик бормочет:<br><br>'
            $CityRumorText += '— Отец Герхард слишком долго принимает женщин в комнате чистых сердец. Сосед дёргает его за рукав: «Ты что, грех на душу берёшь святого человека судить?»'
        end

    ! ===========================================================
    ! 12. ПОРОШОК ТАРО И ЧИСТОТА ИЛЬМАТЕРА
    ! ===========================================================
    elseif $CityRumorKey = 'taro_powder':
        if $CityRumorContext = 'becky':
            $CityRumorText = 'Торговка поправляет платок:<br><br>'
            $CityRumorText += '— Порошок Таро у алтаря — истинное благословение Ильматера. Намазалась, смыла — и кожа гладкая, как шёлк! Мужики от такой чистоты с ума сходят, не то что неряхи заросшие.'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'Молодые горожанки шепчутся перед выходом в праздничный круг:<br><br>'
            $CityRumorText += '— Ты порошком Таро из собора намазалась? Гладкая кожа — верное дело, парни сразу руки на поясницу кладут и не отпускают. Ильматер заповедал держать всё в чистоте, а на танцах без этого никуда!'
        else
            $CityRumorText = 'У колонны шепчутся две хозяйки:<br><br>'
            $CityRumorText += '— Мать застала соседку заросшей как медведицу… лишняя шерсть на теле, как у зверя дикого! Дар у алтаря в соборе всегда бесплатно стоит, бери сколько хочешь, а она ленится. В нашем городе так не живут, чистота — первая заповедь.'
        end

    ! ===========================================================
    ! 13. ПОХОЖДЕНИЯ ИНГИ И ЛУКАСА НА УЛИЦЕ
    ! ===========================================================
    elseif $CityRumorKey = 'inga_lucas':
        if $CityRumorContext = 'becky':
            $CityRumorText = 'Две торговки у рыбного прилавка шепчутся, прикрыв рты ладонями:<br><br>'
            $CityRumorText += '— Слыхала, что дочка Бекки, Инга, с этим верзилой-кузнецом Лукасом за складами вытворяет? В пятницу вечером скользнули в тёмный переулок — и девка прямо в пыль на колени бухнулась, за штаны его схватилась! До свадьбы, вишь ты, не даёт, а ротиком вовсю работает, пока музыка на площади гремит!'
        elseif $CityRumorContext = 'dance':
            $CityRumorText = 'Подмастерья у бочки с элем громко гогочут, перемигиваясь:<br><br>'
