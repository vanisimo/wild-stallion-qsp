! ================================================
! FILE: modules/core/rumors/city_rumors_core.qsps
! MODULE: core/rumors
! [AI-WORKED] Текст переработан / дополнен ассистентом 21.10.2026
! Единый пул городских слухов (City Rumors Engine)
! Версия: v2 / слухи Ирмы, Древа Жизни, орков и дворянства
! ================================================

#CityRumorsEnsureVars
    if CityRumorsInitDone = 1:
        exit
    end

    CityRumorsInitDone = 1
    CityRumorsSeed = 0
    IngaRumorDays_Lucas = 0
    IngaRumorDays_Stefan = 0
    IngaRumorDays_Guard = 0
    IngaRumorDays_Window = 0
    IngaRumorDays_LucasRoom = 0
    IngaRumorDays_GuardBackroom = 0
    IngaRumorDays_GuardMmj = 0
    IngaRumorDays_AnalPurity = 0
---

#CityRumorsResetDaily
    if CityRumorsLastDay = day:
        exit
    end

    CityRumorsLastDay = day
    CityRumorsDailyCount = 0
    killvar 'CityRumorsHeardToday'

    if IngaRumorDays_Lucas > 0:
        IngaRumorDays_Lucas -= 1
        if IngaRumorDays_Lucas = 0:
            CityRumorReady['inga_lucas'] = 0
        end
    end

    if IngaRumorDays_Stefan > 0:
        IngaRumorDays_Stefan -= 1
        if IngaRumorDays_Stefan = 0:
            CityRumorReady['inga_stefan'] = 0
        end
    end

    if IngaRumorDays_Guard > 0:
        IngaRumorDays_Guard -= 1
        if IngaRumorDays_Guard = 0:
            CityRumorReady['inga_guard'] = 0
        end
    end

    if IngaRumorDays_Window > 0:
        IngaRumorDays_Window -= 1
        if IngaRumorDays_Window = 0:
            CityRumorReady['inga_window_night'] = 0
        end
    end

    if IngaRumorDays_LucasRoom > 0:
        IngaRumorDays_LucasRoom -= 1
        if IngaRumorDays_LucasRoom = 0:
            CityRumorReady['inga_lucas_thursday'] = 0
        end
    end

    if IngaRumorDays_GuardBackroom > 0:
        IngaRumorDays_GuardBackroom -= 1
        if IngaRumorDays_GuardBackroom = 0:
            CityRumorReady['inga_guard_backroom'] = 0
        end
    end

    if IngaRumorDays_GuardMmj > 0:
        IngaRumorDays_GuardMmj -= 1
        if IngaRumorDays_GuardMmj = 0:
            CityRumorReady['inga_mmj_guard_stefan'] = 0
        end
    end

    if IngaRumorDays_AnalPurity > 0:
        IngaRumorDays_AnalPurity -= 1
        if IngaRumorDays_AnalPurity = 0:
            CityRumorReady['inga_temple_purity'] = 0
        end
    end
---

#CityRumorsRegisterEvent
    ! ARGS[0] = $Category ('hall_lewd', 'kitchen', 'girls', 'church', 'lermont', 'world', 'incident')
    ! ARGS[1] = Severity (1..3)
    $CityRumorsEventCat = LCASE($ARGS[0])
    CityRumorsEventSeverity = ARGS[1]

    if CityRumorsEventSeverity <= 0:
        CityRumorsEventSeverity = 1
    end

    if $CityRumorsEventCat = 'hall_lewd':
        CityRumorsHallLewdScore += CityRumorsEventSeverity
        if CityRumorsHallLewdScore >= 3 and (TavernScandal >= 20 or TavernLewdFame >= 10 or FamilyCorruptionStage >= 2):
            CityRumorReady['tavern_scandal'] = 1
        end
    elseif $CityRumorsEventCat = 'kitchen':
        CityRumorsKitchenScore += CityRumorsEventSeverity
        if CityRumorsKitchenScore >= 3 and (TavernKitchenRumor >= 1 or SandraLewdKitchenCount >= 1 or SandraKitchenHarassDone >= 2 or FamilyCorruptionStage >= 2):
            CityRumorReady['kitchen_sandra'] = 1
        end
    elseif $CityRumorsEventCat = 'girls':
        CityRumorsGirlsScore += CityRumorsEventSeverity
        if CityRumorsGirlsScore >= 3 and (FamilyCorruptionStage >= 2 or TavernLewdFame >= 10 or TavernScandal >= 20 or AmandaScandalLevel >= 1):
            CityRumorReady['girls_behavior'] = 1
        end
    elseif $CityRumorsEventCat = 'church':
        CityRumorsChurchScore += CityRumorsEventSeverity
        if CityRumorsChurchScore >= 2 and (PlayerChurchDonationTotal > 0 or ChurchDonationDone >= 1):
            CityRumorReady['stefan_donation'] = 1
        end
    end

    killvar '$CityRumorsEventCat'
    killvar 'CityRumorsEventSeverity'
---

#CityRumorsPickKey
    ! Выбирает ключ слуха с учётом сюжетных приоритетов и суточных кулдаунов
    gs 'CityRumorsResetDaily'
    $CityRumorPickedKey = ''

    ! -----------------------------------------------------------
    ! ПРИОРИТЕТ 1: Сюжетные слухи (квесты, подсказки, вехи)
    ! -----------------------------------------------------------

    ! 1. Интрижка Мэра и Ирмы (только после пятничных танцев)
    if PlayerKnows_MayorIrmaAffair = 0 and FridayDancesCount >= 1 and day > 5 and CityRumorsHeardToday['mayor_irma'] = 0:
        $CityRumorPickedKey = 'mayor_irma'
        PlayerKnows_MayorIrmaAffair = 1

    ! 2. Слухи о разгуле в трактире (отзвук событий в зале)
    elseif (CityRumorReady['tavern_scandal'] = 1 or ChurchTavernRumorReady = 1 or TavernLewdFame >= 15 or TavernScandal >= 25 or TavernGirlsEasyRumor = 1) and (TavernScandal >= 20 or TavernLewdFame >= 10 or ChurchTavernRumorReady = 1 or FamilyCorruptionStage >= 2) and day > 3 and CityRumorsHeardToday['tavern_scandal'] = 0:
        $CityRumorPickedKey = 'tavern_scandal'
        ChurchTavernRumorHeard = 1
        ChurchTavernRumorReady = 0
        CityRumorReady['tavern_scandal'] = 0

    ! 4. Легаре и Аманда (после танцев и не ранее второй недели)
    elseif (CityRumorReady['legare_amanda'] = 1 or LegareAmandaRumorReady = 1) and FridayDancesCount >= 1 and day > 7 and CityRumorsHeardToday['legare_amanda'] = 0:
        $CityRumorPickedKey = 'legare_amanda'
        LegareAmandaRumorHeard = 1
        LegareAmandaRumorReady = 0
        CityRumorReady['legare_amanda'] = 0

    ! 5. Слухи о кухне Сандры
    elseif CityRumorReady['kitchen_sandra'] = 1 and (TavernKitchenRumor >= 1 or SandraLewdKitchenCount >= 1 or SandraKitchenHarassDone >= 2 or FamilyCorruptionStage >= 2) and day > 4 and CityRumorsHeardToday['kitchen_sandra'] = 0:
        $CityRumorPickedKey = 'kitchen_sandra'
        CityRumorReady['kitchen_sandra'] = 0

    ! 6. Выходки дочерей (Мелисса и Аманда)
    elseif CityRumorReady['girls_behavior'] = 1 and (FamilyCorruptionStage >= 2 or TavernLewdFame >= 10 or TavernScandal >= 20 or AmandaScandalLevel >= 1) and day > 4 and CityRumorsHeardToday['girls_behavior'] = 0:
        $CityRumorPickedKey = 'girls_behavior'
        CityRumorReady['girls_behavior'] = 0

    ! 7. Пожертвования / откуп Стефана (только если Стефан жертвовал в храм)
    elseif (CityRumorReady['stefan_donation'] = 1 or CityRumorsChurchScore >= 2) and (PlayerChurchDonationTotal > 0 or ChurchDonationDone >= 1) and CityRumorsHeardToday['stefan_donation'] = 0:
        $CityRumorPickedKey = 'stefan_donation'
        CityRumorReady['stefan_donation'] = 0

    ! 8. Инга и Лукас на улице (подворотни, слухи после танцев)
    elseif (CityRumorReady['inga_lucas'] = 1 or IngaRumorDays_Lucas > 0 or IngaLucasRelation >= 1) and FridayDancesCount >= 1 and day > 5 and CityRumorsHeardToday['inga_lucas'] = 0:
        $CityRumorPickedKey = 'inga_lucas'
        CityRumorReady['inga_lucas'] = 0

    ! 9. Инга теперь со Стефаном (подсобка, танцы, переулок)
    elseif (CityRumorReady['inga_stefan'] = 1 or IngaRumorDays_Stefan > 0) and CityRumorsHeardToday['inga_stefan'] = 0:
        $CityRumorPickedKey = 'inga_stefan'
        CityRumorReady['inga_stefan'] = 0

    ! 10. Инга и стражник / Стефан и стражник
    elseif (CityRumorReady['inga_guard'] = 1 or IngaRumorDays_Guard > 0) and CityRumorsHeardToday['inga_guard'] = 0:
        $CityRumorPickedKey = 'inga_guard'
        CityRumorReady['inga_guard'] = 0

    ! 11. Инга: ночной визит Стефана через окно (вторник)
    elseif (CityRumorReady['inga_window_night'] = 1 or IngaRumorDays_Window > 0) and CityRumorsHeardToday['inga_window_night'] = 0:
        $CityRumorPickedKey = 'inga_window_night'
        CityRumorReady['inga_window_night'] = 0

    ! 12. Инга: четверговые ночные визиты Лукаса в комнату
    elseif (CityRumorReady['inga_lucas_thursday'] = 1 or IngaRumorDays_LucasRoom > 0) and CityRumorsHeardToday['inga_lucas_thursday'] = 0:
        $CityRumorPickedKey = 'inga_lucas_thursday'
        CityRumorReady['inga_lucas_thursday'] = 0

    ! 13. Инга: субботние визиты сержанта Грюна в подсобку
    elseif (CityRumorReady['inga_guard_backroom'] = 1 or IngaRumorDays_GuardBackroom > 0) and CityRumorsHeardToday['inga_guard_backroom'] = 0:
        $CityRumorPickedKey = 'inga_guard_backroom'
        CityRumorReady['inga_guard_backroom'] = 0

    ! 14. Инга: совместная подсобка со Стефаном и Грюном (ММЖ)
    elseif (CityRumorReady['inga_mmj_guard_stefan'] = 1 or IngaRumorDays_GuardMmj > 0) and CityRumorsHeardToday['inga_mmj_guard_stefan'] = 0:
        $CityRumorPickedKey = 'inga_mmj_guard_stefan'
        CityRumorReady['inga_mmj_guard_stefan'] = 0

    ! 15. Инга: чистота Ильматера, порошок Таро и анальная уступка со Стефаном
    elseif (CityRumorReady['inga_temple_purity'] = 1 or IngaRumorDays_AnalPurity > 0) and CityRumorsHeardToday['inga_temple_purity'] = 0:
        $CityRumorPickedKey = 'inga_temple_purity'
        CityRumorReady['inga_temple_purity'] = 0

    ! 16. Триумф Стефана: получение дворянства и признание рода Лермонтов
    elseif (CityRumorReady['stefan_noble_triumph'] = 1 or (PlayerIsNoble = 1 and CityRumorHeardOnce['stefan_noble_triumph'] = 0)) and CityRumorsHeardToday['stefan_noble_triumph'] = 0:
        $CityRumorPickedKey = 'stefan_noble_triumph'
        CityRumorReady['stefan_noble_triumph'] = 0
        CityRumorHeardOnce['stefan_noble_triumph'] = 1

    ! 17. Победа над кланами орков в ущелье и освобождение трактов в Казад-Хер
    elseif (CityRumorReady['orc_battle_triumph'] = 1 or (SecondCaravanResolved = 1 and CityRumorHeardOnce['orc_battle_triumph'] = 0)) and CityRumorsHeardToday['orc_battle_triumph'] = 0:
        $CityRumorPickedKey = 'orc_battle_triumph'
        CityRumorReady['orc_battle_triumph'] = 0
        CityRumorHeardOnce['orc_battle_triumph'] = 1

    ! 18. Тайна древнего Древа Жизни в ремесленном квартале
    elseif (CityRumorReady['tree_of_life_rumor'] = 1 or (IrmaTreeRitualDone = 1 and CityRumorHeardOnce['tree_of_life_rumor'] = 0)) and CityRumorsHeardToday['tree_of_life_rumor'] = 0:
        $CityRumorPickedKey = 'tree_of_life_rumor'
        CityRumorReady['tree_of_life_rumor'] = 0
        CityRumorHeardOnce['tree_of_life_rumor'] = 1

    ! 19. Ночные примерки Стефана у модистки Ирмы
    elseif (CityRumorReady['irma_stefan_night'] = 1 or (IrmaNightFittingDone = 1 and CityRumorHeardOnce['irma_stefan_night'] = 0)) and CityRumorsHeardToday['irma_stefan_night'] = 0:
        $CityRumorPickedKey = 'irma_stefan_night'
        CityRumorReady['irma_stefan_night'] = 0
        CityRumorHeardOnce['irma_stefan_night'] = 1

    ! 20. Инга в ученицах у Ирмы и визиты Стефана в мастерскую
    elseif (CityRumorReady['irma_inga_apprentice'] = 1 or ((IngaAtIrmaShop = 1 or IngaIrmaBond >= 5) and CityRumorHeardOnce['irma_inga_apprentice'] = 0)) and CityRumorsHeardToday['irma_inga_apprentice'] = 0:
        $CityRumorPickedKey = 'irma_inga_apprentice'
        CityRumorReady['irma_inga_apprentice'] = 0
        CityRumorHeardOnce['irma_inga_apprentice'] = 1

    ! 21. Взлом портового склада или ночная тревога
    elseif (CityRumorReady['warehouse_breakin'] = 1 or ((PlayerHasWarehouseKeys = 1 or PlayerHasWeaponShipmentInvoice = 1) and CityRumorHeardOnce['warehouse_breakin'] = 0)) and CityRumorsHeardToday['warehouse_breakin'] = 0:
        $CityRumorPickedKey = 'warehouse_breakin'
        CityRumorReady['warehouse_breakin'] = 0
        CityRumorHeardOnce['warehouse_breakin'] = 1

    ! 22. Спасённый наёмник и свидетель в соборе Ильматера
    elseif (CityRumorReady['saved_mercenary'] = 1 or ((MercenaryAlive = 1 or GerhardHonorablePath = 1 or GerhardProtectingWitness = 1) and CityRumorHeardOnce['saved_mercenary'] = 0)) and CityRumorsHeardToday['saved_mercenary'] = 0:
        $CityRumorPickedKey = 'saved_mercenary'
        CityRumorReady['saved_mercenary'] = 0
        CityRumorHeardOnce['saved_mercenary'] = 1

    ! 23. Кларисса: новый виноградник и мечта о Золотом вине
    elseif (CityRumorReady['clarissa_golden_vineyard'] = 1 or (ClarissaGoldenVineyardPlanted = 1 and CityRumorHeardOnce['clarissa_golden_vineyard'] = 0)) and CityRumorsHeardToday['clarissa_golden_vineyard'] = 0:
        $CityRumorPickedKey = 'clarissa_golden_vineyard'
        CityRumorReady['clarissa_golden_vineyard'] = 0
        CityRumorHeardOnce['clarissa_golden_vineyard'] = 1

    ! 24. Жоржетта и Лизетта в порту (после начала ночной работы Лизетты)
    elseif (CityRumorReady['port_georgette_lizette'] = 1 or (LizetteProstPort = 1 and (LizetteKnown = 1 or AmandaMetLizette = 1 or GeorgetteSeekLizetteDone = 1) and CityRumorHeardOnce['port_georgette_lizette'] = 0)) and day > 5 and CityRumorsHeardToday['port_georgette_lizette'] = 0:
        $CityRumorPickedKey = 'port_georgette_lizette'
        CityRumorReady['port_georgette_lizette'] = 0
        CityRumorHeardOnce['port_georgette_lizette'] = 1
    end

    ! -----------------------------------------------------------
    ! ПРИОРИТЕТ 2: Общий ротируемый пул из 7 категорий
    ! -----------------------------------------------------------
    if $CityRumorPickedKey = '':
        killvar '$CityRumorAvailPool'
        CityRumorAvailCount = 0

        if CityRumorsHeardToday['lermont_legacy'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'lermont_legacy'
            CityRumorAvailCount += 1
        end

        if FridayDancesCount >= 1 and day > 5 and CityRumorsHeardToday['mayor_irma'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'mayor_irma'
            CityRumorAvailCount += 1
        end

        if (LizetteProstPort = 1 or CityRumorReady['port_georgette_lizette'] = 1) and (LizetteKnown = 1 or AmandaMetLizette = 1 or GeorgetteSeekLizetteDone = 1) and day > 5 and CityRumorsHeardToday['port_georgette_lizette'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'port_georgette_lizette'
            CityRumorAvailCount += 1
        end

        if day >= 2 and CityRumorsHeardToday['stefan_gaze'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'stefan_gaze'
            CityRumorAvailCount += 1
        end

        if day >= 2 and CityRumorsHeardToday['gerhard_clean_hearts'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'gerhard_clean_hearts'
            CityRumorAvailCount += 1
        end

        if CityRumorsHeardToday['taro_powder'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'taro_powder'
            CityRumorAvailCount += 1
        end

        if (CityRumorReady['tavern_scandal'] = 1 or ChurchTavernRumorReady = 1 or TavernLewdFame >= 15 or TavernScandal >= 25 or TavernGirlsEasyRumor = 1 or CityRumorsHallLewdScore >= 5) and (TavernScandal >= 20 or TavernLewdFame >= 10 or ChurchTavernRumorReady = 1 or FamilyCorruptionStage >= 2) and day > 3 and CityRumorsHeardToday['tavern_scandal'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'tavern_scandal'
            CityRumorAvailCount += 1
        end

        if (CityRumorReady['kitchen_sandra'] = 1 or (CityRumorsKitchenScore >= 3 and (TavernKitchenRumor >= 1 or SandraLewdKitchenCount >= 1 or SandraKitchenHarassDone >= 2 or FamilyCorruptionStage >= 2))) and (TavernKitchenRumor >= 1 or SandraLewdKitchenCount >= 1 or SandraKitchenHarassDone >= 2 or FamilyCorruptionStage >= 2) and day > 4 and CityRumorsHeardToday['kitchen_sandra'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'kitchen_sandra'
            CityRumorAvailCount += 1
        end

        if (CityRumorReady['girls_behavior'] = 1 or (CityRumorsGirlsScore >= 3 and FamilyCorruptionStage >= 2)) and (FamilyCorruptionStage >= 2 or TavernLewdFame >= 10 or TavernScandal >= 20 or AmandaScandalLevel >= 1) and day > 4 and CityRumorsHeardToday['girls_behavior'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'girls_behavior'
            CityRumorAvailCount += 1
        end

        if (CityRumorReady['legare_amanda'] = 1 or LegareAmandaRumorReady = 1) and FridayDancesCount >= 1 and day > 7 and CityRumorsHeardToday['legare_amanda'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'legare_amanda'
            CityRumorAvailCount += 1
        end

        if (CityRumorReady['stefan_donation'] = 1 or CityRumorsChurchScore >= 2) and (PlayerChurchDonationTotal > 0 or ChurchDonationDone >= 1) and CityRumorsHeardToday['stefan_donation'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'stefan_donation'
            CityRumorAvailCount += 1
        end

        if (IngaRumorDays_Lucas > 0 or IngaLucasRelation >= 1 or CityRumorReady['inga_lucas'] = 1) and FridayDancesCount >= 1 and day > 5 and CityRumorsHeardToday['inga_lucas'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'inga_lucas'
            CityRumorAvailCount += 1
        end

        if (IngaRumorDays_Stefan > 0 or IngaBackroomSex = 1) and CityRumorsHeardToday['inga_stefan'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'inga_stefan'
            CityRumorAvailCount += 1
        end

        if (IngaRumorDays_Guard > 0 or IngaGuardResolved > 0) and CityRumorsHeardToday['inga_guard'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'inga_guard'
            CityRumorAvailCount += 1
        end

        if (IngaRumorDays_Window > 0 or IngaNightStefanDone = 1) and CityRumorsHeardToday['inga_window_night'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'inga_window_night'
            CityRumorAvailCount += 1
        end

        if (IngaRumorDays_LucasRoom > 0 or IngaLucasSoloCount >= 1) and CityRumorsHeardToday['inga_lucas_thursday'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'inga_lucas_thursday'
            CityRumorAvailCount += 1
        end

        if (IngaRumorDays_GuardBackroom > 0 or (IngaGuardLadderStage >= 1 and IngaGuardBribedExit = 0)) and CityRumorsHeardToday['inga_guard_backroom'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'inga_guard_backroom'
            CityRumorAvailCount += 1
        end

        if (IngaRumorDays_GuardMmj > 0 or IngaGuardMmjStage >= 1 or IngaGuardMmjDone = 1) and CityRumorsHeardToday['inga_mmj_guard_stefan'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'inga_mmj_guard_stefan'
            CityRumorAvailCount += 1
        end

        if (IngaRumorDays_AnalPurity > 0 or IngaStefanAnalDone = 1) and CityRumorsHeardToday['inga_temple_purity'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'inga_temple_purity'
            CityRumorAvailCount += 1
        end

        if PlayerIsNoble = 1 and CityRumorsHeardToday['stefan_noble_triumph'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'stefan_noble_triumph'
            CityRumorAvailCount += 1
        end

        if SecondCaravanResolved = 1 and CityRumorsHeardToday['orc_battle_triumph'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'orc_battle_triumph'
            CityRumorAvailCount += 1
        end

        if IrmaTreeRitualDone = 1 and CityRumorsHeardToday['tree_of_life_rumor'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'tree_of_life_rumor'
            CityRumorAvailCount += 1
        end

        if IrmaNightFittingDone = 1 and CityRumorsHeardToday['irma_stefan_night'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'irma_stefan_night'
            CityRumorAvailCount += 1
        end

        if (IngaAtIrmaShop = 1 or IngaIrmaBond >= 5) and CityRumorsHeardToday['irma_inga_apprentice'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'irma_inga_apprentice'
            CityRumorAvailCount += 1
        end

        if (PlayerHasWarehouseKeys = 1 or PlayerHasWeaponShipmentInvoice = 1) and CityRumorsHeardToday['warehouse_breakin'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'warehouse_breakin'
            CityRumorAvailCount += 1
        end

        if (MercenaryAlive = 1 or GerhardHonorablePath = 1 or GerhardProtectingWitness = 1) and CityRumorsHeardToday['saved_mercenary'] = 0:
            $CityRumorAvailPool[CityRumorAvailCount] = 'saved_mercenary'
            CityRumorAvailCount += 1
        end

        if CityRumorAvailCount > 0:
            CityRumorPickIdx = RAND(0, CityRumorAvailCount - 1)
            $CityRumorPickedKey = $CityRumorAvailPool[CityRumorPickIdx]
        else:
            if RAND(1, 2) = 1:
                $CityRumorPickedKey = 'lermont_legacy'
            else:
                $CityRumorPickedKey = 'taro_powder'
            end
        end

        killvar '$CityRumorAvailPool'
        killvar 'CityRumorAvailCount'
        killvar 'CityRumorPickIdx'
    end

    CityRumorsHeardToday[$CityRumorPickedKey] = 1
    CityRumorsDailyCount += 1
    CityRumorsSeed += 1
    CityRumorTotal += 1

    ! Влияние сплетен на тревогу Сандры (меньше надлома, затухание при росте разврата)
    if $CityRumorPickedKey = 'tavern_scandal' or $CityRumorPickedKey = 'kitchen_sandra' or $CityRumorPickedKey = 'girls_behavior' or $CityRumorPickedKey = 'legare_amanda' or $CityRumorPickedKey = 'inga_stefan' or $CityRumorPickedKey = 'inga_window_night' or $CityRumorPickedKey = 'inga_mmj_guard_stefan':
        if CityRumorsDailyConcernGiven <> day:
            CityRumorsDailyConcernGiven = day
            if FamilyCorruptionStage < 4:
                SandraFamilyConcern += 1
            else:
                if SandraFamilyConcern > 0:
                    SandraFamilyConcern = 0
                end
            end
        end
    end
---

#CityRumorsGetText
    ! ARGS[0] = $Context ('church', 'becky', 'port', 'hall')
    ! ARGS[1] = $Key (опционально, если пусто — вызывает CityRumorsPickKey)
    $CityRumorsContext = LCASE($ARGS[0])
    $CityRumorsTargetKey = LCASE($ARGS[1])

    if $CityRumorsContext = '':
        $CityRumorsContext = 'church'
    end

    if $CityRumorsTargetKey = '':
        gs 'CityRumorsPickKey'
        $CityRumorsTargetKey = $CityRumorPickedKey
    end

    $CityRumorText = ''
    gs 'CityRumorsText', $CityRumorsTargetKey, $CityRumorsContext

    killvar '$CityRumorsContext'
    killvar '$CityRumorsTargetKey'
---
