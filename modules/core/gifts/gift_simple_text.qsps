! ================================================
! FILE: modules/core/gifts/gift_simple_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! Агентам: НЕ переписывать prose без явного «можно править тексты».
! Перед любой переделкой файла — спросить пользователя; сохранять формулировки.
! MODULE: core/gifts
! Нарратив и реплики упрощённых подарков
! ================================================

#GiftSimpleNarrative
    gs 'NormalizeGirlKey', $ARGS[0]
    $GiftNarrGirl = $GirlKey
    $GiftNarrId = LCASE($ARGS[1])
    $GiftNarrativeText = ''

    if $GiftNarrId = 'gift_cheap':
        if $GiftNarrGirl = 'sandra':
            $GiftNarrativeText = 'Вы подарили маме специю для кухни.'
        elseif $GiftNarrGirl = 'amanda':
            $GiftNarrativeText = 'Вы подарили сестре косметику.'
        elseif $GiftNarrGirl = 'melissa':
            $GiftNarrativeText = 'Вы подарили сестре книгу.'
        elseif $GiftNarrGirl = 'becky':
            $GiftNarrativeText = 'Вы подарили семена для огорода.'
        elseif $GiftNarrGirl = 'inga':
            $GiftNarrativeText = 'Вы подарили красивый бисер.'
        elseif $GiftNarrGirl = 'irma':
            $GiftNarrativeText = 'Вы подарили эльфийскую мазь.'
        elseif $GiftNarrGirl = 'clarissa':
            $GiftNarrativeText = 'Вы подарили маленький флакон со снадобьем.'
        else:
            $GiftNarrativeText = 'Вы подарили обычный подарок.'
        end
    elseif $GiftNarrId = 'gift_expensive':
        if $GiftNarrGirl = 'sandra':
            $GiftNarrativeText = 'Вы подарили маме кухонную утварь.'
        elseif $GiftNarrGirl = 'amanda':
            $GiftNarrativeText = 'Вы подарили блестящую безделушку.'
        elseif $GiftNarrGirl = 'melissa':
            $GiftNarrativeText = 'Вы подарили Мелиссе дорогой книжный аксессуар.'
        elseif $GiftNarrGirl = 'becky':
            $GiftNarrativeText = 'Вы подарили хороший садовый инструмент.'
        elseif $GiftNarrGirl = 'inga':
            $GiftNarrativeText = 'Вы подарили отрез ткани.'
        elseif $GiftNarrGirl = 'irma':
            $GiftNarrativeText = 'Вы подарили эльфийскую безделушку.'
        elseif $GiftNarrGirl = 'clarissa':
            $GiftNarrativeText = 'Вы подарили блестящую безделушку.'
        else:
            $GiftNarrativeText = 'Вы подарили дорогой подарок.'
        end
    end

    killvar '$GiftNarrGirl'
    killvar '$GiftNarrId'
---

#GiftSimpleReactionText
    gs 'NormalizeGirlKey', $ARGS[0]
    $GiftReactGirl = $GirlKey
    $GiftReactId = LCASE($ARGS[1])
    GiftReactStreak = ARGS[2]
    $GiftReactionText = ''

    if $GiftReactId = 'gift_cheap' and GiftReactStreak >= 2:
        if $GiftReactGirl = 'sandra':
            $GiftReactionText = 'Сандра принимает второй свёрток и смотрит на вас прищуренно.<br><br>— Стефан… Ты сегодня что, меня задобрить решил? Или вину отрабатываешь?'
        elseif $GiftReactGirl = 'amanda':
            $GiftReactionText = 'Аманда хмыкает и крутит упаковку в руках.<br><br>— Опять? Стефан, ты сегодня хочешь меня задобрить — или просто скупой вниманием разбрасываешься?'
        elseif $GiftReactGirl = 'melissa':
            $GiftReactionText = 'Мелисса вздыхает с театральной сдержанностью.<br><br>— Два раза за день… Стефан, ты меня задобрить решил или в зале накосячил?'
        elseif $GiftReactGirl = 'becky':
            $GiftReactionText = 'Бекки смеётся и тычет пальцем в вашу грудь.<br><br>— Опять, милый? Сегодня что — задобрить вдову или совесть чистишь?'
        elseif $GiftReactGirl = 'inga':
            $GiftReactionText = 'Инга смотрит на второй подарок и чуть краснеет.<br><br>— Стефан… Два за день. Ты меня задобрить хочешь?'
        elseif $GiftReactGirl = 'irma':
            $GiftReactionText = 'Ирма поднимает бровь.<br><br>— Второй раз сегодня. Задобрить решили — или просто запасаетесь на всех сразу?'
        elseif $GiftReactGirl = 'clarissa':
            $GiftReactionText = 'Кларисса усмехается уголком губ.<br><br>— Ещё один, Стефан? Сегодня явно хотите меня задобрить. Муж бы оценил… если бы увидел счёт, а не флаконы.'
        else:
            $GiftReactionText = $RealName[$GiftReactGirl] + ' смотрит на второй подарок за день и усмехается.<br><br>— Сегодня вы явно меня задобрить решили?'
        end

        killvar '$GiftReactGirl'
        killvar '$GiftReactId'
        killvar 'GiftReactStreak'
        exit
    end

    if $GiftReactId = 'gift_cheap':
        if $GiftReactGirl = 'sandra':
            $GiftReactionText = 'Сандра кивает с сухой усмешкой.<br><br>— Специя. На кухню — куда и надо. Спасибо, Стефан.'
        elseif $GiftReactGirl = 'amanda':
            $GiftReactionText = 'Аманда примеряет косметику на запястье и усмехается.<br><br>— О, для зала сгодится. Спасибо — не думай, что купил меня… хотя почти.'
        elseif $GiftReactGirl = 'melissa':
            $GiftReactionText = 'Мелисса прижимает книгу к груди.<br><br>— Спасибо. Прочту ночью. Без Аманды за спиной.'
        elseif $GiftReactGirl = 'becky':
            $GiftReactionText = 'Бекки хохочет и тычет в пакет с семенами.<br><br>— В огород — правильно. Спасибо, милый.'
        elseif $GiftReactGirl = 'inga':
            $GiftReactionText = 'Инга рассыпает бисер на ладонь и тихо улыбается.<br><br>— Красиво. Спасибо. Придумаю, куда пришить.'
        elseif $GiftReactGirl = 'irma':
            $GiftReactionText = 'Ирма нюхает мазь и кивает профессионально.<br><br>— Эльфийская работа. Спасибо.'
        elseif $GiftReactGirl = 'clarissa':
            $GiftReactionText = 'Кларисса прячет флакон под прилавок и смотрит на вас с ухмылкой.<br><br>— Спасибо. Муж после такого будет крепче спать. А я — не спрашивать, куда делась.'
        else:
            $GiftReactionText = $RealName[$GiftReactGirl] + ' благодарит за подарок.'
        end
    elseif $GiftReactId = 'gift_expensive':
        if GirlConflictUntilDay[$GiftReactGirl] >= day:
            if $GiftReactGirl = 'sandra':
                $GiftReactionText = 'Сандра долго молчит, потом кивает.<br><br>— Хорошая утварь. Вижу, что думал. Ссора не исчезает сама — но ты шаг сделал.'
            elseif $GiftReactGirl = 'amanda':
                $GiftReactionText = 'Аманда берёт безделушку осторожно.<br><br>— Старый ты хрен… Думаешь, блеском всё исправишь? — Пальцы всё равно сжимают подарок крепче. — Ладно. Спасибо.'
            elseif $GiftReactGirl = 'melissa':
                $GiftReactionText = 'Мелисса смотрит на аксессуар и выдыхает.<br><br>— Хочешь купить прощение? Вещь выбрана слишком точно… Спасибо, Стефан.'
            elseif $GiftReactGirl = 'becky':
                $GiftReactionText = 'Бекки прижимает инструмент и улыбается тепло.<br><br>— Ох, милый… Вот это уже серьёзно. Спасибо.'
            elseif $GiftReactGirl = 'inga':
                $GiftReactionText = 'Инга гладит ткань и краснеет.<br><br>— Отрез хороший… Спасибо. Запомню.'
            elseif $GiftReactGirl = 'irma':
                $GiftReactionText = 'Ирма рассматривает безделушку долго и ровно.<br><br>— У эльфов рука лёгкая. Спасибо — история у вещи уже есть.'
            elseif $GiftReactGirl = 'clarissa':
                $GiftReactionText = 'Кларисса принимает подарок сдержанно.<br><br>— Без лишнего шума — редкость. Спасибо, Стефан.'
            else:
                $GiftReactionText = $RealName[$GiftReactGirl] + ' принимает дорогой подарок, и в её взгляде становится меньше холода.'
            end
        else:
            if $GiftReactGirl = 'sandra':
                $GiftReactionText = 'Сандра проверяет утварь и кивает с уважением.<br><br>— Рабочая вещь. Спасибо — ты хоть в кухне понимаешь, что ценится.'
            elseif $GiftReactGirl = 'amanda':
                $GiftReactionText = 'Аманда загорается, как от корабельного блеска.<br><br>— Вот это да! Спасибо, Стефан — теперь в зале точно посмотрят.'
            elseif $GiftReactGirl = 'melissa':
                $GiftReactionText = 'Мелисса прижимает аксессуар к книге и чуть улыбается.<br><br>— Для королевы в голове — самое то. Спасибо.'
            elseif $GiftReactGirl = 'becky':
                $GiftReactionText = 'Бекки обнимает вас за плечи.<br><br>— Ого, милый! Инструмент — это ты серьёзно. Спасибо.'
            elseif $GiftReactGirl = 'inga':
                $GiftReactionText = 'Инга разворачивает отрез и шепчет:<br><br>— Шёлк ложится иначе… Спасибо, Стефан.'
            elseif $GiftReactGirl = 'irma':
                $GiftReactionText = 'Ирма кивает профессионально.<br><br>— Красиво. Спасибо — у каждой вещи должна быть история.'
            elseif $GiftReactGirl = 'clarissa':
                $GiftReactionText = 'Кларисса убирает безделушку под полку.<br><br>— Спасибо. В лавке лишние глаза — не место для восторгов, но жест ваш помню.'
            else:
                $GiftReactionText = $RealName[$GiftReactGirl] + ' принимает дорогой подарок с искренней благодарностью.'
            end
        end
    end

    killvar '$GiftReactGirl'
    killvar '$GiftReactId'
    killvar 'GiftReactStreak'
---

#GiftSimpleRegisterGive
    gs 'NormalizeGirlKey', $ARGS[0]
    $GiftRegGirl = $GirlKey
    $GiftRegId = LCASE($ARGS[1])
    GiftCheapStreakToday = 1

    if $GiftRegId = 'gift_cheap':
        if GirlGiftCheapStampDay[$GiftRegGirl] <> day:
            GirlGiftCheapStampDay[$GiftRegGirl] = day
            GirlGiftCheapTodayCount[$GiftRegGirl] = 0
        end

        GirlGiftCheapTodayCount[$GiftRegGirl] += 1
        GiftCheapStreakToday = GirlGiftCheapTodayCount[$GiftRegGirl]
    end

    killvar '$GiftRegGirl'
    killvar '$GiftRegId'
---