! ================================================
! FILE: modules/core/gifts/gift_shop_menus.qsps
! MODULE: core/gifts
! Лавка подарков на рынке — заглушка (подарки только у корабля)
! ================================================

#MarketGiftStall
    cls

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' ЛАВКА ПОДАРКОВ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    *p 'Прилавок пустует: торговец переехал к кораблю из столицы. Подарки покупают только у причала, когда столица пришвартована.'
    *pl ' '

    act '<b>Назад на рынок</b>', 'images/common/ui/actions/return.png':
        gt 'Market'
    end
---