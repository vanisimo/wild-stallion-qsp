! ================================================
! FILE: modules/core/gifts/gift_registry.qsps
! MODULE: core/gifts
! Упрощённые подарки: обычный и дорогой (только корабль)
! ================================================

#InitGiftInventory
    GiftInventory['gift_cheap'] = 0
    GiftInventory['gift_expensive'] = 0

    GiftInventoryMaxCheap = 2
    GiftInventoryMaxExpensive = 1
    GiftCheapPrice = 42
    GiftExpensivePrice = 78

    GiftShipPurchaseWeek = 0
    GiftShipWeekBoughtCheap = 0
    GiftShipWeekBoughtExpensive = 0

    PortGiftBoughtTotal = 0
---

#GiftShipWeekEnsure
    if GiftShipPurchaseWeek <> week:
        GiftShipPurchaseWeek = week
        GiftShipWeekBoughtCheap = 0
        GiftShipWeekBoughtExpensive = 0
    end
---

#GiftInventoryTotal
    GiftInventoryTotal = GiftInventory['gift_cheap'] + GiftInventory['gift_expensive']
---

#GiftRegistryResolve
    $GiftRegistryId = LCASE($ARGS[0])
    GiftRegistryPrice = 0
    GiftRegistryKnown = 0
    $GiftRegistryAccusative = ''
    $GiftRegistryLabel = ''

    if $GiftRegistryId = 'gift_cheap':
        GiftRegistryPrice = GiftCheapPrice
        $GiftRegistryAccusative = 'обычный подарок'
        $GiftRegistryLabel = 'Обычный подарок'
        GiftRegistryKnown = 1
    elseif $GiftRegistryId = 'gift_expensive':
        GiftRegistryPrice = GiftExpensivePrice
        $GiftRegistryAccusative = 'дорогой подарок'
        $GiftRegistryLabel = 'Дорогой подарок'
        GiftRegistryKnown = 1
    end

    killvar '$GiftRegistryId'
---

#GiftCanBuyCheap
    GiftCanBuyCheap = 0
    $GiftCanBuyReason = ''

    gs 'GiftShipWeekEnsure'

    if GiftInventory['gift_cheap'] >= GiftInventoryMaxCheap:
        $GiftCanBuyReason = 'В сумке уже два обычных подарка — некуда класть новый.'
        exit
    end

    if GiftShipWeekBoughtCheap >= GiftInventoryMaxCheap:
        $GiftCanBuyReason = 'На этой неделе вы уже купили два обычных подарка у корабля. Приходите, когда корабль снова пришвартован.'
        exit
    end

    GiftCanBuyCheap = 1
---

#GiftCanBuyExpensive
    GiftCanBuyExpensive = 0
    $GiftCanBuyReason = ''

    gs 'GiftShipWeekEnsure'

    if GiftInventory['gift_expensive'] >= GiftInventoryMaxExpensive:
        $GiftCanBuyReason = 'В сумке уже лежит дорогой подарок.'
        exit
    end

    if GiftShipWeekBoughtExpensive >= GiftInventoryMaxExpensive:
        $GiftCanBuyReason = 'На этой неделе дорогой подарок у корабля уже куплен. До следующего прихода корабля.'
        exit
    end

    GiftCanBuyExpensive = 1
---

#GiftTryPurchase
    GiftPurchaseOk = 0
    $GiftPurchaseId = LCASE($ARGS[0])
    $GiftPurchaseMessage = ''

    gs 'GiftRegistryResolve', $GiftPurchaseId

    if GiftRegistryKnown = 0:
        $GiftPurchaseMessage = 'Такого товара у торговца нет.'
        killvar '$GiftPurchaseId'
        killvar 'GiftRegistryPrice'
        killvar 'GiftRegistryKnown'
        killvar '$GiftRegistryAccusative'
        killvar '$GiftRegistryLabel'
        exit
    end

    if $GiftPurchaseId = 'gift_cheap':
        gs 'GiftCanBuyCheap'

        if GiftCanBuyCheap = 0:
            $GiftPurchaseMessage = $GiftCanBuyReason
            killvar '$GiftCanBuyReason'
            killvar '$GiftPurchaseId'
            killvar 'GiftRegistryPrice'
            killvar 'GiftRegistryKnown'
            killvar '$GiftRegistryAccusative'
            killvar '$GiftRegistryLabel'
            exit
        end
    elseif $GiftPurchaseId = 'gift_expensive':
        gs 'GiftCanBuyExpensive'

        if GiftCanBuyExpensive = 0:
            $GiftPurchaseMessage = $GiftCanBuyReason
            killvar '$GiftCanBuyReason'
            killvar '$GiftPurchaseId'
            killvar 'GiftRegistryPrice'
            killvar 'GiftRegistryKnown'
            killvar '$GiftRegistryAccusative'
            killvar '$GiftRegistryLabel'
            exit
        end
    end

    if money < GiftRegistryPrice:
        $GiftPurchaseMessage = 'Вам не хватает денег на ' + $GiftRegistryAccusative + '.'
    else:
        money -= GiftRegistryPrice
        GiftInventory[$GiftPurchaseId] += 1
        PortGiftBoughtTotal += 1

        if $GiftPurchaseId = 'gift_cheap':
            GiftShipWeekBoughtCheap += 1
        elseif $GiftPurchaseId = 'gift_expensive':
            GiftShipWeekBoughtExpensive += 1
        end

        $GiftPurchaseMessage = 'Вы покупаете ' + $GiftRegistryAccusative + '. Торговец заворачивает покупку и отдаёт вам на вынос.'
        GiftPurchaseOk = 1
    end

    killvar '$GiftCanBuyReason'
    killvar '$GiftPurchaseId'
    killvar 'GiftRegistryPrice'
    killvar 'GiftRegistryKnown'
    killvar '$GiftRegistryAccusative'
    killvar '$GiftRegistryLabel'
---

#GiftHasAnyInInventory
    GiftHasAny = 0

    if GiftInventory['gift_cheap'] > 0 or GiftInventory['gift_expensive'] > 0:
        GiftHasAny = 1
    end
---

#GiftBagPanelLine
    $GiftBagLineId = LCASE($ARGS[0])

    if GiftInventory[$GiftBagLineId] > 0:
        gs 'GiftRegistryResolve', $GiftBagLineId
        gs 'PanelUiLine', $GiftRegistryLabel + ' — ' + STR(GiftInventory[$GiftBagLineId]) + ' шт.'
        killvar 'GiftRegistryPrice'
        killvar 'GiftRegistryKnown'
        killvar '$GiftRegistryAccusative'
        killvar '$GiftRegistryLabel'
    end

    killvar '$GiftBagLineId'
---

#GiftGirlCanReceive
    gs 'NormalizeGirlKey', $ARGS[0]
    $GiftReceiveGirl = $GirlKey
    GiftGirlCanReceive = 0

    if $GiftReceiveGirl = 'sandra' or $GiftReceiveGirl = 'amanda' or $GiftReceiveGirl = 'melissa' or $GiftReceiveGirl = 'becky' or $GiftReceiveGirl = 'inga' or $GiftReceiveGirl = 'irma' or $GiftReceiveGirl = 'clarissa':
        GiftGirlCanReceive = 1
    end

    killvar '$GiftReceiveGirl'
---

#MenuGirlGiftAddShelfActs
    $MenuGiftShelfGirl = $ARGS[0]
    $MenuGiftShelfReturn = $ARGS[1]

    gs 'MenuGirlGiftTryAct', 'gift_cheap', $MenuGiftShelfGirl, $MenuGiftShelfReturn
    gs 'MenuGirlGiftTryAct', 'gift_expensive', $MenuGiftShelfGirl, $MenuGiftShelfReturn

    killvar '$MenuGiftShelfGirl'
    killvar '$MenuGiftShelfReturn'
---

#MenuGirlGiftTryAct
    $MenuGiftActId = LCASE($ARGS[0])
    $MenuGiftActGirl = $ARGS[1]
    $MenuGiftActReturn = $ARGS[2]

    if GiftInventory[$MenuGiftActId] > 0:
        gs 'MenuGirlGiftName', $MenuGiftActId
        act $GiftName + ' (' + STR(GiftInventory[$MenuGiftActId]) + ')':
            gt 'MenuGirlGiftGive', $MenuGiftActGirl, $MenuGiftActReturn, $MenuGiftActId
        end
    end

    killvar '$MenuGiftActId'
    killvar '$MenuGiftActGirl'
    killvar '$MenuGiftActReturn'
---

#GiftDebugAddAll
    GiftInventory['gift_cheap'] = GiftInventoryMaxCheap
    GiftInventory['gift_expensive'] = GiftInventoryMaxExpensive
---

#PortCapitalShipGiftActs
    $PortGiftReturnLoc = $ARGS[0]

    if $PortGiftReturnLoc = '':
        $PortGiftReturnLoc = 'Port'
    end

    gs 'GiftShipWeekEnsure'
    gs 'GiftInventoryTotal'

    gs 'FormatSpintry', money
    $FormatSpintry_money = $FormatSpintry
    killvar '$FormatSpintry'
    *pl 'Деньги: ' + $FormatSpintry_money + '.'
    *pl 'В сумке: обычных ' + STR(GiftInventory['gift_cheap']) + ' / ' + STR(GiftInventoryMaxCheap) + ', дорогих ' + STR(GiftInventory['gift_expensive']) + ' / ' + STR(GiftInventoryMaxExpensive) + '.'
    *pl 'На этой неделе куплено у корабля: обычных ' + STR(GiftShipWeekBoughtCheap) + ' / ' + STR(GiftInventoryMaxCheap) + ', дорогих ' + STR(GiftShipWeekBoughtExpensive) + ' / ' + STR(GiftInventoryMaxExpensive) + '.'
    *pl ' '

    if $PortGiftShopMessage <> '':
        *p $PortGiftShopMessage
        *pl ' '
        killvar '$PortGiftShopMessage'
    end

    gs 'GiftCanBuyCheap'

    if GiftCanBuyCheap = 1:
        gs 'FormatSpintry', GiftCheapPrice
        $FormatSpintry_GiftCheapPrice = $FormatSpintry
        killvar '$FormatSpintry'
        act '<b>Обычный подарок (' + $FormatSpintry_GiftCheapPrice + ')</b>', 'images/common/ui/actions/gift.png':
            gs 'GiftTryPurchase', 'gift_cheap'
            $PortGiftShopMessage = $GiftPurchaseMessage
            killvar 'GiftPurchaseOk'
            killvar '$GiftPurchaseMessage'
            gt 'PortCapitalShipMenu', $PortGiftReturnLoc
        end
    end

    killvar 'GiftCanBuyCheap'
    killvar '$GiftCanBuyReason'

    gs 'GiftCanBuyExpensive'

    if GiftCanBuyExpensive = 1:
        gs 'FormatSpintry', GiftExpensivePrice
        $FormatSpintry_GiftExpensivePrice = $FormatSpintry
        killvar '$FormatSpintry'
        act '<b>Дорогой подарок (' + $FormatSpintry_GiftExpensivePrice + ')</b>', 'images/common/ui/actions/gift.png':
            gs 'GiftTryPurchase', 'gift_expensive'
            $PortGiftShopMessage = $GiftPurchaseMessage
            killvar 'GiftPurchaseOk'
            killvar '$GiftPurchaseMessage'
            gt 'PortCapitalShipMenu', $PortGiftReturnLoc
        end
    end

    killvar 'GiftCanBuyExpensive'
    killvar '$GiftCanBuyReason'
    killvar '$PortGiftReturnLoc'
---