#GirlIntimSessionBegin
    GirlIntimSessionActive = 1
---

#GirlIntimSessionEnd
    GirlIntimSessionActive = 0
    IntimSessionActive = 0
    $IntimSessionGirl = ''
    $IntimSessionLoc = ''
    IntimForeplayDone = 0
    IntimPlayerOrgasmCount = 0
    IntimMaxOrgasmCount = 0
---

#GirlIntimMenuReturn
    $GirlIntimMenuReturnLoc = $IntimReturnLoc

    if $GirlIntimMenuReturnLoc = '':
        $GirlIntimMenuReturnLoc = $CURLOC
    end

    if $GirlIntimMenuReturnLoc = '':
        $GirlIntimMenuReturnLoc = 'TavernMain'
    end

    if LOC($GirlIntimMenuReturnLoc) = 0:
        $GirlIntimMenuReturnLoc = 'TavernMain'
    end

    gs 'GirlIntimSessionEnd'

    if $CURLOC = $GirlIntimMenuReturnLoc:
        killvar '$GirlIntimMenuReturnLoc'
        exit
    end

    gt $GirlIntimMenuReturnLoc
    killvar '$GirlIntimMenuReturnLoc'
---

#GirlIntimCountMenuOptions
    GirlIntimOptionCount = 0
    gs 'NormalizeGirlKey', $ARGS[0]
    $IntimOptGirl = $GirlKey
    $IntimOptLoc = $ARGS[1]

    if $IntimOptGirl = '':
        killvar '$IntimOptGirl'
        killvar '$IntimOptLoc'
        exit
    end

    if $IntimOptLoc = '':
        $IntimOptLoc = $CURLOC
    end

    if $IntimOptGirl = 'amanda' and $IntimOptLoc = 'AmandaRoom':
        gs 'AmandaLizaRoomDoorCanShow'
        if AmandaLizaRoomDoorCanShow = 1:
            killvar 'AmandaLizaRoomDoorCanShow'
            killvar '$IntimOptGirl'
            killvar '$IntimOptLoc'
            exit
        end
        killvar 'AmandaLizaRoomDoorCanShow'

        if AmandaHomeUnlocked = 1:
            gs 'AmandaHomeCanAdvance'
            if AmandaHomeCanAdvance = 1 and AmandaHomeStage < 6:
                GirlIntimOptionCount += 1
            end
            killvar 'AmandaHomeCanAdvance'

            gs 'AmandaHomeFirstSexCanStart'
            if AmandaHomeFirstSexCanStart = 1:
                GirlIntimOptionCount += 1
            end
            killvar 'AmandaHomeFirstSexCanStart'

            if AmandaHomeSex = 1 and LOC('SexSceneStart') = 1 and time >= 3:
                gs 'CanStartSexScene', 'amanda'
                if SexSceneAllowed = 1:
                    GirlIntimOptionCount += 1
                end
                killvar 'SexSceneAllowed'
                killvar '$SexSceneDenyReason'
            end

            if LOC('AmandaHomeAnalCanTalk') = 1:
                gs 'AmandaHomeAnalCanTalk'
                if AmandaHomeAnalCanTalk = 1:
                    GirlIntimOptionCount += 1
                end
                killvar 'AmandaHomeAnalCanTalk'
            end

            if LOC('AmandaHomeAnalStefanCanStart') = 1:
                gs 'AmandaHomeAnalStefanCanStart'
                if AmandaHomeAnalStefanCanStart = 1:
                    GirlIntimOptionCount += 1
                end
                killvar 'AmandaHomeAnalStefanCanStart'
            end

            if GirlIntimOptionCount = 0 and AmandaHomeSex = 0 and AmandaHomeStage >= 6 and AmandaHomeStage <= 11 and AmandaHomeStepToday = 1:
                GirlIntimOptionCount += 1
            end

            if MelissaHomeSex = 1 and LOC('AmandaMelissaThreesomeCanStart') = 1:
                gs 'AmandaMelissaThreesomeCanStart'
                if AmandaMelissaThreesomeCanStart = 1:
                    GirlIntimOptionCount += 1
                end
            end
        end

    elseif $IntimOptGirl = 'melissa' and $IntimOptLoc = 'MelissaRoom':
        if MelissaHomeUnlocked = 1:
            gs 'MelissaHomeCanAdvance'
            if MelissaHomeCanAdvance = 1 and MelissaHomeStage < 6:
                GirlIntimOptionCount += 1
            end
            killvar 'MelissaHomeCanAdvance'

            if MelissaHomeStage >= 6 and MelissaHomeSex = 0 and MelissaHomeStepToday = 0 and time >= 3:
                GirlIntimOptionCount += 1
            end

            if MelissaHomeSex = 1 and LOC('SexSceneStart') = 1 and time >= 3:
                gs 'CanStartSexScene', 'melissa'
                if SexSceneAllowed = 1:
                    GirlIntimOptionCount += 1
                end
                killvar 'SexSceneAllowed'
                killvar '$SexSceneDenyReason'
            end

            if LOC('MelissaHomeAnalCanStart') = 1:
                gs 'MelissaHomeAnalCanStart'
                if MelissaHomeAnalStepAvailable = 1:
                    GirlIntimOptionCount += 1
                end
                killvar 'MelissaHomeAnalStepAvailable'
                killvar '$MelissaHomeAnalMenuLabel'
                killvar '$MelissaHomeAnalMenuTarget'
            end

            if LOC('MelissaAnalDiscoveryCanAdvance') = 1:
                gs 'MelissaAnalDiscoveryCanAdvance'
                if MelissaAnalDiscoveryCanAdvance = 1:
                    GirlIntimOptionCount += 1
                end
            end

            if LOC('MelissaAnalWithGgCanStart') = 1:
                gs 'MelissaAnalWithGgCanStart'
                if MelissaAnalWithGgCanStart = 1:
                    GirlIntimOptionCount += 1
                end
            end

            if AmandaHomeSex = 1 and LOC('AmandaMelissaThreesomeCanStart') = 1:
                gs 'AmandaMelissaThreesomeCanStart'
                if AmandaMelissaThreesomeCanStart = 1:
                    GirlIntimOptionCount += 1
                end
            end
        end

    elseif $IntimOptGirl = 'sandra' and $IntimOptLoc = 'SandraRoom':
        if SandraHomeUnlocked = 1:
            gs 'SandraHomeCanAdvance'
            if SandraHomeCanAdvance = 1 and SandraHomeStage < 12:
                GirlIntimOptionCount += 1
            end
            killvar 'SandraHomeCanAdvance'

            if SandraHomeStage >= 12 and SandraHomeSex = 0 and SandraHomeStepToday = 0 and time >= 4:
                GirlIntimOptionCount += 1
            end

            if SandraHomeSex = 1 and LOC('SexSceneStart') = 1 and time >= 4:
                gs 'CanStartSexScene', 'sandra'
                if SexSceneAllowed = 1:
                    GirlIntimOptionCount += 1
                end
                killvar 'SexSceneAllowed'
                killvar '$SexSceneDenyReason'
            end
        end

    else:
        if $IntimOptGirl = 'amanda' and AmandaHomeSex = 0:
            killvar '$IntimOptGirl'
            killvar '$IntimOptLoc'
            exit
        end
        if $IntimOptGirl = 'melissa' and MelissaHomeSex = 0:
            killvar '$IntimOptGirl'
            killvar '$IntimOptLoc'
            exit
        end
        if $IntimOptGirl = 'sandra' and SandraHomeSex = 0:
            killvar '$IntimOptGirl'
            killvar '$IntimOptLoc'
            exit
        end

        if LOC('SexSceneStart') = 1:
            gs 'CanStartSexScene', $IntimOptGirl
            if SexSceneAllowed = 1:
                GirlIntimOptionCount += 1
            end
            killvar 'SexSceneAllowed'
            killvar '$SexSceneDenyReason'
        end
    end

    killvar '$IntimOptGirl'
    killvar '$IntimOptLoc'
---

#GirlIntimCheckNpcLinkAvailable
    GirlIntimMenuReady = 0

    gs 'NormalizeGirlKey', $ARGS[0]
    $IntimGirl = $GirlKey
    $IntimReturnLoc = $ARGS[1]

    if $IntimGirl = '':
        killvar '$IntimGirl'
        killvar '$IntimReturnLoc'
        exit
    end

    if $IntimReturnLoc = '':
        $IntimReturnLoc = $CURLOC
    end

    if $IntimReturnLoc = '':
        $IntimReturnLoc = 'TavernMain'
    end

    if LOC($IntimReturnLoc) = 0:
        $IntimReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $IntimGirl
    gs 'MenuGirlCalcConditions', $IntimGirl, $IntimReturnLoc

    if MenuCanIntim = 0:
        exit
    end

    gs 'CanCumToday'

    if PlayerCanCumToday = 0 and debug = 0:
        exit
    end

    if SexUsedToday[$IntimGirl] = 1:
        exit
    end

    gs 'GirlIntimCountMenuOptions', $IntimGirl, $IntimReturnLoc
    if GirlIntimOptionCount <= 0:
        killvar 'GirlIntimOptionCount'
        exit
    end
    killvar 'GirlIntimOptionCount'

    GirlIntimMenuReady = 1
---

#GirlIntimOpenNpcMenu
    gs 'NormalizeGirlKey', $ARGS[0]
    $IntimGirl = $GirlKey
    $IntimOpenMenuLoc = $ARGS[1]
    $IntimOpenReturnLoc = $ARGS[2]

    if $IntimGirl = '':
        exit
    end

    if $IntimOpenMenuLoc = '':
        $IntimOpenMenuLoc = $CURLOC
    end

    if $IntimOpenReturnLoc = '':
        $IntimOpenReturnLoc = $IntimOpenMenuLoc
    end

    if LOC($IntimOpenReturnLoc) = 0:
        $IntimOpenReturnLoc = 'TavernMain'
    end

    gs 'GirlIntimCheckNpcLinkAvailable', $IntimGirl, $IntimOpenMenuLoc

    if GirlIntimMenuReady = 0:
        killvar '$IntimOpenMenuLoc'
        killvar '$IntimOpenReturnLoc'
        exit
    end

    $IntimReturnLoc = $IntimOpenReturnLoc
    gs 'GirlIntimSessionBegin'
    gs 'GirlIntimInitSceneState', $IntimGirl, $IntimOpenMenuLoc
    gs 'GirlIntimBuildMainMenu'
    gs 'Menu.Show', 'GirlIntimMainMenu'

    killvar 'GirlIntimMenuReady'
    killvar '$IntimOpenMenuLoc'
    killvar '$IntimOpenReturnLoc'
---

#GirlIntimPrepareForNpcLink
    gs 'GirlIntimCheckNpcLinkAvailable', $ARGS[0], $ARGS[1]

    if GirlIntimMenuReady = 0:
        exit
    end

    gs 'GirlIntimSessionBegin'
    gs 'GirlIntimInitSceneState', $IntimGirl, $IntimReturnLoc
    gs 'GirlIntimBuildMainMenu'
---

#GirlIntimInitSceneState
    gs 'NormalizeGirlKey', $ARGS[0]
    $IntimStateGirl = $GirlKey
    $IntimStateLoc = $ARGS[1]

    if $IntimStateGirl = '':
        killvar '$IntimStateGirl'
        killvar '$IntimStateLoc'
        exit
    end

    if $IntimStateLoc = '':
        $IntimStateLoc = $CURLOC
    end

    if IntimSessionActive = 0 or $IntimSessionGirl <> $IntimStateGirl or $IntimSessionLoc <> $IntimStateLoc:
        IntimSessionActive = 1
        $IntimSessionGirl = $IntimStateGirl
        $IntimSessionLoc = $IntimStateLoc
        IntimForeplayDone = 0
        IntimPlayerOrgasmCount = 0
        IntimMaxOrgasmCount = 2 + RAND(0, 1)
    end

    killvar '$IntimStateGirl'
    killvar '$IntimStateLoc'
---

#GirlIntimBuildMainMenu
    gs 'Menu.Destroy', 'GirlIntimMainMenu'
    gs 'Menu.Create', 'GirlIntimMainMenu'

    if $IntimGirl = 'amanda' and $IntimSessionLoc = 'AmandaRoom':
        gs 'GirlIntimAddAmandaHomeMenu'
    elseif $IntimGirl = 'melissa' and $IntimSessionLoc = 'MelissaRoom':
        gs 'GirlIntimAddMelissaHomeMenu'
    elseif $IntimGirl = 'sandra' and $IntimSessionLoc = 'SandraRoom':
        gs 'GirlIntimAddSandraHomeMenu'
    else:
        gs 'GirlIntimAddGenericSexMenu'
    end
---

#GirlIntimAddAmandaHomeMenu
    $TargetMenu = $ARGS[0]
    if $TargetMenu = '':
        $TargetMenu = 'GirlIntimMainMenu'
    end

    AmandaHomeIntimMenuAdded = 0

    if AmandaHomeUnlocked = 1:
        gs 'AmandaHomeCanAdvance'

        if AmandaHomeCanAdvance = 1 and AmandaHomeStage < 6:
            gs 'MenuUiAdd', $TargetMenu, '???????? ????? ???????', 'intim'
            gs 'Menu.AddModule', $TargetMenu, {
                gt 'AmandaHomeStep'
            }
            AmandaHomeIntimMenuAdded = 1
        end

        gs 'AmandaHomeFirstSexCanStart'

        if AmandaHomeFirstSexCanStart = 1:
            gs 'AmandaHomeFirstSexMenuLabel'
            gs 'MenuUiAdd', $TargetMenu, $AmandaFirstSexMenuLabel, 'intim'
            gs 'Menu.AddModule', $TargetMenu, {
                gt 'AmandaHomeFirstSexLaunch'
            }
            killvar '$AmandaFirstSexMenuLabel'
            AmandaHomeIntimMenuAdded = 1
        end

        if AmandaHomeSex = 1 and LOC('SexSceneStart') = 1 and time >= 3:
            gs 'CanStartSexScene', 'amanda'

            if SexSceneAllowed = 1:
                gs 'MenuUiAdd', $TargetMenu, '???????? ?????', 'intim'
                gs 'Menu.AddModule', $TargetMenu, {
                    gt 'SexSceneStart', 'amanda', $IntimReturnLoc, 'amanda_repeat'
                }
                AmandaHomeIntimMenuAdded = 1
            end

            killvar 'SexSceneAllowed'
            killvar '$SexSceneDenyReason'
        end

        if LOC('AmandaHomeAnalCanTalk') = 1:
            gs 'AmandaHomeAnalCanTalk'
            if AmandaHomeAnalCanTalk = 1:
                gs 'MenuUiAdd', $TargetMenu, '?????????? ?? ????????? ????????', 'talk'
                gs 'Menu.AddModule', $TargetMenu, {
                    gt 'AmandaHomeAnalTalk'
                }
                AmandaHomeIntimMenuAdded = 1
            end
            killvar 'AmandaHomeAnalCanTalk'
        end

        if LOC('AmandaHomeAnalStefanCanStart') = 1:
            gs 'AmandaHomeAnalStefanCanStart'
            if AmandaHomeAnalStefanCanStart = 1:
                gs 'MenuUiAdd', $TargetMenu, '????????? ???????? (????? ??????????)', 'intim'
                gs 'Menu.AddModule', $TargetMenu, {
                    gt 'AmandaHomeAnalStefanLaunch'
                }
                AmandaHomeIntimMenuAdded = 1
            end
            killvar 'AmandaHomeAnalStefanCanStart'
        end

        if AmandaHomeIntimMenuAdded = 0 and AmandaHomeSex = 0 and AmandaHomeStage >= 6 and AmandaHomeStage <= 11 and AmandaHomeStepToday = 1:
            gs 'MenuUiAdd', $TargetMenu, '?? ??????? ??????????', 'talk'
            gs 'Menu.AddModule', $TargetMenu, {
                gs 'AmandaHomeAfterFirstSexTonightText'
                *p $AmandaHomeText
            }
            AmandaHomeIntimMenuAdded = 1
        end

        if MelissaHomeSex = 1 and LOC('AmandaMelissaThreesomeCanStart') = 1:
            gs 'AmandaMelissaThreesomeCanStart'

            if AmandaMelissaThreesomeCanStart = 1:
                gs 'MenuUiAdd', $TargetMenu, '????? ? ????????', 'intim'
                gs 'Menu.AddModule', $TargetMenu, {
                    gt 'GroupSexAmandaMelissaStefanStart'
                }
                AmandaHomeIntimMenuAdded = 1
            end
        end
    end

    killvar 'AmandaHomeIntimMenuAdded'
    killvar '$TargetMenu'
---

