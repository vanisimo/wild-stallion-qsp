! ================================================
! FILE: modules/core/girls/girl_room_outfit.qsps
! MODULE: core/girls
! Сцена девушки в личной комнате — одна цельная картинка
! Подпись с кликабельным именем: ShowGirlRoomPresence (girl_room_presence.qsps)
! Формат арта: 1024x576 landscape, комната + девушка на кровати
! Путь: images/locations/{girl}_room_{morning|day|night}_{nightgown|naked}_{pose}.webp
! outfit: GirlUniformLevel=0 → nightgown, =1 → naked
! ================================================

#ResolveGirlRoomOutfit
    $OutfitGirl = LCASE($ARGS[0])
    $GirlRoomOutfit = 'casual'

    if $OutfitGirl = '':
        killvar '$OutfitGirl'
        exit
    end

    if $OutfitGirl = 'amanda' or $OutfitGirl = 'melissa' or $OutfitGirl = 'sandra':
        if GirlUniformLevel[$OutfitGirl] = 1:
            $GirlRoomOutfit = 'naked'
        else:
            $GirlRoomOutfit = 'nightgown'
        end
    end

    killvar '$OutfitGirl'
---

#GetGirlRoomImageId
    $RoomIdGirl = LCASE($ARGS[0])
    $RoomIdPose = LCASE($ARGS[1])

    $GirlRoomImageId = ''

    if $RoomIdGirl = '':
        exit
    end

    if $RoomIdPose = '':
        $RoomIdPose = 'idle'
    end

    gs 'ResolveGirlRoomOutfit', $RoomIdGirl
    gs 'GetLocationTimeSuffix'

    $GirlRoomImageId = $RoomIdGirl + '_room_' + $LocImageTimeSuffix + '_' + $GirlRoomOutfit + '_' + $RoomIdPose

    killvar '$RoomIdGirl'
    killvar '$RoomIdPose'
    killvar '$GirlRoomOutfit'
    killvar '$LocImageTimeSuffix'
---

#ShowGirlRoomScene
    $RoomSceneGirl = LCASE($ARGS[0])
    $RoomScenePose = LCASE($ARGS[1])
    $RoomSceneSize = $ARGS[2]

    if $RoomSceneGirl = '':
        exit
    end

    if $RoomSceneSize = '':
        $RoomSceneSize = 'full'
    end

    if $RoomScenePose = '':
        $RoomScenePose = 'idle'
    end

    gs 'GetGirlRoomImageId', $RoomSceneGirl, $RoomScenePose
    $RoomSceneImageId = $GirlRoomImageId
    killvar '$GirlRoomImageId'

    if debug = 1:
        *pl '[DEBUG] GirlRoomScene: images/locations/' + $RoomSceneImageId + '.webp'
    end

    gs 'ShowImage', 'location', $RoomSceneImageId, '', '', 'webp', $RoomSceneSize

    killvar '$RoomSceneGirl'
    killvar '$RoomScenePose'
    killvar '$RoomSceneSize'
    killvar '$RoomSceneImageId'
---