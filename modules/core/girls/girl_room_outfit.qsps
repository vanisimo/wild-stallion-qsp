! ================================================
! FILE: modules/core/girls/girl_room_outfit.qsps
! MODULE: core/girls
! Сцена девушки в личной комнате (ночнушка / голая на кровати)
! Картинки: images/locations/{girl}_room_{time}_{outfit}_{pose}.webp
! ================================================

#ResolveGirlRoomOutfit
    $OutfitGirl = LCASE($ARGS[0])
    $GirlRoomOutfit = 'casual'

    if $OutfitGirl = '':
        killvar '$OutfitGirl'
        exit
    end

    if $OutfitGirl = 'amanda' or $OutfitGirl = 'melissa' or $OutfitGirl = 'sandra':
        if GirlUniformLevel[$OutfitGirl] = 1:
            $GirlRoomOutfit = 'naked'
        else:
            $GirlRoomOutfit = 'nightgown'
        end
    end

    killvar '$OutfitGirl'
---

#ShowGirlRoomScene
    $RoomSceneGirl = LCASE($ARGS[0])
    $RoomScenePose = LCASE($ARGS[1])
    $RoomSceneSize = $ARGS[2]

    if $RoomSceneGirl = '':
        exit
    end

    if $RoomSceneSize = '':
        $RoomSceneSize = 'full'
    end

    if $RoomScenePose = '':
        $RoomScenePose = 'idle'
    end

    gs 'ResolveGirlRoomOutfit', $RoomSceneGirl
    gs 'GetLocationTimeSuffix'

    $RoomSceneImageId = $RoomSceneGirl + '_room_' + $LocImageTimeSuffix + '_' + $GirlRoomOutfit + '_' + $RoomScenePose

    gs 'ShowImage', 'location', $RoomSceneImageId, '', '', '', $RoomSceneSize

    killvar '$RoomSceneGirl'
    killvar '$RoomScenePose'
    killvar '$RoomSceneSize'
    killvar '$RoomSceneImageId'
    killvar '$GirlRoomOutfit'
    killvar '$LocImageTimeSuffix'
---