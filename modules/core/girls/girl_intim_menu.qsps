! ================================================
! FILE: modules/core/girls/girl_intim_menu.qsps
! MODULE: core/girls
! Главная система меню интима с девушками
! ================================================

#StartIntimMenu
    gs 'NormalizeGirlKey', $ARGS[0]
    $IntimGirl = $GirlKey
    $IntimReturnLoc = $ARGS[1]

    if $IntimGirl = '':
        msg 'Ошибка: StartIntimMenu вызван без имени девушки.'
        exit
    end

    if $IntimReturnLoc = '':
        $IntimReturnLoc = $CURLOC
    end

    if $IntimReturnLoc = '':
        $IntimReturnLoc = 'PlayerRoom'
    end

    gt 'GirlIntim', $IntimGirl, $IntimReturnLoc
---

#IntimLocationText
    $IntimTextLoc = $ARGS[1]

    if $IntimTextLoc = 'PlayerRoom':
        *pl 'Ты в своей комнате наверху. Здесь можно закрыть за собой дубовую дверь и ни о чём не волноваться.'
    elseif $IntimTextLoc = 'SandraRoom':
        *pl 'В комнате Сандры строго и опрятно: на полках безупречный порядок, кровать гладко заправлена.'
    elseif $IntimTextLoc = 'MelissaRoom':
        *pl 'Комната Мелиссы уставлена стопками книг. На столе лежат чистые листы и чернильница.'
    elseif $IntimTextLoc = 'AmandaRoom':
        *pl 'В комнате Аманды тепло и светло: на столике разложены ленты, кровать мягко застелена.'
    elseif $IntimTextLoc = 'Kitchen':
        *pl 'На кухне сейчас ни души, а за плотной занавеской в дальнем углу можно укрыться ото всех.'
    elseif $IntimTextLoc = 'TavernMain':
        *pl 'В зале трактира пусто, и в тихом полумраке между лавками открывается простор для нескромных мыслей.'
    else:
        *pl 'Ты находишься в укромном месте, вдали от любопытных глаз.'
    end

    killvar '$IntimTextLoc'
---

#IntimRegisterPlayerCumSoft
    IntimCumRegistered = 0

    gs 'CanCumToday'

    if PlayerCanCumToday = 1:
        gs 'RegisterPlayerCum'

        if Result = 1:
            IntimCumRegistered = 1
            IntimPlayerOrgasmCount += 1
        end
    else:
        if debug = 1:
            daily_cum_count += 1
            total_cumshots += 1
            total_sex_acts += 1
            sexual_endurance += 1

            if sexual_endurance > 100:
                sexual_endurance = 100
            end

            IntimCumRegistered = 1
            IntimPlayerOrgasmCount += 1

            *pl '[DEBUG] Лимит оргазмов был превышен, но дебагом оргазм зарегистрирован.'
        else:
            msg 'Стефан слишком вымотан за сегодня.'
        end
    end
---

#IntimSoftProgress
    gs 'NormalizeGirlKey', $ARGS[0]
    $ProgressGirl = $GirlKey
    $ProgressType = LCASE($ARGS[1])

    if $ProgressGirl = '':
        exit
    end

    if $ProgressType = 'kiss':
        Friends[$ProgressGirl] += 1
        love[$ProgressGirl] += 1
        otkroven[$ProgressGirl] += 1
    elseif $ProgressType = 'caress':
        Friends[$ProgressGirl] += 1
        love[$ProgressGirl] += 1
        otkroven[$ProgressGirl] += 1
        sluttiness[$ProgressGirl] += 1
    elseif $ProgressType = 'hand':
        otkroven[$ProgressGirl] += 1
        sluttiness[$ProgressGirl] += 1
    elseif $ProgressType = 'oral':
        otkroven[$ProgressGirl] += 2
        sluttiness[$ProgressGirl] += 2
    elseif $ProgressType = 'vaginal':
        love[$ProgressGirl] += 1
        otkroven[$ProgressGirl] += 2
        sluttiness[$ProgressGirl] += 2
    elseif $ProgressType = 'anal':
        otkroven[$ProgressGirl] += 2
        sluttiness[$ProgressGirl] += 3
    else:
        Friends[$ProgressGirl] += 1
    end

    gs 'ClampGirlSocialStats', $ProgressGirl
---

#IntimScene
    gs 'NormalizeGirlKey', $ARGS[0]
    $SceneGirl = $GirlKey
    $SceneReturnLoc = $ARGS[1]

    if $SceneGirl = '':
        exit
    end

    if $SceneReturnLoc = '':
        $SceneReturnLoc = 'PlayerRoom'
    end

    gt 'SexSceneStart', $SceneGirl, $SceneReturnLoc
---

#IntimEnd
    gs 'NormalizeGirlKey', $ARGS[0]
    $IntimEndGirl = $GirlKey
    $IntimEndReturnLoc = $ARGS[1]

    if $IntimEndReturnLoc = '':
        $IntimEndReturnLoc = 'TavernMain'
    end

    gs 'GirlIntimSessionEnd'
    gt $IntimEndReturnLoc
---
