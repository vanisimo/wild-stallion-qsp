! ================================================
! FILE: modules/actions/tavern/girl_work_policy_talk_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! Агентам: НЕ переписывать prose без явного «можно править тексты».
! Перед любой переделкой файла — спросить пользователя; сохранять формулировки.
! Канон §0c: сдержанно / сама / расковано
! До FamilyLiberationGateOpen — только сдержанно (меню так же)
! ================================================

#GirlWorkPolicyTalkPrintText
    gs 'GirlWorkPolicyTalkText', $ARGS[0]

    if $PolicyTalkText <> '':
        *p $PolicyTalkText
    end
---

#GirlWorkPolicyTalkText
    $PolicyTalkTextId = LCASE($ARGS[0])
    $PolicyTalkText = ''

    if $PolicyTalkGirl = '':
        $PolicyTalkGirl = 'amanda'
    end

    if $RealName[$PolicyTalkGirl] = '':
        gs 'GirlWorkPolicyTalkEnsureName', $PolicyTalkGirl
    end

    if $PolicyTalkTextId = 'after_harass_intro':
        ! смягчено (2026-08): без «инцидент был так себе» / осуждения выбора
        if $PolicyTalkArea = 'kitchen':
            $PolicyTalkText = 'Когда у печи снова тихо, вы находите минуту. ' + $RealName[$PolicyTalkGirl] + ' слушает. Коротко — как ей удобнее, если на кухню снова полезет гость.'
        else:
            $PolicyTalkText = 'Когда у стола снова обычный гул, вы находите минуту. ' + $RealName[$PolicyTalkGirl] + ' рядом. Не разбор полётов — просто наперёд: как ей проще в таких случаях.'
        end

    elseif $PolicyTalkTextId = 'after_harass_prompt_body':
        if FamilyLiberationGateOpen = 1:
            if $PolicyTalkArea = 'kitchen':
                $PolicyTalkText = 'Сдержанно и если что звать меня. Самой — разбираться. Раскованнее — улыбнулась, наклонилась дала посмотреть на попу или в вырез, чаевые получила. Выбирай.'
            else:
                $PolicyTalkText = 'Сдержанно и если что звать меня. Самой — решать. Раскованнее — улыбнулась, дала подержать за ручку, чаевые заработала, молодец. Как решим — так и будет.'
            end
        else:
            if $PolicyTalkArea = 'kitchen':
                $PolicyTalkText = 'Тут не до рассюсюкиваний: ведем себя тактично. Полезет лапать — зови меня. Я разберусь.'
            else:
                $PolicyTalkText = 'Пока так: играем скромно. Лапает — зви меня. Без «сама разберусь» и без фривольности ради монет.'
            end
        end

    elseif $PolicyTalkTextId = 'intro':
        if $PolicyTalkArea = 'kitchen':
            $PolicyTalkText = 'Находите момент поговорить с ' + $RealName[$PolicyTalkGirl] + ' без лишних ушей. На кухне либо порядок, либо гости решат, что тут проходной двор, и она сама тоже проходная.'
        else:
            $PolicyTalkText = 'Отводите ' + $RealName[$PolicyTalkGirl] + ' в сторону. На такой работе шальные руки окажутся в трусиках, быстрее чем что то сообразишь, языки грязные — слухи разлетятся быстро. лучше обозначит правила, чем потом сожалеть.'
        end

    elseif $PolicyTalkTextId = 'hall_thoughts':
        if FamilyLiberationGateOpen = 1:
            $PolicyTalkText = 'За столом уже обсудили: улыбнутся и наклонится — не постыдно, если без дальнейшего. Можно сказать сдержанно. Можно доверить все ей. Можно сказать добрая официанка — больше денег в ее кубышке. Не я один это выдумал.'
        else:
            $PolicyTalkText = 'Что сказать? Пока одно: веди себя сдержанно. Кто за жопу ухватит — зови. Не кружкой пропишу, не «улыбнулась симпатишному». Порядок и сдержаность.'
        end

    elseif $PolicyTalkTextId = 'kitchen_thoughts':
        if FamilyLiberationGateOpen = 1:
            $PolicyTalkText = 'Кухня тесная, но рамка та же, что за столом: не монастырь и не бордель. Сдержанно. Самой. Или раскованнее — серебро не выплёвывать, дверь не отдавать.'
        else:
            $PolicyTalkText = 'Кухня: сдержанно. Полез без спроса — зовёт меня. Скалка — хорошо, хозяин рядом — лучше. Без «раскованнее» и без «как хочешь» — рано.'
        end

    elseif $PolicyTalkTextId = 'set':
        if $PolicyTalkArea = 'kitchen':
            if GirlKitchenPolicy[$PolicyTalkGirl] = 1:
                $PolicyTalkText = '— Если ещё один полезет на кухню, кричишь СТЕЕЕФАН, не геройствуй. Скалка хороша, но я пропишу надежнее.'
            elseif GirlKitchenPolicy[$PolicyTalkGirl] = 2:
                $PolicyTalkText = '— Решай сама, — предлагаешь. — Сгладить - погладить, осадить - поколатить, выгнать - выпнуть — твое решение, твое мнени. Я не буду бегать за каждым недовольным твоей едой, да из за довольным тем более.'
            elseif GirlKitchenPolicy[$PolicyTalkGirl] = 3:
                ! policy 3 до гейта режется в TalkSet/AfterHarassApply → value 1
                $PolicyTalkText = '— Как обсуждали: серебро не выбрасывай сразу, —  улыбнись, пошути, чаевые забери. Не к стене юбку задрав. Тоньше.'
            else:
                $PolicyTalkText = 'Нового правила нет. Пусть пока как было — иногда лучше не лезть в , пока не закипел.'
            end
        else:
            if GirlWorkPolicy[$PolicyTalkGirl] = 1:
                $PolicyTalkText = '— В зале сдержанно, — говоришь. — Полезет руками под подол — зовёшь меня. Не улыбайся каждому козлу с толстым кошельком.'
            elseif GirlWorkPolicy[$PolicyTalkGirl] = 2:
                $PolicyTalkText = '— Решай сама, — говоришь. — Где улыбнуться, где отойти, где по рукам. Ты не маленькая. Вляпаешься — не говори, что не предупреждал.'
            elseif GirlWorkPolicy[$PolicyTalkGirl] = 3:
                ! только после FamilyLiberationGateOpen (иначе clamp → 1)
                $PolicyTalkText = '— Улыбнулась, ручкой погладила,  — пусть раскошеливаются, —  Не прыгать к клиенту на колени по первому зову. Чаевые и доля — ваши. Все честно'
            else:
                $PolicyTalkText = 'Нового правила нет. Пусть сама чует черту — иногда отсутствие приказа тоже приказ.'
            end
        end

    else:
        $PolicyTalkText = ''
    end

    killvar '$PolicyTalkTextId'
---
