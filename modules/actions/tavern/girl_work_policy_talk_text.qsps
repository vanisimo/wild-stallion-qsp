! ================================================
! FILE: modules/actions/tavern/girl_work_policy_talk_text.qsps
! Тексты разговора после события о правилах работы
! Используется логикой:
! modules/actions/tavern/girl_work_policy_talk.qsps
!
! Тон:
! - средневековая таверна, грубая рабочая речь
! - Стефан дерзкий, но без лишней болтовни
! - объясняет последствия через мысли и реплики, а не через админ-меню
! ================================================

#GirlWorkPolicyTalkPrintText
    gs 'GirlWorkPolicyTalkText', $ARGS[0]

    if $PolicyTalkText <> '':
        *p $PolicyTalkText
    end
---

#GirlWorkPolicyTalkText
    $PolicyTalkTextId = LCASE($ARGS[0])
    $PolicyTalkText = ''

    if $PolicyTalkGirl = '':
        $PolicyTalkGirl = 'amanda'
    end

    if $RealName[$PolicyTalkGirl] = '':
        gs 'GirlWorkPolicyTalkEnsureName', $PolicyTalkGirl
    end

    if $PolicyTalkTextId = 'after_harass_intro':
        if $PolicyTalkArea = 'kitchen':
            $PolicyTalkText = 'Когда клиент уже ушёл, вы отводите ' + $RealName[$PolicyTalkGirl] + ' в сторону. Коротко: что делать, если следующий пьяный хрен решит, что кухня — его двор, а она — в комплекте.'
        else:
            $PolicyTalkText = 'Когда шум в зале спал, вы отводите ' + $RealName[$PolicyTalkGirl] + ' в сторону. Случай был — теперь одно правило на будущее, без театра.'
        end

    elseif $PolicyTalkTextId = 'after_harass_prompt_body':
        if $PolicyTalkArea = 'kitchen':
            $PolicyTalkText = 'Коротко и по делу. Вести себя сдержанно и звать меня. Дать решать самой. Или сказать: вести себя раскованнее — улыбка, дело, чаевые. Только потом не удивляться, если кухня запомнит это дольше одного вечера.'
        else:
            $PolicyTalkText = 'Коротко и по делу. Вести себя сдержанно и звать меня. Дать решать самой. Или сказать: вести себя раскованнее — не на колени, но и не отпугивать кошелёк. Только потом не строить из себя святого, если зал сам решит, где черта.'
        end

    elseif $PolicyTalkTextId = 'intro':
        if $PolicyTalkArea = 'kitchen':
            $PolicyTalkText = 'После кухонного шума вы находите момент поговорить с ' + $RealName[$PolicyTalkGirl] + ' без лишних ушей. На кухне всё просто: либо порядок, либо каждый пьяный хрен решит, что дверь туда открыта вместе с девками.'
        else:
            $PolicyTalkText = 'После случившегося в зале вы отводите ' + $RealName[$PolicyTalkGirl] + ' в сторону. Тут не гостиная благородных девиц: в трактире лапы тянутся быстро, языки грязные, а чаевые иногда пахнут хуже конюшни.'
        end

    elseif $PolicyTalkTextId = 'hall_thoughts':
        if FamilyLiberationGateOpen = 1:
            $PolicyTalkText = 'За ужином мы уже говорили: улыбка, ручка, чаевые — не на колени. Можно велеть вести себя сдержанно. Можно дать решать самой. А можно напомнить про раскованнее — доли растут вместе с кассой. Это не «я один продаю семью»: мы сидели за одним столом.'
        else:
            $PolicyTalkText = 'Что ей сказать? Вести себя сдержанно и звать меня, если кто-то решил, что купил не пиво, а право лапать. Доверить решать самой. Или сказать: раскованнее — улыбка, ручка, чаевые. Только потом, Стефан, не строй из себя святого, если сам отвернулся у стойки.'
        end

    elseif $PolicyTalkTextId = 'kitchen_thoughts':
        if FamilyLiberationGateOpen = 1:
            $PolicyTalkText = 'Кухня — не зал. Но после ужина рамка та же: не монастырь и не бордель. Сдержанно и звать меня. Решать самой. Или раскованнее — серебро не выкидывать с порога, но дверь не отдавать. Семья знает, о чём речь.'
        else:
            $PolicyTalkText = 'С кухней надо решать отдельно. Там тесно, ножи рядом, а клиент без спроса уже наполовину виноват. Сдержанно — звать меня. Самой — разбираться. Раскованнее — не гнать кошелёк, но и не пускать дальше порога. Звучит просто. На кухне редко бывает просто.'
        end

    elseif $PolicyTalkTextId = 'set':
        if $PolicyTalkArea = 'kitchen':
            if GirlKitchenPolicy[$PolicyTalkGirl] = 1:
                $PolicyTalkText = '— Если ещё один полезет на кухню, зовёшь меня, — говорите вы. — Не надо геройствовать. Скалка — хорошая вещь, но хозяин иногда бьёт больнее.'
            elseif GirlKitchenPolicy[$PolicyTalkGirl] = 2:
                $PolicyTalkText = '— Решай сама, — говорите вы. — Я не буду бегать за каждым недовольным миской. Можешь сгладить, можешь осадить, можешь выгнать. Только голову включай.'
            elseif GirlKitchenPolicy[$PolicyTalkGirl] = 3:
                if FamilyLiberationGateOpen = 1:
                    $PolicyTalkText = '— Как за столом говорили: серебро не выплёвывай сразу, — тише. — Улыбка, дело, чаевые. Не отдавай кухню целиком. Мы это уже обсуждали — не я один придумал.'
                else:
                    $PolicyTalkText = '— На кухне тоже можно быть раскованнее, — говорите вы тише. — Улыбка, дело, чаевые. Но смотри, чтобы он не решил, будто купил всю кухню вместе с тобой.'
                end
            else:
                $PolicyTalkText = 'Вы решаете не давать нового правила для кухни. Пусть пока будет как было. Иногда лучше не лезть в котёл, пока он не закипел.'
            end
        else:
            if GirlWorkPolicy[$PolicyTalkGirl] = 1:
                $PolicyTalkText = '— В зале ведёшь себя сдержанно, — говорите вы. — Если кто-то полезет руками, зовёшь меня. Не надо улыбаться каждому козлу, который монетой машет.'
            elseif GirlWorkPolicy[$PolicyTalkGirl] = 2:
                $PolicyTalkText = '— Решай сама, — говорите вы. — Где улыбнуться, где отойти, где дать по рукам. Ты не маленькая. Но если вляпаешься — потом не говори, что тебя не предупреждали.'
            elseif GirlWorkPolicy[$PolicyTalkGirl] = 3:
                if FamilyLiberationGateOpen = 1:
                    $PolicyTalkText = '— Как за ужином: улыбнулась, ручкой — пусть раскошеливаются, — говоришь. — Не на колени. Чаевые и доля — ваши. Мы это проговаривали. Я не тащу вас втихаря.'
                else:
                    $PolicyTalkText = '— Веди себя раскованнее в зале, — говорите вы. — Улыбка, ручка, чаевые. Только не превращай зал в скотный двор и себя — в бесплатную забаву для каждого пьянчуги.'
                end
            else:
                $PolicyTalkText = 'Вы не даёте нового правила для зала. Пусть сама понимает, что можно, а где уже черта. Иногда отсутствие приказа тоже приказ, только грязнее.'
            end
        end

    else:
        $PolicyTalkText = ''
    end

    killvar '$PolicyTalkTextId'
---
