! ================================================
! FILE: modules/actions/tavern/girl_work_policy_talk_text.qsps
! Тексты разговора о правилах (зал / кухня)
! Канон §0c: сдержанно / сама / расковано
! До FamilyLiberationGateOpen — только сдержанно (меню так же)
! ================================================

#GirlWorkPolicyTalkPrintText
    gs 'GirlWorkPolicyTalkText', $ARGS[0]

    if $PolicyTalkText <> '':
        *p $PolicyTalkText
    end
---

#GirlWorkPolicyTalkText
    $PolicyTalkTextId = LCASE($ARGS[0])
    $PolicyTalkText = ''

    if $PolicyTalkGirl = '':
        $PolicyTalkGirl = 'amanda'
    end

    if $RealName[$PolicyTalkGirl] = '':
        gs 'GirlWorkPolicyTalkEnsureName', $PolicyTalkGirl
    end

    if $PolicyTalkTextId = 'after_harass_intro':
        if $PolicyTalkArea = 'kitchen':
            $PolicyTalkText = 'Когда клиент уже ушёл, вы отводите ' + $RealName[$PolicyTalkGirl] + ' в сторону. Коротко: что делать, если следующий пьяный хрен решит, что кухня — его двор, а она — в комплекте.'
        else:
            $PolicyTalkText = 'Когда шум в зале спал, вы отводите ' + $RealName[$PolicyTalkGirl] + ' в сторону. Случай был — теперь одно правило на будущее, без театра.'
        end

    elseif $PolicyTalkTextId = 'after_harass_prompt_body':
        if FamilyLiberationGateOpen = 1:
            if $PolicyTalkArea = 'kitchen':
                $PolicyTalkText = 'Сдержанно и звать меня. Самой — разбираться. Раскованнее — улыбка, дело, чаевые, но кухню не отдавать. Выбирай.'
            else:
                $PolicyTalkText = 'Сдержанно и звать меня. Самой — решать. Раскованнее — улыбка, ручка, чаевые, не на колени. Как скажем — так и будет.'
            end
        else:
            if $PolicyTalkArea = 'kitchen':
                $PolicyTalkText = 'Тут не до тонкостей: сдержанно. Полезет — зовёт меня. Остальное потом.'
            else:
                $PolicyTalkText = 'Пока так: сдержанно. Лапы — звать меня. Без «сама» и без улыбок ради кошелька. Не время.'
            end
        end

    elseif $PolicyTalkTextId = 'intro':
        if $PolicyTalkArea = 'kitchen':
            $PolicyTalkText = 'Находите момент поговорить с ' + $RealName[$PolicyTalkGirl] + ' без лишних ушей. На кухне либо порядок, либо каждый пьяный решит, что дверь открыта вместе с ней.'
        else:
            $PolicyTalkText = 'Отводите ' + $RealName[$PolicyTalkGirl] + ' в сторону. В трактире лапы тянутся быстро, языки грязные — правило лучше сказать вслух, чем надеяться, что «сама догадается».'
        end

    elseif $PolicyTalkTextId = 'hall_thoughts':
        if FamilyLiberationGateOpen = 1:
            $PolicyTalkText = 'За столом уже проговаривали: улыбка и ручка — не стыд, если не на колени. Можно велеть сдержанно. Можно дать самой. Можно напомнить про раскованнее — касса и доли. Не я один это выдумал.'
        else:
            $PolicyTalkText = 'Что сказать? Пока одно: веди себя сдержанно. Кто полезет — зови. Не сама, не «улыбнись богатому». Сначала порядок — остальное, если доживём до разговоров.'
        end

    elseif $PolicyTalkTextId = 'kitchen_thoughts':
        if FamilyLiberationGateOpen = 1:
            $PolicyTalkText = 'Кухня тесная, но рамка та же, что за столом: не монастырь и не бордель. Сдержанно. Самой. Или раскованнее — серебро не выплёвывать, дверь не отдавать.'
        else:
            $PolicyTalkText = 'Кухня: сдержанно. Полез без спроса — зовёт меня. Скалка — хорошо, хозяин рядом — лучше. Без «раскованнее» и без «как хочешь» — рано.'
        end

    elseif $PolicyTalkTextId = 'set':
        if $PolicyTalkArea = 'kitchen':
            if GirlKitchenPolicy[$PolicyTalkGirl] = 1:
                $PolicyTalkText = '— Если ещё один полезет на кухню, зовёшь меня, — говоришь. — Не геройствуй. Скалка хороша, но хозяин бьёт больнее.'
            elseif GirlKitchenPolicy[$PolicyTalkGirl] = 2:
                $PolicyTalkText = '— Решай сама, — говоришь. — Сгладить, осадить, выгнать — твоя голова. Я не буду бегать за каждым недовольным миской.'
            elseif GirlKitchenPolicy[$PolicyTalkGirl] = 3:
                if FamilyLiberationGateOpen = 1:
                    $PolicyTalkText = '— Как за столом: серебро не выплёвывай сразу, — тише. — Улыбка, дело, чаевые. Кухню целиком не отдавай. Мы это уже обсуждали.'
                else:
                    $PolicyTalkText = '— Сдержаннее, чем кажется, — бормочешь и поправляешь себя. — Нет. На кухне пока только порядок. Зовёшь меня.'
                    GirlKitchenPolicy[$PolicyTalkGirl] = 1
                end
            else:
                $PolicyTalkText = 'Нового правила нет. Пусть пока как было — иногда лучше не лезть в котёл, пока не закипел.'
            end
        else:
            if GirlWorkPolicy[$PolicyTalkGirl] = 1:
                $PolicyTalkText = '— В зале сдержанно, — говоришь. — Полезет руками — зовёшь меня. Не улыбайся каждому козлу с монетой.'
            elseif GirlWorkPolicy[$PolicyTalkGirl] = 2:
                $PolicyTalkText = '— Решай сама, — говоришь. — Где улыбнуться, где отойти, где по рукам. Ты не маленькая. Вляпаешься — не говори, что не предупреждал.'
            elseif GirlWorkPolicy[$PolicyTalkGirl] = 3:
                if FamilyLiberationGateOpen = 1:
                    $PolicyTalkText = '— Как за столом: улыбнулась, ручкой — пусть раскошеливаются, — тише. — Не на колени. Чаевые и доля — ваши. Я не тащу вас втихаря.'
                else:
                    $PolicyTalkText = '— Нет, — одёргиваешь себя. — Пока только сдержанно. Зовёшь меня. До других разговоров — не лезем.'
                    GirlWorkPolicy[$PolicyTalkGirl] = 1
                end
            else:
                $PolicyTalkText = 'Нового правила нет. Пусть сама чует черту — иногда отсутствие приказа тоже приказ, только грязнее.'
            end
        end

    else:
        $PolicyTalkText = ''
    end

    killvar '$PolicyTalkTextId'
---
