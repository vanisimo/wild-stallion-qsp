! ================================================
! FILE: modules/actions/tavern/girl_talk_hall_event_reaction_compat.qsps
! Тема hall_event после LastHallEvent (harassment и др.)
! thin memory A: без HallRecentTalk (frozen)
! ================================================

#GirlTalkHallEventReaction
    gs 'NormalizeGirlKey', $ARGS[0]
    $HallEventTalkGirl = $GirlKey
    $HallEventTalkReturnLoc = $ARGS[1]

    if $HallEventTalkGirl = '':
        $HallEventTalkGirl = $LastHallEventGirl
    end

    if $HallEventTalkReturnLoc = '':
        $HallEventTalkReturnLoc = 'TavernMain'
    end

    if LOC($HallEventTalkReturnLoc) = 0:
        $HallEventTalkReturnLoc = 'TavernMain'
    end

    if $HallEventTalkGirl = '':
        *clr
        clr
        cla

        *pl '══════════════════════════════════════════════'
        *pl ' РАЗГОВОР ПОСЛЕ СЛУЧАЯ В ЗАЛЕ'
        *pl '══════════════════════════════════════════════'
        *pl ' '
        *pl 'Стефан пытается вспомнить, с кем именно хотел поговорить после случившегося, но в памяти всё уже смешалось с шумом зала.'
        *pl ' '

        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $HallEventTalkReturnLoc
        end

        exit
    end

    gs 'EnsureGirlData', $HallEventTalkGirl

    *clr
    clr
    cla

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $HallEventTalkGirl
    end

    *pl '══════════════════════════════════════════════'
    *pl ' РАЗГОВОР ПОСЛЕ СЛУЧАЯ В ЗАЛЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if $LastHallEventText <> '':
        *pl $LastHallEventText
        *pl ' '
    end

    if $HallEventTalkGirl = 'amanda':
        *pl 'Аманда мнётся, краснеет и всё время будто собирается сказать больше, чем решается.'
    elseif $HallEventTalkGirl = 'melissa':
        *pl 'Мелисса смотрит внимательно. Она уже поняла, что разговор будет не только о клиенте, но и о ваших правилах.'
    elseif $HallEventTalkGirl = 'sandra':
        *pl 'Сандра слушает спокойно, но тяжёлый взгляд ясно говорит: в трактире пора наводить порядок.'
    else:
        *pl $RealName[$HallEventTalkGirl] + ' ждёт, что вы скажете после случившегося.'
    end

    HallEventDiscussed[$HallEventTalkGirl] = 1

    if LOC('HallRecentMemoryMarkDiscussed') = 1:
        gs 'HallRecentMemoryMarkDiscussed'
    end

    *pl ' '

    if LOC('GirlWorkPolicyTalkHall') = 1:
        gs 'ActUiPrepare', 'Дать правило на будущее', 'policy'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GirlWorkPolicyTalkHall', $HallEventTalkGirl, $HallEventTalkReturnLoc
        end
    end

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $HallEventTalkReturnLoc
    end
---
