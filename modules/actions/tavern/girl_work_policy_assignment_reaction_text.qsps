! ================================================
! FILE: modules/actions/tavern/girl_work_policy_assignment_reaction_text.qsps
! Реакции на правило: сдержанно (1) / сама (2) / расковано (3)
! Без legacy «удерживать клиента любой ценой»
! ================================================

#GirlWorkPolicyAssignmentReactionText
    $PolicyAssignReactionText = ''

    if $PolicyAssignGirl = 'amanda':
        gs 'GirlWorkPolicyAssignmentReactionTextAmanda'
    elseif $PolicyAssignGirl = 'melissa':
        gs 'GirlWorkPolicyAssignmentReactionTextMelissa'
    elseif $PolicyAssignGirl = 'sandra':
        gs 'GirlWorkPolicyAssignmentReactionTextSandra'
    else:
        gs 'GirlWorkPolicyAssignmentReactionTextDefault'
    end
---

#GirlWorkPolicyAssignmentReactionTextAmanda
    if PolicyAssignPolicy = 1:
        if PolicyAssignLevel >= 2:
            $PolicyAssignReactionText = 'Аманда быстро кивает. — Да… лучше вести себя акуратно. А то смотрят так, будто кружку заказали вместе со мной.'
        else:
            $PolicyAssignReactionText = 'Аманда мнётся. — Не флиртовать, значит… Только потом не говори, что я мало улыбаюсь и клиенты недовольны.'
        end
    elseif PolicyAssignPolicy = 2:
        if PolicyAssignLevel >= 2:
            $PolicyAssignReactionText = 'Аманда осторожно улыбается. — доверяешь мне? Ладно. Попробую. Только если что — не говори что я виновата.'
        else:
            $PolicyAssignReactionText = 'Аманда кусает губу. — А если неправильно решу? Кто виноват?'
        end
    elseif PolicyAssignPolicy = 3:
        ! policy 3 только при FamilyLiberationGateOpen (clamp в TalkSet)
        if PolicyAssignLevel >= 3:
            $PolicyAssignReactionText = 'Аманда краснеет, но не отводит взгляд. — Раскованнее… улыбаться. Если он не совсем мерзкий — попробую. Только не смотри потом сычом.'
        elseif PolicyAssignLevel = 2:
            $PolicyAssignReactionText = 'Аманда кивает неуверенно. — Поняла… наверное. Не на колени же.'
        else:
            $PolicyAssignReactionText = 'Аманда резко поднимает глаза. — Раскованнее ради чайвых? Стефан, я не собираюсь виснуть на каждом пьянчуге.'
        end
    else:
        $PolicyAssignReactionText = 'Аманда пожимает плечами. — Без правил? Ну… не ругайся, если дам кому то подносом по башке'
    end
---

#GirlWorkPolicyAssignmentReactionTextMelissa
    if PolicyAssignPolicy = 1:
        if PolicyAssignLevel >= 2:
            $PolicyAssignReactionText = 'Мелисса кивает. — Наконец-то, это правильно. Обозначим границы сразу — чтобы потом не выдирать руки клиентов у нас из под юбок.'
        else:
            $PolicyAssignReactionText = 'Мелисса прищуривается. — Без заигрываний? Хорошо. Только не плачся потом, что зал скучный и прибль низкая.'
        end
    elseif PolicyAssignPolicy = 2:
        if PolicyAssignLevel >= 2:
            $PolicyAssignReactionText = 'Мелисса чуть улыбается. — Сама решать, это по мне. Главное — потом не отмотай все назад.'
        else:
            $PolicyAssignReactionText = 'Мелисса смотрит холоднее. — Удобно тебе. Выйдет хорошо — Стефанчик молодец. Плохо — Мелисса плохая.'
        end
    elseif PolicyAssignPolicy = 3:
        ! policy 3 только при FamilyLiberationGateOpen (clamp в TalkSet)
        if PolicyAssignLevel >= 3:
            $PolicyAssignReactionText = 'Мелисса медленно улыбается. — Раскованнее? Можно. По-своему — не как девка у портовой стены.'
        elseif PolicyAssignLevel = 2:
            $PolicyAssignReactionText = 'Мелисса кивает без радости. — Богатых не отпугивать. Купит меня вместе с кружкой — руку отобью.'
        else:
            $PolicyAssignReactionText = 'Мелисса резко: — Ты что, сдурел? Раскованнее ради серебра? Сам сядь к нему на колени.'
        end
    else:
        $PolicyAssignReactionText = 'Мелисса пожимает плечом. — Без правил — тоже правило. Потом не удивляйся, если каждая поймёт его по-своему.'
    end
---

#GirlWorkPolicyAssignmentReactionTextSandra
    if PolicyAssignPolicy = 1:
        if PolicyAssignLevel >= 2:
            $PolicyAssignReactionText = 'Сандра медленно кивает. — Вот это порядок. Где нет границ, быстро забывают, кто семья, а кто пьяная скотина за столом.'
        else:
            $PolicyAssignReactionText = 'Сандра смотрит тяжело. — Сдержанно? Хорошо бы ты сам помнил это слово не только когда удобно.'
        end
    elseif PolicyAssignPolicy = 2:
        if PolicyAssignLevel >= 2:
            $PolicyAssignReactionText = 'Сандра спокойно: — Я разберусь. Отдаёшь решение мне — не стой потом над душой с лицом обиженного мальчишки.'
        else:
            $PolicyAssignReactionText = 'Сандра хмурится. — Самой решать? Иногда звучит не как доверие, а как умыть руки.'
        end
    elseif PolicyAssignPolicy = 3:
        ! policy 3 только при FamilyLiberationGateOpen (clamp в TalkSet)
        if PolicyAssignLevel >= 3:
            $PolicyAssignReactionText = 'Сандра долго молчит, потом тяжело вздыхает. — Ради трактира — без глупостей и дешёвого позора. Но я понимаю, куда ведёт дорога.'
        elseif PolicyAssignLevel = 2:
            $PolicyAssignReactionText = 'Сандра без улыбки. — Раскованнее можно. Только не путай улыбку с тем, что потом не отмоешь.'
        else:
            $PolicyAssignReactionText = 'Сандра смотрит так, что в зале стало бы тише. — Я не девка из борделя, Стефан. Ещё раз таким тоном — сам удерживай своих богатых.'
        end
    else:
        $PolicyAssignReactionText = 'Сандра складывает руки. — Без правил? Каждый будет щупать черту. Обычно после этого кто-нибудь плачет или дерётся.'
    end
---

#GirlWorkPolicyAssignmentReactionTextDefault
    if PolicyAssignLevel >= 2:
        $PolicyAssignReactionText = $RealName[$PolicyAssignGirl] + ' принимает правило без явного спора.'
    else:
        $PolicyAssignReactionText = $RealName[$PolicyAssignGirl] + ' явно не рада правилу, хотя вслух спорить не спешит.'
    end
---
