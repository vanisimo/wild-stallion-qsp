#SexSceneTextClarissa
    $SexTextAction = LCASE($ARGS[0])

    if $SexTextAction = 'intro':
        if ClarissaIntimFirstSexActive = 1:
            $SexLastText = 'Кларисса запирает подсобку и смотрит на тебя с вызовом: "Быстро. Пока Альбер не вернулся из зала."'
        else:
            $SexLastText = 'Кларисса встречает тебя без притворной скромности. В её взгляде ревность, опыт и готовность взять своё.'
        end
    elseif $SexTextAction = 'kiss':
        $SexLastText = 'Поцелуй с Клариссой жёстче, чем с девчонками из трактира. Она отвечает сразу, будто доказывает что-то самой себе.'
    elseif $SexTextAction = 'caress':
        $SexLastText = 'Твои руки скользят по Клариссе уверенно. Она не учит тебя робости — она учит не терять время.'
    elseif $SexTextAction = 'breast_caress':
        $SexLastText = 'Ласки становятся смелее. Кларисса выдыхает и шепчет: "Не останавливайся на полпути."'
    elseif $SexTextAction = 'cuni':
        $SexLastText = 'Ты ласкаешь Клариссу ниже пояса. Она кусает ладонь, чтобы не выдать себя покупателями за дверью.'
    elseif $SexTextAction = 'blowjob':
        $SexLastText = 'Кларисса берёт тебя в рот без лишней суеты — слишком уверенно для двадцати двух, если не знать её историю.'
    elseif $SexTextAction = 'vaginal':
        $SexLastText = 'Близость с Клариссой быстрая и жаркая. Она больше не играет в приличную жену торговца — хотя бы на эти минуты.'
    elseif $SexTextAction = 'girl_finish':
        $SexLastText = 'Кларисса теряет самообладание и долго не может отдышаться, прислушиваясь к шагам в зале.'
    elseif $SexTextAction = 'player_finish_good':
        $SexLastText = 'Ты кончаешь, и Кларисса смотрит на тебя с усталой, довольной улыбкой.'
    elseif $SexTextAction = 'player_finish_bad':
        $SexLastText = 'Ты срываешься слишком рано. Кларисса вздыхает: "Мужчины… даже те, кто моложе Альбера."'
    elseif $SexTextAction = 'player_out':
        $SexLastText = 'Сил больше нет. Кларисса кивает: "Ладно. Сегодня хватит."'
    elseif $SexTextAction = 'rest':
        $SexLastText = 'Ты переводишь дыхание между бочонками. Кларисса ждёт терпеливо, но не слишком долго.'
    else:
        $SexLastText = 'Кларисса смотрит на тебя, ожидая следующего решения.'
    end

    killvar '$SexTextAction'
