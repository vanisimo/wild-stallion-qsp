#GirlFirstSex
    gs 'NormalizeGirlKey', $ARGS[0]
    $FirstGirl = $GirlKey
    $FirstReturnLoc = $ARGS[1]

    if $FirstGirl = '':
        exit
    end

    if $FirstReturnLoc = '':
        $FirstReturnLoc = 'PlayerRoom'
    end

    gt 'SexSceneStart', $FirstGirl, $FirstReturnLoc, 'first_sex'
---

#GirlFirstSexResult
    gt 'SexSceneMain'
---

#GirlFirstAnal
    gs 'NormalizeGirlKey', $ARGS[0]
    $AnalGirl = $GirlKey
    $AnalReturnLoc = $ARGS[1]

    if $AnalGirl = '':
        exit
    end

    if $AnalReturnLoc = '':
        $AnalReturnLoc = 'PlayerRoom'
    end

    gt 'SexSceneStart', $AnalGirl, $AnalReturnLoc, 'first_anal'
---

#GirlFirstAnalResult
    gt 'SexSceneMain'
---
