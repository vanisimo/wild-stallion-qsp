! ================================================
! FILE: modules/actions/sex/sex_scene_core.qsps
! Шанс сдержаться на грани оргазма
! База 28% + sexual_endurance/5 + IntimStage*2 − штрафы, клип 8–75%
! Одна попытка до оргазма ГГ; после неё кнопка до кончины не возвращается
! ================================================

#SexSceneCalcHoldBackChance
    gs 'EnsureGirlData', $SexGirl

    SexHoldBackChance = 28
    SexHoldBackChance += sexual_endurance / 5
    SexHoldBackChance += IntimStage[$SexGirl] * 2

    if SexGirlArousal >= 85:
        if SexScenePenetrationActive = 1 and ($SexActType = 'vaginal' or $SexActType = 'anal'):
            SexHoldBackChance -= 22
        elseif $SexActType = 'blowjob' or $SexActType = 'rimjob':
            SexHoldBackChance -= 12
        else
            SexHoldBackChance -= 8
        end
    end

    if SexHoldBackChance < 8:
        SexHoldBackChance = 8
    end

    if SexHoldBackChance > 75:
        SexHoldBackChance = 75
    end
---

! ================================================
! FILE: modules/actions/sex/sex_scene_core.qsps
! Попытка сдержаться
! ================================================

#SexSceneActionHoldBack
    if SexSceneHoldBackUsed = 1:
        gt 'SexSceneMain'
    end

    SexSceneHoldBackUsed = 1

    gs 'SexSceneCalcHoldBackChance'

    if Rand(1, 100) <= SexHoldBackChance:
        SexPlayerArousal = 80 - sexual_endurance / 25

        if SexPlayerArousal < 76:
            SexPlayerArousal = 76
        end

        SexSceneMode = 0
        SexScenePlayerEdgeHintShown = 0
        SexSceneRimjobEdgeHintShown = 0
        $SexLastText = 'Тебе удаётся на мгновение взять себя в руки. Напряжение не ушло, но ещё немного времени есть — пока не кончишь.'
    else
        SexSceneMode = 1

        if SexPlayerArousal < 100:
            SexPlayerArousal += 3
        end

        if SexPlayerArousal > 100:
            SexPlayerArousal = 100
        end

        $SexLastText = 'Ты пытаешься сдержаться, но тело уже почти не слушается.'
    end

    gt 'SexSceneMain'
