! ================================================
! FILE: modules/actions/sex/sex_scene_core.qsps
! Стадии реакции на финал и ATM (коррупция + опыт)
! ================================================

#SexSceneCalcCumPlayStage
    gs 'EnsureGirlData', $SexGirl
    gs 'SexSceneEnsureIntimStage', $SexGirl

    SexCumPlayStage = 0

    if oralswallow[$SexGirl] >= 1 or oralcum[$SexGirl] >= 1 or facialcum[$SexGirl] >= 1:
        SexCumPlayStage = 1
    elseif sluttiness[$SexGirl] >= 18:
        SexCumPlayStage = 1
    end

    if $SexGirl = 'becky':
        if SexCumPlayStage < 1:
            SexCumPlayStage = 1
        end
    end

    if $SexGirl = 'inga' and IngaOralStage >= 1:
        if SexCumPlayStage < 1:
            SexCumPlayStage = 1
        end
    end

    if oralswallow[$SexGirl] >= 2 or sluttiness[$SexGirl] >= 26:
        if SexCumPlayStage < 2:
            SexCumPlayStage = 2
        end
    end

    if $SexGirl = 'inga' and IngaOralStage >= 3:
        if SexCumPlayStage < 2:
            SexCumPlayStage = 2
        end
    end

    if $SexGirl = 'amanda' and AmandaLizaInfluence >= 3 and sluttiness['amanda'] >= 14:
        if SexCumPlayStage < 2:
            SexCumPlayStage = 2
        end
    end

    if oralswallow[$SexGirl] >= 3 or sluttiness[$SexGirl] >= 34 or cuminside[$SexGirl] >= 2:
        if SexCumPlayStage < 3:
            SexCumPlayStage = 3
        end
