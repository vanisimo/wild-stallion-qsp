    }
    gs 'Menu.AddCondition', 'SexSceneMenu', "Result=IIF(IntimStage[$SexGirl]>=4,-1,0)"

    gs 'Menu.Add', 'SexSceneMenu', 'Минет'
    gs 'Menu.AddModule', 'SexSceneMenu', {
        gt 'SexSceneActionBlowjob'
    }
    gs 'Menu.AddCondition', 'SexSceneMenu', "Result=IIF(IntimStage[$SexGirl]>=4 and SexSceneBlowjobMenuOk=1 and SexScenePlayerPenisOk=1,-1,0)"

    gs 'Menu.Add', 'SexSceneMenu', 'Анилингус'
    gs 'Menu.AddModule', 'SexSceneMenu', {
        gt 'SexSceneActionRim'
    }
    gs 'Menu.AddCondition', 'SexSceneMenu', "Result=IIF(SexSceneRimUnlocked=1,-1,0)"

    gs 'Menu.Add', 'SexSceneMenu', 'Римминг Стефану'
