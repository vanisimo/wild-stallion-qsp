        gt 'SexSceneActionUndress', 'her'
    }
    gs 'Menu.AddCondition', 'SexSceneMenu', "Result=IIF(SexSceneUndressReady=1 and SexClothesStage=0,-1,0)"

    gs 'Menu.Add', 'SexSceneMenu', 'Раздеться'
    gs 'Menu.AddModule', 'SexSceneMenu', {
        gt 'SexSceneActionUndress', 'gg'
    }
    gs 'Menu.AddCondition', 'SexSceneMenu', "Result=IIF(SexSceneUndressReady=1 and SexClothesStage=1 and IntimStage[$SexGirl]>=5,-1,0)"

    gs 'Menu.Add', 'SexSceneMenu', 'Уйти'
    gs 'Menu.AddModule', 'SexSceneMenu', {
        gt 'SexSceneEnd'
    }
