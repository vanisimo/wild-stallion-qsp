        gt 'SexSceneActionRimjob'
    }
    gs 'Menu.AddCondition', 'SexSceneMenu', "Result=IIF(SexSceneRimjobUnlocked=1 and SexScenePlayerPenisOk=1,-1,0)"

    gs 'Menu.Add', 'SexSceneMenu', 'Трахать'
    gs 'Menu.AddModule', 'SexSceneMenu', {
