#SexSceneStart

    gs 'NormalizeGirlKey', $ARGS[0]
    $SexGirl = $GirlKey
    $SexReturnLoc = $ARGS[1]
    $SexMode = LCASE($ARGS[2])
    $SexDenyReturnLoc = $CURLOC

    if $SexDenyReturnLoc = '':
        $SexDenyReturnLoc = 'TavernMain'
    end

    if $SexReturnLoc = '':
        $SexReturnLoc = $CURLOC
    end

    if $SexReturnLoc = '':
        $SexReturnLoc = 'TavernMain'
    end

    if LOC($SexReturnLoc) = 0:
        $SexReturnLoc = $SexDenyReturnLoc
    end

    if LOC($SexReturnLoc) = 0:
        $SexReturnLoc = 'TavernMain'
    end

    if $SexMode = '':
        $SexMode = 'normal'
    end

    if $SexGirl = '':
        *clr
        clr
        cla
        gs 'SceneShowVisual', 'images/actions/sex/sex_scene/sex_scene_start', 'sex scene: ошибка — нет имени девушки', 'large', 'webp'
        *pl 'Ошибка: SexSceneStart вызван без имени девушки.'
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $SexReturnLoc
        end
        exit
    end

    gs 'EnsureGirlData', $SexGirl
    gs 'SexSceneEnsureIntimStage', $SexGirl
    gs 'CanStartSexScene', $SexGirl

    if SexSceneAllowed = 0:
        *clr
        clr
        cla
        gs 'ShowLocationScreenTitle', 'ИНТИМНАЯ СЦЕНА'
        gs 'SceneShowVisual', 'images/actions/sex/sex_scene/sex_scene_start', 'sex scene: отказ / нельзя начать', 'large', 'webp'
        *p $SexSceneDenyReason

        if debug = 1:
            *pl ' '
            *pl '[DEBUG] Девушка: ' + $SexGirl
            *pl '[DEBUG] IntimStage: ' + STR(IntimStage[$SexGirl])
            *pl '[DEBUG] Дружба: ' + STR(Friends[$SexGirl])
            *pl '[DEBUG] Любовь: ' + STR(love[$SexGirl])
            *pl '[DEBUG] Откровенность: ' + STR(otkroven[$SexGirl])
            *pl '[DEBUG] Развращённость: ' + STR(sluttiness[$SexGirl])
        end

        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $SexDenyReturnLoc
        end
        exit
    end

    gs 'SexSceneInitState', $SexGirl
    gt 'SexSceneMain'
---

#SexSceneInitState

    gs 'NormalizeGirlKey', $ARGS[0]
    $SexGirl = $GirlKey

    SexSceneActive = 1
    SexSceneMode = 0

    SexStage = IntimStage[$SexGirl]
    SexRound = 1
    SexScenePhase = 1
    SexClothesStage = 0

    SexMainStarted = 0
    SexSceneHadVaginal = 0
    SexSceneHadCuni = 0
    SexSceneHadBlowjob = 0
    SexSceneHadRim = 0
    SexSceneHadRimjob = 0
    SexSceneHadAnal = 0
    SexSceneHadPlayerCum = 0
    SexSceneVaginalRegistered = 0
    SexSceneAnalRegistered = 0
    SexSceneOralRegistered = 0

    SexPlayerArousal = 5
    SexGirlArousal = 5 + sluttiness[$SexGirl] / 8 + love[$SexGirl] / 15

    if SexGirlArousal > 18:
        SexGirlArousal = 18
    end

    if $SexGirl = 'georgett':
        SexScenePhase = 2
        SexClothesStage = 2
        SexGirlArousal = 35
    end

    SexPlayerCameInScene = 0
    SexGirlCameInScene = 0
    SexGirlOrgasmStart = GiveOrgasms[$SexGirl]

    SexPlayerRest = 0
    SexPlayerOut = 0
    gs 'SexSceneUpdatePlayerOut'
    SexSimultaneousOrgasm = 0

    SexSceneKissCount = 0
    SexSceneGropeCount = 0
    SexSceneBlowjobCount = 0
    SexSceneVaginalCount = 0
    SexSceneCuniCount = 0
    SexSceneRimCount = 0
    SexSceneRimjobCount = 0
    SexSceneRimjobUnlocked = 0
    SexSceneCalmAtmDone = 0

    SexSceneDeepthroatCount = 0

    SexKissGirlCap = 38
    SexKissPlayerCap = 35
    SexGropeGirlCap = 58
    SexGropePlayerCap = 52
    SexCuniPlayerCap = 48
    SexPlayerOrgasmFromGirlThreshold = 90
    SexPlayerFinishThreshold = 88

    if $SexGirl = 'georgett':
        SexKissGirlCap = 55
        SexKissPlayerCap = 50
        SexGropeGirlCap = 68
        SexGropePlayerCap = 62
    end

    SexGirlTriggeredPlayerOrgasm = 0
    SexSceneNextPlayerGain = 0
    SexSceneCuniUseCount = 0

    $SexPose = 'missionary'
    $SexActType = 'intro'
    SexSceneReverseCowgirlSlutMin = 40
    SexSceneShowChangePose = 0
    SexScenePenetrationActive = 0
    SexSceneAnalCount = 0
    SexScenePlayerEdgeHintShown = 0
    SexSceneRimjobEdgeHintShown = 0
    SexSceneHoldBackUsed = 0
    SexSceneAtmShown = 0
    SexGirlPostOrgasmPulse = 0
    SexGirlExhausted = 0
    $SexFinishPlace = ''
    $SexLastText = ''

    gs 'SexSceneTextAction', 'intro'
    gs 'SexSceneClampValues'
---

#SexSceneMain

    *clr
    clr
    cla

    gs 'EnsureGirlData', $SexGirl
    gs 'SexSceneClampValues'
    gs 'SexSceneShowStatusPanel'

    gs 'ShowLocationScreenTitle', 'БЛИЗОСТЬ: ' + $RealName[$SexGirl]

    gs 'SexSceneShowActionImage'

    *pl ' '
    gs 'SexSceneBuildMenu'
    gs 'FormatText', 'делать', '#2060C0', 'huge', 1, 0, ''
    $SexSceneMenuHref = '<a href="exec:gs ''Menu.Show'', ''SexSceneMenu''">' + $FormattedText + '</a>'
    killvar '$FormattedText'
    *p 'Что вы будете ' + $SexSceneMenuHref + '?'
    killvar '$SexSceneMenuHref'

    *pl ' '

    if $SexLastText <> '':
        *p $SexLastText
    else:
        *p $RealName[$SexGirl] + ' смотрит на вас, ожидая вашего следующего шага.'
    end

    if debug = 1:
        *pl ' '
        *pl '[DEBUG] SexSceneMode: ' + STR(SexSceneMode)
        *pl '[DEBUG] SexScenePhase: ' + STR(SexScenePhase)
        *pl '[DEBUG] IntimStage: ' + STR(IntimStage[$SexGirl])
        *pl '[DEBUG] SexStage: ' + STR(SexStage)
        *pl '[DEBUG] SexRound: ' + STR(SexRound)
        *pl '[DEBUG] SexClothesStage: ' + STR(SexClothesStage)
        *pl '[DEBUG] SexSceneUndressReady: ' + STR(SexSceneUndressReady)
        *pl '[DEBUG] Kiss/Grope: ' + STR(SexSceneKissCount) + '/' + STR(SexSceneGropeCount)
        *pl '[DEBUG] SexActType: ' + $SexActType
        *pl '[DEBUG] SexPlayerArousal: ' + STR(SexPlayerArousal)
        *pl '[DEBUG] SexGirlArousal: ' + STR(SexGirlArousal)
        *pl '[DEBUG] SexPlayerCameInScene: ' + STR(SexPlayerCameInScene)
        *pl '[DEBUG] SexGirlCameInScene: ' + STR(SexGirlCameInScene)
        gs 'SexSceneCalcGirlOrgasmCap'
        *pl '[DEBUG] SexGirlOrgasmCap / exhausted: ' + STR(SexGirlOrgasmCap) + ' / ' + STR(SexGirlExhausted)
        *pl '[DEBUG] SexSceneHadPlayerCum: ' + STR(SexSceneHadPlayerCum)
        *pl '[DEBUG] SexUsedToday: ' + STR(SexUsedToday[$SexGirl])
        *pl '[DEBUG] daily_cum_count: ' + STR(daily_cum_count)
        *pl '[DEBUG] SexPlayerOut: ' + STR(SexPlayerOut) + ' | penis menu: ' + STR(SexScenePlayerPenisOk)

        *pl '[DEBUG] HoldBack used: ' + STR(SexSceneHoldBackUsed) + ' | endurance: ' + STR(sexual_endurance)

        if SexSceneMode = 1:
            gs 'SexSceneCalcHoldBackChance'
            *pl '[DEBUG] HoldBack chance: ' + STR(SexHoldBackChance) + '%'
        end

        if $SexGirl = 'amanda':
            gs 'SexSceneCalcAmandaBlowjobCap'
            gs 'SexSceneCalcCumPlayStage'
            *pl '[DEBUG] Amanda oral: ' + STR(AmandaOralStage) + ' | blowjob cap: ' + STR(AmandaBlowjobCap) + ' | count: ' + STR(SexSceneBlowjobCount) + ' | hadAnal: ' + STR(SexSceneHadAnal)
            *pl '[DEBUG] CumPlay stage: ' + STR(SexCumPlayStage) + ' | slut: ' + STR(sluttiness['amanda']) + ' | swallow: ' + STR(oralswallow['amanda'])
            killvar 'AmandaBlowjobCap'
        end
    end
---

#SexSceneShowStatusPanel

    PanelCustomActive = 1

    clr

    gs 'EnsureGirlData', $SexGirl

    if $RealName[$SexGirl] <> '':
        gs 'PanelUiHeader', 'БЛИЗОСТЬ: ' + $RealName[$SexGirl]
    else
        gs 'PanelUiHeader', 'БЛИЗОСТЬ'
    end

    gs 'PanelUiDivider'
    pl ' '

    pl 'Возбуждение Стефана: ' + STR(SexPlayerArousal) + ' / 100'
    pl 'Возбуждение ' + $RealName[$SexGirl] + ': ' + STR(SexGirlArousal) + ' / 100'

    if SexScenePenetrationActive = 1 and ($SexActType = 'vaginal' or $SexActType = 'anal'):
        gs 'SexScenePoseStatusLabel'
        pl 'Поза: ' + $SexPoseStatusLabel
        killvar '$SexPoseStatusLabel'
    end

    pl ' '

    SexDailyMax = can_cum_daily

    if SexDailyMax <= 0:
        SexDailyMax = max_daily_cum
    end

    if SexDailyMax <= 0:
        SexDailyMax = 2
    end

    gs 'SexSceneCalcMenuUnlocks'
    if $SexGirl = 'georgett':
        gs 'SexSceneStatusTextGeorgette'
    else:
        gs 'SexSceneStatusText'
    end

    if SexGirlCameInScene > 0:
        pl $RealName[$SexGirl] + ' получила удовольствие: ' + STR(SexGirlCameInScene) + ' раз.'
    end

    gs 'SexSceneCalcGirlOrgasmCap'

    if SexGirlOrgasmCap > 0:
        pl 'Оргазмы ' + $RealName[$SexGirl] + ' в этой сцене: ' + STR(SexGirlCameInScene) + ' / ' + STR(SexGirlOrgasmCap) + '.'

        if SexGirlExhausted = 1:
            pl $RealName[$SexGirl] + ' затрахана — почти до смерти.'
        elseif SexGirlCameInScene > SexGirlOrgasmCap:
            pl $RealName[$SexGirl] + ' на пределе — больше не выдержит.'
        end
    end

    if SexPlayerCameInScene > 0:
        pl 'Сейчас Стефан кончил: ' + STR(SexPlayerCameInScene) + ' раз.'
    end

    pl 'Сегодня Стефан кончил: ' + STR(daily_cum_count) + ' / ' + STR(SexDailyMax) + '.'

    if daily_cum_count >= SexDailyMax:
        if debug = 1:
            pl 'Дневной лимит исчерпан — в debug сцена всё ещё может продолжаться.'
        else
            pl 'Дневной лимит исчерпан — новый финал сегодня недоступен.'
        end
    end
---

#SexSceneUpdatePlayerOut

    gs 'CanCumToday'

    if PlayerCanCumToday = 0 and debug = 0:
        SexPlayerOut = 1
        SexPlayerArousal = 0
        SexSceneMode = 0
        SexScenePenetrationActive = 0
    end
---

#SexSceneRejectPlayerPenis

    SexScenePenisRejected = 0
    gs 'SexSceneUpdatePlayerOut'

    if SexPlayerOut = 1 and debug = 0:
        gs 'SexSceneTextAction', 'player_out'
        SexScenePenisRejected = 1
    end
---

#SexSceneRejectGirlExhausted

    SexSceneGirlExhaustedRejected = 0

    if SexGirlExhausted = 1:
        gs 'SexSceneTextGirlExhausted'
        SexSceneGirlExhaustedRejected = 1
    end
---

#SexSceneApplyPlayerGain

    gs 'SexSceneUpdatePlayerOut'

    if SexPlayerOut = 1 and debug = 0:
        SexSceneNextPlayerGain = 0
        killvar 'SexScenePlayerGain'
        exit
    end

    SexScenePlayerGain = SexSceneNextPlayerGain
    SexSceneNextPlayerGain = 0

    if SexScenePlayerGain <= 0:
        killvar 'SexScenePlayerGain'
        exit
    end

    if SexPlayerArousal >= 90:
        SexScenePlayerGainHalf = SexScenePlayerGain / 2

        if SexScenePlayerGainHalf < 1:
            SexScenePlayerGainHalf = 1
        end

        SexScenePlayerGain = SexScenePlayerGainHalf
        killvar 'SexScenePlayerGainHalf'
    end

    if SexPlayerArousal < 100:
        SexPlayerArousal += SexScenePlayerGain

        if SexPlayerArousal > 100:
            SexPlayerArousal = 100
        end
    end

    killvar 'SexScenePlayerGain'
---

#SexSceneClampValues

    SexPlayerArousal = SexPlayerArousal + 0

    if SexPlayerArousal < 0:
        SexPlayerArousal = 0
    end

    if SexPlayerArousal > 100:
        SexPlayerArousal = 100
    end

    SexGirlArousal = SexGirlArousal + 0

    if SexGirlArousal < 0:
        SexGirlArousal = 0
    end

    if SexGirlArousal > 120:
        SexGirlArousal = 120
    end

    if SexClothesStage < 0:
        SexClothesStage = 0
    end

    if SexClothesStage > 2:
        SexClothesStage = 2
    end

    gs 'SexSceneUpdatePlayerOut'

    if SexPlayerOut = 1 and debug = 0:
        SexPlayerArousal = 0
    end
---
