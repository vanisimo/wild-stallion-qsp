    gs 'Menu.AddModule', 'SexSceneMenu', {
        gt 'SexSceneActionKiss'
    }
    gs 'Menu.AddCondition', 'SexSceneMenu', "Result=IIF(IntimStage[$SexGirl]>=1 and SexSceneKissCount<2,-1,0)"

