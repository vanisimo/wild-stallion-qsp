    gs 'Menu.AddModule', 'SexSceneMenu', {
        gt 'SexSceneActionCaress'
    }
    gs 'Menu.AddCondition', 'SexSceneMenu', "Result=IIF(IntimStage[$SexGirl]>=2 and SexSceneGropeCount<2,-1,0)"

