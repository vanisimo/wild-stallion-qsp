#SexSceneActionFinish
    $SexFinishPlace = LCASE($ARGS[0])
    SexSimultaneousOrgasm = 0
    SexSceneMode = 1

    gs 'CanCumToday'

    if Result = 0 and debug = 0:
        SexSceneMode = 0
        SexPlayerArousal = 0
        SexPlayerOut = 1
        SexPlayerRest = 0
        gs 'SexSceneTextAction', 'player_out'
        gt 'SexSceneMain'
    end

    if $SexFinishPlace = 'inside':
        if SexGirlArousal >= 85:
            SexGirlArousal += 30
        elseif SexGirlArousal >= 70:
            SexGirlArousal += 25
        else
            SexGirlArousal += 18
        end
    elseif $SexFinishPlace = 'mouth':
        SexGirlArousal += 15
    elseif $SexFinishPlace = 'face':
        SexGirlArousal += 10
    elseif $SexFinishPlace = 'chest':
        SexGirlArousal += 10
    elseif $SexFinishPlace = 'belly':
        SexGirlArousal += 10
    elseif $SexFinishPlace = 'body':
        SexGirlArousal += 8
    else
        SexGirlArousal += 5
    end

    SexGirlArousalBeforeFinish = SexGirlArousal
    $SexActTypeAtFinish = $SexActType

    gs 'SexSceneTextFinish', $SexFinishPlace
    gs 'SexSceneRegisterFinish', $SexFinishPlace
    gs 'SexSceneCheckGirlOrgasm'

    if $SexFinishPlace = 'mouth' and SexGirlOrgasmNow = 0 and $SexActTypeAtFinish = 'blowjob':
        gs 'SexSceneCalcCumPlayStage'

        SexMouthFinishOrgasmReady = 0

        if SexCumPlayStage >= 5 and SexGirlArousalBeforeFinish >= 62:
            SexMouthFinishOrgasmReady = 1
        elseif SexCumPlayStage >= 4 and SexGirlArousalBeforeFinish >= 78:
            SexMouthFinishOrgasmReady = 1
        elseif $SexGirl = 'inga' and IngaOralOrgasmDone = 1 and IngaOralStage >= 5 and SexCumPlayStage >= 3 and SexGirlArousalBeforeFinish >= 72:
            SexMouthFinishOrgasmReady = 1
        end

        if SexMouthFinishOrgasmReady = 1:
            gs 'SexSceneTextMouthFinishOrgasm'
            SexGirlCameInScene += 1
            GiveOrgasms[$SexGirl] += 1
            gs 'SexSceneOnGirlOrgasmCounted'
        end

        killvar 'SexMouthFinishOrgasmReady'
    end

    killvar '$SexActTypeAtFinish'
    killvar 'SexGirlArousalBeforeFinish'

    if Result = 1:
        gs 'RegisterPlayerCum'
    end

    if debug = 1 and Result = 0:
        daily_cum_count += 1
        total_cumshots += 1
        sexual_endurance += 1

        if sexual_endurance > 100:
            sexual_endurance = 100
        end
    end

    SexSceneHadPlayerCum = 1
    SexPlayerCameInScene += 1
    SexPlayerArousal = 0
    SexPlayerRest = 1
    SexSceneHoldBackUsed = 0
    SexScenePenetrationActive = 0
    SexUsedToday[$SexGirl] = 1

    gs 'SexSceneCleanupText', $SexFinishPlace
    gs 'CanCumToday'

    if Result = 0 and debug = 0:
        SexPlayerOut = 1
    end

    SexSceneMode = 2

    gs 'ClampGirlSocialStats', $SexGirl
    gs 'SexSceneClampValues'
    gt 'SexSceneMain'
