    elseif $SexTextAction = 'look':
        $SexLastText = $RealName[$SexGirl] + ' ловит твой взгляд и ждёт следующего шага.'
    elseif $SexTextAction = 'caress':
        $SexLastText = 'Ты не торопишься, позволяя ' + $RealName[$SexGirl] + ' привыкнуть к твоей близости.'
    elseif $SexTextAction = 'breast_caress':
        $SexLastText = 'Твои ласки становятся смелее, и ' + $RealName[$SexGirl] + ' всё хуже скрывает возбуждение.'
    elseif $SexTextAction = 'cuni':
        $SexLastText = 'Ты переходишь к более откровенной ласке. ' + $RealName[$SexGirl] + ' отвечает всё заметнее.'
    elseif $SexTextAction = 'blowjob':
        $SexLastText = $RealName[$SexGirl] + ' решается на более смелую ласку.'
    elseif $SexTextAction = 'vaginal':
        $SexLastText = 'Близость становится полной. ' + $RealName[$SexGirl] + ' сама тянется к тебе.'
    elseif $SexTextAction = 'girl_finish':
        $SexLastText = $RealName[$SexGirl] + ' больше не может сдерживаться и дрожит в твоих руках.'
    elseif $SexTextAction = 'player_finish_good':
        $SexLastText = 'Ты кончаешь, и ' + $RealName[$SexGirl] + ' выглядит довольной.'
    elseif $SexTextAction = 'player_finish_bad':
        $SexLastText = 'Ты срываешься раньше, чем ' + $RealName[$SexGirl] + ' успевает получить удовольствие.'
    elseif $SexTextAction = 'player_out':
        $SexLastText = 'Сил больше нет, чтобы продолжать.'
    elseif $SexTextAction = 'rest':
        $SexLastText = 'Ты даёшь себе немного времени отдышаться.'
    else:
        $SexLastText = $RealName[$SexGirl] + ' ждёт твоего следующего шага.'
    end

    killvar '$SexTextAction'
