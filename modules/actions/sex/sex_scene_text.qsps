    elseif $SexTextAction = 'grope' or $SexTextAction = 'caress':
        $SexLastText = 'Ты ласкаешь ' + $RealName[$SexGirl] + ' — она отвечает на прикосновения и дышит чаще.'
    elseif $SexTextAction = 'undress_her':
        $SexLastText = 'Вы раздеваетесь друг с другом — одежда больше не мешает близости.'
    elseif $SexTextAction = 'undress_gg':
