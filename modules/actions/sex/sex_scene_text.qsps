! ================================================
! FILE: modules/actions/sex/sex_scene_text.qsps
! MODULE: actions/sex
! Тексты универсальной SexScene (sex_scene_core.qsps)
!
! СТРУКТУРА:
!   #SexSceneText              — роутер по $SexGirl и действию
!   #SexSceneTextAmanda*       — ПОЛНЫЙ набор (приоритет, шлифуем сейчас)
!   #SexSceneTextMelissa/Sandra — семья, базовый набор
!   #SexSceneTextBecky/Inga/Clarissa — заглушки, дополняем при тестах
!   #SexSceneTextDefault*      — fallback для остальных NPC
!   #SexSceneTextFinish*       — финал, ATM, оргазмы, прощание
!
! ДЕЙСТВИЯ ($ARGS[0]): intro, kiss, grope, caress, breast_caress, cuni,
!   blowjob, rim, vaginal, anal, pose_change, girl_finish, player_finish_*,
!   player_out, rest
! СЧЁТЧИКИ: SexSceneKissCount, SexSceneGropeCount, SexSceneCuniCount,
!   SexSceneBlowjobCount, SexSceneVaginalCount, SexSceneAnalCount
! ПОЗЫ ($SexPose): missionary, doggy, side, cowgirl, reverse_cowgirl
! ================================================

#SexSceneText
    $SexTextAction = LCASE($ARGS[0])

    if $SexTextAction = '':
        $SexTextAction = 'intro'
    end

    if $SexTextAction = 'pose_change':
        if $SexGirl = 'amanda':
            gs 'SexSceneTextAmandaPoseChange'
        elseif $SexGirl = 'melissa':
            gs 'SexSceneTextMelissaPoseChange'
        elseif $SexGirl = 'sandra':
            gs 'SexSceneTextSandraPoseChange'
        else
            gs 'SexSceneTextDefaultPoseChange'
        end

        killvar '$SexTextAction'
        exit
    end

    if $SexGirl = 'amanda':
        gs 'SexSceneTextAmanda', $SexTextAction
    elseif $SexGirl = 'melissa':
        gs 'SexSceneTextMelissa', $SexTextAction
    elseif $SexGirl = 'sandra':
        gs 'SexSceneTextSandra', $SexTextAction
    elseif $SexGirl = 'becky':
        gs 'SexSceneTextBecky', $SexTextAction
    elseif $SexGirl = 'inga':
        gs 'SexSceneTextInga', $SexTextAction
    elseif $SexGirl = 'clarissa':
        gs 'SexSceneTextClarissa', $SexTextAction
    else:
        gs 'SexSceneTextDefault', $SexTextAction
    end

    killvar '$SexTextAction'
---

! ================================================
! АМАНДА — основные действия (ласки, ораль, прелюдия)
! Голос: дерзкая сестра, «тише» из-за дома, грубость нарастает к траху
! ================================================

#SexSceneTextAmanda
