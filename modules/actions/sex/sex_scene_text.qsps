    if SexClothesStage = 0:
        pl 'Одежда: на месте.'
    elseif SexClothesStage = 1:
        pl 'Одежда: сбита и мешает всё меньше.'
    else:
        pl 'Одежда: уже не мешает близости.'
    end

    if SexClothesStage < 2:
        pl 'Киска ещё закрыта одеждой — сначала разогрейте и разденьте.'
    end

    if SexGirlArousal >= SexKissGirlCap and SexPlayerArousal >= SexKissPlayerCap:
        pl 'Поцелуи больше почти не разогревают — нужны ласки или оральные действия.'
