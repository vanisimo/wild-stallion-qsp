    ! --- intro: вход в сцену ---
    if $SexTextAction = 'intro':
        $SexLastText = 'Аманда запирает дверь на щеколду и смотрит на вас с вызовом — щёки розовые, глаза блестят. За стенкой шаги мамы или смех Мелиссы, но сестра уже расстегнула ворот ночнушки и не делает вид, что это «просто поговорить». Между вами пахнет её кожей, мылом и чем-то сладким от возбуждения.'

    ! --- kiss: SexSceneKissCount ---
    elseif $SexTextAction = 'kiss':
        if SexSceneKissCount = 1:
            $SexLastText = 'Аманда вцепляется в вашу шею и целует — не по-братски: язык сразу в рот, влажно, жадно, с тихим всхлипом. Маленькая грудь вдавливается в вашу грудь сквозь тонкую ткань, соски уже твёрдые. «Не думай, что я твоя навсегда, дурак…» — шепчет между поцелуями, но сама тянет вашу руку себе на задницу.'
        elseif SexSceneKissCount = 2:
            $SexLastText = 'Вы целуете Аманду в шею, ключицы, сосок сквозь ночнушку — она вздрагивает, кусает губу и шипит: «Тише… услышат…» — но раздвигает ноги, когда ваша ладонь скользит по внутренней стороне бедра. Под пальцами уже мокро и горячо.'
        elseif SexSceneKissCount = 3:
            $SexLastText = 'Поцелуй затягивается: переплетённые языки, слюна на подбородке, её стон в ваш рот. Аманда царапает спину ногтями, прижимает бёдра к вашему паху — чувствуете, как её пизда пульсирует сквозь ткань. «Ну и кто тут распустился… брат…»'
        else
            $SexLastText = 'Вы снова затыкаете Аманде рот поцелуем — она отвечает так же грязно: сосёт ваш язык, давит вас на кровать плечом, шепчет в губы: «Хочу… но тише, иначе мама ворвётся.»'
        end

    ! --- grope / caress / breast_caress: SexSceneGropeCount ---
    elseif $SexTextAction = 'grope' or $SexTextAction = 'caress' or $SexTextAction = 'breast_caress':
        if SexSceneGropeCount = 1:
            $SexLastText = 'Руки залезают под ночнушку: маленькие упругие сиськи в ладонях, твёрдые соски между пальцев. Аманда выгибается, стонет в кулак — «Тише…» — и сама задирает подол, чтобы вы добрались ниже. Пальцы находят мокрую щель: губки набухли, сок стекает на бедро.'
        elseif SexSceneGropeCount = 2:
            $SexLastText = 'Вы мнуть грудь сильнее, крутите соски, спускаетесь к клитору — круговые движения, она дёргает бёдрами, кровать едва скрипит. «Не так громко… ах…» — шепчет Аманда, вцепившись в простыню. Пизда хлюпает под пальцами, внутри узко и жарко.'
        elseif SexSceneGropeCount = 3:
            $SexLastText = 'Два пальца входят в мокрую киску — Аманда раздвигает ноги шире, подмахивает, краснеет до ушей. «Ты… точно хочешь трахать свою сестру?» — выдыхает с вызовом. Сок капает на простыню, запах секса в комнате уже не спрятать.'
        else
            $SexLastText = 'Вы снова ласкаете всё сразу: сиськи, живот, клитор, вход в пизду — Аманда дрожит, кусает подушку, чтобы не закричать. Тело отвечает честнее слов: мокро, горячо, бёдра сами ищут ваши пальцы.'
        end

    ! --- cuni: SexSceneCuniCount ---
    elseif $SexTextAction = 'cuni':
        if SexSceneCuniCount = 1:
            $SexLastText = 'Вы раздвигаете ножки Аманды и прижимаетесь ртом к её пизде — язык скользит по мокрым губкам, вкус солоноватый, возбуждающий. Она откидывается на кровать, вцепляется в простыню, стонет в подушку: «Стефан… тише… ах…»'
        elseif SexSceneCuniCount = 2:
            $SexLastText = 'Язык кружит клитор, то нежно, то жёстко — Аманда выгибается, бёдра дёргаются вам в лицо, сок заливает подбородок. Чавканье и приглушённые стоны — она давит вашу голову между ног: «Не останавливайся… только тише…»'
        else
            $SexLastText = 'Вы жадно лижете её пизду, язык входит внутрь, потом снова на клитор — Аманда трясётся, ноги сжимают ваши плечи, голос срывается в шёпот: «Я сейчас… тише, дурак, я сейчас кончу…»'
        end

    ! --- blowjob: SexSceneBlowjobCount ---
    elseif $SexTextAction = 'blowjob':
        if SexSceneBlowjobCount = 1:
            $SexLastText = 'Аманда опускается на колени между ваших ног, расстёгивает штаны и достаёт твёрдый член — смотрит снизу вверх, краснеет, облизывает головку и берёт в рот. Первые движения неловкие, но жадные: губы плотно обхватывают ствол, язык кружит под уздечкой.'
        elseif SexSceneBlowjobCount = 2:
            $SexLastText = 'Она сосёт ритмично — чавкает, слюна течёт по стволу на яйца, рука помогает у основания. Аманда заглядывает вам в глаза и шипит с полным ртом: «Тише… не стони так громко…» — и берёт глубже.'
        elseif SexSceneBlowjobCount = 3:
            $SexLastText = 'Минет становится глубже — она давится, слёзы на ресницах, но не отпускает. Головка бьётся о горло, слюна пачкает подбородок и грудь. «Хочу, чтобы ты кончил… но не на лицо, пока мама внизу…» — шепчет, облизывая ствол.'
        else
            $SexLastText = 'Аманда снова заглатывает ваш член — уверенно, мокро, с влажным чавканьем. Пальцы сжимают яйца, язык не останавливается, она стонет в ствол и подмахивает головой быстрее.'
        end

    ! --- rim: анилингус ---
    elseif $SexTextAction = 'rim':
        $SexLastText = 'Вы переворачиваете Аманду на четвереньки, раздвигаете ягодицы и проводите языком по тугому колечку ануса — она взвизгивает, вцепляется в простыню. «Тише… что ты… ах…» — шепчет, но не отодвигается. «Лизетта говорила, что так тоже можно… только не рассказывай никому, дурак.»'

    ! --- vaginal / anal: отдельные локации по позам ---
    elseif $SexTextAction = 'anal':
        gs 'SexSceneTextAmandaAnal'

    elseif $SexTextAction = 'vaginal':
        gs 'SexSceneTextAmandaVaginal'

    ! --- оргазм девушки / финал игрока / отдых ---
    elseif $SexTextAction = 'girl_finish':
        $SexLastText = 'Аманда больше не держится: тело выгибается дугой, пизда судорожно сжимается, она кончает долго — дрожит, кусает подушку, чтобы не закричать. Пот на ключицах, грудь вздымается, глаза мутные: «Брат… тише… ах…»'

    elseif $SexTextAction = 'player_finish_good':
        $SexLastText = 'Вы на грани — Аманда чувствует пульсацию внутри, смотрит расфокусированным взглядом и шепчет: «Давай… я тоже хочу…» — бёдра сжимают ваш член сильнее.'

    elseif $SexTextAction = 'player_finish_bad':
        $SexLastText = 'Вы срываетесь слишком рано. Аманда замирает, потом фыркает: «Серьёзно? Я ещё даже… ладно. В следующий раз не торопись, брат.» — но ладонь всё равно скользит по вашему влажному члену.'

    elseif $SexTextAction = 'player_out':
        $SexLastText = 'Член уже не встаёт как надо — сил нет. Аманда замечает, усмехается: «Ну и слабак сегодня…» — но ложится рядом, прижимается бедром: «Отдохни. Я никуда.»'

    elseif $SexTextAction = 'rest':
        $SexLastText = 'Вы откидываетесь, переводите дыхание. Аманда лежит рядом, нога на вашей, пальцы невзначай обхватывают полуэрегированный член и медленно водят по стволу: «Живой ещё? Хорошо. Потом продолжим.»'

    else
        $SexLastText = 'Аманда смотрит на вас — губы припухли, ночнушка сбита, между ног блестит. «Ну? Трахать будешь или опять только пальцами?» — шепчет с дерзкой улыбкой.'
    end

    killvar '$SexTextAction'
