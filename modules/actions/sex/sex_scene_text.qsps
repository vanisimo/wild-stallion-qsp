        pl 'Куни больше почти не возбуждает Стефана — зато хорошо разогревает её.'
    end

    if SexScenePenetrationReady = 0 and IntimStage[$SexGirl] >= 5:
        pl 'Для траха нужно: одежда не мешает, возбуждение обоих не ниже 40.'
    end

    if SexGirlArousal >= 85 and ($SexActType = 'vaginal' or $SexActType = 'anal'):
        pl 'Она на грани — кончить внутрь, скорее всего, доведёт её вместе с вами.'
    end

    if SexPlayerArousal >= SexPlayerOrgasmFromGirlThreshold and ($SexActType = 'vaginal' or $SexActType = 'anal'):
        pl 'Вы на грани — её оргазм во время траха может добить вас до финала.'
    end

    if SexSceneAnalWarmed = 0 and IntimStage[$SexGirl] >= 5:
        pl 'Перед аналом нужен минет, трах или анилингус в этой сцене.'
    end
