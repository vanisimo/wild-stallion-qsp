#IntimSceneStart
    gt 'SexSceneStart', $ARGS[0], $ARGS[1], $ARGS[2]
---

#CanStartIntimScene
    gs 'CanStartSexScene', $ARGS[0]
    IntimSceneAllowed = SexSceneAllowed
    $IntimSceneDenyReason = $SexSceneDenyReason
    Result = SexSceneAllowed
---

#IntimSceneMain
    gt 'SexSceneMain'
---

#ShowIntimSceneStatus
    gs 'SexSceneShowStatusPanel'
---

#IntimSceneKiss
    gt 'SexSceneActionKiss'
---

#IntimSceneCaress
    gt 'SexSceneActionCaress'
---

#IntimSceneContinue
    gt 'SexSceneActionVaginal'
---

#IntimSceneGirlFinish
    gt 'SexSceneMain'
---

#IntimScenePlayerFinish
    gt 'SexSceneActionFinish', 'inside'
---

#IntimSceneEnd
    gt 'SexSceneEnd'
---

#ClampIntimSceneValues
    gs 'SexSceneClampValues'
---
