#GroupSexMenu
    gs 'NormalizeGirlKey', $ARGS[0]
    $GroupMenuGirl = $GirlKey
    if $CurrentLoc = '':
        $CurrentLoc = 'PlayerRoom'
    end
    gt 'GirlIntim', $GroupMenuGirl, $CurrentLoc
