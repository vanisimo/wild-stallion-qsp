! MODULE: actions/sex
! Тексты универсальной SexScene — Инга
! ================================================

#SexSceneTextInga
    $SexTextAction = LCASE($ARGS[0])

    if $SexTextAction = 'intro':
        if IngaBackroomFirstSexActive = 1:
            $SexLastText = 'Инга прижимает тебя к ящикам в подсобке и шепчет: "Быстро… мама в зале."'
        else:
            $SexLastText = 'Инга смотрит на тебя с тихой решимостью — она выбрала тебя, а не Лукаса.'
        end
    elseif $SexTextAction = 'kiss':
        $SexLastText = 'Поцелуй с Ингой осторожный, но она отвечает всё смелее, забывая о стыде.'
    elseif $SexTextAction = 'caress':
        $SexLastText = 'Ты ласкаешь Ингу неторопливо. Она вздрагивает и шепчет, чтобы ты был тише.'
    elseif $SexTextAction = 'breast_caress':
        $SexLastText = 'Твои руки скользят под платье. Инга краснеет, но не отстраняется.'
    elseif $SexTextAction = 'cuni':
        $SexLastText = 'Ты опускаешься ниже. Инга кусает ладонь, чтобы не выдать себя слишком громким стоном.'
    elseif $SexTextAction = 'blowjob':
        $SexLastText = 'Инга опускается на колени между ящиками — смущённо, но уже без колебаний.'
    elseif $SexTextAction = 'vaginal':
        $SexLastText = 'Близость с Ингой становится полной. Она шепчет твоё имя и больше не сравнивает тебя с Лукасом.'
    elseif $SexTextAction = 'girl_finish':
        $SexLastText = 'Инга дрожит в твоих руках и долго не может отдышаться, пряча лицо у тебя на плече.'
    elseif $SexTextAction = 'player_finish_good':
        $SexLastText = 'Ты кончаешь, а Инга смотрит на тебя с благодарностью и смущённой нежностью.'
    elseif $SexTextAction = 'player_finish_bad':
        $SexLastText = 'Ты срываешься раньше, чем Инга успевает получить своё. Она молчит, но в глазах — лёгкая обида.'
    elseif $SexTextAction = 'player_out':
        $SexLastText = 'Сил больше нет. Инга кивает понимающе: "На сегодня хватит."'
    elseif $SexTextAction = 'rest':
        $SexLastText = 'Ты переводишь дыхание. Инга прислушивается к шагам в лавке.'
    else:
        $SexLastText = 'Инга ждёт твоего следующего шага — с тихим волнением.'
    end

    killvar '$SexTextAction'
---
