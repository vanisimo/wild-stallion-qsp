! ================================================
! FILE: modules/actions/dialogs/talk_with_alber.qsps
! MODULE: actions/dialogs
! [AI-WORKED] Текст переработан / дополнен ассистентом 21.10.2026
! Меню и единый движок разговора с Альбером Легаре
! ================================================

#AlberImportantCheck
    AlberImportantReady = 0
    $AlberImportantAction = ''

    ! 1. Примирение со Стефаном
    if LOC('AlberReconcileCanOffer') = 1:
        gs 'AlberReconcileCanOffer'
        if AlberReconcileCanOffer = 1:
            AlberImportantReady = 1
            $AlberImportantAction = 'reconcile'
            exit
        end
    end

    ! 2. О новом винограднике Клариссы
    if ClarissaGoldenVineyardPlanted = 1 and AlberClarissaVineyardTalkDone = 0 and LOC('AlberClarissaVineyardReaction') = 1:
        AlberImportantReady = 1
        $AlberImportantAction = 'clarissa_vineyard'
        exit
    end

    ! 3. Визит в парадном облачении
    if StefanWearingNobleSuit = 1 and StefanNobleTourLegareDone = 0 and LOC('StefanNobleTourLegare') = 1:
        AlberImportantReady = 1
        $AlberImportantAction = 'noble_tour'
        exit
    end
---

#TalkWithAlber
    $GuyName = 'alber'
    $AlberReturnLoc = $ARGS[0]

    if $AlberReturnLoc = '' or LOC($AlberReturnLoc) = 0:
        $AlberReturnLoc = 'WineShop'
    end

    if LOC('InitAlber') = 1:
        gs 'InitAlber'
    end

    cls

    gs 'SceneShowVisual', 'images/npc/legare/alber_talk', 'Мессир Альбер Легаре: разговор', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С МЕССИРОМ ЛЕГАРЕ'

    gs 'AlberUnifiedTalkRun'

    *pl ' '

    ! Контекстные действия на экране беседы
    if LOC('AlberReconcileCanOffer') = 1:
        gs 'AlberReconcileCanOffer'
        if AlberReconcileCanOffer = 1 and LegareReconciledWithStefan = 0:
            gs 'ActUiPrepare', 'Предложить помириться', 'talk'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AlberReconcileWithStefan', $AlberReturnLoc
            end
        end
    end

    if ClarissaGoldenVineyardPlanted = 1 and AlberClarissaVineyardTalkDone = 0 and LOC('AlberClarissaVineyardReaction') = 1:
        gs 'ActUiPrepare', 'Спросить о винограднике Клариссы', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AlberClarissaVineyardReaction', $AlberReturnLoc
        end
    end

    if StefanWearingNobleSuit = 1 and StefanNobleTourLegareDone = 0 and LOC('StefanNobleTourLegare') = 1:
        gs 'ActUiPrepare', 'Визит в парадном облачении', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'StefanNobleTourLegare'
        end
    end

    gs 'ActUiPrepare', 'Вернуться к прилавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        $TmpLoc = $AlberReturnLoc
        killvar '$AlberReturnLoc'
        gt $TmpLoc
    end
---

#AlberUnifiedTalkRun
    ! 1. Проверка лимита полезных разговоров
    gs 'UsefulTalkCheck', 'alber', 'alber_unified'
    if UsefulTalkResult = 0:
        gs 'AlberTalkLimitReachedText'
        exit
    end

    ! 2. Регистрация полезного разговора
    gs 'UsefulTalkRegister', 'alber', 'alber_unified'

    ! 3. Прогрессивная иерархия тем:
    ! --- Совет наставника (после примирения или высокого доверия) ---
    if (LegareReconciledWithStefan = 1 or Friends['alber'] >= 20) and AlberMentorTalkFirstDone = 0:
        AlberMentorTalkFirstDone = 1
        gs 'AlberTalkMentorRun'

    ! --- О лозе на холме (виноградник Клариссы уже высажен) ---
    elseif ClarissaGoldenVineyardPlanted = 1 and AlberClarissaVineyardTalkDone = 1 and AlberHillVineTalkDone = 0:
        AlberHillVineTalkDone = 1
        gs 'AlberTalkHillVineRun'

    ! --- О Лизетте (если связь раскрыта) ---
    elseif Friends['alber'] >= 8 and (LizetteKnown = 1 or PortMeetWitnessed = 1) and LegareConflictStage < 4 and AlberTalkLizetteFirstDone = 0:
        AlberTalkLizetteFirstDone = 1
        gs 'AlberTalkLizetteRun'

    ! --- О доме и Клариссе ---
    elseif Friends['alber'] >= 6 and LegareConflictStage < 4 and AlberTalkHomeFirstDone = 0:
        AlberTalkHomeFirstDone = 1
        gs 'AlberTalkHomeRun'

    ! --- О детях и лавке ---
    elseif LegareConflictStage < 4 and AlberTalkShopFirstDone = 0:
        AlberTalkShopFirstDone = 1
        gs 'AlberTalkShopRun'

    ! --- Циклическая ротация лор-пулов (все темы сохраняются и циклически повторяются) ---
    else:
        AlberLorePoolCycle += 1
        if AlberLorePoolCycle > 4:
            AlberLorePoolCycle = 0
        end

        if AlberLorePoolCycle = 0 and LegareConflictStage < 4:
            gs 'AlberTalkShopRun'
        elseif AlberLorePoolCycle = 1 and Friends['alber'] >= 6 and LegareConflictStage < 4:
            gs 'AlberTalkHomeRun'
        elseif AlberLorePoolCycle = 2 and Friends['alber'] >= 8 and (LizetteKnown = 1 or PortMeetWitnessed = 1) and LegareConflictStage < 4:
            gs 'AlberTalkLizetteRun'
        elseif AlberLorePoolCycle = 3 and ClarissaGoldenVineyardPlanted = 1:
            gs 'AlberTalkHillVineRun'
        elseif AlberLorePoolCycle = 4 and LegareReconciledWithStefan = 1:
            gs 'AlberTalkMentorRun'
        else:
            gs 'AlberTalkSmalltalkRun'
        end
    end
---

#AlberTalkShopRun
    gs 'AlberTalkShopText'
    if Friends['alber'] < 22:
        Friends['alber'] += 1
    end
    Talked['alber'] += 1
---

#AlberTalkHomeRun
    gs 'AlberTalkHomeText'
    if Friends['alber'] < 25:
        Friends['alber'] += 1
    end
    Talked['alber'] += 1
---

#AlberTalkLizetteRun
    gs 'AlberTalkLizetteText'
    Friends['alber'] += 1
    Talked['alber'] += 1
---

#AlberTalkMentorRun
    gs 'AlberTalkMentorText'
    Friends['alber'] += 1
    trading += 1
    Talked['alber'] += 1
---

#AlberTalkHillVineRun
    gs 'AlberTalkHillVineText'
    Friends['alber'] += 1
    Talked['alber'] += 1
---

#AlberTalkSmalltalkRun
    gs 'AlberTalkSmalltalkText'
    if Friends['alber'] < 10:
        Friends['alber'] += 1
    end
    Talked['alber'] += 1
---

#GuyTalkAppendGiftMenuItems
    $GuyGiftName = LCASE($ARGS[0])
    $GuyGiftReturnLoc = $ARGS[1]
    $GuyGiftMenuName = $ARGS[2]

    ! На текущий момент мужчины города подарки не принимают (резерв под будущие предметы/угощения)

    killvar '$GuyGiftName'
    killvar '$GuyGiftReturnLoc'
    killvar '$GuyGiftMenuName'
---
