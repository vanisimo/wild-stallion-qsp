! ================================================
! FILE: modules/actions/dialogs/girl_talk_images.qsps
! MODULE: actions/dialogs
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! Портреты девушек в разговоре по настроению темы
! images/events/girl_talk/{girl}/{mood}_1.webp
! images/portraits/{girl}/talk_{mood}.webp
! ================================================

#GirlTalkResolveMood
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkMoodGirl = $GirlKey
    $GirlTalkMoodTopic = LCASE($ARGS[1])

    if $GirlTalkMoodTopic = '':
        $GirlTalkMoodTopic = LCASE($TalkTopic)
    end

    $GirlTalkMood = 'calm'

    if $GirlTalkMoodGirl = '':
        killvar '$GirlTalkMoodGirl'
        killvar '$GirlTalkMoodTopic'
        exit
    end

    if GirlOffenseDays[$GirlTalkMoodGirl] > 0:
        $GirlTalkMood = 'angry'
    elseif GirlConflictUntilDay[$GirlTalkMoodGirl] >= day or GirlTalkIrritatedUntilDay[$GirlTalkMoodGirl] >= day:
        $GirlTalkMood = 'angry'
    elseif GirlOffenseInterceptCount[$GirlTalkMoodGirl] >= 3:
        $GirlTalkMood = 'angry'
    elseif GirlOffenseInterceptCount[$GirlTalkMoodGirl] = 2:
        $GirlTalkMood = 'tired'
    elseif TavernStaffBusyDay = 1 or (TavernStaffTiredEvening = 1 and time = 4):
        $GirlTalkMood = 'tired'
    elseif $GirlTalkMoodTopic = 'tavern' and TavernDayEventActive = 1:
        gs 'GirlTalkMoodForTavernDayEvent', $GirlTalkMoodGirl
    elseif $GirlTalkMoodTopic = 'compliment' or $GirlTalkMoodTopic = 'joke':
        if love[$GirlTalkMoodGirl] >= 8 or Friends[$GirlTalkMoodGirl] >= 15:
            $GirlTalkMood = 'happy'
        end
    elseif $GirlTalkMoodTopic = 'family':
        if FamilyTension > FamilyTrust + 15:
            $GirlTalkMood = 'angry'
        elseif FamilyTrust > FamilyTension + 20:
            $GirlTalkMood = 'happy'
        end
    elseif $GirlTalkMoodTopic = 'personal':
        if otkroven[$GirlTalkMoodGirl] >= 25:
            $GirlTalkMood = 'happy'
        else:
            $GirlTalkMood = 'calm'
        end
    elseif hate[$GirlTalkMoodGirl] >= 10:
        $GirlTalkMood = 'angry'
    elseif love[$GirlTalkMoodGirl] >= 12 and sluttiness[$GirlTalkMoodGirl] < 30:
        $GirlTalkMood = 'happy'
    end

    killvar '$GirlTalkMoodGirl'
    killvar '$GirlTalkMoodTopic'
---

#GirlTalkMoodForTavernDayEvent
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkMoodGirl = $GirlKey

    $GirlTalkMood = 'calm'

    if $TavernDayEventId = 'caravan':
        $GirlTalkMood = 'tired'
    elseif $TavernDayEventId = 'rats':
        if $GirlTalkMoodGirl = 'sandra':
            $GirlTalkMood = 'angry'
        else:
            $GirlTalkMood = 'tired'
        end
    elseif $TavernDayEventId = 'brawl':
        $GirlTalkMood = 'angry'
    elseif $TavernDayEventId = 'guard':
        if TavernDayEventGuardPassed = 1:
            $GirlTalkMood = 'calm'
        else:
            $GirlTalkMood = 'angry'
        end
    elseif $TavernDayEventId = 'harvest':
        $GirlTalkMood = 'happy'
    elseif $TavernDayEventId = 'minstrels':
        if $GirlTalkMoodGirl = 'melissa':
            $GirlTalkMood = 'happy'
        else:
            $GirlTalkMood = 'calm'
        end
    elseif $TavernDayEventId = 'storm':
        $GirlTalkMood = 'calm'
    elseif $TavernDayEventId = 'pilgrims':
        $GirlTalkMood = 'calm'
    elseif $TavernDayEventId = 'broken':
        if $GirlTalkMoodGirl = 'sandra':
            $GirlTalkMood = 'angry'
        else:
            $GirlTalkMood = 'tired'
        end
    elseif $TavernDayEventId = 'thief':
        $GirlTalkMood = 'angry'
    end

    killvar '$GirlTalkMoodGirl'
---

#GirlTalkShowMoodImage
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkImageGirl = $GirlKey
    $GirlTalkImageSize = $ARGS[1]
    $GirlTalkImageTopic = LCASE($ARGS[2])

    if $GirlTalkImageGirl = '':
        killvar '$GirlTalkImageGirl'
        killvar '$GirlTalkImageSize'
        killvar '$GirlTalkImageTopic'
        exit
    end

    if $GirlTalkImageSize = '' or $GirlTalkImageSize = 'large':
        $GirlTalkImageSize = 'portrait'
    end

    if $GirlTalkImageGirl = 'amanda':
        gs 'GirlTalkResolveMood', $GirlTalkImageGirl, $GirlTalkImageTopic
        $GirlTalkImageFolder = 'images/events/girl_talk/amanda'
        GirlTalkImageVariants = 2
        if LOC('ShowEventImage') = 1:
            gs 'ShowEventImage', $GirlTalkImageFolder, $GirlTalkMood, GirlTalkImageVariants, 'webp', 'portrait'
        elseif LOC('ShowImage') = 1:
            gs 'ShowImage', 'portrait', 'amanda', 'talk_' + $GirlTalkMood, '', 'webp', $GirlTalkImageSize
        end
        gs 'GirlTalkImageDebugBrief', 'amanda', $GirlTalkMood

    elseif $GirlTalkImageGirl = 'melissa':
        gs 'GirlTalkResolveMood', $GirlTalkImageGirl, $GirlTalkImageTopic
        $GirlTalkImageFolder = 'images/events/girl_talk/melissa'
        GirlTalkImageVariants = 2
        if LOC('ShowEventImage') = 1:
            gs 'ShowEventImage', $GirlTalkImageFolder, $GirlTalkMood, GirlTalkImageVariants, 'webp', 'portrait'
        elseif LOC('ShowImage') = 1:
            gs 'ShowImage', 'portrait', 'melissa', 'talk_' + $GirlTalkMood, '', 'webp', $GirlTalkImageSize
        end
        gs 'GirlTalkImageDebugBrief', 'melissa', $GirlTalkMood

    elseif $GirlTalkImageGirl = 'becky':
        gs 'GirlTalkResolveMood', $GirlTalkImageGirl, $GirlTalkImageTopic
        gs 'ShowImage', 'portrait', 'becky', 'talk_' + $GirlTalkMood, '', 'webp', $GirlTalkImageSize
        gs 'GirlTalkImageDebugBrief', 'becky', $GirlTalkMood

    elseif $GirlTalkImageGirl = 'inga':
        gs 'GirlTalkResolveMood', $GirlTalkImageGirl, $GirlTalkImageTopic
        if $GirlTalkMood = 'happy':
            gs 'ShowImage', 'portrait', 'inga', 'talk_happy', '', 'webp', $GirlTalkImageSize
        else:
            gs 'ShowImage', 'portrait', 'inga', 'portrait1', '', 'webp', $GirlTalkImageSize
        end
        gs 'GirlTalkImageDebugBrief', 'inga', $GirlTalkMood

    elseif $GirlTalkImageGirl = 'georgett':
        gs 'GirlTalkResolveMood', $GirlTalkImageGirl, $GirlTalkImageTopic
        gs 'ShowImage', 'portrait', 'georgett', 'talk_' + $GirlTalkMood, '', 'webp', $GirlTalkImageSize
        gs 'GirlTalkImageDebugBrief', 'georgett', $GirlTalkMood

    elseif $GirlTalkImageGirl = 'clarissa':
        gs 'GirlTalkResolveMood', $GirlTalkImageGirl, $GirlTalkImageTopic
        gs 'ShowImage', 'portrait', 'clarissa', 'talk_' + $GirlTalkMood, '', 'webp', $GirlTalkImageSize
        gs 'GirlTalkImageDebugBrief', 'clarissa', $GirlTalkMood

    elseif $GirlTalkImageGirl = 'irma':
        gs 'ShowImagePath', 'images/locations/irma/shop/talk', 'Ирма в лавке', 'portrait', 'webp'

    elseif $GirlTalkImageGirl = 'lizette':
        gs 'GirlTalkResolveMood', $GirlTalkImageGirl, $GirlTalkImageTopic
        gs 'ShowImage', 'portrait', 'lizette', 'talk_' + $GirlTalkMood, '', 'webp', $GirlTalkImageSize
        gs 'GirlTalkImageDebugBrief', 'lizette', $GirlTalkMood

    else:
        gs 'ResolveGirlTalkContextLoc', $GirlTalkImageGirl
        if $TalkImageLoc = 'Kitchen' and LOC('ShowTavernKitchenImage') = 1:
            gs 'ShowTavernKitchenImage'
        elseif $TalkImageLoc = 'SandraRoom' and LOC('ShowLocationImage') = 1:
            gs 'ShowLocationImage', 'sandra_room', $GirlTalkImageSize, 'png'
        elseif LOC('ShowLocationTimeImage') = 1:
            gs 'ShowLocationTimeImage', 'images/locations/tavern/hall', 'jpg'
        end
    end

    killvar '$TalkImageGirl'
    killvar '$TalkImageSize'
    killvar '$TalkImageTopic'
    killvar '$TalkImageLoc'
    killvar '$GirlTalkImageGirl'
    killvar '$GirlTalkImageSize'
    killvar '$GirlTalkImageTopic'
    killvar '$GirlTalkMood'
    killvar '$GirlTalkImageFolder'
    killvar 'GirlTalkImageVariants'
---

#GirlTalkImageDebugBrief
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkBriefGirl = $GirlKey
    $GirlTalkBriefMood = LCASE($ARGS[1])

    if $GirlTalkBriefGirl = 'inga':
        if $GirlTalkBriefMood = 'happy':
            $GirlTalkBriefPath = 'images/portraits/inga/talk_happy.webp'
        else:
            $GirlTalkBriefPath = 'images/portraits/inga/portrait1.webp'
        end
        $GirlTalkBriefText = 'Портрет Инги в продуктовой лавке за прилавком.'
    elseif $GirlTalkBriefGirl = 'becky':
        $GirlTalkBriefPath = 'images/portraits/becky/talk_' + $GirlTalkBriefMood + '.webp'
        $GirlTalkBriefText = 'Портрет Бекки в продуктовой лавке.'
    elseif $GirlTalkBriefGirl = 'clarissa':
        $GirlTalkBriefPath = 'images/portraits/clarissa/talk_' + $GirlTalkBriefMood + '.webp'
        $GirlTalkBriefText = 'Портрет Клариссы в винной лавке.'
    elseif $GirlTalkBriefGirl = 'irma':
        $GirlTalkBriefPath = 'images/locations/irma/shop/talk.webp'
        $GirlTalkBriefText = 'Ирма в швейной мастерской.'
    elseif $GirlTalkBriefGirl = 'georgett':
        $GirlTalkBriefPath = 'images/portraits/georgett/talk_' + $GirlTalkBriefMood + '.webp'
        $GirlTalkBriefText = 'Портрет Жоржетты в порту.'
    elseif $GirlTalkBriefGirl = 'lizette':
        $GirlTalkBriefPath = 'images/portraits/lizette/talk_' + $GirlTalkBriefMood + '.webp'
        $GirlTalkBriefText = 'Портрет Лизетты.'
    else:
        $GirlTalkBriefPath = 'images/events/girl_talk/' + $GirlTalkBriefGirl + '/' + $GirlTalkBriefMood + '_1.webp'
        $GirlTalkBriefText = ''
    end

    if $GirlTalkBriefText = '':
        if $GirlTalkBriefMood = 'calm':
            $GirlTalkBriefText = 'Портрет ' + $RealName[$GirlTalkBriefGirl] + ' в спокойном настроении во время разговора в трактире. Нейтральная мягкая улыбка или собранное лицо, рабочая одежда официантки/кухни, фон зала слегка размыт. Без откровенного контента.'
        elseif $GirlTalkBriefMood = 'happy':
            $GirlTalkBriefText = 'Портрет ' + $RealName[$GirlTalkBriefGirl] + ' в радостном настроении: живая улыбка, чуть приподнятый подбородок, тёплый взгляд. Трактирный антураж, рабочий наряд, ощущение удачного дня.'
        elseif $GirlTalkBriefMood = 'tired':
            $GirlTalkBriefText = 'Портрет ' + $RealName[$GirlTalkBriefGirl] + ' уставшая после тяжёлой смены: тёмные круги или напряжение в плечах, взгляд в сторону, слабая улыбка или без неё. Рабочая одежда помята, фон трактира.'
        elseif $GirlTalkBriefMood = 'angry':
            $GirlTalkBriefText = 'Портрет ' + $RealName[$GirlTalkBriefGirl] + ' в раздражённом или злом настроении: сжатые губы, холодный или резкий взгляд, скрещённые руки или руки на бёдрах. Трактир, рабочий наряд, без агрессии в сторону зрителя.'
        else:
            $GirlTalkBriefText = 'Портрет девушки в разговоре, средневековый трактир.'
        end
    end

    if debug = 1 or debug_images = 1:
        *pl ' '
        *pl '[DEBUG GIRL TALK IMAGE] girl: ' + $GirlTalkBriefGirl + ', mood: ' + $GirlTalkBriefMood
        *pl '[DEBUG GIRL TALK IMAGE] path: ' + $GirlTalkBriefPath
        *pl '[DEBUG GIRL TALK IMAGE] brief: ' + $GirlTalkBriefText
        *pl ' '
    end

    killvar '$GirlTalkBriefGirl'
    killvar '$GirlTalkBriefMood'
    killvar '$GirlTalkBriefPath'
    killvar '$GirlTalkBriefText'
---

#GirlTalkImageDebugPanel
    gs 'ShowLocationScreenTitle', 'DEBUG: ПОРТРЕТЫ РАЗГОВОРА С ДЕВУШКАМИ'
    *pl 'Папка: images/events/girl_talk/{girl}/'
    *pl 'Настроения: calm, happy, tired, angry'
    *pl ' '

    gs 'ActUiPrepare', 'Аманда / уставшая', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $TalkGirl = 'amanda'
        TavernDayEventActive = 1
        $TavernDayEventId = 'caravan'
        TavernStaffBusyDay = 1
        gs 'GirlTalkShowMoodImage', 'amanda', 'large', 'tavern'
    end

    gs 'ActUiPrepare', 'Мелисса / радостная', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'GirlTalkShowMoodImage', 'melissa', 'large', 'compliment'
    end

    gs 'ActUiPrepare', 'Сандра / злая', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $TalkGirl = 'sandra'
        TavernDayEventActive = 1
        $TavernDayEventId = 'rats'
        gs 'GirlTalkShowMoodImage', 'sandra', 'large', 'tavern'
    end

    act '<b>Вернуться</b>', 'images/common/ui/actions/return.png':
        gt 'TavernMain'
    end
---