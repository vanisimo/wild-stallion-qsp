#GirlTalkGeorgetteText
    $GirlTalkGeorgetteTopic = LCASE($ARGS[0])
    $GirlTalkGeorgettePart = LCASE($ARGS[1])
    $GirlTalkGeorgetteText = ''

    ! ----------------------------------------------------
    ! 0. ДИНАМИЧЕСКИЙ БЛОК ВЕХ (MILESTONE)
    ! ----------------------------------------------------
    if $GirlTalkGeorgettePart = 'milestone':
        if LastSexDay['georgett'] > 0 and (day - LastSexDay['georgett'] <= 1) and (SexGirlCameInScene >= 8 or SexGirlExhausted = 1 or SexMarathonGossipPending['georgett'] = 1):
            *pl 'Жоржетта сладко потягивается всем своим пышным телом, и в её низком хрипловатом смехе слышится неподдельное удовольствие:'
            *pl ' '
            *pl '— Ох, Стефанчик, до сих пор в бёдрах сладостная истома стоит после вчерашнего! В каморке у причала такой шторм подняли, что чайки на крыше переполошились.'
            *pl ' '
            *pl 'Уж сколько я мужчин на своём веку повидала, а ты берёшь так жадно и властно, будто хозяйка всей гавани перед тобой на колени встала. Приходи ещё, красавчик... для тебя у меня всегда самое жаркое место припасено.'
            *pl ' '
        elseif HadSex['georgett'] > 0 and (day - LastSexDay['georgett'] >= 4):
            *pl 'Жоржетта стряхивает пепел, с лукавым укором оглядывая тебя сквозь полумрак:'
            *pl ' '
            *pl '— Что, хозяин трактира, совсем про старую подружку забыл? В зале серебро считаешь или юные девки голову вскружили? Жоржетта, конечно, женщина терпеливая, но по крепким рукам скучать умеет. Не забывай дорогу на ночной причал, Стефан.'
            *pl ' '
        end

    ! ----------------------------------------------------
    ! 1. ТЕМА: ПОРТ И НОЧНАЯ ЖИЗНЬ
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_port':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Порт? — кивает на причал. — Спрашивай.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            if GirlTalkGeorgetteLoreSlot = 0:
                *pl 'Она рассказывает о редких товарах, о матросах, которые платят быстро, и о том, как в тихие дни порт всё равно не спит — просто шепчет тише.'
                *pl ' '
            elseif GirlTalkGeorgetteLoreSlot = 1:
                *pl '— Столичный корабль — праздник для тех, кто умеет смотреть, — усмехается она. — Тут и торговля, и сплетни, и девочки, которые впервые видят шёлк не с ярмарки. Маленький город любит делать вид, что ничего не замечает. А я замечаю всё.'
                *pl ' '
            elseif GirlTalkGeorgetteLoreSlot = 2:
                *pl '— Ты видел толпу у дальнего причала, — говорит она без вопроса. — Лизетка тянется к яркому, как мотылёк. Корабль уедет — останутся слухи, кто кому подарил и кто с кем шептался за ящиками. Я в такие дни работаю вдвое осторожнее: и дочь, и клиенты, и ты — все в одном месте.'
                *pl ' '
            else
                *pl '— Ночью сюда заходят не только матросы, — кивает она на тёмные склады. — Контрабандисты, чиновники без эскорта, вдовы с пустыми глазами. Порт не спрашивает фамилию — только платит ли. Мэр делает вид, что не видит; я делаю вид, что верю. Все довольны.'
                *pl ' '
            end
        end

    ! ----------------------------------------------------
    ! 2. ТЕМА: О СЕБЕ И СВОЕЙ СУДЬБЕ
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_bio':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Обо мне? — смеётся. — Ладно. Спрашивай.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            if GirlTalkGeorgetteLoreSlot = 0:
                *pl 'Жоржетта уклончиво говорит о детях и о том, что в порту «всегда есть дело» для женщины без фамилии за спиной. Улыбается так, будто знает больше, чем говорит.'
                *pl ' '
            elseif GirlTalkGeorgetteLoreSlot = 1:
                *pl 'Она говорит без стыда: ночной порт — не наказание и не падение. Там и деньги, и тело в деле, и она умеет получать удовольствие, а не только считать монеты. Проповеди про грех — для тех, кто любит краснеть.'
                *pl ' '
            else
                *pl '— Четверо детей, Стефан. Не сказка, а каши и сапоги, — говорит она без жалости. — Мужей не считаю: один в море, другой в кружке. Я выбрала работу, которая и кормит, и нравится. Город делает вид, что приличный — я делаю вид, что слушаю. Все довольны.'
                *pl ' '
            end
        end

    ! ----------------------------------------------------
    ! 3. ТЕМА: ДОЧЬ ЛИЗЕТТА
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_lizette':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Лизетта? — голос мягче. — Спрашивай.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            if AmandaMetLizette = 1:
                *pl '— Лизетта уже успела найти твоих девочек, да? — усмехается Жоржетта. — Она не злая. Она просто верит, что мир шире, чем позволяют матери. Я тоже так думала — и научилась брать от мира своё, а не ждать счёта. Береги младшую сестру — не из ревности, а потому что моя дочь умеет открывать двери, которые потом не закрываются.'
                *pl ' '
            elseif PortMeetWitnessed = 1:
                *pl '— Ты видел их у корабля, — говорит она без вопроса. — Лизетта тянется к яркому, как мотылёк. Я не могу запереть её. Могу только предупредить того, кто держит в доме молодых девушек.'
                *pl ' '
            else
                *pl 'Жоржетта описывает дочь: умная, красивая, слишком уверенная для своего возраста. «Вся в меня, — говорит она, — только ещё не знает цену.»'
                *pl ' '
            end
        end

    ! ----------------------------------------------------
    ! 4. ТЕМА: КЛИЕНТЫ И МУЖЧИНЫ
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_clients':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Клиенты? — усмехается. — Спрашивай. Я не краснею.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            if GirlTalkGeorgetteLoreSlot = 0:
                *pl '— В день обычно трое-четверо, — говорит она, машинально проводя ладонью по бедру сквозь юбку. — С кем-то успеваешь и сама спустить пару раз, пока он допихивает. А бывают такие торопыги, что только заводишься — а он уже кончил и ушёл.'
                *pl ' '
                *pl '— Помню, заходила военная эскадра. Ох, как тогда имели всех девочек! Меня, наверное, человек двадцать — а то и больше. Я спускала и спускала, сладко было, хоть ноги потом тряслись. — Она усмехается. — Матросы платят быстро. Ремесленники торгуются и краснеют утром — их дело. А «приличные» приходят ночью, когда жена молится за их душу.'
                *pl ' '
            elseif GirlTalkGeorgetteLoreSlot = 1:
                *pl '— Ремесленники — отдельная порода, — смеётся она. — Сначала торгуются за пять монет, потом краснеют, будто я их ограбила. Утром встречаешь на рынке — делают вид, что не знакомы. А ночью снова приходят: «Жоржетта, ну ты же знаешь, я постоянный». Знаю. Постоянный стыдливый.'
                *pl ' '
            else
                *pl '— Самые смешные — «приличные», — кивает она на огни города. — Жена в церкви, он у меня. Платит без торга, лишь бы быстрее — и чтобы никто не увидел. Утром снова муж образцовый. Я не осуждаю: он кормит семью, я кормлю детей. Сделка.'
                *pl ' '
            end
        end

    ! ----------------------------------------------------
    ! 5. ТЕМА: ПОСТЕЛЬ И НАСЛАЖДЕНИЕ
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_sex':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Секс? — прищуривается. — Ладно. Спрашивай.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            if GirlTalkGeorgetteLoreSlot = 0:
                *pl '— Ох, красавчик, мне всегда нравился секс, — говорит она прямо. — Маленькой ещё подсматривала за старшими сестрами на сеновале, за мамой с соседскими дядями — у нас в деревне это не считали чем-то страшным. Когда после танцев меня в уголке зажали двое парней с соседней улицы, я и не ломалась. Пошло-поехало.'
                *pl ' '
                *pl '— Здесь, в городе, за это ещё и платят. Вот только жалко, что многие клиенты думают только о себе — девушке кончить не дают. С тобой хоть внимательнее. — Она кивает тебе, без сентиментальности.'
                *pl ' '
            elseif GirlTalkGeorgetteLoreSlot = 1:
                *pl '— В деревне училась на сеновале и за праздничным столом, — усмехается она. — В городе — за шатром у рынка и в переулке у склада. Разница одна: здесь монеты считают вслух, а стонать просят тише. Тело-то помнит одно и то же удовольствие.'
                *pl ' '
            else
                *pl '— Сначала думала, что работа — это терпеть, — признаётся Жоржетта. — Потом поняла: если уж лежишь, можно и самой получить. Клиент доволен — платит. Я довольна — не злюсь. Все выигрывают, кроме священника, которому нечего исповедовать.'
                *pl ' '
            end
        end

    ! ----------------------------------------------------
    ! 6. ТЕМА: РОДИТЕЛИ И ДЕРЕВНЯ
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_family':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Родители? — пожимает плечами. — Спрашивай.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            if GirlTalkGeorgetteLoreSlot = 0:
                *pl '— Папка ли мне папка — вопрос открытый, мамочка на передок всегда была слаба, — рассказывает она. — А батюня за всеми юбками бегал, да и сейчас, говорят, не остыл. На праздниках у нас вообще весело было: помню, на урожайном пиру мама, старшая сестра Симона и дочка мельника голыми на столах плясали — потом гости их «оприходовали». Папенька Симоне борозду распахал, не глядя, что дочка.'
                *pl ' '
                *pl '— Жили дружно, без лицемерия. Я с папкой да с братцами тоже пару раз перепихнулась — ну и что? Деревня маленькая, все друг друга знают. Город только делает вид, что он другой.'
                *pl ' '
            elseif GirlTalkGeorgetteLoreSlot = 1:
                *pl '— Мама слабая была, папка шустрый, — говорит Жоржетта. — Он за каждой юбкой бегал, а она делала вид, что не видит — пока не приносил монет. Мы в деревне не строили из себя святых. Отсюда и я: знаю цену лицемерию раньше, чем цену хлеба.'
                *pl ' '
            else
                *pl '— На урожайном пиру у нас плясали на столах — кто смелее, тот и громче, — вспоминает она без стыда. — Гости потом «благодарили» танцовщиц. Я тогда ещё девочка была и только смотрела. Подумала: вот это жизнь без нотаций. Город учит краснеть — я не учусь.'
                *pl ' '
            end
        end

    ! ----------------------------------------------------
    ! 7. ТЕМА: ДЕТИ И МАТЕРИНСТВО
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_children':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Дети? — голос мягче. — Спрашивай.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            if GirlTalkGeorgetteLoreSlot = 0:
                *pl '— Четверо у меня, — говорит Жоржетта. — Лизетту почти знаю от кого: неделю после того, как лишилась девства, поехали на рынок. У купца из дальних стран носильщики — мускулы, кожа цвета угля. Мама с тётей Франсуазой шепнули: «пойдём, опробуем». Я просилась с ними — часа два нас имели за шатром. Через время родилась Лизка — смугленькая, вся в отца-чужеземца.'
                *pl ' '
                if LizetteProstPort = 1 or LizetteKnown = 1:
                    *pl '— Остальных троих от кого — не скажу точно, слишком много кандидатов. Младшие у бабушки с дедом живут, а Лизетта уже со мной в порту — помогает, учится. Не запереть её, Стефан. Только научить не отдавать себя даром.'
                    *pl ' '
                else
                    *pl '— Остальных троих от кого — не скажу точно. Живут у моих родителей, а Лизетта порой приезжает ко мне. Я не святая мать — но кашу варю и сапоги покупаю. Этого детям хватает.'
                    *pl ' '
                end
            elseif GirlTalkGeorgetteLoreSlot = 1:
                *pl '— Трое младших у бабушки с дедом в деревне, — говорит она ровно. — Я присылаю монеты, когда есть. Они не спрашивают, откуда — знают и молчат. Лизетта со мной чаще: порт ей нравится, как мне когда-то. Я слежу, чтобы не отдавала себя даром.'
                *pl ' '
            else
                *pl '— Лизка смуглая, вся в отца-чужеземца, — усмехается Жоржетта. — Остальные посветлее — кто от матроса, кто от соседа, кто весть от кого. Счёт вести бессмысленно. Важно, чтобы все четверо были сыты и в сапогах. Этого я и добиваюсь.'
                *pl ' '
            end
        end

    ! ----------------------------------------------------
    ! 8. ТЕМА: ШПИОНАЖ ЗА ЛИЗЕТТОЙ (ЭТАП 1)
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_lizette_spy1':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Ночь, причал, слова — не тело, — кивает Жоржетта. — Говори.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            *pl '— Ты подслушивал у окна в комнате чистых сердец, — говорит она без шёпота. — Значит, слышал то же, что и я по дочери после полуденной службы: красная, сжатая, будто её там не слушали, а вывернули наизнанку.'
            *pl ' '
            *pl '— Отец Герхард спрашивал: видела ли она меня с тобой в соборе, хотела бы сама, трогала ли себя после того, что видела. Торгуется словами — как в порту, только без монет. На этот раз только обнял за плечи и отпустил: «не торопи грех». До его настоящего «благословения» ещё не дошло.'
            *pl ' '
            *pl '— С меня не убудет — ни от твоего подглядывания, ни от её признаний. Дочь ещё думает, что грех — конец света. Пусть сама разберётся, чего хочет. Я рот на замок.'
            *pl ' '
        end

    ! ----------------------------------------------------
    ! 9. ТЕМА: ОТЧЁТ О ЛИЗЕТТЕ И СВЯЩЕННИКЕ
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_lizette_priest':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Ты видел, что было у окна, — без вопроса. — Говори.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            *pl '— Ох, дочка, повзрослела уже, а мне ничего не сказала! — Жоржетта не злится, скорее удивлена. — Волновалась, что мальчиков нет, а она уже с падре перепихнулась. Отец Герхард хорош, дочку мою трахнул — мне и не подумал сказать.'
            *pl ' '
            *pl '— Ну, раз девочка большая уже выросла, будет мне помогать, — решает она. — Не читай мне нотаций, Стефан. Я рада, что ей понравилось. Благословение Ильматера лишним не бывает — я сама знаю.'
            *pl ' '
            *pl '— Завтра ночью встречай нас обеих у причала. Одна она не выходит — только со мной.'
            *pl ' '
        end

    ! ----------------------------------------------------
    ! 10. ТЕМА: ШПИОНАЖ ЗА ЛИЗЕТТОЙ (ЭТАП 2)
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_lizette_spy2':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Снова ночь, снова причал, — говорит Жоржетта. — Лизетты нет. Слушаю.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            *pl '— Ты видел, что было в комнате чистых сердец во второй раз, — говорит она прямо. — Лизетка с отцом Герхардом. Сначала он выспрашивал про мальчишек и про то, что она видела в соборе — потом показал «член, подобный тем, с коими грешила», и дело дошло до кушетки у окна.'
            *pl ' '
            *pl '— Ох, дочка, повзрослела уже, а мне ничего не сказала! Волновалась, что мальчиков нет, а она уже с падре… и мне даже не сказала. — Жоржетта усмехается. — Отец Герхард хорош, дочку мою трахнул — благословил, как он это называет. Не читай мне нотаций, Стефан. Я рада, что ей понравилось. Сама знаю, как там бывает.'
            *pl ' '
            *pl '— Раз девочка большая выросла, будет мне помогать, — решает она. — Пусть работает со мной в порту — под моим глазом, не в твоём зале и не в чужой ширме. Здесь я знаю каждый угол и каждого клиента.'
            *pl ' '
            *pl '— Завтра ночью встретишь нас обеих у причала. Одна она не выходит — только со мной.'
            *pl ' '
        end

    ! ----------------------------------------------------
    ! 11. ТЕМА: КОМПЛИМЕНТ
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_compliment':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Комплимент? — усмехается. — Говори.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            if otkroven['georgett'] >= 24:
                *pl '— Приятно слышать, — усмехается она. — От клиентов комплименты обычно заканчиваются тем, что они хотят сэкономить пять монет. А ты хоть не торгуешься с похвалой.'
                *pl ' '
            else
                *pl '— Льстишь, Стефан, — качает головой Жоржетта, но довольна. — Ладно. Запомню. Но ночь всё равно стоит десять спинтарий — комплимент в котёл не кладёшь.'
                *pl ' '
            end
        end

    ! ----------------------------------------------------
    ! 12. ТЕМА: ЦЕРКОВЬ И ОТЕЦ ГЕРХАРД
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_church':
        if $GirlTalkGeorgettePart = 'intro':
            if GirlTalkGeorgetteChurchPhase = 1:
                *pl '— Церковь? — усмехается. — Спрашивай.'
                *pl ' '
            elseif GirlTalkGeorgetteChurchPhase = 2:
                *pl '— Ты знаешь больше, чем должен, — говорит Жоржетта. — Слушаю.'
                *pl ' '
            else
                *pl '— Ночь. Порт. Церковь за плечами, — поправляет волосы. — Говори.'
                *pl ' '
            end
        elseif $GirlTalkGeorgettePart = 'context':
            if GirlTalkGeorgetteChurchPhase = 1:
                *pl '— Отец Герхард? Кто-то, негодник, наверное, рассказал ему, что мы с тобой на службе шалили, — усмехается она. — Вот он меня и раскрутил на исповеди. Теперь порой после воскресенья меня «благословляет» в комнате чистых сердец. Оргазм и благословение — не спинтарии, конечно, но тоже неплохо. Я не в обиде.'
                *pl ' '
                *pl '— Я хожу, когда надо: дети должны видеть мать в первом ряду. Наутро город снова не знает ничего. Прекрасная сделка.'
                *pl ' '
            elseif GirlTalkGeorgetteChurchPhase = 2:
                *pl '— Ты на исповеди всё выложил, — смеётся Жоржетта. — Ну и правильно: с меня не убудет! Отец Герхард знает, какая я грешница, и всё равно зовёт в комнату чистых сердец. Ему тоже по кайфу грехи отпускать делом, а не одними молитвами.'
                *pl ' '
                *pl '— Ты подслушал у окна? Значит, сам всё видел: благословение я получаю отменное! Не вздумай меня жалеть: мне там ничуть не хуже, чем в порту, только обстановка побогаче.'
                *pl ' '
                if GeorgetteConfessBasic = 1:
                    *pl '— Ты хоть не ври, что удивился, — добавляет она с ухмылкой. — Ты же сам ему про нас разболтал. Теперь живи с этим — и любуйся, как святой отец замаливает наши грешки!'
                    *pl ' '
                end
            else
                if GeorgettePriestSpyLastScene = 2:
                    *pl '— На этой неделе после службы падре опять потребовал показать, как я грешила, — весело усмехается Жоржетта. — Сперва ручками погладила, потом на колени встала и ротиком его порадовала. А напоследок оседлала на стуле, как жеребца! Кончил в меня по самую маточку, смыл все грехи святым семенем. Красота!'
                    *pl ' '
                elseif GeorgettePriestSpyLastScene = 3:
                    *pl '— В это воскресенье он сразу заметил, что я с утра без панталончиков согрешила, — смеётся Жоржетта. — Сперва на коленях погладила, потом верхом оседлала. А когда он меня заполнил своим святым семенем, я его и подколола насчёт доченьки моей, Лизетки — кого он больше любит! Так он, святоша, ловко вывернулся: мол, перед Ильматером обе хороши!'
                    *pl ' '
                elseif GeorgettePriestSpyLastScene = 4:
                    *pl '— На этот раз падре был ненасытен: всё выспрашивал про плотские грехи, — рассказывает Жоржетта. — Я ему такой глубокий минет устроила, что он чуть молитвы не забыл, а потом на стуле оседлала и попросила семя прямо в маточку влить. Заполнил до самых краёв! Оргазм и святое семя — лучшая исповедь.'
                    *pl ' '
                elseif GeorgettePriestSpyLastScene = 5:
                    *pl '— Я его подколола насчёт заповеди о чистоте плоти, — хихикает Жоржетта. — Спросила, мыл ли причинное место святой водой! Он раскраснелся, обиделся, а я языком всё проверила — до самых яичек облизала. Ну а потом оседлала, и он за пару минут в меня кончил. Сказал, что я его языком с ума свела!'
                    *pl ' '
                elseif GeorgettePriestSpyLastScene = 6:
                    *pl '— Рассказала ему про шкипера и боцманов в порту, — улыбается Жоржетта. — Он так возбудился, что аж стул затрещал! Влетел в меня прямо на стуле, как в шторм на палубе, и залил своим благословением. Говорит, смывает грехи портовой жизни.'
                    *pl ' '
                elseif GeorgettePriestSpyLastScene = 7:
                    *pl '— На этой неделе мы уже без всяких церемоний, — довольно потягивается Жоржетта. — Сразу расстегнула ему сутану, ротиком поласкала, а потом оседлала по-хозяйски. Он в меня столько святого семени налил, что на всю неделю благословения хватит. Сказал, что святой круг всегда меня примет!'
                    *pl ' '
                else
                    *pl '— Проповедь про благочестие у алтаря, а за дверью — то, что ты уже видел своими глазами, — усмехается она. — Он зовёт, когда хочет — мы оба знаем, зачем. И оба довольны. Прекрасный обмен!'
                    *pl ' '
                end
                *pl '— Всё из‑за тебя, проказник: не удержал язык за зубами на исповеди — а я теперь в комнате чистых сердец каждую неделю благословение получаю. И знаешь что? Мне там очень даже нравится!'
                *pl ' '
            end
        end

    ! ----------------------------------------------------
    ! 13. ТЕМА: О СОБОРЕ И ЛИЗЕТТЕ
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_lizette_church':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— О соборе и Лизетте? — Жоржетта чуть улыбается, но смотрит на тебя внимательно и тепло. — Спрашивай, Стефан.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            *pl '— Знаю, о чём ты думаешь, — говорит Жоржетта без тени смущения. — Мол, какая мать станет пускать родную дочь глядеть на такое прямо в соборе Ильматера? А я тебе скажу так: на фронтире живём, дикий край, жизнь одним днём отмерена, а слепая невинность — верный приговор!'
            *pl ' '
            *pl '— Отец Герхард с амвона поёт про святую чистоту, а сам в той же комнатке грехи телом смывает с превеликим удовольствием. И правильно делает, плоть живая требует! А если девка вырастет дурочкой, которая от вида мужского уда в обморок хлопается — её первый встречный матрос за медяк обманет, попользует и бросит.'
            *pl ' '
            *pl '— Я Лизетку с малых лет учила жизни радоваться, брать от каждого дня всё и мужиков в кулаке держать. Мужская страсть — силища огромная, и если девка умеет её разжигать да направлять, она королевой ходить будет! И уж лучше она всё увидит со мной — и с тобой, Стефан. Ты парень крепкий, горячий, настоящий жеребец, но не зверь и ласку знаешь. Моя дочка должна видеть, как мужик с ума сходит от наслаждения, и сама от этого гореть!'
            *pl ' '
            *pl '— Так что брось сомнения, красавчик. Мы здесь живём жадно, дышим полной грудью, а завтрашний день пусть сам о себе думает. Ты дал Лизетке отличный урок, а дальше мы с ней в порту зажжём так, что вся гавань завидовать будет!'
            *pl ' '
        end

    ! ----------------------------------------------------
    ! 14. ТЕМА: ЭДДИ ИЗ ЛАВКИ БЕККИ
    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_eddie':
        if $GirlTalkGeorgettePart = 'intro':
            *pl '— Про Эдди из бакалейной лавки? — в её глазах пляшут смешинки. — Спрашивай, Стефан.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            if EddieSawGeorg >= 2:
                *pl '— Эдди? — она качает головой, но усмехается. — Молоко на губах, а глаза уже как у взрослых. Он заглядывал ко мне не за сладостями. Я отшивала — не из доброты к Бекки, а потому что не хочу лишней ссоры с вдовой, которая и так на волосок от слухов. Скажи ей, если хочешь. Или не говори. Мне всё равно — за мной и так ходят тени, а я давно перестала от них прятаться.'
                *pl ' '
            else
                *pl '— Мальчишка любопытный, — признаёт Жоржетта. — Следил, краснел, бегал. В его возрасте это ещё смешно. Через год будет не смешно — ни для него, ни для матери.'
                *pl ' '
            end
        end
    end

    killvar '$GirlTalkGeorgetteTopic'
    killvar '$GirlTalkGeorgettePart'
---