    ! ----------------------------------------------------
    elseif $GirlTalkGeorgetteTopic = 'georgette_bio':
        if $GirlTalkGeorgettePart = 'intro':
            *pl 'Жоржетта тихо посмеивается, откидывая смоляные волосы за плечо, и с любопытством смотрит на тебя из-под полуопущенных ресниц:'
            *pl ' '
            *pl '— Обо мне послушать захотел? — её карие глаза блестят в свете фонаря. — Нечасто мужчины интересуются, что у портовой шлюхи на душе. Ну ладно, Стефан, спрашивай. Врать тебе не стану — чай, не на исповеди.'
            *pl ' '
        elseif $GirlTalkGeorgettePart = 'context':
            if GirlTalkGeorgetteLoreSlot = 0:
                *pl '— Четверо детей у меня, Стефан, — спокойно говорит Жоржетта. — Без богатых дядюшек и без именитых предков. В порт я пришла не от сладкой жизни, но и скулить никогда не привыкла. Здесь женщина всегда заработает на хлеб, если не боится мужских рук и умеет держать язык за зубами.'
                *pl ' '
            elseif GirlTalkGeorgetteLoreSlot = 1:
                *pl '— Я ночной порт не считаю никаким проклятием, — произносит она прямо и без тени стыда. — Здесь живые деньги, здоровое тело в деле, да и я сама люблю мужскую ласку, а не только медяки считаю. А проповеди о грехе пусть слушают те, кому больше заняться нечем.'
                *pl ' '
            else:
                *pl '— Четверо детей, Стефан. Не сказка, а каши и сапоги, — говорит она без жалости. — Мужей не считаю: один в море, другой в кружке. Я выбрала работу, которая и кормит, и нравится. Город делает вид, что приличный — я делаю вид, что слушаю. Все довольны.'
                *pl ' '
            end
        end

