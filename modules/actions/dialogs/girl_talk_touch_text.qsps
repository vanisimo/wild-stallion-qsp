#GirlTalkTouchAmandaText
    $Kind = LCASE($ARGS[0])

    if $Kind = 'hug':
        *pl 'Ты делаешь шаг вперёд и мягко обнимаешь Аманду за худенькие плечи.'
        *pl 'Она на мгновение замирает, удивлённо моргнув, а затем тихо улыбается и робко прислоняется лбом к твоему плечу.'
        *pl '— Стефан... ты сегодня непривычно добрый, — шепчет она.'

    elseif $Kind = 'kiss_cheek':
        *pl 'Ты наклоняешься к сестре и осторожно целуешь её в круглую щёку.'
        if FamilyCorruptionStage <= 1:
            *pl 'Аманда мгновенно заливается густым румянцем и прижимает ладонь к щеке.'
            *pl '— Стефан! Ты чего это среди бела дня... Вдруг гости заметят? — испуганно бормочет она, отводя сияющие глаза.'
        else:
            *pl 'Аманда хихикает, прижимаясь ближе и игриво глядя тебе в лицо.'
            *pl '— И всё? Только в щёку? — дразнит она, покусывая губу.'
        end

    elseif $Kind = 'slap_butt':
        *pl 'Ты резко опускаешь широкую ладонь на аппетитную попу Аманды, звонко шлёпая по ткани юбки.'
        if FamilyCorruptionStage <= 1:
            *pl 'Аманда испуганно вскрикивает, отскакивая на шаг назад и потирая ушибленное место.'
            *pl '— Стефан! Совсем сдурел?! — возмущается она с пылающим лицом. — Руки распускаешь! Я тебе не девка из портовой таверны!'
        else:
            *pl 'Аманда вздрагивает, прикусывает нижнюю губу и оглядывается с лукавой улыбкой.'
            *pl '— Ой... Стефан, ладонь у тебя тяжёлая... Смотри, чтобы Сандра не засекла, — шепчет она, кокетливо покачивая бёдрами.'
        end

    elseif $Kind = 'waist':
        *pl 'Ты уверенно обхватываешь тонкую талию Аманды и рывком притягиваешь её к себе вплотную.'
        if FamilyCorruptionStage <= 3:
            *pl 'Аманда судорожно вдыхает, упираясь ладошками в твою грудь. Её дыхание становится прерывистым.'
            *pl '— Стефан... стой смирно... люди же вокруг, — просит она, но даже не пытается высвободиться.'
        else:
            *pl 'Аманда охотно льнёт всем телом, обнимая тебя за плечи и заглядывая прямо в глаза с пьянящей улыбкой.'
            *pl '— Соскучился по мне, хозяин? — шепчет она, прижимаясь бёдрами к твоему паху.'
        end

    elseif $Kind = 'kiss_neck':
        *pl 'Ты отводишь в сторону прядь светлых волос Аманды и медленно целуешь нежную тёплую кожу на её шее.'
        *pl 'Дрожь пробегает по её телу, пальчики сестры невольно сминают ткань твоей рубахи.'
        *pl '— М-м... Стефан... как же приятно... — тихо стонет она, запрокидывая голову.'

    elseif $Kind = 'squeeze_butt':
        *pl 'Ты кладёшь руку на округлую ягодицу сестры и по-хозяйски сжимаешь упругую плоть.'
        *pl 'Аманда тихо ахает, покорно прогибаясь в пояснице и упираясь бедром в твои ноги.'
        *pl '— Стефан... ты совсем потерял стыд... Что ты со мной делаешь... — горячо выдыхает она.'

    elseif $Kind = 'kiss_lips':
        *pl 'Ты прижимаешь Аманду к деревянной стене и властно накрываешь её рот своими губами.'
        *pl 'Она жалобно вздыхает и тут же охотно раскрывает губы, обвивая твою шею обеими руками.'
        *pl 'Поцелуй получается глубоким, мокрым и голодным. Оторвавшись, Аманда часто дышит, её зрачки расширены.'
        *pl '— Стефан... уведи меня куда-нибудь... прямо сейчас, — умоляет она.'

    elseif $Kind = 'touch_chest':
        *pl 'Ты медленно проводишь ладонью по корсажу Аманды, чувствуя упругую округлость девичьей груди.'
        *pl 'Она подаётся грудью вперёд в твою ладонь, прикрыв веки от нахлынувшего жара.'
        *pl '— Да... вот так... сожми крепче, Стефан... — шепчет сестра с томной истомой.'

    elseif $Kind = 'under_skirt':
        *pl 'Ты скользишь рукой под подол юбки Аманды, поднимаясь пальцами вверх по гладкой коже бедра.'
        if GirlNoPantiesWork['amanda'] = 1:
            *pl 'Твои пальцы натыкаются на абсолютную наготу — под тканью нет никакого белья. Пальцы сразу ощущают влажный сочащийся жар.'
            *pl 'Аманда мелко дрожит и судорожно сжимает твои плечи:'
            *pl '— Стефан... я же без трусиков, как ты велел... Я прямо сейчас протеку на пол... пойдём скорее наверх!'
        else:
            *pl 'Пальцы нащупывают тонкую ткань белья, согретую жаром её тела. Аманда закусывает губу до крови, сжимая твои пальцы бёдрами.'
            *pl '— Стефан... не здесь... пойдём ко мне в комнату, умоляю тебя...'
        end
    end

    killvar '$Kind'
