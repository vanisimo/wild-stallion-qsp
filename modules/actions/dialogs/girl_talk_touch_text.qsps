! ================================================

! FILE: modules/actions/dialogs/girl_talk_touch_text.qsps

! MODULE: actions/dialogs

! [AI-WORKED] Текст переработан / дополнен ассистентом 30.10.2026

! Тексты тактильных инициатив Стефана по коррупции и персонажам

! ================================================

#GirlTalkTouchText
    $TouchGirl = LCASE($ARGS[0])
    $TouchAct = LCASE($ARGS[1])
    $TouchCtx = LCASE($ARGS[2])

    if $TouchGirl = '':
        $TouchGirl = 'amanda'
    end

    if $TouchCtx = '':
        $TouchCtx = 'work'
    end

    if $TalkReturnLoc = 'MarketDance':
        gs 'GirlTalkTouchDanceQuickText', $TouchGirl, $TouchAct
        killvar '$TouchGirl'
        killvar '$TouchAct'
        killvar '$TouchCtx'
        exit
    elseif $TalkReturnLoc = 'Church' or $TalkReturnLoc = 'ChurchSundayService' or $TalkReturnLoc = 'ChurchSundayNoon':
        gs 'GirlTalkTouchChurchQuickText', $TouchGirl, $TouchAct
        killvar '$TouchGirl'
        killvar '$TouchAct'
        killvar '$TouchCtx'
        exit
    end

    if $TouchGirl = 'amanda':
        gs 'GirlTalkTouchAmandaText', $TouchAct, $TouchCtx
    elseif $TouchGirl = 'melissa':
        gs 'GirlTalkTouchMelissaText', $TouchAct, $TouchCtx
    elseif $TouchGirl = 'sandra':
        gs 'GirlTalkTouchSandraText', $TouchAct, $TouchCtx
    elseif $TouchGirl = 'becky':
        gs 'GirlTalkTouchBeckyText', $TouchAct, $TouchCtx
    elseif $TouchGirl = 'clarissa':
        gs 'GirlTalkTouchClarissaText', $TouchAct, $TouchCtx
    elseif $TouchGirl = 'inga':
        gs 'GirlTalkTouchIngaText', $TouchAct, $TouchCtx
    elseif $TouchGirl = 'irma':
        gs 'GirlTalkTouchIrmaText', $TouchAct, $TouchCtx
    elseif $TouchGirl = 'lizette':
        gs 'GirlTalkTouchLizetteText', $TouchAct, $TouchCtx
    elseif $TouchGirl = 'georgett':
        gs 'GirlTalkTouchGeorgetteText', $TouchAct, $TouchCtx
    else:
        gs 'GirlTalkTouchGenericText', $TouchGirl, $TouchAct
    end

    killvar '$TouchGirl'
    killvar '$TouchAct'
    killvar '$TouchCtx'
---

#GirlTalkTouchDanceQuickText
    $DanceTouchGirl = LCASE($ARGS[0])
    $DanceTouchAct = LCASE($ARGS[1])

    if $DanceTouchAct = 'slap_butt':
        *pl 'В шумной круговерти пятничных танцев ты подходишь вплотную к ' + $RealName[$DanceTouchGirl] + ' и звонко, по-хозяйски шлёпаешь её ладонью по округлой попе.'
        if $DanceTouchGirl = 'becky':
            *pl 'Бекки заливисто смеётся, ничуть не смущаясь, и сама виляет пышными бёдрами тебе навстречу: «Ох, Стефан, горячая у тебя рука! Так и тянешь меня в подсобку посреди праздника!»'
        elseif $DanceTouchGirl = 'clarissa':
            *pl 'Кларисса поворачивает голову с азартным блеском в фиолетовых глазах: «Смело, Стефан! Пусть Альбер кружит своих молоденьких, а мы с тобой проведём этот вечер куда веселее».'
        elseif $DanceTouchGirl = 'inga':
            *pl 'Инга вздрагивает от твоей сильной ладони, бросает быстрый расчётливый взгляд в сторону Лукаса и лукаво улыбается тебе: «Сильная хватка, господин хозяин... мне по нраву».'
        elseif $DanceTouchGirl = 'melissa':
            *pl 'От удара по чувствительному месту у Мелиссы перехватывает дух; она кусает губу: «Прямо на площади перед менестрелями, Стефан?! Ты невыносим...»'
        else:
            *pl $RealName[$DanceTouchGirl] + ' игриво ахает, прижимаясь к твоему плечу в гуще танцующих.'
        end
    else:
        *pl 'Пользуясь праздничной толчеёй у фонарей, ты скользишь ладонью по вырезу платья ' + $RealName[$DanceTouchGirl] + ' и крепко сжимаешь её грудь.'
        if $DanceTouchGirl = 'becky':
            *pl 'Бекки томно выдыхает, всегда разгорячённая и готовая к ласке, и сама накрывает твою кисть своей тёплой ладонью: «Мни смелее, милок, от твоих пальцев вся кровь закипает!»'
        elseif $DanceTouchGirl = 'clarissa':
            *pl 'Кларисса выгибается навстречу твоей ладони с победной усмешкой: «Такой напор мне по душе, Стефан... Сегодня счёт в нашу с тобой пользу».'
        elseif $DanceTouchGirl = 'inga':
            *pl 'Инга прижимается к твоему крепкому плечу, оценивая твою мужскую силу: «С таким статным парнем, как ты, Стефан, нигде не пропадёшь».'
        else:
            *pl $RealName[$DanceTouchGirl] + ' прерывисто вздыхает в такт музыке, подаваясь грудью в твою ладонь.'
        end
    end
    *pl 'В свободном заокеанском фронтире никто не строит из себя ханжу: горожане вокруг лишь с живым любопытством поглядывают, кто с кем милуется под музыку, одобрительно перемигиваясь.'

    killvar '$DanceTouchGirl'
    killvar '$DanceTouchAct'
---

#GirlTalkTouchChurchQuickText
    $ChurchTouchGirl = LCASE($ARGS[0])
    $ChurchTouchAct = LCASE($ARGS[1])

    if $ChurchTouchAct = 'slap_butt':
        *pl 'Прямо под высокими сводами собора Ильматера ты незаметно опускаешь ладонь и ощутимо шлёпаешь ' + $RealName[$ChurchTouchGirl] + ' по попе.'
    else:
        *pl 'Выбрав момент среди рядов прихожан в храме Ильматера, ты протягиваешь руку и уверенно сжимаешь грудь ' + $RealName[$ChurchTouchGirl] + '.'
    end

    if TouchStage <= 3 and $ChurchTouchGirl <> 'becky' and $ChurchTouchGirl <> 'georgett':
        *pl $RealName[$ChurchTouchGirl] + ' резко вздрагивает, густо краснеет и возмущённо шикает на тебя шёпотом, оглядываясь на алтарь со священным кругом:'
        *pl '— Стефан, ты совсем рассудок потерял?! Прямо в церкви перед отцом Герхардом! Убери руки сейчас же!'
    else:
        *pl 'Даже в храме нравы фронтира берут своё — ведь сам отец Герхард учит, что плотская тяга угодна жизни. ' + $RealName[$ChurchTouchGirl] + ' воспринимает твою выходку совершенно спокойно, лишь заговорщицки поводит бедром и отвечает тихой улыбкой.'
    end

    killvar '$ChurchTouchGirl'
    killvar '$ChurchTouchAct'
---

#GirlTalkTouchAmandaText
    $TouchAct = LCASE($ARGS[0])
    $TouchCtx = LCASE($ARGS[1])
    if $TouchAct = 'hug':

        *pl 'Ты делаешь шаг вперёд и мягко обнимаешь Аманду за плечи.'

        *pl 'Она на мгновение замирает, удивлённо моргнув, а затем тихо улыбается и прислоняется лбом к твоему плечу.'

        *pl '— Стефан... ты сегодня непривычно добрый, — шепчет она.'
    elseif $TouchAct = 'kiss_cheek':

        *pl 'Ты наклоняешься к сестре и осторожно целуешь её в круглую щёку.'

        if TouchStage <= 1:

            *pl 'Аманда мгновенно заливается густым румянцем и прижимает ладонь к щеке.'

            *pl '— Стефан! Ты чего это среди бела дня... Вдруг гости заметят? — испуганно шепчет она, отводя сияющие глаза.'

        else:

            *pl 'Аманда тихо хихикает, прижимаясь ближе и игриво глядя тебе в лицо.'

            *pl '— И всё? Только в щёку? — дразнит она, покусывая губу.'

        end
    elseif $TouchAct = 'slap_butt':

        *pl 'Ты резко опускаешь широкую ладонь на попу Аманды, звонко шлёпая по ткани юбки.'

        if TouchStage <= 1:

            *pl 'Аманда испуганно вскрикивает, отскакивая на шаг назад и потирая ушибленное место.'

            *pl '— Стефан! Совсем сдурел?! — возмущается она с пылающим лицом. — Руки распускаешь! Я тебе не девка из портовой таверны!'

        else:

            *pl 'Аманда вздрагивает, прикусывает нижнюю губу и оглядывается с лукавой улыбкой.'

            *pl '— Ой... Стефан, ладонь у тебя тяжёлая... Смотри, чтобы Сандра не засекла, — шепчет она, кокетливо покачивая бёдрами.'

        end
    elseif $TouchAct = 'waist':

        *pl 'Ты уверенно обхватываешь тонкую талию Аманды и рывком притягиваешь её к себе вплотную.'

        if TouchStage <= 3:

            *pl 'Аманда судорожно вдыхает, упираясь ладошками в твою грудь. Её дыхание становится прерывистым.'

            *pl '— Стефан... перестань меня лапать... люди же вокруг, — просит она, но даже не пытается высвободиться.'

        else:

            *pl 'Аманда охотно льнёт всем телом, обнимая тебя за плечи и заглядывая прямо в глаза с пьянящей улыбкой.'

            *pl '— Соскучился по мне, братик? — шепчет она, прижимаясь бёдрами к твоему телу.'

        end
    elseif $TouchAct = 'kiss_neck':

        *pl 'Ты отводишь в сторону светлую прядь волос Аманды и медленно целуешь нежную кожу на её шее.'

        *pl 'Дрожь пробегает по её телу, пальцы сестры невольно сминают ткань твоей рубахи.'

        *pl '— М-м... Стефан... как же приятно... — тихо шепчет она, запрокидывая голову.'
    elseif $TouchAct = 'squeeze_butt':

        *pl 'Ты кладёшь руку на округлую ягодицу сестры и по-хозяйски сжимаешь упругую плоть.'

        *pl 'Аманда тихо ахает, покорно прогибаясь в пояснице и упираясь бедром в твои ноги.'

        *pl '— Стефан... ты совсем потерял стыд... Что ты со мной делаешь... — горячо выдыхает она.'
    elseif $TouchAct = 'kiss_lips':

        *pl 'Ты прижимаешь Аманду к деревянной стене и властно накрываешь её рот своими губами.'

        *pl 'Она прерывисто вздыхает и тут же охотно раскрывает губы, обвивая твою шею обеими руками.'

        *pl 'Поцелуй получается глубоким и долгим. Оторвавшись, Аманда часто дышит, её глаза блестят.'

        *pl '— Стефан... уведи меня куда-нибудь... прямо сейчас, — умоляет она.'
    elseif $TouchAct = 'touch_chest':

        *pl 'Ты медленно проводишь ладонью по корсажу Аманды, чувствуя упругую девичью грудь.'

        *pl 'Она подаётся грудью вперёд в твою ладонь, прикрыв веки от нахлынувшего жара.'

        *pl '— Да... вот так... сожми крепче, Стефан... — шепчет сестра с томной истомой.'
    elseif $TouchAct = 'under_skirt':

        *pl 'Ты скользишь рукой под подол юбки Аманды, поднимаясь пальцами вверх по гладкой коже бедра.'

        if GirlNoPantiesWork['amanda'] = 1:

            *pl 'Твои пальцы натыкаются на абсолютную наготу — под тканью нет никакого белья. Пальцы сразу ощущают бархатный сочащийся жар.'

            *pl 'Аманда мелко дрожит и судорожно сжимает твои плечи:'

            *pl '— Стефан... я же без белья, как ты велел... Пойдём скорее наверх!'

        else:

            *pl 'Пальцы нащупывают тонкую ткань белья, согретую жаром её тела. Аманда закусывает губу, сжимая твои пальцы бёдрами.'

            *pl '— Стефан... не здесь... пойдём ко мне в комнату, умоляю тебя...'

        end


    elseif $TouchAct = 'skirt_oral':
        *pl 'Ты опускаешь ладони на бедра и тянешь край юбки вверх, намереваясь спуститься поцелуями ниже пояса.'
        *pl 'Она судорожно ахает, хватаясь пальцами за твои плечи и озираясь по сторонам:'
        *pl '— Стефан! Не посреди же комнаты на виду... Спрячь нас хотя бы за стойкой!'
    elseif $TouchAct = 'guide_hand':
        *pl 'Ты перехватываешь ее ладонь за запястье и уверенно прижимаешь к своим штанам на поясе.'
        *pl 'Ощутив под тканью напряженную твердость, она замирает с перехваченным дыханием и поднимает на тебя расширенные глаза:'
        *pl '— Стефан... ты совсем голову потерял... Кто-нибудь же увидит!'
    end
    killvar '$TouchAct'
    killvar '$TouchCtx'
---

#GirlTalkTouchMelissaText
    $TouchAct = LCASE($ARGS[0])
    $TouchCtx = LCASE($ARGS[1])
    if $TouchAct = 'hug':
        *pl 'Ты делаешь шаг вперёд и приобнимаешь Мелиссу за сведённые усталостью плечи.'
        *pl 'Она сперва остаётся стоять с прямой спиной, окинув тебя ироничным взглядом поверх ведомостей, но от тепла твоих рук её плечи невольно опускаются.'
        *pl '— Решил сбить меня со счёта бочек, Стефан? — ровно спрашивает она, хотя в голосе теплеет. — Или проверяешь, не рассыпалась ли твоя главная помощница?'
    elseif $TouchAct = 'kiss_cheek':
        *pl 'Ты приближаешься и целуешь Мелиссу в гладкую щёку.'
        if TouchStage <= 1:
            *pl 'Мелисса слегка вскидывает бровь, закатывая глаза с видом всезнающей наставницы, но кончики её ушей предательски розовеют.'
            *pl '— Какая предсказуемая нежность. Это награда за сведённый баланс или попытка отвлечь меня от недостачи эля?'
        else:
            *pl 'Мелисса поворачивает голову, встречая твой взгляд в упор; её карие глаза насмешливо и тепло блестят.'
            *pl '— В рыцарских романах дамы от такого падают в обморок, — шепчет она. — Но тебе придётся постараться чуть лучше, братец.'
        end
    elseif $TouchAct = 'slap_butt':
        *pl 'Ты без предупреждения шлёпаешь Мелиссу ладонью по упругой попе.'
        if TouchStage <= 1:
            *pl 'Мелисса резко вздрагивает и разворачивается, её взгляд становится острым, как перо для счетов.'
            *pl '— Какая примитивная выходка, Стефан! — чеканит она, хотя дыхание у неё перехватило. — Ещё раз распустишь руки — будешь сам сводить кассу до утра.'
        else:
            *pl 'По телу Мелиссы пробегает внезапная крупная дрожь — удар приходится прямо по её самой чувствительной зоне. Она прикусывает губу, бросая через плечо потемневший взгляд:'
            *pl '— До чего же вы, мужчины, прямолинейны... — пытается усмехнуться она, но голос заметно подрагивает.'
        end
    elseif $TouchAct = 'waist':
        *pl 'Ты кладёшь руку Мелиссе на пояс и властно прижимаешь её к себе.'
        if TouchStage <= 3:
            *pl 'Мелисса упирается ладонью тебе в грудь, но под твоим уверенным напором её привычный контроль даёт трещину.'
            *pl '— Решил показать, кто в трактире хозяин? Что ж, хватка убедительная... только не мни мне платье.'
        else:
            *pl 'Мелисса сама подаётся навстречу, позволяя снять с себя вечную броню старшей помощницы.'
            *pl '— И что дальше, Стефан? Будешь просто держать меня, как трофей, или перейдёшь к делу?'
        end
    elseif $TouchAct = 'kiss_neck':
        *pl 'Ты наклоняешься к Мелиссе и медленно целуешь её под самое ухо, спускаясь к зажатым мышцам у основания шеи.'
        *pl 'Это её слабое место — она судорожно втягивает воздух, а пальцы мгновенно забывают про строгий порядок и цепляются за твоё плечо.'
        *pl '— Стефан... не туда... — выдыхает она, теряя нить мыслей. — У меня от этого голова идёт кругом...'
    elseif $TouchAct = 'squeeze_butt':
        *pl 'Ты опускаешь руку вниз и крепко, по-хозяйски сжимаешь упругую ягодицу Мелиссы.'
        *pl 'От плотного сжатия сзади её дыхание прерывается резким вдохом, а по спине пробегает непроизвольная волна мурашек.'
        *pl '— Ильматер всеблагой... — сбивчиво шепчет она, невольно подаваясь задом в твою ладонь. — Ты хоть понимаешь, как на меня это действует?..'
    elseif $TouchAct = 'kiss_lips':
        *pl 'Ты решительно притягиваешь Мелиссу к себе, не давая ей вставить ни одной колкости, и накрываешь её губы поцелуем.'
        *pl 'Её насмешливая броня тает в одно мгновение: она прерывисто вздыхает через нос и отвечает с неожиданной, жадной нежностью.'
        *pl '— Ты... ты совершенно сбил меня с мысли, Стефан, — шепчет она, глядя на тебя затуманенными глазами.'
    elseif $TouchAct = 'touch_chest':
        *pl 'Ты уверенно накрываешь ладонью грудь Мелиссы, ощущая сквозь ткань затвердевший сосок.'
        *pl 'Она выпрямляется, тяжело дыша; вся её книжная рассудочность испаряется под жаром твоей руки.'
        *pl '— В трактатах пишут, что телом правит разум... — прерывисто шепчет она. — Какая же это чушь, Стефан...'
    elseif $TouchAct = 'under_skirt':
        *pl 'Ты просовываешь ладонь под край юбки Мелиссы, скользя вверх по гладкому бедру.'
        if GirlNoPantiesWork['melissa'] = 1:
            *pl 'Пальцы сразу натыкаются на горячую голую кожу — под юбкой нет белья. Мелисса вздрагивает всем телом, прикусывая нижнюю губу:'
            *pl '— Ты сам велел мне выйти в зал без белья... — глухо шепчет она. — Доволен своим экспериментом, хозяин?'
        else:
            *pl 'Пальцы скользят по краю её белья. Мелисса тяжело опирается на твою руку, теряя остатки самообладания:'
            *pl '— Стефан... если нас увидят в таком виде, прощай мой авторитет в зале...'
        end
    elseif $TouchAct = 'skirt_oral':
        *pl 'Ты опускаешь ладони на бёдра Мелиссы и тянешь край юбки вверх, намереваясь опуститься перед ней на колени.'
        *pl 'Вся её спесь слетает мгновенно — она судорожно хватает тебя за плечи, расширив карие глаза:'
        *pl '— Стефан, ты в своём уме?! Это совершенно... неразумно посреди комнаты! Уведи меня хотя бы за стойку!'
    elseif $TouchAct = 'guide_hand':
        *pl 'Ты перехватываешь тонкую, испачканную чернилами пальцев ладонь Мелиссы и уверенно прижимаешь к своим штанам на поясе.'
        *pl 'Ощутив под тканью горячую твёрдость, она замирает; в её взгляде строгость борется с острым исследовательским любопытством:'
        *pl '— Какая прямолинейная мужская природа... — шепчет она пересохшими губами. — Спрячь нас за стойку, пока кто-нибудь не вошёл!'
    end
    killvar '$TouchAct'
    killvar '$TouchCtx'
---

#GirlTalkTouchSandraText
    $TouchAct = LCASE($ARGS[0])
    $TouchCtx = LCASE($ARGS[1])
    gs 'GirlTalkCheckSandraThreshold'
    if $TouchAct = 'hug':
        *pl 'На кухне у горячей печи ты делаешь шаг вперёд и крепко обнимаешь Сандру за плечи.'
