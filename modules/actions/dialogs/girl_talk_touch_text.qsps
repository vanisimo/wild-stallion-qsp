#GirlTalkTouchMelissaText
    $Kind = LCASE($ARGS[0])

    if $Kind = 'hug':
        *pl 'Ты делаешь шаг вперёд и приобнимаешь Мелиссу за плечи.'
        *pl 'Она остаётся стоять с прямой спиной, окинув тебя оценивающим взглядом, но отстраняться не спешит.'
        *pl '— Замёрз, Стефан? — ровно спрашивает она. — Или проверяешь, не устала ли я?'

    elseif $Kind = 'kiss_cheek':
        *pl 'Ты приближаешься и целуешь Мелиссу в гладкую щёку.'
        if FamilyCorruptionStage <= 1:
            *pl 'Мелисса слегка вскидывает бровь, на губах играет холодноватая усмешка.'
            *pl '— Это награда за порядок в зале или аванс за вечерний расчёт? — спокойно уточняет она.'
        else:
            *pl 'Мелисса поворачивает голову, встречая твой взгляд в упор, её глаза насмешливо блестят.'
            *pl '— Учишься галантности? Смотри, чтобы запала хватило на большее, — шепчет она.'
        end

    elseif $Kind = 'slap_butt':
        *pl 'Ты без предупреждения шлёпаешь Мелиссу ладонью по тугой попе.'
        if FamilyCorruptionStage <= 1:
            *pl 'Мелисса резко разворачивается, её взгляд становится острым, как бритва.'
            *pl '— Ты ничего не перепутал, Стефан? — чеканит она. — Ещё раз распустишь ладони — останешься без гроша в кассе и без порядка в зале.'
        else:
            *pl 'Мелисса вздрагивает, бросая через плечо лукавый насмешливый взгляд.'
            *pl '— Осмелел? — усмехается она. — Думал, я стану визжать и краснеть? Ошибаешься, братец. Но хватка у тебя неплохая.'
        end

    elseif $Kind = 'waist':
        *pl 'Ты кладёшь руку Мелиссе на пояс и властно прижимаешь её к себе.'
        if FamilyCorruptionStage <= 3:
            *pl 'Мелисса упирается ладонью тебе в плечо, но держит дистанцию чисто символически, её губы насмешливо кривятся.'
            *pl '— Решил показать, кто в доме хозяин? Что ж, хватка крепкая. Главное — удержи.'
        else:
            *pl 'Мелисса сама делает шаг навстречу, прижимаясь бёдрами к твоему бедру с откровенным призывом.'
            *pl '— И что дальше, Стефан? Будешь просто держать или перейдёшь к делу?'
        end

    elseif $Kind = 'kiss_neck':
        *pl 'Ты наклоняешься к Мелиссе и медленно целуешь её под самое ушко, спускаясь к основанию шеи.'
        *pl 'Она медленно и шумно выдыхает, её пальцы на мгновение цепляются за твоё плечо.'
        *pl '— Стефан... держи себя в руках, — негромко произносит она, хотя её голос слегка дрожит.'

    elseif $Kind = 'squeeze_butt':
        *pl 'Ты опускаешь руку вниз и крепко сжимаешь упругую ягодицу Мелиссы.'
        *pl 'Она шумно втягивает воздух сквозь сжатые зубы, подаваясь задом в твою руку.'
        *pl '— Наглеешь на глазах... — шепчет она, глядя исподлобья с тёмным интересом.'

    elseif $Kind = 'kiss_lips':
        *pl 'Ты решительно притягиваешь Мелиссу к себе и впиваешься в её губы поцелуем.'
        *pl 'Она не отстраняется — напротив, её ладонь ложится тебе на затылок, направляя и углубляя поцелуй с уверенным знанием дела.'
        *pl 'Когда вы наконец отстраняетесь, на её щеках играет яркий румянец.'
        *pl '— Неплохо, Стефан, — шепчет она с лёгкой одышкой. — Очень неплохо.'

    elseif $Kind = 'touch_chest':
        *pl 'Ты уверенно накрываешь плотной ладонью грудь Мелиссы, ощущая сквозь ткань твёрдый сосок.'
        *pl 'Она выпрямляется, подавая грудь вперёд под твоё прикосновение, в глазах мелькает жар.'
        *pl '— Нравится? — шепчет она. — Моё тело в твоём распоряжении, хозяин. Только не трать время на пустые вздохи.'

    elseif $Kind = 'under_skirt':
        *pl 'Ты просовываешь ладонь под край юбки Мелиссы, скользя вверх по гладкому прохладному бедру.'
        if GirlNoPantiesWork['melissa'] = 1:
            *pl 'Пальцы сразу натыкаются на горячую голую плоть. Мелисса вздрагивает, прикусывая нижнюю губу и отводя взгляд:'
            *pl '— Стефан... ты сам заставил меня выйти без белья. Теперь чувствуешь, к чему это привело? Вечером зайдёшь ко мне в комнату. Отказов не принимаю.'
        else:
            *pl 'Пальцы скользят по краю её шёлковых трусиков. Мелисса тяжело опирается на твою руку:'
            *pl '— Заканчивай дела в зале, Стефан... Жду тебя наверху.'
        end
    end

    killvar '$Kind'
