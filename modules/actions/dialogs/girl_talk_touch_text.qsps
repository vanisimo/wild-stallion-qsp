#GirlTalkTouchGeorgetteText
    $TouchAct = LCASE($ARGS[0])
    $TouchCtx = LCASE($ARGS[1])
    if $TouchAct = 'hug':

        *pl 'Ты обнимаешь Жоржетту за плечи.'

        *pl 'Она плавно льнёт к тебе всем своим роскошным телом, довольно улыбаясь:'

        *pl '— Приятно видеть ласкового мужчину.'
    elseif $TouchAct = 'kiss_cheek':

        *pl 'Ты целуешь Жоржетту в щёку.'

        if TouchStage <= 1:

            *pl 'Она кокетливо улыбается, скользя пальцем по твоей челюсти:'

            *pl '— Мило, Стефан. Но я знаю, что ты способен на большее.'

        else:

            *pl 'Жоржетта томно щурится, касаясь губами твоей щеки в ответ:'

            *pl '— Раззадориваешь меня, сладкий? Смотри, не пожалей.'

        end
    elseif $TouchAct = 'slap_butt':

        *pl 'Ты с размаху шлёпаешь Жоржетту по пышным ягодицам.'

        if TouchStage <= 1:

            *pl 'Она томно охает, поворачивая голову с соблазнительной улыбкой:'

            *pl '— М-м... какой горячий парень. Шлепок со вкусом.'

        else:

            *pl 'Жоржетта томно прогибается в пояснице, бросая обжигающий взгляд:'

            *pl '— Уверенная рука, Стефан. Мне нравится твоя дерзость.'

        end
    elseif $TouchAct = 'waist':

        *pl 'Ты властно прижимаешь Жоржетту за талию.'

