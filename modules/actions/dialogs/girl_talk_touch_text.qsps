#GirlTalkTouchText
    $TouchGirl = LCASE($ARGS[0])
    $TouchKind = LCASE($ARGS[1])

    if $TouchGirl = '':
        $TouchGirl = 'amanda'
    end

    if $TouchGirl = 'amanda':
        gs 'GirlTalkTouchAmandaText', $TouchKind
    elseif $TouchGirl = 'melissa':
        gs 'GirlTalkTouchMelissaText', $TouchKind
    elseif $TouchGirl = 'sandra':
        gs 'GirlTalkTouchSandraText', $TouchKind
    elseif $TouchGirl = 'becky':
        gs 'GirlTalkTouchBeckyText', $TouchKind
    elseif $TouchGirl = 'clarissa':
        gs 'GirlTalkTouchClarissaText', $TouchKind
    elseif $TouchGirl = 'inga':
        gs 'GirlTalkTouchIngaText', $TouchKind
    elseif $TouchGirl = 'irma':
        gs 'GirlTalkTouchIrmaText', $TouchKind
    elseif $TouchGirl = 'lizette':
        gs 'GirlTalkTouchLizetteText', $TouchKind
    elseif $TouchGirl = 'georgett':
        gs 'GirlTalkTouchGeorgetteText', $TouchKind
    else:
        gs 'GirlTalkTouchGenericText', $TouchGirl, $TouchKind
    end

    killvar '$TouchGirl'
    killvar '$TouchKind'
