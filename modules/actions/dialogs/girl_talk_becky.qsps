! ================================================
! FILE: modules/actions/dialogs/girl_talk_becky.qsps
! MODULE: actions/dialogs
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.10.2026
! Меню и разговоры с Бекки Блэнкеншип в лавке
! ================================================

#GirlTalkBuildBeckyMainMenu
    gs 'Menu.Destroy', 'GirlTalkMainMenu'
    gs 'Menu.Create', 'GirlTalkMainMenu'

    ! ==================== ВАЖНЫЙ РАЗГОВОР (ЕСЛИ ЕСТЬ) ====================
    if BeckyEddieDone = 1 and BeckyEddieNormalizeTalkDone = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор: О новых порядках дома', 'talk'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', $TalkGirl, $TalkReturnLoc, 'becky_eddie_normalize'
        }
    elseif BeckyPriestConfessionSeen = 1 and BeckyPriestOk = 0 and BeckyPriestRetry = 0 and BeckyEddieDone = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор: Утешить после исповеди', 'talk'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', $TalkGirl, $TalkReturnLoc, 'becky_priest_retry'
        }
    elseif BeckyEddieOutraged = 1 and BeckyPriestHint = 0 and BeckyEddieDone = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор: Посоветовать священника', 'talk'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', $TalkGirl, $TalkReturnLoc, 'becky_priest_hint'
        }
    elseif BeckyHomeSex = 1 and EddieHelpPromised = 1 and BeckyEddieOutraged = 0 and BeckyEddieDone = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор: О тайных взглядах Эдди', 'talk'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', $TalkGirl, $TalkReturnLoc, 'becky_eddie_outraged'
        }
    elseif BeckyMayorClerkTalkDone = 0 and (PlayerKnows['becky_backroom_clerk'] = 1 or EventWitnessed['becky_backroom_clerk'] = 1) and Friends['becky'] >= 10:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор: О клерке из мэрии', 'talk'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', $TalkGirl, $TalkReturnLoc, 'becky_clerk'
        }
    elseif BeckyFridayContacts >= 4 and BeckyHomeStage >= 2 and Friends['becky'] >= 12 and HusbandStory > 0 and BeckyHomeStage < 3:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор: Напроситься в гости', 'talk'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', $TalkGirl, $TalkReturnLoc, 'becky_home_invite'
        }
    elseif SandraBeckyCrisisDone = 1 and SandraBeckyTalkBeckyDone = 0 and SandraBeckyHardOffense = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор: О Сандре', 'talk'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'SandraBeckyTalkBecky'
        }
    elseif PlayerHasWarehouseKeys = 1 and PlayerHasDexterityOil = 0 and (sluttiness['becky'] >= 15 or SexSceneCount['becky'] > 0 or BeckySexUnlocked = 1):
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор: О мази «Ловкие пальцы»', 'talk'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'BeckyTalkDexterityOil'
        }
    end

    ! ==================== ПОГОВОРИТЬ (ВСЕГДА) ====================
    gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Поговорить', 'talk'
    gs 'Menu.AddModule', 'GirlTalkMainMenu', {
        gt 'GirlTalkResult', 'becky', $TalkReturnLoc, 'becky_unified'
    }

    ! ==================== ПОДАРОК (ЕСЛИ ЕСТЬ) ====================
    if LOC('GirlTalkAppendGiftMenuItems') = 1:
        gs 'GirlTalkAppendGiftMenuItems'
    end
---

#GirlTalkBeckyUnifiedRun
    ! 1. Проверка лимита полезных разговоров:
    gs 'UsefulTalkCheck', 'becky', 'becky_unified'
    if UsefulTalkResult = 0:
        *pl '— Ох, Стефанчик, не отвлекай хозяйку! — весело подмигивает Бекки, оглаживая цветастый фартук на пышных бёдрах. — Поболтали на славу, а мне ещё кульки перевязывать да муку пересыпать. Заходи попозже, сосед!'
        gs 'ClampGirlSocialStats', 'becky'
        exit
    end

    ! 2. Регистрация полезного разговора:
    gs 'UsefulTalkRegister', 'becky', 'becky_unified'

    ! 3. Иерархия тем:
    ! --- Воспоминание о визите в гости ---
    if BeckyTimesVisited > 0 and BeckyPastVisitTalkToday <> day:
        gs 'GirlTalkBeckyPastVisitRun'

    ! --- Истории об озорствах мужа Эрика (шаги 0-4) ---
    elseif HusbandStory < 5 and Friends['becky'] >= 8:
        gs 'GirlTalkBeckyHusbandRun'

    ! --- Истории о дочке Инге (шаги 0-2) ---
    elseif IngaStory < 3 and Friends['becky'] >= 6:
        gs 'GirlTalkBeckyIngaRun'

    ! --- О сыне Эдди ---
    elseif EddieStory = 0 and Friends['becky'] >= 6:
        gs 'GirlTalkBeckyEddieRun'

    ! --- О забавах Эдди и Жоржетты ---
    elseif EddieSawGeorg >= 2 and HusbandStory > 0 and EddieStory > 0 and Friends['becky'] >= 10 and GeorgMention = 0:
        gs 'GirlTalkBeckyEddieGeorgetteRun'

    ! --- Повседневный разговор о лавке и заказах ---
    else:
        gs 'GirlTalkBeckyShopRun'
    end

    gs 'ClampGirlSocialStats', 'becky'
---

#GirlTalkBeckyShopRun
    *pl 'Ты интересуешься у Бекки, как идут дела в лавке и не подводят ли поставщики.'
    *pl ' '
    *pl 'Вдова охотно отзывается, оглаживая цветастый фартук на пышных бёдрах:'
    *pl ' '
    *pl '— Ох, Стефанчик, грех жаловаться! Мешки с мукой да крупой разлетаются быстро — город-то растёт, кушать все хотят. А трактир твой для меня и вовсе первейший заказчик! Ты заходи почаще, для доброго соседа у меня всегда и товар посвежее припасён, и мера полная.'
    *pl ' '
    *pl 'Бекки лукаво подмигивает, окинув тебя тёплым взглядом хозяйки, знающей толк в торговле.'

    $BeckyShopDailyKey = 'becky_shop_' + STR(day)
    if BeckyShopTalkDay[$BeckyShopDailyKey] = 0:
        BeckyShopTalkDay[$BeckyShopDailyKey] = 1
        if Friends['becky'] < 12:
            Friends['becky'] += 1
        end
        if trading < 30:
            trading += 1
        end
    end
    killvar '$BeckyShopDailyKey'
---

#GirlTalkBeckyIngaRun
    if IngaStory = 0:
        gs 'BeckyTalkIngaStory1Text'
        IngaStory = 1
        if Friends['becky'] < 15:
            Friends['becky'] += 1
        end
    elseif IngaStory = 1:
        gs 'BeckyTalkIngaStory2Text'
        IngaStory = 2
        otkroven['becky'] += 1
    elseif IngaStory = 2:
        gs 'BeckyTalkIngaStory3Text'
        IngaStory = 3
        sluttiness['becky'] += 1
    end

    if $BeckyTalkBlock <> '':
        *pl $BeckyTalkBlock
        killvar '$BeckyTalkBlock'
    end

    gs 'CorruptionProgress', 'becky', 'flirt'
---

