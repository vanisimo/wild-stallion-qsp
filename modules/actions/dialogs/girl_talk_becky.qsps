    if HusbandStory = 0:
        gs 'BeckyTalkHusbandStory1Text'
        HusbandStory = 1
        if Friends['becky'] < 15:
            Friends['becky'] += 1
        end
    elseif HusbandStory = 1:
        gs 'BeckyTalkHusbandStory2Text'
        HusbandStory = 2
        sluttiness['becky'] += 1
    elseif HusbandStory = 2:
        gs 'BeckyTalkHusbandStory3Text'
        HusbandStory = 3
        sluttiness['becky'] += 1
    elseif HusbandStory = 3:
        gs 'BeckyTalkHusbandStory4Text'
        HusbandStory = 4
        otkroven['becky'] += 1
    elseif HusbandStory = 4:
        gs 'BeckyTalkHusbandStory5Text'
        HusbandStory = 5
        sluttiness['becky'] += 1
        otkroven['becky'] += 1
    end

    if $BeckyTalkBlock <> '':
        *pl $BeckyTalkBlock
        killvar '$BeckyTalkBlock'
    end

    gs 'CorruptionProgress', 'becky', 'flirt'
---

#GirlTalkBeckyEddieRun
    EddieStory = 1
    gs 'BeckyTalkEddieStory1Text'
    if Friends['becky'] < 15:
        Friends['becky'] += 1
    end

    if $BeckyTalkBlock <> '':
        *pl $BeckyTalkBlock
        killvar '$BeckyTalkBlock'
    end

    gs 'CorruptionProgress', 'becky', 'talk'
---

#GirlTalkBeckyEddieGeorgetteRun
    GeorgMention = 1
    if EddieStory < 2:
        EddieStory = 2
    end
    gs 'BeckyTalkEddieGeorgText'
    otkroven['becky'] += 2
    sluttiness['becky'] += 1

    if $BeckyTalkBlock <> '':
        *pl $BeckyTalkBlock
        killvar '$BeckyTalkBlock'
    end

    gs 'CorruptionProgress', 'becky', 'flirt'
