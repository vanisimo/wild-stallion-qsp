    BeckyEddieOutraged = 1
    gs 'BeckyTalkEddieOutragedText'
    otkroven['becky'] += 1

    if $BeckyTalkBlock <> '':
        *pl $BeckyTalkBlock
        killvar '$BeckyTalkBlock'
    end

