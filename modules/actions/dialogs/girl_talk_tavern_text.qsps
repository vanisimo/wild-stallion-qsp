! ================================================
! FILE: modules/actions/dialogs/girl_talk_tavern_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! [AI-WORKED] Текст переработан / дополнен ассистентом 28.10.2026
! MODULE: actions/dialogs
! Тексты контекстного разговора о трактире
! ================================================

#GirlTalkTavernText
    $GirlTalkTavernTextId = LCASE($ARGS[0])
    $GirlTalkTavernText = ''

    if $GirlTalkTavernGirl = '':
        $GirlTalkTavernGirl = $TalkGirl
    end

    $GirlTalkTavernChoiceType = $LastHallChoiceType

    if $GirlTalkTavernChoiceType = '' and $GirlTalkTavernGirl <> '':
        $GirlTalkTavernChoiceType = $LastGirlChoiceType[$GirlTalkTavernGirl]
    end

    GirlTalkTavernReputation = tavern_reputation

    if GirlTalkTavernReputation <= 0:
        GirlTalkTavernReputation = TavernReputation
    end

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (ДЕЛОВОЙ ТОН, ЗАЛ, РАСКОВАННОСТЬ)
    ! ----------------------------------------------------
    if $GirlTalkTavernTextId = 'intro':
        if $GirlTalkTavernGirl = 'amanda':
            if FamilyCorruptionStage >= 3 or otkroven['amanda'] >= 25:
                *pl 'Аманда опирается на край стойки, выставляя вперёд попку, и с усмешкой оглядывает зал:'
                *pl ' '
                *pl '— О таверне потолковать хочешь? — она подмигивает тебе. — Мужики валят валом, пялятся на наши попы и платят за внимание.'
                *pl ' '
            elseif otkroven['amanda'] >= 16:
                *pl 'Аманда поправляет съехавшую бретельку, отряхивает фартук и поднимает на тебя взгляд:'
                *pl ' '
                *pl '— О трактире? Ладно, давай, — она слегка улыбается. — Я на ногах с самого утра, но для тебя минутку найду.'
                *pl ' '
            else:
                *pl 'Аманда протирает поднос полотенцем и кивает в сторону зала:'
                *pl ' '
                *pl '— О делах? — она слегка вскидывает подбородок. — Только без поучений: «я тут хозяин, вы подавальщицы». Мы и так знаем, чьё имя в  ратуше записано. Выкладывай, пока клиенты подойти не просят.'
                *pl ' '
            end

        elseif $GirlTalkTavernGirl = 'melissa':
            if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 25:
                *pl 'Мелисса постукивает ногтем по гроссбуху, оглядывая тебя с насмешливой уверенностью, и её взгляд медленно сползает к твоим штанам между ног:'
                *pl ' '
                *pl '— О трактире? — она слегка наклоняет голову. — Заведение приносит отличный доход, когда клиенты думают нижней частью тела, а платят верхней. Главное — держать баланс и не упускать контроль над кассой. Выкладывай, что у тебя.'
                *pl ' '
            elseif otkroven['melissa'] >= 16:
                *pl 'Мелисса откладывает перо, поправляет ворот платья и смотрит на тебя с лёгкой, спокойной полуулыбкой:'
                *pl ' '
                *pl '— О делах заведения? Слушаю тебя, Стефан. Расчёты на сегодня я почти закончила, так что можем сверить мысли. Только давай по существу, без пустой демагогии.'
                *pl ' '
            else:
                *pl 'Мелисса складывает руки на груди, выпрямляет спину и внимательно изучает тебя:'
                *pl ' '
                *pl '— Давай начистоту. Где недосдача, кто ленился, чего не хватает на складе? Я предупреждала: если запустишь дела в зале, потеряешь не только прибыль, но и порядок. Слушаю.'
                *pl ' '
            end

        elseif $GirlTalkTavernGirl = 'sandra':
            if FamilyCorruptionStage >= 3 or otkroven['sandra'] >= 25:
                *pl 'Сандра вытирает ладони о фартук, поправляет глубокий ворот платья, открывая пышную ложбинку, и упирается бедром в край стола. Её глаза теплеют, блуждая по твоим плечам и паху:'
                *pl ' '
                *pl '— О трактире поговорим, Стефан? — она низко усмехается. — Кабацкое дело простое: сытно накормить, крепко налить, а гостей подоить на монеты. Говори прямо, я слушаю своего хозяина.'
                *pl ' '
            elseif otkroven['sandra'] >= 16:
                *pl 'Сандра смахивает прядь со лба, вытирает руки и мягко улыбается тебе:'
                *pl ' '
                *pl '— О трактире, сынок? Давай посидим минутку, пока соус томится. Для тебя у меня всегда время найдётся. Что там в зале происходит?'
                *pl ' '
            else:
                *pl 'Сандра сдвигает котёл на край плиты и оборачивается к тебе, скрестив руки под грудью:'
                *pl ' '
                *pl '— Давай быстрее, Стефан, на кухне дел невпроворот. Трактир нас кормит, но если спустишь порядок на тормозах — хлебать пустые щи будем все вместе. Что стряслось?'
                *pl ' '
            end

        else:
            *pl 'Ты говоришь с'
            *pl ' ' + $RealName[$GirlTalkTavernGirl] + ' о трактире. Ничего лишнего — только запасы, порядок и выручка.'
        end

    ! ----------------------------------------------------
    ! 2. ОСНОВНОЙ КОНТЕКСТ (ЗАПАСЫ, СКАНДАЛЫ, РЕПУТАЦИЯ, НАГРУЗКА)
    ! ----------------------------------------------------
    elseif $GirlTalkTavernTextId = 'context':
        gs 'GirlTalkTavernUseStaffRelief'

        if GirlTalkTavernUseStaffRelief = 1 and tavern_overload_penalty >= 10:
            gs 'GirlTalkTavernStaffReliefText'

        ! Нехватка припасов
        elseif productnum < 30 or winenum < 20 or beernum < 20:
            if FamilyCorruptionStage >= 3:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда хитро подмигивает, поглаживая край столешницы, и бросает взгляд тебе на пояс:'
                    *pl ' '
                    *pl '— На складе почти пусто, Стефан! Мужики, конечно, готовы пить даже кислые остатки, если наливать с глубоким декольте, но эль кончается по-настоящему. Сходи на рынок, пополни бочки — пока клиенты не протрезвели и не разбежались.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса постукивает ногтем по пустой графе прихода и одаривает тебя насмешливым взглядом:'
                    *pl ' '
                    *pl '— Погреб пустеет. Торговать одним лишь женским обаянием выгодно, но без крепкого эля и вина выручка быстро просядет. Иди к торговцам, заполни склад.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра заглядывает в пустой ларь и качает головой, поправляя ворот:'
                    *pl ' '
                    *pl '— Припасы на донышке, сынок. Мужик любит сытное мясо и крепкую выпивку. Не пополнишь запасы сегодня — завтра зал будет гудеть от злости. Не жадничай, закупись как следует.'
                    *pl ' '
                end
            else:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда всплёскивает руками и качает головой:'
                    *pl ' '
                    *pl '— На складе шаром покати, Стефан! Если сегодня набьётся полный зал, мне придётся подавать пустые кружки и разводить руками. Сходи на рынок.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса сухо постукивает пером по пергаменту:'
                    *pl ' '
                    *pl '— Запасы на исходе. Пустые полки — это потерянная выручка и недовольные гости. Иди делай закупки, пока не начался вечерний наплыв.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра хмурится, заглядывая в пустую кадку:'
                    *pl ' '
                    *pl '— На кухне скребём по сусекам. Не пополнишь запасы мяса и муки — гости уйдут голодными и ославят нас на весь город. Не тяни с закупками.'
                    *pl ' '
                else:
                    *pl 'Запасы на исходе. Нужно срочно закупить провизию и выпивку.'
                    *pl ' '
                end
            end

        ! Высокий скандал или развратная слава
        elseif TavernScandal >= 45 or TavernLewdFame >= 35:
            if FamilyCorruptionStage >= 3:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда тихо посмеивается, поправляя глубокий вырез платья, и стреляет глазами к твоим штанам:'
                    *pl ' '
                    *pl '— В городе только и говорят, какие у нас тут вольности творятся! Гости валят валом, чтобы поглазеть на наши формы. Пусть пялятся, Стефан — за это они выкладывают серебро куда охотнее.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса с тонкой усмешкой поправляет бумаги, оглядывая тебя с ног до головы:'
                    *pl ' '
                    *pl '— Слухи о разгуле в нашем заведении разлетаются со скоростью пожара. Городские сплетники возмущаются, но по вечерам сами занимают лучшие столы. Пока этот шум наполняет кассу — он нам на руку.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра хмыкает, уперев руку в округлый бок:'
                    *pl ' '
                    *pl '— Треплются про нас по всему городу. Ханжи носы воротят, зато зал каждый вечер битком. Главное — держи пьяных в узде, а монеты пусть текут в наш карман.'
                    *pl ' '
                end
            else:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда хмурится и опускает глаза, теребя манжет:'
                    *pl ' '
                    *pl '— В городе пошли скверные слухи. Мужики заходят не поужинать, а сально пялиться и отпускать гадкие шуточки. Мне неприятно это терпеть.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса строго сдвигает брови, постукивая пальцами по столу:'
                    *pl ' '
                    *pl '— Дурная слава привлекает зевак и проходимцев, а приличные купцы обходят нас стороной. Скандал разрушает репутацию заведения, Стефан. Это опасная дорожка.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра озабоченно качает головой, сжимая в руке полотенце:'
                    *pl ' '
                    *pl '— Грязная молва о кабаке пачкает всю нашу семью. Доброе имя отмыть куда труднее, чем заплеванный пол. Нужно навести порядок в зале.'
                    *pl ' '
                end
            end

        ! Низкая репутация
        elseif GirlTalkTavernReputation > 0 and GirlTalkTavernReputation < 30:
            if FamilyCorruptionStage >= 3:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда усмехается и поправляет юбку на бёдрах:'
                    *pl ' '
                    *pl '— Чванливые богачи воротят носы, зато простой люд ломится каждый вечер. Плевать на ханжей, Стефан! Лишь бы серебро звенело в карманах.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса сухо замечает, сверяя столбцы цифр:'
                    *pl ' '
                    *pl '— Репутация среди набожных купцов просела. Но для фронтирного кабака это не приговор. Главное — удерживать платёжеспособных гостей и не давать поводов страже.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра хмурится, глядя в сторону двери:'
                    *pl ' '
                    *pl '— В городе шепчутся, будто у нас вертеп. Плевать на сплетников, но драки и поножовщину в зале пресекай сразу. Имя семье ещё пригодится.'
                    *pl ' '
                end
            else:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда нервно кусает губу, оглядывая пустые лавки:'
                    *pl ' '
                    *pl '— На нас косо смотрят в городе. Пара неудачных вечеров — и люди уже шепчутся по углам, будто у нас помойка. Надо что-то делать.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса сухо отчитывается, складывая руки на груди:'
                    *pl ' '
                    *pl '— Репутация заведения упала. Клиенты торгуются за каждый медяк и ведут себя неуважительно. Нужно поднять качество обслуживания, иначе прогорим.'
                    *pl ' '
                else:
                    *pl 'Репутация трактира просела. Нужно вернуть доверие горожан.'
                    *pl ' '
                end
            end

        ! Перегрузка или низкая эффективность персонала
        elseif tavern_overload_penalty >= 20 or tavern_work_efficiency < 45:
            if FamilyCorruptionStage >= 3:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда устало приваливается бедром к стойке, шумно выдыхает и обеими руками поправляет вываливающуюся из выреза грудь. Её затуманенный взгляд скользит по твоим штанам между ног:'
                    *pl ' '
                    *pl '— Нас слишком мало на эту толпу, Стефан! Мужики пьяные, лапают со всех сторон, тянут за юбки...'
                    *pl ' '
                    *pl 'Мне нравится внимание, но когда на одну девку две работы — ноги подкашиваются. Найми ещё кого-нибудь в ратуше. А то у меня сил не останется на ночь с тобой.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса с тихим стуком откладывает перо, потягивается всем телом так, что ткань на груди натягивается, и бросает на тебя насмешливый, но изнурённый взгляд вниз к паху:'
                    *pl ' '
                    *pl '— Разрываться между столами и счетами — глупая экономия, Стефан. Клиенты пялятся на мои формы, сыплют сальностями, а я от усталости уже цифры путаю.'
                    *pl ' '
                    *pl 'Нам нужны служанки в зал. Если ты загонишь меня работой, кто будет считать твою прибыль и греть твою постель? Найми прислугу.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра смахивает пот со лба, облокачивается на край стола, тяжело дыша полной грудью, и смотрит на тебя:'
                    *pl ' '
                    *pl '— Мы с ног валимся, сынок. Девчонки бегают как оглашенные, я у котлов задыхаюсь. Когда в кабаке завал, всё летит кувырком. Иди в ратушу, найми пару девок на подхват. Не жалей медяков, живые люди дороже.'
                    *pl ' '
                end
            else:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда присаживается на край лавки и трёт ноющие ступни:'
                    *pl ' '
                    *pl '— Я еле ноги волочу, Стефан! Народу полно, все орут, требуют выпивки. Одной сложно разорваться между залом и погребом. Найми людей в ратуше, иначе я просто рухну прямо с подносом.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса разминает затёкшую шею, раздражённо сдвигая стопку счетов:'
                    *pl ' '
                    *pl '— Разрываться на две должности сразу — верх неэффективности, Стефан. В суматохе мы путаем кувшины и бьём посуду. Гости злятся, а касса страдает. Дойди до ратуши и найми работниц. Порядок требует свободных рук.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра тяжело опускает половник и упирает руку в поясницу:'
                    *pl ' '
                    *pl '— Нельзя так надрываться. Девчонки в зале на пределе, на кухне котлы кипят. Поговори с клерком в ратуше, найми помощниц. Мы здесь сгинем, если не возьмём людей.'
                    *pl ' '
                else:
                    *pl 'Персонал перегружен работой. Необходимы дополнительные руки.'
                    *pl ' '
                end
            end

        ! Вчерашний день в минусе
        elseif LastDayProfit < 0:
            if FamilyCorruptionStage >= 3:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда прикусывает губку и подходит вплотную, проводя пальцем по твоему поясу:'
                    *pl ' '
                    *pl '— Вчера мы ушли в минус, Стефан... Надо активнее трясти этих пьяниц! Если я расстегну ещё пару пуговиц на корсете, они спустят на выпивку последнее серебро. Подумай об этом, пока считаешь убытки.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса тычет пальцем в красную цифру в гроссбухе и прищуривается, глядя тебе в глаза:'
                    *pl ' '
                    *pl '— Вчера убыток. Мы слишком щедры или недостаточно хитры. В кабацком деле скромность не приносит дохода, Стефан. Пересмотри наценку на вино и заставь зал платить за каждый наш взгляд.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра тяжело вздыхает, опираясь на край печи:'
                    *pl ' '
                    *pl '— Деньги утекли сквозь пальцы, Стефан. Минус по кассе — это тревожный звонок. Соберись, проверь траты. Семья ждёт от тебя уверенности, а не пустых карманов.'
                    *pl ' '
                end
            else:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда говорит без привычных насмешек, глядя на пустые кружки:'
                    *pl ' '
                    *pl '— Вчера мы ушли в убыток. Я в счетах не сильна, но понимаю: если так пойдёт дальше, нам нечем будет платить за крышу. Соберись, Стефан.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса тычет пальцем в итоговую строчку счёта:'
                    *pl ' '
                    *pl '— Вчера чистый минус. Где-то огромная течь: закупки, бой посуды или ленивые работники. Пересмотри расходы, пока мы не залезли в долги.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра тяжело вздыхает, опираясь на стол:'
                    *pl ' '
                    *pl '— Деньги растаяли, день прошёл впустую. Если трактир перестанет приносить доход, нам не на что будет жить. Не опускай руки, Стефан, держи хозяйство крепче.'
                    *pl ' '
                else:
                    *pl 'Вчерашний день принёс убыток. Все смотрят на тебя в ожидании решений.'
                    *pl ' '
                end
            end

        ! Высокая добрая репутация
        elseif GirlTalkTavernReputation >= 60 and TavernScandal < 25:
            if FamilyCorruptionStage >= 3:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда довольно потягивается, улыбаясь во весь рот и поправляя шнуровку:'
                    *pl ' '
                    *pl '— Наш трактир в почёте! Знатные господа заглядывают, кошельки толстые, на чай бросают серебром. В таком зале и повертеть бёдрами приятно.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса удовлетворённо закрывает книгу счетов и усмехается:'
                    *pl ' '
                    *pl '— Высокая репутация и чистые гроссбухи. Идеальная ширма для нашего дома. Гости платят втридорога за статус заведения, а мы снимаем сливки.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра гордо улыбается, оглаживая чистый фартук:'
                    *pl ' '
                    *pl '— О нас говорят с почётом по всему фронтиру. Чисто, сытно, благородно. Ильматер благословляет наш труд, Стефан.'
                    *pl ' '
                end
            else:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда довольно улыбается, поправляя волосы:'
                    *pl ' '
                    *pl '— Наш кабак наконец-то уважают! Приходят солидные люди, платят щедро, ведут себя прилично. В таком зале и работать в радость.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса одобрительно кивает, закрывая книгу:'
                    *pl ' '
                    *pl '— Дела идут ровно. Заведение на хорошем счету, доходы растут. Главное — не расслабляться и удерживать планку.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра с гордостью осматривает чистый зал:'
                    *pl ' '
                    *pl '— В городе о нас говорят с уважением. Похлёбку хвалят, эль свежий, в глаза людям смотреть не стыдно. Доброе дело делаем.'
                    *pl ' '
                else:
                    *pl 'Трактир процветает, доброе имя заведения привлекает лучших гостей.'
                    *pl ' '
                end
            end

        ! Обычный рабочий день
        else:
            if FamilyCorruptionStage >= 3:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда оглаживает фартук на бёдрах и тихо посмеивается, стреляя взглядом к твоим штанам:'
                    *pl ' '
                    *pl '— Спокойный вечер. Мужики пускают слюни на наши формы, я разношу кружки и собираю чаевые. Главное — вовремя качнуть бёдрами у нужного столика, и медяки сами сыплются в карман.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса пересчитывает монеты, неторопливо постукивая пальцем по столу, и одаривает тебя насмешливой полуулыбкой:'
                    *pl ' '
                    *pl '— Всё идёт по плану. Клиенты покорно раскошеливаются, пялясь на наши вырезы. Я держу баланс в гроссбухе, а ты держи порядок в зале. Пока они платят за наши взгляды, этот трактир будет процветать.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра мягко улыбается, поправляя глубокий вырез платья:'
                    *pl ' '
                    *pl '— Зал полон, на кухне сытно шкворчит жаркое, выручка капает. Ты молодец, Стефан, держишь дом крепкой рукой. Поглядываю на тебя — и душа радуется, какой мужчина у нас вырос.'
                    *pl ' '
                end
            else:
                if $GirlTalkTavernGirl = 'amanda':
                    *pl 'Аманда поправляет передник и кивает на столы:'
                    *pl ' '
                    *pl '— День идёт своим чередом. Гости пьют, я подношу. Пока всё спокойно, но расслабляться в зале нельзя ни на минуту.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'melissa':
                    *pl 'Мелисса пересчитывает монеты в ящичке:'
                    *pl ' '
                    *pl '— Обычные кабацкие будни. Главное — контролировать поток выпивки и вовремя пополнять кувшины. Держи ухо востро.'
                    *pl ' '
                elseif $GirlTalkTavernGirl = 'sandra':
                    *pl 'Сандра помешивает варево деревянной ложкой:'
                    *pl ' '
                    *pl '— Всё в порядке, сынок. На кухне шкворчит, в зале шумят в меру. Работай спокойно, дом под присмотром.'
                    *pl ' '
                else:
                    *pl 'Обычные дела трактира — работа идёт своим чередом.'
                    *pl ' '
                end
            end
        end

    ! ----------------------------------------------------
    ! 3. СЛУЖЕБНЫЕ ХУКИ (ПОРТ, СТЫЧКИ, СОБЫТИЯ ДНЯ, РЕМОНТ)
    ! ----------------------------------------------------
    elseif $GirlTalkTavernTextId = 'port_ship_hook':
        gs 'GirlTalkTavernPortShipHookText'

    elseif $GirlTalkTavernTextId = 'hall_hook':
        if $LastHallChoiceEvent = 'noble_attack' and $GirlTalkTavernGirl = 'sandra':
            if $GirlTalkTavernChoiceType = 'sandra_shield':
                *pl 'Сандра тихо роняет, глядя на дверь зала:'
                *pl ' '
                *pl '— Я встала перед клинком не от слабости. В моём доме моего сына чужие хлыщи резать не будут. Но вечер выдался скверным, до сих пор сердце колотится.'
                *pl ' '
            elseif $GirlTalkTavernChoiceType = 'stand_firm':
                *pl 'Сандра крепко сжимает твоё плечо:'
                *pl ' '
                *pl '— Ты не согнулся перед дворянином. Гости это запомнят, а дворянские щенки теперь знают, что здесь живут не рабы. Горжусь тобой.'
                *pl ' '
            elseif $GirlTalkTavernChoiceType = 'yield':
                *pl 'Сандра мягко говорит, без тени упрёка:'
                *pl ' '
                *pl '— Ты остался жив, сынок, и спас дом от разорения. Но не приучай себя кланяться каждому наглецу. В кабацком деле слабину почуют — сожрут.'
                *pl ' '
            else:
                *pl 'Сандра вздыхает:'
                *pl ' '
                *pl '— Сегодня в зале чуть кровь не пролилась. Держи порядок крепче, Стефан.'
                *pl ' '
            end

        elseif $GirlTalkTavernChoiceType = 'protect':
            if $GirlTalkTavernGirl = 'amanda':
                *pl 'Аманда улыбается, заглядывая тебе в глаза:'
                *pl ' '
                *pl '— Хорошо, что ты осадил того хама в зале! А то решили бы, что к нам можно лапы протягивать безнаказанно. Спасибо, Стефан.'
                *pl ' '
            elseif $GirlTalkTavernGirl = 'melissa':
                *pl 'Мелисса довольно кивает:'
                *pl ' '
                *pl '— Ты поставил нахала на место. Гости должны твёрдо знать границы дозволенного. Так держать.'
                *pl ' '
            elseif $GirlTalkTavernGirl = 'sandra':
                *pl 'Сандра с облегчением выдыхает:'
                *pl ' '
                *pl '— Ты спас вечер и защитил девчонку. Настоящий хозяин так и должен поступать.'
                *pl ' '
            else:
                *pl 'Одобряет, что ты вмешался и защитил своих людей.'
                *pl ' '
            end

        elseif $GirlTalkTavernChoiceType = 'calm' or $GirlTalkTavernChoiceType = 'own_choice' or $GirlTalkTavernChoiceType = 'watch' or $GirlTalkTavernChoiceType = 'ignore':
            if $GirlTalkTavernGirl = 'amanda':
                *pl 'Аманда пожимает плечами, отводя глаза:'
                *pl ' '
                *pl '— Ты остался в стороне. Зал, конечно, не разнесли, но теперь я знаю: надеяться мне придётся только на себя.'
                *pl ' '
            elseif $GirlTalkTavernGirl = 'melissa':
                *pl 'Мелисса сухо замечает:'
                *pl ' '
                *pl '— Ты промолчал. Иногда это расчётливость, а иногда обычная нерешительность. Посмотрим, как это аукнется в будущем.'
                *pl ' '
            else:
                *pl 'Ты не стал вмешиваться. Это заметили.'
                *pl ' '
            end

        elseif $GirlTalkTavernChoiceType = 'encourage' or $GirlTalkTavernChoiceType = 'client':
            if $GirlTalkTavernGirl = 'amanda':
                *pl 'Аманда язвительно цедит сквозь зубы:'
                *pl ' '
                *pl '— Если за серебро гостям можно лапать нас, то завтра они придут требовать большего. Не продавай нас, Стефан.'
                *pl ' '
            elseif $GirlTalkTavernGirl = 'melissa':
                *pl 'Мелисса холодно роняет:'
                *pl ' '
                *pl '— Ты выбрал монету вместо гордости. Деньги в кассе, но уважение гостей тает на глазах.'
                *pl ' '
            elseif $GirlTalkTavernGirl = 'sandra':
                *pl 'Сандра строго качает головой:'
                *pl ' '
                *pl '— Монеты взяли, а достоинство потеряли. Это всегда обходится дороже, чем кажется на первый взгляд.'
                *pl ' '
            else:
                *pl 'Деньги получены, но осадок остался тяжёлый.'
                *pl ' '
            end

        else:
            if $GirlTalkTavernGirl = 'amanda':
                *pl 'Аманда задумчиво говорит:'
                *pl ' '
                *pl '— В зале сегодня было жарко. Скажи прямо, на чьей ты стороне, Стефан.'
                *pl ' '
            elseif $GirlTalkTavernGirl = 'melissa':
                *pl 'Мелисса внимательно смотрит на тебя:'
                *pl ' '
                *pl '— Я видела всё, что произошло. Хозяин должен вести за собой, а не просто наблюдать со стороны.'
                *pl ' '
            elseif $GirlTalkTavernGirl = 'sandra':
                *pl 'Сандра устало вздыхает:'
                *pl ' '
                *pl '— Зал полон испытаний, сынок. Главное — оставаться людьми в любой заварухе.'
                *pl ' '
            else:
                *pl 'Вспоминают происшествие в зале — ждут твоих решений.'
                *pl ' '
            end
        end

    elseif $GirlTalkTavernTextId = 'day_event':
        gs 'GirlTalkTavernBuildDayEventText', $GirlTalkTavernGirl

    elseif $GirlTalkTavernTextId = 'repair_hook':
        gs 'GirlTalkTavernBuildRepairHookText', $GirlTalkTavernGirl
    end

    killvar '$GirlTalkTavernTextId'
    killvar '$GirlTalkTavernChoiceType'
    killvar 'GirlTalkTavernReputation'
    killvar 'GirlTalkTavernUseStaffRelief'
---

#GirlTalkTavernBuildDayEventText
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTavernTextGirl = $GirlKey
    $GirlTalkTavernText = ''

    if $GirlTalkTavernTextGirl = '' or TavernDayEventActive = 0 or $TavernDayEventId = '':
        killvar '$GirlTalkTavernTextGirl'
        exit
    end

    if $TavernDayEventId = 'caravan':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Этот торговый караван меня совсем измотал! — Аманда трёт затёкшие запястья. — Носилась между бочками и столами без передышки. Зато выручка отличная.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Караванщики оставили приличную прибыль, но работы было втрое больше, — Мелисса. — Главное, что счета сошлись копейка в копейку.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Когда караван останавливается у нас, кухня кипит без остановки, — Сандра довольно вздыхает. — Устала, но котлы опустели дочиста.'
        end

    elseif $TavernDayEventId = 'rats':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Ты видел этих тварей в кладовой? — Аманда брезгливо передёргивает плечами. — Сандра как закричала, я чуть поднос не уронила! Надо травить их немедленно.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Крысы в запасах — это прямые убытки, — Мелисса хмурится. — Мешки погрызли, крупу испортили. Нельзя запускать кладовые до такого состояния.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Крысы муку попортили, проклятые грызуны! — Сандра сердито стучит по столу. — Полдня вычищала углы. Нужно звать столяра, заделать все щели.'
        end

    elseif $TavernDayEventId = 'brawl':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— После той драки у меня до сих пор руки дрожат, — Аманда поправляет растрёпанные волосы. — Кружки летали, столы трещали. Хорошо хоть нас не задели!'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Пьяная потасовка — худшая реклама для кабака, — Мелисса складывает руки. — Трое буянов подрались, а приличные гости в страхе разбежались. Следи за залом.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Когда в зале кулаками машут, страдают посуда и мои нервы, — Сандра качает головой. — Угомони буянов, Стефан, пока трактир по брёвнышку не растащили.'
        end

    elseif $TavernDayEventId = 'guard':
        if TavernDayEventGuardPassed = 1:
            if $GirlTalkTavernTextGirl = 'amanda':
                $GirlTalkTavernText = '— Городская стража ушла ни с чем! — Аманда с облегчением улыбается. — Я всё утро боялась поборов, но обошлось.'
            elseif $GirlTalkTavernTextGirl = 'melissa':
                $GirlTalkTavernText = '— Инспектор ушёл без штрафа, — Мелисса довольно кивает. — Порядок в бумагах окупается сполна. Так и надо вести дела.'
            elseif $GirlTalkTavernTextGirl = 'sandra':
                $GirlTalkTavernText = '— Стражники проверили чистоту и отвязались, — Сандра вытирает руки. — Слава Ильматеру, всё обошлось миром.'
            end
        else:
            if $GirlTalkTavernTextGirl = 'amanda':
                $GirlTalkTavernText = '— Стражники придирались к каждой мелочи, — Аманда шепчет с досадой. — Стояли над душой, пока штраф не содрали. Злости не хватает!'
            elseif $GirlTalkTavernTextGirl = 'melissa':
                $GirlTalkTavernText = '— Нам выписали штраф, — Мелисса раздражённо стучит пальцами. — Недоглядели за чистотой — расплачивайся звонкой монетой. Пусть будет уроком.'
            elseif $GirlTalkTavernGirl = 'sandra':
                $GirlTalkTavernText = '— Инспектор штраф содрал за непорядок, — Сандра поджимает губы. — Я же говорила: порядок в трактире нужно держать каждый божий день.'
            end
        end

    elseif $TavernDayEventId = 'harvest':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Праздник урожая прошёл шумно! — Аманда улыбается, поправляя косу. — Гости пили за троих, ноги гудят от беготни, но чаевые порадовали.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— День урожая принёс отличную выручку, — Мелисса довольно улыбается. — Зал был полон, запасы разошлись влёт. Отличный день для кассы.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— На праздник урожая кухня дымилась с рассвета, — Сандра тепло усмехается. — Зато все накормлены и довольны. Добрый был денёк.'
        end

    elseif $TavernDayEventId = 'minstrels':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Музыканты отлично разогрели публику! — Аманда смеётся. — Все подпевали, пиво лилось рекой. Только из-за весёлого шума пару заказов перепутала.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Музыка в зале всегда увеличивает продажи эля, — Мелисса. — Люди заслушаются — и заказывают лишнюю кружку. Зови их почаще.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Песни весёлые играли, — Сандра кивает с улыбкой. — Гости вели себя спокойнее, никто в драку не лез. Музыка иногда полезнее окрика.'
        end

    elseif $TavernDayEventId = 'storm':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Из-за ливня на улице ни души, — Аманда вздыхает, глядя в мокрое окно. — Зато выдалась минутка посидеть и перевести дух.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Шторм разогнал посетителей, касса скромная, — Мелисса. — Зато я успела свести все гроссбухи без суеты.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— В такой дождь люди жмутся к камину, — Сандра помешивает угли. — Гостей мало, но похлёбку горячую разбирают с удовольствием.'
        end

    elseif $TavernDayEventId = 'pilgrims':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— В углу сидели паломники Ильматера, — Аманда шепчет. — Смотрели так строго, словно я грешница какая-то. Неловко было наливать им эль.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Паломники платят скромно, но ведут себя смирно, — Мелисса. — Скандалов от них нет, а доброе слово о нашем крове они разнесут дальше по тракту.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Люди веры заходили отдохнуть с дороги, — Сандра очерчивает знак святого круга Ильматера. — Накормила их горячим хлебом. Пусть благословение пребудет с нашим домом.'
        end

    elseif $TavernDayEventId = 'broken':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— В подвале лопнула бочка с элем! — Аманда вздыхает. — Всё утро отмывали полы, эль вытек. Столько добра пропало зря!'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Лопнувшая бочка — это чистый убыток, — Мелисса хмурится. — Проверь обручи на остальных бочках, Стефан. Терять товар на ровном месте мы не можем.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Бочка по швам пошла, — Сандра сердито качает головой. — Стеллажи в подвале покосились. Нужно звать столяра, пока остальные бочки не посыпались.'
        end

    elseif $TavernDayEventId = 'thief':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Ночью в кладовую забрался вор! — Аманда испуганно округляет глаза. — Утащил копчёности и бутылку вина. Страшно подумать, что чужаки лазают по нашему дому.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Нас обокрали, — Мелисса холодно поджимает губы. — Замок на кладовой никуда не годится. Поставь надёжный засов, Стефан, иначе нас обчистят до нитки.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Вор унёс запасы с кухни! — Сандра гневно сжимает кулаки. — Накажи его Ильматер! Повесь крепкий замок на дверь, Стефан, не экономь на безопасности.'
        end
    end

    if $GirlTalkTavernText = '':
        gs 'TavernDayEventHallTextId'
        gs 'TavernDayEventText', $TavernDayEventHallTextId
        $GirlTalkTavernText = '— День выдался хлопотным, — ' + $RealName[$GirlTalkTavernTextGirl] + '. — ' + $TavernDayEventText
        killvar '$TavernDayEventHallTextId'
        killvar '$TavernDayEventText'
    end

    killvar '$GirlTalkTavernTextGirl'
---

#GirlTalkTavernBuildRepairHookText
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTavernTextGirl = $GirlKey
    $GirlTalkTavernText = ''

    if $GirlTalkTavernTextGirl = '' or TavernRepairNeeded = 0 or TavernRepairOrdered = 1:
        killvar '$GirlTalkTavernTextGirl'
        exit
    end

    if $TavernRepairSource = 'rats':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Пока столяр Драупнир не заделает щели в кладовой, — Аманда поёживается, — я туда заходить боюсь. Сходи к мастеру, не тяни.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Повреждённые крысами перекрытия нужно чинить, — Мелисса. — Драупнир в Квартале ремесленников быстро всё исправит. Закажи ремонт.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Доски в кладовой прогрызены, — Сандра строго смотрит на тебя. — Сходи к Драупниру, пусть заменит настил крепким дубом.'
        end

    elseif $TavernRepairSource = 'brawl':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Столы после драки шатаются, — Аманда. — Гости жалуются. Стефан, позови столяра починить мебель.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Переломанная мебель в зале портит вид заведения, — Мелисса. — Драупнир рядом, заплати за починку.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Скамьи расколоты после буянов, — Сандра. — Иди к Драупниру в мастерскую, негоже гостям на кривых лавках сидеть.'
        end

    elseif $TavernRepairSource = 'broken':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Стеллажи в подвале на честном слове держатся, — Аманда. — Без столяра там всё рухнет. Позови Драупнира.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Полки под бочками прогнулись, — Мелисса. — Если рухнут остальные бочки, потеряем кучу денег. Нужен срочный ремонт.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Полки в погребе покосились, — Сандра. — Пока Драупнир новые опоры не поставит, за припасы я не спокойна. Сходи к нему.'
        end
    end

    if $GirlTalkTavernText <> '' and TavernRepairCarryDays >= 1:
        $GirlTalkTavernText = $GirlTalkTavernText + ' Дело тянется уже не первый день.'
    end

    killvar '$GirlTalkTavernTextGirl'
---
