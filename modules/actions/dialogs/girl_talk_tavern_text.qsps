! ================================================
! FILE: modules/actions/dialogs/girl_talk_tavern_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! Агентам: НЕ переписывать prose без явного «можно править тексты».
! Перед любой переделкой файла — спросить пользователя; сохранять формулировки.
! MODULE: actions/dialogs
! Тексты контекстного разговора о трактире
! ================================================

#GirlTalkTavernText
    $GirlTalkTavernTextId = LCASE($ARGS[0])
    $GirlTalkTavernText = ''

    if $GirlTalkTavernGirl = '':
        $GirlTalkTavernGirl = $TalkGirl
    end

    $GirlTalkTavernChoiceType = $LastHallChoiceType

    if $GirlTalkTavernChoiceType = '' and $GirlTalkTavernGirl <> '':
        $GirlTalkTavernChoiceType = $LastGirlChoiceType[$GirlTalkTavernGirl]
    end

    GirlTalkTavernReputation = tavern_reputation

    if GirlTalkTavernReputation <= 0:
        GirlTalkTavernReputation = TavernReputation
    end

    if $GirlTalkTavernTextId = 'intro':
        if $GirlTalkTavernGirl = 'amanda':
            $GirlTalkTavernText = '— Ну давай, про трактир? — Аманда кивает на зал. — Только без «я тут хозяин, вы девочки». Мы и так знаем, кто у клерка расписывается. Говори по делу. А то я начну ныть про клиентов, и мы тут до ночи.'
        elseif $GirlTalkTavernGirl = 'melissa':
            $GirlTalkTavernText = '— Выкладывай. Кто косячил, кто тянул, где дыра в учёте, — Мелисса смотрит как на допросе, но без злобы. — Я тебя предупреждала: налажаешь с залом — потеряешь не только деньги. Нас потеряешь.'
        elseif $GirlTalkTavernGirl = 'sandra':
            $GirlTalkTavernText = '— Короче давай. Кухня ждёт, — Сандра, но не уходит. — Я слушаю. Трактир нас кормит. Будет кормить хреново — жрать будем хреново. Все.'
        else:
            $GirlTalkTavernText = 'Вы говорите с ' + $RealName[$GirlTalkTavernGirl] + ' о трактире. Ничего лишнего — только дела, запасы и то, что завтра ударит по кассе.'
        end

    elseif $GirlTalkTavernTextId = 'context':
        gs 'GirlTalkTavernUseStaffRelief'

        if GirlTalkTavernUseStaffRelief = 1 and tavern_overload_penalty >= 10:
            gs 'GirlTalkTavernStaffReliefText'
        elseif productnum < 30 or winenum < 20 or beernum < 20:
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— Жратва кончается, — Аманда. — Если сегодня набьётся полный зал, будем извиняться, а не наливать.'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Склад пустой, — Мелисса. — Пустые кружки — пустой трёп. Иди закупайся.'
            elseif $GirlTalkTavernGirl = 'sandra':
                $GirlTalkTavernText = '— На кухне на донышке скребём, — Сандра. — Не пополнишь — завтра гости уйдут голодные и злые. Тебе оно надо?'
            else:
                $GirlTalkTavernText = 'Запасы на исходе. Разговор короткий — надо закупаться.'
            end
        elseif TavernScandal >= 45 or TavernLewdFame >= 35:
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— В городе треплются, — Аманда тихо. — Некоторые прутся не жрать, а поглазеть на нас. Меня от этого тошнит.'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Скандал зовёт зевак, а не кошельки, — Мелисса. — Нормальные потом не вернутся. Это не слава. Это позор.'
            elseif $GirlTalkTavernGirl = 'sandra':
                $GirlTalkTavernText = '— Грязный трёп про трактир — это грязный трёп про нас, — Сандра. — Имя отмыть тяжелее, чем пол после попойки.'
            else:
                $GirlTalkTavernText = 'Слухи о трактире зашли слишком далеко. Это чувствуется.'
            end
        elseif GirlTalkTavernReputation > 0 and GirlTalkTavernReputation < 30:
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— На нас косо смотрят, — Аманда. — Один кривой вечер — и уже шепчутся по углам.'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Нас зауважали меньше, — Мелисса. — Клиент сначала щупает взглядом, потом заказ делает. Так дела не делаются.'
            else:
                $GirlTalkTavernText = 'Репутация просела. Говорят, как не усугубить.'
            end
        elseif tavern_overload_penalty >= 20 or tavern_work_efficiency < 45:
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— Нас мало, их дохрена, — Аманда вздыхает. — Улыбка у меня слетает раньше, чем я до стола дохожу.'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Две работы на одну девку — это не экономия, — Мелисса. — Это косяки. А косяки бьют по кассе сразу.'
            elseif $GirlTalkTavernGirl = 'sandra':
                $GirlTalkTavernText = '— Я на кухне, девчонки в зале — так и надо, — Сандра. — Без лишних рук мы сдохнем. Стефан, поговори с клерком. Пусть наймёт ещё кого.'
            else:
                $GirlTalkTavernText = 'Трактир перегружен. Работы слишком много на текущие силы.'
            end
        elseif LastDayProfit < 0:
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— Вчера мы в минусе, — Аманда и не шутит. — Я не счетовод, но понимаю: будем так дальше — зал от нас попросит не улыбок.<br><br>— Я себя продавать не хочу. Но если крыша течёт — люди найдут, чем заплатить. Подумай, пока свой убыток считаешь.'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Мы в минусе, — Мелисса без крика. — Зал, кухня, закупки — где-то течёт. Чини. Не жди, пока мы начнём экономить на себе.<br><br>— Я могу дальше считать. А могу начать действовать. Выбирай, что тебе меньше понравится.'
            elseif $GirlTalkTavernGirl = 'sandra':
                $GirlTalkTavernText = '— Минус вчера — это не цифра, — Сандра. — Это суп завтра будет как вода. И злость сегодня.<br><br>— Закупайся, нанимай, чини крышу. Или скажи честно, что не тянешь. Я героев не люблю. Я люблю, когда мои дети сыты.'
            else:
                $GirlTalkTavernText = 'Вчера минус. Разговор короткий и тяжёлый — дальше все смотрят на вас, а не на кассу.'
            end
        elseif GirlTalkTavernReputation >= 60 and TavernScandal < 25:
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— Пока нас уважают, — Аманда. — Гости заходят спокойно. Не лапают глазами. Работать легче.'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Нас пока уважают, — Мелисса. — Вот и чини мелочи сейчас. Не расслабляй булки.'
            elseif $GirlTalkTavernGirl = 'sandra':
                $GirlTalkTavernText = '— Зал чистый, про нас не болтают, — Сандра. — В глаза смотреть не стыдно. Так и работайте.'
            else:
                $GirlTalkTavernText = 'Имя держится. Дела идут ровно.'
            end
        else:
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— Сегодня ничего страшного, — Аманда, но не расслабляется. — Всё равно я глаз с зала не спускала. Там вечно кто-то «случайно» задержится или «пошутит» слишком близко.<br><br>— Тихо — не значит можно спать. Значит, я ещё могу улыбаться и не блевануть.'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Вот это сработало. Вот это — нет, — Мелисса рубит. — Открытая дверь — это мало. Нужен результат, а не «мы старались».<br><br>— Я не против отдыха. Я против вранья себе. Зал любит тех, кто думает наперёд. А не тех, кто потом оправдывается.'
            elseif $GirlTalkTavernGirl = 'sandra':
                $GirlTalkTavernText = '— Девка прибирается, когда все дрыхнут, — Сандра. — Монеты уходят, зато пол не липнет. Девчонки в зале, я на кухне.<br><br>— Схема работает, пока ты помнишь: схема — это не мы. Нам тоже время нужно. Не только твоей кассе.'
            else:
                $GirlTalkTavernText = 'Коротко о делах трактира — без паники, но и без иллюзий, что «само наладится».'
            end
        end

    elseif $GirlTalkTavernTextId = 'port_ship_hook':
        gs 'GirlTalkTavernPortShipHookText'

    elseif $GirlTalkTavernTextId = 'hall_hook':
        if $LastHallChoiceEvent = 'noble_attack' and $GirlTalkTavernGirl = 'sandra':
            if $GirlTalkTavernChoiceType = 'sandra_shield':
                $GirlTalkTavernText = '— Не смотри на меня так, — Сандра тихо. — Я влезла не от слабости. В моём зале моего сына не режут. Но этот вечер... он много дерьма поднял.'
            elseif $GirlTalkTavernChoiceType = 'stand_firm':
                $GirlTalkTavernText = '— Ты не согнулся, — Сандра. — Гости запомнят. И эти хлыщи в бархате тоже. Трактир выдержит. А я — не знаю. Материнское сердце не железное.'
            elseif $GirlTalkTavernChoiceType = 'yield':
                $GirlTalkTavernText = '— Ты живой, — Сандра без упрёка, но больно ей. — Иногда это важнее, чем гонор. Только не привыкай глаза опускать. В нашем деле привыкнешь — и всё, ты уже на коленях.'
            else:
                $GirlTalkTavernText = '— Сегодня в зале чуть кровь не пролили, — Сандра. — Гости до сих пор шепчутся. Зал держи крепче, Стефан.'
            end
        elseif $GirlTalkTavernChoiceType = 'protect':
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— Про сегодня... — Аманда в зал смотрит. — Хорошо, что влез. А то решат, что тут можно к девкам лезть. И нам конец.'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Сегодня ты черту провёл, — Мелисса. — Гости должны знать своё место. Точка.'
            elseif $GirlTalkTavernGirl = 'sandra':
                $GirlTalkTavernText = '— То, что ты сегодня остановил, — Сандра, — вечер нам спасло. Так и держи.'
            else:
                $GirlTalkTavernText = 'Одобряет, что вмешался.'
            end
        elseif $GirlTalkTavernChoiceType = 'calm' or $GirlTalkTavernChoiceType = 'own_choice' or $GirlTalkTavernChoiceType = 'watch' or $GirlTalkTavernChoiceType = 'ignore':
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— Про сегодня... — Аманда плечами жмёт. — Ты не влез. Может, зал и не взорвался. Но я теперь знаю: если что — я сама. Одна.'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Ты сегодня промолчал, — Мелисса. — Иногда это выдержка. Иногда — ты просто струсил. Посмотрим, что гости запомнят.'
            else:
                $GirlTalkTavernText = 'Вы не вмешались. Заметили.'
            end
        elseif $GirlTalkTavernChoiceType = 'encourage' or $GirlTalkTavernChoiceType = 'client':
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— Если сегодня можно за деньги... — Аманда не договаривает. — То завтра придут уже не жрать. И нам будет тяжелее сказать «нет».'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Сегодня ты выбрал монеты, — Мелисса. — Монеты есть. А вот такие вечера гости помнят дольше, чем вкусную похлёбку.'
            elseif $GirlTalkTavernGirl = 'sandra':
                $GirlTalkTavernText = '— Деньги взяли, себя потеряли, — Сандра. — Это всегда дороже выходит, чем кажется.'
            else:
                $GirlTalkTavernText = 'Деньги взяли. Послевкусие тяжёлое.'
            end
        else:
            if $GirlTalkTavernGirl = 'amanda':
                $GirlTalkTavernText = '— Сегодня в зале было... всякое, — Аманда. — Я запомню. Ты скажи, на чьей ты стороне. А то я сама додумаю. И додумаю хреново.'
            elseif $GirlTalkTavernGirl = 'melissa':
                $GirlTalkTavernText = '— Я видела зал. И тебя видела, — Мелисса. — Не пойму пока, кто ты там был. Хозяин? Зритель? Барыга? Назовись сам. Мы любим, когда всё ясно.'
            elseif $GirlTalkTavernGirl = 'sandra':
                $GirlTalkTavernText = '— В зале было мерзко, — Сандра. — Трактир-то выдержит. Ты мне скажи, за что тебе стыдно, а за что нет. Я потом спрошу. Не у клерка — у сына.'
            else:
                $GirlTalkTavernText = 'Вспоминают сегодняшний случай в зале — и ждут, что хозяин сам назовёт вещи своими именами.'
            end
        end

    elseif $GirlTalkTavernTextId = 'day_event':
        gs 'GirlTalkTavernBuildDayEventText', $GirlTalkTavernGirl

    elseif $GirlTalkTavernTextId = 'repair_hook':
        gs 'GirlTalkTavernBuildRepairHookText', $GirlTalkTavernGirl
    end

    killvar '$GirlTalkTavernTextId'
    killvar '$GirlTalkTavernChoiceType'
    killvar 'GirlTalkTavernReputation'
    killvar 'GirlTalkTavernUseStaffRelief'
---

#GirlTalkTavernBuildDayEventText
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTavernTextGirl = $GirlKey
    $GirlTalkTavernText = ''

    if $GirlTalkTavernTextGirl = '' or TavernDayEventActive = 0 or $TavernDayEventId = '':
        killvar '$GirlTalkTavernTextGirl'
        exit
    end

    if $TavernDayEventId = 'caravan':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Этот караван меня доконал, — Аманда трёт запястье. — Носилась между кухней и залом, аж ноги свело. Зато гости обожрались.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Монеты хорошие, а работы втрое, — Мелисса. — Ещё один такой день — и начнём путать заказы.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Когда караван, кухня горит, — Сандра. — Гоняла девчонок, сама до муки к вечеру добралась. Сил нет.'
        end

    elseif $TavernDayEventId = 'rats':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Ты видел этих тварей? — Аманда морщится. — Сандра как заорала из кладовой, я чуть поднос не выронила. А потом лыбься гостям, ага.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Крысы в кладовой — это всё, прощай запасы, — Мелисса. — И вонь такая, что гости морщатся. Такого быть не должно.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Крысы муку пожрали, — Сандра, губы поджала. — Два раза считала убыток, всё равно бешусь. Кладовую так держать нельзя.'
        end

    elseif $TavernDayEventId = 'brawl':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— После той драки у меня руки до сих пор трясутся, — Аманда. — Столы летали, пиво рекой. А нам потом это дерьмо убирать и делать вид, что всё зашибись.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Драка — худшая реклама, — Мелисса. — Один вечер пьяных уродов — и о нас потом месяц треплются.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Когда в зале морды бьют, летит всё, — Сандра. — Посуда, стулья, мои нервы. Я не нанималась после чужой дури выгребать.'
        end

    elseif $TavernDayEventId = 'guard':
        if TavernDayEventGuardPassed = 1:
            if $GirlTalkTavernTextGirl = 'amanda':
                $GirlTalkTavernText = '— Стража ушла, — Аманда выдыхает. — Я всё утро тряслась из-за штрафа. Видать, чисто было.'
            elseif $GirlTalkTavernTextGirl = 'melissa':
                $GirlTalkTavernText = '— Стража без штрафа ушла, — Мелисса. — Редкость. Так и держи.'
            elseif $GirlTalkTavernTextGirl = 'sandra':
                $GirlTalkTavernText = '— Инспектор ушёл без бумажек — выдохнули, — Сандра. — Но расслабляться рано. В следующий раз придут злее.'
            end
        else:
            if $GirlTalkTavernTextGirl = 'amanda':
                $GirlTalkTavernText = '— Стража нас сегодня дрючила, — Аманда шепчет. — Я стояла как на углях, а они каждую крошку в углу разглядывали.'
            elseif $GirlTalkTavernTextGirl = 'melissa':
                $GirlTalkTavernText = '— Штраф, — Мелисса холодно. — Мы выглядим хуже, чем думаем. Запомни.'
            elseif $GirlTalkTavernTextGirl = 'sandra':
                $GirlTalkTavernText = '— Инспектор штраф выписал, — Сандра. — Чистота — не для красоты. Нас предупредили, Стефан.'
            end
        end

    elseif $TavernDayEventId = 'harvest':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Урожайный день вымотал, — Аманда поправляет косу, но улыбается. — Зал гремел, уши заложило. Устала — но нормально устала.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Урожай, — Мелисса. — Народу дохрена, монеты хорошие. В следующий раз будь готов. Не ной потом.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Праздник в городе — кухня в огне, — Сандра, голос мягче. — Но хоть видно, что о нас помнят. Нормальный день.'
        end

    elseif $TavernDayEventId = 'minstrels':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Музыканты зал разогрели, — Аманда. — Легче, когда гости ржут. Только я из-за песен пару раз заказ перепутала.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Музыканты — нормальный ход для кассы, — Мелисса. — С песней пьют больше. Зови. Только не даром.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Музыка — не моё, — Сандра. — Но сегодня гости тише. Пусть играют. Только чтоб кухне не мешали.'
        end

    elseif $TavernDayEventId = 'storm':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Из-за дождя в зале пусто, — Аманда. — Монет мало. Зато между заказами передохнула. Редкость.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Ливень — народ дома сидит, — Мелисса. — Выручка слабая. Зато учёт делаю, а не ношусь с подносом.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Когда льёт, у печи задерживаются, — Сандра. — Кухня медленнее. Зато никто не орёт и не толкается. Плюс есть.'
        end

    elseif $TavernDayEventId = 'pilgrims':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— В углу паломники сидели, — Аманда. — Смотрели, будто мы в ад идём. Мне пиво наливать стыдно было.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Паломники — мало платят, зато глазами едят, — Мелисса. — Не разорят. Но дальше по дороге про нас расскажут.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Паломники тихие, — Сандра. — Но пялятся. Нашим пьяницам неловко. Мне от этого легче.'
        end

    elseif $TavernDayEventId = 'broken':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Ночью бочка лопнула, — Аманда устало. — Утром в подвале лужа, пивом воняет. Полдня вытирали. Гости косились.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Бочка в подвале — чистый минус, — Мелисса. — Пиво, время, уборка. Ещё один такой сюрприз — и неделя в жопе.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Лопнула бочка — моя головная боль, — Сандра сердито. — Пиво на полу, полки шатаются. Кто-то крепления проверить должен был. Не я одна.'
        end

    elseif $TavernDayEventId = 'thief':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Ночью кладовую обнесли, — Аманда тихо. — Муку и вино. Теперь дверь дважды проверяю. Ненавижу, когда в наш дом лезут.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Кража — дыра в учёте, — Мелисса. — Кто взял — не видно. Чего нет — видно. Замок на кладовую давно пора.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Вор ночью залез, — Сандра. — С утра всё пересчитала и чуть на первого гостя не орала. Бесит, когда труд уходит в чужие лапы.'
        end
    end

    if $GirlTalkTavernText = '':
        gs 'TavernDayEventHallTextId'
        gs 'TavernDayEventText', $TavernDayEventHallTextId
        $GirlTalkTavernText = '— Сегодня вымотало, — ' + $RealName[$GirlTalkTavernTextGirl] + '. — ' + $TavernDayEventText
        killvar '$TavernDayEventHallTextId'
        killvar '$TavernDayEventText'
    end

    killvar '$GirlTalkTavernTextGirl'
---

#GirlTalkTavernBuildRepairHookText
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTavernTextGirl = $GirlKey
    $GirlTalkTavernText = ''

    if $GirlTalkTavernTextGirl = '' or TavernRepairNeeded = 0 or TavernRepairOrdered = 1:
        killvar '$GirlTalkTavernTextGirl'
        exit
    end

    if $TavernRepairSource = 'rats':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Пока Драупнир кладовую не подлатает, — Аманда, — в углы заглядывать боюсь. Сходи к столяру. Пока не стало хуже.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Каждый день без ремонта — минус к имени, — Мелисса. — Драупнир в ремесленном возьмётся. Тянуть нельзя.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Кладовую так и не починили, — Сандра строго. — Полки шатаются, вонь. Иди к Драупниру, пока гости сами не зашептались.'
        end

    elseif $TavernRepairSource = 'brawl':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Зал после драки — ну ты видел, — Аманда. — Стойка скрипит. Стефан, плати столяру.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Потрёпанный зал — плохая визитка, — Мелисса. — Драупнир рядом. Плати сейчас.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— После драки столяра не звали, — Сандра. — Стулья кривые. Иди к Драупниру.'
        end

    elseif $TavernRepairSource = 'broken':
        if $GirlTalkTavernTextGirl = 'amanda':
            $GirlTalkTavernText = '— Подвал всё ещё пивом воняет, — Аманда. — В зале улыбаюсь. А сама знаю: без Драупнира там жопа.'
        elseif $GirlTalkTavernTextGirl = 'melissa':
            $GirlTalkTavernText = '— Подвал сам не починится, — Мелисса. — Каждый день ждёшь — дороже выходит.'
        elseif $GirlTalkTavernTextGirl = 'sandra':
            $GirlTalkTavernText = '— Полки в подвале шатаются, — Сандра. — Пока Драупнира не позовём — за запасы я спокойна не буду. Сходи.'
        end
    end

    if $GirlTalkTavernText <> '' and TavernRepairCarryDays >= 1:
        $GirlTalkTavernText = $GirlTalkTavernText + ' Тянется уже не первый день.'
    end

    killvar '$GirlTalkTavernTextGirl'
---
