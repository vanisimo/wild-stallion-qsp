! ================================================
! FILE: modules/actions/dialogs/girl_talk_lizette_text.qsps
! MODULE: actions/dialogs
! [AI-WORKED] Текст переработан / дополнен ассистентом 03.11.2026
! Тексты меню разговоров Лизетты
! Канон характера: 18 лет, бойкая, красивая мулатка из порта,
! неграмотная, простодушная, озорная, любит наряды, блестяшки и ласку.
! Лор-пулы: GirlTalkLizetteLoreSlot (счётчик в Run)
! ================================================

#GirlTalkLizetteText
    $GirlTalkLizetteTopic = LCASE($ARGS[0])
    $GirlTalkLizettePart = LCASE($ARGS[1])
    $GirlTalkLizetteText = ''

    ! ----------------------------------------------------
    ! 0. ДИНАМИЧЕСКИЙ БЛОК ВЕХ (MILESTONE)
    ! ----------------------------------------------------
    if $GirlTalkLizettePart = 'milestone':
        if LastSexDay['lizette'] > 0 and (day - LastSexDay['lizette'] <= 1) and (SexGirlCameInScene >= 6 or SexGirlExhausted = 1 or SexMarathonGossipPending['lizette'] = 1):
            *pl 'Лизетта весело хихикает, прикрывает рот ладошкой и бросает на тебя озорной, блестящий взгляд из-под тёмных кудрей:'
            *pl ' '
            *pl '— Ой, Стефан... Стоит тут, глазом не моргнёт! А у меня до сих пор коленки дрожат, как ту ночь на причале вспомню. Волны плещут, а ты как ухватил меня за бёдра — так у меня весь дух и вышибло! Настоящий дикий жеребец, мамка не соврала. Ох и горячий ты парень!'
            *pl ' '
        elseif HadSex['lizette'] > 0 and (day - LastSexDay['lizette'] >= 4):
            *pl 'Лизетта забавно надувает пухлые губки, упирает руки в крутые бока и делает вид, будто сердится:'
            *pl ' '
            *pl '— Ну вот, совсем про меня забыл! В своём трактире кружки моешь да с городскими девками любезничаешь, а я тут на ветру стою, одна-одинёшенька! Смотри у меня, Стефан: в порт такие бравые моряки приплывают, ленты дарят, подмигивают... Ещё пару дней нос воротить будешь — уведут твою смуглянку!'
            *pl ' '
        end

    ! ----------------------------------------------------
    ! 1. ТЕМА: ПОРТ И СТОЛИЧНЫЕ КОРАБЛИ
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_port':
        if $GirlTalkLizettePart = 'intro':
            *pl 'Морской ветер треплет смоляные кудри Лизетты. Она весело щурится на скрипучие мачты столичного корабля, поправляет яркую тесьму на корсаже и поворачивается к тебе с широкой улыбкой:'
            *pl ' '
            *pl '— Про корабли спросить хочешь? Ой, я про наш причал с утра до ночи трещать могу! Спрашивай, Стефан, всё как на духу выложу!'
            *pl ' '
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                if PortCapitalShipAvailable = 1 or PortMeetWitnessed = 1:
                    $GirlTalkLizetteText = '— Как трёхмачтовик из столицы швартуется — так тут сразу ярмарка начинается! — тараторит Лизетта, размахивая руками. — Матросы с мешками сыплются, кричат, ругаются, тюки с грохотом на доски валят... А уж сколько они всяких блестяшек везут! Весь город сбегается поглазеть, даже старые деды забывают, что ноги болят!'
                else:
                    $GirlTalkLizetteText = '— Столичные матросы такие забавные! — смеётся Лизетта. — Идут по пирсу враскорячку, шляпы набекрень, в ушах серьги серебряные. Увидят девчонку — сразу свистят, зубы скалят и яблоки заморские из карманов суют. Я им ручкой помашу, улыбнусь — они и растаяли!'
                end
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— С последнего корабля такие ленты выгрузили — синие, алые, гладкие-гладкие! — восторженно шепчет она, округлив глаза. — К нам в лавки такие не возят, всё в столицу уходит. Я одну ленточку себе выпросила, в кудри вплела — красиво же, скажи?'
            elseif GirlTalkLizetteLoreSlot = 2:
                $GirlTalkLizetteText = '— Городские бабы у колодца вечно на меня косятся и губы поджимают, — фыркает Лизетта и беспечно отмахивается. — Мол, вертихвостка портовая, у трапа крутится! Да пускай шипят от зависти! Сами в серых дерюгах ходят и дальше огорода ничего не видели, а у нас в порту шумно, весело и монеты рекой текут!'
            else:
                $GirlTalkLizetteText = '— На дальнем пирсе купцы пряностями торгуют, — шмыгает носом Лизетта. — Пройдёшь мимо — сразу в носу щиплет, чихаешь на весь причал! Зато пахнет праздником. Матросы там за одну ласковую улыбку готовы горсть медяков отсыпать, лишь бы с ними рядышком постояла.'
            end
        end

    ! ----------------------------------------------------
    ! 2. ТЕМА: О СЕБЕ И СВОЕЙ ЖИЗНИ
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_bio':
        if $GirlTalkLizettePart = 'intro':
            *pl 'Лизетта легко прислоняется бедром к просмолённой тумбе, поправляет короткий подол и смотрит на тебя с лукавым, девичьим любопытством:'
            *pl ' '
            *pl '— Про меня послушать хочешь? — она звонко смеётся. — Да чего во мне слушать-то? Я простая, хитрить не умею! Ну да ладно, спрашивай!'
            *pl ' '
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— Мне восемнадцать стукнуло, — охотно рассказывает Лизетта. — В грамоте я ни бельмеса не смыслю, буквы для меня — как жуки на песке. Зато в порту каждую доску знаю! Мамка говорит: была б мордашка смазливая да руки не из попы, а книжки пускай городские умники читают, от них только голова пухнет!'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— На днях один молодой юнга за мной с живой рыбиной бегал! — заливается хохотом Лизетта. — Кричит: «Красавица, дай поцелую, я тебе треску отдам!» А я его мокрой тряпкой по уху огрела! Смеху было на весь причал, грузчики чуть с мостков в воду не повалились!'
            else:
                $GirlTalkLizetteText = '— Я злиться долго вообще не умею, — улыбается девушка во весь рот. — Если кто обидит — язык покажу и убегу! Люблю, когда солнышко греет, чайки кричат и музыка на площади играет. А сидеть в углу и вздыхать — тоска смертная, я от этого сразу засыпаю!'
            end
        end

    ! ----------------------------------------------------
    ! 3. ТЕМА: ПОДАРКИ И ДИКОВИНКИ
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_gifts':
        if $GirlTalkLizettePart = 'intro':
            *pl 'При слове «подарки» глаза Лизетты загораются ярким восторгом. Она подпрыгивает на месте и хватает тебя за рукав:'
            *pl ' '
            *pl '— Подарки?! Ой, я подарочки больше всего на свете люблю! Рассказать, от чего у меня сердце замирает? Слушай скорее!'
            *pl ' '
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— Бусики стеклянные, разноцветные, или браслетик медный с бубенчиками — вот это красота! — с придыханием шепчет она. — Наденешь на руку — звенит, на солнце переливается... Идёшь по причалу, и сразу видно: не замарашка какая-нибудь, а нарядная девчонка!'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Зеркальце маленькое в кармашке — самая нужная вещь! — хвастается Лизетта. — Достанешь, губки надуешь, кудряшку поправишь... Красивая! А парни смотрят и слюни пускают. У меня одно треснуло, жалко до слёз было!'
            else:
                $GirlTalkLizetteText = '— А сладости столичные пробовал? Петушки на палочке, орехи в сахаре! — облизывается она. — Матросы иногда угощают. Сладкие такие, во рту тают... Я за сладкий леденец могу хоть весь день ласковой быть!'
            end
        end

    ! ----------------------------------------------------
    ! 4. ТЕМА: АМАНДА И СЕСТРИНСКАЯ ДРУЖБА
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_amanda':
        if $GirlTalkLizettePart = 'intro':
            *pl 'Лизетта мгновенно оживляется, делает шаг ближе и заговорщически понижает голос:'
            *pl ' '
            *pl '— Про Амандочку? Ой, она такая милая! Спрашивай, Стефан, я тебе про неё всё расскажу!'
            *pl ' '
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                if AmandaMetLizette = 1 and AmandaLizaInfluence >= 5:
                    $GirlTalkLizetteText = '— Аманда твоя сначала всего боялась, краснела как маков цвет! — смеётся Лизетта. — А сейчас гляди-ка: головку держит ровно, бёдрами покачивает, парням улыбается! Я её учу: не бойся мужиков, они от красивых девчонок сами робеют! Главное — улыбаться и не киснуть у стойки!'
                elseif AmandaMetLizette = 1:
                    $GirlTalkLizetteText = '— Мы с ней у корабля ленты вместе перебирали! — сияет Лизетта. — Она так радовалась, глазищи круглые, трогает шёлк и пищит от восторга! Ей ведь в вашем трактире скучно день-деньской кружки мыть. Ей подружка нужна, чтоб секретами делиться!'
                else:
                    $GirlTalkLizetteText = '— Сестрёнка у тебя славная, ладная такая! — говорит Лизетта. — Только пугливая больно, всё на мать оглядывается. Ей бы ленту яркую в косу да на танцы выбежать, чтоб все парни рты разинули!'
                end
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Аманда так смешно уши зажимает, когда я ей про матросские поцелуи рассказываю! — хихикает мулатка. — Сначала ойкает: «Ой, стыдно-то как!», а сама слушает, аж рот открыла! Любопытно же девчонке, как оно бывает на самом деле!'
            else:
                $GirlTalkLizetteText = '— Ты её, Стефан, не ругай за пустяки, — просит Лизетта, трогая тебя за локоть. — Лучше гостинец принеси — ленточку аленькую или гребешок. Девчонки от подарков добрыми становятся, сама знаю!'
            end
        end

    ! ----------------------------------------------------
    ! 5. ТЕМА: ДЕВИЧЬИ СЕКРЕТЫ И ЛАСКИ
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_intim':
        if $GirlTalkLizettePart = 'intro':
            *pl 'Лизетта ничуть не смущается, подходит вплотную и лукаво толкает тебя плечиком:'
            *pl ' '
            *pl '— Про ласки послушать захотел? — её глаза блестят озорным огоньком. — Ой, ну ты даёшь, Стефан! Чего тут скрывать, дело молодое. Спрашивай, расскажу, чему меня мамка учила!'
            *pl ' '
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— Мамка всегда твердит: первое дело — водичка с мылом да порошок «Таро»! — прямо говорит Лизетта. — Если тело чистенькое, гладкое и травкой пахнет — так и целоваться сладко, и ласкать в радость! А от грязнуль любого стошнит, пусть хоть золотом осыплют!'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Поцелуи — это самое вкусное! — мечтательно щурится она. — Когда парень не сразу под юбку руки сует, а сначала за щёчку нежно погладит, в шейку поцелует, в губки сладко... Ой, у меня от этого сразу в животе бабочки летают и коленки сами подгибаются!'
            elseif GirlTalkLizetteLoreSlot = 2:
                $GirlTalkLizetteText = '— Парни молодые вечно торопятся, будто на пожар опаздывают! — смеётся Лизетта. — А я им говорю: «Куда летишь, оглашенный?» Надо сначала ручками погладить, пошептать на ушко, чтоб девчонка разомлела. Когда ей самой сладко — она всё для тебя сделает!'
            elseif GirlTalkLizetteLoreSlot = 3:
                $GirlTalkLizetteText = '— Мужики только с виду такие грозные да напыщенные, — подмигивает девушка. — А погладишь его ласково, прижмёшься грудкой, скажешь, какой он сильный — и всё, растаял как масло на сковородке! Сразу ласковый становится, послушный.'
            elseif GirlTalkLizetteLoreSlot = 4:
                $GirlTalkLizetteText = '— Чего стыдиться-то, коли обоим сладко? — удивляется Лизетта. — Ильматер ведь не зря людям тело дал, чтоб радоваться да ласкаться! Городские святоши пусть в кулак плачут, а мы молодые — нам жить и веселиться надо!'
            else:
                $GirlTalkLizetteText = '— Мне нравится, когда парень крепкий и обнимает уверенно, — шепчет она, поводя смуглым плечиком. — Чтоб прижал крепко-крепко и брал жадно, не мямлил! От таких объятий голова кругом идёт!'
            end
        end

    ! ----------------------------------------------------
    ! 6. ТЕМА: МАТЬ ЖОРЖЕТТА
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_mother':
        if $GirlTalkLizettePart = 'intro':
            *pl 'Лицо Лизетты теплеет, в глазах вспыхивает искренняя дочерняя гордость:'
            *pl ' '
            *pl '— Про мамку спросить хочешь? — она улыбается. — Мамка у меня мировая! Спрашивай, Стефан, я про неё всегда рада сказать!'
            *pl ' '
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— Жоржетта меня никогда веником не гоняла и за косы не таскала! — гордо говорит Лизетта. — Другие матери девок из дома не пускают, а моя учит: смотри на людей в оба глаза, не будь дурёхой и не верь на слово! Она у меня самая добрая!'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Мама всех в порту насквозь видит! — усмехается дочка. — Говорит: «Лизка, улыбайся ласково, но цену себе знай, за просто так никому спуску не давай!» Я вся в неё пошла, только мамка опытнее.'
            else:
                $GirlTalkLizetteText = '— Нас у мамы четверо, и она всех кормит, одевает, никого голодным не оставит! — серьёзно произносит Лизетта. — Пускай городские сплетницы язык чешут — они нам куска хлеба не дали! А я за мамку горой встану, кто её обидит — глаза расцарапаю!'
            end
        end
    end

    killvar '$GirlTalkLizetteTopic'
    killvar '$GirlTalkLizettePart'
---

#GirlTalkLizetteLimitReachedText
    *pl 'Лизетта весело смеётся, машет ладошкой и делает шаг назад:'
    *pl '— Ой, Стефан, всё, язык уже заплетается! Хватит болтать, а то у меня дел невпроворот — побегу к сходням, пока столичные товары не расхватали. Потом договорим!'
---

#GirlTalkLizetteMemoryLimitText
    *pl 'Лизетта смотрит на тебя необычно долго, её звонкий смех затихает. Она подходит вплотную и тихонько касается пальчиками твоей ладони:'
    *pl '— Знаешь, Стефан... Все вокруг видят во мне только девчонку с причала. Посмеяться, за косичку дёрнуть, монетку сунуть... А ты со мной по-хорошему говоришь. Не обижаешь, слушаешь мои глупости.'
    *pl 'Она шмыгает носом и открыто улыбается тебе:'
    *pl '— Мне с тобой так тепло и спокойно. Я тебе верю, Стефан. Правда-правда верю.'
---

#GirlTalkLizetteMemoryPortSexText
    *pl 'Лизетта закусывает губку и вспыхивает ярким румянцем, вспоминая ночной причал:'
    *pl '— Ой, как вспомню ту ночь у бочек... — шепчет она с озорным восторгом. — Доски скрипят, волны шумят, а ты меня так крепко прижал, что я дышать боялась! Думала, трактирщики только кружки носить умеют, а ты прямо буря! Обязательно ещё пойдём... только чтоб стемнело!'
---

#GirlTalkLizetteMemoryChurchSpyText
    *pl 'Лизетта тихонько прыскает в кулак и оглядывается по сторонам:'
    *pl '— Ты ведь подглядывал в соборе через окошко, да? — она насмешливо щурится. — Видел нашего святого отца Герхарда? На проповеди такой важный, круг чертит, а сам передо мной как мальчишка трясся! Мамке только не говори, а то заругает, что я без спросу к нему бегала!'
---

#GirlTalkLizetteMemoryAmandaText
    *pl 'Лизетта улыбается, вспоминая подругу:'
    *pl '— Спасибо, что не запираешь Аманду дома, Стефан! Мы с ней так славно посекретничали. Она у тебя такое солнышко, чистая, добрая... Я её дурному не учу, честное слово! Просто показываю, как ленты красиво повязывать да чтоб парни не обижали.'
---

#GirlTalkLizetteLegareClueText
    *pl 'Лизетта замечает твою озабоченность, подходит ближе и заглядывает в лицо с тёплой, простодушной улыбкой:'
    *pl '— Ты чего такой хмурый, Стефан? Случилось чего?'
    *pl ' '
    *pl '— Альбер Легаре перекрыл поставки вина в мой трактир, — коротко отвечаешь ты. — Пытается прижать нас к ногтю.'
    *pl ' '
    *pl 'Лизетта взмахивает руками и тихо присвистывает:'
    *pl '— Альбер? Мессир Легаре? Он ведь и ко мне захаживает... ну, сюда, в порт. Молоденьких любит, монеты у него звонкие, золотом от него так и веет. Он мне, признаться, тоже нравится — видный такой, важный... Но ты мне всё равно больше нравишься, Стефан! Куда больше.'
    *pl 'Она сердито хмурит тонкие бровки и поджимает губы:'
    *pl '— Да и к Аманде он свои лапы тянет, глазами так и щупает на площади! Ишь чего удумал — нечего моих подружек портить!'
    *pl ' '

    if HadSex['lizette'] > 0 or LizetteSexUnlocked = 1:
        *pl 'Лизетта оглядывается на пирс и понижает голос:'
        *pl '— У нас на причале клиенты вечно языком чешут, когда выпьют да разомлеют. Вчера один столичный приказчик как раз у меня в постели трепался.'
    else:
        *pl 'Лизетта оглядывается на пирс и понижает голос:'
        *pl '— Я у мамки в комнатах слышала, когда клиенты к ней захаживали и вино глушили. Сидели приказчики со столичного корабля, языками чесали.'
    end

    *pl 'Болтали они про ночные погрузки вина. Будто Легаре тайком на столичный корабль бочки грузит, а городскому судье и страже акциз не платит — всё мимо казны пускает.'
    *pl 'Она лезет за корсаж и достаёт помятый, сложенный вчетверо пергамент со следами воска и портовых печатей:'
    *pl '— И вот бумажку один из них уронил на пол. Пьяный был в стельку, даже не заметил. Я её подобрала и спрятала.'
    *pl ' '
    *pl 'Лизетта протягивает пергамент тебе, виновато и открыто улыбаясь:'
    *pl '— Я ведь в грамоте ни бельмеса не смыслю. Для меня эти чёрные закорючки — как жуки на песке толкутся, читать совсем не умею. А тебе может понадобиться! Вдруг пригодится?'
    *pl ' '
    *pl 'Ты берёшь лист. Беглый взгляд выхватывает столбцы цифр, номера партий и отметки столичных складов. Без точного расчёта не разобраться, но Мелисса наверняка щёлкнет эту загадку за пару минут.'
    *pl '— Спасибо, Лизетта. Ты даже не представляешь, как выручила.'
    *pl 'Она сияет от похвалы и весело подмигивает тебе.'
