#GirlTalkLizetteText
    $GirlTalkLizetteTopic = LCASE($ARGS[0])
    $GirlTalkLizettePart = LCASE($ARGS[1])
    $GirlTalkLizetteText = ''

    ! ----------------------------------------------------
    ! 0. ДИНАМИЧЕСКИЙ БЛОК ВЕХ (MILESTONE)
    ! ----------------------------------------------------
    if $GirlTalkLizettePart = 'milestone':
        if LastSexDay['lizette'] > 0 and (day - LastSexDay['lizette'] <= 1) and (SexGirlCameInScene >= 6 or SexGirlExhausted = 1 or SexMarathonGossipPending['lizette'] = 1):
            $GirlTalkLizetteText = 'Лизетта вдруг лукаво щурится, облизывает пухлую нижнюю губу и тихо смеётся, бросая на тебя шальной взгляд из-под светлых ресниц:<br><br>— Ты только погляди на него... Стоит, как ни в чём не бывало! А я до сих пор вздрагиваю, как вспомню ту ночь у причала под плеск волн. Ты меня так жадно и ненасытно брал, Стефан, что у меня до рассвета всё внутри пламенем горело. Настоящий дикий жеребец... Мне такие мужчины по душе.'
        elseif HadSex['lizette'] > 0 and (day - LastSexDay['lizette'] >= 4):
            $GirlTalkLizetteText = 'Лизетта шутливо надувает губки, скрещивая руки под грудью и окидывая тебя притворным укором:<br><br>— А я уж думала, хозяин трактира совсем забыл дорогу к причалу! В зале небось закрутился или с кухарками любезничаешь, пока твоя портовая подружка одна морской бриз слушает? Смотри у меня, Стефан, девицы в порту долго не скучают — заглядывай почаще, если не хочешь, чтоб меня столичные матросы закружили.'
        end

    ! ----------------------------------------------------
    ! 1. ТЕМА: ПОРТ И СТОЛИЧНЫЕ КОРАБЛИ
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_port':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = 'Ветер с моря треплет светлые локоны Лизетты, пахнет смолой, солью и сырыми дубовыми досками причала. Лизетта с улыбкой щурится на высокие мачты столичных шхун, поворачивается к тебе и задорно вскидывает подбородок:<br><br>— Порт, столица, заморские диковинки? Обожаю об этом болтать! Спрашивай, Стефан, я тебе всё без утайки выложу.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                if PortCapitalShipAvailable = 1 or PortMeetWitnessed = 1:
                    $GirlTalkLizetteText = '— Большой корабль приносит не только бочки и тюки, — улыбается Лизетта, оглядывая суету матросов. — Он приносит столичные сплетни, редкие подарки и людей, которые слишком быстро забывают, что на нашем фронтире всё решают не напыщенные дворяне, а то, кто с кем дружит и кто кому улыбнулся.'
                else:
                    $GirlTalkLizetteText = 'Лизетта увлечённо рассказывает о столичных фасонах, шёлковых корсетах и о том, как в огромном портовом городе лукавая женская улыбка часто стоит куда дороже, чем бочонок доброго вина в твоём погребе.'
                end
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— С последнего столичного борта привезли такие атласные ленты, каких в наших лавках отродясь не видывали, — Лизетта доверительно понижает голос, будто посвящает тебя в тайну клада. — Я уже точно знаю, кому из городских девчонок они вскружат голову сильнее всего!'
            elseif GirlTalkLizetteLoreSlot = 2:
                $GirlTalkLizetteText = '— Тут в городке кумушки так и норовят зашипеть, стоит мне перемолвиться словом с матросами у сходней, — смеётся Лизетта, беспечно отмахиваясь. — Я уже привыкла. В столице всё то же самое, только народу больше, шумнее и у причала грязи по колено.'
            else:
                $GirlTalkLizetteText = 'Лизетта с живым любопытством расспрашивает тебя о столице, а затем весело описывает рынок у дальнего пирса: пеструю толпу, запах заморских пряностей и бравых моряков, которые готовы раскошелиться за один ласковый взгляд куда щедрее, чем трактирные завсегдатаи за пинту эля.'
            end
        end

    ! ----------------------------------------------------
    ! 2. ТЕМА: О СЕБЕ И СВОЕЙ ЖИЗНИ
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_bio':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = 'Лизетта легко прислоняется бедром к швартовой тумбе, поправляет вырез платьица и с лукавой усмешкой смотрит тебе прямо в глаза:<br><br>— Обо мне послушать захотел? — её губы трогает озорная улыбка. — Ну что ж, мне скрывать нечего. Спрашивай, хозяин, послушаю, что тебе интересно.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— Мне восемнадцать, порт — мой родной дом, а каждый столичный корабль — настоящий праздник, — негромко говорит она. — Мать тянет семью по ночам, а я смотрю на мир шире, чем сквозь мутные трактирные окна. Никому в рот не заглядываю и цену себе знаю.'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— На днях один молодой матрос пытался выменять живую рыбину на шёлковую ленту для шляпы, — Лизетта заливается звонким смехом. — В столице его бы на смех подняли! А у нас забавно и честно. Все вокруг делают вид, что ничего не замечают, а сами украдкой косятся.'
            else:
                $GirlTalkLizetteText = '— Я не святая праведница, но и не злая уличная девка, — пожимает плечами Лизетта. — Просто отлично знаю, как этот тихий городок любит краснеть и осуждать чужие спины. А я люблю смотреть, кто из этих святош опустит глаза первым.'
            end
        end

    ! ----------------------------------------------------
    ! 3. ТЕМА: ПОДАРКИ И ДИКОВИНКИ
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_gifts':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = 'При слове «подарки» глаза Лизетты мгновенно вспыхивают живым блеском. Она подаётся ближе, обдавая тебя тонким ароматом притираний и морской свежести:<br><br>— Подарки? О, в этом я толк знаю лучше любого торговца! С кораблей везут столько чудес. Спрашивай, подскажу, чем девичье сердце растопить!'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— Тонкий южный браслет, блестящая лента или нитка стеклянных бусин — для тебя это пара монет, а для девочки из трактирного зала это целый кусочек столичной роскоши, — подмигивает Лизетта. — Умелый подарок открывает женские двери быстрее, чем любые споры.'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Зеркальце в резной медной оправе — моя вечная слабость, — доверительно признаётся она. — Долго в него любуешься и вдруг замечаешь, что мужчины вокруг смотрят туда же! А шёлковый веер для пятничных танцев — ещё лучше: и красиво, и повод подойти вплотную.'
            else:
                $GirlTalkLizetteText = '— Специи и сушёные травы — это скука для стряпух, — усмехается Лизетта. — А вот когда в руках сверкает столичная вещица — у любой девчонки дух захватывает. Я дружбой не торгую, Стефан. Но на нашем фронтире блеск и красота ценятся на вес золота.'
            end
        end

    ! ----------------------------------------------------
    ! 4. ТЕМА: АМАНДА И СЕСТРИНСКАЯ ДРУЖБА
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_amanda':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = 'Лизетта мгновенно становится серьёзнее, делает полшага вперёд и понижает голос до заговорщического шёпота:<br><br>— Об Аманде? — она внимательно заглядывает тебе в лицо. — Спрашивай, Стефан. Только без крика и ревности. Мы ведь добра ей хотим.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                if AmandaMetLizette = 1 and AmandaLizaInfluence >= 5:
                    $GirlTalkLizetteText = '— Твоя сестра слушает мои рассказы куда жаднее, чем готова признаться вслух, — негромко произносит Лизетта. — Подарки — это только повод. Ей душно в четырёх стенах трактира, ей нужен большой мир! Ты не бойся: я зла твоей семье не желаю и врагами нам быть ни к чему.'
                elseif AmandaMetLizette = 1:
                    $GirlTalkLizetteText = '— Я привезла для неё кое-какую столичную вещицу с борта, — признаётся Лизетта. — Не ради злого умысла. Просто в глазах у Аманды столько вопросов о жизни, на которые этот сонный городок отвечает лишь тяжёлой работой да окриками.'
                else:
                    $GirlTalkLizetteText = 'Лизетта рассуждает о том, как легко заинтересовать яркими вещами и вольными речами девушку, которая изо дня в день видит лишь мытьё кружек да хмельные рожи в зале. Она явно знает, как подобрать ключик к женскому сердцу.'
                end
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Аманда так забавно краснеет, когда я рассказываю про столичные балы и кавалеров, — усмехается Лизетта. — Не от глупости вовсе. Ей просто стыдно признаться самой себе, что она хочет яркой жизни. Я её не порчу, Стефан. Я просто показываю, что за забором городка тоже есть жизнь.'
            else:
                $GirlTalkLizetteText = '— Если принесёшь ей столичный гостинец — спасибо она скажет тебе, а глазки будут гореть от восторга, — прямо говорит Лизетта. — Я не краду сестёр из семьи. Мне просто нужна смелая подруга, которой надоело считать дни до старости у кухонной плиты.'
            end
        end

    ! ----------------------------------------------------
    ! 5. ТЕМА: ИНТИМНЫЕ СЕКРЕТЫ И НАСТАВЛЕНИЯ
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_intim':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = 'Лизетта улыбается без тени ханжества, подходит вплотную и лукаво касается пальцем твоей груди:<br><br>— Хочешь узнать, о чём женщины шепчутся, когда мужчины отворачиваются? — её смешок звучит жарко и дразняще. — Спрашивай, Стефан. Я не из робкого десятка и краснеть за правду не стану.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— В столице умные женщины первым делом учат чистоте, — прямо говорит Лизетта. — Тело, руки, кожа... Чистота — основа любого истинного наслаждения. Если мужчина чист и опрятен, девичья робость улетучивается вдвое быстрее, и ласки приносят чистую радость обоим.'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Поцелуи и ласки лица — великое искусство, — продолжает Лизетта с со знанием дела. — Сначала нежные прикосновения губ, дыхание на коже... Когда женщина чувствует себя желанной и красивой, она сама тянется навстречу и забывает о притворной строгости.'
            elseif GirlTalkLizetteLoreSlot = 2:
                $GirlTalkLizetteText = '— Мужское тело требует чутких и смелых рук, — понижает голос Лизетта, озорно сверкая глазами. — Нежные ласки пальцами, тепло губ, умение дразнить и не спешить. Аманда пока заливается краской, когда я об этом рассказываю, но слушает затаив дыхание!'
            elseif GirlTalkLizetteLoreSlot = 3:
                $GirlTalkLizetteText = '— В постели нет места грубости и спешке, — оценивающе смотрит на тебя Лизетта. — Любые смелые ласки требуют доверия, ласкового шёпота и времени. Сначала девчонка скажет «нет», потом затихнет, а потом сама попросит не останавливаться. Главное — уметь ждать и слушать её дыхание.'
            elseif GirlTalkLizetteLoreSlot = 4:
                $GirlTalkLizetteText = '— Когда страсть разгорается по-настоящему, — шепчет Лизетта, прикусывая губку, — границы между стыдом и восторгом стираются. Нужен жар, взаимное доверие и уверенные мужские руки, чтобы женщина забыла обо всём на свете от сладостной дрожи.'
            else:
                $GirlTalkLizetteText = '— Истинная раскрепощённость приходит тогда, когда в постели исчезает страх показаться бесстыдной, — говорит Лизетта с уверенной улыбкой. — Любовь и страсть созданы для наслаждения, а не для стыдливых слёз в подушку. И на нашем фронтире эту науку постигают куда быстрее, чем в сонных монастырях.'
            end
        end

    ! ----------------------------------------------------
    ! 6. ТЕМА: МАТЬ ЖОРЖЕТТА
    ! ----------------------------------------------------
    elseif $GirlTalkLizetteTopic = 'lizette_mother':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = 'Лизетта смотрит на огни ночного причала, и в её голосе звучит искренняя, глубокая нежность:<br><br>— О маме спросить хочешь? — она мягко улыбается. — Спрашивай, Стефан. Мама у меня одна на всём белом свете, и я ею горжусь.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— Жоржетта никогда не запирала меня на засов и не читала лицемерных нотаций, — говорит Лизетта. — Она учила меня держать глаза открытыми и видеть людей насквозь. Я люблю её за то, что она не притворяется, будто ночной порт спит праведным сном.'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Моя мать знает цену этому городку лучше любого городского судьи, — кивает Лизетта на тёмные склады. — Я вся в неё пошла, только опыта пока меньше. Она не хочет, чтобы я раздаривала себя даром кому попало, и учит меня женской мудрости.'
            else:
                $GirlTalkLizetteText = '— Мама в одиночку подняла и кормит четверых детей, — произносит Лизетта с непривычной серьёзностью. — В этом городе многие любят судачить о её ремесле, но никто из этих болтунов не принёс моим братьям куска хлеба. Я всегда буду за неё горой, Стефан, и помогу ей во всём.'
            end
        end
    end

    killvar '$GirlTalkLizetteTopic'
    killvar '$GirlTalkLizettePart'
---

#GirlTalkLizetteLimitReachedText
    *pl 'Лизетта легко смеётся и качает головой:'
    *pl '— Стефан, придержи язык. Я люблю поболтать, но не собираюсь стоять тут до рассвета и слушать всё подряд. Хочешь чего-то большего — смотри, любуйся или зови гулять, а серьёзные разговоры оставим на потом.'
---

#GirlTalkLizetteMemoryLimitText
    *pl 'Лизетта непривычно долго смотрит на тебя, и её всегдашняя лукавая усмешка сменяется тёплым, искренним взглядом. Она подходит ближе и тихо касается твоей руки:'
    *pl '— Знаешь, Стефан... В порту все привыкли видеть во мне просто весёлую девчонку с кораблей. Все чего-то хотят — улыбки, сплетен, тела на одну ночь за пару монет. И я привыкла так жить.'
    *pl 'Она на мгновение опускает ресницы, а затем смотрит прямо в глаза:'
    *pl '— А с тобой всё по-другому. Ты не просто слушаешь — ты видишь меня настоящую. И я ловлю себя на мысли, что мне больше не хочется от тебя прятаться за шутками. Я тебе доверяю. По-настоящему.'
---

#GirlTalkLizetteMemoryPortSexText
    *pl 'Лизетта лукаво щурит голубые глаза, вспоминая ту жаркую ночь у причала, и облизывает пухлые губы:'
    *pl '— До сих пор мурашки по коже, как вспомню наши доски под плеск волн... — шепчет она с озорной улыбкой. — Ты тогда был таким ненасытным, Стефан. А я и не думала, что хозяин тихого трактира может брать с такой силой и страстью. Надо будет обязательно повторить... когда стемнеет.'
