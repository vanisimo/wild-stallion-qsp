! ================================================
! FILE: modules/actions/dialogs/girl_talk_lizette_text.qsps
! MODULE: actions/dialogs
! [AI-WORKED] Текст переработан / дополнен ассистентом 21.10.2026
! Тексты меню разговоров Лизетты
! Лор-пулы: GirlTalkLizetteLoreSlot (счётчик в Run)
! ================================================

#GirlTalkLizetteText
    $GirlTalkLizetteTopic = LCASE($ARGS[0])
    $GirlTalkLizettePart = LCASE($ARGS[1])
    $GirlTalkLizetteText = ''

    if $GirlTalkLizetteTopic = 'lizette_port':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = '— Порт, столица, корабли. Спрашивай.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                if PortCapitalShipAvailable = 1 or PortMeetWitnessed = 1:
                    $GirlTalkLizetteText = '— Корабль приносит не только товары, — улыбается Лизетта. — Он приносит новости, подарки и людей, которые слишком быстро забывают, что здесь всё решают не дворяне, а сплетни.'
                else:
                    $GirlTalkLizetteText = 'Она рассказывает о столичных платьях, редких тканях и о том, как в большом городе улыбка часто стоит дороже, чем вино в твоей лавке.'
                end
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— С последнего корабля привезли ленты, которых у вас ещё не видели, — говорит она, будто перечисляет сокровища. — Я уже знаю, кому из девочек они понравятся сильнее всего.'
            elseif GirlTalkLizetteLoreSlot = 2:
                $GirlTalkLizetteText = '— Тут на тебя смотрят, как только поговоришь с матросами, — смеётся Лизетта. — Я уже привыкла. В столице так же, только шумнее и грязнее у причала.'
            else:
                $GirlTalkLizetteText = 'Лизетта спрашивает, бывал ли ты в столице. Когда ты отвечаешь, она коротко описывает рынок у дальнего причала там — толпа, специи, матросы, которые платят за улыбку быстрее, чем здесь за кружку эля.'
            end
        end

    elseif $GirlTalkLizetteTopic = 'lizette_bio':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = '— Обо мне? — усмехается. — Ладно. Спрашивай.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— Мне восемнадцать, порт — мой второй дом, а столичный корабль — праздник, — говорит она. — Мать кормит семью ночью, я смотрю на мир шире зала трактира. Пока без цены — просто смотрю.'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Один матрос пытался обменять рыбу на ленту для шляпы, — вспоминает Лизетта и смеётся. — В столице такого бы не вышло. Здесь смешно, зато честно: все притворяются, что не замечают.'
            else:
                $GirlTalkLizetteText = '— Я не злая и не святая, — пожимает плечами она. — Просто знаю, что этот городок любит краснеть за чужую спину. А я люблю смотреть, кто краснеет первым.'
            end
        end

    elseif $GirlTalkLizetteTopic = 'lizette_gifts':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = '— Подарки? — оживляется. — С корабля много чего привозят. Спрашивай.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— Южный браслет, лента из столицы, стеклянные бусины — мелочь для тебя, а для девочки из зала это «как у большого города», — говорит Лизетта. — Подарок открывает дверь быстрее, чем спор.'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Зеркальце в резной рамке — моя слабость, — признаётся она. — Долго смотришься и вдруг понимаешь, что мужчины смотрят туда же. Веер для танцев — ещё лучше: красиво и с поводом приблизиться.'
            else:
                $GirlTalkLizetteText = '— Специи и травы с корабля — скучно, — усмехается Лизетта. — Но если принести блеск — глаза загораются. Я не торгуюсь за дружбу. Просто знаю, что блеск в маленьком городе стоит дороже золота, потому что другого такого никто не видел.'
            end
        end

    elseif $GirlTalkLizetteTopic = 'lizette_amanda':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = '— Аманда? — понижает голос. — Спрашивай. Только без крика.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                if AmandaMetLizette = 1 and AmandaLizaInfluence >= 5:
                    $GirlTalkLizetteText = '— Твоя сестра слушает меня внимательнее, чем хотела бы признать, — говорит Лизетта. — Подарки — это только повод. Ей нужен мир шире, чем зал трактира. Будь осторожен: я не хочу врагов в твоей семье.'
                elseif AmandaMetLizette = 1:
                    $GirlTalkLizetteText = '— Я привезла ей кое-что с корабля, — признаётся Лизетта. — Не ради интриги. Просто в её глазах слишком много вопросов, на которые этот город отвечает только работой и молчанием.'
                else:
                    $GirlTalkLizetteText = 'Лизетта говорит о редких подарках и о том, как легко заинтересовать девушку, которая каждый день видит один и тот же зал. Пока это звучит безобидно — но она явно привыкла добиваться своего.'
                end
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Аманда краснеет, когда я рассказываю про столицу, — усмехается Лизетта. — Не потому что глупая. Потому что ей стыдно хотеть большего. Я не ломаю её — просто показываю, что дверь уже приоткрыта.'
            else:
                $GirlTalkLizetteText = '— Если подаришь ей что-то с корабля — спасибо скажет тебе, а загораются глаза у неё, — говорит Лизетта прямо. — Я не ворую сестёр. Я ищу подругу, которая тоже устала считать кружки в зале вместо звёзд.'
            end
        end

    elseif $GirlTalkLizetteTopic = 'lizette_intim':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = '— Ты хочешь знать, о чём мы шепчемся с Амандой? — Лизетта усмехается. — Спрашивай. Я не из тех, кто краснеет за чужие слова.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— В столице учат сначала мыть, — говорит Лизетта прямо. — Тело, руки, а если берёшь в рот — то и там, где был, тоже чисто. Грязное в рот — это мерзость, даже Аманда это понимает. А уже потом — не плеваться, проглотить и не морщиться.'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— На лицо — не конец света, — продолжает Лизетта. — Сначала вытерла — и забыла. Потом можно собрать пальцами и попробовать. А на поздних стадиях говорят, что для кожи полезнее всякой пудры с корабля.'
            elseif GirlTalkLizetteLoreSlot = 2:
                $GirlTalkLizetteText = '— Ниже ствола тоже ласкают, — понижает голос она. — Яйца облизывают, мягко посасывают. Сначала страшно, потом привыкаешь. Аманда пока краснеет, но уши на мне.'
            elseif GirlTalkLizetteLoreSlot = 3:
                $GirlTalkLizetteText = '— Был в попе — потом в рот? — Лизетта смотрит на тебя оценивающе. — Только после мытья, и только если сама решишь. Сначала скажет «нет». Потом «ладно, тише». Это не за один вечер.'
            elseif GirlTalkLizetteLoreSlot = 4:
                $GirlTalkLizetteText = '— Если довести её достаточно, — шепчет Лизетта, — можно кончить в рот так, что она сама кончит от вкуса. Нужен жар, опыт и чтобы она уже не делала вид, что ей всё равно.'
            else
                $GirlTalkLizetteText = '— На поздних стадиях умные девочки собирают сперму ручками — с живота, с киски, даже из попы — и отправляют в рот, — говорит Лизетта без стыда. — Аманда ещё сопротивляется словам, но глаза загораются.'
            end
        end

    elseif $GirlTalkLizetteTopic = 'lizette_mother':
        if $GirlTalkLizettePart = 'intro':
            $GirlTalkLizetteText = '— Мать? — усмехается. — Спрашивай.'
        elseif $GirlTalkLizettePart = 'context':
            if GirlTalkLizetteLoreSlot = 0:
                $GirlTalkLizetteText = '— Жоржетта не запирает меня, — говорит Лизетта. — Предупреждает других держать глаза открытыми. Я люблю её за это. Не за нотации — за то, что не делает вид, что порт ночью спит.'
            elseif GirlTalkLizetteLoreSlot = 1:
                $GirlTalkLizetteText = '— Мать знает цену городу лучше мэра, — кивает она на огни склада. — Я вся в неё, только ещё не знаю всех цен. Она не хочет, чтобы я отдавала себя даром. Я пока просто смотрю шире зала.'
            else:
                $GirlTalkLizetteText = '— Иногда она зовёт меня работать рядом, — признаётся Лизетта без стыда. — Не сегодня и не завтра, может. Но я уже понимаю: мать кормит четверых детей, а я хочу не только смотреть на ленты с корабля.'
            end
        end
    end

    killvar '$GirlTalkLizetteTopic'
    killvar '$GirlTalkLizettePart'
---

#GirlTalkLizetteLimitReachedText
    *pl 'Лизетта легко смеётся и качает головой:'
    *pl '— Стефан, придержи язык. Я люблю поболтать, но не собираюсь стоять тут до рассвета и слушать всё подряд. Хочешь чего-то большего — смотри, любуйся или зови гулять, а серьёзные разговоры оставим на потом.'
---

#GirlTalkLizetteMemoryLimitText
    *pl 'Лизетта непривычно долго смотрит на тебя, и её всегдашняя лукавая усмешка сменяется тёплым, искренним взглядом. Она подходит ближе и тихо касается твоей руки:'
    *pl '— Знаешь, Стефан... В порту все привыкли видеть во мне просто весёлую девчонку с кораблей. Все чего-то хотят — улыбки, сплетен, тела на одну ночь за пару монет. И я привыкла так жить.'
    *pl 'Она на мгновение опускает ресницы, а затем смотрит прямо в глаза:'
    *pl '— А с тобой всё по-другому. Ты не просто слушаешь — ты видишь меня настоящую. И я ловлю себя на мысли, что мне больше не хочется от тебя прятаться за шутками. Я тебе доверяю. По-настоящему.'
---

#GirlTalkLizetteMemoryPortSexText
    *pl 'Лизетта лукаво щурит голубые глаза, вспоминая ту жаркую ночь у причала, и облизывает пухлые губы:'
    *pl '— До сих пор мурашки по коже, как вспомню наши доски под плеск волн... — шепчет она с озорной улыбкой. — Ты тогда был таким ненасытным, Стефан. А я и не думала, что хозяин тихого трактира может брать с такой силой и страстью. Надо будет обязательно повторить... когда стемнеет.'
---

#GirlTalkLizetteMemoryChurchSpyText
    *pl 'Лизетта тихо фыркает и оглядывается по сторонам, заметив твой понимающий взгляд:'
    *pl '— Ты ведь всё видел тогда в соборе за витражом, признайся? — она насмешливо щурится, ничуть не смущаясь. — Видел, как наш святоша Герхард теряет разум от одного взгляда на девичьи коленки. Святой круг, молитвы, благословения... а сам дрожит, как мальчишка. Ты только матери не говори — она и так считает, что я слишком рано узнала, сколько стоят чужие грехи.'
---

#GirlTalkLizetteMemoryAmandaText
    *pl 'Лизетта улыбается, вспоминая их беседы с Амандой:'
    *pl '— Спасибо, что не запираешь Аманду в четырёх стенах, Стефан. Ей очень не хватало подруги, с которой можно посмеяться и поговорить о том, о чём взрослые обычно молчат. Она у тебя замечательная. Чистая, искренняя... Я не сделаю ей дурного, обещаю. Просто покажу, что мир шире кухонных полок.'
---
