! ================================================
! FILE: modules/actions/dialogs/girl_talk_family_text.qsps
! MODULE: actions/dialogs
! Тексты контекстного разговора о семье
! ================================================

#GirlTalkFamilyText
    $GirlTalkFamilyTextId = LCASE($ARGS[0])
    $GirlTalkFamilyText = ''

    if $GirlTalkFamilyGirl = '':
        $GirlTalkFamilyGirl = $TalkGirl
    end

    $GirlTalkFamilyChoiceType = $LastHallChoiceType

    if $GirlTalkFamilyChoiceType = '' and $GirlTalkFamilyGirl <> '':
        $GirlTalkFamilyChoiceType = $LastGirlChoiceType[$GirlTalkFamilyGirl]
    end

    if $GirlTalkFamilyTextId = 'intro':
        if $GirlTalkFamilyGirl = 'amanda':
            $GirlTalkFamilyText = '— Про нас? — Аманда косится на дверь. — Ладно, валяй. Только не включай хозяина. Я и так помню, кто тут за крышу платит.'
        elseif $GirlTalkFamilyGirl = 'melissa':
            $GirlTalkFamilyText = '— Говори. Про нас, не про зал. — Мелисса складывает руки. — Я тебя предупреждала: что творится внизу, то потом лезет наверх. И воняет.<br><br>Голос мягче, чем поза.'
        elseif $GirlTalkFamilyGirl = 'sandra':
            $GirlTalkFamilyText = '— Про нас хочешь? — Сандра вытирает руки о фартук, хотя он чистый. — Давай быстро. У меня котлы кипят, но я послушаю. Для вас у меня время есть. Всегда было.'
        else:
            $GirlTalkFamilyText = 'Разговор о доме. ' + $RealName[$GirlTalkFamilyGirl] + ' слушает внимательнее обычного — здесь ставки выше, чем в зале.'
        end

    elseif $GirlTalkFamilyTextId = 'context':
        if $GirlTalkFamilyGirl = 'sandra' and SandraHomeSex = 0 and GirlSuspectsAmandaStefan['sandra'] >= 1 and SandraAmandaSuspicionTalkDone = 0 and FamilyCorruptionStage < 4:
            $GirlTalkFamilyText = '— Я про то утро думаю, — Сандра говорит сразу, без подходов. — Вы с Амандой не выспались. Дверь скрипела всю ночь. Я не глухая, Стефан. И не слепая.<br><br>— При девчонках я сцену катить не буду. Но мы с тобой вдвоём поговорим. Честно. А пока — веди себя так, чтобы мне не пришлось выбирать между тобой и ею. Я этого не хочу.'
        elseif $GirlTalkFamilyGirl = 'melissa' and MelissaHomeSex = 0 and GirlSuspectsAmandaStefan['melissa'] >= 1 and MelissaAmandaTeaseDone = 0 and FamilyCorruptionStage < 4:
            $GirlTalkFamilyText = '— Мы не про зал сейчас, — Мелисса смотрит в глаза. — Не прикидывайся, что у вас с Амандой всё как раньше. Я не дура. И в сказки про невинность не верю.<br><br>— Было у вас что-то — скажи сам. Не скажешь — я сама додумаю. А считаю я быстро, ты знаешь.'
        elseif $GirlTalkFamilyGirl = 'amanda' and AmandaFirstSexMorningShown = 1 and AmandaFirstSexAmandaWorryTalkDone = 0 and FamilyCorruptionStage < 4:
            $GirlTalkFamilyText = '— Про нас... — Аманда теребит рукав, не смотрит. — Мама что-то чует. Мелисса зыркает так, будто уже всё знает, но молчит.<br><br>— Давай тише будем, а? Не потому что стыдно. Потому что одна не та улыбка — и ужин к чертям. Я не хочу, чтобы нас судили за столом.'
        elseif FamilyCorruptionStage >= 4:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = '— Мы уже другие, — Аманда говорит тихо, без своей обычной наглости. — За столом все лыбятся. А я вижу: Мелисса считает наши взгляды. Мама — наши паузы. Ты — монеты.<br><br>— Раньше я домой приходила. А теперь будто на сцену выхожу. И не пойму, что играю. Комедию? Трагедию? Наверное, всё сразу.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = '— Всё размылось, — Мелисса без пафоса. — Уже не важно, кто прав. Важно, кто первый перестанет стыдиться. Я молчать не буду. И притворяться тоже.<br><br>— Мы ещё садимся за один стол. Пока садимся — не всё потеряно.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = '— Терпением мы не выживем, — Сандра устало. — Мы выживем, если будем помнить, зачем мы вообще вместе. А внизу каждый вечер соблазн.<br><br>— Я не святая, Стефан. Но если мы забудем, ради чего этот трактир держали — мы продадим не стены. Мы друг друга продадим.'
            else:
                $GirlTalkFamilyText = 'В доме привыкли, что старые правила больше не железные. Разговор идёт осторожно — как по тонкому льду над подвалом.'
            end
        elseif FamilyCorruptionStage >= 2:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = '— Раньше мы просто ужинали после смены, — Аманда вздыхает. — А теперь за столом то, о чём лучше молчать. Кто-то ржёт как лошадь. Кто-то молчит так, что уши закладывает.<br><br>— Я не знаю, это мудрость или трусость. Знаю одно: если начнёт вонять залом — я первая не выдержу. И первая же сделаю вид, что всё нормально.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = '— Мы ещё держимся, — Мелисса режет словами. — Но не на вере. Все видят, куда ты тащишь трактир, если не выберешь сторону.<br><br>— Я помогаю маме. Слежу за Амандой. Слежу за тобой. Устала быть единственной, кто всё считает. Но пока я считаю — мы не чужие. Мы ещё семья.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = '— Ругаться каждый вечер я не буду, — Сандра ставит точку. — Но и делать вид, что ничего не происходит — тоже не буду. Мы должны знать, за что нам стыдно. И чем гордиться.<br><br>— Ты хозяин. Я мать. Мелисса у нас вместо судьи. Аманда — искра. Если искра не туда упадёт — сгорим все. И она первая.'
            else:
                $GirlTalkFamilyText = 'Границы в доме уже не такие чёткие. Слова подбирают осторожно — каждый боится задеть не тот нерв.'
            end
        elseif FamilyTension > FamilyTrust + 15:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = '— Ты спрашиваешь про нас, — Аманда криво улыбается, — а я думаю, за кого ты сегодня. У нас тут как перед дракой в зале. Все лыбятся, а в руке уже нож.<br><br>— Я могу языком ужалить. А вот чинить то, что ты молчанием сломал — не могу. Так что говори. Или не обижайся, если я скажу сама. И тебе не понравится.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = '— У нас тут все на нервах, — Мелисса без крика. — Один разговор — или сблизит, или добьёт. Говори прямо. Я устала гадать по твоим вздохам. И по тому, за кого ты в зале вписался.<br><br>— Я не Аманда. Мне зрители не нужны. Мне нужна правда. Не дашь её — я начну рулить сама. И, честно, у меня получится.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = '— Все злые, — Сандра роняет. — Слышно без слов. Ложка звякнула не так, половица скрипнула, Мелисса на Аманду посмотрела. Один честный разговор лучше, чем неделя, когда мы жрём молча.<br><br>— Я устала всех разнимать. Но пока ты не покажешь, что сам тянешь — я не уйду в сторону. И это не упрёк. Я мать.'
            else:
                $GirlTalkFamilyText = 'Дом на взводе. Осторожно — здесь каждое слово может стать искрой.'
            end
        elseif FamilyTrust > FamilyTension + 20:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = '— Знаешь... — Аманда улыбается и тут же отворачивается, будто её поймали. — Приятно, когда можно сказать «мы» и не ждать, что ты подколешь.<br><br>— Не думай, я всё та же Аманда. Но если ты правда за нас — я, может, перестану всё прятать. Может. Попробую, честно.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = '— Пока мы можем орать друг на друга без ножей — это хорошо, — Мелисса, и уголок рта дёрнулся. — Мы ещё не чужие. Не постояльцы в своём же доме.<br><br>— Я говорила, будет тяжело. Не говорила, что иногда будет нормально. Не привыкай. Я всё ещё считаю. Просто теперь не против тебя.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = '— Вот так и надо, — Сандра кивает, и видно — отпустило. — Когда можно сказать правду и не бояться, что тебя продадут за медяк или за шутку пьяного гостя.<br><br>— Ты растёшь, Стефан. Не годами. Делами. Может, скоро я перестану стоять между вами и дверью. Пока — спасибо, что спросил про нас, а не про выручку.'
            else:
                $GirlTalkFamilyText = 'В семье ещё есть доверие. Разговор идёт спокойнее — но никто не расслабляется до конца.'
            end
        else:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = '— Комнаты, ссоры, работа под одной крышей, — Аманда пожимает плечами. — Я устала всё в себе держать. Злости нет. Просто привыкла, что наш дом — это и кухня, и зал, и чужие лапы на плече после смены.<br><br>— Иногда мечтаю свалить. А потом думаю: а куда? Везде чужая крыша. Лучше уж наша. Если ты не дурак.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = '— Раньше было проще, — Мелисса. — Сейчас я каждый день считаю. Не от страха. От привычки держать всё под контролем.<br><br>— Аманда думает, я злая. Я не злая. Я готовлюсь. Если завтра в зале опять полезут к нам — я уже знаю, что делать. Вопрос — ты знаешь?'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = '— Наш дом — это не комната над трактиром, — Сандра. — Это куда ты приползаешь, когда внизу ор и вонь. Пока так.<br><br>— Девчонки взрослеют быстрее, чем мы крышу латаем. Ты — хозяин. Я слежу, чтоб на плите не сгорело главное. Остальное — на тебе, сын.'
            else:
                $GirlTalkFamilyText = 'Тихо о доме. Без скандала — но и без иллюзий, что всё идеально.'
            end
        end

    elseif $GirlTalkFamilyTextId = 'hall_hook':
        if $LastHallChoiceEvent = 'noble_attack' and $GirlTalkFamilyGirl = 'sandra':
            if $GirlTalkFamilyChoiceType = 'sandra_shield':
                $GirlTalkFamilyText = '— Не хотела, чтобы ты видел меня такой, — говорит Сандра тихо. — Мать между сыном и клинком. Иначе в зеркало не смотреть.<br><br>— Он назвал тебя бастардом. Дом услышал. Я выбрала тебя — не потому что слабая. Потому что иначе у нас не останется ни дома, ни имени, ни утра без стыда.'
            elseif $GirlTalkFamilyChoiceType = 'yield':
                $GirlTalkFamilyText = '— Согнулся, чтобы выжить, — говорит Сандра мягко. — Не виню. Дом важнее гордости одного вечера.<br><br>— Потом поговорим — не о зале. О том, что в тебе от отца на бумаге и что в тебе от нас. Пока — живой. Этого хватит на сегодня.'
            else:
                $GirlTalkFamilyText = '— После вечера дом уже не прежний, — говорит Сандра. — Слишком много услышали «бастард». Тайны с кухни не сдерёшь ножом для хлеба.<br><br>— Я не спрошу всё сразу. Но если ты хранишь бумаги — однажды принесёшь их сам. Или я дожму. Матерински, не по-зальной.'
            end
        elseif $GirlTalkFamilyChoiceType = 'protect':
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = '— Про зал... — Аманда замолкает, ковыряет ногтем стол. — Спасибо, что влез. Сама бы справилась. Ну... почти.<br><br>— Для меня это много значит. Не для трактира. Для меня. Я запомню. И если опять полезут — я тебе скажу. Или врежу подносом. Как настроение будет.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = '— Я видела, что ты сделал в зале, — Мелисса. — Это важно. Когда ты защищаешь своих — мы дышим. Когда ты просто смотришь — мы считаем, сколько нам до конца.<br><br>— Я тебя предупреждала про черту. Сегодня ты её провёл. Не расслабляйся. Завтра полезут снова. Но спасибо. Без улыбок. Правда.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = '— Сегодня в зале ты напомнил, зачем мы вообще этот дом держим, — Сандра. — Иногда защитить — это и есть семья. Не слова за ужином. А спина, когда к твоим лезут.<br><br>— Так и надо. Ты не герой. Ты живой. И пока ты стоишь — мне чуть спокойнее. Чуть-чуть. Но уже не ноль.'
            else:
                $GirlTalkFamilyText = 'Запомнили, что вмешался. В доме это весит больше, чем любая чаевая.'
            end
        elseif $GirlTalkFamilyChoiceType = 'calm' or $GirlTalkFamilyChoiceType = 'own_choice' or $GirlTalkFamilyChoiceType = 'watch' or $GirlTalkFamilyChoiceType = 'ignore':
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = '— Про зал... — Аманда отводит глаза. — Ты не влез. Может, умно. Может, забоялся. Я не судья. Я та, кого лапали.<br><br>— Не удивляйся, если я теперь сама буду решать. И тут, и там. Я колючая — не значит слабая. Значит, устала ждать, пока ты выберешь сторону.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = '— Ты оставил меня разгребать, — Мелисса. — Справлюсь. Только не называй это потом «заботой».<br><br>— Я умею держать зал. Сестру умею держать. И тебя удержу, если надо. Сегодня ты выбрал молчать. Завтра я выберу правила. И ты их почувствуешь. Раньше, чем гости.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = '— Не полез в драку, — Сандра. — Может, пожалел вечер. Может, просто удобнее промолчать. Я решу потом.<br><br>— Я не требую, чтобы ты геройствовал каждый раз. Я требую, чтобы ты знал, когда тебе должно быть стыдно. Подумай об этом. За ужином я на тебя посмотрю.'
            else:
                $GirlTalkFamilyText = 'Вы не вмешались. В доме заметили — и запомнят дольше, чем в зале.'
            end
        elseif $GirlTalkFamilyChoiceType = 'encourage' or $GirlTalkFamilyChoiceType = 'client':
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = '— Про вчера... — Аманда в пол смотрит. — Деньги ты взял. Я поняла.<br><br>— Знаешь, что хуже всего? От пьяного в зале я отобьюсь. Плюну ему в рожу. А когда ты сам киваешь... Куда мне плевать, Стефан? Тебе в суп?'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = '— Про вчера, — Мелисса сухо. — Монеты у тебя. А совесть где? У нас наверху осталась?<br><br>— Не делай вид, что удивлён. Я всё помню.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = '— Про вчера слышала, — Сандра не отрывается от дел. — Деньги есть. А дочерям — как после этого в глаза людям смотреть?<br><br>Стук ложкой.<br><br>— Я мать. Поговорим. Не сейчас.'
            else:
                $GirlTalkFamilyText = 'Деньги взяли. В доме тяжело — пахнет не ужином, а сделкой.'
            end
        else:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = '— Ты сегодня какой-то… другой, — говорит Аманда не сразу. — Не знаю, хороший или нет. Дом это запомнит. Я — тоже.<br><br>— Расскажи сам, если хочешь. Или молчи. Только молчание у нас не лечит — только копит.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = '— Я видела зал, — говорит Мелисса. — Видела тебя. Пока не знаю, как это назвать. Хозяин? Наблюдатель? Торговец?<br><br>— Семья любит ярлыки. Я — нет. Но выводы всё равно сделаю. Дай мне повод назвать тебя своим, а не случайным.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = '— В зале было непросто, — говорит Сандра. — Дом это переварит — если ты скажешь, на чьей стороне крыша.<br><br>— Я не требую подвигов. Требую ясности. Для матери это одно и то же.'
            else:
                $GirlTalkFamilyText = 'Вспоминают, каким хозяином вы были для дома в тот вечер. Слова пока не находят — но взгляды уже говорят.'
            end
        end
    end

    killvar '$GirlTalkFamilyTextId'
    killvar '$GirlTalkFamilyChoiceType'
---