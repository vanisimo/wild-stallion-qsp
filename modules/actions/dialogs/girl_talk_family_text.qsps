! ================================================
! FILE: modules/actions/dialogs/girl_talk_family_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! MODULE: actions/dialogs
! Тексты контекстного разговора о семье
! ================================================

#GirlTalkFamilyText
    $GirlTalkFamilyTextId = LCASE($ARGS[0])
    $GirlTalkFamilyText = ''

    if $GirlTalkFamilyGirl = '':
        $GirlTalkFamilyGirl = $TalkGirl
    end

    $GirlTalkFamilyChoiceType = $LastHallChoiceType

    if $GirlTalkFamilyChoiceType = '' and $GirlTalkFamilyGirl <> '':
        $GirlTalkFamilyChoiceType = $LastGirlChoiceType[$GirlTalkFamilyGirl]
    end

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (СЕМЕЙНЫЙ КРУГ, НАСТРОЕНИЕ, РАСКОВАННОСТЬ)
    ! ----------------------------------------------------
    if $GirlTalkFamilyTextId = 'intro':
        if $GirlTalkFamilyGirl = 'amanda':
            if FamilyCorruptionStage >= 3:
                $GirlTalkFamilyText = 'Аманда прислоняется бедром к косяку, скрещивает руки под грудью и лукаво щурится. Её взгляд скользит по твоему телу вниз к штанам между ног:<br><br>— Про нас? — она тихо усмехается. — Давай, спрашивай. За закрытыми дверями мы уже давно не чужие друг другу. Только тише, чтобы в зале не грели уши.'
            else:
                $GirlTalkFamilyText = 'Аманда настороженно оглядывается на дверь и поправляет край фартука:<br><br>— Про дом хочешь поговорить? — она переступает с ноги на ногу. — Ладно, валяй. Только не включай строгого хозяина. Я и без нотаций помню, кто за крышу платит.'
            end

        elseif $GirlTalkFamilyGirl = 'melissa':
            if FamilyCorruptionStage >= 3:
                $GirlTalkFamilyText = 'Мелисса откладывает перо, слегка наклоняет голову и с насмешливой полуулыбкой смотрит тебе прямо в глаза:<br><br>— О делах семьи? — она складывает руки на груди. — Выкладывай. Скрывать друг от друга нам уже нечего — старые запреты мы успешно похоронили. Говори начистоту, без увиливаний.'
            else:
                $GirlTalkFamilyText = 'Мелисса выпрямляет спину и строго оглядывает тебя:<br><br>— Говори. Только про наш дом, а не про кабацкие дрязги. Я предупреждала: если бардак из зала полезет наверх, мы перестанем быть семьёй. Слушаю тебя.'
            end

        elseif $GirlTalkFamilyGirl = 'sandra':
            if FamilyCorruptionStage >= 3:
                $GirlTalkFamilyText = 'Сандра вытирает ладони о полотенце, подаётся вперёд и поправляет вырез платья, обнажая пышную грудь. Её глаза теплеют, задерживаясь на твоём лице и плечах:<br><br>— О нашей семье, Стефан?.. — она мягко улыбается. — Подойди ближе. Ты теперь в этом доме и опора, и настоящий хозяин. Спрашивай, для тебя у меня всегда найдётся время.'
            else:
                $GirlTalkFamilyText = 'Сандра смахивает крошки со стола и разворачивается к тебе, сложив руки под грудью:<br><br>— Про нас поговорить пришёл? — она внимательно смотрит тебе в глаза. — Давай быстро, пока суп на плите не убежал. Для детей у меня время всегда есть. Выкладывай.'
            end

        else:
            $GirlTalkFamilyText = 'Разговор о доме. ' + $RealName[$GirlTalkFamilyGirl] + ' слушает внимательно — семейные узы значат больше, чем дела в зале.'
        end

    ! ----------------------------------------------------
    ! 2. ОСНОВНОЙ КОНТЕКСТ СЕМЬИ (ПОДОЗРЕНИЯ, КОРРУПЦИЯ, ДОВЕРИЕ)
    ! ----------------------------------------------------
    elseif $GirlTalkFamilyTextId = 'context':

        ! Специфические подозрения и события
        if $GirlTalkFamilyGirl = 'sandra' and SandraHomeSex = 0 and GirlSuspectsAmandaStefan['sandra'] >= 1 and SandraAmandaSuspicionTalkDone = 0 and FamilyCorruptionStage < 4:
            $GirlTalkFamilyText = 'Сандра откладывает кухонный нож, вытирает руки и тяжело смотрит тебе прямо в глаза:<br><br>— Я всё думаю про то утро, Стефан, — ровным, глухим голосом начинает она. — Вы с Амандой оба носа из комнат не казали, а половицы наверху скрипели всю ночь напролёт. Я не глухая и не слепая.<br><br>Она подходит ближе и твёрдо кладёт руку тебе на плечо:<br><br>— При девчонках скандала я устраивать не стану. Но мы с тобой поговорим с глазу на глаз. А пока — веди себя так, чтобы мне не пришлось вставать между сыном и дочерью. Я этого не переживу.'

        elseif $GirlTalkFamilyGirl = 'melissa' and MelissaHomeSex = 0 and GirlSuspectsAmandaStefan['melissa'] >= 1 and MelissaAmandaTeaseDone = 0 and FamilyCorruptionStage < 4:
            $GirlTalkFamilyText = 'Мелисса закрывает книгу, складывает руки на груди и пристально буравит тебя взглядом поверх очков:<br><br>— Мы сейчас не о выручке говорим, — сухо отчеканивает она. — Даже не пытайся делать вид, будто между тобой и Амандой всё по-прежнему. Я не дура и в сказочки про братскую нежность не верю.<br><br>Она щурится, скривив губы:<br><br>— Было у вас что-то — скажи прямо сам. Не скажешь — я сложу два и два без тебя. А считаю я быстро и безошибочно, ты это отлично знаешь.'

        elseif $GirlTalkFamilyGirl = 'amanda' and AmandaFirstSexMorningShown = 1 and AmandaFirstSexAmandaWorryTalkDone = 0 and FamilyCorruptionStage < 4:
            $GirlTalkFamilyText = 'Аманда нервно теребит край передника, покусывая нижнюю губу и не поднимая на тебя глаз:<br><br>— Про нас... — шепчет она, косясь на лестницу. — Мама смотрит волком, явно что-то почуяла. А Мелисса сверлит взглядом так, будто уже всё поняла, просто выжидает удобный момент.<br><br>Она робко касается твоей руки пальцами:<br><br>— Давай будем осторожнее, ладно? Не потому что мне стыдно... А потому что одна случайная усмешка — и за столом начнётся ад. Я не хочу, чтобы нас судили всей семьёй.'

        ! Высокая коррупция: старые рамки сломаны, семья живёт по своим правилам
        elseif FamilyCorruptionStage >= 4:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = 'Аманда тихо посмеивается, подходит вплотную и смело кладёт ладонь на твою грудь, заглядывая снизу вверх:<br><br>— Мы стали совсем другими, Стефан, — её глаза блестят. — За общим столом все сидят чинно, а под скатертью наши колени соприкасаются. Мама ловит твои взгляды, Мелисса следит за каждым твоим вздохом... Стыд выветрился без следа. Осталась чистая страсть и наш общий секрет. Мы держимся друг за друга крепче, чем любые праведники в этом городе.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = 'Мелисса спокойно барабанит пальцами по конторке, оглядывая тебя с насмешливой уверенностью:<br><br>— Прежние предрассудки развеялись, — ровно констатирует она. — Городские ханжи с ума сошли бы, узнай они, что творится под нашей крышей. Но в этом есть железная логика: нас больше ничем нельзя расколоть. Мы повязаны одной тайной. Главное — держи невозмутимое лицо перед чужаками в зале. Остальное остаётся только нашим.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = 'Сандра глубоко вздыхает, но на её лице нет печали — лишь зрелая, тёплая улыбка. Она касается твоей щеки ладонью:<br><br>— Мы перешагнули черту, сынок, — тихо говорит она. — Раньше я боялась гнева Ильматера, а теперь вижу: наш дом выстоял. Ты взял на себя всё — и заботу, и мужскую силу. Я твоя мать, но я же и твоя женщина. И пока мы делим хлеб, постель и кров без обмана — никто нас не сломает.'
            else:
                $GirlTalkFamilyText = 'В доме старые запреты давно развеялись. Разговор идёт без оглядки на чужую мораль — здесь каждый знает цену общей тайне.'
            end

        ! Средняя коррупция: трещины в морали, зарождение запретного
        elseif FamilyCorruptionStage >= 2:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = 'Аманда вздыхает, поправляя косу, и бросает на тебя смущённый, но пытливый взгляд:<br><br>— Раньше мы просто ужинали и расходились спать, — тихо говорит она. — А теперь за столом воздух прямо искрит. Кто-то шутит двусмысленно, кто-то молчит так, что мороз по коже. Я не знаю, куда это всё приведёт. Но если честно... мне уже не хочется возвращаться к старым порядкам. С тобой всё стало иначе.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = 'Мелисса смотрит прямо, скрестив руки на груди:<br><br>— Мы ещё держим внешние приличия, — сухо произносит она. — Но границы трещат по швам. Все видят, какими взглядами мы обмениваемся за ужином. Я считаю доходы, но считаю и то, как быстро меняются наши роли. Ты хозяин, Стефан. Смотри, куда ведёшь наш дом.'
                if PlayerKnows_SandraDraupnirFriday = 0 and SandraCarpenterSecret = 0:
                    $GirlTalkFamilyText += '<br><br>— И ещё кое-что про нашу матушку, — Мелисса иронично вскидывает бровь. — По пятницам вечером она зачастила в Квартал ремесленников к столяру Драупниру. Видимо, дуб в его мастерской требует особого присмотра... Сходил бы ты проведал её как-нибудь в пятничный вечер.'
                    SandraDraupnirHintGossip = 1
                end
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = 'Сандра нервно поправляет фартук, глядя в сторону:<br><br>— Неспокойно мне, Стефан, — в голосе сквозит волнение. — Девчонки выросли, смотрят на тебя совсем не как на брата. Да и в моих мыслях появилось то, от чего следовало бы расшибить лоб в храме Ильматера. Мы ходим по краю. Береги девчонок, сынок. И себя береги.'
            else:
                $GirlTalkFamilyText = 'Прежние правила в доме дают трещину. Разговор идёт осторожно — каждый прощупывает почву, боясь задеть запретную тему.'
            end

        ! Высокое напряжение: ссоры, обиды, недоверие
        elseif FamilyTension > FamilyTrust + 15:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = 'Аманда кривит губы и с вызовом смотрит на тебя:<br><br>— Ты спрашиваешь про дом? — она цедит слова сквозь зубы. — А у нас тут обстановка, как перед поножовщиной в зале. Все улыбаются сквозь зубы, а в кулаке держат камень. Хватит отмалчиваться, Стефан. Говори прямо, что на уме, иначе я сама скажу — и тебе это сильно не понравится.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = 'Мелисса резко захлопывает гроссбух, её пальцы сжаты в кулаки:<br><br>— В доме все на взводе, — холодно констатирует она. — Мы либо сядем и разберёмся без криков, либо дом развалится на куски. Я устала гадать по твоим вздохам и косым взглядам. Нужна правда. Не дашь её — я начну наводить порядок своими методами.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = 'Сандра роняет ложку на стол с глухим стуком:<br><br>— Все злые как собаки, — горько говорит она. — Половица скрипнет — уже искры летят. За столом едим молча, словно чужие люди. Стефан, ты глава дома! Сделай что-нибудь, пока мы окончательно не перегрызлись.'
            else:
                $GirlTalkFamilyText = 'В доме обстановка накалена до предела. Любое неосторожное слово может обернуться скандалом.'
            end

        ! Высокое доверие: теплота, сплочённость
        elseif FamilyTrust > FamilyTension + 20:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = 'Аманда искренне улыбается, чуть склонив голову к плечу:<br><br>— Знаешь, Стефан... — мягко начинает она. — Здорово, когда можно просто поговорить и не ждать подвоха. Я всё та же заноза, конечно, но рядом с тобой мне спокойно. Спасибо, что ты за нас стоишь горой.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = 'Уголок губ Мелиссы слегка приподнимается в редкой улыбке:<br><br>— Пока мы умеем слушать друг друга — мы выстоим, — спокойно замечает она. — Я много критикую, знаю. Но это потому, что мне не всё равно. Ты делаешь правильные шаги, Стефан. Семья это чувствует.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = 'Сандра с облегчением выдыхает, и с её лица сходит привычная усталость:<br><br>— Вот так и должно быть, — она кивает с одобрением. — Когда в семье правда и опора, никакой шторм снаружи не страшен. Ты взрослеешь, Стефан. Не годами, а поступками. Мне на душе спокойнее за девчонок, когда ты рядом.'
            else:
                $GirlTalkFamilyText = 'В семье царит редкое согласие. Беседа течёт легко и доверительно.'
            end

        ! Обычное состояние дома
        else:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = 'Аманда пожимает плечами, глядя в окно:<br><br>— Комнаты тесные, забот выше крыши, — она усмехается. — Иногда хочется хлопнуть дверью и сбежать на край света. А потом подумаешь: кому я там нужна? Здесь хоть свой угол. Главное — не ссориться по пустякам.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = 'Мелисса поправляет бумаги на столе:<br><br>— Обычные будни, — сухо отзывается она. — Работаем, считаем медяки, латаем дыры в бюджете. Главное — держать строй и не давать слабину перед чужаками в зале.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = 'Сандра помешивает варево в котле:<br><br>— Живём потихоньку, сынок. Девчонки при деле, на плите кипит, крыша не течёт. Слава Ильматеру, пока справляемся. Ты за залом приглядывай, а я дом удержу.'
            else:
                $GirlTalkFamilyText = 'Спокойный разговор о домашних заботах — без лишних страстей и потрясений.'
            end
        end

    ! ----------------------------------------------------
    ! 3. РЕАКЦИИ НА ВЫБОР В ЗАЛЕ (ПОСЛЕДСТВИЯ И ВПЕЧАТЛЕНИЯ)
    ! ----------------------------------------------------
    elseif $GirlTalkFamilyTextId = 'hall_hook':

        ! Стычка с дворянином
        if $LastHallChoiceEvent = 'noble_attack' and $GirlTalkFamilyGirl = 'sandra':
            if $GirlTalkFamilyChoiceType = 'sandra_shield':
                $GirlTalkFamilyText = 'Сандра говорит тихо, опустив глаза на свои натруженные ладони:<br><br>— Не хотела я, чтобы ты видел меня такой, Стефан. Мать, закрывающая сына от клинка... Но иначе я поступить не могла. Он назвал тебя бастардом на весь зал. Семья это услышала. Я встала между вами, потому что без тебя наш дом обратится в пепел.'
            elseif $GirlTalkFamilyChoiceType = 'yield':
                $GirlTalkFamilyText = 'Сандра мягко касается твоего плеча, в её глазах сочувствие:<br><br>— Ты уступил, чтобы сберечь жизни, — тихо говорит она. — Я не виню тебя. Гордость одного вечера не стоит пролитой крови. Главное — ты жив. А со спесью этих господ мы ещё разберёмся.'
            else:
                $GirlTalkFamilyText = 'Сандра хмурится, глядя в сторону лестницы:<br><br>— После той стычки дом словно притих. Слишком громко прозвучало слово «бастард». Тайны прошлого тяжело удержать на замке, Стефан. Но что бы там ни болтали — ты наш.'
            end

        ! Стефан защитил девушку
        elseif $GirlTalkFamilyChoiceType = 'protect':
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = 'Аманда на секунду заминается, теребя край юбки, а затем быстро вскидывает сияющие глаза:<br><br>— Насчёт того случая в зале... Спасибо, что влез, Стефан. Я бы, конечно, и сама огрела того наглеца кувшином... но то, что ты встал за меня горой — дорогого стоит. Я это запомню.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = 'Мелисса одобрительно кивает, слегка прищурившись:<br><br>— Я видела, как ты осадил того хама в зале. Это было правильно. Когда хозяин защищает своих людей, зал уважает заведение. Ты провёл черту, за которую нельзя заступать. Молодец.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = 'Сандра тепло улыбается, смахивая слезинку с уголка глаза:<br><br>— Сегодня в зале ты показал, что мы настоящая семья, Стефан. Защитить своих девочек от пьяного сброда — поступок мужчины. У меня прямо от сердца отлегло.'
            else:
                $GirlTalkFamilyText = 'Твой поступок в зале запомнили. В доме это ценят выше любых денег.'
            end

        ! Стефан не стал вмешиваться / спустил на тормозах
        elseif $GirlTalkFamilyChoiceType = 'calm' or $GirlTalkFamilyChoiceType = 'own_choice' or $GirlTalkFamilyChoiceType = 'watch' or $GirlTalkFamilyChoiceType = 'ignore':
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = 'Аманда отводит взгляд и с горечью усмехается:<br><br>— Про тот случай... Ты промолчал и не стал связываться. Может, для трактира это и выгодно, не знаю. Но я поняла одно: если полезут снова — надеяться мне придётся только на свои ногти и зубы.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = 'Мелисса сухо смотрит на тебя, сложив руки на груди:<br><br>— Ты предпочёл остаться в стороне. Я справилась сама, мне не привыкать. Но не называй своё малодушие выдержкой, Стефан. Семья ждёт опоры, а не молчаливого зрителя.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = 'Сандра поджимает губы и качает головой:<br><br>— Не полез в драку... Может, пожалел посуду и покой в зале. Но осадок остался тяжёлый, сынок. Если хозяин опускает глаза, гости быстро садятся на шею.'
            else:
                $GirlTalkFamilyText = 'Ты не вмешался в конфликт. В доме это заметили и сделали свои выводы.'
            end

        ! Стефан взял деньги / поощрил приставания
        elseif $GirlTalkFamilyChoiceType = 'encourage' or $GirlTalkFamilyChoiceType = 'client':
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = 'Аманда сверлит взглядом пол, её пальцы сжаты в кулаки до побелевших костяшек:<br><br>— Ты взял с того урода монеты и позволил лапать меня, — в её голосе дрожит ярость. — От пьяного гостя я отобьюсь подносом. Но когда собственный брат продаёт меня за пару медяков... Куда мне теперь смотреть, Стефан? И во что верить?'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = 'Мелисса говорит ледяным тоном, обдавая тебя презрительным взглядом:<br><br>— Ты взял серебро за то, чтобы к нам распускали руки. Чистый расчёт, да? Только не удивляйся, если завтра я оценю твою долю с той же бессердечностью. Семья так не поступает.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = 'Сандра с глухим стуком опускает ладонь на стол:<br><br>— Слышала я про эти деньги, Стефан. Звон монет в кармане душу греет? А как дочерям после этого людям в глаза смотреть? Я мать. И если ты решил торговать честью девчонок — наш дом долго не простоит.'
            else:
                $GirlTalkFamilyText = 'Ты взял деньги за покладистость. В доме повисла тяжёлая, гнетущая тишина.'
            end

        ! Прочее / общее эхо
        else:
            if $GirlTalkFamilyGirl = 'amanda':
                $GirlTalkFamilyText = 'Аманда задумчиво смотрит на тебя, поправляя ворот:<br><br>— Ты после того вечера какой-то странный. Не пойму, гордиться тобой или опасаться. Семья всё замечает, Стефан. Расскажи сам, если есть что сказать.'
            elseif $GirlTalkFamilyGirl = 'melissa':
                $GirlTalkFamilyText = 'Мелисса внимательно изучает твоё выражение лица:<br><br>— Я наблюдала за тобой в зале. Пока не могу дать тебе чёткого определения: хозяин, купец или просто свидетель? Поступки значат больше слов. Дай повод уважать тебя.'
            elseif $GirlTalkFamilyGirl = 'sandra':
                $GirlTalkFamilyText = 'Сандра мягко улыбается, но во взгляде сквозит озабоченность:<br><br>— Вечер выдался непростым, сынок. Дом всё переварит, лишь бы мы держались заодно. Скажи прямо, на чьей ты стороне.'
            else:
                $GirlTalkFamilyText = 'Вспоминают, каким хозяином ты показал себя в тот вечер. Взгляды говорят красноречивее слов.'
            end
        end
    end

    killvar '$GirlTalkFamilyTextId'
    killvar '$GirlTalkFamilyChoiceType'
---