! ================================================
! FILE: modules/actions/dialogs/girl_talk_family_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! MODULE: actions/dialogs
! Тексты контекстного разговора о семье
! ================================================

#GirlTalkFamilyText
    $GirlTalkFamilyTextId = LCASE($ARGS[0])
    $GirlTalkFamilyText = ''

    if $GirlTalkFamilyGirl = '':
        $GirlTalkFamilyGirl = $TalkGirl
    end

    $GirlTalkFamilyChoiceType = $LastHallChoiceType

    if $GirlTalkFamilyChoiceType = '' and $GirlTalkFamilyGirl <> '':
        $GirlTalkFamilyChoiceType = $LastGirlChoiceType[$GirlTalkFamilyGirl]
    end

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (СЕМЕЙНЫЙ КРУГ, НАСТРОЕНИЕ, РАСКОВАННОСТЬ)
    ! ----------------------------------------------------
    if $GirlTalkFamilyTextId = 'intro':
        if $GirlTalkFamilyGirl = 'amanda':
            if $TalkReturnLoc = 'AmandaRoom' or $GirlLocation['amanda'] = 'AmandaRoom' or time = 5:
                if FamilyCorruptionStage >= 3:
                    *pl 'Аманда полулежит на кровати, скрестив стройные ножки, и лукаво щурится, скользя взглядом к твоим штанам между ног:'
                    *pl ' '
                    *pl '— Про нас? — она тихо усмехается. — Давай, спрашивай. За закрытыми дверями мы уже давно не чужие друг другу. Присаживайся.'
                    *pl ' '
                else:
                    *pl 'Аманда сидит на постели, обхватив колени руками, и поднимает на тебя взгляд:'
                    *pl ' '
                    *pl '— Про дом хочешь поговорить? — она вздыхает. — Ладно, заходи. Только без нотаций. Я и без них помню, кто у нас тут самый главный.'
                    *pl ' '
                end
            else:
                if FamilyCorruptionStage >= 3:
                    *pl 'Аманда прислоняется бедром к косяку, скрещивает руки под грудью и лукаво щурится. Её взгляд скользит по твоему телу вниз к штанам между ног:'
                    *pl ' '
                    *pl '— Про нас? — она тихо усмехается. — Давай, спрашивай. За закрытыми дверями мы уже давно не чужие друг другу. Только тише, чтобы в зале не грели уши.'
                    *pl ' '
                else:
                    *pl 'Аманда настороженно оглядывается на дверь и поправляет край фартука:'
                    *pl ' '
                    *pl '— Про дом хочешь поговорить? — она переступает с ноги на ногу. — Ладно, только не включай строгого хозяина. Я и без нотаций помню, кто у нас тут самый главный.'
                    *pl ' '
                end
            end

        elseif $GirlTalkFamilyGirl = 'melissa':
            if $TalkReturnLoc = 'MelissaRoom' or $GirlLocation['melissa'] = 'MelissaRoom' or time = 5:
                if FamilyCorruptionStage >= 3:
                    *pl 'Мелисса откладывает книгу на тумбочку, выпрямляет спину и с насмешливой полуулыбкой смотрит тебе в глаза:'
                    *pl ' '
                    *pl '— О делах семьи? — она слегка наклоняет голову. — Выкладывай. Скрывать друг от друга нам уже нечего — старые запреты мы успешно похоронили. Говори начистоту.'
                    *pl ' '
                else:
                    *pl 'Мелисса сидит у столика при свече и строго оглядывает тебя:'
                    *pl ' '
                    *pl '— Говори, Стефан. Только про наш дом, а не про кабацкие дела. Слушаю тебя.'
                    *pl ' '
                end
            else:
                if FamilyCorruptionStage >= 3:
                    *pl 'Мелисса откладывает перо, слегка наклоняет голову и с насмешливой полуулыбкой смотрит тебе прямо в глаза:'
                    *pl ' '
                    *pl '— О делах семьи? — она складывает руки на груди. — Выкладывай. Скрывать друг от друга нам уже нечего — старые запреты мы успешно похоронили. Говори начистоту, без увиливаний.'
                    *pl ' '
                else:
                    *pl 'Мелисса выпрямляет спину и строго оглядывает тебя:'
                    *pl ' '
                    *pl '— Говори. Только про наш дом, а не про кабацкие дрязги. Я предупреждала: если бардак из зала полезет наверх, мы перестанем быть семьёй. Слушаю тебя.'
                    *pl ' '
                end
            end

        elseif $GirlTalkFamilyGirl = 'sandra':
            if $TalkReturnLoc = 'SandraRoom' or $GirlLocation['sandra'] = 'SandraRoom' or time = 5:
                if FamilyCorruptionStage >= 3:
                    *pl 'Сандра сидит на кровати в тонкой ночной сорочке, открывающей пышную грудь. Её глаза теплеют, задерживаясь на твоём лице и плечах:'
                    *pl ' '
                    *pl '— О нашей семье, Стефан?.. — она мягко улыбается. — Присядь ближе. Ты теперь в этом доме и опора, и настоящий хозяин. Для тебя у меня всегда найдётся время.'
                    *pl ' '
                else:
                    *pl 'Сандра сидит на краю постели, уперев руки в колени, и оборачивается к тебе:'
                    *pl ' '
                    *pl '— Про нас поговорить пришёл? — она внимательно смотрит тебе в глаза. — Заходи, Стефан. День был нелёгкий, но для детей у меня время всегда есть. Выкладывай.'
                    *pl ' '
                end
            else:
                if FamilyCorruptionStage >= 3:
                    *pl 'Сандра вытирает ладони о полотенце, подаётся вперёд и поправляет вырез платья, обнажая пышную грудь. Её глаза теплеют, задерживаясь на твоём лице и плечах:'
                    *pl ' '
                    *pl '— О нашей семье, Стефан?.. — она мягко улыбается. — Подойди ближе. Ты теперь в этом доме и опора, и настоящий хозяин. Спрашивай, для тебя у меня всегда найдётся время.'
                    *pl ' '
                else:
                    *pl 'Сандра смахивает крошки со стола и разворачивается к тебе, сложив руки под грудью:'
                    *pl ' '
                    *pl '— Про нас поговорить пришёл? — она внимательно смотрит тебе в глаза. — Давай быстро, пока суп на плите не убежал. Для детей у меня время всегда есть. Выкладывай.'
                    *pl ' '
                end
            end

        else:
            *pl 'Разговор о доме.'
            *pl ' ' + $RealName[$GirlTalkFamilyGirl] + ' слушает внимательно — семейные узы значат больше, чем дела в зале.'
        end

    ! ----------------------------------------------------
    ! 2. ОСНОВНОЙ КОНТЕКСТ СЕМЬИ (ПОДОЗРЕНИЯ, КОРРУПЦИЯ, ДОВЕРИЕ)
    ! ----------------------------------------------------
    elseif $GirlTalkFamilyTextId = 'context':

        ! Специфические подозрения и события
        if $GirlTalkFamilyGirl = 'sandra' and SandraHomeSex = 0 and GirlSuspectsAmandaStefan['sandra'] >= 1 and SandraAmandaSuspicionTalkDone = 0 and FamilyCorruptionStage < 4:
            *pl 'Сандра откладывает кухонный нож, вытирает руки и тяжело смотрит тебе прямо в глаза:'
            *pl ' '
            *pl '— Я всё думаю про то утро, Стефан, — ровным, глухим голосом начинает она. — Вы с Амандой оба носа из комнат не казали, а половицы наверху скрипели всю ночь напролёт. Я не глухая и не слепая.'
            *pl ' '

        elseif $GirlTalkFamilyGirl = 'melissa' and MelissaHomeSex = 0 and GirlSuspectsAmandaStefan['melissa'] >= 1 and MelissaAmandaTeaseDone = 0 and FamilyCorruptionStage < 4:
            *pl 'Мелисса закрывает книгу, складывает руки на груди и пристально буравит тебя взглядом поверх очков:'
            *pl ' '
            *pl '— Мы сейчас не о выручке говорим, — сухо отчеканивает она. — Даже не пытайся делать вид, будто между тобой и Амандой всё по-прежнему. Я не дура и в сказочки про братскую нежность не верю.'
            *pl ' '

        elseif $GirlTalkFamilyGirl = 'amanda' and AmandaFirstSexMorningShown = 1 and AmandaFirstSexAmandaWorryTalkDone = 0 and FamilyCorruptionStage < 4:
            *pl 'Аманда нервно теребит край передника, покусывая нижнюю губу и не поднимая на тебя глаз:'
            *pl ' '
            *pl '— Про нас... — шепчет она, косясь на лестницу. — Мама смотрит волком, явно что-то почуяла. А Мелисса сверлит взглядом так, будто уже всё поняла, просто выжидает удобный момент.'
            *pl ' '

        ! Высокая коррупция: старые рамки сломаны, семья живёт по своим правилам
        elseif FamilyCorruptionStage >= 4:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда тихо посмеивается, подходит вплотную и смело кладёт ладонь на твою грудь, заглядывая снизу вверх:'
                *pl ' '
                *pl '— Мы стали совсем другими, Стефан, — её глаза блестят. — За общим столом все сидят чинно, а под скатертью наши колени соприкасаются. Мама ловит твои взгляды, Мелисса следит за каждым твоим вздохом...'
                *pl ' '
                *pl 'Стыд выветрился без следа. Осталась чистая страсть и наш общий секрет. Мы держимся друг за друга крепче, чем любые праведники в этом городе.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса спокойно барабанит пальцами по конторке, оглядывая тебя с насмешливой уверенностью:'
                *pl ' '
                *pl '— Прежние предрассудки развеялись, — ровно констатирует она. — Городские ханжи с ума сошли бы, узнай они, что творится под нашей крышей. Но в этом есть железная логика: нас больше ничем нельзя расколоть.'
                *pl ' '
                *pl 'Мы повязаны одной тайной. Главное — держи невозмутимое лицо перед чужаками в зале. Остальное остаётся только нашим.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра глубоко вздыхает, но на её лице нет печали — лишь зрелая, тёплая улыбка. Она касается твоей щеки ладонью:'
                *pl ' '
                *pl '— Мы перешагнули черту, сынок, — тихо говорит она. — Раньше я боялась гнева Ильматера, а теперь вижу: наш дом выстоял.'
                *pl ' '
                *pl 'Ты взял на себя всё — и заботу, и мужскую силу. Я твоя мать, но я же и твоя женщина. И пока мы делим хлеб, постель и кров без обмана — никто нас не сломает.'
                *pl ' '
            else:
                *pl 'В доме старые запреты давно развеялись. Разговор идёт без оглядки на чужую мораль — здесь каждый знает цену общей тайне.'
                *pl ' '
            end

        ! Средняя коррупция: трещины в морали, зарождение запретного
        elseif FamilyCorruptionStage >= 2:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда вздыхает, поправляя косу, и бросает на тебя смущённый, но пытливый взгляд:'
                *pl ' '
                *pl '— Раньше мы просто ужинали и расходились спать, — тихо говорит она. — А теперь за столом воздух прямо искрит. Кто-то шутит двусмысленно, кто-то молчит так, что мороз по коже.'
                *pl ' '
                *pl 'Я не знаю, куда это всё приведёт. Но если честно... мне уже не хочется возвращаться к старым порядкам. С тобой всё стало иначе.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса смотрит прямо, скрестив руки на груди:'
                *pl ' '
                *pl '— Мы ещё держим внешние приличия, — сухо произносит она. — Но границы трещат по швам. Все видят, какими взглядами мы обмениваемся за ужином.'
                *pl ' '
                *pl 'Я считаю доходы, но считаю и то, как быстро меняются наши роли. Ты хозяин, Стефан. Смотри, куда ведёшь наш дом.'
                *pl ' '
                if PlayerKnows_SandraDraupnirFriday = 0 and SandraCarpenterSecret = 0:
                    *pl '— И ещё кое-что про нашу матушку, — Мелисса иронично вскидывает бровь. — По пятницам вечером она зачастила в Квартал ремесленников к столяру Драупниру. Видимо, дуб в его мастерской требует особого присмотра... Сходил бы ты проведал её как-нибудь в пятничный вечер.'
                    *pl ' '
                    SandraDraupnirHintGossip = 1
                end
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра нервно поправляет фартук, глядя в сторону:'
                *pl ' '
                *pl '— Неспокойно мне, Стефан, — в голосе сквозит волнение. — Девчонки выросли, смотрят на тебя совсем не как на брата. Да и в моих мыслях появилось то, от чего следовало бы расшибить лоб в храме Ильматера.'
                *pl ' '
                *pl 'Мы ходим по краю. Береги девчонок, сынок. И себя береги.'
                *pl ' '
            else:
                *pl 'Прежние правила в доме дают трещину. Разговор идёт осторожно — каждый прощупывает почву, боясь задеть запретную тему.'
                *pl ' '
            end

        ! Высокое напряжение: ссоры, обиды, недоверие
        elseif FamilyTension > FamilyTrust + 15:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда кривит губы и с вызовом смотрит на тебя:'
                *pl ' '
                *pl '— Ты спрашиваешь про дом? — она цедит слова сквозь зубы. — А у нас тут обстановка, как перед поножовщиной в зале.'
                *pl ' '
                *pl 'Все улыбаются сквозь зубы, а в кулаке держат камень. Хватит отмалчиваться, Стефан. Говори прямо, что на уме, иначе я сама скажу — и тебе это сильно не понравится.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса резко захлопывает гроссбух, её пальцы сжаты в кулаки:'
                *pl ' '
                *pl '— В доме все на взводе, — холодно констатирует она. — Мы либо сядем и разберёмся без криков, либо дом развалится на куски. Я устала гадать по твоим вздохам и косым взглядам. Нужна правда. Не дашь её — я начну наводить порядок своими методами.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра роняет ложку на стол с глухим стуком:'
                *pl ' '
                *pl '— Все злые как собаки, — горько говорит она. — Половица скрипнет — уже искры летят. За столом едим молча, словно чужие люди. Стефан, ты глава дома! Сделай что-нибудь, пока мы окончательно не перегрызлись.'
                *pl ' '
            else:
                *pl 'В доме обстановка накалена до предела. Любое неосторожное слово может обернуться скандалом.'
                *pl ' '
            end

        ! Высокое доверие: теплота, сплочённость
        elseif FamilyTrust > FamilyTension + 20:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда искренне улыбается, чуть склонив голову к плечу:'
                *pl ' '
                *pl '— Знаешь, Стефан... — мягко начинает она. — Здорово, когда можно просто поговорить и не ждать подвоха. Я всё та же заноза, конечно, но рядом с тобой мне спокойно. Спасибо, что ты за нас стоишь горой.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Уголок губ Мелиссы слегка приподнимается в редкой улыбке:'
                *pl ' '
                *pl '— Пока мы умеем слушать друг друга — мы выстоим, — спокойно замечает она. — Я много критикую, знаю. Но это потому, что мне не всё равно. Ты делаешь правильные шаги, Стефан. Семья это чувствует.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра с облегчением выдыхает, и с её лица сходит привычная усталость:'
                *pl ' '
                *pl '— Вот так и должно быть, — она кивает с одобрением. — Когда в семье правда и опора, никакой шторм снаружи не страшен. Ты взрослеешь, Стефан. Не годами, а поступками. Мне на душе спокойнее за девчонок, когда ты рядом.'
                *pl ' '
            else:
                *pl 'В семье царит редкое согласие. Беседа течёт легко и доверительно.'
                *pl ' '
            end

        ! Обычное состояние дома
        else:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда пожимает плечами, глядя в окно:'
                *pl ' '
                *pl '— Комнаты тесные, забот выше крыши, — она усмехается. — Иногда хочется хлопнуть дверью и сбежать на край света. А потом подумаешь: кому я там нужна? Здесь хоть свой угол. Главное — не ссориться по пустякам.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса поправляет бумаги на столе:'
                *pl ' '
                *pl '— Обычные будни, — сухо отзывается она. — Работаем, считаем медяки, латаем дыры в бюджете. Главное — держать строй и не давать слабину перед чужаками в зале.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра помешивает варево в котле:'
                *pl ' '
                *pl '— Живём потихоньку, сынок. Девчонки при деле, на плите кипит, крыша не течёт. Слава Ильматеру, пока справляемся. Ты за залом приглядывай, а я дом удержу.'
                *pl ' '
            else:
                *pl 'Спокойный разговор о домашних заботах — без лишних страстей и потрясений.'
                *pl ' '
            end
        end

    ! ----------------------------------------------------
    ! 3. РЕАКЦИИ НА ВЫБОР В ЗАЛЕ (ПОСЛЕДСТВИЯ И ВПЕЧАТЛЕНИЯ)
    ! ----------------------------------------------------
    elseif $GirlTalkFamilyTextId = 'hall_hook':

        ! Стычка с дворянином
        if $LastHallChoiceEvent = 'noble_attack' and $GirlTalkFamilyGirl = 'sandra':
            if $GirlTalkFamilyChoiceType = 'sandra_shield':
                *pl 'Сандра говорит тихо, опустив глаза на свои натруженные ладони:'
                *pl ' '
                *pl '— Не хотела я, чтобы ты видел меня такой, Стефан. Мать, закрывающая сына от клинка... Но иначе я поступить не могла. Он назвал тебя бастардом на весь зал. Семья это услышала. Я встала между вами, потому что без тебя наш дом обратится в пепел.'
                *pl ' '
            elseif $GirlTalkFamilyChoiceType = 'yield':
                *pl 'Сандра мягко касается твоего плеча, в её глазах сочувствие:'
                *pl ' '
                *pl '— Ты уступил, чтобы сберечь жизни, — тихо говорит она. — Я не виню тебя. Гордость одного вечера не стоит пролитой крови. Главное — ты жив. А со спесью этих господ мы ещё разберёмся.'
                *pl ' '
            else:
                *pl 'Сандра хмурится, глядя в сторону лестницы:'
                *pl ' '
                *pl '— После той стычки дом словно притих. Слишком громко прозвучало слово «бастард». Тайны прошлого тяжело удержать на замке, Стефан. Но что бы там ни болтали — ты наш.'
                *pl ' '
            end

        ! Стефан защитил девушку
        elseif $GirlTalkFamilyChoiceType = 'protect':
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда на секунду заминается, теребя край юбки, а затем быстро вскидывает сияющие глаза:'
                *pl ' '
                *pl '— Насчёт того случая в зале... Спасибо, что влез, Стефан. Я бы, конечно, и сама огрела того наглеца кувшином... но то, что ты встал за меня горой — дорогого стоит. Я это запомню.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса одобрительно кивает, слегка прищурившись:'
                *pl ' '
                *pl '— Я видела, как ты осадил того хама в зале. Это было правильно. Когда хозяин защищает своих людей, зал уважает заведение. Ты провёл черту, за которую нельзя заступать. Молодец.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра тепло улыбается, смахивая слезинку с уголка глаза:'
                *pl ' '
                *pl '— Сегодня в зале ты показал, что мы настоящая семья, Стефан. Защитить своих девочек от пьяного сброда — поступок мужчины. У меня прямо от сердца отлегло.'
                *pl ' '
            else:
                *pl 'Твой поступок в зале запомнили. В доме это ценят выше любых денег.'
                *pl ' '
            end

        ! Стефан не стал вмешиваться / спустил на тормозах
        elseif $GirlTalkFamilyChoiceType = 'calm' or $GirlTalkFamilyChoiceType = 'own_choice' or $GirlTalkFamilyChoiceType = 'watch' or $GirlTalkFamilyChoiceType = 'ignore':
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда отводит взгляд и с горечью усмехается:'
                *pl ' '
                *pl '— Про тот случай... Ты промолчал и не стал связываться. Может, для трактира это и выгодно, не знаю. Но я поняла одно: если полезут снова — надеяться мне придётся только на свои ногти и зубы.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса сухо смотрит на тебя, сложив руки на груди:'
                *pl ' '
                *pl '— Ты предпочёл остаться в стороне. Я справилась сама, мне не привыкать. Но не называй своё малодушие выдержкой, Стефан. Семья ждёт опоры, а не молчаливого зрителя.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра поджимает губы и качает головой:'
                *pl ' '
                *pl '— Не полез в драку... Может, пожалел посуду и покой в зале. Но осадок остался тяжёлый, сынок. Если хозяин опускает глаза, гости быстро садятся на шею.'
                *pl ' '
            else:
                *pl 'Ты не вмешался в конфликт. В доме это заметили и сделали свои выводы.'
                *pl ' '
            end

        ! Стефан взял деньги / поощрил приставания
        elseif $GirlTalkFamilyChoiceType = 'encourage' or $GirlTalkFamilyChoiceType = 'client':
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда сверлит взглядом пол, её пальцы сжаты в кулаки до побелевших костяшек:'
                *pl ' '
                *pl '— Ты взял с того урода монеты и позволил лапать меня, — в её голосе дрожит ярость. — От пьяного гостя я отобьюсь подносом. Но когда собственный брат продаёт меня за пару медяков... Куда мне теперь смотреть, Стефан? И во что верить?'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса говорит ледяным тоном, обдавая тебя презрительным взглядом:'
                *pl ' '
                *pl '— Ты взял серебро за то, чтобы к нам распускали руки. Чистый расчёт, да? Только не удивляйся, если завтра я оценю твою долю с той же бессердечностью. Семья так не поступает.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра с глухим стуком опускает ладонь на стол:'
                *pl ' '
                *pl '— Слышала я про эти деньги, Стефан. Звон монет в кармане душу греет? А как дочерям после этого людям в глаза смотреть? Я мать. И если ты решил торговать честью девчонок — наш дом долго не простоит.'
                *pl ' '
            else:
                *pl 'Ты взял деньги за покладистость. В доме повисла тяжёлая, гнетущая тишина.'
                *pl ' '
            end

        ! Прочее / общее эхо
        else:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда задумчиво смотрит на тебя, поправляя ворот:'
                *pl ' '
                *pl '— Ты после того вечера какой-то странный. Не пойму, гордиться тобой или опасаться. Семья всё замечает, Стефан. Расскажи сам, если есть что сказать.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса внимательно изучает твоё выражение лица:'
                *pl ' '
                *pl '— Я наблюдала за тобой в зале. Пока не могу дать тебе чёткого определения: хозяин, купец или просто свидетель? Поступки значат больше слов. Дай повод уважать тебя.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра мягко улыбается, но во взгляде сквозит озабоченность:'
                *pl ' '
                *pl '— Вечер выдался непростым, сынок. Дом всё переварит, лишь бы мы держались заодно. Скажи прямо, на чьей ты стороне.'
                *pl ' '
            else:
                *pl 'Вспоминают, каким хозяином ты показал себя в тот вечер. Взгляды говорят красноречивее слов.'
                *pl ' '
            end
        end
    end

    killvar '$GirlTalkFamilyTextId'
    killvar '$GirlTalkFamilyChoiceType'
---