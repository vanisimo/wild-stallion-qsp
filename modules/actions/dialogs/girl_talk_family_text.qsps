! ================================================
! FILE: modules/actions/dialogs/girl_talk_family_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.11.2026
! MODULE: actions/dialogs
! Тексты контекстного разговора о семье
! ================================================

#GirlTalkFamilyText
    $GirlTalkFamilyTextId = LCASE($ARGS[0])
    $GirlTalkFamilyText = ''

    if $GirlTalkFamilyGirl = '':
        $GirlTalkFamilyGirl = $TalkGirl
    end

    $GirlTalkFamilyChoiceType = $LastHallChoiceType

    if $GirlTalkFamilyChoiceType = '' and $GirlTalkFamilyGirl <> '':
        $GirlTalkFamilyChoiceType = $LastGirlChoiceType[$GirlTalkFamilyGirl]
    end

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (СЕМЕЙНЫЙ КРУГ, НАСТРОЕНИЕ, РАСКОВАННОСТЬ)
    ! ----------------------------------------------------
    if $GirlTalkFamilyTextId = 'intro':
        if $GirlTalkFamilyGirl = 'amanda':
            if $TalkReturnLoc = 'AmandaRoom' or $GirlLocation['amanda'] = 'AmandaRoom' or time = 5:
                if FamilyCorruptionStage >= 3:
                    *pl 'Аманда лениво перекатывается на кровати, подпирает голову ладонью и ведёт носком босой ноги по одеялу. Взгляд скользит вниз, к твоему ремню, и она усмехается:'
                    *pl ' '
                    *pl '— Про нас? — она похлопывает ладонью по покрывалу рядом с собой. — Садись. За закрытыми дверями мы уже давно не чужие друг другу. Спрашивай.'
                    *pl ' '
                else:
                    *pl 'Аманда сидит на постели, обхватив колени руками. Она коротко вздыхает и поднимает на тебя настороженный взгляд:'
                    *pl ' '
                    *pl '— Про дом хочешь поговорить? — она кивает на стул. — Ладно, заходи. Только без нотаций. Я и без них помню, кто у нас тут самый главный.'
                    *pl ' '
                end
            else:
                if FamilyCorruptionStage >= 3:
                    *pl 'Аманда прислоняется бедром к косяку, скрещивает руки под грудью. Её взгляд медленно сползает по твоей рубахе к пряжке ремня, и она лукаво щурится:'
                    *pl ' '
                    *pl '— Про нас? — она понижает голос до шёпота. — Давай, спрашивай. За закрытыми дверями мы уже давно не чужие друг другу. Только тише, чтобы в зале не грели уши.'
                    *pl ' '
                else:
                    *pl 'Аманда настороженно оглядывается на дверь и поправляет край фартука. Переступает с ноги на ногу:'
                    *pl ' '
                    *pl '— Про дом хочешь поговорить? — она вздыхает. — Ладно, только не включай строгого хозяина. Я и без нотаций помню, кто у нас тут самый главный.'
                    *pl ' '
                end
            end

        elseif $GirlTalkFamilyGirl = 'melissa':
            if $TalkReturnLoc = 'MelissaRoom' or $GirlLocation['melissa'] = 'MelissaRoom' or time = 5:
                if FamilyCorruptionStage >= 3:
                    *pl 'Мелисса захлопывает книгу, кладёт её на тумбочку и выпрямляет спину. Смотрит тебе в глаза с насмешливой полуулыбкой, чуть наклоняя голову:'
                    *pl ' '
                    *pl '— О делах семьи? — она проводит пальцем по корешку книги. — Выкладывай. Скрывать друг от друга нам уже нечего — старые запреты мы успешно похоронили. Говори начистоту.'
                    *pl ' '
                else:
                    *pl 'Мелисса сидит у столика при свече. Она отрывается от книги и строго оглядывает тебя поверх страницы:'
                    *pl ' '
                    *pl '— Говори, Стефан. Только про наш дом, а не про трактирные дела. Слушаю тебя.'
                    *pl ' '
                end
            else:
                if FamilyCorruptionStage >= 3:
                    *pl 'Мелисса откладывает перо и поворачивается к тебе всем корпусом. С насмешливой полуулыбкой она смотрит прямо в глаза:'
                    *pl ' '
                    *pl '— О делах семьи? — она складывает руки на груди. — Выкладывай. Скрывать друг от друга нам уже нечего — старые запреты мы успешно похоронили. Говори начистоту, без увиливаний.'
                    *pl ' '
                else:
                    *pl 'Мелисса выпрямляет спину и строго оглядывает тебя, сжав губы:'
                    *pl ' '
                    *pl '— Говори. Только про наш дом, а не про трактир. Я предупреждала: если бардак из зала полезет наверх, мы перестанем быть семьёй. Слушаю тебя.'
                    *pl ' '
                end
            end

        elseif $GirlTalkFamilyGirl = 'sandra':
            if $TalkReturnLoc = 'SandraRoom' or $GirlLocation['sandra'] = 'SandraRoom' or time = 5:
                if FamilyCorruptionStage >= 3:
                    *pl 'Сандра сидит на кровати в тонкой ночной сорочке. Она подбирает под себя ногу и жестом зовёт тебя ближе. Взгляд теплеет, задерживаясь на твоём лице и плечах:'
                    *pl ' '
                    *pl '— О нашей семье, Стефан?.. — она мягко улыбается. — Присядь ближе. Ты теперь в этом доме и опора, и настоящий хозяин. Для тебя у меня всегда найдётся время.'
                    *pl ' '
                else:
                    *pl 'Сандра сидит на краю постели, уперев руки в колени. Она оборачивается к тебе и внимательно смотрит в глаза:'
                    *pl ' '
                    *pl '— Про нас поговорить пришёл? — она кивает на стул. — Заходи, Стефан. День был нелёгкий, но для детей у меня время всегда есть. Выкладывай.'
                    *pl ' '
                end
            else:
                if FamilyCorruptionStage >= 3:
                    *pl 'Сандра вытирает ладони о полотенце, подаётся вперёд и поправляет вырез платья. Её взгляд теплеет, скользя по твоему лицу и плечам:'
                    *pl ' '
                    *pl '— О нашей семье, Стефан?.. — она мягко улыбается. — Подойди ближе. Ты теперь в этом доме и опора, и настоящий хозяин. Спрашивай, для тебя у меня всегда найдётся время.'
                    *pl ' '
                else:
                    *pl 'Сандра смахивает крошки со стола и разворачивается к тебе, сложив руки под грудью. Внимательно смотрит в глаза:'
                    *pl ' '
                    *pl '— Про нас поговорить пришёл? — она кивает на лавку. — Давай быстро, пока суп на плите не убежал. Для детей у меня время всегда есть. Выкладывай.'
                    *pl ' '
                end
            end

        else:
            *pl 'Разговор о доме.'
            *pl ' ' + $RealName[$GirlTalkFamilyGirl] + ' слушает внимательно — семейные узы значат больше, чем дела в зале.'
        end

        ! ----------------------------------------------------
        ! 2. ОСНОВНОЙ КОНТЕКСТ СЕМЬИ (ПОДОЗРЕНИЯ, КОРРУПЦИЯ, ДОВЕРИЕ)
        ! ----------------------------------------------------
    elseif $GirlTalkFamilyTextId = 'context':

        ! Специфические подозрения и события
        if $GirlTalkFamilyGirl = 'sandra' and SandraHomeSex = 0 and GirlSuspectsAmandaStefan['sandra'] >= 1 and SandraAmandaSuspicionTalkDone = 0 and FamilyCorruptionStage < 4:
            *pl 'Сандра откладывает кухонный нож, вытирает руки и тяжело смотрит тебе прямо в глаза:'
            *pl ' '
            *pl '— Я всё думаю про то утро, Стефан, — ровным, глухим голосом начинает она. — Вы с Амандой оба носа из комнат не казали, а половицы наверху скрипели всю ночь напролёт. Я не глухая и не слепая.'
            *pl ' '
            *pl '— Мам, ну скрипели и скрипели. Дом старый, — ты разводишь руками. — Может, крысы.'
            *pl ' '
            *pl '— Крысы у нас в подполе, — она поджимает губы. — А наверху, сынок, другие звери шалят. Ты мне зубы не заговаривай. Я твою породу знаю: весь в отца — тот тоже умел сказки плести.'
            *pl ' '

        elseif $GirlTalkFamilyGirl = 'melissa' and MelissaHomeSex = 0 and GirlSuspectsAmandaStefan['melissa'] >= 1 and MelissaAmandaTeaseDone = 0 and FamilyCorruptionStage < 4:
            *pl 'Мелисса закрывает книгу, складывает руки на груди и пристально буравит тебя взглядом поверх очков:'
            *pl ' '
            *pl '— Мы сейчас не о выручке говорим, — сухо отчеканивает она. — Даже не пытайся делать вид, будто между тобой и Амандой всё по-прежнему. Я не дура и в сказочки про братскую нежность не верю.'
            *pl ' '
            *pl '— Мелисса, у тебя от этих романов уже в голове одни непристойности, — хмыкаешь ты. — Может, тебе про осаду крепости почитать?'
            *pl ' '
            *pl '— Осаду крепости я как раз и наблюдаю, — она прищуривается. — Только вот крепость — наша сестра, а осаждающий — ты. И не надо делать из меня дуру, Стефан. Я по глазам вижу, кто ночью к кому ходит.'
            *pl ' '

        elseif $GirlTalkFamilyGirl = 'amanda' and AmandaFirstSexMorningShown = 1 and AmandaFirstSexAmandaWorryTalkDone = 0 and FamilyCorruptionStage < 4:
            *pl 'Аманда нервно теребит край передника, покусывая нижнюю губу и не поднимая на тебя глаз:'
            *pl ' '
            *pl '— Про нас... — шепчет она, косясь на лестницу. — Мама смотрит волком, явно что-то почуяла. А Мелисса сверлит взглядом так, будто уже всё поняла, просто выжидает удобный момент.'
            *pl ' '
            *pl '— Не трясись, — ты кладёшь руку ей на плечо. — Пока мы сами не признаемся, у них только догадки. А догадки к делу не пришьёшь.'
            *pl ' '
            *pl '— А если мама спросит в лоб? — Аманда вскидывает на тебя испуганные глаза. — Я же не смогу ей врать, у меня всё на лице написано!'
            *pl ' '

        ! Высокая коррупция: старые рамки сломаны, семья живёт по своим правилам
        elseif FamilyCorruptionStage >= 4:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда подходит почти вплотную, кладёт ладонь тебе на грудь и заглядывает снизу вверх с весёлым бесстыдством.'
                *pl ' '
                *pl '— Знаешь, что мне нравится? — она чуть сжимает пальцы. — Сидим днём за столом, все такие правильные: мать раскладывает салфетки, Мелисса носом в книгу, я подаю похлёбку. А под скатертью колени уже трутся, взгляды горят — и никто, никто больше не делает невинных глаз.'
                *pl ' '
                *pl '— И что, всех всё устраивает? — ты ухмыляешься.'
                *pl ' '
                *pl '— Ещё как! — она фыркает. — Три бабы в доме — один член. Делим честно, по очереди, по настроению. Я, конечно, громче всех — сам знаешь. Мелисса поначалу шипела, мол, тише, а теперь сама стонет так, что мне кажется я с вами кончаю. А если ты допоздна застрял — не пропадать же добру. У Бекки в лавке огурцы крепкие, а у мамы в сундуке такие штуки — закачаешься.'
                *pl ' '
                *pl '— Главное, чтобы гостям в похлёбку не попало, — ты подмигиваешь.'
                *pl ' '
                *pl '— Ой, да ладно! — Аманда хохочет и легонько толкает тебя в плечо. — Скажи ещё, что сам ни разу не подглядывал, когда мы с Мелиссой без тебя развлекаемся.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса барабанит пальцами по стопке бумаг. На губах — усмешка.'
                *pl ' '
                *pl '— Старые предрассудки умерли, Стефан, — она чеканит слова, ровно . — Если бы сплетники узнали, что творится под нашей крышей, они бы языки себе стёрли до корней. Но система работает безупречно.'
                *pl ' '
                *pl '— Система? — ты приподнимаешь бровь. — Ты про нас с тобой или про всю семью разом?'
                *pl ' '
                *pl '— Про всех, — она загибает пальцы. — Я прекрасно слышу, как ты трахаешь Аманду — она визжит так, что слышно в погребе. Я знаю, что ты ходишь по ночам трахать маму — и, видит Ильматер, я не осуждаю. Я сама беру свою долю и стону под тобой не хуже сестры.'
                *pl ' '
                *pl '— И что, никакой ревности? — ты усмехаешься, опираясь локтем на конторку.'
                *pl ' '
                *pl '— Ревность — удел тех, кто не уверен в своём месте, — Мелисса двигает бедром. — Моё место — здесь, с тобой, с ними. Главное — держать  лицо, когда в зал входит гость. А под столом в этот момент... ну, ты сам знаешь, что там может быть.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра подходит неторопливо, кладёт тёплую ладонь тебе на плечо и заглядывает в глаза — спокойно, без тени стеснения. Её большой палец мягко гладит ткань рубахи.'
                *pl ' '
                *pl '— Мы перешагнули черту, сын, — говорит она негромко. — И я больше не оглядываюсь на чужое мнение. Дом от этого стал только крепче. Ты взял на себя не только трактир — ты взял нас, всех, без остатка.'
                *pl ' '
                *pl '— Справляюсь? — ты кладёшь ладонь на ее грудь.'
                *pl ' '
                *pl '— Ещё как, — Сандра улыбается краешком губ. — Девчонки после твоего члена ходят довольные, перестали грызться из-за ерунды. А я... — она делает короткую паузу, — я твоя мать, Стефан. Но я и твоя горячая женщина. Ты приходишь ко мне ночью, и я принимаю тебя охотно. Пока мы делим кров, постель честно, без утайки — никакой шторм снаружи нам не страшен.'
                *pl ' '
                *pl '— Даже если соседи начнут шептаться?'
                *pl ' '
                *pl '— Пусть шепчутся, — она пожимает плечами. — Их шёпот не сделает моих дочерей счастливее. А твой член — делает. Всё просто.'
                *pl ' '
            else:
                *pl 'В доме старые запреты давно развеялись. Разговор идёт без оглядки на чужую мораль — здесь каждый знает цену общей тайне.'
                *pl ' '
            end

        ! Средняя коррупция: трещины в морали, зарождение запретного
        elseif FamilyCorruptionStage >= 2:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда вздыхает, поправляя косу, и бросает на тебя смущённый, но пытливый взгляд:'
                *pl ' '
                *pl '— Раньше мы просто ужинали и расходились спать, — тихо говорит она. — А теперь за столом воздух прямо искрит. Кто-то шутит двусмысленно, кто-то молчит так, что мурашки.'
                *pl ' '
                *pl '— И кто же у нас мастер двусмысленных шуток? — ты приподнимаешь бровь. — Уж не ты ли?'
                *pl ' '
                *pl '— Может, и я, — она смущённо улыбается. — Я не знаю, куда это всё приведёт. Но если честно... мне уже не хочется возвращаться к старым порядкам. С тобой всё стало иначе.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса смотрит прямо, скрестив руки на груди:'
                *pl ' '
                *pl '— Мы ещё держим внешние приличия, —  произносит она. — Но только внешние, люди видят наши взгляды друг на друга.'
                *pl ' '
                *pl '— А ты, как всегда, всё видишь первой, — ты усмехаешься. — И что же ты видишь, сестрёнка?'
                *pl ' '
                *pl '— Я считаю прибыль, но считаю и то, как быстро меняются наши отношения, — она не отводит взгляд. — Ты хозяин, Стефан. Смотри, куда ведёшь наш дом.'
                *pl ' '
                if PlayerKnows_SandraDraupnirFriday = 0 and SandraCarpenterSecret = 0:
                    *pl '— И ещё кое-что про нашу матушку, — Мелисса иронично вскидывает бровь. — По пятницам вечером она зачастила в Квартал ремесленников к столяру Драупниру. Видимо, "дуб" в его мастерской требует особого присмотра... Сходил бы ты проведал её как-нибудь в пятничный вечер.'
                    *pl ' '
                    SandraDraupnirHintGossip = 1
                end
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра поправляет фартук, глядя на тебя открытым, тёплым взглядом:'
                *pl ' '
                *pl '— Время летит, Стефан, — негромко говорит она. — Девчонки выросли, налились соком, смотрят на тебя совсем не как на брата. Да и в моих мыслях появилось то, от чего кровь по жилам бежит горячее.'
                *pl ' '
                *pl '— Мам, ты меня смущаешь, — ты покашливаешь, но ухмылку не прячешь. — Я, конечно, парень видный, но чтобы настолько...'
                *pl ' '
                *pl '— Не паясничай, — она улыбается. — На нашем фронтире семья должна держаться за своё. Береги девчонок, сынок. И будь для нас настоящей опорой.'
                *pl ' '
            else:
                *pl 'Прежние правила в доме дают трещину. Разговор идёт осторожно — каждый прощупывает почву, боясь задеть запретную тему.'
                *pl ' '
            end

            ! Высокое напряжение: ссоры, обиды, недоверие
        elseif FamilyTension > FamilyTrust + 15:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда кривит губы и с вызовом смотрит на тебя:'
                *pl ' '
                *pl '— Ты спрашиваешь про дом? — она цедит слова сквозь зубы. — А у нас тут обстановка, как перед поножовщиной в зале.'
                *pl ' '
                *pl '— Аманда, давай без этих твоих... — ты морщишься.'
                *pl ' '
                *pl '— Без чего? Без правды? — она резко подаётся вперёд. — Все улыбаются сквозь зубы, а в кулаке держат камень. Хватит отмалчиваться, Стефан. Говори прямо, что на уме, иначе я сама скажу — и тебе это сильно не понравится.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса резко захлопывает гроссбух, её пальцы сжаты в кулаки:'
                *pl ' '
                *pl '— В доме все на взводе, — холодно констатирует она. — Мы либо сядем и разберёмся без криков, либо дом развалится на куски.'
                *pl ' '
                *pl '— И что ты предлагаешь? — ты скрещиваешь руки. — Семейный совет с графиком и повесткой?'
                *pl ' '
                *pl '— А хоть бы и так! — она вскидывает подбородок. — Я устала гадать по твоим вздохам и косым взглядам. Нужна правда. Не дашь её — я начну наводить порядок своими методами.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра роняет ложку на стол с глухим стуком:'
                *pl ' '
                *pl '— Все злые как собаки, — горько говорит она. — Половица скрипнет — уже искры летят. За столом едим молча, словно чужие люди.'
                *pl ' '
                *pl '— Мам, я разберусь, — ты поднимаешь ладонь. — Дай мне время.'
                *pl ' '
                *pl '— Время у тебя было, — она качает головой. — Стефан, ты глава дома! Сделай что-нибудь, пока мы окончательно не перегрызлись.'
                *pl ' '
            else:
                *pl 'В доме обстановка накалена до предела. Любое неосторожное слово может обернуться скандалом.'
                *pl ' '
            end

            ! Высокое доверие: теплота, сплочённость
        elseif FamilyTrust > FamilyTension + 20:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда искренне улыбается, чуть склонив голову к плечу:'
                *pl ' '
                *pl '— Знаешь, Стефан... — мягко начинает она. — Здорово, когда можно просто поговорить и не ждать подвоха. Я всё та же заноза, конечно, но рядом с тобой мне спокойно. Спасибо, что ты за нас стоишь горой.'
                *pl ' '
                *pl '— Да ладно тебе, — ты отмахиваешься, но улыбку не прячешь. — Кто-то же должен держать вас в узде.'
                *pl ' '
                *pl '— В узде? — она фыркает. — Скорее уж в тепле и сытости. И это, знаешь ли, куда приятнее.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Уголок губ Мелиссы слегка приподнимается в редкой улыбке:'
                *pl ' '
                *pl '— Пока мы умеем слушать друг друга — мы выстоим, — спокойно замечает она. — Я много критикую, знаю. Но это потому, что мне не всё равно. Ты делаешь правильные шаги, Стефан. Семья это чувствует.'
                *pl ' '
                *pl '— Мелисса, ты сейчас сделала мне комплимент? — ты притворно хватаешься за сердце. — Ильматер, кажется, я дожил до этого дня.'
                *pl ' '
                *pl '— Не обольщайся, — она закатывает глаза. — Просто констатирую факт. И не проси повторить.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра с облегчением выдыхает, и с её лица сходит привычная усталость:'
                *pl ' '
                *pl '— Вот так и должно быть, — она кивает с одобрением. — Когда в семье правда и опора, никакой шторм снаружи не страшен. Ты взрослеешь, Стефан. Не годами, а поступками. Мне на душе спокойнее за девчонок, когда ты рядом.'
                *pl ' '
                *pl '— Стараюсь, мам, — ты пожимаешь плечами. — Ты же сама меня учила: дом держится на хозяине.'
                *pl ' '
                *pl '— Учила, — она улыбается. — И рада, что ты наконец-то начал слушать.'
                *pl ' '
            else:
                *pl 'В семье царит редкое согласие. Беседа течёт легко и доверительно.'
                *pl ' '
            end

            ! Обычное состояние дома
        else:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда пожимает плечами, глядя в окно:'
                *pl ' '
                *pl '— Комнаты тесные, забот выше крыши, — она усмехается. — Иногда хочется хлопнуть дверью и сбежать на край света. А потом подумаешь: кому я там нужна? Здесь хоть свой угол. Главное — не ссориться по пустякам.'
                *pl ' '
                *pl '— Ну, если сбежишь, кто будет у меня спринтрии из карманов тырить? — ты подмигиваешь.'
                *pl ' '
                *pl '— Я не тырю! — она возмущённо пихает тебя в плечо. — Я беру честную долю за страдания рядом с таким братцем.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса поправляет бумаги на столе:'
                *pl ' '
                *pl '— Обычные будни, — сухо отзывается она. — Работаем, считаем монеты, латаем дыры в бюджете. Главное — держать строй и не давать слабину перед чужаками в зале.'
                *pl ' '
                *pl '— Скучно живёшь, сестрёнка, — ты хмыкаешь. — Одни цифры да бумаги.'
                *pl ' '
                *pl '— Зато благодаря этим цифрам у тебя есть крыша над головой, — она бросает на тебя колкий взгляд. — И не надо морщиться: кто-то должен быть в этой семье ответственным.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра помешивает варево в котле:'
                *pl ' '
                *pl '— Живём потихоньку, сынок. Девчонки при деле, на плите кипит, крыша не течёт. Слава Ильматеру, пока справляемся. Ты за залом приглядывай, а я дом удержу.'
                *pl ' '
                *pl '— Мам, ты как скала, — ты прислоняешься к косяку. — Без тебя тут всё бы давно развалилось.'
                *pl ' '
                *pl '— Не подлизывайся, — она усмехается. — Лучше скажи, как там в зале: буянов нет?'
                *pl ' '
            else:
                *pl 'Спокойный разговор о домашних заботах — без лишних страстей и потрясений.'
                *pl ' '
            end
        end

        ! ----------------------------------------------------
        ! 3. РЕАКЦИИ НА ВЫБОР В ЗАЛЕ (ПОСЛЕДСТВИЯ И ВПЕЧАТЛЕНИЯ)
        ! ----------------------------------------------------
    elseif $GirlTalkFamilyTextId = 'hall_hook':

        ! Стычка с дворянином
        if $LastHallChoiceEvent = 'noble_attack' and $GirlTalkFamilyGirl = 'sandra':
            if $GirlTalkFamilyChoiceType = 'sandra_shield':
                *pl 'Сандра опускает взгляд на натруженные ладони:'
                *pl ' '
                *pl '— Не хотела, чтобы ты видел меня такой, Стефан. Мать, закрывающая сына от клинка...'
                *pl ' '
                *pl 'Ты перехватываешь её руку, сжимаешь пальцы:'
                *pl ' '
                *pl '— Ты встала между мной и сталью. Я этого не забуду.'
                *pl ' '
                *pl 'Она поднимает глаза, и в них плещется облегчение пополам с тревогой:'
                *pl ' '
                *pl '— Он назвал тебя бастардом на весь зал. Я иначе не могла. Без тебя наш дом — пепел.'
                *pl ' '
            elseif $GirlTalkFamilyChoiceType = 'yield':
                *pl 'Сандра касается твоего плеча, в глазах — сочувствие:'
                *pl ' '
                *pl '— Ты уступил, чтобы сберечь жизни. Я не виню.'
                *pl ' '
                *pl 'Ты криво усмехаешься:'
                *pl ' '
                *pl '— Гордость против клинка — плохой размен. Но осадок остался.'
                *pl ' '
                *pl 'Она кивает, сжимая твоё плечо:'
                *pl ' '
                *pl '— Главное — ты жив. А со спесью этих господ ещё разберёмся.'
                *pl ' '
            else:
                *pl 'Сандра хмурится, глядя в сторону лестницы:'
                *pl ' '
                *pl '— После той стычки дом притих. Слишком громко прозвучало «бастард».'
                *pl ' '
                *pl 'Ты встречаешь её взгляд спокойно:'
                *pl ' '
                *pl '— Тайны прошлого на замке не удержать. Но болтать могут что угодно.'
                *pl ' '
                *pl 'Она выдыхает, и плечи чуть опускаются:'
                *pl ' '
                *pl '— Что бы там ни было — ты наш, Стефан.'
                *pl ' '
            end

            ! Стефан защитил девушку
        elseif $GirlTalkFamilyChoiceType = 'protect':
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда теребит край юбки, потом вскидывает сияющие глаза:'
                *pl ' '
                *pl '— За тот случай в зале... Спасибо, что влез.'
                *pl ' '
                *pl 'Ты пожимаешь плечами:'
                *pl ' '
                *pl '— Ты бы и сама огрела его кувшином. Но я не мог стоять и смотреть.'
                *pl ' '
                *pl 'Она фыркает, но уголки губ ползут вверх:'
                *pl ' '
                *pl '— То, что встал за меня горой — дорогого стоит. Я запомню.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса одобрительно кивает, прищурившись:'
                *pl ' '
                *pl '— Я видела, как ты осадил того хама. Это было правильно.'
                *pl ' '
                *pl 'Ты скрещиваешь руки на груди:'
                *pl ' '
                *pl '— Хозяин защищает своих. Иначе зачем мне этот трактир?'
                *pl ' '
                *pl 'Она поправляет очки:'
                *pl ' '
                *pl '— Ты провёл черту, за которую нельзя заступать. Молодец.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра тепло улыбается, смахивая слезинку с уголка глаза:'
                *pl ' '
                *pl '— Сегодня в зале ты показал, что мы — семья.'
                *pl ' '
                *pl 'Ты берёшь её за руку:'
                *pl ' '
                *pl '— Своих девочек в обиду не дам. Никому.'
                *pl ' '
                *pl 'Она сжимает твои пальцы в ответ:'
                *pl ' '
                *pl '— У меня от сердца отлегло, сынок.'
                *pl ' '
            else:
                *pl 'Твой поступок в зале запомнили. В доме это ценят выше любых денег.'
                *pl ' '
            end

            ! Стефан не стал вмешиваться / спустил на тормозах
        elseif $GirlTalkFamilyChoiceType = 'calm' or $GirlTalkFamilyChoiceType = 'own_choice' or $GirlTalkFamilyChoiceType = 'watch' or $GirlTalkFamilyChoiceType = 'ignore':
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда отводит взгляд и горько усмехается:'
                *pl ' '
                *pl '— Ты промолчал и не стал связываться. Может, для трактира и выгодно.'
                *pl ' '
                *pl 'Ты вздыхаешь:'
                *pl ' '
                *pl '— Я думал, ты сама справишься. Ты всегда справлялась.'
                *pl ' '
                *pl 'Она вскидывает подбородок, в глазах — сталь:'
                *pl ' '
                *pl '— Теперь я поняла: если полезут снова — надеяться только на свои ногти и зубы.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса сухо смотрит на тебя, сложив руки на груди:'
                *pl ' '
                *pl '— Ты предпочёл остаться в стороне. Я справилась сама.'
                *pl ' '
                *pl 'Ты встречаешь её взгляд прямо:'
                *pl ' '
                *pl '— Я оценивал, стоит ли вмешиваться. Не хотел раздувать скандал.'
                *pl ' '
                *pl 'Она качает головой, и в голосе звенит лёд:'
                *pl ' '
                *pl '— Не называй малодушие выдержкой, Стефан. Семья ждёт опоры, а не зрителя.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра поджимает губы и качает головой:'
                *pl ' '
                *pl '— Не полез в драку... Может, пожалел посуду и покой в зале.'
                *pl ' '
                *pl 'Ты разводишь руками:'
                *pl ' '
                *pl '— Я думал, так будет лучше для всех. Без крови и битой мебели.'
                *pl ' '
                *pl 'Она смотрит на тебя долгим взглядом:'
                *pl ' '
                *pl '— Осадок остался тяжёлый, сынок. Если хозяин опускает глаза — гости садятся на шею.'
                *pl ' '
            else:
                *pl 'Ты не вмешался в конфликт. В доме это заметили и сделали свои выводы.'
                *pl ' '
            end

            ! Стефан взял деньги / поощрил приставания
        elseif $GirlTalkFamilyChoiceType = 'encourage' or $GirlTalkFamilyChoiceType = 'client':
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда сверлит взглядом пол, пальцы сжаты в кулаки до побелевших костяшек:'
                *pl ' '
                *pl '— Ты взял с того урода монеты и позволил лапать меня.'
                *pl ' '
                *pl 'Ты поднимаешь ладони:'
                *pl ' '
                *pl '— Я думал, ты отобьёшься, если что. А деньги... деньги трактиру нужны.'
                *pl ' '
                *pl 'Она вскидывает голову, и в голосе дрожит ярость:'
                *pl ' '
                *pl '— От пьяного гостя я отобьюсь подносом. Но когда брат подставляет меня первому встречному за пригоршню спринтриев... Куда мне теперь смотреть, Стефан?'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса обдаёт тебя ледяным взглядом:'
                *pl ' '
                *pl '— Ты взял серебро за то, чтобы к нам распускали руки. Чистый расчёт?'
                *pl ' '
                *pl 'Ты пытаешься пожать плечами:'
                *pl ' '
                *pl '— Трактир есть трактир. Гости платят — мы терпим.'
                *pl ' '
                *pl 'Она поправляет очки и чеканит каждое слово:'
                *pl ' '
                *pl '— Тогда не удивляйся, если завтра я оценю твою долю с той же бессердечностью. В следующий раз я выставлю счёт с той же холодной точностью. Семья так не поступает.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра с глухим стуком опускает ладонь на стол:'
                *pl ' '
                *pl '— Слышала я про эти деньги, Стефан. Звон монет душу греет?'
                *pl ' '
                *pl 'Ты отводишь взгляд:'
                *pl ' '
                *pl '— Я не думал, что всё так обернётся. Просто... подвернулся случай.'
                *pl ' '
                *pl 'Она не убирает ладонь со стола, голос — как натянутая струна:'
                *pl ' '
                *pl '— Ты пустил чужие руки в наш дом за звонкую монету. Я мать. Если ты не видишь разницы между трактиром и семьёй — наш дом долго не простоит.'
                *pl ' '
            else:
                *pl 'Ты взял деньги за покладистость. В доме повисла тяжёлая, гнетущая тишина.'
                *pl ' '
            end

            ! Прочее / общее эхо
        else:
            if $GirlTalkFamilyGirl = 'amanda':
                *pl 'Аманда задумчиво поправляет ворот:'
                *pl ' '
                *pl '— Ты после того вечера какой-то странный. Не пойму, гордиться тобой или опасаться.'
                *pl ' '
                *pl 'Ты усмехаешься краем рта:'
                *pl ' '
                *pl '— Может, и то и другое сразу. Расскажи, что тебя гложет.'
                *pl ' '
                *pl 'Она щурится:'
                *pl ' '
                *pl '— Семья всё замечает, Стефан. Расскажи сам, если есть что сказать.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'melissa':
                *pl 'Мелисса внимательно изучает твоё лицо:'
                *pl ' '
                *pl '— Я наблюдала за тобой в зале. Пока не могу дать определения: хозяин, купец или свидетель?'
                *pl ' '
                *pl 'Ты выдерживаешь её взгляд:'
                *pl ' '
                *pl '— А ты вынеси вердикт позже. Когда будет больше поступков.'
                *pl ' '
                *pl 'Она кивает, чуть смягчившись:'
                *pl ' '
                *pl '— Поступки значат больше слов. Дай повод уважать тебя.'
                *pl ' '
            elseif $GirlTalkFamilyGirl = 'sandra':
                *pl 'Сандра мягко улыбается, но во взгляде — озабоченность:'
                *pl ' '
                *pl '— Вечер выдался непростым, сынок. Дом всё переварит, лишь бы мы держались заодно.'
                *pl ' '
                *pl 'Ты кладёшь руку на стол рядом с её ладонью:'
                *pl ' '
                *pl '— Я на стороне семьи. Всегда был.'
                *pl ' '
                *pl 'Она накрывает твою ладонь своей:'
                *pl ' '
                *pl '— Хорошо, если так. Держись за это, сынок — не дай залу нас расшатать.'
                *pl ' '
            else:
                *pl 'Вспоминают, каким хозяином ты показал себя в тот вечер. Взгляды говорят красноречивее слов.'
                *pl ' '
            end
        end
    end

    killvar '$GirlTalkFamilyTextId'
    killvar '$GirlTalkFamilyChoiceType'
---
