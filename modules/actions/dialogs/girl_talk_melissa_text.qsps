    ! -------------------------------------------------------------------------
    if GirlNoPantiesWork['melissa'] = 1:
        if FamilyCorruptionStage >= 3:
            *pl 'Мелисса с легкой ироничной усмешкой слегка приподнимает край юбки, открывая взору гладкое бедро без следа белья:'
            *pl '— Твой наказ выходить в зал без панталон... С точки зрения строгой морали это форменное безобразие. Но с точки зрения физиологии — поразительный эксперимент.'
            *pl 'Она наклоняется чуть ближе, её голос обретает бархатные интимные нотки:'
            *pl '— Прохладный воздух под юбкой заставляет обостряться каждый нерв. А когда гости пялятся на мои ноги, пытаясь угадать, что там скрыто... внизу всё предательски сжимается и увлажняется от возбуждения. Твой расчёт оказался чертовски точным, хозяин.'
            *pl ' '
        else:
            *pl 'Мелисса сдержанно одёргивает подол и бросает на тебя строгий взгляд поверх очков:'
            *pl '— Ходить на смене без белья — сомнительное распоряжение, Стефан. Мне приходится следить за каждым шагом и каждым наклоном к нижним полкам. Надеюсь, ты отдаёшь себе отчёт, насколько это рискованно при пьяных гостях.'
            *pl ' '
        end
    elseif GirlNoPantiesWork['melissa'] = 0 and (sluttiness['melissa'] >= 45 and FamilyCorruptionStage >= 3):
        *pl 'Мелисса аккуратно поправляет ткань платья и сухо замечает:'
        *pl '— В белье работать куда спокойнее — внимание клиентов остаётся в рамках приличий. Хотя по твоему взгляду я замечаю, что открытый доступ волновал тебя куда сильнее.'
        *pl ' '
    end

    if MelissaProhibitMinstrel = 1:
        *pl 'Она слегка хмыкает, крутя в пальцах гусиное перо:'
        *pl '— Твой запрет на общение с бродячим менестрелем... С точки зрения собственника я тебя понимаю: менестрели падки на чужих сестёр и любят плести интриги. Но учти: ты лишил меня редкого источника рифм и столичных баллад. Так что будь добр компенсировать эту потерю собственным вниманием.'
        *pl ' '
