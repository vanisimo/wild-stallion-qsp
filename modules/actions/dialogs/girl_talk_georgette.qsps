! ================================================
! FILE: modules/actions/dialogs/girl_talk_georgette.qsps
! MODULE: actions/dialogs
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! Меню и расширенные разговоры Жоржетты в порту
! ================================================

#GirlTalkGeorgetteChurchMenuReady
    GeorgetteChurchMenuReady = 0

    if GeorgettePortSexDone = 0 or GeorgetteTalkBioDone = 0:
        exit
    end

    if GeorgettePriestSpySeen = 0 and GeorgetteChurchIntroDone = 0:
        GeorgetteChurchMenuReady = 1
        exit
    end

    if GeorgettePriestSpySeen = 1 and GeorgetteChurchAfterSpy1Done = 0:
        GeorgetteChurchMenuReady = 1
        exit
    end

    if GeorgetteChurchRecapPending = 1 and $TalkReturnLoc = 'Port' and time = 5:
        GeorgetteChurchMenuReady = 1
    end
---

#GirlTalkGeorgetteChurchResolvePhase
    GirlTalkGeorgetteChurchPhase = 0

    if GeorgetteTalkPriestSpyDone = 1 and GeorgetteChurchAfterSpy1Done = 0:
        GeorgetteChurchAfterSpy1Done = 1
    end

    if GeorgetteTalkChurchDone = 1 and GeorgettePriestSpySeen = 0 and GeorgetteChurchIntroDone = 0:
        GeorgetteChurchIntroDone = 1
    end

    if GeorgettePriestSpySeen = 0 and GeorgetteChurchIntroDone = 0:
        GirlTalkGeorgetteChurchPhase = 1
    elseif GeorgettePriestSpySeen = 1 and GeorgetteChurchAfterSpy1Done = 0:
        GirlTalkGeorgetteChurchPhase = 2
    elseif GeorgetteChurchRecapPending = 1:
        GirlTalkGeorgetteChurchPhase = 3
    end

    if GirlTalkGeorgetteChurchPhase = 3:
        if GeorgettePriestSpyLastScene < 1:
            GeorgettePriestSpyLastScene = 1
        end

        if GeorgettePriestSpyLastScene > 7:
            GeorgettePriestSpyLastScene = 7
        end
    end
---

#GirlTalkGeorgetteLoreBump
    $GirlTalkGeorgetteLoreCounter = $ARGS[0]

    if $GirlTalkGeorgetteLoreCounter = 'port':
        GirlTalkGeorgetteLoreSlot = GeorgetteTalkPortStory
        GeorgetteTalkPortStory += 1
        if GeorgetteTalkPortStory >= 4:
            GeorgetteTalkPortStory = 0
        end
    elseif $GirlTalkGeorgetteLoreCounter = 'bio':
        GirlTalkGeorgetteLoreSlot = GeorgetteTalkBioStory
        GeorgetteTalkBioStory += 1
        if GeorgetteTalkBioStory >= 3:
            GeorgetteTalkBioStory = 0
        end
    elseif $GirlTalkGeorgetteLoreCounter = 'clients':
        GirlTalkGeorgetteLoreSlot = GeorgetteTalkClientsStory
        GeorgetteTalkClientsStory += 1
        if GeorgetteTalkClientsStory >= 3:
            GeorgetteTalkClientsStory = 0
        end
    elseif $GirlTalkGeorgetteLoreCounter = 'sex':
        GirlTalkGeorgetteLoreSlot = GeorgetteTalkSexStory
        GeorgetteTalkSexStory += 1
        if GeorgetteTalkSexStory >= 3:
            GeorgetteTalkSexStory = 0
        end
    elseif $GirlTalkGeorgetteLoreCounter = 'family':
        GirlTalkGeorgetteLoreSlot = GeorgetteTalkFamilyStory
        GeorgetteTalkFamilyStory += 1
        if GeorgetteTalkFamilyStory >= 3:
            GeorgetteTalkFamilyStory = 0
        end
    elseif $GirlTalkGeorgetteLoreCounter = 'children':
        GirlTalkGeorgetteLoreSlot = GeorgetteTalkChildrenStory
        GeorgetteTalkChildrenStory += 1
        if GeorgetteTalkChildrenStory >= 3:
            GeorgetteTalkChildrenStory = 0
        end
    else:
        GirlTalkGeorgetteLoreSlot = 0
    end

    killvar '$GirlTalkGeorgetteLoreCounter'
---

#GirlTalkBuildGeorgetteMainMenu
    gs 'Menu.Destroy', 'GirlTalkMainMenu'
    gs 'Menu.Create', 'GirlTalkMainMenu'

    ! Если ещё не знакомы — первое знакомство
    if GeorgetteKnown < 1:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор', 'important'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GeorgetteFirstMeet', $TalkReturnLoc
        }
        exit
    end

    ! ==================== 1. ВАЖНЫЙ РАЗГОВОР (ЕСЛИ ЕСТЬ) ====================
    ! 1.1. Церковь и отец Герхард (ввод, после spy E или еженедельный рекап воскресного шпионажа)
    gs 'GirlTalkGeorgetteChurchMenuReady'
    if GeorgetteChurchMenuReady = 1:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор', 'important'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', 'georgett', $TalkReturnLoc, 'georgette_church'
        }
    ! 1.2. Об уроке для Лизетты в соборе
    elseif LizaSawSexInChurch = 1 and GeorgetteTalkLizetteChurchDone = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор', 'important'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', 'georgett', $TalkReturnLoc, 'georgette_lizette_church'
        }
    ! 1.3. О Лизетке у отца Герхарда (шпионаж 1)
    elseif LizettePriestSpyStage >= 1 and GeorgetteTalkLizetteSpy1Done = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор', 'important'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', 'georgett', $TalkReturnLoc, 'georgette_lizette_spy1'
        }
    ! 1.4. О Лизетте и отце Герхарде (шпионаж 2)
    elseif LizettePriestSpySeen = 1 and GeorgetteTalkLizetteSpy2Done = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор', 'important'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', 'georgett', $TalkReturnLoc, 'georgette_lizette_spy2'
        }
    ! 1.5. Об Эдди из лавки Бекки
    elseif GeorgetteTalkChildrenDone = 1 and Friends['georgett'] >= 16 and EddieSawGeorg >= 1 and GeorgetteTalkEddieDone = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор', 'important'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', 'georgett', $TalkReturnLoc, 'georgette_eddie'
        }
    ! 1.6. О дочери Лизетте (первое сюжетное открытие)
    elseif GeorgetteTalkPortDone = 1 and (LizetteMentionedByGeorgette = 1 or PortMeetWitnessed = 1) and GeorgetteTalkLizetteDone = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор', 'important'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', 'georgett', $TalkReturnLoc, 'georgette_lizette'
        }
    end
    killvar 'GeorgetteChurchMenuReady'

    ! ==================== 2. ПОГОВОРИТЬ (ВСЕГДА) ====================
    gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Поговорить', 'talk'
    gs 'Menu.AddModule', 'GirlTalkMainMenu', {
        gt 'GirlTalkResult', 'georgett', $TalkReturnLoc, 'georgette_unified'
    }

    ! ==================== 3. СДЕЛАТЬ ПОДАРОК (ЕСЛИ ЕСТЬ) ====================
    if LOC('GirlTalkAppendGiftMenuItems') = 1:
        gs 'GirlTalkAppendGiftMenuItems'
    end
---

#GirlTalkGeorgetteUnifiedRun
    ! 1. Проверка лимита полезных разговоров:
    gs 'UsefulTalkCheck', 'georgett', 'georgette_unified'
    if UsefulTalkResult = 0:
        gs 'GirlTalkGeorgetteLimitReachedText'
        gs 'ClampGirlSocialStats', 'georgett'
        exit
    end

    ! 2. Регистрация полезного разговора:
    gs 'UsefulTalkRegister', 'georgett', 'georgette_unified'

    ! 3. Иерархия тем разговора:
    ! --- Пик откровения (предел) ---
    if otkroven['georgett'] >= 25 and (GeorgettePortSexDone = 1 or HadSex['georgett'] > 0) and GeorgetteMemoryLimitDone = 0:
        gs 'GirlTalkGeorgetteMemoryLimitText'
        if GeorgetteMemoryLimitDone = 0:
            GeorgetteMemoryLimitDone = 1
            love['georgett'] += 2
            otkroven['georgett'] += 2
            Friends['georgett'] += 1
        else:
            love['georgett'] += 1
            otkroven['georgett'] += 1
        end

    ! --- Воспоминание о ночи в порту ---
    elseif GeorgettePortSexDone = 1 and otkroven['georgett'] >= 18 and GeorgetteMemoryPortSexDone = 0:
        gs 'GirlTalkGeorgetteMemoryPortSexText'
        GeorgetteMemoryPortSexDone = 1
        love['georgett'] += 2
        otkroven['georgett'] += 1

    ! --- Воспоминание о шалостях в церкви на службе ---
    elseif (GeorgetteConfessBasic = 1 or HadSex['georgett'] > 0 or LizaSawSexInChurch = 1) and GeorgetteMemoryChurchSexDone = 0 and otkroven['georgett'] >= 14:
        gs 'GirlTalkGeorgetteMemoryChurchSexText'
        GeorgetteMemoryChurchSexDone = 1
        otkroven['georgett'] += 2
        love['georgett'] += 1

    ! --- Первые последовательные открытия лора ---
    elseif GeorgetteTalkBioDone = 0:
        gs 'GirlTalkGeorgetteBioRun'

    elseif GeorgetteTalkPortDone = 0:
        gs 'GirlTalkGeorgettePortRun'

    elseif GeorgetteTalkClientsDone = 0 and Friends['georgett'] >= 8:
        gs 'GirlTalkGeorgetteClientsRun'

    elseif GeorgetteTalkSexDone = 0 and Friends['georgett'] >= 10:
        gs 'GirlTalkGeorgetteSexRun'

    elseif GeorgetteTalkFamilyDone = 0 and Friends['georgett'] >= 12:
        gs 'GirlTalkGeorgetteFamilyRun'

    elseif GeorgetteTalkChildrenDone = 0 and Friends['georgett'] >= 14:
        gs 'GirlTalkGeorgetteChildrenRun'

    ! --- Повторяющаяся ротация богатых лор-пулов (все реплики Жоржетты сохраняются) ---
    else:
        GeorgetteLorePoolCycle += 1
        if GeorgetteLorePoolCycle > 5:
            GeorgetteLorePoolCycle = 0
        end

        if GeorgetteLorePoolCycle = 0:
            gs 'GirlTalkGeorgetteBioRun'
        elseif GeorgetteLorePoolCycle = 1:
            gs 'GirlTalkGeorgettePortRun'
        elseif GeorgetteLorePoolCycle = 2:
            gs 'GirlTalkGeorgetteClientsRun'
        elseif GeorgetteLorePoolCycle = 3:
            gs 'GirlTalkGeorgetteSexRun'
        elseif GeorgetteLorePoolCycle = 4:
            gs 'GirlTalkGeorgetteFamilyRun'
        else:
            gs 'GirlTalkGeorgetteChildrenRun'
        end
    end

    ! --- Дополнительные действия на экране разговора ---
    if $TalkReturnLoc = 'Port' and time = 5 and GeorgettePortNightGone = 0:
        gs 'PortNightGirlVisible', 'georgett'

        if PortNightGirlVisible = 1:
            if GeorgettePortSexDone = 0:
                gs 'ActUiPrepare', 'Снять Жоржетту (10 спинтарий)', 'intim'
            else:
                gs 'ActUiPrepare', 'Провести ночь с Жоржеттой (10 спинтарий)', 'intim'
            end

            act $ActUiLabel, $ActUiIconPath:
                gt 'GeorgettePortNightPaySex', 'Port'
            end
        end

        killvar 'PortNightGirlVisible'
    end

    if Friends['georgett'] >= 12 or love['georgett'] >= 10 or otkroven['georgett'] >= 12:
        gs 'ActUiPrepare', 'Сделать комплимент', 'flirt'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GirlTalkResult', 'georgett', $TalkReturnLoc, 'compliment'
        end
    end

    if GiftInventory['gift_cheap'] > 0 or GiftInventory['gift_expensive'] > 0:
        gs 'ActUiPrepare', 'Сделать подарок', 'gift'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GirlTalkResult', 'georgett', $TalkReturnLoc, 'gift'
        end
    end

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgettePortRun
    gs 'GirlTalkGeorgetteLoreBump', 'port'
    gs 'GirlTalkGeorgettePrintText', 'georgette_port', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_port', 'milestone'
    gs 'GirlTalkGeorgettePrintText', 'georgette_port', 'context'

    GeorgetteTalkPortDone = 1
    Friends['georgett'] += 1
    trading += 1
---

#GirlTalkGeorgetteBioRun
    gs 'GirlTalkGeorgetteLoreBump', 'bio'
    gs 'GirlTalkGeorgettePrintText', 'georgette_bio', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_bio', 'milestone'
    gs 'GirlTalkGeorgettePrintText', 'georgette_bio', 'context'

    GeorgetteTalkBioDone = 1
    Friends['georgett'] += 1
    otkroven['georgett'] += 1

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteLizetteRun
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette', 'milestone'
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette', 'context'

    GeorgetteTalkLizetteDone = 1
    Friends['georgett'] += 1
    LizetteMentionedByGeorgette = 1

    if AmandaLizaInfluence < 100:
        AmandaLizaInfluence += 1
    end

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteClientsRun
    if GeorgetteTalkClientsDone = 0:
        GeorgetteTalkClientsDone = 1
    end

    gs 'GirlTalkGeorgetteLoreBump', 'clients'
    gs 'GirlTalkGeorgettePrintText', 'georgette_clients', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_clients', 'milestone'
    gs 'GirlTalkGeorgettePrintText', 'georgette_clients', 'context'

    Friends['georgett'] += 1
    otkroven['georgett'] += 2

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteSexRun
    if GeorgetteTalkSexDone = 0:
        GeorgetteTalkSexDone = 1
    end

    gs 'GirlTalkGeorgetteLoreBump', 'sex'
    gs 'GirlTalkGeorgettePrintText', 'georgette_sex', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_sex', 'milestone'
    gs 'GirlTalkGeorgettePrintText', 'georgette_sex', 'context'

    Friends['georgett'] += 1
    otkroven['georgett'] += 2

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteFamilyRun
    if GeorgetteTalkFamilyDone = 0:
        GeorgetteTalkFamilyDone = 1
    end

    gs 'GirlTalkGeorgetteLoreBump', 'family'
    gs 'GirlTalkGeorgettePrintText', 'georgette_family', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_family', 'milestone'
    gs 'GirlTalkGeorgettePrintText', 'georgette_family', 'context'

    Friends['georgett'] += 1
    otkroven['georgett'] += 2

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteChildrenRun
    if GeorgetteTalkChildrenDone = 0:
        GeorgetteTalkChildrenDone = 1
    end

    gs 'GirlTalkGeorgetteLoreBump', 'children'
    gs 'GirlTalkGeorgettePrintText', 'georgette_children', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_children', 'milestone'
    gs 'GirlTalkGeorgettePrintText', 'georgette_children', 'context'

    Friends['georgett'] += 1
    otkroven['georgett'] += 2

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteChurchRun
    gs 'GirlTalkGeorgetteChurchResolvePhase'

    if GirlTalkGeorgetteChurchPhase = 0:
        exit
    end

    gs 'GirlTalkGeorgettePrintText', 'georgette_church', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_church', 'context'

    if GirlTalkGeorgetteChurchPhase = 1:
        GeorgetteChurchIntroDone = 1
    elseif GirlTalkGeorgetteChurchPhase = 2:
        GeorgetteChurchAfterSpy1Done = 1
        GeorgetteTalkPriestSpyDone = 1
    elseif GirlTalkGeorgetteChurchPhase = 3:
        GeorgetteChurchRecapPending = 0
    end

    Friends['georgett'] += 1
    otkroven['georgett'] += 1

    gs 'ClampGirlSocialStats', 'georgett'

    killvar 'GirlTalkGeorgetteChurchPhase'
---

#GirlTalkGeorgetteLizetteSpy1Run
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette_spy1', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette_spy1', 'context'

    GeorgetteTalkLizetteSpy1Done = 1
    Friends['georgett'] += 1
    otkroven['georgett'] += 1

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteLizettePriestReportRun
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette_priest', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette_priest', 'context'

    GeorgetteTalkLizettePriestReportDone = 1
    Friends['georgett'] += 1
    otkroven['georgett'] += 1

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteLizetteSpy2Run
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette_spy2', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette_spy2', 'context'

    GeorgetteTalkLizetteSpy2Done = 1
    GeorgetteTalkLizettePriestReportDone = 1
    Friends['georgett'] += 1
    otkroven['georgett'] += 2

    if LizetteProstPortStartDay = 0:
        LizetteProstPortStartDay = day + 1
    end

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteLizetteChurchRun
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette_church', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_lizette_church', 'context'

    GeorgetteTalkLizetteChurchDone = 1
    Friends['georgett'] += 1
    otkroven['georgett'] += 2

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteEddieRun
    gs 'GirlTalkGeorgettePrintText', 'georgette_eddie', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_eddie', 'context'

    GeorgetteTalkEddieDone = 1
    Friends['georgett'] += 1

    if EddieStory < 2:
        EddieStory = 2
    end

    gs 'ClampGirlSocialStats', 'georgett'
---

#GirlTalkGeorgetteComplimentRun
    gs 'GirlTalkGeorgettePrintText', 'georgette_compliment', 'intro'
    gs 'GirlTalkGeorgettePrintText', 'georgette_compliment', 'context'

    TalkTopicUseful = 1
    gs 'UsefulTalkRegister', 'georgett', 'compliment'

    TalkRoll = RAND(1, 100)
    TalkChance = 40 + Friends['georgett'] + love['georgett'] + otkroven['georgett']

    if TalkChance > 95:
        TalkChance = 95
    end

    if TalkRoll <= TalkChance:
        $ComplimentKey = 'georgett_' + STR(day)
        if GirlComplimentDay[$ComplimentKey] = 0:
            GirlComplimentDay[$ComplimentKey] = 1
            love['georgett'] += 1
            if Friends['georgett'] < 12:
                Friends['georgett'] += 1
            end
        end
        killvar '$ComplimentKey'
    end

    gs 'ClampGirlSocialStats', 'georgett'

    killvar 'TalkRoll'
    killvar 'TalkChance'
---

#GirlTalkGeorgettePrintText
    gs 'GirlTalkGeorgetteText', $ARGS[0], $ARGS[1]

    if $GirlTalkGeorgetteText <> '':
        *pl $GirlTalkGeorgetteText
    end

    killvar '$GirlTalkGeorgetteText'
---
