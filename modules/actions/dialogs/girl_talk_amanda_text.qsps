#GirlTalkAmandaMemoryLimitText
    ! Проверка отсутствия NTR (чистый путь отношений со Стефаном)
    AmandaHasNtrPath = 0
    if AmandaLegareFirstSexDone = 1 or Fact_AmandaLegareFridayAlley = 1 or AmandaNeighborBoysStage >= 1 or AmandaAlleyMmfDone = 1 or HallMissingGirlPrivateCount['amanda'] >= 1 or AmandaNpcPath > 2 or GirlNpcPath['amanda'] > 2:
        AmandaHasNtrPath = 1
    end

    if AmandaHasNtrPath = 0:
        ! --- ЧИСТЫЙ ПУТЬ (БЕЗ NTR): Искреннее, живое признание легкомысленной девчонки ---
        if FamilyCorruptionStage <= 1:
            *pl 'Аманда вдруг умолкает на полуслове. Её озорной задор сменяется тихим, непривычным смущением. Она опускает ресницы, теребя край передника, а затем робко касается пальцами твоей ладони:'
            *pl '— Знаешь... я ведь вечно спорю и строю из себя язву. Боялась, что если покажу слабину, ты так и будешь видеть во мне сопливую девчонку.'
            *pl 'Она медленно поднимает взгляд, и её щёки заливает девичий румянец:'
            *pl '— А на деле... я только о тебе и думаю. Городские мальчишки с их ужимками рядом с тобой — просто щенки. Ни у кого нет такой стати и силы. Когда ты рядом и смотришь вот так... у меня всё внутри тает.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Аманда замолкает, отставляя поднос, и делает шаг вплотную к тебе. Её глаза блестят озорным и одновременно глубоким, жарким теплом:'
            *pl '— Помнишь, как я раньше заглядывалась на парней у площади? Так вот... забудь. Всё это глупости были. Никто из них даже близко не умеет так жадно и сладко меня ласкать.'
            *pl 'Она легко скользит ладонью по твоей груди, прикусывая нижнюю губу:'
            *pl '— В постели мне только ты нужен, к чужим рукам меня даже не тянет. С тобой мне безумно хорошо, и я хочу, чтобы ты всегда был рядом и держал надо мной опеку.'
        else:
            *pl 'Аманда прижимается к тебе всем телом, бесстыдно притираясь упругой грудью и бёдрами:'
            *pl '— Зачем мне чужие неумехи, когда у меня есть собственный ненасытный жеребец? Ты научил меня не стесняться своих желаний и получать дикое удовольствие.'
            *pl 'Она жарко дышит тебе в шею, бросая откровенный взгляд на твои штаны:'
            *pl '— Ни один мужик в городе не сравнится с твоим напором. Моё тело и все мои дырочки в твоём полном распоряжении. Пока мы здесь — я хочу только твой член.'
        end
    else:
        ! --- ПУТЬ С ОПЫТОМ НА СТОРОНЕ (NTR / сторонние связи): без ложной моногамии, откровенно и дерзко ---
        if FamilyCorruptionStage <= 2:
            *pl 'Аманда отводит взгляд, заправляя прядь волос за ухо, и кривовато усмехается:'
            *pl '— Мы оба знаем, что я не домашняя тихоня. В городе столько всего интересного... но рядом с тобой мне всегда спокойнее. Ты хороший брат, и парень хороший.'
        else:
            *pl 'Аманда усмехается, скользя взглядом по твоей фигуре:'
            *pl '— Не проси от меня верности, я слишком люблю жизнь и острые забавы. Но признаю честно: трахаешься ты отлично. Ты для меня всегда любимый братик, даже если вокруг полно других парней.'
        end
    end

    killvar 'AmandaHasNtrPath'
