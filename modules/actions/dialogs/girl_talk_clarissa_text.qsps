#GirlTalkClarissaHomeText
    $GirlTalkClarissaHomeTextId = LCASE($ARGS[0])
    $GirlTalkClarissaHomeText = ''

    if $GirlTalkClarissaHomeTextId = 'intro':
        *pl 'Кларисса притворяет дверь в заднюю комнату и с улыбкой поворачивается к тебе:'
        *pl ' '
        *pl '— О доме Легаре расспросить хочешь? — она говорит с лёгким смешком. — Спрашивай, Стефан. Мне скрывать нечего, да и ханжеством я никогда не страдала.'
        *pl ' '

    elseif $GirlTalkClarissaHomeTextId = 'milestone':
        if LastSexDay['clarissa'] > 0 and (day - LastSexDay['clarissa'] <= 1) and (SexGirlCameInScene >= 6 or SexGirlExhausted = 1 or SexMarathonGossipPending['clarissa'] = 1):
            *pl 'Кларисса потягивается всем телом, словно сытая кошка, и бросает на тебя горячий взгляд:'
            *pl ' '
            *pl '— После вчерашней забавы у меня всё тело ноет сладкой истомой. Альбер ходит по дому, пересчитывает серебро, а я только и вспоминаю, как твой жезл входил в меня до самого упора. Умеешь ты порадовать женщину!'
            *pl ' '
        elseif (ClarissaIntimSex = 1 or HadSex['clarissa'] > 0) and (day - LastSexDay['clarissa'] >= 4):
            *pl 'Кларисса цокает языком с наигранным укором:'
            *pl ' '
            *pl '— Дни тянутся скучновато, когда ты пропадаешь в своём трактире, Стефан. Муж занят бочками и девками, а мне приходится искать развлечений на стороне. Не заставляй меня скучать слишком долго!'
            *pl ' '
        end

    elseif $GirlTalkClarissaHomeTextId = 'context':
        if ClarissaJealousy >= 3 and AmandaLegareFirstSexDone = 1:
            *pl '— Муж прямо светится после встреч с твоей сестрицей, — посмеивается Кларисса. — Значит, охота удалась. Ну и славно, теперь в постели будет стараться вдвое усерднее, доказывая, что он ещё ого-го.'
