        ClarissaPaternityTextStep = ClarissaPaternityStory
    end
    $GirlTalkClarissaPaternityText = ''

    if $GirlTalkClarissaPaternityTextId = 'intro':
        if ClarissaPaternityTextStep <= 0:
            *pl '— О моём прошлом и о том, как я стала женой Альбера?.. — Кларисса удивлённо приподнимает бровь, а затем заливается звонким, насмешливым смехом. — Неужели ты только сейчас решил об этом спросить, Стефан? Святой Ильматер, да в нашем городишке об этом каждая собака под забором знает!'
            *pl ' '
        elseif ClarissaPaternityTextStep = 1:
            *pl 'Кларисса наливает в стеклянный бокал немного вина, с лукавым блеском в глазах поглядывая на тебя:'
            *pl ' '
            *pl '— Хочешь знать, что было дальше, трактирщик? Слушай, мне не жалко.'
            *pl ' '
        else:
            *pl 'Кларисса отставляет бокал и с задорной усмешкой опирается о дубовую стойку:'
            *pl ' '
            *pl '— Ну а как мы сейчас живём — это отдельная песня, Стефан.'
            *pl ' '
        end

    elseif $GirlTalkClarissaPaternityTextId = 'context':
        if ClarissaPaternityTextStep <= 0:
            *pl 'Она складывает руки на груди, с удовольствием глядя на твоё озадаченное лицо:'
            *pl ' '
            *pl '— Ты до того, как трактир принял, только и знал, что с дружками пиво хлестать да за девками увиваться. Мимо ушей всё пропускал, пока носом не ткнули! А тайна простая: я с ранних лет была девкой горячей. Едва сиськи наметились да кровь заиграла — меня уже вовсю к мальчикам потянуло.'
            *pl ' '
            *pl 'Она без тени смущения подмигивает тебе:'
            *pl ' '
            *pl '— Сперва на сеновале с молодым конюхом кувыркалась, потом с соседским сыном за амбаром обжималась — еле оттащили! Так что к мужскому телу я привыкла задолго до того, как переступила порог богатого дома.'

        elseif ClarissaPaternityTextStep = 1:
            *pl 'Кларисса озорно усмехается, крутя в пальцах золочёную пуговицу на манжете:'
            *pl ' '
            *pl '— А потом покойная матушка Элоиза привела меня в дом Легаре нищей приживалкой. Я сразу смекнула, что Альбер — мужик видный, богатый, при серебре. Чего ждать у моря погоды? Я сама к нему ночью в постель и залезла!'
            *pl ' '
            *pl 'Она тихо посмеивается, вспоминая былое:'
            *pl ' '
            *pl '— Мать всё видела, но только глаза прикрыла да перекрестилась кругом Ильматера: понимала, что для безродной девки это золотой билет. Альбер от такой девичьей прыти обалдел, да так в моих руках и растаял.'

        else:
            *pl 'Кларисса качает головой с насмешливой, довольной улыбкой:'
            *pl ' '
            *pl '— Когда матушка умерла, я просто заняла её место и стала законной госпожой Легаре. И с тех пор у нас идеальный союз: живём весело, друг другу в штаны со слезами не заглядываем, а в постели до сих пор искры летят!'
            *pl ' '
            *pl 'Она бросает на тебя откровенный, манящий взгляд:'
            *pl ' '
            *pl '— Альбер охотится за молоденькими девицами, а я коллекционирую крепких мужиков с большими членами. Мы с мужем оба любим плотские радости и соревнуемся, кто ярче жизнь проживёт! Так что не делай круглые глаза, трактирщик — с нами не соскучишься.'
        end
    end

    killvar '$GirlTalkClarissaPaternityTextId'
    killvar 'ClarissaPaternityTextStep'
---
