#GirlTalkWineShopText
    $GirlTalkWineShopTextId = LCASE($ARGS[0])
    $GirlTalkWineShopText = ''

    if $GirlTalkWineShopTextId = 'intro':
        *pl 'В винной лавке Легаре царит прохладный полумрак. Кларисса стоит за высоким прилавком, подперев подбородок ладонью. Заметив тебя, она выпрямляется, и в её фиолетовых глазах вспыхивают лукавые искорки:'
        *pl ' '
        *pl '— О вине и делах пришёл поговорить, Стефан? — её голос звучит с бархатной хрипотцой. — Или снова пришёл поглазеть на мою юбку? Спрашивай, для видного гостя у меня всегда найдётся минутка.'
        *pl ' '

    elseif $GirlTalkWineShopTextId = 'milestone':
        if LastSexDay['clarissa'] > 0 and (day - LastSexDay['clarissa'] <= 1) and (SexGirlCameInScene >= 6 or SexGirlExhausted = 1 or SexMarathonGossipPending['clarissa'] = 1):
            *pl 'Кларисса бросает быстрый насмешливый взгляд на входную дверь, а затем медленно оглядывает твои бёдра с довольной улыбкой:'
            *pl ' '
            *pl '— Ты ведёшь себя слишком самоуверенно, трактирщик... Будто и не ты вчера среди винных бочек драл меня так, что у меня ноги до сих пор подкашиваются.'
            *pl ' '
            *pl 'Она тихо посмеивается, поправляя вырез платья:'
            *pl ' '
            *pl '— Альбер ничего не подозревает, но если ты продолжишь смотреть на меня с такой ненасытной жаждой — покупатели решат, что ты пришёл дегустировать не вино, а саму хозяйку.'
            *pl ' '
        elseif (ClarissaIntimSex = 1 or HadSex['clarissa'] > 0) and (day - LastSexDay['clarissa'] >= 4):
            *pl 'Кларисса насмешливо щурится, протирая стеклянный бокал льняной тряпицей:'
            *pl ' '
            *pl '— Стефан, ты совсем дорогу в нашу лавку забыл. Заказы присылаешь с мальчишками, а сам не кажешь носа. Смотри, трактирщик: свято место пусто не бывает. У меня тут портовые грузчики вокруг бочек крутятся — как бы твоё место в подсобке не заняли!'
            *pl ' '
        end

    elseif $GirlTalkWineShopTextId = 'context':
        if ClarissaSupplyTalkReady = 1 or ClarissaSupplyAftermathReady = 1:
            *pl '— Если мы и дальше будем возить вино обходными тропами, — говорит она с деловым азартом, — держи ухо востро. Альбер подозрения чует за версту, а стража на воротах только и ждёт повода наложить лапу на наши бочки.'
            *pl ' '
        elseif AmandaLegareFirstSexDone = 1 or Fact_AmandaLegareFridayAlley = 1:
            *pl 'Кларисса перечисляет сорта и цены, но при упоминании трактира усмехается: «Легаре всё увивается за Амандой? Пусть пыжится. Если обломается — мне ночью больше ласки достанется, а если сладит — я за него только порадуюсь и себе кого-нибудь новенького присмотрю».'
            *pl ' '
        elseif ClarissaBulkWinePurchases >= 2:
            *pl '— Спасибо за крупные заказы, Стефан, — улыбается Кларисса. — С такими объёмами лавка процветает, а у меня появляется больше поводов запереться с тобой в подсобке для „дегустации“.'
            *pl ' '
        else:
            *pl 'Ты обсуждаешь с Клариссой бочонки, поставщиков и цены. Она знает рынок превосходно и уверенно держит лавку в своих руках, пока муж разъезжает по делам.'
