        elseif PlayerKnows_MelissaClarissaBrotherGossip = 1:
            *pl '— Мелисса думает, что я не слышу городских пересудов о её братце, — усмехается Кларисса. — В нашем городе сплетни разносятся быстрее ветра. Но мне-то какое дело? Лишь бы в постели толк был.'
            *pl ' '
        elseif ClarissaLegareSuspicionTalkReady = 1:
            *pl '— Альбер что-то носом водит, — замечает она весело. — Поглядывает на меня с прищуром. Но у нас уговор простой: пока лавка в прибыли и честь семьи на людях не задета — каждый волен развлекаться как хочет.'
            *pl ' '
        else:
            *pl 'Кларисса рассказывает о домашних делах, о старших детях Альбера и о том, как забавно наблюдать за чванливыми купеческими семьями, строящими из себя святош.'
            *pl ' '
        end
