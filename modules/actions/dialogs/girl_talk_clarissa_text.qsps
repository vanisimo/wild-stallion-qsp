#GirlTalkClarissaPaternityText
    $GirlTalkClarissaPaternityTextId = LCASE($ARGS[0])
    $GirlTalkClarissaPaternityText = ''

    if $GirlTalkClarissaPaternityTextId = 'intro':
        $GirlTalkClarissaPaternityText = '— О моём прошлом и как я стала женой Альбера?.. — Кларисса сперва удивлённо приподнимает бровь, а затем на её губах появляется насмешливая, понимающая улыбка. — Неужели ты только сейчас решил об этом спросить, Стефан? Ну давай, выкладывай, что у тебя там на уме.'

    elseif $GirlTalkClarissaPaternityTextId = 'context':
        *pl '— Ты и правда думаешь, что открыл какую-то великую тайну? — Кларисса тихо и язвительно усмехается, протирая бокал. — Святой Ильматер, Стефан, да в нашем городишке об этом каждая собака под забором знает! Как такое скроешь в месте, где все друг у друга на виду? Когда матушка померла и я заняла её место в постели Альбера, кумушки на рынке три месяца кости мне перемывали.'
        *pl ' '
        *pl 'Она оглядывает тебя с насмешливым прищуром:'
        *pl ' '
        *pl '— Просто ты до того, как тебе трактир на плечи свалился, только и знал, что с дружками по кабакам шляться, пиво хлестать да за девками увиваться. Слушать, кто с кем спит и кто кому кем приходится, тебе и в голову не приходило — мимо ушей всё пропускал, пока носом не ткнули.'
        *pl ' '
        *pl 'Она скрещивает руки на груди, говоря совершенно спокойно и без тени стыда:'
        *pl ' '
        *pl '— Да, Альбер мне не родной отец. Моя покойная мать Элоиза пришла в его дом нищей приживалкой со мной на руках, сама не зная, от кого меня нагуляла. Альбер был богат, мы от него зависели целиком и полностью. Он положил на меня глаз ещё когда я девчонкой была: сперва просил губками его радовать, а как пошла первая кровь и стали расти сиськи — лишил меня невинности. Мама всё знала и сама благословляла: для безродных приживалок удержаться при богатом купце было вопросом выживания. Всё было по обоюдному согласию, Стефан. А когда матушка умерла, я просто стала законной госпожой Легаре и заняла её постель.'
        *pl ' '
        *pl 'Она с усмешкой качает головой:'
        *pl ' '
        *pl '— Так что не делай круглые глаза. Весь город это давно переварил и привык. Но забавно видеть, как наш юный трактирщик наконец начинает замечать, как на самом деле устроен этот мир.'
        $GirlTalkClarissaPaternityText = ''
    end

    killvar '$GirlTalkClarissaPaternityTextId'
---
