! ================================================
! FILE: modules/actions/dialogs/girl_talk_tavern.qsps
! MODULE: actions/dialogs
! Контекстный разговор о делах трактира
! ================================================

#GirlTalkTavernRun
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTavernGirl = $GirlKey

    if $GirlTalkTavernGirl = '':
        exit
    end

    gs 'EnsureGirlData', $GirlTalkTavernGirl

    gs 'GirlTalkTavernPrintText', 'intro'
    gs 'GirlTalkTavernPrintText', 'context'

    GirlTalkTavernHallHookReady = 0
    GirlTalkTavernPortShipHookReady = 0
    GirlTalkTavernDayHookReady = 0
    GirlTalkTavernRepairHookReady = 0
    GirlTalkTavernDanceDressHookReady = 0

    gs 'GirlTalkTavernHasPortShipHook', $GirlTalkTavernGirl

    if GirlTalkTavernPortShipHookReady = 1:
        gs 'GirlTalkTavernPrintText', 'port_ship_hook'
        $GirlTalkTavernPortShipHookKey = $GirlTalkTavernGirl + '_' + STR(day)
        AmandaPortShipHintDiscussed[$GirlTalkTavernPortShipHookKey] = 1
        killvar '$GirlTalkTavernPortShipHookKey'
    else:
    gs 'GirlTalkTavernHasHallHook', $GirlTalkTavernGirl

    if GirlTalkTavernPortShipHookReady = 0 and GirlTalkTavernHallHookReady = 1:
        gs 'GirlTalkTavernPrintText', 'hall_hook'
        $GirlTalkTavernHallHookKey = $GirlTalkTavernGirl + '_' + STR(day)
        GirlTalkTavernHallHookDiscussed[$GirlTalkTavernHallHookKey] = 1
        killvar '$GirlTalkTavernHallHookKey'
    elseif GirlTalkTavernPortShipHookReady = 0:
        gs 'GirlTalkTavernHasDayEventHook', $GirlTalkTavernGirl

        if GirlTalkTavernDayHookReady = 1:
            gs 'GirlTalkTavernPrintText', 'day_event'
            $GirlTalkTavernDayHookKey = $GirlTalkTavernGirl + '_' + STR(day)
            GirlTalkTavernDayHookDiscussed[$GirlTalkTavernDayHookKey] = 1
            killvar '$GirlTalkTavernDayHookKey'
        else:
            gs 'GirlTalkTavernHasRepairHook', $GirlTalkTavernGirl

            if GirlTalkTavernRepairHookReady = 1:
                gs 'GirlTalkTavernPrintText', 'repair_hook'
                $GirlTalkTavernRepairHookKey = $GirlTalkTavernGirl + '_' + STR(day)
                GirlTalkTavernRepairHookDiscussed[$GirlTalkTavernRepairHookKey] = 1
                killvar '$GirlTalkTavernRepairHookKey'
            else:
                gs 'GirlTalkTavernHasDanceDressHook', $GirlTalkTavernGirl

                if GirlTalkTavernDanceDressHookReady = 1:
                    gs 'GirlTalkTavernPrintDanceDressHint', $GirlTalkTavernGirl
                    $GirlTalkTavernDanceDressHookKey = $GirlTalkTavernGirl + '_' + STR(day)
                    GirlTalkDanceDressHookDiscussed[$GirlTalkTavernDanceDressHookKey] = 1
                    killvar '$GirlTalkTavernDanceDressHookKey'
                end
            end
        end
    end
    end

    Friends[$GirlTalkTavernGirl] += 1
    management_skill += 1

    killvar '$GirlTalkTavernGirl'
    killvar 'GirlTalkTavernHallHookReady'
    killvar 'GirlTalkTavernPortShipHookReady'
    killvar 'GirlTalkTavernDayHookReady'
    killvar 'GirlTalkTavernRepairHookReady'
    killvar 'GirlTalkTavernDanceDressHookReady'
---

#GirlTalkTavernHasHallHook
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTavernHookGirl = $GirlKey

    GirlTalkTavernHallHookReady = 0

    if $GirlTalkTavernHookGirl = '':
        exit
    end

    if $LastHallChoiceGirl <> $GirlTalkTavernHookGirl:
        exit
    end

    if LastGirlChoiceDay[$GirlTalkTavernHookGirl] <> day:
        exit
    end

    $GirlTalkTavernHallHookKey = $GirlTalkTavernHookGirl + '_' + STR(day)

    if GirlTalkTavernHallHookDiscussed[$GirlTalkTavernHallHookKey] = 1:
        killvar '$GirlTalkTavernHookGirl'
        killvar '$GirlTalkTavernHallHookKey'
        exit
    end

    if $LastHallChoiceType = '' and $LastGirlChoiceType[$GirlTalkTavernHookGirl] = '':
        killvar '$GirlTalkTavernHookGirl'
        killvar '$GirlTalkTavernHallHookKey'
        exit
    end

    GirlTalkTavernHallHookReady = 1

    killvar '$GirlTalkTavernHookGirl'
    killvar '$GirlTalkTavernHallHookKey'
---

#GirlTalkTavernHasDayEventHook
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTavernHookGirl = $GirlKey

    GirlTalkTavernDayHookReady = 0

    if $GirlTalkTavernHookGirl = '':
        exit
    end

    if TavernDayEventActive = 0 or $TavernDayEventId = '':
        killvar '$GirlTalkTavernHookGirl'
        exit
    end

    $GirlTalkTavernDayHookKey = $GirlTalkTavernHookGirl + '_' + STR(day)

    if GirlTalkTavernDayHookDiscussed[$GirlTalkTavernDayHookKey] = 1:
        killvar '$GirlTalkTavernHookGirl'
        killvar '$GirlTalkTavernDayHookKey'
        exit
    end

    GirlTalkTavernDayHookReady = 1

    killvar '$GirlTalkTavernHookGirl'
    killvar '$GirlTalkTavernDayHookKey'
---

#GirlTalkTavernHasRepairHook
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTavernHookGirl = $GirlKey

    GirlTalkTavernRepairHookReady = 0

    if $GirlTalkTavernHookGirl = '':
        exit
    end

    if TavernRepairNeeded = 0 or TavernRepairOrdered = 1:
        killvar '$GirlTalkTavernHookGirl'
        exit
    end

    if $TavernRepairSource <> 'rats' and $TavernRepairSource <> 'brawl' and $TavernRepairSource <> 'broken':
        killvar '$GirlTalkTavernHookGirl'
        exit
    end

    $GirlTalkTavernRepairHookKey = $GirlTalkTavernHookGirl + '_' + STR(day)

    if GirlTalkTavernRepairHookDiscussed[$GirlTalkTavernRepairHookKey] = 1:
        killvar '$GirlTalkTavernHookGirl'
        killvar '$GirlTalkTavernRepairHookKey'
        exit
    end

    GirlTalkTavernRepairHookReady = 1

    killvar '$GirlTalkTavernHookGirl'
    killvar '$GirlTalkTavernRepairHookKey'
---

#GirlTalkTavernPrintText
    if $GirlTalkTavernGirl = '':
        $GirlTalkTavernGirl = $TalkGirl
    end

    gs 'GirlTalkTavernText', $ARGS[0]

    if $GirlTalkTavernText <> '':
        *p $GirlTalkTavernText
    end

    killvar '$GirlTalkTavernText'
---

#GirlTalkTavernHasDanceDressHook
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTavernHookGirl = $GirlKey

    GirlTalkTavernDanceDressHookReady = 0

    if $GirlTalkTavernHookGirl <> 'amanda' and $GirlTalkTavernHookGirl <> 'melissa':
        killvar '$GirlTalkTavernHookGirl'
        exit
    end

    if week <> 3 and week <> 4:
        killvar '$GirlTalkTavernHookGirl'
        exit
    end

    $GirlTalkTavernDanceDressKey = $GirlTalkTavernHookGirl + '_' + STR(day)

    if GirlTalkDanceDressHookDiscussed[$GirlTalkTavernDanceDressKey] = 1:
        killvar '$GirlTalkTavernHookGirl'
        killvar '$GirlTalkTavernDanceDressKey'
        exit
    end

    if $GirlTalkTavernHookGirl = 'amanda':
        if AmandaDanceDressReady = 1 or AmandaDanceDressSelfBought = 1:
            killvar '$GirlTalkTavernHookGirl'
            killvar '$GirlTalkTavernDanceDressKey'
            exit
        end

        if AmandaDanceDressFittingDue = 1:
            GirlTalkTavernDanceDressHookReady = 1
        elseif AmandaDanceDressAgreed = 1 and AmandaDanceDressOrdered = 0:
            GirlTalkTavernDanceDressHookReady = 1
        elseif AmandaDanceDressOrdered = 0 and Friends['amanda'] > 10:
            GirlTalkTavernDanceDressHookReady = 1
        end
    elseif $GirlTalkTavernHookGirl = 'melissa':
        if MelissaDanceDressReady = 1 or MelissaDanceDressSelfBought = 1:
            killvar '$GirlTalkTavernHookGirl'
            killvar '$GirlTalkTavernDanceDressKey'
            exit
        end

        if MelissaDanceDressFittingDue = 1:
            GirlTalkTavernDanceDressHookReady = 1
        elseif MelissaDanceDressAgreed = 1 and MelissaDanceDressOrdered = 0:
            GirlTalkTavernDanceDressHookReady = 1
        elseif MelissaDanceDressOrdered = 0 and Friends['melissa'] > 10:
            GirlTalkTavernDanceDressHookReady = 1
        end
    end

    killvar '$GirlTalkTavernHookGirl'
    killvar '$GirlTalkTavernDanceDressKey'
---

#GirlTalkTavernPrintDanceDressHint
    $DanceDressHintGirl = LCASE($ARGS[0])

    if $DanceDressHintGirl = 'amanda':
        if AmandaDanceDressFittingDue = 1:
            *pl ' '
            *pl '— Стефан, моё платье готово к примерке! — с нетерпением шепчет Аманда. — Пойдём к Ирме, я хочу поскорее его надеть!'
        elseif AmandaDanceDressAgreed = 1 and AmandaDanceDressOrdered = 0:
            *pl ' '
            *pl '— Ты помнишь, что мы договаривались сходить к Ирме насчёт платья? — тихо напоминает Аманда. — Пятница близко, модистка не успеет сшить, если мы затянем!'
        elseif AmandaDanceDressOrdered = 0 and Friends['amanda'] > 10:
            *pl ' '
            *pl '— Кстати, о пятнице... — Аманда чуть заминается, теребя край фартука. — На площади опять будут танцы. Все девчонки придут в новых платьях от Ирмы, а мне и пойти не в чем... Слушай, Стефан, выкроишь со мной часок заглянуть к модистке? Сама я не потяну, да и Ирма без тебя заказ не оформит.'
        end
    elseif $DanceDressHintGirl = 'melissa':
        if MelissaDanceDressFittingDue = 1:
            *pl ' '
            *pl '— Ирма передала, что ждёт нас на примерку, — спокойно говорит Мелисса, хотя в глазах пляшут искорки. — Надо зайти до вечера.'
        elseif MelissaDanceDressAgreed = 1 and MelissaDanceDressOrdered = 0:
            *pl ' '
            *pl '— Не забудь: мы собирались к модистке заказать наряд к пятнице, — замечает Мелисса. — Ирма берёт время на пошив, так что лучше не тянуть до последнего.'
        elseif MelissaDanceDressOrdered = 0 and Friends['melissa'] > 10:
            *pl ' '
            *pl '— И ещё кое-что, — Мелисса отрывается от счёта, бросая строгий, но чуть смущённый взгляд. — В пятницу вечером ярмарочная площадь встанет на уши из-за танцев. Появиться там в повседневном платье — значит расписаться в собственной несостоятельности. Если найдёшь время дойти со мной до лавки Ирмы, я выберу что-то строгое и приличное. Подумай об этом.'
        end
    end

    killvar '$DanceDressHintGirl'
---