! ================================================
! FILE: modules/actions/dialogs/girl_talk_town_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! MODULE: actions/dialogs
! Тексты городских разговоров (Жоржетта, Грета, Жюльетта, горожанки)
! ================================================

#GirlTalkTownLifeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTownLifeGirl = $GirlKey
    $GirlTalkTownLifeTextId = LCASE($ARGS[1])
    $GirlTalkTownLifeText = ''

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (ГОРОДСКАЯ СРЕДА, ОТКРОВЕНИЕ, РАСКОВАННОСТЬ)
    ! ----------------------------------------------------
    if $GirlTalkTownLifeTextId = 'intro':
        if $GirlTalkTownLifeGirl = 'georgett':
            if FamilyCorruptionStage >= 3 or otkroven['georgett'] >= 25:
                *pl 'Жоржетта лениво поправляет глубокий вырез платья, выставляя пышную грудь, и с насмешливой улыбкой скользит взглядом по твоим штанам между ног:'
                *pl ' '
                *pl '— О городе потолковать хочешь, Стефан? — она низко посмеивается, прикусив губу. — Или просто искал повод постоять рядом с красивой женщиной? Спрашивай. В этом городишке я знаю каждую щель и каждого мужика с тугим кошельком. Слушаю тебя.'
                *pl ' '
            else:
                *pl 'Жоржетта оглядывает улицу, щурясь на солнце, и заправляет локон за ухо:'
                *pl ' '
                *pl '— О городе? — она усмехается, глядя на тебя с лёгким прищуром. — Тут все друг друга знают, но правду говорят только за закрытыми дверями. Спрашивай, Стефан, пока у меня есть минутка.'
                *pl ' '
            end

        elseif $GirlTalkTownLifeGirl = 'greta':
            if FamilyCorruptionStage >= 3 or otkroven['greta'] >= 20:
                *pl 'Грета чуть смущённо поправляет платок, робко поднимая на тебя глаза и оглядываясь по сторонам:'
                *pl ' '
                *pl '— О городских делах?.. — она тихо вздыхает и делает шаг ближе. — Хорошо, Стефан. Рядом с тобой мне спокойнее. Спрашивай, я расскажу то, что слышала на рынке и у храма Ильматера.'
                *pl ' '
            else:
                *pl 'Грета осторожно перебирает край рукава и смотрит сдержанно:'
                *pl ' '
                *pl '— О городе? Я не так много знаю о шумной жизни... но если хочешь спросить — спрашивай, Стефан. Я отвечу, как сумею.'
                *pl ' '
            end

        elseif $GirlTalkTownLifeGirl = 'juliette':
            if FamilyCorruptionStage >= 3 or otkroven['juliette'] >= 20:
                *pl 'Жюльетта мягко улыбается, оглаживая юбку, и внимательно смотрит тебе прямо в глаза:'
                *pl ' '
                *pl '— Хочешь поговорить о городе? Я уже начинаю понимать здешние порядки. И знаешь, Стефан... хорошо, что в этом месте у меня есть к кому обратиться. Спрашивай, мне приятно с тобой болтать.'
                *pl ' '
            else:
                *pl 'Жюльетта слегка наклоняет голову, оценивающе глядя на тебя:'
                *pl ' '
                *pl '— О городе? — она пожимает плечами. — Я здесь человек сравнительно новый, только привыкаю к нравам фронтира. Но если интересно моё мнение — говори, послушаю.'
                *pl ' '
            end

        else:
            *pl '— О городе потолковать хочешь? — горожанка останавливается и поворачивается к тебе. — Слушаю тебя, Стефан.'
            *pl ' '
        end

    ! ----------------------------------------------------
    ! 2. ОСНОВНОЙ КОНТЕКСТ (СЛУХИ, ПОРТ, ТАЙНЫ ГОРОЖАН)
    ! ----------------------------------------------------
    elseif $GirlTalkTownLifeTextId = 'context':
        if $GirlTalkTownLifeGirl = 'georgett':
            if FamilyCorruptionStage >= 3 or otkroven['georgett'] >= 25:
                *pl 'Жоржетта делает шаг ближе, наклоняясь так, что из выреза едва не выкатывается грудь, и шепчет, обдавая тебя горячим дыханием:'
                *pl ' '
                *pl '— Этот городишко насквозь прогнил от похоти и жадности, Стефан. Днём благочестивые отцы семейств очерчивают святой круг Ильматера и толкуют о чести. А по ночам в портовых переулках те же самые купцы и капитаны задирают юбки портовым девкам и суют серебро дрожащими руками.'
                *pl ' '
                *pl 'Знаешь, почему мне здесь нравится? Потому что люди здесь не притворяются святыми, когда горит плоть. Держи свой кабак крепче — на чужих слабостях строятся самые богатые дома.'
                *pl ' '
            else:
                *pl 'Жоржетта складывает руки под грудью и насмешливо оглядывает площадь:'
                *pl ' '
                *pl '— В порту снова пристал чужой корабль с юга. Матросы сразу повалили в кабаки спускать жалование.'
                *pl ' '
                *pl 'В нашем маленьком городке сплетни летают быстрее чайки над волнами. Стоит кому-то оступиться — к вечеру весь рынок смакует подробности. Главное — не верить сладким речам заезжих моряков: они легко обещают золотые горы, а поутру отчаливают с первым приливом.'
                *pl ' '
            end

        elseif $GirlTalkTownLifeGirl = 'greta':
            if FamilyCorruptionStage >= 3 or otkroven['greta'] >= 20:
                *pl 'Грета опускает глаза, нервно теребя пуговицу на воротнике, и говорит полушёпотом:'
                *pl ' '
                *pl '— В городе сейчас такие разговоры, Стефан... На проповедях отец Герхард цитирует священные книги Ильматера и настойчиво призывает к скрещиванию и союзу плоти на фронтире. Прихожане слушают пастыря открыв рот — авторитет церкви ведь непререкаем, вот народ и шепчется на площади совсем без стыда. Говорят, в переулках по ночам творится такое, от чего у скромной девушки щёки горят.'
                *pl ' '
                *pl 'Иногда мне становится не по себе от этих речей... а иногда невольно думаешь: неужели открытая плотская страсть и правда так сладка? Ты только никому не говори, что я об этом размышляю.'
                *pl ' '
            else:
                *pl 'Грета говорит тихо и скромно, поглядывая на прохожих:'
                *pl ' '
                *pl '— Повседневная жизнь в городе идёт своим чередом. Утром женщины спешат к колодцу за водой, на рынке торгуются за рыбу и овощи, по воскресеньям весь город собирается у алтаря Ильматера.'
                *pl ' '
                *pl 'Люди здесь простые, не любят зазнаек и чужаков. Если вести себя скромно и не искать ссор — город примет и не обидит.'
                *pl ' '
            end

        elseif $GirlTalkTownLifeGirl = 'juliette':
            if FamilyCorruptionStage >= 3 or otkroven['juliette'] >= 20:
                *pl 'Жюльетта задумчиво оглядывает улицу и тихо говорит, чуть понизив голос:'
                *pl ' '
                *pl '— Этот фронтирный город кажется диким и грубым, но здесь всё честно. Мужчины смотрят прямо и без стеснения показывают, чего хотят. Одинокой девушке здесь трудно, если у неё нет надёжного защитника.'
                *pl ' '
                *pl 'Я вижу, как ты держишь свой трактир, Стефан. Ты сильный мужчина, и с каждым днём становишься увереннее в себе. Мне спокойно, когда ты рядом.'
                *pl ' '
            else:
                *pl 'Жюльетта поправляет прядь волос и говорит сдержанно:'
                *pl ' '
                *pl '— Город шумный, нравы здесь куда жёстче, чем в центральных провинциях. Моряки, торговцы, стражники — у каждого свой интерес и свои правила.'
                *pl ' '
                *pl 'Я стараюсь быть осторожной и не ходить по вечерам через тёмные переулки. Нужно время, чтобы пустить здесь корни.'
                *pl ' '
            end

        else:
            *pl 'Разговор о городских новостях — ярмарочные цены, сплетни с площади и морские вести.'
            *pl ' '
        end
    end

    killvar '$GirlTalkTownLifeGirl'
    killvar '$GirlTalkTownLifeTextId'
---
