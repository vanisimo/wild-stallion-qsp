! ================================================
! FILE: modules/actions/dialogs/girl_talk_town_text.qsps
! MODULE: actions/dialogs
! Тексты городских разговоров (Грета, Жюльетта, горожанки)
! ================================================

#GirlTalkTownLifeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTownLifeGirl = $GirlKey
    $GirlTalkTownLifeTextId = LCASE($ARGS[1])
    $GirlTalkTownLifeText = ''

    if $GirlTalkTownLifeTextId = 'intro':
        if $GirlTalkTownLifeGirl = 'georgett':
            $GirlTalkTownLifeText = '— Город? — усмехается Жоржетта. — Тут все друг друга знают. Спрашивай.'
        elseif $GirlTalkTownLifeGirl = 'greta':
            $GirlTalkTownLifeText = '— О городе? — тихо спрашивает Грета. — Я не много знаю... но спрашивай.'
        elseif $GirlTalkTownLifeGirl = 'juliette':
            $GirlTalkTownLifeText = '— Ты давно здесь? — спрашивает Жюльетта. — Я только привыкаю.'
        else:
            $GirlTalkTownLifeText = '— О городе? Слушаю.'
        end

    elseif $GirlTalkTownLifeTextId = 'context':
        if $GirlTalkTownLifeGirl = 'georgett':
            $GirlTalkTownLifeText = 'Жоржетта говорит о порте, о чужих кораблях и о том, как в маленьком городе сплетни ходят быстрее правды — и как приятно иногда быть темой лучших из них.'
        elseif $GirlTalkTownLifeGirl = 'greta':
            $GirlTalkTownLifeText = 'Грета рассказывает о повседневной городской жизни сдержанно, будто проверяет, можно ли тебе доверять хотя бы обычную болтовню.'
        elseif $GirlTalkTownLifeGirl = 'juliette':
            $GirlTalkTownLifeText = 'Жюльетта говорит о городе мягко и немного настороженно — ей важно понять, кто ты в этом месте, прежде чем рассказывать о себе больше.'
        else:
            $GirlTalkTownLifeText = 'Коротко о городе — без трактира и без исповедей.'
        end
    end

    killvar '$GirlTalkTownLifeGirl'
    killvar '$GirlTalkTownLifeTextId'
---
