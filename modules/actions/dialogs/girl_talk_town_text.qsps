! ================================================
! FILE: modules/actions/dialogs/girl_talk_town_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! MODULE: actions/dialogs
! Тексты городских разговоров (Жоржетта, Грета, Жюльетта, горожанки)
! ================================================

#GirlTalkTownLifeText
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkTownLifeGirl = $GirlKey
    $GirlTalkTownLifeTextId = LCASE($ARGS[1])
    $GirlTalkTownLifeText = ''

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (ГОРОДСКАЯ СРЕДА, ОТКРОВЕНИЕ, РАСКОВАННОСТЬ)
    ! ----------------------------------------------------
    if $GirlTalkTownLifeTextId = 'intro':
        if $GirlTalkTownLifeGirl = 'georgett':
            if FamilyCorruptionStage >= 3 or otkroven['georgett'] >= 25:
                $GirlTalkTownLifeText = 'Жоржетта лениво поправляет глубокий вырез платья, выставляя пышную грудь, и с насмешливой улыбкой скользит взглядом по твоим штанам между ног:<br><br>— О городе потолковать хочешь, Стефан? — она низко посмеивается, прикусив губу. — Или просто искал повод постоять рядом с красивой женщиной? Спрашивай. В этом городишке я знаю каждую щель и каждого мужика с тугим кошельком. Слушаю тебя.'
            else:
                $GirlTalkTownLifeText = 'Жоржетта оглядывает улицу, щурясь на солнце, и заправляет локон за ухо:<br><br>— О городе? — она усмехается, глядя на тебя с лёгким прищуром. — Тут все друг друга знают, но правду говорят только за закрытыми дверями. Спрашивай, Стефан, пока у меня есть минутка.'
            end

        elseif $GirlTalkTownLifeGirl = 'greta':
            if FamilyCorruptionStage >= 3 or otkroven['greta'] >= 20:
                $GirlTalkTownLifeText = 'Грета чуть смущённо поправляет платок, робко поднимая на тебя глаза и оглядываясь по сторонам:<br><br>— О городских делах?.. — она тихо вздыхает и делает шаг ближе. — Хорошо, Стефан. Рядом с тобой мне спокойнее. Спрашивай, я расскажу то, что слышала на рынке и у храма Ильматера.'
            else:
                $GirlTalkTownLifeText = 'Грета осторожно перебирает край рукава и смотрит сдержанно:<br><br>— О городе? Я не так много знаю о шумной жизни... но если хочешь спросить — спрашивай, Стефан. Я отвечу, как сумею.'
            end

        elseif $GirlTalkTownLifeGirl = 'juliette':
            if FamilyCorruptionStage >= 3 or otkroven['juliette'] >= 20:
                $GirlTalkTownLifeText = 'Жюльетта мягко улыбается, оглаживая юбку, и внимательно смотрит тебе прямо в глаза:<br><br>— Хочешь поговорить о городе? Я уже начинаю понимать здешние порядки. И знаешь, Стефан... хорошо, что в этом месте у меня есть к кому обратиться. Спрашивай, мне приятно с тобой болтать.'
            else:
                $GirlTalkTownLifeText = 'Жюльетта слегка наклоняет голову, оценивающе глядя на тебя:<br><br>— О городе? — она пожимает плечами. — Я здесь человек сравнительно новый, только привыкаю к нравам фронтира. Но если интересно моё мнение — говори, послушаю.'
            end

        else:
            $GirlTalkTownLifeText = '— О городе потолковать хочешь? — горожанка останавливается и поворачивается к тебе. — Слушаю тебя, Стефан.'
        end

    ! ----------------------------------------------------
    ! 2. ОСНОВНОЙ КОНТЕКСТ (СЛУХИ, ПОРТ, ТАЙНЫ ГОРОЖАН)
    ! ----------------------------------------------------
    elseif $GirlTalkTownLifeTextId = 'context':
        if $GirlTalkTownLifeGirl = 'georgett':
            if FamilyCorruptionStage >= 3 or otkroven['georgett'] >= 25:
                $GirlTalkTownLifeText = 'Жоржетта делает шаг ближе, наклоняясь так, что из выреза едва не выкатывается грудь, и шепчет, обдавая тебя горячим дыханием:<br><br>— Этот городишко насквозь прогнил от похоти и жадности, Стефан. Днём благочестивые отцы семейств очерчивают святой круг Ильматера и толкуют о чести. А по ночам в портовых переулках те же самые купцы и капитаны задирают юбки портовым девкам и суют серебро дрожащими руками. Знаешь, почему мне здесь нравится? Потому что люди здесь не притворяются святыми, когда горит плоть. Держи свой кабак крепче — на чужих слабостях строятся самые богатые дома.'
            else:
                $GirlTalkTownLifeText = 'Жоржетта складывает руки под грудью и насмешливо оглядывает площадь:<br><br>— В порту снова пристал чужой корабль с юга. Матросы сразу повалили в кабаки спускать жалование. В нашем маленьком городке сплетни летают быстрее чайки над волнами. Стоит кому-то оступиться — к вечеру весь рынок смакует подробности. Главное — не верить сладким речам заезжих моряков: они легко обещают золотые горы, а поутру отчаливают с первым приливом.'
            end

        elseif $GirlTalkTownLifeGirl = 'greta':
            if FamilyCorruptionStage >= 3 or otkroven['greta'] >= 20:
                $GirlTalkTownLifeText = 'Грета опускает глаза, нервно теребя пуговицу на воротнике, и говорит полушёпотом:<br><br>— В городе сейчас так тревожно, Стефан... На проповедях отец Герхард говорит о праведности и каре за распутство, но женщины на площади шепчутся совсем о другом. Говорят, в трактирах и переулках по ночам творится такое, от чего у скромной девушки щёки горят. Иногда мне становится страшно от этих историй... а иногда невольно думаешь: неужели запретное и правда так сладко? Ты только никому не говори, что я об этом размышляю.'
            else:
                $GirlTalkTownLifeText = 'Грета говорит тихо и скромно, поглядывая на прохожих:<br><br>— Повседневная жизнь в городе идёт своим чередом. Утром женщины спешат к колодцу за водой, на рынке торгуются за рыбу и овощи, по воскресеньям весь город собирается у алтаря Ильматера. Люди здесь простые, не любят зазнаек и чужаков. Если вести себя скромно и не искать ссор — город примет и не обидит.'
            end

        elseif $GirlTalkTownLifeGirl = 'juliette':
            if FamilyCorruptionStage >= 3 or otkroven['juliette'] >= 20:
                $GirlTalkTownLifeText = 'Жюльетта задумчиво оглядывает улицу и тихо говорит, чуть понизив голос:<br><br>— Этот фронтирный город кажется диким и грубым, но здесь всё честно. Мужчины смотрят прямо и без стеснения показывают, чего хотят. Одинокой девушке здесь трудно, если у неё нет надёжного защитника. Я вижу, как ты держишь свой трактир, Стефан. Ты сильный мужчина, и с каждым днём становишься увереннее в себе. Мне спокойно, когда ты рядом.'
            else:
                $GirlTalkTownLifeText = 'Жюльетта поправляет прядь волос и говорит сдержанно:<br><br>— Город шумный, нравы здесь куда жёстче, чем в центральных провинциях. Моряки, торговцы, стражники — у каждого свой интерес и свои правила. Я стараюсь быть осторожной и не ходить по вечерам через тёмные переулки. Нужно время, чтобы пустить здесь корни.'
            end

        else:
            $GirlTalkTownLifeText = 'Разговор о городских новостях — ярмарочные цены, сплетни с площади и морские вести.'
        end
    end

    killvar '$GirlTalkTownLifeGirl'
    killvar '$GirlTalkTownLifeTextId'
---
