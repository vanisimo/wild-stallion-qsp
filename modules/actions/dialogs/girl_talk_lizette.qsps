! ================================================
! FILE: modules/actions/dialogs/girl_talk_lizette.qsps
! MODULE: actions/dialogs
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! Меню и расширенные разговоры Лизетты в порту
! ================================================

#GirlTalkLizetteLoreBump
    $GirlTalkLizetteLoreCounter = $ARGS[0]

    if $GirlTalkLizetteLoreCounter = 'port':
        GirlTalkLizetteLoreSlot = LizetteTalkPortStory
        LizetteTalkPortStory += 1
        if LizetteTalkPortStory >= 4:
            LizetteTalkPortStory = 0
        end
    elseif $GirlTalkLizetteLoreCounter = 'bio':
        GirlTalkLizetteLoreSlot = LizetteTalkBioStory
        LizetteTalkBioStory += 1
        if LizetteTalkBioStory >= 3:
            LizetteTalkBioStory = 0
        end
    elseif $GirlTalkLizetteLoreCounter = 'gifts':
        GirlTalkLizetteLoreSlot = LizetteTalkGiftsStory
        LizetteTalkGiftsStory += 1
        if LizetteTalkGiftsStory >= 3:
            LizetteTalkGiftsStory = 0
        end
    elseif $GirlTalkLizetteLoreCounter = 'amanda':
        GirlTalkLizetteLoreSlot = LizetteTalkAmandaStory
        LizetteTalkAmandaStory += 1
        if LizetteTalkAmandaStory >= 3:
            LizetteTalkAmandaStory = 0
        end
    elseif $GirlTalkLizetteLoreCounter = 'mother':
        GirlTalkLizetteLoreSlot = LizetteTalkMotherStory
        LizetteTalkMotherStory += 1
        if LizetteTalkMotherStory >= 3:
            LizetteTalkMotherStory = 0
        end
    elseif $GirlTalkLizetteLoreCounter = 'intim':
        GirlTalkLizetteLoreSlot = LizetteTalkIntimStory
        LizetteTalkIntimStory += 1
        if LizetteTalkIntimStory >= 6:
            LizetteTalkIntimStory = 0
        end
    else:
        GirlTalkLizetteLoreSlot = 0
    end

    killvar '$GirlTalkLizetteLoreCounter'
---

#GirlTalkBuildLizetteMainMenu
    gs 'Menu.Destroy', 'GirlTalkMainMenu'
    gs 'Menu.Create', 'GirlTalkMainMenu'

    ! ==================== 1. ВАЖНЫЙ РАЗГОВОР (ЕСЛИ ЕСТЬ) ====================
    ! 1.1. Знакомство в порту (если ещё не говорили о корабле и столице)
    if LizetteTalkPortDone = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор', 'important'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', 'lizette', $TalkReturnLoc, 'port_talk'
        }
    ! 1.2. О влиянии на Аманду и уроках (если влияние выросло, но о том, чему учит девочек, ещё не говорили)
    elseif AmandaLizaInfluence >= 2 and LizetteTalkIntimDone = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор', 'important'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', 'lizette', $TalkReturnLoc, 'lizette_intim'
        }
    ! 1.3. О матери Жоржетте (если знает Жоржетту, но разговор о матери ещё не состоялся)
    elseif GeorgetteKnown = 1 and LizetteTalkMotherDone = 0 and Friends['lizette'] >= 6:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Важный разговор', 'important'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkResult', 'lizette', $TalkReturnLoc, 'lizette_mother'
        }
    end

    ! ==================== 2. ПОГОВОРИТЬ (ВСЕГДА) ====================
    gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Поговорить', 'talk'
    gs 'Menu.AddModule', 'GirlTalkMainMenu', {
        gt 'GirlTalkResult', 'lizette', $TalkReturnLoc, 'lizette_unified'
    }

    ! ==================== 3. СДЕЛАТЬ ПОДАРОК (ЕСЛИ ЕСТЬ) ====================
    if LOC('GirlTalkAppendGiftMenuItems') = 1:
        gs 'GirlTalkAppendGiftMenuItems'
    end
---

#GirlTalkLizetteUnifiedRun
    ! 1. Проверка лимита полезных разговоров:
    gs 'UsefulTalkCheck', 'lizette', 'lizette_unified'
    if UsefulTalkResult = 0:
        gs 'GirlTalkLizetteLimitReachedText'
        gs 'ClampGirlSocialStats', 'lizette'
        exit
    end

    ! 2. Регистрация полезного разговора:
    gs 'UsefulTalkRegister', 'lizette', 'lizette_unified'

    ! 3. Иерархия тем разговора:
    ! --- Пик откровения (предел) ---
    if otkroven['lizette'] >= 25 and (HadSex['lizette'] > 0 or LizetteSexUnlocked = 1) and LizetteMemoryLimitDone = 0:
        gs 'GirlTalkLizetteMemoryLimitRun'

    ! --- Воспоминание о ночи в порту ---
    elseif HadSex['lizette'] > 0 and otkroven['lizette'] >= 18 and LizetteMemoryPortSexDone = 0:
        gs 'GirlTalkLizetteMemoryPortSexRun'

    ! --- Воспоминание о подглядывании в соборе ---
    elseif LizettePriestSpySeen = 1 and otkroven['lizette'] >= 14 and LizetteMemoryChurchSpyDone = 0:
        gs 'GirlTalkLizetteMemoryChurchSpyRun'

    ! --- Воспоминание о дружбе с Амандой ---
    elseif AmandaMetLizette = 1 and AmandaLizaInfluence >= 5 and otkroven['lizette'] >= 10 and LizetteMemoryAmandaDone = 0:
        gs 'GirlTalkLizetteMemoryAmandaRun'

    ! --- Первые последовательные открытия лора ---
    elseif LizetteTalkBioDone = 0:
        gs 'GirlTalkLizetteBioRun'

    elseif LizetteTalkPortDone = 0:
        gs 'GirlTalkLizettePortRun'

    elseif LizetteTalkGiftsDone = 0 and Friends['lizette'] >= 6:
        gs 'GirlTalkLizetteGiftsRun'

    elseif LizetteTalkAmandaDone = 0 and (AmandaMetLizette = 1 or PortMeetWitnessed = 1):
        gs 'GirlTalkLizetteAmandaRun'

    elseif LizetteTalkMotherDone = 0 and GeorgetteKnown = 1:
        gs 'GirlTalkLizetteMotherRun'

    elseif LizetteTalkIntimDone = 0 and AmandaLizaInfluence >= 2:
        gs 'GirlTalkLizetteIntimRun'

    ! --- Повторяющаяся ротация богатых лор-пулов (все 6 пулов сохраняются) ---
    else:
        LizetteLorePoolCycle += 1
        if LizetteLorePoolCycle > 5:
            LizetteLorePoolCycle = 0
        end

        if LizetteLorePoolCycle = 0:
            gs 'GirlTalkLizetteBioRun'
        elseif LizetteLorePoolCycle = 1:
            gs 'GirlTalkLizettePortRun'
        elseif LizetteLorePoolCycle = 2:
            gs 'GirlTalkLizetteGiftsRun'
        elseif LizetteLorePoolCycle = 3:
            gs 'GirlTalkLizetteAmandaRun'
        elseif LizetteLorePoolCycle = 4:
            gs 'GirlTalkLizetteMotherRun'
        else:
            if AmandaLizaInfluence >= 2:
                gs 'GirlTalkLizetteIntimRun'
            else:
                gs 'GirlTalkLizetteGiftsRun'
            end
        end
    end

    ! --- Дополнительные действия на экране разговора ---
    if $TalkReturnLoc = 'Port' and time = 5 and LizettePortNightGone = 0 and LizetteSexUnlocked = 1:
        gs 'PortNightGirlVisible', 'lizette'

        if PortNightGirlVisible = 1:
            gs 'ActUiPrepare', 'Провести ночь с Лизеттой (10 спинтарий)', 'intim'
            act $ActUiLabel, $ActUiIconPath:
                gt 'PortProstNightHire', 'Port', 'lizette'
            end
        end

        killvar 'PortNightGirlVisible'
    end

    $ComplimentActKey = 'lizette_' + STR(day)
    if (Friends['lizette'] >= 12 or love['lizette'] >= 10 or otkroven['lizette'] >= 12) and GirlComplimentDay[$ComplimentActKey] = 0:
        gs 'ActUiPrepare', 'Сделать комплимент', 'flirt'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GirlTalkResult', 'lizette', $TalkReturnLoc, 'compliment'
        end
    end
    killvar '$ComplimentActKey'

    if GiftInventory['gift_cheap'] > 0 or GiftInventory['gift_expensive'] > 0:
        gs 'ActUiPrepare', 'Сделать подарок', 'gift'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GirlTalkResult', 'lizette', $TalkReturnLoc, 'gift'
        end
    end

    gs 'ClampGirlSocialStats', 'lizette'
---

#GirlTalkLizetteMemoryLimitRun
    gs 'GirlTalkLizetteMemoryLimitText'

    if LizetteMemoryLimitDone = 0:
        LizetteMemoryLimitDone = 1
        love['lizette'] += 2
        otkroven['lizette'] += 2
        Friends['lizette'] += 1
    else:
        love['lizette'] += 1
        otkroven['lizette'] += 1
    end
---

#GirlTalkLizetteMemoryPortSexRun
    gs 'GirlTalkLizetteMemoryPortSexText'
    LizetteMemoryPortSexDone = 1
    love['lizette'] += 2
    otkroven['lizette'] += 1
---

#GirlTalkLizetteMemoryChurchSpyRun
    gs 'GirlTalkLizetteMemoryChurchSpyText'
    LizetteMemoryChurchSpyDone = 1
    otkroven['lizette'] += 2
    Friends['lizette'] += 1
---

#GirlTalkLizetteMemoryAmandaRun
    gs 'GirlTalkLizetteMemoryAmandaText'
    LizetteMemoryAmandaDone = 1
    otkroven['lizette'] += 1
    Friends['lizette'] += 1
---

#GirlTalkLizettePortRun
    gs 'GirlTalkLizetteLoreBump', 'port'
    gs 'GirlTalkLizettePrintText', 'lizette_port', 'intro'
    gs 'GirlTalkLizettePrintText', 'lizette_port', 'milestone'
    gs 'GirlTalkLizettePrintText', 'lizette_port', 'context'

    LizetteTalkPortDone = 1
    LizetteKnown = 1
    Friends['lizette'] += 1
    trading += 1

    gs 'ClampGirlSocialStats', 'lizette'
---

#GirlTalkLizetteBioRun
    gs 'GirlTalkLizetteLoreBump', 'bio'
    gs 'GirlTalkLizettePrintText', 'lizette_bio', 'intro'
    gs 'GirlTalkLizettePrintText', 'lizette_bio', 'milestone'
    gs 'GirlTalkLizettePrintText', 'lizette_bio', 'context'

    LizetteTalkBioDone = 1
    Friends['lizette'] += 1
    otkroven['lizette'] += 1

    gs 'ClampGirlSocialStats', 'lizette'
---

#GirlTalkLizetteGiftsRun
    gs 'GirlTalkLizetteLoreBump', 'gifts'
    gs 'GirlTalkLizettePrintText', 'lizette_gifts', 'intro'
    gs 'GirlTalkLizettePrintText', 'lizette_gifts', 'milestone'
    gs 'GirlTalkLizettePrintText', 'lizette_gifts', 'context'

    LizetteTalkGiftsDone = 1
    Friends['lizette'] += 1
    trading += 1

    gs 'ClampGirlSocialStats', 'lizette'
---

#GirlTalkLizetteAmandaRun
    gs 'GirlTalkLizetteLoreBump', 'amanda'
    gs 'GirlTalkLizettePrintText', 'lizette_amanda', 'intro'
    gs 'GirlTalkLizettePrintText', 'lizette_amanda', 'milestone'
    gs 'GirlTalkLizettePrintText', 'lizette_amanda', 'context'

    LizetteTalkAmandaDone = 1
    Friends['lizette'] += 1
    AmandaLizaInfluence += 1

    if AmandaLizaInfluence > 100:
        AmandaLizaInfluence = 100
    end

    gs 'ClampGirlSocialStats', 'lizette'
---

#GirlTalkLizetteMotherRun
    gs 'GirlTalkLizetteLoreBump', 'mother'
    gs 'GirlTalkLizettePrintText', 'lizette_mother', 'intro'
    gs 'GirlTalkLizettePrintText', 'lizette_mother', 'milestone'
    gs 'GirlTalkLizettePrintText', 'lizette_mother', 'context'

    LizetteTalkMotherDone = 1
    Friends['lizette'] += 1

    gs 'ClampGirlSocialStats', 'lizette'
---

#GirlTalkLizetteIntimRun
    gs 'GirlTalkLizetteLoreBump', 'intim'
    gs 'GirlTalkLizettePrintText', 'lizette_intim', 'intro'
    gs 'GirlTalkLizettePrintText', 'lizette_intim', 'milestone'
    gs 'GirlTalkLizettePrintText', 'lizette_intim', 'context'

    LizetteTalkIntimDone = 1
    Friends['lizette'] += 1
    otkroven['lizette'] += 1

    if AmandaLizaInfluence < 100:
        AmandaLizaInfluence += 1
    end

    gs 'AmandaOralTryAdvanceFromLizette', GirlTalkLizetteLoreSlot

    gs 'ClampGirlSocialStats', 'lizette'
---

#GirlTalkLizettePrintText
    gs 'GirlTalkLizetteText', $ARGS[0], $ARGS[1]

    if $GirlTalkLizetteText <> '':
        *pl $GirlTalkLizetteText
        *pl ' '
    end

    killvar '$GirlTalkLizetteText'
---
