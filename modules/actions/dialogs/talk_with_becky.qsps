! ================================================
! FILE: modules/actions/dialogs/talk_with_becky.qsps
! MODULE: actions/dialogs
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.10.2026
! Совместимость и особые диалоги Бекки
! ================================================

#TalkWithBecky
    gt 'BeckyShop'
---

#BeckyTalkDexterityOil
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'МАЗЬ «ЛОВКИЕ ПАЛЬЦЫ»'
    gs 'SceneShowVisual', 'images/locations/shops/becky_shop/becky', 'Бекки в лавке', 'large', 'webp'

    PlayerHasDexterityOil = 1
    gs 'BeckyTalkDexterityOilText'
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShop'
    end
---
