    ! ==================== ИРМА ====================
    if $TalkGirl = 'irma':
        if LOC('IrmaUniformOfferCanStart') = 1:
            gs 'IrmaUniformOfferCanStart'
            if IrmaUniformOfferCanStart = 1:
                if IrmaUniformOfferDeclined = 0:
                    $IrmaOfferTitle = 'Предложение Ирмы по форме'
                else:
                    $IrmaOfferTitle = 'Разговор о форме'
                end
                gs 'MenuUiAdd', 'GirlTalkMainMenu', $IrmaOfferTitle, 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'IrmaUniformOfferStart', $TalkReturnLoc
                }
                killvar '$IrmaOfferTitle'
