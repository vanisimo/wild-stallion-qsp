            if MelissaFirstPathChoiceCanStart = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О менестреле и ваших отношениях', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'MelissaFirstPathChoiceStart', $TalkReturnLoc
                }
            end
            killvar 'MelissaFirstPathChoiceCanStart'
        end

        if LOC('MelissaProhibitMinstrelTalkCanOffer') = 1:
            gs 'MelissaProhibitMinstrelTalkCanOffer'
            if MelissaProhibitMinstrelTalkCanOffer = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О запрете встреч с менестрелем', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'MelissaProhibitMinstrelTalk', $TalkReturnLoc
                }
            end
            killvar 'MelissaProhibitMinstrelTalkCanOffer'
