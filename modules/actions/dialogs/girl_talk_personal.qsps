! ================================================
! FILE: modules/actions/dialogs/girl_talk_personal.qsps
! MODULE: actions/dialogs
! Личные и важные разговоры: сюжет, зал, лор
! Кнопка «Личный разговор» в корне — только если есть хотя бы один пункт внутри
! ================================================

#GirlTalkPersonalOpenSubmenu
    GirlTalkPersonalMenuActive = 1
    GirlTalkAutoOpenTalkMenu = 1
    gt 'GirlTalk', $TalkGirl, $TalkReturnLoc
---

#GirlTalkRootAppendPersonalMenu
    if GirlTalkPersonalAvailable = 1:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', '★ Важный разговор', 'talk'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gs 'GirlTalkPersonalOpenSubmenu'
        }
    end
---

#GirlTalkPersonalCountHallTopics
    ! thin hall follow-up: policy after harass уже на сцене.
    ! «Что случилось» / «Моё решение» в личном меню не считаем (дубль after-screen).
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkPersonalHallGirl = $GirlKey
    GirlTalkPersonalHallTopicsCount = 0

    if $GirlTalkPersonalHallGirl = '':
        killvar '$GirlTalkPersonalHallGirl'
        exit
    end

    ! «Как она выполнила правило» — только если policy-response реально ждёт разговора
    if LOC('GirlPolicyResponseTalkCanDiscuss') = 1:
        gs 'GirlPolicyResponseTalkCanDiscuss', $GirlTalkPersonalHallGirl
        if GirlPolicyResponseTalkAvailable = 1:
            GirlTalkPersonalHallTopicsCount += 1
        end
    end

    ! «Реакция семьи» — чужая реакция, не дубль policy after harass
    if LOC('HallFamilyReactionCanDiscuss') = 1:
        gs 'HallFamilyReactionCanDiscuss', $GirlTalkPersonalHallGirl
        if HallFamilyReactionAvailable = 1:
            GirlTalkPersonalHallTopicsCount += 1
        end
    end

    killvar '$GirlTalkPersonalHallGirl'
---

#GirlTalkPersonalAddHallTopicsToMenu
    ! Убрано: «Что случилось в зале» (hall_event) — после harass уже итог + policy.
    ! Убрано: «Моё решение в зале» (hall_choice) — protect/watch уже отыгран на сцене;
    !   текст HallChoiceFamilyTalk остаётся в файлах (debug / future), не в меню.

    if LOC('GirlPolicyResponseTalkCanDiscuss') = 1:
        gs 'GirlPolicyResponseTalkCanDiscuss', $TalkGirl
        if GirlPolicyResponseTalkAvailable = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Как она выполнила правило', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkHallTopicStart', $TalkGirl, $TalkReturnLoc, 'hall_policy'
            }
        end
    end

    if LOC('HallFamilyReactionCanDiscuss') = 1:
        gs 'HallFamilyReactionCanDiscuss', $TalkGirl
        if HallFamilyReactionAvailable = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Реакция семьи', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkHallTopicStart', $TalkGirl, $TalkReturnLoc, 'hall_family'
            }
        end
    end
---

#GirlTalkPersonalAddArcTopicsToMenu
    ! Общая тема: недавняя ссора / примирение
    if GirlConflictLevel[$TalkGirl] > 0 and GirlConflictUntilDay[$TalkGirl] < day and GirlConflictAfterTalkLevel[$TalkGirl] < GirlConflictLevel[$TalkGirl]:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Поговорить о недавней ссоре', 'talk'
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlConflictAfterTalk', $TalkGirl, $TalkReturnLoc
        }
    end

    ! ==================== АМАНДА ====================
    if $TalkGirl = 'amanda':
        if AmandaLegareTalkReady = 1 and LOC('AmandaTalkAboutLegare') = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О визите купца Легаре', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'AmandaTalkAboutLegare', $TalkReturnLoc
            }
        end

        if LOC('AmandaLegarePrivateAftermathCanTalk') = 1:
            gs 'AmandaLegarePrivateAftermathCanTalk'
            if AmandaLegarePrivateAftermathCanTalk = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О ночном разговоре с Легаре', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'AmandaLegarePrivateAftermath', $TalkReturnLoc
                }
            end
            killvar 'AmandaLegarePrivateAftermathCanTalk'
        end

        if LOC('AmandaLegareOutsideAftermathCanTalk') = 1:
            gs 'AmandaLegareOutsideAftermathCanTalk'
            if AmandaLegareOutsideAftermathCanTalk = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О встрече с Легаре у трактира', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'AmandaLegareOutsideAftermath', $TalkReturnLoc
                }
            end
            killvar 'AmandaLegareOutsideAftermathCanTalk'
        end

        if AmandaPathChoiceDone = 0 and LOC('AmandaPathChoiceCanStart') = 1:
            gs 'AmandaPathChoiceCanStart'
            if AmandaPathChoiceCanStart = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О Легаре и ваших отношениях', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
