#GirlTalkPersonalBanOptionsCount
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkPersonalBanGirl = $GirlKey
    GirlTalkPersonalBanOptionsCount = 0

    if $GirlTalkPersonalBanGirl = 'amanda':
        if AmandaMetLizette = 1 or LizetteKnown = 1:
            GirlTalkPersonalBanOptionsCount += 1
        end

        if AmandaLegareInterest >= 1 or AmandaLegareTalkDone = 1 or Fact_AmandaLegareOutsideMeet = 1 or FactHappened['amanda_dancewithlegare_1'] = 1 or AmandaLegareStreetInterceptDone = 1 or AmandaLegareBackyardDone = 1:
            GirlTalkPersonalBanOptionsCount += 1
        end

        ! парни: не с первого дня — только если уже есть повод / запрет уже стоит (снять)
        gs 'GirlTalkPersonalGuysBanCanShow', 'amanda'
        if GirlTalkPersonalGuysBanCanShow = 1:
            GirlTalkPersonalBanOptionsCount += 1
        end
        killvar 'GirlTalkPersonalGuysBanCanShow'
    end

    killvar '$GirlTalkPersonalBanGirl'
---

#GirlTalkPersonalGuysBanCanShow
    ! Запрет парней — после unlock amanda_boys / соседских следов / уже включённого запрета
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkGuysBanGirl = $GirlKey
    GirlTalkPersonalGuysBanCanShow = 0

    if $GirlTalkGuysBanGirl <> 'amanda':
        killvar '$GirlTalkGuysBanGirl'
        exit
    end

    if AmandaProhibitGuys = 1:
        GirlTalkPersonalGuysBanCanShow = 1
        killvar '$GirlTalkGuysBanGirl'
        exit
