    if LOC('SandraStaffGirlsReactionCanTalk') = 1:
        gs 'SandraStaffGirlsReactionCanTalk', $TalkGirl
        if SandraStaffGirlsReactionCanTalk = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О помощницах', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'SandraStaffGirlsReactionTalk', $TalkGirl, $TalkReturnLoc
            }
        end
    end

    ! ==================== КЛАРИССА ====================
    if $TalkGirl = 'clarissa':
        if ClarissaPaternityTalkDone = 0:
            if (PlayerKnows_ClarissaNotLegareDaughter = 1 or PlayerKnows_ClarissaLegareDarkBackstory = 1 or AlberVar['hearabouthiswife'] = 1 or MelissaClarissaTalkPhraseHeard['clarissa_legare_dark_backstory'] = 1) and (Friends['clarissa'] >= 8 or otkroven['clarissa'] >= 10 or love['clarissa'] >= 4):
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О её браке с Альбером и прошлом', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'GirlTalkResult', $TalkGirl, $TalkReturnLoc, 'clarissa_paternity'
                }
            end
        end

        if ClarissaTalkAboutAmandaReady = 1 and ClarissaTalkAboutAmandaDone = 0 and LOC('ClarissaTalkAboutLegareAmanda') = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О Легаре и Аманде', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'ClarissaTalkAboutLegareAmanda', $TalkReturnLoc
            }
        end

        if Fact_AmandaLegarePrivateTalk = 1 and ClarissaAmandaLegarePrivateTalkDiscussed = 0 and LOC('ClarissaTalkAboutAmandaLegarePrivate') = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О личном разговоре Легаре с Амандой', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'ClarissaTalkAboutAmandaLegarePrivate', $TalkReturnLoc
            }
        end

        if ClarissaAmandaLegareOutsideTalkReady = 1 and ClarissaAmandaLegareOutsideTalkDiscussed = 0 and LOC('ClarissaTalkAboutAmandaLegareOutside') = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О том, что Легаре искал Аманду', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'ClarissaTalkAboutAmandaLegareOutside', $TalkReturnLoc
            }
        end

        if ClarissaAmandaLegareMajorRiskTalkReady = 1 and ClarissaAmandaLegareMajorRiskDiscussed = 0 and LOC('ClarissaTalkAboutAmandaLegareMajor') = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О том, что случилось с Амандой', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'ClarissaTalkAboutAmandaLegareMajor', $TalkReturnLoc
            }
        end

        if ClarissaLegareConflictTalkReady = 1 and ClarissaLegareConflictTalkDone = 0 and LOC('ClarissaTalkAboutLegareFirstConflict') = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О поведении Легаре в трактире', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'ClarissaTalkAboutLegareFirstConflict', $TalkReturnLoc
            }
        end

        if ClarissaSupplyTalkReady = 1 and LOC('ClarissaTalkAboutSupplyRoute') = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О тайных поставках', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'ClarissaTalkAboutSupplyRoute', $TalkReturnLoc
            }
        end

        if LOC('MarkClarissaSupplyAftermathReady') = 1:
            gs 'MarkClarissaSupplyAftermathReady'
            if ClarissaSupplyAftermathReady = 1 and LOC('ClarissaTalkAboutSupplyAftermath') = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О риске тайных поставок', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'ClarissaTalkAboutSupplyAftermath', $TalkReturnLoc
                }
            end
            killvar 'ClarissaSupplyAftermathReady'
        end

        if ClarissaLegareSuspicionTalkReady = 1 and ClarissaLegareSuspicionTalkDone = 0 and LOC('ClarissaTalkAboutLegareSuspicion') = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О подозрениях Легаре', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'ClarissaTalkAboutLegareSuspicion', $TalkReturnLoc
            }
        end

        if LOC('ClarissaLegareReconcileCanStart') = 1:
            gs 'ClarissaLegareReconcileCanStart'
            if ClarissaLegareReconcileCanStart = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О примирении с Альбером', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'ClarissaLegareReconcileStart'
                }
            end
            killvar 'ClarissaLegareReconcileCanStart'
        end
    end

    ! ==================== ИНГА ====================
    if $TalkGirl = 'inga':
        if LOC('IngaGuardComplaintCanStart') = 1:
            gs 'IngaGuardComplaintCanStart'
            if IngaGuardComplaintCanStart = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Спросить о проблеме со стражником', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'IngaGuardComplaintStart'
                }
            end
            killvar 'IngaGuardComplaintCanStart'
