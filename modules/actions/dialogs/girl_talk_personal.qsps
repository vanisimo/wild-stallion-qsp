            if DanceDressEscortCanStart = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Идти к Ирме за платьем', 'travel'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'IrmaDanceDressEscortStart', 'melissa', $TalkReturnLoc
                }
            end
            killvar 'DanceDressEscortCanStart'
        end

        if LOC('DanceDressFittingEscortCanStart') = 1:
            gs 'DanceDressFittingEscortCanStart', 'melissa'
            if DanceDressFittingEscortCanStart = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Примерка платья у Ирмы', 'shop'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'IrmaDanceDressEscortStart', 'melissa', $TalkReturnLoc
                }
            end
            killvar 'DanceDressFittingEscortCanStart'
        end

        if LOC('DanceDressTalkCanStart') = 1:
            gs 'DanceDressTalkCanStart', 'melissa'
            if DanceDressTalkCanStart = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Платье для танцев', 'gift'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'GirlTalkResult', 'melissa', $TalkReturnLoc, 'dance_dress'
                }
            end
            killvar 'DanceDressTalkCanStart'
        end
    end

    ! ==================== САНДРА ====================
    if $TalkGirl = 'sandra':
        if LOC('SandraBirthRevealCanTalk') = 1:
            gs 'SandraBirthRevealCanTalk'
            if SandraBirthRevealCanTalk = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О том, что случилось в зале', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'SandraTalkAboutBirthSecret', $TalkReturnLoc
                }
            end
        end

        if LOC('SandraLermontLetterCanTalk') = 1:
            gs 'SandraLermontLetterCanTalk'
            if SandraLermontLetterCanTalk = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О письме в сундуке', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'SandraTalkAboutLermontLetter', $TalkReturnLoc
                }
