            if IngaBeckyLucasGossipCanStart = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Спросить про Лукаса и заднюю', 'talk'
                gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                    gt 'IngaBeckyLucasGossipStart'
