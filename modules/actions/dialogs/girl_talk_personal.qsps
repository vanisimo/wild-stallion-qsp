! ================================================
! FILE: modules/actions/dialogs/girl_talk_personal.qsps
! MODULE: actions/dialogs
! Личные и важные разговоры: сюжет, зал, лор
! Кнопка «Личный разговор» в корне — только если есть хотя бы один пункт внутри
! ================================================

#GirlTalkPersonalOpenSubmenu
    GirlTalkPersonalMenuActive = 1
    GirlTalkAutoOpenTalkMenu = 1
    gt 'GirlTalk', $TalkGirl, $TalkReturnLoc
---

#GirlTalkRootAppendPersonalMenu
    if GirlTalkPersonalAvailable = 1:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Личный разговор', ''
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gs 'GirlTalkPersonalOpenSubmenu'
        }
    end
---

#GirlTalkPersonalCountHallTopics
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkPersonalHallGirl = $GirlKey
    GirlTalkPersonalHallTopicsCount = 0

    if $GirlTalkPersonalHallGirl = '':
        killvar '$GirlTalkPersonalHallGirl'
        exit
    end

    if $LastHallEventType = 'harassment' and $LastHallEventGirl = $GirlTalkPersonalHallGirl and HallEventDiscussed[$GirlTalkPersonalHallGirl] = 0:
        GirlTalkPersonalHallTopicsCount += 1
    end

    if LOC('GirlPolicyResponseTalkCanDiscuss') = 1:
        gs 'GirlPolicyResponseTalkCanDiscuss', $GirlTalkPersonalHallGirl
        if GirlPolicyResponseTalkAvailable = 1:
            GirlTalkPersonalHallTopicsCount += 1
        end
    end

    if LOC('HallChoiceFamilyTalkCanDiscuss') = 1:
        gs 'HallChoiceFamilyTalkCanDiscuss', $GirlTalkPersonalHallGirl
        if HallChoiceFamilyTalkAvailable = 1:
            GirlTalkPersonalHallTopicsCount += 1
        end
    end

    if LOC('HallFamilyReactionCanDiscuss') = 1:
        gs 'HallFamilyReactionCanDiscuss', $GirlTalkPersonalHallGirl
        if HallFamilyReactionAvailable = 1:
            GirlTalkPersonalHallTopicsCount += 1
        end
    end

    if LOC('HallRecentTalkCanDiscuss') = 1:
        gs 'HallRecentTalkCanDiscuss', $GirlTalkPersonalHallGirl
        if HallRecentTalkAvailable = 1:
            GirlTalkPersonalHallTopicsCount += 1
        end
    end

    killvar '$GirlTalkPersonalHallGirl'
---

#GirlTalkPersonalAddHallTopicsToMenu
    if $LastHallEventType = 'harassment' and $LastHallEventGirl = $TalkGirl and HallEventDiscussed[$TalkGirl] = 0:
        gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Что случилось в зале', ''
        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkHallTopicStart', $TalkGirl, $TalkReturnLoc, 'hall_event'
        }
    end

    if LOC('GirlPolicyResponseTalkCanDiscuss') = 1:
        gs 'GirlPolicyResponseTalkCanDiscuss', $TalkGirl
        if GirlPolicyResponseTalkAvailable = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Как она выполнила правило', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkHallTopicStart', $TalkGirl, $TalkReturnLoc, 'hall_policy'
            }
        end
    end

    if LOC('HallChoiceFamilyTalkCanDiscuss') = 1:
        gs 'HallChoiceFamilyTalkCanDiscuss', $TalkGirl
        if HallChoiceFamilyTalkAvailable = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Моё решение в зале', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkHallTopicStart', $TalkGirl, $TalkReturnLoc, 'hall_choice'
            }
        end
    end

    if LOC('HallFamilyReactionCanDiscuss') = 1:
        gs 'HallFamilyReactionCanDiscuss', $TalkGirl
        if HallFamilyReactionAvailable = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Реакция семьи', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkHallTopicStart', $TalkGirl, $TalkReturnLoc, 'hall_family'
            }
        end
    end

    if LOC('HallRecentTalkCanDiscuss') = 1:
        gs 'HallRecentTalkCanDiscuss', $TalkGirl
        if HallRecentTalkAvailable = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Недавний случай в зале', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkHallTopicStart', $TalkGirl, $TalkReturnLoc, 'hall_recent'
            }
        end
    end
---

#GirlTalkPersonalAddArcTopicsToMenu
    if $TalkGirl = 'sandra' and LOC('SandraBirthRevealCanTalk') = 1:
        gs 'SandraBirthRevealCanTalk'

        if SandraBirthRevealCanTalk = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О том, что случилось в зале', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'SandraTalkAboutBirthSecret', $TalkReturnLoc
            }
        end
    end

    if $TalkGirl = 'sandra' and LOC('SandraLermontLetterCanTalk') = 1:
        gs 'SandraLermontLetterCanTalk'

        if SandraLermontLetterCanTalk = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О письме в сундуке', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'SandraTalkAboutLermontLetter', $TalkReturnLoc
            }
        end
    end

    if $TalkGirl = 'sandra' and LOC('SandraStaffHireCanTalk') = 1:
        gs 'SandraStaffHireCanTalk'

        if SandraStaffHireCanTalk = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О помощницах для трактира', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'SandraStaffHireTalk', $TalkReturnLoc
            }
        end
    end

    if LOC('SandraStaffGirlsReactionCanTalk') = 1:
        gs 'SandraStaffGirlsReactionCanTalk', $TalkGirl

        if SandraStaffGirlsReactionCanTalk = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О помощницах', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'SandraStaffGirlsReactionTalk', $TalkGirl, $TalkReturnLoc
            }
        end
    end

    if $TalkGirl = 'sandra' and LOC('SandraBeckyCrisisCanTalk') = 1:
        gs 'SandraBeckyCrisisCanTalk'

        if SandraBeckyCrisisCanTalk = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Выяснение отношений', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'SandraBeckyCrisisStart'
            }
        end
    end

    if $TalkGirl = 'sandra' and LOC('FamilyCouncilMomHintCanTalk') = 1:
        gs 'FamilyCouncilMomHintCanTalk'

        if FamilyCouncilMomHintCanTalk = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Нам нужно поговорить', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyCouncilMomHintTalk'
            }
        end
    end
---

#GirlTalkPersonalCheckAvailable
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkPersonalGirl = $GirlKey

    GirlTalkPersonalAvailable = 0
    GirlTalkPersonalStoryCount = 0
    GirlTalkPersonalMinOtkroven = 20

    if $GirlTalkPersonalGirl = '':
        killvar '$GirlTalkPersonalGirl'
        exit
    end

    if $GirlTalkPersonalGirl = 'amanda':
        GirlTalkPersonalMinOtkroven = 14
    elseif $GirlTalkPersonalGirl = 'melissa':
        GirlTalkPersonalMinOtkroven = 16
    elseif $GirlTalkPersonalGirl = 'sandra':
        GirlTalkPersonalMinOtkroven = 18
    end

    gs 'GirlTalkPersonalCountHallTopics', $GirlTalkPersonalGirl
    GirlTalkPersonalStoryCount += GirlTalkPersonalHallTopicsCount
    killvar 'GirlTalkPersonalHallTopicsCount'

    if $GirlTalkPersonalGirl = 'sandra':
        if LOC('SandraBirthRevealCanTalk') = 1:
            gs 'SandraBirthRevealCanTalk'
            if SandraBirthRevealCanTalk = 1:
                GirlTalkPersonalStoryCount += 1
            end
        end

        if LOC('SandraLermontLetterCanTalk') = 1:
            gs 'SandraLermontLetterCanTalk'
            if SandraLermontLetterCanTalk = 1:
                GirlTalkPersonalStoryCount += 1
            end
        end

        if LOC('SandraStaffHireCanTalk') = 1:
            gs 'SandraStaffHireCanTalk'
            if SandraStaffHireCanTalk = 1:
                GirlTalkPersonalStoryCount += 1
            end
        end

        if LOC('SandraBeckyCrisisCanTalk') = 1:
            gs 'SandraBeckyCrisisCanTalk'
            if SandraBeckyCrisisCanTalk = 1:
                GirlTalkPersonalStoryCount += 1
            end
        end

        if LOC('FamilyCouncilMomHintCanTalk') = 1:
            gs 'FamilyCouncilMomHintCanTalk'
            if FamilyCouncilMomHintCanTalk = 1:
                GirlTalkPersonalStoryCount += 1
            end
        end
    end

    if LOC('SandraStaffGirlsReactionCanTalk') = 1:
        gs 'SandraStaffGirlsReactionCanTalk', $GirlTalkPersonalGirl
        if SandraStaffGirlsReactionCanTalk = 1:
            GirlTalkPersonalStoryCount += 1
        end
    end

    if otkroven[$GirlTalkPersonalGirl] >= GirlTalkPersonalMinOtkroven:
        if $GirlTalkPersonalGirl = 'amanda':
            gs 'GirlTalkPersonalStoryAvailable', 'amanda', 'amanda_legare'
            if GirlTalkPersonalStoryReady = 1:
                GirlTalkPersonalStoryCount += 1
            end

            gs 'GirlTalkPersonalStoryAvailable', 'amanda', 'amanda_boys'
            if GirlTalkPersonalStoryReady = 1:
                GirlTalkPersonalStoryCount += 1
            end

            gs 'GirlTalkPersonalBanOptionsCount', 'amanda'
            GirlTalkPersonalStoryCount += GirlTalkPersonalBanOptionsCount
            killvar 'GirlTalkPersonalBanOptionsCount'

        elseif $GirlTalkPersonalGirl = 'melissa':
            gs 'GirlTalkPersonalStoryAvailable', 'melissa', 'melissa_musician'
            if GirlTalkPersonalStoryReady = 1:
                GirlTalkPersonalStoryCount += 1
            end

        elseif $GirlTalkPersonalGirl = 'sandra':
            gs 'GirlTalkPersonalStoryAvailable', 'sandra', 'sandra_carpenter'
            if GirlTalkPersonalStoryReady = 1:
                GirlTalkPersonalStoryCount += 1
            end

            gs 'GirlTalkPersonalStoryAvailable', 'sandra', 'sandra_priest'
            if GirlTalkPersonalStoryReady = 1:
                GirlTalkPersonalStoryCount += 1
            end
        end
    end

    if GirlTalkPersonalStoryCount > 0:
        GirlTalkPersonalAvailable = 1
    end

    killvar '$GirlTalkPersonalGirl'
    killvar 'GirlTalkPersonalStoryCount'
    killvar 'GirlTalkPersonalMinOtkroven'
---

#GirlTalkPersonalStoryUnlocked
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkPersonalUnlockGirl = $GirlKey
    $GirlTalkPersonalStoryId = LCASE($ARGS[1])

    GirlTalkPersonalStoryUnlocked = 0

    if $GirlTalkPersonalUnlockGirl = '' or $GirlTalkPersonalStoryId = '':
        killvar '$GirlTalkPersonalUnlockGirl'
        killvar '$GirlTalkPersonalStoryId'
        exit
    end

    if $GirlTalkPersonalStoryId = 'amanda_legare':
        if Fact_AmandaLegareOutsideMeet = 1 or Fact_AmandaLegareMajorRisk = 1 or Fact_AmandaLegarePrivateTalk = 1:
            GirlTalkPersonalStoryUnlocked = 1
        elseif AmandaNpcPath >= 12 or GirlNpcPath['amanda'] >= 12:
            GirlTalkPersonalStoryUnlocked = 1
        elseif FactHappened['amanda_dancewithlegare_1'] = 1 or FactHappened['amanda_waswithlegare'] = 1:
            GirlTalkPersonalStoryUnlocked = 1
        end

    elseif $GirlTalkPersonalStoryId = 'amanda_boys':
        if HallMissingGirlPrivateCount['amanda'] >= 1:
            GirlTalkPersonalStoryUnlocked = 1
        elseif sluttiness['amanda'] >= 22 or GirlNpcPath['amanda'] >= 22:
            GirlTalkPersonalStoryUnlocked = 1
        elseif GirlPublicAttention['amanda'] >= 25 and sluttiness['amanda'] >= 15:
            GirlTalkPersonalStoryUnlocked = 1
        end

    elseif $GirlTalkPersonalStoryId = 'melissa_musician':
        if GirlPersonalStoryUnlock['melissa_musician'] = 1:
            GirlTalkPersonalStoryUnlocked = 1
        elseif FactHappened['melissa_musiciannotice_1'] = 1:
            GirlTalkPersonalStoryUnlocked = 1
        end

    elseif $GirlTalkPersonalStoryId = 'sandra_carpenter':
        if GirlPersonalStoryUnlock['sandra_carpenter'] = 1:
            GirlTalkPersonalStoryUnlocked = 1
        elseif FactHappened['sandra_carpentersecret_1'] = 1:
            GirlTalkPersonalStoryUnlocked = 1
        end

    elseif $GirlTalkPersonalStoryId = 'sandra_priest':
        if GirlPersonalStoryUnlock['sandra_priest'] = 1:
            GirlTalkPersonalStoryUnlocked = 1
        elseif FactHappened['sandra_churchcomplaint_1'] = 1 or FactHappened['church_sandracomplaint'] = 1:
            GirlTalkPersonalStoryUnlocked = 1
        end
    end

    killvar '$GirlTalkPersonalUnlockGirl'
    killvar '$GirlTalkPersonalStoryId'
---

#GirlTalkPersonalStoryMinOtkroven
    $GirlTalkPersonalMinStoryId = LCASE($ARGS[0])
    GirlTalkPersonalStoryMinOtkroven = 20

    if $GirlTalkPersonalMinStoryId = 'amanda_legare':
        GirlTalkPersonalStoryMinOtkroven = 14
    elseif $GirlTalkPersonalMinStoryId = 'amanda_boys':
        GirlTalkPersonalStoryMinOtkroven = 18
    elseif $GirlTalkPersonalMinStoryId = 'melissa_musician':
        GirlTalkPersonalStoryMinOtkroven = 16
    elseif $GirlTalkPersonalMinStoryId = 'sandra_carpenter':
        GirlTalkPersonalStoryMinOtkroven = 18
    elseif $GirlTalkPersonalMinStoryId = 'sandra_priest':
        GirlTalkPersonalStoryMinOtkroven = 20
    end

    killvar '$GirlTalkPersonalMinStoryId'
---

#GirlTalkPersonalStoryAvailable
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkPersonalAvailGirl = $GirlKey
    $GirlTalkPersonalAvailStory = LCASE($ARGS[1])

    GirlTalkPersonalStoryReady = 0

    if $GirlTalkPersonalAvailGirl = '' or $GirlTalkPersonalAvailStory = '':
        killvar '$GirlTalkPersonalAvailGirl'
        killvar '$GirlTalkPersonalAvailStory'
        exit
    end

    if GirlPersonalStoryDiscussed[$GirlTalkPersonalAvailStory] = 1:
        killvar '$GirlTalkPersonalAvailGirl'
        killvar '$GirlTalkPersonalAvailStory'
        exit
    end

    gs 'GirlTalkPersonalStoryUnlocked', $GirlTalkPersonalAvailGirl, $GirlTalkPersonalAvailStory

    if GirlTalkPersonalStoryUnlocked = 0:
        killvar '$GirlTalkPersonalAvailGirl'
        killvar '$GirlTalkPersonalAvailStory'
        killvar 'GirlTalkPersonalStoryUnlocked'
        exit
    end

    gs 'GirlTalkPersonalStoryMinOtkroven', $GirlTalkPersonalAvailStory

    if otkroven[$GirlTalkPersonalAvailGirl] >= GirlTalkPersonalStoryMinOtkroven:
        GirlTalkPersonalStoryReady = 1
    end

    killvar '$GirlTalkPersonalAvailGirl'
    killvar '$GirlTalkPersonalAvailStory'
    killvar 'GirlTalkPersonalStoryUnlocked'
    killvar 'GirlTalkPersonalStoryMinOtkroven'
---

#GirlTalkPersonalBanOptionsCount
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkPersonalBanGirl = $GirlKey
    GirlTalkPersonalBanOptionsCount = 0

    if $GirlTalkPersonalBanGirl = 'amanda':
        if AmandaMetLizette = 1 or LizetteKnown = 1:
            GirlTalkPersonalBanOptionsCount += 1
        end

        if AmandaLegareInterest >= 1 or AmandaLegareTalkDone = 1 or Fact_AmandaLegareOutsideMeet = 1 or FactHappened['amanda_dancewithlegare_1'] = 1:
            GirlTalkPersonalBanOptionsCount += 1
        end

        GirlTalkPersonalBanOptionsCount += 1
    end

    killvar '$GirlTalkPersonalBanGirl'
---

#GirlTalkPersonalLegareBanned
    GirlTalkPersonalLegareBanned = 0

    if AmandaLegareInstruction = 1 or AmandaLegareInstruction = 4:
        GirlTalkPersonalLegareBanned = 1
    end
---

#GirlTalkPersonalBuildMainMenu
    gs 'Menu.Destroy', 'GirlTalkMainMenu'
    gs 'Menu.Create', 'GirlTalkMainMenu'

    gs 'GirlTalkPersonalAddArcTopicsToMenu'
    gs 'GirlTalkPersonalAddHallTopicsToMenu'

    if $TalkGirl = 'amanda':
        gs 'GirlTalkPersonalStoryAvailable', 'amanda', 'amanda_legare'
        if GirlTalkPersonalStoryReady = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О Легаре', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkPersonalStoryStart', $TalkGirl, $TalkReturnLoc, 'amanda_legare'
            }
        end

        gs 'GirlTalkPersonalStoryAvailable', 'amanda', 'amanda_boys'
        if GirlTalkPersonalStoryReady = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О парнях в городе', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkPersonalStoryStart', $TalkGirl, $TalkReturnLoc, 'amanda_boys'
            }
        end

        if AmandaMetLizette = 1 or LizetteKnown = 1:
            if LizetteBanned = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Разрешить болтать с Лизеттой', ''
            else
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Запретить болтать с Лизеттой', ''
            end

            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkPersonalBanToggle', $TalkGirl, $TalkReturnLoc, 'lizette'
            }
        end

        if AmandaLegareInterest >= 1 or AmandaLegareTalkDone = 1 or Fact_AmandaLegareOutsideMeet = 1 or FactHappened['amanda_dancewithlegare_1'] = 1:
            gs 'GirlTalkPersonalLegareBanned'

            if GirlTalkPersonalLegareBanned = 1:
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Разрешить общение с Легаре', ''
            else
                gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Запретить общение с Легаре', ''
            end

            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkPersonalBanToggle', $TalkGirl, $TalkReturnLoc, 'legare'
            }

            killvar 'GirlTalkPersonalLegareBanned'
        end

        if AmandaProhibitGuys = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Разрешить встречаться с парнями', ''
        else
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'Запретить встречаться с парнями', ''
        end

        gs 'Menu.AddModule', 'GirlTalkMainMenu', {
            gt 'GirlTalkPersonalBanToggle', $TalkGirl, $TalkReturnLoc, 'guys'
        }

    elseif $TalkGirl = 'melissa':
        gs 'GirlTalkPersonalStoryAvailable', 'melissa', 'melissa_musician'
        if GirlTalkPersonalStoryReady = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О музыканте', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkPersonalStoryStart', $TalkGirl, $TalkReturnLoc, 'melissa_musician'
            }
        end

    elseif $TalkGirl = 'sandra':
        gs 'GirlTalkPersonalStoryAvailable', 'sandra', 'sandra_carpenter'
        if GirlTalkPersonalStoryReady = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О столяре', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkPersonalStoryStart', $TalkGirl, $TalkReturnLoc, 'sandra_carpenter'
            }
        end

        gs 'GirlTalkPersonalStoryAvailable', 'sandra', 'sandra_priest'
        if GirlTalkPersonalStoryReady = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', 'О священнике', ''
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'GirlTalkPersonalStoryStart', $TalkGirl, $TalkReturnLoc, 'sandra_priest'
            }
        end
    end
---

#GirlTalkPersonalBuildMenu
    gs 'GirlTalkPersonalBuildMainMenu'
---

#GirlTalkPersonalBanToggle
    gs 'NormalizeGirlKey', $ARGS[0]
    $TalkGirl = $GirlKey
    $TalkReturnLoc = $ARGS[1]
    $GirlTalkPersonalBanKind = LCASE($ARGS[2])

    if $TalkGirl = '' or $GirlTalkPersonalBanKind = '':
        killvar '$GirlTalkPersonalBanKind'
        exit
    end

    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    gs 'MenuGirlCalcConditions', $TalkGirl, $TalkReturnLoc

    if MenuCanTalk = 0:
        gs 'GirlTalkClosedScreen', $TalkGirl, $TalkReturnLoc
        killvar '$GirlTalkPersonalBanKind'
        exit
    end

    gs 'GirlTalkSessionBegin'
    gs 'GirlTalkPersonalApplyBan', $GirlTalkPersonalBanKind

    GirlTalkPersonalMenuActive = 1
    GirlTalkAutoOpenTalkMenu = 1
    gt 'GirlTalk', $TalkGirl, $TalkReturnLoc

    killvar '$GirlTalkPersonalBanKind'
---

#GirlTalkPersonalApplyBan
    $GirlTalkPersonalBanKind = LCASE($ARGS[0])

    if $GirlTalkPersonalBanKind = 'lizette':
        if LizetteBanned = 1:
            LizetteBanned = 0
            LizetteBanStrict = 0
            AmandaTrustStefan += 1

            if AmandaTrustStefan > 100:
                AmandaTrustStefan = 100
            end

            $GirlTalkPendingNotice[$TalkGirl] = 'Вы сказали Аманде, что погорячились с запретом — с Лизеттой снова можно болтать. Она поблагодарила вас за доверие.'
        else:
            LizetteBanned = 1
            LizetteBanStrict = 0
            $GirlTalkPendingNotice[$TalkGirl] = 'Вы попросили Аманду не болтать с Лизеттой — та распущенная девчонка и хорошему не научит. Аманда выслушала и пообещала послушаться.'
        end

    elseif $GirlTalkPersonalBanKind = 'legare':
        gs 'GirlTalkPersonalLegareBanned'

        if GirlTalkPersonalLegareBanned = 1:
            AmandaLegareInstruction = 0
            AmandaTrustStefan += 1

            if AmandaTrustStefan > 100:
                AmandaTrustStefan = 100
            end

            $GirlTalkPendingNotice[$TalkGirl] = 'Вы сняли запрет на общение с Легаре. Аманда вздохнула с облегчением — но пообещала быть осторожной.'
        else:
            AmandaLegareInstruction = 1
            AmandaTrustStefan += 1
            $GirlTalkPendingNotice[$TalkGirl] = 'Вы попросили Аманду держаться подальше от Легаре. Она кивнула — пока вы рядом, она постарается не танцевать с ним и не болтать.'
        end

        killvar 'GirlTalkPersonalLegareBanned'

    elseif $GirlTalkPersonalBanKind = 'guys':
        if AmandaProhibitGuys = 1:
            AmandaProhibitGuys = 0
            AmandaTrustStefan += 1

            if AmandaTrustStefan > 100:
                AmandaTrustStefan = 100
            end

            $GirlTalkPendingNotice[$TalkGirl] = 'Вы разрешили Аманде встречаться с парнями в городе. Она улыбнулась — будто получила больше воздуха, чем ожидала.'
        else:
            AmandaProhibitGuys = 1

            if LOC('OffenseDaysBanImmediate') = 1:
                gs 'OffenseDaysBanImmediate', 'amanda', 'ban_guys'
            end

            AmandaRebellion += 1
            $GirlTalkPendingNotice[$TalkGirl] = 'Вы запретили Аманде встречаться с парнями после смены. Она нахмурилась, но согласилась — пока вы хозяин трактира.'
        end
    end

    killvar '$GirlTalkPersonalBanKind'
---

#GirlTalkPersonalStoryStart
    gs 'NormalizeGirlKey', $ARGS[0]
    $TalkGirl = $GirlKey
    $TalkReturnLoc = $ARGS[1]
    $GirlTalkPersonalStoryId = LCASE($ARGS[2])

    if $TalkGirl = '' or $GirlTalkPersonalStoryId = '':
        msg 'Ошибка: GirlTalkPersonalStoryStart вызван без параметров.'
        exit
    end

    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    gs 'MenuGirlCalcConditions', $TalkGirl, $TalkReturnLoc

    if MenuCanTalk = 0:
        gs 'GirlTalkClosedScreen', $TalkGirl, $TalkReturnLoc
        exit
    end

    gs 'GirlTalkPersonalStoryAvailable', $TalkGirl, $GirlTalkPersonalStoryId

    if GirlTalkPersonalStoryReady = 0:
        gt 'GirlTalk', $TalkGirl, $TalkReturnLoc
        exit
    end

    gs 'UsefulTalkCheck', $TalkGirl, 'personal'

    if UsefulTalkResult = 0:
        gt 'GirlTalkBlockedUsefulTopic', $TalkGirl, $TalkReturnLoc
        exit
    end

    gs 'GirlTalkSessionBegin'

    cls

    gs 'GirlTalkShowSidebarWithAnchor', $TalkGirl

    *pl '══════════════════════════════════════════════'
    *pl ' ЛИЧНЫЙ РАЗГОВОР: ' + $RealName[$TalkGirl]
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('ShowGirlTalkContextImage') = 1:
        gs 'ShowGirlTalkContextImage', $TalkGirl, 'large'
    end

    gs 'GirlTalkShowNpcMenuAnchor', 'main'
    *pl ' '

    gs 'GirlTalkPersonalPrintText', 'intro'
    gs 'GirlTalkPersonalPrintText', 'story'

    GirlPersonalStoryDiscussed[$GirlTalkPersonalStoryId] = 1

    Friends[$TalkGirl] += 1
    otkroven[$TalkGirl] += 1

    if love[$TalkGirl] >= 5:
        love[$TalkGirl] += 1
    end

    if $TalkGirl = 'amanda' and $GirlTalkPersonalStoryId = 'amanda_legare':
        GirlSecretiveness['amanda'] -= 1

        if GirlSecretiveness['amanda'] < 0:
            GirlSecretiveness['amanda'] = 0
        end

        if Fact_AmandaLegareMajorRisk = 1 and otkroven['amanda'] >= 28:
            AmandaNpcPath += 1
        end

    elseif $TalkGirl = 'amanda' and $GirlTalkPersonalStoryId = 'amanda_boys':
        GirlSecretiveness['amanda'] -= 1

        if GirlSecretiveness['amanda'] < 0:
            GirlSecretiveness['amanda'] = 0
        end

        if sluttiness['amanda'] >= 25:
            sluttiness['amanda'] += 1
        end

    elseif $TalkGirl = 'sandra' and $GirlTalkPersonalStoryId = 'sandra_priest':
        if SandraMoralResistance > 0:
            SandraMoralResistance -= 1
        end
    end

    gs 'UsefulTalkRegister', $TalkGirl, 'personal'
    gs 'ClampGirlSocialStats', $TalkGirl

    *pl ' '

    gs 'GirlTalkAddReturnButton'

    killvar '$GirlTalkPersonalStoryId'
---

#GirlTalkPersonalPrintText
    if $GirlTalkPersonalGirl = '':
        $GirlTalkPersonalGirl = $TalkGirl
    end

    if $GirlTalkPersonalStoryId = '':
        $GirlTalkPersonalStoryId = $ARGS[1]
    end

    gs 'GirlTalkPersonalText', $ARGS[0]

    if $GirlTalkPersonalText <> '':
        *p $GirlTalkPersonalText
    end

    killvar '$GirlTalkPersonalText'
---