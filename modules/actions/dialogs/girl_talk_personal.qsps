---

#GirlTalkPersonalCheckAvailable
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlTalkPersonalGirl = $GirlKey

    GirlTalkPersonalAvailable = 0
    GirlTalkPersonalStoryCount = 0
    GirlTalkPersonalMinOtkroven = 20

    if $GirlTalkPersonalGirl = '':
        killvar '$GirlTalkPersonalGirl'
        exit
    end

    if $GirlTalkPersonalGirl = 'amanda':
        GirlTalkPersonalMinOtkroven = 14
    elseif $GirlTalkPersonalGirl = 'melissa':
        GirlTalkPersonalMinOtkroven = 16
    elseif $GirlTalkPersonalGirl = 'sandra':
        GirlTalkPersonalMinOtkroven = 18
    end

    ! Недавняя ссора / примирение
    if GirlConflictLevel[$GirlTalkPersonalGirl] > 0 and GirlConflictUntilDay[$GirlTalkPersonalGirl] < day and GirlConflictAfterTalkLevel[$GirlTalkPersonalGirl] < GirlConflictLevel[$GirlTalkPersonalGirl]:
        GirlTalkPersonalStoryCount += 1
    end

    gs 'GirlTalkPersonalCountHallTopics', $GirlTalkPersonalGirl
    GirlTalkPersonalStoryCount += GirlTalkPersonalHallTopicsCount
    killvar 'GirlTalkPersonalHallTopicsCount'

    ! ==================== АМАНДА ====================
    if $GirlTalkPersonalGirl = 'amanda':
        if AmandaLegareTalkReady = 1 and LOC('AmandaTalkAboutLegare') = 1:
            GirlTalkPersonalStoryCount += 1
        end

        if LOC('AmandaLegarePrivateAftermathCanTalk') = 1:
            gs 'AmandaLegarePrivateAftermathCanTalk'
            if AmandaLegarePrivateAftermathCanTalk = 1:
                GirlTalkPersonalStoryCount += 1
            end
            killvar 'AmandaLegarePrivateAftermathCanTalk'
        end

        if LOC('AmandaLegareOutsideAftermathCanTalk') = 1:
            gs 'AmandaLegareOutsideAftermathCanTalk'
            if AmandaLegareOutsideAftermathCanTalk = 1:
                GirlTalkPersonalStoryCount += 1
            end
            killvar 'AmandaLegareOutsideAftermathCanTalk'
        end

        if AmandaPathChoiceDone = 0 and LOC('AmandaPathChoiceCanStart') = 1:
            gs 'AmandaPathChoiceCanStart'
            if AmandaPathChoiceCanStart = 1:
                GirlTalkPersonalStoryCount += 1
            end
            killvar 'AmandaPathChoiceCanStart'
        end

        if LOC('AmandaLegareMajorAftermathCanTalk') = 1:
            gs 'AmandaLegareMajorAftermathCanTalk'
            if AmandaLegareMajorAftermathCanTalk = 1:
                GirlTalkPersonalStoryCount += 1
            end
            killvar 'AmandaLegareMajorAftermathCanTalk'
        end

        if LegareFirstConflictAfterTalkReady = 1 and LegareFirstConflictAfterTalkDone = 0 and LOC('AmandaTalkAboutLegareFirstConflict') = 1:
            GirlTalkPersonalStoryCount += 1
        end

        if LOC('DanceDressEscortCanStart') = 1:
            gs 'DanceDressEscortCanStart', 'amanda'
            if DanceDressEscortCanStart = 1:
                GirlTalkPersonalStoryCount += 1
            end
            killvar 'DanceDressEscortCanStart'
        end

        if LOC('DanceDressFittingEscortCanStart') = 1:
            gs 'DanceDressFittingEscortCanStart', 'amanda'
            if DanceDressFittingEscortCanStart = 1:
                GirlTalkPersonalStoryCount += 1
            end
            killvar 'DanceDressFittingEscortCanStart'
        end

        if LOC('DanceDressTalkCanStart') = 1:
            gs 'DanceDressTalkCanStart', 'amanda'
            if DanceDressTalkCanStart = 1:
                GirlTalkPersonalStoryCount += 1
            end
            killvar 'DanceDressTalkCanStart'
        end
    end

    ! ==================== МЕЛИССА ====================
    if $GirlTalkPersonalGirl = 'melissa':
        if MelissaLegareWarningSeen = 1 and MelissaLegarePrivateTalkDone = 0 and LOC('MelissaTalkAboutLegare') = 1:
            GirlTalkPersonalStoryCount += 1
        end

        if Fact_AmandaLegarePrivateTalk = 1 and MelissaAmandaLegarePrivateTalkDiscussed = 0 and LOC('MelissaTalkAboutAmandaLegarePrivate') = 1:
            GirlTalkPersonalStoryCount += 1
        end

        if MelissaAmandaLegareOutsideTalkReady = 1 and MelissaAmandaLegareOutsideTalkDiscussed = 0 and LOC('MelissaTalkAboutAmandaLegareOutside') = 1:
            GirlTalkPersonalStoryCount += 1
        end

        if MelissaFirstPathChoiceDone = 0 and LOC('MelissaFirstPathChoiceCanStart') = 1:
