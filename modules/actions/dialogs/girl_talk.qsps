#GirlTalkImportantScreen
    gs 'NormalizeGirlKey', $ARGS[0]
    $TalkGirl = $GirlKey
    $TalkReturnLoc = $ARGS[1]

    if $TalkGirl = '':
        $TalkGirl = 'amanda'
    end
    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    cls

    gs 'GirlTalkShowSidebarWithAnchor', $TalkGirl
    gs 'ShowLocationScreenTitle', 'ВАЖНАЯ БЕСЕДА: ' + $RealName[$TalkGirl]
    gs 'SceneShowVisual', 'images/actions/dialogs/' + $TalkGirl + '_important', 'важная беседа: ' + $RealName[$TalkGirl], 'large', 'webp'

    gs 'GirlTalkBuildImportantMenu'
    gs 'GetNpcMenuLinkHref', 'GirlTalkImportantMenu', $RealName[$TalkGirl]

    *pl 'У вас с ' + $NpcMenuLinkHref + ' есть важные вопросы, требующие отдельного обсуждения.'
    killvar '$NpcMenuLinkHref'

    ! Единственная кнопка на панели act: Отойти
    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $TalkReturnLoc
    end
