---

#GirlTalkChatScreen
    gs 'NormalizeGirlKey', $ARGS[0]
    $TalkGirl = $GirlKey
    $TalkReturnLoc = $ARGS[1]

    if $TalkGirl = '':
        $TalkGirl = 'amanda'
    end
    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    cls

    gs 'GirlTalkShowSidebarWithAnchor', $TalkGirl
    gs 'ShowLocationScreenTitle', 'РАЗГОВОР: ' + $RealName[$TalkGirl]
    gs 'SceneShowVisual', 'images/actions/dialogs/' + $TalkGirl + '_chat', 'разговор: ' + $RealName[$TalkGirl], 'large', 'webp'

    gs 'GirlTalkBuildChatMenu'
    gs 'GetNpcMenuLinkHref', 'GirlTalkChatMenu', $RealName[$TalkGirl]

    *pl $NpcMenuLinkHref + ' переводит на тебя внимательный взгляд, готовая выслушать.'
    killvar '$NpcMenuLinkHref'

    ! Единственная кнопка на панели act: Отойти
    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $TalkReturnLoc
    end
---

#GirlTalkBuildChatMenu
    gs 'Menu.Destroy', 'GirlTalkChatMenu'
    gs 'Menu.Create', 'GirlTalkChatMenu'

    gs 'MenuUiAdd', 'GirlTalkChatMenu', 'О делах трактира', 'tavern'
    gs 'Menu.AddModule', 'GirlTalkChatMenu', {
        gt 'GirlTalkRunTopic', $TalkGirl, $TalkReturnLoc, 'tavern'
    }

    gs 'MenuUiAdd', 'GirlTalkChatMenu', 'Поболтать ни о чём', 'smalltalk'
    gs 'Menu.AddModule', 'GirlTalkChatMenu', {
        gt 'GirlTalkRunTopic', $TalkGirl, $TalkReturnLoc, 'smalltalk'
    }

    if Friends[$TalkGirl] >= 3 or love[$TalkGirl] >= 2 or $TalkGirl = 'amanda' or $TalkGirl = 'melissa' or $TalkGirl = 'sandra':
        gs 'MenuUiAdd', 'GirlTalkChatMenu', 'О семье', 'family'
        gs 'Menu.AddModule', 'GirlTalkChatMenu', {
            gt 'GirlTalkRunTopic', $TalkGirl, $TalkReturnLoc, 'family'
        }
    end

    if otkroven[$TalkGirl] >= 8 or Friends[$TalkGirl] >= 15 or love[$TalkGirl] >= 8:
        gs 'MenuUiAdd', 'GirlTalkChatMenu', 'О личном', 'talk'
        gs 'Menu.AddModule', 'GirlTalkChatMenu', {
            gt 'GirlTalkRunTopic', $TalkGirl, $TalkReturnLoc, 'personal'
        }
    end

    $ComplimentMenuKey = $TalkGirl + '_' + STR(day)
    if (Friends[$TalkGirl] >= 12 or love[$TalkGirl] >= 10 or otkroven[$TalkGirl] >= 12) and GirlComplimentDay[$ComplimentMenuKey] = 0:
        gs 'MenuUiAdd', 'GirlTalkChatMenu', 'Сделать комплимент', 'flirt'
        gs 'Menu.AddModule', 'GirlTalkChatMenu', {
            gt 'GirlTalkRunTopic', $TalkGirl, $TalkReturnLoc, 'compliment'
        }
    end
    killvar '$ComplimentMenuKey'
---

#GirlTalkRunTopic
    gs 'NormalizeGirlKey', $ARGS[0]
    $TalkGirl = $GirlKey
    $TalkReturnLoc = $ARGS[1]
    $TalkTopic = LCASE($ARGS[2])

    if $TalkGirl = '':
        $TalkGirl = 'amanda'
    end
    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl

    ! Проверка лимитов полезных разговоров
    if $TalkTopic = 'tavern' or $TalkTopic = 'family' or $TalkTopic = 'personal':
        gs 'UsefulTalkCheck', $TalkGirl, $TalkTopic
        if UsefulTalkResult = 0:
            gt 'GirlTalkBlockedUsefulTopic', $TalkGirl, $TalkReturnLoc
            exit
        end
    end

    cls
    gs 'GirlTalkShowSidebarWithAnchor', $TalkGirl
    gs 'ShowLocationScreenTitle', 'РАЗГОВОР: ' + $RealName[$TalkGirl]
    gs 'SceneShowVisual', 'images/actions/dialogs/' + $TalkGirl + '_' + $TalkTopic, 'разговор: ' + $RealName[$TalkGirl] + ' (' + $TalkTopic + ')', 'large', 'webp'
    *pl ' '

    if $TalkTopic = 'tavern':
        gs 'UsefulTalkRegister', $TalkGirl, 'tavern'
        gs 'GirlTalkTavernRun', $TalkGirl

    elseif $TalkTopic = 'smalltalk':
        gs 'SmallTalkNpc', $TalkGirl
        gs 'GirlTalkAfterSmalltalk', $TalkGirl

    elseif $TalkTopic = 'family':
        gs 'UsefulTalkRegister', $TalkGirl, 'family'
        gs 'GirlTalkFamilyRun', $TalkGirl

    elseif $TalkTopic = 'personal':
        gs 'UsefulTalkRegister', $TalkGirl, 'personal'
        if $TalkGirl = 'amanda':
            gs 'GirlTalkAmandaUnifiedRun'
        elseif $TalkGirl = 'melissa':
            gs 'GirlTalkMelissaUnifiedRun'
        elseif $TalkGirl = 'sandra':
            gs 'GirlTalkSandraUnifiedRun'
        elseif $TalkGirl = 'becky':
            gs 'GirlTalkBeckyUnifiedRun'
        elseif $TalkGirl = 'clarissa':
            gs 'GirlTalkClarissaUnifiedRun'
        elseif $TalkGirl = 'inga':
            gs 'GirlTalkIngaUnifiedRun'
        elseif $TalkGirl = 'lizette':
            gs 'GirlTalkLizetteUnifiedRun'
        elseif $TalkGirl = 'georgett':
            gs 'GirlTalkGeorgetteUnifiedRun'
        else:
            gs 'GirlTalkResult', $TalkGirl, $TalkReturnLoc, 'personal'
        end

    elseif $TalkTopic = 'compliment':
        gs 'GirlTalkResult', $TalkGirl, $TalkReturnLoc, 'compliment'
        exit
    end

    gs 'ClampGirlSocialStats', $TalkGirl
    *pl ' '
    gs 'GirlTalkBuildChatMenu'
    gs 'GetNpcMenuLinkHref', 'GirlTalkChatMenu', $RealName[$TalkGirl]
    *pl $NpcMenuLinkHref + ' вытирает стойку полотенцем, продолжая поглядывать на тебя.'
    killvar '$NpcMenuLinkHref'
    *pl ' '

    ! Единственная кнопка на панели act: Отойти
    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $TalkReturnLoc
    end
---

#GirlTalkGiftScreen
    gs 'NormalizeGirlKey', $ARGS[0]
    $TalkGirl = $GirlKey
    $TalkReturnLoc = $ARGS[1]

    if $TalkGirl = '':
        $TalkGirl = 'amanda'
    end
    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    cls

    gs 'GirlTalkShowSidebarWithAnchor', $TalkGirl
    gs 'ShowLocationScreenTitle', 'ПОДАРОК: ' + $RealName[$TalkGirl]
    gs 'SceneShowVisual', 'images/actions/dialogs/' + $TalkGirl + '_gift', 'подарок: ' + $RealName[$TalkGirl], 'large', 'webp'

    gs 'GirlTalkBuildGiftMenu'
    gs 'GetNpcMenuLinkHref', 'GirlTalkGiftMenu', $RealName[$TalkGirl]

    *pl $NpcMenuLinkHref + ' с любопытством смотрит на твою сумку, гадая, что ты достанешь.'
    killvar '$NpcMenuLinkHref'

    ! Единственная кнопка на панели act: Отойти
    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $TalkReturnLoc
    end
---

#GirlTalkBuildGiftMenu
    gs 'Menu.Destroy', 'GirlTalkGiftMenu'
    gs 'Menu.Create', 'GirlTalkGiftMenu'

    if GiftInventory['gift_cheap'] > 0:
        gs 'MenuUiAdd', 'GirlTalkGiftMenu', 'Подарить малый подарок (' + STR(GiftInventory['gift_cheap']) + ' шт.)', 'gift'
        gs 'Menu.AddModule', 'GirlTalkGiftMenu', {
            gt 'MenuGirlGiftGive', $TalkGirl, $TalkReturnLoc, 'gift_cheap'
        }
    end

    if GiftInventory['gift_expensive'] > 0:
        gs 'MenuUiAdd', 'GirlTalkGiftMenu', 'Подарить дорогой подарок (' + STR(GiftInventory['gift_expensive']) + ' шт.)', 'gift'
        gs 'Menu.AddModule', 'GirlTalkGiftMenu', {
            gt 'MenuGirlGiftGive', $TalkGirl, $TalkReturnLoc, 'gift_expensive'
        }
    end
---

#GirlTalkOrdersCheckAvailable
    GirlTalkOrdersCount = 0
    gs 'NormalizeGirlKey', $ARGS[0]
    $OrdersCheckGirl = $GirlKey

    if $OrdersCheckGirl = 'amanda':
        if AmandaProhibitGuys = 1 or AmandaNeighborBoysStage >= 1 or AmandaSeenWithGuys = 1 or day >= 3:
            GirlTalkOrdersCount += 1
        end

        gs 'GirlTalkPersonalLegareBanned'
        if GirlTalkPersonalLegareBanned = 1 or AmandaLegareMet = 1 or AmandaLegareDanceDone = 1 or PortMeetWitnessed = 1:
            GirlTalkOrdersCount += 1
        end
        killvar 'GirlTalkPersonalLegareBanned'

        if LizetteBanned = 1 or LizetteKnown = 1 or PortMeetWitnessed = 1:
            GirlTalkOrdersCount += 1
        end

        if LOC('GirlNoPantiesWorkCanOffer') = 1:
            gs 'GirlNoPantiesWorkCanOffer', 'amanda'
            if GirlNoPantiesWorkCanOffer = 1 or GirlNoPantiesWork['amanda'] = 1:
                GirlTalkOrdersCount += 1
            end
            killvar 'GirlNoPantiesWorkCanOffer'
        end

    elseif $OrdersCheckGirl = 'melissa':
        if MelissaProhibitMinstrel = 1 or MelissaMinstrelMet = 1:
            GirlTalkOrdersCount += 1
        end

        if MelissaProhibitGuys = 1 or day >= 3:
            GirlTalkOrdersCount += 1
        end

        if LOC('GirlNoPantiesWorkCanOffer') = 1:
            gs 'GirlNoPantiesWorkCanOffer', 'melissa'
            if GirlNoPantiesWorkCanOffer = 1 or GirlNoPantiesWork['melissa'] = 1:
                GirlTalkOrdersCount += 1
            end
            killvar 'GirlNoPantiesWorkCanOffer'
        end

    elseif $OrdersCheckGirl = 'sandra':
        if LOC('GirlNoPantiesWorkCanOffer') = 1:
            gs 'GirlNoPantiesWorkCanOffer', 'sandra'
            if GirlNoPantiesWorkCanOffer = 1 or GirlNoPantiesWork['sandra'] = 1:
                GirlTalkOrdersCount += 1
            end
            killvar 'GirlNoPantiesWorkCanOffer'
        end
    end

    killvar '$OrdersCheckGirl'
---

#GirlTalkOrdersScreen
    gs 'NormalizeGirlKey', $ARGS[0]
    $TalkGirl = $GirlKey
    $TalkReturnLoc = $ARGS[1]

    if $TalkGirl = '':
        $TalkGirl = 'amanda'
    end
    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    cls

    gs 'GirlTalkShowSidebarWithAnchor', $TalkGirl
    gs 'ShowLocationScreenTitle', 'НАКАЗ: ' + $RealName[$TalkGirl]
    gs 'SceneShowVisual', 'images/actions/tavern/' + $TalkGirl + '_orders', 'наказы: ' + $RealName[$TalkGirl], 'large', 'webp'

    gs 'GirlTalkBuildOrdersMenu'
    gs 'GetNpcMenuLinkHref', 'GirlTalkOrdersMenu', $RealName[$TalkGirl]

    *pl $NpcMenuLinkHref + ' внимательно слушает твои хозяйские указания и наказы.'
    killvar '$NpcMenuLinkHref'

    if $GirlTalkPendingNotice[$TalkGirl] <> '':
        *pl ' '
        *p $GirlTalkPendingNotice[$TalkGirl]
        $GirlTalkPendingNotice[$TalkGirl] = ''
    end
    *pl ' '

    ! Единственная кнопка на панели act: Отойти
    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $TalkReturnLoc
    end
---

#GirlTalkBuildOrdersMenu
    gs 'Menu.Destroy', 'GirlTalkOrdersMenu'
    gs 'Menu.Create', 'GirlTalkOrdersMenu'

    if $TalkGirl = 'amanda':
        if AmandaProhibitGuys = 1 or AmandaNeighborBoysStage >= 1 or AmandaSeenWithGuys = 1 or day >= 3:
            if AmandaProhibitGuys = 1:
                gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Разрешить встречи с парнями', 'talk'
                gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                    gt 'GirlTalkPersonalBanToggle', 'amanda', $TalkReturnLoc, 'guys'
                }
            else:
                gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Запретить встречи с парнями', 'talk'
                gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                    gt 'GirlTalkPersonalBanToggle', 'amanda', $TalkReturnLoc, 'guys'
                }
            end
        end

        gs 'GirlTalkPersonalLegareBanned'
        if GirlTalkPersonalLegareBanned = 1 or AmandaLegareMet = 1 or AmandaLegareDanceDone = 1 or PortMeetWitnessed = 1:
            if GirlTalkPersonalLegareBanned = 1:
                gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Разрешить общение с Легаре', 'talk'
                gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                    gt 'GirlTalkPersonalBanToggle', 'amanda', $TalkReturnLoc, 'legare'
                }
            else:
                gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Запретить общение с Легаре', 'talk'
                gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                    gt 'GirlTalkPersonalBanToggle', 'amanda', $TalkReturnLoc, 'legare'
                }
            end
        end
        killvar 'GirlTalkPersonalLegareBanned'

        if LizetteBanned = 1 or LizetteKnown = 1 or PortMeetWitnessed = 1:
            if LizetteBanned = 1:
                gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Разрешить болтать с Лизеттой', 'talk'
                gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                    gt 'GirlTalkPersonalBanToggle', 'amanda', $TalkReturnLoc, 'lizette'
                }
            else:
                gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Запретить болтать с Лизеттой', 'talk'
                gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                    gt 'GirlTalkPersonalBanToggle', 'amanda', $TalkReturnLoc, 'lizette'
                }
            end
        end

        if LOC('GirlNoPantiesWorkCanOffer') = 1:
            gs 'GirlNoPantiesWorkCanOffer', 'amanda'
            if GirlNoPantiesWorkCanOffer = 1 or GirlNoPantiesWork['amanda'] = 1:
                if GirlNoPantiesWork['amanda'] = 0:
                    gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Наказ: работать в зале без белья', 'policy'
                    gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                        gt 'GirlNoPantiesWorkTalkSet', 'amanda', 1, 'GirlTalkOrdersScreen'
                    }
                else:
                    gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Разрешить носить бельё в зале', 'policy'
                    gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                        gt 'GirlNoPantiesWorkTalkSet', 'amanda', 0, 'GirlTalkOrdersScreen'
                    }
                end
            end
            killvar 'GirlNoPantiesWorkCanOffer'
        end
    end

    if $TalkGirl = 'melissa':
        if MelissaProhibitMinstrel = 1 or MelissaMinstrelMet = 1:
            if MelissaProhibitMinstrel = 1:
                gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Разрешить встречи с менестрелем', 'talk'
                gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                    gt 'GirlTalkPersonalBanToggle', 'melissa', $TalkReturnLoc, 'minstrel'
                }
            else:
                gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Запретить встречи с менестрелем', 'talk'
                gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                    gt 'GirlTalkPersonalBanToggle', 'melissa', $TalkReturnLoc, 'minstrel'
                }
            end
        end

        if MelissaProhibitGuys = 1 or day >= 3:
            if MelissaProhibitGuys = 1:
                gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Разрешить гулять по вечерам', 'talk'
                gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                    gt 'GirlTalkPersonalBanToggle', 'melissa', $TalkReturnLoc, 'guys'
                }
            else:
                gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Запретить гулять по вечерам', 'talk'
                gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                    gt 'GirlTalkPersonalBanToggle', 'melissa', $TalkReturnLoc, 'guys'
                }
            end
        end

        if LOC('GirlNoPantiesWorkCanOffer') = 1:
            gs 'GirlNoPantiesWorkCanOffer', 'melissa'
            if GirlNoPantiesWorkCanOffer = 1 or GirlNoPantiesWork['melissa'] = 1:
                if GirlNoPantiesWork['melissa'] = 0:
                    gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Наказ: работать в зале без белья', 'policy'
                    gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                        gt 'GirlNoPantiesWorkTalkSet', 'melissa', 1, 'GirlTalkOrdersScreen'
                    }
                else:
                    gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Разрешить носить бельё в зале', 'policy'
                    gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                        gt 'GirlNoPantiesWorkTalkSet', 'melissa', 0, 'GirlTalkOrdersScreen'
                    }
                end
            end
            killvar 'GirlNoPantiesWorkCanOffer'
        end
    end

    if $TalkGirl = 'sandra':
        if LOC('GirlNoPantiesWorkCanOffer') = 1:
            gs 'GirlNoPantiesWorkCanOffer', 'sandra'
            if GirlNoPantiesWorkCanOffer = 1 or GirlNoPantiesWork['sandra'] = 1:
                if GirlNoPantiesWork['sandra'] = 0:
                    gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Наказ: ходить без белья', 'policy'
                    gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                        gt 'GirlNoPantiesWorkTalkSet', 'sandra', 1, 'GirlTalkOrdersScreen'
                    }
                else:
                    gs 'MenuUiAdd', 'GirlTalkOrdersMenu', 'Разрешить носить бельё', 'policy'
                    gs 'Menu.AddModule', 'GirlTalkOrdersMenu', {
                        gt 'GirlNoPantiesWorkTalkSet', 'sandra', 0, 'GirlTalkOrdersScreen'
                    }
                end
            end
            killvar 'GirlNoPantiesWorkCanOffer'
        end
    end
---
