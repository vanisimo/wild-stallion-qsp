#GirlTalkPersonalText
    $GirlTalkPersonalTextId = LCASE($ARGS[0])
    $GirlTalkPersonalText = ''

    if $GirlTalkPersonalGirl = '':
        $GirlTalkPersonalGirl = $TalkGirl
    end

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (ЛИЧНЫЙ ТОН, РАСКОВАННОСТЬ, ОТКРОВЕНИЕ)
    ! ----------------------------------------------------
    if $GirlTalkPersonalTextId = 'intro':
        if $GirlTalkPersonalGirl = 'amanda':
            if FamilyCorruptionStage >= 3 or otkroven['amanda'] >= 30:
                $GirlTalkPersonalText = 'Аманда прислоняется бедром к косяку двери, скрещивает руки под грудью и вскидывает подбородок. Её взгляд медленно скользит по твоему телу и задерживается на штанах между ног с лукавой усмешкой:<br><br>— Личное? — она подаётся чуть вперёд, облизав губы. — Ну давай, спрашивай. Мы уже давно не в том положении, чтобы строить из себя пай-девочку и строгово брата. Хочешь знать правду — скажу. Только без хозяйских замашек, Стефан. Сама решу, чем делиться.'
            elseif otkroven['amanda'] >= 18:
                $GirlTalkPersonalText = 'Аманда одёргивает подол юбки, переступает с ноги на ногу и отводит прядь волос за ухо, внимательно глядя тебе в глаза:<br><br>— Личное? Ладно, валяй, — она слегка хмурится, но не отходит. — Только не сверли меня взглядом, как строгий судья. Если начнёшь читать нотации — сразу уйду к столикам. Спрашивай по-человечески.'
            else:
                $GirlTalkPersonalText = 'Аманда отступает на шаг назад, складывает руки на груди и недоверчиво щурится:<br><br>— Личное? А тебе-то какое дело, Стефан? — она косится на дверь зала. — За стойкой следи. Начнёшь лезть в душу с расспросами — я сразу в дурочку сыграю. Ничего не знаю, ничего не слышала.'
            end

        elseif $GirlTalkPersonalGirl = 'melissa':
            if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 30:
                $GirlTalkPersonalText = 'Мелисса неторопливо закрывает конторскую книгу, опирается спиной на полку и скрещивает длинные ноги. Её губы кривятся в насмешливой полуулыбке, а цепкий взгляд опускается к твоему поясу:<br><br>— О личном поговорить пришёл? — она тихо хмыкает, чуть наклонив голову. — Спрашивай прямо. Границы приличий мы уже благополучно перешагнули, так что глупо притворяться скромницей. Что тебя интересует? Задавай вопрос — получишь точный ответ.'
            elseif otkroven['melissa'] >= 18:
                $GirlTalkPersonalText = 'Мелисса откладывает перо в сторону, разминает тонкие пальцы и поворачивается к тебе, уперев руку в бок:<br><br>— Спрашивай как брат, Стефан. Не как хозяин трактира, — голос звучит сухо, но взгляд мягче обычного. — Твою мину «я тут главный» я за версту чую. Не дави, дай сформулировать мысль.'
            else:
                $GirlTalkPersonalText = 'Мелисса окидывает тебя холодным взглядом поверх гроссбуха и постукивает ногтем по столешнице:<br><br>— Моё личное остаётся за порогом трактира, Стефан. Если есть дело по залу или счетам — говори. Праздную болтовню я не развожу.'
            end

        elseif $GirlTalkPersonalGirl = 'sandra':
            if FamilyCorruptionStage >= 3 or otkroven['sandra'] >= 30:
                $GirlTalkPersonalText = 'Сандра откладывает полотенце, подаётся вперёд и обеими руками поправляет вырез платья, демонстративно открывая пышную ложбинку. Её взгляд опускается прямо к твоим штанам между ног, задерживаясь на паху с бесстыдной усмешкой:<br><br>— Личное, Стефан?.. — она говорит низким, хрипловатым голосом. — Спрашивай, не робей. От тебя мне теперь скрывать нечего. Сама знаю, какая я есть, и ты давно не мальчишка. Подойди ближе, говори прямо в лицо. Я тебя слушаю.'
            elseif otkroven['sandra'] >= 18:
                $GirlTalkPersonalText = 'Сандра вытирает руки о передник, смахивает прядь волос со лба и негромко вздыхает:<br><br>— Личное... — она смотрит на тебя устало, но тепло. — Спрашивай, сынок. Я не железная. Слишком долго всё тянула на собственных плечах. Душу наизнанку с порога не выверну, но раз сам спросил — значит, слушать готов.'
            else:
                $GirlTalkPersonalText = 'Сандра строго сдвигает брови, не прекращая нарезать овощи на доске:<br><br>— Не до праздных речей сейчас, Стефан. Обед сам себя не сварит. Если что-то срочное по дому — выкладывай сразу, а душу бередить нечего.'
            end

        else:
            $GirlTalkPersonalText = $RealName[$GirlTalkPersonalGirl] + ' слегка приподнимает подбородок и смотрит на тебя, оценивая, насколько искренен твой интерес.'
        end

    ! ----------------------------------------------------
    ! 2. ИСТОРИИ И ПРИКЛЮЧЕНИЯ ВНЕ ДОМА
    ! ----------------------------------------------------
    elseif $GirlTalkPersonalTextId = 'story':

        ! --- АМАНДА И ЛЕГАРЕ ---
        if $GirlTalkPersonalStoryId = 'amanda_legare':
            if Fact_AmandaLegareMajorRisk = 1:
                if FamilyCorruptionStage >= 3 or sluttiness['amanda'] >= 35:
                    $GirlTalkPersonalText = 'Аманда вызывающе прикусывает губу, упирает руки в бока и дерзко смотрит тебе в глаза:<br><br>— Ты и сам прекрасно всё понимаешь, — в голосе звучит вызов. — С Легаре это давно не невинные танцы. Он богатый хлыщ, у него мошна лопается от серебра. Он пялится на меня как на женщину, жадно и без стеснения. И меня это заводит, Стефан! Я кручу им, как хочу, вытягиваю подарки. А если решу лечь под него — это будет мой выбор. Не смей мне указывать, сам хорош.'
                elseif otkroven['amanda'] >= 25:
                    $GirlTalkPersonalText = 'Аманда опускает глаза и теребит завязки фартука, покусывая губу:<br><br>— Ты и так всё понял, — тихо роняет она. — Легаре зовёт — я иду. То ли назло всем, то ли потому что он видит во мне взрослую девку, а не сопливую подавальщицу. Врать тебе не стану, но и шлюхой не называй. Мне страшно, но остановиться трудно.'
                else:
                    $GirlTalkPersonalText = 'Аманда хмурится и отворачивается к стене:<br><br>— Не лезь ко мне с допросами про Легаре, Стефан. Что было на улице — моё дело. За собой лучше следи.'
                end

            elseif Fact_AmandaLegareOutsideMeet = 1 or Fact_AmandaLegarePrivateTalk = 1:
                if FamilyCorruptionStage >= 3 or otkroven['amanda'] >= 25:
                    $GirlTalkPersonalText = 'Аманда усмехается, поправляя волосы, и стреляет глазами вниз, к твоему поясу:<br><br>— Легаре крутится вокруг меня как кот у миски. Зовёт в укромные углы, нашёптывает комплименты. Думает, раз у него тонкие сапоги и серебро в кармане, я сразу юбку задеру. Пусть надеется! Держать богатого дурака на поводке — сущее удовольствие. Я не пропаду, Стефан, не бойся.'
                elseif otkroven['amanda'] >= 18:
                    $GirlTalkPersonalText = 'Аманда признаётся, отводя взгляд в сторону:<br><br>— Легаре ко мне липнет. Сначала надувал щёки и показывал статус, теперь на свидания зовёт за угол. Я возвращалась злая, но шла снова. Не люблю я его, Стефан. Но рядом с ним я чувствую, что чего-то стою.'
                else:
                    $GirlTalkPersonalText = 'Аманда отводит глаза и нервно поправляет манжет:<br><br>— Пялится этот Легаре не только на кувшины с вином, это правда. Но я держу дистанцию. Он говорит красиво, зубы заговаривает, но руки распускать я ему не даю.'
                end

            else:
                if FamilyCorruptionStage >= 3:
                    $GirlTalkPersonalText = 'Аманда лениво усмехается, скользя взглядом по твоей фигуре:<br><br>— Легаре смотрит на меня так, будто уже приценился. Мужики в зале все одинаковые — слюни пускают на всё, что движется. Пусть смотрит, мне не убудет. Лишь бы платил щедро.'
                else:
                    $GirlTalkPersonalText = 'Аманда говорит сдержанно, поглядывая на стойку:<br><br>— Легаре смотрит иначе, чем прочие гости. Пока ничего лишнего не позволяет, но по залу уже шепотки пошли. А от сплетен беды всегда больше, чем от правды.'
                end
            end

        ! --- АМАНДА И СОСЕДСКИЕ ПАРНИ ---
        elseif $GirlTalkPersonalStoryId = 'amanda_boys':
            if sluttiness['amanda'] >= 35 or HallMissingGirlPrivateCount['amanda'] >= 2 or FamilyCorruptionStage >= 4:
                $GirlTalkPersonalText = 'Аманда тихо посмеивается, прикусывая нижнюю губу, и бросает откровенный взгляд тебе между ног:<br><br>— Про парней? — она подходит вплотную и шепчет на ухо: — После смены я не всегда бегу спать. За бочками у чёрного хода, у старого колодца... Соседские парни молодые, горячие. Лапают жадно, до синяков на бёдрах. Мне нравится чувствовать, как они дрожат от одного моего взгляда. Стыда нет, Стефан. Я беру от жизни то, чего хочу.'
            elseif sluttiness['amanda'] >= 25 or GirlNpcPath['amanda'] >= 25 or FamilyCorruptionStage >= 2:
                $GirlTalkPersonalText = 'Аманда поправляет шнуровку на груди, чуть смущаясь, но с гордостью в голосе:<br><br>— Кавалеров хватает, не жалуюсь. Один соседский парень давно проходу не даёт. Стоим у ворот допоздна, болтаем. Целовались пару раз в темноте... Руки он распускать пытался, но я вовремя осадила. Мама бы узнала — заперла бы дома. А мне приятно внимание.'
            else:
                $GirlTalkPersonalText = 'Аманда пожимает плечами, глядя в окно:<br><br>— Парни с соседней улицы постоянно крутятся возле колодца. Улыбки, глупые шуточки. Мама вечно ворчит, а мне приятно. Хоть кто-то видит во мне живую девчонку, а не только служанку с подносом.'
            end

        ! --- МЕЛИССА И МУЗЫКАНТ ---
        elseif $GirlTalkPersonalStoryId = 'melissa_musician':
            if FamilyCorruptionStage >= 3 and otkroven['melissa'] >= 25:
                $GirlTalkPersonalText = 'Мелисса нервно сцепляет пальцы, закусывает губу и медленно опускает взгляд к твоим штанам между ног, тяжело выдыхая:<br><br>— Музыкант этот... — её голос чуть вздрагивает. — Головой я всё понимаю: он менестрель, бродяга, видит привлекательную девушку и хочет затащить в постель. Но когда он начинает петь и смотрит прямо мне в глаза... у меня внутри всё обрывается. В животе всё скручивается, бросает в жар, а между ног делается мокро. Я злюсь на себя, пытаюсь включить холодный расчёт — и не могу с собой совладать. Этот менестрель для меня словно наваждение... Моё слабое место. Точно такое же, как и ты, Стефан.'
            elseif otkroven['melissa'] >= 25:
                $GirlTalkPersonalText = 'Мелисса слегка опускает глаза, и на её скулах проступает лёгкий румянец:<br><br>— На танцах один музыкант на меня всё время смотрит. Ждал после смены у переулка. Знаю, как это выглядит со стороны, но он умеет слушать. Не ждёт от меня вечной строгости и порядка. Признаюсь — он мне симпатичен. Больше, чем мне самой хотелось бы.'
            else:
                $GirlTalkPersonalText = 'Мелисса строго одёргивает рукава платья и сухо произносит:<br><br>— Музыкант один играет на площади, когда я иду за покупками. Два раза перекинулись парой фраз у ворот. Любовью это называть глупо. Просто вежливая беседа, не более того.'
            end

        ! --- САНДРА И СТОЛЯР ДРАУПНИР ---
        elseif $GirlTalkPersonalStoryId = 'sandra_carpenter':
            if FamilyCorruptionStage >= 3 and otkroven['sandra'] >= 25:
                $GirlTalkPersonalText = 'Сандра глубоко и хрипло выдыхает, поправляя вырез, и прямо смотрит тебе в глаза без тени смущения:<br><br>— Драупнир... — она лениво оглаживает своё бедро. — Мужик кряжистый, сильный, в бороде стружка. Сидели у него в мастерской, пили крепкий эль. Руки у него тяжёлые, хватка железная. Прижал меня к верстаку — и знаешь, Стефан, я не стала противиться. Бабьему телу нужна грубая мужская ласка. Ильматер простит, а перед городскими ханжами мне отчитываться не в чем.'
            elseif otkroven['sandra'] >= 25:
                $GirlTalkPersonalText = 'Сандра нервно мнёт край передника, опустив взгляд в пол:<br><br>— Драупнир, столяр... Он не только полки чинил. Сидели допоздна, разговаривали. Смотрел на меня не как на кухарку или хозяйку, а как на одинокую женщину. Стыдно мне, Стефан. Перед домом стыдно, перед памятью... Но потянуло меня к нему. Хоть на вечер почувствовать себя желанной.'
            else:
                $GirlTalkPersonalText = 'Сандра строго поджимает губы и разворачивается к плите:<br><br>— Драупнир из Квартала ремесленников делал нам стеллажи. Человек прямолинейный, дело своё знает. Задержалась я у него по хозяйственным расчётам. Дальше этого твоё любопытство заходить не должно, Стефан. Займись делом.'
            end

        ! --- САНДРА И СВЯЩЕННИК ГЕРХАРД ---
        elseif $GirlTalkPersonalStoryId = 'sandra_priest':
            if FamilyCorruptionStage >= 3 and otkroven['sandra'] >= 25:
                $GirlTalkPersonalText = 'Сандра презрительно и чувственно усмехается, очерчивая пальцем контур груди:<br><br>— Отец Герхард... — она тихо фыркает. — На проповеди очертит святой круг Ильматера, говорит о чистоте помыслов и воздержании. А сам в исповедальне глазами буквально раздевает! Дышит тяжело, в декольте заглядывает, руки дрожат. Все мужчины сделаны из одной плоти, Стефан, даже те, что в рясах ходят. Лицемерит святоша. Но если ему так хочется грешить — пусть помогает нашему дому, замаливая свои похотливые мысли.'
            elseif otkroven['sandra'] >= 25:
                $GirlTalkPersonalText = 'Сандра сцепляет пальцы в замок, её плечи напрягаются:<br><br>— Святой отец Герхард... Я ведь к нему за утешением хожу. А он говорит о грехе так, словно всю мою подноготную видит. После службы придержал у выхода, сжимал мои ладони в своих. Страшно мне стало, Стефан... и в то же время сердце заколотилось. Сама не знаю, чистое это благословение или греховный соблазн.'
            else:
                $GirlTalkPersonalText = 'Сандра хмурится и сухо роняет, не глядя на тебя:<br><br>— Священник в храме Ильматера слишком пристально смотрит на меня по воскресеньям. Заявил, что нашему дому нужно больше смирения. Что он имел в виду — не знаю, но спала я после того разговора скверно.'
            end

        else:
            $GirlTalkPersonalText = $RealName[$GirlTalkPersonalGirl] + ' на мгновение замирает, отводит взгляд и качает головой:<br><br>— Не сейчас, Стефан. Не время для таких разговоров.'
        end
    end

    killvar '$GirlTalkPersonalTextId'
---