! ================================================
! FILE: modules/actions/dialogs/girl_talk_personal_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! Агентам: НЕ переписывать prose без явного «можно править тексты».
! Перед любой переделкой файла — спросить пользователя; сохранять формулировки.
! MODULE: actions/dialogs
! Тексты личных разговоров о приключениях вне дома
! ================================================

#GirlTalkPersonalText
    $GirlTalkPersonalTextId = LCASE($ARGS[0])
    $GirlTalkPersonalText = ''

    if $GirlTalkPersonalGirl = '':
        $GirlTalkPersonalGirl = $TalkGirl
    end

    if $GirlTalkPersonalTextId = 'intro':
        if $GirlTalkPersonalGirl = 'amanda':
            $GirlTalkPersonalText = '— Личное? — Аманда щурится, будто палит, не подслушивает ли кто. — Ну давай... спрашивай. Только начнёшь нудить как хозяин — я сразу в дурочку. Ту самую, которая «ничего не знаю, ничего не было».'
        elseif $GirlTalkPersonalGirl = 'melissa':
            $GirlTalkPersonalText = '— Ладно. — Мелисса отходит от двери. — Спрашивай как брат. Не как хозяин. Я твою рожу «я тут решаю» за версту вижу.<br><br>— Личное — это не слабость. Это то, что у тебя остаётся, когда зал закрыл. Не торопи меня.'
        elseif $GirlTalkPersonalGirl = 'sandra':
            $GirlTalkPersonalText = '— Личное... — тихо, почти шёпотом. — Спрашивай, Стефан. Я не железная. Просто мать. Баба, которая слишком долго всё на себе тащила.<br><br>— Не жди, что я тебе душу выверну с порога. Но раз спросил — значит, слушать готов. И на том спасибо.'
        else:
            $GirlTalkPersonalText = 'Личное. ' + $RealName[$GirlTalkPersonalGirl] + ' не спешит отвечать — будто взвешивает, доверились ли вы по-настоящему.'
        end

    elseif $GirlTalkPersonalTextId = 'story':
        if $GirlTalkPersonalStoryId = 'amanda_legare':
            if Fact_AmandaLegareMajorRisk = 1 and otkroven['amanda'] >= 30:
                $GirlTalkPersonalText = '— Ты и так всё понял, — не поднимает глаз. — С Легаре — это не танцы. Зовёт — я иду. То ли вам назло, то ли потому что он на меня смотрит как на бабу, а не как на дочь трактирщика. Не смотри на меня как на шлюху. Врать не буду.'
            elseif Fact_AmandaLegareOutsideMeet = 1 or Fact_AmandaLegarePrivateTalk = 1:
                if otkroven['amanda'] >= 22:
                    $GirlTalkPersonalText = '— Легаре ко мне клеится, — Аманда признаётся. — Сначала выпендривался, статус показывал. Потом звать начал. Не в зал. Возвращалась злая и красная — и шла снова. Не люблю его. Но там я не пустое место.'
                else:
                    $GirlTalkPersonalText = '— Если ты про Легаре, — уводит глаза, — да, пялится не только на вино. Я держусь. Правда держусь. Только он говорит так, будто всё про меня знает. И меня это сбивает.'
                end
            else:
                $GirlTalkPersonalText = '— Легаре на меня смотрит по-другому, — осторожно. — Пока ничего такого. Но в зале уже языками чешут. А от трёпа беды больше, чем от дела.'
            end

        elseif $GirlTalkPersonalStoryId = 'amanda_boys':
            if sluttiness['amanda'] >= 35 or HallMissingGirlPrivateCount['amanda'] >= 2:
                $GirlTalkPersonalText = '— Про парней? — шёпотом, в сторону. — После смены я не всегда домой. У колодца, у чёрного входа... Знаю, как это выглядит. Иногда делаю больше, чем надо. Не влюблена. Просто там меня хотят. Меня, а не официантку.'
            elseif sluttiness['amanda'] >= 25 or GirlNpcPath['amanda'] >= 25:
                $GirlTalkPersonalText = '— Кавалеров хватает, — Аманда. — Один давно подкатывает. Отшучиваюсь, но у ворот торчу дольше, чем мама бы разрешила. Целовались. Дальше?.. Наверное, нет.'
            else:
                $GirlTalkPersonalText = '— Парни с соседней улицы давно липнут, — Аманда. — Улыбка, трёп у колодца. Мама бы заругала. А мне приятно. Хоть кто-то смотрит на меня, а не на поднос.'
            end

        elseif $GirlTalkPersonalStoryId = 'melissa_musician':
            if otkroven['melissa'] >= 28:
                $GirlTalkPersonalText = '— На танцах один музыкант на меня только и смотрит, — без шуток. — Думала, рисуется. А он потом ждал после смены. Знаю, как это выглядит. Но он слушает. Не ждёт, что я сильная. И да — он мне нравится. Больше, чем я хочу.'
            else:
                $GirlTalkPersonalText = '— Музыкант один играет, когда я иду мимо, — Мелисса сухо. — Любовью не назову. Два раза у выхода поболтали. Я не сразу ушла.'
            end

        elseif $GirlTalkPersonalStoryId = 'sandra_carpenter':
            if otkroven['sandra'] >= 30:
                $GirlTalkPersonalText = '— Драупнир... — Сандра тяжело вздыхает. — Не только полки чинил. Сидели, говорил со мной. Без сальных намёков. Я задержалась. Подробностей не будет. Стыдно мне. Перед Ильматером, перед вами. Но тянет меня туда. Там я баба, а не мать-надзиратель.'
            else:
                $GirlTalkPersonalText = '— Драупнир, столяр с ремесленного, — тихо. — Полки делал. Смотрит без похоти, но в душу. Возвращалась я позже, чем сказала. Дальше — не твоё дело, Стефан.'
            end

        elseif $GirlTalkPersonalStoryId = 'sandra_priest':
            if otkroven['sandra'] >= 32:
                $GirlTalkPersonalText = '— Отец Герхард... — Сандра руки сжимает. — Я к нему не только молиться хожу. Он про грех говорит так, будто мой знает. После службы мы говорили. Долго. На меня так смотрят — и страшно, и легче. Не устраивай мне допрос, Стефан. Я сама не знаю, грех это или я просто впервые выговорилась.'
            else:
                $GirlTalkPersonalText = '— Священник на нас в воскресенье слишком смотрит, — Сандра сухо. — После проповеди меня у двери придержал. Сказал, «дому Лонгкоков нужна забота». Что он имел в виду — не знаю. Спала я после этого плохо.'
            end

        else:
            $GirlTalkPersonalText = $RealName[$GirlTalkPersonalGirl] + ' начала говорить — и замолчала.<br><br>— Не сегодня. Не могу.'
        end
    end

    killvar '$GirlTalkPersonalTextId'
---