! ================================================
! FILE: modules/actions/dialogs/girl_talk_personal_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! [AI-WORKED] Текст переработан / дополнен ассистентом 30.10.2026
! MODULE: actions/dialogs
! Тексты личных разговоров о приключениях вне дома
! ================================================

#GirlTalkPersonalText
    $GirlTalkPersonalTextId = LCASE($ARGS[0])
    $GirlTalkPersonalText = ''

    if $GirlTalkPersonalGirl = '':
        $GirlTalkPersonalGirl = $TalkGirl
    end

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (ЛИЧНЫЙ ТОН, РАСКОВАННОСТЬ, ОТКРОВЕНИЕ)
    ! ----------------------------------------------------
    if $GirlTalkPersonalTextId = 'intro':
        if $GirlTalkPersonalGirl = 'amanda':
            if FamilyCorruptionStage >= 3 or otkroven['amanda'] >= 30:
                *pl 'Аманда прислоняется бедром к косяку двери, скрещивает руки под грудью и вскидывает подбородок. Её взгляд медленно скользит по твоему телу и задерживается на штанах между ног с лукавой усмешкой:'
                *pl ' '
                *pl '— Личное? — она подаётся чуть вперёд, облизав губы. — Ну давай, спрашивай.'
                *pl ' '
                *pl 'Мы уже давно не в том положении, чтобы строить из себя пай-девочку и строгово брата. Хочешь знать правду — скажу. Только без хозяйских замашек, Стефан. Сама решу, чем делиться.'
                *pl ' '
            elseif otkroven['amanda'] >= 18:
                *pl 'Аманда одёргивает подол юбки, переступает с ноги на ногу и отводит прядь волос за ухо, внимательно глядя тебе в глаза:'
                *pl ' '
                *pl '— Личное? Ладно, валяй, — она слегка хмурится, но не отходит. — Только не сверли меня взглядом, как строгий судья. Если начнёшь читать нотации — сразу уйду к столикам. Спрашивай по-человечески.'
                *pl ' '
            else:
                *pl 'Аманда отступает на шаг назад, складывает руки на груди и недоверчиво щурится:'
                *pl ' '
                *pl '— Личное? А тебе-то какое дело, Стефан? — она косится на дверь зала. — За стойкой следи. Начнёшь лезть в душу с расспросами — я сразу в дурочку сыграю. Ничего не знаю, ничего не слышала.'
                *pl ' '
            end

        elseif $GirlTalkPersonalGirl = 'melissa':
            if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 30:
                *pl 'Мелисса неторопливо закрывает конторскую книгу, опирается спиной на полку и скрещивает длинные ноги. Её губы кривятся в насмешливой полуулыбке, а цепкий взгляд опускается к твоему поясу:'
                *pl ' '
                *pl '— О личном поговорить пришёл? — она тихо хмыкает, чуть наклонив голову. — Спрашивай прямо. Границы приличий мы уже благополучно перешагнули, так что глупо притворяться скромницей. Что тебя интересует? Задавай вопрос — получишь точный ответ.'
                *pl ' '
            elseif otkroven['melissa'] >= 18:
                *pl 'Мелисса откладывает перо в сторону, разминает тонкие пальцы и поворачивается к тебе, уперев руку в бок:'
                *pl ' '
                *pl '— Спрашивай как брат, Стефан. Не как хозяин трактира, — голос звучит сухо, но взгляд мягче обычного. — Твою мину «я тут главный» я за версту чую. Не дави, дай сформулировать мысль.'
                *pl ' '
            else:
                *pl 'Мелисса окидывает тебя холодным взглядом поверх гроссбуха и постукивает ногтем по столешнице:'
                *pl ' '
                *pl '— Моё личное остаётся за порогом трактира, Стефан. Если есть дело по залу или счетам — говори. Праздную болтовню я не развожу.'
                *pl ' '
            end

        elseif $GirlTalkPersonalGirl = 'sandra':
            if FamilyCorruptionStage >= 3 or otkroven['sandra'] >= 30:
                *pl 'Сандра откладывает полотенце, подаётся вперёд и обеими руками поправляет вырез платья, демонстративно открывая пышную ложбинку. Её взгляд опускается прямо к твоим штанам между ног, задерживаясь на паху с бесстыдной усмешкой:'
                *pl ' '
                *pl '— Личное, Стефан?.. — она говорит низким, хрипловатым голосом. — Спрашивай, не робей. От тебя мне теперь скрывать нечего. Сама знаю, какая я есть, и ты давно не мальчишка. Подойди ближе, говори прямо в лицо. Я тебя слушаю.'
                *pl ' '
            elseif otkroven['sandra'] >= 18:
                *pl 'Сандра вытирает руки о передник, смахивает прядь волос со лба и негромко вздыхает:'
                *pl ' '
                *pl '— Личное... — она смотрит на тебя устало, но тепло. — Спрашивай, сынок. Я не железная. Слишком долго всё тянула на собственных плечах. Душу наизнанку с порога не выверну, но раз сам спросил — значит, слушать готов.'
                *pl ' '
            else:
                *pl 'Сандра строго сдвигает брови, не прекращая нарезать овощи на доске:'
                *pl ' '
                *pl '— Не до праздных речей сейчас, Стефан. Обед сам себя не сварит. Если что-то срочное по дому — выкладывай сразу, а душу бередить нечего.'
                *pl ' '
            end

        else:
            $GirlTalkPersonalText = $RealName[$GirlTalkPersonalGirl] + ' слегка приподнимает подбородок и смотрит на тебя, оценивая, насколько искренен твой интерес.'
        end

    ! ----------------------------------------------------
    ! 2. ИСТОРИИ И ПРИКЛЮЧЕНИЯ ВНЕ ДОМА
    ! ----------------------------------------------------
    elseif $GirlTalkPersonalTextId = 'story':

        ! --- АМАНДА И ЛЕГАРЕ ---
        if $GirlTalkPersonalStoryId = 'amanda_legare':
            if Fact_AmandaLegareMajorRisk = 1:
                if FamilyCorruptionStage >= 3 or sluttiness['amanda'] >= 35:
                    *pl 'Аманда вызывающе прикусывает губу, упирает руки в бока и дерзко смотрит тебе в глаза:'
                    *pl ' '
                    *pl '— Ты и сам прекрасно всё понимаешь, — в голосе звучит вызов. — С Легаре это давно не невинные танцы. Он богатый хлыщ, у него мошна лопается от серебра. Он пялится на меня как на женщину, жадно и без стеснения.'
                    *pl ' '
                    *pl 'И меня это заводит, Стефан! Я кручу им, как хочу, вытягиваю подарки. А если решу лечь под него — это будет мой выбор. Не смей мне указывать, сам хорош.'
                    *pl ' '
                elseif otkroven['amanda'] >= 25:
                    *pl 'Аманда опускает глаза и теребит завязки фартука, покусывая губу:'
                    *pl ' '
                    *pl '— Ты и так всё понял, — роняет она с усмешкой. — Легаре зовёт — я иду. Он видит во мне взрослую, привлекательную девку, а не сопливую подавальщицу. И на подарки не скупится. Мужиков нужно уметь крутить вокруг пальца, Стефан! Сама решу, кому улыбаться, а ты за залом следи.'
                    *pl ' '
                else:
                    *pl 'Аманда хмурится и отворачивается к стене:'
                    *pl ' '
                    *pl '— Не лезь ко мне с допросами про Легаре, Стефан. Что было на улице — моё дело. За собой лучше следи.'
                    *pl ' '
                end

            elseif Fact_AmandaLegareOutsideMeet = 1 or Fact_AmandaLegarePrivateTalk = 1:
                if FamilyCorruptionStage >= 3 or otkroven['amanda'] >= 25:
                    *pl 'Аманда усмехается, поправляя волосы, и стреляет глазами вниз, к твоему поясу:'
                    *pl ' '
                    *pl '— Легаре крутится вокруг меня как кот у миски. Зовёт в укромные углы, нашёптывает комплименты. Думает, раз у него тонкие сапоги и серебро в кармане, я сразу юбку задеру.'
                    *pl ' '
                    *pl 'Пусть надеется! Держать богатого дурака на поводке — сущее удовольствие. Я не пропаду, Стефан, не бойся.'
                    *pl ' '
                elseif otkroven['amanda'] >= 18:
                    *pl 'Аманда признаётся, отводя взгляд в сторону:'
                    *pl ' '
                    *pl '— Легаре ко мне липнет. Сначала надувал щёки и показывал статус, теперь на свидания зовёт за угол. Я возвращалась злая, но шла снова. Не люблю я его, Стефан. Но рядом с ним я чувствую, что чего-то стою.'
                    *pl ' '
                else:
                    *pl 'Аманда отводит глаза и нервно поправляет манжет:'
                    *pl ' '
                    *pl '— Пялится этот Легаре не только на кувшины с вином, это правда. Но я держу дистанцию. Он говорит красиво, зубы заговаривает, но руки распускать я ему не даю.'
                    *pl ' '
                end

            else:
                if FamilyCorruptionStage >= 3:
                    *pl 'Аманда лениво усмехается, скользя взглядом по твоей фигуре:'
                    *pl ' '
                    *pl '— Легаре смотрит на меня так, будто уже приценился. Мужики в зале все одинаковые — слюни пускают на всё, что движется. Пусть смотрит, мне не убудет. Лишь бы платил щедро.'
                    *pl ' '
                else:
                    *pl 'Аманда говорит сдержанно, поглядывая на стойку:'
                    *pl ' '
                    *pl '— Легаре смотрит иначе, чем прочие гости. Пока ничего лишнего не позволяет, но по залу уже шепотки пошли. А от сплетен беды всегда больше, чем от правды.'
                    *pl ' '
                end
            end

        ! --- АМАНДА И СОСЕДСКИЕ ПАРНИ ---
        elseif $GirlTalkPersonalStoryId = 'amanda_boys':
            if sluttiness['amanda'] >= 35 or HallMissingGirlPrivateCount['amanda'] >= 2 or FamilyCorruptionStage >= 4:
                *pl 'Аманда тихо посмеивается, прикусывая нижнюю губу, и бросает откровенный взгляд тебе между ног:'
                *pl ' '
                *pl '— Про парней? — она подходит вплотную и шепчет на ухо: — После смены я не всегда бегу спать. За бочками у чёрного хода, у старого колодца... Соседские парни молодые, горячие.'
                *pl ' '
                *pl 'Лапают жадно, до синяков на бёдрах. Мне нравится чувствовать, как они дрожат от одного моего взгляда. Стыда нет, Стефан. Я беру от жизни то, чего хочу.'
                *pl ' '
            elseif sluttiness['amanda'] >= 25 or GirlNpcPath['amanda'] >= 25 or FamilyCorruptionStage >= 2:
                *pl 'Аманда поправляет шнуровку на груди, чуть смущаясь, но с гордостью в голосе:'
                *pl ' '
                *pl '— Кавалеров хватает, не жалуюсь. Один соседский парень давно проходу не даёт. Стоим у ворот допоздна, болтаем.'
                *pl ' '
                *pl 'Целовались пару раз в темноте... Руки он распускать пытался, но я вовремя осадила. Мама бы узнала — заперла бы дома. А мне приятно внимание.'
                *pl ' '
            else:
                *pl 'Аманда пожимает плечами, глядя в окно:'
                *pl ' '
                *pl '— Парни с соседней улицы постоянно крутятся возле колодца. Улыбки, глупые шуточки. Мама вечно ворчит, а мне приятно. Хоть кто-то видит во мне живую девчонку, а не только служанку с подносом.'
                *pl ' '
            end

        ! --- МЕЛИССА И МУЗЫКАНТ ---
        elseif $GirlTalkPersonalStoryId = 'melissa_musician':
            if FamilyCorruptionStage >= 3 and otkroven['melissa'] >= 25:
                *pl 'Мелисса нервно сцепляет пальцы, закусывает губу и медленно опускает взгляд к твоим штанам между ног, тяжело выдыхая:'
                *pl ' '
                *pl '— Музыкант этот... — её голос чуть вздрагивает. — Головой я всё понимаю: он менестрель, бродяга, видит привлекательную девушку и хочет затащить в постель. Но когда он начинает петь и смотрит прямо мне в глаза... у меня внутри всё обрывается.'
                *pl ' '
                *pl 'В животе всё скручивается, бросает в жар, а между ног делается мокро. Я злюсь на себя, пытаюсь включить холодный расчёт — и не могу с собой совладать. Этот менестрель для меня словно наваждение... Моё слабое место. Точно такое же, как и ты, Стефан.'
                *pl ' '
            elseif otkroven['melissa'] >= 25:
                *pl 'Мелисса слегка опускает глаза, и на её скулах проступает лёгкий румянец:'
                *pl ' '
                *pl '— На танцах один музыкант на меня всё время смотрит. Ждал после смены у переулка. Знаю, как это выглядит со стороны, но он умеет слушать. Не ждёт от меня вечной строгости и порядка. Признаюсь — он мне симпатичен. Больше, чем мне самой хотелось бы.'
                *pl ' '
            else:
                *pl 'Мелисса строго одёргивает рукава платья и сухо произносит:'
                *pl ' '
                *pl '— Музыкант один играет на площади, когда я иду за покупками. Два раза перекинулись парой фраз у ворот. Любовью это называть глупо. Просто вежливая беседа, не более того.'
                *pl ' '
            end

        ! --- САНДРА И СТОЛЯР ДРАУПНИР ---
        elseif $GirlTalkPersonalStoryId = 'sandra_carpenter':
            if FamilyCorruptionStage >= 3 and otkroven['sandra'] >= 25:
                *pl 'Сандра глубоко и хрипло выдыхает, поправляя вырез, и прямо смотрит тебе в глаза без тени смущения:'
                *pl ' '
                *pl '— Драупнир... — она лениво оглаживает своё бедро. — Мужик кряжистый, сильный, в бороде стружка. Сидели у него в мастерской, пили крепкий эль.'
                *pl ' '
                *pl 'Руки у него тяжёлые, хватка железная. Прижал меня к верстаку — и знаешь, Стефан, я не стала противиться. Бабьему телу нужна грубая мужская ласка. Ильматер простит, а перед городскими ханжами мне отчитываться не в чем.'
                *pl ' '
            elseif otkroven['sandra'] >= 25:
                *pl 'Сандра поправляет фартук, глядя прямо и спокойно:'
                *pl ' '
                *pl '— Драупнир, столяр... Мужик прямой и крепкий. Сидели допоздна, пили крепкий эль, говорили начистоту. Смотрел на меня не как на кухарку, а как на желанную женщину.'
                *pl ' '
                *pl 'Женскому телу ласка нужна, Стефан. Я взрослая женщина и имею право на радость. А перед городскими святошами мне оправдываться не в чем.'
                *pl ' '
            else:
                *pl 'Сандра строго поджимает губы и разворачивается к плите:'
                *pl ' '
                *pl '— Драупнир из Квартала ремесленников делал нам стеллажи. Человек прямолинейный, дело своё знает. Задержалась я у него по хозяйственным расчётам. Дальше этого твоё любопытство заходить не должно, Стефан. Займись делом.'
                *pl ' '
            end

        ! --- САНДРА И СВЯЩЕННИК ГЕРХАРД ---
        elseif $GirlTalkPersonalStoryId = 'sandra_priest':
            if FamilyCorruptionStage >= 3 and otkroven['sandra'] >= 25:
                *pl 'Сандра негромко говорит, поправляя вырез платья:'
                *pl ' '
                *pl '— Прихожане слушают отца Герхарда без всяких сомнений. Церковь в городе — непререкаемый авторитет, что пастырь с амвона объявил, то для людей закон. Этим он и пользуется. А ведь Герхард спит и видит, как вернуться в столицу, а попутно оприходовать всех красивых горожанок в округе!'
                *pl ' '
                *pl 'На этой почве у него даже был глухой конфликт с мэром. Но мэр отступил: рассудил трезво, что священник тут временщик — уедет в столицу, а с горожанок не убудет. Тем более за проповедями стоит вектор самой герцогини: ей нужно бурное скрещивание и рост населения фронтира. Поэтому церковь здесь даже не борется с местными религиями гномов, орков и эльфов, а ловко приспосабливает их под себя, выдавая за священное наследие Ильматера. Вот святой отец и пользуется плодами покорности паствы прямо за церковной ширмой.'
                *pl ' '
            elseif otkroven['sandra'] >= 25:
                *pl 'Сандра делится наблюдениями, понизив голос:'
                *pl ' '
                *pl '— Простые горожане верят каждому слову отца Герхарда: авторитет церкви безусловен, спорить с амвоном никто не посмеет. А святой отец стремится всеми силами выслужиться и вернуться в столицу, попутно затаскивая к себе за ширму городских красавиц. Из-за этого у него случился конфликт с мэром, но мэр отступил: знает, что святоша тут временщик, а с горожанок не убудет.'
                *pl ' '
                *pl 'К тому же вектор проповедей задаёт сама герцогиня. Ей нужно скорейшее освоение края, поэтому церковь не воюет с культами гномов, орков и эльфов, а подгоняет их древние обычаи плодородия под заветы Ильматера, толкая народы к скрещиванию. Герхард выслуживает столичный перевод, а народ внимает ему без тени сомнения.'
                *pl ' '
            else:
                *pl 'Сандра хмурится и сухо роняет, не глядя на тебя:'
                *pl ' '
                *pl '— Прихожане слушают отца Герхарда безоговорочно: церковь для всех непререкаемый авторитет. Он выслуживает прощение герцогини, чтобы вернуться в столицу, и мечтает оприходовать всех видных женщин города. Мэр с ним спорить не стал и отступил: понимает, что святоша тут временщик, а с горожанок не убудет. Да и церковь по указке герцогини не трогает веру гномов, орков и эльфов, подгоняя их древнее наследие под Ильматера ради скрещивания народов.'
                *pl ' '
            end

        else:
            *pl $RealName[$GirlTalkPersonalGirl] + ' на мгновение замирает, отводит взгляд и качает головой:'
            *pl ' '
            *pl '— Не сейчас, Стефан. Не время для таких разговоров.'
            *pl ' '
        end
    end

    killvar '$GirlTalkPersonalTextId'
---