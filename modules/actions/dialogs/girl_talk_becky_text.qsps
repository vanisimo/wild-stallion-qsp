        *pl ' '
        BeckyTalkHomeInvitePoints += 1
    else:
        *pl 'Ты не находишь подходящих слов про Эдди и лишь неопределённо пожимаешь плечами.'
        *pl ' '
    end

    *pl '— А дочка моя старшая, Ингеборг? — пристально смотрит тебе в глаза вдова.'
    *pl ' '

