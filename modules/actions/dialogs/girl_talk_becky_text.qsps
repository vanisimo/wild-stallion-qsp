        BeckyTalkHomeInvitePoints = 0
        exit
    end

    BeckyTalkHomeInvitePoints = 0
    *pl '— Стефанчик, я бы и рада тебя пригреть, но что дети скажут? — вздыхает Бекки, теребя фартук. — Вот Эдди — как я родному сыну в глаза смотреть буду, если молодого кавалера в дом приведу?'
    *pl ' '

