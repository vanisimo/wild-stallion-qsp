#GirlTalkSandraLimitReachedText
    if $GirlLocation['sandra'] = 'SandraRoom' or time = 5:
        if FamilyCorruptionStage >= 3 and (SandraHomeSex >= 1 or HadSex['sandra'] >= 1):
            *pl 'Сандра поправляет край сорочки и бросает на тебя томный, лукавый взгляд:'
            *pl '— Стефан, ночь на дворе, посуда вымыта, а глаза сами закрываются. Если пришёл за лаской — закрывай дверь на засов. А если просто лясы точить — дай матери выспаться, завтра договорим.'
        else:
            *pl 'Сандра устало, но тепло качает головой, опуская руки на колени:'
            *pl '— Стефан, ночь на дворе, спать пора. Давай-ка отдыхай, хозяин. Завтра договорим, если это ещё будет важно.'
        end
    else:
        if FamilyCorruptionStage >= 3 and (SandraHomeSex >= 1 or HadSex['sandra'] >= 1):
            *pl 'Сандра с насмешливой улыбкой легонько толкает тебя бедром от плиты:'
            *pl '— У меня суп перекипит, а ты мне тут зубы заговариваешь и под юбку норовишь заглянуть. Иди в зал, хозяин. Вечером в комнате всё обсудим без свидетелей.'
        else:
            *pl 'Сандра тепло, но твёрдо качает головой, вытирая руки полотенцем:'
            *pl '— Стефан, у меня суп убежит, а ты всё лясы точишь. Давай-ка займись делом, хозяин. Вечером или завтра договорим, если это ещё будет важно.'
        end
    end
