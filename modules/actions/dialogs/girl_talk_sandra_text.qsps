! ================================================
! FILE: modules/actions/dialogs/girl_talk_sandra_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! MODULE: actions/dialogs
! Живые контекстные диалоги Сандры о дочерях, городе и семье
! ================================================

#GirlTalkDaughtersText
    $GirlTalkDaughtersTextId = LCASE($ARGS[0])
    $GirlTalkDaughtersText = ''

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (ЛОКАЦИЯ, АТМОСФЕРА, РАСКОВАННОСТЬ)
    ! ----------------------------------------------------
    if $GirlTalkDaughtersTextId = 'intro':
        $SandraTalkLoc = $GirlLocation['sandra']
        if $SandraTalkLoc = '':
            $SandraTalkLoc = 'Kitchen'
        end

        if $SandraTalkLoc = 'Kitchen':
            if SandraHomeSex >= 1 or HadSex['sandra'] >= 1 or FamilyCorruptionStage >= 3:
                $GirlTalkDaughtersText = 'Завидев тебя на пороге, Сандра неторопливо откладывает нож, подаётся вперёд и обеими руками снизу вверх поправляет пышную грудь в вырезе, выкатывая её наружу ещё откровеннее. Её взгляд тут же скользит вниз по твоему телу — прямо к штанам между ног, жадно и без малейшего стыда задерживаясь на выпуклости паха. Облизнув припухшие губы, она упирается бёдрами в край стола и хрипловато усмехается:<br><br>— О девчонках потолковать пришёл, Стефан? — она медленно ведёт пальцем по ключице к глубокой ложбинке. — Или соскучился по хозяйке? Подойди ближе, не держи руки по швам. У меня от одного твоего вида низ живота тянет... Стой так рядом, пока этот дубовый стол под нами не затрещал. Говори, я слушаю.'
            else:
                $GirlTalkDaughtersText = 'Сандра сноровисто перебирает кухонную утварь, то и дело поправляя завязки фартука на талии. Услышав твои шаги, она вытирает ладони о полотенце, стряхивает прядь со лба и разворачивается всем корпусом, внимательно оглядывая тебя с ног до головы.<br><br>— Ты как раз вовремя, Стефан, — она смахивает крошки с края стола и скрещивает руки под грудью. — О девчонках поговорить хочешь? Для семьи у меня всегда минутка найдётся. Выкладывай, что приметил, я слушаю.'
            end

        elseif $SandraTalkLoc = 'SandraRoom':
            if SandraHomeSex >= 1 or HadSex['sandra'] >= 1 or FamilyCorruptionStage >= 3:
                $GirlTalkDaughtersText = 'Сандра сидит на краю постели в тонкой сорочке с распахнутым воротом, из которого едва не вываливается налившаяся грудь с тёмными сосками. Заметив тебя, она откладывает гребень, широко разводит округлые бёдра, натягивая подол, и манит тебя пальцем. Её взгляд медленно и жадно спускается к твоим штанам между ног, задерживаясь на паху с откровенным предвкушением:<br><br>— Дверь на засов задвинь, Стефан, — хрипло выдыхает она, поглаживая своё бедро ладонью и призывно похлопывая по одеялу. — Садись ко мне вплотную. О девчонках потолковать хочешь или сам знаешь, зачем пришёл? Не мучай меня пустыми речами, у меня между ног уже жарко делается, стоит тебе рядом встать... Говори, пока я сама с тебя штаны не стащила.'
            else:
                $GirlTalkDaughtersText = 'Сандра сидит на деревянной скамье у окна, разминая затёкшую шею и поправляя ворот платья. Увидев тебя на пороге, она опускает руки на колени и кивает на соседний табурет:<br><br>— Заходи, Стефан, закрой дверь от сквозняка. С ног валюсь к вечеру, хоть спину разогнуть. О семье поговорить пришёл? Присаживайся, слушаю тебя внимательно. Давай начистоту, как есть.'
            end

        else:
            if SandraHomeSex >= 1 or HadSex['sandra'] >= 1 or FamilyCorruptionStage >= 3:
                $GirlTalkDaughtersText = 'Сандра делает шаг тебе навстречу, прижимаясь упругой грудью к твоей руке, и без тени смущения скользит ладонью по твоему животу прямо к поясу штанов. Её глаза опускаются вниз, стреляя откровенным похотливым взглядом между твоих ног:<br><br>— Выкроил минутку, Стефан? — шепчет она горячо на ухо, прикусив нижнюю губу. — Спрашивай, что хотел. Только не прижимайся так близко, если не собираешься прямо здесь задрать мне юбки. Я ведь для тебя всегда на взводе...'
            else:
                $GirlTalkDaughtersText = 'Сандра поправляет съехавший фартук, одёргивает подол платья и оборачивается к тебе, уперев руку в бок:<br><br>— Слушаю тебя, Стефан. Ты здесь хозяин, я за домом гляжу. О девчонках слово замолвить хочешь? Говори прямо.'
            end
        end

        killvar '$SandraTalkLoc'

    ! ----------------------------------------------------
    ! 2. ВЕХИ ОТНОШЕНИЙ И БЛИЗОСТИ (ДИНАМИЧЕСКИЙ БЛОК)
    ! ----------------------------------------------------
    elseif $GirlTalkDaughtersTextId = 'milestone':
        if LastSexDay['sandra'] > 0 and (day - LastSexDay['sandra'] <= 1) and (SexGirlCameInScene >= 6 or SexGirlExhausted = 1 or SexMarathonGossipPending['sandra'] = 1):
            $GirlTalkDaughtersText = 'Сандра вдруг прикусывает губу и медленно проводит ладонью по внутреннему краю своего бедра, чуть приподнимая край юбки. Её взгляд падает прямо на твои штаны между ног, скользя по очертаниям члена с жадной, бесстыдной усмешкой:<br><br>— Ты только погляди на него... Стоит с невинным видом, будто и не ты меня только вчера до беспамятства драл! — она шумно втягивает воздух, прикрыв глаза. — У меня внутри до сих пор всё ноет и пульсирует от твоих толчков, между ног влажно, а ноги дрожат, стоит вспомнить, как ты меня нагибал и засаживал до самого упора. Ненасытный жеребец... Гляжу сейчас на твой стояк в штанах — и снова низ живота жжёт. Хоть бросай всё и лезь под юбку...'
        elseif SandraHomeSex >= 1 and (day - LastSexDay['sandra'] >= 4):
            $GirlTalkDaughtersText = 'Сандра делает резкий шаг к тебе, упирается ладонями в твой пояс и демонстративно опускает глаза к твоей промежности, ощупывая взглядом напряжённые штаны между ног:<br><br>— А я уж думала, ты вовсе забыл дорогу в мою постель, — с хриплым укором цедит она, дразняще прижимаясь лобком к твоей ноге. — Ходишь тут гоголем, за чужими юбками косишься, пока у меня внутри всё горит без твоего горячего хера! Моя дырочка истосковалась по хорошей порке. Смотри у меня, Стефан: ещё пару дней промаешься — сама затащу в угол, расстегну твои порты и оседлаю до белых глаз. Не смей заставлять меня голодать, понял?'
        elseif SandraBirthRevealTalkDone = 1 and SandraBirthLoreTalkDone = 0:
            SandraBirthLoreTalkDone = 1
            $GirlTalkDaughtersText = 'Сандра подходит ближе, крепко сжимает твоё плечо и смотрит прямо в глаза, откинув выбившийся локон назад:<br><br>— Знаешь, Стефан... Я ведь всё думаю о том разговоре про графа Лермонта. Под одним сердцем я вас троих выносила, но отцы разные. Только на нашем диком фронтире на столичные сословные бредни всем плевать с высокой колокольни. Здесь главное не то, чья кровь в грамотах записана, а то, кто рядом спину прикрывает. Ты встал во главе дома, оберегаешь меня и девчонок. И что бы городские сплетники ни шипели — мы одна крепкая семья, и никто нам не указ.'
        end

    ! ----------------------------------------------------
    ! 3. ОСНОВНОЙ КОНТЕКСТ (ДЕВЧОНКИ, ГОРОДСКИЕ СЕКРЕТЫ, СЕМЬЯ)
    ! ----------------------------------------------------
    elseif $GirlTalkDaughtersTextId = 'context':
        ! Приоритет 1: Стычка или ухаживания Легаре вокруг Аманды
        if (AmandaLegareTalkReady = 1 or FactHappened['amanda_dancewithlegare_1'] = 1 or AmandaLegareInterest >= 10) and SandraLegareTalkDay <> day:
            SandraLegareTalkDay = day
            if FamilyCorruptionStage >= 3:
                $GirlTalkDaughtersText = 'Сандра с усмешкой поправляет глубокий вырез, приваливается бедром к столу и хмыкает:<br><br>— Альбер этот, винный индюк, всё вокруг нашей Аманды хвостом крутит. Думает, раз у него погреба ломятся да мошна трещит, так любая девчонка ему в рот заглядывать будет. Аманда у нас девка острая, пусть покрутит ему нос да выдоит звонкого серебра на наш трактир, дураков учить надо! Только ты за этим франтом приглядывай в оба глаза, Стефан. Если этот хлыщ вздумает распустить руки или обидеть девчонку — не церемонься, сверни ему нос набок. Пусть знает, чьих девок лапать вздумал.'
            else:
                $GirlTalkDaughtersText = 'Сандра нервно одёргивает передник и озабоченно качает головой:<br><br>— Меня этот виноторговец Легаре из ума не идёт. Богатый, лощёный, с кошельком наперевес... Таким господам юные девочки вроде Аманды — всего лишь забава на пару ночей. Поиграет, сломает ради потехи и бросит, а нам потом слёзы утирать. Ты уж поговори с сестрой построже, Стефан. Нельзя ей верить сладким речам этого лиса.'
            end

        ! Приоритет 2: Ротация тем (Мелисса, Аманда, городские секреты, семейный уклад)
        else:
            SandraDaughtersTopicCycle += 1
            if SandraDaughtersTopicCycle > 3:
                SandraDaughtersTopicCycle = 0
            end

            ! Тема 0: Мелисса
            if SandraDaughtersTopicCycle = 0:
                $GirlTalkDaughtersText = 'Сандра смахивает прядь со лба и негромко посмеивается:<br><br>— Мелисса наша всё пытается железную леди из себя корчить. Засядет с гроссбухами, счётами трещит, губы подожмёт — прямо госпожа управляющая! Всё хочет доказать, что она тут самая рассудительная. А я-то вижу, как она на тебя украдкой поглядывает, когда ты порядок наводишь. Чуть ты голос повысишь по-хозяйски — у неё сразу вся спесь слетает, и ушки розовеют. Умная она девка, но женское сердце счётами не заменишь — ей сильное плечо рядом нужно.'

            ! Тема 1: Аманда
            elseif SandraDaughtersTopicCycle = 1:
                $GirlTalkDaughtersText = 'Сандра упирает руки в бока и со вздохом улыбается:<br><br>— Аманда у нас чистый порох. Чуть искра — и вспыхнет. Характер дерзкий, норовистый, слова в простоте не скажет. То перед гостями кокетничает, то огрызается. Но ты не сердись на неё шибко. Молодая девка пробует мир на прочность. Ей вожак нужен, Стефан: чтоб осадил вовремя, но не со злобой, а крепко и по-свойски. Она к тебе тянется, хоть и хорохорится.'

            ! Тема 2: Городские сплетни и секреты Сандры (Драупнир, священник Герхард или атмосфера)
            elseif SandraDaughtersTopicCycle = 2:
                if (PlayerKnows_SandraDraupnirFriday = 1 or SandraConfessedDraupnir = 1 or GirlPersonalStoryDone['sandra_sandra_carpenter'] = 1) and SandraSecretStoryCycle = 0:
                    SandraSecretStoryCycle = 1
                    $GirlTalkDaughtersText = 'Сандра лукаво прищуривается, лениво поглаживая своё бедро:<br><br>— Про столяра Драупнира нашего вспоминаю — до сих пор смех берёт. Гном кряжистый, руки что твои молоты, в бороде вечно стружка! Никаких вздохов при луне да витиеватых речей. Зато уж если за дело берётся — щепки летят так, что стены трещат! Простой, крепкий мужик. На нашем фронтире такая сила и прямота куда честнее столичных соплей.'
                elseif (PlayerKnows_SandraGerhardVisits = 1 or GirlPersonalStoryDone['sandra_sandra_priest'] = 1) and SandraSecretStoryCycle = 1:
                    SandraSecretStoryCycle = 0
                    $GirlTalkDaughtersText = 'Сандра кривит губы в насмешливой улыбке, скрестив руки под налившейся грудью:<br><br>— А святой отец Герхард наш... У алтаря проповеди заводит о святом круге, чистоте души и смирении плоти. А сам за исповедальной ширмой так глазами по женским вырезам шарит, словно благословение через юбки раздаёт! Все они одним миром мазаны, Стефан: кровь у всех горячая, хоть в сутане, хоть в штанах. Только священники ещё и лицемерят в три слоя, а я этого с детства терпеть не могу.'
                else:
                    if SandraSecretStoryCycle = 0:
                        SandraSecretStoryCycle = 1
                    else:
                        SandraSecretStoryCycle = 0
                    end
                    if FamilyCorruptionStage >= 3:
                        $GirlTalkDaughtersText = 'Сандра беспечно машет рукой, оглаживая округлое бедро:<br><br>— В городке про наш трактир чего только не болтают кумушки. И девки, мол, у нас слишком бойкие, и порядки слишком вольные. А я говорю: пусть захлебнутся своей желчью! Завидуют, что у нас жизнь бьёт ключом, серебро звенит, а под нашей крышей никто не скучает.'
                    else:
                        $GirlTalkDaughtersText = 'Сандра делает шаг ближе и негромко делится мыслями:<br><br>— В городе сейчас ухо востро надо держать. Купцы норовят обсчитать на поставках муки и солода, а соседи только и ждут, чтоб мы оступились. Но пока ты в зале порядок держишь, я за спину спокойна.'
                    end
                end

            ! Тема 3: Семейный уклад и фронтирная гордость
            else:
                if FamilyCorruptionStage >= 4:
                    $GirlTalkDaughtersText = 'Сандра тихо и довольно смеётся, подавшись к тебе вплотную и заглядывая в глаза:<br><br>— Знаешь, Стефан... а ведь славно мы теперь живём. Никакой показной праведности, никакого страха перед чужим судом. Девчонки цветут, в заведении полно народу, а у нас под крышей — тепло, сытно и весело. Мы сами себе закон и опора. И пока мы держимся друг за друга — ни одна собака в городе нам не страшна.'
                elseif FamilyTension > FamilyTrust + 10:
                    $GirlTalkDaughtersText = 'Сандра тяжело вздыхает, опуская плечи:<br><br>— Тяжело девчонкам пока между собой. Слишком много обид накопилось за прежние голодные годы. Мелисса ворчит, Аманда ерепенится. Но я вижу, что ты стараешься их помирить. Не отступай, Стефан. Ты хозяин, держи нас всех вместе.'
                else:
                    $GirlTalkDaughtersText = 'Сандра тепло кладёт ладонь тебе на предплечье:<br><br>— Ничего, Стефан, всё у нас на лад идёт. Аманда учится уму-разуму, Мелисса за расходами следит, я у печи хозяйничаю. Вытянем мы трактир, точно говорю. А с таким толковым хозяином — нам вообще горы по колено.'
                end
            end
        end
    end

    killvar '$GirlTalkDaughtersTextId'
---
