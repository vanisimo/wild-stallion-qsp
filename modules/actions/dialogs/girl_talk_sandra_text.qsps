! ================================================
! FILE: modules/actions/dialogs/girl_talk_sandra_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! Агентам: НЕ переписывать prose без явного «можно править тексты».
! Перед любой переделкой файла — спросить пользователя; сохранять формулировки.
! MODULE: actions/dialogs
! Тексты разговора Сандры о дочерях
! ================================================

#GirlTalkDaughtersText
    $GirlTalkDaughtersTextId = LCASE($ARGS[0])
    $GirlTalkDaughtersText = ''

    if $GirlTalkDaughtersTextId = 'intro':
        if $GirlLocation['sandra'] = 'Kitchen':
            $GirlTalkDaughtersText = '— Про девчонок? — Сандра кивает на котёл. — Говори. Я помешаю и послушаю. Для них у меня всегда время есть.'
        else:
            $GirlTalkDaughtersText = '— О них? — Сандра садится, впервые за день. — Слушаю, Стефан. Ты хозяин. Я мать. Давай без вранья.'
        end

    elseif $GirlTalkDaughtersTextId = 'context':
        if AmandaRebellion >= 15 or GirlRebellion['amanda'] >= 15:
            $GirlTalkDaughtersText = '— Аманда с тобой спорит всё чаще, — Сандра мешает без нужды. — Она не понимает: в трактире каждый взгляд клиента — это не мелочь. Подарочек, танец, шёпот у бочки — оно потом боком выходит.<br><br>— Я не её дерзости боюсь. Боюсь, что она психанёт и докажет что-то не языком. А потом скажет «я же говорила», как Мелисса. Только у Мелиссы голова есть.'
        elseif MelissaFamilyConcern >= 3 or GirlTrustStefan['melissa'] < GirlTrustStefan['amanda']:
            $GirlTalkDaughtersText = '— Мелисса нас держит крепче, чем вы думаете, — Сандра. — Снаружи порядок. А внутри она каждый ваш взгляд считает. На Аманду, на тебя.<br><br>— Не будешь с ней честным — она начнёт рулить сама. Всем. И трактиром, и семьёй. А я буду между вами бегать. Устала. Но не уйду.'
        elseif FamilyTension > FamilyTrust + 10:
            $GirlTalkDaughtersText = '— Девчонки друг от друга закрылись, — Сандра тяжело. — Аманда обиду за шуткой прячет. Мелисса — за своим «я же говорила».<br><br>— Мы не развалимся за вечер. Но трещит уже. По смеху слышно. По тому, как за ужином молчат. Они ругаться перестали. А это хуже. Значит, терпят.'
        elseif FamilyTrust > FamilyTension + 15:
            $GirlTalkDaughtersText = '— Пока они друг друга слышат, — Сандра, и видно — отпустило. — И тебя тоже. Аманда на старшую смотрит не только чтоб подколоть. Мелисса на младшую — не только чтоб построить.<br><br>— Не просри это в зале, Стефан. Мы ещё можем нормально жить. Я в сказки не верю. Но верю, что можно поужинать, и никто не встанет злой.'
        else:
            $GirlTalkDaughtersText = 'Сандра говорит про дочерей без вранья.<br><br>— Аманда ещё учится не краснеть от каждой похабщины и не хамить на каждый комплимент. Мелисса уже привыкла считать не только капусту, но и людей. Им обеим нужен хозяин. Не тюфяк и не тиран.<br><br>— Ты молодой. Они тоже. Я между вами, пока ты не докажешь, что без меня крыша не рухнет.'
        end

        if AmandaLegareTalkReady = 1 or MelissaLegareWarningSeen = 1:
            $GirlTalkDaughtersText += '<br><br>— И ещё, — тише. — Я слышу, как они про Легаре шепчутся. Аманда думает, я глухая. Мелисса думает, я слепая. Я не та и не другая. И меня это жрёт сильнее, чем пустая касса.'
        end
    end

    killvar '$GirlTalkDaughtersTextId'
---