! ================================================
! FILE: modules/actions/dialogs/girl_talk_sandra_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! MODULE: actions/dialogs
! Живые контекстные диалоги Сандры о дочерях, городе и семье
! ================================================

#GirlTalkDaughtersText
    $GirlTalkDaughtersTextId = LCASE($ARGS[0])
    $GirlTalkDaughtersText = ''

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (ЛОКАЦИЯ, АТМОСФЕРА, РАСКОВАННОСТЬ)
    ! ----------------------------------------------------
    if $GirlTalkDaughtersTextId = 'intro':
        $SandraTalkLoc = $GirlLocation['sandra']
        if $SandraTalkLoc = '':
            $SandraTalkLoc = 'Kitchen'
        end

        if $SandraTalkLoc = 'Kitchen':
            if SandraHomeSex >= 1 or HadSex['sandra'] >= 1 or FamilyCorruptionStage >= 3:
                $GirlTalkDaughtersText = 'На кухне жарко дышит очаг, разнося сытный дух мясной похлёбки и пряных кореньев. Заметив тебя на пороге, Сандра лукаво улыбается через плечо и смахивает тыльной стороной ладони прядь волос со влажного лба. Она откладывает увесистую ложку, поворачивается к тебе и беспечно прислоняется бедром к краю дубового стола, оправляя глубокий вырез платья.<br><br>— О девчонках пришёл потолковать? — в её грудном голосе звучит мягкая хрипотца. — Подойди ближе, Стефан, не стой истуканом. От печи такой жар идёт, что голова кружится... а когда ты рядом, мысли и вовсе от кастрюль уплывают.'
            else:
                $GirlTalkDaughtersText = 'На кухне стоит мерный гул и густой пар кипящего варева. Сандра сноровисто шинкует огородную зелень на широкой доске, привычно стряхивая нарезанное в глиняный горшок. Услышав твои шаги, она вытирает руки чистым полотенцем и оборачивается к тебе с деловитой материнской теплотой.<br><br>— Ты как раз вовремя, Стефан, — кивает она на мерно булькающий котёл. — Помешаю рагу и послушаю. О девчонках поговорить хочешь? Для семьи у меня всегда минутка найдётся. Выкладывай, что приметил.'
            end

        elseif $SandraTalkLoc = 'SandraRoom':
            if SandraHomeSex >= 1 or HadSex['sandra'] >= 1 or FamilyCorruptionStage >= 3:
                $GirlTalkDaughtersText = 'В спальне Сандры царит мягкий полумрак и тишина, пахнет сушёной лавандой и нагретым воском. Сандра сидит на краю мягкой постели в свободной сорочке со спущенным плечом, неторопливо расчёсывая пышные волосы гребнем. При твоём появлении её серые глаза озаряются ласковым светом, а на губах играет тёплая, чуть лукавая улыбка.<br><br>Она откладывает гребень и мягко похлопывает ладонью по покрывалу рядом с собой:<br>— Заходи, Стефан, притвори дверь... Садись ко мне поближе. За день так ноги истопчешь, что только бы упасть, но для тебя силы всегда найдутся. Ну, о чём у тебя голова болит? О наших девчонках?'
            else:
                $GirlTalkDaughtersText = 'В комнате Сандры скромно и спокойно. Она сидит на деревянной лавке у окна, потирая уставшие за долгий день плечи. Заметив тебя, она чуть заметно улыбается мягкой, немного усталой улыбкой.<br><br>— Заходи, Стефан, закрой дверь от сквозняка. С ног валюсь к вечеру. О семье поговорить пришёл? Присаживайся, слушаю тебя внимательно. Давай начистоту, как есть.'
            end

        else:
            if SandraHomeSex >= 1 or HadSex['sandra'] >= 1 or FamilyCorruptionStage >= 3:
                $GirlTalkDaughtersText = 'Сандра на секунду отвлекается от трактирной суеты, делает шаг навстречу и привычным, собственническим жестом кладёт ладонь тебе на грудь, поправляя ворот рубахи.<br><br>— Выкроил минутку для разговора? — негромко шепчет она, глядя снизу вверх с живой чертовщинкой во взгляде. — Спрашивай, хозяин. Я для тебя всегда время найду.'
            else:
                $GirlTalkDaughtersText = 'Сандра быстро смахивает крошки со столешницы, отряхивает фартук и оборачивается к тебе с внимательным взглядом.<br><br>— Слушаю тебя, Стефан. Ты здесь хозяин, я за домом гляжу. О девчонках слово замолвить хочешь? Говори прямо.'
            end
        end

        killvar '$SandraTalkLoc'

    ! ----------------------------------------------------
    ! 2. ВЕХИ ОТНОШЕНИЙ И БЛИЗОСТИ (ДИНАМИЧЕСКИЙ БЛОК)
    ! ----------------------------------------------------
    elseif $GirlTalkDaughtersTextId = 'milestone':
        if LastSexDay['sandra'] > 0 and (day - LastSexDay['sandra'] <= 1):
            $GirlTalkDaughtersText = 'Сандра вдруг тихо хмыкает, и по её шее к щекам поднимается лёгкий, приятный румянец. Она бросает на тебя долгий взгляд из-под ресниц, в котором смешались женская истома и задорная насмешка:<br><br>— Ты только погляди на него... Стоит с невинным видом, будто и не ты меня недавно так жадно в постель уминал! У меня до сих пор в коленях слабость стоит и поясницу тянет. Уж не знаю, от кого в тебе столько горячности, Стефан... Неугомонный ты у меня. Но знаешь... стряпухе грех жаловаться, когда в доме такой неутомимый хозяин.'
        elseif SandraHomeSex >= 1 and (day - LastSexDay['sandra'] >= 4):
            $GirlTalkDaughtersText = 'Сандра упирает руки в пышные бока и прищуривается, в шутливом укоре пряча искреннюю женскую ревность:<br><br>— А я уж думала, ты вовсе забыл дорогу в мою спальню, — Сандра с притворным вздохом качает головой. — Ходишь тут гоголем, в гроссбухи уткнёшься или за городскими юбками поглядываешь, пока твоя Сандра по ночам в одиночестве простыни греет. Смотри у меня, хозяин: забросишь меня совсем — найду, чем тебя за живое задеть. Так что не забывай заглядывать, я ведь скучаю.'
        elseif SandraBirthRevealTalkDone = 1 and SandraBirthLoreTalkDone = 0:
            SandraBirthLoreTalkDone = 1
            $GirlTalkDaughtersText = 'Сандра на миг задерживает руку на твоём плече, и взгляд её теплеет особенным, доверительным светом:<br><br>— Знаешь, Стефан... Я ведь всё думаю о том разговоре про графа Лермонта. Под одним сердцем я вас троих выносила, но отцы разные. Только на нашем диком фронтире на столичные сословные бредни всем плевать с высокой колокольни. Здесь главное не то, чья кровь в грамотах записана, а то, кто рядом спину прикрывает. Ты встал во главе дома, оберегаешь меня и девчонок. И что бы городские сплетники ни шипели — мы одна крепкая семья, и никто нам не указ.'
        end

    ! ----------------------------------------------------
    ! 3. ОСНОВНОЙ КОНТЕКСТ (ДЕВЧОНКИ, ГОРОДСКИЕ СЕКРЕТЫ, СЕМЬЯ)
    ! ----------------------------------------------------
    elseif $GirlTalkDaughtersTextId = 'context':
        ! Приоритет 1: Стычка или ухаживания Легаре вокруг Аманды
        if (AmandaLegareTalkReady = 1 or FactHappened['amanda_dancewithlegare_1'] = 1 or AmandaLegareInterest >= 10) and SandraLegareTalkDay <> day:
            SandraLegareTalkDay = day
            if FamilyCorruptionStage >= 3:
                $GirlTalkDaughtersText = '— Альбер этот, винный индюк, всё вокруг нашей Аманды хвостом крутит, — Сандра фыркает с довольной ухмылкой. — Думает, раз у него погреба ломятся да мошна трещит, так любая девчонка ему в рот заглядывать будет. Аманда у нас девка острая, пусть покрутит ему нос да выдоит звонкого серебра на наш трактир, дураков учить надо! Только ты за этим франтом приглядывай в оба глаза, Стефан. Если этот хлыщ вздумает распустить руки или обидеть девчонку — не церемонься, сверни ему нос набок. Пусть знает, чьих девок лапать вздумал.'
            else:
                $GirlTalkDaughtersText = '— Меня этот виноторговец Легаре из ума не идёт, — Сандра озабоченно качает головой. — Богатый, лощёный, с кошельком наперевес... Таким господам юные девочки вроде Аманды — всего лишь забава на пару ночей. Поиграет, сломает ради потехи и бросит, а нам потом слёзы утирать. Ты уж поговори с сестрой построже, Стефан. Нельзя ей верить сладким речам этого лиса.'
            end

        ! Приоритет 2: Ротация тем (Мелисса, Аманда, городские секреты, семейный уклад)
        else:
            SandraDaughtersTopicCycle += 1
            if SandraDaughtersTopicCycle > 3:
                SandraDaughtersTopicCycle = 0
            end

            ! Тема 0: Мелисса
            if SandraDaughtersTopicCycle = 0:
                $GirlTalkDaughtersText = '— Мелисса наша всё пытается железную леди из себя корчить, — Сандра посмеивается с тёплой материнской гордостью. — Засядет с гроссбухами, счётами трещит, губы подожмёт — прямо госпожа управляющая! Всё хочет доказать, что она тут самая рассудительная. А я-то вижу, как она на тебя украдкой поглядывает, когда ты порядок наводишь. Чуть ты голос повысишь по-хозяйски — у неё сразу вся спесь слетает, и ушки розовеют. Умная она девка, но женское сердце счётами не заменишь — ей сильное плечо рядом нужно.'

            ! Тема 1: Аманда
            elseif SandraDaughtersTopicCycle = 1:
                $GirlTalkDaughtersText = '— Аманда у нас чистый порох, — Сандра со вздохом улыбается. — Чуть искра — и вспыхнет. Характер дерзкий, норовистый, слова в простоте не скажет. То перед гостями кокетничает, то огрызается. Но ты не сердись на неё шибко. Молодая девка пробует мир на прочность. Ей вожак нужен, Стефан: чтоб осадил вовремя, но не со злобой, а крепко и по-свойски. Она к тебе тянется, хоть и хорохорится.'

            ! Тема 2: Городские сплетни и секреты Сандры (Драупнир, священник Герхард или атмосфера)
            elseif SandraDaughtersTopicCycle = 2:
                if (PlayerKnows_SandraDraupnirFriday = 1 or SandraConfessedDraupnir = 1 or GirlPersonalStoryDone['sandra_sandra_carpenter'] = 1) and SandraSecretStoryCycle = 0:
                    SandraSecretStoryCycle = 1
                    $GirlTalkDaughtersText = '— Про столяра Драупнира нашего вспоминаю — до сих пор смех берёт, — Сандра лукаво прищуривается без капли ханжества. — Гном кряжистый, руки что твои молоты, в бороде вечно стружка! Никаких вздохов при луне да витиеватых речей. Зато уж если за дело берётся — щепки летят так, что стены трещат! Простой, крепкий мужик. На нашем фронтире такая сила и прямота куда честнее столичных соплей.'
                elseif (PlayerKnows_SandraGerhardVisits = 1 or GirlPersonalStoryDone['sandra_sandra_priest'] = 1) and SandraSecretStoryCycle = 1:
                    SandraSecretStoryCycle = 0
                    $GirlTalkDaughtersText = '— А святой отец Герхард наш... — Сандра кривит губы в насмешливой улыбке. — У алтаря проповеди заводит о святом круге, чистоте души и смирении плоти. А сам за исповедальной ширмой так глазами по женским вырезам шарит, словно благословение через юбки раздаёт! Все они одним миром мазаны, Стефан: кровь у всех горячая, хоть в сутане, хоть в штанах. Только священники ещё и лицемерят в три слоя, а я этого с детства терпеть не могу.'
                else:
                    if SandraSecretStoryCycle = 0:
                        SandraSecretStoryCycle = 1
                    else:
                        SandraSecretStoryCycle = 0
                    end
                    if FamilyCorruptionStage >= 3:
                        $GirlTalkDaughtersText = '— В городке про наш трактир чего только не болтают кумушки, — Сандра беспечно машет рукой. — И девки, мол, у нас слишком бойкие, и порядки слишком вольные. А я говорю: пусть захлебнутся своей желчью! Завидуют, что у нас жизнь бьёт ключом, серебро звенит, а под нашей крышей никто не скучает.'
                    else:
                        $GirlTalkDaughtersText = '— В городе сейчас ухо востро надо держать, — Сандра негромко делится мыслями. — Купцы норовят обсчитать на поставках муки и солода, а соседи только и ждут, чтоб мы оступились. Но пока ты в зале порядок держишь, я за спину спокойна.'
                    end
                end

            ! Тема 3: Семейный уклад и фронтирная гордость
            else:
                if FamilyCorruptionStage >= 4:
                    $GirlTalkDaughtersText = '— Знаешь, Стефан... а ведь славно мы теперь живём, — Сандра тихо и довольно смеётся, глядя тебе в глаза. — Никакой показной праведности, никакого страха перед чужим судом. Девчонки цветут, в заведении полно народу, а у нас под крышей — тепло, сытно и весело. Мы сами себе закон и опора. И пока мы держимся друг за друга — ни одна собака в городе нам не страшна.'
                elseif FamilyTension > FamilyTrust + 10:
                    $GirlTalkDaughtersText = '— Тяжело девчонкам пока между собой, — вздыхает Сандра. — Слишком много обид накопилось за прежние голодные годы. Мелисса ворчит, Аманда ерепенится. Но я вижу, что ты стараешься их помирить. Не отступай, Стефан. Ты хозяин, держи нас всех вместе.'
                else:
                    $GirlTalkDaughtersText = '— Ничего, Стефан, всё у нас на лад идёт, — уверенно подытоживает Сандра. — Аманда учится уму-разуму, Мелисса за расходами следит, я у печи хозяйничаю. Вытянем мы трактир, точно говорю. А с таким толковым хозяином — нам вообще горы по колено.'
                end
            end
        end
    end

    killvar '$GirlTalkDaughtersTextId'
---
