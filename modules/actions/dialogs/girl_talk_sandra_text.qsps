! ================================================
! FILE: modules/actions/dialogs/girl_talk_sandra_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! [AI-WORKED] Текст переработан / дополнен ассистентом 30.10.2026
! MODULE: actions/dialogs
! Живые контекстные диалоги Сандры о дочерях, городе и семье
! ================================================

#GirlTalkDaughtersText
    $GirlTalkDaughtersTextId = LCASE($ARGS[0])
    $GirlTalkDaughtersText = ''

    ! ----------------------------------------------------
    ! 1. ВСТУПЛЕНИЕ (ЛОКАЦИЯ, АТМОСФЕРА, РАСКОВАННОСТЬ)
    ! ----------------------------------------------------
    if $GirlTalkDaughtersTextId = 'intro':
        $SandraTalkLoc = $TalkReturnLoc
        if $SandraTalkLoc = '':
            $SandraTalkLoc = $GirlLocation['sandra']
        end
        if $TalkReturnLoc = 'SandraRoom' or $GirlLocation['sandra'] = 'SandraRoom' or $CURLOC = 'SandraRoom' or time = 5:
            $SandraTalkLoc = 'SandraRoom'
        elseif $SandraTalkLoc = '':
            $SandraTalkLoc = 'Kitchen'
        end

        if $SandraTalkLoc = 'Kitchen':
            if SandraHomeSex >= 1 or HadSex['sandra'] >= 1 or FamilyCorruptionStage >= 3:
                *pl 'Завидев тебя на пороге, Сандра  подаётся вперёд и обеими руками снизу вверх поправляет пышную грудь, сжимая ее так что она вот вот вывалится из выреза. Её взгляд тут же скользит вниз по твоему телу — прямо к штанам между ног, жадно и без малейшего стыда задерживаясь на выпуклости паха. Облизнув губы, она упирается бёдрами в край стола и спрашивает:'
                *pl ' '
                *pl '— О девчонках потолковать пришёл, Стефан? — Или соскучился по мамочке? У меня от одного твоего вида мокро под юбкой...'
                *pl ' '
            else:
                *pl 'Сандраперебирает кухонную утварь, то и дело поправляя завязки фартука на талии. Услышав твои шаги, она вытирает ладони о полотенце, внимательно оглядывая тебя с ног до головы.'
                *pl ' '
                *pl '— Ты как раз вовремя, Стефан, — она смахивает крошки с края стола и скрещивает руки под грудью. — О девчонках поговорить хочешь? Для семьи у меня всегда минутка найдётся.'
                *pl ' '
            end

        elseif $SandraTalkLoc = 'SandraRoom':
            if SandraHomeSex >= 1 or HadSex['sandra'] >= 1 or FamilyCorruptionStage >= 3:
                *pl 'Сандра сидит на краю постели в тонкой сорочке с распахнутым воротом, из которого едва не вываливается налившаяся грудь с тёмными сосками. Заметив тебя, она откладывает гребень, широко разводит округлые бёдра, натягивая подол, и манит тебя пальцем. Её взгляд медленно и жадно спускается к твоим штанам между ног, задерживаясь на паху с откровенным предвкушением:'
                *pl ' '
                *pl '— Дверь на засов задвинь, Стефан, — хрипло выдыхает она, поглаживая своё бедро ладонью и призывно похлопывая по одеялу. — Садись ко мне.'
                *pl ' '
                *pl 'О сестрах потолковать хочешь или маме присунуть? У меня между ног уже жарко делается... Говори, пока я сама с тебя штаны не стащила.'
                *pl ' '
            else:
                *pl 'Сандра сидит на деревянной скамье у окна, разминая затёкшую шею и поправляя ночнушку. Увидев тебя на пороге, она опускает руки на колени и кивает:'
                *pl ' '
                *pl '— Заходи, Стефан, с ног валюсь к вечеру, что спину не разогнуть. О семье поговорить пришёл?'
                *pl ' '
            end

        else:
            if SandraHomeSex >= 1 or HadSex['sandra'] >= 1 or FamilyCorruptionStage >= 3:
                *pl 'Сандра делает шаг тебе навстречу, прижимаясь упругой грудью к твоей руке, и без тени смущения скользит ладонью по твоему животу прямо к поясу штанов. Её глаза опускаются вниз, стреляя откровенным похотливым взглядом между твоих ног:'
                *pl ' '
                *pl '— Выкроил минутку, Стефан? — шепчет она горячо на ухо, прикусив нижнюю губу. — Спрашивай, что хотел. Только не прижимайся так близко, если не собираешься прямо здесь задрать мне юбки. Я ведь для тебя всегда на взводе...'
                *pl ' '
            else:
                *pl 'Сандра поправляет съехавший фартук, одёргивает подол платья и оборачивается к тебе, уперев руку в бок:'
                *pl ' '
                *pl '— Слушаю тебя, Стефан. Ты здесь хозяин, я за домом гляжу. О девчонках слово замолвить хочешь? Говори прямо.'
                *pl ' '
            end
        end

        killvar '$SandraTalkLoc'

    ! ----------------------------------------------------
    ! 2. ВЕХИ ОТНОШЕНИЙ И БЛИЗОСТИ (ДИНАМИЧЕСКИЙ БЛОК)
    ! ----------------------------------------------------
    elseif $GirlTalkDaughtersTextId = 'milestone':
        if LastSexDay['sandra'] > 0 and (day - LastSexDay['sandra'] <= 1) and (SexGirlCameInScene >= 6 or SexGirlExhausted = 1 or SexMarathonGossipPending['sandra'] = 1):
            *pl 'Сандра вдруг прикусывает губу и медленно проводит ладонью по внутренней стороне бедра, чуть приподнимая край юбки. Её взгляд падает прямо на твои штаны между ног, скользя по очертаниям члена с жадной, бесстыдной усмешкой:'
            *pl ' '
            *pl '— Ты только погляди на него... Стоит с невинным видом, будто и не ты меня вчера до беспамятства драл! — она шумно втягивает воздух, прикрыв глаза.'
            *pl ' '
            *pl '— У меня внутри до сих пор всё ноет и пульсирует, все натер и ноги не держат... Гляжу сейчас на твой стояк в штанах — и снова низ живота жжёт. Хоть бросай всё и лезь на член...'
            *pl ' '
        elseif SandraHomeSex >= 1 and (day - LastSexDay['sandra'] >= 4):
            *pl 'Сандра делает резкий шаг к тебе, упирается ладонями в твой пояс и демонстративно опускает глаза к твоей промежности, ощупывая взглядом напряжённые штаны между ног:'
            *pl ' '
            *pl '— А я уж думала, ты вовсе забыл дорогу в мою комнату, — с укором говорит она, дразняще прижимаясь лобком к твоей ноге. — Ходишь тут за чужими юбками, пока у мамы внутри всё горит без члена!'
            *pl ' '
            *pl 'Моя дырочка истосковалась по хорошему траху. Смотри у меня, Стефан: ещё пару дней промедлишь — достану из сундука диковинку Драупнира из дерева Диких Земель или у Бекки в лавке выберу самый тугой баклажан! Хоть гномья штука и тёплая, да ещё внутрь стреляет, но живой жеребец мне в сто раз милее. Так что жду тебя вечером!'
            *pl ' '
        elseif SandraBirthRevealTalkDone = 1 and SandraBirthLoreTalkDone = 0:
            SandraBirthLoreTalkDone = 1
            *pl 'Сандра подходит ближе, крепко сжимает твоё плечо и смотрит прямо в глаза, откинув выбившийся локон назад:'
            *pl ' '
            *pl '— Знаешь, Стефан... Я ведь всё думаю о том разговоре про графа Лермонта. Под одним сердцем я вас троих выносила, но отцы разные.'
            *pl ' '
            *pl 'Только на нашем графстве на это не обращают внимание. Здесь главное не то, чей ты сын, а то, какой ты человек. Ты встал во главе дома, оберегаешь меня и девчонок. И что бы кто не говорил — мы одна семья.'
            *pl ' '
        end

    ! ----------------------------------------------------
    ! 3. ОСНОВНОЙ КОНТЕКСТ (ДЕВЧОНКИ, ГОРОДСКИЕ СЕКРЕТЫ, СЕМЬЯ)
    ! ----------------------------------------------------
    elseif $GirlTalkDaughtersTextId = 'context':
        ! Приоритет 1: Стычка или ухаживания Легаре вокруг Аманды
        if (AmandaLegareTalkReady = 1 or FactHappened['amanda_dancewithlegare_1'] = 1 or AmandaLegareInterest >= 10) and SandraLegareTalkDay <> day:
            SandraLegareTalkDay = day
            if FamilyCorruptionStage >= 3:
                *pl 'Сандра с усмешкой поправляет глубокий вырез, приваливается бедром к столу и хмыкает:'
                *pl ' '
                *pl '— Альбер этот, винный индюк, всё вокруг нашей Аманды хвостом крутит. Думает, раз у него погреба ломятся да мошна трещит, так любая девчонка ему в рот заглядывать будет. Аманда у нас девка острая, пусть покрутит ему нос да выдоит звонкого серебра на наш трактир, дураков учить надо!'
                *pl ' '
                *pl 'Только ты за этим франтом приглядывай в оба глаза, Стефан. Если этот хлыщ вздумает распустить руки или обидеть девчонку — не церемонься, сверни ему нос набок. Пусть знает, чьих девок лапать вздумал.'
                *pl ' '
            else:
                *pl 'Сандра нервно одёргивает передник и озабоченно качает головой:'
                *pl ' '
                *pl '— Меня этот виноторговец Легаре из ума не идёт. Богатый, лощёный, с кошельком наперевес... Таким господам юные девочки вроде Аманды — всего лишь забава на пару ночей.'
                *pl ' '
                *pl 'Поиграет, сломает ради потехи и бросит, а нам потом слёзы утирать. Ты уж поговори с сестрой построже, Стефан. Нельзя ей верить сладким речам этого лиса.'
                *pl ' '
            end

        ! Приоритет 2: Ротация тем (Мелисса, Аманда, городские секреты, семейный уклад)
        else:
            SandraDaughtersTopicCycle += 1
            if SandraDaughtersTopicCycle > 3:
                SandraDaughtersTopicCycle = 0
            end

            ! Тема 0: Мелисса
            if SandraDaughtersTopicCycle = 0:
                *pl 'Сандра смахивает прядь со лба и негромко посмеивается:'
                *pl ' '
                *pl '— Мелисса наша всё пытается железную леди из себя корчить. Засядет с гроссбухами, счётами трещит, губы подожмёт — прямо госпожа управляющая! Всё хочет доказать, что она тут самая рассудительная.'
                *pl ' '
                if MelissaHomeSex = 1 or FamilyCorruptionStage >= 3:
                    *pl 'А сама после твоих визитов в спальню сияет как начищенное серебро! Походка плавная, щёки алые. И видела я, как она у Бекки овощи придирчиво щупала, пока ты в зале крутился. Умная девка, но живая плоть берёт своё — и слава Ильматеру, что в нашем доме есть кому её ублажить.'
                    *pl ' '
                else:
                    *pl 'А я-то вижу, как она на тебя украдкой поглядывает, когда ты порядок наводишь. Чуть ты голос повысишь по-хозяйски — у неё сразу вся спесь слетает, и ушки розовеют. Умная она девка, но женское сердце счётами не заменишь — ей сильное плечо рядом нужно.'
                    *pl ' '
                end

            ! Тема 1: Аманда
            elseif SandraDaughtersTopicCycle = 1:
                *pl 'Сандра упирает руки в бока и со вздохом улыбается:'
                *pl ' '
                *pl '— Аманда у нас чистый порох. Чуть искра — и вспыхнет. Характер дерзкий, норовистый, слова в простоте не скажет. То перед гостями кокетничает, то огрызается.'
                *pl ' '
                if AmandaHomeSex = 1 or FamilyCorruptionStage >= 3:
                    *pl 'Зато как ты её прижмёшь — так сразу шёлковой делается! Я ведь слышу, как она по ночам сладко стонет, и знаю, какие длинные огурцы она у соседки выбирает, когда ты задерживаешься. Молодая, горячая кобылка! Ей такой сильный жеребец, как ты, и нужен, чтобы держал в узде и досыта радовал.'
                    *pl ' '
                else:
                    *pl 'Но ты не сердись на неё шибко. Молодая девка пробует мир на прочность. Ей вожак нужен, Стефан: чтоб осадил вовремя, но не со злобой, а крепко и по-свойски. Она к тебе тянется, хоть и хорохорится.'
                    *pl ' '
                end

            ! Тема 2: Городские сплетни и секреты Сандры (Драупнир, священник Герхард или атмосфера)
            elseif SandraDaughtersTopicCycle = 2:
                if SandraGnomeDildoTalkDone = 1:
                    *pl 'Сандра лукаво щурится и шепчет, подавшись вперёд:'
                    *pl ' '
                    *pl '— Ты на ту резную вещицу в моём сундуке косо не гляди, Стефан. Драупнир раздобыл волшебное тентаклевое дерево из Диких Земель. Оно ведь живое, всё само делает — само теплеет, пульсирует, возбуждает и само внутрь стреляет! Обработать такое адски трудно: столяру потребовалась ювелирная тонкость, чтобы придать форму и не сломать то, что само живёт и работает. Чудо-вещь, чтобы одинокая баба не тосковала по ночам. Но живой уд рядом — это родной жар и плоть. Так что исполняй свои обязанности, радуй мамку почаще, и подарок так и останется лежать под холстом!'
                    *pl ' '
                elseif (PlayerKnows_SandraDraupnirFriday = 1 or SandraConfessedDraupnir = 1 or GirlPersonalStoryDone['sandra_sandra_carpenter'] = 1) and SandraSecretStoryCycle = 0:
                    SandraSecretStoryCycle = 1
                    *pl 'Сандра лукаво прищуривается, лениво поглаживая своё бедро:'
                    *pl ' '
                    *pl '— Про столяра Драупнира нашего вспоминаю — до сих пор смех берёт. Гном кряжистый, руки что твои молоты, в бороде вечно стружка! Никаких вздохов при луне да витиеватых речей.'
                    *pl ' '
                    *pl 'Зато уж если за дело берётся — щепки летят так, что стены трещат! Простой, крепкий мужик. На нашем фронтире такая сила и прямота куда честнее столичных соплей.'
                    *pl ' '
                elseif (PlayerKnows_SandraGerhardVisits = 1 or GirlPersonalStoryDone['sandra_sandra_priest'] = 1) and SandraSecretStoryCycle = 1:
                    SandraSecretStoryCycle = 0
                    *pl 'Сандра негромко замечает, скрестив руки под налившейся грудью:'
                    *pl ' '
                    *pl '— Отец Герхард... Прихожане слушают его без всяких сомнений: церковь в городе — непререкаемый авторитет, никто и не думает перечить пастырю. Этим святой отец и пользуется. Он ведь всей душой рвётся назад в столицу, а заодно мечтает оприходовать всех красивых горожанок в округе!'
                    *pl ' '
                    *pl 'На этой почве у них с мэром даже случился конфликт, но мэр отступил — рассудил трезво, что священник тут временщик, а с горожанок не убудет. К тому же за проповедями стоит вектор самой герцогини: ей нужно бурное скрещивание и рост населения края. Поэтому церковь на фронтире не борется с местными религиями гномов, орков и эльфов, а ловко приспосабливает их под себя, выдавая за священное наследие Ильматера. Вот Герхард и отрабатывает столичный заказ, надеясь на скорый отъезд, а заодно греет руки за исповедальной ширмой.'
                    *pl ' '
                else:
                    if SandraSecretStoryCycle = 0:
                        SandraSecretStoryCycle = 1
                    else:
                        SandraSecretStoryCycle = 0
                    end
                    if FamilyCorruptionStage >= 3:
                        *pl 'Сандра беспечно машет рукой, оглаживая округлое бедро:'
                        *pl ' '
                        *pl '— В городке про наш трактир чего только не болтают кумушки. И девки, мол, у нас слишком бойкие, и порядки слишком вольные.'
                        *pl ' '
                        *pl 'А я говорю: пусть захлебнутся своей желчью! Завидуют, что у нас жизнь бьёт ключом, серебро звенит, а под нашей крышей никто не скучает.'
                        *pl ' '
                    else:
                        *pl 'Сандра делает шаг ближе и негромко делится мыслями:'
                        *pl ' '
                        *pl '— В городе сейчас ухо востро надо держать. Купцы норовят обсчитать на поставках муки и солода, а соседи только и ждут, чтоб мы оступились. Но пока ты в зале порядок держишь, я за спину спокойна.'
                        *pl ' '
                    end
                end

            ! Тема 3: Семейный уклад и фронтирная гордость
            else:
                if FamilyCorruptionStage >= 4:
                    *pl 'Сандра тихо и довольно смеётся, подавшись к тебе вплотную и заглядывая в глаза:'
                    *pl ' '
                    *pl '— Знаешь, Стефан... а ведь славно мы теперь живём. Никакой показной праведности, никакого страха перед чужим судом.'
                    *pl ' '
                    *pl 'Девчонки цветут, в заведении полно народу, а у нас под крышей — тепло, сытно и весело. Мы сами себе закон и опора. И пока мы держимся друг за друга — ни одна собака в городе нам не страшна.'
                    *pl ' '
                elseif FamilyTension > FamilyTrust + 10:
                    *pl 'Сандра тяжело вздыхает, опуская плечи:'
                    *pl ' '
                    *pl '— Тяжело девчонкам пока между собой. Слишком много обид накопилось за прежние голодные годы. Мелисса ворчит, Аманда ерепенится. Но я вижу, что ты стараешься их помирить. Не отступай, Стефан. Ты хозяин, держи нас всех вместе.'
                    *pl ' '
                else:
                    *pl 'Сандра тепло кладёт ладонь тебе на предплечье:'
                    *pl ' '
                    *pl '— Ничего, Стефан, всё у нас на лад идёт. Аманда учится уму-разуму, Мелисса за расходами следит, я у печи хозяйничаю. Вытянем мы трактир, точно говорю. А с таким толковым хозяином — нам вообще горы по колено.'
                    *pl ' '
                end
            end
        end
    end

    killvar '$GirlTalkDaughtersTextId'
---
