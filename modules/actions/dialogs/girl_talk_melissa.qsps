#GirlTalkMelissaMemoryAnalRun
    gs 'GirlTalkMelissaMemoryAnalText'
    MelissaMemoryAnalDone = 1
    love['melissa'] += 2
    otkroven['melissa'] += 2
    sluttiness['melissa'] += 1
