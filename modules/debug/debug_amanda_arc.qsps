! ================================================
! FILE: modules/debug/debug_amanda_arc.qsps
! MODULE: debug
! Отдельная debug-панель арки Аманды (акт 1)
! ================================================

#DebugAmandaArcPanel
    if debug = 0:
        exit
    end

    gs 'PanelDebugToolsHeader'

    pl '<b>DEBUG: АМАНДА — INTIMACY-АРКА</b>'
    pl ' '

    gs 'DebugAmandaPrintContext'
    pl ' '

    gs 'DebugAmandaPrintHomeArc'
    pl ' '

    gs 'DebugAmandaPrintDanceBlock'
    pl ' '

    gs 'DebugAmandaPrintLegareBlock'
    pl ' '

    gs 'DebugAmandaPrintKinksBlock'
    pl ' '

    gs 'DebugAmandaPrintSocialBlock'
    pl ' '

    gs 'DebugAmandaPrintNextHint'
    pl ' '

    gs 'DebugAmandaPrintPresets'
    pl ' '

    pl '<a href="exec:gs ''DebugAmandaArcReset'' & gs ''DebugAmandaArcPanel''">Сброс флагов Аманды</a>'
    pl ' '
    pl '<a href="exec:gs ''DebugIntimacyArcPanel''">← Intimacy-арки (все персонажи)</a>'
    pl '<a href="exec:gs ''PanelDebugToolsMain''">← Главная debug-панель</a>'
    pl ' '
---

#DebugAmandaPrintContext
    gs 'GetCitySchedulePhase'

    pl '<b>Контекст</b>'
    pl 'День: ' + STR(day) + ' | неделя: ' + STR(week) + ' | время: ' + STR(time) + ' (' + $CitySchedulePhase + ')'
    pl 'Локация Аманды: ' + $GirlLocation['amanda']

    gs 'AmandaHomeCanAdvance'
    gs 'AmandaHomeFirstSexCanStart'

    if AmandaHomeCanAdvance = 1:
        pl 'Лестница сегодня: <font color="#008000"><b>можно</b></font>'
    else
        pl 'Лестница сегодня: <font color="#888888">нельзя</font>'
    end

    if AmandaHomeFirstSexCanStart = 1:
        pl 'Первая близость сегодня: <font color="#008000"><b>можно</b></font>'
    else
        pl 'Первая близость сегодня: <font color="#888888">нельзя</font>'
    end

    killvar '$CitySchedulePhase'
    killvar 'AmandaHomeCanAdvance'
    killvar 'AmandaHomeFirstSexCanStart'
---

#DebugAmandaHomeStageLabel
    $DebugAmandaStageLabel = 'неизвестно'
    DebugAmandaStageCode = AmandaHomeStage

    if AmandaHomeUnlocked = 0:
        $DebugAmandaStageLabel = 'дом закрыт'
    elseif AmandaHomeSex = 1:
        $DebugAmandaStageLabel = 'SexScene разблокирован (свободные вечера)'
    elseif DebugAmandaStageCode = 0:
        $DebugAmandaStageLabel = '0 — следующий: обнимашки'
    elseif DebugAmandaStageCode = 1:
        $DebugAmandaStageLabel = '1 — следующий: поцелуй'
    elseif DebugAmandaStageCode = 2:
        $DebugAmandaStageLabel = '2 — следующий: ласки'
    elseif DebugAmandaStageCode = 3:
        $DebugAmandaStageLabel = '3 — следующий: ручная'
    elseif DebugAmandaStageCode = 4:
        $DebugAmandaStageLabel = '4 — следующий: минет'
    elseif DebugAmandaStageCode = 5:
        $DebugAmandaStageLabel = '5 — следующий: куни'
    elseif DebugAmandaStageCode = 6:
        $DebugAmandaStageLabel = '6 — разговор перед первым разом'
    elseif DebugAmandaStageCode = 7:
        $DebugAmandaStageLabel = '7 — первая ночь (линейная сцена)'
    elseif DebugAmandaStageCode = 8:
        $DebugAmandaStageLabel = '8 — вечер вместе (2-й вечер)'
    elseif DebugAmandaStageCode = 9:
        $DebugAmandaStageLabel = '9 — поза сзади'
    elseif DebugAmandaStageCode = 10:
        $DebugAmandaStageLabel = '10 — боком + unlock'
    elseif DebugAmandaStageCode >= 11:
        $DebugAmandaStageLabel = STR(DebugAmandaStageCode) + ' — финал арки'
    end

    killvar 'DebugAmandaStageCode'
---

#DebugAmandaPrintHomeArc
    gs 'DebugAmandaHomeStageLabel'

    pl '<b>Дом — лестница и первая близость</b>'
    pl 'Стадия: <b>' + $DebugAmandaStageLabel + '</b>'
    killvar '$DebugAmandaStageLabel'

    gs 'DebugAmandaPrintBool', 'Дом открыт (AmandaHomeUnlocked)', AmandaHomeUnlocked
    gs 'DebugAmandaPrintBool', 'Полный unlock (AmandaHomeSex)', AmandaHomeSex
    gs 'DebugAmandaPrintBool', 'Шаг уже сегодня (AmandaHomeStepToday)', AmandaHomeStepToday
    gs 'DebugAmandaPrintBool', 'Первая ночь пройдена (AmandaFirstNightDone)', AmandaFirstNightDone
    gs 'DebugAmandaPrintBool', 'Первый вагинал зарегистрирован', AmandaHomeFirstVaginalRegistered
    gs 'DebugAmandaPrintBool', 'SexScene unlock', AmandaSexSceneUnlocked
    gs 'DebugAmandaPrintBool', 'Поза doggy OK', AmandaPoseDoggyOk
    gs 'DebugAmandaPrintBool', 'Поза side OK', AmandaPoseSideOk

    gs 'ResolveGirlRoomOutfit', 'amanda'
    gs 'GetLocationTimeSuffix'

    pl 'Комната: uniform=' + STR(GirlUniformLevel['amanda']) + ' (' + $GirlRoomOutfit + '), картинка idle: amanda_room_' + $LocImageTimeSuffix + '_' + $GirlRoomOutfit + '_idle.webp'

    killvar '$GirlRoomOutfit'
    killvar '$LocImageTimeSuffix'
---

#DebugAmandaPrintDanceBlock
    if LOC('AmandaLegareRaceWindowOpen') = 1:
        gs 'AmandaLegareRaceWindowOpen'
    end

    pl '<b>Танцы и платье</b>'
    gs 'DebugAmandaPrintBool', 'Платье готово', AmandaDanceDressReady
    gs 'DebugAmandaPrintBool', 'Купила сама', AmandaDanceDressSelfBought
    gs 'DebugAmandaPrintBool', 'Купил игрок', AmandaDanceDressPlayerBought
    pl 'Пятничных танцев: ' + STR(AmandaFridayDanceCount) + ' (гонка с 5-й пт или д.33+пт)'
    gs 'DebugAmandaPrintBool', 'Окно гонки Легаре сейчас', AmandaLegareRaceWindowOpen
    gs 'DebugAmandaPrintBool', 'Гонка Легаре сыграна', AmandaLegareFridayRaceDone
    pl 'Результат гонки: 0=стоп / 1=claim / 2=watch / 3=отошёл → ' + STR(AmandaLegareFridayRaceResult)
---

#DebugAmandaPrintLegareBlock
    gs 'AmandaHomeFirstSexResolveContext'

    pl '<b>Легаре и выбор пути</b>'
    pl 'Контекст первой ночи: <b>' + $AmandaFirstSexContext + '</b> (pure / legare_hidden / legare_known)'
    gs 'DebugAmandaPrintBool', 'Сцена в переулке (LegareFirstSexDone)', AmandaLegareFirstSexDone
    pl '<font color="#888888">флаг ≠ вагинал: в гонке чаще oral, virginity может остаться 1</font>'
    gs 'DebugAmandaPrintBool', 'Игрок знает про гонку', PlayerKnows_AmandaLegareFridayRace
    gs 'DebugAmandaPrintBool', 'Факт: переулок в пятницу', Fact_AmandaLegareFridayAlley
    gs 'DebugAmandaPrintBool', 'Выбор path готов', AmandaPathChoiceReady
    gs 'DebugAmandaPrintBool', 'Выбор path сделан', AmandaPathChoiceDone
    pl 'AmandaPathChoice: ' + STR(AmandaPathChoice) + ' | запрет парней: ' + STR(AmandaProhibitGuys)
    pl 'NpcPath / PlayerPath: ' + STR(AmandaNpcPath) + ' / ' + STR(AmandaPlayerPath)
    pl 'Интерес Легаре: ' + STR(AmandaLegareInterest)

    if AmandaLegareFirstSexDone = 1 and AmandaLegareFridayRaceDone = 0:
        pl '<font color="#c06000"><b>⚠ LegareFirstSex без гонки</b> — вероятно debug-пресет; тексты: legare_hidden, без плевы при virginity=1</font>'
    end

    if AmandaLegareFirstSexDone = 1 and PlayerKnows_AmandaLegareFridayRace = 0 and AmandaLegareFridayRaceDone = 0:
        pl '<font color="#c06000">⚠ Нет PlayerKnows и гонки — для legare_known используй пресет «гонка watch»</font>'
    end

    killvar '$AmandaFirstSexContext'
---

#DebugAmandaPrintKinksBlock
    pl '<b>Кинки и Лизетта</b>'
    pl 'Соседские парни — стадия: ' + STR(AmandaNeighborBoysStage)
    gs 'DebugAmandaPrintBool', 'Анал Легаре', AmandaLegareAnalDone
    gs 'DebugAmandaPrintBool', 'Анал соседи', AmandaNeighborBoysAnalDone
    gs 'DebugAmandaPrintBool', 'Talk Лизетта (анал)', AmandaLizetteAnalTalkDone
    gs 'DebugAmandaPrintBool', 'Домашний анал с ГГ', AmandaHomeAnalDone
    pl 'Lizette talk count / влияние: ' + STR(AmandaLizetteAnalTalkCount) + ' / ' + STR(AmandaLizaInfluence)
    pl 'Oral stage / ATM calm: ' + STR(AmandaOralStage) + ' / ' + STR(AmandaOralAtmCalmDone)
    pl '<a href="exec:gs ''AmandaOralBumpTo'', AmandaOralStage + 1 & gs ''DebugAmandaArcPanel''">Oral stage +1</a>'
    gs 'DebugAmandaPrintBool', 'ЖЖМ Аманда+Мелисса', AmandaMelissaThreesomeDone
    gs 'DebugAmandaPrintBool', 'ММЖ Аманда+Легаре', AmandaLegareMmfDone
---

#DebugAmandaPrintSocialBlock
    pl '<b>Социальные шкалы</b>'
    pl 'Дружба / любовь: ' + STR(Friends['amanda']) + ' / ' + STR(love['amanda'])
    pl 'Откровенность / развращённость: ' + STR(otkroven['amanda']) + ' / ' + STR(sluttiness['amanda'])
    pl 'IntimStage: ' + STR(IntimStage['amanda'])
    pl 'Девственность: ' + STR(virginity['amanda']) + ' | вагинал с ГГ: ' + STR(HadVaginalWithPlayer['amanda'])
    pl 'Вагинал count: ' + STR(VaginalCount['amanda']) + ' | кончил внутрь: ' + STR(cuminside['amanda'])
---

#DebugAmandaPrintBool
    $DebugAmandaBoolLabel = $ARGS[0]
    DebugAmandaBoolValue = ARGS[1]

    if $DebugAmandaBoolLabel = '':
        killvar '$DebugAmandaBoolLabel'
        exit
    end

    if DebugAmandaBoolValue = 1:
        pl $DebugAmandaBoolLabel + ': <b><font color="#008000">да</font></b>'
    else
        pl $DebugAmandaBoolLabel + ': <font color="#888888">нет</font>'
    end

    killvar '$DebugAmandaBoolLabel'
    killvar 'DebugAmandaBoolValue'
---

#DebugAmandaPrintNextHint
    $DebugAmandaNextHint = '—'

    if AmandaHomeUnlocked = 0:
        $DebugAmandaNextHint = 'Открыть дом — увести с танцев (AmandaDanceLeaveHome) или debug-прыжок'
    elseif AmandaHomeSex = 1:
        $DebugAmandaNextHint = 'Арка завершена — «Провести вечер» (SexScene) в комнате, вечер, time>=3'
    else
        gs 'AmandaHomeCanAdvance'
        gs 'AmandaHomeFirstSexCanStart'

        if AmandaHomeCanAdvance = 1 and AmandaHomeStage < 6:
            $DebugAmandaNextHint = 'Лестница: NPC → интим → «Провести время наедине» (stage ' + STR(AmandaHomeStage) + ')'
        elseif AmandaHomeFirstSexCanStart = 1:
            gs 'AmandaHomeFirstSexMenuLabel'
            $DebugAmandaNextHint = 'Меню интима: «' + $AmandaFirstSexMenuLabel + '»'
            killvar '$AmandaFirstSexMenuLabel'
        elseif AmandaHomeStepToday = 1 and AmandaHomeStage >= 6 and AmandaHomeStage <= 11:
            $DebugAmandaNextHint = 'Сегодня шаг уже сделан — дождаться следующего вечера (time 3–4)'
        elseif AmandaHomeStage < 6:
            $DebugAmandaNextHint = 'Лестница: вечер (time>=3), Аманда в AmandaRoom, шаг сегодня ещё не брали'
        else
            $DebugAmandaNextHint = 'Проверь time, локацию и AmandaHomeStage'
        end

        killvar 'AmandaHomeCanAdvance'
        killvar 'AmandaHomeFirstSexCanStart'
    end

    pl '<b>Следующий шаг:</b> ' + $DebugAmandaNextHint
    killvar '$DebugAmandaNextHint'
---

#DebugAmandaPrintPresets
    pl '<b>Прыжки в комнату</b>'
    pl '<a href="exec:gs ''DebugIntimacyJumpAmandaHome'', ''0'' & gt ''AmandaRoom''">stage 0 → обнимашки</a>'
