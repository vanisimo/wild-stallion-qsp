    pl '<a href="exec:gs ''DebugAmandaPresetLegareRaceGate'' & gs ''DebugAmandaArcPanel''">5-я пт — окно гонки (площадь)</a>'
    pl '<a href="exec:gs ''DebugAmandaPresetLegareRaceWatch'' & gs ''DebugAmandaArcPanel''">гонка watch + Legare (legare_known)</a>'
    pl '<a href="exec:gs ''DebugAmandaPresetLegareRaceWatchHidden'' & gs ''DebugAmandaArcPanel''">гонка step_aside + Legare (legare_hidden)</a>'
    pl '<a href="exec:AmandaLegareFirstSexDone = 1 & AmandaPathChoiceReady = 1 & PlayerKnows_AmandaLegareFridayRace = 1 & Fact_AmandaLegareFridayAlley = 1 & AmandaLegareFridayRaceDone = 1 & AmandaLegareFridayRaceResult = 2 & AmandaNpcPath = 4 & AmandaLegareInterest = 8 & gs ''DebugAmandaArcPanel''">выбор path (согласованные флаги)</a>'
    pl '<a href="exec:AmandaLegareFirstSexDone = 1 & AmandaNeighborBoysStage = 0 & AmandaProhibitGuys = 0 & sluttiness[''amanda''] = 25 & time = 4 & gs ''DebugAmandaArcPanel''">соседские парни (гейт)</a>'
    pl '<a href="exec:AmandaLegareFirstSexDone = 1 & Fact_AmandaLegareFridayAlley = 1 & sluttiness[''amanda''] = 40 & AmandaLegareInterest = 12 & time = 4 & gs ''DebugAmandaArcPanel''">анал Легаре (гейт)</a>'
    pl '<a href="exec:AmandaLegareAnalDone = 1 & AmandaNeighborBoysStage = 3 & sluttiness[''amanda''] = 45 & time = 4 & gs ''DebugAmandaArcPanel''">анал парни (гейт)</a>'
    pl '<a href="exec:AmandaHomeSex = 1 & AmandaLizetteAnalTalkCount = 3 & AmandaLizaInfluence = 5 & AmandaLizetteAnalTalkDone = 0 & time = 4 & gs ''DebugAmandaArcPanel''">talk Лизетта → анал ГГ</a>'
