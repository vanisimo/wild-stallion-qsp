        gs 'AmandaLizaTalkText', $DebugAmandaLizaPreviewPhrase
        pl '│ ' + $AmandaLizaTalkText
        killvar '$AmandaLizaTalkText'
        pl '└────────────────────────────────────────────────────────────'
