! ================================================
! FILE: modules/debug/debug_amanda_liza.qsps
! MODULE: debug
! Аманда + Лизетта: визиты, подслушивание, пул сплетен
! ================================================

#DebugAmandaLizaPanel
    if debug = 0:
        exit
    end

    gs 'PanelDebugToolsHeader'

    pl '<b>DEBUG: АМАНДА + ЛИЗЕТТА (СПЛЕТНИ, ВИЗИТЫ, СЮЖЕТ)</b>'
    pl 'Сплетни (AmandaLizaTalk), визиты в зал/комнату, сюжетные ивенты.'
    pl ' '

    gs 'DebugAmandaLizaPrintContext'
    pl ' '

    gs 'DebugAmandaLizaPrintFlags'
    pl ' '

    gs 'DebugAmandaLizaPrintGates'
    pl ' '

    gs 'DebugAmandaLizaPrintPool'
    pl ' '

    gs 'DebugAmandaLizaPrintPhraseTester'
    pl ' '

    gs 'DebugAmandaLizaPrintPresets'
    pl ' '

    gs 'DebugAmandaLizaPrintJumps'
    pl ' '

    pl '<a href="exec:gs ''DebugAmandaLizaReset'' & gs ''DebugAmandaLizaPanel''"><font color="#cc0000"><b>[Сброс ветки Лизетты]</b></font></a>'
    pl '<a href="exec:gs ''DebugAmandaArcPanel''">→ Панель intimacy-арки Аманды</a>'

    gs 'PanelDebugToolsBack'
---

#DebugAmandaLizaPrintContext
    gs 'GetDateTimeNames'
    gs 'GetCitySchedulePhase'
    gs 'UpdateGirlLocations'

    pl '<b>══════════════════════════════════════════════════</b>'
    pl '<b>КОНТЕКСТ</b>'
    pl '<b>══════════════════════════════════════════════════</b>'
    pl 'День: ' + STR(day) + ' | Неделя: ' + STR(week) + ' (' + $WeekDay + ') | Время: ' + STR(time) + ' (' + $TimeOfDay + ')'
    pl 'Фаза города: <b>' + $CitySchedulePhase + '</b>'
    pl 'Локации: Аманда -> <b>' + $GirlLocation['amanda'] + '</b> | Лизетта -> <b>' + $GirlLocation['lizette'] + '</b>'

    gs 'IsTavernOpen'
    gs 'DebugAmandaLizaPrintBool', 'Трактир открыт (TavernOpen)', TavernOpen

    killvar '$CitySchedulePhase'
---

#DebugAmandaLizaPrintBool
    $DebugAmandaLizaBoolLabel = $ARGS[0]
    DebugAmandaLizaBoolValue = ARGS[1]

    if $DebugAmandaLizaBoolLabel = '':
        killvar '$DebugAmandaLizaBoolLabel'
        exit
    end

    if DebugAmandaLizaBoolValue = 1:
        pl $DebugAmandaLizaBoolLabel + ': <b><font color="#00aa00">[✓ ДА]</font></b>'
    else
        pl $DebugAmandaLizaBoolLabel + ': <font color="#888888">[✗ нет]</font>'
    end

    killvar '$DebugAmandaLizaBoolLabel'
    killvar 'DebugAmandaLizaBoolValue'
---

#DebugAmandaLizaPrintFlags
    gs 'AmandaLizetteEnsureVars'

    pl '<b>══════════════════════════════════════════════════</b>'
    pl '<b>ЗНАКОМСТВО И СТАТУС ВИЗИТОВ</b>'
    pl '<b>══════════════════════════════════════════════════</b>'
    gs 'DebugAmandaLizaPrintBool', 'Порт witness (PortMeetWitnessed)', PortMeetWitnessed
    gs 'DebugAmandaLizaPrintBool', 'Аманда встретила Лизетту (AmandaMetLizette)', AmandaMetLizette
    gs 'DebugAmandaLizaPrintBool', 'Лизетта известна (LizetteKnown)', LizetteKnown
    pl 'Стадия визитов (LizetteVisitStage): <b>' + STR(LizetteVisitStage) + '</b> (1=ждёт room_visit, 2=после)'
    pl 'Визиты в зал нед / готовность: ' + STR(AmandaLizaHallVisitsWeek) + ' / ' + STR(AmandaLizaHallVisitReady) + ' (день: ' + STR(AmandaLizaHallVisitDay[day]) + ')'
    pl 'Разговоры в комнате на неделе: ' + STR(AmandaLizaRoomTalksWeek) + ' | Неделя расписания: ' + STR(AmandaLizaScheduleWeek)
    pl 'Подслушано всего: ' + STR(AmandaLizaTalkHeardCount) + ' | Ключ части дня: «' + $AmandaLizaTalkUsedKey + '»'

    pl ' '
    pl '<b>Запреты и бунт:</b>'
    gs 'DebugAmandaLizaPrintBool', 'Запрет (LizetteBanned)', LizetteBanned
    gs 'DebugAmandaLizaPrintBool', 'Строгий запрет (LizetteBanStrict)', LizetteBanStrict
    gs 'DebugAmandaLizaPrintBool', 'Тайный визит был (LizetteSecretVisit)', LizetteSecretVisit
    pl 'Влияние Лизетты (AmandaLizaInfluence): ' + STR(AmandaLizaInfluence) + ' | Бунт (AmandaRebellion): ' + STR(AmandaRebellion) + ' | Развратность: ' + STR(sluttiness['amanda']) + ' | Откровенность: ' + STR(otkroven['amanda'])

    pl ' '
    pl '<b>Интим, орал и марафон:</b>'
    gs 'DebugAmandaLizaPrintBool', 'Домашний секс был (AmandaHomeSex)', AmandaHomeSex
    gs 'DebugAmandaLizaPrintBool', 'Невинность (virginity)', virginity['amanda']
    gs 'AmandaOralEnsureVars'
    pl 'Оральная стадия (AmandaOralStage): ' + STR(AmandaOralStage) + ' / 6 | Оргазмы от игрока: ' + STR(GiveOrgasms['amanda'])
    gs 'DebugAmandaLizaPrintBool', 'Марафон ожидает сплетню (SexMarathonGossipPending)', SexMarathonGossipPending['amanda']
    pl 'Последний день марафона: ' + STR(SexMarathonGossipLastDay['amanda'])
    gs 'DebugAmandaLizaPrintBool', 'Разговор об анале был (AnalTalkDone)', AmandaLizetteAnalTalkDone
    pl 'Счётчик намёков на анал (AnalTalkCount): ' + STR(AmandaLizetteAnalTalkCount) + ' (нужно 2 для разблокировки)'
---

#DebugAmandaLizaPrintGates
    pl '<b>══════════════════════════════════════════════════</b>'
    pl '<b>ГЕЙТЫ ТЕКУЩЕГО МОМЕНТА</b>'
    pl '<b>══════════════════════════════════════════════════</b>'

    gs 'AmandaLizetteInAmandaRoomNow'
    gs 'DebugAmandaLizaPrintBool', 'Лизетта в комнате Аманды сейчас (вс день/вечер)', AmandaLizetteInAmandaRoomNow
    killvar 'AmandaLizetteInAmandaRoomNow'

    gs 'AmandaLizaRoomDoorCanShow'
    gs 'DebugAmandaLizaPrintBool', 'Сцена закрытой двери доступна (AmandaLizaRoomDoor)', AmandaLizaRoomDoorCanShow
    killvar 'AmandaLizaRoomDoorCanShow'

    gs 'AmandaLizaTalkCanTrigger', 'tavernmain'
    gs 'DebugAmandaLizaPrintBool', 'Подслушать в зале доступно (CanTrigger)', AmandaLizaTalkCanTrigger
    killvar 'AmandaLizaTalkCanTrigger'

    gs 'AmandaLizaTalkCanTrigger', 'amandaroom'
    gs 'DebugAmandaLizaPrintBool', 'Болтовня в комнате доступна (CanTrigger)', AmandaLizaTalkCanTrigger
    killvar 'AmandaLizaTalkCanTrigger'

    AmandaLizetteCanStart = 0
    $AmandaLizetteNextEvent = ''
    gs 'AmandaLizetteEnsureVars'

    gs 'GetCitySchedulePhase'
    DebugAmandaLizaRoomVisitPhaseOk = 0

    if week = 7 and time >= 3 and time <= 4 and $CitySchedulePhase = 'sunday_visits':
        DebugAmandaLizaRoomVisitPhaseOk = 1
    end

    killvar '$CitySchedulePhase'

    if LizetteKnown = 1 and LizetteVisitStage = 1 and DebugAmandaLizaRoomVisitPhaseOk = 1:
        if $GirlLocation['amanda'] = 'AmandaRoom' and $GirlLocation['lizette'] = 'AmandaRoom':
            AmandaLizetteCanStart = 1
            $AmandaLizetteNextEvent = 'room_visit'
        end
    end

    killvar 'DebugAmandaLizaRoomVisitPhaseOk'

    if AmandaLizetteCanStart = 0:
        if LizetteBanned = 1 and LizetteSecretVisit = 0 and AmandaRebellion >= 3 and time = 5:
            AmandaLizetteCanStart = 1
            $AmandaLizetteNextEvent = 'secret_visit'
        end
    end

    if AmandaLizetteCanStart = 1:
        pl 'Сюжетный ивент AmandaLizetteTryEvent: <b><font color="#00aa00">' + $AmandaLizetteNextEvent + '</font></b>'
    else
        pl 'Сюжетный ивент AmandaLizetteTryEvent: <font color="#888888">[нет]</font>'
    end

    killvar 'AmandaLizetteCanStart'
    killvar '$AmandaLizetteNextEvent'
---

#DebugAmandaLizaPrintPool
    gs 'AmandaLizaTalkBuildPool'

    pl '<b>══════════════════════════════════════════════════</b>'
    pl '<b>АКТИВНЫЙ ПУЛ СПЛЕТЕН: ' + STR(AmandaLizaTalkPoolSize) + ' фраз (Tier max: ' + STR(AmandaLizaTalkPoolMax) + ')</b>'
    pl '<b>══════════════════════════════════════════════════</b>'

    if AmandaLizaTalkPoolSize > 0:
        DebugPoolIdx = 1
        :DebugPoolLoop
        if DebugPoolIdx <= AmandaLizaTalkPoolSize:
            pl '  [' + STR(DebugPoolIdx) + '] <a href="exec:gs ''DebugAmandaLizaPreview'',''' + $AmandaLizaTalkPool[DebugPoolIdx] + '''">' + $AmandaLizaTalkPool[DebugPoolIdx] + '</a>'
            DebugPoolIdx += 1
            jump 'DebugPoolLoop'
        end
        killvar 'DebugPoolIdx'
    else
        pl '<font color="#cc6600">Пул пуст — ни одна фраза не проходит текущие гейты (slut, home sex, oral, запреты...).</font>'
    end
---

#DebugAmandaLizaPrintPhraseTester
