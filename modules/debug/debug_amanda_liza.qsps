    pl '<b>ТЕСТЕР ТЕКСТОВ СПЛЕТЕН (КЛИК ДЛЯ ПРОСМОТРА)</b>'
    pl '<b>══════════════════════════════════════════════════</b>'

    if $DebugAmandaLizaPreviewPhrase <> '':
        pl '┌────────────────────────────────────────────────────────────'
        pl '│ <b>ТЕКСТ ФРАЗЫ: [' + $DebugAmandaLizaPreviewPhrase + ']</b>  <a href="exec:gs ''DebugAmandaLizaClearPreview''">[x Скрыть]</a>'
