#DebugAmandaLizaPrintJumps
    pl '<b>══════════════════════════════════════════════════</b>'
    pl '<b>ЗАПУСК СЦЕН (1-КЛИК, БЕЗ ROLL) И ЛОКАЦИИ</b>'
