    gs 'DebugAmandaLizaPanel'
---

#DebugAmandaLizaPrintPresets
    pl '<b>══════════════════════════════════════════════════</b>'
    pl '<b>ПРЕСЕТЫ СОСТОЯНИЙ</b>'
    pl '<b>══════════════════════════════════════════════════</b>'
    pl '  <a href="exec:gs ''DebugAmandaLizaPresetAfterPort'' & gs ''DebugAmandaLizaPanel''">[Пресет] После порта: witness + знакомство</a>'
    pl '  <a href="exec:gs ''DebugAmandaLizaPresetHallVisit'' & gs ''DebugAmandaLizaPanel''">[Пресет] Будний день: визит Лизетты в зал (ready)</a>'
    pl '  <a href="exec:gs ''DebugAmandaLizaPresetSundayRoom'' & gs ''DebugAmandaLizaPanel''">[Пресет] Воскресенье: обе в AmandaRoom (дверь)</a>'
    pl '  <a href="exec:gs ''DebugAmandaLizaPresetRoomVisitStory'' & gs ''DebugAmandaLizaPanel''">[Пресет] Воскресенье: сюжет room_visit (stage 1)</a>'
    pl '  <a href="exec:gs ''DebugAmandaLizaPresetGossipRich'' & gs ''DebugAmandaLizaPanel''">[Пресет] Богатый пул сплетен (home sex, slut 45, oral 4)</a>'
    pl '  <a href="exec:gs ''DebugAmandaLizaPresetMarathon8AndGossip'' & gs ''DebugAmandaLizaPanel''"><b>[Пресет] 8 оргазмов + marathon pending + флаги Лизетты</b></a>'
    pl '  <a href="exec:gs ''DebugAmandaLizaPresetAnalTalkPath'' & gs ''DebugAmandaLizaPanel''">[Пресет] Путь к AnalTalk unlock (count 2)</a>'
    pl '  <a href="exec:gs ''DebugAmandaLizaPresetSecretVisit'' & gs ''DebugAmandaLizaPanel''">[Пресет] Тайный ночной визит (запрет, бунт 5)</a>'
    pl '  <a href="exec:AmandaLizaHallVisitReady = 1 & AmandaLizaHallVisitDay[day] = 1 & gs ''DebugAmandaLizaPanel''">[Быстрый форс] Hall ready = 1 (без смены дня)</a>'
    pl '  <a href="exec:$AmandaLizaTalkUsedKey = '''' & gs ''DebugAmandaLizaPanel''">[Сбросить] Ключ части дня (повтор overhear)</a>'
    pl '  <a href="exec:SexMarathonGossipPending[''amanda''] = 1 & gs ''DebugAmandaLizaPanel''">[Флаг] Включить Marathon pending</a>'
