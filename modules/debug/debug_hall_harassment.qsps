---

#HallHarassmentDebugPrintStatus
    *pl 'liberation=' + STR(FamilyLiberationGateOpen) + ' | moral=' + STR(Act1MoralUnlocked) + ' | councilDone=' + STR(FamilyCouncilDone)
    *pl 'stage=' + STR(FamilyCorruptionStage) + ' | ever_harass=' + STR(HallHarassEverOccurred) + ' | debug=' + STR(debug)
    *pl 'day=' + STR(day) + ' time=' + STR(time) + ' week=' + STR(week) + ' open=' + STR(TavernOpen)
    *pl ' '
    *pl 'Аманда: slut=' + STR(sluttiness['amanda']) + ' u=' + STR(GirlUniformLevel['amanda']) + ' nop=' + STR(GirlNoPantiesWork['amanda']) + ' pol=' + STR(GirlWorkPolicy['amanda']) + ' jobW=' + STR(jobwaitress['amanda']) + ' loc=' + $GirlLocation['amanda']
    *pl 'Мелисса: slut=' + STR(sluttiness['melissa']) + ' u=' + STR(GirlUniformLevel['melissa']) + ' nop=' + STR(GirlNoPantiesWork['melissa']) + ' pol=' + STR(GirlWorkPolicy['melissa']) + ' jobW=' + STR(jobwaitress['melissa']) + ' loc=' + $GirlLocation['melissa']
    *pl 'Сандра: slut=' + STR(sluttiness['sandra']) + ' u=' + STR(GirlUniformLevel['sandra']) + ' nop=' + STR(GirlNoPantiesWork['sandra']) + ' pol=' + STR(GirlWorkPolicy['sandra']) + ' loc=' + $GirlLocation['sandra']
    *pl ' '
    *pl 'Гейты AllowedTier (на девушку): T2=stage≥2+slut≥20; T3=stage≥3+slut≥40+u1'
    *pl 'Кнопки watch/ignore: только liberation=1. Cock: drop_coin + liberation + stage≥3 + ever=1'
---

#HallHarassmentDebugApplyStaff
    ! девушки на смене в зале / кухне для natural pick
    gs 'IsTavernOpen'
    if TavernOpen = 0:
        ! день/время: будний noon если закрыто
        if week = 7:
            week = 1
        end
        if time = 5:
            time = 3
        end
        gs 'IsTavernOpen'
    end

    jobwaitress['amanda'] = 1
    jobwaitress['melissa'] = 1
    jobkitchen['sandra'] = 1
    $GirlLocation['amanda'] = 'TavernMain'
    $GirlLocation['melissa'] = 'TavernMain'
    $GirlLocation['sandra'] = 'Kitchen'

    if LOC('EnsureGirlData') = 1:
        gs 'EnsureGirlData', 'amanda'
        gs 'EnsureGirlData', 'melissa'
        gs 'EnsureGirlData', 'sandra'
    end
---

#HallHarassmentDebugPreset
    $HallHarassDebugPresetId = LCASE($ARGS[0])

    gs 'HallHarassmentDebugApplyStaff'
    HallHarassmentDay = 0
    HallHarassmentTime = 0
    HallHarassmentResolved = 0
    KitchenHarassmentDay = 0
    KitchenHarassmentTime = 0

    if $HallHarassDebugPresetId = 'pre_dinner':
        FamilyLiberationGateOpen = 0
        Act1MoralUnlocked = 0
        FamilyCouncilDone = 0
        FamilyCouncilPending = 0
        FamilyCorruptionStage = 0
        sluttiness['amanda'] = 10
        sluttiness['melissa'] = 10
        sluttiness['sandra'] = 10
        GirlUniformLevel['amanda'] = 0
        GirlUniformLevel['melissa'] = 0
        GirlUniformLevel['sandra'] = 0
        GirlNoPantiesWork['amanda'] = 0
        GirlNoPantiesWork['melissa'] = 0
        GirlNoPantiesWork['sandra'] = 0
        GirlWorkPolicy['amanda'] = 1
        GirlWorkPolicy['melissa'] = 1
        GirlWorkPolicy['sandra'] = 1
        HallHarassEverOccurred = 0

    elseif $HallHarassDebugPresetId = 'post_dinner':
        FamilyLiberationGateOpen = 1
        Act1MoralUnlocked = 1
        FamilyCouncilDone = 1
        FamilyCouncilPending = 0
        if FamilyCorruptionStage < 1:
            FamilyCorruptionStage = 1
        end
        if sluttiness['amanda'] < 15:
            sluttiness['amanda'] = 15
        end
        if sluttiness['melissa'] < 15:
            sluttiness['melissa'] = 15
        end
        if sluttiness['sandra'] < 15:
            sluttiness['sandra'] = 15
        end

    elseif $HallHarassDebugPresetId = 'post_dinner_t2':
        FamilyLiberationGateOpen = 1
        Act1MoralUnlocked = 1
        FamilyCouncilDone = 1
        FamilyCouncilPending = 0
        FamilyCorruptionStage = 2
        sluttiness['amanda'] = 25
        sluttiness['melissa'] = 25
        sluttiness['sandra'] = 25

    elseif $HallHarassDebugPresetId = 'post_dinner_t3':
        FamilyLiberationGateOpen = 1
        Act1MoralUnlocked = 1
        FamilyCouncilDone = 1
        FamilyCouncilPending = 0
        FamilyCorruptionStage = 3
        sluttiness['amanda'] = 45
        sluttiness['melissa'] = 45
        sluttiness['sandra'] = 45
        GirlUniformLevel['amanda'] = 1
        GirlUniformLevel['melissa'] = 1
        GirlUniformLevel['sandra'] = 1
        HallHarassEverOccurred = 1

    elseif $HallHarassDebugPresetId = 'cock_ready':
        FamilyLiberationGateOpen = 1
        Act1MoralUnlocked = 1
        FamilyCouncilDone = 1
        FamilyCouncilPending = 0
        FamilyCorruptionStage = 3
        HallHarassEverOccurred = 1
        sluttiness['amanda'] = 45
        sluttiness['melissa'] = 45
        sluttiness['sandra'] = 45
        GirlUniformLevel['amanda'] = 1
        GirlUniformLevel['melissa'] = 1
        GirlUniformLevel['sandra'] = 1
        GirlWorkPolicy['amanda'] = 2
        GirlWorkPolicy['melissa'] = 2
        GirlWorkPolicy['sandra'] = 2

    elseif $HallHarassDebugPresetId = 'nopanties':
        FamilyLiberationGateOpen = 1
        Act1MoralUnlocked = 1
        FamilyCouncilDone = 1
        FamilyCouncilPending = 0
        FamilyCorruptionStage = 2
        sluttiness['amanda'] = 25
        sluttiness['melissa'] = 25
        sluttiness['sandra'] = 25
        GirlUniformLevel['amanda'] = 1
        GirlUniformLevel['melissa'] = 1
        GirlUniformLevel['sandra'] = 1
        GirlNoPantiesWork['amanda'] = 1
        GirlNoPantiesWork['melissa'] = 1
        GirlNoPantiesWork['sandra'] = 1

    elseif $HallHarassDebugPresetId = 'offense_low':
        ! band low: ждала защиты — ignore/watch_bad копят обиду
        FamilyLiberationGateOpen = 1
        Act1MoralUnlocked = 1
        FamilyCouncilDone = 1
        FamilyCouncilPending = 0
        FamilyCorruptionStage = 1
        sluttiness['amanda'] = 12
        sluttiness['melissa'] = 12
        sluttiness['sandra'] = 12
        GirlWorkPolicy['amanda'] = 1
        GirlWorkPolicy['melissa'] = 1
        GirlWorkPolicy['sandra'] = 1
        GirlPublicAttention['amanda'] = 5
        GirlPublicAttention['melissa'] = 5
        GirlUniformLevel['amanda'] = 0
        GirlUniformLevel['melissa'] = 0
        GirlUniformLevel['sandra'] = 0
        GirlNoPantiesWork['amanda'] = 0
        GirlNoPantiesWork['melissa'] = 0
        GirlNoPantiesWork['sandra'] = 0
        GirlRebellion['amanda'] = 0
        GirlRebellion['melissa'] = 0
        AmandaRebellion = 0
        AmandaPublicAttention = 5
    end

    killvar '$HallHarassDebugPresetId'
---

#HallHarassmentDebugLaunchNatural
    $HallHarassDebugGirl = LCASE($ARGS[0])

    if $HallHarassDebugGirl = '':
        $HallHarassDebugGirl = 'amanda'
    end

    gs 'HallHarassmentDebugApplyStaff'
    HallHarassmentDay = 0
    HallHarassmentTime = 0
    HallHarassmentResolved = 0
    KitchenHarassmentDay = 0
    KitchenHarassmentTime = 0
    HallHarassDebugForce = 0

    if $HallHarassDebugGirl = 'sandra':
        SparkQueueConsumeKitchen = 1
        $SparkQueueConsumeGirl = 'sandra'
        SparkQueueConsumeHall = 0
        gt 'KitchenHarassment', 'Kitchen'
    else:
        SparkQueueConsumeHall = 1
        $SparkQueueConsumeGirl = $HallHarassDebugGirl
        SparkQueueConsumeKitchen = 0
        gt 'HallHarassment', 'TavernMain'
    end
---

#HallHarassmentDebugPanel
    ! item-panel style (если откроют из панели)
    gs 'PanelDebugToolsHeader'
    pl 'HARASSMENT DEBUG'
    pl ' '
    pl 'liberation=' + STR(FamilyLiberationGateOpen) + ' moral=' + STR(Act1MoralUnlocked) + ' stage=' + STR(FamilyCorruptionStage)
    pl 'ever=' + STR(HallHarassEverOccurred) + ' debug=' + STR(debug)
    pl ' '
    pl '<a href="exec:gs ''HallHarassmentDebugPreset'', ''pre_dinner'' & gs ''HallHarassmentDebugPanel''">ДО ужина</a>'
    pl '<a href="exec:gs ''HallHarassmentDebugPreset'', ''post_dinner'' & gs ''HallHarassmentDebugPanel''">ПОСЛЕ ужина</a>'
    pl '<a href="exec:gs ''HallHarassmentDebugPreset'', ''post_dinner_t2'' & gs ''HallHarassmentDebugPanel''">После + T2</a>'
    pl '<a href="exec:gs ''HallHarassmentDebugPreset'', ''post_dinner_t3'' & gs ''HallHarassmentDebugPanel''">После + T3</a>'
    pl '<a href="exec:gs ''HallHarassmentDebugPreset'', ''cock_ready'' & gs ''HallHarassmentDebugPanel''">Cock-ready</a>'
    pl '<a href="exec:gs ''HallHarassmentDebugPreset'', ''nopanties'' & gs ''HallHarassmentDebugPanel''">No panties</a>'
    pl '<a href="exec:gs ''HallHarassmentDebugApplyStaff'' & gs ''HallHarassmentDebugPanel''">Смена в зале</a>'
    pl ' '
    pl '<a href="exec:gt ''HallHarassmentGateDebugMenu''">→ Полноэкранное меню harass</a>'
    pl '<a href="exec:gt ''HallHarassmentDebugStart'', ''amanda'', 3, 4">Force Аманда T3 wall</a>'
    pl '<a href="exec:gt ''HallHarassmentDebugStart'', ''amanda'', 3, 5, ''drop_coin'', 1, ''flee''">Force coin+cock flee</a>'
    pl '<a href="exec:gt ''HallHarassmentDebugLaunchNatural'', ''amanda''">Natural Аманда</a>'
    pl ' '
    gs 'PanelDebugToolsBack'
