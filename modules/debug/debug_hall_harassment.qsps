    end

    gs 'ActUiPrepare', 'Аманда T2 type4 (пах сзади)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallHarassmentDebugStart', 'amanda', 2, 4
    end

    gs 'ActUiPrepare', 'Аманда T3 type1 (юбка)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallHarassmentDebugStart', 'amanda', 3, 1
    end

    gs 'ActUiPrepare', 'Аманда T3 wall', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallHarassmentDebugStart', 'amanda', 3, 4
    end

    gs 'ActUiPrepare', 'Аманда T3 drop_cutlery', 'generic'
    act $ActUiLabel, $ActUiIconPath:
