    end

    gs 'ActUiPrepare', 'Harass Мелисса (natural)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallHarassmentDebugLaunchNatural', 'melissa'
    end

    gs 'ActUiPrepare', 'Harass кухня Сандра (natural)', 'kitchen'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallHarassmentDebugLaunchNatural', 'sandra'
    end

    *pl ' '
    *pl '── ЗАПУСК: FORCE type (tier+type) ──'
    gs 'ActUiPrepare', 'Аманда T1 type1 (рука)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallHarassmentDebugStart', 'amanda', 1, 1
    end

    gs 'ActUiPrepare', 'Аманда T2 type1 (попа)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
