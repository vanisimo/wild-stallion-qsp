! ================================================
! FILE: modules/debug/debug_hall_harassment.qsps
! MODULE: debug
! Debug: после ужина + гейты AllowedTier / T3 / cock / policy
! для теста hall/kitchen harassment
! Вход: gt 'HallHarassmentGateDebugMenu'
!       gt 'HallHarassmentDebugMenu' (alias)
! ================================================

#HallHarassmentGateDebugMenu
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' DEBUG: HARASSMENT / ГЕЙТЫ'
