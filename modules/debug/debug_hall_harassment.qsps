    *pl 'Аманда: days=' + STR(GirlOffenseDays['amanda']) + ' protectK=' + STR(GirlOffenseMismatchProtect['amanda']) + ' policyK=' + STR(GirlOffenseMismatchPolicy['amanda']) + ' reason=' + $GirlOffenseReason['amanda']
    *pl 'Мелисса: days=' + STR(GirlOffenseDays['melissa']) + ' protectK=' + STR(GirlOffenseMismatchProtect['melissa']) + ' policyK=' + STR(GirlOffenseMismatchPolicy['melissa'])
    *pl 'Сандра: days=' + STR(GirlOffenseDays['sandra']) + ' reason=' + $GirlOffenseReason['sandra']
    *pl 'K=3 mismatch (ignore/watch_bad) → days=4. Band high (2) не копит no_protect.'

    gs 'ActUiPrepare', 'Обида-тест: low band (slut12 pol1)', 'generic'
