#DebugPortChurchArcBool
    $DebugArcBoolLabel = $ARGS[0]
    DebugArcBoolVal = ARGS[1]

    if $DebugArcBoolLabel = '':
        killvar '$DebugArcBoolLabel'
        exit
    end

    if DebugArcBoolVal = 1:
        pl $DebugArcBoolLabel + ': <b><font color="#00aa00">[✓ ДА]</font></b>'
    else
        pl $DebugArcBoolLabel + ': <font color="#888888">[✗ нет]</font>'
    end

    killvar '$DebugArcBoolLabel'
    killvar 'DebugArcBoolVal'
