! ================================================
! FILE: modules/debug/debug_mayor_arc.qsps
! MODULE: debug
! Отладка мэрии и налогового гейта
! ================================================

#DebugMayorArcPanel
    if debug = 0:
        exit
    end

    gs 'PanelDebugToolsHeader'

    pl 'DEBUG: МЭРИЯ / НАЛОГ'
    pl ' '
    pl 'TaxPercent: ' + STR(TaxPercent)
    pl 'TavernCityTaxTotal: ' + STR(TavernCityTaxTotal)
    pl 'LastDayCityTax: ' + STR(LastDayCityTax)
    pl 'MayorCityTaxDailyGate: ' + STR(MayorCityTaxDailyGate)
    pl 'MayorCityTaxDailyGateDays: ' + STR(MayorCityTaxDailyGateDays)
    pl 'MayorCityTaxStreak: ' + STR(MayorCityTaxStreak)
    pl 'MayorCityTaxGateReady: ' + STR(MayorCityTaxGateReady)
    pl 'MayorAudienceBribe: ' + STR(MayorAudienceBribe)
    pl 'MayorBribePaid: ' + STR(MayorBribePaid)
    pl 'MayorFirstTalkDone: ' + STR(MayorFirstTalkDone)
    pl 'MayorAudienceRefused: ' + STR(MayorAudienceRefused)
    pl 'MayorClerkAdviceGiven: ' + STR(MayorClerkAdviceGiven)
    pl 'MayorClerkBackroomMentioned: ' + STR(MayorClerkBackroomMentioned)
    pl 'becky_backroom_clerk peek: ' + STR(PlayerKnows['becky_backroom_clerk']) + '/' + STR(EventWitnessed['becky_backroom_clerk'])
    pl 'BeckyMayorClerkTalkDone: ' + STR(BeckyMayorClerkTalkDone)
    pl 'TavernCarpenterUpgradesUnlocked: ' + STR(TavernCarpenterUpgradesUnlocked)
    pl 'SandraStaffHired: ' + STR(SandraStaffHired)
    pl 'MayorClerkMentionedStaff: ' + STR(MayorClerkMentionedStaff)
    pl 'MayorWorkoffProfitDays: ' + STR(MayorWorkoffProfitDays)
    pl 'Sign done / Staff hired: ' + STR(TavernUpgradeSignDone) + ' / ' + STR(SandraStaffHired)

    if LOC('MayorClerkWorkoffEvaluate') = 1:
        gs 'MayorClerkWorkoffEvaluate'
        pl 'MayorWorkoffReady: ' + STR(MayorWorkoffReady)
    end

    pl ' '
    pl '<a href="exec:MayorCityTaxStreak = MayorCityTaxDailyGateDays & MayorCityTaxGateReady = 1 & gs ''DebugMayorArcPanel''">Тест: налоговый гейт пройден</a>'
    pl '<a href="exec:MayorCityTaxStreak = 0 & MayorCityTaxGateReady = 0 & gs ''DebugMayorArcPanel''">Сбросить налоговый гейт</a>'
    pl '<a href="exec:MayorClerkAdviceGiven = 1 & TavernCarpenterUpgradesUnlocked = 1 & MayorClerkMentionedStaff = 1 & TavernUpgradeSignDone = 1 & SandraStaffHired = 1 & MayorWorkoffProfitDays = 2 & gs ''DebugMayorArcPanel''">Тест: отработка готова</a>'
    pl '<a href="exec:MayorFirstTalkDone = 0 & MayorBribePaid = 0 & MayorAudienceRefused = 0 & MayorClerkAdviceGiven = 0 & MayorClerkBackroomMentioned = 0 & MayorAudienceAttempted = 0 & MayorCityTaxStreak = 0 & MayorCityTaxGateReady = 0 & TavernCarpenterUpgradesUnlocked = 0 & gs ''DebugMayorArcPanel''">Сбросить арку мэра</a>'
    pl '<a href="exec:MayorBribePaid = 1 & MayorAudienceRefused = 1 & FactHappened[''becky_backroom_clerk''] = 1 & PlayerKnows[''becky_backroom_clerk''] = 1 & MayorClerkAdviceGiven = 0 & MayorClerkBackroomMentioned = 0 & gs ''DebugMayorArcPanel''">Тест: возврат взятки + peek клерка</a>'
    pl '<a href="exec:gt ''MayorOffice''">Открыть мэрию</a>'

    gs 'PanelDebugToolsBack'
---