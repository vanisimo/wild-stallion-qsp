! ================================================
! FILE: modules/debug/debug_tavern_event_dispatcher.qsps
! MODULE: debug
! Единый полноэкранный хаб: события трактира v2
! Вход: gt 'TavernEventDispatcherDebugMenu'
!       предмет «Дебаг» → Полноэкранный тест событий трактира
! Назначение:
! - harass / missing-from-play / lewd (legacy) / kitchen
! - daily aftermath force
! - v2 probe / play coach
! - переходы в гейт-меню harassment
! ================================================

#TavernEventDispatcherDebugMenu
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' DEBUG: СОБЫТИЯ ТРАКТИРА (v2)'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *pl 'liberation=' + STR(FamilyLiberationGateOpen) + ' moral=' + STR(Act1MoralUnlocked) + ' stage=' + STR(FamilyCorruptionStage)
    *pl 'ever_harass=' + STR(HallHarassEverOccurred) + ' PlayCoached a/m/s=' + STR(PlayCoached['amanda']) + '/' + STR(PlayCoached['melissa']) + '/' + STR(PlayCoached['sandra'])
    *pl 'LewdAutoOff=' + STR(HallLewdAutoDisabled) + ' MissingOnlyPlay=' + STR(HallMissingOnlyFromPlay)
    *pl 'day=' + STR(day) + ' time=' + STR(time) + ' week=' + STR(week)
    *pl ' '

    *pl '── ПРИСТАВАНИЯ (harass v2) ──'
    gs 'ActUiPrepare', 'Harass: гейты + после ужина', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallHarassmentGateDebugMenu'
    end

    gs 'ActUiPrepare', 'Harass Аманда T3 wall (force)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallHarassmentDebugPreset', 'post_dinner_t3'
        gt 'HallHarassmentDebugStart', 'amanda', 3, 4
    end

    gs 'ActUiPrepare', 'Harass Мелисса T2 natural', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallHarassmentDebugPreset', 'post_dinner_t2'
        gs 'HallHarassmentDebugLaunchNatural', 'melissa'
    end

    gs 'ActUiPrepare', 'Harass кухня Сандра natural', 'kitchen'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallHarassmentDebugPreset', 'post_dinner_t2'
        gs 'HallHarassmentDebugLaunchNatural', 'sandra'
    end

    gs 'ActUiPrepare', 'Harass Аманда natural (текущие гейты)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallHarassmentDebugLaunchNatural', 'amanda'
    end

    *pl ' '
    *pl '── ПРОПАЖА (только from play) ──'
    gs 'ActUiPrepare', 'Missing from play: Аманда', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingGirlDebugStart', 'amanda'
    end

    gs 'ActUiPrepare', 'Missing from play: Мелисса', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingGirlDebugStart', 'melissa'
    end

    gs 'ActUiPrepare', 'Missing from play: Сандра (кухня)', 'kitchen'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingGirlDebugStart', 'sandra'
    end

    *pl ' '
    *pl '── УГОВОР (каркас перед missing) ──'
    if LOC('HallMissingBargainDebugStart') = 1:
        gs 'ActUiPrepare', 'Bargain soft: Аманда', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'HallMissingBargainDebugStart', 'amanda', 'soft', 'TavernEventDispatcherDebugMenu'
        end

        gs 'ActUiPrepare', 'Bargain hard: Аманда', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'HallMissingBargainDebugStart', 'amanda', 'hard', 'TavernEventDispatcherDebugMenu'
        end

        gs 'ActUiPrepare', 'Bargain soft: Мелисса', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'HallMissingBargainDebugStart', 'melissa', 'soft', 'TavernEventDispatcherDebugMenu'
        end

        gs 'ActUiPrepare', 'Bargain hard: Мелисса', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'HallMissingBargainDebugStart', 'melissa', 'hard', 'TavernEventDispatcherDebugMenu'
        end

        gs 'ActUiPrepare', 'Bargain soft: Сандра', 'kitchen'
        act $ActUiLabel, $ActUiIconPath:
            gt 'HallMissingBargainDebugStart', 'sandra', 'soft', 'TavernEventDispatcherDebugMenu'
        end

        gs 'ActUiPrepare', 'Bargain hard: Сандра', 'kitchen'
        act $ActUiLabel, $ActUiIconPath:
            gt 'HallMissingBargainDebugStart', 'sandra', 'hard', 'TavernEventDispatcherDebugMenu'
        end

        gs 'ActUiPrepare', 'Missing БЕЗ уговора (skip)', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            HallMissingBargainSkip = 1
            gt 'HallMissingGirlDebugStart', 'amanda'
        end

        *pl ' '
        *pl '── PHASE (лесенка) ──'
        if LOC('HallMissingPhaseDebugSet') = 1:
            gs 'ActUiPrepare', 'Phase soft_intro: Аманда', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gs 'HallMissingPhaseDebugSet', 'amanda', 'soft_intro'
                gt 'HallMissingBargainDebugStart', 'amanda', '', 'TavernEventDispatcherDebugMenu'
            end
            gs 'ActUiPrepare', 'Phase soft_play: Аманда', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gs 'HallMissingPhaseDebugSet', 'amanda', 'soft_play'
                gt 'HallMissingBargainDebugStart', 'amanda', '', 'TavernEventDispatcherDebugMenu'
            end
            gs 'ActUiPrepare', 'Phase hard: Аманда', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gs 'HallMissingPhaseDebugSet', 'amanda', 'hard'
                gt 'HallMissingBargainDebugStart', 'amanda', '', 'TavernEventDispatcherDebugMenu'
            end
            gs 'ActUiPrepare', 'Phase free+face: Аманда', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gs 'HallMissingPhaseDebugSet', 'amanda', 'free'
                gt 'HallMissingBargainDebugStart', 'amanda', '', 'TavernEventDispatcherDebugMenu'
            end
            gs 'ActUiPrepare', 'Phase hard: Мелисса', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gs 'HallMissingPhaseDebugSet', 'melissa', 'hard'
                gt 'HallMissingBargainDebugStart', 'melissa', '', 'TavernEventDispatcherDebugMenu'
            end
            gs 'ActUiPrepare', 'Phase hard: Сандра', 'kitchen'
            act $ActUiLabel, $ActUiIconPath:
                gs 'HallMissingPhaseDebugSet', 'sandra', 'hard'
                gt 'HallMissingBargainDebugStart', 'sandra', '', 'TavernEventDispatcherDebugMenu'
            end
        end
        if LOC('HallMissingPhaseReset') = 1:
            gs 'ActUiPrepare', 'Phase RESET all girls', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gs 'HallMissingPhaseReset', ''
                *pl 'Phase reset amanda/melissa/sandra'
                gt 'TavernEventDispatcherDebugMenu'
            end
        end

        *pl ' '
        *pl '── НОБИЛЬ (только сёстры) ──'
        gs 'ActUiPrepare', 'Noble force: Аманда (уговор+сцена)', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingPhaseDebugSet', 'amanda', 'soft_play'
            $HallMissingPromiseForce = 'noble'
            $HallHarassClient = 'noble'
            gt 'HallMissingBargainStart', 'amanda', 'TavernEventDispatcherDebugMenu'
        end
        gs 'ActUiPrepare', 'Noble force: Мелисса (уговор+сцена)', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingPhaseDebugSet', 'melissa', 'soft_play'
            $HallMissingPromiseForce = 'noble'
            $HallHarassClient = 'noble'
            gt 'HallMissingBargainStart', 'melissa', 'TavernEventDispatcherDebugMenu'
        end
    end

    *pl ' '
    *pl '── LEWD (legacy UI; auto выключен) ──'
    gs 'ActUiPrepare', 'Hall lewd: Аманда', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallLewdDebugStart', 'amanda'
    end

    gs 'ActUiPrepare', 'Hall lewd: Мелисса', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallLewdDebugStart', 'melissa'
    end

    gs 'ActUiPrepare', 'Kitchen lewd: Сандра', 'kitchen'
    act $ActUiLabel, $ActUiIconPath:
        gt 'KitchenLewdDebugStart'
    end

    *pl ' '
    *pl '── КУХНЯ: конфликт с клиентом ──'
    gs 'ActUiPrepare', 'Кухня клиент: Аманда', 'kitchen'
    act $ActUiLabel, $ActUiIconPath:
        gt 'KitchenCustomerDebugStart', 'amanda'
    end

    gs 'ActUiPrepare', 'Кухня клиент: Мелисса', 'kitchen'
    act $ActUiLabel, $ActUiIconPath:
        gt 'KitchenCustomerDebugStart', 'melissa'
    end

    gs 'ActUiPrepare', 'Кухня клиент: Сандра', 'kitchen'
    act $ActUiLabel, $ActUiIconPath:
        gt 'KitchenCustomerDebugStart', 'sandra'
    end

    *pl ' '
    *pl '── УТРО / AFTERMATH ──'
    gs 'ActUiPrepare', 'Aftermath: Аманда protect', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'DailyAftermathDebugForce', 'amanda', 'harassment', 'protect'
    end

    gs 'ActUiPrepare', 'Aftermath: Аманда ignore', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'DailyAftermathDebugForce', 'amanda', 'harassment', 'ignore'
    end

    gs 'ActUiPrepare', 'Aftermath: Мелисса watch', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'DailyAftermathDebugForce', 'melissa', 'hall_lewd', 'watch'
    end

    gs 'ActUiPrepare', 'Aftermath: Сандра profit', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'DailyAftermathDebugForce', 'sandra', 'kitchen', 'profit'
    end

    gs 'ActUiPrepare', 'Aftermath: полная панель', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'DailyAftermathDebugPanel'
    end

    *pl ' '
    *pl '── V2 / COACH / POLICY ──'
    if LOC('HallSceneV2DebugProbe') = 1:
        gs 'ActUiPrepare', 'V2 probe: Аманда memory/rumor', 'debug'
        act $ActUiLabel, $ActUiIconPath:
            gt 'HallSceneV2DebugProbe', 'amanda', 'TavernEventDispatcherDebugMenu'
        end

        gs 'ActUiPrepare', 'V2 probe: Мелисса', 'debug'
        act $ActUiLabel, $ActUiIconPath:
            gt 'HallSceneV2DebugProbe', 'melissa', 'TavernEventDispatcherDebugMenu'
        end
    end

    if LOC('HallPlayCoachStart') = 1:
        gs 'ActUiPrepare', 'Play coach (подслух): А↔Лизетта', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            FamilyLiberationGateOpen = 1
            Act1MoralUnlocked = 1
            if FamilyCorruptionStage < 2:
                FamilyCorruptionStage = 2
            end
            AmandaMetLizette = 1
            LizetteKnown = 1
            gt 'HallPlayCoachStart', 'amanda', 'TavernEventDispatcherDebugMenu'
        end

        gs 'ActUiPrepare', 'Play coach (подслух): М↔Кларисса', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            FamilyLiberationGateOpen = 1
            Act1MoralUnlocked = 1
            if FamilyCorruptionStage < 2:
                FamilyCorruptionStage = 2
            end
            PlayCoached['amanda'] = 1
            gt 'HallPlayCoachStart', 'melissa', 'TavernEventDispatcherDebugMenu'
        end

        gs 'ActUiPrepare', 'Play coach (подслух): С↔Бекки', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            FamilyLiberationGateOpen = 1
            Act1MoralUnlocked = 1
            if FamilyCorruptionStage < 2:
                FamilyCorruptionStage = 2
            end
            PlayCoached['amanda'] = 1
            PlayCoached['melissa'] = 1
            gt 'HallPlayCoachStart', 'sandra', 'TavernEventDispatcherDebugMenu'
        end
    end

    gs 'ActUiPrepare', 'Воскресенье: визиты (debug menu)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
        time = 3
        gs 'GetDateTimeNames'
        if LOC('SundayShopVisitsDebugMenu') = 1:
            gt 'SundayShopVisitsDebugMenu', 'TavernEventDispatcherDebugMenu'
        else:
            gt 'Market'
        end
    end

    if LOC('GirlWorkPolicyTalkDebugHall') = 1:
        gs 'ActUiPrepare', 'Правила зала: Аманда', 'policy'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GirlWorkPolicyTalkDebugHall', 'amanda'
        end
    end

    if LOC('GirlWorkPolicyTalkDebugKitchen') = 1:
        gs 'ActUiPrepare', 'Правила кухни: Аманда', 'kitchen'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GirlWorkPolicyTalkDebugKitchen', 'amanda'
        end
    end

    *pl ' '
    *pl '── СЛУЖЕБНОЕ ──'
    gs 'ActUiPrepare', 'Открыть смену (зал+кухня)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        if LOC('HallHarassmentDebugApplyStaff') = 1:
            gs 'HallHarassmentDebugApplyStaff'
        end
        gt 'TavernEventDispatcherDebugMenu'
    end

    gs 'ActUiPrepare', 'Пресет: после ужина + T3', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        if LOC('HallHarassmentDebugPreset') = 1:
            gs 'HallHarassmentDebugPreset', 'post_dinner_t3'
        end
        gt 'TavernEventDispatcherDebugMenu'
    end

    gs 'ActUiPrepare', 'В главный зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---
