! ================================================
! FILE: modules/debug/debug_hall_missing.qsps
! MODULE: debug
! Отладка пропажи с гостем (уговор + лесенка + сцена)
! Вход: gt 'HallMissingDebugMenu'
! ================================================

#HallMissingDebugEnsure

    if $HallMissingDbgGirl = '':
        $HallMissingDbgGirl = 'sandra'
    end
    if $HallMissingDbgGirl <> 'amanda' and $HallMissingDbgGirl <> 'melissa' and $HallMissingDbgGirl <> 'sandra':
        $HallMissingDbgGirl = 'sandra'
    end
    if $HallMissingDbgClient = '':
        $HallMissingDbgClient = 'craftsman'
    end
    if HallMissingDbgHardStep < 0:
        HallMissingDbgHardStep = 0
    end
    if HallMissingDbgHardSub < 0:
        HallMissingDbgHardSub = 0
    end
    if debug < 1:
        debug = 1
    end
---

#HallMissingDebugPrepGates

    if LOC('HallSceneV2EnsureFlags') = 1:
        gs 'HallSceneV2EnsureFlags'
    end
    FamilyLiberationGateOpen = 1
    Act1MoralUnlocked = 1
    FamilyCouncilDone = 1
    if FamilyCorruptionStage < 3:
        FamilyCorruptionStage = 3
    end
    TavernScandal = 50
    TavernLewdFame = 30
    TavernGirlsEasyRumor = 1
    TavernBackroomRumor = 1
    HallMissingOnlyFromPlay = 1
    HallMissingBargainSkip = 0
    HallMissingBargainDone = 0
    HallMissingFromPlay = 1
    HallMissingGirlDisabled = 0
    HallMissingGirlLastGlobalDay = 0
    HallMissingGirlLastGlobalTime = 0
---

! ARGS[0]=girl
#HallMissingDebugPrepGirl

    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $g = $HallMissingGirlKey
    if $g = '':
        $g = $HallMissingDbgGirl
    end
    gs 'HallMissingDebugPrepGates'
    if LOC('HallMissingGirlEnsureName') = 1:
        gs 'HallMissingGirlEnsureName', $g
    end
    GirlUniformLevel[$g] = 1
    GirlWorkPolicy[$g] = 3
    GirlPolicyAgreement[$g] = 2
    GirlHallLewdStage[$g] = 4
    GirlPublicAttention[$g] = 40
    GirlNpcPath[$g] = 30
    GirlSecretiveness[$g] = 15
    GirlRebellion[$g] = 10
    PlayCoached[$g] = 1
    sluttiness[$g] = 40
    HallMissingGirlLastDay[$g] = 0
    if $g = 'amanda':
        AmandaScandalLevel = 50
        AmandaPublicAttention = 40
        AmandaNpcPath = 30
        AmandaSecretiveness = 15
        AmandaRebellion = 10
    elseif $g = 'melissa':
        MelissaScandalTolerance = 40
        MelissaNpcPath = 30
    else
        SandraPragmatism = 40
        SandraMoralResistance = 10
        SandraNpcPath = 30
    end
    killvar '$g'
---

! русские подписи для статуса и кнопок
#HallMissingDebugFillLabels

    gs 'HallMissingDebugEnsure'
    $g = $HallMissingDbgGirl
    if LOC('HallMissingPhaseEnsure') = 1:
        gs 'HallMissingPhaseEnsure', $g
    end

    if $g = 'amanda':
        $HallMissingDbgGirlRu = 'Аманда'
        $HallMissingDbgPlaceRu = 'подсобка'
    elseif $g = 'melissa':
        $HallMissingDbgGirlRu = 'Мелисса'
        $HallMissingDbgPlaceRu = 'подсобка'
    else
        $HallMissingDbgGirlRu = 'Сандра'
        $HallMissingDbgPlaceRu = 'кухня'
    end

    if $HallMissingDbgClient = 'traveler' or $HallMissingDbgClient = 'sailor':
        $HallMissingDbgClientRu = 'моряк'
    elseif $HallMissingDbgClient = 'craftsman' or $HallMissingDbgClient = 'local':
        $HallMissingDbgClientRu = 'мастеровой'
    elseif $HallMissingDbgClient = 'rich_merchant' or $HallMissingDbgClient = 'merchant':
        $HallMissingDbgClientRu = 'купец'
    elseif $HallMissingDbgClient = 'noble':
        $HallMissingDbgClientRu = 'дворянин'
    elseif $HallMissingDbgClient = 'drunk_guest' or $HallMissingDbgClient = 'drunk':
        $HallMissingDbgClientRu = 'пьяный гость (отказ)'
    else
        $HallMissingDbgClientRu = $HallMissingDbgClient
    end

    $ph = LCASE($HallMissingPhase[$g])
    if $ph = 'soft_intro':
        $HallMissingDbgPhaseRu = 'мягкое знакомство'
    elseif $ph = 'soft_play':
        $HallMissingDbgPhaseRu = 'мягкая игра'
    elseif $ph = 'hard':
        $HallMissingDbgPhaseRu = 'жёсткая лесенка'
    elseif $ph = 'free':
        $HallMissingDbgPhaseRu = 'свободный повтор'
    else
        $HallMissingDbgPhaseRu = $ph
    end

    if $g = 'sandra':
        if HallMissingDbgHardSub = 1:
            $HallMissingDbgHardRu = '1 — проглотить'
        elseif HallMissingDbgHardSub = 2:
            $HallMissingDbgHardRu = '2 — показать во рту'
        elseif HallMissingDbgHardSub = 3:
            $HallMissingDbgHardRu = '3 — на лицо'
        elseif HallMissingDbgHardSub = 4:
            $HallMissingDbgHardRu = '4 — горло, кончает в рот'
        elseif HallMissingDbgHardSub = 5:
            $HallMissingDbgHardRu = '5 — горло, кончает в горло'
        else
            $HallMissingDbgHardRu = '0 — минет, кончает в рот'
        end
    else
        if HallMissingDbgHardStep = 1:
            $HallMissingDbgHardRu = '1 — рот'
        elseif HallMissingDbgHardStep = 2:
            $HallMissingDbgHardRu = '2 — после рта'
        elseif HallMissingDbgHardStep = 3:
            $HallMissingDbgHardRu = '3 — на лицо'
        elseif HallMissingDbgHardStep = 4:
            $HallMissingDbgHardRu = '4 — горло'
        else
            $HallMissingDbgHardRu = '0 — бедро / копилка'
        end
        $HallMissingDbgHardRu = $HallMissingDbgHardRu + ' · подшаг ' + STR(HallMissingDbgHardSub)
    end

    $pf = LCASE($HallMissingPromiseForce)
    if $pf = '':
        $HallMissingDbgForceRu = 'нет (как выпадет)'
    elseif $pf = 'look_tits':
        $HallMissingDbgForceRu = 'смотреть на грудь'
    elseif $pf = 'hug_waist':
        $HallMissingDbgForceRu = 'обнять / талия'
    elseif $pf = 'touch_cock':
        $HallMissingDbgForceRu = 'ладонь сквозь ткань'
    elseif $pf = 'mouth_hard':
        $HallMissingDbgForceRu = 'рот / минет'
    elseif $pf = 'facial':
        $HallMissingDbgForceRu = 'на лицо'
    elseif $pf = 'deepthroat':
        $HallMissingDbgForceRu = 'горло'
    elseif $pf = 'titjob':
        $HallMissingDbgForceRu = 'грудью'
    elseif $pf = 'hand_quick':
        $HallMissingDbgForceRu = 'рукой'
    elseif $pf = 'noble':
        $HallMissingDbgForceRu = 'дворянин'
    else
        $HallMissingDbgForceRu = $HallMissingPromiseForce
    end

    killvar '$g'
    killvar '$ph'
    killvar '$pf'
---

! ARGS[0]=girl|client|phase  ARGS[1]=значение
#HallMissingDebugActMark

    $HallMissingDbgMark = '    '
    if $ARGS[0] = 'girl' and $HallMissingDbgGirl = $ARGS[1]:
        $HallMissingDbgMark = '●  '
    elseif $ARGS[0] = 'client' and $HallMissingDbgClient = $ARGS[1]:
        $HallMissingDbgMark = '●  '
    elseif $ARGS[0] = 'phase' and $HallMissingPhase[$HallMissingDbgGirl] = $ARGS[1]:
        $HallMissingDbgMark = '●  '
    end
---

#HallMissingDebugStatusLine

    gs 'HallMissingDebugFillLabels'
    $g = $HallMissingDbgGirl
    *pl 'СЕЙЧАС'
    *pl '  Девушка:     ' + $HallMissingDbgGirlRu + '  (' + $HallMissingDbgPlaceRu + ')'
    *pl '  Гость:       ' + $HallMissingDbgClientRu
    *pl '  Этап:        ' + $HallMissingDbgPhaseRu
    *pl '  Знакомство:  шаг ' + STR(HallMissingSoftIntroStep[$g]) + '   игра ' + STR(HallMissingSoftPlayCount[$g]) + '/' + STR(HallMissingSoftPlayNeed)
    *pl '  Лесенка:     ' + $HallMissingDbgHardRu
    if HallMissingHardLadderDone[$g] = 1:
        *pl '  Лесенка рта: пройдена'
    else
        *pl '  Лесенка рта: ещё идёт'
    end
    if HallMissingFlagFaceDone[$g] = 1:
        $HallMissingDbgFaceRu = 'да'
    else
        $HallMissingDbgFaceRu = 'нет'
    end
    if HallMissingFlagMouthMature[$g] = 1:
        $HallMissingDbgMatureRu = 'да'
    else
        $HallMissingDbgMatureRu = 'нет'
    end
    *pl '  На лицо:     ' + $HallMissingDbgFaceRu + '     зрелый рот: ' + $HallMissingDbgMatureRu
    if $g <> 'sandra':
        *pl '  Дворянин:    ярус ' + STR(HallMissingNobleTier[$g])
    end
    *pl '  Принудить:   ' + $HallMissingDbgForceRu
    *pl ' '
    *pl 'КАК ПОЛЬЗОВАТЬСЯ'
    *pl '  1) девушка и гость   2) этап   3) прогнать с уговором'
    *pl '  Каталог сцен — только текст Scene+встреча, без сдвига лесенки.'
    killvar '$g'
    killvar '$HallMissingDbgFaceRu'
    killvar '$HallMissingDbgMatureRu'
---

#HallMissingDebugMenu

    *clr
    clr
    cla
    gs 'SceneShowVisual', 'images/debug/debug_hall_missing/hall_missing_debug_menu', 'ОТЛАДКА: ПРОПАЖА С ГОСТЕМ', 'large', 'webp'
    gs 'HallMissingDebugEnsure'

    *pl '══════════════════════════════════════════════'
    *pl ' ОТЛАДКА: ПРОПАЖА С ГОСТЕМ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'HallMissingDebugStatusLine'
    *pl ' '

    *pl '── 1. ДЕВУШКА ──'
    gs 'HallMissingDebugActMark', 'girl', 'amanda'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Аманда  (подсобка)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingDbgGirl = 'amanda'
        gt 'HallMissingDebugMenu'
    end
    gs 'HallMissingDebugActMark', 'girl', 'melissa'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Мелисса  (подсобка)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingDbgGirl = 'melissa'
        gt 'HallMissingDebugMenu'
    end
    gs 'HallMissingDebugActMark', 'girl', 'sandra'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Сандра  (кухня)', 'kitchen'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingDbgGirl = 'sandra'
        gt 'HallMissingDebugMenu'
    end

    *pl ' '
    *pl '── 2. ГОСТЬ ──'
    gs 'HallMissingDebugActMark', 'client', 'traveler'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Моряк  (большой, любит руку)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingDbgClient = 'traveler'
        gt 'HallMissingDebugMenu'
    end
    gs 'HallMissingDebugActMark', 'client', 'craftsman'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Мастеровой  (на лицо, обильно)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingDbgClient = 'craftsman'
        gt 'HallMissingDebugMenu'
    end
    gs 'HallMissingDebugActMark', 'client', 'rich_merchant'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Купец  (толстый, любит рот)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingDbgClient = 'rich_merchant'
        gt 'HallMissingDebugMenu'
    end
    gs 'HallMissingDebugActMark', 'client', 'drunk_guest'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Пьяный  (уговор срывается)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingDbgClient = 'drunk_guest'
        gt 'HallMissingDebugMenu'
    end
    if $HallMissingDbgGirl <> 'sandra':
        gs 'HallMissingDebugActMark', 'client', 'noble'
        gs 'ActUiPrepare', $HallMissingDbgMark + 'Дворянин', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            $HallMissingDbgClient = 'noble'
            gt 'HallMissingDebugMenu'
        end
    end

    *pl ' '
    *pl '── 3. ЭТАП ЛЕСЕНКИ ──'
    gs 'HallMissingDebugActMark', 'phase', 'soft_intro'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Мягкое знакомство', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingPhaseDebugSet', $HallMissingDbgGirl, 'soft_intro'
        gt 'HallMissingDebugMenu'
    end
    gs 'HallMissingDebugActMark', 'phase', 'soft_play'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Мягкая игра', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingPhaseDebugSet', $HallMissingDbgGirl, 'soft_play'
        gt 'HallMissingDebugMenu'
    end
    gs 'HallMissingDebugActMark', 'phase', 'hard'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Жёсткая лесенка  (с нуля)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingPhaseDebugSet', $HallMissingDbgGirl, 'hard'
        HallMissingDbgHardStep = 0
        HallMissingDbgHardSub = 0
        gt 'HallMissingDebugMenu'
    end
    gs 'HallMissingDebugActMark', 'phase', 'free'
    gs 'ActUiPrepare', $HallMissingDbgMark + 'Свободный повтор  (зрелый рот)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingPhaseDebugSet', $HallMissingDbgGirl, 'free'
        gt 'HallMissingDebugMenu'
    end
    gs 'ActUiPrepare', 'Сбросить лесенку этой девушки', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingPhaseResetOne', $HallMissingDbgGirl
        HallMissingDbgHardStep = 0
        HallMissingDbgHardSub = 0
        $HallMissingPromiseForce = ''
        gt 'HallMissingDebugMenu'
    end
    gs 'ActUiPrepare', 'Сбросить лесенку всех троих', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingPhaseReset', ''
        HallMissingDbgHardStep = 0
        HallMissingDbgHardSub = 0
        $HallMissingPromiseForce = ''
        gt 'HallMissingDebugMenu'
    end

    *pl ' '
    *pl '── 4. ШАГ РТА  (перед прогоном) ──'
    if $HallMissingDbgGirl = 'sandra':
        *pl 'Сандра: 0 минет → 1 проглотить → 2 показать → 3 лицо → 4 горло+рот → 5 горло'
        gs 'ActUiPrepare', 'Шаг 0 — минет, в рот', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingDebugSetHard', 'sandra', 0, 0
            gt 'HallMissingDebugMenu'
        end
        gs 'ActUiPrepare', 'Шаг 1 — проглотить', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingDebugSetHard', 'sandra', 0, 1
            gt 'HallMissingDebugMenu'
        end
        gs 'ActUiPrepare', 'Шаг 2 — показать во рту', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingDebugSetHard', 'sandra', 0, 2
            gt 'HallMissingDebugMenu'
        end
        gs 'ActUiPrepare', 'Шаг 3 — на лицо', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingDebugSetHard', 'sandra', 0, 3
            gt 'HallMissingDebugMenu'
        end
        gs 'ActUiPrepare', 'Шаг 4 — горло, кончает в рот', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingDebugSetHard', 'sandra', 0, 4
            gt 'HallMissingDebugMenu'
        end
        gs 'ActUiPrepare', 'Шаг 5 — горло, кончает в горло', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingDebugSetHard', 'sandra', 0, 5
            gt 'HallMissingDebugMenu'
        end
    else
        *pl 'Сёстры: 0 бедро → 1 рот → 3 лицо → 4 горло. «Следующий подшаг» крутит внутри слота.'
        gs 'ActUiPrepare', 'Слот 0 — бедро / копилка', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingDebugSetHard', $HallMissingDbgGirl, 0, 0
            gt 'HallMissingDebugMenu'
        end
        gs 'ActUiPrepare', 'Слот 1 — рот', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingDebugSetHard', $HallMissingDbgGirl, 1, 0
            gt 'HallMissingDebugMenu'
        end
        gs 'ActUiPrepare', 'Слот 3 — на лицо', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingDebugSetHard', $HallMissingDbgGirl, 3, 0
            gt 'HallMissingDebugMenu'
        end
        gs 'ActUiPrepare', 'Слот 4 — горло', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gs 'HallMissingDebugSetHard', $HallMissingDbgGirl, 4, 0
            gt 'HallMissingDebugMenu'
        end
        gs 'ActUiPrepare', 'Следующий подшаг в этом слоте', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            HallMissingDbgHardSub += 1
            if HallMissingDbgHardSub > 5:
                HallMissingDbgHardSub = 0
            end
            gs 'HallMissingDebugSetHard', $HallMissingDbgGirl, HallMissingDbgHardStep, HallMissingDbgHardSub
            gt 'HallMissingDebugMenu'
        end
    end

    *pl ' '
    *pl '── 5. ПРИНУДИТЬ УСЛУГУ  (необязательно) ──'
    *pl 'Пусто — игра сама выберет. Сбросится после выбора уговора.'
    gs 'ActUiPrepare', 'Смотреть на грудь', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingPromiseForce = 'look_tits'
        gt 'HallMissingDebugMenu'
    end
    gs 'ActUiPrepare', 'Обнять / талия', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingPromiseForce = 'hug_waist'
        gt 'HallMissingDebugMenu'
    end
    gs 'ActUiPrepare', 'Ладонь сквозь ткань', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingPromiseForce = 'touch_cock'
        gt 'HallMissingDebugMenu'
    end
    gs 'ActUiPrepare', 'Рот / минет', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingPromiseForce = 'mouth_hard'
        gt 'HallMissingDebugMenu'
    end
    gs 'ActUiPrepare', 'На лицо', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingPromiseForce = 'facial'
        gt 'HallMissingDebugMenu'
    end
    gs 'ActUiPrepare', 'Горло', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingPromiseForce = 'deepthroat'
        gt 'HallMissingDebugMenu'
    end
    if $HallMissingDbgGirl = 'sandra':
        gs 'ActUiPrepare', 'Грудью', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            $HallMissingPromiseForce = 'titjob'
            gt 'HallMissingDebugMenu'
        end
    else
        gs 'ActUiPrepare', 'Рукой', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            $HallMissingPromiseForce = 'hand_quick'
            gt 'HallMissingDebugMenu'
        end
    end
    if $HallMissingDbgGirl <> 'sandra':
        gs 'ActUiPrepare', 'Дворянин (и гость тоже)', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            $HallMissingPromiseForce = 'noble'
            $HallMissingDbgClient = 'noble'
            gt 'HallMissingDebugMenu'
        end
    end
    gs 'ActUiPrepare', 'Не принуждать', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $HallMissingPromiseForce = ''
        gt 'HallMissingDebugMenu'
    end

    *pl ' '
    *pl '── КУХНЯ САНДРЫ  (из зала, как у Аманды) ──'
    *pl 'Подслушано: Аманда ' + STR(PlayCoached['amanda']) + '  Мелисса ' + STR(PlayCoached['melissa']) + '  Сандра ' + STR(PlayCoached['sandra'])
    if LOC('SandraKitchenDebugStart') = 1:
        gs 'ActUiPrepare', 'Кухня: приставание  (без подслушки Сандры)', 'kitchen'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraKitchenDebugStart', 'harass', 'craftsman'
        end
        gs 'ActUiPrepare', 'Кухня: подыгрыш  (нужна подслушка a→м→с)', 'kitchen'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraKitchenDebugStart', 'play', 'craftsman'
        end
        gs 'ActUiPrepare', 'Кухня: подыгрыш → пропажа  (смотреть)', 'kitchen'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraKitchenDebugStart', 'play_missing', 'craftsman'
        end
        gs 'ActUiPrepare', 'Кухня: подыгрыш с купцом', 'kitchen'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraKitchenDebugStart', 'play', 'rich_merchant'
        end
        gs 'ActUiPrepare', 'Кухня: до ужина  (только Защитить)', 'kitchen'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraKitchenDebugStart', 'protect_only', 'craftsman'
        end
        gs 'ActUiPrepare', 'Кухня: пьяный  (отказ)', 'kitchen'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraKitchenDebugStart', 'harass', 'drunk_guest'
        end
        gs 'ActUiPrepare', 'Подслушать Аманду  (открыть цепочку)', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'HallPlayCoachStart', 'amanda', 'HallMissingDebugMenu'
        end
        gs 'ActUiPrepare', 'Сбросить лимиты кухни Сандры', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            SandraKitchenHookLastDay = 0
            SandraKitchenHookLastTime = 0
            KitchenHarassmentDay = 0
            KitchenHarassmentTime = 0
            HallMissingGirlLastDay['sandra'] = 0
            PlayCoached['sandra'] = 0
            SandraKitchenForceMissing = 0
            gt 'HallMissingDebugMenu'
        end
    end

    *pl ' '
    *pl '── ПРОГОН ──'
    *pl 'Уговор (один экран) → пропажа → меню выбора → возврат сюда.'
    gs 'ActUiPrepare', 'Прогнать с уговором  (как сейчас)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingDebugRunFull'
    end
    gs 'ActUiPrepare', 'Знакомство, шаг 0 — и прогнать', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingPhaseDebugSet', $HallMissingDbgGirl, 'soft_intro'
        HallMissingSoftIntroStep[$HallMissingDbgGirl] = 0
        $HallMissingPromiseForce = ''
        gt 'HallMissingDebugRunFull'
    end
    gs 'ActUiPrepare', 'Знакомство, шаг 1 (обнять) — и прогнать', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingPhaseDebugSet', $HallMissingDbgGirl, 'soft_intro'
        HallMissingSoftIntroStep[$HallMissingDbgGirl] = 1
        $HallMissingPromiseForce = ''
        gt 'HallMissingDebugRunFull'
    end
    gs 'ActUiPrepare', 'Знакомство, шаг 2 (ладонь) — и прогнать', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingPhaseDebugSet', $HallMissingDbgGirl, 'soft_intro'
        HallMissingSoftIntroStep[$HallMissingDbgGirl] = 2
        $HallMissingPromiseForce = ''
        gt 'HallMissingDebugRunFull'
    end
    gs 'ActUiPrepare', 'Жёсткая лесенка, текущий шаг — и прогнать', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingDebugSetHard', $HallMissingDbgGirl, HallMissingDbgHardStep, HallMissingDbgHardSub
        $HallMissingPromiseForce = ''
        gt 'HallMissingDebugRunFull'
    end
    gs 'ActUiPrepare', 'Свободный повтор — и прогнать', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'HallMissingPhaseDebugSet', $HallMissingDbgGirl, 'free'
        $HallMissingPromiseForce = ''
        gt 'HallMissingDebugRunFull'
    end
    gs 'ActUiPrepare', 'Сразу пропажа  (без экрана уговора)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingDebugRunSkipBargain'
    end

    *pl ' '
    *pl '── КАТАЛОГ СЦЕН  (только текст, лесенка не двигается) ──'
    gs 'ActUiPrepare', 'Мягкие сцены…', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingDebugPreviewSoftMenu'
    end
    gs 'ActUiPrepare', 'Рот / жёсткая лесенка…', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingDebugPreviewHardMenu'
    end
    gs 'ActUiPrepare', 'Финал, вход, срыв…', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingDebugPreviewTermMenu'
    end

    *pl ' '
    gs 'ActUiPrepare', 'К событиям трактира', 'return'
    act $ActUiLabel, $ActUiIconPath:
        if LOC('TavernEventDispatcherDebugMenu') = 1:
            gt 'TavernEventDispatcherDebugMenu'
        else
            gt 'TavernMain'
        end
    end
    gs 'ActUiPrepare', 'В зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

! ARGS[0]=girl ARGS[1]=hardStep ARGS[2]=hardSub
#HallMissingDebugSetHard

    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $g = $HallMissingGirlKey
    if $g = '':
        $g = $HallMissingDbgGirl
    end
    HallMissingDbgHardStep = $ARGS[1]
    HallMissingDbgHardSub = $ARGS[2]
    if HallMissingDbgHardStep < 0:
        HallMissingDbgHardStep = 0
    end
    if HallMissingDbgHardSub < 0:
        HallMissingDbgHardSub = 0
    end
    gs 'HallMissingPhaseDebugSet', $g, 'hard'
    HallMissingHardStep[$g] = HallMissingDbgHardStep
    HallMissingHardSub[$g] = HallMissingDbgHardSub
    HallMissingHardLadderDone[$g] = 0
    $HallMissingPhase[$g] = 'hard'
    if $g = 'sandra' and HallMissingDbgHardSub >= 2:
        HallMissingFlagMouthMature['sandra'] = 1
    end
    killvar '$g'
---

#HallMissingDebugRunFull

    gs 'HallMissingDebugEnsure'
    gs 'HallMissingDebugPrepGirl', $HallMissingDbgGirl
    $HallMissingGirl = $HallMissingDbgGirl
    $HallHarassGirl = $HallMissingDbgGirl
    $HallHarassClient = $HallMissingDbgClient
    $HallMissingClient = $HallMissingDbgClient
    $HallMissingReturnLoc = 'HallMissingDebugMenu'
    HallMissingBargainSkip = 0
    HallMissingBargainDone = 0
    HallMissingFromPlay = 1
    $HallHarassStanceCanon = 'play'
    $HarassGirlStance = 'provoke'
    HarassTier = 3
    HallHarassType = 4
    if LOC('HallMissingApplyClientFlavorTags') = 1:
        gs 'HallMissingApplyClientFlavorTags'
    end
    if LOC('HallMissingPhaseEnsure') = 1:
        gs 'HallMissingPhaseEnsure', $HallMissingDbgGirl
    end
    ! если в hard — применить dbg step/sub
    if $HallMissingPhase[$HallMissingDbgGirl] = 'hard':
        HallMissingHardStep[$HallMissingDbgGirl] = HallMissingDbgHardStep
        HallMissingHardSub[$HallMissingDbgGirl] = HallMissingDbgHardSub
    end
    gt 'HallMissingBargainStart', $HallMissingDbgGirl, 'HallMissingDebugMenu'
---

#HallMissingDebugRunSkipBargain

    gs 'HallMissingDebugEnsure'
    gs 'HallMissingDebugPrepGirl', $HallMissingDbgGirl
    $HallMissingGirl = $HallMissingDbgGirl
    $HallHarassGirl = $HallMissingDbgGirl
    $HallHarassClient = $HallMissingDbgClient
    $HallMissingClient = $HallMissingDbgClient
    HallMissingBargainSkip = 1
    HallMissingBargainDone = 0
    HallMissingFromPlay = 1
    if LOC('HallMissingApplyClientFlavorTags') = 1:
        gs 'HallMissingApplyClientFlavorTags'
    end
    if $HallMissingPhase[$HallMissingDbgGirl] = 'hard':
        HallMissingHardStep[$HallMissingDbgGirl] = HallMissingDbgHardStep
        HallMissingHardSub[$HallMissingDbgGirl] = HallMissingDbgHardSub
    end
    if $HallMissingPromiseForce <> '':
        $HallMissingPromise = LCASE($HallMissingPromiseForce)
        $HallMissingPromiseForce = ''
        HallMissingBargainDone = 1
        if LOC('HallMissingApplyPromiseToAct') = 1:
            gs 'HallMissingApplyPromiseToAct'
        end
        HallMissingBargainSkip = 1
        gt 'HallMissingGirlStartFromPlay', $HallMissingDbgGirl, 'HallMissingDebugMenu'
    end
    gt 'HallMissingGirlStartFromPlay', $HallMissingDbgGirl, 'HallMissingDebugMenu'
---

! ARGS[0]=act  ARGS[1]=finish(optional)  ARGS[2]=promise(optional)
#HallMissingDebugPreview

    *clr
    clr
    cla
    gs 'SceneShowVisual', 'images/debug/debug_hall_missing/hall_missing_debug_preview', 'ПРОСМОТР СЦЕНЫ', 'large', 'webp'
    gs 'HallMissingDebugEnsure'
    gs 'HallMissingDebugPrepGirl', $HallMissingDbgGirl

    $HallMissingGirl = $HallMissingDbgGirl
    $HallMissingClient = $HallMissingDbgClient
    $HallMissingPrivateAct = LCASE($ARGS[0])
    $HallMissingFinish = LCASE($ARGS[1])
    $HallMissingPromise = LCASE($ARGS[2])
    if $HallMissingPrivateAct = '':
        $HallMissingPrivateAct = 'look_tits'
    end
    HallMissingPromiseBreak = 0
    HallMissingCuniToAnilingus = 0
    if $HallMissingPrivateAct = 'anilingus' and $HallMissingDbgGirl <> 'sandra':
        HallMissingCuniToAnilingus = 1
        HallMissingBargainExplicit = 1
        $HallMissingInitiative = 'high'
    elseif $HallMissingPrivateAct = 'anilingus' and $HallMissingDbgGirl = 'sandra':
        $HallMissingPrivateAct = 'cuni'
    end
    HallMissingSilverExtra = 0
    $HallMissingSceneKey = ''
    $HallMissingPlace = 'storage'
    if $HallMissingDbgGirl = 'sandra':
        $HallMissingPlace = 'kitchen'
    end

    if LOC('HallMissingApplyClientFlavorTags') = 1:
        gs 'HallMissingApplyClientFlavorTags'
    end
    $HallLewdClient = $HallMissingClient
    if LOC('HallLewdFillClientBits') = 1:
        gs 'HallLewdFillClientBits'
    else
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
    end

    gs 'HallMissingResolveSceneKey'

    gs 'HallMissingDebugFillLabels'
    *pl '══════════════════════════════════════════════'
    *pl ' ПРОСМОТР СЦЕНЫ'
    *pl '══════════════════════════════════════════════'
    *pl '  ' + $HallMissingDbgGirlRu + '  ·  ' + $HallMissingDbgClientRu + '  ·  ' + $HallMissingDbgPlaceRu
    *pl '  действие: ' + $HallMissingPrivateAct
    if $HallMissingFinish <> '':
        *pl '  финал:    ' + $HallMissingFinish
    end
    if $HallMissingPromise <> '':
        *pl '  уговор:   ' + $HallMissingPromise
    end
    *pl '  ключ:     ' + $HallMissingSceneKey
    if HallMissingClientCumHeavy = 1:
        *pl '  обильно:  да'
    end
    *pl ' '
    *pl '── СЦЕНА ──'
    *pl ' '
    gs 'HallMissingPrintPeekScene'
    *pl ' '
    *pl '── ВСТРЕЧА ──'
    *pl ' '
    gs 'HallMissingPrintPeekMeet'
    *pl ' '

    gs 'ActUiPrepare', 'Ещё раз ту же сцену', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingDebugPreview', $HallMissingPrivateAct, $HallMissingFinish, $HallMissingPromise
    end
    gs 'ActUiPrepare', 'К мягким сценам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingDebugPreviewSoftMenu'
    end
    gs 'ActUiPrepare', 'В меню отладки пропажи', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingDebugMenu'
    end
