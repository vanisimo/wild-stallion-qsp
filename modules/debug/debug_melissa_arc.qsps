! ================================================
! FILE: modules/debug/debug_melissa_arc.qsps
! MODULE: debug
! [AI-WORKED] 20.09.2026
! Отдельная debug-панель арки Мелиссы (акт 1)
! Охватывает: домашнюю лестницу, танцы, менестреля
! (встречи в повозке 1-4, закулисье, гонка 6-й пт),
! домашний анал, кинки, групповые сцены, социальные статы
! ================================================

#DebugMelissaArcPanel
    if debug = 0:
        exit
    end

    gs 'PanelDebugToolsHeader'

    pl '<b>DEBUG: МЕЛИССА — СЮЖЕТНАЯ И INTIMACY-АРКА</b>'
    pl ' '

    gs 'DebugMelissaPrintContext'
    pl ' '

    gs 'DebugMelissaPrintHomeArc'
    pl ' '

    gs 'DebugMelissaPrintDanceBlock'
    pl ' '

    gs 'DebugMelissaPrintMinstrelBlock'
    pl ' '

    gs 'DebugMelissaPrintMinstrelEncountersBlock'
    pl ' '

    gs 'DebugMelissaPrintAnalAndKinksBlock'
    pl ' '

    gs 'DebugMelissaPrintSocialBlock'
    pl ' '

    gs 'DebugMelissaPrintNextHint'
    pl ' '

    gs 'DebugMelissaPrintPresets'
    pl ' '

    pl '<a href="exec:gs ''DebugMelissaArcReset'' & gs ''DebugMelissaArcPanel''">🔄 Полный сброс всех флагов Мелиссы</a>'
    pl ' '
    pl '<a href="exec:gs ''DebugAmandaArcPanel''">→ Аманда (интим-панель)</a>'
    pl '<a href="exec:gs ''DebugIntimacyArcPanel''">← Intimacy-арки (все персонажи)</a>'
    pl '<a href="exec:gs ''PanelDebugToolsMain''">← Главная debug-панель</a>'
    pl ' '
---

#DebugMelissaPrintContext
    gs 'GetCitySchedulePhase'

    pl '<b>Контекст</b>'
    pl 'День: ' + STR(day) + ' | неделя: ' + STR(week) + ' | время: ' + STR(time) + ' (' + $CitySchedulePhase + ')'
    pl 'Локация Мелиссы: ' + $GirlLocation['melissa']

    gs 'MelissaHomeCanAdvance'
    if MelissaHomeCanAdvance = 1:
        pl 'Домашняя лестница сегодня: <font color="#008000"><b>можно</b></font>'
    else:
        pl 'Домашняя лестница сегодня: <font color="#888888">нельзя</font>'
    end

    if MelissaHomeUnlocked = 1 and MelissaHomeStage >= 6 and MelissaHomeSex = 0 and MelissaHomeStepToday = 0 and time >= 3:
        pl 'Первая близость (дефлорация) сегодня: <font color="#008000"><b>можно</b></font>'
    else:
        pl 'Первая близость (дефлорация) сегодня: <font color="#888888">нельзя</font>'
    end

    if LOC('MelissaHomeAnalCanStart') = 1:
        gs 'MelissaHomeAnalCanStart'
        if MelissaHomeAnalStepAvailable = 1:
            pl 'Домашний анал сегодня: <font color="#008000"><b>доступен</b></font> («' + $MelissaHomeAnalMenuLabel + '»)'
        else:
            pl 'Домашний анал сегодня: <font color="#888888">недоступен</font>'
        end
        killvar 'MelissaHomeAnalStepAvailable'
        killvar '$MelissaHomeAnalMenuLabel'
        killvar '$MelissaHomeAnalMenuTarget'
    end

    if LOC('MelissaMinstrelWagonCanStart') = 1:
        gs 'MelissaMinstrelWagonCanStart'
        if MelissaMinstrelWagonCanStart = 1:
            pl 'Повозка менестреля: <font color="#008000"><b>можно зайти</b></font> (стадия ' + STR(MelissaMinstrelWagonStage) + ')'
        else:
            pl 'Повозка менестреля: <font color="#888888">закрыта / нельзя</font>'
        end
        killvar 'MelissaMinstrelWagonCanStart'
    end

    if LOC('MelissaMinstrelFridayRaceCanStart') = 1:
        gs 'MelissaMinstrelFridayRaceCanStart'
        if MelissaMinstrelFridayRaceCanStart = 1:
            pl 'Гонка 6-й пятницы (подворотня): <font color="#008000"><b>доступна</b></font>'
        else:
            pl 'Гонка 6-й пятницы: <font color="#888888">нет</font>'
        end
        killvar 'MelissaMinstrelFridayRaceCanStart'
    end

    pl 'Время: <a href="exec:time = 1 & gs ''DebugMelissaArcPanel''">утро (1)</a> | <a href="exec:time = 2 & gs ''DebugMelissaArcPanel''">день (2)</a> | <a href="exec:time = 3 & gs ''DebugMelissaArcPanel''">вечер (3)</a> | <a href="exec:time = 4 & gs ''DebugMelissaArcPanel''">поздний вечер (4)</a> | <a href="exec:time = 5 & gs ''DebugMelissaArcPanel''">ночь (5)</a>'
    pl 'Расписание: <a href="exec:week = 5 & time = 4 & gs ''DebugMelissaArcPanel''">пятница вечер (танцы)</a> | <a href="exec:week = 2 & time = 3 & gs ''DebugMelissaArcPanel''">вторник день (рынок)</a>'

    killvar '$CitySchedulePhase'
    killvar 'MelissaHomeCanAdvance'
---

#DebugMelissaHomeStageLabel
    $DebugMelissaStageLabel = 'неизвестно'
    DebugMelissaStageCode = MelissaHomeStage

    if MelissaHomeUnlocked = 0:
        $DebugMelissaStageLabel = 'дом закрыт'
    elseif MelissaHomeSex = 1:
        $DebugMelissaStageLabel = 'SexScene разблокирован (повторные вечера, ночей: ' + STR(MelissaHomeNightCount) + ')'
    elseif DebugMelissaStageCode = 0:
        $DebugMelissaStageLabel = '0 — счета и травяной чай (объятия)'
    elseif DebugMelissaStageCode = 1:
        $DebugMelissaStageLabel = '1 — роман «Королева Элеонора» и первый поцелуй'
    elseif DebugMelissaStageCode = 2:
        $DebugMelissaStageLabel = '2 — снятие доспехов у ночного окна'
    elseif DebugMelissaStageCode = 3:
        $DebugMelissaStageLabel = '3 — анатомический интерес и ласка рукой'
    elseif DebugMelissaStageCode = 4:
        $DebugMelissaStageLabel = '4 — власть Королевы: услада губ (минет)'
    elseif DebugMelissaStageCode = 5:
        $DebugMelissaStageLabel = '5 — падение крепости: ласка лона (куни)'
    elseif DebugMelissaStageCode = 6:
        $DebugMelissaStageLabel = '6 — решительный разговор перед дефлорацией'
    elseif DebugMelissaStageCode >= 7:
        $DebugMelissaStageLabel = STR(DebugMelissaStageCode) + ' — финал арки дефлорации'
    end

    killvar 'DebugMelissaStageCode'
---

#DebugMelissaPrintHomeArc
    gs 'DebugMelissaHomeStageLabel'

    pl '<b>Домашняя цепочка (Player-Path)</b>'
    pl 'Стадия: <b>' + $DebugMelissaStageLabel + '</b>'
    killvar '$DebugMelissaStageLabel'

    gs 'DebugMelissaPrintBool', 'Дом открыт (MelissaHomeUnlocked)', MelissaHomeUnlocked
    gs 'DebugMelissaPrintBool', 'Секс разблокирован (MelissaHomeSex)', MelissaHomeSex
    gs 'DebugMelissaPrintBool', 'Шаг сделан сегодня (MelissaHomeStepToday)', MelissaHomeStepToday
    gs 'DebugMelissaPrintBool', 'Первая ночь активна (MelissaHomeFirstSexActive)', MelissaHomeFirstSexActive
    pl 'Проведено совместных ночей: ' + STR(MelissaHomeNightCount)
    pl 'Шкала верности игроку (MelissaPlayerPath): ' + STR(MelissaPlayerPath)
    gs 'DebugMelissaPrintBool', 'Девственность (virginity)', virginity['melissa']
    gs 'DebugMelissaPrintBool', 'Вагинал с ГГ (HadVaginalWithPlayer)', HadVaginalWithPlayer['melissa']

    pl 'Быстрый переход на стадию: '
    pl '  <a href="exec:gs ''DebugMelissaJumpHome'', 0 & gt ''MelissaRoom''">stage 0 (чай)</a> | <a href="exec:gs ''DebugMelissaJumpHome'', 1 & gt ''MelissaRoom''">stage 1 (поцелуй)</a> | <a href="exec:gs ''DebugMelissaJumpHome'', 2 & gt ''MelissaRoom''">stage 2 (окно)</a> | <a href="exec:gs ''DebugMelissaJumpHome'', 3 & gt ''MelissaRoom''">stage 3 (рука)</a>'
    pl '  <a href="exec:gs ''DebugMelissaJumpHome'', 4 & gt ''MelissaRoom''">stage 4 (минет)</a> | <a href="exec:gs ''DebugMelissaJumpHome'', 5 & gt ''MelissaRoom''">stage 5 (куни)</a> | <a href="exec:gs ''DebugMelissaJumpHome'', 6 & gt ''MelissaRoom''">stage 6 (разговор)</a>'
    pl '  ⚡ <a href="exec:gs ''DebugMelissaJumpHome'', 6 & gt ''MelissaHomeFirstSexLaunch''">Прямой запуск первой ночи (MelissaHomeFirstSexLaunch)</a>'
    pl '  ⚡ <a href="exec:gs ''DebugMelissaJumpHomeRepeat'' & gt ''MelissaRoom''">SexScene: повторный вечер в комнате (time=4)</a>'
---

#DebugMelissaPrintDanceBlock
    pl '<b>Танцы и нарядное платье</b>'
    gs 'DebugMelissaPrintBool', 'Платье готово (MelissaDanceDressReady)', MelissaDanceDressReady
    gs 'DebugMelissaPrintBool', 'Купил игрок (MelissaDanceDressPlayerBought)', MelissaDanceDressPlayerBought
    gs 'DebugMelissaPrintBool', 'Купила сама (MelissaDanceDressSelfBought)', MelissaDanceDressSelfBought
    gs 'DebugMelissaPrintBool', 'Была на танцах (MelissaFridayDanceAttended)', MelissaFridayDanceAttended
    pl 'Счётчик танцев Мелиссы: ' + STR(MelissaFridayDanceCount) + ' | общих танцев: ' + STR(FridayDancesCount)
    gs 'DebugMelissaPrintBool', 'Парадный костюм Стефана', StefanRespectableSuit

    pl 'Прогресс в танце: stage ' + STR(MelissaDanceStage) + ' | талия ' + STR(MelissaDanceWaist) + ' | поцелуй ' + STR(MelissaDanceKiss) + ' | шея ' + STR(MelissaDanceNeck) + ' | подворотня ' + STR(MelissaDanceAlley) + ' | танец окончен ' + STR(MelissaDanceEnded)
    pl 'Подворотня у площади: stage ' + STR(MelissaAlleyStage) + ' | kiss ' + STR(MelissaAlleyKiss) + ' | close ' + STR(MelissaAlleyClose) + ' | риск ' + STR(MelissaAlleyRisk)

    pl 'Действия:'
    pl '  <a href="exec:MelissaDanceDressReady = 1 & MelissaDanceDressPlayerBought = 1 & gs ''DebugMelissaArcPanel''">Платье готово (купил Стефан)</a> | <a href="exec:MelissaDanceDressReady = 1 & MelissaDanceDressSelfBought = 1 & gs ''DebugMelissaArcPanel''">Платье готово (купила сама)</a>'
    pl '  ⚡ <a href="exec:week = 5 & time = 4 & MelissaDanceDressReady = 1 & StefanRespectableSuit = 1 & gt ''MarketDance''">Перейти на танцы (пятница вечер, костюм, MarketDance)</a>'
    pl '  ⚡ <a href="exec:week = 5 & time = 4 & MelissaDanceDressReady = 1 & gt ''MelissaDance''">Танец с Мелиссой (MelissaDance)</a>'
    pl '  ⚡ <a href="exec:gs ''DebugMelissaPresetDanceAlley'' & gt ''MelissaDanceAlleyEvent''">Подворотня с Мелиссой (MelissaDanceAlleyEvent)</a>'
---

#DebugMelissaPrintMinstrelBlock
    pl '<b>Менестрель (' + $MelissaMinstrelName + ') — знакомство, роман и выбор пути</b>'
    gs 'DebugMelissaPrintBool', 'Знакомство состоялось (MelissaMinstrelMet)', MelissaMinstrelMet
    gs 'DebugMelissaPrintBool', 'Поцелуй готов (MelissaMinstrelKissReady)', MelissaMinstrelKissReady
    gs 'DebugMelissaPrintBool', 'Поцелуй после танца был (MelissaMinstrelKissDone)', MelissaMinstrelKissDone
    pl 'Стадия романа с менестрелем (MelissaMinstrelAffairStage): ' + STR(MelissaMinstrelAffairStage) + ' / 3'
    pl 'Интерес к менестрелю (MelissaMusicianInterest): ' + STR(MelissaMusicianInterest)

    pl 'Сцена в трактире: offer ' + STR(MelissaMusicStageOfferDone) + ' | Драупнир сцена ' + STR(TavernUpgradeStageDone)
    pl 'Пропажа в зале (HallMissing): done ' + STR(MelissaMinstrelHallMissingDone) + ' | result ' + STR(MelissaMinstrelHallMissingResult) + ' (1=search, 2=spy, 3=wait)'
    pl 'Выбор пути (PathChoice): ready ' + STR(MelissaFirstPathChoiceReady) + ' | done ' + STR(MelissaFirstPathChoiceDone) + ' | выбор ' + STR(MelissaFirstPathChoice) + ' (1=добиваться, 2=запретить, 3=следить)'
    gs 'DebugMelissaPrintBool', 'Запрет встреч со стороны ГГ', MelissaProhibitMinstrel
    pl 'Дней запрета: ' + STR(MelissaProhibitDays) + ' | Слежка Стефана: ' + STR(MelissaWatchMinstrel)

    pl 'Действия:'
    pl '  ⚡ <a href="exec:week = 5 & time = 4 & MelissaDanceDressReady = 1 & MelissaFridayDanceAttended = 1 & MelissaMinstrelMet = 0 & gt ''MelissaMinstrelMeetStart''">Знакомство на танцах (MelissaMinstrelMeetStart)</a>'
    pl '  ⚡ <a href="exec:week = 5 & time = 4 & MelissaMinstrelMet = 1 & MelissaMinstrelKissReady = 1 & MelissaMusicianInterest = 20 & gt ''MelissaMinstrelKissStart''">Поцелуй после танца (MelissaMinstrelKissStart)</a>'
    pl '  ⚡ <a href="exec:gt ''MelissaMusicStageTalk''">Разговор о сцене для музыкантов (MelissaMusicStageTalk)</a>'
    pl '  ⚡ <a href="exec:week = 5 & time = 3 & TavernUpgradeStageDone = 1 & MelissaMusicStageOfferDone = 1 & MelissaMinstrelKissDone = 1 & gt ''MelissaMinstrelHallMissingStart'', ''TavernMain''">Пропажа в зале трактира</a>'
    pl '  ⚡ <a href="exec:MelissaFirstPathChoiceReady = 1 & gt ''MelissaFirstPathChoiceStart'', ''TavernMain''">Выбор пути (MelissaFirstPathChoiceStart)</a>'
    pl '  ⚡ <a href="exec:MelissaMinstrelMet = 1 & gt ''MelissaProhibitMinstrelTalk''">Разговор о запрете встреч с менестрелем</a>'
---

#DebugMelissaPrintMinstrelEncountersBlock
    pl '<b>Встречи с менестрелем: повозка, закулисье и гонка 6-й пятницы</b>'
    pl 'Стадия повозки (MelissaMinstrelWagonStage): <b>' + STR(MelissaMinstrelWagonStage) + '</b> / 4 | сегодня: ' + STR(MelissaMinstrelWagonToday)
    gs 'DebugMelissaPrintBool', 'Первый секс с менестрелем (MelissaMinstrelFirstSexDone)', MelissaMinstrelFirstSexDone
    gs 'DebugMelissaPrintBool', 'Факт секса в переулке в пятницу', Fact_MelissaMinstrelFridayAlley
    gs 'DebugMelissaPrintBool', 'Факт секса в подсобке трактира', Fact_MelissaMinstrelBackroomSex

    pl 'Сцены в повозке:'
    pl '  ⚡ <a href="exec:gt ''MelissaMinstrelWagonScene1_1''">Повозка 1: стихи и упавшая лютня (срыв близости)</a>'
    pl '  ⚡ <a href="exec:gt ''MelissaMinstrelWagonScene2_1''">Повозка 2: игра на лютне, ласки сзади, оргазм Мелиссы</a>'
    pl '  ⚡ <a href="exec:gt ''MelissaMinstrelWagonScene3_1''">Повозка 3: флейта, урок дыхания (минет менестрелю)</a>'
    pl '  ⚡ <a href="exec:gt ''MelissaMinstrelWagonScene4_1''">Повозка 4: книга о музе, постель и первый секс</a>'
    pl '  ⚡ <a href="exec:MelissaMinstrelDanceTick = 0 & gt ''MelissaMinstrelDanceStageLook''">Помост менестрелей на танцах (наблюдение)</a>'
    pl '  ⚡ <a href="exec:week = 2 & time = 3 & gt ''MelissaMinstrelTuesdaySpot''">Вторник: Мелисса у повозки на рынке</a>'

    pl 'Закулисье у сцены (Backroom):'
    pl '  done ' + STR(MelissaMinstrelBackroomDone) + ' | result ' + STR(MelissaMinstrelBackroomResult) + ' | spark ' + STR(MelissaMinstrelBackroomSparkPending)
    pl '  ⚡ <a href="exec:gt ''MelissaMinstrelBackroomStart'', ''TavernMain''">Запустить закулисье у сцены (BackroomStart)</a>'

    pl 'Гонка 6-й пятницы (Alley Race):'
    pl '  window ' + STR(MelissaMinstrelRaceWindowOpen) + ' | done ' + STR(MelissaMinstrelFridayRaceDone) + ' | result ' + STR(MelissaMinstrelFridayRaceResult) + ' | spark ' + STR(MelissaMinstrelFridayRaceSparkPending)
    pl '  ⚡ <a href="exec:MelissaDanceDressReady = 1 & MelissaFridayDanceCount = 6 & week = 5 & time = 4 & day = 40 & gt ''MelissaMinstrelFridayRaceStart''">Запустить гонку 6-й пятницы (AlleyRaceStart)</a>'

    pl 'Флаги: <a href="exec:MelissaMinstrelWagonToday = 0 & gs ''DebugMelissaArcPanel''">сбросить WagonToday</a> | <a href="exec:MelissaMinstrelWagonStage = 0 & gs ''DebugMelissaArcPanel''">wagon=0</a> | <a href="exec:MelissaMinstrelWagonStage = 1 & gs ''DebugMelissaArcPanel''">wagon=1</a> | <a href="exec:MelissaMinstrelWagonStage = 2 & gs ''DebugMelissaArcPanel''">wagon=2</a> | <a href="exec:MelissaMinstrelWagonStage = 3 & gs ''DebugMelissaArcPanel''">wagon=3</a> | <a href="exec:MelissaMinstrelWagonStage = 4 & gs ''DebugMelissaArcPanel''">wagon=4</a>'
---

#DebugMelissaPrintAnalAndKinksBlock
    pl '<b>Домашний анал, кинки и групповые сцены</b>'
    pl 'Домашний анал — стадия: <b>' + STR(MelissaHomeAnalStage) + '</b> / 4 | сегодня: ' + STR(MelissaHomeAnalToday)
    gs 'DebugMelissaPrintBool', 'Ждёт разговора с Клариссой', MelissaClarissaAnalTalkPending
    gs 'DebugMelissaPrintBool', 'Разговор с Клариссой состоялся', MelissaClarissaAnalTalkDone
    gs 'DebugMelissaPrintBool', 'Домашний анал пройден (MelissaHomeAnalDone)', MelissaHomeAnalDone
    gs 'DebugMelissaPrintBool', 'Анал со Стефаном был (MelissaAnalWithGgDone)', MelissaAnalWithGgDone
    gs 'DebugMelissaPrintBool', 'Анал разблокирован в SexScene', MelissaAnalUnlocked
    gs 'DebugMelissaPrintBool', 'Анальная девственность', analvirgin['melissa']

    pl 'Сцены домашнего анала:'
    pl '  ⚡ <a href="exec:gs ''DebugMelissaJumpHomeAnal'', 1 & gt ''MelissaHomeAnalStep1''">Шаг 1: объятия со спины, искра интереса (MelissaHomeAnalStep1)</a>'
    pl '  ⚡ <a href="exec:gs ''DebugMelissaJumpHomeAnal'', 2 & gt ''MelissaHomeAnalStep2''">Шаг 2: масло, пальцы, оргазм и благодарность (MelissaHomeAnalStep2)</a>'
    pl '  ⚡ <a href="exec:gt ''MelissaClarissaAnalTalkShopScene''">Беседа с Клариссой в лавке вина (MelissaClarissaAnalTalkShopScene)</a>'
    pl '  ⚡ <a href="exec:gs ''DebugMelissaJumpHomeAnal'', 3 & gt ''MelissaHomeAnalStep3''">Шаг 3: полная близость со Стефаном (MelissaHomeAnalStep3)</a>'

    pl 'Kink discovery стадия: ' + STR(MelissaAnalDiscoveryStage) + ' / 4 | сегодня: ' + STR(MelissaAnalDiscoveryToday)
    pl '  ⚡ <a href="exec:gt ''MelissaAnalDiscoveryStep''">Kink discovery шаг (MelissaAnalDiscoveryStep)</a>'
    pl '  ⚡ <a href="exec:gt ''MelissaAnalWithGgStart''">Анал через Kink-систему (MelissaAnalWithGgStart)</a>'

    pl 'Групповые сцены и связи:'
    pl '  ММЖ с менестрелем: ready ' + STR(MelissaMinstrelThreesomeReady) + ' | offer ' + STR(MelissaMinstrelThreesomeCanOffer) + ' | done ' + STR(MelissaMinstrelThreesomeDone)
    pl '  ⚡ <a href="exec:gs ''DebugMelissaPresetThreesomeMinstrel'' & gt ''GroupSexMelissaMinstrelStefanStart''">ММЖ (Элрик + Мелисса + Стефан)</a>'
    pl '  ЖЖМ Аманда+Мелисса: ready ' + STR(AmandaMelissaThreesomeReady) + ' | done ' + STR(AmandaMelissaThreesomeDone)
    pl '  ⚡ <a href="exec:gs ''DebugMelissaPresetThreesomeAmanda'' & gt ''GroupSexAmandaMelissaStefanStart''">ЖЖМ (Аманда + Мелисса + Стефан)</a>'
    pl '  Кларисса ММЖ done: ' + STR(ClarissaMmfMelissaDone) + ' | связь Кларисса-Мелисса: ' + STR(MelissaClarissaBond)
    pl '  ⚡ <a href="exec:gt ''GroupSexClarissaMelissaMmfScene''">ММЖ (Кларисса + Мелисса + Стефан)</a>'
    pl '  Ночные тренировки растяжки с Амандой: стадия ' + STR(AmandaMelissaTrainingStage) + ' / 6 | done ' + STR(AmandaMelissaTrainingDone)
    pl '  ⚡ <a href="exec:gs ''DebugMelissaPresetStretchTraining'', 1 & gt ''AmandaMelissaNightTraining''">Тренировка с Амандой (AmandaMelissaNightTraining)</a>'
---

#DebugMelissaPrintSocialBlock
    pl '<b>Социальные параметры и шкалы</b>'
    pl 'Дружба: ' + STR(Friends['melissa']) + ' [<a href="exec:Friends[''melissa''] += 5 & gs ''DebugMelissaArcPanel''">+5</a> / <a href="exec:Friends[''melissa''] -= 5 & gs ''DebugMelissaArcPanel''">-5</a>] | Любовь: ' + STR(love['melissa']) + ' [<a href="exec:love[''melissa''] += 5 & gs ''DebugMelissaArcPanel''">+5</a> / <a href="exec:love[''melissa''] -= 5 & gs ''DebugMelissaArcPanel''">-5</a>]'
    pl 'Откровенность: ' + STR(otkroven['melissa']) + ' [<a href="exec:otkroven[''melissa''] += 5 & gs ''DebugMelissaArcPanel''">+5</a> / <a href="exec:otkroven[''melissa''] -= 5 & gs ''DebugMelissaArcPanel''">-5</a>] | Развращённость: ' + STR(sluttiness['melissa']) + ' [<a href="exec:sluttiness[''melissa''] += 5 & gs ''DebugMelissaArcPanel''">+5</a> / <a href="exec:sluttiness[''melissa''] -= 5 & gs ''DebugMelissaArcPanel''">-5</a>]'
    pl 'PlayerPath: ' + STR(MelissaPlayerPath) + ' [<a href="exec:MelissaPlayerPath += 1 & gs ''DebugMelissaArcPanel''">+1</a>] | NpcPath: ' + STR(MelissaNpcPath) + ' [<a href="exec:MelissaNpcPath += 1 & gs ''DebugMelissaArcPanel''">+1</a>]'
    pl 'Интерес к менестрелю: ' + STR(MelissaMusicianInterest) + ' [<a href="exec:MelissaMusicianInterest += 5 & gs ''DebugMelissaArcPanel''">+5</a> / <a href="exec:MelissaMusicianInterest -= 5 & gs ''DebugMelissaArcPanel''">-5</a>]'
    pl 'Потребность в контроле: ' + STR(MelissaControlNeed) + ' | Ревность: ' + STR(MelissaJealousy) + ' | Доверие: ' + STR(MelissaTrustStefan) + ' | Уважение: ' + STR(MelissaRespectStefan)
    pl 'Скрытность: ' + STR(MelissaSecretiveness) + ' | Забота о семье: ' + STR(MelissaFamilyConcern) + ' | Обида (дней): ' + STR(GirlOffenseDays['melissa'])
    pl 'Сексуальная статистика: intimStage ' + STR(IntimStage['melissa']) + ' | поцелуи ' + STR(KissCount['melissa']) + ' | ласки ' + STR(CaressCount['melissa']) + ' | минет ' + STR(BlowjobCount['melissa']) + ' | куни ' + STR(CuniCount['melissa'])
    pl 'Секс: всего ' + STR(sexacts['melissa']) + ' | вагинал ' + STR(vaginalacts['melissa']) + ' | анал всего ' + STR(analacts['melissa']) + ' | анал от ГГ ' + STR(analfromyou['melissa']) + ' | внутрь ' + STR(cuminside['melissa'])
---

#DebugMelissaPrintNextHint
    $DebugMelissaNextHint = '—'

    if MelissaHomeUnlocked = 0:
