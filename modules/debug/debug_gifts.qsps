! ================================================
! FILE: modules/debug/debug_gifts.qsps
! MODULE: debug
! Панель отладки подарков
! ================================================

#DebugGiftPanel
    if debug = 0:
        clr
        pl 'DEBUG отключён.'
        exit
    end

    gs 'PanelDebugToolsHeader'

    pl 'DEBUG: ПОДАРКИ'
    pl ' '
    pl 'PortGiftBoughtTotal: ' + STR(PortGiftBoughtTotal)
    pl 'GiftShipPurchaseWeek: ' + STR(GiftShipPurchaseWeek) + ' (week ' + STR(week) + ')'
    pl 'GiftShipWeekBoughtCheap: ' + STR(GiftShipWeekBoughtCheap) + ' / ' + STR(GiftInventoryMaxCheap)
    pl 'GiftShipWeekBoughtExpensive: ' + STR(GiftShipWeekBoughtExpensive) + ' / ' + STR(GiftInventoryMaxExpensive)
    gs 'GiftInventoryTotal'
    pl 'GiftInventoryTotal: ' + STR(GiftInventoryTotal)
    pl 'gift_cheap: ' + STR(GiftInventory['gift_cheap'])
    pl 'gift_expensive: ' + STR(GiftInventory['gift_expensive'])
    pl ' '

    pl '<a href="exec:GiftInventory[''gift_cheap''] += 1 & gs ''DebugGiftPanel''">+1 обычный</a>'
    pl '<a href="exec:GiftInventory[''gift_expensive''] += 1 & gs ''DebugGiftPanel''">+1 дорогой</a>'
    pl '<a href="exec:gs ''GiftDebugAddAll'' & gs ''DebugGiftPanel''">Заполнить лимит</a>'
    pl '<a href="exec:gs ''InitGiftInventory'' & gs ''DebugGiftPanel''">Обнулить инвентарь</a>'

    gs 'PanelDebugToolsBack'
---