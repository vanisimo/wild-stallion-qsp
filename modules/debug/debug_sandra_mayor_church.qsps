! ================================================
! FILE: modules/debug/debug_sandra_mayor_church.qsps
! MODULE: debug
! Дебаг-панель для линий Мэра и Отца Герхарда (Сандра)
! ================================================

#DebugSandraMayorChurchPanel
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'DEBUG: САНДРА — МЭР И ЦЕРКОВЬ'

    *pl '<b>Текущие флаги и переменные:</b>'
    *pl 'week = ' + STR(week) + ' | day = ' + STR(day) + ' | time = ' + STR(time)
    *pl 'FamilyCorruptionStage = ' + STR(FamilyCorruptionStage) + ' | sluttiness[sandra] = ' + STR(sluttiness['sandra'])
    *pl 'GirlNoPantiesWork[sandra] = ' + STR(GirlNoPantiesWork['sandra']) + ' | panties[sandra] = ' + STR(panties['sandra'])
    *pl ' '
    *pl '<b>Линия Мэра:</b>'
    *pl 'SandraMayorVisitsStopped = ' + STR(SandraMayorVisitsStopped)
    *pl 'PlayerKnows_MayorUsesSandra = ' + STR(PlayerKnows_MayorUsesSandra)
    *pl 'tavern_reputation = ' + STR(tavern_reputation) + ' | money = ' + STR(money)
    *pl ' '
    *pl '<b>Линия Отца Герхарда:</b>'
    *pl 'SandraConfessedDraupnir = ' + STR(SandraConfessedDraupnir) + ' | SandraConfessedMayor = ' + STR(SandraConfessedMayor)
    *pl 'SandraChurchGerhardSeen = ' + STR(SandraChurchGerhardSeen)
    *pl 'PlayerKnows_SandraGerhardVisits = ' + STR(PlayerKnows_SandraGerhardVisits)
    *pl 'SandraGerhardVisitsStopped = ' + STR(SandraGerhardVisitsStopped)
    *pl ' '

    *pl '--- <b>Быстрые переключатели</b> ---'
    *pl '<a href="exec:GirlNoPantiesWork[''sandra''] = 1 - GirlNoPantiesWork[''sandra''] & gt ''DebugSandraMayorChurchPanel''">Переключить бельё Сандры (GirlNoPantiesWork)</a>'
    *pl '<a href="exec:FamilyCorruptionStage = (FamilyCorruptionStage + 1) mod 6 & gt ''DebugSandraMayorChurchPanel''">Коррупция +1 (сейчас ' + STR(FamilyCorruptionStage) + ')</a>'
    *pl '<a href="exec:SandraMayorVisitsStopped = 1 - SandraMayorVisitsStopped & gt ''DebugSandraMayorChurchPanel''">Мэр визиты остановлены (' + STR(SandraMayorVisitsStopped) + ')</a>'
    *pl '<a href="exec:SandraConfessedDraupnir = 1 & SandraConfessedMayor = 1 & gt ''DebugSandraMayorChurchPanel''">Дать исповедь (Драупнир + Мэр)</a>'
    *pl ' '

    *pl '--- <b>Тест сцен</b> ---'
    *pl '<a href="exec:gt ''SandraMayorSpyStart''">Запустить подглядывание Мэра (SandraMayorSpyStart)</a>'
    *pl '<a href="exec:PlayerKnows_MayorUsesSandra = 1 & gt ''MayorOfficeConfrontSandraVisits''">Разговор с Мэром (MayorOfficeConfrontSandraVisits)</a>'
    *pl '<a href="exec:gt ''SandraChurchSpyStart''">Запустить подглядывание Герхарда (SandraChurchSpyStart)</a>'
    *pl '<a href="exec:gt ''SandraGerhardStopTalk''">Разговор с Сандрой про Герхарда (SandraGerhardStopTalk)</a>'
    *pl '<a href="exec:gt ''SandraDraupnirFridayPeek''">Запустить подглядывание у Гнома (SandraDraupnirFridayPeek)</a>'
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в главный зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---
