! ================================================
! FILE: modules/events/tavern/legare_supply_aftermath_text.qsps
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты последствий торгового давления Легаре
! Используется кодом:
! modules/events/tavern/legare_supply_aftermath.qsps
! ================================================

#MelissaTalkAboutLegareSupplyIntroText
    *pl 'Мелисса с сухим треском перелистывает плотные пергаментные листы в расходной книге и морщится, водя пальцем по свежим колонкам цифр.'
    *pl '— Это уже не просто купеческая обида, Стефан. Это чистая арифметика на выживание, — говорит она своим привычным менторским тоном, поправляя выбившуюся прядку волос. — Если Легаре задержит следующую повозку с элем, через три дня нам нечего будет наливать даже в полдень.'
    *pl 'Она поднимает на вас проницательные глаза и понижает голос:'
    *pl '— Завсегдатаи могут простить пересоленную похлёбку или остывшую печь. Но пустые кружки и кислое пойло они не простят никогда. Слух разлетится по посаду за пару часов.'
---

#MelissaTalkAboutLegareSupplyActionText
    $SupplyAftermathTextChoice = LCASE($ARGS[0])

    if $SupplyAftermathTextChoice = 'check_stock':
        *pl 'Вы просите Мелиссу лично провести полную ревизию подвала и запереть расходные краны.'
        *pl 'Она с видимым удовольствием берётся за дело: вооружившись восковой табличкой и мелом, лично спускается в погреб, обстукивает каждую бочку, выверяет остаток вина по пальцам и устанавливает жёсткий суточный лимит для разносчиц.'
        *pl '— До вечера пятницы протянем без потерь, — сообщает она, отряхивая подол от подвальной пыли. — Конфликт это не решит, но пару дней передышки ты выиграл.'

    elseif $SupplyAftermathTextChoice = 'save_alcohol':
        *pl 'Вы даёте указание разливать эль строже, слегка не доливая до ободка кружек.'
        *pl 'Мелисса скептически поджимает губы, но кивает:'
        *pl '— Сделаем. Только учти: городские плотники и возчики считают пиво точнее любых весов. Пена осядет — и начнутся косые взгляды. Порядок в бочках наведём, но шум в зале станет куда злее.'

    elseif $SupplyAftermathTextChoice = 'seek_route':
        *pl 'Вы вполголоса говорите, что ищете способ обойти купеческую монополию Легаре.'
        *pl 'Мелисса мгновенно улавливает вашу мысль, её брови удивлённо приподнимаются:'
        *pl '— Кларисса? — шепчет она, подавшись вперёд. — Дерзко, Стефан. Очень дерзко. Если её муж узнает, что его обвели вокруг пальца в его же собственной кладовой... он рассвирепеет. Но признаю: это единственный способ не дать трактиру засохнуть.'

    elseif $SupplyAftermathTextChoice = 'admit_danger':
        *pl 'Вы прямо и без прикрас признаёте: положение опасное, и Легаре способен разорить вас, если не проявить гибкость.'
        *pl 'Мелисса внимательно смотрит на вас, и в её строгом взгляде мелькает неподдельное уважение:'
        *pl '— Хорошо, что ты не петушишься, Стефан. Признать силу врага — первый шаг к тому, чтобы его переиграть. Нам нужен холодный план, а не пустая злость. Давай считать дальше.'

    else:
        *pl 'Мелисса кивает и берёт подсчёт расхода выпивки под личный присмотр.'
    end

    killvar '$SupplyAftermathTextChoice'
---

#ClarissaTalkAboutSupplyAftermathIntroText
    *pl 'Кларисса тихо прикрывает тяжёлую дубовую дверь ратушного архива, оставаясь с вами наедине среди полок с пыльными свитками.'
    *pl '— Я помогла тебе с вином не ради забавы, Стефан, — произносит она мягко, но с затаённой тревогой. — И уж точно не потому, что это безопасно.'
    *pl 'Она нервно касается пальцами серебряной цепочки на шее:'
    *pl '— Легаре каждый вечер пересчитывает приходные ордера. Если он заметит, что две телеги с южного тракта ушли в сторону слободы, он начнёт рыть землю носом.'
---

#ClarissaTalkAboutSupplyAftermathActionText
    $ClarissaSupplyAftermathTextChoice = LCASE($ARGS[0])

    if $ClarissaSupplyAftermathTextChoice = 'thank':
        *pl 'Вы искренне и сдержанно благодарите её за помощь, не давая пустых мальчишеских обещаний.'
        *pl 'Кларисса тепло, но грустно улыбается:'
        *pl '— Спасибо, Стефан. Мне важно знать, что ты понимаешь цену этой помощи. В нашем доме давно разучились говорить «спасибо».'

    elseif $ClarissaSupplyAftermathTextChoice = 'ask_suspicion':
        *pl 'Вы спрашиваете прямо: не заподозрил ли Легаре что-то неладное?'
        *pl 'Кларисса на секунду задумывается, покусывая губу:'
        *pl '— Пока нет. Он считает, что ты просто перекупил старые остатки у городских пивоваров. Но Легаре не дурак. Если «Дикий Жеребец» продолжит наливать доброе южное вино при закрытых складах гильдии, он сложит два и два.'

    elseif $ClarissaSupplyAftermathTextChoice = 'offer_protection':
        *pl 'Вы твёрдо говорите, что если купец посмеет поднять на неё руку или обвинить в измене — вы не оставите её одну.'
        *pl 'Кларисса долго и пристально смотрит на вас, в её глазах вспыхивает благодарность вперемешку со страхом:'
        *pl '— Красивые слова, Стефан... Очень благородные. Ильматер свидетель, я давно не слышала подобного от мужчин. Я запомню это.'

    elseif $ClarissaSupplyAftermathTextChoice = 'continue_secret':
        *pl 'Вы просите её продолжать направлять бочки в обход мужа, пока буря не уляжется.'
        *pl 'Кларисса медленно выдыхает и кивает:'
        *pl '— Хорошо. Но теперь каждая телега должна приходить только глухой ночью, со стороны скотного двора. Следующая оплошность будет стоить мне покоя, а тебе — трактира.'

    else:
        *pl 'Кларисса молча слушает вас, обдумывая каждый следующий шаг.'
    end

    killvar '$ClarissaSupplyAftermathTextChoice'
---
