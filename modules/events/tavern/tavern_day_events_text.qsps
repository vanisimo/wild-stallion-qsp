! ================================================
! FILE: modules/events/tavern/tavern_day_events_text.qsps
! MODULE: events/tavern
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты дневных нейтральных событий таверны
! ================================================

#TavernDayEventText
    $TavernDayEventTextId = LCASE($ARGS[0])
    $TavernDayEventText = ''

    if $TavernDayEventTextId = 'caravan_morning':
        $TavernDayEventText = 'С самого рассвета у ворот «Дикого Жеребца» скрипят тяжёлые груженые повозки, ржут упряжные лошади, а заезжие купцы и бородатые возчики с гомоном вваливаются в двери. Зал мгновенно наполнился гулом чужих голосов, запахом дорожной пыли, мокрой шерсти и звоном монет. Аманда, Мелисса и Сандра сбиваются с ног, разрываясь между кухней, кружками и бесконечными заказами. Сегодня никому не до праздных бесед — весь трактир крутится вокруг проезжего каравана.'

    elseif $TavernDayEventTextId = 'caravan_hall':
        $TavernDayEventText = 'У распахнутых ворот стоят повозки каравана, а в зале яблоку негде упасть: купцы и возчики хрипло требуют добавка, стучат кружками по дубовым столам и громко спорят о ценах на шерсть и зерно. Девушки только и успевают лавировать между лавками с полными подносами. На лицах — сосредоточенная усталость: сегодня трактир работает на пределе возможностей, и о личных разговорах можно даже не думать.'

    elseif $TavernDayEventTextId = 'caravan_evening':
        $TavernDayEventText = 'Караван снялся с постоя, оставив за собой горы грязной посуды, липкие столы и гудящую пустоту. Девушки совершенно вымотаны после безумного дня: еле передвигая гудящие ноги, они убирают зал и на любые попытки заговорить отвечают лишь усталым, умоляющим взглядом.'

    elseif $TavernDayEventTextId = 'caravan_end':
        $TavernDayEventText = 'Шумный день караванного постоя подошёл к концу. Пусть персонал выбился из сил, а в зале предстоит долгая уборка, зато кошель трактира заметно потяжелел от серебра, а слух о сытном и расторопном приёме в «Диком Жеребце» караванщики понесут дальше по тракту.'

    elseif $TavernDayEventTextId = 'rats_morning':
        $TavernDayEventText = 'Утро началось с грохота и звона уроненной миски на кухне: в кладовом подвале обнаружились следы наглых крыс. Холщовые мешки прогрызены насквозь, белая мука рассыпана по камням вперемешку с мышиным помётом, а куски сала и копчёностей безнадёжно испорчены. Сандра в ярости бранится на всю таверну, в кладовой стоит кислый затхлый дух, а девушки в панике пытаются спасти уцелевшие припасы.'

    elseif $TavernDayEventTextId = 'rats_hall':
        $TavernDayEventText = 'В зале висит тяжёлая, нервная атмосфера: до гостей то и дело долетает сердитый голос Сандры из кухни, порции сегодня скромнее обычного, а из приоткрытого люка кладовой тянет сыростью и кислятиной. Посетители косятся на треснувшие ящики и недовольно перешёптываются, принюхиваясь к подаваемой снеди.'

    elseif $TavernDayEventTextId = 'rats_hall_repair_pending':
        $TavernDayEventText = 'Ремонт кладовой уже согласован: столяр Драупнир обещал прийти с инструментом к вечеру. В подвале пока всё ещё видны следы зубов на досках и чувствуется запах переворошённой муки, но Сандра хотя бы перестала метать громы и молнии, ожидая прихода мастера.'

    elseif $TavernDayEventTextId = 'rats_hall_repaired':
        $TavernDayEventText = 'Драупнир на совесть подлатал кладовую: гнилые доски заменены крепким дубом, щели наглухо забиты, а тяжёлые полки теперь стоят как влитые. Запах свежей стружки вытеснил затхлость, и трактир наконец возвращается к привычному спокойному ритму.'

    elseif $TavernDayEventTextId = 'rats_repair_hint':
        $TavernDayEventText = 'Двери и лари в кладовой перекошены, доски подгнили, а крысиные норы зияют в каждом углу — своими силами тут не справиться. Стоит заглянуть в квартал ремесленников к столяру Драупниру: старый мастер знает, как укрепить дерево намертво, хотя за работу наверняка запросит полновесную плату.'

    elseif $TavernDayEventTextId = 'rats_brawl':
        $TavernDayEventText = 'К вечеру нервозность вылилась в настоящую беду: захмелевшие завсегдатаи устроили громкую перебранку из-за скверной похлёбки и чёрного хлеба. Слово за слово — и в ход пошли кулаки и глиняные кружки. Прежде чем удалось растащить драчунов, один из столов разнесли в щепки, перебив кучу посуды и распугав приличных гостей.'

    elseif $TavernDayEventTextId = 'rats_end_repaired':
        $TavernDayEventText = 'День выдался на редкость суматошным: крысиный набег влетел в копеечку, испортив припасы и нервы. Однако Драупнир успел вовремя заколотить лазейки и укрепить полки — дальнейших бед удалось избежать, и завтра кладовая встретит день в полной готовности.'

    elseif $TavernDayEventTextId = 'rats_end_unrepaired':
        $TavernDayEventText = 'Тяжёлый, убыточный день подошёл к концу. Крысы попортили добрую долю припасов, в зале едва не учинили погром, а кладовая так и осталась разбитой и расшатанной. Если не пригласить столяра, завтра сырость, вонь и убытки снова дадут о себе знать.'

    elseif $TavernDayEventTextId = 'brawl_morning':
        $TavernDayEventText = 'Утро в зале встретило картиной полного разорения: массивная дубовая лавка расколота надвое, у стойки зияет свежая трещина от брошенной кружки, а на полу темнеют подсохшие лужи пролитого хмеля. Несколько хмурых наёмников с помятыми физиономиями сидят в углу, злобно поглядывая друг на друга и сжимая рукояти кинжалов.'

    elseif $TavernDayEventTextId = 'brawl_hall':
        $TavernDayEventText = 'В зале стоит тяжёлый дух кислого пива, дешёвого табака и недавней ярости. Персонал спешно выметает глиняные черепки из-под ног, стараясь не привлекать внимания задир. Гости сидят тише воды, перешёптываясь по углам, а пошатнувшаяся стойка красноречиво свидетельствует о размахе вчерашнего побоища.'

    elseif $TavernDayEventTextId = 'brawl_hall_repair_pending':
        $TavernDayEventText = 'Драупнир уже получил задаток и обещал явиться с пилой и рубанком к вечеру. И хотя стойка пока держится на честном слове, а сломанные стулья сиротливо свалены у стены, на душе спокойнее: мастер вернёт залу подобающий порядок.'

    elseif $TavernDayEventTextId = 'brawl_repair_hint':
        $TavernDayEventText = 'Барная стойка дала глубокую трещину, а разбитые стулья грозят вот-вот развалиться под очередным посетителем. Без хорошего столяра тут не обойтись: мастер Драупнир из квартала ремесленников быстро вернёт мебели крепость, если не пожалеть монет за работу.'

    elseif $TavernDayEventTextId = 'brawl_end_repaired':
        $TavernDayEventText = 'Драка влетела трактиру в добрую копеечку и стоила немало нервов, однако Драупнир сработал на совесть. Стойка стянута железными скобами, ножки столов подогнаны, и к вечеру зал вновь обрёл солидный и аккуратный вид.'

    elseif $TavernDayEventTextId = 'brawl_end_unrepaired':
        $TavernDayEventText = 'Побоище оставило глубокие шрамы на деревянной обшивке и заметную брешь в кассе. Ремонт так и остался на словах: треснувшая мебель и шатающаяся стойка завтра встретят гостей укоризненным скрипом, нанося урон чести заведения.'

    elseif $TavernDayEventTextId = 'guard_morning':
        $TavernDayEventText = 'С утра под окнами послышался мерный лязг кованых сапог и железа: в двери уверенно ввалился наряд городской стражи. Сержант с каменным лицом окинул взглядом стойку, придирчиво разглядывая углы и шурша бумагами с городскими печатями, словно заранее надеялся найти хоть какой-нибудь повод придраться.'

    elseif $TavernDayEventTextId = 'guard_hall_pass':
        $TavernDayEventText = 'Стражники неспешно обходят зал, заглядывая за бочки и проверяя чистоту столов. Порядок и приличный вид заведения охлаждают их служебное рвение: сержант скупо кивает, прячет свиток в кожаную сумку и не находит, к чему бы прицепиться.'

    elseif $TavernDayEventTextId = 'guard_hall_fine':
        $TavernDayEventText = 'Сержант стражи кривит губы, тычет перчаткой в запыленный угол и громко возмущается состоянием кладовой и шумом в зале. По его цепкому взгляду сразу ясно: блюстителю закона нужен не столько порядок, сколько жирный штраф в пользу городской казны — или собственный карман.'

    elseif $TavernDayEventTextId = 'guard_end_pass':
        $TavernDayEventText = 'Проверка стражи закончилась благополучно: сержант убедился, что закон не нарушен, пропустил за счёт заведения кружку светлого эля и увёл людей прочь. «Дикий Жеребец» укрепил репутацию благонадёжного места.'

    elseif $TavernDayEventTextId = 'guard_end_fine':
        $TavernDayEventText = 'Визит стражи обернулся горьким унижением и убытком. Сержант громогласно отчитал трактирщика при всех гостях, составил придирчивую кляузу и выписал грабительский штраф. Репутация заведения пошатнулась, а посетители ещё долго шептались о визите властей.'

    elseif $TavernDayEventTextId = 'harvest_morning':
        $TavernDayEventText = 'Весь город с утра гудит: наступил праздник урожая! Улицы украшены венками из спелых колосьев, отовсюду пахнет яблоками и свежеиспечённым хлебом. Нарядные горожане и крестьяне из окрестных деревень валом валят в трактир, стремясь отметить щедрый год за доброй кружкой.'

    elseif $TavernDayEventTextId = 'harvest_hall':
        $TavernDayEventText = 'Зал трещит по швам: за столами звучат праздничные здравицы, тосты за богатый сбор и весёлые песни. В воздухе плывёт густой аромат жареного мяса, а девушки с сияющими глазами едва успевают разносить полные кувшины, ловя на себе одобрительные взгляды и получая щедрые чаевые.'

    elseif $TavernDayEventTextId = 'harvest_end':
        $TavernDayEventText = 'Праздник урожая удался на славу: бочки опустели, мясо съедено до последнего ломтя, а выручка в кассе греет душу увесистой тяжестью. Трактир показал себя гостеприимным и хлебосольным, заслужив искреннее уважение добрых горожан.'

    elseif $TavernDayEventTextId = 'minstrels_morning':
        $TavernDayEventText = 'С самого утра в трактире звучат переливы струн и звон бубна: в зале обосновалась ватага бродячих менестрелей. Разложив лютни, флейты и смычки на лучшем столе у камина, они настраивают лады, распеваются и притягивают в зал толпу зевак со всей улицы.'

    elseif $TavernDayEventTextId = 'minstrels_hall':
        $TavernDayEventText = 'Под высокими балками разносится звонкая баллада о рыцарях и дальних странствиях. Гости воодушевленно подпевают в такт, барабаня кружками по дубовым столам и требуя ещё вина. В зале царит редкое оживление, хотя от звона струн и криков публики порой закладывает уши.'

    elseif $TavernDayEventTextId = 'minstrels_end':
        $TavernDayEventText = 'Менестрели отыграли свой репертуар на славу, сорвав бурю рукоплесканий и заметно оживив торговлю элем. Гости разошлись с прекрасным настроением, а день оставил после себя приятное ощущение весёлой кутерьмы и неплохую прибыль.'

    elseif $TavernDayEventTextId = 'storm_morning':
        $TavernDayEventText = 'Небо затянуло свинцовыми тучами, и над городом разразился настоящий шторм. Холодный ливень хлещет по черепице, превращая мостовую в потоки серой грязи. Улицы опустели, и лишь редкие путники, насквозь промокшие и озябшие, торопливо стучат в двери трактира в поисках сухого угла.'

    elseif $TavernDayEventTextId = 'storm_hall':
        $TavernDayEventText = 'За мутными стёклами хлещет стена дождя, а в зале царит сонный, размеренный покой. В очаге потрескивают сухие поленья, пахнет согретым вином и сырой шерстью сушащихся плащей. Немногие завсегдатаи не торопятся уходить, неспешно цедя эль и слушая мерный рокот грозы.'

    elseif $TavernDayEventTextId = 'storm_end':
        $TavernDayEventText = 'Непогода отрезала трактир от широкого потока гостей, зато верные посетители провели за кружками весь день, спасаясь от сырости. День прошёл на редкость мирно и без лишних потрясений, дав передышку всему заведению.'

    elseif $TavernDayEventTextId = 'pilgrims_morning':
        $TavernDayEventText = 'В город вошла группа паломников в грубых серых власяницах — смиренные странники, следующие по святому пути Ильматера Всеблагого. Опираясь на узловатые посохи, они осенили себя священным кругом у порога и робко попросили горячей похлёбки и ломтя хлеба за ту малую медную монетку, что у них осталась. Их строгие, исполненные веры взгляды словно проверяют душу и совесть хозяина.'

    elseif $TavernDayEventTextId = 'pilgrims_hall':
        $TavernDayEventText = 'В дальнем углу зала чинно сидят паломники Ильматера. Положив на колени посохи, они тихо шепчут молитвы, очерчивают знак святого Круга над скромными деревянными мисками и делят поданный хлеб. Буйные гуляки невольно притихают под их праведными взглядами, а в зале воцаряется редкое благоговение.'

    elseif $TavernDayEventTextId = 'pilgrims_end':
        $TavernDayEventText = 'Паломники Ильматера покинули трактир, вознеся благословение дому Стефана за приют и милосердие. Монет от них перепало немного, но весть о добродетели трактирщика быстро разнеслась среди прихожан и городской церкви, прибавив доброй славы «Дикому Жеребцу».'

    elseif $TavernDayEventTextId = 'broken_morning':
        $TavernDayEventText = 'Ночью в подвале грянула беда: не выдержали старые железные обручи, и дубовая бочка с отборным элем с треском лопнула. Пенный хмель залил каменный пол, превратив подвал в скользкое зловонное болото, а тяжёлые клёпки при падении погнули соседние полки. Часть драгоценных запасов напитков безвозвратно утеряна.'

    elseif $TavernDayEventTextId = 'broken_hall':
        $TavernDayEventText = 'Сквозь щели в полу из подвала поднимается тяжёлый дух скисшего эля. Стойка и нижние ступени подвальной лестницы расшатались после ночной суматохи, когда спасали уцелевшие бочонки. Без крепкой руки столяра наводить порядок здесь будет сущим мучением.'

    elseif $TavernDayEventTextId = 'broken_hall_repair_pending':
        $TavernDayEventText = 'Драупнир получил заказ и дал слово подойти к вечеру со смолой, зажимами и новыми дубовыми брусьями. Пока полки ещё перекошены, а из погреба слышен запах пролитого хмеля, но персонал хотя бы уверен, что подвал скоро приведут в полный порядок.'

    elseif $TavernDayEventTextId = 'broken_repair_hint':
        $TavernDayEventText = 'Опоры под бочками прогнулись, а полки в погребе грозят рухнуть под тяжестью оставшихся кувшинов. Нужно срочно наведаться в ремесленный квартал к столяру Драупниру: старый гном быстро укрепит настил и заменит лопнувшие балки.'

    elseif $TavernDayEventTextId = 'broken_end_repaired':
        $TavernDayEventText = 'Потеря бочки обошлась недёшево, но благодаря умелым рукам Драупнира подвал снова в полной безопасности. Новые дубовые подпорки встали намертво, лужи вычерпаны, и за уцелевшие запасы теперь можно не опасаться.'

    elseif $TavernDayEventTextId = 'broken_end_unrepaired':
        $TavernDayEventText = 'Убыточный день подошёл к концу, а подвал так и остался в плачевном состоянии. Сырость, запах выдохшегося пива и перекошенные балки будут и дальше портить припасы, если не позвать столяра.'

    elseif $TavernDayEventTextId = 'thief_morning':
        $TavernDayEventText = 'Утренняя ревизия принесла скверную весть: ночью через хлипкое окно со стороны заднего двора в кладовую пробрался вор. Пропал целый мешок муки высшего сорта и пара кувшинов доброго южного вина, а на влажной земле у забора остались чужие следы сапог.'

    elseif $TavernDayEventTextId = 'thief_hall':
        $TavernDayEventText = 'По залу ползут тревожные шепотки: персонал на взводе, Сандра с яростным видом пересчитывает каждую краюху и банку, а взгляды девушек на подозрительных гостей стали настороженными и колючими. Спокойствие в доме нарушено.'

    elseif $TavernDayEventTextId = 'thief_end':
        $TavernDayEventText = 'Ночная кража неприятно ударила по припасам и оставила мерзкий осадок. Пришлось спешно навешивать тяжёлые амбарные замки на заднюю дверь и подвальные ставни, чтобы отвадить любителей лёгкой наживы.'

    elseif $TavernDayEventTextId = 'carpenter_visit_rats':
        $TavernDayEventText = 'Драупнир молча осматривает кладовую: ощупывает зазубренные доски, тычет толстым пальцем в расшатанные полки и сплёвывает под ноги. — Держать будет, если с умом перебрать и закрепить прямо сейчас, — хрипло бурчит старый гном. — Платите — и к вечеру зайду в трактир со скобами и рубанком, сам всё подгоню.'

    elseif $TavernDayEventTextId = 'carpenter_visit_brawl':
        $TavernDayEventText = 'Драупнир хмуро оглядывает трещину в дубовой стойке и расколотый стул. — В следующий раз пусть на кулаках за воротами меряются, — ворчит он, постукивая обухом молотка по столешнице. — Зал я вам стяну, но работа не пятиминутная. Оплатите заказ — к вечеру сам приду со снаряжением и всё сделаю.'

    elseif $TavernDayEventTextId = 'carpenter_visit_broken':
        $TavernDayEventText = 'Драупнир спускается в сырой подвал, тычет молотком в намокшую, прогнувшуюся полку и качает косматой головой. — Тяжёлую бочку вам не удержать, пока балки гнилые, а крепления шатаются, — говорит он. — Заплатите — вечером приду и намертво укреплю весь подвал.'

    elseif $TavernDayEventTextId = 'carpenter_no_money':
        $TavernDayEventText = '— Без звонкой монеты работы не будет, — отрезает Драупнир, скрещивая руки на груди. — До вечера так всё и простоит: гости косятся, девки нервничают, а слава заведения тает. Потянете время — ещё и стол рухнет или драка вспыхнет. Заработайте на ремонт или готовьтесь подсчитывать убытки.'

    elseif $TavernDayEventTextId = 'carpenter_refuse':
        $TavernDayEventText = 'Вы решаете повременить с ремонтом. Драупнир равнодушно пожимает плечами: — Ваше дело, хозяин. Только потом не жалуйтесь, когда полка с кувшинами с грохотом осыплется или гости начнут плеваться. До конца дня трактир останется в таком виде — и лучше ему от ожидания точно не станет.'

    elseif $TavernDayEventTextId = 'carpenter_order_confirm':
        $TavernDayEventText = 'Драупнир скупо кивает, сгребает монеты широкой ладонью и прячет в кожаный кошель. — Договорились. К вечеру загляну в «Дикий Жеребец» и приведу зал и подвал в полный порядок. До тех пор сами в крепления не лезьте — только дерево попортите.'

    elseif $TavernDayEventTextId = 'carpenter_already_ordered':
        $TavernDayEventText = 'Драупнир уже принял задаток и даже слышать не хочет лишних расспросов. — Сказано же: к вечеру буду, — недовольно бурчит он из-за верстака. — Иди в свой трактир и жди мастера, не маячь перед глазами.'

    elseif $TavernDayEventTextId = 'carpenter_evening_rats':
        $TavernDayEventText = 'К вечеру в главный зал неторопливо заходит Драупнир с тяжёлым ящиком инструментов. Стук молотка, визг пилы, терпкий запах свежей сосновой стружки — и спустя час полки в кладовой снова стоят ровно и несокрушимо. Сандра облегчённо выдыхает, а посетители забывают о крысиных проделках.'

    elseif $TavernDayEventTextId = 'carpenter_evening_brawl':
        $TavernDayEventText = 'Драупнир появляется в зале с набором железных скоб и без лишних слов принимается за дело. Уверенные удары, подгонка клиньев — и вот уже стойка монолитна, а стулья не шатаются под рукой. Когда гном собирает инструмент, зал снова выглядит опрятно и надёжно.'

    elseif $TavernDayEventTextId = 'carpenter_evening_broken':
        $TavernDayEventText = 'Вечером Драупнир основательно укрепляет подвальные перекрытия и опорные балки. Лужи хмеля убраны, новые дубовые распорки встали как влитые — теперь бочки можно ставить без малейшего страха, что настил провалится.'

    elseif $TavernDayEventTextId = 'carryover_rats_morning':
        $TavernDayEventText = 'Со вчерашнего дня кладовая так и стоит разбитой: крысиные норы не заделаны, запах испорченной муки продолжает сочиться в зал, а Сандра с самого утра в бешенстве пинает покосившийся ларь.'

    elseif $TavernDayEventTextId = 'carryover_rats_hall':
        $TavernDayEventText = 'Вчерашнее нашествие крыс всё ещё отравляет жизнь трактиру: полки в кладовой перекошены, гости брезгливо принюхиваются, а персонал работает на грани срыва. Пока не пригласите Драупнира, заведение будет нести убытки.'

    elseif $TavernDayEventTextId = 'carryover_rats_end':
        $TavernDayEventText = 'Ещё один день подошёл к концу, а кладовую так никто и не починил. Затхлый дух, испорченная репутация и глухое раздражение гостей копятся с каждым часом — ремонт нельзя больше откладывать.'

    elseif $TavernDayEventTextId = 'carryover_brawl_morning':
        $TavernDayEventText = 'После вчерашнего побоища зал так и остался в запустении. Треснувшая стойка угрожающе поскрипывает при каждом облокачивании, а расколотая мебель напоминает гостям, что хозяин пожалел денег на столяра.'

    elseif $TavernDayEventTextId = 'carryover_brawl_hall':
        $TavernDayEventText = 'Зал выглядит откровенно потрёпанным и заброшенным. Посетители с усмешкой разглядывают зарубки и трещины на стойке — без руки Драупнира «Дикий Жеребец» с каждым часом теряет приличный вид и гостей.'

    elseif $TavernDayEventTextId = 'carryover_brawl_end':
        $TavernDayEventText = 'Очередной день прошёл без ремонта после драки. Зал производит удручающее впечатление, почтенные горожане обходят трактир стороной, а чинить мебель рано или поздно всё равно придётся.'

    elseif $TavernDayEventTextId = 'carryover_broken_morning':
        $TavernDayEventText = 'Со вчерашней аварии в подвале так и не просохло: полки шатаются, а кислый запах пролитого пива стал ещё резче. Пока бочонки стоят на честном слове, запасы напитков в любой момент могут рухнуть на пол.'

    elseif $TavernDayEventTextId = 'carryover_broken_hall':
        $TavernDayEventText = 'Из подвала продолжает тянуть тяжёлым пивным перегаром, а подвальная лестница ходит ходуном под сапогами. Без помощи столяра заведение работает исключительно на голом везении.'

    elseif $TavernDayEventTextId = 'carryover_broken_end':
        $TavernDayEventText = 'Подвал так и остался аварийным. Потери от лопнувшей бочки наложились на испорченное впечатление гостей и новые расходы — затягивать с визитом к столяру становится попросту опасно.'

    elseif $TavernDayEventTextId = 'delicious_kitchen_morning':
        $TavernDayEventText = 'С раннего утра из кухни тянет упоительным, сытным ароматом: Сандра пустила в дело душистые заморские пряности. Запечённое мясо шкворчит в травах, густой наваристый бульон манит пряным духом, который слышен далеко за порогом. Горожане и проезжие купцы с улицы уже заглядывают в окна, предвкушая сытный обед.'

    elseif $TavernDayEventTextId = 'delicious_kitchen_hall':
        $TavernDayEventText = 'В зале шумно, но сегодня этот шум — от чистого удовольствия. Гости с волчьим аппетитом уплетают пряную похлёбку, макают свежий хлеб в густую подливу и довольно чокаются кружками. То и дело слышатся тосты за здоровье поварихи и щедрый стол «Дикого Жеребца».'

    elseif $TavernDayEventTextId = 'delicious_kitchen_evening':
        $TavernDayEventText = 'К вечеру котлы выскребли дочиста, а касса заметно потяжелела от сытых серебряных монет. Сандра, разрумянившаяся и довольная похвалами, вытирает фартук с гордой улыбкой хозяйки.'

    elseif $TavernDayEventTextId = 'delicious_kitchen_end':
        $TavernDayEventText = 'День пряной кухни прошёл с оглушительным успехом. Сытые гости разошлись по городу с добрыми вестями о великолепном столе в трактире Стефана. Репутация заведения заметно подросла.'

    elseif $TavernDayEventTextId = 'tavern_praise_morning':
        $TavernDayEventText = 'С утра в трактир заглянула солидная купеческая гильдия вместе с городскими мастерами. Они заняли лучшие столы у камина, нахваливают чистый зал, свежесть солода и гостеприимство молодого хозяина.'

    elseif $TavernDayEventTextId = 'tavern_praise_hall':
        $TavernDayEventText = 'За столами царит душевная, тёплая атмосфера. Довольные завсегдатаи и почтенные торговцы поднимают кружки за процветание трактира, оставляют щедрые чаевые и громко спорят лишь о том, чья кружка полнее.'

    elseif $TavernDayEventTextId = 'tavern_praise_evening':
        $TavernDayEventText = 'Вечер завершился в благостном согласии. Гости расходились сытыми и весёлыми, благодаря Стефана и девушек за образцовый порядок и радушие.'

    elseif $TavernDayEventTextId = 'tavern_praise_end':
        $TavernDayEventText = 'День искренней похвалы принёс трактиру прекрасную выручку, рост уважения среди горожан и добрые чаевые для девушек.'

    elseif $TavernDayEventTextId = 'staff_busy_talk':
        if time = 4 and TavernStaffTiredEvening = 1:
            $TavernDayEventText = '— Не сейчас, Стефан, — тяжело вздыхает она, опираясь о край стола. — После такого сумасшедшего дня я буквально валюсь с ног.'
        else:
            $TavernDayEventText = '— Потом, Стефан, ради Ильматера, потом! — на ходу бросает она, балансируя тяжёлым подносом. — В зале такой завал, что некогда даже дух перевести!'
        end
    end

    killvar '$TavernDayEventTextId'
