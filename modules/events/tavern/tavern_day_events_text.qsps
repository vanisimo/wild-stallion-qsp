! ================================================
! FILE: modules/events/tavern/tavern_day_events_text.qsps
! MODULE: events/tavern
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! Тексты дневных нейтральных событий таверны
! ================================================

#TavernDayEventText
    $TavernDayEventTextId = LCASE($ARGS[0])
    $TavernDayEventText = ''

    if $TavernDayEventTextId = 'caravan_morning':
        $TavernDayEventText = 'С самого рассвета у ворот грохочут тяжёлые телеги, ржут упряжные лошади, а в двери валом валят запыленные купцы и бородатые возчики. Зал мигом забился чужими людьми, на дубовые столы с глухим стуком падают тяжёлые кружки, а на стойке звенит серебро. Аманда на ходу одёргивает короткую юбку, Мелисса ловко расставляет глиняные кувшины прямо перед носами гостей, а Сандра у печи едва успевает орудовать черпаком. Сегодня никому не до праздных бесед — весь трактир крутится вокруг проезжего каравана.'

    elseif $TavernDayEventTextId = 'caravan_hall':
        if FamilyCorruptionStage >= 4:
            $TavernDayEventText = 'Зал гудит от хмельных криков купцов. Аманда нарочно плавно покачивает бёдрами между лавок; когда захмелевший торговец звонко шлёпает её ниже пояса, она лишь хихикает, прячет полученную монету в глубокий вырез платья и стреляет глазами в сторону Стефана, проверяя, видит ли он её обтянутый зад. Мелисса, наклоняясь над столом, нарочно задерживается, дразня гостей ложбинкой груди, а Сандра спокойно принимает знаки внимания, поправляя тугой лиф прямо у раздачи.'
        elseif FamilyCorruptionStage >= 2:
            $TavernDayEventText = 'Купцы и возчики шумят на весь зал, требуя вина и похлёбки. Аманда подаёт кружки с лёгкой усмешкой, поправляя вырез платья и не слишком спеша отстраняться, когда чужая ладонь скользит опасно близко к её бедру. Мелисса с невозмутимым видом ловко перехватывает монеты прямо со стола, бросая на Стефана лукавые взгляды, а Сандра вытирает влажные ладони о передник, зорко наблюдая за набитым залом.'
        else:
            $TavernDayEventText = 'У распахнутых ворот стоят повозки каравана, а в зале яблоку негде упасть: купцы и возчики хрипло требуют добавка, стучат кружками по дубовым столам и громко спорят о ценах на шерсть и зерно. Девушки только и успевают лавировать между лавками с полными подносами, уворачиваясь от грубых рук. На лицах — сосредоточенная усталость: сегодня трактир работает на пределе возможностей, и о личных разговорах можно даже не думать.'
        end

    elseif $TavernDayEventTextId = 'caravan_evening':
        $TavernDayEventText = 'Караван наконец снялся с постоя, оставив за собой горы грязной посуды, липкие столы и гудящую пустоту. Девушки совершенно вымотаны после сумасшедшего дня: Аманда без сил опустилась на лавку, вытянув гудящие ноги, Мелисса массирует затёкшие пальцы, а Сандра тяжело опирается о стойку. На любые попытки заговорить они лишь вымученно улыбаются.'

    elseif $TavernDayEventTextId = 'caravan_end':
        $TavernDayEventText = 'Шумный день караванного постоя подошёл к концу. Пусть девушки выбились из сил, а в зале предстоит долгая уборка, зато кошель на поясе Стефана приятно потяжелел от монет, а караванщики понесут добрую молву о сытном приёме в «Диком Жеребце» дальше по тракту.'

    elseif $TavernDayEventTextId = 'rats_morning':
        $TavernDayEventText = 'Утро началось со звона разбитой миски на кухне: Сандра с грохотом распахнула дверь подвала. Серые твари прогрызли холщовые мешки, рассыпали белую муку по камням и попортили добрый кусок копчёного сала. Сандра в ярости сжимает скалку, сверкая глазами на всю таверну, а девушки спешно подбирают юбки и с опаской заглядывают в тёмный угол кладовой, спасая уцелевшие головки сыра.'

    elseif $TavernDayEventTextId = 'rats_hall':
        $TavernDayEventText = 'В зале висит нервная обстановка: до гостей то и дело долетает сердитый голос Сандры из кухни, порции сегодня скромнее обычного, а из приоткрытого люка кладовой доносятся ругательства. Посетители косятся на треснувшие ящики и недовольно стучат ложками. Аманда нервно оглядывается на каждый шорох под половицами, прижимая поднос к груди, а Мелисса старается быстрее разносить кружки, отвлекая гостей от задержек.'

    elseif $TavernDayEventTextId = 'rats_hall_repair_pending':
        $TavernDayEventText = 'Ремонт кладовой уже согласован: столяр Драупнир обещал прийти с инструментом к вечеру. В подвале пока ещё видны следы зубов на досках, но Сандра уже опустила скалку и спокойно месит тесто, ожидая прихода мастера.'

    elseif $TavernDayEventTextId = 'rats_hall_repaired':
        $TavernDayEventText = 'Драупнир на совесть подлатал кладовую: гнилые доски заменены крепким дубом, щели наглухо забиты железными скобами, а тяжёлые полки теперь стоят как влитые. Сандра удовлетворённо осматривает углы, уперев руки в бока, и трактир возвращается к привычному ритму.'

    elseif $TavernDayEventTextId = 'rats_repair_hint':
        $TavernDayEventText = 'Лари в кладовой перекошены, а доски у пола изгрызены крысами — своими силами тут не справиться. Стоит заглянуть в квартал ремесленников к столяру Драупниру: старый мастер знает, как укрепить дерево намертво, хотя за работу наверняка запросит полновесную плату.'

    elseif $TavernDayEventTextId = 'rats_brawl':
        $TavernDayEventText = 'К вечеру нервозность переросла в настоящую беду: захмелевшие завсегдатаи устроили громкую перебранку из-за скверной похлёбки и подсохшего хлеба. Слово за слово — и в ход пошли кулаки и глиняные кружки. Прежде чем удалось растащить драчунов, один из столов разнесли в щепки, перебив кучу посуды и распугав гостей.'

    elseif $TavernDayEventTextId = 'rats_end_repaired':
        $TavernDayEventText = 'Крысиный набег потрепал нервы и запасы, однако Драупнир успел вовремя заколотить лазейки и укрепить полки. Дальнейших бед удалось избежать, и завтра кладовая встретит день в полной готовности.'

    elseif $TavernDayEventTextId = 'rats_end_unrepaired':
        $TavernDayEventText = 'Тяжёлый, убыточный день подошёл к концу. Крысы попортили добрую долю припасов, в зале едва не учинили погром, а кладовая так и осталась разбитой и расшатанной. Если не пригласить столяра, завтра убытки снова дадут о себе знать.'

    elseif $TavernDayEventTextId = 'brawl_morning':
        $TavernDayEventText = 'Утро в зале встретило картиной погрома: массивная дубовая лавка расколота надвое, у стойки зияет свежая трещина от брошенной кружки, а на полу темнеют сколы древесины. Несколько хмурых наёмников с помятыми физиономиями сидят в углу, злобно поглядывая друг на друга и сжимая рукояти кинжалов.'

    elseif $TavernDayEventTextId = 'brawl_hall':
        if FamilyCorruptionStage >= 4:
            $TavernDayEventText = 'Следы ночного побоища ничуть не смущают девушек. Аманда грациозно перешагивает через обломки лавки, нарочно приподнимая подол и обнажая стройные бёдра; она ловит взгляд Стефана на своей попке и лукаво подмигивает. Мелисса выметает черепки из-под ног гостей с язвительной усмешкой, а Сандра опирается о надтреснутую стойку, выставив вперёд пышную грудь и с вызовом поглядывая на задир.'
        elseif FamilyCorruptionStage >= 2:
            $TavernDayEventText = 'В зале ещё чувствуется напряжение недавней драки. Аманда ловко обходит треснувшую мебель, прижимая поднос к боку и стреляя глазами по углам. Мелисса осторожно сметает черепки в совок, насмешливо косясь на помятых наёмников, а Сандра то и дело поправляет передник, держа под рукой тяжёлый черпак.'
        else:
            $TavernDayEventText = 'В зале висит настороженная тишина. Персонал спешно выметает глиняные черепки из-под ног, стараясь не привлекать внимания задир. Гости сидят тише воды, перешёптываясь по углам, а пошатнувшаяся стойка красноречиво свидетельствует о размахе вчерашнего побоища.'
        end

    elseif $TavernDayEventTextId = 'brawl_hall_repair_pending':
        $TavernDayEventText = 'Драупнир уже получил задаток и обещал явиться с пилой и рубанком к вечеру. И хотя стойка пока держится на деревянном клине, а сломанные стулья сложены у стены, на душе спокойнее: мастер вернёт залу подобающий вид.'

    elseif $TavernDayEventTextId = 'brawl_repair_hint':
        $TavernDayEventText = 'Барная стойка дала глубокую трещину, а разбитые стулья грозят вот-вот развалиться под очередным посетителем. Без хорошего столяра тут не обойтись: мастер Драупнир из квартала ремесленников быстро вернёт мебели крепость, если не пожалеть монет за работу.'

    elseif $TavernDayEventTextId = 'brawl_end_repaired':
        $TavernDayEventText = 'Драка влетела трактиру в добрую копеечку, однако Драупнир сработал на совесть. Стойка стянута коваными железными скобами, ножки столов подогнаны, и к вечеру зал вновь обрёл надёжный вид.'

    elseif $TavernDayEventTextId = 'brawl_end_unrepaired':
        $TavernDayEventText = 'Побоище оставило глубокие шрамы на дереве и заметную брешь в кассе. Треснувшая мебель и шатающаяся стойка завтра снова встретят гостей укоризненным скрипом.'

    elseif $TavernDayEventTextId = 'guard_morning':
        $TavernDayEventText = 'С утра под окнами послышался мерный лязг кованых сапог и железа: в двери уверенно ввалился наряд городской стражи. Сержант с каменным лицом окинул взглядом стойку, придирчиво осмотрел углы и шуршит бумагами с городскими печатями, положив ладонь в латной перчатке на эфес тесака.'

    elseif $TavernDayEventTextId = 'guard_hall_pass':
        $TavernDayEventText = 'Стражники неспешно обходят зал, заглядывая за бочки и проверяя чистоту столов. Порядок и уверенный вид хозяина охлаждают их служебное рвение: сержант скупо кивает, прячет свиток в кожаную сумку и хлопает Стефана по плечу.'

    elseif $TavernDayEventTextId = 'guard_hall_fine':
        $TavernDayEventText = 'Сержант стражи кривит губы, тычет перчаткой в запыленный угол и громко возмущается состоянием кладовой и шумом в зале. По его цепкому взгляду сразу ясно: блюстителю закона нужен не порядок, а жирный штраф в пользу казны — или собственный карман.'

    elseif $TavernDayEventTextId = 'guard_end_pass':
        $TavernDayEventText = 'Проверка стражи закончилась благополучно: сержант убедился, что закон не нарушен, осушил за счёт заведения кружку светлого эля, вытер усы и увёл людей прочь. «Дикий Жеребец» укрепил репутацию благонадёжного места.'

    elseif $TavernDayEventTextId = 'guard_end_fine':
        $TavernDayEventText = 'Визит стражи обернулся горьким унижением и убытком. Сержант громогласно отчитал трактирщика при всех гостях, составил придирчивую кляузу и выписал грабительский штраф. Посетители ещё долго шептались о визите властей.'

    elseif $TavernDayEventTextId = 'harvest_morning':
        $TavernDayEventText = 'Весь город с утра гудит: наступил праздник урожая! Ворота украшены венками из спелых колосьев пшеницы. Нарядные горожане и крестьяне из окрестных деревень валом валят в трактир, стремясь отметить щедрый год за доброй кружкой. Аманда уже приколола к лифу полевой цветок, Мелисса проверяет чистые стопки кружек, а Сандра ставит в печь противни со свежей сдобой.'

    elseif $TavernDayEventTextId = 'harvest_hall':
        if FamilyCorruptionStage >= 4:
            $TavernDayEventText = 'Праздничный угар захлестнул зал с головой. За столами гремят песни и тосты за богатый сбор. Аманда в открытую дразнит подвыпивших крестьян: плавно покачивает бёдрами в такт музыке, позволяет ущипнуть себя за попку за щедрую монету и бросает на Стефана томный взгляд, прикусив губу. Мелисса с насмешливой улыбкой забирает серебро с подносов, нарочно наклоняясь перед гостями так, чтобы в вырезе была видна грудь, а Сандра подливает вина самым щедрым постояльцам, поправляя тесный лиф.'
        elseif FamilyCorruptionStage >= 2:
            $TavernDayEventText = 'В зале шумно и весело: за столами звучат праздничные здравицы и тосты. Аманда с сияющими глазами лавирует между рядов, поправляя вырез платья и со смехом уворачиваясь от чересчур смелых рук гостей. Мелисса ловко ссыпает чаевые в кармашек передника, бросая на Стефана понимающие взгляды, а Сандра с гордым видом разносит горячие пироги.'
        else:
            $TavernDayEventText = 'Зал трещит по швам: за столами звучат праздничные здравицы, тосты за богатый сбор и весёлые песни. Девушки с быстрыми улыбками едва успевают разносить полные кувшины, ловя на себе одобрительные взгляды и получая щедрые чаевые.'
        end

    elseif $TavernDayEventTextId = 'harvest_end':
        $TavernDayEventText = 'Праздник урожая удался на славу: бочки опустели, мясо съедено до последнего ломтя, а выручка в кассе греет душу увесистой тяжестью. Трактир показал себя гостеприимным и хлебосольным, заслужив искреннее уважение горожан.'

    elseif $TavernDayEventTextId = 'minstrels_morning':
        if TavernUpgradeStageDone = 1:
            $TavernDayEventText = 'С самого утра в трактире звучат переливы струн и звон бубна: в зале обосновалась ватага бродячих менестрелей. Они с благодарностью заняли новую дубовую сцену в углу зала, расчехлив лютни, флейты и смычки, настраивают лады и притягивают к подмосткам толпу любопытных горожан со всей улицы.'
        else:
            $TavernDayEventText = 'С самого утра в трактире звучат переливы струн и звон бубна: в зале обосновалась ватага бродячих менестрелей. Разложив лютни, флейты и смычки на лучшем столе у камина, они настраивают лады, распеваются и притягивают в зал толпу зевак со всей улицы.'
        end

    elseif $TavernDayEventTextId = 'minstrels_hall':
        if FamilyCorruptionStage >= 3:
            if TavernUpgradeStageDone = 1:
                $TavernDayEventText = 'На дубовой сцене менестрели поют звонкую балладу, срывая бурные крики. Но главное представление происходит у стойки: Мелисса застыла с кувшином в руках, часто и прерывисто дыша под звуки голоса молодого барда. Её щеки пылают, тонкие пальцы стискивают ткань фартука, а бедра под юбкой едва заметно сжимаются. Она бросает на Стефана виноватый, влажный взгляд, полный горячего смущения от собственной мокрой слабости, и спешно одёргивает подол. Аманда тем временем с задорным смехом покачивает бёдрами в такт музыке, подзадоривая захмелевших слушателей.'
            else:
                $TavernDayEventText = 'Под балками льётся звонкая баллада. Мелисса замерла посреди зала с подносом: от вида и голоса кудрявого менестреля у неё перехватило дух. Она часто дышит, прикусив губу, бёдра под тканью юбки сжаты, а на Стефана она смотрит с влажным, виноватым блеском в глазах — эта музыка будит в ней дрожь между ног, с которой она не может совладать. Аманда весело подпевает запеву, крутя юбкой перед столиками.'
            end
        else:
            if TavernUpgradeStageDone = 1:
                $TavernDayEventText = 'На новой дубовой сцене в углу зала вовсю играют бродячие менестрели. Под высокими балками разносится звонкая баллада о рыцарях и дальних странствиях. Гости воодушевленно подпевают в такт, барабаня кружками по дубовым столам и требуя ещё вина. Благодаря помосту столы для посетителей свободны, а музыка звучит торжественно на весь зал.'
            else:
                $TavernDayEventText = 'Под высокими балками разносится звонкая баллада о рыцарях и дальних странствиях. Гости воодушевленно подпевают в такт, барабаня кружками по дубовым столам и требуя ещё вина. В зале царит редкое оживление, а девушки с улыбками разносят выпивку.'
            end
        end

    elseif $TavernDayEventTextId = 'minstrels_end':
        if TavernUpgradeStageDone = 1:
            $TavernDayEventText = 'Менестрели отыграли свой репертуар на сцене на славу, сорвав бурю рукоплесканий и заметно оживив торговлю вином и элем. Музыканты от души поблагодарили хозяина за прекрасный помост, гости разошлись в великолепном настроении, а день принёс отличную выручку.'
        else:
            $TavernDayEventText = 'Менестрели отыграли свой репертуар на славу, сорвав бурю рукоплесканий и заметно оживив торговлю элем. Гости разошлись с прекрасным настроением, а день оставил после себя приятное ощущение весёлой кутерьмы и неплохую прибыль.'
        end

    elseif $TavernDayEventTextId = 'storm_morning':
        $TavernDayEventText = 'Небо затянуло свинцовыми тучами, и над городом разразился шторм. Холодный ливень хлещет по черепице, превращая мостовую в потоки серой грязи. Улицы опустели, и лишь редкие путники, насквозь промокшие и озябшие, торопливо стучат в двери трактира в поисках сухого угла у огня.'

    elseif $TavernDayEventTextId = 'storm_hall':
        $TavernDayEventText = 'За мутными стёклами хлещет стена дождя, а в зале царит сонный, размеренный покой. В очаге весело потрескивают сухие поленья, разбрасывая золотистые искры. Немногие завсегдатаи не торопятся уходить, неспешно цедя эль и слушая рокот грома. Аманда присела на краешек лавки, поглаживая колено, Мелисса не торопясь натирает льняной ветошью кружки, а Сандра подкладывает дрова в печь.'

    elseif $TavernDayEventTextId = 'storm_end':
        $TavernDayEventText = 'Непогода отрезала трактир от широкого потока гостей, зато верные посетители провели за кружками весь день, укрываясь от ненастья. День прошёл на редкость мирно и без потрясений, дав передышку всем работницам.'

    elseif $TavernDayEventTextId = 'pilgrims_morning':
        $TavernDayEventText = 'В город вошла группа паломников в грубых серых власяницах — смиренные странники, следующие по святому пути Ильматера Всеблагого. Опираясь на узловатые посохи, они благоговейно очертили перед грудью знак священного Круга у порога и робко попросили горячей похлёбки и хлеба за ту малую медную монетку, что у них осталась. Их строгие, исполненные веры взгляды словно проверяют душу и совесть хозяина.'

    elseif $TavernDayEventTextId = 'pilgrims_hall':
        $TavernDayEventText = 'В дальнем углу зала чинно сидят паломники Ильматера. Положив на лавки посохи, они тихо шепчут молитвы, очерчивают знак святого Круга над скромными деревянными мисками и преломляют поданный хлеб. Буйные гуляки невольно притихают под их праведными взглядами, а Аманда и Мелисса бесшумно разносят воду, ведя себя подчёркнуто скромно.'

    elseif $TavernDayEventTextId = 'pilgrims_end':
        $TavernDayEventText = 'Паломники Ильматера покинули трактир, вознеся благословение дому Стефана за приют и милосердие. Монет от них перепало немного, но весть о добродетели трактирщика быстро разнеслась среди прихожан и городской церкви, прибавив доброй славы «Дикому Жеребцу».'

    elseif $TavernDayEventTextId = 'broken_morning':
        $TavernDayEventText = 'Ночью в подвале стряслась беда: не выдержали старые железные обручи, и дубовая бочка с отборным элем с треском лопнула. Пенный хмель залил каменный пол, а тяжёлые клёпки при падении погнули соседние полки. Сандра утром лишь всплеснула руками от досады: часть драгоценных запасов напитков утекла в щели между камней.'

    elseif $TavernDayEventTextId = 'broken_hall':
        $TavernDayEventText = 'Стойка и нижние ступени подвальной лестницы расшатались после ночной суматохи, когда спасали уцелевшие бочонки. Сандра то и дело выходит с кухни, вытирая мокрые руки о передник, а Мелисса с озабоченным видом сверяет оставшиеся кувшины в гроссбухе. Без крепкой руки столяра наводить порядок здесь будет сущим мучением.'

    elseif $TavernDayEventTextId = 'broken_hall_repair_pending':
        $TavernDayEventText = 'Драупнир получил заказ и дал слово подойти к вечеру со смолой, зажимами и новыми дубовыми брусьями. Пока полки ещё перекошены, но Сандра уже перестала браниться, а девушки спокойно наливают гостям из уцелевших бочонков.'

    elseif $TavernDayEventTextId = 'broken_repair_hint':
        $TavernDayEventText = 'Опоры под бочками прогнулись, а полки в погребе грозят рухнуть под тяжестью оставшихся кувшинов. Нужно срочно наведаться в ремесленный квартал к столяру Драупниру: старый гном быстро укрепит настил и заменит лопнувшие балки.'

    elseif $TavernDayEventTextId = 'broken_end_repaired':
        $TavernDayEventText = 'Потеря бочки обошлась недёшево, но благодаря умелым рукам Драупнира подвал снова в полной безопасности. Новые дубовые подпорки встали намертво, лужи вычерпаны, и за уцелевшие запасы теперь можно не опасаться.'

    elseif $TavernDayEventTextId = 'broken_end_unrepaired':
        $TavernDayEventText = 'Убыточный день подошёл к концу, а подвал так и остался в аварийном состоянии. Перекошенные балки и скользкие камни будут и дальше угрожать запасам, если не позвать столяра.'

    elseif $TavernDayEventTextId = 'thief_morning':
        $TavernDayEventText = 'Утренняя ревизия принесла скверную весть: ночью через хлипкое окно со стороны заднего двора в кладовую пробрался вор. Пропал целый мешок муки высшего сорта и пара кувшинов доброго южного вина, а на влажной земле у забора остались чужие следы сапог. Сандра сжимает кулаки у пустого ларя, а Мелисса спешно проверяет засовы.'

    elseif $TavernDayEventTextId = 'thief_hall':
        $TavernDayEventText = 'По залу ползут тревожные шепотки: персонал на взводе, Сандра с яростным видом пересчитывает каждую краюху и банку, а взгляды девушек на подозрительных гостей в плащах стали настороженными и колючими. Спокойствие в доме нарушено.'

    elseif $TavernDayEventTextId = 'thief_end':
        $TavernDayEventText = 'Ночная кража неприятно ударила по припасам и оставила мерзкий осадок. Пришлось спешно навешивать тяжёлые амбарные замки на заднюю дверь и подвальные ставни, чтобы отвадить любителей лёгкой наживы.'

    elseif $TavernDayEventTextId = 'carpenter_visit_rats':
        $TavernDayEventText = 'Драупнир молча осматривает кладовую: ощупывает зазубренные доски, тычет толстым пальцем в расшатанные полки и сплёвывает под ноги. — Держать будет, если с умом перебрать и закрепить прямо сейчас, — хрипло бурчит старый гном. — Плати — и к вечеру зайду в трактир со скобами и рубанком, сам всё подгоню.'

    elseif $TavernDayEventTextId = 'carpenter_visit_brawl':
        $TavernDayEventText = 'Драупнир хмуро оглядывает трещину в дубовой стойке и расколотый стул. — В следующий раз пусть на кулаках за воротами меряются, — ворчит он, постукивая обухом молотка по столешнице. — Зал я тебе стяну, но работа не пятиминутная. Оплати заказ — к вечеру сам приду со снаряжением и всё сделаю.'

    elseif $TavernDayEventTextId = 'carpenter_visit_broken':
        $TavernDayEventText = 'Драупнир спускается в подвал, тычет молотком в намокшую, прогнувшуюся полку и качает косматой головой. — Тяжёлую бочку вам не удержать, пока балки гнилые, а крепления шатаются, — говорит он. — Заплати — вечером приду и намертво укреплю весь настил.'

    elseif $TavernDayEventTextId = 'carpenter_no_money':
        $TavernDayEventText = '— Без звонкой монеты работы не будет, — отрезает Драупнир, скрещивая руки на груди. — До вечера так всё и простоит: гости косятся, девки нервничают, а слава заведения тает. Потянешь время — ещё и стол рухнет или драка вспыхнет. Заработай на ремонт или готовься подсчитывать убытки.'

    elseif $TavernDayEventTextId = 'carpenter_refuse':
        $TavernDayEventText = 'Ты решаешь повременить с ремонтом. Драупнир равнодушно пожимает плечами: — Твоё дело, хозяин. Только потом не жалуйся, когда полка с кувшинами с грохотом осыплется или гости начнут плеваться. До конца дня трактир останется в таком виде — и лучше ему от ожидания точно не станет.'

    elseif $TavernDayEventTextId = 'carpenter_order_confirm':
        $TavernDayEventText = 'Драупнир скупо кивает, сгребает монеты широкой ладонью и прячет в кожаный кошель. — Договорились. К вечеру загляну в «Дикий Жеребец» и приведу зал и подвал в полный порядок. До тех пор сам в крепления не лезь — только дерево попортишь.'

    elseif $TavernDayEventTextId = 'carpenter_already_ordered':
        $TavernDayEventText = 'Драупнир уже принял задаток и даже слышать не хочет лишних расспросов. — Сказано же: к вечеру буду, — недовольно бурчит он из-за верстака. — Иди в свой трактир и жди мастера, не маячь перед глазами.'

    elseif $TavernDayEventTextId = 'carpenter_evening_rats':
        $TavernDayEventText = 'К вечеру в главный зал неторопливо заходит Драупнир с тяжёлым ящиком инструментов. Стук молотка, визг пилы — и спустя час полки в кладовой снова стоят ровно и несокрушимо. Сандра облегчённо опускает руки на пояс, а посетители забывают о крысиных проделках.'

    elseif $TavernDayEventTextId = 'carpenter_evening_brawl':
        $TavernDayEventText = 'Драупнир появляется в зале с набором железных скоб и без лишних слов принимается за дело. Уверенные удары, подгонка клиньев — и вот уже стойка монолитна, а стулья не шатаются под рукой. Когда гном собирает инструмент, зал снова выглядит опрятно и надёжно.'

    elseif $TavernDayEventTextId = 'carpenter_evening_broken':
        $TavernDayEventText = 'Вечером Драупнир основательно укрепляет подвальные перекрытия и опорные балки. Лужи вычерпаны, новые дубовые распорки встали как влитые — теперь бочки можно ставить без малейшего страха, что настил провалится.'

    elseif $TavernDayEventTextId = 'carryover_rats_morning':
        $TavernDayEventText = 'Со вчерашнего дня кладовая так и стоит разбитой: крысиные лазейки не заделаны, испорченная мука рассыпана по углам, а Сандра с самого утра в бешенстве пинает покосившийся ларь.'

    elseif $TavernDayEventTextId = 'carryover_rats_hall':
        $TavernDayEventText = 'Вчерашнее нашествие крыс всё ещё отравляет жизнь трактиру: полки в кладовой перекошены, гости брезгливо разглядывают подаваемые миски, а персонал работает на грани срыва. Пока не позовёшь Драупнира, заведение будет нести убытки.'

    elseif $TavernDayEventTextId = 'carryover_rats_end':
        $TavernDayEventText = 'Ещё один день подошёл к концу, а кладовую так никто и не починил. Испорченная репутация и глухое раздражение гостей копятся с каждым часом — ремонт нельзя больше откладывать.'

    elseif $TavernDayEventTextId = 'carryover_brawl_morning':
        $TavernDayEventText = 'После вчерашнего побоища зал так и остался в запустении. Треснувшая стойка угрожающе поскрипывает при каждом облокачивании, а расколотая мебель напоминает гостям, что хозяин пожалел денег на столяра.'

    elseif $TavernDayEventTextId = 'carryover_brawl_hall':
        $TavernDayEventText = 'Зал выглядит откровенно потрёпанным. Посетители с усмешкой разглядывают зарубки и трещины на стойке — без руки Драупнира «Дикий Жеребец» с каждым часом теряет приличный вид и гостей.'

    elseif $TavernDayEventTextId = 'carryover_brawl_end':
        $TavernDayEventText = 'Очередной день прошёл без ремонта после драки. Зал производит удручающее впечатление, почтенные горожане обходят трактир стороной, а чинить мебель рано или поздно всё равно придётся.'

    elseif $TavernDayEventTextId = 'carryover_broken_morning':
        $TavernDayEventText = 'Со вчерашней аварии в подвале так и не навели порядок: полки шатаются, а пролитый эль липнет к сапогам. Пока бочонки стоят на честном слове, запасы напитков в любой момент могут рухнуть на пол.'

    elseif $TavernDayEventTextId = 'carryover_broken_hall':
        $TavernDayEventText = 'Из подвала доносится скрип просевших балок, а подвальная лестница ходит ходуном под сапогами. Без помощи столяра заведение работает исключительно на голом везении.'

    elseif $TavernDayEventTextId = 'carryover_broken_end':
        $TavernDayEventText = 'Подвал так и остался аварийным. Потери от лопнувшей бочки наложились на испорченное впечатление гостей и новые расходы — затягивать с визитом к столяру становится попросту опасно.'

    elseif $TavernDayEventTextId = 'delicious_kitchen_morning':
        $TavernDayEventText = 'С раннего утра кухня гудит от работы: Сандра пустила в дело отборные куски свинины и свежие травы. Мясо весело шкворчит на вертеле, подрумяниваясь над углями, а густая наваристая похлёбка булькает в котле. Сандра с гордым видом пробует соус с деревянной ложки, облизывая губы. Прохожие с улицы уже заглядывают в окна, предвкушая сытный обед.'

    elseif $TavernDayEventTextId = 'delicious_kitchen_hall':
        if FamilyCorruptionStage >= 4:
            $TavernDayEventText = 'В зале яблоку негде упасть: гости с волчьим аппетитом уплетают запечённое мясо, макают хлеб в подливу и чокаются кружками. Сандра лично выходит в зал проверить раздачу: фартук обтягивает её полные бедра, глубокий вырез лифа приоткрывает пышную грудь, на которой блестят капельки пота. Гости сыплют серебро прямо ей в руки, а она с довольной улыбкой принимает похвалу, ловя горячий взгляд Стефана.'
        elseif FamilyCorruptionStage >= 2:
            $TavernDayEventText = 'В зале шумно, и этот шум — от сытого удовольствия. Гости наперебой требуют добавки, вытирая усы и довольно крякая над мисками. Сандра с румянцем на щеках выносит новые блюда, поправляя вырез платья и гордо поглядывая на Стефана: её стряпня сегодня покорила весь трактир.'
        else:
            $TavernDayEventText = 'В зале шумно, но сегодня этот шум — от чистого удовольствия. Гости с волчьим аппетитом уплетают похлёбку, макают свежий хлеб в густую подливу и довольно чокаются кружками. То и дело слышатся тосты за здоровье поварихи и щедрый стол «Дикого Жеребца».'
        end

    elseif $TavernDayEventTextId = 'delicious_kitchen_evening':
        $TavernDayEventText = 'К вечеру котлы выскребли дочиста, а касса заметно потяжелела от сытых серебряных монет. Сандра, разрумянившаяся и довольная похвалами, вытирает фартук с гордой улыбкой хозяйки.'

    elseif $TavernDayEventTextId = 'delicious_kitchen_end':
        $TavernDayEventText = 'День отменной кухни прошёл с оглушительным успехом. Сытые гости разошлись по городу с добрыми вестями о великолепном столе в трактире Стефана. Репутация заведения заметно подросла.'

    elseif $TavernDayEventTextId = 'tavern_praise_morning':
        $TavernDayEventText = 'С утра в трактир заглянула солидная купеческая гильдия вместе с городскими мастерами. Они заняли лучшие столы у камина, нахваливают чистый зал, добрый солод и гостеприимство молодого хозяина.'

    elseif $TavernDayEventTextId = 'tavern_praise_hall':
        if FamilyCorruptionStage >= 4:
            $TavernDayEventText = 'За столами царит вальяжная атмосфера. Почтенные торговцы и мастера поднимают кружки за процветание трактира и щедро осыпают монетами девушек. Аманда грациозно наклоняется над столами, дразня стариков вырезом платья и легко касаясь их плеч; Мелисса насмешливо сгребает серебро, а гости с одобрительными ухмылками перемигиваются со Стефаном, признавая, что в этом доме умеют ублажить гостя во всех смыслах.'
        elseif FamilyCorruptionStage >= 2:
            $TavernDayEventText = 'За столами царит душевная атмосфера. Довольные завсегдатаи и почтенные торговцы поднимают кружки за процветание трактира, оставляют щедрые чаевые и громко нахваливают девушек. Аманда и Мелисса с румянцем на щеках ловко разносят напитки, с улыбкой переглядываясь со Стефаном.'
        else:
            $TavernDayEventText = 'За столами царит душевная, тёплая атмосфера. Довольные завсегдатаи и почтенные торговцы поднимают кружки за процветание трактира, оставляют щедрые чаевые и громко спорят лишь о том, чья кружка полнее.'
        end

    elseif $TavernDayEventTextId = 'tavern_praise_evening':
        $TavernDayEventText = 'Вечер завершился в благостном согласии. Гости расходились сытыми и весёлыми, благодаря Стефана и девушек за образцовый порядок и радушие.'

    elseif $TavernDayEventTextId = 'tavern_praise_end':
        $TavernDayEventText = 'День искренней похвалы принёс трактиру прекрасную выручку, рост уважения среди горожан и добрые чаевые для девушек.'

    elseif $TavernDayEventTextId = 'staff_busy_talk':
        if time = 4 and TavernStaffTiredEvening = 1:
            $TavernDayEventText = '— Не сейчас, Стефан, — тяжело выдыхает она, опираясь о край стола и поправляя растрепавшиеся волосы. — После такого сумасшедшего дня я буквально валюсь с ног.'
        else:
            $TavernDayEventText = '— Потом, Стефан, ради Ильматера, потом! — на ходу бросает она, балансируя тяжёлым подносом и сверкая глазами. — В зале такой завал, что некогда даже дух перевести!'
        end
    end

    killvar '$TavernDayEventTextId'
---

