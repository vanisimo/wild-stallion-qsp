! ================================================
! FILE: modules/events/tavern/amanda_escape_work_text.qsps
! MODULE: events/tavern
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! Тексты побега Аманды со смены (Escape from work)
! ================================================

#AmandaEscapeWorkText
    $EscapeTextId = LCASE($ARGS[0])
    $EscapeSceneType = LCASE($ARGS[1])
    $EscapeWorkText = ''

    if $EscapeTextId = 'intro':
        $EscapeWorkText = 'В разгар смены зал наполнен гулом голосов: подвыпившие ремесленники стучат кружками по дубовым столешницам, заезжий купец требует горячего жаркого, а у стойки скапливается очередь за элем.'
        $EscapeWorkText += '<br><br>Ты оглядываешь зал в поисках Аманды — но её нигде нет. На спинке угловой скамьи сиротливо висит её брошенный холщовый передник, а рядом на подносе остывают недомытые кружки.'
        $EscapeWorkText += '<br><br>Сестрёнка просто бросила работу прямо посреди тяжёлого дня и куда-то исчезла.'

    elseif $EscapeTextId = 'search_sandra':
        if $AmandaEscapePartner = 'legare':
            $EscapeWorkText = 'Ты заглядываешь на кухню. Сандра как раз помешивает бульон в котле. Заметив твоё хмурое лицо, она раздражённо вытирает руки фартуком и машет половником:'
            $EscapeWorkText += '<br><br>— Ищешь эту вертихвостку? Видела я в кухонное окно! Подкатил к ней этот богатей Легаре. Улыбался, ручки ей целовал, сладкие речи лил — а она и растаяла, как масло на сковороде! Импозантный купец, благодетель городской, а сам на молоденьких девчонок заглядывается! Скинула передник и шмыгнула с ним в переулок за трактиром. Беги скорее, Стефан, пока этот лис не запудрил девке мозги окончательно!'
        else:
            $EscapeWorkText = 'Ты заглядываешь на кухню. Сандра отряхивает ладони от муки и, поймав твой взгляд, тяжело вздыхает, осеняя себя знаком Священного Круга:'
            $EscapeWorkText += '<br><br>— Опять Аманду ищешь? Видела я, как за сарай на заднем дворе юркнул этот соседский бездельник ' + $AmandaEscapePartnerName + '. А девчонка бросила поднос и побежала за ним, хихикая на весь двор! Вся в отца... тому тоже лишь бы гулять, пока дело стоит. Беги на задний двор, Стефан, приструни девку, пока беды не натворили!'
        end

    elseif $EscapeTextId = 'catch_spot':
        if $EscapeSceneType = 'legare':
            $EscapeWorkText = 'Ты осторожно заглядываешь в тенистый каменный проход за трактиром.'
            $EscapeWorkText += '<br><br>Аманда прижалась спиной к замшелой кирпичной стене, разрумянившаяся, с горящими глазами. Перед ней стоит Легаре — импозантный купец и городской богатей в дорогом суконном камзоле. Он одной рукой небрежно опирается о стену над её плечом, а пальцами другой приподнимает её подбородок, заглядывая в глаза и нашёптывая комплименты. Аманда смущённо улыбается, запрокинув голову и ожидая поцелуя.'

        elseif $EscapeSceneType = 'neighbor_group':
            $EscapeWorkText = 'Ты бесшумно подкрадываешься к старому сараю и выглядываешь из-за штабеля досок.'
            $EscapeWorkText += '<br><br>Картина открывается тревожная: Аманда загнана в тупик сеновала, а вокруг неё плотным полукольцом стоят сразу трое соседских парней — Ханс, Курт и Феликс! Они похотливо гогочут, переговариваются хриплыми голосами и уже распускают поясные ремни на портках, отрезая девушке путь к бегству. Аманда растерянно прижалась к тюкам сена, нервно теребя подол юбки и часто дыша.'

        elseif $EscapeSceneType = 'neighbor_sex':
            $EscapeWorkText = 'Ты тихо обходишь угол сарая и заглядываешь за гружённую дровами телегу.'
            $EscapeWorkText += '<br><br>Там ' + $AmandaEscapePartnerName + ' уже развернул Аманду лицом к поленнице. Его руки нагло ухватили подол её юбки и задирают ткань вверх, открывая девичьи ноги выше колен. Аманда испуганно и сладко охает, упираясь ладошками в шершавые поленья дров и слегка подрагивая от предвкушения.'

        elseif $EscapeSceneType = 'neighbor_blowjob':
            $EscapeWorkText = 'Ты заглядываешь за угол сарая со стороны огородов.'
            $EscapeWorkText += '<br><br>' + $AmandaEscapePartnerName + ' прислонился спиной к телеге. С наглой, самодовольной усмешкой он распустил шнуровку на штанах и свободной рукой нетерпеливо подзывает Аманду, указывая взглядом на землю у своих ног. Аманда колеблется, нервно кусает нижнюю губу, испуганно оглядывается по сторонам — но уже начинает медленно сгибать колени, готовая опуститься перед ним.'

        else:
            $EscapeWorkText = 'Ты выглядываешь из-за штабеля дров на заднем дворе трактира.'
            $EscapeWorkText += '<br><br>Там, в узком простенке, Аманда стоит вплотную к ' + $AmandaEscapePartnerName + '. Соседский парень нагло приобнял её за талию, поглаживая бедро сквозь ткань платья, и тянется к её губам для поцелуя. Аманда тихо хихикает, кокетливо упираясь пальчиками ему в грудь, но не отталкивая.'
        end

    elseif $EscapeTextId = 'interrupt':
        if $EscapeSceneType = 'legare':
            $EscapeWorkText = 'Ты решительно выходишь из тени: «Легаре! Не много ли чести для хозяина чужих смен?»'
            $EscapeWorkText += '<br><br>Легаре медленно отстраняется от Аманды и невозмутимо поправляет ворот камзола. На его холёном лице играет спокойная, снисходительная усмешка богатого господина:'
            $EscapeWorkText += '<br><br>— А, Стефан... Не стоит горячиться. Я лишь составил приятную беседу твоей сестре. Ей явно тесно в твоём кабаке... До скорой встречи, Аманда.'
            $EscapeWorkText += '<br><br>Легаре с вежливым поклоном неторопливо уходит. Аманда остаётся стоять у стены — бледная, напуганная твоим внезапным появлением, судорожно прижимая руки к груди.'

        else:
            $EscapeWorkText = 'Ты с яростным окриком выскакиваешь из-за укрытия: «А ну пошли вон отсюда, псы блудливые!»'
            $EscapeWorkText += '<br><br>Эффект получается сокрушительным. Соседские парни в диком испуге шарахаются в стороны, роняя поленья и оглашая воздух отборной бранью. Кто на ходу подтягивает штаны, кто едва не ломает забор, с визгом перемахивая через доски и растворяясь в переулках!'
            $EscapeWorkText += '<br><br>Вся их похоть сорвана в один миг! Аманда испуганно ойкает, судорожно одёргивает подол платья и вжимается в стену сарая, дрожа всем телом от стыда перед тобой.'
        end

    elseif $EscapeTextId = 'watch_scene':
        if $EscapeSceneType = 'legare':
            $EscapeWorkText = 'Ты задерживаешь дыхание и остаёшься в тени у стены, наблюдая за происходящим.'
            $EscapeWorkText += '<br><br>Легаре притягивает Аманду за талию и накрывает её губы долгим, властным поцелуем взрослого мужчины. Его холёная ладонь бесцеремонно скользит по её боку, поднимается выше и сжимает округлую девичью грудь поверх корсажа. Аманда томно стонет ему в рот, обвивая шею купца ручками и полностью отдаваясь его ласке.'
            $EscapeWorkText += '<br><br>Наконец Легаре отрывается от её губ. Он ласково проводит пальцем по её пылающей щеке, обещает вскоре прийти снова и не спеша уходит в сторону рынка. Аманда остаётся стоять, опьянённая и растрёпанная.'

        elseif $EscapeSceneType = 'neighbor_group':
            $EscapeWorkText = 'Ты остаёшься в укрытии, боясь шелохнуться, пока перед твоими глазами разворачивается развратная сцена.'
            $EscapeWorkText += '<br><br>Парни втроём затаскивают Аманду на сеновал за сараем. Её платье задрано, передник брошен в солому. Ханс бесцеремонно входит в неё сзади, вбиваясь под её сдавленные всхлипы, пока Курт держит её за обнажённую грудь, а Феликс подставляет свой отвердевший уд прямо к её послушным губам. Аманда задыхается, постанывает и принимает в себя похоть всех троих прямо посреди бела дня.'
            $EscapeWorkText += '<br><br>Всё длится до тех пор, пока парни по очереди не изливают своё семя. Застегнув портки, они со смехом переговариваются и покидают двор. Аманда остаётся лежать на сене — опустошённая, липкая от чужой спермы и тяжело дышащая.'

        elseif $EscapeSceneType = 'neighbor_sex':
            $EscapeWorkText = 'Ты остаёшься за телегой, с колотящимся сердцем наблюдая за сестрой.'
            $EscapeWorkText += '<br><br>' + $AmandaEscapePartnerName + ' рывком задирает её юбку до пояса, обнажая белые ягодицы. Смачно шлёпнув её по попе, он грубо входит в неё сзади. Аманда стонет, вцепившись ногтями в борт телеги, её бёдра ритмично колышутся в такт его толчкам. Влажные шлепки тел разносятся по двору.'
            $EscapeWorkText += '<br><br>Парень шумно кряхтит и кончает внутрь, крепко вжавшись в неё. Затем он торопливо заправляет штаны, хлопает её по бедру и удирает через огород. Аманда медленно сползает на колени, пытаясь перевести дыхание.'

        elseif $EscapeSceneType = 'neighbor_blowjob':
            $EscapeWorkText = 'Ты замираешь в тени, не вмешиваясь.'
            $EscapeWorkText += '<br><br>Аманда медленно опускается на колени прямо в пыль перед парнем. Дрожащими пальчиками она обхватывает его багровый уд и бережно направляет себе в рот. Её щёки вздуваются, голова двигается вверх и вниз, а с губ срываются влажные причмокивания. Парень блаженно закатывает глаза, запустив пальцы в её волосы.'
            $EscapeWorkText += '<br><br>Спустя минуту парень судорожно стонет и стреляет горячим семенем прямо ей в рот. Аманда покорно всё сглатывает, вытирает подбородок рукавом и тяжело дышит, глядя, как довольный любовник улепётывает со двора.'

        else:
            $EscapeWorkText = 'Ты наблюдаешь из-за поленницы. Парень крепко прижимает Аманду к себе, целует её в губы и лапает её бёдра и грудь. Аманда тает в его объятиях, тяжело дыша и отвечая на поцелуй. Нацеловавшись вволю, парень украдкой покидает двор, а Аманда остаётся поправлять растрёпанные волосы.'
        end

    elseif $EscapeTextId = 'post_watch_confront_intro':
        $EscapeWorkText = 'Ты медленно выходишь из тени укрытия. Твои тяжёлые шаги гулко отдаются в тишине.'
        $EscapeWorkText += '<br><br>Аманда, ещё не успевшая до конца привести в порядок одежду, испуганно оборачивается — и лицо её мертвенно бледнеет. Она видит твой взгляд и всё понимает без слов.'
        $EscapeWorkText += '<br><br>— Стефан?! — её голос срывается в тонкий, панический шёпот. — Ты... ты всё это время стоял там?! Ты... ты всё видел?!'

    elseif $EscapeTextId = 'watch_quiet_leave':
        $EscapeWorkText = 'Ты бесшумно отступаешь назад и через боковую дверь возвращаешься в шумный зал трактира.'
        $EscapeWorkText += '<br><br>Спустя четверть часа в зале появляется Аманда. Её щёки пылают, передник наспех повязан, а в глазах ещё пляшут отголоски пережитого. Она старается не смотреть на тебя и торопливо хватается за кружки, делая вид, что просто выходила подышать воздухом.'
        $EscapeWorkText += '<br><br>Но ты знаешь всю правду.'

    elseif $EscapeTextId = 'choice_ban_rebel':
        $EscapeWorkText = 'Ты подходишь вплотную, чеканя каждое слово: «Аманда! Я тебе ясно и прямо запретил путаться с парнями! А ты мало того что нарушила мой запрет, так ещё и бросила работу посреди дня!»'
        $EscapeWorkText += '<br><br>Аманда вскидывает подбородок. В её глазах вспыхивает бунтарский огонёк, щёки пылают от возмущения:'
        $EscapeWorkText += '<br><br>— Ты мне не отец и не муж, Стефан, чтобы запирать меня в четырёх стенах! Я не рабыня твоя! Если я захочу подышать воздухом или поговорить с тем, кто видит во мне девушку, а не служанку для разноса пива — я буду это делать! Хватит вечно мне указывать!'
        $EscapeWorkText += '<br><br>Она сердито топает ножкой и, демонстративно задев тебя плечом, гордо уходит обратно к трактиру.'

    elseif $EscapeTextId = 'choice_ban_guilt':
        $EscapeWorkText = 'Ты строго складываешь руки на груди: «Аманда, вспомни наш разговор. Я ведь предупреждал тебя и запретил крутить шашни с парнями за моей спиной. Почему ты нарушила своё обещание?»'
        $EscapeWorkText += '<br><br>Услышав твой спокойный, но веский упрёк, Аманда сразу сникает. Её губы начинают дрожать, а на глаза наворачиваются искренние слёзы раскаяния:'
        $EscapeWorkText += '<br><br>— Стефан... пожалуйста, не сердись... — всхлипывает она, судорожно теребя пальчиками край передника. — Я помню, правда помню! Просто... дурь в голову ударила, помутилось всё... Прости меня, дуру набитую! Я больше никогда не ослушаюсь твоего слова, клянусь Ильматером!'
        $EscapeWorkText += '<br><br>Она виновато опускает голову, готовая на любую работу, лишь бы ты не держал на неё зла.'

    elseif $EscapeTextId = 'choice_shameless':
        $EscapeWorkText = 'Ты смотришь на неё с брезгливой строгостью хозяина заведения: «Ты совсем стыд потеряла? Прямо у стен трактира, в грязи и пыли, осквернять себя перед уличными оборванцами?! Если гости увидят такое — о нашей семье поползёт такая слава, что ни один приличный человек к нам на порог не ступит!»'
        $EscapeWorkText += '<br><br>Аманда закрывает лицо руками и горько всхлипывает, дрожа всем телом от стыда:'
        $EscapeWorkText += '<br><br>— Стефан... я... я не знаю, что на меня нашло... пожалуйста, не говори маме!'
        $EscapeWorkText += '<br><br>— Живо к колодцу, — отрезаешь ты. — Возьми порошок Таро, смой с себя всю эту грязь, надень чистый передник и вставай к мойке. И чтобы до конца дня я ни звука от тебя не слышал!'
        $EscapeWorkText += '<br><br>Аманда послушно кивает, утирая слёзы, и с поникшей головой бежит отмываться.'

    elseif $EscapeTextId = 'choice_claim':
        $EscapeWorkText = 'Ты молча шагаешь вперёд, хватаешь её за талию и решительно прижимаешь спиной к стене. Твой взгляд темнеет от собственнической страсти:'
        $EscapeWorkText += '<br><br>— Думаешь, можешь бегать на свидания посреди дня? Раз у тебя столько лишнего жара, что не сидится за стойкой — я сам решу, куда его деть.'
        $EscapeWorkText += '<br><br>Прежде чем она успевает пикнуть, ты властно накрываешь её губы поцелуем, пальцами крепко сжимая её бедро. Аманда испуганно охает в твой рот, но уже через секунду её сопротивление тает — её ручки обвивают твою шею, пальчики путаются в твоих волосах, а бёдра сами подаются навстречу твоему телу.'
        $EscapeWorkText += '<br><br>Когда ты наконец отрываешь свои губы от её рта, Аманда тяжело и прерывисто дышит. Её щёки пылают, губы влажно блестят, а взгляд затуманен сладкой покорностью:'
        $EscapeWorkText += '<br><br>— Стефанчик... ты совсем с ума сошёл... — шепчет она с пьяной улыбкой. — Прямо здесь... Ладно, я всё поняла... Иду я в зал, иду!'

    elseif $EscapeTextId = 'choice_strict':
        $EscapeWorkText = 'Ты сурово отчитываешь её голосом строгого хозяина: «В зале полно людей, гости ждут свои заказы, кружки не вымыты, а хозяйская дочь прохлаждается по закоулкам! Трактир кормит всю нашу семью, и если ты будешь так относиться к делу — мы по миру пойдём. Немедленно надень передник и за работу!»'
        $EscapeWorkText += '<br><br>Аманда надувает губки и отводит взгляд:'
        $EscapeWorkText += '<br><br>— Вечно ты так... чуть что — работа, трактир, деньги... Будто я и не человек вовсе.'
        $EscapeWorkText += '<br><br>Тем не менее, хозяйский тон действует безотказно. Не решаясь спорить дальше, она подбирает брошенный фартук и послушно трусит в зал наводить порядок.'

    elseif $EscapeTextId = 'choice_talk':
        $EscapeWorkText = 'Ты вздыхаешь, присаживаешься рядом на скамью и говоришь с ней спокойно, по-братски, без криков и спеси:'
        if $AmandaEscapePartner = 'legare':
            $EscapeWorkText += '<br><br>— Аманда, пойми ты наконец: Легаре — богатейший купец в городе, меценат и влиятельный господин. Для таких людей простые девушки из трактиров — всего лишь мимолётная забава. Он наговорит тебе красивых речей, посулит золотые горы, а потом вернётся к своим сделкам и делам, оставив тебя с разбитым сердцем и кривотолками на весь рынок.'
        else:
            $EscapeWorkText += '<br><br>— Аманда, ты же умная девочка. Соседские лоботрясы вроде ' + $AmandaEscapePartnerName + ' только и ищут, кого бы потискать за сараем, а потом побегут хвастаться собутыльникам в кабак, перевирая всё в десять раз. Тебе потом перед людьми глаз не поднять будет.'
        end
        $EscapeWorkText += '<br><br>Аманда слушает тебя, опустив глаза в землю. Видно, как в её голове укладываются твои слова. Она тихо вздыхает и искренне говорит:'
        $EscapeWorkText += '<br><br>— Ты прав, Стефан... Я просто дурочка, мне захотелось внимания и красивых речей. Спасибо, что бережёшь меня. Я пойду помогу тебе в зале.'
    end

    killvar '$EscapeTextId'
    killvar '$EscapeSceneType'
---
