! ================================================
! FILE: modules/events/tavern/amanda_escape_work_text.qsps
! MODULE: events/tavern
! Тексты побега Аманды со смены (Escape from work)
! ================================================

#AmandaEscapeWorkText
    $EscapeTextId = LCASE($ARGS[0])
    $EscapeSceneType = LCASE($ARGS[1])
    $EscapeWorkText = ''

    if $EscapeTextId = 'intro':
        $EscapeWorkText = 'В разгар смены зал наполнен гулом голосов: подвыпившие ремесленники стучат кружками по дубовым столешницам, заезжий купец требует горячего жаркого, а у стойки скапливается очередь за элем.'
        $EscapeWorkText += '<br><br>Вы оглядываете зал в поисках Аманды — но её нигде нет. На спинке угловой скамьи сиротливо висит её брошенный холщовый передник, а рядом на подносе остывают недомытые кружки.'
        $EscapeWorkText += '<br><br>Сестрёнка просто бросила работу прямо посреди тяжёлого дня и куда-то исчезла.'

    elseif $EscapeTextId = 'search_sandra':
        if $AmandaEscapePartner = 'legare':
            $EscapeWorkText = 'Вы заглядываете на кухню. Сандра как раз помешивает бульон в котле. Заметив ваше хмурое лицо, она раздражённо вытирает руки фартуком и машет половником:'
            $EscapeWorkText += '<br><br>— Ищешь эту вертихвостку? Видела я в кухонное окно! Подкатил к ней этот богатей Легаре. Улыбался, ручки ей целовал, сладкие речи лил — а она и растаяла, как масло на сковороде! Импозантный купец, благодетель городской, а сам на молоденьких девчонок заглядывается! Скинула передник и шмыгнула с ним в переулок за трактиром. Беги скорее, Стефан, пока этот лис не запудрил девке мозги окончательно!'
        else:
            $EscapeWorkText = 'Вы заглядываете на кухню. Сандра отряхивает ладони от муки и, поймав ваш взгляд, тяжело вздыхает, осеняя себя знаком Священного Круга:'
            $EscapeWorkText += '<br><br>— Опять Аманду ищешь? Видела я, как за сарай на заднем дворе юркнул этот соседский бездельник ' + $AmandaEscapePartnerName + '. А девчонка бросила поднос и побежала за ним, хихикая на весь двор! Вся в отца... тому тоже лишь бы гулять, пока дело стоит. Беги на задний двор, Стефан, приструни девку, пока беды не натворили!'
        end

    elseif $EscapeTextId = 'catch_spot':
        if $EscapeSceneType = 'legare':
            $EscapeWorkText = 'Вы осторожно заглядываете в тенистый каменный проход за трактиром.'
            $EscapeWorkText += '<br><br>Аманда прижалась спиной к замшелой кирпичной стене, разрумянившаяся, с горящими глазами. Перед ней стоит Легаре — импозантный купец и городской богатей в дорогом суконном камзоле. Он одной рукой небрежно опирается о стену над её плечом, а пальцами другой приподнимает её подбородок, заглядывая в глаза и нашёптывая комплименты. Аманда смущённо улыбается, запрокинув голову и ожидая поцелуя.'

        elseif $EscapeSceneType = 'neighbor_group':
            $EscapeWorkText = 'Вы бесшумно подкрадываетесь к старому сараю и выглядываете из-за штабеля досок.'
            $EscapeWorkText += '<br><br>Картина открывается тревожная: Аманда загнана в тупик сеновала, а вокруг неё плотным полукольцом стоят сразу трое соседских парней — Ханс, Курт и Феликс! Они похотливо гогочут, переговариваются хриплыми голосами и уже распускают поясные ремни на портках, отрезая девушке путь к бегству. Аманда растерянно прижалась к тюкам сена, нервно теребя подол юбки и часто дыша.'

        elseif $EscapeSceneType = 'neighbor_sex':
            $EscapeWorkText = 'Вы тихо обходите угол сарая и заглядываете за гружённую дровами телегу.'
            $EscapeWorkText += '<br><br>Там ' + $AmandaEscapePartnerName + ' уже развернул Аманду лицом к поленнице. Его руки нагло ухватили подол её юбки и начинают задирать ткань вверх, открывая девичьи ноги выше колен. Аманда испуганно и сладко охает, упираясь ладошками в шершавые поленья дров и слегка подрагивая от предвкушения.'

        elseif $EscapeSceneType = 'neighbor_blowjob':
            $EscapeWorkText = 'Вы заглядываете за угол сарая со стороны огородов.'
            $EscapeWorkText += '<br><br>' + $AmandaEscapePartnerName + ' прислонился спиной к телеге. С наглой, самодовольной усмешкой он распустил шнуровку на штанах и свободной рукой нетерпеливо подзывает Аманду, указывая взглядом на пыль у своих ног. Аманда колеблется, нервно кусает нижнюю губу, испуганно оглядывается по сторонам — но уже начинает медленно сгибать колени, готовая опуститься перед ним.'

        else:
            $EscapeWorkText = 'Вы выглядываете из-за штабеля дров на заднем дворе трактира.'
            $EscapeWorkText += '<br><br>Там, в узком простенке, Аманда стоит вплотную к ' + $AmandaEscapePartnerName + '. Соседский парень нагло приобнял её за талию, поглаживая бедро сквозь ткань платья, и тянется к её губам для поцелуя. Аманда тихо хихикает, кокетливо упираясь пальчиками ему в грудь, но не отталкивая.'
        end

    elseif $EscapeTextId = 'interrupt':
        if $EscapeSceneType = 'legare':
            $EscapeWorkText = 'Вы решительно выходите из тени: «Легаре! Не много ли чести для хозяина чужих смен?»'
            $EscapeWorkText += '<br><br>Легаре медленно отстраняется от Аманды и невозмутимо поправляет ворот камзола. На его холёном лице играет спокойная, снисходительная усмешка богатого господина:'
            $EscapeWorkText += '<br><br>— А, почтенный Стефан... Не стоит горячиться. Я лишь составил приятную беседу твоей сестре. Ей явно тесно в твоём кабаке... До скорой встречи, Аманда.'
            $EscapeWorkText += '<br><br>Легаре с вежливым поклоном неторопливо уходит. Аманда остаётся стоять у стены — бледная, напуганная вашим внезапным появлением, судорожно прижимая руки к груди.'

        else:
            $EscapeWorkText = 'Вы с яростным рыком выскакиваете из-за укрытия: «А ну пошли вон отсюда, псы блудливые!»'
            $EscapeWorkText += '<br><br>Эффект получается сокрушительным. Соседские парни в диком ужасе шарахаются в стороны, роняя поленья и оглашая воздух отборной бранью. Кто на ходу подтягивает штаны, кто едва не ломает забор, с визгом перемахивая через доски и растворяясь в переулках!'
            $EscapeWorkText += '<br><br>Сексуальный акт сорван до того, как они успели к нему прикоснуться! Аманда испуганно ойкает, судорожно одёргивает подол платья и вжимается в стену сарая, дрожа всем телом от стыда перед вами.'
        end

    elseif $EscapeTextId = 'watch_scene':
        if $EscapeSceneType = 'legare':
            $EscapeWorkText = 'Вы задерживаете дыхание и остаётесь в тени у стены, наблюдая за происходящим.'
            $EscapeWorkText += '<br><br>Легаре притягивает Аманду за талию и накрывает её губы долгим, властным поцелуем взрослого мужчины. Его холёная ладонь бесцеремонно скользит по её боку, поднимается выше и сжимает округлую девичью грудь поверх корсажа. Аманда томно стонет ему в рот, обвивая шею купца ручками и полностью отдаваясь его ласке.'
            $EscapeWorkText += '<br><br>Наконец Легаре отрывается от её губ. Он ласково проводит пальцем по её пылающей щеке, обещает вскоре прийти снова и не спеша уходит в сторону рынка. Аманда остаётся стоять, опьянённая и растрёпанная.'

        elseif $EscapeSceneType = 'neighbor_group':
            $EscapeWorkText = 'Вы остаётесь в укрытии, боясь шелохнуться, пока перед вашими глазами разворачивается дикая, развратная сцена.'
            $EscapeWorkText += '<br><br>Парни втроём затаскивают Аманду на сеновал за сараем. Её платье задрано, передник брошен в солому. Ханс бесцеремонно входит в неё сзади, вбиваясь под её сдавленные всхлипы, пока Курт держит её за обнажённую грудь, а Феликс подставляет свой отвердевший уд прямо к её послушным губам. Аманда задыхается, постанывает и принимает в себя похоть всех троих прямо посреди бела дня.'
            $EscapeWorkText += '<br><br>Оргия длится до тех пор, пока все трое не изливают своё семя. Застегнув портки, парни со смехом переговариваются и покидают двор. Аманда остаётся лежать на сене — опустошённая, липкая от чужой спермы и тяжело дышащая.'

        elseif $EscapeSceneType = 'neighbor_sex':
            $EscapeWorkText = 'Вы остаётесь за телегой, с колотящимся сердцем наблюдая за сестрой.'
            $EscapeWorkText += '<br><br>' + $AmandaEscapePartnerName + ' рывком задирает её юбку до пояса, обнажая белые ягодицы. Смачно шлёпнув её по попе, он грубо входит в неё сзади. Аманда стонет, вцепившись ногтями в борт телеги, её бёдра ритмично колышутся в такт его толчкам. Влажные шлепки тел разносятся по всему двору.'
            $EscapeWorkText += '<br><br>Парень шумно кряхтит и кончает внутрь, крепко вжавшись в неё. Затем он торопливо заправляет штаны, хлопает её по бедру и удирает через огород. Аманда медленно сползает на колени, пытаясь перевести дыхание.'

        elseif $EscapeSceneType = 'neighbor_blowjob':
            $EscapeWorkText = 'Вы замираете в тени, не вмешиваясь.'
            $EscapeWorkText += '<br><br>Аманда медленно опускается на колени прямо в пыль перед парнем. Дрожащими пальчиками она обхватывает его багровый уд и бережно направляет себе в рот. Её щёки вздуваются, голова двигается вверх и вниз, а с губ срываются влажные причмокивания. Парень блаженно закатывает глаза, запустив пальцы в её волосы.'
            $EscapeWorkText += '<br><br>Спустя минуту парень судорожно стонет и стреляет горячим семенем прямо ей в рот. Аманда покорно всё сглатывает, вытирает подбородок рукавом и тяжело дышит, глядя, как довольный любовник улепётывает со двора.'

        else:
            $EscapeWorkText = 'Вы наблюдаете из-за поленницы. Парень крепко прижимает Аманду к себе, целует её в губы и лапает её бёдра и грудь. Аманда тает в его объятиях, тяжело дыша и отвечая на поцелуй. Нацеловавшись вволю, парень украдкой покидает двор, а Аманда остаётся поправлять растрёпанные волосы.'
        end

    elseif $EscapeTextId = 'post_watch_confront_intro':
        $EscapeWorkText = 'Вы медленно выходите из тени укрытия. Ваши тяжёлые шаги гулко отдаются в тишине.'
        $EscapeWorkText += '<br><br>Аманда, ещё не успевшая до конца привести в порядок одежду, испуганно оборачивается — и лицо её мертвенно бледнеет. Она видит ваш взгляд и всё понимает без слов.'
        $EscapeWorkText += '<br><br>— Стефан?! — её голос срывается в тонкий, панический шёпот. — Ты... ты всё это время стоял там?! Ты... ты всё видел?!'

    elseif $EscapeTextId = 'watch_quiet_leave':
        $EscapeWorkText = 'Вы бесшумно отступаете назад и через боковую дверь возвращаетесь в шумный зал трактира.'
        $EscapeWorkText += '<br><br>Спустя четверть часа в зале появляется Аманда. Её щёки пылают, передник наспех повязан, а в глазах ещё пляшут отголоски пережитого. Она старается не смотреть на вас и торопливо хватается за кружки, делая вид, что просто выходила подышать воздухом.'
        $EscapeWorkText += '<br><br>Но вы знаете всю правду.'

    elseif $EscapeTextId = 'choice_ban_rebel':
        $EscapeWorkText = 'Вы подходите вплотную, чеканя каждое слово: «Аманда! Я тебе ясно и прямо запретил путаться с парнями! А ты мало того что нарушила мой запрет, так ещё и бросила работу посреди дня!»'
        $EscapeWorkText += '<br><br>Аманда вскидывает подбородок. В её глазах вспыхивает бунтарский огонёк, щёки пылают от возмущения:'
        $EscapeWorkText += '<br><br>— Ты мне не отец и не муж, Стефан, чтобы запирать меня в четырёх стенах! Я не рабыня твоя! Если я захочу подышать воздухом или поговорить с тем, кто видит во мне девушку, а не служанку для разноса пива — я буду это делать! Хватит вечно мне указывать!'
        $EscapeWorkText += '<br><br>Она сердито топает ножкой и, демонстративно задев вас плечом, гордо уходит обратно к трактиру.'

    elseif $EscapeTextId = 'choice_ban_guilt':
        $EscapeWorkText = 'Вы строго складываете руки на груди: «Аманда, вспомни наш разговор. Я ведь предупреждал тебя и запретил крутить шашни с парнями за моей спиной. Почему ты нарушила своё обещание?»'
        $EscapeWorkText += '<br><br>Услышав ваш спокойный, но веский упрёк, Аманда сразу сникает. Её губы начинают дрожать, а на глаза наворачиваются искренние слёзы раскаяния:'
        $EscapeWorkText += '<br><br>— Стефан... пожалуйста, не сердись... — всхлипывает она, судорожно теребя пальчиками край передника. — Я помню, правда помню! Просто... бес попутал... Прости меня, дуру набитую! Я больше никогда не ослушаюсь твоего слова, клянусь Ильматером!'
        $EscapeWorkText += '<br><br>Она виновато опускает голову, готовая на любую работу, лишь бы вы не держали на неё зла.'

    elseif $EscapeTextId = 'choice_shameless':
        $EscapeWorkText = 'Вы смотрите на неё с брезгливой строгостью хозяина заведения: «Ты совсем стыд потеряла? Прямо у стен трактира, в грязи и пыли, осквернять себя перед уличными оборванцами?! Если гости увидят такое — о нашей семье поползёт такая слава, что ни один приличный человек к нам на порог не ступит!»'
        $EscapeWorkText += '<br><br>Аманда закрывает лицо руками и горько всхлипывает, дрожа всем телом от стыда:'
        $EscapeWorkText += '<br><br>— Стефан... я... я не знаю, что на меня нашло... пожалуйста, не говори маме!'
        $EscapeWorkText += '<br><br>— Живо к колодцу, — отрезаете вы. — Возьми порошок Таро, смой с себя всю эту грязь, надень чистый передник и вставай к мойке. И чтобы до конца дня я ни звука от тебя не слышал!'
        $EscapeWorkText += '<br><br>Аманда послушно кивает, утирая слёзы, и с поникшей головой бежит отмываться.'

    elseif $EscapeTextId = 'choice_claim':
        $EscapeWorkText = 'Вы молча шагаете вперёд, хватаете её за талию и решительно прижимаете спиной к стене. Ваш взгляд темнеет от собственнической страсти:'
        $EscapeWorkText += '<br><br>— Думаешь, можешь бегать на свидания посреди дня? Раз у тебя столько лишнего жара, что не сидится за стойкой — я сам решу, куда его деть.'
        $EscapeWorkText += '<br><br>Прежде чем она успевает пикнуть, вы властно накрываете её губы поцелуем, пальцами крепко сжимая её бедро. Аманда испуганно охает в ваш рот, но уже через секунду её сопротивление тает — её ручки обвивают вашу шею, пальчики путаются в ваших волосах, а бёдра сами подаются навстречу вашему телу.'
        $EscapeWorkText += '<br><br>Когда вы наконец отрываете свои губы от её рта, Аманда тяжело и прерывисто дышит. Её щёки пылают, губы влажно блестят, а взгляд затуманен сладкой покорностью:'
        $EscapeWorkText += '<br><br>— Стефанчик... ты совсем с ума сошёл... — шепчет она с пьяной улыбкой. — Прямо здесь... Ладно, я всё поняла... Иду я в зал, иду!'

    elseif $EscapeTextId = 'choice_strict':
        $EscapeWorkText = 'Вы сурово отчитываете её голосом строгого хозяина: «В зале полно людей, гости ждут свои заказы, кружки не вымыты, а хозяйская дочь прохлаждается по закоулкам! Трактир кормит всю нашу семью, и если ты будешь так относиться к делу — мы по миру пойдём. Немедленно надень передник и за работу!»'
        $EscapeWorkText += '<br><br>Аманда надувает губки и отводит взгляд:'
        $EscapeWorkText += '<br><br>— Вечно ты так... чуть что — работа, трактир, деньги... Будто я и не человек вовсе.'
        $EscapeWorkText += '<br><br>Тем не менее, хозяйский тон действует безотказно. Не решаясь спорить дальше, она подбирает брошенный фартук и послушно трусит в зал наводить порядок.'

    elseif $EscapeTextId = 'choice_talk':
        $EscapeWorkText = 'Вы вздыхаете, присаживаетесь рядом на скамью и говорите с ней спокойно, по-братски, без криков и спеси:'
        if $AmandaEscapePartner = 'legare':
            $EscapeWorkText += '<br><br>— Аманда, пойми ты наконец: Легаре — богатейший купец в городе, меценат и влиятельный господин. Для таких людей простые девушки из трактиров — всего лишь мимолётная забава. Он наговорит тебе красивых речей, посулит золотые горы, а потом вернётся к своим сделкам и делам, оставив тебя с разбитым сердцем и кривотолками на весь рынок.'
        else:
            $EscapeWorkText += '<br><br>— Аманда, ты же умная девочка. Соседские лоботрясы вроде ' + $AmandaEscapePartnerName + ' только и ищут, кого бы потискать за сараем, а потом побегут хвастаться собутыльникам в кабак, перевирая всё в десять раз. Тебе потом перед людьми глаз не поднять будет.'
        end
        $EscapeWorkText += '<br><br>Аманда слушает вас, опустив глаза в землю. Видно, как в её голове укладываются ваши слова. Она тихо вздыхает и искренне говорит:'
        $EscapeWorkText += '<br><br>— Ты прав, Стефан... Я просто дурочка, мне захотелось внимания и красивых речей. Спасибо, что бережёшь меня. Я пойду помогу тебе в зале.'
    end

    killvar '$EscapeTextId'
    killvar '$EscapeSceneType'
---
