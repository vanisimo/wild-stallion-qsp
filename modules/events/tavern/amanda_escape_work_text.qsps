! ================================================
! FILE: modules/events/tavern/amanda_escape_work_text.qsps
! MODULE: events/tavern
! [AI-WORKED] Текст переработан / дополнен ассистентом 04.11.2026
! Тексты побега Аманды со смены (Escape from work)
! Свидания с Легаре, соседские парни, тройничек, сеновал
! Вариативность по FamilyCorruptionStage 0-5
! ================================================

#AmandaEscapeWorkText
    $EscapeTextId = LCASE($ARGS[0])
    $EscapeSceneType = LCASE($ARGS[1])

    if $EscapeTextId = 'intro':
        if FamilyCorruptionStage <= 1:
            *pl 'В зале стоит обычный для полудня шум. Ремесленники за дальним столом громко спорят о ценах на кожу, торговец у окна нетерпеливо стучит кружкой по столешнице, а у стойки скапливается очередь за выпивкой.'
            *pl ' '
            *pl 'Ты оглядываешь столы, но знакомой косы нигде не видно. На спинке угловой скамьи аккуратно висит холщовый передник Аманды, а рядом сиротливо стоит деревянный поднос с грязными кружками.'
            *pl ' '
            *pl 'Сестра опять ускользнула прямо посреди работы, оставив гостей на тебя.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'В разгар смены зал гудит от криков и стука кружек. Посетители требуют эля и жаркого, но разносить заказы некому.'
            *pl ' '
            *pl 'У выхода на задний двор на лавке валяется скомканный передник Аманды. Похоже, она скинула его в спешке, даже не оглянувшись на переполненные столы.'
            *pl ' '
            *pl 'Опять бросила работу ради тайных встреч, зная, что залу не хватает рук.'
        else:
            *pl 'В зале тесно и шумно от десятков посетителей. Гости громко перекликаются, стучат доньями о доски и посмеиваются.'
            *pl ' '
            *pl 'Фартук Аманды небрежно брошен прямо у двери наружу. Заметив твой растерянный взгляд, плотник за ближним столом широко скалится:'
            *pl '— Хозяин, сестрицу высматриваешь? Так она только что упорхнула во двор! Глаза блестят, ленты в волосах развеваются — видать, кавалер не ждёт!'
            *pl ' '
            *pl 'Аманда ушла со смены в открытую, даже не пытаясь придумать повод.'
        end

    elseif $EscapeTextId = 'search_sandra':
        if $AmandaEscapePartner = 'legare':
            if FamilyCorruptionStage <= 1:
                *pl 'Ты заглядываешь на кухню. Сандра как раз снимает горячую крышку с котла и, заметив твой взгляд, сердито отряхивает руки:'
                *pl ' '
                *pl '— Стефан! Аманду высматриваешь? Я в окно приметила — к ней господин Легаре подошёл. Весь из себя важный, улыбается, шёлковую ленту сунул и за локоток увлёк в переулок. Беги скорее! Нечего девчонке шептаться с этим столичным хитрецом!'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Сандра резко ставит сковороду на плиту и оборачивается к тебе, уперев руки в бока:'
                *pl ' '
                *pl '— Опять сбежала, негодница? Легаре её у крыльца подкараулил. Рассыпался соловьём, платок шёлковый сунул — она хихикнула, сбросила фартук и юркнула с ним за угол склада. Ступай приструни обоих, пока богатей ей окончательно голову не вскружил!'
            else:
                *pl 'Сандра бросает половник на стол и с досадой вытирает руки тряпкой:'
                *pl ' '
                *pl '— Ищешь нашу вертихвостку? Прямо под окном крутилась с Легаре! Он её за талию облапил, она к нему жмётся, смеётся на весь двор. Увёл за поленницу. Совсем стыд потеряла девка — посреди белого дня перед гостями хвостом крутит!'
            end
        else:
            if $AmandaCatchSceneType = 'neighbor_group':
                if FamilyCorruptionStage <= 2:
                    *pl 'Сандра раскладывает пироги на противень и тревожно машет рукой в сторону окна:'
                    *pl ' '
                    *pl '— Стефан, беги к старому сараю! Ханс, Курт и сапожников Феликс всей гурьбой на сеновал полезли, а Аманда поднос бросила и со смехом за ними припустила! Втроём её окружили, добром это не кончится!'
                else:
                    *pl 'Сандра с грохотом опускает чугунную сковороду на плиту и сердито сплёвывает:'
                    *pl ' '
                    *pl '— Сестра твоя совсем страх потеряла! Ханс, Курт и Феликс свистнули из-за плетня — она передник долой и сразу к ним на сеновал! Вся троица вокруг вьётся, руки распускают. Иди разгони стадо, пока люди на улице пальцами тыкать не начали!'
                end
            elseif $AmandaCatchSceneType = 'neighbor_pair':
                if FamilyCorruptionStage <= 2:
                    *pl 'Сандра кивает в сторону кухонного окна:'
                    *pl ' '
                    *pl '— Гляди в оба: во двор скользнули ' + $AmandaEscapePartnerName + ' и ' + $AmandaEscapePartnerName2 + '. Аманда как увидела их — поднос на лавку и следом юркнула. Шушукаются за сараем вдвоём на одну девку! Беги, пока не натворили глупостей!'
                else:
                    *pl 'Сандра быстро шинкует капусту, тяжело стуча ножом по доске:'
                    *pl ' '
                    *pl '— Парни за ней уже парами ходят! ' + $AmandaEscapePartnerName + ' с ' + $AmandaEscapePartnerName2 + ' увели её к старой телеге. Стоят, лапают средь бела дня, а в зале столы грязью заросли. Сходи да всыпь обоим!'
                end
            else:
                if FamilyCorruptionStage <= 1:
                    *pl 'Сандра качает головой и указывает ложкой на заднюю дверь:'
                    *pl ' '
                    *pl '— Видела я в щёлку: к сараю прокрался ' + $AmandaEscapePartnerName + '. Аманда как приметила его — сразу во двор метнулась. Ступай верни её за стойку, нечего девке по углам жаться.'
                elseif FamilyCorruptionStage <= 3:
                    *pl 'Сандра хмурит брови и недовольно морщится:'
                    *pl ' '
                    *pl '— Опять ' + $AmandaEscapePartnerName + ' у плетня вертится! Аманда кружки побросала и выскочила наружу. Стоят за поленницей, смешки да переглядки. Иди разгони бездельников!'
                else:
                    *pl 'Сандра раздражённо взмахивает полотенцем:'
                    *pl ' '
                    *pl '— Парни только свистнут, а эта сразу юбку подбирает! Едва замаячил ' + $AmandaEscapePartnerName + ' — передник под лавку и бегом. Ступай к сараю, пока они там не ославили весь наш дом!'
                end
            end
        end

    elseif $EscapeTextId = 'catch_spot':
        if $EscapeSceneType = 'legare_early':
            if FamilyCorruptionStage <= 1:
                *pl 'Ты осторожно заглядываешь в узкий переулок за трактиром.'
                *pl ' '
                *pl 'Аманда стоит спиной к кирпичной стене, вся пунцовая от смущения. Легаре держит её за пальцы, мягко поглаживая ладонь, и с бархатной улыбкой шепчет что-то на ухо. Сестра опускает глаза в землю, робко улыбается, но руку не отнимает.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Легаре прижал Аманду к шероховатой стене переулка, по-хозяйски обняв за тонкую талию. В пальцах сестры блестит тонкая шёлковая лента.'
                *pl ' '
                *pl 'Она негромко смеётся, положив руку купцу на грудь. Когда тот наклоняется к её шее, Аманда чуть отстраняется, игриво дразня кавалера и вздрагивая от его горячего дыхания.'
            else:
                *pl 'В дальнем глухом тупике переулка Аманда прижата к кирпичной кладке. Её корсаж расшнурован, обнажая пышные полукружия груди.'
                *pl ' '
                *pl 'Легаре сжимает её упругие бёдра, тесно притираясь пахом. Сестра жадно обвивает его шею обеими руками, запрокидывает голову и сама тянется к его губам для долгого поцелуя.'
            end

        elseif $EscapeSceneType = 'legare_blowjob':
            if FamilyCorruptionStage <= 1:
                *pl 'В полумраке переулка Легаре стоит, прислонившись к стене, с расстёгнутым поясом. Аманда опустилась перед ним на колени прямо на брошенный плащ.'
                *pl ' '
                *pl 'Она дрожит, робко оглядываясь по сторонам, и несмело берёт его горячий ствол в ладони. Осторожно коснувшись кончиком языка головки, она послушно берёт плоть в рот. Легаре ласково гладит её по волосам, направляя движения сестры до дрожи в ногах.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Аманда уверенно стоит на коленях между бёдер Легаре. Одной рукой она опирается о его колено, а второй направляет крупный член себе в рот, двигая головой плавно и глубоко.'
                *pl ' '
                *pl 'Купец зарывается пальцами в её распущенные волосы, прерывисто дыша. Спустя минуту он шумно стонет, и Аманда послушно принимает в себя его горячие толчки, поднимая снизу вверх лукавый взгляд.'
            else:
                *pl 'Аманда без тени стеснения стоит на четвереньках в пыли переулка. Её губы жадно и ненасытно скользят по стволу Легаре, уходя до самого основания.'
                *pl ' '
                *pl 'Она упивается своей властью, лаская его плоть языком и пальцами. Когда купец сотрясается в мощном оргазме, она жадно сглатывает всё до последней капли и облизывает губы с довольной усмешкой.'
            end

        elseif $EscapeSceneType = 'legare_sex':
            if FamilyCorruptionStage <= 1:
                *pl 'Легаре осторожно развернул Аманду лицом к деревянным ящикам и поднял подол её платья. Сестра крепко вцепилась пальцами в доски, прикусив губу в ожидании.'
                *pl ' '
                *pl 'Он медленно и плавно входит в неё сзади. Аманда тихо ойкает, но тут же начинает подаваться навстречу. Их дыхание сливается в единый сбивчивый ритм, пока оба не замирают в крепких тисках объятий.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Аманда упёрлась ладонями в край широкой лавки, задрав юбку до поясницы. Легаре крепко сжимает её бёдра, мерно и глубоко толкаясь внутрь.'
                *pl ' '
                *pl 'Сестра прижимает ладонь ко рту, глуша сладострастные стоны, и охотно покачивает задом в такт его движениям. С глухим рыком купец вбивается до упора, содрогаясь вместе с дрожащей от наслаждения девчонкой.'
            else:
                *pl 'Аманда сидит на высоком штабеле ящиков, широко раскинув ноги и закинув их Легаре на бёдра. Купец властно сминает её грудь, вгоняя член на всю глубину.'
                *pl ' '
                *pl 'Она громко и бесстыдно стонет на весь переулок, впиваясь ногтями ему в плечи. Её бёдра бьются навстречу каждому удару, пока бурный оргазм не накрывает обоих с головой.'
            end

        elseif $EscapeSceneType = 'legare_corrupt':
            *pl 'Аманда покорно прогнулась над тюками с сукном, обнажив круглые ягодицы. Легаре прижимает её поясницу, неторопливо и властно входя в её узкую попу.'
            *pl ' '
            *pl 'Сестра глухо вскрикивает, закусив костяшки пальцев, но тут же расслабляется и сама подаётся назад, принимая весь напор. Купец ускоряет темп, вбивая её в тюки, пока оба не замирают в изнеможении от сокрушительного финала.'

        elseif $EscapeSceneType = 'neighbor_early':
            if FamilyCorruptionStage <= 1:
                *pl 'За старым сараем Аманда стоит, прижавшись спиной к поленнице. ' + $AmandaEscapePartnerName + ' держит её за руку и несмело тянется поцеловать в щёку. Сестра звонко хихикает и смущённо отворачивает лицо.'
            elseif FamilyCorruptionStage <= 3:
                *pl $AmandaEscapePartnerName + ' прижал Аманду к дощатой стене сарая, жадно целуя её в губы. Его ладонь уверенно скользнула под юбку, сжимая нежное бедро. Сестра горячо отвечает на поцелуй, обвив его шею руками.'
            else:
                *pl 'Аманда сидит на краю телеги, задрав платье выше колен. ' + $AmandaEscapePartnerName + ' жадно сжимает её голые бёдра, покрывая поцелуями шею и ключицы. Сестра сама притягивает парня ближе, довольно смеясь.'
            end

        elseif $EscapeSceneType = 'neighbor_blowjob':
            if FamilyCorruptionStage <= 1:
                *pl $AmandaEscapePartnerName + ' стоит возле колеса телеги, судорожно сжимая спущенные штаны. Аманда опустилась перед ним на колени прямо в солому.'
                *pl ' '
                *pl 'Она осторожно обхватывает его член губами, двигаясь неуверенно и медленно. Парень тяжело дышит, зажмурив глаза, и вскоре шумно выдыхает, содрогаясь от нахлынувшего жара.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Аманда уверенно работает губами перед ' + $AmandaEscapePartnerName + ', опустившись на колени в солому. Одной рукой она ловко помогает себе у основания, задавая быстрый ритм.'
                *pl ' '
                *pl 'Парень запрокидывает голову и глухо мычит от восторга. Спустя мгновение он кончает ей в рот, а сестра послушно сглатывает и вытирает подбородок рукавом платья.'
            else:
                *pl 'Аманда встала на четвереньки прямо в сухую солому за сараем. Она ненасытно и жадно заглатывает член парня до самого горла, сверкая озорными глазами.'
                *pl ' '
                *pl $AmandaEscapePartnerName + ' судорожно цепляется за борт телеги и сотрясается в безудержной разрядке. Аманда не выпускает его до самого конца, вылизывая ствол начисто.'
            end

        elseif $EscapeSceneType = 'neighbor_sex':
            if FamilyCorruptionStage <= 1:
                *pl $AmandaEscapePartnerName + ' развернул Аманду к телеге, поднял подол и аккуратно вошёл сзади.'
                *pl ' '
                *pl 'Сестра вцепилась пальцами в дощатый борт, тихо ойкая при каждом толчке. Парень двигается осторожно, пока дрожь наслаждения не охватывает обоих, заставляя Аманду бессильно обмякнуть.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Аманда опирается на колесо телеги, гибко выгнув спину. ' + $AmandaEscapePartnerName + ' крепко держит её за бёдра, глубоко и ритмично входя внутрь.'
                *pl ' '
                *pl 'Сестра шумно дышит, охотно подыгрывая каждому движению задом. Они кончают почти одновременно, сдавленно вскрикивая в полуденную тишину двора.'
            else:
                *pl 'Аманда раскинулась на куче свежей соломы, закинув ноги парню на плечи. ' + $AmandaEscapePartnerName + ' мощно и размашисто вбивается в неё, сжимая упругие бёдра.'
                *pl ' '
                *pl 'Сестра громко стонет, требуя ещё и ещё, пока бурный оргазм не скручивает её тело в сладких судорогах.'
            end

        elseif $EscapeSceneType = 'neighbor_pair':
            if FamilyCorruptionStage <= 2:
                *pl 'За сараем Аманда оказалась в кольце сразу двоих парней. Один обнимает её сзади за талию и целует шею, а второй гладит её обнажённое бедро под юбкой.'
                *pl ' '
                *pl 'Щёки сестры пылают, грудь тяжело вздымается от смущения и тайного восторга, но она и не думает вырываться.'
            else:
                *pl 'Аманда беззаботно развлекается сразу с двумя кавалерами. ' + $AmandaEscapePartnerName + ' пристроился сзади, мерно толкаясь в её лоно, а ' + $AmandaEscapePartnerName2 + ' стоит перед ней — и сестра с жаром ласкает его губами.'
                *pl ' '
                *pl 'Оба парня стонут от нетерпения, кончая почти одновременно. Аманда ловко справляется с обоими, довольно жмурясь и посмеиваясь от переполняющего её жара.'
            end

        elseif $EscapeSceneType = 'neighbor_group':
            if FamilyCorruptionStage <= 2:
                *pl 'На сеновале в полумраке Аманду обступила троица — Ханс, Курт и Феликс. Парни нетерпеливо расстёгивают пояса, окружив её в кольцо.'
                *pl ' '
                *pl 'Сестра сидит в мягком сене, поджав ноги. Её щёки горят румянцем, а в глазах плещется озорное любопытство пополам со страхом.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'На сеновале Аманда вовсю забавляется с тремя дружками. Один целует её в губы, второй сжимает податливую грудь через тонкую ткань, а третий уже направляет член к её рту.'
                *pl ' '
                *pl 'Сестра тихо хихикает, подаётся навстречу ласкам и с готовностью принимает плоть на язык.'
            else:
                *pl 'На сеновале развернулся настоящий разврат. Аманда полностью отдалась троим дружкам: Ханс уверенно входит в неё сзади, Курт упивается её грудью, а Феликс глубоко заходит ей в рот.'
                *pl ' '
                *pl 'Сестра стонет от дикого восторга, выгибаясь в сене. Парни по очереди отдают ей своё семя, пока Аманда обессиленно не валится в солому с блаженной улыбкой на губах.'
            end
        end

    elseif $EscapeTextId = 'interrupt':
        if $EscapeSceneType = 'legare_early' or $EscapeSceneType = 'legare_blowjob' or $EscapeSceneType = 'legare_sex' or $EscapeSceneType = 'legare_corrupt':
            *pl 'Ты решительно выходишь из тени переулка:'
            *pl '— Легаре! Ты берега не попутал — среди бела дня хозяйскую сестру по углам тискать?'
            *pl ' '
            *pl 'Легаре не спеша отстраняется, невозмутимо поправляет шёлковый камзол и бросает на тебя снисходительный взгляд:'
            *pl '— Стефан... К чему этот шум? Мы лишь приятно беседовали. Твоей сестре очень идёт галантное внимание. Не горячись, мальчик. Нашему трактиру ещё пригодятся мои заказы.'
            *pl ' '
            *pl 'С лёгкой ухмылкой купец разворачивается и неспешным шагом скрывается за углом.'
            *pl ' '
            if FamilyCorruptionStage <= 1:
                *pl 'Аманда стоит бледная как полотно, торопливо одёргивая подол платья. Она прячет лицо в ладонях, не смея поднять на тебя глаза.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Аманда сердито надувает губы и топает ногой:'
                *pl '— Стефан! Вечно ты лезешь со своими нравоучениями! Он мне подарок принёс и ленты обещал, а ты всё испортил!'
            else:
                *pl 'Аманда лениво поправляет шнуровку корсажа и усмехается тебе прямо в лицо:'
                *pl '— Ну вот, всю забаву разогнал. Такой кавалер обходительный был, а ты примчался как цепной пёс.'
            end

        elseif $EscapeSceneType = 'neighbor_pair':
            *pl 'Ты с яростным криком выскакиваешь из-за угла сарая:'
            *pl '— А ну пошли вон отсюда, оба! Сейчас оглоблю возьму — хребты переломаю!'
            *pl ' '
            *pl $AmandaEscapePartnerName + ' и ' + $AmandaEscapePartnerName2 + ' в дикой панике подхватывают штаны и, сшибая коленями забор, кубарем переваливаются в соседний огород.'
            *pl ' '
            if FamilyCorruptionStage <= 1:
                *pl 'Аманда вжимается спиной в борт телеги, испуганно закрывая пылающее лицо руками.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Аманда скрещивает руки на груди и сердито хмурится:'
                *pl '— Чего ты на парней кидаешься?! Мы просто стояли и смеялись!'
            else:
                *pl 'Аманда звонко цокает языком и отряхивает юбку от соломы:'
                *pl '— Разогнал кавалеров, грозный хозяин... Кто теперь мне спинку чесать будет?'
            end

        else:
            *pl 'Ты выступаешь вперёд, грозно повышая голос:'
            *pl '— А ну брысь отсюда, лоботрясы блудливые! Ноги повыдёргиваю!'
            *pl ' '
            *pl 'Парни в ужасе врассыпную кидаются к забору, на ходу подтягивая штаны, и мгновенно растворяются в кустах.'
            *pl ' '
            if FamilyCorruptionStage <= 1:
                *pl 'Аманда вздрагивает, прижимает ладони к груди и испуганно опускает голову.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Аманда раздражённо вскидывает подбородок:'
                *pl '— Опять пришёл орать! Шагу ступить без твоей слежки нельзя!'
            else:
                *pl 'Аманда отряхивает подол с ленивой усмешкой:'
                *pl '— Горло только зря дерёшь. Парней перепугал, а сам теперь за ними убирать будешь?'
            end
        end

    elseif $EscapeTextId = 'watch_scene':
        if $EscapeSceneType = 'legare_early':
            *pl 'Ты остаёшься в тени за штабелем досок, наблюдая за ними.'
            *pl ' '
            *pl 'Легаре притягивает Аманду к себе и долго целует её в губы, пока его пальцы ласкают её грудь поверх корсажа. Затем он шепчет ей обещание скорой встречи, дарит обещанную ленту и не спеша уходит. Сестра остаётся стоять у кирпичей, тяжело дыша и прижимая ладонь к горящим губам.'

        elseif $EscapeSceneType = 'legare_blowjob':
            *pl 'Аманда на коленях доводит начатое дело до конца. Легаре с глухим стоном сотрясается, запуская пальцы ей в волосы.'
            *pl ' '
            *pl 'Сестра послушно сглатывает семя. Купец довольно оглаживает её по подбородку, обещает привезти сладких гостинцев и приводит одежду в порядок. Когда он скрывается за углом, Аманда медленно поднимается с колен, вытирая губы.'

        elseif $EscapeSceneType = 'legare_sex':
            *pl 'Мерный стук тел о ящики разносится по переулку. Легаре мощно вбивается в Аманду, пока та судорожно сжимает край досок, заглушая собственные стоны.'
            *pl ' '
            *pl 'После финального толчка купец шумно выдыхает ей в затылок, медленно выходит и заботливо опускает её подол. Поцеловав девушку в висок, он удаляется. Аманда бессильно прислоняется к стене, переводя дух.'

        elseif $EscapeSceneType = 'legare_corrupt':
            *pl 'Легаре безжалостно и сладко терзает Аманду в тугой зад на тюках сукна. Сестра стонет, вжимаясь лицом в шерсть, пока оба не достигают изнурительного пика.'
            *pl ' '
            *pl 'Купец застёгивает пояс, накидывает ей на шею обещанную цепочку и покидает переулок. Аманда медленно сползает на колени, тяжело и прерывисто дыша.'

        elseif $EscapeSceneType = 'neighbor_early':
            *pl 'Парень долго и жадно целует Аманду за поленницей, поглаживая её крутые бёдра. Наконец, боязливо оглянувшись на окна трактира, он перемахивает через плетень. Сестра остаётся одна, с блаженной улыбкой оправляя юбку.'

        elseif $EscapeSceneType = 'neighbor_blowjob':
            *pl 'Аманда на коленях возле телеги старательно ублажает дружка. Парень хрипит, зажмурившись, и сотрясается в сладкой судороге.'
            *pl ' '
            *pl 'Сестра сглатывает, вытирает лицо фартуком и торопливо споласкивает рот водой из уличной бочки, довольно посматривая на убегающего парня.'

        elseif $EscapeSceneType = 'neighbor_sex':
            *pl 'Колесо телеги глухо поскрипывает под их напором. Парень шумно и яростно доводит Аманду до дрожи в ногах, пока она судорожно цепляется за спицы.'
            *pl ' '
            *pl 'Закончив дело, парень наскоро поддёргивает штаны и убегает через огороды. Аманда остаётся сидеть на траве, пытаясь унять дрожь в бёдрах.'

        elseif $EscapeSceneType = 'neighbor_pair':
            *pl 'Оба парня по очереди и вместе берут от Аманды всё, что хотели, укрывшись за сараем. Сестра стонет, успевая одарить лаской каждого.'
            *pl ' '
            *pl 'Оставив девушку раскрасневшейся и обессиленной, дружки весело перемигиваются и исчезают за забором. Аманда медленно поднимается, с трудом натягивая чулки.'

        elseif $EscapeSceneType = 'neighbor_group':
            *pl 'Троица на сеновале упивается податливым телом Аманды, сменяя друг друга в сладком безумии. Сестра стонет под их напором, отдаваясь без остатка.'
            *pl ' '
            *pl 'Когда все трое наконец насыщаются и спускаются по приставной лестнице во двор, Аманда ещё долго лежит в измятой соломе, глядя в щели крыши с шальной улыбкой.'
        end

    elseif $EscapeTextId = 'post_watch_confront_intro':
        *pl 'Ты неторопливо выходишь из своего укрытия. Аманда вздрагивает, оборачивается на звук шагов — и по её лицу становится ясно: она поняла, что ты видел всё от начала до конца.'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl '— Стефан?! — её голос срывается от ужаса. Она судорожно прижимает руки к груди, бледнея на глазах. — Ты... ты всё это время стоял там?! Умоляю, ради Ильматера, не говори маме!'
        elseif FamilyCorruptionStage <= 3:
            *pl '— Стефан?.. — густой румянец заливает её щёки и шею. Она кусает нижнюю губу и виновато отводит взгляд. — Ты подглядывал? Не злись... мы просто немного увлеклись.'
        else:
            *pl '— Ой, Стефан! — она медленно проводит языком по губам, бесстыдно разглядывая тебя с головы до ног. — Давно любуешься? Ну и как тебе представление?'
        end

    elseif $EscapeTextId = 'watch_quiet_leave':
        *pl 'Ты бесшумно разворачиваешься и уходишь обратно в общий зал трактира.'
        *pl ' '
        *pl 'Примерно через четверть часа в дверях наконец появляется Аманда.'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl 'Она бледна, прячет глаза от гостей и молча повязывает передник, тут же хватаясь за гору немытых кружек.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Её щёки ещё горят румянцем, на губах блуждает робкая улыбка. Она берёт поднос и украдкой бросает в твою сторону настороженные взгляды.'
        else:
            *pl 'Она вплывает в зал неспешной, покачивающейся походкой. Корсаж едва удерживает раскрасневшуюся грудь, а взгляд сестры вызывающе скользит по твоему лицу.'
        end

    elseif $EscapeTextId = 'choice_ban_rebel':
        *pl '— Аманда! Я ясно и строго запретил тебе путаться с чужими мужиками по углам! Ты мало того что нарушила слово, так ещё и бросила гостей посреди смены!'
        *pl ' '
        if FamilyCorruptionStage <= 2:
            *pl '— Ты мне не хозяин и не господин! — вспыхивает Аманда, сжимая кулачки. — Я свободная девушка, а не твоя рабыня! С кем хочу стоять — с тем и буду!'
        else:
            *pl '— Хватит строить из себя святого праведника! — дерзко усмехается сестра. — Я молодая, мне мужской ласки хочется, а не только тряпкой махать. Твои дурацкие запреты мне смешны!'
        end

    elseif $EscapeTextId = 'choice_ban_guilt':
        *pl '— Аманда, мы же семья. Мы договаривались помогать друг другу и держать марку нашего дома. Зачем ты позоришь нас и нарушаешь слово?'
        *pl ' '
        if FamilyCorruptionStage <= 2:
            *pl '— Стефан... прости меня, пожалуйста! — шепчет Аманда, виновато пряча глаза. — Дурная голова совсем закружилась от сладких речей... Клянусь Ильматером, я больше тебя не подведу!'
        else:
            *pl '— Ладно тебе, не читай морали... — неловко передёргивает плечами сестра. — Не хотела я подставлять трактир. Впредь буду осмотрительнее.'
        end

    elseif $EscapeTextId = 'choice_shameless':
        *pl '— Совсем стыд потеряла? Прямо под стенами родного трактира, в грязи и соломе, средь бела дня! Увидят горожане — на смех поднимут и нас, и тебя!'
        *pl ' '
        if FamilyCorruptionStage <= 2:
            *pl '— Не кричи так... — Аманда заливается краской до самых корней волос. — Сама не знаю, что на меня нашло. Сейчас пойду к умывальнику, приведу себя в порядок и вернусь за столы.'
        else:
            *pl '— Брось ханжеские проповеди! — отмахивается Аманда с шальной улыбкой. — На фронтире все так живут и радуются. Зато сколько сладости было... тебе ли не знать?'
        end

    elseif $EscapeTextId = 'choice_claim':
        *pl 'Ты шагаешь вперёд, властно прижимаешь Аманду спиной к стене и берёшь её за подбородок:'
        *pl '— Раз в твоей крови среди рабочего дня столько жара — я сам найду ему достойное применение.'
        *pl ' '
        *pl 'Ты наклоняешься и накрываешь её губы глубоким, хозяйским поцелуем.'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl 'Аманда испуганно ойкает, упираясь ладошками тебе в грудь, но спустя миг её сопротивление тает, и она робко приоткрывает губы навстречу.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Она мгновенно обвивает твою шею руками, прижимается всем телом и тихо стонет прямо в поцелуй, забыв обо всём на свете.'
        else:
            *pl 'Она горячо подаётся вперёд бёдрами, притираясь к твоему паху, и хрипло шепчет в губы:'
            *pl '— Вот это по-мужски... Ты стоишь их всех вместе взятых. Не отпускай меня...'
        end

    elseif $EscapeTextId = 'choice_strict':
        *pl '— В зале гости стучат кружками, столы жирные, заказы остывают! Живо надень передник и марш к стойке, пока я не снял штраф с твоей доли!'
        *pl ' '
        *pl 'Аманда испуганно подбирает брошенный фартук, торопливо завязывает тесёмки за спиной и спешит в зал, не решаясь спорить с суровым хозяином.'

    elseif $EscapeTextId = 'choice_talk':
        *pl 'Ты вздыхаешь, присаживаешься на край телеги и говоришь спокойно, без крика и брани:'
        *pl ' '
        if $AmandaEscapePartner = 'legare':
            *pl '— Аманда, пойми ты наконец: Легаре — богатый столичный купец. Для таких вельмож простые трактирные девушки — лишь мимолётная забава. Он подарит ленту, пообещает златые горы, а потом уедет восвояси, оставив тебя с разбитым сердцем и сплетнями на весь рынок.'
        else:
            if $AmandaCatchSceneType = 'neighbor_group':
                *pl '— Пускать к себе троих парней на сеновале — это уже не шалость. Завтра они растреплют в каждой кузнице и пекарне, и отбоя от наглецов не будет.'
            elseif $AmandaCatchSceneType = 'neighbor_pair':
                *pl '— Крутить сразу с двумя у забора — последнее дело. Парни между собой похвалятся, а грязь прилипнет к твоему имени.'
            else:
                *pl '— Соседские лоботрясы только и ищут, кого бы затискать в темноте, а потом будут горланить по кабакам, перевирая всё в десять раз. Тебе потом перед людьми глаз не поднять будет.'
            end
        end
        *pl ' '
        *pl 'Аманда внимательно слушает тебя, опустив глаза в землю. Видно, как твои слова находят отклик в её душе. Она тихо вздыхает и искренне говорит:'
        *pl '— Ты прав, Стефан... Спасибо, что бережёшь меня от дурной славы. Пойдём, я сейчас же помогу тебе в зале.'
    end

    killvar '$EscapeTextId'
    killvar '$EscapeSceneType'
---