! ================================================
! FILE: modules/events/tavern/amanda_escape_work_text.qsps
! MODULE: events/tavern
! [AI-WORKED] Текст переработан / дополнен ассистентом 05.11.2026
! Тексты побега Аманды со смены в зале (Escape from work)
! Свидания с Легаре, соседские парни, тройничек, сеновал
! Вариативность по FamilyCorruptionStage 0-5
!
! ================================================
! АРХИТЕКТУРА И СТРУКТУРА СЦЕН ПОБЕГА СО СМЕНЫ:
! ================================================
!
!  [1. intro]
!     Локация: #AmandaEscapeWorkStart
!     Смысл: Стефан замечает, что Аманда бросила работу и сбежала (фартук брошен).
!     Выбор игрока: куда пойти искать (кухня Сандры / переулок / задний двор).
!
!  [2. search_sandra]
!     Локация: #AmandaEscapeWorkSearch ('sandra')
!     Смысл: Подсказка Сандры на кухне (видела в окно, куда и с кем ушла Аманда).
!
!  [3. catch_spot]  <-- ВНИМАНИЕ: СТОП-КАДР / ЗАВЯЗКА (ДО ВЫБОРА!)
!     Локация: #AmandaEscapeWorkCatch
!     Смысл: Стефан выследил Аманду и заглянул из укрытия.
!     ПРАВИЛО: Здесь описывается только НАЧАЛЬНЫЙ МОМЕНТ встречи / ласк.
!     НЕТ кульминации, финала или оргазмов, потому что игрок ещё НЕ выбрал:
!       - Кнопка «Вмешаться немедленно (прервать до начала!)» -> переход в interrupt
!       - Кнопка «Не вмешиваться (наблюдать из укрытия)» -> переход в watch_scene
!
!  [4. interrupt]
!     Локация: #AmandaEscapeWorkInterrupt
!     Смысл: Игрок нажал «Вмешаться!». Стефан выскакивает, спугивает партнёров,
!     прерывая близость на корню (парни убегают / Легаре галантно уходит).
!
!  [5. watch_scene]  <-- ВНИМАНИЕ: КУЛЬМИНАЦИЯ И РАЗВЯЗКА НАБЛЮДЕНИЯ
!     Локация: #AmandaEscapeWorkWatch
!     Смысл: Игрок нажал «Не вмешиваться». Стефан остаётся в тени.
!     ПРАВИЛО: Здесь описывается полное развитие сцены ДО ФИНАЛА (кульминация,
!     оргазмы, благодарности, завершение близости и уход партнёра).
!
!  [6. post_watch_confront_intro]
!     Локация: #AmandaEscapeWorkPostWatchConfront
!     Смысл: Стефан выходит к оставшейся в одиночестве Аманде после увиденного.
!
!  [7. watch_quiet_leave]
!     Локация: #AmandaEscapeWorkWatchLeave
!     Смысл: Стефан тихо возвращается в зал, не раскрывая себя, и ждёт сестру.
!
!  [8. choice_*]
!     Локация: #AmandaEscapeWorkConfront
!     Смысл: Реплики разговора Стефана и Аманды (строгость / запрет / поцелуй и т.д.).
! ================================================

#AmandaEscapeWorkText
$EscapeTextId = LCASE($ARGS[0])
$EscapeSceneType = LCASE($ARGS[1])

! ----------------------------------------------------
! 1. INTRO — АМАНДА ИСЧЕЗЛА СО СМЕНЫ
! Вызывается из: #AmandaEscapeWorkStart
! ----------------------------------------------------
if $EscapeTextId = 'intro':
    if FamilyCorruptionStage <= 1:
        *pl 'В зале стоит обычный для полудня шум. Ремесленники за дальним столом громко спорят о ценах на кожу, торговец у окна нетерпеливо стучит кружкой по столешнице, а у стойки скапливается очередь за выпивкой.'
        *pl ' '
        *pl 'Ты оглядываешь столы, но знакомой попки нигде не видно. На спинке угловой скамьи аккуратно висит холщовый передник Аманды, а рядом сиротливо стоит деревянный поднос.'
        *pl ' '
        *pl 'Сестра опять ускользнула прямо посреди работы, оставив гостей на тебя и Мелиссу.'
    elseif FamilyCorruptionStage <= 3:
        *pl 'В разгар смены зал гудит от разговоров и стука кружек. Посетители требуют эля, вина и жаркого, но разносить заказы некому.'
        *pl ' '
        *pl 'У выхода на задний двор на лавке валяется скомканный передник Аманды. Похоже, она скинула его в спешке, даже не оглянувшись.'
        *pl ' '
        *pl 'Опять бросила работу ради встречи, с каким то из своих ухажеров.'
    else:
        *pl 'В зале тесно и шумно от десятков посетителей. Гости громко перекликаются, стучат кружками о доски и посмеиваются.'
        *pl ' '
        *pl 'Фартук Аманды небрежно брошен прямо у двери. Заметив твой растерянный взгляд, клиент за ближним столом широко скалится:'
        *pl '— Хозяин, сестрицу высматриваешь? Так она только что упорхнула во двор! Глаза блестят, ленты в волосах развеваются — видать, кавалер не ждёт!'
        *pl ' '
        *pl 'Аманда ушла со смены в открытую, даже не пытаясь придумать отмазку.'
    end

    ! ----------------------------------------------------
    ! 2. SEARCH_SANDRA — ПОДСКАЗКА САНДРЫ НА КУХНЕ
    ! Вызывается из: #AmandaEscapeWorkSearch ('sandra')
    ! ----------------------------------------------------
elseif $EscapeTextId = 'search_sandra':
    if $AmandaEscapePartner = 'legare':
        if FamilyCorruptionStage <= 1:
            *pl 'Ты заглядываешь на кухню. Сандра как раз снимает горячую крышку с котла и, заметив твой взгляд, сердито отряхивает руки:'
            *pl ' '
            *pl '— Стефан! Аманду высматриваешь? Я в окно приметила — к ней господин Легаре подошёл. Весь из себя важный, улыбается, шёлковую ленту сунул и за локоток увлёк в переулок. Беги скорее! Нечего девчонке шептаться с этим хитрецом!'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Сандра резко ставит сковороду на плиту и оборачивается к тебе, уперев руки в бока:'
            *pl ' '
            *pl '— Опять сбежала, негодница? Легаре её у крыльца подкараулил. Рассыпался соловьём, платок шёлковый сунул — она хихикнула, сбросила фартук и юркнула с ним за угол склада. Ступай приструни обоих, пока купец ее нам не разложил, работа не ждет!'
        else:
            *pl 'Сандра бросает половник на стол и с досадой вытирает руки тряпкой:'
            *pl ' '
            *pl '— Ищешь нашу вертихвостку? Прямо под окном крутилась с Легаре! Он её за талию облапил, она к нему жмётся, смеётся на весь двор. Увёл за поленницу. Это конечно Легаре купец богатый, если дает ему, так даже и неплохо, но не посреди работы!'
        end
    else:
        if $AmandaCatchSceneType = 'neighbor_group':
            if FamilyCorruptionStage <= 2:
                *pl 'Сандра раскладывает пироги на противень и тревожно машет рукой в сторону окна:'
                *pl ' '
                *pl '— Стефан, беги к старому сараю! Ханс, Курт и сапожников Феликс всей гурьбой на сеновал полезли, а Аманда поднос бросила и со смехом за ними припустила! Втроём её окружили, добром это не кончится!'
            else:
                *pl 'Сандра с грохотом опускает чугунную сковороду на плиту и сердито сплёвывает:'
                *pl ' '
                *pl '— Сестра твоя совсем страх потеряла! Ханс, Курт и Феликс свистнули из-за плетня — она передник долой и сразу к ним на сеновал! Они же ее так оттрахают, что она до конца дня ходит не сможет, иди разгони!'
            end
        elseif $AmandaCatchSceneType = 'neighbor_pair':
            if FamilyCorruptionStage <= 2:
                *pl 'Сандра кивает в сторону кухонного окна:'
                *pl ' '
                *pl '— Гляди в оба: во двор скользнули ' + $AmandaEscapePartnerName + ' и ' + $AmandaEscapePartnerName2 + '. Аманда как увидела их — поднос на лавку и следом юркнула. Шушукаются за сараем вдвоём на одну девку! Беги, пока не натворили глупостей!'
            else:
                *pl 'Сандра быстро шинкует капусту, тяжело стуча ножом по доске:'
                *pl ' '
                *pl '— Парни за ней уже парами ходят! ' + $AmandaEscapePartnerName + ' с ' + $AmandaEscapePartnerName2 + ' увели её к старой телеге. Стоят, руки вдвоем под юбку запустили, а в зале народ голодный, Мелисса одна не справляется. Сходи да всыпь всем троим!'
            end
        else:
            if FamilyCorruptionStage <= 1:
                *pl 'Сандра качает головой и указывает ложкой на заднюю дверь:'
                *pl ' '
                *pl '— Видела я к сараю прокрался ' + $AmandaEscapePartnerName + '. Аманда как приметила его — сразу во двор метнулась. Ступай верни её за стойку, нечего девке по первому свисту за парнем бежать.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Сандра хмурит брови и недовольно морщится:'
                *pl ' '
                *pl '— Опять ' + $AmandaEscapePartnerName + ' у плетня вертится! Аманда кружки побросала и выскочила наружу. Стоят за поленницей, смешки да переглядки. Иди разгони бездельников!'
            else:
                *pl 'Сандра раздражённо взмахивает полотенцем:'
                *pl ' '
                *pl '— Парни только свистнут, а эта сразу юбку подбирает! Едва замаячил ' + $AmandaEscapePartnerName + ' — передник под лавку и бегом. Ступай к сараю, он уже наверно ей и присунуть успел, Аманда быстро ноги разводит.!'
            end
        end
    end

    ! ----------------------------------------------------
    ! 3. CATCH_SPOT — МОМЕНТ ОБНАРУЖЕНИЯ (ЗАВЯЗКА / СТОП-КАДР)
    ! Вызывается из: #AmandaEscapeWorkCatch
    ! Смысл: Стефан выследил Аманду и заглянул из укрытия.
    ! ВАЖНО: Сцена ТОЛЬКО НАЧИНАЕТСЯ или находится в процессе ласк.
    ! НИКАКОГО ФИНАЛА (семяизвержения, оргазмов, ухода партнёров) здесь нет,
    ! так как именно на этом экране игрок решает:
    !   1) "Вмешаться немедленно" -> прервать до финала (#AmandaEscapeWorkInterrupt)
    !   2) "Не вмешиваться" -> досмотреть до конца (#AmandaEscapeWorkWatch)
    ! ----------------------------------------------------
elseif $EscapeTextId = 'catch_spot':
    if $EscapeSceneType = 'legare_early':
        if FamilyCorruptionStage <= 1:
            *pl 'Ты осторожно заглядываешь в узкий переулок за трактиром.'
            *pl ' '
            *pl 'Аманда стоит спиной к кирпичной стене, вся пунцовая от смущения. Легаре держит её за пальцы, мягко поглаживая ладонь, и с бархатной улыбкой шепчет что-то на ухо. Сестра опускает глаза в землю, робко улыбается, но руку не отнимает.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Легаре прижал Аманду к шероховатой стене переулка,  обняв за тонкую талию, и сжимая попку. В пальцах сестры блестит тонкая шёлковая лента.'
            *pl ' '
            *pl 'Она негромко смеётся, положив руку купцу на грудь. Когда тот наклоняется к её шее, Аманда чуть отстраняется, игриво дразня кавалера и вздрагивая от его горячего дыхания.'
        else:
            *pl 'В дальнем стороне переулка Аманда прижата к кирпичной кладке. Её корсаж расшнурован, обнажая небольшие груди, котрые задорно сияют острыми сосками .'
            *pl ' '
            *pl 'Легаре сжимает её попку, тесно притираясь пахом. Сестра жадно обвивает его шею обеими руками, запрокидывает голову и сама тянется к его губам для долгого поцелуя.'
        end

    elseif $EscapeSceneType = 'legare_blowjob':
        if FamilyCorruptionStage <= 1:
            *pl 'В полумраке переулка Легаре стоит, прислонившись к стене, с расстёгнутым поясом. Аманда опустилась перед ним на колени прямо на брошенный плащ.'
            *pl ' '
            *pl 'Она вздрагивает, оглядываясь по сторонам, и несмело берёт его горячий ствол в ладони. Осторожно коснувшись кончиком языка головки, чуть замедлевшись, открвает ротики рещительно берет в рот головку. Легаре ласково гладит её по волосам, направляя движения вашей сестры.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Аманда  стоит на коленях между бёдер Легаре. Одной рукой она гладит мошонку виноторговца, а второй направляет член себе в рот, двигая головой и возбуждающе причмокивая.'
            *pl ' '
            *pl 'Купец зарывается пальцами в её волосы, прерывисто дыша от удовольствия. Аманда вытаскивает член играется с головкой кончиком языка, бросает снизу вверх лукавый взгляд, и засунув член обратно, продолжает плавно двигать головой.'
        else:
            *pl 'Аманда на коленках в переулке. Её губы жадно скользят по члену Легаре, от кончика до самого основания.'
            *pl ' '
            *pl 'Она ласкает яица языком и пальцами одной руки, вторая рука у нее между ног, впивается в разгореченную письку твоей сестры, вызывая влажные хлюпы. Виноторговец не оставляет дело на самотек, его руки ложатся на голову Аманды и он начинает задавать темп и грубину, чем похоже только сильнее расзадоривает ее. К звукам хлюпающей киски Аманды, добавляется звук ее горла пронзаемого членом купца.'
        end

    elseif $EscapeSceneType = 'legare_sex':
        if FamilyCorruptionStage <= 1:
            *pl 'Легаре развернул Аманду лицом к деревянным ящикам и поднял подол её платья. Сестра крепко вцепилась пальцами в доски, прикусив губу в ожидании.'
            *pl ' '
            *pl '— Тише, птичка, не дрожи... — вкрадчиво шепчет купец, ласково поглаживая её по попе. — Никто сюда не заглянет.'
            *pl ' '
            *pl '— Только... аккуратно, Альбер... —  шепчет Аманда, краснея лицом. — Вдруг кто то заметит...'
            *pl ' '
            *pl 'Он проводит головкой по влажным половым губкам, а потом мяхко вставляет член. Аманда тихо ойкает, но тут же начинает подмахивать. Прихватив твою сестру за попку, купец направляет ее движения и темп, в угоду себе .'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Аманда упёрлась ладонями в край широкой лавки, задрав юбку.'
            *pl ' '
            *pl '— Как мне нравится твоя маленькая попка, птичка, — восторженно шепчет купец, сжимая булочки двумя руками. — Весь день бы тебя любил.'
            *pl ' '
            *pl '— Ой в попку не дам... —  вскрикивает Аманда, — ну пока недам...'
            *pl ' Легаре вздохнув крепко сжимает её жопку, и вставив член в раздрешонную дырочку.'
            *pl ' '
            *pl 'Сестра прижимает ладонь ко рту, глуша сладострастный стон, и начинает охотно подмахивает задом в такт его движениям. Она подстраивается под каждое его движение, прикрывая глаза от наслаждения.'
        else:
            *pl 'Аманда сидит на высоком штабеле ящиков, широко раскинув ноги и закинув их Легаре на бёдра. Купец властно сминает её грудь, вгоняя член на всю глубину.'
            *pl ' '
            *pl '— Какая же ты ненасытная, Аманда... — жадно выдыхает купец ей в губы. — Во всем городе не сыскать такой страсной девицы!'
            *pl ' '
            *pl '— Так трахай меня сильнее, Альбер! — громко стонет сестра, запрокидывая голову. — Глубже... и не сравнивай меня с другими своими девками...!'
            *pl ' '
            *pl '— Никаких сравнений, моя развратная красавица, только мой член у тебя внутри — усмехается купец, ещё сильнее прижимая её к себе.'
            *pl ' '
            *pl 'Она громко стонет на весь переулок, впиваясь ему в плечи, пока их тела бьются друг о друга во всё ускоряющемся темпе.'
        end

    elseif $EscapeSceneType = 'legare_corrupt':
        if FamilyCorruptionStage <= 3:
            *pl 'Аманда опирается о штабель ящиков, приподняв подол платья. Легаре с нескрываемым восторгом прижимается сзади, Сжимая попку и разведя булки всторону любуясь розовым анусом молодой девушки.'
            *pl ' '
            *pl '— Наконец-то, птичка моя... — шепчет купец, горячо дыша ей в шею. — В попу даешь. Я уж думал, так и будешь отказывать...'
            *pl ' '
            *pl '— Только осторожно, Альбер... и тихо, —  говорит твоя сестра. — Смаж там хорошенько... чтобы мне больно не было'
            *pl ' '
            *pl '— Не бойся, я буду аккуратен, — успокаивает её Легаре, припадая на одно колено и проникая языком в анус Аманды, смазывая ее слюной, потом медленно и бережно входит в заднюю дырочку. — Ты у меня умница. В следующий раз принесу тебе новую помаду.'
            *pl ' '
            *pl 'Аманда тихо вскрикивает, но тут же шумно выдыхает, расслабляясь и подается навстречу его неторопливым движениям.'
        else:
            *pl 'Аманда прогнулась над ящиками, задрав подол до поясницы. Легаре сжимает и разводит в стороны её круглые ягодицы, смотря на розовую открытую дырочку в попе.'
            *pl ' '
            *pl '— Ну чего замер, Альбер? — с смешком оглядывается твоя сестра через плечо. — нравится вид моей дырочки, заткни ее как затыкаешь дырки в своих бочках, я ведь знаю, как тебе нравится!'
            *pl ' '
            *pl '— Ни капли стыда, бесстыдница, — с упоением усмехается купец, резко всаживая, член в попу. — За это ты мне и по душе. - тут же набрав высокий темп, говорит Легаре'
            *pl ' '
            *pl '— Даааа, не  только тебе! — Аманда с наслаждением прогибает спину, громко постанывая и сжимая анусом член купца.'
        end

    elseif $EscapeSceneType = 'neighbor_early':
        if FamilyCorruptionStage <= 1:
            *pl 'За старым сараем Аманда стоит, прижавшись спиной к поленнице. ' + $AmandaEscapePartnerName + ' держит её за руку и несмело тянется поцеловать в щёку. Сестра звонко хихикает и отворачивает лицо.'
            *pl ' '
            *pl '— Куда губы тянешь! — не даётся Аманда, отстраняясь. — Ты меня просто поговорить позвал, а сам сразу слюни распустил!'
            *pl ' '
            *pl '— Ну Амандочка, мы же одни тут... — умоляет ' + $AmandaEscapePartnerName + ', пытаясь приобнять её за талию.'
            *pl ' '
            *pl '— Дурак, я же тебе говорила: я ещё девушка и берегу себя! — строго отбривает парня сестра, шлёпая его по ладоням. — Иди поищи кого поподатливей!'
        elseif FamilyCorruptionStage <= 3:
            *pl $AmandaEscapePartnerName + ' прижал Аманду к стене сарая, жадно целуя её в губы. Его ладонь уверенно сжимает попку Аманды. Сестра горячо отвечает на поцелуй, обвив его шею руками.'
            *pl ' '
            *pl '— Ах, как увидела тебя — сразу выбежала, нравишься ты мне! — сквозь поцелуи говорит Аманда.'
            *pl ' '
            *pl '— Только я или все парни, которые к тебе ходят? — немного ревниво говорит ' + $AmandaEscapePartnerName + '.'
            *pl ' '
            *pl '— Ой всё, Фридрих... — почувствовав, как парень вздрогнул. — То есть ' + $AmandaEscapePartnerName + ', — поправилась твоя сестра. — Чё ты начинаешь? Это ты ко мне пришёл в надежде на ласку, а теперь ещё и допрос устраиваешь!'
        else:
            *pl 'Аманда сидит на краю телеги, задрав платье выше колен. ' + $AmandaEscapePartnerName + ' жадно сжимает её голые бёдра, покрывая поцелуями шею и ключицы. Сестра сама притягивает парня ближе, довольно смеясь.'
            *pl ' '
            *pl '— Смотри не растеряй весь пыл раньше времени, — поддразнивает она кавалера с озорной улыбкой. — А то знаю я вас, хвастунов соседских!'
        end

    elseif $EscapeSceneType = 'neighbor_reject':
        if AmandaEscapeRejectType = 1:
            *pl $AmandaEscapePartnerName + ' прижал Аманду к стене сарая, жадно целуя её в губы. Его ладонь уверенно сжимает попку Аманды. Сестра горячо отвечает на поцелуй, обвив его шею руками.'
            *pl ' '
            *pl '— Ах, как увидела тебя — сразу выбежала, нравишься ты мне! — сквозь поцелуи говорит Аманда.'
            *pl ' '
            *pl '— Только я или все парни, которые к тебе ходят? — немного ревниво говорит ' + $AmandaEscapePartnerName + '.'
            *pl ' '
            *pl '— Ой всё, Фридрих... — почувствовав, как парень вздрогнул. — То есть ' + $AmandaEscapePartnerName + ', — поправилась твоя сестра. — Чё ты начинаешь? Это ты ко мне пришёл в надежде на ласку, а теперь ещё и допрос устраиваешь?!'
            *pl ' '
            *pl 'Аманда обиженно отталкивает парня в грудь и скрещивает руки на груди, сердито надув губки.'

        elseif AmandaEscapeRejectType = 2:
            *pl $AmandaEscapePartnerName + ' прижал сестру к бочке за сараем, страстно осыпая её шею поцелуями. Аманда томно прикрывает глаза, обнимая его за плечи:'
            *pl ' '
            *pl '— Ах, Хансик... ты принёс тех тёплых булочек с корицей, как обещал?..'
            *pl ' '
            *pl 'Парень отшатывается с вытаращенными глазами:'
            *pl '— Какой ещё Хансик?! Я ' + $AmandaEscapePartnerName + '! Ханс — пекарь, а я ' + $AmandaEscapePartnerDesc + '! Ты что, с пекарем крутишь?!'
            *pl ' '
            *pl 'Аманда смущённо моргает, но тут же вспыхивает от досады:'
            *pl '— Ой... Ну перепутала спросонья, чё орать-то сразу?! Вы тут все на одно лицо! Мог бы ради приличия и сам угощение раздобыть, кавалер тоже мне! С пустыми руками припёрся, ещё и права качает!'

        elseif AmandaEscapeRejectType = 3:
            *pl $AmandaEscapePartnerName + ' жадно обнимает Аманду за талию, прижимая к поленнице. Сестра проводит пальчиками по его плечам, доверчиво прижимаясь щекой к груди:'
            *pl ' '
            *pl '— Ох, Петер, какие у тебя сильные плечи стали... соскучилась я...'
            *pl ' '
            *pl 'Парень замирает, как громом поражённый, и ошарашенно отстраняется:'
            *pl '— Петер?! Тот здоровенный кузнец?! Ты что, с этой горой мышц путаешься?!'
            *pl ' '
            *pl 'Аманда вздрагивает, быстро одёргивая руки, но мгновенно идёт в контратаку:'
            *pl '— С каким ещё кузнецом, с дуба рухнул?! В сумерках показалось! А ты сразу сопли распустил да вопить на весь огород вздумал?! Всё, обломись, кавалер, иди к кузнецу сам, раз он тебе так интересен!'

