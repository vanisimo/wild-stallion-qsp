    ! ----------------------------------------------------
    ! 4. INTERRUPT — СТЕФАН ВМЕШАЛСЯ И ПРЕРВАЛ СЦЕНУ
    ! Вызывается из: #AmandaEscapeWorkInterrupt
    ! Смысл: Игрок нажал "Вмешаться немедленно". Стефан выскакивает
    ! из укрытия и спугивает партнёров ДО финала.
    ! ----------------------------------------------------
elseif $EscapeTextId = 'interrupt':
    if $EscapeSceneType = 'legare_early' or $EscapeSceneType = 'legare_blowjob' or $EscapeSceneType = 'legare_sex' or $EscapeSceneType = 'legare_corrupt':
        *pl 'Ты решительно выходишь из тени переулка:'
        *pl '— Легаре! Ты берега не попутал — среди бела дня мою сестру по углам тискать?'
        *pl ' '
        *pl 'Легаре не спеша отстраняется, невозмутимо поправляет шёлковый камзол и бросает на тебя снисходительный взгляд:'
        *pl '— Стефан... К чему этот шум? Мы лишь приятно беседовали. Твоей сестре нравится галантное внимание. Не горячись, мальчик. Твоему трактиру ещё пригодятся мои поствки.'
        *pl ' '
        *pl 'С лёгкой ухмылкой купец разворачивается и неспешным шагом скрывается за углом.'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl 'Аманда стоит бледная, торопливо одёргивая подол платья. Она отпустила голову вниз, не смея поднять на тебя глаза.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Аманда сердито надувает губы и топает ногой:'
            *pl '— Стефан! Вечно ты лезешь со своими нравоучениями! Он мне подарок принёс и ленты обещал, а ты всё испортил!'
        else:
            *pl 'Аманда лениво поправляет шнуровку корсажа и усмехается тебе прямо в лицо:'
            *pl '— Ну вот, всю забаву разогнал. Такой кавалер обходительный был, а ты примчался как цепной пёс.'
        end

    elseif $EscapeSceneType = 'neighbor_pair':
        *pl 'Ты с яростным криком выскакиваешь из-за угла сарая:'
        *pl '— А ну пошли вон отсюда, оба! Сейчас оглоблю возьму — хребты переломаю!'
        *pl ' '
        *pl $AmandaEscapePartnerName + ' и ' + $AmandaEscapePartnerName2 + ' в дикой панике подхватывают штаны и, сшибая коленями забор, кубарем переваливаются в соседний огород.'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl 'Аманда вжимается спиной в борт телеги, закрывая пылающее лицо руками.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Аманда скрещивает руки на груди и сердито хмурится:'
            *pl '— Чего ты на парней кидаешься?! Мы просто стояли и смеялись!'
        else:
            *pl 'Аманда звонко цокает языком и отряхивает юбку от соломы:'
            *pl '— Разогнал кавалеров, грозный такой... Кто теперь мне писю почешит изнутри?'
        end

    else:
        *pl 'Ты выступаешь вперёд, грозно повышая голос:'
        *pl '— А ну брысь отсюда, лоботрясы блудливые! Ноги повыдёргиваю!'
        *pl ' '
        *pl 'Парни в ужасе врассыпную кидаются к забору, на ходу подтягивая штаны, и мгновенно растворяются в кустах.'
        *pl ' '
        if $EscapeSceneType = 'neighbor_reject':
            *pl 'Аманда облегчённо выдыхает и даже одобрительно кивает тебе:'
            *pl '— И правильно, Стефан! Прогони его! Привязался тут, глупости всякие городит... Пойдём лучше в зал, я за стойку встану.'
        elseif FamilyCorruptionStage <= 1:
            *pl 'Аманда вздрагивает, прижимает ладони к груди и испуганно опускает голову.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Аманда раздражённо вскидывает подбородок:'
            *pl '— Опять пришёл копытами стучишь, рогами мотаешь! Чисто бык, разяренный!'
        else:
            *pl 'Аманда отряхивает подол с ленивой усмешкой:'
            *pl '— Горло только зря дерёшь. Парней перепугал, а мне кто теперь поможет? У меня между прочми все промокло.'
        end
    end

    ! ----------------------------------------------------
    ! 5. WATCH_SCENE — РЕЗУЛЬТАТ НАБЛЮДЕНИЯ (РАЗВЯЗКА И ФИНАЛ)
    ! Вызывается из: #AmandaEscapeWorkWatch
    ! Смысл: Игрок выбрал "Не вмешиваться (наблюдать из укрытия)".
    ! Стефан остаётся в тени до самого конца свидания.
    ! Здесь описывается кульминация, завершение близости и уход партнёра(ов).
    ! ----------------------------------------------------
elseif $EscapeTextId = 'watch_scene':
    if $EscapeSceneType = 'legare_early':
        *pl 'Ты остаёшься в тени за штабелем досок, наблюдая за ними.'
        *pl ' '
        *pl 'Легаре притягивает Аманду к себе и долго целует её в губы, пока его пальцы сжимают ее попку. Затем он шепчет ей обещание скорой встречи, дарит обещанную ленту и не спеша уходит. Сестра остаётся стоять у кирпичей, тяжело дыша и прижимая ладонь к горящим губам.'

    elseif $EscapeSceneType = 'legare_blowjob':
        *pl 'Аманда на коленях доводит начатое дело до конца. Легаре с глухим стоном сотрясается, запуская пальцы ей в волосы.'
        *pl ' '
        *pl 'Сестра послушно сглатывает семя. Купец довольно оглаживает её по подбородку, обещает привезти сладких гостинцев и приводит одежду в порядок. Когда он скрывается за углом, Аманда медленно поднимается с колен, вытирая губы.'

    elseif $EscapeSceneType = 'legare_sex':
        *pl 'Мерный стук тел о ящики разносится по переулку. Легаре мощно вбивается в Аманду, пока та судорожно сжимает край досок, заглушая собственные стоны.'
        *pl ' '
        *pl 'После финального толчка купец шумно выдыхает ей в затылок, медленно выходит и заботливо опускает её подол. Поцеловав девушку в висок, он удаляется. Аманда бессильно прислоняется к стене, переводя дух.'

    elseif $EscapeSceneType = 'legare_corrupt':
        *pl 'Легаре безжалостно и сладко терзает Аманду в тугой зад на тюках сукна. Сестра стонет, вжимаясь лицом в шерсть, пока оба не достигают изнурительного пика.'
        *pl ' '
        *pl 'Купец застёгивает пояс, накидывает ей на шею обещанную цепочку и покидает переулок. Аманда медленно сползает на колени, тяжело и прерывисто дыша.'

    elseif $EscapeSceneType = 'neighbor_early':
        if FamilyCorruptionStage <= 1:
            *pl 'Парень ещё пытается неловко поймать её за руку, но Аманда гордо вскидывает подбородок, одёргивает юбку и решительно шагает к чёрному ходу:'
            *pl ' '
            *pl '— Разговор окончен! Нечего было руки распускать!'
            *pl ' '
            *pl 'Обиженный ухажёр в растерянности топчется у сарая, а затем, с досады сплюнув в солому, торопливо перемахивает через забор. Сестра же спокойно возвращается к трактиру.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Парень надулся от обиды, бурча что-то себе под нос про других кавалеров. Аманда упирает руки в бока и сердито фыркает:'
            *pl ' '
            *pl '— Ну и сиди тут со своими обидками! Бывай!'
            *pl ' '
            *pl 'Резко развернувшись на каблуках, сестра с гордым видом удаляется к кухне. ' + $AmandaEscapePartnerName + ' стоит один как в воду опущенный, не зная, куда девать руки, после чего крадучись убирается восвояси.'
        else:
            *pl 'Парень долго и жадно целует Аманду за поленницей, пока оба не переводят дух. Наконец, боязливо оглянувшись на окна трактира, кавалер перемахивает через плетень. Сестра остаётся одна, с шальной улыбкой оправляя юбку.'
        end

    elseif $EscapeSceneType = 'neighbor_reject':
        if AmandaEscapeRejectType = 1:
            *pl 'Парень пытается что-то промямлить про «других дружков», но Аманда непреклонна:'
            *pl ' '
            *pl '— Ну и сиди тут со своими обидками! Бывай!'
            *pl ' '
            *pl 'Резко развернувшись на каблуках, сестра с гордым видом удаляется к кухне трактира. ' + $AmandaEscapePartnerName + ' остаётся один у стены сарая как в воду опущенный. С досады сплюнув в солому, он натягивает штаны и крадучись убирается восвояси.'

        elseif AmandaEscapeRejectType = 2:
            *pl 'Парень багровеет от ревности, пытаясь спорить, но Аманда скрещивает руки на груди:'
            *pl ' '
            *pl '— Раз такой крикливый — сиди тут голодный! Булочки ему подавай, ишь!'
            *pl ' '
            *pl 'Она гордо поворачивается спиной и шагает к трактиру. Парень с досады пинает колесо телеги и уныло плетётся прочь через соседский сад.'

        elseif AmandaEscapeRejectType = 3:
            *pl 'Ухажёр ещё пытается оправдаться, но Аманда резко указывает ему на плетень:'
            *pl ' '
            *pl '— Разговор окончен! Не дорос ещё на меня орать!'
            *pl ' '
            *pl 'Сестра быстрым шагом спешит в зал. ' + $AmandaEscapePartnerName + ' в бессильной ярости сжимает кулаки, оглядывается по сторонам и с позором убирается восвояси.'

        elseif AmandaEscapeRejectType = 4:
            *pl 'Аманда оставляет парня наедине с его чахлым букетиком и разворачивается к трактиру:'
            *pl ' '
            *pl '— Подари своей козе, она оценит!'
            *pl ' '
            *pl 'Гордо задрав носик, сестра возвращается к работе. Незадачливый кавалер со злостью швыряет общипанную ромашку в грязь и, понурив голову, перелезает через забор в соседний огород.'

        else:
            *pl 'Аманда отмахивается от запутавшегося парня, не желая слушать его нелепые оправдания:'
            *pl ' '
            *pl '— Всё, свободен! Иди сказки в другом месте рассказывай!'
            *pl ' '
            *pl 'Она решительно шагает к задней двери трактира, одёргивая юбку. ' + $AmandaEscapePartnerName + ' растерянно чешет в затылке, подтягивает пояс и, ругая себя за длинный язык, спешно ретируется.'
        end

    elseif $EscapeSceneType = 'neighbor_blowjob':
        *pl 'Аманда на коленях возле телеги старательно ублажает дружка. Парень хрипит, зажмурившись, и сотрясается в сладкой судороге.'
        *pl ' '
        *pl 'Сестра сглатывает, вытирает лицо фартуком и торопливо споласкивает рот водой из уличной бочки, довольно посматривая на убегающего парня.'

    elseif $EscapeSceneType = 'neighbor_sex':
        *pl 'Колесо телеги глухо поскрипывает под их напором. Парень шумно и яростно доводит Аманду до дрожи в ногах, пока она судорожно цепляется за спицы.'
        *pl ' '
        *pl 'Закончив дело, парень наскоро поддёргивает штаны и убегает через огороды. Аманда остаётся сидеть на траве, пытаясь унять дрожь в бёдрах.'

    elseif $EscapeSceneType = 'neighbor_pair':
        *pl 'Оба парня по очереди и вместе берут от Аманды всё, что хотели, укрывшись за сараем. Сестра стонет, успевая одарить лаской каждого.'
        *pl ' '
        *pl 'Оставив девушку раскрасневшейся и обессиленной, дружки весело перемигиваются и исчезают за забором. Аманда медленно поднимается, с трудом натягивая чулки.'

    elseif $EscapeSceneType = 'neighbor_group':
        *pl 'Троица на сеновале упивается податливым телом Аманды, сменяя друг друга в сладком безумии. Сестра стонет под их напором, отдаваясь без остатка.'
        *pl ' '
        *pl 'Когда все трое наконец насыщаются и спускаются по приставной лестнице во двор, Аманда ещё долго лежит в измятой соломе, глядя в щели крыши с шальной улыбкой.'
    end

    ! ----------------------------------------------------
    ! 6. POST_WATCH_CONFRONT_INTRO — СТЕФАН ВЫХОДИТ К АМАНДЕ
    ! Вызывается из: #AmandaEscapeWorkPostWatchConfront
    ! Смысл: Стефан выходит к оставшейся в одиночестве Аманде после увиденного.
    ! ----------------------------------------------------
elseif $EscapeTextId = 'post_watch_confront_intro':
    *pl 'Ты неторопливо выходишь из своего укрытия. Аманда вздрагивает, оборачивается на звук шагов — и по её лицу становится ясно: она поняла, что ты видел всё от начала до конца.'
    *pl ' '
    if $AmandaCatchSceneType = 'neighbor_reject':
        *pl '— Стефан?.. — Аманда вздрагивает, но тут же сердито надувает губки. — Ты всё видел? Да этот дурак совсем берега попутал! Пойдём лучше в зал, я за стойку встану.'
    elseif FamilyCorruptionStage <= 1:
        *pl '— Стефан?! — её голос срывается от ужаса. Она судорожно прижимает руки к груди, бледнея на глазах. — Ты... ты всё это время стоял там?! Умоляю, ради Ильматера, не говори маме!'
    elseif FamilyCorruptionStage <= 3:
        *pl '— Стефан?.. — густой румянец заливает её щёки и шею. Она кусает нижнюю губу и виновато отводит взгляд. — Ты подглядывал? Не злись... мы просто немного увлеклись.'
    else:
        *pl '— Ой, Стефан! — она медленно проводит языком по губам, бесстыдно разглядывая тебя с головы до ног. — Давно любуешься? Ну и как тебе представление?'
    end

    ! ----------------------------------------------------
    ! 7. WATCH_QUIET_LEAVE — ТИХОЕ ВОЗВРАЩЕНИЕ В ЗАЛ
    ! Вызывается из: #AmandaEscapeWorkWatchLeave
    ! Смысл: Стефан тихо уходит назад за стойку, не раскрывая слежки.
    ! ----------------------------------------------------
elseif $EscapeTextId = 'watch_quiet_leave':
    *pl 'Ты бесшумно разворачиваешься и уходишь обратно в общий зал трактира.'
    *pl ' '
    *pl 'Примерно через четверть часа в дверях наконец появляется Аманда.'
    *pl ' '
    if $AmandaCatchSceneType = 'neighbor_reject':
        *pl 'Она сердито одёргивает передник, поправляет волосы и решительно принимается за работу, тихо бурча себе под нос что-то нелестное о местных парнях.'
    elseif FamilyCorruptionStage <= 1:
        *pl 'Она бледна, прячет глаза от гостей и молча повязывает передник, тут же хватаясь за гору немытых кружек.'
    elseif FamilyCorruptionStage <= 3:
        *pl 'Её щёки ещё горят румянцем, на губах блуждает робкая улыбка. Она берёт поднос и украдкой бросает в твою сторону настороженные взгляды.'
    else:
        *pl 'Она вплывает в зал неспешной, покачивающейся походкой. Корсаж едва удерживает раскрасневшуюся грудь, а взгляд сестры вызывающе скользит по твоему лицу.'
    end

    ! ----------------------------------------------------
    ! 8. ВАРИАНТЫ РАЗГОВОРА С АМАНДОЙ (CONFRONT CHOICES)
    ! Вызывается из: #AmandaEscapeWorkConfront
    ! ----------------------------------------------------
elseif $EscapeTextId = 'choice_ban_rebel':
    *pl '— Аманда! Я ясно и строго запретил тебе путаться с чужими мужиками по углам! Ты мало того что нарушила слово, так ещё и бросила гостей посреди смены!'
    *pl ' '
    if FamilyCorruptionStage <= 2:
        *pl '— Ты мне не хозяин и не господин! — вспыхивает Аманда, сжимая кулачки. — Я свободная девушка, а не твоя рабыня! С кем хочу стоять — с тем и буду!'
    else:
        *pl '— Хватит строить из себя святого праведника! — дерзко усмехается сестра. — Я молодая, мне мужской ласки хочется, а не только тряпкой махать. Твои дурацкие запреты мне смешны!'
    end

elseif $EscapeTextId = 'choice_ban_guilt':
    *pl '— Аманда, мы же семья. Мы договаривались помогать друг другу и держать марку нашего дома. Зачем ты позоришь нас и нарушаешь слово?'
    *pl ' '
    if FamilyCorruptionStage <= 2:
        *pl '— Стефан... прости меня, пожалуйста! — шепчет Аманда, виновато пряча глаза. — Дурная голова совсем закружилась от сладких речей... Клянусь Ильматером, я больше тебя не подведу!'
    else:
        *pl '— Ладно тебе, не читай морали... — неловко передёргивает плечами сестра. — Не хотела я подставлять трактир. Впредь буду осмотрительнее.'
    end

elseif $EscapeTextId = 'choice_shameless':
    *pl '— Совсем стыд потеряла? Прямо под стенами родного трактира, в грязи и соломе, средь бела дня! Увидят горожане — на смех поднимут и нас, и тебя!'
    *pl ' '
    if FamilyCorruptionStage <= 2:
        *pl '— Не кричи так... — Аманда заливается краской до самых корней волос. — Сама не знаю, что на меня нашло. Сейчас пойду к умывальнику, приведу себя в порядок и вернусь за столы.'
    else:
        *pl '— Брось ханжеские проповеди! — отмахивается Аманда с шальной улыбкой. — На фронтире все так живут и радуются. Зато сколько сладости было... тебе ли не знать?'
    end

elseif $EscapeTextId = 'choice_claim':
    *pl 'Ты шагаешь вперёд, властно прижимаешь Аманду спиной к стене и берёшь её за подбородок:'
    *pl '— Раз в твоей крови среди рабочего дня столько жара — я сам найду ему достойное применение.'
    *pl ' '
    *pl 'Ты наклоняешься и накрываешь её губы глубоким, хозяйским поцелуем.'
    *pl ' '
    if FamilyCorruptionStage <= 1:
        *pl 'Аманда испуганно ойкает, упираясь ладошками тебе в грудь, но спустя миг её сопротивление тает, и она робко приоткрывает губы навстречу.'
    elseif FamilyCorruptionStage <= 3:
        *pl 'Она мгновенно обвивает твою шею руками, прижимается всем телом и тихо стонет прямо в поцелуй, забыв обо всём на свете.'
    else:
        *pl 'Она горячо подаётся вперёд бёдрами, притираясь к твоему паху, и хрипло шепчет в губы:'
        *pl '— Вот это по-мужски... Ты стоишь их всех вместе взятых. Не отпускай меня...'
    end

elseif $EscapeTextId = 'choice_strict':
    *pl '— В зале гости стучат кружками, столы жирные, заказы остывают! Живо надень передник и марш к стойке, пока я не снял штраф с твоей доли!'
    *pl ' '
    *pl 'Аманда испуганно подбирает брошенный фартук, торопливо завязывает тесёмки за спиной и спешит в зал, не решаясь спорить с суровым хозяином.'

elseif $EscapeTextId = 'choice_talk':
    *pl 'Ты вздыхаешь, присаживаешься на край телеги и говоришь спокойно, без крика и брани:'
    *pl ' '
    if $AmandaEscapePartner = 'legare':
        *pl '— Аманда, пойми ты наконец: Легаре — богатый столичный купец. Для таких вельмож простые трактирные девушки — лишь мимолётная забава. Он подарит ленту, пообещает златые горы, а потом уедет восвояси, оставив тебя с разбитым сердцем и сплетнями на весь рынок.'
    else:
        if $AmandaCatchSceneType = 'neighbor_group':
            *pl '— Пускать к себе троих парней на сеновале — это уже не шалость. Завтра они растреплют в каждой кузнице и пекарне, и отбоя от наглецов не будет.'
        elseif $AmandaCatchSceneType = 'neighbor_pair':
            *pl '— Крутить сразу с двумя у забора — последнее дело. Парни между собой похвалятся, а грязь прилипнет к твоему имени.'
        else:
            *pl '— Соседские лоботрясы только и ищут, кого бы затискать в темноте, а потом будут горланить по кабакам, перевирая всё в десять раз. Тебе потом перед людьми глаз не поднять будет.'
        end
    end
    *pl ' '
    *pl 'Аманда внимательно слушает тебя, опустив глаза в землю. Видно, как твои слова находят отклик в её душе. Она тихо вздыхает и искренне говорит:'
    *pl '— Ты прав, Стефан... Спасибо, что бережёшь меня от дурной славы. Пойдём, я сейчас же помогу тебе в зале.'
end

killvar '$EscapeTextId'
killvar '$EscapeSceneType'
---