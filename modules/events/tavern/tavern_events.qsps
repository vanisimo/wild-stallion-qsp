! ================================================
! FILE: modules/events/tavern/tavern_events.qsps
! MODULE: events/tavern
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! События рабочего дня таверны
! Срабатывают при завершении дня
! Могут менять прибыль, репутацию и итоговый текст дня
! ================================================

#TavernWorkDayEvent
    tavern_event_profit_bonus = 0
    tavern_event_reputation_bonus = 0
    $LastTavernEventText = ''

    if TavernDayEventActive = 1 and $TavernDayEventId <> '':
        gs 'TavernDayEventApplyWorkDaySummary'
    else

    ! ====================== ЕСЛИ ТАВЕРНА НЕ РАБОТАЛА ======================

    if tavern_can_serve_drinks = 0:
        $LastTavernEventText = 'Таверна почти не работала: без обслуживания в зале гости только топтались у порога и быстро расходились прочь.'
        tavern_event_reputation_bonus = -1
    else

    ! ====================== ВЫБОР СОБЫТИЯ ======================

    TavernEventRoll = RAND(1, 100)

    ! ====================== ДОВОЛЬНЫЕ ГОСТИ ======================

    if TavernEventRoll <= 18:
        if tavern_work_efficiency >= 60:
            $LastTavernEventText = 'Гости разошлись сытыми и довольными: стучали кружками по столам, хвалили выпивку и обещали заглянуть завтра.'
            tavern_event_reputation_bonus = 1
        else:
            $LastTavernEventText = 'Гости в целом остались довольны, хотя девушкам то и дело приходилось извиняться за задержки с заказами.'
        end

    ! ====================== МЕДЛЕННОЕ ОБСЛУЖИВАНИЕ ======================

    elseif TavernEventRoll <= 34:
        if tavern_waitress_power < 35:
            $LastTavernEventText = 'Посетители шумно возмущались медленным обслуживанием: стучали пустыми кружками, а пара завсегдатаев ушла, так и не дождавшись кувшина.'
            tavern_event_profit_bonus = -20
            tavern_event_reputation_bonus = -1
        else:
            $LastTavernEventText = 'В зале стоял несмолкаемый гул, но девушки крутились между столами и справились с наплывом гостей.'
        end

    ! ====================== ССОРА ПОСЕТИТЕЛЕЙ ======================

    elseif TavernEventRoll <= 64:
        $LastTavernEventText = 'Под вечер между двумя захмелевшими гостями вспыхнула перепалка с опрокинутыми стульями. Драчунов удалось быстро растащить, но настроение в зале остыло.'
        tavern_event_profit_bonus = -10

        if tavern_reputation < 35:
            tavern_event_reputation_bonus = -1
        end

    ! ====================== ЩЕДРЫЕ ЧАЕВЫЕ ======================

    elseif TavernEventRoll <= 80:
        if tavern_waitress_power >= 30:
            gs 'PickFamilyWaitressForTips'

            if $FamilyTipsGirl <> '':
                gs 'AwardGirlTipsFromBase', $FamilyTipsGirl, 15 + RAND(5, 15)

                if $RealName[$FamilyTipsGirl] <> '':
                    if $FamilyTipsGirl = 'amanda':
                        if FamilyCorruptionStage >= 3:
                            $LastTavernEventText = 'Щедрые гости отсыпали серебра за расторопность — Аманда с лукавой улыбкой спрятала монеты в вырез лифа на глазах у Стефана.'
                        else:
                            $LastTavernEventText = 'Довольные гости оставили щедрые чаевые — Аманда с сияющей улыбкой ссыпала серебро в свой кошелёк.'
                        end
                    elseif $FamilyTipsGirl = 'melissa':
                        if FamilyCorruptionStage >= 3:
                            $LastTavernEventText = 'Щедрые гости расщедрились на звонкую монету — Мелисса с ироничной усмешкой пересчитала серебро и спрятала в карман передника.'
                        else:
                            $LastTavernEventText = 'Несколько гостей оставили чаевые за расторопность — Мелисса аккуратно убрала монеты в кошель.'
                        end
                    elseif $FamilyTipsGirl = 'sandra':
                        if FamilyCorruptionStage >= 3:
                            $LastTavernEventText = 'Гости не поскупились на похвалу и монеты — Сандра довольно поправила пышную грудь и опустила чаевые за пазуху.'
                        else:
                            $LastTavernEventText = 'Гости расщедрились за сытный стол — Сандра с хозяйским видом убрала серебро в карман передника.'
                        end
                    else:
                        $LastTavernEventText = 'Несколько гостей оставили щедрые чаевые — ' + $RealName[$FamilyTipsGirl] + ' убрала их в свой кошелёк.'
                    end
                else:
                    $LastTavernEventText = 'Несколько гостей оставили щедрые чаевые за расторопное обслуживание — монеты достались работнице, а не трактирной кассе.'
                end
            else:
                $LastTavernEventText = 'Несколько гостей щедро отблагодарили за выпивку и оставили монеты в общей кассе.'
                tavern_event_profit_bonus = 25
            end

            killvar '$FamilyTipsGirl'
        else:
            $LastTavernEventText = 'Кто-то из гостей потянулся за монетой для чаевых, но из-за путаницы с заказами так ничего и не оставил.'
        end

    ! ====================== СПОКОЙНЫЙ ДЕНЬ ======================

    else:
        $LastTavernEventText = 'День прошёл спокойно: кружки наливались вовремя, споры гасли сами собой, а под вечер зал мирно опустел.'
    end

    end
    end

    gs 'TavernDayEventFinalizeRepairAtDayEnd'

    if TavernRepairCarryPending = 1 and $LastTavernEventText = '':
        gs 'TavernDayEventCarryOverEndText'
    end

    ! ====================== ПРИМЕНЕНИЕ К ПРИБЫЛИ ======================

    tavern_expected_profit += tavern_event_profit_bonus

    if tavern_expected_profit < -150:
        tavern_expected_profit = -150
    end

    killvar 'TavernEventRoll'
---
