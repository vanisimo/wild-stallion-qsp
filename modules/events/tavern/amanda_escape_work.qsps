! ================================================
! FILE: modules/events/tavern/amanda_escape_work.qsps
! MODULE: events/tavern
! Побег Аманды со смены в зале (Escape from work)
! С Легаре (только после секса в подворотне) или соседскими парнями
! Одиночный парень (рандом 1 из 7), тройничек (2 рандомных парня), груповушка (Ханс, Курт, Феликс)
! ================================================

#AmandaEscapeWorkCanStart
    AmandaEscapeWorkCanStart = 0

    gs 'IsTavernOpen'
    if TavernOpen = 0:
        exit
    end

    if week = 7:
        exit
    end

    if week = 5 and time = 4:
        exit
    end

    if time < 2 or time > 4:
        exit
    end

    if jobwaitress['amanda'] = 0 and jobwhore['amanda'] = 0:
        exit
    end

    if AmandaEscapeWorkDoneDay = day:
        exit
    end

    if AmandaAtPortShip = 1:
        exit
    end

    ! Побег с Легаре возможен ТОЛЬКО если она с ним встречается И уже был секс в подворотне
    AmandaCanEscapeLegare = 0
    if AmandaLegareInterest >= 1 and (AmandaLegareFirstSexDone = 1 or Fact_AmandaLegareFridayAlley = 1):
        AmandaCanEscapeLegare = 1
    end

    ! Побег с парнями возможен, если нет прямого запрета либо если бунт велик
    AmandaCanEscapeBoys = 0
    if AmandaProhibitGuys = 0 or AmandaRebellion >= 3:
        if AmandaNeighborBoysStage >= 1 or AmandaAlleyMmfDone = 1 or AmandaBoysGroupUnlocked = 1 or FamilyCorruptionStage >= 2:
            AmandaCanEscapeBoys = 1
        elseif AmandaRebellion >= 2 or sluttiness['amanda'] >= 12 or AmandaSecretiveness >= 2 or FamilyCorruptionStage >= 1:
            AmandaCanEscapeBoys = 1
        end
    end

    if AmandaCanEscapeLegare = 0 and AmandaCanEscapeBoys = 0:
        exit
    end

    AmandaEscapeWorkCanStart = 1
---

#AmandaEscapeWorkTryAutoStart
    $AmandaEscapeReturnLoc = $ARGS[0]

    if $AmandaEscapeReturnLoc = '':
        $AmandaEscapeReturnLoc = 'TavernMain'
    end

    if LOC($AmandaEscapeReturnLoc) = 0:
        $AmandaEscapeReturnLoc = 'TavernMain'
    end

    if LOC('AmandaEscapeWorkCanStart') = 1:
        gs 'AmandaEscapeWorkCanStart'

        if AmandaEscapeWorkCanStart = 1:
            if AmandaLegareFirstSexDone = 1 or AmandaNeighborBoysStage >= 2 or AmandaAlleyMmfDone = 1 or FamilyCorruptionStage >= 2:
                AmandaEscapeChance = 45
            else:
                AmandaEscapeChance = 25
            end

            AmandaEscapeRoll = RAND(1, 100)

            if AmandaEscapeRoll <= AmandaEscapeChance or debug = 1:
                killvar 'AmandaEscapeChance'
                killvar 'AmandaEscapeRoll'
                AmandaEscapeWorkDoneDay = day
                AmandaEscapeWorkCount += 1
                gt 'AmandaEscapeWorkStart', $AmandaEscapeReturnLoc
            end

            killvar 'AmandaEscapeChance'
            killvar 'AmandaEscapeRoll'
        end
    end
---

#AmandaEscapeWorkSetBoy
    _boySlot = ARGS[0]
    _boyIdx = ARGS[1]

    if _boyIdx = 1:
        $_tempName = 'Томас'
        $_tempDesc = 'сын мясника'
    elseif _boyIdx = 2:
        $_tempName = 'Ханс'
        $_tempDesc = 'племянник пекаря'
    elseif _boyIdx = 3:
        $_tempName = 'Курт'
        $_tempDesc = 'подмастерье бондаря'
    elseif _boyIdx = 4:
        $_tempName = 'Феликс'
        $_tempDesc = 'помощник сапожника'
    elseif _boyIdx = 5:
        $_tempName = 'Люк'
        $_tempDesc = 'помощник мельника'
    elseif _boyIdx = 6:
        $_tempName = 'Якоб'
        $_tempDesc = 'подручный плотника'
    else:
        $_tempName = 'Финн'
        $_tempDesc = 'конюх с постоялого двора'
    end

    if _boySlot = 1:
        $AmandaEscapePartnerName = $_tempName
        $AmandaEscapePartnerDesc = $_tempDesc
    elseif _boySlot = 2:
        $AmandaEscapePartnerName2 = $_tempName
        $AmandaEscapePartnerDesc2 = $_tempDesc
    elseif _boySlot = 3:
        $AmandaEscapePartnerName3 = $_tempName
        $AmandaEscapePartnerDesc3 = $_tempDesc
    end

    killvar '_boySlot'
    killvar '_boyIdx'
    killvar '$_tempName'
    killvar '$_tempDesc'
---

#AmandaEscapeWorkStart
    *clr
    clr
    cla

    $AmandaEscapeReturnLoc = $ARGS[0]
    if $AmandaEscapeReturnLoc = '':
        $AmandaEscapeReturnLoc = 'TavernMain'
    end

    ! Проверка доступности партнёров:
    AmandaCanEscapeLegare = 0
    if AmandaLegareInterest >= 1 and (AmandaLegareFirstSexDone = 1 or Fact_AmandaLegareFridayAlley = 1):
        AmandaCanEscapeLegare = 1
    end

    AmandaCanEscapeBoys = 0
    if AmandaProhibitGuys = 0 or AmandaRebellion >= 3:
        AmandaCanEscapeBoys = 1
    end

    if AmandaCanEscapeLegare = 1 and AmandaCanEscapeBoys = 1:
        if RAND(1, 2) = 1:
            $AmandaEscapePartner = 'legare'
        else:
            $AmandaEscapePartner = 'neighbor'
        end
    elseif AmandaCanEscapeLegare = 1:
        $AmandaEscapePartner = 'legare'
    else:
        $AmandaEscapePartner = 'neighbor'
    end

    killvar 'AmandaCanEscapeLegare'
    killvar 'AmandaCanEscapeBoys'

    if $AmandaEscapePartner = 'legare':
        $AmandaEscapePartnerName = 'Легаре'
        $AmandaEscapePartnerName2 = ''
        $AmandaEscapePartnerName3 = ''

        ! Определение уровня интимности с Легаре
        if (AmandaLegareAnalDone = 1 or AmandaHomeAnalDone = 1 or analacts['amanda'] > 0 or FamilyCorruptionStage >= 4) and AmandaLegareInterest >= 3 and (sluttiness['amanda'] >= 35 or FamilyCorruptionStage >= 4):
            $AmandaCatchSceneType = 'legare_corrupt'
        elseif AmandaLegareFirstSexDone = 1 or (virginity['amanda'] = 0 and AmandaLegareInterest >= 3) or (sluttiness['amanda'] >= 35 and AmandaLegareInterest >= 2) or FamilyCorruptionStage >= 3:
            $AmandaCatchSceneType = 'legare_sex'
        elseif AmandaLegareInterest >= 2 or oralacts['amanda'] > 0 or sluttiness['amanda'] >= 20 or FamilyCorruptionStage >= 2:
            $AmandaCatchSceneType = 'legare_blowjob'
        else:
            $AmandaCatchSceneType = 'legare_early'
        end

    else:
        ! Встречи с соседскими парнями:
        ! 1. Груповушка (сеновал): фиксированная тройка Ханс, Курт и Феликс
        if (AmandaNeighborBoysStage >= 4 or AmandaAlleyMmfDone = 1 or AmandaBoyBrothersStage >= 8 or AmandaBrothersTrained = 1 or AmandaBoysGroupUnlocked = 1 or FamilyCorruptionStage >= 4) and (sluttiness['amanda'] >= 45 or FamilyCorruptionStage >= 4) and RAND(1, 100) <= 30:
            $AmandaCatchSceneType = 'neighbor_group'
            $AmandaEscapePartnerName = 'Ханс'
            $AmandaEscapePartnerDesc = 'племянник пекаря'
            $AmandaEscapePartnerName2 = 'Курт'
            $AmandaEscapePartnerDesc2 = 'подмастерье бондаря'
            $AmandaEscapePartnerName3 = 'Феликс'
            $AmandaEscapePartnerDesc3 = 'помощник сапожника'

        ! 2. Тройничек: двое случайных разных парней из пула 7
        elseif (AmandaBoysGroupUnlocked = 1 or AmandaBoyBrothersStage >= 5 or AmandaBoysPairStage > 0 or AmandaNeighborBoysStage >= 2 or FamilyCorruptionStage >= 2 or (sluttiness['amanda'] >= 28 and AmandaNeighborBoysStage >= 1)) and RAND(1, 100) <= 45:
            $AmandaCatchSceneType = 'neighbor_pair'
            _b1 = RAND(1, 7)
            _b2 = RAND(1, 6)
            if _b2 >= _b1: _b2 += 1
            gs 'AmandaEscapeWorkSetBoy', 1, _b1
            gs 'AmandaEscapeWorkSetBoy', 2, _b2
            $AmandaEscapePartnerName3 = ''
            $AmandaEscapePartnerDesc3 = ''
            killvar '_b1'
            killvar '_b2'

        ! 3. Одиночный парень: один случайный парень из пула 7
        else:
            $AmandaEscapePartnerName2 = ''
            $AmandaEscapePartnerDesc2 = ''
            $AmandaEscapePartnerName3 = ''
            $AmandaEscapePartnerDesc3 = ''
            _b1 = RAND(1, 7)
            gs 'AmandaEscapeWorkSetBoy', 1, _b1
            killvar '_b1'

            ! Проверка на отказ/облом ухажёра:
            _rejectChance = 25
            if FamilyCorruptionStage <= 1:
                _rejectChance = 45
            elseif FamilyCorruptionStage <= 2:
                _rejectChance = 35
            end

            if RAND(1, 100) <= _rejectChance:
                $AmandaCatchSceneType = 'neighbor_reject'
                AmandaEscapeRejectType = RAND(1, 5)
            elseif AmandaNeighborBoysStage >= 3 or (sluttiness['amanda'] >= 35 and AmandaNeighborBoysStage >= 2) or FamilyCorruptionStage >= 3:
                $AmandaCatchSceneType = 'neighbor_sex'
            elseif AmandaNeighborBoysStage >= 2 or sluttiness['amanda'] >= 22 or FamilyCorruptionStage >= 2:
                $AmandaCatchSceneType = 'neighbor_blowjob'
            else:
                $AmandaCatchSceneType = 'neighbor_early'
            end
            killvar '_rejectChance'
        end
    end

    gs 'ShowLocationScreenTitle', 'АМАНДА ИСЧЕЗЛА СО СМЕНЫ'
    gs 'SceneShowVisual', 'images/events/tavern/amanda_escape_work/amanda_escape_work_start', 'АМАНДА УШЛА СО СМЕНЫ', 'large', 'webp'
    gs 'EnsureGirlData', 'amanda'

    gs 'AmandaEscapeWorkText', 'intro'

    *pl ' '

    gs 'ActUiPrepare', 'Проверить задний двор', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaEscapeWorkSearch', 'yard', $AmandaEscapeReturnLoc
    end

    gs 'ActUiPrepare', 'Проверить переулок за трактиром', 'road'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaEscapeWorkSearch', 'alley', $AmandaEscapeReturnLoc
    end

    gs 'ActUiPrepare', 'Спросить Сандру на кухне', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaEscapeWorkSearch', 'sandra', $AmandaEscapeReturnLoc
    end
---

#AmandaEscapeWorkSearch
    *clr
    clr
    cla

    $EscapeSearchPlace = LCASE($ARGS[0])
    $AmandaEscapeReturnLoc = $ARGS[1]

    if $AmandaEscapeReturnLoc = '':
        $AmandaEscapeReturnLoc = 'TavernMain'
    end

    if $EscapeSearchPlace = 'sandra':
        gs 'ShowLocationScreenTitle', 'КУХНЯ ТРАКТИРА'
        gs 'SceneShowVisual', 'images/events/tavern/amanda_escape_work/amanda_escape_work_sandra', 'КУХНЯ ТРАКТИРА', 'large', 'webp'

        gs 'AmandaEscapeWorkText', 'search_sandra'
        *pl ' '

        if $AmandaEscapePartner = 'legare':
            gs 'ActUiPrepare', 'Броситься в переулок за трактиром', 'road'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaEscapeWorkSearch', 'alley', $AmandaEscapeReturnLoc
            end
            gs 'ActUiPrepare', 'Проверить задний двор на всякий случай', 'look'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaEscapeWorkSearch', 'yard', $AmandaEscapeReturnLoc
            end
        else:
            gs 'ActUiPrepare', 'Броситься на задний двор к сараю', 'look'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaEscapeWorkSearch', 'yard', $AmandaEscapeReturnLoc
            end
            gs 'ActUiPrepare', 'Проверить переулок за трактиром', 'road'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaEscapeWorkSearch', 'alley', $AmandaEscapeReturnLoc
            end
        end

        gs 'ActUiPrepare', 'Плюнуть и вернуться в зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $AmandaEscapeReturnLoc
        end

    else:
        gt 'AmandaEscapeWorkCatch', $EscapeSearchPlace, $AmandaEscapeReturnLoc
    end

    killvar '$EscapeSearchPlace'
---

#AmandaEscapeWorkCatch
    *clr
    clr
    cla

    $EscapeCatchPlace = LCASE($ARGS[0])
    $AmandaEscapeReturnLoc = $ARGS[1]

    if $AmandaEscapeReturnLoc = '':
        $AmandaEscapeReturnLoc = 'TavernMain'
    end

    if $EscapeCatchPlace = 'yard':
        gs 'SceneShowVisual', 'images/events/tavern/amanda_escape_work/amanda_escape_work_yard', 'ЗАДНИЙ ДВОР — ПОБЕГ', 'large', 'webp'
    else:
        gs 'SceneShowVisual', 'images/events/tavern/amanda_escape_work/amanda_escape_work_alley', 'ПЕРЕУЛОК — ПОБЕГ', 'large', 'webp'
    end

    gs 'ShowLocationScreenTitle', 'ПОБЕГ СО СМЕНЫ: ИЗ УЗКОГО УКРЫТИЯ'

    ! Описание увиденного ДО вмешательства (НАЧАЛЬНЫЙ СТОП-КАДР: ласки в процессе, без финала!)
    gs 'AmandaEscapeWorkText', 'catch_spot', $AmandaCatchSceneType

    *pl ' '

    ! Ключевая развилка:
    ! 1) Прервать до начала -> Стефан выскакивает и прогоняет партнёров (#AmandaEscapeWorkInterrupt)
    ! 2) Наблюдать дальше -> Стефан остаётся в тени до финала сцены (#AmandaEscapeWorkWatch)
    gs 'ActUiPrepare', 'Вмешаться немедленно (прервать до начала!)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaEscapeWorkInterrupt', $EscapeCatchPlace, $AmandaEscapeReturnLoc
    end

    gs 'ActUiPrepare', 'Не вмешиваться (наблюдать из укрытия)', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaEscapeWorkWatch', $EscapeCatchPlace, $AmandaEscapeReturnLoc
    end
---

#AmandaEscapeWorkInterrupt
    *clr
    clr
    cla

    $EscapeCatchPlace = LCASE($ARGS[0])
    $AmandaEscapeReturnLoc = $ARGS[1]

    if $AmandaEscapeReturnLoc = '':
        $AmandaEscapeReturnLoc = 'TavernMain'
    end

    gs 'ShowLocationScreenTitle', 'СТЕФАН ВМЕШАЛСЯ'
    if $EscapeCatchPlace = 'yard':
        gs 'SceneShowVisual', 'images/events/tavern/amanda_escape_work/amanda_escape_work_yard', 'ПРЕРВАТЬ ПОБЕГ', 'large', 'webp'
    else:
        gs 'SceneShowVisual', 'images/events/tavern/amanda_escape_work/amanda_escape_work_alley', 'ПРЕРВАТЬ ПОБЕГ', 'large', 'webp'
    end

    gs 'AmandaEscapeWorkText', 'interrupt', $AmandaCatchSceneType

    *pl ' '

    ! Варианты разговора при прерывании
    if AmandaProhibitGuys = 1:
        gs 'ActUiPrepare', 'Напомнить о строгом запрете на парней', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AmandaEscapeWorkConfront', 'ban', $AmandaEscapeReturnLoc
        end
    end

    gs 'ActUiPrepare', 'Строго потребовать немедленно вернуться к работе', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaEscapeWorkConfront', 'strict', $AmandaEscapeReturnLoc
    end

    gs 'ActUiPrepare', 'Прижать к стене и по-хозяйски наказать поцелуем', 'flirt'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaEscapeWorkConfront', 'claim', $AmandaEscapeReturnLoc
    end

    gs 'ActUiPrepare', 'Спокойно поговорить и предостеречь от глупостей', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaEscapeWorkConfront', 'talk', $AmandaEscapeReturnLoc
    end
---

#AmandaEscapeWorkWatch
