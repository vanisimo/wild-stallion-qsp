    else:
        gs 'SceneShowVisual', 'images/events/tavern/amanda_escape_work/amanda_escape_work_alley', 'НАБЛЮДЕНИЕ ИЗ ТЕНИ', 'large', 'webp'
    end

    ! Регистрация последствий наблюдения
    if $AmandaCatchSceneType = 'neighbor_reject':
        arousal += 5
    else:
        sluttiness['amanda'] += 2
        AmandaNpcPath += 1
        AmandaScandalLevel += 1
        arousal += 25
    end

    if $AmandaCatchSceneType = 'neighbor_blowjob':
        oralacts['amanda'] += 1
        sexacts['amanda'] += 1
        if AmandaNeighborBoysStage < 2:
            AmandaNeighborBoysStage = 2
        end
    elseif $AmandaCatchSceneType = 'neighbor_sex':
        vaginalacts['amanda'] += 1
        sexacts['amanda'] += 1
        if AmandaNeighborBoysStage < 3:
            AmandaNeighborBoysStage = 3
        end
        if virginity['amanda'] = 1:
            virginity['amanda'] = 0
            AmandaDeflowerDone = 1
        end
    elseif $AmandaCatchSceneType = 'neighbor_pair':
        oralacts['amanda'] += 1
        vaginalacts['amanda'] += 1
        sexacts['amanda'] += 2
        AmandaBoysPairStage += 1
        sluttiness['amanda'] += 2
        if virginity['amanda'] = 1:
            virginity['amanda'] = 0
            AmandaDeflowerDone = 1
        end
    elseif $AmandaCatchSceneType = 'neighbor_group':
        oralacts['amanda'] += 1
        vaginalacts['amanda'] += 1
        sexacts['amanda'] += 2
        AmandaAlleyMmfDone = 1
        if AmandaNeighborBoysStage < 4:
            AmandaNeighborBoysStage = 4
        end
        if virginity['amanda'] = 1:
            virginity['amanda'] = 0
            AmandaDeflowerDone = 1
        end
    elseif $AmandaCatchSceneType = 'neighbor_early':
        if AmandaNeighborBoysStage < 1:
            AmandaNeighborBoysStage = 1
        end
    elseif $AmandaCatchSceneType = 'legare_blowjob':
        oralacts['amanda'] += 1
        sexacts['amanda'] += 1
        AmandaLegareInterest += 1
        sluttiness['amanda'] += 1
    elseif $AmandaCatchSceneType = 'legare_sex':
        vaginalacts['amanda'] += 1
        sexacts['amanda'] += 1
        AmandaLegareFirstSexDone = 1
        AmandaLegareInterest += 1
        sluttiness['amanda'] += 2
        if virginity['amanda'] = 1:
            virginity['amanda'] = 0
            AmandaLegareDeflowerDone = 1
        end
    elseif $AmandaCatchSceneType = 'legare_corrupt':
        analacts['amanda'] += 1
        sexacts['amanda'] += 1
        AmandaLegareAnalDone = 1
        AmandaLegareInterest += 1
        sluttiness['amanda'] += 3
        FamilyTension += 1
        gs 'RegisterSex', 'amanda', 'anal', 0, 0
    elseif $AmandaCatchSceneType = 'legare_early' or $AmandaCatchSceneType = 'legare':
        AmandaLegareInterest += 1
    end

    PlayerKnows_AmandaEscapeEscapade = 1

    ! Полное описание развязки/финала при наблюдении (кульминация, оргазмы, завершение ласк и уход)
    gs 'AmandaEscapeWorkText', 'watch_scene', $AmandaCatchSceneType

    *pl ' '

    gs 'ActUiPrepare', 'Выйти из укрытия к Аманде', 'generic'
