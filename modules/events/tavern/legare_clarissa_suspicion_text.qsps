! ================================================
! FILE: modules/events/tavern/legare_clarissa_suspicion_text.qsps
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты события "Легаре подозревает Клариссу"
! Используется кодом:
! modules/events/tavern/legare_clarissa_suspicion.qsps
! ================================================

#LegareClarissaSuspicionIntroText
    *pl 'В этот раз Легаре приходит без подвод, без приказчиков и без торговых накладных.'
    *pl 'Он не спеша садится за угловой стол в полутени, кладёт на дубовую доску тяжёлые кулаки и молча буравит вас немигающим взглядом, пока вы не подходите сами.'
    *pl '— Любопытные вещи творятся в нашем городке, Стефан, — произносит он негромко, но в его голосе звенит натянутая, опасная струна. — Я прижал поставки, гильдейские склады для тебя закрыты наглухо... а из твоего подвала всё так же пахнет добрым выдержанным рислингом.'
    *pl 'Он делает паузу, медленно постукивая перстнем:'
    *pl '— Кто-то очень ловко знает расписание моих повозок, тайные ключи от южных амбаров и имена возчиков, которым я задолжал. Очень ловко.'
    *pl 'Имя своей жены он вслух не называет, но тень Клариссы уже незримо стоит между вами у стойки.'
---

#LegareClarissaSuspicionActionText
    $ClarissaSuspicionTextChoice = LCASE($ARGS[0])

    if $ClarissaSuspicionTextChoice = 'pretend':
        *pl 'Вы с невозмутимым видом пожимаете плечами и протираете стойку полотенцем:'
        *pl '— Земля слухами полнится, Легаре. Город не заканчивается твоей лавкой, а у бродячих торговцев всегда найдётся пара лишних бочек для сметливого хозяина.'
        *pl 'Легаре медленно кривит губы в ядовитой усмешке, в которой нет ни капли веры:'
        *pl '— Конечно. Простая трактирная удача... Что ж, Стефан. Смотри, как бы эта удача не сломала тебе хребет. В нашем городе случайности долго не живут.'

    elseif $ClarissaSuspicionTextChoice = 'protect_clarissa':
        *pl 'Вы твёрдо встречаете его взгляд и обрубаете намёки:'
        *pl '— Оставь свои домашние подозрения при себе, купец. Кларисса честно ведёт городские книги в ратуше, а в трактирные дела не лезет. Не смей вымещать свою злость на женщине.'
        *pl 'В глазах Легаре вспыхивает неистовая ярость, пальцы сжимаются до побелевших костяшек:'
        *pl '— Осторожнее, щенок! Ты слишком быстро и рьяно взялся защищать чужую жену! Не забывай, с кем говоришь, и не лезь в чужую постель, если дорога своя шкура!'

    elseif $ClarissaSuspicionTextChoice = 'blame_temporary':
        if LegareClarissaSuspicionResult = 0:
            *pl 'Вы холодно перечисляете имена мелких слободских винокуров и старых возчиков с южного тракта, намекая на их старые обиды на гильдию.'
            *pl 'Легаре мрачнеет. Он знает, что среди пригородных торговцев хватает тех, кто точит на него зуб за пошлины.'
            *pl '— Слободские, значит... — цедит он, раздумывая. — Что ж, я проверю этих оборванцев. Но если узнаю, что ты мне солгал...'
        else:
            *pl 'Вы пытаетесь свалить всё на случайных временных поставщиков, но Легаре резко бьёт ладонью по столу:'
            *pl '— Не держи меня за круглого дурака! Временный бродяга не достанет монастырский рислинг из южного амбара! Этот след ведёт прямиком из моего дома, и ты прекрасно это знаешь!'
        end

    elseif $ClarissaSuspicionTextChoice = 'drop_route':
        *pl 'Вы понимаете, что над головой Клариссы нависла смертельная угроза, и решаете отступить.'
        *pl '— Если тебя так тревожат эти бочки — считай, что это была разовая сделка. Больше этого вина здесь не увидят.'
        *pl 'Легаре довольно щурится, уверенный, что снова прижал вас к стенке:'
        *pl '— Вот и славно. Помни своё место, трактирщик.'
        *pl 'Для Клариссы опасность временно отступила, но трактир снова остаётся с пустыми кранами один на один с монополистом.'

    elseif $ClarissaSuspicionTextChoice = 'alliance_warning':
        *pl 'Вы наклоняетесь к нему через стол и негромко, с ледяной уверенностью говорите:'
        *pl '— Послушай меня внимательно, Легаре. В этом городе многие устали от твоей ненасытности — и в ратуше, и на площади. Кларисса не одна, и если ты посмеешь сотворить с ней недоброе — отвечать придётся не перед трактирщиком, а перед магистратом.'
        *pl 'Лицо купца вытягивается от бешенства, он тяжело дышит:'
        *pl '— Вот, значит, как... Вы спелись за моей спиной? Что ж, война так война, Стефан. Пощады не жди.'

    elseif $ClarissaSuspicionTextChoice = 'kick_out':
        *pl 'Вы молча хватаете купца за ворот суконного плаща и рывком поднимаете со скамьи:'
        *pl '— Разговор окончен, Легаре. Вон из моего заведения. И чтобы я больше не видел твоей рожи ни у стойки, ни у винных погребов!'
        *pl 'Легаре стряхивает ваши руки, поправляет воротник и с ледяным спокойствием бросает перед дверью:'
        *pl '— Отныне ни одна капля доброго вина не попадет в этот хлев. Ты сам подписал себе разорение.'
        *pl 'Тяжёлая дубовая дверь захлопывается. Поставки гильдии закрыты окончательно.'

    else:
        *pl 'Разговор обрывается в тягучем, гнетущем молчании, но подозрения купца теперь горят ярким пламенем.'
    end

    killvar '$ClarissaSuspicionTextChoice'
---

#ClarissaTalkAboutLegareSuspicionText
    *pl 'Кларисса нервно перебирает пергаменты на конторке, её пальцы мелко дрожат.'
    *pl '— Я знала, что этот день настанет, Стефан... Просто Ильматер свидетель, я надеялась, что мы успеем подготовиться лучше.'
    *pl 'Она поднимает на вас полные страха и решимости глаза:'
    *pl '— Легаре не прощает обмана. Если он окончательно уверует, что я отдала его вино тебе за спиной... он не станет судиться. Он запрет меня на ключ и превратит жизнь в сущий ад. Нам нужно держаться вместе.'
---

#MelissaTalkAboutLegareSuspicionText
    *pl 'Мелисса слушает ваш рассказ, и её лицо становится пугающе сосредоточенным.'
    *pl '— Мы перешли черту, Стефан, — говорит она, складывая руки на груди. — Пока это были споры о ценах на пиво, это была просто торговля. Но теперь на кону дом городского купца и свобода Клариссы.'
    *pl 'Она смотрит на дубовую дверь главного зала:'
    *pl '— Если Легаре пойдёт до конца, он ударит не только по поставкам. Он пойдёт к городскому судье или наймёт портовых головорезов. Нам нужно быть готовыми ко всему.'
---
