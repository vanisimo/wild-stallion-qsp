! ================================================
! FILE: modules/events/melissa/melissa_music_stage_text.qsps
! MODULE: events/melissa
! [AI-WORKED] 20.09.2026
! Тексты работы сцены, выступления менестреля и взаимодействия с публикой
! ================================================

#TavernMusicStageIntroText
    if TavernStageWorking = 1:
        *pl 'В дальнем углу главного зала возвышается ладная деревянная сцена, построенная мастером Драупниром. На помосте, освещённом теплым светом начищенных масляных ламп, царит весёлое оживление.'
        *pl 'Менестрель <<$TavernStagePerformer>> легко перебирает струны лютни, с улыбкой оглядывая переполненный зал. Ближайшие столы плотно сдвинуты — гости сгрудились вокруг помоста, затаив дыхание или громко подпевая знакомым куплетам.'
        *pl 'В воздухе витает густой аромат жареного мяса, свежего хлеба и пряного вина. Официантки едва успевают разносить полные кружки, а посетители охотно тянутся за кошельками, радуясь редкому для придорожного трактира зрелищу.'
    else:
        *pl 'В дальнем углу зала стоит аккуратный деревянный помост, сколоченный из светлых дубовых досок. Сейчас сцена пуста и убрана.'
        *pl 'На полированном дереве стоят два высоких подсвечника с оплывшими свечами, у стены аккуратно сложен суконный занавес, за которым скрывается проход в подсобные помещения.'
        *pl 'Даже без музыки сцена придаёт трактиру солидный и праздничный вид — завсегдатаи с уважением поглядывают на помост, зная, что в дни праздников и ярмарок здесь звучат лучшие песни в округе.'
    end
---

#TavernStageListenBalladText
    TavernStageSongIndex = RAND(1, 4)

    if TavernStageSongIndex = 1:
        *pl '<<$TavernStagePerformer>> делает плавный шаг вперёд, бережно касается колков лютни и берёт чистый, протяжный аккорд. Зал невольно стихает.'
        *pl 'Звучит старинная «Баллада о рыцаре Роланде и деве у горного ручья». Бархатный голос менестреля легко взлетает к тёмным балкам потолка, повествуя о верности клятве, далёких походах и деве, ожидавшей своего суженого семь долгих вёсен.'
        *pl 'Слушатели за столами замирают с кружками в руках. Седоусый ветеран у камина задумчиво оглаживает бороду, молодые подмастерья затаили дыхание, а сидевшие в углу купцы одобрительно кивают в такт строгим, возвышенным строфам.'
        *pl 'Когда финальный аккорд затихает в тишине зала, на мгновение воцаряется благоговейное молчание, а затем зал взрывается дружными рукоплесканиями и одобрительными выкриками:'
        *pl '— Вот это слог! Слава Ильматеру за доброе искусство!'
        *pl 'В открытый футляр у края помоста со звоном падает несколько медных и мелких серебряных монет.'

    elseif TavernStageSongIndex = 2:
        *pl 'Менестрель озорно подмигивает залу, делает шутливый поклон и с ходу ударяет по струнам в быстром, плясовом ритме.'
        *pl 'Под сводами трактира разносится весёлая «Песнь о хмельном послушнике и монастырском погребе». Куплеты о том, как благочестивый брат во имя испытания духа решил лично проверить крепость всех бочек с вином, вызывают бурный восторг публики.'
        *pl 'Зал подхватывает задорный рефрен хором: крепкие ремесленники барабанят тяжелыми кружками по дубовым столешницам, башмаки дружно отбивают такт по половицам, а пена со свеженалитого эля щедро летит на столы.'
        *pl 'Хохот стоит такой, что звенит посуда на полках. Завсегдатаи у стойки наперебой требуют повторить кружки, поднимая тосты за ловкого послушника и доброго хозяина трактира!'

    elseif TavernStageSongIndex = 3:
        *pl '<<$TavernStagePerformer>> садится на высокий табурет у края сцены и мягко ведёт смычком по струнам, извлекая нежную, щемящую мелодию.'
        *pl 'Это лирическая песнь о странствующем рыцаре, который искал по свету прекраснейшую даму, а нашёл своё счастье в тихой долине среди простых холмов. Слова льются сладко и певуче, как майский мёд, заставляя даже самых грубых гуляк притихнуть.'
        *pl 'Слушая эти строки, девицы за столами зарделись и мечтательно потупили взоры. Публика очарована искусством менестреля, и по залу проносится тихий, восхищённый вздох.'
        *pl 'Кто-то из растроганных торговцев бросает на помост полновесную серебряную спинтарию, крича: «Спой ещё, парень! За такую песню и кошелька не жаль!»'

    else:
        *pl 'Менестрель вскидывает руку с пером на шляпе, возвещая начало главной трактирной песни — «Гимна вольного всадника и Дикого Жеребца».'
        *pl 'Энергичный бой струн заставляет кровь бежать быстрее. Песня славит дорогу, вольный ветер, верного коня, горячий очаг и пенящийся хмель, что ждёт каждого усталого путника под крышей этого гостеприимного дома.'
        *pl 'Гости в едином порыве вскакивают со скамей, высоко поднимая кружки с элем и кубки с терпким вином:'
        *pl '— За «Дикого Жеребца»! За Стефана! Долгих лет трактиру!'
        *pl 'Шумное веселье охватывает весь зал от порога до кухни: публика чокается через столы, братается и дружно требует добавить жареных колбасок и ещё вина.'
    end

    ! Реакции девушек, если они в зале
    if $GirlLocation['melissa'] = 'TavernMain':
        *pl ' '
        *pl 'Мелисса стоит у резного столба неподалёку от помоста, прижимая к груди поднос с чистыми стаканами. Её щёки слегка алеют, взгляд прикован к музыканту, а тонкие губы беззвучно шевелятся, повторяя стихотворный размер:'
        *pl '<i>«Рифма на цезуре выдержана безупречно... хотя в третьем катрене аллитерация могла бы быть строже»,</i> — мысленно рассуждает она с видом неприступного книжного критика, но сияющие глаза и сбитое дыхание выдают её искреннее восхищение.'
    end

    if $GirlLocation['amanda'] = 'TavernMain':
        *pl ' '
        *pl 'Аманда весело кружит между столами, покачивая аппетитными бёдрами в такт музыке. Разнося шипящее пиво, она озорно подмигивает менестрелю, звонко смеётся в ответ на шутки гостей и ловко уворачивается от чересчур вольных рук захмелевших поклонников, собирая щедрые чаевые.'
    end

    if $GirlLocation['sandra'] = 'TavernMain':
        *pl ' '
        *pl 'Сандра наблюдает за сценой из-за барной стойки. Заметив, как бойко пустеют винные бочонки, она сдержанно улыбается, хотя на чересчур вольных куплетах всё же чинно очерчивает перед собой знак святого Круга Ильматера, следя, чтобы веселье не переходило границ приличия.'
    end

    killvar 'TavernStageSongIndex'
---

#TavernStageOrderSongText
    *pl 'Ты подходишь к самому краю помоста, достаёшь из поясного кошеля пять звонких спинтарий и уверенным жестом кладёшь их на край деки лютни.'
    *pl '— Спой для всего зала, <<$TavernStagePerformer>>! За здоровье добрых горожан и процветание «Дикого Жеребца»!'
    *pl 'Менестрель ловко подхватывает монеты, отвешивает тебе пышный артистический поклон и громко обращается к публике:'
    *pl '— Угощение от щедрого хозяина Стефана! Слушайте же, добрые люди, песнь о трактире, где путник всегда найдёт тепло, хмель и братское плечо!'
    *pl 'Он ударяет по струнам с удвоенным жаром. Зал взрывается громогласным ликованием: посетители с радостными криками салютуют тебе кружками, тостуя за молодого хозяина и славя его гостеприимство.'
    *pl 'Трактир гудит от воодушевления, а репутация заведения среди горожан заметно растёт.'
---

#TavernStageTalkMinstrelText
    *pl 'Менестрель объявляет короткий перерыв, откладывает лютню на войлочную подставку и спускается на одну ступеньку, вытирая лоб шёлковым платком.'
    *pl '— Славный вечер, мастер Стефан! — с улыбкой приветствует он тебя, принимая поданную кружку прохладной воды. — Сцена, признаться, вышла отменная. Дерево сухое, звонкое, звук не вязнет под потолком, а летит прямо в уши гостям. В таком зале петь — чистое удовольствие.'
    *pl '— Публика сегодня щедрая? — усмехаешься ты.'
    *pl '— Народ в городе истосковался по хорошей песне, — кивает он. — На трактах сейчас неспокойно, купцы говорят, что пошлины на южных заставах подняли, так что люди рады забыть о заботах за добрым элем под вашей крышей.'

    if MelissaMinstrelMet = 1 and MelissaProhibitMinstrel = 0:
        *pl 'Он на мгновение задерживает взгляд на фигуре Мелиссы, разносящей напитки в глубине зала, и негромко добавляет:'
        *pl '— И должен сказать... у вас удивительная сестра. Мелисса не просто слушает — она слышит суть поэзии. Её замечания о ритме и старинных балладах стоят разговоров с университетскими мэтрами.'
    elseif MelissaProhibitMinstrel = 1:
        *pl 'Заметив твой пристальный хозяйский взгляд, менестрель сдержанно выпрямляется:'
        *pl '— Не беспокойтесь, сударь Стефан. Я помню наш уговор и ваш порядок в доме. Я здесь только ради музыки и честного заработка.'
    end
---

#TavernStageCollectTipsText
    *pl 'На краю сцены стоит резная деревянная шкатулка, куда благодарные слушатели опускают плату за выступление. В ней поблёскивает изрядная кучка медных и серебряных монет, набросанных воодушевленной публикой.'
    *pl 'По давнему обычаю трактиров, хозяин заведения имеет право взять долю за предоставление помоста и крыши, либо оставить всё музыканту в знак особого покровительства искусствам.'
---

#TavernStageTakeTipsText
    *pl 'Ты подходишь к шкатулке и отсчитываешь законную долю трактира — двадцать полновесных спинтарий.'
    *pl '<<$TavernStagePerformer>> с пониманием и вежливым поклоном принимает оставшуюся часть:'
    *pl '— Справедливая плата за тёплый очаг, отличную сцену и лучший приём в городе, мастер Стефан. Всегда приятно иметь дело с рассудительным хозяином.'
    *pl 'Ты прячешь монеты в кассу заведения. Чистая прибыль от работы сцены приятно греет кошель.'
---

#TavernStageLeaveTipsText
    *pl 'Ты с улыбкой отодвигаешь шкатулку обратно к музыканту:'
    *pl '— Оставь всё себе, <<$TavernStagePerformer>>. Твои песни стоят каждого гроша, что бросили гости. Пусть в «Диком Жеребце» знают, что здесь ценят истинный талант.'
    *pl 'Глаза менестреля вспыхивают искренней признательностью. Он прижимает руку к сердцу и склоняется в глубоком поклоне:'
    *pl '— Поистине щедрый и благородный жест, сударь Стефан! Слава о вашем великодушии и гостеприимстве облетит все трактиры отсюда до самых предгорий!'
    *pl 'Гости, заметившие твой поступок, одобрительно переглядываются, уважая хозяина за широкую душу.'

    if $GirlLocation['melissa'] = 'TavernMain':
        *pl 'Мелисса издали замечает твой жест. На её губах появляется редкая, по-настоящему тёплая улыбка: она явно оценила твоё уважение к музыканту.'
    end
---

#TavernStageBackstageText
    *pl 'Ты отстраняешь плотный суконный занавес и заглядываешь в полумрак закулисья.'
    *pl 'За перегородкой царит тишина, контрастирующая с шумом зала. Здесь стоят деревянные футляры для инструментов, запасные кувшины, мотки верёвок и пара мягких стульев у штабеля ящиков.'
    *pl 'В воздухе пахнет старым деревом, канифолью для струн и воском. Это уютный и укромный уголок, куда почти не проникает посторонний взгляд из общего зала.'

    if MelissaMinstrelAffairStage >= 1:
        *pl 'На одном из бочонков лежит забытый кем-то листок плотной бумаги с аккуратными строчками стихов, исчерканными знакомым мелким почерком Мелиссы.'
    end
---

#TavernStagePrintHallDescription
    TavernStageDescPrinted = 0

    if TavernStageWorking = 0:
        exit
    end

    TavernStageDescPrinted = 1

    if time = 2:
        gs 'PrintMainP', 'К полудню трактир наполняется чистыми звуками лютни. На новой деревянной сцене в углу зала расположился менестрель ' + $TavernStagePerformer + ' — он настраивает лады, легко касается струн и напевает шутливые дорожные куплеты.'
        gs 'PrintMainP', 'Вокруг помоста уже собираются первые любопытные горожане, а у стойки бойко заказывают свежее пиво и горячую похлёбку.'
    elseif time = 3:
        gs 'PrintMainP', 'Днём в главном зале царит звонкий, праздничный гул. На подмостках во весь голос поёт менестрель ' + $TavernStagePerformer + ', выводя задорные баллады о далёких походах и прекрасных девах.'
        gs 'PrintMainP', 'Гости дружно подхватывают припевы, стуча кружками по дубовым столам; в воздухе плывёт аромат жареного мяса и пенного эля, а торговля идёт живее обычного.'
        if $GirlLocation['melissa'] = 'TavernMain':
            gs 'PrintMainP', 'Мелисса разносит кувшины между столами, но её взгляд то и дело возвращается к сцене — щёки сестры порозовели, а губы беззвучно шевелятся в такт песне.'
        end
    elseif time = 4:
        gs 'PrintMainP', 'Вечером трактир преображается в настоящий центр городского веселья. Зал полон гостей: в тёплом свете ламп менестрель ' + $TavernStagePerformer + ' срывает бурные рукоплескания, исполняя лирические романсы и лихие застольные гимны.'
        gs 'PrintMainP', 'Посетители воодушевлённо подпевают хором, звонко чокаются кружками и щедро бросают монеты на край помоста. Атмосфера шумная, хмельная и по-настоящему праздничная.'
        if $GirlLocation['melissa'] = 'TavernMain':
            gs 'PrintMainP', 'Мелисса легко лавирует в толпе с подносом, бросая в сторону подмостков сияющие, взволнованные взгляды — всеобщее внимание к музыканту явно льстит её сердцу.'
        end
    else:
        gs 'PrintMainP', 'В зале звучит негромкая музыка — менестрель ' + $TavernStagePerformer + ' наигрывает на лютне со сцены, развлекая немногочисленных посетителей.'
    end
---

#TavernStagePrintHallNote
    if TavernUpgradeStageDone = 1 and TavernStageWorking = 0 and TavernOpen = 1:
        gs 'PrintMainP', 'В дальнем углу зала привлекает взгляд добротная деревянная сцена, возведённая столяром Драупниром. Сейчас помост пуст и аккуратно прибран, но само его присутствие придаёт залу солидный, благородный вид в ожидании вечерних выступлений.'
    end
---
