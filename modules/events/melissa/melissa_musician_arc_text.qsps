! ================================================
! FILE: modules/events/melissa/melissa_musician_arc_text.qsps
! MODULE: events/family
! [AI-WORKED] 18.09.2026
! Тексты ветки Мелиссы и менестреля
! ================================================

#MelissaMusicStageTalkText
    *pl 'Мелисса сидит за угловым столом, аккуратно закладывая шелковой лентой страницу толстой книги в тиснёном переплёте. От её платья всё ещё слегка пахнет вечерней площадью и дымом праздничных костров.'
    *pl '— Он снова будет в городе в следующую пятницу, — невозмутимо произносит она, не поднимая глаз от текста. — Проезжие музыканты любят наш зал, когда им есть где встать с лютней, а не только толкаться между подвыпившими подмастерьями.'
    *pl '— Если сговориться с Драупниром и сколотить небольшое возвышение в углу, менестрели не займут лучший стол для гостей и не опрокинут кружки. Это практично, Стефан. И доход от вина поднимется минимум на треть — люди слушают баллады и охотнее тянутся за выпивкой.'
    *pl 'Она делает небольшую паузу и чуть приподнимает бровь, заметив твой пристальный взгляд:'
    *pl '— И не смотри на меня так, будто я делаю это ради его стихов. Я забочусь о выручке заведения. Хотя баллада о леди Гвендолин в его исполнении действительно безупречна по ритмике.'
    *pl 'Она говорит сухо и расчетливо, как привыкла днём перед амбарной книгой, но тонкие пальцы нервно гладят тиснёную кожу переплёта, а на скулах проступает предательский румянец. За её напускным деловым расчётом ты отчётливо видишь трещину в броне: от одной мысли об Эльрике у неё замирает дыхание, оживляя ночные книжные грёзы.'
---

#MelissaMinstrelMeetIntroText
    *pl 'Мелисса замерла у края деревянного помоста на площади, скрестив руки на груди. Менестрель <<$MelissaMinstrelName>> заканчивает сложный куплет старинной баллады и, плавно завершив аккорд, отвешивает ей церемонный поклон — глубокий, словно даме из рыцарского романа.'
    *pl 'Она держится прямо и гордо, как венценосная королева, снизошедшая до странствующего поэта. Но её выдают глаза: в них плещется неподдельный девичий восторг, на щеках горит румянец, а под шнуровкой корсажа бешено колотится сердце. В животе сладко порхают бабочки, и от одного звука его бархатного голоса внизу живота разливается запретный, томительный жар.'
---

#MelissaMinstrelMeetActionText
    $MinstrelMeetTextChoice = LCASE($ARGS[0])

    if $MinstrelMeetTextChoice = 'approach':
        *pl 'Ты подходишь к сестре и с усмешкой кладёшь руку ей на плечо, прерывая затянувшуюся паузу.'
        *pl '— Заслушалась стихами, книжница? — бросаешь ты с весёлой хозяйской уверенностью.'
        *pl 'Менестрель вежливо улыбается, кланяется вам обоим и отступает к другим слушателям, но цепкий взгляд его серых глаз задерживается на вас чуть дольше обычного.'
        *pl '— Я всего лишь оценивала размер строфы, Стефан, — сухо, но с заметной запинкой парирует Мелисса, торопливо пряча пылающие щёки. Она отчаянно пытается вернуть себе привычный строгий тон, но пересохшие губы и сбитое дыхание выдают её с головой.'

    elseif $MinstrelMeetTextChoice = 'warn':
        *pl 'Ты встаёшь между ними и недвусмысленно даёшь понять бродячему лютнисту, что старшая из сестёр Лонгкок — не из тех девиц, которым вешают лапшу на уши рифмами.'
        *pl 'Менестрель примирительно поднимает ладони и отшучивается, но Мелисса сердито вспыхивает:'
        *pl '— Стефан, перестань! Ты вечно ведёшь себя как цепной пёс у лавки мясника! — шипит она, сжимая кулачки. Ей до слёз досадно, что ты грубо разрушил прекрасную сказку, в которой она на миг почувствовала себя прекрасной дамой из баллады.'

    elseif $MinstrelMeetTextChoice = 'watch':
        *pl 'Ты остаёшься в тени навеса и наблюдаешь со стороны. Менестрель что-то негромко шепчет, показывая на колки лютни, а Мелисса отвечает — не смущённо, как провинциалка, а пылко споря с ним о текстах песен, изредка счастливо и звонко смеясь.'
        *pl 'Она играет роль мудрой покровительницы, направляющей поэта, но от каждого его взгляда застенчиво опускает ресницы. Такой живой, уязвимой и женственной ты не видел её за всеми её гроссбухами.'

    elseif $MinstrelMeetTextChoice = 'ignore':
        *pl 'Ты решаешь не лезть в чужие разговоры и отвлекаешься на суету вокруг помоста мэра. Когда ты снова оборачиваешься, менестрель уже галантно целует кончики пальцев Мелиссы на прощание.'
        *pl 'Мелисса замирает, словно заколдованная: её губы полуоткрыты, а взгляд затуманен сладкой истомой. От простого прикосновения его губ к коже её колени дрожат, а между бедер становится горячо и влажно.'
    end

    killvar '$MinstrelMeetTextChoice'
---

#MelissaMinstrelKissIntroText
    *pl 'Очередной танец подошёл к концу, музыка на площади затихла. В полумраке под сводчатой аркой у складов <<$MelissaMinstrelName>> что-то негромко декламирует Мелиссе, склоняясь к её лицу неприлично близко для простого музыканта.'
    *pl 'Мелисса прижимает к груди ладони, её щёки горят в сумерках. Вся её броня дала трещину: днём она строгая и неприступная хозяйка, но сейчас, словно героиня запретного романа, она стоит перед ним, затаив дыхание, чувствуя, как от сладкого томления слабеют ноги и намокает ткань исподнего.'
---

#MelissaMinstrelKissActionText
    $MinstrelKissTextChoice = LCASE($ARGS[0])

    if $MinstrelKissTextChoice = 'interrupt':
        *pl '— Мелисса, Сандра уже спрашивала, где тебя носит, — громко окликаешь ты, выходя из тени.'
        *pl 'Они резко отстраняются друг от друга. Музыкант шутливо салютует тебе шляпой и растворяется в толпе на площади.'
        *pl 'Мелисса судорожно прижимает ладонь к вздымающейся груди, её губы влажно блестят, а в глазах ещё не угас туман наваждения:'
        *pl '— Стефан... ты... ты вечно всё портишь! — сдавленно шепчет она, готовая расплакаться от досады и стыда за собственную слабость.'

    elseif $MinstrelKissTextChoice = 'watch':
        *pl 'Ты замираешь за бочками, не шевелясь. Менестрель берёт Мелиссу за подбородок, заглядывая ей в глаза, и касается губами её губ — сперва робко, затем всё настойчивее.'
        *pl 'Мелисса на мгновение забывает обо всём: её пальцы впиваются в его плечи, тело подаётся навстречу, отвечая на поцелуй с отчаянной, накопленной годами девичьей жаждой. Лишь через несколько долгих секунд она с трудом отстраняется, часто дыша и прижимая пальцы к пылающим губам.'
        *pl 'Она возвращается на освещённую улицу, покачиваясь от нахлынувших чувств, совершенно потерянная между своим дневным благоразумием и ночной страстью.'

    elseif $MinstrelKissTextChoice = 'leave':
        *pl 'Ты пожимаешь плечами и разворачиваешься, оставляя сестру разбираться со своими романами самостоятельно.'
        *pl 'Когда вы встречаетесь позже у трактира, Мелисса нарочито избегает твоего взгляда. Но её затуманенный взор и рассеянные движения выдают девушку, чьё сердце впервые пробило брешь в ледяной броне рассудка.'
    end

    killvar '$MinstrelKissTextChoice'
---

#MelissaMinstrelHallMissingIntroText
    *pl 'Пятничный вечер в трактире в самом разгаре. На новом помосте в углу зала <<$MelissaMinstrelName>> перебирает струны, собирая вокруг себя восторженную толпу горожан, но Мелиссы с подносом нигде не видно.'
    *pl 'Сандра, протирая кружки за стойкой, сердито поджимает губы:'
    *pl '— Куда опять подевалась эта девчонка? Сказала, что пошла проверить запасы за сценой, и как сквозь землю провалилась. Стефан, разберись!'
---

#MelissaMinstrelHallMissingActionText
    $MelissaHallTextChoice = LCASE($ARGS[0])

    if $MelissaHallTextChoice = 'search':
        *pl 'Ты решительно шагаешь за плотный суконный занавес позади подмостков.'
        *pl 'Мелисса обнаруживается у штабеля ящиков: она сидит на высоком бочонке, закинув ногу на ногу и держа в пальцах гусиное перо, пока <<$MelissaMinstrelName>> сидит на низком табурете у её ног, послушно держа лютню на коленях.'
        *pl 'На расстеленном пергаменте видны свежие правки мелким аккуратным почерком сестры.'
        *pl '— Вот здесь, Элрик: рифмовать «глаза» и «слеза» — признак творческой лени, — наставляет она менестреля голосом строгой королевы-покровительницы. Но Стефан замечает, как дрожит перо в её пальцах, а корсаж ходит ходуном от частого дыхания.'
        *pl 'Завидев тебя, менестрель торопливо поднимается и с вежливым поклоном выскальзывает в боковую дверь. Мелисса судорожно прячет пергамент за спину:'
        *pl '— Стефан! Ты... ты стучать не умеешь?! Я всего лишь спасала репутацию заведения... правила его нескладные вирши!'

    elseif $MelissaHallTextChoice = 'spy':
        *pl 'Ты тихо подкрадываешься к щели между досками перегородки.'
        *pl 'В полумраке подсобки менестрель опустился на одно колено перед Мелиссой, благоговейно положив ладонь на её колено и нашептывая пылкие посвящения в самые её губы.'
        *pl 'Мелисса пытается держаться недосягаемой Музой, но плоть берёт своё: её веки трепещут, пальцы путаются в его волосах, а между приоткрытых губ вырывается тихий стон:'
        *pl '— Ты дерзок, Элрик... — сбивающимся шёпотом произносит она. — Твои стихи... они лишают меня рассудка... Но если ты думаешь, что королевы так легко отдают своё сердце...'
        *pl 'Она не успевает договорить: менестрель покрывает её шею горячими поцелуями, и Мелисса запрокидывает голову, судорожно сжимая бедра от разливающегося между ними сладкого жара.'

    elseif $MelissaHallTextChoice = 'wait':
        *pl 'Ты решаешь не устраивать сцен при посетителях и остаёшься за стойкой.'
        *pl 'Спустя добрых четверть часа Мелисса выскальзывает из-за занавеса. Она старается идти царственно и прямо, но её щёки горят, корсаж слегка смят, а взгляд блуждает, словно во сне.'
        *pl 'Она подхватывает поднос, но руки её мелко дрожат, расплёскивая пену с кружек. Дневная строгая хозяйка отчаянно борется с ночной мечтательницей, и эта борьба делает её чертовски желанной.'
    end

    killvar '$MelissaHallTextChoice'
---

#MelissaFirstPathChoiceIntroText
    if MelissaMinstrelHallMissingResult >= 2:
        *pl 'После того, что творилось за сценой, притворяться слепым глупо. Мелисса сидит перед тобой в пустом утреннем зале, скрестив тонкие пальцы на столешнице. В её взгляде нет раскаяния — лишь холодное ожидание твоего вердикта.'
    else:
        *pl 'После танцев на площади и поцелуя под аркой напряжение между вами достигло предела. Мелисса всегда держалась строже и неприступнее Аманды, но сейчас она смотрит на тебя с нескрываемым вызовом, ожидая твоего решения.'
    end
---

#MelissaFirstPathChoiceActionText
    $MelissaPathTextKey = LCASE($ARGS[0])

    if $MelissaPathTextKey = 'pursue':
        *pl 'Ты садишься напротив и берёшь её за руку, глядя прямо в глаза:'
        *pl '— Никаких бродячих поэтов, Мелисса. Если кому и суждено быть рядом с тобой, то мне. Здесь, дома, а не по закоулкам за чужой лютней.'
        *pl 'Мелисса удивлённо приоткрывает губы, но руки не отдёргивает. В глубине её зрачков вспыхивает победный огонёк — она знала, что заставит тебя ревновать.'

    elseif $MelissaPathTextKey = 'prohibit':
        *pl '— Хватит балагана. Ты работаешь в трактире, а не крутишь хвостом перед заезжими скоморохами, — жёстко отрезаешь ты. — С менестрелем покончено. Никаких свиданий вне праздника.'
        *pl 'Мелисса холодно прищуривается, вскидывая подбородок:'
        *pl '— Ты мне не отец, Стефан, чтобы указывать, с кем мне читать стихи. Но если порядок в зале для тебя дороже — я подчинюсь. Пока что.'

    elseif $MelissaPathTextKey = 'watch':
        *pl '— Делай что хочешь, — ровно произносишь ты, — но помни: трактир на виду у всего города. Если из-за твоих шашней с менестрелем пойдут дурные слухи, пеняй на себя. Я буду следить за каждым его шагом.'
        *pl 'Мелисса скептически усмехается:'
        *pl '— Вечно ты строишь из себя строгого хозяина. Не волнуйся, я умею держать дистанцию лучше, чем ты думаешь.'
    end

    killvar '$MelissaPathTextKey'
---