! ================================================
! FILE: modules/events/melissa/melissa_musician_arc_text.qsps
! MODULE: events/family
! [AI-WORKED] 18.09.2026
! Тексты ветки Мелиссы и менестреля
! ================================================

#MelissaMusicStageTalkText
    *pl 'Мелисса сидит за угловым столом, аккуратно закладывая лентой страницу толстой книги в тиснёном переплёте. От её платья всё ещё слегка пахнет вечерней площадью и дымом праздничных костров.'
    *pl '— Он снова будет в городе в следующую пятницу, — невозмутимо произносит она, не поднимая глаз от текста. — Проезжие музыканты любят наш зал, когда им есть где встать с лютней, а не только толкаться между подвыпившими подмастерьями.'
    *pl '— Если сговориться с Драупниром и сколотить небольшое возвышение в углу, менестрели не займут лучший стол для гостей и не опрокинут кружки. Это практично, Стефан. И доход от вина поднимется минимум на треть — люди слушают баллады и охотнее тянутся за выпивкой.'
    *pl 'Она делает небольшую паузу и чуть приподнимает бровь, заметив твой пристальный взгляд:'
    *pl '— И не смотри на меня так, будто я делаю это ради его стихов. Я забочусь о выручке заведения. Хотя баллада о леди Гвендолин в его исполнении действительно безупречна по ритмике.'
---

#MelissaMinstrelMeetIntroText
    *pl 'Мелисса замерла у края деревянного помоста на площади, скрестив руки на груди. Менестрель <<$MelissaMinstrelName>> заканчивает сложный куплет старинной баллады и, плавно завершив аккорд, отвешивает ей церемонный поклон — глубокий, словно даме из рыцарского романа.'
    *pl 'Мелисса слегка вспыхивает румянцем — мимолётным, но заметным — и на мгновение забывает свою обычную насмешливую сдержанность, отвечая ему лёгким кивком.'
---

#MelissaMinstrelMeetActionText
    $MinstrelMeetTextChoice = LCASE($ARGS[0])

    if $MinstrelMeetTextChoice = 'approach':
        *pl 'Ты подходишь к сестре и с усмешкой кладёшь руку ей на плечо, прерывая затянувшуюся паузу.'
        *pl '— Заслушалась стихами, книжница? — бросаешь ты с весёлой хозяйской уверенностью.'
        *pl 'Менестрель вежливо улыбается, кланяется вам обоим и отступает к другим слушателям, но цепкий взгляд его серых глаз задерживается на вас чуть дольше обычного.'
        *pl '— Я всего лишь оценивала размер строфы, Стефан, — сухо, но без злости парирует Мелисса, пряча тень улыбки. — Не все вокруг столь неотесаны, как завсегдатаи нашей стойки.'

    elseif $MinstrelMeetTextChoice = 'warn':
        *pl 'Ты встаёшь между ними и недвусмысленно даёшь понять бродячему лютнисту, что старшая из сестёр Лонгкок — не из тех девиц, которым вешают лапшу на уши рифмами.'
        *pl 'Менестрель примирительно поднимает ладони и отшучивается, но Мелисса недовольно цокает языком:'
        *pl '— Стефан, сделай лицо попроще. Ты выглядишь как цепной пёс у лавки мясника. Я в состоянии сама разобрать, где истинная поэзия, а где пустая лесть.'

    elseif $MinstrelMeetTextChoice = 'watch':
        *pl 'Ты остаёшься в тени навеса и наблюдаешь со стороны. Менестрель что-то негромко шепчет, показывая на колки лютни, а Мелисса отвечает — не смущённо, как провинциалка, а оживлённо споря с ним о текстах песен, изредка сдержанно смеясь.'
        *pl 'Такой открытой и искренне увлечённой ты не видел её уже очень давно.'

    elseif $MinstrelMeetTextChoice = 'ignore':
        *pl 'Ты решаешь не лезть в чужие разговоры и отвлекаешься на суету вокруг помоста мэра. Когда ты снова оборачиваешься, менестрель уже галантно целует кончики пальцев Мелиссы на прощание, а она с лёгкой полуулыбкой провожает его взглядом.'
    end

    killvar '$MinstrelMeetTextChoice'
---

#MelissaMinstrelKissIntroText
    *pl 'Очередной танец подошёл к концу, музыка на площади затихла. В полумраке под сводчатой аркой у складов <<$MelissaMinstrelName>> что-то негромко декламирует Мелиссе, склоняясь к её лицу неприлично близко для простого музыканта.'
    *pl 'Мелисса прижимает к груди ладони, её щёки горят в сумерках, но она не спешит делать шаг назад.'
---

#MelissaMinstrelKissActionText
    $MinstrelKissTextChoice = LCASE($ARGS[0])

    if $MinstrelKissTextChoice = 'interrupt':
        *pl '— Мелисса, Сандра уже спрашивала, где тебя носит, — громко окликаешь ты, выходя из тени.'
        *pl 'Они резко отстраняются друг от друга. Музыкант шутливо салютует тебе шляпой и растворяется в толпе на площади.'
        *pl 'Мелисса нервно поправляет ворот платья, её дыхание сбито:'
        *pl '— Мы просто прощались, Стефан... Вечно ты появляешься в самый неподходящий момент, словно строгий надсмотрщик.'

    elseif $MinstrelKissTextChoice = 'watch':
        *pl 'Ты замираешь за бочками, не шевелясь. Менестрель берёт Мелиссу за подбородок, заглядывая ей в глаза, и касается губами её губ — сперва робко, затем всё настойчивее.'
        *pl 'Мелисса на мгновение зажмуривается, отвечая на поцелуй, после чего мягко отталкивает его ладонью в грудь, напоминая о приличиях.'
        *pl 'Она возвращается на освещённую часть улицы с горящим взглядом и рассеянной улыбкой.'

    elseif $MinstrelKissTextChoice = 'leave':
        *pl 'Ты пожимаешь плечами и разворачиваешься, оставляя сестру разбираться со своими романами самостоятельно.'
        *pl 'Когда вы встречаетесь позже у трактира, Мелисса нарочито избегает смотреть тебе в глаза, но во всём её виде сквозит волнующая тайна, которой она не собирается делиться.'
    end

    killvar '$MinstrelKissTextChoice'
---

#MelissaMinstrelHallMissingIntroText
    *pl 'Пятничный вечер в трактире в самом разгаре. На новом помосте в углу зала <<$MelissaMinstrelName>> перебирает струны, собирая вокруг себя восторженную толпу горожан, но Мелиссы с подносом нигде не видно.'
    *pl 'Сандра, протирая кружки за стойкой, сердито поджимает губы:'
    *pl '— Куда опять подевалась эта девчонка? Сказала, что пошла проверить запасы за сценой, и как сквозь землю провалилась. Стефан, разберись!'
---

#MelissaMinstrelHallMissingActionText
    $MelissaHallTextChoice = LCASE($ARGS[0])

    if $MelissaHallTextChoice = 'search':
        *pl 'Ты решительно шагаешь за плотную занавесь позади подмостков. Мелисса обнаруживается у ящиков — она торопливо оглаживает подол юбки и собирает рассыпавшиеся нотные листы.'
        *pl 'Менестрель успевает выскользнуть в боковую дверь, оставив за собой лишь терпкий запах трубочного табака и гвоздики.'
        *pl '— Я... я просто помогала ему разобрать баллады, — с вызовом заявляет Мелисса, хотя её щёки пылают румянцем.'

    elseif $MelissaHallTextChoice = 'spy':
        *pl 'Ты тихо подкрадываешься к щели между досками перегородки. В полумраке подсобки менестрель прижимает Мелиссу к стене, его руки уверенно сминают ткань её платья на бёдрах, а с её губ срывается прерывистый полустон-полувздох.'
        *pl 'Ты видишь достаточно, чтобы осознать: если не вмешаться, этот бродячий поэт скоро уведёт её прямо из-под твоего носа.'

    elseif $MelissaHallTextChoice = 'wait':
        *pl 'Ты решаешь не устраивать сцен при посетителях и остаёшься за стойкой. Спустя добрых четверть часа Мелисса выскальзывает из-за занавеса — шпильки в волосах сбились, губы влажно блестят, а пуговицы на корсаже застёгнуты явно второпях.'
        *pl 'Она подхватывает поднос с вином и принимается разносить заказы с нарочито деловитым видом.'
    end

    killvar '$MelissaHallTextChoice'
---

#MelissaFirstPathChoiceIntroText
    if MelissaMinstrelHallMissingResult >= 2:
        *pl 'После того, что творилось за сценой, притворяться слепым глупо. Мелисса сидит перед тобой в пустом утреннем зале, скрестив тонкие пальцы на столешнице. В её взгляде нет раскаяния — лишь холодное ожидание твоего вердикта.'
    else:
        *pl 'После танцев на площади и поцелуя под аркой напряжение между вами достигло предела. Мелисса всегда держалась строже и неприступнее Аманды, но сейчас она смотрит на тебя с нескрываемым вызовом, ожидая твоего решения.'
    end
---

#MelissaFirstPathChoiceActionText
    $MelissaPathTextKey = LCASE($ARGS[0])

    if $MelissaPathTextKey = 'pursue':
        *pl 'Ты садишься напротив и берёшь её за руку, глядя прямо в глаза:'
        *pl '— Никаких бродячих поэтов, Мелисса. Если кому и суждено быть рядом с тобой, то мне. Здесь, дома, а не по закоулкам за чужой лютней.'
        *pl 'Мелисса удивлённо приоткрывает губы, но руки не отдёргивает. В глубине её зрачков вспыхивает победный огонёк — она знала, что заставит тебя ревновать.'

    elseif $MelissaPathTextKey = 'prohibit':
        *pl '— Хватит балагана. Ты работаешь в трактире, а не крутишь хвостом перед заезжими скоморохами, — жёстко отрезаешь ты. — С менестрелем покончено. Никаких свиданий вне праздника.'
        *pl 'Мелисса холодно прищуривается, вскидывая подбородок:'
        *pl '— Ты мне не отец, Стефан, чтобы указывать, с кем мне читать стихи. Но если порядок в зале для тебя дороже — я подчинюсь. Пока что.'

    elseif $MelissaPathTextKey = 'watch':
        *pl '— Делай что хочешь, — ровно произносишь ты, — но помни: трактир на виду у всего города. Если из-за твоих шашней с менестрелем пойдут дурные слухи, пеняй на себя. Я буду следить за каждым его шагом.'
        *pl 'Мелисса скептически усмехается:'
        *pl '— Вечно ты строишь из себя строгого хозяина. Не волнуйся, я умею держать дистанцию лучше, чем ты думаешь.'
    end

    killvar '$MelissaPathTextKey'
---