! ================================================
! FILE: modules/events/melissa/melissa_minstrel_backroom_text.qsps
! MODULE: events/family
! [AI-WORKED] 18.09.2026: углубление характера Мелиссы (Муза и Королева, а не пассивная жертва)
! Тексты закулисья Мелиссы и менестреля
! ================================================

#MelissaMinstrelBackroomIntroText
    *pl 'Новая сцена в углу зала отгорожена тяжёлым суконным занавесом. За ним царит полутьма и приглушённая тишина, слишком интимная для шумного пятничного вечера.'
    *pl 'Мелисса и <<$MelissaMinstrelName>> скрылись там уже добрых десять минут назад, оставив зал звенеть кружками без хозяйского присмотра.'
---

#MelissaMinstrelBackroomActionText
    $MelissaBackroomTextChoice = LCASE($ARGS[0])

    if $MelissaBackroomTextChoice = 'interrupt':
        *pl 'Ты резко дёргаешь занавес в сторону, вторгаясь в полумрак закулисья.'
        *pl 'Мелисса восседает на высоком ящике, словно королева на троне, закинув ногу на ногу и скрестив руки на груди. Менестрель замер в полушаге от неё с лютней в руках, декламируя пылкую строфу.'
        *pl ' '
        *pl 'При твоём появлении сестра старается не выдать смущения, но её поза выдает напряжение, а на щеках вспыхивает яркий румянец:'
        *pl '— Стефан? Ты решил приобщиться к высокому слогу? Элрик как раз излагал мне теорию куртуазной любви... Хотя его практические порывы явно опережают теорию.'
        *pl 'Она говорит насмешливо, но её пальцы судорожно комкают край фартука, а прерывистый вздох выдает, как сладко и тревожно билось её сердце ещё секунду назад.'
        *pl 'Менестрель с учтивым, чуть ироничным поклоном салютует тебе и отступает на шаг, уступая дорогу хозяину.'

    elseif $MelissaBackroomTextChoice = 'spy':
        if MelissaMinstrelBackroomSpyRollHard = 1:
            *pl 'Сквозь щель в сукне занавеса открывается волнующая картина.'
            *pl 'Менестрель прижал Мелиссу спиной к деревянной обшивке сцены, горячо нашептывая ей на ухо строки из запретных баллад. Его ладонь смело скользит по талии девушки, подбираясь к вырезу корсажа.'
            *pl 'Мелисса пытается играть роль неприступной Музы и покровительницы, но её рациональная броня трещит по швам: её пальцы судорожно путаются в тёмных кудрях поэта, а из приоткрытых губ срывается прерывистый, молящий вздох:'
            *pl '— Ты дерзок, Элрик... — шепчет она, чувствуя, как в животе порхают бабочки, а между бёдер разливается горячая, стыдная влага. — Твои рифмы... они жгут сильнее огня... Но если ты завтра не утроишь выручку заведения, твоя Муза... я прикажу выставить тебя за дверь...'
            *pl 'Голос её срывается на тихий сладострастный стон, когда поэт жадно целует её шею под ключицей. Мелисса запрокидывает голову, на мгновение сдаваясь этой сладкой слабости и забывая, кто она — расчётливая хозяйка или безумная книжная дева.'
        else:
            *pl 'За занавесом слышны мягкий перебор струн и бархатный, завораживающий голос менестреля.'
            *pl 'Элрик опустился на колени перед Мелиссой, декламируя сонет и с благоговением касаясь пальцами её подола. Мелисса сидит прямо, словно королева на троне, легко щёлкая его гусиным пером по руке:'
            *pl '— Сперва доведи размер до совершенства, поэт. Руки держи на струнах, а награду получишь, когда зрители в зале будут рукоплескать со слезами на глазах.'
            *pl 'Она говорит строго, как мудрая правительница из хроник, но её зрачки расширены, дыхание сбито, а в глубине карих глаз плещется чистый девичий восторг перед поэтом, который поёт только для неё.'
        end

    elseif $MelissaBackroomTextChoice = 'leave':
        if MelissaMinstrelBackroomSoftNearMiss = 1:
            *pl 'Ты отворачиваешься и возвращаешься к стойке, оставив их наедине с искусством.'
            *pl 'Спустя четверть часа Мелисса выходит в зал: щёки её алеют от возбуждения, походка слегка неуверенная, словно ноги отнялись от сладкой слабости, а в руках она сжимает исписанный пергамент с посвящением «Прекрасной и непокорной госпоже трактира».'
            *pl 'Она ловит твой взгляд и торопливо отводит глаза, пряча туманную истому: в этот вечер её книжные фантазии подобрались слишком близко к опасной черте.'
        else:
            *pl 'Ты решаешь не следить за сестрой и занимаешься заказами в зале.'
            *pl 'Когда Мелисса наконец выходит из-за занавеса, её осанка подчеркнуто строга, как у наставницы, но глубокий румянец и блуждающая улыбка выдают, что стихи менестреля попали точно в цель.'
        end
    end

    killvar '$MelissaBackroomTextChoice'
---