! ================================================
! FILE: modules/events/melissa/melissa_minstrel_backroom_text.qsps
! MODULE: events/family
! [AI-WORKED] 18.09.2026
! Тексты закулисья Мелиссы и менестреля
! ================================================

#MelissaMinstrelBackroomIntroText
    *pl 'Новая сцена в углу зала отгорожена тяжёлым суконным занавесом. За ним царит полутьма и приглушённая тишина, слишком интимная для шумного пятничного вечера.'
    *pl 'Мелисса и <<$MelissaMinstrelName>> скрылись там уже добрых десять минут назад, оставив зал звенеть кружками без хозяйского присмотра.'
---

#MelissaMinstrelBackroomActionText
    $MelissaBackroomTextChoice = LCASE($ARGS[0])

    if $MelissaBackroomTextChoice = 'interrupt':
        *pl 'Ты резко дёргаешь занавес в сторону, нарушая уединение. Мелисса вздрагивает, испуганно прижимая ладонь к вороту платья, а менестрель отстраняется — невозмутимо, но с явной досадой в прищуре серых глаз.'
        *pl '— Стефан... — сбившимся шёпотом произносит сестра, пытаясь вернуть лицу привычное строгое выражение. — Мы просто обсуждали ноты к балладе.'
        *pl 'Ты прервал их вовремя, но огонь между ними уже разгорелся.'

    elseif $MelissaBackroomTextChoice = 'spy':
        if MelissaMinstrelBackroomSpyRollHard = 1:
            *pl 'Сквозь щель в занавесе доносятся сдавленные вздохи и прерывистый шёпот. Менестрель прижал Мелиссу к дощатой стене, нашептывая ей на ухо строки из куртуазных поэм, а его руки уверенно сминают подол её платья.'
            *pl 'Мелисса запрокидывает голову, её пальцы судорожно вцепились в его плечи. Это не просто флирт — ещё мгновение, и пути назад уже не останется.'
        else:
            *pl 'За занавесом слышны тихий шёпот, влажные звуки поцелуев и шорох ткани. Менестрель склоняется к её шее, а Мелисса лишь слабо пытается остудить его пыл, с трудом сдерживая дыхание.'
            *pl 'Черта ещё не перейдена окончательно, но благоразумие книжной девицы явно дало трещину.'
        end

    elseif $MelissaBackroomTextChoice = 'leave':
        if MelissaMinstrelBackroomSoftNearMiss = 1:
            *pl 'Ты отворачиваешься и возвращаешься к шумной стойке. За перегородкой слышны сдавленный смех и торопливый шелест юбок — они явно балансируют на самой грани.'
            *pl 'Спустя время Мелисса появляется в зале: подбородок вздёрнут, в глазах лихорадочный блеск, а шпильки в волосах держатся на честном слове.'
        else:
            *pl 'Ты решаешь не следить за сестрой и занимаешься заказами в зале. Когда Мелисса наконец выходит из-за занавеса, её щёки горят румянцем, но она тут же прячет смущение за привычной холодной улыбкой.'
        end
    end

    killvar '$MelissaBackroomTextChoice'
---