! ================================================
! FILE: modules/events/melissa/melissa_minstrel_backroom_text.qsps
! MODULE: events/family
! [AI-WORKED] Текст переработан / дополнен ассистентом 02.11.2026
! Полноценная детальная сцена: Менестрель в комнате Мелиссы
! ================================================

#MelissaMinstrelBackroomIntroText
    *pl 'Ночь. Таверна давно закрыта, в коридоре второго этажа царит сонная тишина.'
    *pl 'Проходя мимо комнаты сестры, ты замечаешь, что дверь слегка приоткрыта, а из щели пробивается тёплый свет свечи.'
    *pl 'Внутри слышен приглушённый мужской шёпот и тихое девичье хихиканье. Менестрель Элрик тайком пробрался наверх прямо в спальню Мелиссы.'
---

#MelissaMinstrelBackroomActionText
    $MelissaBackroomTextChoice = LCASE($ARGS[0])

    if $MelissaBackroomTextChoice = 'interrupt':
        *pl 'Ты с силой распахиваешь дверь и шагаешь через порог, нависая над любовниками:'
        *pl '— Что здесь происходит?! Элрик, ты попутал трактир с дешёвым притоном?!'
        *pl ' '
        *pl 'Менестрель испуганно вскакивает с кровати, путаясь в штанах и роняя исписанный листок с куплетами на ковёр:'
        *pl '— Хозяин Стефан! Мы... мы просто выверяли рифмы к новой саге... Никакого неуважения к дому!'
        *pl 'Он кубарем выскальзывает в коридор и скатывается по лестнице вниз.'
        *pl 'Мелисса сидит на краю постели, её ночная сорочка сбита набок, обнажая белое плечо. Она сверкает на тебя полными ярости и стыда глазами:'
        *pl '— Стефан! Как ты смеешь врываться в мою комнату без стука?! Я уже не маленькая девочка, чтобы ты следил за каждым моим вздохом!'
        *pl 'Впрочем, её сбивчивое дыхание и пунцовый румянец показывают, что твоё вмешательство прервало то, к чему всё неумолимо шло.'

    elseif $MelissaBackroomTextChoice = 'spy':
        *pl 'Ты бесшумно приникаешь глазом к широкой щели приоткрытой двери.'
        *pl 'В мягком янтарном сиянии свечей разворачивается запретная сцена:'
        *pl 'Мелисса лежит на своей девичьей кровати среди разложенных пергаментов и книг. Её тонкая ночная сорочка задрана выше пояса, обнажая стройные белые бёдра.'
        *pl 'Элрик устроил её ножки у себя на плечах, прижав бёдра девушки к матрасу. Его лицо погружено между её ног — он жадно, со знанием дела ласкает её сокровенную ложбинку языком.'
        *pl ' '
        *pl 'Мелисса выгибается в спине, её пальцы до белизны костяшек сжимают простыни. Из её горла вырывается тихий, прерывистый стон:'
        *pl '«Ах... Элрик... как горячо... твои губы... слаще любых сонетов... прошу, не мучай, возьми меня!..»'
        *pl ' '
        *pl 'Менестрель поднимается на колени, наставляя твёрдый, налитый ствол к её лону. Мелисса сама подаётся навстречу, жадно насаживаясь на его плоть.'
        *pl 'Кровать ритмично поскрипывает в такт его мощным толчкам. Мелисса стонет в голос, бесстыдно подмахивая бёдрами и запрокидывая голову:'
        if MelissaHomeSex = 1:
            *pl '«Да... вот так... глубже!.. Мой грозный братик думает, что держит меня в узде, но его ласки грубы... а ты поёшь телом, Элрик... заполняй меня всю!..»'
        else:
            *pl '«Да... ещё... сильнее!.. Ни одна книга не способна описать это безумие... я вся твоя, поэт...»'
        end
        *pl ' '
        *pl 'На пике бешеной страсти Элрик с глухим рыком до упора входит в её лоно, мощными толчками изливая горячую лавину семени в самое нутро сестры.'
        *pl 'Мелисса сладко вздрагивает, задыхаясь в оргазме, и крепко обнимает его ногами за талию, не давая отстраниться ни на дюйм.'
        *pl ' '
        *pl 'Когда они наконец затихают, тяжело переводя дух, Мелисса гладит поэта по волосам с хитрой и разомлевшей улыбкой:'
        if FamilyCorruptionStage >= 3:
            *pl '«Ты опять залил всё семя внутрь, безумец... А если я понесу от тебя? Хотя... пусть в этом доме зазвучит детский смех, Стефан с мамой только рады будут новому помощнику в трактире. Но в следующий раз мы попробуем со спины — я хочу почувствовать, как ты входишь в мою попку прямо здесь, на этой кровати...»'
        else:
            *pl '«Ты сошёл с ума, Элрик... если я забеременею от бродячего барда, нас обоих вышвырнут из города... Но Ильматер видит, я ни о чём не жалею...»'
        end
        *pl ' '
        *pl 'Ты тихо отступаешь назад по коридору, чувствуя, как в груди закипает смесь бешеного возбуждения и осознания: строгая, неприступная сестра окончательно отдала своё тело и душу заезжему музыканту.'

    elseif $MelissaBackroomTextChoice = 'leave':
        *pl 'Ты решаешь не нарушать уединение сестры и бесшумно отходишь от её двери.'
        *pl 'Спустя несколько минут из-за створки доносятся сладостные, приглушённые вскрики Мелиссы и мерный стук кровати о стену.'
        *pl 'Ты спускаешься вниз, понимая, что этой ночью в спальне сестры все книги и расчёты забыты ради чистой плотской страсти.'
    end

    killvar '$MelissaBackroomTextChoice'
---
