! ================================================
! FILE: modules/events/melissa/melissa_minstrel_backroom_text.qsps
! MODULE: events/family
! Тексты закулисья Мелиссы и менестреля
! ================================================

#MelissaMinstrelBackroomIntroText
    *p 'Новая сцена в углу зала отгорожена занавесом. За ним — тишина, слишком интимная для пятничного вечера.'
    *p 'Мелисса и ' + $MelissaMinstrelName + ' исчезли там уже несколько минут.'
---

#MelissaMinstrelBackroomActionText
    $MelissaBackroomTextChoice = LCASE($ARGS[0])

    if $MelissaBackroomTextChoice = 'interrupt':
        *p 'Вы резко раздвигаете занавес. Мелисса вздрагивает, менестрель отступает — пока без позора, но с явным раздражением.'
        *p '«Стефан…» — шепчет она. Вы прерываете их, но история с менестрелем на этом не оборвётся.'

    elseif $MelissaBackroomTextChoice = 'spy':
        if MelissaMinstrelBackroomSpyRollHard = 1:
            *p 'За занавесом слышны сдержанные стоны. Мелисса шепчет что-то — не «стой».'
            *p 'Руки, дыхание, ткань на полу. Ещё мгновение — и назад дороги не будет. Они пока не знают, что вы слушаете.'
        else
            *p 'За занавесом — поцелуи и руки под платьем. Дальше они ещё не зашли, но граница уже пройдена.'
        end

    elseif $MelissaBackroomTextChoice = 'leave':
        if MelissaMinstrelBackroomSoftNearMiss = 1:
            *p 'Вы отворачиваетесь к залу. За занавесом слышны сдержанный смех и шорох — но не то, что нельзя остановить одним шагом.'
            *p 'Мелисса выходит с приподнятым подбородком и рассыпанной причёской. Не до конца — но они уже слишком близко. Скоро снова придётся выбирать.'
        else:
            *p 'Вы заняты залом. Когда Мелисса возвращается, она краснеет — но улыбается кому-то за вашей спиной.'
        end
    end

    killvar '$MelissaBackroomTextChoice'
---