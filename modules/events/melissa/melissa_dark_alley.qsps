---

#MelissaDanceAlleyReset
    MelissaAlleyDay = day
    MelissaAlleyStage = 0
    MelissaAlleyRisk = 0
    MelissaAlleyKiss = 0
    MelissaAlleyClose = 0
    MelissaAlleyPetting = 0
