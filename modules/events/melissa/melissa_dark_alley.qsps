        if MelissaAlleyStage < 3:
            MelissaAlleyStage = 3
        end
        MelissaAlleyRisk += 3
        love[$MelissaAlleyGirl] += 1
        otkroven[$MelissaAlleyGirl] += 1

    elseif $MelissaAlleyAction = 'petting':
        MelissaAlleyPetting = 1
        if MelissaAlleyStage < 4:
            MelissaAlleyStage = 4
        end
        MelissaAlleyRisk += 4
        sluttiness[$MelissaAlleyGirl] += 1
