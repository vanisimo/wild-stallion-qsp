#MelissaDanceAlleyEvent
    *clr
    clr
    cla

    $MelissaAlleyGirl = 'melissa'
    gs 'EnsureGirlData', $MelissaAlleyGirl

    if MelissaAlleyDay <> day:
        gs 'MelissaDanceAlleyReset'
    end

    if MelissaAlleyStage = 0:
        MelissaAlleyStage = 1
        MelissaAlleyRisk = 8 + MelissaDancePublicRisk
        MelissaPlayerPath += 1
        otkroven['melissa'] += 1
        if RAND(1, 100) <= 50:
            MelissaAlleyPlace = 2
        else:
            MelissaAlleyPlace = 1
        end
    end

    if MelissaAlleyPetting = 1:
        gs 'SceneShowVisual', 'images/events/melissa/melissa_dark_alley/melissa_dance_alley_petting', 'МЕЛИССА: ЛАСКИ ПОД ЮБКОЙ', 'large', 'webp'
    elseif MelissaAlleyClose = 1:
        gs 'SceneShowVisual', 'images/events/melissa/melissa_dark_alley/melissa_dance_alley_close', 'МЕЛИССА: ОБЪЯТИЯ В ПОЛУМРАКЕ', 'large', 'webp'
    elseif MelissaAlleyKiss = 1:
        gs 'SceneShowVisual', 'images/events/melissa/melissa_dark_alley/melissa_dance_alley_kiss', 'МЕЛИССА: ПОЦЕЛУЙ В ТЕМНОТЕ', 'large', 'webp'
    else:
        gs 'SceneShowVisual', 'images/events/melissa/melissa_dark_alley/melissa_dance_alley_event', 'ПОДВОРОТНЯ У ПЛОЩАДИ', 'large', 'webp'
    end

    gs 'ShowLocationScreenTitle', 'ПОДВОРОТНЯ У ПЛОЩАДИ'

    if LOC('MelissaDanceAlleyMainText') = 1:
        gs 'MelissaDanceAlleyMainText'
    else:
        if $MelissaAlleyLastText <> '':
            *p $MelissaAlleyLastText
        else:
            *pl 'Ты с Мелиссой отходишь от шумной ярмарочной площади в тёмный проход между домами.'
            *pl 'Музыка слышна за углом, но здесь, в полумраке у каменной кладки, каждый звук кажется громче.'
        end
    end

    if MelissaAlleyPlace = 2:
        *pl ' '
        *pl 'В глубине переулка ведут наверх широкие деревянные ступени бокового крыльца магистратской конторы — здесь сухо, чисто и тень портика надёжно скрывает вас от огней площади.'
    else:
        *pl ' '
        *pl 'Узкий проход упирается в прохладную гладкую каменную кладку древней арки — здесь царит глубокая тень.'
    end

    *pl ' '

    if debug = 1:
        *pl '[DEBUG MELISSA ALLEY] Stage: ' + STR(MelissaAlleyStage) + ' | Place: ' + STR(MelissaAlleyPlace) + ' | Risk: ' + STR(MelissaAlleyRisk)
        *pl ' '
    end

    gs 'MelissaDanceAlleyBuildForeplayMenu'

    *p 'Что ты будешь <a href="exec:gs ''Menu.Show'', ''MelissaAlleyMenu''">делать</a>?'

    gs 'ActUiPrepare', 'Уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaDanceAlleyEnd'
    end
---

