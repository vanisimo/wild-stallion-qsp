#MelissaDanceAlleyPeeperCheck
    ! Постоянный наблюдатель на ступенях конторы (вероятность 20%)
    if MelissaAlleyPlace = 2 and MelissaAlleyPeeperTriggered = 0:
        MelissaPeeperRoll = RAND(1, 100)
        if MelissaPeeperRoll <= 20:
            MelissaAlleyPeeperTriggered = 1
            MelissaAlleyClerkWitness = 1
            MelissaAlleyRisk += 4
            TavernScandal += 1
            if LOC('MelissaDanceAlleyPeeperText') = 1:
                gs 'MelissaDanceAlleyPeeperText'
            end
        end
    end
    killvar 'MelissaPeeperRoll'
---

#MelissaDanceAlleyWitnessCheck
