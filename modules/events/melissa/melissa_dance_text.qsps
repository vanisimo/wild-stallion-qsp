! ================================================
! FILE: modules/events/melissa/melissa_dance_text.qsps
! MODULE: events/family
! [AI-WORKED] Текст переработан / дополнен ассистентом 02.11.2026
! Тексты пятничного танца Мелиссы (вариативность по FamilyCorruptionStage и otkroven)
! ================================================

#MelissaDanceMainText
    if $MelissaDanceLastText <> '':
        *pl $MelissaDanceLastText
    elseif MelissaDanceStage = 1:
        if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 15:
            *pl 'Ты ведёшь Мелиссу в круг танцующих под звуки весёлой скрипки.'
            *pl 'Она держит спину прямо, как настоящая книжная королева, но её пальцы с чувственным нажимом сплетаются с твоими, а карие глаза насмешливо блестят в свете праздничных костров.'
        else:
            *pl 'Ты ведёшь Мелиссу в круг танцующих. Она ступает чинно и аккуратно, стараясь держаться на приличном расстоянии, но не отпускает твою руку слишком быстро.'
        end
    elseif MelissaDanceStage = 2:
        if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 15:
            *pl 'Твоя ладонь уверенно покоится на её гибкой талии. Мелисса не только не отстраняется, но сама подаётся ближе, позволяя бедру мягко задевать твоё при каждом повороте танца.'
        else:
            *pl 'Твоя ладонь на её талии. Мелисса прислушивается к ритму барабанов и внимательно следит краем глаза, не смотрит ли слишком пристально мать где-то среди почтенных горожанок.'
        end
    elseif MelissaDanceStage = 3:
        if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 15:
            *pl 'После поцелуя Мелисса облизывает припухшие губы с лукавой, победной усмешкой. Она вызывающе смотрит по сторонам, словно бросая вызов любопытным зевакам на площади.'
        else:
            *pl 'После поцелуя Мелисса испуганно отводит взгляд и густо краснеет, но не отталкивает тебя. На площади слишком много досужих глаз, чтобы показать что-то лишнее.'
        end
    elseif MelissaDanceStage >= 4:
        if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 15:
            *pl 'Мелисса прижимается к тебе всем телом, позабыв о приличиях и чужих пересудах. Её горячее дыхание щекочет тебе подбородок, а пальцы сжимают твою рубаху на спине.'
        else:
            *pl 'Мелисса стоит слишком близко к тебе. Даже для вольного пятничного вечера это уже выходит за рамки невинного танца сестры и брата, и она нервно кусает губу.'
        end
    else:
        if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 15:
            *pl 'Мелисса в элегантном наряде винного цвета выглядит притягательно и смело. Она ловит твой взгляд и насмешливо склоняет голову набок, ожидая мужского напора.'
        else:
            *pl 'Мелисса в праздничном платье выглядит строже обычного — и всё равно не может скрыть смущённого румянца от того, что ей льстит твоё внимание.'
        end
    end
---

#MelissaDanceActionText
    $MelissaDanceTextAction = LCASE($ARGS[0])

    if $MelissaDanceTextAction = 'dance':
        if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 15:
            $MelissaDanceLastText = 'Мелисса с улыбкой вкладывает пальцы в твою ладонь: «Надеюсь, ты помнишь ритм, Стефан? Я не позволю тебе отдавить мне туфли на глазах у половины города».'
        else:
            $MelissaDanceLastText = 'Мелисса принимает приглашение после короткой паузы: «Только один танец, Стефан. Не стоит привлекать к нам лишнее внимание толпы».'
        end
    elseif $MelissaDanceTextAction = 'waist':
        if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 15:
            $MelissaDanceLastText = 'Ты крепко прижимаешь её за талию к себе. Мелисса выдыхает сквозь зубы и шепчет на ухо: «Смелее, хозяин... Или ты боишься, что городские сплетники пересчитают твои пальцы на моем платье?»'
        elseif FamilyCorruptionStage >= 2 or otkroven['melissa'] >= 8:
            $MelissaDanceLastText = 'Ты кладёшь руки ей на талию. Мелисса вздрагивает, но послушно подстраивается под твои шаги: «Тише, Стефан... Не сжимай так жадно, на нас же смотрят».'
        else:
            $MelissaDanceLastText = 'Ты кладёшь руку ей на талию. Мелисса неловко выпрямляет спину, стараясь сохранить благопристойный зазор между вами: «Не части, Стефан... держи дистанцию, как подобает брату».'
        end
    elseif $MelissaDanceTextAction = 'kiss':
        if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 15:
            $MelissaDanceLastText = 'Ты властно привлекаешь её к себе и целуешь прямо в кругу танцующих. Мелисса смело отвечает на поцелуй, приоткрывая тёплые губы и дразняще касаясь тебя языком под шум восторженных выкриков гуляк.'
        elseif FamilyCorruptionStage >= 2 or otkroven['melissa'] >= 8:
            $MelissaDanceLastText = 'Поцелуй заставляет её замереть. Мелисса судорожно сжимает твоё плечо, отвечая коротко и горячо, после чего прячет пылающее лицо у тебя на груди.'
        else:
            $MelissaDanceLastText = 'Поцелуй застаёт её врасплох. Мелисса растерянно моргает, отстраняясь на полшага: «Стефан! Ты с ума сошёл при всём народе?.. А если матушка увидит?»'
        end
    elseif $MelissaDanceTextAction = 'neck':
        if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 15:
            $MelissaDanceLastText = 'Твои губы скользят по её шее к чувствительной ямочке у ключицы. Мелисса протяжно, томно стонет, запрокидывая голову тебе на плечо: «Ах... Стефан... прямо здесь, среди зевак... с ума сводишь...»'
        elseif FamilyCorruptionStage >= 2 or otkroven['melissa'] >= 8:
            $MelissaDanceLastText = 'Поцелуй в шею сбивает её с шага. Мелисса нервно сглатывает, цепляясь за твой локоть: «Стефан, прошу... у меня мурашки по всей спине, я собьюсь с ритма...»'
        else:
            $MelissaDanceLastText = 'Ты касаешься губами её шеи. Мелисса испуганно вздрагивает и отдёргивает голову: «Стефан, прекрати! Здесь же полно досужих зевак, это переходит всякие границы!»'
        end
    else:
        $MelissaDanceLastText = 'Танец продолжается под гул голосов и перезвон ярмарочной музыки.'
    end

    killvar '$MelissaDanceTextAction'
---

#MelissaDanceAlleyIntroText
    *pl 'Мелисса останавливается у тёмного прохода между лавками и решительно берёт тебя за руку.'
    if FamilyCorruptionStage >= 3 or otkroven['melissa'] >= 15:
        *pl '— Не здесь, Стефан... — шепчет она с горячим придыханием, прижимаясь к тебе в тени навеса. — Я не хочу суетиться стоя у пыльного забора, как дешёвая портовая девка. Пойдём домой. В мою комнату. Там ты получишь всё, о чём сейчас думаешь.'
    else:
        *pl '— Не здесь, Стефан, — твёрдо качает она головой, поправляя подол платья. — Я хочу, чтобы наш первый раз был особенным и обдуманным. А не в грязной подворотне среди бочек.'
    end
---

#IrmaMelissaDanceDressBuyText
    $IrmaDressText = 'Ирма разворачивает ткань цвета ночного вина: «Для Мелиссы — чуть строже крой, чем для Аманды. Семьдесят спринтрий, три дня работы. Платье для пятничных танцев — не для зала трактира».'
---

#IrmaMelissaDanceDressBoughtText
    $IrmaDressText = 'Ирма записывает мерки и обещает платье к ближайшей пятнице. Мелисса будет готова танцевать на площади в полном наряде.'
---
