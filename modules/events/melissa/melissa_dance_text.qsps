! ================================================
! FILE: modules/events/melissa/melissa_dance_text.qsps
! MODULE: events/family
! [AI-WORKED] 18.09.2026
! Тексты пятничного танца Мелиссы
! ================================================

#MelissaDanceMainText
    if $MelissaDanceLastText <> '':
        *pl $MelissaDanceLastText
    elseif MelissaDanceStage = 1:
        *pl 'Вы ведёте Мелиссу в круг танцующих. Она держит спину прямо, как настоящая книжная королева, но не отпускает вашу руку слишком быстро.'
    elseif MelissaDanceStage = 2:
        *pl 'Ваша ладонь на её талии. Мелисса прислушивается к музыке и внимательно следит, не смотрит ли слишком пристально мать где-то в толпе.'
    elseif MelissaDanceStage = 3:
        *pl 'После поцелуя Мелисса отводит взгляд, но не отстраняется. На площади слишком много любопытных глаз, чтобы показать больше.'
    elseif MelissaDanceStage >= 4:
        *pl 'Мелисса стоит слишком близко к вам. Даже для вольного пятничного вечера это уже не просто танец сестры и брата.'
    else:
        *pl 'Мелисса в праздничном платье выглядит строже обычного — и всё равно не может скрыть, что ей льстит ваше внимание.'
    end
---

#MelissaDanceActionText
    $MelissaDanceTextAction = LCASE($ARGS[0])

    if $MelissaDanceTextAction = 'dance':
        $MelissaDanceLastText = 'Мелисса принимает приглашение после короткой паузы. «Только один танец», — говорит она, хотя музыка явно рассчитывает на большее.'
    elseif $MelissaDanceTextAction = 'waist':
        $MelissaDanceLastText = 'Вы кладёте руки ей на талию. Мелисса вздрагивает, но продолжает шагать в такт — слишком стараясь выглядеть невозмутимой.'
    elseif $MelissaDanceTextAction = 'kiss':
        $MelissaDanceLastText = 'Поцелуй заставляет её замереть. На мгновение Мелисса забывает о строгих взглядах горожан.'
    elseif $MelissaDanceTextAction = 'neck':
        $MelissaDanceLastText = 'Поцелуй в шею заставляет Мелиссу сбиться с шага. Она шепчет, что здесь слишком много праздных зевак.'
    else:
        $MelissaDanceLastText = 'Танец продолжается под шум площади.'
    end

    killvar '$MelissaDanceTextAction'
---

#MelissaDanceAlleyIntroText
    *pl 'Мелисса останавливается у тёмного прохода и твёрдо качает головой.'
    *pl '— Не здесь, Стефан. Я… хочу, чтобы первый раз был дома. Без музыки, без чужих шагов за углом.'
    *pl 'Подворотня откроется позже — после первой домашней близости.'
---

#IrmaMelissaDanceDressBuyText
    $IrmaDressText = 'Ирма разворачивает ткань цвета ночного вина: «Для Мелиссы — чуть строже крой, чем для Аманды. Семьдесят спинтарий, три дня работы. Платье для пятничных танцев — не для зала трактира».'
---

#IrmaMelissaDanceDressBoughtText
    $IrmaDressText = 'Ирма записывает мерки и обещает платье к ближайшей пятнице. Мелисса будет готова танцевать на площади в полном наряде.'
---