! ================================================
! FILE: modules/events/melissa/melissa_home_chain.qsps
! MODULE: events/family
! [AI-WORKED] 18.09.2026: полная переработка и углубление характера Мелиссы
! Домашняя лестница Мелиссы (player-path):
! 0: Вечер за счетами и травяной чай
! 1: «Королева Элеонора» и первый поцелуй
! 2: Снятие доспехов: ласка у ночного окна
! 3: Анатомический интерес и ласка рукой
! 4: Власть Королевы: услада губ
! 5: Падение крепости: ласка лона
! 6: Решительный разговор перед первой ночью (дефлорация) -> SexScene -> утренняя реакция семьи
! ================================================

#MelissaHomeCanAdvance

    MelissaHomeCanAdvance = 0

    if MelissaHomeUnlocked = 0:
        exit
    end

    if MelissaHomeSex = 1:
        exit
    end

    if MelissaHomeStepToday = 1:
        exit
    end

    if time < 3:
        exit
    end

    if $GirlLocation['melissa'] <> 'MelissaRoom':
        exit
    end

    if MelissaHomeStage >= 6:
        exit
    end

    if Friends['melissa'] < 7 + MelissaHomeStage:
        if MelissaMinstrelFirstSexDone = 0:
            exit
        end
    end

    if GirlOffenseDays['melissa'] > 0:
        exit
    end

    MelissaHomeCanAdvance = 1
---

#MelissaHomeStep

    gs 'MelissaHomeCanAdvance'

    if MelissaHomeCanAdvance = 0:
        gt 'MelissaRoom'
    end

    if MelissaHomeStage = 0:
        $MelissaHomeStepKey = 'hug'
        $MelissaStepVisual = 'images/events/melissa/melissa_home_chain/melissa_home_step_0'
        $MelissaStepVisualCaption = 'Вечер за счетами и травяной чай'
        $MelissaStepHeader = 'ВЕЧЕР ЗА СЧЕТАМИ И ТРАВЯНОЙ ЧАЙ'
    elseif MelissaHomeStage = 1:
        $MelissaHomeStepKey = 'kiss'
        $MelissaStepVisual = 'images/events/melissa/melissa_home_chain/melissa_home_step_1'
        $MelissaStepVisualCaption = 'Чтение романа и первый поцелуй'
        $MelissaStepHeader = 'РЫЦАРСКИЙ РОМАН И ПЕРВЫЙ ПОЦЕЛУЙ'
    elseif MelissaHomeStage = 2:
        $MelissaHomeStepKey = 'petting'
        $MelissaStepVisual = 'images/events/melissa/melissa_home_chain/melissa_home_step_2'
        $MelissaStepVisualCaption = 'Снятие доспехов у ночного окна'
        $MelissaStepHeader = 'СНЯТИЕ ДОСПЕХОВ: У НОЧНОГО ОКНА'
    elseif MelissaHomeStage = 3:
        $MelissaHomeStepKey = 'handjob'
        $MelissaStepVisual = 'images/events/melissa/melissa_home_chain/melissa_home_step_3'
        $MelissaStepVisualCaption = 'Анатомический интерес и ласка рукой'
        $MelissaStepHeader = 'АНАТОМИЧЕСКИЙ ИНТЕРЕС И ЛАСКА РУКОЙ'
    elseif MelissaHomeStage = 4:
        $MelissaHomeStepKey = 'blowjob'
        $MelissaStepVisual = 'images/events/melissa/melissa_home_chain/melissa_home_step_4'
        $MelissaStepVisualCaption = 'Власть Королевы: услада губ'
        $MelissaStepHeader = 'ВЛАСТЬ КОРОЛЕВЫ: УСЛАДА ГУБ'
    elseif MelissaHomeStage = 5:
        $MelissaHomeStepKey = 'cuni'
        $MelissaStepVisual = 'images/events/melissa/melissa_home_chain/melissa_home_step_5'
        $MelissaStepVisualCaption = 'Падение крепости: ласка лона'
        $MelissaStepHeader = 'ПАДЕНИЕ КРЕПОСТИ: ЛАСКА ЛОНА'
    else:
        gt 'MelissaRoom'
    end

    *clr
    clr
    cla

    gs 'SceneShowVisual', $MelissaStepVisual, $MelissaStepVisualCaption, 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' ' + $MelissaStepHeader + ' — БЕСЕДА'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeStepText', $MelissaHomeStepKey, 'talk'

    *pl ' '

    gs 'ActUiPrepare', 'Продолжить', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaHomeStepAct'
    end
---

#MelissaHomeStepAct

    *clr
    clr
    cla

    gs 'SceneShowVisual', $MelissaStepVisual, $MelissaStepVisualCaption, 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' ' + $MelissaStepHeader + ' — СБЛИЖЕНИЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeStepText', $MelissaHomeStepKey, 'act'

    *pl ' '

    gs 'ActUiPrepare', 'Продолжить', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaHomeStepAfter'
    end
---

#MelissaHomeStepAfter

    *clr
    clr
    cla

    gs 'SceneShowVisual', $MelissaStepVisual, $MelissaStepVisualCaption, 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' ' + $MelissaStepHeader + ' — ПОСЛЕВКУСИЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeStepText', $MelissaHomeStepKey, 'after'

    *pl ' '

    MelissaHomeStage += 1
    MelissaHomeStepToday = 1
    MelissaPlayerPath += 1
    LastAttentionDay['melissa'] = day

    if $MelissaHomeStepKey = 'handjob' or $MelissaHomeStepKey = 'blowjob' or $MelissaHomeStepKey = 'cuni':
        LastSexDay['melissa'] = day
    end

    if $MelissaHomeStepKey = 'hug':
        Friends['melissa'] += 2
        love['melissa'] += 1
        otkroven['melissa'] += 1
    elseif $MelissaHomeStepKey = 'kiss':
        KissCount['melissa'] += 1
        love['melissa'] += 2
        otkroven['melissa'] += 2
    elseif $MelissaHomeStepKey = 'petting':
        CaressCount['melissa'] += 1
        love['melissa'] += 2
        otkroven['melissa'] += 2
    elseif $MelissaHomeStepKey = 'handjob':
        CaressCount['melissa'] += 1
        sluttiness['melissa'] += 1
        otkroven['melissa'] += 2
    elseif $MelissaHomeStepKey = 'blowjob':
        BlowjobCount['melissa'] += 1
        OralCount['melissa'] += 1
        sluttiness['melissa'] += 2
        love['melissa'] += 1
    elseif $MelissaHomeStepKey = 'cuni':
        CuniCount['melissa'] += 1
        OralCount['melissa'] += 1
        otkroven['melissa'] += 3
        love['melissa'] += 2
    end

    gs 'ClampGirlSocialStats', 'melissa'
    killvar '$MelissaHomeStepKey'
    killvar '$MelissaStepVisual'
    killvar '$MelissaStepVisualCaption'
    killvar '$MelissaStepHeader'

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaRoom'
    end
---

#MelissaHomeFirstSexLaunch

    if MelissaHomeUnlocked = 0 or MelissaHomeStage < 6:
        gt 'MelissaRoom'
    end

    if MelissaHomeSex = 1:
        gt 'MelissaRoom'
    end

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/melissa_home_chain/melissa_home_first_sex_launch', 'РЕШИТЕЛЬНЫЙ ВЫБОР МЕЛИССЫ', 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' РЕШИТЕЛЬНЫЙ РАЗГОВОР ПЕРЕД ПЕРВОЙ НОЧЬЮ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeStepText', 'presex'

    *pl ' '

    MelissaHomeFirstSexActive = 1
    MelissaHomeStepToday = 1

    if IntimStage['melissa'] < 5:
        IntimStage['melissa'] = 5
    end

    if otkroven['melissa'] < 20:
        otkroven['melissa'] = 20
    end

    gs 'ActUiPrepare', 'Сделать этот шаг вместе', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'SexSceneStart', 'melissa', 'MelissaHomeAfterSex', 'melissa_home_first'
    end

    gs 'ActUiPrepare', 'Не торопить события', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaRoom'
    end
---

#MelissaHomeAfterSex

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/melissa_home_chain/melissa_home_after_sex', 'МЕЛИССА ПОСЛЕ ПЕРВОЙ НОЧИ', 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' УТРО ПОСЛЕ ПЕРВОЙ НОЧИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeAfterSexText'

    *pl ' '

    MelissaHomeSex = 1
    if MelissaHomeNightCount < 1:
        MelissaHomeNightCount = 1
    end
    MelissaPlayerPath += 3
    love['melissa'] += 3
    otkroven['melissa'] += 3
    LastSexDay['melissa'] = day
    LastAttentionDay['melissa'] = day
    virginity['melissa'] = 0
    sexacts['melissa'] += 1
    vaginalacts['melissa'] += 1
    gs 'RegisterSex', 'melissa', 'vaginal', 1, 0

    ! Регистрация события для утренней реакции семьи
    gs 'FamilyFirstSexMorningMarkPending', 'melissa'

    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Остаться в комнате', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaRoom'
    end

    gs 'ActUiPrepare', 'Выйти в коридор', 'floor'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#MelissaDanceLeaveHome

    MelissaHomeUnlocked = 1
    MelissaDanceEnded = 1
    MelissaPlayerPath += 2
    LastAttentionDay['melissa'] = day
    LastSexDay['melissa'] = day

    if LOC('MelissaDanceLeaveHomeText') = 1:
        gs 'MelissaDanceLeaveHomeText'
    else:
        $MelissaDanceLastText = 'Вы уводите Мелиссу с площади в трактир.'
    end

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/melissa_home_chain/melissa_dance_leave_home', 'УХОД С ТАНЦЕВ', 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' УХОД С ТАНЦЕВ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *pl $MelissaDanceLastText
    *pl ' '

    $GirlLocation['melissa'] = 'MelissaRoom'

    gs 'ActUiPrepare', 'Пойти в комнату Мелиссы', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaRoom'
    end

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

#MelissaProhibitMinstrelTalk

    if MelissaMinstrelMet = 0:
        gt $TalkReturnLoc
    end

    if MelissaProhibitMinstrel = 1:
        *pl 'Вы уже запретили Мелиссе встречаться с менестрелем. Она помнит это — и обижается.'
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $TalkReturnLoc
        end
        exit
    end

    gs 'MelissaProhibitMinstrelTalkText'

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/melissa_home_chain/melissa_prohibit_minstrel_talk', 'РАЗГОВОР О МЕНЕСТРЕЛЕ', 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' РАЗГОВОР О МЕНЕСТРЕЛЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *pl $MelissaTalkText
    *pl ' '

    gs 'ActUiPrepare', 'Запретить встречи с ' + $MelissaMinstrelName, 'talk'
    act $ActUiLabel, $ActUiIconPath:
        MelissaProhibitMinstrel = 1
        if MelissaMinstrelFirstSexDone = 1:
            MelissaProhibitDays = 3
        else:
            MelissaProhibitDays = 7
        end

        if LOC('OffenseDaysBanImmediate') = 1:
            gs 'OffenseDaysBanImmediate', 'melissa', 'ban_minstrel'
        end

        MelissaControlNeed += 2
        MelissaJealousy += 1
        MelissaMusicianInterest -= 3

        if MelissaMusicianInterest < 0:
            MelissaMusicianInterest = 0
        end

        gs 'MelissaProhibitMinstrelDoneText'
        *pl $MelissaTalkText
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $TalkReturnLoc
        end
    end

    gs 'ActUiPrepare', 'Пока не запрещать', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $TalkReturnLoc
    end
---

#MelissaProhibitMinstrelTalkCanOffer

    MelissaProhibitMinstrelTalkCanOffer = 0

    if MelissaMinstrelMet = 0:
        exit
    end

    if MelissaProhibitMinstrel = 1:
        exit
    end

    if MelissaFirstPathChoiceDone = 0:
        exit
    end

    MelissaProhibitMinstrelTalkCanOffer = 1
---