    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaMinstrelWagonInterrupt', 3
    end
---

#MelissaMinstrelWagonScene3_2
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_blowjob', 'УРОК ДЫХАНИЯ', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' ПОВОЗКА МЕНЕСТРЕЛЯ — ОРАЛЬНАЯ ПРАКТИКА'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaMinstrelWagonText', 'scene3_2'
    *pl ' '

    MelissaMinstrelWagonStage = 3
    MelissaMinstrelWagonToday = 1
    MelissaMinstrelWagonLastDay = day
    MelissaMusicianInterest += 3
    MelissaNpcPath += 2
    sluttiness['melissa'] += 3
    otkroven['melissa'] += 2
    BlowjobCount['melissa'] += 1
    OralCount['melissa'] += 1
    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Отойти от повозки', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

! ================================================
! ВСТРЕЧА 4: КНИГА О МУЗЕ И ПЕРВЫЙ СЕКС
! ================================================

#MelissaMinstrelWagonScene4_1
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_book_talk', 'КНИГА О ЧУВСТВЕННОЙ МУЗЕ', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' ПОВОЗКА МЕНЕСТРЕЛЯ — СПОР О ВДОХНОВЕНИИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaMinstrelWagonText', 'scene4_1'
    *pl ' '

    gs 'ActUiPrepare', 'Затаить дыхание и смотреть', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaMinstrelWagonScene4_2'
    end

    gs 'ActUiPrepare', 'Резко распахнуть дверь повозки', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaMinstrelWagonInterrupt', 4
    end
---

#MelissaMinstrelWagonScene4_2
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_first_sex', 'СЛИЯНИЕ НА УЗКОЙ КРОВАТИ', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' ПОВОЗКА МЕНЕСТРЕЛЯ — ВДОХНОВЕНИЕ ПЛОТИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaMinstrelWagonText', 'scene4_2'
    *pl ' '

    MelissaMinstrelWagonStage = 4
    MelissaMinstrelWagonToday = 1
    MelissaMinstrelWagonLastDay = day
    MelissaMinstrelFirstSexDone = 1
    Fact_MelissaMinstrelFridayAlley = 1
    Fact_MelissaMinstrelBackroomSex = 1
    MelissaNpcPath += 3
    sluttiness['melissa'] += 4
    otkroven['melissa'] += 3

    if virginity['melissa'] = 1:
        virginity['melissa'] = 0
    end

    sexacts['melissa'] += 1
    vaginalacts['melissa'] += 1
    gs 'RegisterSex', 'melissa', 'vaginal', 0, 1

    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Тихо уйти в ночь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

! ================================================
! ВМЕШАТЕЛЬСТВО СТЕФАНА
! ================================================

#MelissaMinstrelWagonInterrupt
    *clr
    clr
    cla

    $WagonInterruptStage = $ARGS[0]

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_interrupt', 'ВМЕШАТЕЛЬСТВО СТЕФАНА', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' ПОВОЗКА МЕНЕСТРЕЛЯ — ВМЕШАТЕЛЬСТВО'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaMinstrelWagonText', 'interrupt', $WagonInterruptStage
    *pl ' '

    MelissaMinstrelWagonToday = 1
    MelissaTrustStefan += 1
    MelissaPlayerPath += 1

    if MelissaMusicianInterest > 0:
        MelissaMusicianInterest -= 1
    end

    gs 'ClampGirlSocialStats', 'melissa'
    killvar '$WagonInterruptStage'

    gs 'ActUiPrepare', 'Увести Мелиссу на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---
