    MelissaMinstrelFirstSexDone = 1
    Fact_MelissaMinstrelFridayAlley = 1
    Fact_MelissaMinstrelBackroomSex = 1
    MelissaNpcPath += 3
    sluttiness['melissa'] += 4
    otkroven['melissa'] += 3

    if virginity['melissa'] = 1:
        virginity['melissa'] = 0
    end

    sexacts['melissa'] += 1
    vaginalacts['melissa'] += 1
    gs 'RegisterSex', 'melissa', 'vaginal', 0, 1

    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Тихо уйти', 'return'
