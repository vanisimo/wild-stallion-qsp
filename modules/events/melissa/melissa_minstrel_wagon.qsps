#MelissaMinstrelDanceIgnoreDepart
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_stage_depart', 'ОНИ СКРЫЛИСЬ В ПОВОЗКЕ', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'ПЛОЩАДЬ: МЕЛИССА УШЛА'

    gs 'MelissaMinstrelWagonText', 'dance_stage_ignore_depart'
    *pl ' '

    MelissaMinstrelWagonStage += 1
    MelissaMinstrelWagonToday = 1
    MelissaMinstrelWagonLastDay = day
    MelissaMusicianInterest += 1
    MelissaNpcPath += 1
    if MelissaMinstrelWagonStage >= 4:
        MelissaMinstrelFirstSexDone = 1
        Fact_MelissaMinstrelFridayAlley = 1
        if virginity['melissa'] = 1:
            virginity['melissa'] = 0
        end
    end
    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
