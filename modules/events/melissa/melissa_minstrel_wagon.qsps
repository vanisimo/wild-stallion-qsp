! ================================================
! FILE: modules/events/melissa/melissa_minstrel_wagon.qsps
! MODULE: events/melissa
! [AI-WORKED] 19.09.2026
! Встречи Мелиссы и менестреля в повозке (4 встречи по 2 экрана)
! 1. Читает стихи -> падает лютня (срыв близости)
! 2. Игра на лютне -> ласки сзади, пальцы под юбку, оргазм Мелиссы
! 3. Игра на флейте -> урок дыхания (минет менестрелю)
! 4. Книга о музе -> первый секс / проверка стихов
! ================================================

#MelissaMinstrelWagonCanStart
    MelissaMinstrelWagonCanStart = 0

    if MelissaMinstrelMet = 0:
        exit
    end

    if MelissaMinstrelWagonToday = 1:
        exit
    end

    ! Доступно по пятницам вечером на танцах или во вторник днем/вечером
    if week = 5 and time = 4:
        ! OK
    elseif week = 2 and (time >= 2 and time <= 4):
        ! OK
    else:
        if MelissaMinstrelWeekdayAllow <> 1:
            exit
        end
    end

    if MelissaMinstrelWagonStage >= 4:
        exit
    end

    MelissaMinstrelWagonCanStart = 1
---

#MelissaMinstrelWagonTryStart
    gs 'MelissaMinstrelWagonCanStart'

    if MelissaMinstrelWagonCanStart = 1:
        gt 'MelissaMinstrelWagonLaunch'
    end
---

#MelissaMinstrelWagonLaunch
    killvar 'MelissaMinstrelWeekdayAllow'

    if MelissaMinstrelWagonStage = 0:
        gt 'MelissaMinstrelWagonScene1_1'
    elseif MelissaMinstrelWagonStage = 1:
        gt 'MelissaMinstrelWagonScene2_1'
    elseif MelissaMinstrelWagonStage = 2:
        gt 'MelissaMinstrelWagonScene3_1'
    elseif MelissaMinstrelWagonStage = 3:
        gt 'MelissaMinstrelWagonScene4_1'
    else:
        if week = 5 and time = 4:
            gt 'MarketDance'
        else:
            gt 'Market'
        end
    end
---

! ================================================
! ВСТРЕЧА 1: СТИХИ И УПАВШАЯ ЛЮТНЯ
! ================================================

#MelissaMinstrelWagonScene1_1
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_poems', 'ПОВОЗКА МЕНЕСТРЕЛЯ — ЧТЕНИЕ СТИХОВ', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'ПОВОЗКА МЕНЕСТРЕЛЯ — ПОЭТИЧЕСКИЙ СПОР'

    gs 'MelissaMinstrelWagonText', 'scene1_1'
    *pl ' '

    gs 'ActUiPrepare', 'Наблюдать дальше', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaMinstrelWagonScene1_2'
    end

    gs 'ActUiPrepare', 'Постучать и окликнуть', 'stop'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaMinstrelWagonInterrupt', 1
    end
---

#MelissaMinstrelWagonScene1_2
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_lute_fall', 'УПАВШАЯ ЛЮТНЯ', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'ПОВОЗКА МЕНЕСТРЕЛЯ — ЗВОН СТРУН'

    gs 'MelissaMinstrelWagonText', 'scene1_2'
    *pl ' '

    MelissaMinstrelWagonStage = 1
    MelissaMinstrelWagonToday = 1
    MelissaMinstrelWagonLastDay = day
    MelissaMusicianInterest += 2
    MelissaNpcPath += 1
    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Отойти от повозки', 'return'
    act $ActUiLabel, $ActUiIconPath:
        if week = 5 and time = 4:
            gt 'MarketDance'
        else:
            gt 'Market'
        end
    end
---

