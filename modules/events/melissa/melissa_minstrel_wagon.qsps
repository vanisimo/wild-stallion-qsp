! ================================================
! ВМЕШАТЕЛЬСТВО СТЕФАНА
! ================================================

#MelissaMinstrelWagonInterrupt
    *clr
    clr
    cla

    $WagonInterruptStage = $ARGS[0]

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_interrupt', 'ВМЕШАТЕЛЬСТВО СТЕФАНА', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'ПОВОЗКА МЕНЕСТРЕЛЯ — ВМЕШАТЕЛЬСТВО'

    gs 'MelissaMinstrelWagonText', 'interrupt', $WagonInterruptStage
    *pl ' '

    MelissaMinstrelWagonToday = 1
    MelissaTrustStefan += 1
    MelissaPlayerPath += 1

    if MelissaMusicianInterest > 0:
        MelissaMusicianInterest -= 1
    end

    gs 'ClampGirlSocialStats', 'melissa'
    killvar '$WagonInterruptStage'

    gs 'ActUiPrepare', 'Увести Мелиссу', 'return'
    act $ActUiLabel, $ActUiIconPath:
        if week = 5 and time = 4:
            gt 'MarketDance'
        else:
            gt 'Market'
        end
    end
---

! ================================================
! ПЯТНИЧНЫЕ ТАНЦЫ: НАБЛЮДЕНИЕ У ПОМОСТА МЕНЕСТРЕЛЯ
! ================================================

#MelissaMinstrelDanceStageLook
    *clr
    clr
    cla

    if MelissaMinstrelDanceTick = 0:
        gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_stage_listening', 'МЕЛИССА У ПОМОСТА МЕНЕСТРЕЛЯ', 'large', 'webp'
    elseif MelissaMinstrelDanceTick = 1:
        gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_stage_beside', 'МЕНЕСТРЕЛЬ РЯДОМ С МЕЛИССОЙ', 'large', 'webp'
    else:
        gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_stage_kiss_hand', 'МЕНЕСТРЕЛЬ ЦЕЛУЕТ РУЧКУ МЕЛИССЫ', 'large', 'webp'
    end

    gs 'ShowLocationScreenTitle', 'ПОМОСТ МЕНЕСТРЕЛЕЙ: МЕЛИССА И ЭЛРИК'

    gs 'MelissaMinstrelWagonText', 'dance_stage_tick' + STR(MelissaMinstrelDanceTick)
    *pl ' '

    gs 'ActUiPrepare', 'Наблюдать дальше', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gs 'FridayDanceAdvanceRound'
        _roundsLeft = 8 - FridayDancesCount

        if MelissaMinstrelDanceTick = 0:
            if _roundsLeft <= 0:
                gt 'MelissaMinstrelDanceDepart'
            else:
                MelissaMinstrelDanceTick = 1
                gt 'MelissaMinstrelDanceStageLook'
            end
        elseif MelissaMinstrelDanceTick = 1:
            if _roundsLeft <= 1 or RAND(1, 100) <= (8 - _roundsLeft) * 15:
                gt 'MelissaMinstrelDanceDepart'
            else:
                MelissaMinstrelDanceTick = 2
                gt 'MelissaMinstrelDanceStageLook'
            end
        else:
            gt 'MelissaMinstrelDanceDepart'
        end
    end

    gs 'ActUiPrepare', 'Вмешаться', 'stop'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaMinstrelDanceInterrupt'
    end

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

#MelissaMinstrelDanceDepart
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_stage_depart', 'МЕНЕСТРЕЛЬ И МЕЛИССА УХОДЯТ ПОД РУЧКУ', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'МЕНЕСТРЕЛЬ И МЕЛИССА УХОДЯТ С ТАНЦЕВ'
    *pl 'Они уходят с танцев вдвоём, взявшись под ручку...'
    *pl ' '

    gs 'MelissaMinstrelWagonText', 'dance_stage_depart'
    *pl ' '

    gs 'ActUiPrepare', 'Проследить', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaMinstrelWagonLaunch'
    end

    gs 'ActUiPrepare', 'Разогнать', 'stop'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaMinstrelDanceInterruptDepart'
    end

    gs 'ActUiPrepare', 'Уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaMinstrelDanceIgnoreDepart'
    end
---

#MelissaMinstrelDanceInterrupt
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_stage_interrupt', 'ВМЕШАТЕЛЬСТВО СТЕФАНА', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'ВМЕШАТЕЛЬСТВО: ПОМОСТ МЕНЕСТРЕЛЕЙ'

    gs 'MelissaMinstrelWagonText', 'dance_stage_interrupt'
    *pl ' '

    MelissaMinstrelWagonToday = 1
    MelissaMinstrelDanceTick = 0
    MelissaTrustStefan += 1
    MelissaPlayerPath += 1
    gs 'ClampGirlSocialStats', 'melissa'
    gs 'FridayDanceAdvanceRound'

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

