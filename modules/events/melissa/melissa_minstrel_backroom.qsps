! ================================================
! FILE: modules/events/melissa/melissa_minstrel_backroom.qsps
! MODULE: events/family
! [AI-WORKED] 02.11.2026: Сцена в спальне Мелиссы на 2-м этаже (3 уровня коррупции, гейты)
! ================================================

#MelissaMinstrelBackroomCanStart

    MelissaMinstrelBackroomCanStart = 0

    ! Не чаще 1 раза в день
    if MelissaMinstrelBackroomDone = 1 and MelissaMinstrelBackroomLastDay = day:
        exit
    end

    ! ДЕФЛОРАЦИЯ СТРОГО В ПОВОЗКЕ: до первого секса в повозке сцена в спальне недоступна
    if MelissaMinstrelFirstSexDone = 0 and MelissaMinstrelWagonStage < 4:
        exit
    end

    if TavernUpgradeStageDone = 0:
        exit
    end

    if MelissaMinstrelKissDone = 0:
        exit
    end

    if MelissaMusicStageOfferDone = 0:
        exit
    end

    ! Вечер четверга во время работы таверны
    if week <> 4:
        exit
    end

    if time <> 4:
        exit
    end

    if MelissaProhibitMinstrel = 1:
        if GirlOffenseDays['melissa'] = 0 and (day - LastAttentionDay['melissa'] < 7):
            exit
        end
    end

    MelissaMinstrelBackroomCanStart = 1
---

#MelissaMinstrelBackroomTryStart

    if LOC('MelissaMinstrelBackroomCanStart') = 1:
        gs 'MelissaMinstrelBackroomCanStart'

        if MelissaMinstrelBackroomCanStart = 1:
            gt 'MelissaMinstrelBackroomStart', $ARGS[0]
        end
    end
---

#MelissaMinstrelBackroomStart

    *clr
    clr
    cla

    $MelissaBackroomReturnLoc = $ARGS[0]
    if $MelissaBackroomReturnLoc = '':
        $MelissaBackroomReturnLoc = 'TavernMain'
    end

    MelissaMinstrelBackroomDone = 1
    MelissaMinstrelBackroomLastDay = day

    gs 'EnsureGirlData', 'melissa'

    ! Определение уровня коррупции для сцены
    if FamilyCorruptionStage >= 4:
        MelissaBedroomTier = 3
    elseif FamilyCorruptionStage >= 2:
        MelissaBedroomTier = 2
    else:
        MelissaBedroomTier = 1
    end

    gs 'SceneShowVisual', 'images/events/melissa/melissa_home_chain/melissa_home_step_0', 'СПАЛЬНЯ МЕЛИССЫ: ТАЙНЫЙ ГОСТЬ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ВТОРОЙ ЭТАЖ: СПАЛЬНЯ МЕЛИССЫ'

    gs 'MelissaMinstrelBackroomText', 'intro'
    *pl ' '

    gs 'MelissaMinstrelBackroomBuildMenu'

    *p 'Что вы будете <a href="exec:gs ''Menu.Show'', ''MelissaBackroomMenu''">делать</a>?'
---

#MelissaMinstrelBackroomBuildMenu

    gs 'Menu.Destroy', 'MelissaBackroomMenu'
    gs 'Menu.Create', 'MelissaBackroomMenu'

    gs 'MenuUiAdd', 'MelissaBackroomMenu', 'Ворваться', 'stop'
    gs 'Menu.AddModule', 'MelissaBackroomMenu', {
        gt 'MelissaMinstrelBackroomAction', 'interrupt', $MelissaBackroomReturnLoc
    }

    gs 'MenuUiAdd', 'MelissaBackroomMenu', 'Подглядывать', 'look'
    gs 'Menu.AddModule', 'MelissaBackroomMenu', {
        gt 'MelissaMinstrelBackroomAction', 'spy', $MelissaBackroomReturnLoc
    }

    gs 'MenuUiAdd', 'MelissaBackroomMenu', 'Отойти', 'return'
    gs 'Menu.AddModule', 'MelissaBackroomMenu', {
        gt 'MelissaMinstrelBackroomAction', 'leave', $MelissaBackroomReturnLoc
    }
---

#MelissaMinstrelBackroomAction

    *clr
    clr
    cla

    $MelissaBackroomChoice = LCASE($ARGS[0])
    $MelissaBackroomReturnLoc = $ARGS[1]
    if $MelissaBackroomReturnLoc = '':
        $MelissaBackroomReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', 'melissa'

    if $MelissaBackroomChoice = 'interrupt':
        gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_stage_interrupt', 'ВМЕШАТЕЛЬСТВО СТЕФАНА', 'large', 'webp'
        gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: ВМЕШАТЕЛЬСТВО'
        gs 'MelissaMinstrelBackroomText', 'interrupt'
        *pl ' '

        if MelissaBedroomTier = 1:
            MelissaTrustStefan += 1
            Friends['melissa'] += 1
            MelissaPlayerPath += 2
            MelissaMusicianInterest -= 1
            if MelissaMusicianInterest < 0:
                MelissaMusicianInterest = 0
            end

            gs 'ActUiPrepare', 'Вернуться в зал', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt $MelissaBackroomReturnLoc
            end

        elseif MelissaBedroomTier = 2:
            MelissaPlayerPath += 1
            MelissaMusicianInterest -= 1
            GirlOffenseDays['melissa'] += 1
            if MelissaMusicianInterest < 0:
                MelissaMusicianInterest = 0
            end

            gs 'ActUiPrepare', 'Вернуться в зал', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt $MelissaBackroomReturnLoc
            end

        else:
            ! Высокая коррупция: выбор Стефана — выкинуть менестреля или уйти
            gs 'ActUiPrepare', 'Выставить Элрика вон', 'stop'
            act $ActUiLabel, $ActUiIconPath:
                gt 'MelissaMinstrelBackroomInterruptKick', $MelissaBackroomReturnLoc
            end

            gs 'ActUiPrepare', 'Уйти и не мешать', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt 'MelissaMinstrelBackroomInterruptLeave', $MelissaBackroomReturnLoc
            end
        end

    elseif $MelissaBackroomChoice = 'spy':
        MelissaWatchMinstrel = 1
        MelissaNpcPath += 2
        GirlNpcPath['melissa'] += 2
        MelissaMusicianInterest += 2
        MelissaSecretiveness += 1
        TavernScandal += 1

        ! Переход к экрану 2 (процесс близости)
        gt 'MelissaMinstrelBedroomStep2', $MelissaBackroomReturnLoc

    elseif $MelissaBackroomChoice = 'leave':
        MelissaNpcPath += 1
        GirlNpcPath['melissa'] += 1
        MelissaMusicianInterest += 1

        gs 'SceneShowVisual', 'images/events/melissa/melissa_home_chain/melissa_home_step_0', 'ТИШИНА В КОРИДОРЕ', 'large', 'webp'
        gs 'ShowLocationScreenTitle', 'КОРИДОР ВТОРОГО ЭТАЖА'
        gs 'MelissaMinstrelBackroomText', 'leave'
        *pl ' '

        gs 'ActUiPrepare', 'Вернуться в зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $MelissaBackroomReturnLoc
        end
    end

    gs 'ClampGirlSocialStats', 'melissa'
---

#MelissaMinstrelBedroomStep2
    *clr
    clr
    cla

    $MelissaBackroomReturnLoc = $ARGS[0]

    ! Проверка доступности анала по гейтам
    MelissaBedroomAnalAllowed = 0
    if MelissaHomeAnalDone = 1 or analfromyou['melissa'] >= 1 or MelissaMinstrelAnalDone = 1:
        MelissaBedroomAnalAllowed = 1
    end

    ! Определение позы и действия в зависимости от ступени коррупции
    if MelissaBedroomTier = 1:
        ! Низкая коррупция: у шкафа (стоя раком)
        MelissaBedroomAct = 'closet_stand'
        gs 'SceneShowVisual', 'images/events/melissa/melissa_home_chain/melissa_home_step_1', 'У ШКАФА СРЕДИ САЛФЕТОК', 'large', 'webp'
        gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: У ДУБОВОГО ШКАФА'
        gs 'MelissaMinstrelBackroomText', 'act_tier1'

    elseif MelissaBedroomTier = 2:
        ! Средняя коррупция: сидит на кровати, минет -> вагинал в миссионерской (или анал при гейте)
        if MelissaBedroomAnalAllowed = 1 and RAND(1, 3) = 1:
            MelissaBedroomAct = 'bed_anal_missionary'
            gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_loop_anal', 'НА КРОВАТИ: ЗАПРЕТНЫЙ ПУТЬ', 'large', 'webp'
            gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: СТРАСТЬ НА КРОВАТИ'
            gs 'MelissaMinstrelBackroomText', 'act_tier2_anal'
        else:
            MelissaBedroomAct = 'bed_missionary'
            gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_first_sex', 'НА КРОВАТИ: МИССИОНЕРСКАЯ ПОЗА', 'large', 'webp'
            gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: ЛАСКИ НА КРОВАТИ'
            gs 'MelissaMinstrelBackroomText', 'act_tier2_vaginal'
        end

    else:
        ! Высокая коррупция: сидит на кровати, рука под юбкой -> расширенный пул
        MelissaTier3Roll = RAND(1, 3)
        if MelissaBedroomAnalAllowed = 1 and MelissaTier3Roll = 1:
            MelissaBedroomAct = 'bed_cowgirl_reverse_anal'
            gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_loop_anal', 'ОБРАТНАЯ НАЕЗДНИЦА В АНАЛ', 'large', 'webp'
            gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: БЕССТЫДНЫЙ АНАЛ'
            gs 'MelissaMinstrelBackroomText', 'act_tier3_anal'
        elseif MelissaTier3Roll = 2:
            MelissaBedroomAct = 'bed_doggy_vaginal'
            gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_loop_prelude', 'РАКОМ НА КРОВАТИ', 'large', 'webp'
            gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: СТРАСТЬ РАКОМ'
            gs 'MelissaMinstrelBackroomText', 'act_tier3_doggy'
        else:
            MelissaBedroomAct = 'bed_deep_oral_missionary'
            gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_first_sex', 'ПОЛНАЯ ПОКОРНОСТЬ МУЗЫ', 'large', 'webp'
            gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: НЕИСТОВОЕ СЛИЯНИЕ'
            gs 'MelissaMinstrelBackroomText', 'act_tier3_full'
        end
        killvar 'MelissaTier3Roll'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Смотреть финал', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaMinstrelBedroomStep3', $MelissaBackroomReturnLoc
    end
---

#MelissaMinstrelBedroomStep3
    *clr
    clr
    cla

    $MelissaBackroomReturnLoc = $ARGS[0]

    gs 'SceneShowVisual', 'images/events/melissa/melissa_home_chain/melissa_home_step_2', 'ФИНАЛ В СПАЛЬНЕ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: РАЗВЯЗКА'

    gs 'MelissaMinstrelBackroomText', 'finish'
    *pl ' '

    MelissaNpcPath += 1
    sluttiness['melissa'] += 2
    otkroven['melissa'] += 1
    sexacts['melissa'] += 1

    if MelissaBedroomAct = 'bed_anal_missionary' or MelissaBedroomAct = 'bed_cowgirl_reverse_anal':
        analacts['melissa'] += 1
        MelissaMinstrelAnalDone = 1
    else:
        vaginalacts['melissa'] += 1
    end

    gs 'ClampGirlSocialStats', 'melissa'

    killvar 'MelissaBedroomTier'
    killvar 'MelissaBedroomAct'
    killvar 'MelissaBedroomAnalAllowed'

    gs 'ActUiPrepare', 'Вернуться в зал таверны', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $MelissaBackroomReturnLoc
    end
---

#MelissaMinstrelThreesomeCanOffer
    MelissaMinstrelThreesomeCanOffer = 0
    if MelissaMinstrelThreesomeEventUnlocked = 0:
        exit
    end
    if MelissaMinstrelThreesomeDone = 1:
        exit
    end
    if MelissaMinstrelThreesomeReady = 0:
        exit
    end
    if FamilyCorruptionStage < 3:
        exit
    end
    if MelissaHomeSex = 0:
        exit
    end
    if TavernUpgradeStageDone = 0:
        exit
    end
    if MelissaMinstrelFirstSexDone = 0:
        exit
    end
    MelissaMinstrelThreesomeCanOffer = 1
---

#MelissaMinstrelThreesomeStart
    gt 'GroupSexMelissaMinstrelStefanStart'
---

#MelissaMinstrelBackroomDebugReset
    MelissaMinstrelBackroomDone = 0
    MelissaMinstrelBackroomResult = 0
    MelissaMinstrelBackroomLastDay = 0
---

#MelissaMinstrelBackroomInterruptKick
    *clr
    clr
    cla

    $MelissaBackroomReturnLoc = $ARGS[0]

    MelissaPlayerPath += 1
    MelissaMustVisitTonight = 1
    GirlOffenseDays['melissa'] += 1

    gs 'SceneShowVisual', 'images/events/melissa/melissa_home_chain/melissa_home_step_0', 'МЕЛИССА ОСТАЛАСЬ ОДНА', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: ТРЕБОВАНИЕ МЕЛИССЫ'
    gs 'MelissaMinstrelBackroomText', 'interrupt_tier3_kicked'
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $MelissaBackroomReturnLoc
    end
---

#MelissaMinstrelBackroomInterruptLeave
    *clr
    clr
    cla

    $MelissaBackroomReturnLoc = $ARGS[0]

    MelissaNpcPath += 2
    GirlNpcPath['melissa'] += 2
    MelissaMusicianInterest += 2
    sluttiness['melissa'] += 2
    sexacts['melissa'] += 1
    vaginalacts['melissa'] += 1

    gs 'SceneShowVisual', 'images/events/melissa/minstrel_wagon/melissa_wagon_first_sex', 'ИНТИМ ПРОДОЛЖАЕТСЯ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: СТРАСТЬ ПРОДОЛЖАЕТСЯ'
    gs 'MelissaMinstrelBackroomText', 'interrupt_tier3_continued'
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $MelissaBackroomReturnLoc
    end
---
