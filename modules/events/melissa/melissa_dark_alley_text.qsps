#MelissaDanceAlleyStage5Text
    $MelissaFormat = LCASE($ARGS[0])

    if $MelissaFormat = 'blowjob':
        if FamilyCorruptionStage <= 1:
            *pl 'Проведя рукой по спине Мелиссы, ты надавил на её плечо.'
            *pl 'Мелисса с нерешительностью опускается на колени, придерживая руками края праздничного платья.'
            *pl 'В полумраке между стенами её лицо бледнеет, а в глазах плещется страх быть замеченной, но руки сами развярывают штаны и выпускают наружу член.'
            *pl 'Она на мгновение замирает: «Ты этого хочешь?» — спрашивает она, и тут же касается губами налитой головки.'
            *pl 'Её ротик обхватывает ствол, а голова начинает ритмично двигатся. Мелисса сосёт стараясь побыстрее закончить, и чем глубже она сосёт тем сильней возбуждается. Неожиданно она лостает член из рта и языком быстро лижет гловку, отчего ты теряешь остатки контроля и издаешь громкий стон.'
        else:
            *pl 'Мелисса с дерзкой, улыбкой опускается на колени прямо на мостовую.'
            *pl 'В её взгляде блеск и азарт возбуждения. Ловкими пальцами она расправляется с твоим поясом, высвобождает налитый ствол и на мгновение прижимается к нему горячей щекой, дразняще вдыхая запах твоего возбуждения.'
            *pl 'Широко открыв рот, она одним жадным движением заглатывает головку. Мелисса усердно и страстно работает языком и губами, двигая головой во все ускоряющемся темпе время от времени доставая член и облизывая его, и яйца поочередно, засасывая их в свой ученный ротик.'
            *pl 'Продолжая сосать, Мелисса приподнимается на колени, чтобы лучше обхватить твой член, и начинает ласкать твои яйца языком и руками, доводя тебя до самого края.'
        end

    elseif $MelissaFormat = 'vaginal':
        if FamilyCorruptionStage <= 1:
            *pl 'Ты поднимаешь юбки Мелиссы до пояса и прижимаешь её спиной к шершавой каменной кладке дома.'
            *pl 'Она вцепляется пальцами в воротник твоего камзола, пряча пылающее от стыда лицо у тебя на плече. Одной рукой ты приподнимаешь её стройное бедро, направляя член к её горячему, влажному лону.'
            *pl 'Плавный толчок вперёд — и сдавленный, прерывистый стон Мелиссы. Она крепко сжимает бёдра вокруг тебя, со страхом прислушиваясь к музыке за углом, но её тело само подаётся навстречу каждому твоему толчку, впившись руками в ее попку, ты нанизываешь ее лоно, на свой член, наполняя пространство влажными хлюпами и стонами Мелиссы.'
            *pl 'В очередной раз сжав ее попку, ты особено сильно вдавливаешь ее в себя.'
            *pl 'Она в ответ издаёт протяжный стон: «Ох Ильматер, да прямо туда, ты там что-то достал!» — и сестра, задрожав, замерла, наслаждаясь оргазмом.'
        else:
            *pl 'Отойдя от тебя на шаг сестричка меденно поднимает поддол платья, обножая бёдра и раскрасневшуюся пизденку.'
            *pl '- Нравится, я знала что ты меня утащишь с площади, и специально для тебя я не одела трусики'
            *pl 'Она забрасывает ногу тебе на бедро и притягивает тебя к себе за затылок, жадно впиваясь в твои губы возбуждённым поцелуем. Прижав тебя к себе и надевается на твой член, всасывая раскалённую глубину её киски.'
            *pl 'Мелисса стонет в голос, не сдерживая похотливых вздохов и хлюпов текущей щели, пронзаемой членом, которые отражаются от стен. Она раскачивает бёдрами в такт твоим грубым, напористым толчкам, впиваясь ногтями в твои плечи, забывая обо всём.'
            *pl '«Ещё, ещё! — стонет она, — Не останавливайся, дай мне почувствовать тебя поглубже, достань до самого нутра!»'
            *pl 'Ты привычно сжав ее попку, нанизываешь ее особенно глубоко, достав точку от которой у Мелиссы, подкашиваются ноги и она повиснув на тебе начинает биться в оргазменных судорогах.'   
        end

    elseif $MelissaFormat = 'anal':
        if FamilyCorruptionStage <= 1:
            *pl 'Ты разворачиваешь Мелиссу лицом к стене и заставляешь её опереться ладонями о шершавую кладку переулка.'
            *pl 'Лишившись возможности видеть тебя и происходящее, она замирает ожидая твоих действий. Задирав её юбки и оголв попку сестры, ты раздвигаешь тугие половинки её ягодиц, Мелисса тихо говорит: «Ты хочешь в попку? Ильматер Стефан это неправильно, но так волнительно» — пытается сохронить хоть каплю благорозумия, говорит сестра.'
            *pl 'Она немного приподнимается на носочки и наклоняется вперёд, отпустившись на колени ты ты облизываешь ее анус, потом засовываешь язык глубже, смачивая своей слюной.'
            *pl '— Стефан, откуда ты такой развратный? — спрашивает она, краснея.'
            *pl 'Поднявшись на ноги, ты упираешься головкой в колечко ее ануса и медленно, с усилием проталкиваешься внутрь. Мелисса прикусывает губу, чтобы не закричать, и упираясь руками в стену, начинает стонать от переполняющего чувства.'
            *pl 'Взявшись за ее бедра, ты неспешно двигаешься в попке девушки, стараясь доставить ей наслаждение. Мелисса негромко стонет и выгибает спину, вбирая твой член поглубже.'
            *pl 'Её дыхание становится всё более частым и неровным. Каждый толчок вызывает у Мелиссы новую волну наслаждения, от которой её тело мелко дрожит. Не выдержав сладкой пытки твоих неспешных движений, она срывается за грань оргазма.'
        else:
            *pl 'Ты прижимаешь Мелиссу грудью к камням стены, а она сама с дразнящим смешком выгибает поясницу, отставляя назад округлые, соблазнительные ягодицы.'
            *pl 'Мелисса смотрит на тебя и улыбается: «Вижу братик хочет мою любимую дырочку» - от этих слов и ее развратного тона, по твоему телу пробегает стадо мурашек, а член встаёт колом.'
            *pl 'Она оборачивается через плечо, сверкая озорными, возбуждёнными глазами, но ты неспешно подходишь к ее лицу, и без слов подставляешь член к ее ротику: «Кончено смазака как я могла забыть» - говорит она, и вбирает ваш член.'
            *pl 'Выдернув член изо рта, и вернувшись к ее попке, ты неспешно вдавливаешь смазанный ствол в анус сестры.'
            *pl 'Мелисса издаёт сладострастный стон,  когда плоть туго растягивает её колечко. Она ничуть не противится — напротив, сама охотно подаётся задом навстречу каждому толчку, с порочным упоением отдаваясь своей страсти прямо на мостовой.'
            *pl 'Её дыхание становится всё более частым и неровным. Каждый толчок вызывает у Мелиссы новую волну наслаждения, от которой её тело мелко дрожит. Не выдержав сладкой пытки твоих движений, она срывается за грань оргазма.'
        end
    end

    killvar '$MelissaFormat'
---

#MelissaDanceAlleyAftermathText
    $MelissaFormat = LCASE($ARGS[0])
    $MelissaFinish = LCASE($ARGS[1])

    if $MelissaFinish = 'outside':
      if $MelissaFormat = 'vaginal':
        *pl 'Огразм сестры, ее киска сжимающая твой член, все сильнее и сильнее, подталкивая к оргазму. Ты рывком вынимаешь член из её киски и изливая обильные струи горячей спермы на ее животик и лобок, покрыв белыми капельками ее девичью красоту.'
      elseif $MelissaFormat = 'mouth':
        *pl 'Eщё один мощный толчок - и тебя сшибает волна оргазма, выдернеув член из её рта, ты выпускаешь струю заструей, но благоразумная Мелисса, успевает накрыть твою блестящую от слюны головку, ладошкой и все заряды остаются у нее на пальцах.'
      else:
        *pl 'Оргазменные спазмы ануса сестры толкают и тебя в оргазм. Ты вытаскиваешь член из ее ануса. И залпами разукрашиваешь попку Мелиссы, густые капли спермы стекают по её бедрам.'
      end   
    elseif $MelissaFinish = 'inside':
        if $MelissaFormat = 'vaginal':
            *pl 'Не выдержав накала наслаждения, ты вонзаешься в неё до самого основания и мощными толчками извергаешься глубоко внутрь её горячей киски. Мелисса судорожно вздрагивает, сжимаясь вокруг твоего члена в сладких конвульсиях.'
        else:
            *pl 'Оргазменные спазмы ануса сестры толкают и тебя в оргазм. Ты засаживаешь до упора в её узкий зад и пульсирующими толчками заливаешь семенем её нутро. Мелисса глухо стонет, сотрясаясь от второй волны оргазма.'
        end
    elseif $MelissaFinish = 'mouth':
        *pl 'Ты прижимаешь ее голову к своему члену и разряжаешься прямо в её умненький ротик. Мелисса жадно принимает порцию за порцией, зажмурившись и сглатывая тяжёлую сперму.'
    elseif $MelissaFinish = 'face':
        *pl '- Давай сюда свою мордашку, сестричка! - стонешь ты, выдернув член из Мелиссы, и дождавшись пока она подставит личико, выплёвываешь струю за струёй. Блеклые струйки спермы ложаться на её щёки, припухшие губы, Она поворачивает голову подставляя то одну стонрону лица то другую, мурлыкая под нос от удовольствия.'
    end

    *pl ' '

    if FamilyCorruptionStage <= 1:
        *pl 'Мелисса судорожно переводит дыхание, её лицо пылает стыдом и смятением, торопливо оправляет корсаж и подол платья, доставая платок, чтобы стереть следы вашей тайной страсти.'
        *pl 'Она оглядывается по сторонам, смущаясь посмотреть тебе в глаза: "-Это было немного безумно... но похоже что мне понравилось."'
        *pl '— Ох, Стефан... мы не должны быть столь безрассудны, - взволнованным шепотом говорит она, . — Пошли быстрее, сделаем вид что ты меня провожаешь до дома.'

    elseif FamilyCorruptionStage = 2:
        *pl 'Мелисса несколько мгновений стоит неподвижно, уперевшись лбом в твоё плечо и постепенно восстанавливая сбитое дыхание.'
        *pl 'Затем она отстраняется и с лукавой усмешкой на припухших губах поправляет платье.'
        *pl '— Ну что ж, господин трактирщик... Должна заметить, городские летописи эту часть празника описывают не в полной мере, — говорит она поправляя выбившуюся прядь волос.'

    else:
        *pl 'Мелисса ничуть не смущается содеянного. Она неторопливо и уверенно приводит себя в порядок, не скрывая дерзкого блеска в глазах и откровенно любуясь произведённым эффектом.'
        if $MelissaFinish = 'face' or $MelissaFinish = 'mouth':
            *pl 'Она спокойно слизывает остатки семени с губ:'
            *pl '— Вкусненько, - говорит она проглотив остаток, - похоже на танцы я хожу тоько ради того чтобы меня утащили в тёмный переулок.'
        elseif $MelissaFinish = 'anal':
            *pl 'Без ложной скромности задрав подол и демонстрируя вам свою голую жопку,она вытирает что осталось снаружи:'
            *pl '- Ммм, два раза кончила, сначала только от попки, ты был молодцом!'
        elseif $MelissaFinish = 'vaginal':
            *pl 'Без ложной скромности задрав подол и демонстрируя вам свою голую раскрытую щель из которой сочится семя, она стирает потеки:'
            *pl '- Ммм, хорошо то как, мненравится как мы танцуем! - засмеялась сестра' 
        else:
            *pl 'Стерев все следы произошедшего, она благодарно засосала в рот все еще стоявший член, очищая его от остатков спермы, а затем поцеловав его на последок, засунула обратоно в штаны и сказала: "Ммм, чистота во славу Ильматера, братец!"' 
        end
    end

    killvar '$MelissaFormat'
    killvar '$MelissaFinish'
---

#MelissaDanceAlleyEndText
    if MelissaAlleyAfterSex = 1:
