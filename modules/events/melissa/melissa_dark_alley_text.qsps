#MelissaDanceAlleyStage4Text
    _composure = ARGS[0]

    *pl 'Хмельные шаги и гогот за углом постепенно затихают — подгулявшая компания свернула в сторону трактиров на набережной.'
    *pl 'Опасность миновала, но напряжение между вами достигло предела.'

    if _composure <= 0:
        *pl 'От прежней рассудительной Мелиссы не осталось и следа. Её дыхание стало частым и прерывистым, взгляд затуманился слепой похотью.'
        *pl 'Она сама тянется к твоей шее, лихорадочно шепча, что ей уже всё равно, увидит ли их кто-то, лишь бы ты не останавливался.'
    elseif _composure = 1:
        *pl 'Мелисса густо краснеет, покусывая губы и пытаясь совладать с собственным телом, но предательская дрожь в пальцах выдаёт её с головой.'
        *pl 'Она понимает, к чему всё идёт, и её сопротивление окончательно сломлено желанием.'
    else:
        *pl 'Она всё ещё делает слабую попытку сохранить лицо, сдавленно иронизируя над ситуацией, однако её разгорячённое тело прижато к тебе так тесно, что слова теряют всякий смысл.'
    end

    killvar '_composure'
---

#MelissaDanceAlleyStage5Text
    $MelissaFormat = LCASE($ARGS[0])

    if $MelissaFormat = 'blowjob':
        if FamilyCorruptionStage <= 1:
            *pl 'Мелисса с видимой нерешительностью опускается на колени на холодные камни подворотни, бережно придерживая руками края праздничного платья, чтобы не испачкать подол.'
            *pl 'В полумраке между стенами её лицо бледнеет, а в глазах плещется панический страх быть замеченной. Дрожащими пальцами она неловко расстёгивает твои штаны и выпускает наружу горячий, пульсирующий член.'
            *pl 'Она на мгновение замирает, стыдливо покусывая нижнюю губу, а затем робко касается губами налитой головки. Её ротик осторожно и трепетно обхватывает ствол. Мелисса сосёт медленно, стараясь не шуметь, поминутно вздрагивая от каждого далёкого звука ярмарки и поглядывая на тебя снизу вверх полными растерянной покорности глазами.'
        else:
            *pl 'Мелисса с дерзкой, лукавой полуулыбкой опускается на колени прямо на каменную мостовую, даже не заботясь о пыли на дорогой ткани платья.'
            *pl 'В её взгляде нет ни капли стыда — лишь порочный блеск и жадный азарт. Ловкими, уверенными пальцами она расправляется с твоим поясом, высвобождает налитый ствол и на мгновение прижимается к нему горячей щекой, дразняще вдыхая мускусный запах твоего возбуждения.'
            *pl 'Широко открыв влажный рот, она одним жадным движением заглатывает головку до самого основания, упираясь ладонями в твои бедра. Мелисса усердно и страстно работает языком и губами, двигая головой во все ускоряющемся темпе и откровенно упиваясь опасностью происходящего прямо под носом у толпы за углом.'
        end

    elseif $MelissaFormat = 'vaginal':
        if FamilyCorruptionStage <= 1:
            *pl 'Ты поднимаешь юбки Мелиссы до пояса, сдвигая тонкую ткань белья, и прижимаешь её спиной к шершавой каменной кладке дома.'
            *pl 'Она испуганно затаивает дыхание и судорожно вцепляется пальцами в воротник твоего камзола, пряча пылающее от стыда лицо у тебя на плече. Одной рукой ты приподнимаешь её стройное бедро, направляя член к её горячему, влажному лону.'
            *pl 'Плавный толчок вперёд — и сдавленный, прерывистый стон Мелиссы гаснет у твоей шеи. Она крепко сжимает бёдра вокруг тебя, со страхом прислушиваясь к музыке за углом, но её тело само подаётся навстречу каждому твоему осторожному, глубокому толчку, плавясь от запретной близости.'
        else:
            *pl 'Ты решительно задираешь подолы её праздничного платья, а Мелисса сама с горячим нетерпением сдёргивает бельё, распахивая объятия у холодной каменной стены.'
            *pl 'Она смело забрасывает ногу тебе на бедро и притягивает тебя к себе за затылок, жадно впиваясь в твои губы требовательным поцелуем. Твой ствол одним мощным выпадом входит во влажную, раскалённую глубину её киски.'
            *pl 'Мелисса стонет в голос, не сдерживая похотливых вздохов, которые эхом отражаются от стен узкого прохода. Она бешено раскачивает бёдрами в такт твоим грубым, напористым толчкам, впиваясь ногтями в твои плечи и упиваясь полным падением всех семейных запретов.'
        end

    elseif $MelissaFormat = 'anal':
        if FamilyCorruptionStage <= 1:
            *pl 'Ты разворачиваешь Мелиссу лицом к стене и заставляешь её опереться ладонями о шершавую кладку переулка.'
            *pl 'Лишившись возможности видеть тебя и происходящее, она заметно паникует. Когда ты задираешь её юбки и пальцами раздвигаешь тугие половинки её ягодиц, Мелисса тихо просит пощады, боясь нестерпимого стыда и резкой боли на грязной улице.'
            *pl 'Головка упирается в её сжатое колечко ее ануса и медленно, с усилием проталкивается внутрь. Мелисса прикусывает губу, чтобы не закричать, и судорожно цепляется за трещины в камне, содрогаясь всем телом от непривычного, переполняющего чувства полной беспомощности и покорности.'
        else:
            *pl 'Ты прижимаешь Мелиссу грудью к камням стены, а она сама с дразнящим смешком выгибает поясницу, отставляя назад округлые, соблазнительные ягодицы.'
            *pl 'Она оборачивается через плечо, сверкая озорными, возбуждёнными глазами, в которых читается неприкрытый вызов. Без долгих предисловий ты настойчиво вдавливаешь смазанный ствол в её тесную, горячую попку.'
            *pl 'Мелисса издаёт глубокий, сладострастный стон, вжимаясь пальцами в стену, когда плоть туго растягивает её колечко. Она ничуть не противится — напротив, сама охотно подаётся задом навстречу каждому сокрушительному толчку, с порочным упоением отдаваясь противоестественной страсти прямо на мостовой ярмарочного квартала.'
        end
    end

    killvar '$MelissaFormat'
---

#MelissaDanceAlleyAftermathText
    $MelissaFormat = LCASE($ARGS[0])
    $MelissaFinish = LCASE($ARGS[1])

    if $MelissaFinish = 'outside':
        *pl 'Чувствуя приближение оргазма, ты извлекаешь член и изливаешь обильные струи горячей спермы на её бёдра и подол платья, пачкая дорогую ткань белыми каплями.'
    elseif $MelissaFinish = 'inside':
        if $MelissaFormat = 'vaginal':
            *pl 'На пике наслаждения ты вонзаешься в неё до самого основания и мощными толчками извергаешься глубоко внутрь её горячего лона. Мелисса судорожно вздрагивает, сжимаясь вокруг твоего члена в сладких конвульсиях.'
        else:
            *pl 'Ты засаживаешь до упора в её узкий зад и пульсирующими толчками заливаешь семенем её нутро. Мелисса глухо стонет в стену, сотрясаясь от волны запоздалого оргазма.'
        end
    elseif $MelissaFinish = 'mouth':
        *pl 'Ты упираешься руками в её плечи и разряжаешься прямо в её открытый рот. Мелисса жадно принимает густую порцию за порцией, зажмурившись и покорно сглатывая горячую тяжесть твоего семени.'
    elseif $MelissaFinish = 'face':
        *pl 'Ты изливаешься прямо на её запрокинутое лицо. Густые белые капли ложатся на её щёки, припухшие губы и веки, стекая вниз по подбородку.'
    end

    *pl ' '

    if FamilyCorruptionStage <= 1:
        *pl 'Мелисса судорожно переводит дыхание, её лицо пылает стыдом и смятением. Дрожащими руками она торопливо оправляет корсаж и подол платья, доставая кружевной платок, чтобы стереть следы вашей тайной страсти.'
        *pl 'Она испуганно оглядывается по сторонам, боясь поднять на тебя глаза, но в её взгляде сквозь смущение читается искренний восторг перед случившимся.'
        *pl '— Стефан... если об этом кто-нибудь узнает, это конец, — прерывающимся шепотом говорит она, поспешно пряча платок. — Скорее, нам нельзя здесь оставаться.'

    elseif FamilyCorruptionStage = 2:
        *pl 'Мелисса несколько мгновений стоит неподвижно, уперевшись лбом в твоё плечо и постепенно восстанавливая сбитое дыхание.'
        *pl 'Затем она отстраняется и с тонкой, лукавой усмешкой на припухших губах поправляет платье. В её умных глазах больше нет паники — лишь тёплая ирония и глубокая привязанность.'
        *pl '— Ну что ж, господин трактирщик... Должна заметить, городские летописи весьма сухо описывают обычаи праздничных вечеров, — с насмешливой нежностью шепчет она, поправляя выбившуюся прядь волос.'

    else:
        *pl 'Мелисса ничуть не смущается содеянного. Она неторопливо и уверенно приводит себя в порядок, не скрывая дерзкого блеска в глазах и откровенно любуясь произведённым эффектом.'
        if $MelissaFinish = 'face' or $MelissaFinish = 'mouth':
            *pl 'Она спокойно слизывает остатки семени с губ, бросая на тебя вызывающий, собственнический взгляд:'
            *pl '— Знаешь, эти деревенские пляски на площади не стоят и десятой доли того, чем мы только что занимались в этой подворотне.'
        else:
            *pl 'Она с улыбкой прислоняется к твоему плечу, наслаждаясь послевкусием порочной близости прямо под носом у всего города.'
        end
    end

    killvar '$MelissaFormat'
    killvar '$MelissaFinish'
