#MelissaDanceAlleyStage1Text
    *pl 'Вы с Мелиссой отходите от освещённой факелами рыночной площади в глубокую тень узкого прохода между двумя каменными домами.'
    *pl 'Гул голосов, и музыка с площади всё ещё доносятся сюда эхом, но здесь гораздо спокойней и темней.'
    *pl 'Мелисса слегка прислоняется спиной к стене, её грудь вздымается под корсажем праздничного платья. Она окидывает тебя внимательным, испытующим взглядом поверх полуулыбки — в ней борются привычная рассудительность и внезапный, хмельной интерес к происходящему.'
    *pl '— Стефан, ты же понимаешь, насколько это безрассудно? — тихо произносит она, хотя даже не пытается отстраниться. — Любой может свернуть сюда, и тогда не оберешься пересудов...'
---

#MelissaDanceAlleyStage2Text
    $MelissaAction = LCASE($ARGS[0])

    if $MelissaAction = 'talk':
        *pl 'Ты усмехаешься и негромко поддеваешь: «В твоих любимых поэмах дамы никогда не читали кавалерам нотаций в укромных уголках».'
        *pl 'Мелисса пытается парировать твои слова: «Я могу привести в пример благоразумие и правила приличия, но…» — её голос предательски дрожит. Воздух между вами накаляется с каждым словом, а её взгляд то и дело соскальзывает на твои губы.'
        *pl '— В стихах всегда умалчивают о последствиях, — едва слышно возражает она, закусив нижнюю губу. — Но… признаю, логика здесь бессильна.'

    elseif $MelissaAction = 'whisper':
        *pl 'Ты наклоняешься к самому её уху, касаясь тёплым дыханием нежной кожи шеи, и шепчешь слова, от которых по её телу пробегает заметная дрожь.'
        *pl 'Мелисса судорожно втягивает воздух сквозь зубы. Пальцы её тонких рук машинально сжимают ткань твоего камзола на груди.'
        *pl 'Вся её напускная строгость рассыпается в прах от одного этого интимного прикосновения, оставляя лишь жаркое, сбивчивое дыхание.'

    elseif $MelissaAction = 'listen':
        *pl 'Ты прижимаешь палец к её губам и прислушиваешься вместе с ней к звукам за углом.'
        *pl 'В отдалении гремит музыка и слышны голоса и смех весёлой толпы .'
        *pl 'Мелисса замирает, не смея шелохнуться. Её сердце колотится о рёбра так гулко, что ты чувствуешь это даже через одежду.'
    end

    killvar '$MelissaAction'
---

#MelissaDanceAlleyStage3Text
    $MelissaAction = LCASE($ARGS[0])

    if $MelissaAction = 'wall':
        *pl 'Ты делаешь резкий шаг вперёд, прижимая Мелиссу к камням стены и полностью перекрывая ей выход своим телом.'
        *pl 'Оказавшись в ловушке между камнем и твоей грудью, она беспомощно запрокидывает голову. Глаза её темнеют от нахлынувшего возбуждения, а горделивая осанка сменяется расслабленной мягкостью.'

    elseif $MelissaAction = 'kiss':
        *pl 'Ты не даёшь ей закончить фразу и накрываешь её губы поцелуем.'
        *pl 'Мелисса тихо застонала в поцелуй, на мгновение замирая, но тут же подаётся всем телом навстречу, обнимая тебя за шею. Её влажный язычок отвечает с неожиданной страстью, заставляя забыть обо всех предосторожностях.'

    elseif $MelissaAction = 'petting':
        *pl 'Твоя рука скользит вниз, собирая ткань её праздничной юбки и поднимая её выше колен.'
        *pl 'Пальцы касаются гладкой, горячей кожи её бёдер. Мелисса прерывисто стонет, пытаясь свести ноги от смущения, но ты мягко раздвигаешь их коленом, чувствуя, как влага желания уже пропитала её бельё.'
        *pl 'Найдя горошенку возбужденного влажного клитора, ты прнялся его нежно ласкать пальцами, Мелисса застонала прикусив губу прижимаясь к тебе всем телом.'
    end

    *pl ' '
    *pl 'Внезапно со стороны площади доносится топот подкованных сапог и пьяные выкрики нескольких мужчин, направляющихся прямо к вашему переулку!'
    *pl 'Мелисса вздрагивает и испуганно округляет глаза, в панике вжимаясь в тебя, боясь издать хоть звук.'
    *pl '— Если нас тут застукают, я тебя убью! — шепчет она, не отрываясь от твоих губ. — А потом проплачу положенный по тебе траур…'

    killvar '$MelissaAction'
