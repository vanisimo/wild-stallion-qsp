! ================================================
! FILE: modules/events/melissa/melissa_dark_alley_text.qsps
! MODULE: events/family
! [AI-WORKED] 18.09.2026
! Тексты подворотни Мелиссы
! ================================================

#MelissaDanceAlleyMainText
    *pl 'Подворотня скрывает вас от шумной площади, но Мелисса всё равно чутко прислушивается к шагам за углом.'
    *pl 'После домашней первой ночи она уже не отступает назад — только шепчет, чтобы вы были осторожнее.'
---

#MelissaDanceAlleyActionText
    $MelissaAlleyTextAction = LCASE($ARGS[0])

    if $MelissaAlleyTextAction = 'look':
        $MelissaAlleyLastText = 'Проход пуст, но задорная музыка с площади всё ещё отчётливо слышна.'
    elseif $MelissaAlleyTextAction = 'kiss':
        $MelissaAlleyLastText = 'Поцелуй в глубокой тени заставляет Мелиссу сладко вздрогнуть и прижаться ближе.'
    elseif $MelissaAlleyTextAction = 'close':
        $MelissaAlleyLastText = 'Вы притягиваете её к себе за талию. Мелисса прерывисто шепчет: «Только тихо…»'
    end

    killvar '$MelissaAlleyTextAction'
---

#MelissaDanceAlleyHomeGateText
    *pl 'Мелисса твёрдо качает головой: «Не здесь, Стефан. Сначала дома — я не хочу, чтобы наш первый раз был в грязной подворотне».'
---

#MelissaDanceAlleyBeforeSexText
    *pl 'Густая тень подворотни делает вас смелее. Мелисса больше не спорит — её губы приоткрыты, а руки сами обвивают вашу шею.'
---

#MelissaDanceAlleyEndText
    if MelissaAlleyAfterSex = 1:
        *pl 'Вы возвращаетесь на площадь. Мелисса тщательно одёргивает платье и старается держаться с невозмутимым видом.'
    else:
        *pl 'Вы выходите из подворотни. Мелисса слегка смущена, но уверенно держится рядом с вами.'
    end
---