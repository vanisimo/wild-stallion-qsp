! ================================================
! FILE: modules/events/melissa/melissa_home_anal.qsps
! MODULE: events/melissa
! [AI-WORKED] 18.09.2026
! Домашняя ветка открытия анала Мелиссы (3 акта + беседа с Клариссой)
! 1. Прилечь вместе: объятия со спины, трение, пробуждение интереса к трактатам
! 2. Подготовка: масло, бережные ласки, чувственный оргазм Мелиссы, благодарность
!    -> Разговор Мелиссы с Клариссой (в лавке Легаре или в воскресенье)
! 3. Полная близость со Стефаном, открытие повторного анала
! ================================================

#MelissaHomeAnalCanStart
    MelissaHomeAnalStepAvailable = 0
    $MelissaHomeAnalMenuLabel = ''
    $MelissaHomeAnalMenuTarget = ''

    if MelissaHomeSex = 0:
        exit
    end

    if time < 3:
        exit
    end

    if $GirlLocation['melissa'] <> 'MelissaRoom':
        exit
    end

    ! Шаг 1: Доступен после 5 ночей секса
    if MelissaHomeAnalStage = 0 and MelissaHomeNightCount >= 5 and MelissaHomeAnalToday = 0:
        MelissaHomeAnalStepAvailable = 1
        $MelissaHomeAnalMenuLabel = 'Прилечь вместе'
        $MelissaHomeAnalMenuTarget = 'MelissaHomeAnalStep1'
        exit
    end

    ! Шаг 2: Масло и бережные ласки
    if MelissaHomeAnalStage = 1 and MelissaHomeAnalToday = 0:
        MelissaHomeAnalStepAvailable = 1
        $MelissaHomeAnalMenuLabel = 'Особенная ласка (масло)'
        $MelissaHomeAnalMenuTarget = 'MelissaHomeAnalStep2'
        exit
    end

    ! Ожидание беседы с Клариссой
    if MelissaHomeAnalStage = 2 and MelissaHomeAnalToday = 0:
        MelissaHomeAnalStepAvailable = 1
        $MelissaHomeAnalMenuLabel = 'Спросить об особенной близости'
        $MelissaHomeAnalMenuTarget = 'MelissaHomeAnalStepWaitingClarissa'
        exit
    end

    ! Шаг 3: Полная близость
    if MelissaHomeAnalStage = 3 and MelissaHomeAnalToday = 0:
        MelissaHomeAnalStepAvailable = 1
        $MelissaHomeAnalMenuLabel = 'Особенная близость'
        $MelissaHomeAnalMenuTarget = 'MelissaHomeAnalStep3'
        exit
    end
---

! ================================================
! ШАГ 1: ОБЪЯТИЯ СО СПИНЫ И ИСКРА ИНТЕРЕСА
! ================================================

#MelissaHomeAnalStep1
    gt 'MelissaHomeAnalStep1_Talk'
---

#MelissaHomeAnalStep1_Talk
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/home_anal/melissa_home_anal_step1_talk', 'МЕЛИССА — ОБЪЯТИЯ В ПОЛУМРАКЕ', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' КОМНАТА МЕЛИССЫ — ТИХИЙ ВЕЧЕР'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeAnalText', 'step1_talk'
    *pl ' '

    gs 'ActUiPrepare', 'Прижать её ближе', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaHomeAnalStep1_Act'
    end
---

#MelissaHomeAnalStep1_Act
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/home_anal/melissa_home_anal_step1_act', 'МЕЛИССА — ДЫХАНИЕ И ДРОЖЬ', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' КОМНАТА МЕЛИССЫ — СМУЩЕНИЕ И ТРАКТАТЫ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeAnalText', 'step1_act'
    *pl ' '

    gs 'ActUiPrepare', 'Успокоить её и согласиться подождать', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaHomeAnalStep1_After'
    end
---

#MelissaHomeAnalStep1_After
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/home_anal/melissa_home_anal_step1_after', 'МЕЛИССА — НЕЖНОСТЬ ПЕРЕД СНОМ', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' КОМНАТА МЕЛИССЫ — СОГЛАСИЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeAnalText', 'step1_after'
    *pl ' '

    MelissaHomeAnalStage = 1
    MelissaHomeAnalToday = 1
    MelissaHomeNightCount += 1
    MelissaPlayerPath += 1
    otkroven['melissa'] += 2
    love['melissa'] += 1
    LastAttentionDay['melissa'] = day
    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Остаться с Мелиссой', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaRoom'
    end

    gs 'ActUiPrepare', 'Выйти в коридор', 'floor'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

