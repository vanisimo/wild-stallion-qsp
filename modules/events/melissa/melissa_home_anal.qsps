    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeAnalText', 'step2_after'
    *pl ' '

    MelissaHomeAnalStage = 2
    MelissaHomeAnalToday = 1
    MelissaHomeAnalStage2Day = day
    MelissaClarissaAnalTalkPending = 1
    MelissaHomeNightCount += 1
    sluttiness['melissa'] += 3
    otkroven['melissa'] += 3
    love['melissa'] += 2
    BlowjobCount['melissa'] += 1
    OralCount['melissa'] += 1

    gs 'CanCumToday'
    if Result = 1 or debug = 1:
        gs 'RegisterPlayerCum'
    end

    LastSexDay['melissa'] = day
    SexUsedToday['melissa'] = 1
    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Остаться с Мелиссой', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MelissaRoom'
    end

    gs 'ActUiPrepare', 'Выйти в коридор', 'floor'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
