#MelissaHomeAnalStep3_After
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/melissa/home_anal/melissa_home_anal_step3_after', 'МЕЛИССА — СЧАСТЬЕ И ПОКОЙ', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' КОМНАТА МЕЛИССЫ — СЧАСТЬЕ И ПОКОЙ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeAnalText', 'step3_after'
    *pl ' '

    MelissaHomeAnalStage = 4
    MelissaHomeAnalDone = 1
    MelissaAnalWithGgDone = 1
    MelissaAnalUnlocked = 1
    analvirgin['melissa'] = 0
    analfromyou['melissa'] += 1
    analacts['melissa'] += 1
    MelissaHomeNightCount += 1
    MelissaPlayerPath += 3
    sluttiness['melissa'] += 4
    otkroven['melissa'] += 4
    love['melissa'] += 3

    gs 'RegisterSex', 'melissa', 'anal', 1, 1

    gs 'CanCumToday'
    if Result = 1 or debug = 1:
        gs 'RegisterPlayerCum'
        cuminside['melissa'] += 1
    end

    LastSexDay['melissa'] = day
    SexUsedToday['melissa'] = 1
    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Остаться с Мелиссой до утра', 'return'
