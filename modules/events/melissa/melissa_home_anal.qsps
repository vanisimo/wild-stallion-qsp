    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MelissaHomeAnalText', 'clarissa_shop_talk'
    *pl ' '

    MelissaClarissaAnalTalkPending = 0
    MelissaClarissaAnalTalkDone = 1
    MelissaHomeAnalStage = 3
    MelissaClarissaBond += 3
    sluttiness['melissa'] += 2
    otkroven['melissa'] += 2
    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Вернуться к прилавку', 'return'
