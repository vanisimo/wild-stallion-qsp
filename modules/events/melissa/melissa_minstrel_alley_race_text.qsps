! FILE: modules/events/melissa/melissa_minstrel_alley_race_text.qsps
! MODULE: events/family
! [AI-WORKED] 18.09.2026
! Тексты гонки менестреля на 6-й пятнице
! ================================================

#MelissaMinstrelFridayRaceIntroText
    *pl 'Шестая пятница в шёлковом платье от Ирмы. Мелисса уже привыкла к восхищённым взглядам горожан, но <<$MelissaMinstrelName>> сегодня особенно настойчив.'
    *pl 'Отложив лютню после заключительного куплета, он подходит к ней вплотную и вкрадчиво предлагает уйти от шума площади в полумрак узкого переулка между амбарами — якобы чтобы показать редкий список рыцарских стихов.'
    *pl 'Мелисса колеблется, нервно теребя рукав платья, и бросает растерянный взгляд в твою сторону, ожидая, как ты отреагируешь.'
---

#MelissaMinstrelFridayRaceActionText
    $MelissaRaceTextChoice = LCASE($ARGS[0])

    if $MelissaRaceTextChoice = 'stop':
        *pl 'Ты решительно шагаешь вперёд и встаёшь между ними, скрестив руки на груди:'
        *pl '— Стихи на сегодня закончились, скоморох. Мелиссе пора домой, за стойку.'
        *pl 'Менестрель с холодной усмешкой отступает на шаг, приподнимая шляпу, а Мелисса с облегчением выдыхает:'
        *pl '— Ты вечно всё портишь своей грубостью, Стефан... Хотя на улице и впрямь сыро.'

    elseif $MelissaRaceTextChoice = 'claim':
        *pl 'Ты подходишь к Мелиссе, уверенно берёшь её за руку и переплетаешь пальцы с её тонкими пальцами:'
        *pl '— Пойдём домой, Мелисса. Тебе незачем шастать по тёмным углам.'
        *pl 'Менестрель желчно кривит губы, но не смеет перечить. Мелисса на мгновение замирает, а затем крепче сжимает твою ладонь, послушно следуя за тобой.'

    elseif $MelissaRaceTextChoice = 'watch':
        if MelissaMinstrelFridayRaceWatchRollHard = 1:
            *pl 'Ты скользишь следом в густую тень переулка. Под ногами хрустит сор, в тупике пахнет сыростью и чужим терпким табаком.'
            *pl 'Менестрель прижимает Мелиссу к дощатому забору, горячо нашептывая стихи прямо в её приоткрытые губы. Она не отталкивает его — лишь испуганно оглядывается на выход из подворотни.'
            *pl 'Ещё секунда — и черта будет перейдена окончательно.'
        else:
            *pl 'Менестрель пытается увлечь Мелиссу глубже в темноту, но она, вспыхнув румянцем, решительно высвобождает ладонь после пары шагов.'
            *pl 'Она возвращается на освещённую площадь с чуть сбившимся дыханием. На этот раз её благоразумие взяло верх, но грань остаётся пугающе тонкой.'
        end

    elseif $MelissaRaceTextChoice = 'step_aside':
        if MelissaMinstrelFridayRaceSoftNearMiss = 1:
            *pl 'Ты отворачиваешься, делая вид, что изучаешь винные бочки торговцев. Менестрель беспрепятственно уводит Мелиссу в сумрак подворотни.'
            *pl 'Спустя добрых десять минут она выныривает обратно на площадь — растрёпанная, с пылающими щеками и лихорадочно блестящими глазами.'
        else:
            *pl 'Ты решаешь не вмешиваться. Однако Мелисса, заметив твоё показное равнодушие, с оскорблённым видом качает головой и отказывается идти за менестрелем.'
            *pl 'Музыкант разочарованно цокает языком, а Мелисса возвращается к подругам, нарочито не глядя в твою сторону.'
        end
    end

    killvar '$MelissaRaceTextChoice'
---