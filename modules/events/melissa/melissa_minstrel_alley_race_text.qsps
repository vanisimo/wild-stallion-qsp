! ================================================
! FILE: modules/events/melissa/melissa_minstrel_alley_race_text.qsps
! MODULE: events/family
! [AI-WORKED] 18.09.2026: углубление характера Мелиссы (Муза и Королева, а не безвольная жертва)
! Тексты гонки менестреля на 6-й пятнице
! ================================================

#MelissaMinstrelFridayRaceIntroText
    *pl 'Пятница в нарядном шёлковом платье от Ирмы. Мелисса уже привыкла к восхищённым взглядам горожан, но <<$MelissaMinstrelName>> сегодня превзошёл сам себя.'
    *pl 'Отложив лютню после заключительного аккорда, он подходит к ней с изящным поклоном и вкрадчиво предлагает отойти в полумрак арочного проезда между амбарами — якобы для того, чтобы показать только что записанную балладу, посвящённую «самой мудрой деве города».'
    *pl 'Мелисса замирает: её сердце отчаянно колотится в груди, в животе порхают бабочки, а от одной мысли о темноте переулка между бёдер разливается горячая влага. Она пытается спрятаться за маской снисходительной королевы-покровительницы, поглаживая шёлковый рукав, но её броня готова пасть. Она бросает короткий, почти беспомощный взгляд в твою сторону — словно сама моля брата спасти её от этого наваждения.'
---

#MelissaMinstrelFridayRaceActionText
    $MelissaRaceTextChoice = LCASE($ARGS[0])

    if $MelissaRaceTextChoice = 'stop':
        *pl 'Ты решительно шагаешь вперёд и встаёшь между ними, скрестив руки на груди:'
        *pl '— Стихи на сегодня закончились, скоморох. Мелиссе пора домой.'
        *pl ' '
        *pl 'Менестрель с холодной усмешкой отступает на шаг, приподнимая шляпу с пером. Мелисса театрально вздыхает с привычным книжным снисхождением:'
        *pl '— Стефан, ты разрушил тончайшую аллегорию о Королеве Элеоноре своим кабацким басом. Впрочем... у Элрика рифмы и впрямь начали скатываться в излишне вольные намёки. Пойдём, пока ты не полез в драку с лютней наперевес.'
        *pl 'Но когда она поворачивается к тебе, ты слышишь её тихий выдох искреннего облегчения: твой грубый окрик выдернул её из сладкого омута, в который она едва не шагнула с головой.'

    elseif $MelissaRaceTextChoice = 'claim':
        *pl 'Ты подходишь к Мелиссе, уверенно берёшь её за руку и крепко переплетаешь пальцы с её тонкой ладонью:'
        *pl '— Пойдём домой, Мелисса. Твои романы и настоящие дела ждут тебя в трактире.'
        *pl ' '
        *pl 'Менестрель желчно кривит губы, но не смеет перечить хозяину заведения. Мелисса на мгновение замирает, удивлённо глядя на вашу сцепленную руку, затем чувствует твоё уверенное тепло — и книжный туман менестреля отступает перед осязаемой силой брата. Она крепче сжимает твои пальцы и поворачивается к музыканту с царственной невозмутимостью:'
        *pl '— Мой брат прав, Элрик. Настоящая Муза вдохновляет на почтительном расстоянии. Доведи балладу до ума к следующей пятнице — и смотри не сбейся с размера.'

    elseif $MelissaRaceTextChoice = 'watch':
        if MelissaMinstrelFridayRaceWatchRollHard = 1:
            *pl 'Ты бесшумно скользишь следом в густую тень переулка. В каменном тупике пахнет сыростью, дождём и дорогим табаком.'
            *pl 'Менестрель прижал Мелиссу к дощатой стене амбара, горячо декламируя строки о пламени страсти прямо в её приоткрытые губы. Его ладони жадно обнимают её за талию, подбираясь к бёдрам.'
            *pl 'Мелисса пытается сохранить дистанцию покровительницы, но в темноте её сопротивление тает: её веки вздрагивают, из горла вырывается сдавленный стон, а под шелком платья всё тело пронзает дрожь чистого вожделения:'
            *pl '— Элрик... постой... благосклонность дамы... не покупается одними сонетами... — шепчет она слабеющим голосом, не в силах оторваться от его рта, пока его губы целуют её шею и мочку уха.'
            *pl 'Лишь в самый последний миг, собрав остатки воли, она упирается ладонями ему в грудь и с трудом отстраняется, сохраняя хрупкое подобие приличий ценой колотящегося сердца и пылающего лона.'
        else:
            *pl 'Менестрель пытается увлечь Мелиссу глубже в темноту подворотни, но девушка останавливается уже через пару шагов.'
            *pl 'Она решительно высвобождает запястье, обдавая барда насмешливым, трезвым взглядом:'
            *pl '— Не так быстро, менестрель. Ты путаешь поэтическое вдохновение с банальной спешкой. Изучи сперва правила приличия, а затем зови хозяйскую дочь в тёмные переулки.'
            *pl 'Она возвращается на освещённую площадь с гордой осанкой, оставив музыканта в растерянности.'
        end

    elseif $MelissaRaceTextChoice = 'step_aside':
        if MelissaMinstrelFridayRaceSoftNearMiss = 1:
            *pl 'Ты отворачиваешься, делая вид, что занят осмотром праздничной ярмарки. Менестрель беспрепятственно уводит Мелиссу в сумрак переулка.'
            *pl 'Спустя добрых десять минут она возвращается обратно: щёки пылают, походка пьяная от пережитого возбуждения, а в пальцах нервно зажат исписанный рифмами листок.'
            *pl 'Она ловит твой взгляд и силится изобразить надменную улыбку королевы, но её влажные глаза и прерывистое дыхание выдают всю бурю чувств: бродячий поэт сумел растопить её неприступность, подарив ей те самые запретные строки и поцелуи, о которых она читала по ночам.'
        else:
            *pl 'Ты демонстративно не вмешиваешься, оставаясь на месте.'
            *pl 'Заметив твоё равнодушие, Мелисса оскорблённо поджимает губы, резко одёргивает подол и наотрез отказывается идти за менестрелем в темноту:'
            *pl '— Поэзия хороша на свету, Элрик. А для тёмных углов у тебя слишком много самоуверенности.'
            *pl 'Она возвращается к знакомым горожанкам с ледяным, безупречным видом, нарочито не глядя в твою сторону.'
        end
    end

    killvar '$MelissaRaceTextChoice'
---