#MelissaHomeStepText
    $MelissaHomeStepKey = LCASE($ARGS[0])

    if $MelissaHomeStepKey = 'hug':
        $MelissaHomeText = 'Мелисса позволяет обнять себя, но сразу шепчет: «Тише, Стефан. Я ведь старше Аманды — мне нельзя выглядеть легкомысленной».'
    elseif $MelissaHomeStepKey = 'kiss':
        $MelissaHomeText = 'Поцелуй заставляет её замереть. Мелисса отвечает сдержанно, но не отстраняется — в её взгляде мелькает смущение и непривычное доверие.'
    elseif $MelissaHomeStepKey = 'petting':
        $MelissaHomeText = 'Она не торопится, чутко проверяя каждое ваше движение. Но когда вы не отступаете, Мелисса тихо вздыхает и сама притягивает вас ближе.'
    elseif $MelissaHomeStepKey = 'handjob':
        $MelissaHomeText = 'Мелисса действует осторожно, будто решает сложную книжную задачу. Её аккуратная ладонь чуть дрожит, пальцы обхватывают налитую плоть, но она не останавливается.'
    elseif $MelissaHomeStepKey = 'blowjob':
        $MelissaHomeText = 'Она опускается на колени у кровати и бросает быстрый взгляд на дверь. «Только быстро… и никому ни слова», — шепчет Мелисса, обхватывая губами горячую головку.'
    elseif $MelissaHomeStepKey = 'cuni':
        $MelissaHomeText = 'Вы ласкаете её губами и языком. Мелисса закусывает угол подушки, чтобы не выдать себя стоном. Её пальцы вплетаются в ваши волосы — весь строгий контроль рушится на глазах.'
    elseif $MelissaHomeStepKey = 'presex':
        $MelissaHomeText = 'Мелисса смотрит на вас прямо, её щёки пылают: «Если мы переступим эту черту — я больше не смогу делать вид, что ты просто брат. И… я не хочу делать вид».'
    else:
        $MelissaHomeText = 'Между вами повисает напряжённая, волнующая тишина.'
    end

    killvar '$MelissaHomeStepKey'
---

#MelissaHomeAfterSexText
    $MelissaHomeText = 'Мелисса поправляет рассыпавшиеся волосы и долго молчит, глядя на примятую простыню. «Теперь ты знаешь, какая я на самом деле, Стефан, — наконец говорит она с лёгкой, непривычно мягкой улыбкой. — И я знаю, кого выбираю. По крайней мере, сегодня».'
---

#MelissaDanceLeaveHomeText
    $MelissaDanceLastText = 'Мелисса оглядывается на шумную площадь и кивает вам: «Хватит танцев на сегодня. Пойдём домой, в трактир, пока мама занята делами».'
---

#MelissaProhibitMinstrelTalkText
    $MelissaTalkText = 'Вы поднимаете разговор о менестреле по имени <<$MelissaMinstrelName>>. Мелисса с лёгкой насмешкой закатывает глаза: «Он просто поёт баллады на площади, Стефан. Не строй из себя грозного ревнивца на пустом месте».'
---

#MelissaProhibitMinstrelDoneText
    $MelissaTalkText = 'Мелисса недовольно хмурится и складывает руки на груди: «Хорошо. Я не стану с ним встречаться без нужды. Но если ты думаешь, что можешь читать мне нотации, как строгий наставник — ты ошибаешься».'
---