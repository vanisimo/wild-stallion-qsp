    elseif $MelissaHomeStepKey = 'cuni':
        if $MelissaHomeScreen = 'talk':
            *pl 'Вы бережно укладываете Мелиссу на мягкую перину, прямо среди разложенных пергаментов и рукописей.'
            *pl 'Её ночная сорочка слегка задрана, открывая стройные, гладкие бёдра, благоухающие свежестью и лавандовой водой.'
            *pl ' '
            *pl 'Мелисса нервно закусывает губу, пытаясь прикрыться остатками привычного книжного сарказма:'
            *pl '— Стефан... постой. Это совершенно... ненаучно! В трактатах сказано, что девам нашего склада подобает сдержанность и хладнокровие, а такие вольности...'

        elseif $MelissaHomeScreen = 'act':
            *pl 'Не давая ей закончить нотацию, вы решительно раздвигаете её шелковистые бёдра и опускаетесь лицом между её ног.'
            *pl 'Ваши горячие губы и язык влажно припадают к её сокровенному, набухшему бутону.'
            *pl ' '
            *pl 'Мелисса пронзительно ахает, выгибаясь всем телом. Все книги, трактаты и цитаты великих философов мгновенно испаряются из её головы!'
            *pl 'Её тонкие пальцы судорожно впиваются в ваши волосы, то пытаясь оттолкнуть, то с бешеной силой прижимая ваше лицо ближе к источающей нектар ложбинке.'
            *pl ' '
            *pl '— О Ильматер... Стефан... что ты... что ты со мной делаешь?! — её голос срывается на всхлипывающий стон. — Я не могу... я сейчас с ума сойду... пусти... нет, не смей останавливаться!'
            *pl 'Ваш язык непрерывно выписывает горячие круги по её чувствительной плоти, втягивая её в пучину неистового экстаза.'

        else
            *pl 'Волна сокрушительного оргазма накрывает Мелиссу с головой. Её тело натягивается тугой струной, из горла вырывается долгий, сдавленный крик наслаждения, а сокровенные мышцы бьются в частых, сладких судорогах вокруг вашего лица.'
            *pl ' '
            *pl 'Она бессильно падает на подушки, часто и тяжело вздымая грудь.'
            *pl ' '
            if MelissaMinstrelFirstSexDone = 1:
                *pl 'Спустя пару минут Мелисса находит в себе силы открыть глаза. В её взгляде нет высокомерия — лишь преображённая, чистая женская нежность:'
                *pl '— Стефан... Это было... совершенно иначе. Так глубоко и жарко... словно ты добрался до самого сокровенного во мне, куда никто никогда не смел заглянуть.'
                *pl 'Она гладит вас по волосам, притягивая к себе для благодарного поцелуя:'
                *pl '— С тобой мне больше не нужно носить доспехи. Ты покорил мою крепость без единого выстрела.'
            else:
                *pl 'Слезинки ошеломляющего счастья блестят в уголках её глаз. Она закрывает пылающее лицо ладонями, переводя дыхание:'
                *pl '— О Ильматер... Мой разум... он просто испарился. Ни одной связной мысли, только ослепительная вспышка света перед глазами.'
                *pl 'Она с робким благоговением тянет вас на себя, целуя в губы со вкусом её собственной сладости:'
                *pl '— Ни в одной библиотеке мира нет таких слов, чтобы описать это... Ты сделал со мной то, чего не способна сделать ни одна мудрая книга на свете.'
            end
        end

    elseif $MelissaHomeStepKey = 'presex':
        *pl 'В комнате царит благоговейная, звенящая тишина. Свеча почти догорела, наполняя воздух тёплым ароматом воска.'
        *pl ' '
        *pl 'Мелисса сидит на краю постели. Сорочка спадает с её плеча, обнажая нежную девичью кожу, а растрёпанные волосы свободно струятся по спине.'
        *pl 'Она смотрит на вас прямо, без привычной иронии и насмешки — в её взгляде сквозит глубокая, осознанная решимость взрослой женщины.'
        *pl ' '
        *pl '— Мы оба знаем, к чему всё шло, Стефан, — тихо, но твёрдо произносит она, протягивая вам раскрытую ладонь. — Я больше не могу прятаться за своими книгами, колкостями и вечным надзором. Всё это время я притворялась холодной и неприступной, потому что смертельно боялась признаться себе, как отчаянно я тянусь к тебе.'
        *pl ' '
        *pl 'Она сжимает ваши пальцы, и в её голосе звучит неподдельный трепет:'
        *pl '— Если мы переступим эту черту — обратной дороги не будет. Я стану твоей женщиной. Навсегда. И видит Ильматер... я хочу этого всем своим сердцем.'

    else
        *pl 'Между вами повисает напряжённая, сладостная тишина, полная невысказанных признаний.'
    end

    killvar '$MelissaHomeStepKey'
    killvar '$MelissaHomeScreen'
