! ================================================
! FILE: modules/events/eddie/eddie_arc.qsps
! MODULE: events/becky
! Ветка Эдди: talk → подворотня → исповедь → дом
! ================================================

#EddieGeorgAlleyUnlocked

    EddieGeorgAlleyUnlocked = 0

    if Friends['eddie'] >= 8:
        EddieGeorgAlleyUnlocked = 1
    end
---

#EddieImportantCheck
    EddieImportantReady = 0
    $EddieImportantAction = ''

    ! 1. О пятницах Сандры (подсказка о мастерской Драупнира — строго после первой пятницы)
    if day >= 6 and PlayerKnows_SandraDraupnirFriday = 0 and SandraDraupnirHintEddie = 0 and SandraCarpenterSecret = 0 and SandraHomeSex = 0 and Friends['eddie'] >= 10:
        EddieImportantReady = 1
        $EddieImportantAction = 'sandra_friday'
        exit
    end

    ! 2. Пообещать помощь (с Бекки и Жоржеттой)
    if BeckyHomeSex = 1 and EddieSawGeorg = 2 and EddieHelpPromised = 0 and Friends['eddie'] >= 10 and BeckyEddieDone = 0:
        EddieImportantReady = 1
        $EddieImportantAction = 'help_promise'
        exit
    end

    ! 3. Лучшие друзья (предложение о жене)
    if BeckyEddieDone = 1 and EddieBestFriend = 0 and Friends['eddie'] >= 18:
        EddieImportantReady = 1
        $EddieImportantAction = 'best_friend'
        exit
    end

    ! 4. Сказать, что всё в порядке (после сцены с Бекки)
    if BeckyEddieDone = 1 and EddieBeckyPostTalkDone = 0:
        EddieImportantReady = 1
        $EddieImportantAction = 'becky_post'
        exit
    end
---

#EddieRunImportantAction
    $EddieActionType = $ARGS[0]
    $EddieTalkReturnLoc = 'BeckyShop'

    if LOC('InitEddie') = 1:
        gs 'InitEddie'
    end

    cls
    gs 'ShowImagePath', 'images/events/eddie/eddie_arc/eddie_talk', '', 'portrait', 'webp'
    gs 'ShowLocationScreenTitle', 'ВАЖНЫЙ РАЗГОВОР: ЭДДИ'

    if $EddieActionType = 'sandra_friday':
        gs 'EddieTalkSandraFridayText'
        *pl $EddieArcText
        killvar '$EddieArcText'
        SandraDraupnirHintEddie = 1
        Talked['eddie'] += 1

    elseif $EddieActionType = 'help_promise':
        gs 'EddieHelpPromiseText'
        *pl $EddieArcText
        killvar '$EddieArcText'
        EddieHelpPromised = 1
        Friends['eddie'] += 1
        Talked['eddie'] += 1

    elseif $EddieActionType = 'best_friend':
        gs 'EddieBestFriendText'
        *pl $EddieArcText
        killvar '$EddieArcText'
        EddieBestFriend = 1
        EddieWifeOffer = 1
        Friends['eddie'] += 1
        Talked['eddie'] += 1

    elseif $EddieActionType = 'becky_post':
        *pl 'Ты подмигиваешь Эдди, давая понять, что всё под контролем.'
        *pl '— Слушай, Стефан... Я правда благодарен, — тихо говорит он, глядя в пол. — Думал, после того случая всё пойдёт кувырком. Хорошо, что ты всё разрулил.'
        EddieBeckyPostTalkDone = 1
        Friends['eddie'] += 1
        Talked['eddie'] += 1
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        killvar '$EddieActionType'
        gt $EddieTalkReturnLoc
    end
---

#TalkWithEddie

    $GuyName = 'eddie'

    if $ARGS[0] <> '':
        $EddieTalkReturnLoc = $ARGS[0]
    elseif $EddieTalkReturnLoc = '':
        $EddieTalkReturnLoc = 'BeckyShop'
    end

    if LOC('InitEddie') = 1:
        gs 'InitEddie'
    end

    cls

    gs 'ShowImagePath', 'images/events/eddie/eddie_arc/eddie_talk', '', 'portrait', 'webp'
    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С ЭДДИ'

    gs 'EddieUnifiedTalkRun'

    *pl ' '

    ! Контекстные действия на экране разговора (если доступны важные темы)
    if day >= 6 and PlayerKnows_SandraDraupnirFriday = 0 and SandraDraupnirHintEddie = 0 and SandraCarpenterSecret = 0 and SandraHomeSex = 0 and Friends['eddie'] >= 10:
        gs 'ActUiPrepare', 'Заметить задумчивый взгляд Эдди', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'EddieRunImportantAction', 'sandra_friday'
        end
    end

    if BeckyHomeSex = 1 and EddieSawGeorg = 2 and EddieHelpPromised = 0 and Friends['eddie'] >= 10 and BeckyEddieDone = 0:
        gs 'ActUiPrepare', 'Пообещать помощь', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'EddieRunImportantAction', 'help_promise'
        end
    end

    if BeckyEddieDone = 1 and EddieBestFriend = 0 and Friends['eddie'] >= 18:
        gs 'ActUiPrepare', 'Поговорить по душам', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'EddieRunImportantAction', 'best_friend'
        end
    end

    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        $TmpLoc = $EddieTalkReturnLoc
        killvar '$EddieTalkReturnLoc'
        gt $TmpLoc
    end
---

#EddieUnifiedTalkRun
    ! 1. Проверка лимита полезных разговоров
    gs 'UsefulTalkCheck', 'eddie', 'eddie_unified'
    if UsefulTalkResult = 0:
        gs 'EddieTalkLimitReachedText'
        exit
    end

    ! 2. Регистрация полезного разговора
    gs 'UsefulTalkRegister', 'eddie', 'eddie_unified'

    ! 3. Прогрессивная иерархия тем:
    ! --- Лучший друг (после сближения и признания) ---
    if EddieBestFriend = 1 and EddieFriendMemoryDone = 0:
        EddieFriendMemoryDone = 1
        gs 'EddieTalkBestFriendRun'

    ! --- О девушках в трактире ---
    elseif Friends['eddie'] >= 5 and EddieTalkedTavernGirls = 0:
        EddieTalkedTavernGirls = 1
        gs 'EddieTalkTavernGirlsRun'

    ! --- О девушках в городе / хвастовство ---
    elseif Friends['eddie'] >= 5 and EddieTalkGirlsBoastFirstDone = 0:
        EddieTalkGirlsBoastFirstDone = 1
        gs 'EddieTalkGirlsBoastRun'

    ! --- О матери и лавке ---
    elseif EddieTalkShopFirstDone = 0:
        EddieTalkShopFirstDone = 1
        gs 'EddieTalkShopRun'

    ! --- Циклическая ротация лор-пулов ---
    else:
        EddieLorePoolCycle += 1
        if EddieLorePoolCycle > 3:
            EddieLorePoolCycle = 0
        end

        if EddieLorePoolCycle = 0:
            gs 'EddieTalkShopRun'
        elseif EddieLorePoolCycle = 1 and Friends['eddie'] >= 5:
            gs 'EddieTalkGirlsBoastRun'
        elseif EddieLorePoolCycle = 2 and Friends['eddie'] >= 5:
            gs 'EddieTalkTavernGirlsRun'
        elseif EddieLorePoolCycle = 3 and EddieBestFriend = 1:
            gs 'EddieTalkBestFriendRun'
        else:
            gs 'EddieTalkSmalltalkRun'
        end
    end
---

#EddieTalkLimitReachedText
    *pl 'Эдди весело почесывает затылок и разводит руками:'
    *pl '— Стефан, матушка уже косится на нас из-за полок. Если я сейчас продолжу лясы точить, она заставит меня мешки с крупой до вечера таскать. Давай позже перетрём, когда лавка опустеет!'
---

#EddieTalkBestFriendRun
    gs 'EddieBestFriendText'
    *pl $EddieArcText
    killvar '$EddieArcText'
    Friends['eddie'] += 1
    Talked['eddie'] += 1
---

#EddieTalkTavernGirlsRun
    gs 'EddieTalkTavernGirlsText'
    *pl $EddieArcText
    killvar '$EddieArcText'
    Friends['eddie'] += 1
    Talked['eddie'] += 1
---

#EddieTalkGirlsBoastRun
    gs 'EddieTalkGirlsBoastText'
    *pl $EddieArcText
    killvar '$EddieArcText'
    if Friends['eddie'] < 15:
        Friends['eddie'] += 1
    end
    Talked['eddie'] += 1
---

#EddieTalkShopRun
    *pl 'Ты расспрашиваешь Эдди о делах в лавке и о том, как справляется Бекки.'
    *pl '— Мама держит всё железной хваткой, — улыбается Эдди. — Иногда ворчит, что я считаю медленно, но без меня бы с ума сошла с этими поставщиками и телегами. Ты, главное, муку для трактира вовремя забирай, а то она место на складе занимает.'
    if Friends['eddie'] < 10:
        Friends['eddie'] += 1
    end
    Talked['eddie'] += 1
---

#EddieTalkSmalltalkRun
    *pl 'Ты перебрасываешься с Эдди парой шуток о городских новостях, девчонках и ценах на зерно.'
    *pl 'Эдди заразительно смеётся, явно радуясь возможности ненадолго отвлечься от нудной возни с ящиками.'
    if Friends['eddie'] < 8:
        Friends['eddie'] += 1
    end
    Talked['eddie'] += 1
---

#PortAlley

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОДВОРОТНЯ У ПОРТА'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/port_alley', 'ПОДВОРОТНЯ У ПОРТА', 'large', 'webp'
    *p 'Узкий проход между складами. Пахнет рыбой, дёгтем и чужими тайнами.'
    *pl ' '

    if Friends['eddie'] < 8:
        gs 'ActUiPrepare', 'Вернуться к пристани', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Port'
        end
        exit
    end

    if EddieSawGeorg = 0:
        gs 'ActUiPrepare', 'Прислушаться', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'EddieAlleySpy1'
        end
    elseif EddieSawGeorg = 1 and day >= EddieAlleyNextDay:
        gs 'ActUiPrepare', 'Заглянуть в тень', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'EddieAlleySpy2'
        end
    elseif EddieSawGeorg >= 2:
        *p 'Подворотня пуста — Эдди сегодня здесь не появляется.'
    else:
        *p 'Пока здесь тихо. Эдди, кажется, ещё не возвращался.'
    end

    gs 'ActUiPrepare', 'Вернуться к пристани', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#EddieAlleySpy1

    SceneArtUseReal = 1
    gs 'EddieAlleySpy1Text'

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОДВОРОТНЯ — ЭДДИ И ЖОРЖЕТТА'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/eddie_alley_spy1', 'ПОДВОРОТНЯ — ЭДДИ И ЖОРЖЕТТА', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    EddieSawGeorg = 1
    EddieAlleyNextDay = day + RAND(1, 7)
    Friends['eddie'] += 1

    gs 'ActUiPrepare', 'Незаметно уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#EddieAlleySpy2

    SceneArtUseReal = 1
    gs 'EddieAlleySpy2Text'

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОДВОРОТНЯ — ИГРА «МАМОЧКА»'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/eddie_alley_spy2', 'ПОДВОРОТНЯ — ИГРА «МАМОЧКА»', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    EddieSawGeorg = 2
    Friends['eddie'] += 1

    gs 'ActUiPrepare', 'Незаметно уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#BeckyEddieConfession

    SceneArtUseReal = 1
    if week <> 7 or time < 2:
        gt 'Church'
    end

    if BeckyPriestOk = 1:
        gt 'Church'
    end

    gs 'BeckyEddieConfessionDirectText'

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ИСПОВЕДЬ БЕККИ'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/becky_eddie_confession', 'ИСПОВЕДЬ БЕККИ', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    BeckyPriestConfessionSeen = 1
    BeckyPriestOk = 1
    BeckyVar['PriestAdvice'] = 3
    BeckyEddieDonationPaid = 1

    gs 'ActUiPrepare', 'Выйти из церкви', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Church'
    end
---

#BeckyEddieJoinFirst
    gt 'BeckyEddieHomeLaunch'
---

#BeckyEddieHomeLaunch

    if BeckyHomeSex = 0 or EddieHelpPromised = 0 or BeckyEddieDone = 1:
        gt 'BeckyHomeBedroom'
    end

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ БЕККИ — ЗАСОВ'
    gs 'SceneShowVisual', 'images/events/becky/home/doorclose', 'СПАЛЬНЯ БЕККИ — ЗАСОВ', 'large', 'webp'

    *p 'Вдова, как обычно, закрыла дверь на засов и потянула вас к кровати. Вы вспомнили о разговоре с Эдди.'
    *pl ' '

    gs 'ActUiPrepare', 'Поцеловать Бекки и незаметно открыть засов', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyEddieHomeOpenLatch'
    end

    gs 'ActUiPrepare', 'Идти за вдовой (не трогать засов)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyEddieHomeLockedLatch'
    end
---

#BeckyEddieHomeLockedLatch

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ЗАКРЫТАЯ ДВЕРЬ'
    gs 'SceneShowVisual', 'images/events/becky/sexeddie/eddiespy', 'ЗАКРЫТАЯ ДВЕРЬ', 'large', 'webp'

    *p 'Целуя вдовушку, вы краем уха услышали, как дёрнулась, но не поддалась дверь, а затем последовали тихие удаляющиеся шаги. Пожав плечами, вы вернулся к страстным губам Бекки.'
    *pl ' '

    BeckyVar['EddieTryToFuck'] = 3
    if Friends['eddie'] > 0:
        Friends['eddie'] -= 1
    end

    if LOC('SexSceneStart') = 1:
        gs 'ActUiPrepare', 'Продолжить вечер с Бекки', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SexSceneStart', 'becky', 'BeckyHomeAfterSex', 'becky_repeat'
        end
    else:
        gs 'ActUiPrepare', 'Вернуться на рынок', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Market'
        end
    end
---

#BeckyEddieHomeOpenLatch

    if BeckyPriestOk = 0 and BeckyVar['PriestAdvice'] < 3:
        gt 'BeckyEddieHomeFail'
    end

    BeckyVar['PriestAdvice'] = 3
    gt 'BeckyEddieHomeStep1'
---

#BeckyEddieHomeFail

    SceneArtUseReal = 1
    gs 'BeckyEddieHomeFailText'

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПРОВАЛ'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/becky_eddie_home_fail', 'ПРОВАЛ', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    BeckyEddieHomeFailed = 1
    BeckyVar['EddieTryToFuck'] = 2
    BeckyVar['EddieFailures'] += 1

    if Friends['becky'] > 3:
        Friends['becky'] -= 3
    end

    if Friends['eddie'] > 5:
        Friends['eddie'] -= 5
    end

    if sluttiness['becky'] > 25:
        sluttiness['becky'] -= 3
    end

    gs 'ActUiPrepare', 'Вернуться на рынок', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

