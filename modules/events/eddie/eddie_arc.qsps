! ================================================
! FILE: modules/events/eddie/eddie_arc.qsps
! MODULE: events/becky
! Ветка Эдди: talk → подворотня → исповедь → дом
! ================================================

#EddieGeorgAlleyUnlocked

    EddieGeorgAlleyUnlocked = 0

    if Friends['eddie'] >= 8:
        EddieGeorgAlleyUnlocked = 1
    end
---

#TalkWithEddie

    $GuyName = 'eddie'

    if $ARGS[0] <> '':
        $EddieTalkReturnLoc = $ARGS[0]
    elseif $EddieTalkReturnLoc = '':
        $EddieTalkReturnLoc = 'BeckyShop'
    end

    if LOC('InitEddie') = 1:
        gs 'InitEddie'
    end

    cls

    SceneArtUseReal = 1
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/eddie_talk', 'РАЗГОВОР С ЭДДИ', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С ЭДДИ'

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        if $EddieTalkReturnLoc = '':
            $EddieTalkReturnLoc = 'BeckyShop'
        end
        $TmpLoc = $EddieTalkReturnLoc
        killvar '$EddieTalkReturnLoc'
        gt $TmpLoc
    end

    gs 'Menu.Create', 'MenuEddieTalk'

    gs 'MenuUiAdd', 'MenuEddieTalk', 'Поболтать о разной фигне', ''
    gs 'Menu.AddModule', 'MenuEddieTalk', {
        *pl 'Вы некоторое время болтаете с Эдди о несущественных вещах.'
        dynamic 'if Talked[''eddie'']<=2 and Rand(1,2)=1 and Friends[''eddie'']<=5:
            *pl ''Вы немного сдружились с Эдди.''
            Friends[''eddie'']+=1
        end
        if Talked[''eddie'']>2: *pl ''Ничего нового из разговора вы не узнали.'''
        Talked['eddie'] += 1
    }

    gs 'MenuUiAdd', 'MenuEddieTalk', 'Спросить про маму по пятницам', ''
    gs 'Menu.AddModule', 'MenuEddieTalk', {
        gs 'EddieTalkSandraFridayText'
        *pl $EddieArcText
        SandraDraupnirHintEddie = 1
        Talked['eddie'] += 1
    }
    gs 'Menu.AddCondition', 'MenuEddieTalk', "Result=IIF(PlayerKnows_SandraDraupnirFriday=0 and SandraDraupnirHintEddie=0,-1,0)"

    gs 'MenuUiAdd', 'MenuEddieTalk', 'Поболтать о девушках', ''
    gs 'Menu.AddModule', 'MenuEddieTalk', {
        gs 'EddieTalkGirlsBoastText'
        *pl $EddieArcText
        if Friends['eddie'] < 10:
            Friends['eddie'] += 1
        end
        Talked['eddie'] += 1
    }
    gs 'Menu.AddCondition', 'MenuEddieTalk', "Result=IIF(Friends['eddie']>=5,-1,0)"

    gs 'MenuUiAdd', 'MenuEddieTalk', 'Рассказать о девушках в трактире', ''
    gs 'Menu.AddModule', 'MenuEddieTalk', {
        gs 'EddieTalkTavernGirlsText'
        *pl $EddieArcText
        EddieTalkedTavernGirls = 1
        Friends['eddie'] += 1
        Talked['eddie'] += 1
    }
    gs 'Menu.AddCondition', 'MenuEddieTalk', "Result=IIF(Friends['eddie']>=5 and EddieTalkedTavernGirls=0,-1,0)"

    gs 'MenuUiAdd', 'MenuEddieTalk', 'Предложить помочь с мамой', ''
    gs 'Menu.AddModule', 'MenuEddieTalk', {
        gs 'EddieHelpPromiseText'
        *p $EddieArcText
        EddieHelpPromised = 1
        Friends['eddie'] += 1
        Talked['eddie'] += 1
    }
    gs 'Menu.AddCondition', 'MenuEddieTalk', "Result=IIF(BeckyHomeSex=1 and EddieSawGeorg=2 and EddieHelpPromised=0 and Friends['eddie']>=10 and BeckyEddieDone=0 and Talked['eddie']<2,-1,0)"

    gs 'MenuUiAdd', 'MenuEddieTalk', 'Поговорить о том, как теперь бывает дома', ''
    gs 'Menu.AddModule', 'MenuEddieTalk', {
        *pl 'Эдди смущённо улыбается: "Ну… теперь мама не так злится. Спасибо, что помог разобраться."'
        Friends['eddie'] += 1
        Talked['eddie'] += 1
    }
    gs 'Menu.AddCondition', 'MenuEddieTalk', "Result=IIF(BeckyEddieDone=1 and Talked['eddie']<2,-1,0)"

    gs 'MenuUiAdd', 'MenuEddieTalk', 'Выслушать благодарность лучшего друга', ''
    gs 'Menu.AddModule', 'MenuEddieTalk', {
        gs 'EddieBestFriendText'
        *p $EddieArcText
        EddieBestFriend = 1
        EddieWifeOffer = 1
        Friends['eddie'] += 1
        Talked['eddie'] += 1
    }
    gs 'Menu.AddCondition', 'MenuEddieTalk', "Result=IIF(BeckyEddieDone=1 and EddieBestFriend=0 and Friends['eddie']>=18 and Talked['eddie']<2,-1,0)"

    gs 'MenuUiAdd', 'MenuEddieTalk', 'Вернуться', ''
    gs 'Menu.AddModule', 'MenuEddieTalk', {
        if $EddieTalkReturnLoc = '':
            $EddieTalkReturnLoc = 'BeckyShop'
        end
        $TmpLoc = $EddieTalkReturnLoc
        killvar '$EddieTalkReturnLoc'
        gt $TmpLoc
    }

    gs 'Menu.Show', 'MenuEddieTalk'
---

#PortAlley

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОДВОРОТНЯ У ПОРТА'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/port_alley', 'ПОДВОРОТНЯ У ПОРТА', 'large', 'webp'
    *p 'Узкий проход между складами. Пахнет рыбой, дёгтем и чужими тайнами.'
    *pl ' '

    if Friends['eddie'] < 8:
        gs 'ActUiPrepare', 'Вернуться к пристани', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Port'
        end
        exit
    end

    if EddieSawGeorg = 0:
        gs 'ActUiPrepare', 'Прислушаться', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'EddieAlleySpy1'
        end
    elseif EddieSawGeorg = 1 and day >= EddieAlleyNextDay:
        gs 'ActUiPrepare', 'Заглянуть в тень', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'EddieAlleySpy2'
        end
    elseif EddieSawGeorg >= 2:
        *p 'Подворотня пуста — Эдди сегодня здесь не появляется.'
    else:
        *p 'Пока здесь тихо. Эдди, кажется, ещё не возвращался.'
    end

    gs 'ActUiPrepare', 'Вернуться к пристани', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#EddieAlleySpy1

    SceneArtUseReal = 1
    gs 'EddieAlleySpy1Text'

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОДВОРОТНЯ — ЭДДИ И ЖОРЖЕТТА'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/eddie_alley_spy1', 'ПОДВОРОТНЯ — ЭДДИ И ЖОРЖЕТТА', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    EddieSawGeorg = 1
    EddieAlleyNextDay = day + RAND(1, 7)
    Friends['eddie'] += 1

    gs 'ActUiPrepare', 'Незаметно уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#EddieAlleySpy2

    SceneArtUseReal = 1
    gs 'EddieAlleySpy2Text'

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОДВОРОТНЯ — ИГРА «МАМОЧКА»'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/eddie_alley_spy2', 'ПОДВОРОТНЯ — ИГРА «МАМОЧКА»', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    EddieSawGeorg = 2
    Friends['eddie'] += 1

    gs 'ActUiPrepare', 'Незаметно уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#BeckyEddieConfession

    SceneArtUseReal = 1
    if week <> 7 or time < 2:
        gt 'Church'
    end

    if BeckyPriestOk = 1:
        gt 'Church'
    end

    gs 'BeckyEddieConfessionDirectText'

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ИСПОВЕДЬ БЕККИ'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/becky_eddie_confession', 'ИСПОВЕДЬ БЕККИ', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    BeckyPriestConfessionSeen = 1
    BeckyPriestOk = 1
    BeckyVar['PriestAdvice'] = 3
    BeckyEddieDonationPaid = 1

    gs 'ActUiPrepare', 'Выйти из церкви', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Church'
    end
---

#BeckyEddieJoinFirst
    gt 'BeckyEddieHomeLaunch'
---

#BeckyEddieHomeLaunch

    if BeckyHomeSex = 0 or EddieHelpPromised = 0 or BeckyEddieDone = 1:
        gt 'BeckyHomeBedroom'
    end

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ БЕККИ — ЗАСОВ'
    gs 'SceneShowVisual', 'images/events/becky/home/doorclose', 'СПАЛЬНЯ БЕККИ — ЗАСОВ', 'large', 'webp'

    *p 'Вдова, как обычно, закрыла дверь на засов и потянула вас к кровати. Вы вспомнили о разговоре с Эдди.'
    *pl ' '

    gs 'ActUiPrepare', 'Поцеловать Бекки и незаметно открыть засов', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyEddieHomeOpenLatch'
    end

    gs 'ActUiPrepare', 'Идти за вдовой (не трогать засов)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyEddieHomeLockedLatch'
    end
---

#BeckyEddieHomeLockedLatch

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ЗАКРЫТАЯ ДВЕРЬ'
    gs 'SceneShowVisual', 'images/events/becky/sexeddie/eddiespy', 'ЗАКРЫТАЯ ДВЕРЬ', 'large', 'webp'

    *p 'Целуя вдовушку, вы краем уха услышали, как дёрнулась, но не поддалась дверь, а затем последовали тихие удаляющиеся шаги. Пожав плечами, вы вернулся к страстным губам Бекки.'
    *pl ' '

    BeckyVar['EddieTryToFuck'] = 3
    if Friends['eddie'] > 0:
        Friends['eddie'] -= 1
    end

    if LOC('SexSceneStart') = 1:
        gs 'ActUiPrepare', 'Продолжить вечер с Бекки', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SexSceneStart', 'becky', 'BeckyHomeAfterSex', 'becky_repeat'
        end
    else:
        gs 'ActUiPrepare', 'Вернуться на рынок', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Market'
        end
    end
---

#BeckyEddieHomeOpenLatch

    if BeckyPriestOk = 0 and BeckyVar['PriestAdvice'] < 3:
        gt 'BeckyEddieHomeFail'
    end

    BeckyVar['PriestAdvice'] = 3
    gt 'BeckyEddieHomeStep1'
---

#BeckyEddieHomeFail

    SceneArtUseReal = 1
    gs 'BeckyEddieHomeFailText'

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПРОВАЛ'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/becky_eddie_home_fail', 'ПРОВАЛ', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    BeckyEddieHomeFailed = 1
    BeckyVar['EddieTryToFuck'] = 2
    BeckyVar['EddieFailures'] += 1

    if Friends['becky'] > 3:
        Friends['becky'] -= 3
    end

    if Friends['eddie'] > 5:
        Friends['eddie'] -= 5
    end

    if sluttiness['becky'] > 25:
        sluttiness['becky'] -= 3
    end

    gs 'ActUiPrepare', 'Вернуться на рынок', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#BeckyEddieHomeStep1

    SceneArtUseReal = 1
    gs 'BeckyEddieHomeStep1Text'

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'СЦЕНА С ЭДДИ — НАЧАЛО'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/becky_eddie_home_step1', 'СЦЕНА С ЭДДИ — НАЧАЛО', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    gs 'ActUiPrepare', 'Продолжить', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyEddieHomeStep2'
    end
---

#BeckyEddieHomeStep2

    SceneArtUseReal = 1
    gs 'BeckyEddieHomeStep2Text'

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/becky_eddie_home_step2', 'Бекки/Эдди: дом, шаг 2', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    gs 'ActUiPrepare', 'Продолжить', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyEddieHomeStep3'
    end
---

#BeckyEddieHomeStep3

    SceneArtUseReal = 1
    gs 'BeckyEddieHomeStep3Text'

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/becky_eddie_home_step3', 'Бекки/Эдди: дом, шаг 3', 'large', 'webp'
    *p $EddieArcText
    *pl ' '

    gs 'ActUiPrepare', 'Кивнуть Эдди — уважить просьбу Бекки', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'BeckyEddieHomeFinishInsideText'
        *p $EddieArcText
        gs 'BeckyEddieHomeFinish'
        gt 'BeckyEddieHomeAfter'
    end

    gs 'ActUiPrepare', 'Показать глазами — пусть кончает куда хочет', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'BeckyEddieHomeFinishOutsideText'
        *p $EddieArcText
        gs 'BeckyEddieHomeFinish'
        gt 'BeckyEddieHomeAfter'
    end
---

#BeckyEddieHomeFinish

    cuminside['becky'] += 1

    sluttiness['becky'] += 5
    otkroven['becky'] += 2
    Friends['becky'] += 1
    Friends['eddie'] += 5

    if BeckyHomeStage < 5:
        BeckyHomeStage = 5
    end

    BeckyEddieDone = 1
    BeckyVar['EddieTryToFuck'] = 4

    if BeckyPriestOk = 1 or BeckyVar['PriestAdvice'] >= 3:
        BeckyPriestArcOpen = 1
    end
---

#BeckyEddieHomeAfter

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОСЛЕ'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/becky_eddie_home_after', 'ПОСЛЕ', 'large', 'webp'
    *p 'Ночь в доме Бекки больше не будет прежней.'
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться на рынок', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#ProcessEddieMomBackground

    EddieMomNightShown = 0

    if BeckyEddieDone = 0:
        exit
    end

    if RAND(1, 4) <> 1:
        exit
    end

    gs 'EddieMomBackgroundText'
    EddieMomNightShown = 1
    $LastDayBackgroundEvent = $EddieMomNightText
---
