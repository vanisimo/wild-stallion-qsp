---

#BeckyEddieHomeStep3

    SceneArtUseReal = 1
    gs 'BeckyEddieHomeStep3Text'

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/becky_eddie_home_step3', 'Бекки/Эдди: дом, шаг 3', 'large', 'webp'
