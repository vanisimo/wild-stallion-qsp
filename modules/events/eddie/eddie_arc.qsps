    gs 'ActUiPrepare', 'Показать глазами — пусть кончает куда хочет', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gs 'BeckyEddieHomeFinishOutsideText'
        *p $EddieArcText
        gs 'BeckyEddieHomeFinish'
        gt 'BeckyEddieHomeAfter'
    end
---

#BeckyEddieHomeFinish

    cuminside['becky'] += 1

    sluttiness['becky'] += 5
    otkroven['becky'] += 2
    Friends['becky'] += 1
    Friends['eddie'] += 5

    if BeckyHomeStage < 5:
        BeckyHomeStage = 5
    end

    BeckyEddieDone = 1
    BeckyVar['EddieTryToFuck'] = 4

    if BeckyPriestOk = 1 or BeckyVar['PriestAdvice'] >= 3:
        BeckyPriestArcOpen = 1
    end
---

#BeckyEddieHomeAfter

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОСЛЕ'
    gs 'SceneShowVisual', 'images/events/eddie/eddie_arc/becky_eddie_home_after', 'ПОСЛЕ', 'large', 'webp'
