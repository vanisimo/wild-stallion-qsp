#SandraDraupnirFridayDoorBurstResolveText
    $SandraDraupnirChoiceKey = LCASE($ARGS[0])

    if $SandraDraupnirChoiceKey = 'humor':
        *pl 'Ты опираешься плечом о дверной косяк и скрещиваешь руки на груди. Ухмылка сама лезет на лицо.'
        *pl ' '
        *pl '— Так вот почему у нас в трактире полы не скрипят. Особый присмотр за столяром по пятницам.'
        *pl ' '
        *pl 'Сандра прикрывает глаза ладонью. Плечи её вздрагивают — то ли от стыда, то ли от сдавленного смешка.'
        *pl ' '
        *pl '— Стефан, чтоб тебя...'
        *pl ' '
        *pl 'Драупнир закидывает голову, и его раскатистый хохот заполняет комнату. Косы бороды трясутся.'
        *pl ' '
        *pl '— А я что говорил! — грохочет он, глядя на Сандру. — Смышлёный у тебя парень. Глазастый. Всё видит, шельмец.'
    elseif $SandraDraupnirChoiceKey = 'strict':
        *pl 'Ты шагаешь в комнату, возвышаясь над гномом. Смотришь на мать в упор.'
        *pl ' '
        *pl '— Давно? — спрашиваешь сухо, по-хозяйски. — Давно скрываешь эти пятничные визиты?'
        *pl ' '
        *pl 'Сандра выпрямляется у кровати. Она оглаживает фартук, расправляя складки, и встречает твой взгляд прямо. Голос звучит тихо, но твёрдо.'
        *pl ' '
        *pl '— Не хотела пересудов. И скандала на весь трактир. Ты теперь хозяин, сам понимаешь.'
        *pl ' '
        *pl 'Драупнир выступает вперёд. Макушкой он тебе по плечо, но стоит крепко, как скала. Смотрит исподлобья.'
        *pl ' '
        *pl '— Таились ради её имени, Стефан. Не со зла. Но ты хозяин дома, — он делает паузу, и голос его гудит ровно, без дрожи. — Имеешь право знать правду.'
    else:
        *pl 'Твой взгляд невольно цепляется за смятую постель. Ты тут же отводишь глаза в сторону, чувствуя, как загораются кончики ушей.'
        *pl ' '
        *pl '— Извините, — бросаешь коротко. — Не мешаю.'
        *pl ' '
        *pl 'Ты выходишь в сени и плотно прикрываешь за собой дверь. Секундная заминка за спиной, а потом — тихий, прерывистый выдох Сандры. Ты стоишь в темноте, прислонившись спиной к шершавой стене, и переводишь дух.'
    end

    killvar '$SandraDraupnirChoiceKey'
---

#SandraDraupnirFridayInterceptText
    if FamilyCorruptionStage <= 1:
        *pl 'Ты ждёшь в тени у бочек на заднем дворе. На улице свежо и темно. Минут через двадцать боковая дверь из спальни приоткрывается бесшумно.'
        *pl ' '
        *pl 'Сандра выскальзывает наружу. Она поправляет волосы и одёргивает фартук, не замечая тебя. Ты выступаешь из темноты ей навстречу.'
        *pl ' '
        *pl '— За специями для бульонов ходила? — спрашиваешь вполголоса.'
        *pl ' '
        *pl 'Мать вздрагивает всем телом. Она хватает тебя за рукав мёртвой хваткой и притягивает ближе. В глазах — испуг пополам с мольбой.'
        *pl ' '
        *pl '— Ради Ильматера, Стефан, — шепчет она горячо. — Дома — ни слова. Ни полслова.'
        *pl ' '
        *pl 'Она тянет тебя за угол, в сторону дома, не давая и рта раскрыть.'
    else:
        *pl 'Ты ждёшь, привалившись плечом к бочке. Дверь скрипит — Сандра выходит, поправляя сбившуюся причёску. Щёки раскраснелись, но шаг лёгкий.'
        *pl ' '
        *pl 'Ты выступаешь из-за бочек с усмешкой.'
        *pl ' '
        *pl '— Опять за специями ходила?'
        *pl ' '
        *pl 'Она вздрагивает, но тут же фыркает. Усталая полуулыбка трогает её губы.'
        *pl ' '
        *pl '— Не суй нос в мои пятницы, Стефан, — осаживает она тебя без злобы. — Оба взрослые. Иди давай, домой.'
        *pl ' '
        *pl 'Она идёт рядом с тобой через двор, уже без страха и лишнего стыда, лишь поправляя ворот платья.'
    end
