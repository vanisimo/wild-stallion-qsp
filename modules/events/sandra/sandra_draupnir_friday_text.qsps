#SandraDraupnirFridayShopText
    if week = 5 and time = 4 and $GirlLocation['sandra'] = 'DraupnirShop':
        $SandraDraupnirShopText = 'Из закрытой на засов мастерской слышны приглушённые голоса и тихие женские вздохи. Драупнир говорит неторопливо и басовито, а второй голос — знакомый, тёплый, мамин — отвечает ему так ласково и тиховато, как на кухне она отродясь ни с кем не говорила.'
    else:
        $SandraDraupnirShopText = 'В мастерской Драупнира повсюду свежая дубовая стружка, банки со смолой да воском. Коренастый гном-столяр опирается о верстак, прищуриваясь на тебя из-под густых бровей.'
    end
---

#DraupnirUpgradesLockedText
    gs 'PrintMainLine', 'Драупнир даже не отрывает взгляд от дубовой заготовки, оглаживая её сильной мозолистой ладонью.'
    gs 'PrintMainLine', '— Крупные работы для трактира? Не сейчас, хозяин. Срочный ремонт, петли, полки — это сделаю. А остальное пока подождёт.'
---

#SandraDraupnirFridayPeekText
    $SandraDraupnirFridayPeekText = 'Ты прижимаешься глазом к узкой щели деревянных ставен. Картинка внутри заставляет тебя онеметь:'
    $SandraDraupnirFridayPeekText += '<br><br>Твоя строгая мать, хранительница устоев и морали дома, восседает прямо на дубовом верстаке с задорно приподнятыми пышными юбками! А крепкий, широкоплечий гном Драупнир уверенно держит её за бёдра, пока Сандра с жаром целует его в губы и сладостно вздыхает.'
    $SandraDraupnirFridayPeekText += '<br><br>— Ох, Драупнир, милый… — шепчет мать, прижимая гнома к своей груди.'
    $SandraDraupnirFridayPeekText += '<br><br>Ты отстраняешься от окна, переводя дыхание: твоя мать — не просто бессменный кухонный страж, а живая, горячая женщина со своими взрослыми тайнами.'
---

#SandraDraupnirFridayPrintText
    $DraupnirTextId = $ARGS[0]

    if $DraupnirTextId = 'draupnir_spy_screen':
        if SandraDraupnirSpyStep = 1:
            *pl 'Ты приникаешь глазом к узкой щели деревянных ставен мастерской.'
            *pl ' '
            *pl 'В полумраке помещения на широкой кровати у столярного верстака расположилась Сандра. В её движениях видна полная расслабленность и открытость.'

            if SandraNoPantiesToday = 1:
                *pl ' '
                *pl 'Подняв подол платья к поясу, Сандра демонстрирует совершенно голое тело ниже талии — она опять пришла к гному без белья.'
                *pl 'Драупнир с озорной ухмылкой проводит мозолистой ладонью по её чистой, гладкой ложбинке:'
                *pl '— Опять без белья прибежала, матушка? Ну ты и сластёна...'
            else:
                *pl ' '
                *pl 'Сандра привычным движением стягивает бельё до колен и откладывает его на край верстака.'
                *pl 'Драупнир прижимает её бёдра, готовясь войти.'
            end

            *pl ' '
            if SandraCorruptionStage = 1 or SandraDraupnirRandomPose = 1:
                *pl 'Сандра ложится на спину, широко расставив ноги. Коренастый гном устраивается поверх неё, погружая лицо в её пышную, горячую грудь.'
                *pl 'Сочные шлепки плоти о плоть раздаются по всей мастерской. Сандра сладостно стонет, прижимая голову гнома к своим грудям и принимая его глубокие, сильные толчки.'
            else:
                *pl 'Сандра встаёт на колени прямо на кровати, упираясь локтями в подушки и прогибая поясницу.'
                *pl 'Драупнир упирается ногами в пол и встаёт сзади, крепко сжимая её пышные ягодицы.'
                *pl 'Он ритмично и глубоко вбивается в её влагалище сзади. Сандра прогибается ниже, с трудом сдерживая громкие стоны.'
            end

        elseif SandraDraupnirSpyStep = 2:
            if SandraCorruptionStage = 1:
                *pl 'Драупнир ускоряет темп, издавая хриплое гномье рычание.'
                *pl 'Он изливается мощными, горячими струями семени глубоко внутрь её влагалища.'
                *pl 'Сандра с выдохом обнимает гнома ногами за талию, принимая всё его семя до последней капли.'
            else:
                *pl 'Закончив первый сет вагинального секса, Драупнир присаживается на край кровати.'
                *pl 'Сандра без лишних просьб опускается перед ним на колени, обхватывая губами его мокрый от соков член и увлечённо отсасывая.'
                *pl 'Она глубоко принимает его плоть в рот, лаская головку языком.'
            end

        elseif SandraDraupnirSpyStep = 3:
            *pl 'Драупнир поднимает Сандру обратно на кровать и снова входит в её горячее, распалённое лоно.'
            *pl 'Спустя десяток мощных толчков гном глухо рычит и обильно кончает вагинально, заполняя её изнутри горячей спермой.'
            *pl 'Сандра блаженно прижмуривается, чувствуя, как семя гнома наполняет её лоно.'
        end
    end

    killvar '$DraupnirTextId'
---

#SandraDraupnirFridayDoorBurstText
    *pl 'Ты уверенно толкаешь боковую дверь мастерской — дубовое полотно со скрипом отходит в сторону!'
    *pl ' '
    *pl 'Сандра в испуге ахает, моментально сдёргивая подол платья вниз и наливаясь пунцовым румянцем до самых ушей. Драупнир утирает пот со лба тяжёлой ладонью, опускает деревянный молот и спокойно встречает твой взгляд своими карими глазами:'
    *pl ' '
    *pl '— Стефан?! Ты… что ты тут делаешь?! — заикаясь, выдыхает мать.'
---

#SandraDraupnirFridayDoorBurstResolveText
    $SandraDraupnirChoiceKey = LCASE($ARGS[0])

    if $SandraDraupnirChoiceKey = 'humor':
        *pl 'Ты с лёгкой плутовской ухмылкой опираешься о дверной косяк:'
        *pl '— А я-то в трактире всё гадал, отчего у нас дубовые скамьи да полы так идеально подогнаны… Оказывается, столяр под особым присмотром работает!'
        *pl ' '
        *pl 'Сандра прикрывает лицо обеими ладонями, готовая провалиться сквозь землю от смущения. Зато Драупнир добродушно и громко хохочет, упирая руки в бока:'
        *pl '— Ладно тебе, Сандра! Парень-то у тебя смышлёный, статный хозяин — всё видит! Нечего от него таиться.'
    elseif $SandraDraupnirChoiceKey = 'strict':
        *pl 'Ты делаешь шаг вперёд и спрашиваешь строго, со всей солидностью хозяина трактира:'
        *pl '— И давно вы от меня это скрываете, матушка?'
        *pl ' '
        *pl 'Сандра виновато опускает взгляд и тихо оглаживает фартук:'
        *pl '— Стефанчик… извини. Мы не хотели скандала в доме.'
        *pl ' '
        *pl 'Драупнир выступает вперёд и с уважением кивает тебе:'
        *pl '— Твоя правда, хозяин. Скрывали, потому как за репутацию дома переживали. Но ты вырос — и имеешь право знать.'
    else:
        *pl 'Ты смущённо делаешь шаг назад:'
        *pl '— Извините… не буду вам мешать, — и быстро прикрываешь дверь.'
        *pl ' '
        *pl 'Сандра с тихим вздохом облегчения оправляет платье, а за закрытыми дверями снова возобновляется их разговор.'
    end

    killvar '$SandraDraupnirChoiceKey'
---

#SandraDraupnirFridayInterceptText
    *pl 'Ты тихо отходишь в сторону и устраиваешься в тени за дубовыми бочками неподалёку от мастерской.'
    *pl ' '
    *pl 'Минут через двадцать тяжёлая дверь тихо отворяется, и на порог выходит Сандра. Она тщательно оглаживает свой фартук, поправляет выбившиеся локоны и прижимает к груди ладони — её щёки всё ещё пылают румянцем, а на губах застыла счастливая улыбка.'
    *pl ' '
    *pl 'Ты выходишь из тени прямо ей навстречу:'
    *pl '— Специи для кухонных бульонов проверяла, Сандра?'
    *pl ' '
    *pl 'Мать вздрагивает, хапает ртом воздух и вспыхивает до самых ушей:'
    *pl '— Стефанчик! Ты… видит Ильматер, только никому в доме не говори! — смущённо шепчет она, увлекая тебя по тёмной улочке в сторону дома.'
---
