#SandraDraupnirFridayShopText
    if week = 5 and time = 4 and $GirlLocation['sandra'] = 'DraupnirShop':
        $SandraDraupnirShopText = 'Из закрытой на засов спальни за мастерской слышны приглушённые голоса и тихие женские вздохи. Драупнир говорит неторопливо и басовито, а второй голос — знакомый, тёплый, мамин — отвечает ему так ласково и тиховато, как на кухне она отродясь ни с кем не говорила.'
    else:
        $SandraDraupnirShopText = 'Ты заходишь в мастерскую. Под ногами хрустит стружка, в воздухе висит пыльца, танцующая в луче света из окна. На верстаке, среди банок с воском и мутной смолой, лежит свежеструганная доска.<br><br>Коренастый гном опирается о край верстака и щурится на тебя из-под кустистых бровей. Густая борода, заплетённая в косы, чуть подрагивает.<br><br>— А, хозяин. Гляди сюда, — гудит он басом и проводит ладонью по доске. — Дуб. Ещё три таких — и столешница в общий зал готова будет. Что хотел?'
    end
---

#DraupnirUpgradesLockedText
    gs 'PrintMainLine', 'Драупнир проводит широкой ладонью по дубовой доске, смахивая невидимую пылинку.'
    gs 'PrintMainLine', '— Крупное пока не проси, Стефан, — басит он, не поднимая глаз. — Мелкий ремонт сделаю, петли подтяну, а пристройки подождут. Руки пока не доходят.'
---

#SandraDraupnirFridayPeekText
    $SandraDraupnirFridayPeekText = 'Ты приникаешь к щели деревянных ставен и замираешь.'
    $SandraDraupnirFridayPeekText += '<br><br>Сандра сидит на краю кровати с задранной юбкой, а коренастый гном Драупнир держит её за бёдра и жадно целует в губы. Мать прижимает его голову к груди и прерывисто вздыхает.'
    $SandraDraupnirFridayPeekText += '<br><br>Ты отступаешь от окна, переводя дыхание: строгий страж кухни живёт по пятницам совсем другой жизнью.'
---

#SandraDraupnirFridayPrintText
    $DraupnirTextId = $ARGS[0]

    if $DraupnirTextId = 'draupnir_spy_screen':
        if SandraDraupnirSpyStep = 1:
            *pl 'Ты приникаешь к узкой щели деревянных ставен спальни гнома.'
            *pl ' '

            if SandraNoPantiesToday = 1:
                *pl 'Сандра сидит на краю широкой дубовой кровати, расправив юбки вокруг бёдер. Ты видишь через щель в ставнях, как она без тени смущения подхватывает подол и тянет вверх — ткань ползёт по полным коленям, открывая гладкую кожу бёдер. Под платьем ничего нет. Драупнир стоит перед ней на полу, и при её посадке на высокой кровати его лицо оказывается почти вровень с её грудью.'
                *pl '— «Знала, к кому шла», — произносит он низким голосом, и его толстые пальцы ложатся на её колени.'
                *pl 'Он разводит их в стороны, притискиваясь между бёдер. Одна ладонь скользит по внутренней стороне бедра вверх, к влажной гладкой коже лона. Сандра выдыхает сквозь зубы и подаётся бёдрами вперёд. Драупнир ведёт пальцами по складкам — медленно, с нажимом, — и усмехается в бороду.'
                *pl '— «Без белья. Специально ведь».'
                *pl 'Сандра кладёт ладонь ему на плечо и сжимает. Ты замечаешь, как её пальцы впиваются в грубую ткань его рубахи. Гном не торопится: он разводит складки большим пальцем, трёт круговым движением, заставляя её бедро дрогнуть. Свет лампы на тумбе бросает тёплые блики на её голые колени и на его широкие предплечья.'
                *pl '— «Хватит дразнить», — говорит она тихо, но твёрдо.'
                *pl 'Драупнир поднимает голову. Его заплетённые косы бороды качаются. Он пододвигается вплотную, упирается бёдрами в край кровати, и его ладони обхватывают её за ягодицы. Сандра откидывается на локтях, приподнимая таз. Ты видишь, как его короткие сильные ноги упираются в половицы, а руки притягивают её ближе — и вот уже головка упирается в мокрую гладкую кожу.'
                *pl 'Он входит одним толчком — резко, до упора. Сандра вскрикивает коротко и тут же зажимает рот ладонью. Её бёдра сжимают его корпус, юбки сбиваются на поясе. Драупнир держит её за ягодицы и начинает двигаться — размеренно, с хриплым выдохом на каждый толчок. Ты видишь, как напрягаются мышцы на его толстой шее и как пальцы Сандры комкают покрывало.'
            else:
                *pl 'Сандра садится на край кровати и тянет вниз бельё — простая светлая ткань скользит по полным бёдрам, задерживается на коленях. Она стягивает его до щиколоток и небрежно отбрасывает в сторону. Бельё падает на крышку дубового сундука у изножья, сминается там светлой тряпицей. Ты видишь, как она расправляет юбки и кладёт ладони на колени.'
                *pl 'Драупнир стоит перед кроватью. Он упирается ладонями ей в колени и разводит их — медленно, с нажимом. Его рост таков, что лицо оказывается чуть ниже её груди. Он подаётся вперёд и зарывается лицом ей в живот — жёсткая борода скользит по ткани платья, а затем по голой коже, когда он поднимает подол выше. Сандра кладёт руку ему на затылок, перебирая пальцами косицы.'
                *pl '— «Терпеливый», — произносит она с короткой усмешкой.'
                *pl 'Он целует кожу у пупка, ведёт губами ниже. Его большой палец ложится на гладкую промежность и проводит вдоль складок — один раз, второй, размазывая влагу. Сандра шумно втягивает воздух и раздвигает бёдра шире. Драупнир поднимает голову, его тёмные глаза блестят в свете лампы.'
                *pl '— «Ложись».'
                *pl 'Она откидывается на спину, подтягивает колени к груди. Гном забирается на кровать следом — матрас прогибается под его коренастым телом. Он устраивается между её бёдер, упираясь ладонями в матрас по бокам от её талии. Ты видишь, как его косы свешиваются вниз и касаются её живота. Он опускает взгляд на её лоно, ведёт пальцами по влажной коже — и наклоняется, чтобы поцеловать её чуть ниже пупка, прежде чем пристроиться войти.'
            end

            *pl ' '
            if SandraCorruptionStage = 1 or SandraDraupnirRandomPose = 1:
                *pl 'Сандра лежит на спине поперёк широкой кровати, подтянув колени к груди и широко разведя бёдра. Лоскутное одеяло сбито под ней в складки. Драупнир забирается на матрас на коленях и пододвигается между её ног. При его росте лицо оказывается ровно на уровне её пышной груди — не выше и не ниже.'
                *pl 'Он кладёт мозолистые ладони на её груди и сжимает. Пальцы утопают в мягкой плоти. Сандра выгибает спину, подаваясь навстречу. Гном наклоняет голову и прихватывает губами сосок — тянет, отпускает, обводит языком. Его заплетённая борода щекочет кожу, и Сандра ёжится, запуская пальцы ему в волосы.'
                *pl '— «Не щади», — говорит она тихо.'
                *pl 'Он входит — глубоко, размеренно. Бёдра Сандры вздрагивают, она обхватывает его торс ногами. Драупнир начинает двигаться: короткие сильные толчки, от которых матрас ритмично поскрипывает. Его ноги упираются в матрас, мышцы на пояснице напрягаются при каждом движении. Ты видишь, как он сжимает её груди ладонями, мнёт их, пока бёдра вбиваются в неё снова и снова.'
                *pl 'Сандра прижимает его голову к груди, перебирая косицы бороды. Её дыхание сбивается на частые выдохи. Гном ускоряет темп — теперь толчки идут чаще, жёстче, и она закусывает губу, чтобы не застонать в голос. Её пальцы скользят по его широким плечам, оставляя белые следы ногтей на коже. Ты видишь, как двигаются их тела — он вколачивается в неё, она подаётся бёдрами навстречу, и лампа на тумбе отбрасывает на стену их слитную тень.'
            else:
                *pl 'Сандра опускается на колени на толстый ковёр у края кровати. Она опирается грудью и локтями на матрас, прогибая поясницу и выставляя широкие бёдра вверх. Юбки задраны на поясницу, открывая гладкие ягодицы. При таком положении её бёдра оказываются ровно на высоте паха стоящего гнома — идеальное совпадение, будто кровать строили под их рост.'
                *pl 'Драупнир становится прямо за ней. Его мозолистые ладони ложатся на её бёдра и сжимают — пальцы утопают в мягкой плоти. Он притягивает её к себе и входит одним сильным толчком. Звук удара — влажный, глухой — разносится по спальне. Сандра вскрикивает и тут же зажимает рот ладонью, вторая рука комкает покрывало.'
                *pl 'Он начинает двигаться — ритмично, с силой. Каждый толчок отдаётся шлепком, её ягодицы вздрагивают от ударов его бёдер. Сандра утыкается лицом в сгиб локтя, глуша стоны. Её поясница прогибается глубже, она подаётся назад, насаживаясь на него. Ты видишь, как напрягаются мышцы на её спине и как пальцы босых ног поджимаются на ковре.'
                *pl 'Драупнир наращивает темп. Его короткие сильные ноги упираются в пол, руки держат её за бёдра мёртвой хваткой. Косы бороды раскачиваются в такт движениям. Сандра уже не сдерживается — сквозь прижатую ладонь прорываются частые всхлипы. Она трётся щекой о покрывало, сжимает ткань в кулаке и выгибается сильнее, принимая его глубже. Гном рычит что-то низкое сквозь зубы и вбивается в неё ещё жёстче, и лампа на тумбе подрагивает от ритмичных толчков.'
            end

        elseif SandraDraupnirSpyStep = 2:
            if SandraCorruptionStage = 1:
                *pl 'Драупнир рычит сквозь стиснутые зубы — низкий, утробный звук, от которого пламя лампы будто вздрагивает. Его толстые пальцы впиваются в бёдра Сандры, притягивают резче, жёстче. Ритм ломается, перестаёт быть размеренным — теперь это частые, рваные удары снизу вверх, от которых её пышная грудь колышется в такт, а с губ срывается сбитое дыхание. Ты видишь в щель ставен, как напрягаются мышцы на его короткой шее, как вздуваются жилы на широких плечах. Кровать поскрипывает жалобно и часто, словно вторя этому нарастающему темпу.'
                *pl 'Сандра обхватывает его за плечи, прижимается щекой к макушке — её пальцы скользят по потной коже, сжимаются на трапециях. «Давай... давай же», — выдыхает она хрипло, и это не просьба, а подгоняющий шёпот. Драупнир вдавливается до упора — ещё, и ещё, и ещё — пока его бёдра не прижимаются к её разведённым ногам плотно, без зазора. Он замирает на долю секунды, а потом с гулким стоном изливается глубоко внутрь — горячими, пульсирующими толчками, от которых Сандра вздрагивает всем телом и сильнее стискивает его плечи.'
                *pl 'Ты слышишь, как она всхлипывает — не от боли, от накатившей разрядки — и утыкается лицом в его спутанные волосы. Её бёдра мелко дрожат, прижимаются к нему ещё теснее, принимая всё до последней капли. Драупнир тяжело дышит в ложбинку меж её грудей, его борода щекочет влажную от испарины кожу. Несколько долгих мгновений они не двигаются — только грудные клетки ходят ходуном, только пальцы медленно разжимаются, отпуская натруженные мышцы. Сандрин шёпот едва различим: «Хороший мой...», и её ладонь гладит его по затылку — нежно, почти по-матерински.'
            else:
                *pl 'Драупнир отстраняется первым — с влажным, непристойным звуком разрывает их соединение и тяжело опускается на край кровати. Его ноги не достают до пола, пятки висят над ковром. Он шумно переводит дух, запускает пятерню в косы бороды, а взгляд его — затуманенный, но цепкий — следит за Сандрой. Она поднимается с ковра неторопливо, с ленивой грацией, и ты замечаешь на её губах ухмылку — не стыдливую, а понимающую, предвкушающую. Она опускается на колени меж его разведённых бёдер, и теперь её лицо оказывается ровно напротив его паха — мокрого, блестящего от их общих соков.'
                *pl 'Её ладонь ложится на его ствол уверенно, по-хозяйски. Пальцы обхватывают влажную плоть, скользят от основания к головке, собирая белёсую влагу. Сандра наклоняется ближе, и её язык касается самой вершинки — пробует, слизывает солоноватую каплю, медленно обводит разгорячённую головку по кругу. Драупнир шумно втягивает воздух сквозь зубы, его толстые пальцы сами тянутся к её растрёпанным волосам, зарываются в них, но не давят — пока лишь поглаживают. «Не томи, женщина», — хрипит он, но в голосе больше восхищения, чем приказа.'
                *pl 'Она принимает его в рот — не сразу глубоко, а постепенно, смакуя. Губы плотно обхватывают ствол, щёки втягиваются, и она начинает ритмично двигаться: вперёд-назад, то ускоряясь, то замедляясь на самой головке, чтобы обвести её языком. Её взгляд — снизу вверх, прямо ему в глаза — откровенный и жадный. Драупнир глухо стонет, его бёдра непроизвольно подаются навстречу, а пальцы в её волосах сжимаются крепче. «Вот так... умница...» — выдыхает он, откидывая голову, но почти сразу снова смотрит вниз, не в силах оторваться от зрелища её губ, скользящих по его плоти.'
            end

        elseif SandraDraupnirSpyStep = 3:
            *pl 'Он не даёт ей довести до конца — рывком поднимает с ковра, за плечи, и толкает к кровати. Сандра падает на спину с коротким смешком, её бёдра оказываются на самом краю, ноги сами разводятся в стороны. Драупнир встаёт между них на полу — его рост теперь идеально совпадает с уровнем её лона. Никаких прелюдий, никаких ласк — он входит сразу, одним глубоким, мощным толчком, и Сандра вскрикивает, запрокидывая голову. Её пальцы вцепляются в одеяло, сминают грубую ткань, пока он задаёт темп — быстрый, жёсткий, безжалостный.'
            *pl 'Шлепки раздаются влажные и частые — его бёдра бьются о её разведённые ноги, плоть входит до упора и выскальзывает почти полностью, чтобы снова вонзиться глубоко. Сандра стонет в голос, коротко и хрипло, её грудь подпрыгивает от каждого толчка, а ладони мечутся — то хватаются за его косы, притягивая ближе, то снова комкают одеяло. «Глубже... Ильматер, глубже...» — вырывается у неё, и Драупнир рычит в ответ, ускоряясь так, что пламя лампы колеблется от движения воздуха.'
            *pl 'Его финиш накатывает внезапно и мощно. Он вжимается в неё до предела, замирает на миг — и с утробным стоном изливается внутрь, горячо и густо. Ты видишь, как Сандра выгибается навстречу, как её бёдра дрожат и сжимаются вокруг него, как по внутренней стороне её бедра медленно стекает белёсая капля. Драупнир тяжело наваливается на неё, упираясь лбом в ложбинку груди, его дыхание — хриплое, рваное. Сандра обнимает его за голову, гладит по спутанным косам, и её губы шепчут что-то неразборчивое — то ли благодарность, то ли ласку. Её ноги медленно соскальзывают с его поясницы, обессиленно падают на кровать.'
        end
    end

    killvar '$DraupnirTextId'
---

#SandraDraupnirFridayDoorBurstText
    if FamilyCorruptionStage <= 1:
        *pl 'Ты толкаешь боковую дверь в конце коридора. Петли взвизгивают.'
        *pl ' '
        *pl 'В спальне горит тёплая лампа. Ты видишь кровать со смятым одеялом, тяжёлый сундук у стены и ковёр на полу. Сандра вскакивает с кровати, судорожно одёргивая задравшиеся юбки. Вырез на платье сбит, она пытается поправить его дрожащими пальцами. Лицо заливается густой краской.'
        *pl ' '
        *pl '— Стефан! — вскрикивает она, и голос срывается.'
        *pl ' '
        *pl 'Невысокий Драупнир стоит у кровати. Он не суетится. Медленно застёгивает ремень на поясе, поправляет сползшую косу бороды и поднимает на тебя спокойный взгляд. Он молчит, ожидая, что скажешь ты.'
        *pl ' '
        *pl 'Ты стоишь в дверях, и в тишине слышно только, как потрескивает фитиль лампы.'
    else:
        *pl 'Дверь в спальню распахивается от твоего плеча, глухо ударившись о стену.'
        *pl ' '
        *pl 'Сандра сидит на краю кровати. Она быстро натягивает платье на плечи и одёргивает подол до щиколоток. Щёки раскраснелись, но паники в глазах нет. Она зло прикусывает губу и бросает на тебя колючий взгляд.'
        *pl ' '
        *pl '— Хозяин трактира, видит Ильматер, мог бы и стучаться для приличия.'
        *pl ' '
        *pl 'Драупнир стоит на ковре рядом с ней. Он неторопливо затягивает ремень и, задрав голову, смотрит на тебя снизу вверх. В седеющей бороде прячется кривая усмешка.'
        *pl ' '
        *pl '— Не ко времени ты заглянул, парень, — гудит он своим басом.'
    end
