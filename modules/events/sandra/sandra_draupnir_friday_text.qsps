#SandraDraupnirFridayShopText
    if week = 5 and time = 4 and $GirlLocation['sandra'] = 'DraupnirShop':
        $SandraDraupnirShopText = 'Из закрытой на засов мастерской слышны приглушённые голоса и тихие женские вздохи. Драупнир говорит неторопливо и басовито, а второй голос — знакомый, тёплый, мамин — отвечает ему так ласково и тиховато, как на кухне она отродясь ни с кем не говорила.'
    else:
        $SandraDraupnirShopText = 'Мастерская Драупнира пахнет свежей дубовой стружкой, смолой да воском. Коренастый гном-столяр опирается о верстак, прищуриваясь на вас из-под густых бровей.'
    end
---

#DraupnirUpgradesLockedText
    gs 'PrintMainLine', 'Драупнир даже не отрывает взгляд от дубовой заготовки, оглаживая её сильной мозолистой ладонью.'
    gs 'PrintMainLine', '— Крупные работы для трактира? Не сейчас, хозяин. Срочный ремонт, петли, полки — это сделаю. А остальное пока подождёт.'
---

#SandraDraupnirFridayPeekText
    $SandraDraupnirFridayPeekText = 'Вы прижимаетесь глазом к узкой щели деревянных ставен. Картинка внутри заставляет вас онеметь:<br>Ваша строгая мать, хранительница устоев и морали дома, восседает прямо на дубовом верстаке с задорно приподнятыми пышными юбками! А крепкий, широкоплечий гном Драупнир уверенно держит её за бёдра, пока Сандра с жаром целует его в губы и сладостно вздыхает.<br>"Ох, Драупнир, милый…" — шепчет мать, прижимая гнома к своей груди.<br>Вы отстраняетесь от окна, переводя дыхание: ваша мать — не просто бессменный кухонный волнорез, а живая, горячая женщина со своими взрослыми тайнами.'
---

#SandraDraupnirFridayDoorBurstText
    $SandraDraupnirFridayText = 'Вы уверенно толкаете боковую дверь мастерской — дубовое полотно со скрипом отходит в сторону!<br>Сандра в испуге ахает, моментально сдёргивая подол платья вниз и наливаясь пунцовым румянцем до самых ушей. Драупнир утирает пот со лба тяжелой ладонью, опускает деревянный молот и спокойно встречает ваш взгляд своими карими глазами.<br>— Стефан?! Ты… что ты тут делаешь?! — заикаясь, выдыхает мать.'
---

#SandraDraupnirFridayDoorBurstResolveText
    $SandraDraupnirChoiceKey = LCASE($ARGS[0])

    if $SandraDraupnirChoiceKey = 'humor':
        $SandraDraupnirFridayText = 'Вы с лёгкой плутовской ухмылкой опираетесь о дверной косяк:<br>— А я-то в трактире всё гадал, отчего у нас дубовые скамьи да полы так идеально подогнаны… Оказывается, столяр под особым присмотром работает!<br>Сандра прикрывает лицо обеими ладонями, готова провалиться сквозь землю от смущения. Зато Драупнир добродушно и громко хохочет, упирая руки в бока:<br>— Ладно тебе, Сандра! Парень-то у тебя смыслёный, статный хозяин — всё видит! Нечего от него таиться.'
    elseif $SandraDraupnirChoiceKey = 'strict':
        $SandraDraupnirFridayText = 'Вы делаете шаг вперёд и спрашиваете строго, со всей солидностью хозяина трактира:<br>— И давно вы от меня это скрываете, матушка?<br>Сандра виновато опускает взгляд и тихо оглаживает фартук: "Стефанчик… извини. Мы не хотели скандала в доме." Драупнир выступает вперёд и с уважением кивает вам: "Твоя правда, хозяин. Скрывали, потому как за репутацию дома переживали. Но ты вырос — и имеешь право знать."'
    else:
        $SandraDraupnirFridayText = 'Вы смущённо делаете шаг назад:<br>— Извините… не буду вам мешать, — и быстро прикрываете дверь.<br>Сандра с тихим вздохом облегчения оправляет платье, а за закрытыми дверями снова возобновляется их разговор.'
    end

    killvar '$SandraDraupnirChoiceKey'
---

#SandraDraupnirFridayInterceptText
    $SandraDraupnirFridayText = 'Вы тихо отходите в сторону и устраиваетесь в тени за большими дубовыми бочками неподалёку от мастерской.<br>Минут через двадцать тяжелая дверь тихо отворяется, и на порог выходит Сандра. Она тщательно оглаживает свой фартук, поправляет выбившиеся локоны и прижимает к груди ладони — её щёки всё ещё пылают румянцем, а на губах застыла счастливая улыбка.<br>Вы выходите из тени прямо ей навстречу:<br>— Специи для кухонных бульонов проверяла, Сандра?<br>Мать вздгивает, хапает ртом воздух и вспыхивает до самых ушей: "Стефанчик! Ты… видит Ильматер, только никому в доме не говори!" — смущённо шепчет она, увлекая вас по тёмной улочке в сторону дома.'
---