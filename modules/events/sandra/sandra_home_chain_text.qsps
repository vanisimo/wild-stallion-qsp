#SandraHomeStepText
    $SandraHomeStepKey = LCASE($ARGS[0])

    if $SandraHomeStepKey = 'goodnight':
        $SandraHomeText = 'Вы задерживаетесь у приоткрытой двери её спальни: "Спокойной ночи, Сандра." Она отрывает взгляд от шитья — глаза её усталые от дневных забот кухни, но удивительно тёплые. "И тебе спокойной ночи, Стефанчик," — тихо говорит мать, откладывая иголку. "Только не засиживайся с счётами до полуночи — тебе завтра трактир открывать."'
    elseif $SandraHomeStepKey = 'sit':
        $SandraHomeText = 'Ты тихо переступаете порог и присаживаетесь на край её кровати. Сандра не отодвигается — лишь внимательно и ласково смеривает вас взглядом: "Ты сегодня какой-то особенный, Стефанчик… Задумал что-то или в зале какая беда стряслась?" — в её тихом голосе слышится материнская забота, за которой сквозит первое неосознанное волнение.'
    elseif $SandraHomeStepKey = 'hug':
        $SandraHomeText = 'Ты осторожно, но уверенно приобнимаете её за плечи. Сандра на мгновение замирает, поражённая вашей смелостью, но затем с тихим вздохом прижимается к вашей груди, будто боится, что кто-то из дочерей за стеной может услышать этот момент близости.'
    elseif $SandraHomeStepKey = 'breast_slip':
        $SandraHomeText = 'Пока вы ласково держите её в объятиях, тонкая лямка ночной рубашки медленно соскальзывает с её округлого плеча, обнажая пышную грудь. Сандра поправляет ткань не сразу — её дыхание прерывается, а на щёках разгорается густой, стыдливый румянец.'
    elseif $SandraHomeStepKey = 'compliment':
        $SandraHomeText = '"Ты очень красивая, Сандра," — говорите вы прямо, глядя ей в глаза. Она смущённо опускает взгляд и прикусывает губу: "Не говори глупостей, Стефанчик… Я же уже не девчонка." Однако дрогнувшие уголки её алых губ выдают, насколько ей приятно слышать эти слова от статного молодого хозяина.'
    elseif $SandraHomeStepKey = 'kiss':
        $SandraHomeText = 'Ваш первый поцелуй заставляет её глубоко вздрогнуть. Сандра отвечает на поцелуй на удивление чувственно и горячо, прижимаясь всем телом, но тут же шёпотом отстраняется на миг: "Только тихо, милый… Девки на этаже ещё чутко спят."'
    elseif $SandraHomeStepKey = 'noticed':
        if SandraCarpenterSecret >= 1:
            $SandraHomeText = 'Взгляд Сандры медленно опускается ниже вашего пояса. Она тяжело вздыхает, пряча лицо: "Ты… совсем взрослый мужик уже. И я вижу это. Ты ведь знаешь мою тайну с Драупниром… Знаешь, какая я на самом деле." Её голос дрожит от смеси стыда и вспыхнувшей женской страсти.'
        else:
            $SandraHomeText = 'Взгляд Сандры на секунду задержался ниже вашего пояса. Она прикусывает губу и судорожно втягивает воздух: "Ты… совсем взрослый уже, плечистый. И я это вижу." Голос матери дрожит от смущения и первого откровенного любопытства.'
        end
    elseif $SandraHomeStepKey = 'help_offer':
        $SandraHomeText = '"Не мучайся так, Стефанчик…" — шепчет Сандра, опустив глаза, но не убирая рук с вашей груди. "Я же женщина опытная… знаю, как мужское тело горит от нерастраченной силы. Если тебе совсем невмоготу — я помогу. Только пусть это останется строго между нами."'
    elseif $SandraHomeStepKey = 'handjob':
        $SandraHomeText = 'Ладонь Сандры действует удивительно ласково и уверенно. Опытная женщина накрывает ваш напряжённый член, водя по нему горячими пальцами, и косится на закрытую дверь спальни: "Давай… быстро и тихо, милый."'
    elseif $SandraHomeStepKey = 'cuni':
        $SandraHomeText = 'Сандра медленно раздвигает пышные бёдра, будто каждое движение — сладостное преступление перед устоями дома. Когда вы прикасаетесь губами и языком к её влажному бутончику, её тело пронзает дрожь. Сильный оргазм сотрясает вдову, и она судорожно прижимает ладонь к вашим губам, сдерживая стон.'
    elseif $SandraHomeStepKey = 'titjob':
        $SandraHomeText = 'Сандра с жарким вздохом расстёгивает корсаж и прижимает свою пышную грудь к вашему члену, лаская его мягкими тёплыми полушариями. "Ах, несытный ты какой, Стефанчик…" — шепчет она, горячо целуя вас в макушку.'
    elseif $SandraHomeStepKey = 'blowjob':
        $SandraHomeText = 'Она бесшумно опускается на колени у кровати и бросает короткий взгляд на дверь. "Только один раз… и никому ни слова," — тихо шепчет Сандра, прежде чем обхватить ваш член губами и принять его в свой тёплый рот.'
    elseif $SandraHomeStepKey = 'presex':
        $SandraHomeText = 'Сандра смотрит вам прямо в глаза горячим, решительным взглядом: "Стефанчик… если мы сейчас перейдём эту последнюю черту — я больше не смогу привторяться перед тобой просто строгой матерью. И видит Ильматер, я сама больше не хочу притворяться!"'
    else:
        $SandraHomeText = 'Между вами повисает напряжённая, сладкая тишина.'
    end

    killvar '$SandraHomeStepKey'
---

#SandraHomeAfterSexText
    $SandraHomeText = 'Сандра поправляет ночную рубашку и не спеша присаживается на край кровати, глядя в окно на ночной город. "Ну вот… теперь между нами нет тайны," — тихо говорит она, прижимаясь плечом к вашей груди. — "И я точно знаю, кем ты стал для меня. Теперь ты настоящий хозяин и мой мужчина."'
