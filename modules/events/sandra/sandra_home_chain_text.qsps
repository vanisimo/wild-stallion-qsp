#SandraHomeStepText
    $SandraHomeStepKey = LCASE($ARGS[0])

    if $SandraHomeStepKey = 'goodnight':
        *pl 'Ты задерживаешься у приоткрытой двери её спальни:'
        *pl '— Спокойной ночи, Сандра.'
        *pl ' '
        *pl 'Она отрывает взгляд от шитья — глаза её усталые от дневных забот на кухне, но удивительно тёплые:'
        *pl '— И тебе спокойной ночи, Стефанчик, — тихо говорит мать, откладывая иголку. — Только не засиживайся со счётами до полуночи — тебе завтра трактир открывать.'

    elseif $SandraHomeStepKey = 'sit':
        *pl 'Ты тихо переступаешь порог и присаживаешься на край её кровати. Сандра не отодвигается — лишь внимательно и ласково смеривает тебя взглядом:'
        *pl '— Ты сегодня какой-то особенный, Стефанчик… Задумал что-то или в зале какая беда стряслась?'
        *pl ' '
        *pl 'В её тихом голосе слышится материнская забота, за которой сквозит первое неосознанное волнение.'

    elseif $SandraHomeStepKey = 'hug':
        *pl 'Ты осторожно, но уверенно приобнимаешь её за плечи. Сандра на мгновение замирает, поражённая твоей смелостью, но затем с тихим вздохом прижимается к твоей груди, будто боится, что кто-то из дочерей за стеной может услышать этот момент близости.'

    elseif $SandraHomeStepKey = 'breast_slip':
        *pl 'Пока ты ласково держишь её в объятиях, тонкая лямка ночной рубашки медленно соскальзывает с её округлого плеча, обнажая пышную грудь.'
        *pl ' '
        *pl 'Сандра поправляет ткань не сразу — её дыхание прерывается, а на щеках разгорается густой, стыдливый румянец.'

    elseif $SandraHomeStepKey = 'compliment':
        *pl '— Ты очень красивая, Сандра, — говоришь ты прямо, глядя ей в глаза.'
        *pl ' '
        *pl 'Она смущённо опускает взгляд и прикусывает губу:'
        *pl '— Не говори глупостей, Стефанчик… Я же уже не девчонка.'
        *pl ' '
        *pl 'Однако дрогнувшие уголки её губ выдают, насколько ей приятно слышать эти слова от статного молодого хозяина.'

    elseif $SandraHomeStepKey = 'kiss':
        *pl 'Ваш первый поцелуй заставляет её глубоко вздрогнуть. Сандра отвечает на удивление чувственно и горячо, прижимаясь всем телом, но тут же шёпотом отстраняется на миг:'
        *pl '— Только тихо, милый… Девки на этаже ещё чутко спят.'

    elseif $SandraHomeStepKey = 'noticed':
        if SandraCarpenterSecret >= 1:
            *pl 'Взгляд Сандры медленно опускается ниже твоего пояса. Она тяжело вздыхает, пряча лицо:'
            *pl '— Ты… совсем взрослый мужик уже. И я вижу это. Ты ведь знаешь мою тайну с Драупниром… знаешь, какая я на самом деле.'
            *pl ' '
            *pl 'Её голос дрожит от смеси стыда и вспыхнувшей женской страсти.'
        else:
            *pl 'Взгляд Сандры на секунду задерживается ниже твоего пояса. Она прикусывает губу и судорожно втягивает воздух:'
            *pl '— Ты… совсем взрослый уже, плечистый. И я это вижу.'
            *pl ' '
            *pl 'Голос матери дрожит от смущения и первого откровенного любопытства.'
        end

    elseif $SandraHomeStepKey = 'help_offer':
        *pl '— Не мучайся так, Стефанчик… — шепчет Сандра, опустив глаза, но не убирая рук с твоей груди. — Я же женщина опытная… знаю, как мужское тело горит от нерастраченной силы. Если тебе совсем невмоготу — я помогу. Только пусть это останется строго между нами.'

    elseif $SandraHomeStepKey = 'handjob':
        *pl 'Ладонь Сандры действует удивительно ласково и уверенно. Опытная женщина накрывает твой напряжённый член, водя по нему горячими пальцами, и косится на закрытую дверь спальни:'
        *pl '— Давай… быстро и тихо, милый.'

    elseif $SandraHomeStepKey = 'cuni':
        *pl 'Сандра медленно раздвигает пышные бёдра, будто каждое движение — сладостное преступление перед устоями дома.'
        *pl ' '
        *pl 'Когда ты прикасаешься губами и языком к её влажному бутончику, её тело пронзает дрожь. Сильный оргазм сотрясает женщину, и она судорожно прижимает ладонь к твоим губам, сдерживая стон.'

    elseif $SandraHomeStepKey = 'titjob':
        *pl 'Сандра с жарким вздохом расстёгивает сорочку и прижимает свою пышную грудь к твоему члену, лаская его мягкими тёплыми полушариями.'
        *pl ' '
        *pl '— Ах, ненасытный ты какой, Стефанчик… — шепчет она, горячо целуя тебя в макушку.'

    elseif $SandraHomeStepKey = 'blowjob':
        *pl 'Она бесшумно опускается на колени у кровати и бросает короткий взгляд на дверь:'
        *pl '— Только один раз… и никому ни слова, — тихо шепчет Сандра, прежде чем обхватить твой член губами и принять его в свой тёплый рот.'

    elseif $SandraHomeStepKey = 'presex':
        *pl 'Сандра смотрит тебе прямо в глаза горячим, решительным взглядом:'
        *pl '— Стефанчик… если мы сейчас перейдём эту последнюю черту — я больше не смогу притворяться перед тобой просто строгой матерью. И видит Ильматер, я сама больше не хочу притворяться!'

    else:
        *pl 'Между вами повисает напряжённая, сладкая тишина.'
    end

    killvar '$SandraHomeStepKey'
