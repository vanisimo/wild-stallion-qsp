! ================================================
! FILE: modules/events/sandra/sandra_mayor_arc_text.qsps
! MODULE: events/sandra
! ! [AI-WORKED] Текст переработан / дополнен ассистентом 28.09.2026
! Тексты визитов Сандры к мэру и разговоров с мэром
! ================================================

#SandraMayorArcPrintText
    $SandraMayorTextId = $ARGS[0]

    if $SandraMayorTextId = 'mayor_spy_screen':
        if SandraMayorSpyStep = 1:
            *pl 'Стефан осторожно приникает глазом к узкой щели в массивной дубовой двери кабинета мэра.'
            *pl 'За резным столом восседает мэр, откинувшись на спинку кресла. Сандра стоит напротив, спокойно расстёгивая пуговицы верхнего платья и поправляя шаль.'
            *pl 'В её движениях нет ни страха, ни слез, ни покорного отчаяния — лишь сухая, практичная собранность женщины, привыкшей улаживать семейные дела так, как того требуют обстоятельства.'

            if SandraNoPantiesToday = 1:
                *pl 'Подняв подол юбки, Сандра демонстрирует совершенно голое тело ниже пояса. Она намеренно не надевала сегодня белья, чтобы не тратить лишнего времени на стягивание трусиков.'
                *pl 'Мэр усмехается, скользя взглядом по её гладкой, чистой ложбинке:'
                *pl '— Даже бельё решила не надевать? Молодчина, Сандра... Сразу видно, экономишь моё время.'
            else:
                *pl 'Подняв подол юбки, Сандра привычным движением стягивает бельё до колен, огибая бедра.'
                *pl 'Мэр хмыкает, наблюдав за её движениями:'
                *pl '— Бельё всё-таки надела? Ну ничего, снимай-снимай, нам лишние тряпки ни к чему.'
            end

            *pl 'Сандра без лишних слов опускается на колени перед креслом мэра и расстёгивает его гульфик, умело доставая его плоть.'

        elseif SandraMayorSpyStep = 2:
            if SandraCorruptionStage = 1:
                *pl 'Сандра обхватывает губами член мэра, ритмично двигая головой. Ей не нужно ничего изображать — она действует четко, уверенно и без промедления.'
                *pl 'Мэр откидывает голову назад, постанывая от её умелых прикосновений. Спустя пару минут он крепко сжимает её каштановые волосы и с глухим рыком изливается прямо ей в рот.'
                *pl 'Сандра аккуратно принимает всю порцию, глотает и вытирает губы платком. Никакой драмы — лишь завершённая сделка.'
            else:
                *pl 'Закончив с ласками ртом, мэр поднимает Сандру с колен и поворачивает её лицом к столу, упирая руками в полированный дуб.'
                *pl 'Сандра наклоняется вперед, широко расставив ноги и приподняв подол.'

                if SandraNoPantiesToday = 1:
                    *pl 'Отсутствие белья позволяет мэру без малейших задержек направить свой член прямо в её влажное лоно.'
                else:
                    *pl 'Мэр нетерпеливо сдергивает её трусики полностью и с ходу входит в её горячее тело.'
                end

                *pl 'Шлепки плоти о плоть звонко раздаются в тишине кабинета. Сандра сжимает пальцами край стола, размеренно дыша и принимая глубокие толчки.'
            end

        elseif SandraMayorSpyStep = 3:
            if SandraCorruptionStage = 2:
                *pl 'После серии сочных, сильных толчков мэр извлекает член из её влагалища и настойчиво направляет его к её лицу.'
                *pl 'Сандра без колебаний снова открывает рот, принимая густые струи семени на язык и губы.'
                *pl 'Она спокойно вытирает лицо кружевным платочком и поправляет юбку, завершив визит.'
            else:
                *pl 'Мэр извлекает член и грубо натягивает Сандру за ягодицы, направляя головку к её анальному отверстию.'

                if analvirgin['sandra'] = 0 or SandraAnalUnlocked = 1 or StefanSandraAnalUnlocked = 1:
                    *pl 'Уже привычная к подобным ласкам, Сандра слегка расслабляется, позволяя члену мэра протолкнуться в её тугую попку.'
                    *pl 'Мэр рычит от удовольствия, размеренно вбиваясь в её анус.'
                else:
                    *pl 'Вместо анального входа мэр переворачивает её и устраивает еще один жесткий сет глубокого вагинального траха, от которого Сандра сжимает зубы.'
                end
            end

        elseif SandraMayorSpyStep = 4:
            *pl 'Мэр доводит себя до извержения и выплескивает семя прямо на лицо и в рот Сандры.'
            *pl 'Сандра смахивает капли с подбородка, аккуратно застёгивает платье и поправляет волосы перед небольшим зеркалом на стене.'
            *pl '— Налоги за этот месяц учтены, мэр? — спокойно уточняет она.'
            *pl '— Учтены, Сандра. До следующего раза, — ухмыляется мэр.'
        end

    elseif $SandraMayorTextId = 'confront_intro':
        *pl 'Стефан решительно входит в кабинет мэра, плотно закрывая за собой дверь.'
        *pl 'Мэр поднимает взгляд от документов и недовольно щурится:'
        *pl '— Стефан? Что за манеры врываться без доклада? Говори быстро, у меня мало времени.'
        *pl '— Речь о визитах моей матери, — твердо говорит Стефан. — Я знаю, зачем Сандра ходит к вам каждые два понедельника.'

    elseif $SandraMayorTextId = 'confront_high_rep':
        *pl 'Мэр на мгновение замирает, всматриваясь в лицо Стефана. Он помнит, что "Дикий Жеребец" сейчас на слуху у всего города, а молодой хозяин пользуется уважением торговцев и гильдий.'
        *pl 'Мэр медленно откладывает перо и вздыхает:'
        *pl '— Хм... Вижу, ты парень не промах, Стефан. И заведение твое держится высоко. Ладно. Скандалы с уважительными людьми мне в городе не нужны.'
        *pl '— Сандре больше не придется приходить в мой кабинет для "особых отчетов". Налоги трактира останутся в стандартной норме.'
        *pl '— Договорились, господин мэр, — чеканит Стефан.'

    elseif $SandraMayorTextId = 'confront_low_rep':
        *pl 'Мэр откидывается на спинку кресла и снисходительно усмехается:'
        *pl '— Знаешь о визитах? И что с того, парень? Твой трактир еле концы с концами сводит, репутация в грязи. Если твоя мать не будет отрабатывать скидки по налогам — я закрою "Дикий Жеребец" к концу недели.'
        *pl '— Но если ты так печешься о матери — можешь выплатить её налоговые отступные из кассы. Три сотни монет наличными на стол — и её визиты прекратятся.'

    elseif $SandraMayorTextId = 'confront_bribe_success':
        *pl 'Стефан выкладывает тяжелый кошель с 300 монетами на стол мэра.'
        *pl 'Мэр с улыбкой взвешивает кошель в руке и прячет его в выдвижной ящик:'
        *pl '— Вот это деловой разговор. Отступные приняты. Сандре передай, что её личные визиты ко мне отменяются.'
    end

    killvar '$SandraMayorTextId'
---
