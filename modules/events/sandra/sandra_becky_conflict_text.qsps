! ================================================
! FILE: modules/events/sandra/sandra_becky_conflict_text.qsps
! MODULE: events/sandra
! Тексты конфликта и примирения Сандры и Бекки
! ================================================

#SandraBeckySundayEavesdropText
    $SandraBeckyText = 'Гуляя неподалёку от лавки Бекки в воскресный день, вы слышите громкие, взволнованные голоса. Заглянув в окно, вы видите мать и Бекки — обе бледные, глаза горят гневом.<br><br>— Ты сознаёшься?! — звенит голос Сандры. — Ты заманила моего сына, задурила мальчику голову! Ты сама ведёшь беспорядочную жизнь, так ещё и Стефана в это втягиваешь?!<br><br>Бекки вспыхивает и делает шаг вперёд:<br>— А ты бы молчала, Сандра! Мать-наставница нашлась! Думаешь, я не знаю, к кому ты тайно бегаешь?! К гному Драупниру на задворки!<br><br>Сандра от неожиданности теряет дар речи. Подруги отворачиваются друг от друга втянув плечи, и воскресная встреча заканчивается полным разрывом.'
---

#SandraBeckyCrisisIntroText
    $SandraBeckyText = 'Сандра подходит к вам на кухне. Лицо её строгое, но в глазах читается глубокая обида и переживание за вас.<br><br>— Стефан, я слышала всё, что о вас с Бекки говорят… И сама с ней говорила. Скажи мне как матери — неужели ты действительно заходишь к ней в спальню? Она же задурила тебе голову!'
---

#SandraBeckyCrisisChoice1Text
    if SandraHomeSex = 1:
        $SandraBeckyText = 'Вы пытаетесь уклониться от прямого ответа, говоря туманными фразами. Сандра смотрит на вас с горьким укором:<br><br>— Не юли, Стефан! Я же видела, как она защищается… И ты молчишь! Значит, правда… Мало тебе меня было, решил всех женщин в городе перепробовать?!<br><br>Она отворачивается и уходит, отказываясь говорить с вами.'
    else:
        $SandraBeckyText = 'Вы пытаетесь отшутиться и уйти от ответа. Сандра сжимает губы:<br><br>— Не юли, Стефан! Я же видела её лицо… Значит, всё правда. Ты позволил этой женщине заморочить себе голову.<br><br>Она строго отворачивается и уходит.'
    end
---

#SandraBeckyCrisisChoice2Text
    if SandraHomeSex = 1:
        $SandraBeckyText = '— Я взрослый мужчина и сам решаю, с кем мне быть! — отрезаете вы.<br><br>Глаза Сандры вспыхивают гневом и ревностью:<br>— Ах, сам решаешь?! Значит, меня тебе мало оказалось?! Всех теток в этом городе решил попользовать?! Вон отсюда, и не подходи ко мне!<br><br>Сандра в ярости хлопает дверью.'
    else:
        $SandraBeckyText = '— Я уже сам решаю, с кем и когда мне встречаться, — твёрдо говорите вы.<br><br>Сандра хмурится и выпрямляет спину:<br>— Вот как ты заговорил с матерью… Ну хорошо, хозяин. Только со мной в таком тоне больше не разговаривай.<br><br>Она уходит, храня ледяное молчание.'
    end
---

#SandraBeckyCrisisChoice3Text
    if SandraHomeSex = 1:
        $SandraBeckyText = 'Вы мягко прижимаете Сандру к себе и шепчете ей на ухо:<br><br>— Мам, ну что ты… Ты же знаешь, мне просто нравятся опытные, взрослые женщины. А ты — самая красивая из них.<br><br>Сандра вздрагивает от ваших слов, щеки её заливает румянец. Обида тает в её глазах:<br>— Ах ты шалун… Умеешь подход найти. Ладно, не гневайся на мать.'
    else:
        $SandraBeckyText = 'Вы спокойно обнимаете Сандру за плечи и говорите мягким, уверенным голосом:<br><br>— Мам, не переживай. Никто мне голову не задурил, я прекрасно всё понимаю. Бекки хорошая женщина, но ты для меня всегда на первом месте.<br><br>Сандра тяжело вздыхает и прижимается к вам:<br>— Ох, Стефан… Вырос ты. Ладно, я спокойна за тебя.'
    end
---

#SandraBeckyTalkBeckyIntroText
    $SandraBeckyText = 'Вы заходите в лавку к Бекки. Вдова выглядит расстроенной и нервно перебирает товары.<br><br>— Я поговорил с мамой, — спокойно говорите вы. — Она поняла, что была неправа.<br><br>Бекки вспыхивает:<br>— Неправа?! Да она назвала меня шлюхой при всех!<br><br>— Нет, Бекки, она так не думает, — мягко перебиваете вы. — Ты у нас взрослая, красивая, любвеобильная женщина. Кто ещё в нашем городе с тобой сравнится?<br><br>Бекки смущается, улыбается и кивает: — Ну ладно… если Сандра готова, я тоже поговорю.'
---

#SandraBeckyTalkSandraIntroText
    $SandraBeckyText = 'Вы подходите к Сандре в трактире.<br><br>— Мам, Бекки тоже признаёт, что была неправа и должна была с тобой посоветоваться, — говорите вы.<br><br>Сандра немного молчит, потом качает головой:<br>— Мы обе горячие… Ладно, Стефан, я согласна встретиться и поговорить с ней.'
---

#SandraBeckySundayReconcileA_Text
    $SandraBeckyText = 'В воскресенье вы тихо подходите к окну лавки Бекки. Подруги сидят за столом, наливают по чарочке.<br><br>— Извини меня, Бекки, — тихо говорит Сандра. — Я ведь понимаю… Стефан у нас красивый парень, а как за ум взялся да трактир поднял — глаз не оторвать.<br><br>— Да уж, это точно, — улыбается Бекки.<br><br>Сандра краснеет и добавляет:<br>— Да я… я и сама перед ним не устояла. Он теперь и ко мне по ночам заходит.<br><br>Бекки роняет ложку и ахает:<br>— Что?! С собственным сыном?! Ну ты и шлюха, Сандра! — и обе взрываются хохотом.<br><br>Они весело обсуждают достоинства Стефана и решают, что нужно позвать его к Бекки на вино — «помочь двум одиноким вдовам».'
---

#SandraBeckySundayReconcileB_Text
    $SandraBeckyText = 'В воскресенье вы подглядываете в окно лавки Бекки. Сандра и Бекки сидят за столом и тепло беседуют.<br><br>— Извини меня, Бекки, — говорит Сандра. — Я перенервничала. Стефан так изменился, вырос, настоящим мужчиной стал, когда трактир в руки взял.<br><br>— Да, Сандра, ты права, он молодец, — кивает Бекки.<br><br>Подруги обнимаются, мир между ними восстановлен.'
---

#SandraBeckyDelayedRevelationText
    $SandraBeckyText = 'В воскресный день вы снова слышите смех из лавки Бекки. Заглянув в окно, вы видите подруг за вином.<br><br>— Знаешь, Бекки, — смущённо шепчет Сандра, — я ведь тогда не всё тебе сказала… Я и сама перед Стефаном не устояла. Он и ко мне по ночам приходит.<br><br>Бекки всплескивает руками и смеётся:<br>— Ах ты шлюха, Сандра! С собственным сыном!<br><br>Они со смехом начинают обсуждать достоинства Стефана и договариваются позвать его на вечернее вино.'
---

#SundayVisitBeckySandraScandalText
    gs 'SandraBeckySundayEavesdropText'
    $SundayVisitText = $SandraBeckyText
---

#SandraBeckyThreesomeIntroText
    $GroupSexText = 'Сандра и Бекки встретили вас с вином в доме вдовы. Обе женщины весело смеются, выпивают и зовут вас поухаживать за двумя одинокими подругами.'
---

#SandraBeckyThreesomeStepText
    $GroupSexText = 'Сандра и Бекки делят ваше внимание, прижимаясь с обеих сторон и смеясь над своими прежними обидами.'
---

#SandraBeckyThreesomeAfterText
    $GroupSexText = 'Вечер в доме Бекки увенчался полным примирением и тёплой ночью.'
