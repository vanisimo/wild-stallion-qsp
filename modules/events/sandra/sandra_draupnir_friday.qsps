! ================================================
! FILE: modules/events/sandra/sandra_draupnir_friday.qsps
! MODULE: events/family
! ! [AI-WORKED] Текст переработан / дополнен ассистентом 25.09.2026
! Пятничные визиты Сандры к Драупниру (NPC-path & раскрытие тайны)
! ================================================

#SandraFridayDraupnirAdvance

    if week <> 5:
        exit
    end

    if SandraFridayDraupnirCountDay = day:
        exit
    end

    SandraFridayDraupnirCountDay = day
    SandraFridayDraupnirCount += 1
---

#SandraDraupnirFridayBackgroundResolve

    if week <> 6:
        exit
    end

    if SandraDraupnirFridayResolved = 1:
        SandraDraupnirFridayResolved = 0
        exit
    end

    if SandraHomeSex = 1:
        SandraDraupnirFridayResolved = 0
        exit
    end

    gs 'SandraDraupnirAffairAdvance', 'background'
    SandraDraupnirFridayResolved = 0
---

#SandraDraupnirAffairAdvance

    $SandraDraupnirAdvanceMode = LCASE($ARGS[0])

    if SandraDraupnirAffairStage < 6:
        SandraDraupnirAffairStage += 1
    end

    SandraNpcPath += 1
    GirlNpcPath['sandra'] += 1

    if $SandraDraupnirAdvanceMode = 'watch' or $SandraDraupnirAdvanceMode = 'background':
        SandraNpcPath += 1
        GirlNpcPath['sandra'] += 1
        GirlSecretiveness['sandra'] += 1
    elseif $SandraDraupnirAdvanceMode = 'step_aside':
        SandraNpcPath += 2
        GirlNpcPath['sandra'] += 2
        GirlSecretiveness['sandra'] += 2
    end

    if GirlSecretiveness['sandra'] > 100:
        GirlSecretiveness['sandra'] = 100
    end

    if SandraNpcPath > 100:
        SandraNpcPath = 100
    end

    if GirlNpcPath['sandra'] > 100:
        GirlNpcPath['sandra'] = 100
    end

    killvar '$SandraDraupnirAdvanceMode'
---

#SandraDraupnirFridayCanStart

    SandraDraupnirFridayCanStart = 0

    if week <> 5:
        exit
    end

    if time <> 4:
        exit
    end

    if SandraDraupnirFridayToday = 1:
        exit
    end

    if $GirlLocation['sandra'] <> 'DraupnirShop':
        exit
    end

    SandraDraupnirFridayCanStart = 1
---

#SandraDraupnirFridayPeek
    *clr
    clr
    cla

    gs 'InitDraupnir'
    gs 'EnsureGirlData', 'sandra'

    SandraDraupnirSpyStep = 1

    if GirlNoPantiesWork['sandra'] = 1 or panties['sandra'] = 0:
        SandraNoPantiesToday = 1
    else:
        SandraNoPantiesToday = 0
    end

    if FamilyCorruptionStage <= 1 or sluttiness['sandra'] < 25:
        SandraCorruptionStage = 1
        SandraDraupnirSpyMaxSteps = 2
    else:
        SandraCorruptionStage = 2
        SandraDraupnirSpyMaxSteps = 3
    end

    if SandraCorruptionStage >= 2:
        SandraDraupnirRandomPose = RAND(1, 2)
    else:
        SandraDraupnirRandomPose = 1
    end

    gt 'SandraDraupnirSpyScreen'
---

#SandraDraupnirSpyScreen
    *clr
    clr
    cla

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', 'sandra'
    end

    gs 'ShowLocationScreenTitle', 'У ОКНА МАСТЕРСКОЙ: ПОДГЛЯДЫВАНИЕ'

    if SandraCorruptionStage = 1:
        $DraupnirImgKey = 'step_' + STR(SandraDraupnirSpyStep) + '_stage_1'
    else:
        if SandraDraupnirSpyStep = 1:
            $DraupnirImgKey = 'step_1_pose_' + STR(SandraDraupnirRandomPose)
        else:
            $DraupnirImgKey = 'step_' + STR(SandraDraupnirSpyStep) + '_stage_2'
        end
    end

    $DraupnirImgCap = 'Мастерская Драупнира: ' + $DraupnirImgKey
    gs 'SceneShowVisual', 'images/events/sandra/sandra_draupnir_friday/' + $DraupnirImgKey, $DraupnirImgCap, 'large', 'webp'

    gs 'SandraDraupnirFridayPrintText', 'draupnir_spy_screen'
    *pl ' '

    if SandraDraupnirSpyStep < SandraDraupnirSpyMaxSteps:
        gs 'ActUiPrepare', 'Смотреть дальше', 'look'
        act $ActUiLabel, $ActUiIconPath:
            SandraDraupnirSpyStep += 1
            gt 'SandraDraupnirSpyScreen'
        end
    else:
        SandraDraupnirFridayPeekSeen[day] = 1
        SandraDraupnirFridayPeekOffer = 0
        SandraCarpenterSecret = 1
        PlayerKnows_SandraDraupnirFriday = 1
        PlayerKnows_SandraDraupnirAffair = 1
        SandraDraupnirEventDone = 1
        sluttiness['sandra'] += 1
        TavernScandal += 1

        if LOC('KnowledgeRegisterFact') = 1:
            gs 'KnowledgeRegisterFact', 'sandra_draupnir_friday_peek'
        end

        if LOC('KnowledgeRegisterPlayerKnows') = 1:
            gs 'KnowledgeRegisterPlayerKnows', 'sandra_draupnir_friday_peek', 'peek'
        end

        *pl 'Стефан тихо переводит дыхание и отступает от окна мастерской.'
        *pl ' '

        gs 'ActUiPrepare', 'Назад в квартал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'CraftsmenQuarter'
        end
    end
---

#DraupnirShop

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/sandra/sandra_draupnir_friday/draupnir_shop', 'лавка Драупнира', 'large', 'webp'
    gs 'AddGlobalButtons'
    gs 'InitDraupnir'

    gs 'PrintTitleLine', ' МАСТЕРСКАЯ ДРАУПНИРА'

    gs 'SandraDraupnirFridayShopText'
    gs 'PrintMainP', $SandraDraupnirShopText
    killvar '$SandraDraupnirShopText'

    *pl ' '

    if week = 5 and time = 4 and $GirlLocation['sandra'] = 'DraupnirShop' and SandraDraupnirFridayToday = 0:
        gs 'ActUiPrepare', 'Подглядеть у окна', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraDraupnirFridayPeek'
        end

        gs 'ActUiPrepare', 'Толкнуть дверь и войти без стука', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraDraupnirFridayDoorBurst'
        end

        gs 'ActUiPrepare', 'Подождать у бочек снаружи', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraDraupnirFridayIntercept'
        end
    end

    *pl ' '

    gs 'BuildDraupnirTalkMenu'
    gs 'NpcMenuLink', 'Драупнир', 'DraupnirTalkMenu'

    *pl ' '

    if TavernCarpenterUpgradesUnlocked = 1:
        act '<b>Улучшения трактира</b>', 'images/common/ui/actions/work.png':
            gt 'DraupnirUpgradesShop'
        end
    else:
        act '<b>Заказ для трактира</b>', 'images/common/ui/actions/work.png':
            gt 'DraupnirUpgradesLocked'
        end
    end

    if TavernRepairNeeded = 1 and TavernRepairOrdered = 0:
        act '<b>Срочный ремонт</b>', 'images/common/ui/actions/work.png':
            gt 'TavernDayEventCarpenterRepair'
        end
    elseif TavernRepairNeeded = 1 and TavernRepairOrdered = 1:
        act '<b>Ремонт заказан</b>', 'images/common/ui/actions/work.png':
            gt 'TavernDayEventCarpenterRepairAlreadyOrdered'
        end
    end

    *pl ' '

    act '<b>Квартал ремесленников</b>', 'images/common/ui/actions/craftsmen.png':
        gt 'CraftsmenQuarter'
    end
---

#BuildDraupnirTalkMenu

    gs 'Menu.Destroy', 'DraupnirTalkMenu'
    gs 'Menu.Create', 'DraupnirTalkMenu'

    gs 'MenuUiAdd', 'DraupnirTalkMenu', 'Поболтать', 'talk'
    gs 'Menu.AddModule', 'DraupnirTalkMenu', {
        gt 'DraupnirSmallTalk'
    }

    gs 'MenuUiAdd', 'DraupnirTalkMenu', 'Назад', 'return'
    gs 'Menu.AddModule', 'DraupnirTalkMenu', {
        gt 'DraupnirShop'
    }
---

#DraupnirUpgradesLocked

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/sandra/sandra_draupnir_friday/draupnir_upgrades_locked', 'Драупнир: улучшения закрыты', 'large', 'webp'
    gs 'InitDraupnir'

    gs 'PrintTitleLine', ' ДРАУПНИР'

    gs 'DraupnirUpgradesLockedText'

    *pl ' '

    act '<b>Назад в мастерскую</b>', 'images/common/ui/actions/return.png':
        gt 'DraupnirShop'
    end
---

#SandraDraupnirFridayDoorBurst

    *clr
    clr
    cla

    gs 'EnsureGirlData', 'sandra'
    gs 'InitDraupnir'

    gs 'SceneShowVisual', 'images/events/sandra/sandra_draupnir_friday/sandra_draupnir_friday_action', 'ВНЕЗАПНЫЙ ВХОД В МАСТЕРСКУЮ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ВНЕЗАПНЫЙ ВХОД В МАСТЕРСКУЮ'

    SandraCarpenterSecret = 1
    PlayerKnows_SandraDraupnirFriday = 1
    PlayerKnows_SandraDraupnirAffair = 1
    SandraDraupnirEventDone = 1
    SandraDraupnirFridayToday = 1

    gs 'SandraDraupnirFridayDoorBurstText'
    *p $SandraDraupnirFridayText
    *pl ' '

    gs 'ActUiPrepare', 'Подколоть с юмором (про идеальные доски)', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'SandraDraupnirFridayDoorBurstResolve', 'humor'
    end

    gs 'ActUiPrepare', 'Спросить строго, как хозяин дома', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'SandraDraupnirFridayDoorBurstResolve', 'strict'
    end

    gs 'ActUiPrepare', 'Смущённо извиниться и выйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'SandraDraupnirFridayDoorBurstResolve', 'exit'
    end
---

#SandraDraupnirFridayDoorBurstResolve

    $SandraDraupnirChoice = LCASE($ARGS[0])

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/sandra/sandra_draupnir_friday/sandra_draupnir_friday_action', 'РАЗГОВОР В МАСТЕРСКОЙ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'РАЗГОВОР В МАСТЕРСКОЙ'

    if $SandraDraupnirChoice = 'humor':
        SandraTrustStefan += 1
        GirlTrustStefan['sandra'] += 1
        Friends['sandra'] += 1
        love['sandra'] += 1
    elseif $SandraDraupnirChoice = 'strict':
        SandraRespect += 1
        otkroven['sandra'] += 1
    else:
        Friends['sandra'] += 1
    end

    gs 'ClampGirlSocialStats', 'sandra'
    gs 'SandraDraupnirFridayDoorBurstResolveText', $SandraDraupnirChoice
    *p $SandraDraupnirFridayText
    *pl ' '

    killvar '$SandraDraupnirChoice'

    gs 'ActUiPrepare', 'Вернуться в квартал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'CraftsmenQuarter'
    end
---

#SandraDraupnirFridayIntercept

    *clr
    clr
    cla

    gs 'EnsureGirlData', 'sandra'

    gs 'SceneShowVisual', 'images/events/sandra/sandra_draupnir_friday/sandra_draupnir_friday_action', 'ЗАСАДА У БОЧЕК', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ЗАСАДА У БОЧЕК'

    SandraCarpenterSecret = 1
    PlayerKnows_SandraDraupnirFriday = 1
    PlayerKnows_SandraDraupnirAffair = 1
    SandraDraupnirEventDone = 1
    SandraDraupnirFridayToday = 1

    gs 'SandraDraupnirFridayInterceptText'
    *p $SandraDraupnirFridayText
    *pl ' '

    gs 'ActUiPrepare', 'Пойти в сторону дома', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'CraftsmenQuarter'
    end
---