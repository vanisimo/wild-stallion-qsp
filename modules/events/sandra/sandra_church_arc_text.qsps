! ================================================
! FILE: modules/events/sandra/sandra_church_arc_text.qsps
! MODULE: events/sandra
! ! [AI-WORKED] Текст переработан / дополнен ассистентом 28.09.2026
! Тексты визитов Сандры в Комнату чистых сердец к Отцу Герхарду
! ================================================

#SandraChurchArcPrintText
    $ChurchArcTextId = $ARGS[0]

    if $ChurchArcTextId = 'church_spy_screen':
        if SandraChurchIsFirstVisit = 1:
            *pl 'Стефан приникает к резной щели у витражного окна "Комнаты чистых сердец".'
            *pl 'Отец Герхард стоит рядом с Сандрой, слащаво улыбаясь и приглушенно читая стихи благословения Ильматера.'
            *pl '— Чистота духа начинает с чистоты помыслов и смирения плоти, дочь моя... — шепчет святой отец.'
            *pl 'Его ладонь медленно скользит по подолу платья Сандры, поднимаясь всё выше по её бедру.'

            if SandraNoPantiesToday = 1:
                *pl 'Подняв подол, пальцы священника не встречают никакой преграды из ткани — Сандра пришла без белья.'
                *pl 'Отец Герхард тяжело вздыхает, почувствовав горячую, нежную кожу и влажные губки ее лобка. Его глаза жадно блестят в полумраке:'
                *pl '— Ах, Ильматер всеблагой... Ни единого покрова порока на теле... Чиста и откровенна перед храмом.'
                *pl 'Сандра лишь спокойно закрывает глаза, без проявления страха или возмущения принимая эти прикосновения как уплату долга церкви.'
            else:
                *pl 'Пальцы Герхарда упираются в тонкую ткань её трусиков. Ситцевая полоска едва сдерживает его настойчивые движения.'
                *pl 'Священник просовывает пальцы под резинку белья, слегка оттягивая её и поглаживая влажную ложбинку Сандры:'
                *pl '— Смири свою плоть, дочь моя... Ощути теплоту благословения Круга...'
                *pl 'Сандра стоически переносит его ласки, спокойно выжидая завершения ритуала.'
            end

        else:
            if SandraChurchSpyStep = 1:
                *pl 'Отец Герхард заводит Сандру вглубь комнаты и затворяет засов.'
                *pl '— Ильматер требует полного очищения от грехов, Сандра... Опустись передо мной.'

                if SandraNoPantiesToday = 1:
                    *pl 'Сандра опускается на колени перед священником. Отсутствие белья под юбкой делает её позу предельно откровенной.'
                else:
                    *pl 'Сандра опускается на колени, поправляя юбку и обнажая член святого отца.'
                end

                *pl 'Она умело обхватывает плоть Герхарда губами, начиная ритмичные движения.'

            elseif SandraChurchSpyStep = 2:
                if SandraCorruptionStage = 1:
                    *pl 'Отец Герхард глухо стонет, закатывая глаза под сутаной.'
                    *pl 'Спустя пару минут он изливается горячими струями прямо в рот Сандры, шепча хвалу Ильматеру.'
                    *pl 'Сандра покорно проглатывает семя, вытирает губы и поднимается с колен.'
                else:
                    *pl 'Отец Герхард укладывает Сандру на деревянную скамью у алтаря чистоты.'
                    *pl 'Задрапировав её юбку выше пояса, священник входит в её горячее влагалище.'
                    *pl 'Звуки святых молитв переплетаются с ритмичными шлепками тел в полумраке комнаты.'
                end

            elseif SandraChurchSpyStep = 3:
                if SandraCorruptionStage = 2:
                    *pl 'Закончив вагинальный акт, Герхард извлекает член и настойчиво прижимает Сандру за затылок.'
                    *pl 'Она принимает его семя в рот, завершая отработку "чистых сердец".'
                else:
                    *pl 'Герхард переворачивает Сандру лицом к скамье и прижимает её таз.'

                    if analvirgin['sandra'] = 0 or SandraAnalUnlocked = 1 or StefanSandraAnalUnlocked = 1:
                        *pl 'Священник нагнетает член в её анальное отверстие, глухо рыча от тугого охвата.'
                    else:
                        *pl 'Священник устраивает жесткий, глубокий вагинальный сет, от которого Сандра сжимает пальцами край скамьи.'
                    end
                end

            elseif SandraChurchSpyStep = 4:
                *pl 'Отец Герхард кончает в рот и на губы Сандры, крестя её святым кругом:'
                *pl '— Грехи твои отпущены, дочь моя... Иди с миром Ильматера.'
                *pl 'Сандра вытирает семя с лица и спокойно поправляет одежду.'
            end
        end

    elseif $ChurchArcTextId = 'talk_stop_intro':
        *pl 'Стефан отводит Сандру в сторону и серьезно смотрит ей в глаза:'
        *pl '— Мама, я видел, что происходит в "Комнате чистых сердец". Отец Герхард пользуется тобой. Я хочу, чтобы ты больше туда не ходила.'

    elseif $ChurchArcTextId = 'talk_stop_failed':
        *pl 'Сандра вздыхает и качает головой с сухой, практичной грустью:'
        *pl '— Стефан... Ты еще не понимаешь, как устроен этот город. Пока мэр висит у нас на шее с налогами, я не могу позволить себе сокрушить отношения еще и с церковью.'
        *pl '— Если мы поссоримся с Отцом Герхардом прямо сейчас — святые отцы затравят наш трактир слухами и проклятиями. Сначала нужно решить вопрос с мэрией.'
        *pl '<i>(Разговор не сработал. Чтобы убедить Сандру прекратить визиты к Отцу Герхарду, сначала необходимо прекратить визиты к Мэру!)</i>'

    elseif $ChurchArcTextId = 'talk_stop_success':
        *pl 'Сандра удивленно смотрит на Стефана, а затем её плечи расслабляются, и на губах появляется редкая, облегченная улыбка:'
        *pl '— Раз ты уладил вопрос с мэром и налогами... Ты прав, Стефан. Терпеть отвратительные ласки Герхарда я больше не обязана.'
        *pl '— Я больше не переступлю порог этой комнаты. Спасибо тебе, сын.'
    end

    killvar '$ChurchArcTextId'
---
