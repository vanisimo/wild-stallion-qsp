! ================================================
! FILE: modules/events/quests/guard_bribe_quest.qsps
! MODULE: events/quests
! Квест стражника Грюна и Инги
! Сговор на рынке → проверки в Пн/Чт утро → 4 стадии жалоб → откуп 45 мараведи
! ================================================

#IngaGuardCheckVisitTick
    if IngaGuardSchemeActive <> 1:
        exit
    end

    if IngaGuardResolved <> 0:
        exit
    end

    if IngaGuardVisitPendingTalk = 1:
        exit
    end

    ! Визиты стражника происходят в понедельник утро (week=1, time=1) и четверг утро (week=4, time=1)
    if (week = 1 or week = 4) and time = 1:
        if IngaGuardLastVisitDay <> day:
            IngaGuardLastVisitDay = day
            IngaGuardVisitStage += 1
            IngaGuardVisitPendingTalk = 1
        end
    end
---

#IngaGuardSchemeProposal
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/locations/market/market/cityguard', 'СЕРЖАНТ ГРЮН НА РЫНКЕ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ПОСТ СТРАЖНИКОВ: СГОВОР С ГРЮНОМ'

    if LOC('IngaGuardSchemeProposalText') = 1:
        gs 'IngaGuardSchemeProposalText'
    end

    *pl ' '
    *pl 'Твои деньги: ' + STR(money) + ' мараведи.'
    *pl ' '

    if money >= 25:
        gs 'ActUiPrepare', 'Заплатить 25 мараведи', 'money'
        act $ActUiLabel, $ActUiIconPath:
            money -= 25
            IngaGuardSchemeActive = 1
            IngaGuardVisitStage = 0
            IngaGuardVisitPendingTalk = 0
            IngaGuardProblem = 1

            *clr
            clr
            cla
            gs 'SceneShowVisual', 'images/locations/market/market/cityguard', 'СГОВОР С ГРЮНОМ', 'large', 'webp'
            gs 'ShowLocationScreenTitle', 'СГОВОР СКРЕПЛЁН'

            if LOC('IngaGuardSchemePaidText') = 1:
                gs 'IngaGuardSchemePaidText'
            end

            *pl ' '
            gs 'ActUiPrepare', 'Вернуться на рынок', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt 'Market'
            end
        end
    else:
        *pl '<i>У тебя недостаточно денег, чтобы нанять стражника (нужно 25 мараведи).</i>'
    end

    gs 'ActUiPrepare', 'Отказаться и уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'GuardPost'
    end
---

#IngaGuardIntervene
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/locations/market/market/cityguard', 'РАЗГОВОР С СЕРЖАНТОМ ГРЮНОМ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ПОСТ СТРАЖНИКОВ: ТРЕБОВАНИЕ ПРЕКРАТИТЬ'

    if LOC('IngaGuardInterveneText') = 1:
        gs 'IngaGuardInterveneText'
    end

    *pl ' '
    *pl 'Твои деньги: ' + STR(money) + ' мараведи.'
    *pl ' '

    if money >= 45:
        gs 'ActUiPrepare', 'Заплатить 45 мараведи', 'money'
        act $ActUiLabel, $ActUiIconPath:
            money -= 45
            IngaGuardResolved = IngaGuardHelpPromise
            IngaGuardSchemeActive = 2
            IngaGuardVisitPendingTalk = 0
            IngaServingGuard = 0
            IngaGuardProblem = 0
            GuardBribed = 1
            IngaRumorDays_Guard = 6
            CityRumorReady['inga_guard'] = 1
            PlayerKnows_IngaStefanGuardDeal = 1

            if IngaGuardResolved = 1:
                IngaGuardHelpStage = 1
                IngaGuardWeeklyActive = 0
            else:
                IngaGuardHelpStage = 2
                IngaGuardWeeklyActive = 0
            end

            *clr
            clr
            cla
            gs 'SceneShowVisual', 'images/locations/market/market/cityguard', 'СДЕЛКА СО СТРАЖНИКОМ', 'large', 'webp'
            gs 'ShowLocationScreenTitle', 'ВОПРОС УЛАЖЕН'

            if LOC('IngaGuardIntervenePaidText') = 1:
                gs 'IngaGuardIntervenePaidText'
            end

            *pl ' '
            gs 'ActUiPrepare', 'Вернуться на рынок', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt 'Market'
            end
        end
    else:
        *pl '<i>У тебя недостаточно денег для отступных (нужно 45 мараведи).</i>'
    end

    gs 'ActUiPrepare', 'Отказаться платить', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'GuardPost'
    end
---

#IngaGuardComplaintTalk
    *clr
    clr
    cla

    gs 'EnsureGirlData', 'inga'

    gs 'SceneShowVisual', 'images/locations/inga/shop/stress', 'ИНГА В ЛАВКЕ — ТРЕВОГА', 'large', 'png'
    gs 'ShowLocationScreenTitle', 'ЛАВКА БЛЭНКЕНШИП: РАЗГОВОР С ИНГОЙ'

    if IngaGuardVisitStage = 1:
        if LOC('IngaGuardComplaintStage1Text') = 1:
            gs 'IngaGuardComplaintStage1Text'
        end
        IngaGuardVisitPendingTalk = 0
        Friends['inga'] += 1
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться в лавку', 'shop'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyShop'
        end

    elseif IngaGuardVisitStage = 2:
        if LOC('IngaGuardComplaintStage2Text') = 1:
            gs 'IngaGuardComplaintStage2Text'
        end
        IngaGuardHelpPromise = 1
        IngaGuardVisitPendingTalk = 0
        Friends['inga'] += 2

        *pl ' '
        gs 'ActUiPrepare', 'Вернуться в лавку', 'shop'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyShop'
        end

    elseif IngaGuardVisitStage = 3:
        if LOC('IngaGuardComplaintStage3Text') = 1:
            gs 'IngaGuardComplaintStage3Text'
        end
        IngaGuardHelpPromise = 2
        IngaGuardVisitPendingTalk = 0

        *pl ' '
        gs 'ActUiPrepare', 'Вернуться в лавку', 'shop'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyShop'
        end

    else:
        ! 4-й визит — окончательный отказ и закрытие любовного рута
        if LOC('IngaGuardComplaintStage4Text') = 1:
            gs 'IngaGuardComplaintStage4Text'
        end
        IngaGuardResolved = -1
        IngaRomanceBlocked = 1
        IngaPlayerRouteOpen = 0
        IngaGuardHelpStage = -1
        IngaServingGuard = 1
        IngaGuardWeeklyActive = 1
        IngaGuardVisitPendingTalk = 0
        IngaRumorDays_Guard = 6
        CityRumorReady['inga_guard'] = 1
        Friends['inga'] -= 5

        *pl ' '
        gs 'ActUiPrepare', 'Уйти на рынок', 'market'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Market'
        end
    end

    gs 'ClampGirlSocialStats', 'inga'
---

#IngaGuardThanks
    *clr
    clr
    cla

    gs 'EnsureGirlData', 'inga'

    gs 'SceneShowVisual', 'images/locations/inga/shop/talk', 'ИНГА БЛАГОДАРИТ СТЕФАНА', 'large', 'png'
    gs 'ShowLocationScreenTitle', 'ЛАВКА БЛЭНКЕНШИП: БЛАГОДАРНОСТЬ ИНГИ'

    IngaGuardThanksDone = 1
    IngaRomanceUnlocked = 1
    IngaPlayerRouteOpen = 1
    GuardBribed = 1
    IngaGuardProblem = 0
    IngaRumorDays_Guard = 6
    CityRumorReady['inga_guard'] = 1
    PlayerKnows_IngaStefanGuardDeal = 1

    love['inga'] += 3
    Friends['inga'] += 5
    otkroven['inga'] += 2
    gs 'ClampGirlSocialStats', 'inga'

    if LOC('IngaGuardThanksText') = 1:
        gs 'IngaGuardThanksText'
    end

    *pl ' '

    if LOC('IngaRomanceTryUnlock') = 1:
        gs 'IngaRomanceTryUnlock'
    end

    gs 'ActUiPrepare', 'Вернуться к прилавку', 'shop'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShop'
    end
---

! ================================================
! Сохранённые устаревшие локаторы для совместимости
! ================================================

#IngaGuardHarassmentTryActivate
    if LOC('IngaGuardCheckVisitTick') = 1:
        gs 'IngaGuardCheckVisitTick'
    end
---

#IngaGuardComplaintCanStart
    IngaGuardComplaintCanStart = 0
    if IngaGuardVisitPendingTalk = 1:
        IngaGuardComplaintCanStart = 1
    end
---

#IngaGuardComplaintStart
    gt 'IngaGuardComplaintTalk'
---

#IngaGuardProblem
    gt 'IngaGuardComplaintTalk'
---

#GuardBribeStart
    gt 'IngaGuardIntervene'
---

#MeetGuard
    gt 'IngaGuardIntervene'
---

#GuardBribeResolve
    $GuardBribeResolveMode = LCASE($ARGS[0])
    GuardBribed = 1
    IngaServingGuard = 0
    IngaGuardProblem = 0
    IngaGuardVisitPendingTalk = 0
    IngaPlayerRouteOpen = 1
    IngaGuardHelpStage = 1
    IngaRumorDays_Guard = 6
    CityRumorReady['inga_guard'] = 1
    PlayerKnows_IngaStefanGuardDeal = 1
    killvar '$GuardBribeResolveMode'
---

#IngaGuardThanksCanStart
    IngaGuardThanksCanStart = 0
    if IngaGuardResolved > 0 and IngaGuardThanksDone = 0:
        IngaGuardThanksCanStart = 1
    end
---