! ================================================
! FILE: modules/events/quests/inga_guard_quest.qsps
! MODULE: events/quests
! [AI-WORKED] Текст переработан / дополнен ассистентом 17.10.2026
! Еженедельная подсобка: Лестница Грюна, соло-циклы и ММЖ
! ================================================

#IngaGuardSaturdayCanStart
    IngaGuardSaturdayCanStart = 0

    if week <> 6:
        exit
    end

    if time <> 4:
        exit
    end

    if IngaGuardSaturdayLastDay = day:
        exit
    end

    if IngaGuardBribedExit = 1:
        exit
    end

    ! Ветка Б (совместное использование)
    if IngaGuardHelpStage = 2 and FamilyCorruptionStage >= 3 and IngaGuardWeeklyActive = 1:
        IngaGuardSaturdayCanStart = 1
        exit
    end

    ! Ветка В (где Грюн один)
    if IngaGuardHelpStage = -1 and IngaServingGuard = 1 and IngaGuardWeeklyActive = 1:
        IngaGuardSaturdayCanStart = 1
        exit
    end
---

#IngaGuardSaturday
    if LOC('IngaGuardSaturdayCanStart') = 1:
        gs 'IngaGuardSaturdayCanStart'
    end

    if IngaGuardSaturdayCanStart = 0:
        exit
    end

    IngaGuardSaturdayLastDay = day
    IngaGuardSaturdayDone = 1

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/guard_quest/backroom_door', 'ПОДСОБКА ЛАВКИ — СУББОТА ВЕЧЕРОМ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ПОДСОБКА ЛАВКИ — СУББОТА ВЕЧЕРОМ'

    *pl 'Ты проходишь мимо лавки Блэнкеншип и слышишь знакомые звуки из приоткрытой двери подсобки.'
    *pl 'Голос сержанта Грюна и приглушённые шорохи не оставляют сомнений в том, что происходит внутри.'

    gs 'ActUiPrepare', 'Подойти и подсмотреть', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IngaGuardSaturdaySpy'
    end

    gs 'ActUiPrepare', 'Пройти мимо', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#IngaGuardSaturdaySpy
    *clr
    clr
    cla

    ! Если лестница соло Грюна ещё не закончена (продвижение только при подглядывании)
    if IngaGuardLadderDone = 0:
        if IngaGuardLadderStage = 0:
            gt 'IngaGuardLadderVisit1'
        elseif IngaGuardLadderStage = 1:
            gt 'IngaGuardLadderVisit2'
        elseif IngaGuardLadderStage = 2:
            gt 'IngaGuardLadderVisit3_1'
        elseif IngaGuardLadderStage = 3:
            gt 'IngaGuardLadderVisit4_1'
        else:
            gt 'IngaGuardLadderVisit5_1'
        end
    end

    ! Лестница Грюна завершена: проверка доступности ММЖ
    IngaGuardMmjAllowed = 0
    if IngaGuardHelpStage = 2 and (FamilyCouncilDone = 1 or FamilyCorruptionStage >= 3) and IngaGuardBribedExit = 0:
        IngaGuardMmjAllowed = 1
    end

    if IngaGuardMmjAllowed = 1:
        gt 'IngaGuardMmjEntryChoice'
    else:
        gt 'IngaGuardRegularSolo'
    end
---

