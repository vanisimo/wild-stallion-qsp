#IngaGuardMmjEntryChoice
    *clr
    clr
    cla

    gs 'EnsureGirlData', 'inga'
    gs 'SceneShowVisual', 'images/events/inga/guard_quest/inga_guard_solo_entry', 'ГРЮН И ИНГА В ПОДСОБКЕ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ПОДСОБКА: ВЫБОР ДЕЙСТВИЯ'

    if LOC('IngaGuardMmjVisit1_1Text') = 1:
        gs 'IngaGuardMmjVisit1_1Text'
    end

    *pl ' '
    gs 'ActUiPrepare', 'Войти в подсобку (ММЖ)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IngaGuardMmjRouter'
    end

    gs 'ActUiPrepare', 'Остаться наблюдать из укрытия', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IngaGuardRegularSolo'
    end

    gs 'ActUiPrepare', 'Уйти на рынок', 'market'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#IngaGuardMmjRouter
    if IngaGuardMmjLadderDone = 0:
        if IngaGuardMmjStage = 0:
            gt 'IngaGuardMmjVisit1_2'
        elseif IngaGuardMmjStage = 1:
            gt 'IngaGuardMmjVisit2_2'
        else:
            gt 'IngaGuardMmjVisit3_2'
        end
    else:
        gt 'IngaGuardMmjLoopInit'
    end
---

