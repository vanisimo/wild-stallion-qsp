! ================================================
! ПОВТОРЯЮЩАЯСЯ ММЖ СЦЕНА
! ================================================

#IngaGuardMmjLoopInit
    MmjSwapCount = 0
    MmjIsDp = 0
    $MmjPose = 'stefan_back'
    gt 'IngaGuardMmjLoop'
---

#IngaGuardMmjLoop
    *clr
    clr
    cla

    gs 'EnsureGirlData', 'inga'

    if $MmjPose = 'stefan_back':
        gs 'SceneShowVisual', 'images/events/inga/guard_quest/mmj_loop_stefan_back', 'СТЕФАН СЗАДИ, ГРЮН ОРАЛЬНО', 'large', 'webp'
    elseif $MmjPose = 'stefan_front':
        gs 'SceneShowVisual', 'images/events/inga/guard_quest/mmj_loop_stefan_front', 'СТЕФАН ОРАЛЬНО, ГРЮН СЗАДИ', 'large', 'webp'
    elseif $MmjPose = 'dp_stefan_vag':
        gs 'SceneShowVisual', 'images/events/inga/guard_quest/mmj_loop_dp_vag', 'ДВОЙНОЕ ПРОНИКНОВЕНИЕ: СТЕФАН ВАГИНАЛЬНО', 'large', 'webp'
    elseif $MmjPose = 'dp_stefan_anal':
        gs 'SceneShowVisual', 'images/events/inga/guard_quest/mmj_loop_dp_anal', 'ДВОЙНОЕ ПРОНИКНОВЕНИЕ: СТЕФАН АНАЛЬНО', 'large', 'webp'
    end

    gs 'ShowLocationScreenTitle', 'ПОДСОБКА: СОВМЕСТНАЯ СЦЕНА'

    if LOC('IngaGuardMmjLoopText') = 1:
        gs 'IngaGuardMmjLoopText', $MmjPose
    end

    *pl ' '

    ! Возможность поменяться местами (до 2 раз)
    if MmjSwapCount < 2:
        gs 'ActUiPrepare', 'Поменяться местами с Грюном', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            MmjSwapCount += 1
            if $MmjPose = 'stefan_back':
                $MmjPose = 'stefan_front'
            elseif $MmjPose = 'stefan_front':
                $MmjPose = 'stefan_back'
            elseif $MmjPose = 'dp_stefan_vag':
                $MmjPose = 'dp_stefan_anal'
            elseif $MmjPose = 'dp_stefan_anal':
                $MmjPose = 'dp_stefan_vag'
            end
            gt 'IngaGuardMmjLoop'
        end
    end

    ! Переход к двойному проникновению (если анал открыт и ещё не в DP)
    if analvirgin['inga'] = 0 and MmjIsDp = 0:
        gs 'ActUiPrepare', 'Предложить двойное проникновение (DP)', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaGuardMmjDpSelect'
        end
    end

    ! Варианты финала
    if MmjIsDp = 0:
        gs 'ActUiPrepare', 'Кончить в рот', 'cum'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaGuardMmjFinish', 'mouth'
        end

        gs 'ActUiPrepare', 'Кончить в вагину', 'cum'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaGuardMmjFinish', 'inside'
        end
    else:
        gs 'ActUiPrepare', 'Синхронно кончить вместе с Грюном', 'cum'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaGuardMmjFinish', 'dp'
        end
    end
---

#IngaGuardMmjDpSelect
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/guard_quest/mmj_dp_proposal', 'ПРЕДЛОЖЕНИЕ ДВОЙНОГО ПРОНИКНОВЕНИЯ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ММЖ: ВЫБОР ПОЗИЦИИ ДЛЯ DP'

    *pl 'Ты предлагаешь взять Ингу в два смычка. Грюн довольно гогочет и хлопает тебя по плечу:'
    *pl '"Вот это по-нашему! Девка уже спелая, выдержит обоих. Выбирай, Стефан, какую дырочку берёшь себе?"'

    *pl ' '
    gs 'ActUiPrepare', 'Войти спереди (вагина), Грюн сзади', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $MmjPose = 'dp_stefan_vag'
        MmjIsDp = 1
        gt 'IngaGuardMmjLoop'
    end

    gs 'ActUiPrepare', 'Войти сзади (анал), Грюн спереди', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        $MmjPose = 'dp_stefan_anal'
        MmjIsDp = 1
        gt 'IngaGuardMmjLoop'
    end
---

#IngaGuardMmjFinish
    $MmjFinishChoice = $ARGS[0]

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/guard_quest/mmj_loop_finish', 'ФИНАЛ СОВМЕСТНОЙ СЦЕНЫ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ПОДСОБКА: ФИНАЛ'

    if LOC('IngaGuardMmjFinishText') = 1:
        gs 'IngaGuardMmjFinishText', $MmjFinishChoice
    end

    gs 'RegisterPlayerCum'
    sluttiness['inga'] += 2
    gs 'ClampGirlSocialStats', 'inga'

    killvar '$MmjPose'
    killvar 'MmjSwapCount'
    killvar 'MmjIsDp'
    killvar '$MmjFinishChoice'

    *pl ' '
    gs 'ActUiPrepare', 'Вернуться на рынок', 'market'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

! ================================================
! ОБРАТНАЯ СОВМЕСТИМОСТЬ
! ================================================

#IngaGuardSaturdayInterrupt
    gt 'Market'
---

#IngaGuardSaturdayAfterInterrupt
    gt 'Market'
---

#IngaGuardSaturdayDebugReset
    IngaGuardSaturdayDone = 0
    IngaGuardSaturdayLastDay = 0
    IngaGuardSaturdayCanStart = 0
    IngaGuardLadderStage = 0
    IngaGuardLadderDone = 0
    IngaGuardMmjStage = 0
    IngaGuardMmjLadderDone = 0
    IngaGuardBribedExit = 0
---