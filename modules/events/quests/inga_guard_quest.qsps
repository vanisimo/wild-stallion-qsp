    end

    IngaGuardLadderStage = 1
    sluttiness['inga'] += 1
    IngaNpcPath += 1
    gs 'ClampGirlSocialStats', 'inga'

    *pl ' '
    gs 'ActUiPrepare', 'Тихо уйти на рынок', 'market'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
