! ================================================
! FILE: modules/events/irma/irma_lizette_panties_text.qsps
! MODULE: events/irma
! ! [AI-WORKED] Текст переработан / дополнен ассистентом 03.11.2026
! Тексты покупки белья Лизетте в лавке Ирмы
! ================================================

#IrmaLizettePantiesPrintText
    $TextKey = LCASE(TRIM($ARGS[0]))

    if $TextKey = 'shop_meet':
        *pl 'Ты переступаешь порог мастерской Ирмы и сразу слышишь звонкий знакомый смех.'
        *pl 'Лизетта крутится у застеклённой витрины, разглядывая кружева. Заметив тебя, она радостно взвизгивает и подбегает вплотную, повиснув на твоём плече:'
        *pl '— Стефан! А я тебя уже заждалась! Гляди, что я нашла!'
        *pl 'Она указывает пальчиком на бархатную подушечку под стеклом, где лежат тончайшие белые прозрачные трусики столичной работы с аккуратной шёлковой каймой.'
        *pl '— Я о таких месяц мечтала! Доставай звонкие монеты, как обещал!'
        *pl 'За прилавком с лёгкой снисходительной улыбкой стоит Ирма:'
        *pl '— Добрый день, Стефан. Твоя юная спутница не теряет времени. Ткань чистый столичный шёлк — двадцать спринтриев.'

    elseif $TextKey = 'undress_hall':
        *pl 'Ты выкладываешь на полированное дерево прилавка двадцать блестящих спринтриев.'
        *pl 'Лизетта пищит от чистого восторга, хватает тонкое кружево, с размаху целует тебя в щёку и прямо посреди торгового зала задирает юбку выше пояса.'
        *pl 'Одним ловким движением она стягивает простые холщовые панталоны и швыряет их на скамью, сверкая тёмными округлыми бёдрами.'
        *pl 'Ирма всплёскивает руками и строго хмурит брови:'
        *pl '— Лизетта! Ты в приличной мастерской, а не на пирсе у пьяных матросов! Живо в примерочную!'
        *pl 'Полуэльфийка подхватывает девушку под локоть и уводит за плотную бархатную штору. Через секунду из-за ткани высовывается кудрявая голова Лизетты:'
        *pl '— Стефан, чего стоишь как чужой? Заходи скорее, оценишь обновку!'

    elseif $TextKey = 'fitting_room':
        *pl 'Ты отодвигаешь портьеру и заходишь в тёплую, освещённую свечами примерочную.'
        *pl 'Лизетта стоит перед высоким овальным зеркалом в одних лишь новых трусиках. Белая полупрозрачная паутинка шёлка сидит на её упругой попке как влитая, ослепительно контрастируя со смуглой матовой кожей.'
        *pl 'Она крутится, любуясь отражением, показывает тебе язык и бросается в твои объятия:'
        *pl '— Стефан, они идеальные! Спасибо-спасибо-спасибо! Я бы прямо сейчас тебе дала, честное слово, но тогда испачкаю шёлк, а мне их так жалко... Да и место здесь чересчур строгое.'
        *pl 'Ирма, стоящая у стойки с зеркалом, деликатно отступает к выходу:'
        *pl '— Я могу оставить вас одних, если желаете.'
        *pl '— Ой, да брось, Ирма, ты нам совсем не мешаешь! — беззаботно отмахивается Лизетта.'
        *pl 'Она опускается на колени перед тобой на ковёр, стягивает твои штаны и с озорной улыбкой обхватывает твой стоящий уд влажными горячими губами.'
        *pl 'Лизетта ласкает твою плоть с упоением и страстью, время от времени бросая смеющиеся взгляды снизу вверх на тебя и смущённо наблюдающую портниху. Через несколько минут волна наслаждения накрывает тебя с головой.'

    elseif $TextKey = 'finish':
        *pl 'Ты шумно выдыхаешь и выплёскиваешь горячее семя на губы и подбородок девушки. Лизетта довольно щурится, ловя густые капли кончиком языка.'
        *pl 'Ирма замирает. Взгляд полуэльфийки прикован к белым потёкам на смуглом лице Лизетты.'
        *pl 'Она медленно подходит ближе, словно в трансе, опускается рядом и касается пальцем свежего сгустка семени у края губ девушки.'
        *pl 'Поднеся палец к собственным губам, Ирма пробует каплю на язык, прикрывая глаза.'
        *pl '— Поразительно... — тихо шепчет она, и в её фиолетовых глазах вспыхивает таинственный зелёный отблеск. — В тебе бродит огромная сила, Стефан. Дикая, нетронутая, как соки священного Древа.'
        *pl 'Она медленно открывает глаза и пристально смотрит тебе прямо в душу:'
        *pl '— Мы ещё обязательно вернёмся к этому разговору, хозяин трактира. В потайном саду. А пока... вы оба получили, что хотели.'
        *pl 'Лизетта довольно поправляет платье и чмокает тебя на прощание: дело сделано, обновка красуется на ней, а в кармане у тебя лежит неопровержимая улика против Легаре.'

    end

    killvar '$TextKey'
---
