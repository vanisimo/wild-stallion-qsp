! ================================================
! FILE: modules/events/irma/irma_tree_arc_text.qsps
! MODULE: events/irma
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.10.2026
! Нарративные тексты ночных сцен Ирмы, тайного сада, омовения и ритуалов плодородия у Древа
! ================================================

#IrmaTreePrintText
    $IrmaTreeTextId = $ARGS[0]

    if $IrmaTreeTextId = 'night_hub_intro':
        *pl 'В ночной мастерской царит глубокий, сокровенный покой. На дубовом раскройном столе горят толстые восковые свечи, бросая золотые отсветы на отрезы тонкого шёлка.'
        *pl ' '
        *pl 'Ирма сидит в глубоком кресле, одетая в струящийся полупрозрачный пеньюар цвета увядшей розы. Серебристые эльфийские волосы мягкой волной рассыпаны по обнажённым плечам. Она встречает тебя тёплой, чуть насмешливой улыбкой хозяйки, привыкшей видеть сквозь любые мужские намерения.'
        *pl ' '
        *pl '— Доброй ночи, Стефан. Пришёл погреться у моего огня или жаждешь прикоснуться к тайнам, о которых молчит этот город?'

    elseif $IrmaTreeTextId = 'first_visit_intro':
        *pl 'Ты осторожно стучишь в кованую заднюю дверь мастерской. В ночной тишине ремесленного квартала каждый звук кажется предательски громким.'
        *pl ' '
        *pl 'За дверью слышится лёгкий шорох ткани, щёлкает тяжёлый засов, и створка приоткрывается. На пороге стоит Ирма. На ней лёгкий домашний пеньюар, едва прикрывающий округлые бёдра и высокую девичью грудь, сквозь тонкую ткань которой проступают тёмные ареолы сосков.'
        *pl ' '
        *pl 'Полуэльфийка смеривает тебя долгим, оценивающим взглядом, а затем губ её касается лукавая улыбка:'
        *pl ' '
        *pl '— Хозяин «Дикого Жеребца» собственной персоной... И что же привело молодого трактирщика ко мне в такой неурочный час? Неужели городские сплетни не дают уснуть?'
        *pl ' '
        *pl 'Она распахивает дверь шире, впуская тебя в тёплый полумрак мастерской, пахнущей высушенными горными травами, шёлком и тонким мускусным ароматом её собственного тела.'

    elseif $IrmaTreeTextId = 'mayor_truth_text':
        *pl 'Ты садишься напротив и, не выдержав любопытства, задаёшь вопрос, о котором шепчется вся Соборная площадь: правда ли мэр Борджиа бегает к ней по ночам, чтобы «снимать мерки без штанов»?'
        *pl ' '
        *pl 'Ирма заливисто и искренне смеётся, запрокинув голову. Её серебристые локоны вздрагивают на тонких ключицах:'
        *pl ' '
        *pl '— О, Ильматер всеблагой! Людская молва всегда примитивнее правды. Старый Борджиа действительно приходит сюда после танцев. И да — без одежды. Но не ради плотских забав, как воображают кумушки у рыбных рядов. Мэру под шестьдесят, Стефан. Его тело сохнет, суставы ноют, а мужская сила тает с каждым месяцем.'
        *pl ' '
        *pl 'Она делает глоток травяного настоя и серьёзнеет:'
        *pl ' '
        *pl '— Борджиа приходит ради священных соков Древа Жизни. Я делаю ему ритуальные массажи и готовлю восстанавливающие настойки. Без них он давно слёг бы в постель и потерял власть. Но старый чиновник — сухой ствол. Он только берёт от Древа силу, не способный вернуть ему ничего взамен.'
        *pl ' '
        *pl 'Ирма плавно поднимается на ноги, берёт со стола шёлковую портновскую ленту и медленно подходит к тебе:'
        *pl ' '
        *pl '— А вот в тебе, мальчик мой, кровь кипит ключом. Снимай одежду, Стефан. Давай посмотрим, каков ты без грубого сукна и сапог. Я сниму с тебя настоящие мерки.'

    elseif $IrmaTreeTextId = 'fitting_scene_text':
        *pl 'Ты скидываешь сапоги, расстёгиваешь ремень и стягиваешь рубаху со штанами, оставаясь абсолютно нагим посреди озарённой свечами мастерской. Прохладный ночной воздух приятно холодит кожу.'
        *pl ' '
        *pl 'Ирма обходит тебя по кругу, не скрывая профессионального и чисто женского восхищения. Её длинные прохладные пальцы скользят по твоим широким плечам, очерчивают рельеф груди и спускаются по твёрдым мышцам пресса.'
        *pl ' '
        *pl '— Какая стать... — мурлычет полуэльфийка. — Ни капли дряблости, ни следа чиновничьей жижи. Настоящий дикий жеребец.'
        *pl ' '
        *pl 'Она накидывает измерительную ленту на твои бёдра, затем опускается на колени прямо перед тобой. От её близости, от тёплого дыхания и аромата эльфийских масел кровь с глухим гулом приливает к паху. Твой член на глазах у Ирмы стремительно наливается тяжёлой сталью, поднимаясь вверх.'
        *pl ' '
        *pl 'Ирма замирает, глядя на твой восемнадцатисантиметровый эрегированный ствол с крупной багровой головкой. Её зрачки расширяются, а на губах играет манящая улыбка:'
        *pl ' '
        *pl '— Семья Лонгкоков гордится этой фамилией не на пустом месте... — шепчет она, обвивая твой разгорячённый уд гибкой шёлковой лентой и с лёгким стоном скользя ладонью от яичек до самого венчика. — Древо Жизни века не знало столь могучего и чистого мужского корня.'

    elseif $IrmaTreeTextId = 'fitting_kiss_text':
        *pl 'Не в силах больше сдерживать дурманящее влечение, ты подаёшься вперёд, обхватываешь Ирму за талию и привлекаешь к себе. Твои губы накрывают её чувственный рот.'
        *pl ' '
        *pl 'Полуэльфийка вздрагивает, но не отстраняется — наоборот, с жадным тихим стоном отвечает на твой поцелуй. Её тонкий гибкий язык сплетается с твоим, со вкусом пряных горных трав и терпкого мёда. Её руки впиваются в твои обнажённые плечи, прижимаясь всем податливым телом к твоему раскалённому члену.'
        *pl ' '
        *pl 'Прервав поцелуй, Ирма тяжело дышит, глядя на тебя затуманенными страстью глазами:'
        *pl ' '
        *pl '— Хватит медлить... Пойдём. Древо ждёт тебя.'

    elseif $IrmaTreeTextId = 'fitting_repeat_text':
        *pl 'В привычном полумраке ночной мастерской ты сбрасываешь одежду, отдаваясь в умелые руки Ирмы. Полуэльфийка ласкает твою нагую кожу ароматными маслами, снимает напряжение прошедшего дня и дразнит твой вздыбленный член тонкими шёлковыми лентами.'
        *pl ' '
        *pl 'Каждое её прикосновение распаляет кровь, пробуждая дикую первобытную силу, готовую вырваться на волю.'

    elseif $IrmaTreeTextId = 'garden_enter_intro':
        *pl 'Ирма берёт тебя за руку и ведёт к тяжёлой дубовой двери за бархатной портьерой. Щёлкает кованый замок, створка бесшумно отворяется — и в лицо ударяет влажный, пьянящий аромат цветущих трав и первозданного леса.'
        *pl ' '
        *pl 'Ты выходишь во внутренний двор, надёжно скрытый со всех сторон высокими гранитными стенами городской цитадели. Сверху сияет полная луна, заливая двор серебристым сиянием.'
        *pl ' '
        *pl 'А прямо перед тобой возвышается Древо Жизни. Колоссальный древний исполин, чьи корни, словно мускулы великана, взламывают каменные плиты, а крона мерцает живым изумрудно-серебряным светом. У его подножия бьёт чистый источник, наполняющий широкую чашу из белого мрамора.'

    elseif $IrmaTreeTextId = 'tree_garden_hub':
        *pl 'Ты стоишь в сокровенном святилище посреди спящего города. Листва Древа Жизни едва слышно звенит на ночном ветру, словно поёт древнюю эльфийскую песнь. В воздухе разлит покой, исцеляющий душу и наполняющий тело первобытной бодростью.'
        *pl ' '
        *pl 'Рядом с мраморной купелью курится чаша с порошком «Таро», а мягкий мох у корней манит возлечь под сенью священных ветвей.'

    elseif $IrmaTreeTextId = 'bath_ritual_text':
        *pl 'Ирма медленно распускает пояс своего пеньюара и сбрасывает шёлк на траву. Перед тобой предстаёт её совершенное обнажённое тело: высокая упругая грудь, тонкая осиная талия, плавный изгиб бёдер и аккуратный, гладко выбритый по завету чистоты Ильматера лобок.'
        *pl ' '
        *pl 'Она ступает в тёплую воду мраморной купели и манит тебя за собой. Ты погружаешься в воду рядом с ней. Вода приятно покалывает кожу, снимая всю дневную усталость.'
        *pl ' '
        *pl 'Ирма берёт горсть серого порошка «Таро», разводит его в ладонях до состояния нежнейшей мыльной пены и начинает бережно омывать твоё тело. Её ладони скользят по твоей шее, груди, спускаются к животу. Вода в купели бурлит от её ласк, а когда её пальцы смыкаются вокруг твоего каменного удa, ты не удерживаешься от хриплого стона.'
        *pl ' '
        *pl 'Она опускается ниже, лаская твой член под водой губами и языком, очищая плоть перед алтарём. Твоё дыхание сбивается, а в жилах закипает священное пламя.'

    elseif $IrmaTreeTextId = 'fertility_ritual_text':
        *pl 'Выбравшись из купели, Ирма увлекает тебя на мягкое ложе из изумрудного мха, прямо меж могучих корней Древа Жизни.'
        *pl ' '
        *pl 'Она ложится на спину, раскинув серебристые волосы, и широко разводит длинные стройные ноги, открывая влажное, готовое к соитию женское лоно. Листья Древа над вами начинают пульсировать мягким серебристым светом, чувствуя близость ритуала.'
        *pl ' '
        *pl '— Войди в меня, Стефан... — шепчет Ирма прерывающимся голосом жрицы. — Наполни меня... Отдай свою силу корням!'
        *pl ' '
        *pl 'Ты нависаешь над ней, упираешься багровой головкой во влажные складки и одним плавным, мощным толчком входишь в её горячее, узкое нутро до самого упора. Ирма вскрикивает от сладостной полноты, запрокидывает голову и обвивает твои бёдра ногами, намертво замыкая тебя в себе.'
        *pl ' '
        *pl 'Ты начинаешь размеренно и глубоко вбиваться в неё. Каждое движение сопровождается влажным шлепаньем плоти о плоть и сдавленными стонами полуэльфийки. Она царапает твою спину, извивается под тобой, а корни Древа под вашими телами словно вибрируют в такт каждому твоему толчку, впитывая жар первобытной страсти.'
        *pl ' '
        *pl 'Чувствуя приближение неумолимой разрядки, ты ускоряешь темп, вбиваясь до основания. Ирма кричит, её вагина сжимается серией мощных спазмов женского оргазма, и в этот миг ты с хриплым рыком изливаешь мощные, густые струи семени глубоко в её разгорячённое нутро, делясь жизненной силой с ней и с древней землёй под вами!'

    elseif $IrmaTreeTextId = 'post_ritual_text':
        *pl 'Дрожь соития постепенно стихает. Серебряный свет в кроне Древа вспыхивает ярче, а затем мягко рассеивается, окутывая вас тёплым благодатным маревом.'
        *pl ' '
        *pl 'Ирма обессиленно лежит на мху, прижимаясь мокрой щекой к твоей вздымающейся груди. Её дыхание постепенно выравнивается, а на губах блуждает счастливая, умиротворённая улыбка:'
        *pl ' '
        *pl '— Ты чувствуешь?.. Древо напилось. Оно признало тебя, мой дикий жеребец. Теперь его сила течёт и в твоих жилах.'
        *pl ' '
        *pl 'Ты ощущаешь, как по телу разливается невероятная бодрость: усталость ушла, в паху сохраняется упругая готовность, а разум чист и спокоен.'

    elseif $IrmaTreeTextId = 'elixir_brew_text':
        *pl 'Ирма подходит к чаше из полированного корня, наполняет серебряный кубок густой изумрудной жидкостью со свежими листьями Древа и протягивает его тебе.'
        *pl ' '
        *pl 'Ты делаешь глубокий глоток. Напиток на вкус терпкий, пахнет диким мёдом и хвоей. В ту же секунду по жилам прокатывается обжигающая волна: в висках проясняется, мышцы наливаются упругой мощью, а мужская сила в паху восстанавливается до предела, стирая всякую тень дневной усталости!'
        *pl ' '
        *pl '— Пей, Стефан, — ласково улыбается Ирма. — Этот эликсир восстановит твоё мужское семя, сколько бы раз ты сегодня ни познал женщину. Сила Древа бережёт тебя.'
    end
---
