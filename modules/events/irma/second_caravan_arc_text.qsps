! ================================================
! FILE: modules/events/irma/second_caravan_arc_text.qsps
! MODULE: events/irma
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.10.2026
! Нарративные тексты ветки второго каравана (стратегия Ирмы, шаман Грок-Таш, битва кланов, триумф)
! ================================================

#SecondCaravanPrintText
    $CaravanTextId = $ARGS[0]

    if $CaravanTextId = 'irma_plan_intro':
        *pl 'Ирма раскладывает на замшелом каменном парапете у Древа Жизни старинный пергамент с картой Диких Земель.'
        *pl ' '
        *pl '— Первый обоз со сталью пропал в ущелье, Стефан. Но Столица не успокоится: ровно через месяц в наш порт прибудет второй транспортный галеас с новой партией клинков и арбалетов.'
        *pl ' '
        *pl 'Она очерчивает пальцем скалистый хребет на севере карты:'
        *pl ' '
        *pl '— Орки клана «Степных Волков» сейчас в бешенстве: столичные эмиссары обещали им оружие, но груз так и не дошёл. Они рыщут у границы, готовые разорвать любого человека. Но они не знают, что обоз перехватили дикари «Красного Топора»!'
        *pl ' '
        *pl 'Полуэльфийка вкладывает в твою ладонь резной медальон из белого корня с эльфийской руной мира:'
        *pl ' '
        *pl '— Возьми этот оберег, Стефан. Выезжай через Северные ворота в пустоши и покажи его дозору Степных Волков. Они отведут тебя к старому шаману Грок-Ташу. Открой ему правду: кто украл их мечи и где логово воров. А взамен пообещай, что второй караван выйдет навстречу прямо к их переправе. Пусть два диких племени сцепятся насмерть за эту сталь!'

    elseif $CaravanTextId = 'wolves_patrol_text':
        *pl 'Ты направляешь коня по каменистой тропе в глубь северных пустошей. Ветер доносит горький запах полыни и дыма.'
        *pl ' '
        *pl 'Внезапно из-за серых валунов с гортанным рыком выскакивают четверо массивных зеленокожих орков верхом на гигантских боевых волках. В их руках зажаты зазубренные копья, а глаза горят дикой жаждой крови.'
        *pl ' '
        *pl 'Конь встаёт на дыбы. Ты поднимаешь над головой резной амулет из корня Древа Жизни. Белая руна ярко вспыхивает в лучах полуденного солнца.'
        *pl ' '
        *pl 'Орки осекаются, свирепо переглядываются и опускают копья. Старший дозорный глухо рычит на ломаном человеческом наречии:'
        *pl ' '
        *pl '— Знак Древа... Человек несёт знак Матери Леса. Мы не убивать. Шаман Грок-Таш будет говорить!'

    elseif $CaravanTextId = 'shaman_tent_intro':
        *pl 'Тебя приводят в огромное стойбище из грубых шкур. В центре лагеря курится костёр из смолистых костей, вокруг которого сидит верховный шаман Грок-Таш — сгорбленный, увешанный амулетами из черепов старый орк с горящими углями глаз.'
        *pl ' '
        *pl '— Зачем сын людей пришёл в пустоши? — голос шамана звучит как скрежет камней. — Ваши князья обещали Степным Волкам городскую сталь за мир на трактах! Где наши мечи?! Вы обманули нас, и мы сожжём ваши хутора дотла!'

    elseif $CaravanTextId = 'shaman_pact_text':
        *pl 'Ты сохраняешь ледяное спокойствие, глядя прямо в глаза вождю дикарей:'
        *pl ' '
        *pl '— Город не обманывал вас, Грок-Таш. Караван шёл к вам. Но в ущелье на обоз напали шакалы клана «Красного Топора»! Они перебили охрану, украли ваши мечи и сейчас хвастаются вашей сталью в своём логове!'
        *pl ' '
        *pl 'Шаман замирает, его клыки скрежещут от неописуемой ярости:'
        *pl ' '
        *pl '— Красный Топор?! Эти падальщики посмели украсть наше железо?!'
        *pl ' '
        *pl '— Да. Но через месяц из порта выйдет второй обоз с оружием. Мы направим его не по тракту, а прямо к вашей переправе. Вы получите новые мечи, арбалеты и доспехи. А взамен — обрушьте всю эту сталь на логово Красного Топора и сотрите их род с лица земли!'
        *pl ' '
        *pl 'Грок-Таш тяжело дышит, затем выхватывает кремнёвый нож, полосует свою ладонь и прижимает окровавленный кулак к твоей руке:'
        *pl ' '
        *pl '— Кровный договор заключён! Степные Волки клянутся кровью: мы не тронем город и Древо. Мы встретим повозки на переправе, а потом кишки воинов Красного Топора украсят скалы ущелья!'

    elseif $CaravanTextId = 'battle_climax_text':
        *pl 'Месяц спустя второй столичный обоз под охраной выходит за городские ворота и берёт курс к северной переправе.'
        *pl ' '
        *pl 'Ты наблюдаешь с высокого скалистого гребня. На переправе обозников уже встречает орда Степных Волков. Передача ящиков проходит строго по уговору — испуганные возницы отдают груз и без единой царапины поворачивают телеги обратно к городу.'
        *pl ' '
        *pl 'А затем начинается буря.'
        *pl ' '
        *pl 'Вооружившись столичными стальными клинками, щитами и мощными арбалетами, сотни разъярённых Степных Волков лавиной обрушиваются на ущелье дикарей Красного Топора!'
        *pl ' '
        *pl 'Эхо разносит яростный вой, звон скрещивающейся стали и предсмертные вопли. Дикари Красного Топора пытаются отбиваться награбленным ранее оружием, но Степные Волки рвут их строй на куски. Кровавая бойня длится до самых сумерек, пока ущелье не затихает.'
        *pl ' '
        *pl 'Оба свирепых племени перемололи друг друга в прах: клан Красного Топора истреблён под корень, а остатки обескровленных Степных Волков уходят далеко на север в ледяные тундры, лишившись сил набегать на рубежи на долгие десятилетия!'

    elseif $CaravanTextId = 'triumph_aftermath_text':
        *pl 'В Квартале ремесленников стоит невероятный гул. У кузницы Драупнира собрались купцы, оружейники и возницы.'
        *pl ' '
        *pl '— Слыхали?! — гремит Драупнир, увидав тебя, и со всего размаха опускает кружку эля на наковальню. — Орки в ущелье перерезали друг дружку начисто! Тракты к Рудным Горам Казад-Хера свободны! Ни одной банды, ни одного заслона!'
        *pl ' '
        *pl 'Гном сгребает тебя в медвежьи объятия и выставляет на прилавок тяжёлый кошель:'
        *pl ' '
        *pl '— Четыреста полновесных спинтарий твоей доли за открытие пути, парень! Плюс лучшие обозы с солодом, мукой и копчёностями идут прямо в погреба «Дикого Жеребца»! Весь город пьёт за твою удачу!'

    elseif $CaravanTextId = 'irma_reward_text':
        *pl 'Поздней ночью ты входишь в потайной сад Древа Жизни. Листва древнего исполина горит ослепительным серебристым огнём, наполняя воздух звоном чистейшей магии.'
        *pl ' '
        *pl 'Ирма встречает тебя у мраморной купели. На ней нет никакой одежды — её совершенное тело светится в лунном свете, словно сотканное из звёздной пыли.'
        *pl ' '
        *pl 'Она делает шаг навстречу и крепко обвивает твою шею руками, прижимаясь всем горячим трепещущим телом:'
        *pl ' '
        *pl '— Ты сделал это, Стефан... Дикари разбиты, пограничье спасено, а корни Древа больше не чувствуют страха и скверны.'
        *pl ' '
        *pl 'Она медленно опускается вместе с тобой на мягкий ковёр из мха под шелест серебряных ветвей:'
        *pl ' '
        *pl '— Сегодня Древо славит тебя... и я принадлежу тебе вся, до последней капли моей эльфийской души.'
    end
---
