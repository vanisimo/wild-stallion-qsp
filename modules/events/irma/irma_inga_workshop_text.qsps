! ================================================
! FILE: modules/events/irma/irma_inga_workshop_text.qsps
! MODULE: events/irma
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.10.2026
! Нарративные тексты мастерской Ирмы и Инги (обучение, снятие мерок, примерка, таинство омовения у Древа)
! ================================================

#IrmaIngaWorkshopPrintText
    $WorkshopTextId = $ARGS[0]

    if $WorkshopTextId = 'apprentice_talk_text':
        *pl 'Ты подходишь к широкому дубовому раскройному столу в глубине лавки. Инга усердно намётывает край тонкой льняной юбки, то и дело поправляя за ухо выбившуюся каштановую прядку.'
        *pl ' '
        *pl 'Ирма стоит рядом, сложив руки на груди, и с лёгкой наставнической строгостью наблюдает за каждым движением ученицы:'
        *pl ' '
        *pl '— Стежок должен быть мелким и ровным, Инга. Подол платья — это первое, на что смотрят на танцах, когда девушка кружится перед кавалерами. Заметишь неровность — распускай без жалости.'
        *pl ' '
        *pl 'Завидев тебя, Инга поднимает глаза и мгновенно вспыхивает нежным румянцем. Её губы трогает робкая, радостная улыбка:'
        *pl ' '
        *pl '— Здравствуй, Стефан... Я сегодня помогаю госпоже Ирме с новыми заказами для городских дам. Госпожа говорит, что у меня уже твёрже держится игла.'
        *pl ' '
        *pl 'Ирма бросает на девушку оценивающий взгляд и мягко улыбается:'
        *pl ' '
        *pl '— Способности у неё есть, и усердия не занимать. Осталось научиться чувствовать ткань и не бояться человеческого тела.'

    elseif $WorkshopTextId = 'fitting_stefan_text':
        *pl 'Ирма снимает со своей шеи шёлковую измерительную ленту и вкладывает её в ладонь ученицы:'
        *pl ' '
        *pl '— Хватит шить по книжкам, Инга. Настоящая портниха обязана уметь работать с живым клиентом. Вот господин Стефан — статный молодой мужчина. Возьми ленту и сними с него мерки для праздничного дублета.'
        *pl ' '
        *pl 'Инга смущённо сглатывает ком в горле, делает шаг к тебе и робко поднимает глаза. Её щёки пылают. Ты с улыбкой расправляешь плечи, давая девушке свободу действий.'
        *pl ' '
        *pl 'Её тонкие, слегка дрожащие пальцы ложатся на твои плечи, измеряя размах спины, затем скользят по груди, плотно прижимая ленту к твоим мышцам. От её близости, от тёплого девичьего дыхания и аромата луговых цветов в твоей груди сладко замирает сердце.'
        *pl ' '
        *pl '— Плечи... сорок восемь... — тихо, почти шёпотом произносит Инга, опускаясь на колени, чтобы измерить линию талии и бёдер. Лента охватывает твой пояс, пальцы девушки случайно задевают ткань штанов в районе паха, где от её близости уже проступает упругая твёрдость. Инга вздрагивает, задерживает дыхание и бросает на тебя испуганный и одновременно обжигающий взгляд.'
        *pl ' '
        *pl 'Ирма за её спиной лукаво усмехается:'
        *pl ' '
        *pl '— Прекрасно, Инга. Не отдёргивай руку. Мужское тело требует уверенности и твёрдой посадки ткани.'

    elseif $WorkshopTextId = 'dress_tryon_text':
        *pl '— А теперь твоя очередь, Инга, — Ирма снимает с манекена великолепное платье цвета спелой вишни с глубоким фигурным вырезом и открытыми плечами. — Я закончила подгонку. Ступай за ширму, примерь. Нам нужен строгий мужской взгляд Стефана.'
        *pl ' '
        *pl 'Спустя пару минут шёлковая портьера отодвигается, и Инга выходит на середину лавки. У тебя перехватывает дыхание.'
        *pl ' '
        *pl 'Платье сидит как влитое, облегая её тонкую талию и подчеркивая округлые соблазнительные бёдра. Корсет приподнимает её высокую девичью грудь, приоткрывая манящую ложбинку. Инга смущённо поводит плечами, глядя в пол, но в её глазах горит искренний восторг от собственного отражения в ростовом зеркале.'
        *pl ' '
        *pl '— Ну как, Стефан? — спрашивает Ирма, поправляя подол на бёдрах девушки. — Как тебе наша ученица?'
        *pl ' '
        *pl '— Ты ослепительна, Инга, — искренне произносишь ты, любуясь её грацией. — В таком наряде на площади в пятницу все парни потеряют рассудок.'
        *pl ' '
        *pl 'Инга поднимает на тебя сияющие благодарностью глаза, закусив губу от нахлынувшего счастья.'

    elseif $WorkshopTextId = 'tree_visit_text':
        *pl 'Поздним вечером, когда лавка закрывается на тяжёлый засов, Ирма берёт Ингу за руку и отворяет кованую дверь во внутренний дворик.'
        *pl ' '
        *pl 'Инга замирает на пороге, прижав ладони к груди. В ночном воздухе величественно возвышается Древо Жизни, озарённое мерцающим серебристым сиянием. Листва древнего исполина тихо шелестит, словно приветствуя вошедших.'
        *pl ' '
        *pl '— Это священное место, дитя, — ласково говорит Ирма, помогая Инге снять платье. — Здесь нет места городскому стыду и людским кривотолкам. Ильматер заповедал держать тело в чистоте, а древняя Эллона благословляет женственность и продолжение жизни.'
        *pl ' '
        *pl 'Инга доверчиво сбрасывает одежду, оставаясь нагой в серебристом лунном свете, и робко ступает в тёплую мраморную купель у корней. Ты входишь в воду вслед за ней.'
        *pl ' '
        *pl 'Ирма взбивает в ладонях порошок «Таро» в нежную ароматную пену и бережно омывает плечи и спину Инги, смывая последние следы робости. Ты обнимаешь девушку за талию, прижимая её к себе в целебной воде. Инга расслабляется, прислоняется затылком к твоему плечу и доверчиво выдыхает, ощущая тепло твоих рук и защиту полуэльфийки.'
        *pl ' '
        *pl 'Под сенью сияющего Древа Жизни ваши сердца бьются в унисон, наполняясь покоем, чистотой и глубокой чувственной гармонией.'
    end
---
