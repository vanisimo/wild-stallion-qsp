! ================================================
! FILE: modules/events/family/daily_aftermath.qsps
! MODULE: family
! Система ежедневных последствий
! Версия: v4 / unified with GirlRemembers* memory
! ================================================

#DailyAftermathQueue

    DailyAftermathPending = 1
---

#DailyAftermathCanRun

    DailyAftermathAvailable = 0

    if DailyAftermathPending = 1:
        DailyAftermathAvailable = 1
    end
---

#DailyAftermathProcess

    if DailyAftermathPending = 0:
        exit
    end

    if DailyAftermathShownToday = 1:
        exit
    end

    if $DailyAftermathReasonGirl = '' and $LastHallMemoryGirl <> '':
        $DailyAftermathReasonGirl = $LastHallMemoryGirl
        $DailyAftermathReasonEvent = $LastHallMemoryEvent
        $DailyAftermathReasonChoice = $LastHallMemoryChoice
    end

    gs 'DailyAftermathSelect'

    if $DailyAftermathSelected = '':
        exit
    end

    DailyAftermathPending = 0
    DailyAftermathShownToday = 1

    gt 'DailyAftermathShow', $DailyAftermathSelected
---

#DailyAftermathResetDaily

    DailyAftermathShownToday = 0
---

#DailyAftermathMarkFromChoice

    DailyAftermathPending = 1
    DailyAftermathReasonDay = day

    if $LastHallMemoryGirl <> '':
        $DailyAftermathReasonGirl = $LastHallMemoryGirl
        $DailyAftermathReasonChoice = $LastHallMemoryChoice
        $DailyAftermathReasonEvent = $LastHallMemoryEvent
    end
---

#DailyAftermathSelect

    $DailyAftermathSelected = ''

    if $DailyAftermathReasonGirl = 'amanda':
        if GirlRemembersProtection['amanda'] > GirlRemembersNeglect['amanda']:
            $DailyAftermathSelected = 'amanda_protection'
            exit
        end

        if GirlRemembersNeglect['amanda'] > GirlRemembersProtection['amanda']:
            $DailyAftermathSelected = 'amanda_neglect'
            exit
        end

        if GirlRemembersProfitChoices['amanda'] > 0:
            $DailyAftermathSelected = 'amanda_profit'
            exit
        end

        ! fallback по последнему выбору
        if $DailyAftermathReasonChoice = 'protect' or $DailyAftermathReasonChoice = 'protect_hard' or $DailyAftermathReasonChoice = 'stop':
            $DailyAftermathSelected = 'amanda_protection'
            exit
        end
        if $DailyAftermathReasonChoice = 'ignore' or $DailyAftermathReasonChoice = 'watch' or $DailyAftermathReasonChoice = 'peek':
            $DailyAftermathSelected = 'amanda_neglect'
            exit
        end
        if $DailyAftermathReasonChoice = 'profit' or $DailyAftermathReasonChoice = 'client' or $DailyAftermathReasonChoice = 'encourage':
            $DailyAftermathSelected = 'amanda_profit'
            exit
        end
    end

    if $DailyAftermathReasonGirl = 'melissa':
        if StefanInconsistentChoices > 0:
            $DailyAftermathSelected = 'melissa_doubt'
            exit
        end

        if GirlRemembersProtection['melissa'] > GirlRemembersNeglect['melissa']:
            $DailyAftermathSelected = 'melissa_respect'
            exit
        end

        if GirlRemembersProfitChoices['melissa'] > 0:
            $DailyAftermathSelected = 'melissa_profit'
            exit
        end

        ! нет отдельного melissa_neglect — watch/ignore → doubt
        if $DailyAftermathReasonChoice = 'protect' or $DailyAftermathReasonChoice = 'protect_hard' or $DailyAftermathReasonChoice = 'stop':
            $DailyAftermathSelected = 'melissa_respect'
            exit
        end
        if $DailyAftermathReasonChoice = 'ignore' or $DailyAftermathReasonChoice = 'watch' or $DailyAftermathReasonChoice = 'peek':
            $DailyAftermathSelected = 'melissa_doubt'
            exit
        end
        if $DailyAftermathReasonChoice = 'profit' or $DailyAftermathReasonChoice = 'client' or $DailyAftermathReasonChoice = 'encourage':
            $DailyAftermathSelected = 'melissa_profit'
            exit
        end
    end

    if $DailyAftermathReasonGirl = 'sandra':
        if GirlRemembersProfitChoices['sandra'] > 0 or FamilyTension > FamilyTrust:
            $DailyAftermathSelected = 'sandra_concern'
            exit
        end

        if GirlRemembersProtection['sandra'] > 0 or FamilyTrust >= FamilyTension:
            $DailyAftermathSelected = 'sandra_trust'
            exit
        end

        if $DailyAftermathReasonChoice = 'profit' or $DailyAftermathReasonChoice = 'client' or $DailyAftermathReasonChoice = 'encourage' or $DailyAftermathReasonChoice = 'ignore' or $DailyAftermathReasonChoice = 'watch':
            $DailyAftermathSelected = 'sandra_concern'
            exit
        end
        if $DailyAftermathReasonChoice = 'protect' or $DailyAftermathReasonChoice = 'protect_hard' or $DailyAftermathReasonChoice = 'stop':
            $DailyAftermathSelected = 'sandra_trust'
            exit
        end
    end

    if FamilyTension >= FamilyTrust + 5:
        $DailyAftermathSelected = 'family_tension'
        exit
    end

    if FamilyTrust >= FamilyTension + 5:
        $DailyAftermathSelected = 'family_trust'
        exit
    end

    ! последний fallback: не молчать, если reason girl задан
    if $DailyAftermathReasonGirl = 'amanda':
        $DailyAftermathSelected = 'amanda_protection'
        exit
    end
    if $DailyAftermathReasonGirl = 'melissa':
        $DailyAftermathSelected = 'melissa_respect'
        exit
    end
    if $DailyAftermathReasonGirl = 'sandra':
        $DailyAftermathSelected = 'sandra_concern'
        exit
    end

    if FamilyTension > FamilyTrust:
        $DailyAftermathSelected = 'family_tension'
    else:
        $DailyAftermathSelected = 'family_trust'
    end
---

#DailyAftermathShow

    $DailyAftermathScene = LCASE($ARGS[0])

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/family/daily_aftermath/daily_aftermath_show', 'УТРО ПОСЛЕ СОБЫТИЙ', 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' УТРО ПОСЛЕ СОБЫТИЙ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'DailyAftermathPrintText', $DailyAftermathScene

    if debug = 1:
        *pl ' '
        *pl '[DEBUG AFTERMATH] scene: ' + $DailyAftermathScene
        *pl '[DEBUG AFTERMATH] reason girl: ' + $DailyAftermathReasonGirl
        *pl '[DEBUG AFTERMATH] reason choice: ' + $DailyAftermathReasonChoice
        *pl '[DEBUG AFTERMATH] reason event: ' + $DailyAftermathReasonEvent
        *pl '[DEBUG AFTERMATH] FamilyTrust: ' + STR(FamilyTrust)
        *pl '[DEBUG AFTERMATH] FamilyTension: ' + STR(FamilyTension)
        *pl '[DEBUG AFTERMATH] protect amanda: ' + STR(GirlRemembersProtection['amanda'])
        *pl '[DEBUG AFTERMATH] ignore amanda: ' + STR(GirlRemembersNeglect['amanda'])
        *pl '[DEBUG AFTERMATH] profit amanda: ' + STR(GirlRemembersProfitChoices['amanda'])
    end

    *pl ' '

    gs 'ActUiPrepare', 'Продолжить', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

! ARGS[0]=girl, ARGS[1]=event, ARGS[2]=choice (protect/ignore/watch/profit/encourage)
! Ставит память + pending и сразу показывает утро (полноэкран)
#DailyAftermathDebugForce

    $DAForceGirl = LCASE($ARGS[0])
    $DAForceEvent = LCASE($ARGS[1])
    $DAForceChoice = LCASE($ARGS[2])

    if $DAForceGirl = '':
        $DAForceGirl = 'amanda'
    end

    if $DAForceGirl <> 'amanda' and $DAForceGirl <> 'melissa' and $DAForceGirl <> 'sandra':
        $DAForceGirl = 'amanda'
    end

    if $DAForceEvent = '':
        $DAForceEvent = 'harassment'
    end

    if $DAForceChoice = '':
        $DAForceChoice = 'protect'
    end

    if $DAForceChoice = 'client':
        $DAForceChoice = 'profit'
    end

    if LOC('EnsureGirlData') = 1:
        gs 'EnsureGirlData', $DAForceGirl
    end

    if LOC('GirlMemoryOfStefanRegister') = 1:
        gs 'GirlMemoryOfStefanRegister', $DAForceGirl, $DAForceEvent, $DAForceChoice
    end

    DailyAftermathPending = 1
    DailyAftermathShownToday = 0
    DailyAftermathReasonDay = day
    $DailyAftermathReasonGirl = $DAForceGirl
    $DailyAftermathReasonEvent = $DAForceEvent
    $DailyAftermathReasonChoice = $DAForceChoice

    ! Явная сцена для debug — не зависеть от равных счётчиков / family stats
    $DailyAftermathSelected = ''
    if $DAForceGirl = 'amanda':
        if $DAForceChoice = 'protect' or $DAForceChoice = 'protect_hard' or $DAForceChoice = 'stop' or $DAForceChoice = 'hard_stop':
            $DailyAftermathSelected = 'amanda_protection'
        elseif $DAForceChoice = 'ignore' or $DAForceChoice = 'watch' or $DAForceChoice = 'peek' or $DAForceChoice = 'do_nothing':
            $DailyAftermathSelected = 'amanda_neglect'
        else:
            $DailyAftermathSelected = 'amanda_profit'
        end
    elseif $DAForceGirl = 'melissa':
        if $DAForceChoice = 'protect' or $DAForceChoice = 'protect_hard' or $DAForceChoice = 'stop':
            $DailyAftermathSelected = 'melissa_respect'
        elseif $DAForceChoice = 'profit' or $DAForceChoice = 'client' or $DAForceChoice = 'encourage' or $DAForceChoice = 'let_client':
            $DailyAftermathSelected = 'melissa_profit'
        else:
            $DailyAftermathSelected = 'melissa_doubt'
        end
    else:
        if $DAForceChoice = 'protect' or $DAForceChoice = 'protect_hard' or $DAForceChoice = 'stop':
            $DailyAftermathSelected = 'sandra_trust'
        else:
            $DailyAftermathSelected = 'sandra_concern'
        end
    end

    DailyAftermathPending = 0
    DailyAftermathShownToday = 1

    killvar '$DAForceGirl'
    killvar '$DAForceEvent'
    killvar '$DAForceChoice'

    gt 'DailyAftermathShow', $DailyAftermathSelected
---

#DailyAftermathDebugPanel

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/family/daily_aftermath/daily_aftermath_debug_panel', 'DEBUG: DAILY AFTERMATH', 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' DEBUG: DAILY AFTERMATH'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    *pl 'DailyAftermathPending: ' + STR(DailyAftermathPending)
    *pl 'DailyAftermathShownToday: ' + STR(DailyAftermathShownToday)
    *pl 'DailyAftermathReasonDay: ' + STR(DailyAftermathReasonDay)
    *pl 'Reason girl: ' + $DailyAftermathReasonGirl
    *pl 'Reason choice: ' + $DailyAftermathReasonChoice
    *pl 'Reason event: ' + $DailyAftermathReasonEvent
    *pl ' '
    *pl 'FamilyTrust: ' + STR(FamilyTrust)
    *pl 'FamilyTension: ' + STR(FamilyTension)
    *pl ' '
    *pl '<b>Память:</b>'
    *pl 'Аманда защита/игнор/прибыль: ' + STR(GirlRemembersProtection['amanda']) + ' / ' + STR(GirlRemembersNeglect['amanda']) + ' / ' + STR(GirlRemembersProfitChoices['amanda'])
    *pl 'Мелисса защита/игнор/прибыль: ' + STR(GirlRemembersProtection['melissa']) + ' / ' + STR(GirlRemembersNeglect['melissa']) + ' / ' + STR(GirlRemembersProfitChoices['melissa'])
    *pl 'Сандра защита/игнор/прибыль: ' + STR(GirlRemembersProtection['sandra']) + ' / ' + STR(GirlRemembersNeglect['sandra']) + ' / ' + STR(GirlRemembersProfitChoices['sandra'])
    *pl ' '

    gs 'ActUiPrepare', 'Тест: Аманда / защита → утро', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        gt 'DailyAftermathDebugForce', 'amanda', 'harassment', 'protect'
    end

    gs 'ActUiPrepare', 'Тест: Аманда / игнор → утро', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        gt 'DailyAftermathDebugForce', 'amanda', 'harassment', 'ignore'
    end

    gs 'ActUiPrepare', 'Тест: Мелисса / watch lewd → утро', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        gt 'DailyAftermathDebugForce', 'melissa', 'hall_lewd', 'watch'
    end

    gs 'ActUiPrepare', 'Тест: Сандра / прибыль → утро', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        gt 'DailyAftermathDebugForce', 'sandra', 'kitchen', 'profit'
    end

    gs 'ActUiPrepare', 'Только поставить pending (без показа)', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        DailyAftermathPending = 1
        DailyAftermathShownToday = 0
        gt 'DailyAftermathDebugPanel'
    end

    gs 'ActUiPrepare', 'Сброс shown today', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        DailyAftermathShownToday = 0
        gt 'DailyAftermathDebugPanel'
    end

    gs 'ActUiPrepare', 'Запустить aftermath сейчас', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        DailyAftermathShownToday = 0
        DailyAftermathPending = 1
        gt 'DailyAftermathProcess'
    end

    gs 'ActUiPrepare', 'К событиям трактира', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        if LOC('TavernEventDispatcherDebugMenu') = 1:
            gt 'TavernEventDispatcherDebugMenu'
        else:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'В главный зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---
