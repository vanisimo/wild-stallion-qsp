! ================================================
! FILE: modules/events/family/amanda_first_sex_family_reaction_text.qsps
! MODULE: events/family
! Тексты: утро после первого секса с Амандой, подозрения, прозрения
! ================================================

#AmandaFirstSexMorningText
    $AmandaHomeText = 'Утром ты просыпаешься раньше Аманды. Она спит, прижавшись к тебе, с лёгкой улыбкой на лице.'

    if $AmandaFirstSexMorningWitness = 'sandra':
        $AmandaHomeText += '<br><br>Когда вы спускаетесь вниз, Сандра бросает на вас долгий, изучающий взгляд. Брови слегка приподняты.'
        $AmandaHomeText += '<br>«Что-то вы сегодня оба… слишком довольные,» — говорит она с лёгкой подозрительностью. — «Не иначе, всю ночь секретами делились?»'
    else
        $AmandaHomeText += '<br><br>Мелисса, проходя мимо, вдруг останавливается и принюхивается. Потом смотрит на вас двоих с ехидной улыбкой.'
        $AmandaHomeText += '<br>«Ого… от вас двоих так и веет… «братской любовью»», — шепчет она так, чтобы слышали только вы. — «Аманда, у тебя на шее след, между прочим.»'
    end

    $AmandaHomeText += '<br><br>Аманда краснеет до ушей и толкает тебя локтем под столом.'
---

#AmandaFirstSexSandraSuspicionTalkText
    $AmandaFirstSexFamilyTalkText = 'Сандра откладывает половник и смотрит на тебя внимательно — не зло, но без привычной мягкости.'
    $AmandaFirstSexFamilyTalkText += '<br><br>«Я не слепая, Стефан. Ты и Аманда… слишком близки в последнее время. Не хочу скандала за завтраком, но воздух в доме другой.»'
    $AmandaFirstSexFamilyTalkText += '<br>Она не называет слов, которых боится сама. Только добавляет тише: «Скажи честно — мне стоит волноваться?»'
---

#AmandaFirstSexSandraSuspicionChoiceText
    $AmandaFirstSexSandraTalkChoice = LCASE($ARGS[0])

    if $AmandaFirstSexSandraTalkChoice = 'deny':
        $AmandaFirstSexFamilyTalkText = 'Ты отмахиваешься — мол, выспались, трактир вымотал. Сандра молчит слишком долго.'
        $AmandaFirstSexFamilyTalkText += '<br><br>«Ладно,» — наконец говорит она. — «Пока поверю. Но смотри: дом ещё держится на том, что мы делаем вид, будто всё прилично.»'
    elseif $AmandaFirstSexSandraTalkChoice = 'calm':
        $AmandaFirstSexFamilyTalkText = 'Ты говоришь спокойно: дом важнее слухов, ты всё держишь под контролем. Сандра выдыхает.'
        $AmandaFirstSexFamilyTalkText += '<br><br>«Хорошо,» — кивает она. — «Я не хочу рушить то, что осталось. Но если я снова увижу… то, что не должна видеть мать — поговорим иначе.»'
    else
        $AmandaFirstSexFamilyTalkText = 'Ты переводишь разговор на трактир, заказы и усталость после смены. Сандра слушает и отпускает тему — но не полностью.'
        $AmandaFirstSexFamilyTalkText += '<br><br>«Делай своё,» — говорит она сухо. — «Только не забывай: дочери смотрят на тебя. И я тоже.»'
    end

    killvar '$AmandaFirstSexSandraTalkChoice'
---

#AmandaFirstSexMelissaTeaseText
    $AmandaFirstSexFamilyTalkText = 'Мелисса проходит мимо с подносом, останавливается и смотрит на тебя с ехидством.'
    $AmandaFirstSexFamilyTalkText += '<br><br>«Ну что, братик,» — шепчет она, — «след на шее Аманды ещё держится? Или ты уже новый придумал?»'
    $AmandaFirstSexFamilyTalkText += '<br>Она фыркает и уходит, не дожидаясь ответа — будто и не спрашивала всерьёз.'
---

#AmandaFirstSexMelissaUnderstoodTalkText
    $AmandaFirstSexFamilyTalkText = 'Мелисса долго молчит, глядя в пол, потом поднимает глаза.'
    $AmandaFirstSexFamilyTalkText += '<br><br>«Теперь понимаю… то утро. Ты и Аманда.» — выдыхает она без злости, скорее с усталой усмешкой. — «Я тогда подкалывала. А вы уже…»'
    $AmandaFirstSexFamilyTalkText += '<br>Она не договаривает и пожимает плечами: «Ладно. Мы теперь в одной лодке. Только маме не свети — она и так всё чует.»'
---

#AmandaFirstSexSandraUnderstoodTalkText
    $AmandaFirstSexFamilyTalkText = 'Сандра садится напротив — без кастрюль, без спешки. Лицо спокойное, но глаза тяжёлые.'
    $AmandaFirstSexFamilyTalkText += '<br><br>«Теперь я понимаю,» — говорит она тихо, — «почему вы с Амандой тогда выглядели… так. Не сон. Не секреты.»'
    $AmandaFirstSexFamilyTalkText += '<br>Пауза. «Я не буду кричать. Дом и так на волоске. Но не притворяйся передо мной, что ничего не было — не тогда и не сейчас.»'
---

#AmandaFirstSexAmandaWorryTalkText
    $AmandaFirstSexFamilyTalkText = 'Аманда ловит тебя в коридоре и тянет за рукав.'

    if $AmandaFirstSexMorningWitness = 'sandra':
        $AmandaFirstSexFamilyTalkText += '<br><br>«Мама сегодня смотрела… странно,» — шепчет она. — «Ничего не сказала вслух. Хуже, чем если бы накричала.»'
    else
        $AmandaFirstSexFamilyTalkText += '<br><br>«Мелисса опять хихикала за столом,» — шепчет Аманда. — «Про шею. Думаешь, она правда ничего не поняла?»'
    end

    $AmandaFirstSexFamilyTalkText += '<br>Она кусает губу: «Тише будем. Хотя бы пока дом ещё делает вид, что мы нормальные.»'
---