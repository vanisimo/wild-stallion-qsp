! ================================================
! FILE: modules/events/family/family_noble_celebration_text.qsps
! MODULE: events/family
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.10.2026
! Нарративные тексты семейного триумфа и визитов по городу в статусе дворянина
! ================================================

#FamilyNobleCelebrationPrintText
    $CelebrationTextId = $ARGS[0]

    if $CelebrationTextId = 'dinner_intro':
        *pl 'Вечер в жилых покоях второго этажа непривычно тихий и торжественный. Двери зала внизу заперты, свечи в медных канделябрах заливают дубовый стол мягким янтарным светом.'
        *pl ' '
        *pl 'Сандра накрыла богатый стол: шкворчит свежее жаркое с пряным розмарином, на глиняном блюде дышит паром каравай, а рядом алеет кувшин доброго монастырского вина.'
        *pl ' '
        *pl 'Все трое сидят на скамьях в ожидании. Мелисса нетерпеливо постукивает пальцами по столешнице, Аманда во все глаза смотрит на тебя, а Сандра nervously комкает край передника.'
        *pl ' '
        *pl 'Ты медленно достаёшь из-за пазухи тяжёлый пергаментный свиток, перевязанный шёлковой алой лентой, и с глухим стуком выкладываешь его в самый центр стола.'
        *pl ' '
        *pl 'В тишине комнаты раздаётся приглушённый вдох Аманды. Массивная сургучная печать с гербом графства и золотым тиснением ярко блестит в свете свечей.'

    elseif $CelebrationTextId = 'suit_fitting':
        *pl 'Ты встаёшь из-за стола, подходишь к высокому ростовому зеркалу в резной дубовой раме и открываешь кованый ларь с парадным нарядом.'
        *pl ' '
        if MayorConfidantPath = 1 or MayorBlackmailSuccess = 1:
            *pl 'Этот камзол из плотного тёмно-синего бархата с золотым галуном и серебряными пуговицами получен прямо из ратуши. Столичный крой идеален: широкие плечи подчёркнуты рельефным шитьём, а белоснежная льняная рубаха с кружевным воротником сидит безупречно.'
        else:
            *pl 'Парадный наряд благородного сословия пошит на славу: глубокий тёмный бархат, тончайшая вышивка серебряной нитью по вороту и манжетам, мягкая кожа узких сапог и тяжёлый пояс с чеканной пряжкой.'
        end
        *pl ' '
        *pl 'Ты застёгиваешь серебряные пуговицы, поправляешь кружево на запястьях и расправляешь плечи.'
        *pl ' '
        *pl 'Из зеркала на тебя смотрит уже не прежний беспутный трактирный увалень, каким тебя считали на улицах Трипербана. Перед тобой стоит рослый, статный молодой дворянин с уверенным и твёрдым взглядом хозяина.'

    elseif $CelebrationTextId = 'family_toast':
        *pl 'Ты поворачиваешься к столу. На несколько секунд в комнате воцаряется благоговейная тишина.'
        *pl ' '
        *pl 'У Сандры перехватывает дыхание. Её глаза наполняются горячими слезами, но на губах играет счастливейшая из улыбок:'
        *pl ' '
        *pl '— Ильматер всеблагой... Стефан. Твой отец Лермонт гордился бы тобой так, как ни один отец на этой земле. Сколько я натерпелась страха за эти годы, сколько злых языков шипело нам в спину... Теперь всё кончено. Ни одна живая душа во всём городе больше не посмеет назвать тебя безродным бастардом. Ты — полноправный мессир Стефан Лонгкок, глава нашего дома!'
        *pl ' '
        *pl 'Мелисса медленно встаёт, скрестив руки на груди, и внимательно осматривает тебя с головы до ног. В её умных глазах искрится неприкрытое уважение:'
        *pl ' '
        *pl '— По городскому кодексу дворянский патент освобождает трактир от половины пошлин и даёт право голоса на совете гильдий. Но важнее другое: ты добился этого не пустой милостью, а собственным умом и железной хваткой. Ты заслужил это право, брат.'
        *pl ' '
        *pl 'Аманда с восторженным вскриком срывается с места, подбегает к тебе и нежно проводит ладонью по бархату на твоём плече:'
        *pl ' '
        *pl '— Стефан! Ты выглядишь как настоящий принц из баллад менестрелей! На следующих пятничных танцах все купчихи и важные дамы просто лопнут от зависти, глядя на нас!'
        *pl ' '
        *pl 'Сандра разливает по глиняным кубкам рубиновое вино. Вы поднимаете чаши ввысь:'
        *pl ' '
        *pl '— За семью Лонгкоков! За мессира Стефана и наш «Дикий Жеребец»!'
        *pl ' '
        *pl 'Кубки со звоном сходятся над столом. Сандра вытирает уголок глаза фартуком и с гордой улыбкой подталкивает тебя к двери:'
        *pl ' '
        *pl '— Не сиди взаперти в такой день, Стефан! Пройдись по городу в своём новом наряде. Пусть все завистники своими глазами увидят, кто теперь хозяин положения!'

    elseif $CelebrationTextId = 'tour_irma':
        *pl 'Ты распахиваешь колокольчатую дверь ателье. Ирма, склонившаяся над отрезом шёлка, медленно поднимает голову — и замирает.'
        *pl ' '
        *pl 'Полуэльфийка откладывает ножницы, плавной грациозной походкой обходит тебя кругом, оценивающе скользя взглядом по бархату, плечам и посадке ворота.'
        *pl ' '
        if MayorConfidantPath = 1 or MayorBlackmailSuccess = 1:
            *pl '— Ого... Значит, сам мэр Борджиа раскошелился на столичный гардероб для тебя? — её губы трогает тонкая, лукавая улыбка. — Недурно скроено, хотя в пройме рукава столичные портные явно ленились. Но на твоей фигуре, Стефан, даже чиновничий бархат смотрится царственно. Мои поздравления, ваше благородие!'
        else:
            *pl '— Настоящий лорд Лонгкок, — мягко произносит она, и в её раскосых глазах вспыхивает одобрительный огонёк. — Ткань легла безупречно. Ни один напыщенный франт из Верхнего квартала не сравнится с тобой в стати. Мои самые искренние поздравления, Стефан.'
        end
        *pl ' '
        *pl 'Она шутливо склоняет голову в изящном светском полупоклоне, подчеркивая твой новый высокий статус.'

    elseif $CelebrationTextId = 'tour_gerhard':
        *pl 'Под высокими сводами храма Ильматера гулко звучат твои шаги. Отец Герхард оборачивается от алтаря и внимательно смотрит на твоё парадное облачение.'
        *pl ' '
        *pl 'На лице священника нет подобострастия, но в морщинах у глаз теплится глубокое уважение.'
        *pl ' '
        *pl 'Ты почтительно склоняешь голову и осеняешь себя знаком Святого Круга.'
        *pl ' '
        *pl '— Благородное звание, сын мой Стефан — это не повод для тщеславия, а великая ответственность перед Ильматером, — негромко, но весомо произносит отец Герхард. — Истинное благородство измеряется не блеском серебряных пуговиц, а готовностью защищать обездоленных и творить правду. Ты доказал стойкость духа в годину испытаний. Да пребудет святой круг Ильматера над твоим домом.'

    elseif $CelebrationTextId = 'tour_legare':
        *pl 'В лавке виноторговца пахнет дубом и выдержанным вином. Альбер Легаре и Кларисса как раз сверяют записи у бочек, когда ты переступаешь порог.'
        *pl ' '
        *pl 'Альбер роняет перо на пергамент. Старый купец несколько секунд молча разглядывает твой парадный дублет, затем его лицо озаряется широкой, добродушной улыбкой.'
        *pl ' '
        *pl '— Мессир Стефан! Разрази меня гром, если этот бархат не сидит на тебе лучше, чем на половине столичных чинуш! — он хлопает ладонью по дубовой стойке и наполняет два хрустальных кубка. — Быть бастардом и подняться до дворянской грамоты своим трудом и головой — такое я уважаю больше любой спесивой родовитости! За твой герб, сосед!'
        *pl ' '
        *pl 'Кларисса лукаво улыбается из-за стойки, её щёки вспыхивают лёгким румянцем:'
        *pl ' '
        *pl '— Поздравляю, мессир Стефан... Теперь наш будущий виноградник под покровительством настоящего дворянина.'

    elseif $CelebrationTextId = 'tour_draupnir':
        *pl 'В мастерской Драупнира стоит грохот молота и сноп искр. Заметив тебя в дверях, коренастый гном опускает клещи в кадку с шипящей водой и вытирает закопчённые ладони кожаным фартуком.'
        *pl ' '
        *pl 'Его густая борода вздрагивает, и мастерскую оглашает оглушительный, раскатистый хохот:'
        *pl ' '
        *pl '— Ха-ха-ха! Глядите-ка, трактирщик при параде и в шелках! Ну, парень, порода видна издалека — Лермонтова кровь в землю не ушла! Но запомни мои слова: лорд ты теперь или мессир, а если доведётся снова браться за топоры на тракте — хватку не теряй! Поздравляю от всего гномьего сердца! Вечером загляну — выкачу за твой герб кружку доброго крепкого эля!'

    elseif $CelebrationTextId = 'tour_becky':
        *pl 'На рынке возле лавки Блэнкеншип шумно. Бекки как раз пересчитывает мешки с крупой, а Инга подметает порог.'
        *pl ' '
        *pl 'Увидев тебя в расшитом дублете, Бекки застывает с раскрытым ртом, затем картинно всплёскивает руками и пытается присесть в неуклюжем, карикатурном реверансе:'
        *pl ' '
        *pl '— Ой, держите меня семеро! Сам благородный господин к нашим скромным мешкам снизошёл! Инга, бросай метлу, кланяйся в пол! Мессир Стефан, а мессир Стефан, дворяне за муку-то золотом платят или как все смертные?'
        *pl ' '
        *pl 'Инга смущённо дёргает наставницу за рукав, краснея до самых кончиков ушей, и смотрит на тебя с нескрываемым благоговением:'
        *pl ' '
        *pl '— Бекки, перестань дразниться... Стефан, ты выглядишь просто невероятно! Тебе... тебе безумно идёт этот наряд!'

    elseif $CelebrationTextId = 'tour_mayor':
        *pl 'В приёмной ратуши всегда царит бюрократический холод, но сегодня всё иначе. Старый клерк, завидев тебя, немедленно поднимается из-за конторки и сгибается в почтительном поклоне:'
        *pl ' '
        *pl '— Добро пожаловать, мессир Лонгкок. Бумаги внесены в дворянский реестр графства без единой помарки. Городской магистрат всегда открыт для вас.'
        *pl ' '
        *pl 'Мэр Борджиа выглядывает из дверей кабинета. Градоначальник оценивающе окидывает взглядом твой наряд, и на его холёном лице мелькает хитрая, дипломатичная усмешка:'
        *pl ' '
        *pl '— Выглядите великолепно, мессир Стефан. Мы оба помним, как непросто дался этот титул. Но теперь вы принадлежите к высшему сословию нашего города. Рассчитываю, что наше сотрудничество и впредь будет взаимовыгодным.'

    elseif $CelebrationTextId = 'tour_guards':
        *pl 'Ты проходишь по центральной улице мимо ворот. Двое рослых городских стражников в начищенных кирасах замечают твоё благородное облачение и уверенную поступь.'
        *pl ' '
        *pl 'Дозорные мгновенно вытягиваются во фрунт, и наконечники их тяжёлых алебард с чётким металлическим лязгом салютуют о каменные плиты мостовой:'
        *pl ' '
        *pl '— Здравия желаем, мессир Лонгкок! Город спокоен, служба идёт по уставу!'

    elseif $CelebrationTextId = 'tour_finish':
        *pl 'Ты возвращаешься в свою комнату на втором этаже трактира. За окном догорает закат, а снизу доносится привычный, родной гул обеденного зала.'
        *pl ' '
        *pl 'Ты медленно расстёгиваешь серебряные пуговицы, стягиваешь тяжёлый бархатный камзол и бережно отряхиваешь его от городской пыли. Парадный наряд аккуратно ложится на деревянные плечики в резной шкаф.'
        *pl ' '
        *pl 'Дворянский патент с золотым тиснением и гербовой печатью занимает почётное место в надёжном кованом сундуке — рядом с письмами отца и семейными реликвиями.'
        *pl ' '
        *pl 'Ты натягиваешь привычную прочную рубаху, затягиваешь знакомый кожаный жилет и проводишь ладонью по волосам.'
        *pl ' '
        *pl '«Хорош наряд для парада да для танцев, но не для стойки, — усмехаешься ты про себя. — Бархат пивной пены и сажи из печи не любит. Грамота у меня, закон на моей стороне, имя защищено — а трактир сам себя не обслужит. Пора за дело».'
        *pl ' '
        *pl 'С лёгким сердцем и твёрдой уверенностью в будущем хозяин «Дикого Жеребца» спускается по деревянным ступеням в зал.'

    end

    killvar '$CelebrationTextId'
---
