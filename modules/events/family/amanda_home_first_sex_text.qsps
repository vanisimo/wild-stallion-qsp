#AmandaHomeFirstSexNight1Text
    gs 'AmandaHomeFirstSexResolveContext'

    $AmandaHomeText = 'Вы гасите свечу почти дотла. В полумраке Аманда нервно смеётся и тянет вас на кровать.'
    $AmandaHomeText += '<br><br>Ночнушка сползает с плеч — вы целуете обнажённую грудь, сосок твердеет под губами; она вздрагивает и стонет тихо. Подол задирается — ладонь на бедре, выше, к мокрой теплоте между ног. Она раздвигает ноги, не останавливая вас.'

---

#AmandaHomeFirstSexNight2Text
    $AmandaHomeText = 'Ваши ладони по бёдрам — внутренняя сторона, к самому входу. Аманда раздвигает ноги шире, дышит вам в шею.'
    $AmandaHomeText += '<br><br>Пальцы скользят по мокрым губкам, входят чуть-чуть — она выгибается, стонет в подушку. «Тише... ещё...» — шепчет. Внутри горячо, узко, влажно — она готова раньше, чем успевает это осознать.'

---

#AmandaHomeFirstSexNight3Text
    gs 'AmandaHomeFirstSexResolveContext'

    if virginity['amanda'] = 1:
        if $AmandaFirstSexContext = 'legare_known':
            $AmandaHomeText = 'Вы укладываете её на спину, раздвигаете бёдра. Головка касается входа — Аманда смотрит вам в глаза: «Внутри... впервые. По-настоящему. Медленно.»'
            $AmandaHomeText += '<br><br>Толкаетесь осторожно — сопротивление, потом короткий вскрик, когда плева рвётся. Она вцепляется в простыню, слёзы на ресницах.'
            $AmandaHomeText += '<br><br>Вы замираете, обнимаете, целуете — «тише, я здесь». Входите снова — медленно, нежно, до конца. Внутри горячо, тесно, она дышит часто, но не отталкивает.'
        elseif $AmandaFirstSexContext = 'legare_hidden':
            $AmandaHomeText = 'Нависаете над ней — член у влажного входа. «Медленно... я ещё...» — шепчет Аманда.'
            $AmandaHomeText += '<br><br>Первый толчок — она вскрикивает в кулак: плева уступает, внутри боль и жар. Вы целуете её, гладите грудь, не двигаетесь, пока не перестанет дрожать.'
            $AmandaHomeText += '<br><br>Потом снова — медленно, миллиметр за миллиметром, до конца. Она стонет в подушку, ногти в вашей спине.'
        else
            $AmandaHomeText = 'Аманда запрокидывает голову — испуг и возбуждение. Вы направляете член к мокрому входу и входите медленно.'
            $AmandaHomeText += '<br><br>Плева рвётся — короткий вскрик, она бледнеет. Вы обнимаете, целуете, ждёте. Потом снова — нежно, глубже. Внутри тесно, горячо, она вцепилась в простыню.'
            $AmandaHomeText += '<br><br>«Стефан...» — выдыхает сквозь зубы. «Тише... ах...»'
        end
    else
        if $AmandaFirstSexContext = 'legare_known':
            $AmandaHomeText = 'Аманда ложится на спину, раздвигает ноги — между бёдер блестит влага. Вы касаетесь головкой входа и легко проскальзываете внутрь мокрой вульвы.'
            $AmandaHomeText += '<br><br>Она издаёт довольный стон, обхватывает вас ногами. «Иначе... чем было...» — шепчет. Внутри горячо, мягко, принимает вас целиком.'
        else
            $AmandaHomeText = 'Аманда ложится, смотрит в глаза. Член скользит в мокрую вульву без сопротивления — она охает и прикусывает губу от удовольствия.'
            $AmandaHomeText += '<br><br>«Ах...» — довольный выдох. Бёдра обхватывают вас. Внутри горячо, влажно — она сразу подмахивает чуть-чуть.'
        end
    end

