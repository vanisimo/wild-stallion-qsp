#AmandaHomeFirstSexResolveContext
    $AmandaFirstSexContext = 'pure'

    if AmandaLegareFirstSexDone = 1:
        if PlayerKnows_AmandaLegareFridayRace = 1:
            $AmandaFirstSexContext = 'legare_known'
        else
            $AmandaFirstSexContext = 'legare_hidden'
        end
    end
---

#AmandaHomeFirstSexAppendVirginity
    $VirginAppendScene = LCASE($ARGS[0])

    if $VirginAppendScene = '':
        $VirginAppendScene = 'talk'
    end

    if $VirginAppendScene = 'talk':
        if virginity['amanda'] = 1:
            $AmandaHomeText += '<br><br>«Стефан... в писечку я никому не давала. Если возьмешь меня — это по-настоящему. Мне страшно. И я всё равно хочу.»'
        else
            $AmandaHomeText += '<br><br>«Если снова войдёшь в меня — это уже не «просто семья»,» — шепчет она. «Ты хочешь?»'
        end
    elseif $VirginAppendScene = 'talk_close':
        if virginity['amanda'] = 1:
            $AmandaHomeText += '<br><br>Она касается вашей щеки — ненадолго, почти стыдливо: «Ты точно хочешь? Точно меня?»'
        else
            $AmandaHomeText += '<br><br>Кусает губу: «Ты точно хочешь? Со мной?»'
        end
    elseif $VirginAppendScene = 'finish_inside':
        if virginity['amanda'] = 1:
            $AmandaHomeText += '<br><br>Между ног тепло и липко. Она не торопится вставать — прижимается, дрожит чуть-чуть.'
        end
    end

    killvar '$VirginAppendScene'
---

#AmandaHomeFirstSexAppendLegare
    $LegareAppendScene = LCASE($ARGS[0])

    if $LegareAppendScene = '':
        $LegareAppendScene = 'talk'
    end

    if $AmandaFirstSexContext = 'legare_known':
        if $LegareAppendScene = 'talk':
            $AmandaHomeText += '<br><br>«Ты знаешь, что у меня уже было... кое-что. Но... не так. С тобой — по-другому.»'
        elseif $LegareAppendScene = 'enter':
            $AmandaHomeText += '<br><br>«Медленно... хочу иначе, чем в подворотне»,» — шепчет она, не отводя взгляда.'
        elseif $LegareAppendScene = 'orgasm':
            $AmandaHomeText += '<br><br>«Ах... Стефан... это... совсем не то же самое что языком...» — обрывает себя. «Почему я раньше не давала...это так хорошо»'
        elseif $LegareAppendScene = 'evening':
            $AmandaHomeText += '<br><br>«Вчера было иначе. С тобой.» Не объясняет, с чем сравнивает — и не нужно.'
        elseif $LegareAppendScene = 'finish':
            $AmandaHomeText += '<br><br>«Не думай, что теперь мои дырочки твои навсегда, братик,» — шепчет в шею. Но бёдра не разжимает.'
        end
    elseif $AmandaFirstSexContext = 'legare_hidden':
        if $LegareAppendScene = 'enter':
            $AmandaHomeText += '<br><br>Движения её тела чуть увереннее, чем слова «я ещё...» — вы не спрашиваете почему.'
        elseif $LegareAppendScene = 'orgasm':
            $AmandaHomeText += '<br><br>«Я... не знала, что бывает... так хорошо» — смеётся смущённо сквозь стон. «Не останавливайся.»'
        end
    end

    killvar '$LegareAppendScene'
