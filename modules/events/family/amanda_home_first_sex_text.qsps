#AmandaHomeFirstSexTalkText
    gs 'AmandaHomeFirstSexResolveContext'

    $AmandaHomeText = 'Аманда сидит на кровати в ночнушке — после всех ваших вечеров наедине она уже не делает вид, что это «просто сестра и брат».'
    $AmandaHomeText += '<br><br>«Мы уже делали многое,» — говорит она тихо. «Руками, ртом, языком. Я даже не знала, что может быть так хорошо.»'
    $AmandaHomeText += '<br><br>Пальцы теребят край ткани. Потом поднимает взгляд: «Но если ты разомкнешь меня — назад не склеишь. И я боюсь... боюсь, что захочу ещё.»'

    gs 'AmandaHomeFirstSexAppendVirginity', 'talk'
    gs 'AmandaHomeFirstSexAppendLegare', 'talk'
    gs 'AmandaHomeFirstSexAppendVirginity', 'talk_close'
---

#AmandaHomeFirstSexTalkChoiceText
    $AmandaFirstSexTalkChoice = LCASE($ARGS[0])

    if $AmandaFirstSexTalkChoice = 'gentle':
        $AmandaHomeText = 'Вы говорите спокойно: не торопитесь, остановитесь в любой момент, если станет страшно.'
        $AmandaHomeText += '<br><br>Аманда замирает — потом выдыхает так, будто держала дыхание всю неделю. Прижимается лбом к вашему плечу.'

        if virginity['amanda'] = 1:
            $AmandaHomeText += '<br><br>«Тогда... не сегодня, если заплачу. Или сегодня, если нет, дурак.» Пауза. «Спасибо, что не смеёшься.»'
        else
            $AmandaHomeText += '<br><br>«Ладно... тогда сегодня, если не передумаю,» — шепчет почти без вызова.'
        end
    else
        $AmandaHomeText = 'Вы фыркаете: она сама дошла до куни, а теперь строит из себя святую. Аманда вспыхивает — и вдруг смеётся тихо, нервно, по-настоящему.'
        $AmandaHomeText += '<br><br>«Ну и кто тут распустился...» — бросает она, но глаза блестят. «Ладно. Если станет страшно — не обижайся, если скажу стоп.»'

        if virginity['amanda'] = 1:
            $AmandaHomeText += '<br><br>Кивает сама себе: «Хотя кого я обманываю. Давно уже не остановилась бы.»'
        else
            $AmandaHomeText += '<br><br>«Только не смотри так, будто я уже твоя навсегда.»'
        end
    end

    killvar '$AmandaFirstSexTalkChoice'
