#AmandaHomeFirstSexResolveContext
    $AmandaFirstSexContext = 'pure'

    if AmandaLegareFirstSexDone = 1:
        if PlayerKnows_AmandaLegareFridayRace = 1:
            $AmandaFirstSexContext = 'legare_known'
        else
            $AmandaFirstSexContext = 'legare_hidden'
        end
    end
---

#AmandaHomeFirstSexMenuLabel
    $AmandaFirstSexMenuLabel = 'Первая близость'

    if AmandaHomeStage = 6:
        $AmandaFirstSexMenuLabel = 'Поговорить перед первым разом'
    elseif AmandaHomeStage = 7:
        $AmandaFirstSexMenuLabel = 'Первая ночь'
    elseif AmandaHomeStage = 8:
        $AmandaFirstSexMenuLabel = 'Вечер вместе'
    elseif AmandaHomeStage = 9:
        $AmandaFirstSexMenuLabel = 'Попробовать иначе'
    elseif AmandaHomeStage = 10:
        $AmandaFirstSexMenuLabel = 'Последний шаг перед свободой'
    end
---

#AmandaHomeFirstSexTalkText
    gs 'AmandaHomeFirstSexResolveContext'

    if $AmandaFirstSexContext = 'legare_known':
        if virginity['amanda'] = 1:
            $AmandaHomeText = 'Аманда сидит на кровати, кутает ноги под себя. Пальцы теребят край ночнушки — ненадолго, потом поднимает взгляд.'
            $AmandaHomeText += '<br><br>«Ты знаешь, что у меня было... кое-что,» — говорит она без уточнений. «Но внутри... туда ещё никто не входил. Никто. Это другое.»'
            $AmandaHomeText += '<br><br>Долгая пауза. «Если ты войдёшь в меня — это уже по-настоящему. Не грязно, не второпях. С тобой. Мне страшно. И я всё равно хочу.»'
        else
            $AmandaHomeText = 'Аманда сидит на кровати, смотрит на руки. Потом выдыхает: «Было кое-что до тебя. Но не то, о чём я думала, когда представляла кого-то своего.»'
            $AmandaHomeText += '<br><br>Поднимает взгляд: «Если войдёшь в меня снова — это уже честнее. По-другому. Ты всё ещё хочешь?»'
        end
    elseif $AmandaFirstSexContext = 'legare_hidden':
        if virginity['amanda'] = 1:
            $AmandaHomeText = 'Аманда обнимает колени, ночнушка сползла с плеча — она не замечает.'
            $AmandaHomeText += '<br><br>«Мы уже зашли далеко,» — шепчет она. «Руками, ртом, твоим языком. Я даже не знала, что тело может так.»'
            $AmandaHomeText += '<br><br>Голос тише: «Но если ты войдёшь в меня — это уже не вернуть. И я... боюсь не тебя. Боюсь, что захочу ещё.»'
        else
            $AmandaHomeText = 'Аманда смотрит в сторону, потом обратно. «Мы уже зашли далеко — и каждый шаг дальше от «просто семья».»'
            $AmandaHomeText += '<br><br>«Если ты снова войдёшь в меня...» — не договаривает. Кусает губу. «Ты хочешь?»'
        end
    else
        if virginity['amanda'] = 1:
            $AmandaHomeText = 'Аманда смотрит на вас — без бравады, без привычного вызова. Только свеча, её дыхание и тишина за дверью.'
            $AmandaHomeText += '<br><br>«Стефан... мы уже делали многое. Ты трогал меня. Я трогала тебя. Твой язык...» — краснеет, не договаривает. «Но внутри — я ещё никого не пускала. Это будет первый раз. Настоящий.»'
            $AmandaHomeText += '<br><br>Она прижимает ладонь к груди: «И я хочу. И боюсь. Одновременно.»'
        else
            $AmandaHomeText = 'Аманда смотрит с влажными глазами: «Стефан... мы уже делали многое. Но каждый раз — как будто снова решаюсь сорваться с цепи, которую сама на себя надела.»'
            $AmandaHomeText += '<br><br>Пауза. «Ты хочешь?»'
        end
    end

    if virginity['amanda'] = 1:
        $AmandaHomeText += '<br><br>Она касается вашей щеки — ненадолго, почти стыдливо: «Ты точно хочешь этого? Не потому что я рядом. А потому что — я?»'
    else
        $AmandaHomeText += '<br><br>Кусает губу: «Ты точно хочешь? Со мной?»'
    end
---

#AmandaHomeFirstSexTalkChoiceText
    $AmandaFirstSexTalkChoice = LCASE($ARGS[0])

    if $AmandaFirstSexTalkChoice = 'gentle':
        if virginity['amanda'] = 1:
            $AmandaHomeText = 'Вы говорите спокойно: не торопитесь, остановитесь, если захочет. Аманда замирает — потом выдыхает так, будто держала дыхание всю неделю.'
            $AmandaHomeText += '<br><br>Прижимается лбом к вашему плечу: «Тогда... не сегодня, если заплачу. Или сегодня, если нет, дурак.» Пауза. «Спасибо, что не смеёшься.»'
        else
            $AmandaHomeText = 'Вы говорите: не торопитесь. Аманда выдыхает и прижимается лбом к вашему плечу.'
            $AmandaHomeText += '<br><br>«Ладно... тогда сегодня, если не передумаю,» — шепчет почти без вызова.'
        end
    else
        if virginity['amanda'] = 1:
            $AmandaHomeText = 'Вы фыркаете: она сама дошла до куни, а теперь строит из себя святую. Аманда вспыхивает — и вдруг смеётся тихо, нервно, по-настоящему.'
            $AmandaHomeText += '<br><br>«Ну и кто тут распустился...» — бросает она, но глаза блестят. «Ладно. Если станет страшно — не обижайся, если скажу стоп.»'
            $AmandaHomeText += '<br><br>Кивает сама себе: «Хотя кого я обманываю. Давно уже не остановилась бы.»'
        else
            $AmandaHomeText = 'Вы фыркаете: давно уже не святая. Аманда вспыхивает, но не отстраняется.'
            $AmandaHomeText += '<br><br>«Ну и кто тут распустился...» — бросает она. «Ладно. Только не смотри так, будто я уже твоя.»'
        end
    end

    killvar '$AmandaFirstSexTalkChoice'
