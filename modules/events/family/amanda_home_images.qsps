#AmandaHomeShowStepImage
    $AmandaHomeImageStep = LCASE($ARGS[0])
    $AmandaHomeImageSize = $ARGS[1]

    if $AmandaHomeImageStep = '':
        killvar '$AmandaHomeImageStep'
        killvar '$AmandaHomeImageSize'
        exit
    end

    if $AmandaHomeImageSize = '':
        $AmandaHomeImageSize = 'full'
    end

    if debug = 1:
        *pl '[DEBUG] AmandaHomeShowStepImage: ' + $AmandaHomeImageStep
    end

    if $AmandaHomeImageStep = 'hug' or $AmandaHomeImageStep = 'kiss' or $AmandaHomeImageStep = 'petting' or $AmandaHomeImageStep = 'handjob' or $AmandaHomeImageStep = 'blowjob' or $AmandaHomeImageStep = 'cuni':
        gs 'ShowGirlRoomScene', 'amanda', $AmandaHomeImageStep, $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'presex':
        gs 'AmandaHomeShowFirstNightRoomImage', 'idle', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'talk' or $AmandaHomeImageStep = 'talk_done' or $AmandaHomeImageStep = 'after_night' or $AmandaHomeImageStep = 'evening_talk' or $AmandaHomeImageStep = 'unlock':
        gs 'ShowGirlRoomScene', 'amanda', $AmandaHomeImageStep, $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'foreplay_undress':
        gs 'AmandaHomeShowFirstSexImage', 'foreplay', 'undress', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'foreplay_touch':
        gs 'AmandaHomeShowFirstSexImage', 'foreplay', 'touch', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'missionary_enter':
        gs 'AmandaHomeShowFirstSexImage', 'vaginal', 'missionary_enter', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'missionary_slow':
        gs 'AmandaHomeShowFirstSexImage', 'vaginal', 'missionary_slow', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'missionary_orgasm':
        gs 'AmandaHomeShowFirstSexImage', 'vaginal', 'missionary_orgasm', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'missionary_repeat':
        gs 'AmandaHomeShowFirstSexImage', 'vaginal', 'missionary_repeat', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'finish_prompt':
        gs 'AmandaHomeShowFirstSexImage', 'finish', 'prompt', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'finish_inside':
        gs 'AmandaHomeShowFirstSexImage', 'finish', 'inside', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'finish_outside':
        gs 'AmandaHomeShowFirstSexImage', 'finish', 'outside', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'doggy_learn':
        gs 'AmandaHomeShowFirstSexImage', 'vaginal', 'doggy_learn', $AmandaHomeImageSize
    elseif $AmandaHomeImageStep = 'side_learn':
        gs 'AmandaHomeShowFirstSexImage', 'vaginal', 'side_learn', $AmandaHomeImageSize
    end

    killvar '$AmandaHomeImageStep'
    killvar '$AmandaHomeImageSize'
---

#AmandaHomeShowFirstSexImage
    $AmandaFirstSexCategory = LCASE($ARGS[0])
    $AmandaFirstSexPose = LCASE($ARGS[1])
    $AmandaFirstSexSize = $ARGS[2]

    if $AmandaFirstSexCategory = '' or $AmandaFirstSexPose = '':
        killvar '$AmandaFirstSexCategory'
        killvar '$AmandaFirstSexPose'
        killvar '$AmandaFirstSexSize'
        exit
    end

    if $AmandaFirstSexSize = '':
        $AmandaFirstSexSize = 'full'
    end

    gs 'ShowSex', 'amanda', $AmandaFirstSexCategory, $AmandaFirstSexPose, $AmandaFirstSexSize

    killvar '$AmandaFirstSexCategory'
    killvar '$AmandaFirstSexPose'
    killvar '$AmandaFirstSexSize'
---

#AmandaHomeShowFirstNightRoomImage
    $AmandaFirstNightRoomPose = LCASE($ARGS[0])
    $AmandaFirstNightRoomSize = $ARGS[1]

    if $AmandaFirstNightRoomPose = '':
        $AmandaFirstNightRoomPose = 'petting'
    end

    if $AmandaFirstNightRoomSize = '':
        $AmandaFirstNightRoomSize = 'full'
    end

    AmandaHomeFirstNightImageUniform = GirlUniformLevel['amanda']
    GirlUniformLevel['amanda'] = 1

    gs 'ShowGirlRoomScene', 'amanda', $AmandaFirstNightRoomPose, $AmandaFirstNightRoomSize

    GirlUniformLevel['amanda'] = AmandaHomeFirstNightImageUniform
    killvar 'AmandaHomeFirstNightImageUniform'
    killvar '$AmandaFirstNightRoomPose'
    killvar '$AmandaFirstNightRoomSize'
---