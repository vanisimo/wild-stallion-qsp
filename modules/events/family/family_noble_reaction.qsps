        exit
    end

    gs 'MelissaNobleReactionCanTalk'
    if MelissaNobleReactionCanTalk = 0:
        gt 'GirlTalk', 'melissa', $MelissaNobleReturnLoc
        exit
    end

    gs 'ShowGirlSidebar', 'melissa'
    gs 'ShowLocationScreenTitle', 'МЕЛИССА: ПЕЧАТЬ ГЕРЦОГИНИ'
    gs 'SceneShowVisual', 'images/events/family/noble_reaction_melissa', 'Мелисса с ироничной улыбкой и тайной гордостью изучает грамоту', 'large', 'webp'

    gs 'FamilyNobleReactionPrintText', 'melissa_noble_text'
    *pl ' '

    MelissaNobleReactionDone = 1
    love['melissa'] += 5
    Friends['melissa'] += 5
    otkroven['melissa'] += 5
    MelissaTrustStefan += 3
    MelissaRespectStefan += 5

    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ActUiPrepare', 'Улыбнуться сестре и поговорить ещё', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'GirlTalk', 'melissa', $MelissaNobleReturnLoc
    end

    gs 'ActUiPrepare', 'Вернуться к залу', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $MelissaNobleReturnLoc
