! ================================================
! FILE: modules/events/family/family_noble_reaction.qsps
! MODULE: events/family
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.10.2026
! Реакция семьи (Сандра, Мелисса, Аманда) на получение Стефаном дворянства
! ================================================

#SandraNobleReactionCanTalk
    SandraNobleReactionCanTalk = 0
    if PlayerIsNoble = 1 and SandraNobleReactionDone = 0:
        SandraNobleReactionCanTalk = 1
    end
---

#SandraTalkAboutNobility
    *clr
    clr
    cla

    $SandraNobleReturnLoc = $ARGS[0]
    if $SandraNobleReturnLoc = '':
        $SandraNobleReturnLoc = 'TavernMain'
    end
    if LOC($SandraNobleReturnLoc) = 0:
        $SandraNobleReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', 'sandra'
    gs 'MenuGirlCalcConditions', 'sandra', $SandraNobleReturnLoc

    if MenuCanTalk = 0:
        gs 'GirlTalkClosedScreen', 'sandra', $SandraNobleReturnLoc
        exit
    end

    gs 'SandraNobleReactionCanTalk'
    if SandraNobleReactionCanTalk = 0:
        gt 'GirlTalk', 'sandra', $SandraNobleReturnLoc
        exit
    end

    gs 'ShowGirlSidebar', 'sandra'
    gs 'ShowLocationScreenTitle', 'САНДРА: ПРИЗНАНИЕ РОДА ЛЕРМОНТОВ'
    gs 'SceneShowVisual', 'images/events/family/noble_reaction_sandra', 'Сандра со слезами радости прижимает к груди дворянский патент', 'large', 'webp'

    gs 'FamilyNobleReactionPrintText', 'sandra_noble_text'
    *pl ' '

    SandraNobleReactionDone = 1
    love['sandra'] += 5
    Friends['sandra'] += 5
    otkroven['sandra'] += 5
    FamilyTrust += 3
    if FamilyTension >= 2:
        FamilyTension -= 2
    else:
        FamilyTension = 0
    end
    if SandraFamilyConcern >= 2:
        SandraFamilyConcern -= 2
    else:
        SandraFamilyConcern = 0
    end

    gs 'ClampGirlSocialStats', 'sandra'

    gs 'ActUiPrepare', 'Обнять мать и поговорить ещё', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'GirlTalk', 'sandra', $SandraNobleReturnLoc
    end

    gs 'ActUiPrepare', 'Вернуться к делам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $SandraNobleReturnLoc
    end
---

#MelissaNobleReactionCanTalk
