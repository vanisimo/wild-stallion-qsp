#AmandaNobleReactionCanTalk
    AmandaNobleReactionCanTalk = 0
    if PlayerIsNoble = 1 and AmandaNobleReactionDone = 0:
        AmandaNobleReactionCanTalk = 1
    end
---

#AmandaTalkAboutNobility
    *clr
    clr
    cla

    $AmandaNobleReturnLoc = $ARGS[0]
    if $AmandaNobleReturnLoc = '':
        $AmandaNobleReturnLoc = 'TavernMain'
    end
    if LOC($AmandaNobleReturnLoc) = 0:
        $AmandaNobleReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', 'amanda'
    gs 'MenuGirlCalcConditions', 'amanda', $AmandaNobleReturnLoc

    if MenuCanTalk = 0:
        gs 'GirlTalkClosedScreen', 'amanda', $AmandaNobleReturnLoc
        exit
    end

    gs 'AmandaNobleReactionCanTalk'
    if AmandaNobleReactionCanTalk = 0:
        gt 'GirlTalk', 'amanda', $AmandaNobleReturnLoc
        exit
    end

    gs 'ShowGirlSidebar', 'amanda'
    gs 'ShowLocationScreenTitle', 'АМАНДА: ДВОРЯНСКИЙ ТРИУМФ'
    gs 'SceneShowVisual', 'images/events/family/noble_reaction_amanda', 'Аманда с восторгом виснет на шее Стефана', 'large', 'webp'

    gs 'FamilyNobleReactionPrintText', 'amanda_noble_text'
    *pl ' '

    AmandaNobleReactionDone = 1
    AmandaWantsNobleDress = 1
    love['amanda'] += 5
    Friends['amanda'] += 5
    otkroven['amanda'] += 5
    AmandaTrustStefan += 3
    AmandaPublicAttention += 5

    gs 'ClampGirlSocialStats', 'amanda'

    gs 'ActUiPrepare', 'Пообещать первый танец и поговорить ещё', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'GirlTalk', 'amanda', $AmandaNobleReturnLoc
    end

    gs 'ActUiPrepare', 'Вернуться к работе', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $AmandaNobleReturnLoc
    end
---

#IrmaOrderAmandaNobleDress
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ЗАКАЗ ШЁЛКОВОГО ПЛАТЬЯ ДЛЯ АМАНДЫ'
    gs 'SceneShowVisual', 'images/locations/shops/irma_shop/dress_order', 'Ирма показывает Стефану эскиз изумрудного шёлкового платья', 'large', 'webp'

    if money < 80:
        gs 'FamilyNobleReactionPrintText', 'irma_dress_no_money'
        *pl ' '

        gs 'ActUiPrepare', 'Вернуться к лавке', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IrmaShop'
        end
    else:
        money -= 80
        AmandaHasNobleDress = 1

        gs 'FamilyNobleReactionPrintText', 'irma_dress_order_success'
        *pl ' '

        gs 'ActUiPrepare', 'Забрать упакованный наряд', 'policy'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IrmaShop'
        end
    end
---

#AmandaNobleDressGiftCanTalk
    AmandaNobleDressGiftCanTalk = 0
    if AmandaHasNobleDress = 1 and AmandaNobleDressGiven = 0:
        AmandaNobleDressGiftCanTalk = 1
    end
---

#AmandaGiveNobleDress
    *clr
    clr
    cla

    $AmandaGiftReturnLoc = $ARGS[0]
    if $AmandaGiftReturnLoc = '':
        $AmandaGiftReturnLoc = 'TavernMain'
    end
    if LOC($AmandaGiftReturnLoc) = 0:
        $AmandaGiftReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', 'amanda'
    gs 'ShowGirlSidebar', 'amanda'
    gs 'ShowLocationScreenTitle', 'ПОДАРОК ДЛЯ АМАНДЫ'
    gs 'SceneShowVisual', 'images/events/family/amanda_dress_gift', 'Аманда с восторгом прижимает к себе шёлковое платье от Ирмы', 'large', 'webp'

    gs 'FamilyNobleReactionPrintText', 'amanda_dress_gift_text'
    *pl ' '

    AmandaNobleDressGiven = 1
    AmandaDanceDressReady = 1
    love['amanda'] += 10
    Friends['amanda'] += 5
    otkroven['amanda'] += 5
    AmandaPublicAttention += 5

    gs 'ClampGirlSocialStats', 'amanda'

    gs 'ActUiPrepare', 'Полюбоваться сияющей сестрой', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'GirlTalk', 'amanda', $AmandaGiftReturnLoc
    end

    gs 'ActUiPrepare', 'Вернуться в зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $AmandaGiftReturnLoc
    end
---
