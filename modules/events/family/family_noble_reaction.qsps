#MelissaTalkAboutNobility
    *clr
    clr
    cla

    $MelissaNobleReturnLoc = $ARGS[0]
    if $MelissaNobleReturnLoc = '':
        $MelissaNobleReturnLoc = 'TavernMain'
    end
    if LOC($MelissaNobleReturnLoc) = 0:
        $MelissaNobleReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', 'melissa'
    gs 'MenuGirlCalcConditions', 'melissa', $MelissaNobleReturnLoc

    if MenuCanTalk = 0:
