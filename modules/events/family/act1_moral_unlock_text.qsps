! ================================================
! FILE: modules/events/family/act1_moral_unlock_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! Агентам: НЕ переписывать prose без явного «можно править тексты».
! Перед любой переделкой файла — спросить пользователя; сохранять формулировки.
! MODULE: events/family
! Тексты утренних мыслей Стефана (Act1 moral unlock)
! ================================================

#Act1MoralUnlockMoneyThoughts
    gs 'MayorCityTaxGateIsReady'
    gs 'PrintThoughtP', 'Клерк взял деньги за попытку — и мэр даже не дал мне рот открыть, скотина. Налог вчера: ' + STR(LastDayCityTax) + ', нужно ' + STR(MayorCityTaxDailyGate) + ' два дня подряд. Серия: ' + STR(MayorCityTaxStreak) + '.'

    if MayorBribePaid = 1:
        gs 'PrintThoughtP', 'За приём ушло ' + STR(MayorAudienceBribe) + ' спинтарий. Назад не отдали — зато теперь я знаю цену попытки.'
    end

    if Act1SurveyDraupnir = 1:
        gs 'PrintThoughtP', 'Вывеска у Драупнира — ' + STR(TavernUpgradeSignCost) + '. Дальше фасад, кухня… каждый гвоздь отдельно.'
    else:
        gs 'PrintThoughtP', 'У столяра нужно узнать, цены на вывеску и ремонт — цифры посмотреть, но не думаю что дёшево.'
    end

    ! «Мать сама наймёт» — только на ужине (family_council). Здесь — совет клерка, без спойлера.
    if Act1SurveyStaff = 1:
        gs 'PrintThoughtP', 'Клерк долбил: рук не хватает, надо людей. Это значит — подъёмные, потом каждый день… надо набрать баб посисястее, буду как султан в гареме.'
    else:
        gs 'PrintThoughtP', 'Клерк сказал нанять персонал — снять нагрузку с девочек. О я сниму с них нагрузку, найму таких девок... таких чтобы жопы-во и сиски-во, что трактир вмиг станет золотым дном.'
    end

    if Act1SurveySuit = 1:
        gs 'PrintThoughtP', 'Приличный костюм у Ирмы — ' + STR(MayorRespectableSuitCost) + '. Без него в мэрии смотрят как на шарамыжника.'
    else:
        gs 'PrintThoughtP', 'У ирмы костюм стоит — недёшево, это я слышал ещё до визита.'
    end

    gs 'FormatSpintry', LastDayProfit
    $FormatSpintry_Act1LastProfit = $FormatSpintry
    killvar '$FormatSpintry'
    gs 'FormatSpintry', money
    $FormatSpintry_Act1Money = $FormatSpintry
    killvar '$FormatSpintry'

    gs 'PrintThoughtP', 'Вчера в кассу ' + $FormatSpintry_Act1LastProfit + '. В кошельке ' + $FormatSpintry_Act1Money + '. Так долго копить — а что мэр потребует после приёма, чёрт его знает.'

    killvar '$FormatSpintry_Act1LastProfit'
    killvar '$FormatSpintry_Act1Money'
---

#Act1MoralUnlockFamilyThoughts
    gs 'PrintThoughtP', 'То есть чтобы всякие оборванцы с титулом, не могли меня по ходу прирезать. Мне нужна печать, чтобы поставить печать, нужен мэр, чтобы попасть к мэру, нужна прибыль, и вся та лабуда, что пердел этот, мать его, клерк. И так понятно что у меня не образцовая таверна.'
    gs 'PrintThoughtP', 'Аманда, Мелисса, Мама… они семья. И трактир мой. Но как же хочется прибить этого придурка, вот зачем он к нам зашел. Я могу попрость их, ну чуть- чуть чуть быть более радостными при виде клиентов, особенно богатых клиентов, тогда и деньги пойдут побыстрее, или не нежно, но тогда медленно уныло, как кактус в темноте.'
    gs 'PrintThoughtP', 'Да и в зале, кого то за жопу ущипнули, эти орут, я как Бусико, кидаюсь на защиту их чести и достоинства, тфу на Мелиссу и ее романы, уже в башке как гвозди сидят. Так вот могу же и незаметить, или заметить, но не присечь. Хотя нужно с ними все обсудить, не прям конечно в лоб им это сказать, но так заувалировано намекнуть, решено все за ужином им расскажу, а там дальше будем думать.'
---
