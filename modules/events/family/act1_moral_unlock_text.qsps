! ================================================
! FILE: modules/events/family/act1_moral_unlock_text.qsps
! MODULE: events/family
! Тексты утренних мыслей Стефана (Act1 moral unlock)
! ================================================

#Act1MoralUnlockMoneyThoughts
    gs 'MayorCityTaxGateIsReady'

    gs 'PrintThoughtP', 'Клерк деньги взял — дверь мэра всё равно закрыта.'
    gs 'PrintThoughtP', 'Налог вчера: ' + STR(LastDayCityTax) + '. Надо ' + STR(MayorCityTaxDailyGate) + ' два дня подряд. Сейчас серия: ' + STR(MayorCityTaxStreak) + '.'

    if MayorBribePaid = 1:
        gs 'PrintThoughtP', 'За приём ушло ' + STR(MayorAudienceBribe) + '. Назад не отдали. Знаю цену попытки.'
    end

    if Act1SurveyDraupnir = 1:
        gs 'PrintThoughtP', 'Вывеска у Драупнира — ' + STR(TavernUpgradeSignCost) + '. Дальше фасад, кухня. Каждый гвоздь — отдельно.'
    else:
        gs 'PrintThoughtP', 'Столяр цены называл — не запомнил. Но недёшево.'
    end

    ! Найм «мамой» — только на ужине. Здесь совет клерка.
    if Act1SurveyStaff = 1:
        gs 'PrintThoughtP', 'Клерк долбил: рук мало. Подъёмные, потом каждый день… кто наймёт — ещё разберёмся.'
    else:
        gs 'PrintThoughtP', 'Клерк сказал: нанять людей, снять нагрузку с девочек. Кто и сколько — потом. Без рук не вытянем.'
    end

    if Act1SurveySuit = 1:
        gs 'PrintThoughtP', 'Костюм у Ирмы — ' + STR(MayorRespectableSuitCost) + '. Без него в мэрии — как с порта.'
    else:
        gs 'PrintThoughtP', 'Ирма бы сшила костюм под приём. Недёшево — это я и раньше слышал.'
    end

    gs 'FormatSpintry', LastDayProfit
    $FormatSpintry_Act1LastProfit = $FormatSpintry
    killvar '$FormatSpintry'
    gs 'FormatSpintry', money
    $FormatSpintry_Act1Money = $FormatSpintry
    killvar '$FormatSpintry'

    gs 'PrintThoughtP', 'Вчера в кассу ' + $FormatSpintry_Act1LastProfit + '. В кошельке ' + $FormatSpintry_Act1Money + '.'
    gs 'PrintThoughtP', 'Копить долго. А что мэр выжмет после приёма — чёрт его знает.'

    killvar '$FormatSpintry_Act1LastProfit'
    killvar '$FormatSpintry_Act1Money'
---

#Act1MoralUnlockFamilyThoughts
    gs 'PrintThoughtP', 'Клерк хочет прибыль и порядок. В зале чуют: где девушки мягче — там руки смелее.'

    gs 'PrintThoughtP', 'Аманда, Мелисса, мать — мои. Трактир мой. Отпустить — касса легче. Держать — дольше, без сюрпризов за спиной.'

    gs 'PrintThoughtP', 'Не только защищать. Можно и иначе — но не втихаря. Вечером за столом. Сказать, что узнал. Ночью — ужин. Не тянуть.'
---
