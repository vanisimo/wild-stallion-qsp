! ================================================
! FILE: modules/events/family/act1_moral_unlock_text.qsps
! MODULE: events/family
! Тексты утренних мыслей Стефана (Act1 moral unlock)
! ================================================

#Act1MoralUnlockMoneyThoughts
    gs 'MayorCityTaxGateIsReady'
    gs 'PrintThoughtP', 'Клерк взял деньги за попытку — и мэр всё равно не открыл дверь. Налог вчера: ' + STR(LastDayCityTax) + ', нужно ' + STR(MayorCityTaxDailyGate) + ' два дня подряд. Серия: ' + STR(MayorCityTaxStreak) + '.'

    if MayorBribePaid = 1:
        gs 'PrintThoughtP', 'За приём ушло ' + STR(MayorAudienceBribe) + ' спинтарий. Назад не отдали — зато теперь я знаю цену попытки.'
    end

    if Act1SurveyDraupnir = 1:
        gs 'PrintThoughtP', 'Вывеска у Драупнира — ' + STR(TavernUpgradeSignCost) + '. Дальше фасад, кухня… каждый гвоздь отдельно.'
    else:
        gs 'PrintThoughtP', 'Столяр назвал цены на вывеску и ремонт — цифры не запомнил, но недёшево.'
    end

    if Act1SurveyStaff = 1:
        gs 'PrintThoughtP', 'Мать нанимает сама: подъёмные ' + STR(TavernHiredKitchenMovingCost) + ' и ' + STR(TavernHiredCleaningMovingCost) + ', потом ' + STR(TavernHiredKitchenCost) + ' и ' + STR(TavernHiredCleaningCost) + ' каждый день.'
    else:
        gs 'PrintThoughtP', 'Персонал мать наймёт сама — подъёмные и зарплата лягут на трактир.'
    end

    if Act1SurveySuit = 1:
        gs 'PrintThoughtP', 'Приличный костюм у Ирмы — ' + STR(MayorRespectableSuitCost) + '. Без него в мэрии смотрят как на портового.'
    else:
        gs 'PrintThoughtP', 'Ирма шила бы костюм под приём — недёшево, это я слышал ещё до клерка.'
    end

    gs 'FormatSpintry', LastDayProfit
    $FormatSpintry_Act1LastProfit = $FormatSpintry
    killvar '$FormatSpintry'
    gs 'FormatSpintry', money
    $FormatSpintry_Act1Money = $FormatSpintry
    killvar '$FormatSpintry'

    gs 'PrintThoughtP', 'Вчера в кассу ' + $FormatSpintry_Act1LastProfit + '. В кошельке ' + $FormatSpintry_Act1Money + '. Так долго копить — а что мэр потребует после приёма, чёрт его знает.'

    killvar '$FormatSpintry_Act1LastProfit'
    killvar '$FormatSpintry_Act1Money'
---

#Act1MoralUnlockFamilyThoughts
    gs 'PrintThoughtP', 'Клерк хочет прибыль и порядок. В зале можно вести себя по-разному — народ чует, где девушки мягче отбиваются от рук.'

    gs 'PrintThoughtP', 'Аманда, Мелисса, мать… они мои. И трактир мой. Отпустить — касса дышит легче. Держать — дольше, зато без сюрпризов за спиной.'

    gs 'PrintThoughtP', 'Сегодня зал откроется. Решать буду я.'
---