#FamilySleepingGirlScene
    *clr
    clr
    cla

    $SleepGirl = LCASE($ARGS[0])

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: СОННАЯ КРАСАВИЦА'
    gs 'SceneShowVisual', 'images/events/family/sleeping_' + $SleepGirl, 'СПЯЩАЯ ' + $RealName[$SleepGirl], 'large', 'webp'

    *pl 'Ты тихо приоткрываешь дверь. В комнате царит полумрак. ' + $RealName[$SleepGirl] + ' крепко спит, раскинувшись на кровати.'
    *pl 'Одеяло сползло на пол, обнажая её тёплое, расслабленное тело. Мерное дыхание колышет грудь.'

    gs 'ActUiPrepare', 'Тихо уйти и не будить', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end

    gs 'ActUiPrepare', 'Взять в рот у спящей', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FamilySleepingGirlAction', $SleepGirl, 'mouth'
    end

    gs 'ActUiPrepare', 'Войти в киску спящей', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FamilySleepingGirlAction', $SleepGirl, 'vagina'
    end

    gs 'ActUiPrepare', 'Облизать, а затем взять', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FamilySleepingGirlAction', $SleepGirl, 'lick'
    end
---

#FamilySleepingGirlAction
    *clr
    clr
    cla

    $SleepActGirl = LCASE($ARGS[0])
    $SleepActType = LCASE($ARGS[1])

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: ЛАСКА СПЯЩЕЙ'
    gs 'SceneShowVisual', 'images/events/family/sleep_act_' + $SleepActType + '_' + $SleepActGirl, 'НОЧНАЯ ЛАСКА: ' + $RealName[$SleepActGirl], 'large', 'webp'

    if $SleepActType = 'mouth':
        *pl 'Ты осторожно проводишь набухшей головкой по её приоткрытым губам. Девушка сквозь сон рефлекторно смыкает губы, начиная сонно посасывать горячую плоть.'
        *pl 'Когда член проникает глубже к языку, она распахивает затуманенные глаза, сдавленно стонет в твой ствол и обхватывает ладонями твои бёдра.'

    elseif $SleepActType = 'vagina':
        *pl 'Ты раздвигаешь сонные бёдра, смазываешь влажное лоно соками и плавно входишь на всю длину. Девушка вздрагивает, сладко стонет в подушку от глубокого наполнения и обвивает твои бёдра ногами, просыпаясь на пике наслаждения.'

    else
        *pl 'Ты опускаешься между её раскинутых сонных бёдер и начинаешь горячо, медленно вылизывать нежные губы и набухший клитор. Девушка вздрагивает, выгибает таз навстречу твоему языку и просыпается от накатившей волны жара, прижимая твою голову к своему лону.'
        *pl 'Затем ты поднимаешься выше и берёшь её горячее, готовое тело.'
    end

    *pl ' '
    *pl 'Интим завершается ярким оргазмом. ' + $RealName[$SleepActGirl] + ' лежит на подушках, тяжело дыша и счастливо улыбаясь в темноту.'

    gs 'RegisterPlayerCum'
    LastSexDay[$SleepActGirl] = day
    HadSex[$SleepActGirl] += 1

    gs 'ActUiPrepare', 'Назад в коридор', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#FamilyMasturbationScene
    *clr
    clr
    cla

    $MastGirl = LCASE($ARGS[0])

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: ТАЙНОЕ ВОЗБУЖДЕНИЕ'
    gs 'SceneShowVisual', 'images/events/family/masturbation_' + $MastGirl, 'МАСТУРБАЦИЯ: ' + $RealName[$MastGirl], 'large', 'webp'

    *pl 'Ты осторожно заглядываешь в комнату. В полутьме ' + $RealName[$MastGirl] + ' лежит на кровати, сорочка задрана до груди.'
    *pl 'Пальцы быстро и жадно двигаются между бёдер. Губы закушены, но тихие стоны всё равно прорываются: несколько ночей без тебя — и тело берёт своё.'

    gs 'ActUiPrepare', 'Тихо наблюдать из дверей', 'look'
    act $ActUiLabel, $ActUiIconPath:
        *pl ' '
        *pl 'Ты стоишь в дверях и смотришь. Она выгибается, вздрагивает в сладкой судороге — и только тогда замечает тебя. Вместо испуга на губах томная улыбка:'
        *pl '— Долго же ты шёл... Мог бы и помочь.'
        gs 'ActUiPrepare', 'Уйти', 'return'
        act $ActUiLabel, $ActUiIconPath: gt 'TavernSecondFloor'
    end

    gs 'ActUiPrepare', 'Перехватить и взять её', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        *pl ' '
        *pl 'Ты подходишь, перехватываешь её мокрую ладонь и прижимаешь к подушке. Она охает — и сама раздвигает колени шире:'
        *pl '— Наконец-то... Только не тяни, я и так на краю.'
        *pl 'Ты входишь одним толчком. Она вскрикивает, обвивает тебя руками и ногами и не отпускает до самого конца.'
        gs 'RegisterPlayerCum'
        LastSexDay[$MastGirl] = day
        HadSex[$MastGirl] += 1
        gs 'ActUiPrepare', 'Закончить ночь', 'return'
        act $ActUiLabel, $ActUiIconPath: gt 'TavernSecondFloor'
    end
---
