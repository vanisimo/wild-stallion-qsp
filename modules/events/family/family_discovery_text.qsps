#FamilyDiscoverySandraNightCatchClash
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: СРЫВ ВСЕХ ПОКРОВОВ'
    gs 'SceneShowVisual', 'images/events/family/family_clash_bedroom', 'ОБЩИЙ СРЫВ ПОКРОВОВ', 'large', 'webp'

    *pl 'Сандра тычет пальцем в постель и срывается на крик:'
    *pl '— Вы превратили дом в притон! Я поведу вас к отцу Герхарду, вы у меня на коленях каяться будете!'
    *pl ' '
    *pl 'Аманда вскакивает с кровати, прижимая простыню к груди:'
    *pl '— К Герхарду?! А сама ты по пятницам куда бегаешь, мама? К гному Драупниру в заднюю комнату! Думаешь, весь город глухой? Он за тобой дверь на засов, а ты потом полдня улыбаешься, как кошка!'
    *pl ' '
    *pl 'Сандра отшатывается, словно от удара. Губы беззвучно шевелятся, щёки заливает краска.'
    *pl ' '

    if HadSex['sandra'] > 0 or SandraHomeSex = 1:
        *pl 'Ты поднимаешься с кровати и заслоняешь сестёр собой:'
        *pl '— Хватит, мама. Кого ты судишь? Сама забыла, как стонала подо мной и просила не останавливаться?'
        *pl ' '
        *pl 'Сёстры замирают с открытыми ртами. Мелисса хватается за спинку кровати:'
        *pl '— Мама?! И ты... тоже?!'
        *pl ' '
        *pl 'Аманда нервно, истерично смеётся:'
        *pl '— Ну конечно! Вся семья в одной постели, одна я дура, что краснела!'
    end

    *pl ' '
    *pl 'В комнате наступает мёртвая тишина. Все тайны, что годами копились под крышей трактира, рухнули в одну секунду.'
    *pl 'Сандра роняет свечу на пол, закрывает лицо ладонями и в слезах бросается прочь. Дверь её спальни хлопает так, что дрожат стены.'

    SandraBoycottActive = 1
    SandraDiscoveryCrisisStage = 1
    SandraCrisisDay = day
    SandraNightWatchPending = 0
    FamilySisterSuspicionStage = 7

    gs 'ActUiPrepare', 'Остаться в спальне', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#FamilyDiscoverySandraConfession
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ХРАМ ИЛЬМАТЕРА: ИСПОВЕДЬ САНДРЫ'
    gs 'SceneShowVisual', 'images/events/church/sandra_confession_gerhard', 'ИСПОВЕДЬ У ОТЦА ГЕРХАРДА', 'large', 'webp'

    *pl 'В полумраке исповедальни Сандра опускается на колени перед решёткой. Слёзы текут по щекам, голос срывается на шёпот — она выкладывает священнику всё, что творится в доме.'
    *pl ' '
    *pl 'Отец Герхард долго молчит. Потом медленно очерчивает знак святого Круга:'
    *pl '— Успокойся, дочь моя. Ильматер страдал за людей не для того, чтобы они мёрзли поодиночке. Приграничье — суровый край, и тепло плоти держит семьи крепче любых клятв. Грех — когда дочерей тянут по портовым канавам чужие руки. А когда дом держится у одного очага...'
    *pl 'Он делает паузу, и голос за решёткой становится мягче, почти бархатным:'
    *pl '— Ступай с миром, Сандра. И не терзай себя. Ты ещё молодая женщина, и тело твоё — тоже дар Ильматера.'
    *pl ' '
    *pl 'С сердца Сандры падает камень, который она носила не один год. Только последние слова священника почему-то заставляют её покраснеть.'

    SandraDiscoveryCrisisStage = 2

    gs 'ActUiPrepare', 'Выйти из храма', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Church'
    end
---

#FamilyDiscoverySandraBeckyTalk
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ЛАВКА БЕККИ: РАЗГОВОР ПОДРУГ'
    gs 'SceneShowVisual', 'images/events/becky/becky_sandra_tea', 'САНДРА И БЕККИ ЗА ЧАЕМ', 'large', 'webp'

    *pl 'В задней комнатке лавки Бекки наливает подруге горячий взвар. Сандра, путаясь и краснея, выкладывает всё. Бекки слушает, подперев щёку, а потом добродушно машет рукой:'
    *pl ' '

    if BeckyIngaThreesomeDone = 1:
        *pl '— Тю, Сандра, нашла из-за чего убиваться! Да ты на нас с Ингой погляди! Стефан и мне бока грел, и дочку мою уважил — да ещё обеих разом, на одной кровати! И ничего: лавка стоит, чай пьём, в постели не тесно. Инга с утра поёт, а я хоть помолодела.'
        *pl ' '
        *pl 'Сандра давится взваром:'
        *pl '— Бекки! Обеих?!'
        *pl ' '
        *pl '— А то! — Бекки довольно подмигивает. — Парень в тебя пошёл — жадный до работы. Так что не реви. Свой, родная кровь, дом в кулаке держит. Радуйся, что девки под присмотром, а не по чужим сеновалам шастают.'
    else
        *pl '— Тю, Сандра! У нас в деревне зимы были такие, что вся семья под одним тулупом спала. Кто там с кем грелся — никто не спрашивал, и в колокол никто не звонил. Дети росли крепкие, дома стояли целые.'
        *pl ' '
        *pl 'Она наклоняется ближе и понижает голос:'
        *pl '— Ты свою молодость вспомни, святоша. Сама-то по пятницам к гному бегаешь — и правильно, баба без мужика сохнет. А тут свой парень, родная кровь, дом в кулаке держит. Радоваться надо, что девки под присмотром, а не чужие подонки их по сеновалам тискают.'
    end

    *pl ' '
    *pl 'Сандра опускает глаза и долго молчит. Потом тихо, почти неслышно смеётся:'
    *pl '— Ты неисправима, Бекки.'
    *pl '— Зато не одинока, — подмигивает та.'

    SandraDiscoveryCrisisStage = 3

    gs 'ActUiPrepare', 'Вернуться домой', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#FamilyDiscoverySandraNightSurrender
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'КОМНАТА СТЕФАНА: ПРИМИРЕНИЕ С САНДРОЙ'
    gs 'SceneShowVisual', 'images/events/sandra/sandra_night_surrender', 'САНДРА В ПОСТЕЛИ СТЕФАНА', 'large', 'webp'

    *pl 'Ночью дверь твоей комнаты тихо скрипит. На пороге Сандра — без сорочки, без платка, зрелое тело в лунном свете.'
    *pl 'Она закрывает дверь на засов, подходит к кровати и опускается на колени рядом с тобой.'
    *pl ' '

    if HadSex['sandra'] > 0 or SandraHomeSex = 1:
        *pl 'Она берёт твою ладонь и кладёт себе на грудь. Сердце под ней колотится:'
        *pl '— Прости дуру, Стефан. Я так боялась людского суда, что забыла, кто держит этот дом. Больше прятаться не стану. Ни от дочерей, ни от тебя.'
        *pl 'Она обнимает тебя за шею и тянет к себе в долгий, жадный поцелуй.'
    else
        *pl 'Она смотрит на тебя снизу вверх, голос дрожит:'
        *pl '— Пусть лучше ты, чем чужаки по подворотням. Ты хозяин этого дома, Стефан. А я устала притворяться праведницей.'
        *pl 'Её ладони ложатся на твои бёдра. Сандра склоняется и осторожно, жадно ласкает губами твоё мужское естество, осыпая ствол горячими поцелуями.'

        SandraHomeSex = 1
        HadSex['sandra'] += 1
        virginity['sandra'] = 0
    end

    *pl ' '
    *pl 'В эту ночь последний барьер стыда в доме Лонгкок рушится навсегда.'

    SandraBoycottActive = 0
    SandraDiscoveryCrisisStage = 4
    FamilySisterSuspicionStage = 8
    FamilyCorruptionStage = 4
    FamilyTension = 0
    FamilyTrust = 100

    gs 'ActUiPrepare', 'Принять Сандру', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'PlayerRoom'
    end
