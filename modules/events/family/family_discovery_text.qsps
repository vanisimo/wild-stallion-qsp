! ================================================
! FILE: modules/events/family/family_discovery_text.qsps
! MODULE: events/family
! [AI-WORKED] Текст переработан / дополнен ассистентом 30.10.2026
! Тексты системы обнаружения связей: сплетни, подруги (Лизетта, Кларисса), ссора сестёр и бойкот
! ================================================

#FamilyDiscoveryFriendTalkAmanda
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР В ПОРТУ: ЛИЗЕТТА И АМАНДА'
    gs 'SceneShowVisual', 'images/events/family/lizette_amanda_talk', 'РАЗГОВОР: ЛИЗЕТТА И АМАНДА', 'large', 'webp'

    *pl 'У причала скрипят сходни. Лизетта сидит на перевёрнутом ящике, болтает ногой и щурится на Аманду с широкой ухмылкой.'
    *pl ' '
    *pl '— Амандочка, дурёха ты моя глазастая, — тянет Лизетта певучим говорком. — Ходишь всю неделю, будто тебя мёдом намазали. Думаешь, братец только к тебе под одеяло ныряет?'
    *pl ' '
    *pl 'Аманда вспыхивает до корней волос и оглядывается на грузчиков:'
    *pl '— Лизетта! Прикуси язык, пока люди не слышат!'
    *pl ' '
    if HadSex['melissa'] > 0 or MelissaHomeSex = 1:
        *pl '— А пусть слышат, — хохочет мулатка и шлёпает себя по бедру. — Моя мамка таких кобелей насквозь видела: коли у хозяина в хлеву две тёлочки, он обеих и доит. Мелисса твоя умная с утра ноги еле переставляет, а сядет за конторку — ёрзает, будто под юбкой муравейник. Губы искусанные, глаза масляные. Ты сама так ходила после первой ночи, а?'
        *pl ' '
        *pl 'Аманда открывает рот — и не находит ответа. Пальцы стискивают край передника до белизны.'
        *pl ' '
        *pl '— То-то, — Лизетта наклоняется к самому её уху. — Ты не реви, ты гляди в оба. Мужика делить можно, дурёха. А вот за дурочку себя держать — не давай.'
    else:
        *pl '— А пусть слышат, — хохочет мулатка и шлёпает себя по бедру. — Ты ходишь с утра, будто тебя мёдом намазали. Глаза масляные, губы искусанные. Думаешь, сестрица твоя умная в свитки уткнулась и ничего не видит? Мелисса на тебя волком смотрит, за каждым шагом брата следит. Чует, шельма, куда он по ночам шастает. Скоро весь дом на уши поднимет!'
        *pl ' '
        *pl 'Аманда открывает рот — и не находит ответа. Пальцы стискивают край передника до белизны.'
        *pl ' '
        *pl '— То-то, — Лизетта наклоняется к самому её уху. — Ты не реви, ты гляди в оба. Тайны в семье долго не живут. Особенно когда старшая сестрица считает себя умнее всех.'
    end

    FamilySisterSuspicionStage = 2
    FamilySisterArgumentPending = 1

    gs 'ActUiPrepare', 'Вернуться к делам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#FamilyDiscoveryFriendTalkMelissa
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР В ЛАВКЕ: КЛАРИССА И МЕЛИССА'
    gs 'SceneShowVisual', 'images/events/family/clarissa_melissa_talk', 'РАЗГОВОР: КЛАРИССА И МЕЛИССА', 'large', 'webp'

    *pl 'Кларисса отставляет чашку с взваром и смотрит на подругу в упор, не моргая.'
    *pl ' '
    *pl '— Мелисса, ты цитируешь трактаты и считаешь себя умнее половины города, — ровно говорит она. — А у себя под носом не видишь, кто к твоему брату по ночам бегает.'
    *pl ' '
    *pl 'Мелисса фыркает и захлопывает книгу:'
    *pl '— Если ты про Стефана, то его ночные маршруты предсказуемы, как у кота в марте. Кухня, погреб, кровать.'
    *pl ' '
    *pl '— Чья кровать? — Кларисса чуть приподнимает бровь. — Аманда третий день порхает по залу и улыбается пивным кружкам. Ей вслед свистят, а она даже не огрызается. Так светятся девки, которых всю ночь не выпускали из постели. Ты правда думаешь, что он бережёт себя для твоих умных разговоров?'
    *pl ' '
    *pl 'Ирония сползает с лица Мелиссы. Она открывает рот для колкости — и закрывает. Пальцы стискивают кожаный переплёт.'
    *pl '— Он... не посмел бы, — тихо произносит она. И сама слышит, как жалко это звучит.'

    FamilySisterSuspicionStage = 2
    FamilySisterArgumentPending = 1

    gs 'ActUiPrepare', 'Вернуться к делам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#FamilySisterArgumentScene
    *clr
    clr
    cla

    FamilySisterArgumentPending = 0

    ! Определяем тип ситуации: обе сестры, только Аманда, только Мелисса
    if (HadSex['amanda'] > 0 or AmandaHomeSex = 1) and (HadSex['melissa'] > 0 or MelissaHomeSex = 1):
        $FamilySisterBoycottType = 'both'
    elseif HadSex['amanda'] > 0 or AmandaHomeSex = 1:
        $FamilySisterBoycottType = 'amanda'
    else
        $FamilySisterBoycottType = 'melissa'
    end

    gs 'ShowLocationScreenTitle', 'ВТОРОЙ ЭТАЖ: СКАНДАЛ В КОРИДОРЕ'
    gs 'SceneShowVisual', 'images/events/family/sisters_quarrel_corridor', 'ССОРА СЕСТЁР В КОРИДОРЕ', 'large', 'webp'

    *pl 'Ты поднимаешься по лестнице на второй этаж. Ещё снизу слышны сорванные на крик женские голоса.'
    *pl 'У дверей спален стоят Аманда и Мелисса — щёки пылают, кулаки сжаты, в глазах слёзы пополам с яростью.'
    *pl ' '

    if $FamilySisterBoycottType = 'both':
        *pl '— Бесстыжая! — Аманда наступает на сестру и тычет пальцем ей в грудь. — Думаешь, я не вижу, как ты на него пялишься? Как юбку одёргиваешь, когда он мимо идёт?'
        *pl ' '
        *pl 'Мелисса кривит губы в усмешке, но голос у неё дрожит:'
        *pl '— Одёргиваю юбку? Какое тонкое наблюдение от девушки, которая на прошлой неделе нарочно уронила поднос, лишь бы нагнуться перед ним.'
        *pl ' '
        *pl '— Заткнись! — Аманда толкает её в плечо. — Он мой! Он ко мне каждую ночь ходит, понятно тебе, книжная моль?! Две недели уже!'
        *pl ' '
        *pl 'Мелисса замирает на долю секунды — и смеётся зло и коротко:'
        *pl '— Каждую ночь? Тогда объясни, дорогая, кто брал меня на моём же столе, прямо на гроссбухе, пока ты сопела в подушку? Я чернила с бёдер до сих пор не оттёрла.'
        *pl ' '
        *pl 'В коридоре повисает мёртвая тишина. Сёстры смотрят друг на друга широко раскрытыми глазами. Обе тайны вырвались наружу разом.'

    elseif $FamilySisterBoycottType = 'amanda':
        *pl '— Ты совсем потеряла стыд, Аманда? — шипит Мелисса. — Ты спишь с собственным братом! Портовые девки хотя бы берут за это деньги.'
        *pl ' '
        *pl 'Аманда упирает руки в бока и выставляет грудь вперёд:'
        *pl '— А тебе завидно, да?! Да, сплю! И мне хорошо, слышишь? Так хорошо, что я в подушку кричу! А ты ночами со свитками обнимаешься и делаешь вид, что тебе это интереснее!'
        *pl ' '
        *pl 'Мелисса вздрагивает, как от пощёчины. Скулы белеют. Удар попал точно туда, где больнее всего.'

    else
        *pl '— Лицемерка! — сквозь слёзы кричит Аманда. — «Мне нужны только книги», «чистота Ильматера»! А сама перед Стефаном ноги раздвинула!'
        *pl ' '
        *pl 'Мелисса держит спину прямо, только пальцы теребят манжету:'
        *pl '— Не раздвинула, а приняла взвешенное решение, — холодно поправляет она. — Стефану нужна женщина, с которой можно и поговорить после. А не девочка, которая хихикает и путает, где у кровати изголовье.'
        *pl ' '
        *pl '— Ненавижу тебя! И его ненавижу! — всхлипывает Аманда. — Предатели, оба!'
    end

    *pl ' '
    *pl 'Снизу, с кухни, гремит голос Сандры:'
    *pl '— Ильматер всеблагой, вы чего там орёте?! Опять платье не поделили? А ну по комнатам, пока я ухватом по задницам не прошлась!'

    gs 'ActUiPrepare', 'Вмешаться в перепалку', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FamilySisterArgumentStefanReaction'
    end
---

#FamilySisterArgumentStefanReaction
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ВТОРОЙ ЭТАЖ: ГЛУХОЙ БОЙКОТ'
    gs 'SceneShowVisual', 'images/events/family/sisters_boycott_doors', 'ЗАКРЫТЫЕ ДВЕРИ СПАЛЕН', 'large', 'webp'

    *pl 'Ты выходишь из тени лестничного пролёта:'
    *pl '— Хватит орать на весь дом. Внизу посетители уже ставки делают, кто кому волосы выдерет.'
    *pl ' '
    *pl 'Сёстры разом поворачиваются к тебе. В их глазах нет ни стыда, ни послушания — только обида.'
    *pl ' '

    if $FamilySisterBoycottType = 'both':
        *pl '— Ты!.. — Аманда задыхается от слёз. — Кобель проклятый! Нас обеих дурами держал, ещё и по очереди?! Не смей ко мне подходить! Никогда!'
        *pl ' '
        *pl 'Мелисса смотрит на тебя сухими, потемневшими глазами:'
        *pl '— Поздравляю, Стефан. Ты умудрился быть одновременно предсказуемым и подлым. Редкое сочетание. Для меня тебя больше нет.'

    elseif $FamilySisterBoycottType = 'amanda':
        *pl 'Мелисса смеривает тебя взглядом с головы до пояса и брезгливо кривит губы:'
        *pl '— Не прикасайся ко мне. Развлекайся со своей игрушкой. Город уже хихикает — скоро и в колокол зазвонят.'
        *pl ' '
        *pl 'Аманда растерянно смотрит то на тебя, то на захлопнувшуюся дверь Мелиссы — и тоже в слезах бросается к себе.'

    else
        *pl 'Аманда рыдает в голос, глядя на тебя с ненавистью:'
        *pl '— Уйди! Я к Легаре пойду! Он хоть красивой называет и не врёт, к кому по ночам ходит!'
        *pl ' '
        *pl 'Мелисса молча отворачивается и бросает через плечо:'
        *pl '— Оставь нас обеих в покое. Хотя бы на время, раз уж на это у тебя хватит выдержки.'
    end

    *pl ' '
    *pl 'Две двери хлопают почти одновременно. Ключи с сухим стуком проворачиваются в замках.'
    *pl 'В доме повисает тишина. Уговорами тут не взять. А в городе Альбер Легаре и менестрель Элрик уже кружат возле обиженных девушек, как коты у сметаны.'

    ! Активация бойкота
    FamilySisterBoycottActive = 1
    FamilySisterBoycottDay = day
    FamilySisterSuspicionStage = 4
    GirlOffenseDays['amanda'] = 3
    GirlOffenseDays['melissa'] = 3
    $GirlOffenseReason['amanda'] = 'sister_quarrel'
    $GirlOffenseReason['melissa'] = 'sister_quarrel'

    gs 'ActUiPrepare', 'Остаться в коридоре', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#FamilySisterBoycottTalkAmanda
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'КОМНАТА АМАНДЫ: БОЙКОТ'
    gs 'SceneShowVisual', 'images/npc/family/amanda/amanda_offended', 'ОБИЖЕННАЯ АМАНДА', 'large', 'webp'

    *pl 'Аманда сидит на кровати, подтянув колени к груди, и демонстративно смотрит в стену. Плечи мелко подрагивают.'
    *pl ' '
    *pl '— Пошёл вон, Стефан, — глухо бросает она, не поворачивая головы. — Иди к Мелиссе. Пусть она тебе трактаты читает, пока ты её... Тьфу! Мне от тебя тошно.'
    *pl ' '
    *pl 'Она натягивает одеяло до подбородка, будто от тебя можно им закрыться. Слова сейчас бессильны.'

    gs 'ActUiPrepare', 'Выйти из комнаты', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#FamilySisterBoycottTalkMelissa
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'КОМНАТА МЕЛИССЫ: БОЙКОТ'
    gs 'SceneShowVisual', 'images/npc/family/melissa/melissa_offended', 'ХОЛОДНАЯ МЕЛИССА', 'large', 'webp'

    *pl 'Мелисса сидит за столом над книгой. На твой приход она даже не поднимает глаз — только переворачивает страницу.'
    *pl ' '
    *pl '— Твоё присутствие здесь избыточно, — ровно произносит она. — Как и твои объяснения. Я их уже написала за тебя: «так вышло», «вы обе мне дороги», «я не думал». Угадала? Закрой дверь с той стороны.'
    *pl ' '
    *pl 'Ирония стала её бронёй. Простыми словами её не пробить.'

    gs 'ActUiPrepare', 'Выйти из комнаты', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#FamilyDiscoveryLizetteAdvice
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОРТ: СОВЕТ ЛИЗЕТТЫ'
    gs 'SceneShowVisual', 'images/npc/port/lizette/lizette_talk', 'ЛИЗЕТТА В ПОРТУ', 'large', 'webp'

    *pl 'Лизетта сидит на канатной бухте у складов и греется на солнце.'
    *pl 'Выслушав историю о ссоре сестёр, она звонко хохочет, запрокинув голову:'
    *pl ' '
    *pl '— Ой, Стефанчик! Допрыгался, жеребец? Прижали девки хвост? Говорила я — двух кобылок в одном стойле без узды не удержишь!'
    *pl ' '
    *pl 'Она спрыгивает вниз, подходит вплотную и ведёт пальцем по твоей груди — вниз, до самого пояса:'
    *pl '— Амандочка твоя в подушку ревёт да кусает её, а представляет, небось, тебя. Слова ей твои не нужны, дуралей. Возле неё Легаре крутится — шёлком машет, сладкое на ушко шепчет. Ещё денёк, и она ему назло под юбку залезть даст.'
    *pl ' '
    *pl '— Пойди да покажи купцу, кто в доме хозяин. А потом прижми её так, чтоб дух вон. Бабе после ссоры не речи нужны, а крепкие руки. А я ей шепну, чтоб не дурила.'

    FamilyLegareInterceptAvailable = 1

    gs 'ActUiPrepare', 'Поблагодарить Лизетту', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#FamilyDiscoveryClarissaAdvice
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ЛАВКА КЛАРИССЫ: СОВЕТ ПОДРУГИ'
    gs 'SceneShowVisual', 'images/npc/shops/clarissa/clarissa_talk', 'КЛАРИССА В ЛАВКЕ', 'large', 'webp'

    *pl 'Кларисса слушает тебя молча, скрестив руки на груди.'
    *pl ' '
    *pl '— Мелисса считает, что ты выставил её дурой, Стефан. Для неё это хуже, чем если бы ты её ударил.'
    *pl ' '
    *pl 'Она выдерживает паузу:'
    *pl '— Менестрель Элрик уже поёт ей вирши и хвалит её ум. Сладкая отрава для девушки, которая боится, что её любят только за тело. Выгони его. А потом приди к ней сам — не с оправданиями, а с делом. Спроси совета по трактиру. Она сделает вид, что ей всё равно, и будет считать минуты до твоего прихода.'
    *pl ' '
    *pl 'Уголок её губ чуть приподнимается:'
    *pl '— И ещё. Когда она начнёт язвить — не спорь. Закрой ей рот. Способ выбери сам.'

    FamilyMinstrelConfrontAvailable = 1

    gs 'ActUiPrepare', 'Поблагодарить Клариссу', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#FamilyDiscoveryInterceptLegare
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'УЛИЦА: СТЫЧКА С ЛЕГАРЕ'
    gs 'SceneShowVisual', 'images/events/amanda/legare_confront', 'СТЕФАН И ЛЕГАРЕ', 'large', 'webp'

    *pl 'Ты перехватываешь Альбера Легаре у поворота к лавке. Под мышкой у торговца свёрток с тканью — шагает он явно к трактиру.'
    *pl ' '
    *pl 'Ты встаёшь прямо на пути:'
    *pl '— Подарки убери, Легаре. К Аманде ты больше не подойдёшь. Ни с шёлком, ни без.'
    *pl ' '
    *pl 'Легаре медленно опускает руки. В глазах мелькает злость:'
    *pl '— Зарываешься, трактирщик. Девка не бочка пива, в погребе не запрёшь. Сама ко мне прибежит, когда ты ей наскучишь.'
    *pl ' '
    *pl '— Пусть сначала добежит, — усмехаешься ты. — А ты пока посчитай, сколько зубов у тебя останется, если я тебя ещё раз у своих дверей увижу.'
    *pl ' '
    if FridayStreetClashHappened = 1 and $FridayClashType = 'win':
        *pl 'Легаре невольно трогает челюсть, помня прошлую встречу на мостовой, сплёвывает под ноги и уходит к рынку. В окне трактира колышется занавеска — Аманда всё видела. И ты успеваешь заметить, как дрогнуло её лицо.'
    else:
        *pl 'Легаре сплёвывает под ноги, разворачивается и уходит к рынку. В окне трактира колышется занавеска — Аманда всё видела. И ты успеваешь заметить, как дрогнуло её лицо.'
    end

    FamilyLegareIntercepted = 1
    FamilyLegareInterceptAvailable = 0
    LegareConflictStage = MIN(7, LegareConflictStage + 1)
    Friends['legare'] = MAX(0, Friends['legare'] - 2)
    AmandaLegareConflictWithLegareReady = 1

    gs 'ActUiPrepare', 'Вернуться в трактир', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#FamilyDiscoveryConfrontMinstrel
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ЗАЛ ТРАКТИРА: МЕНЕСТРЕЛЬ УХОДИТ'
    gs 'SceneShowVisual', 'images/events/melissa/minstrel_confront', 'СТЕФАН И МЕНЕСТРЕЛЬ', 'large', 'webp'

    *pl 'Менестрель Элрик сидит за дальним столом, перебирает струны лютни и ловит взгляд хмурой Мелиссы у стойки.'
    *pl 'Ты подходишь, накрываешь струны ладонью и наклоняешься к его уху:'
    *pl ' '
    *pl '— Забирай свою бренчалку и проваливай. В моём заведении поют только по моему слову.'
    *pl ' '
    *pl 'Элрик бледнеет, торопливо прячет лютню в чехол, бросает на стол пару медяков и выскальзывает за дверь.'
    *pl ' '
    *pl 'Мелисса провожает его взглядом, потом смотрит на тебя. Бровь ползёт вверх:'
    *pl '— Грубо. Примитивно. Совершенно не изящно.'
    *pl 'Она отворачивается к счётам, но ты успеваешь заметить, как дрогнули уголки её губ:'
    *pl '— Продолжай в том же духе.'

    FamilyMinstrelConfronted = 1
    FamilyMinstrelConfrontAvailable = 0

    gs 'ActUiPrepare', 'Остаться в зале', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
