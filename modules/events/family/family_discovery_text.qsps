#FamilyDiscoverySistersReconcile
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ВТОРОЙ ЭТАЖ: ПРИМИРЕНИЕ'
    gs 'SceneShowVisual', 'images/events/family/sisters_reconcile', 'ПРИМИРЕНИЕ СЕСТЁР', 'large', 'webp'

    *pl 'Ты заходишь в комнату и задвигаешь засов. Аманда и Мелисса обе здесь — настороженные, не знающие, чего ждать.'
    *pl ' '
    *pl 'Ты садишься между ними и говоришь прямо:'
    *pl '— Хватит грызть друг друга. Город полон стервятников: Легаре я отвадил, менестрель сбежал, поджав хвост. Чужим я вас не отдам. Ни одну.'
    *pl ' '
    *pl 'Ты берёшь Аманду за одну руку, Мелиссу — за другую и крепко сжимаешь:'
    *pl '— Вы обе мои. И делить вам в этом доме нечего.'
    *pl ' '
    *pl 'Аманда сдаётся первой — утыкается носом в твоё плечо и бурчит сквозь всхлип:'
    *pl '— Но ко мне ты будешь ходить чаще. Это не обсуждается.'
    *pl ' '
    *pl '— Обсуждается, — тут же парирует Мелисса и сжимает твою руку в ответ. — График составлю я. У меня хотя бы почерк разборчивый.'
    *pl ' '
    *pl 'Аманда фыркает сквозь слёзы. Мелисса прячет улыбку. А ты думаешь, что этот график, пожалуй, подпишешь не глядя.'
    *pl 'Ледяная стена рушится.'

    FamilySisterBoycottActive = 0
    FamilySisterSuspicionStage = 5
    GirlOffenseDays['amanda'] = 0
    GirlOffenseDays['melissa'] = 0
    FamilyTension = 0
    FamilyTrust += 15

    gs 'ActUiPrepare', 'Остаться с сёстрами', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
