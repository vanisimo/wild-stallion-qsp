! ================================================
! FILE: modules/events/family/family_discovery_text.qsps
! MODULE: events/family
! [AI-WORKED] Текст переработан / дополнен ассистентом 01.11.2026
! Тексты механики раскрытия отношений: ревность сестёр, ссора, бойкот и примирение
! ================================================

#FamilyDiscoveryFriendTalkAmanda
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОРТ: РАЗГОВОР У ПРИЧАЛА'
    gs 'SceneShowVisual', 'images/events/family/lizette_amanda_talk', 'порт: Лизетта и Аманда', 'large', 'webp'

    *pl 'У причала поскрипывают сходни, пахнет просмолённым деревом и морем. Лизетта сидит на перевёрнутом ящике, беззаботно болтая ногами в туфельках.'
    *pl ' '
    *pl 'Стефан останавливается за штабелем тюков, невольно прислушиваясь к звонким девичьим голосам.'
    *pl ' '
    *pl '— Амандочка, дурёха ты моя глазастая, — тянет Лизетта своим певучим столичным говорком, подперев щёку ладонью. — Ходишь вся румяная, сияешь, будто в трактире эль не разносишь, а мёд с молоком пьёшь. Что, братец твой наконец перестал робеть и обратил на тебя мужское внимание?'
    *pl ' '
    *pl 'Аманда мгновенно вспыхивает до кончиков ушей, испуганно прижимая ладошки к пылающим щекам:'
    *pl '— Лизетта! Тише ты! Ничего такого... Он просто хозяин, а я помогаю!'
    *pl ' '
    if HadSex['melissa'] > 0 or MelissaHomeSex = 1:
        *pl 'Лизетта лукаво щурится, окидывая подругу понимающим взглядом:'
        *pl '— Ой ли? Только вот Мелисса твоя строгая в последнее время тоже ходит с расстёгнутым воротом и глаза прячет. Ты уверена, милая, что его ласки достаются только тебе? Мужчины на фронтире жадные — если распробуют сладость, одной ложкой сыты не бывают.'
        *pl ' '
        *pl 'Аманда замирает, её дыхание перехватывает от внезапного укола ревности:'
        *pl '— Не может быть... Мелисса же вечно нос задирает и строит из себя недотрогу!'
        *pl ' '
        *pl '— Именно такие тихони в тишине спален горячее всего стонут, глупенькая, — смеётся Лизетта. — Присмотрись к ней получше.'
    else:
        *pl 'Лизетта снисходительно улыбается, поправляя шёлковый платок на плечах:'
        *pl '— Помогаешь, говоришь? Ну-ну. Только смотри, милая: пока ты краснеешь, твоя расчётливая сестрица Мелисса время зря не теряет. Мужчины тянутся к тем, кто рядом.'
        *pl ' '
        *pl 'Аманда насупливается, сжимая кулачки:'
        *pl '— Мелиссе только её гроссбухи интересны! Стефан для неё просто помощник по счетам!'
        *pl ' '
        *pl '— В тихом омуте черти водятся, Амандочка, — напевает Лизетта. — Держи ухо востро.'
    end

    FamilySisterSuspicionStage = 2
    FamilySisterArgumentPending = 1

    gs 'ActUiPrepare', 'Отойти от причала', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#FamilyDiscoveryFriendTalkMelissa
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'РЫНОК: РАЗГОВОР У ЛАВКИ'
    gs 'SceneShowVisual', 'images/events/family/clarissa_melissa_talk', 'рынок: Кларисса и Мелисса', 'large', 'webp'

    *pl 'Среди торговых рядов у винной лавки царит обычный полуденный шум. Кларисса неторопливо потягивает взвар из глиняной кружки, прислонившись к дубовой бочке.'
    *pl ' '
    *pl 'Стефан задерживается за углом навеса, заметив Мелиссу с корзиной покупок.'
    *pl ' '
    *pl '— Мелисса, ты можешь цитировать старинные трактаты сколько угодно, — ровно замечает Кларисса, внимательно глядя подруге в лицо. — Но меня не проведёшь. Ты уже дважды ошиблась в расчётах за поставку вина, а шея у тебя горит ярче южного заката.'
    *pl ' '
    *pl 'Мелисса нервно поправляет выбившуюся прядь, стараясь сохранить невозмутимый вид:'
    *pl '— Я просто устала, Кларисса. Много работы с налогами, Стефан ещё не во всех бумагах освоился...'
    *pl ' '
    *pl '— Стефан, говоришь? — Кларисса усмехается уголком губ. — Руки у твоего названого брата крепкие, это в городе любая заметит. Только пока ты корпишь над записями, младшенькая твоя, Аманда, порхает вокруг него как бабочка. Думаешь, молодой хозяин долго будет слушать твои сухие отчёты, если рядом есть податливое девичье тепло?'
    *pl ' '
    *pl 'Мелисса поджимает губы, пальцы на ручке корзины заметно белеют от напряжения:'
    *pl '— Аманда — наивная девчонка. Стефан не настолько слеп, чтобы путать минутный каприз с настоящей опорой.'
    *pl ' '
    *pl '— Мужчины думают не пользой, дорогая, — усмехается Кларисса. — Особенно когда захлопывается дверь спальни. Не будь дурой, приглядись.'

    FamilySisterSuspicionStage = 2
    FamilySisterArgumentPending = 1

    gs 'ActUiPrepare', 'Отойти от лавки', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#FamilySisterArgumentScene
    *clr
    clr
    cla

    FamilySisterArgumentPending = 0

    if (HadSex['amanda'] > 0 or AmandaHomeSex = 1) and (HadSex['melissa'] > 0 or MelissaHomeSex = 1):
        $FamilySisterBoycottType = 'both'
    elseif HadSex['amanda'] > 0 or AmandaHomeSex = 1:
        $FamilySisterBoycottType = 'amanda'
    else
        $FamilySisterBoycottType = 'melissa'
    end

    gs 'ShowLocationScreenTitle', 'ВТОРОЙ ЭТАЖ: ССОРА СЕСТЁР'
    gs 'SceneShowVisual', 'images/events/family/sisters_quarrel_corridor', 'коридор: ссора сестёр', 'large', 'webp'

    *pl 'Ты поднимаешься по скрипучей деревянной лестнице на второй этаж. Ещё снизу слышны резкие, сорванные на крик девичьи голоса.'
    *pl 'В коридоре у дверей спален стоят Аманда и Мелисса — щёки пылают, кулаки сжаты, взгляды скрестились, словно клинки.'
    *pl ' '

    if $FamilySisterBoycottType = 'both':
        *pl '— Бесстыжая! — Аманда наступает на сестру, тыча пальцем ей в грудь. — Сама строила из себя недотрогу, а по ночам тихонько к нему в постель шастаешь! Думаешь, я глухая?! Думаешь, не слышала, как ты стонала за стеной?!'
        *pl ' '
        *pl 'Мелисса нервно одёргивает ворот, в её голосе звенит ледяное бешенство:'
        *pl '— А ты считаешь себя умнее всех, Аманда?! Вешаешься на него при каждом удобном случае! Я думала, хотя бы у одной из нас хватит рассудка держать границы дома!'
        *pl ' '
        *pl '— Границы?! — срывается на плач Аманда. — Да ты первая эти границы перешагнула! Лицемерка! В глаза говоришь про порядок, а сама под одеяло лезешь!'
        *pl ' '
        *pl '— Замолчи! — шипит Мелисса, кусая губу. — Ты понятия не имеешь, каково это — отвечать за весь этот проклятый трактир! И не смей обвинять меня в том, в чём сама погрязла с головой!'

    elseif $FamilySisterBoycottType = 'amanda':
        *pl '— Ты совсем стыд потеряла, Аманда?! — чеканит Мелисса, в упор глядя на младшую сестру. — Думаешь, я слепая? Запах его пота на твоей сорочке не скроет никакой травяной взвар! Ты разрушаешь остатки приличия в этом доме!'
        *pl ' '
        *pl 'Аманда упрямо вскидывает подбородок, в её глазах блестят злые слёзы:'
        *pl '— А тебе какое дело?! Завидуешь, да?! Завидуешь, что он обнимает меня, а не твою кислую мину над книгами! Ты просто завистливая злюка!'

    else
        *pl '— Ты предала наше доверие, Мелисса! — кричит Аманда, сжимая фартук. — Вечно учила меня уму-разуму, а сама тайно пускаешь Стефана в свою спальню! Какая же ты гадкая!'
        *pl ' '
        *pl 'Мелисса скрещивает руки на груди, её губы мелко дрожат:'
        *pl '— Не смей повышать на меня голос, девчонка! Стефан — взрослый мужчина и хозяин дома. Я забочусь о том, чтобы он не искал утешения на стороне!'
    end

    *pl ' '
    *pl 'Половицы под твоими ногами громко скрипят. Сёстры разом вздрагивают и замирают, обернувшись на звук шагов.'

    gs 'ActUiPrepare', 'Вмешаться в спор', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FamilySisterArgumentStefanReaction'
    end
---

#FamilySisterArgumentStefanReaction
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ВТОРОЙ ЭТАЖ: БОЙКОТ'
    gs 'SceneShowVisual', 'images/events/family/sisters_boycott_doors', 'коридор: хлопанье дверьми', 'large', 'webp'

    *pl 'Ты выходишь из тени лестничного пролёта, хмуро глядя на разгорячённых сестёр:'
    *pl '— А ну тихо! Вы совсем с ума сошли — орать на весь дом? Внизу посетители уже ставки делают, кто кому косы вырвет!'
    *pl ' '
    *pl 'Сёстры на мгновение опекают, но затем вся накопленная буря обращается прямо против тебя.'
    *pl ' '

    if $FamilySisterBoycottType = 'both':
        *pl '— А ты вообще замолчи! — сквозь слёзы кричит Аманда, смерив тебя взглядом раненого зверька. — Думал, самый хитрый?! Ласкать обеих и делать вид, что ничего не происходит?! Ненавижу тебя, Стефан!'
        *pl ' '
        *pl 'Мелисса медленно выдыхает, её голос звучит подчеркнуто холодно, но пальцы судорожно сжаты:'
        *pl '— Браво, господин хозяин. Прекрасный образец управления. Поздравляю с успешным результатом. Теперь разбирайся со своим трактиром сам.'

    elseif $FamilySisterBoycottType = 'amanda':
        *pl 'Аманда отступает к своей двери, закрывая лицо ладонями:'
        *pl '— Не подходи ко мне, Стефан! Слышать тебя не хочу! Иди к своей Мелиссе, пусть она тебе счета гладит!'

    else
        *pl 'Мелисса с ледяным презрением смеривает тебя с ног до головы:'
        *pl '— Твоё поведение переходит всякие границы, Стефан. Больше ко мне не приближайся.'
    end

    *pl ' '
    *pl 'Аманда с грохотом захлопывает дверь своей комнаты так, что со стен осыпается побелка.'
    *pl 'Секундой позже щёлкает засов за спиной Мелиссы. В коридоре воцаряется глухая, гнетущая тишина.'
    *pl 'Обе сестры ушли в глухой бойкот и отказываются разговаривать.'

    FamilySisterBoycottActive = 1
    FamilySisterBoycottDay = day
    FamilySisterSuspicionStage = 4
    GirlOffenseDays['amanda'] = 3
    GirlOffenseDays['melissa'] = 3
    $GirlOffenseReason['amanda'] = 'sister_quarrel'
    $GirlOffenseReason['melissa'] = 'sister_quarrel'
    FamilyBoycottTalkAmandaDone = 0
    FamilyBoycottTalkMelissaDone = 0

    gs 'ActUiPrepare', 'Спуститься вниз', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#FamilySisterBoycottTalkAmanda
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'КОМНАТА АМАНДЫ: ОБИДА'
    gs 'SceneShowVisual', 'images/events/family/amanda_boycott_room', 'Аманда: обида в комнате', 'large', 'webp'

    *pl 'Ты тихо приоткрываешь дверь в комнату сестры. Аманда сидит на краю кровати, подтянув колени к груди, и демонстративно смотрит в тёмное окно.'
    *pl ' '
    *pl '— Пошёл вон, Стефан, — глухо бросает она, шмыгая носом. — Иди к своей Мелиссе... Она же взрослая, умная, всё на свете знает... А я так, дурочка на побегушках, да?'
    *pl ' '
    *pl 'Ты садишься на край кровати рядом с ней и мягко опускаешь ладонь ей на плечо. Аманда дёргается, но руки не сбрасывает.'
    *pl 'Ты спокойно и твёрдо объясняешь ей, что она для тебя — не просто младшая сестра или работница в зале. Её теплота, её живой смех и преданность значат для тебя ничуть не меньше, чем все книги и расчёты Мелиссы, и ты никогда не хотел причинить ей боль.'
    *pl ' '
    *pl 'Аманда медленно поворачивает мокрое от слёз лицо и утыкается лбом тебе в плечо, тихо всхлипывая:'
    *pl '— Я так испугалась, Стефан... Подумала, что ты просто играешь со мной. Мне было так больно... Если... если я правда тебе дорога, поговори с ней. Но не смей отталкивать меня, слышишь?'

    FamilyBoycottTalkAmandaDone = 1
    AmandaTrustStefan += 3

    gs 'ActUiPrepare', 'Выйти из комнаты', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#FamilySisterBoycottTalkMelissa
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'КОМНАТА МЕЛИССЫ: РАЗГОВОР'
    gs 'SceneShowVisual', 'images/events/family/melissa_boycott_room', 'Мелисса: разговор в комнате', 'large', 'webp'

    *pl 'В комнате Мелиссы горит единственная свеча. Она сидит за столом, глядя в пергамент невидящим взглядом; кончик гусиного пера давно высох.'
    *pl ' '
    *pl '— Если ты пришёл с банальными извинениями, Стефан — оставь их, — чеканит она, не поворачивая головы. — Я занята расходными ведомостями, и на пустые эмоции у меня нет времени.'
    *pl ' '
    *pl 'Ты подходишь ближе и накрываешь её напряжённую ладонь своей рукой, вынуждая отложить перо.'
    *pl '— Хватит прятаться за счетами, Мелисса. Скажи прямо, что тебя задело.'
    *pl ' '
    *pl 'Плечи Мелиссы на мгновение опускаются, холодная маска трещит по швам:'
    *pl '— Задело то, что я ненавижу терять контроль, Стефан! — сдавленно выдыхает она, встречая твой взгляд в упор. — Примитивная, базарная ревность... Я опустилась до криков в коридоре из-за того, что моё тело и чувства вышли из повиновения рассудка. Это бесит меня больше всего.'
    *pl ' '
    *pl 'Ты говоришь ей, что её ум, гордость и строгость — именно то, за что ты её ценишь, и что живые чувства не делают её слабой. Мелисса тяжело вздыхает и на миг прислоняется лбом к твоей руке:'
    *pl '— Ты невыносим, Стефан... Ломаешь весь мой выстроенный порядок. Но этот трактир — наше общее дело. Поговори с Амандой. Мы не должны всё разрушить.'

    FamilyBoycottTalkMelissaDone = 1
    MelissaRespectStefan += 3

    gs 'ActUiPrepare', 'Выйти из комнаты', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#FamilyDiscoveryLizetteAdvice
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОРТ: СОВЕТ ЛИЗЕТТЫ'
    gs 'SceneShowVisual', 'images/events/family/lizette_advice', 'порт: совет Лизетты', 'large', 'webp'

    *pl 'Стефан застаёт Лизетту у ящиков со столичными пряностями.'
    *pl 'Она лукаво улыбается, обмахиваясь кружевным платком, и внимательно слушает рассказ о домашней буре.'
    *pl ' '
    *pl '— Ох, Стефан, бедный мой хозяин! — посмеивается она с искренним блеском в глазах. — За двумя сестричками погнался — обе коготки выпустили! Но послушай умную девушку: на фронтире женщины делят не наследство, а жизнь.'
    *pl ' '
    *pl 'Лизетта подходит вплотную и легко касается пальцем его подбородка:'
    *pl '— Твои сёстры бесятся не потому, что ты согрешил, а потому, что каждая боится оказаться брошенной ради другой. Не пытайся врать и не выбирай одну. Собери обеих за одним столом, как подобает настоящему хозяину, и дай понять: вы одна семья, и делить вам нечего. Поверь, когда женщина уверена, что её не выкинут из сердца, её ревность быстро уступает место согласию.'

    gs 'ActUiPrepare', 'Вернуться на пристань', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#FamilyDiscoveryClarissaAdvice
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'РЫНОК: СОВЕТ КЛАРИССЫ'
    gs 'SceneShowVisual', 'images/events/family/clarissa_advice', 'рынок: совет Клариссы', 'large', 'webp'

    *pl 'За рядами винных бочек Кларисса выслушивает Стефана, лениво помешивая вино в бокале.'
    *pl ' '
    *pl '— Мелисса с утра ходит чернее тучи, но в глазах у неё огонь, — усмехается Кларисса. — Знаешь, в чём беда моей учёной подруги, Стефан? Она пытается разложить по полочкам то, что требует простого мужского решения.'
    *pl ' '
    *pl 'Она смотрит на Стефана с лукавым прищуром:'
    *pl '— Ей страшно признать, что под строгим платьем она хочет тепла так же, как младшая. Не оправдывайся перед ними. Женщины простят мужчине страсть и жадность, но никогда не простят нерешительности. Поговори с обеими наедине, а потом посади их рядом. Покажи, что трактир держится на вас троих — и они сами найдут общий язык.'

    gs 'ActUiPrepare', 'Вернуться на рынок', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#FamilyDiscoverySistersReconcile
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ОБЩИЙ ЗАЛ: ПРИМИРЕНИЕ СЕМЬИ'
    gs 'SceneShowVisual', 'images/events/family/sisters_reconcile', 'зал: примирение сестёр', 'large', 'webp'

    *pl 'В тихий час, когда зал пустеет, ты собираешь Аманду и Мелиссу за дальним дубовым столом.'
    *pl 'Они садятся друг напротив друга, глядя в столешницу; воздух между ними звенит от скрытого волнения.'
    *pl ' '
    *pl 'Ты садишься во главе стола и кладёшь ладони на тёплое дерево:'
    *pl '— Хватит прятаться и злиться. Мы чуть не разрушили дом из-за недомолвок. Мы — семья. Этот трактир держится на нас троих, и я не собираюсь выбирать между вами или позволять вам враждовать.'
    *pl ' '
    *pl 'Аманда несмело поднимает влажные глаза, закусывая губу:'
    *pl '— Мелисса... прости меня за то, что наговорила на лестнице. Я была дурой.'
    *pl ' '
    *pl 'Мелисса молчит несколько секунд, нервно поправляя ворот платья, а затем тяжело и облегчённо выдыхает:'
    *pl '— И ты меня прости, Аманда. Я повела себя несправедливо... Мы обе поддались глупым эмоциям.'
    *pl ' '
    *pl 'Сёстры переглядываются, и впервые за долгие дни на их лицах проступает робкая, искренняя улыбка. Между ними падает стена недоверия, уступая место новому, глубокому пониманию: старые строгие запреты рухнули, но вместе они стали только ближе.'
    *pl ' '
    *pl 'Они одновременно поворачивают лица к тебе. В их взглядах больше нет упрёка — только готовность делить с тобой и общую работу, и эту новую семейную тайну.'

    FamilySisterBoycottActive = 0
    FamilySisterSuspicionStage = 5
    GirlOffenseDays['amanda'] = 0
    GirlOffenseDays['melissa'] = 0
    FamilyBoycottTalkAmandaDone = 0
    FamilyBoycottTalkMelissaDone = 0
    FamilyTension = 0
    FamilyTrust += 15
    AmandaTrustStefan += 5
    MelissaTrustStefan += 5

    gs 'ActUiPrepare', 'Вернуться к делам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---
