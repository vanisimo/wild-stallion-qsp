! ================================================
! FILE: modules/events/port/port_amanda_lizette_text.qsps
! [AI-WORKED] 2026-09-07: tuned tone and voices, grounded in lore
! Тексты сцены Аманды и Лизетты у корабля
! ================================================

#PortAmandaLizetteText
    $PortAmandaLizetteTextId = LCASE($ARGS[0])
    $PortAmandaLizetteText = ''

    if $PortAmandaLizetteTextId = 'port_scene':
        $PortAmandaLizetteText = 'У трапа столичного корабля'
    elseif $PortAmandaLizetteTextId = 'port_scene_tail':
        $PortAmandaLizetteText = 'оживлённо щебечет с незнакомой смуглой девушкой — обе увлечённо перебирают пёстрые шелка и звонко смеются над заморскими безделушками.'
    elseif $PortAmandaLizetteTextId = 'inspect':
        $PortAmandaLizetteText = 'Ты останавливаешься в нескольких шагах, укрывшись за штабелем ящиков, и с улыбкой наблюдаешь за сестрой.'
        $PortAmandaLizetteText += '<br><br>Сегодня у Аманды законный повод выбраться из трактира к причалу — развеяться от привычных хлопот в зале, поглазеть на людей и посмотреть, что привезли купцы. Щёки её горят румянцем, в глазах неподдельный восторг, а в руках — отрез яркой шёлковой ленты.'
        $PortAmandaLizetteText += '<br><br>Рядом с ней вертится девчонка примерно того же возраста: смуглая, с копной тёмных кудрей и живыми, смешливыми глазами. Она ничуть не робеет, держится легко и раскованно — видно, что в порту чувствует себя как рыба в воде. Ловко перебирая заморские бусины и браслеты, смуглянка что-то увлечённо тараторит на ухо Аманде, то и дело прикладывая к её волосам то гребень, то пёструю тесьму.'
        $PortAmandaLizetteText += '<br><br>Аманда то прыскает со смеху, закрывая рот ладошкой, то смущённо вспыхивает, слушая бойкую болтовню новой подружки. Девушки шепчутся обо всём подряд: о столичных нарядах, о заморских тканях, о мальчишках и праздниках — словом, о том, о чём девчонкам только и хочется трещать часами напролёт.'
        $PortAmandaLizetteText += '<br><br>Смуглянка заливисто смеётся, подмигивает Аманде и шутливо поправляет ей косу. Видно, что обе искренне рады найти сверстницу, с которой можно без умолку поболтать обо всех девичьих секретах.'

        if GeorgetteKnown = 1:
            $PortAmandaLizetteText += '<br><br>Глядя на смуглую девушку, ты вспоминаешь слова Жоржетты. Тёмная кожа, южные кудри, неугомонный нрав... Дочь портовой торговки, Лизетта. Теперь понятно, кто это.'
        end

        $PortAmandaLizetteText += '<br><br>Ты решаешь не подходить и не мешать сестре: пускай посекретничают и вдоволь наговорятся. А у тебя самого ещё полно дел в порту.'
    elseif $PortAmandaLizetteTextId = 'stefan_recognizes':
        $PortAmandaLizetteText = 'Ты вспоминаешь слова Жоржетты. Дочь, которая часто бегает в порт смотреть товары из столицы. Лизетта. Теперь сомнений не остаётся.'
    else:
        $PortAmandaLizetteText = 'У трапа столичного корабля Аманда оживлённо болтает с незнакомой девушкой.'
    end

    killvar '$PortAmandaLizetteTextId'
---