! ================================================
! FILE: modules/events/port/port_night_alley_text.qsps
! MODULE: events/port
! [AI-WORKED] 2026-09-08: canon prose overhaul - detailed action, appearance, canon characters
! Тексты наблюдения в переулке (B3 / H)
! ================================================

#PortNightAlleyText
    $PortNightAlleyTextId = LCASE($ARGS[0])
    $PortNightAlleyText = ''

    if $PortNightAlleyTextId = 'peek_open_georgett':
        $PortNightAlleyText = 'Вы бесшумно прижимаетесь к просмолённой стене пакгауза и заглядываете в узкий проём между штабелями бочек. В переулке покачивается масляный фонарь, озаряя тёплым жёлтым светом сырые доски и старую разгрузочную телегу.'
    elseif $PortNightAlleyTextId = 'peek_open_lizette':
        $PortNightAlleyText = 'Вы осторожно ступаете по влажным доскам причала и скользите взглядом за угол соляного склада. Запах смолы, солоноватой воды и пряностей кружит голову, а дрожащий свет фонаря выхватывает из темноты уютный тупик между бочками и гружёной телегой.'

    elseif $PortNightAlleyTextId = 'georgett_sailors':
        $PortNightAlleyText = 'Двое рослых темнокожих матросов с заморского судна устроили тридцатидвухлетнюю блондинку на краю гружёной телеги. Жоржетта упёрлась ладонями в сено, её пышная, налитая спелая грудь сладко вздрагивает при каждом толчке, а голубые глаза блестят от неподдельного возбуждения. Тонкая ткань платья задрана до самой талии, обнажая аппетитные белые бёдра.'
        $PortNightAlleyText += '<br><br>Один матрос стоит сзади, крепко сжимая её ягодицы мозолистыми руками и мерно, глубоко всаживая свой тугой тёмный ствол в её сочащуюся влагой киску. Жоржетта сладострастно выгибает спину, ловит ритм и стонет низким грудным голосом, а второй моряк тем временем ласкает её набухшие соски и с улыбкой направляет свой член ей в приоткрытые губы. Блондинка с жадным упоением обхватывает горячую головку ртом, водит языком и заглатывает глубже, сладко постанывая от двойной ласки.'
        $PortNightAlleyText += '<br><br>— Ох, черти морские, как же сладко у вас получается… — выдыхает она, когда первый моряк с хриплым рыком кончает глубоко внутрь, заставляя её тело содрогнуться в мощном оргазме. Второй изливается ей в рот, и Жоржетта с довольной улыбкой всё проглатывает, вытирая губы тыльной стороной ладони.'
        $PortNightAlleyText += '<br><br>— Ты ненасытная, красавица, — весело смеётся матрос на ломаном наречии, выкладывая на крышку бочки горсть серебряных монет сверх уговора. Жоржетта пересчитывает плату, приятно щурясь: — Для таких парней мне никогда не жалко времени. Приходите завтра, порадуем друг друга ещё разок!'

    elseif $PortNightAlleyTextId = 'georgett_townsman':
        $PortNightAlleyText = 'Зажиточный горожанин в добротном суконном плаще прижал Жоржетту к деревянной стене склада. Блондинка с готовностью обхватила его поясницу своими стройными бёдрами, задрав подол юбки. Её высокая пышная грудь выскользнула из глубокого декольте корсажа, и горожанин жадно целует её соски, пока его крепкий член методично и плавно входит в податливую, мокрую плоть.'
        $PortNightAlleyText += '<br><br>— Ах… да, вот так, милый, ещё… прямо туда… — томно шепчет Жоржетта ему на ухо, запуская пальцы в его аккуратную бородку и ритмично двигая тазом навстречу каждому толчку. — Чувствуешь, как я тебя сжимаю? Не торопись, получай удовольствие…'
        $PortNightAlleyText += '<br><br>Горожанин довольно покряхтывает, сжимая её пышные ягодицы: — Какая же ты горячая, Жоржетта… Вся гильдия только о тебе и говорит. — Он ускоряет темп, с упоением вдалбливая член до самого упора. Блондинка шумно вскрикивает, закатывая голубые глаза от накатившего оргазма, и плотно сжимает его бёдра, когда мужчина с блаженным стоном изливается глубоко в неё.'
        $PortNightAlleyText += '<br><br>Отдышавшись, горожанин бережно опускает её на ноги и с улыбкой вкладывает в ладонь увесистый кошель: — Спасибо за ласку, красавица. На душе прямо полегчало. — Жоржетта поправляет платье и нежно целует его в щёку: — Приходи в любой вечер, дорогой. Всегда рада доставить тебе радость.'

    elseif $PortNightAlleyTextId = 'georgett_oral':
        $PortNightAlleyText = 'Жоржетта уютно устроилась на коленях у большой бочки, на которой сидит седой, кряжистый капитан торговой шхуны. Светлые локоны красавицы рассыпались по плечам, подчёркивая открытую аппетитную ложбинку её пышной груди. Расстегнув штаны моряка, она с ласковой улыбкой берёт его внушительный член обеими руками и медленно облизывает сочную головку.'
        $PortNightAlleyText += '<br><br>— Ну что, старый морской волк, соскучился в плавании по женским губкам? — лукаво подмигивает она голубыми глазами и мягко погружает ствол в свой тёплый, влажный рот. Жоржетта действует умело и с явным наслаждением: скользит губами до самого основания, поглаживает мошонку пальчиками и задаёт размеренный, бархатный темп, заставляя капитана хрипло стонать от блаженства.'
        $PortNightAlleyText += '<br><br>— Ох, чертовка… слаще любого эля в кабаке… — бормочет моряк, бережно поглаживая её по золотистым волосам. Жоржетта ускоряет движения губ, плотно сжимает щёки и доводит мужчину до бурного финала. Он с довольным рычанием кончает ей глубоко в горло. Блондинка мягко сглатывает семя, облизывает влажные губки и сладко улыбается снизу вверх.'
        $PortNightAlleyText += '<br><br>Капитан от души хлопает её по плечу и щедро сыплет монеты в её раскрытую ладонь: — Золотые у тебя ручки и ротик, Жоржетта! Настоящая королева порта! — Жоржетта весело подмигивает, пряча серебро: — Для хорошего человека ничего не жалко, капитан!'

    elseif $PortNightAlleyTextId = 'georgett_wall':
        $PortNightAlleyText = 'Молодой мускулистый докер с широкими плечами зажал Жоржетту спиной к шершавым брёвнам пакгауза. Блондинка сама задорно подпрыгнула, широко разведя стройные ноги и оплетя его поясницу. Её пышная, соблазнительно упругая грудь подрагивает под тонким батистом рубашки, а в голубых глазах горит задорный огонёк.'
        $PortNightAlleyText += '<br><br>Парень держит её за ягодицы, мощными, уверенными толчками входя в неё снизу вверх. Стенка склада ритмично поскрипывает от их напора, влажные шлепки тел разносятся по переулку. Жоржетта запрокидывает голову, впиваясь ногтями в его крепкие плечи, и громко стонет в такт движениям:'
        $PortNightAlleyText += '<br><br>— Да… сильнее, парень, какой ты крепкий! Трахай меня, вот так, глубже! — Она сладостно ерзает на его члене, помогая бёдрами и доводя обоих до предела. Докер шумно рычит, прижимает её всем телом к стене и с хриплым стоном щедро кончает в горячее нутро блондинки. Жоржетта содрогается всем телом от мощной разрядки, счастливо улыбаясь ему в губы.'
        $PortNightAlleyText += '<br><br>Опустив её на землю, сияющий докер торопливо протягивает звенящие спинтарии: — Ух, Жоржетта, спасибо! С тобой любая усталость после разгрузки как рукой снимается! — Блондинка приглаживает юбку и легко треплет парня по вихрастой макушке: — На здоровье, силач. Заработал — умей и отдохнуть!'

    elseif $PortNightAlleyTextId = 'georgett_anal':
        $PortNightAlleyText = 'Возле широкой бочки Жоржетта стоит на четвереньках, прогнув спину и аппетитно отставив назад упругую круглую попку. Светлые волосы спадают на плечи, открывая вид на роскошный вырез, откуда выглядывает тяжёлая грудь. За ней стоит высокий матрос с золотой серьгой в ухе, бережно смазывая её тугую розовую дырочку слюной и пахучим маслицем.'
        $PortNightAlleyText += '<br><br>— Не бойся, красавица, я аккуратно… — шепчет он, нежно поглаживая бёдра тридцатидвухлетней шлюхи. Жоржетта оборачивается через плечо, одаряя его манящим взглядом голубых глаз:'
        $PortNightAlleyText += '<br><br>— Кто боится-то? Давай, заходи смелее, только плавно. Я задний вход тоже люблю, когда парень с толком делает. — Матрос медленно надавливает крупной головкой, раздвигая тугие складочки ануса. Жоржетта протяжно и сладко выдыхает, расслабляется и сама подаётся назад, насаживаясь на толстый ствол на всю длину.'
        $PortNightAlleyText += '<br><br>Матрос начинает уверенно и глубоко входить в её задницу, шлёпая ладонью по гладкой коже бедра. Жоржетта стонет от необычного, распирающего удовольствия, запуская руку себе между ног и поглаживая набухший клитор. Через несколько минут бурного темпа они кончают одновременно: моряк изливается в её плотную попку, а Жоржетта бьётся в экстазе, пачкая соками пальцы.'
        $PortNightAlleyText += '<br><br>Вытащив член, матрос с восхищением целует её в плечо и отсчитывает двойную плату: — Ну ты и мастерица, Жоржетта! Редко встретишь такую податливую и страстную женщину! — Блондинка с довольным урчанием поправляет подол: — Хорошая работа требует хорошей награды, красавчик. Приходи ещё, согреем друг друга!'

    elseif $PortNightAlleyTextId = 'georgett_dp':
        $PortNightAlleyText = 'На широкой разгрузочной телеге развернулось настоящее празднество плоти. Двое крепких портовых грузчиков устроили Жоржетту между собой на мягких тюках парусины. Тридцатидвухлетняя блондинка упирается коленями в ткань, её великолепная пышная грудь колышется от пылких движений, а румяное лицо сияет искренней чувственной радостью.'
        $PortNightAlleyText += '<br><br>Один парень лежит на спине, и Жоржетта сидит на нём верхом, принимая его член в свою мокрую киску, а второй пристроился сзади и бережно, но настойчиво входит ей в попку. Блондинка протяжно ахает, когда оба крепких мужских органа заполняют её до отказа:'
        $PortNightAlleyText += '<br><br>— О-о-ох… сразу двое… как же полно, как горячо! — стонет она, обхватывая пальцами шею переднего любовника и целуя его в губы, пока задний держит её за бёдра и задаёт ритм. Мужчины работают слаженно и бережно, любуясь пышным, отзывчивым телом блондинки.'
        $PortNightAlleyText += '<br><br>Когда оба с хриплыми стонами разряжаются внутрь — один в лоно, другой в анал — Жоржетта кричит от накатившего двойного оргазма, сжимаясь вокруг них всеми мышцами. Несколько минут все трое просто лежат в обнимку, тяжело дыша и улыбаясь.'
        $PortNightAlleyText += '<br><br>— Вот это была жара, Жоржетта! Настоящий праздник! — довольно посмеиваются грузчики, выкладывая перед ней солидную кучку серебра. Блондинка собирает монеты, светясь от удовольствия: — С вами, мальчики, хоть каждую ночь! И поработали на славу, и ублажили как надо!'

    elseif $PortNightAlleyTextId = 'georgett_priest':
        $PortNightAlleyText = 'В полумраке переулка за деревянной перегородкой виднеется тёмная фигура в монашеской рясе — молодой послушник из храма Ильматера, явно сбежавший из обители ради ночных утех. Жоржетта сидит у него на коленях, задрав подол юбки и широко разведя стройные белые ноги. Её пышная грудь выскользнула из декольте, и послушник благоговейно прижимается к ней губами.'
        $PortNightAlleyText += '<br><br>Член священнослужителя скрыт под складками рясы, глубоко входя в горячую плоть тридцатидвухлетней блондинки. Жоржетта плавно и сладострастно покачивается на нём, поглаживая юношу по гладко выбритым щекам:'
        $PortNightAlleyText += '<br><br>— Ну что, святой отец, велика ли благодать? — с озорной улыбкой шепчет она голубыми глазами прямо ему в лицо. — Ильматер заповедовал радоваться плоти и не отказывать ближнему в утешении.'
        $PortNightAlleyText += '<br><br>— Велика, о как велика… всеблагой да простит меня… — прерывисто шепчет парень, не в силах сдержать восторга, и крепко обнимает её за талию. Жоржетта ускоряет круговые движения бёдер, доводя молодого послушника до неистового семяизвержения. Он сдавленно ахает и заливает её нутро горячим семенем, пока блондинка сладко вздрагивает от собственной разрядки.'
        $PortNightAlleyText += '<br><br>Отдышавшись, юноша смущённо, но с сияющим лицом суёт ей в ладонь увесистый храмовый кошелёк: — Спасибо тебе, Жоржетта… Ты словно ангел во плоти. — Блондинка весело целует его в лоб, пряча спинтарии: — Иди с миром, отрок, и замаливай грехи с лёгким сердцем. Приходи ещё за благословением!'

    elseif $PortNightAlleyTextId = 'georgett_eddie':
        $PortNightAlleyText = 'В щели между бочками виден забавный и трогательный силуэт: молодой Эдди из лавки вдовы Бекки крадётся в переулок, красный от смущения до самых кончиков ушей. Жоржетта ласково встречает его у шершавой стены склада. Тридцатидвухлетняя блондинка выглядит невероятно притягательно: глубокое декольте открывает вид на роскошную, маняще пышную грудь, а голубые глаза светятся мягким материнским пониманием.'
        $PortNightAlleyText += '<br><br>— Ну что, Эдди, пришёл проведать свою любимую Жоржетту? — нежно шепчет она, притягивая парня к себе и позволяя его дрожащим рукам лечь на её мягкую талию. Эдди торопливо суёт ей в кулачок несколько честно заработанных монет:'
        $PortNightAlleyText += '<br><br>— Да, Жоржетта… я так ждал ночи… — парень путается в её юбках, достаёт напряжённый член и с благоговением прижимается к её тёплому бедру. Блондинка сама направляет его головку внутрь своей сочной, готовой киски. Парень судорожно стонет от невероятной тесноты и мягкости.'
        $PortNightAlleyText += '<br><br>Жоржетта плавно ведёт его движения, обнимая за плечи и одаривая нежными поцелуями: — Вот так, милый, какой ты у меня молодец, какой крепкий мальчик… — От её ласковых слов и обжигающей влаги Эдди быстро заходится в экстазе и с хриплым вздохом обильно кончает ей внутрь. Блондинка ласково гладит его по волосам, успокаивая его дрожь.'
        $PortNightAlleyText += '<br><br>— Ух… Жоржетта, ты самая лучшая на свете! — счастливо выдыхает Эдди, застёгивая штаны. Блондинка улыбается и поправляет ему воротник: — Беги домой, мой хороший, и матери ни слова. Захочешь ласки — ты знаешь, где меня найти.'

    elseif $PortNightAlleyTextId = 'georgett_eddie_mommy':
        $PortNightAlleyText = 'Эдди снова в переулке, но теперь в его походке куда больше уверенности. Жоржетта сидит на перевёрнутой бочке, распахнув полы платья и открыв взору упругую, налитую грудь с розовыми сосками. Её светлые локоны колышет лёгкий ветерок, а в голубых глазах сияет лукавое обожание.'
        $PortNightAlleyText += '<br><br>— Пришёл к своей мамочке, мой пирожочек? — с бархатистой улыбкой мурлычет тридцатидвухлетняя красавица, протягивая к нему руки. Эдди с благоговейным трепетом опускается на колени:'
        $PortNightAlleyText += '<br><br>— Да, мамочка… покажи, как ты любишь своего мальчика… — шепчет он, прижимаясь лицом к её пышной груди и жадно целуя соски. Жоржетта с явным удовольствием поглаживает его затылок, затем мягко раздвигает колени и сажает парня на бочку рядом с собой, направляя его затвердевший член в свою влажную глубину.'
        $PortNightAlleyText += '<br><br>Она двигается на нём с искусной нежностью, лаская его торс и негромко нашептывая ему ласковые похвалы: — Вот так, сладенький… пей молочко, люби мамочку… смотри, как мамочке с тобой хорошо… — Жоржетта сама заводится от этой игры не на шутку, шумно вздыхая и кончая вместе с ним в жарком порыве наслаждения.'
        $PortNightAlleyText += '<br><br>Эдди блаженно обнимает её, отдавая все свои сбережения: — Спасибо, мамочка… я самый счастливый! — Блондинка осыпает его лоб поцелуями и прячет серебро: — Расти большим и сильным, мой мальчик. Жду тебя на следующей неделе!'

    elseif $PortNightAlleyTextId = 'lizette_sailors':
        $PortNightAlleyText = 'У большой деревянной телеги с парусиновыми мешками резвится восемнадцатилетняя Лизетта в компании двоих весёлых заморских матросов. Юная мулатка с экзотической бархатистой смуглой кожей, шапкой пружинистых тёмных кудрей и сияющими голубыми глазами выглядит потрясающе соблазнительно. Её аккуратная, девически упругая грудь дразняще выглядывает из выреза пёстрого столичного платья.'
        $PortNightAlleyText += '<br><br>Один моряк развалился на мешках, и Лизетта оседлала его крепкие бёдра, задорно подпрыгивая на его крупном тёмном стволе. Её гибкое стройное тело изгибается с невероятной грацией, а звонкий заливистый смех эхом разносится по переулку. Второй моряк встал рядом, и юная озорница охотно обхватывает его член своими пухлыми губами, скользя языком и умело ублажая обоих мужчин сразу.'
        $PortNightAlleyText += '<br><br>— Ох, черти полосатые, как же мне нравится! — весело восклицает Лизетта, оторвавшись от члена и сладко извиваясь на нижнем моряке. — Двигайся резвее, морячок, давай-давай! — Мулатка сама заводится от дерзкой забавы, её бёдра трепещут, и звонкий девичий оргазм сотрясает её тело. Матросы с довольными возгласами кончают почти синхронно: один омывает её лоно изнутри, второй изливается ей на животик и аккуратную грудь.'
        $PortNightAlleyText += '<br><br>Матросы хохочут и бросают ей горсть блестящих спинтарий: — Ай да девка! Огонь, а не девчонка! — Лизетта с сияющей улыбкой собирает монетки за подвязку чулка: — А то! Мама учила брать от жизни всё! Приплывайте ещё, мальчики!'

    elseif $PortNightAlleyTextId = 'lizette_young':
        $PortNightAlleyText = 'Молодой симпатичный парень, подмастерье из городской кузницы, прижал восемнадцатилетнюю Лизетту к тёплым доскам складской стены. Смуглая мулатка с копной тёмных кудрей и озорными голубыми глазами звонко хихикает, с явным удовольствием обхватив его талию своими гибкими ножками. Её аккуратная упругая грудь часто вздымается от возбуждения, когда юноша осторожно, но жадно целует её шею.'
        $PortNightAlleyText += '<br><br>— Ну же, смелее, кузнечик, не обожгу! — игриво подбадривает она, сама направляя его горячий ствол в свою узкую влажную щёлочку. Парень входит одним плавным движением, и оба сладостно вздыхают от идеального совпадения тел. Парень начинает двигаться быстро и пылко, любуясь экзотической красотой юной шлюхи.'
        $PortNightAlleyText += '<br><br>Лизетта подстраивается под каждый его толчок, её смуглые бёдра пляшут в такт его дыханию, а в голубых глазах мерцает искренний огонь наслаждения. — Ах… да, вот так… какой ты горячий! — стонет она, крепче сжимая его ногами и содрогаясь в ярком юношеском оргазме. Парень с блаженным вскриком кончает внутрь, прижимаясь лбом к её кудрям.'
        $PortNightAlleyText += '<br><br>Сползая по стене на ноги, парень с восхищением отсыпает ей монеты: — Лизетта, ты просто чудо! Я всю неделю о тебе на наковальне мечтал! — Мулатка весело чмокает его в нос, пряча серебро: — Мечтай почаще, кузнечик! Приходи, как только карманы снова зазвенят!'

    elseif $PortNightAlleyTextId = 'lizette_townsman':
        $PortNightAlleyText = 'На широкой пузатой бочке из-под рома восемнадцатилетняя Лизетта озорно устроилась на четвереньках, прогнув спинку и выставив назад гладкую, упругую смуглую попку. Тёмные локоны спадают на лоб, приоткрывая сияющие голубые глаза, а сквозь расстёгнутый ворот платья видна её небольшая девичья грудь с торчащими сосками. Сзади стоит усатый ремесленник в чистом фартуке, с упоением разглядывая её прелести.'
        $PortNightAlleyText += '<br><br>— Ай да девчонка, картинка просто… — довольно кряхтит ремесленник, любовно поглаживая её смуглые ягодицы. Лизетта кокетливо оглядывается через плечо:'
        $PortNightAlleyText += '<br><br>— Меньше болтай, дяденька, лучше покажи, на что способен городской мастер! — Ремесленник с улыбкой входит в неё сзади, крепко взявшись за края бочки. Дерево мерно поскрипывает под их напором, а Лизетта сладко постанывает, ритмично двигая попкой навстречу каждому глубокому толчку.'
        $PortNightAlleyText += '<br><br>Ремесленник ускоряется, с удовольствием ощущая, как горячее девичье нутро нежно и цепко обжимает его ствол. Через пару минут оба достигают кульминации: мужчина с хрипом изливается глубоко в мулатку, а Лизетта визжит от восторга, кончая на прохладные доски бочки.'
        $PortNightAlleyText += '<br><br>— Вот это по-нашему, по-ремесленному! — посмеивается мужчина, щедро одаривая её серебром. Лизетта поправляет юбку и весело сверкает глазами: — Золотые руки у ваших мастеров, дяденька! Заходи ещё на огонёк!'

    elseif $PortNightAlleyTextId = 'lizette_legare':
        $PortNightAlleyText = 'У деревянной перегородки пакгауза стоит почтенный купец Альбер Легаре в своём роскошном тёмно-синем плаще с меховой оторочкой. Он ничуть не робеет, не оглядывается по сторонам и чувствует себя здесь полновластным хозяином положения. Рядом с ним — восемнадцатилетняя Лизетта. Купец искренне и тепло привязан к молодой смуглянке: он ласково гладит её по тёмным кудрям и с восхищением целует её бархатные щёки.'
        $PortNightAlleyText += '<br><br>— Моя маленькая экзотическая птичка, как же ты хороша сегодня… — с мягкой улыбкой приговаривает Альбер, осторожно приподнимая подол её платья и любуясь гибким смуглым телом. Под тонкой тканью перекатывается её аккуратная упругая грудь, а голубые глаза Лизетты искрятся нежностью и кокетством.'
        $PortNightAlleyText += '<br><br>Легаре входит в неё плавно и уверенно, одной рукой придерживая её за талию, а другой нежно поглаживая её лицо. Лизетта с довольным стоном обвивает его шею руками, с наслаждением подаваясь навстречу каждому толчку: — Мессир Альбер, с вами всегда так сладко и надёжно… Вы настоящий мужчина, не то что зеленые мальчишки.'
        $PortNightAlleyText += '<br><br>Купец ласково улыбается, размеренно и глубоко доводя её до яркого, чувственного оргазма, после чего и сам с наслаждением кончает внутрь её горячего лона. Отдышавшись, он достаёт увесистый бархатный кошель, полный золотых и серебряных монет, и щедро вкладывает его в ладошку девушки:'
        $PortNightAlleyText += '<br><br>— Купи себе новых лент и сладостей, красавица моя. Ты достойна самого лучшего. — Лизетта с сияющими глазами целует купца в губы: — Спасибо, добрый мессир Альбер! Вы у меня самый лучший!'

    elseif $PortNightAlleyTextId = 'lizette_legare_oral':
        $PortNightAlleyText = 'Альбер Легаре вальяжно облокотился на высокую просмолённую бочку, распахнув свой богатый плащ. Ни капли смущения или страха на его холёном лице нет — он знает себе цену и сполна наслаждается ночным причалом. Перед ним на коленях устроилась восемнадцатилетняя Лизетта. Тёмные упругие кудри рассыпались по плечам, голубые глаза смотрят на купца с живым обожанием и лаской.'
        $PortNightAlleyText += '<br><br>Мулатка заботливо расстегнула его штаны и взяла в ладошки налитый мужской орган. Склонившись, она нежно целует головку, скользит тёплым язычком по венкам и медленно, с бархатной мягкостью погружает член в свой ротик. Её аккуратная грудь соблазнительно колышется, когда она мерно двигает головой, помогая себе пальчиками у основания ствола.'
        $PortNightAlleyText += '<br><br>— Умница, девочка моя… какая же ты искусная ларовница, — довольно мурлычет Легаре, ласково перебирая её тёмные завитки и ничуть не форсируя темп. Лизетта довольно мычит в ответ, стараясь доставить богатому покровителю максимальное наслаждение. Она заглатывает глубже, ласкает его мошонку и сладко щурится от удовольствия.'
        $PortNightAlleyText += '<br><br>Когда купец с хриплым вздохом облегчения изливает своё семя, Лизетта аккуратно всё принимает, сглатывает до последней капли и с озорной улыбкой поднимает на него сияющее личико. Легаре с улыбкой достаёт пригоршню монет и осыпает ими девушку: — Настоящее сокровище южных морей! Всегда радуешь моё сердце, Лизетта! — Мулатка довольно смеётся: — Для вас, мессир Альбер, с превеликой радостью!'

    elseif $PortNightAlleyTextId = 'lizette_legare_take':
        $PortNightAlleyText = 'В глубине переулка на большой разгрузочной телеге среди мягких мешков с зерном расположились Альбер Легаре и юная Лизетта. Купец сбросил плащ на сено, его лицо светится спокойной, вальяжной уверенностью. Восемнадцатилетняя мулатка с удовольствием устроилась перед ним на коленях, игриво покачивая круглой смуглой попкой и поглядывая на него через плечо сияющими голубыми глазами.'
        $PortNightAlleyText += '<br><br>— Готова, моя синеглазая жемчужина? — с доброй улыбкой спрашивает Альбер, бережно оглаживая её бёдра. — Готова, мессир Альбер, возьмите меня скорее! — задорно отзывается девчонка. Купец входит в неё сзади размеренно, крепко и глубоко. Мешки под ними мягко пружинят, заглушая звуки.'
        $PortNightAlleyText += '<br><br>Легаре трахает молодую мулатку со знанием дела: ласкает её талию, целует смуглые лопатки и задаёт плотный, сладострастный ритм. Лизетта шумно стонет, прогибая тонкую спинку и виляя бёдрами в такт его толчкам. Её аккуратная грудь вздымается от восторга, а сочная киска жадно сжимает член купца, доводя девушку до неистового девичьего оргазма.'
        $PortNightAlleyText += '<br><br>Альбер с довольным стоном кончает следом, наполняя мулатку до краев своим семенем. Поправив одежду, купец заботливо помогает девушке подняться и выкладывает на мешок тяжёлый кошель: — Вот тебе за старание, моя радость. Ни в чём себе не отказывай. — Лизетта крепко обнимает его за шею: — Спасибо, мессир Альбер! Вы самый добрый и щедрый покровитель во всем городе!'

    elseif $PortNightAlleyTextId = 'lizette_oral':
        $PortNightAlleyText = 'У высокой стопки просмолённых ящиков восемнадцатилетняя мулатка Лизетта опустилась на колени перед молодым столичным матросом. Её копна тёмных кудрей задорно подрагивает, голубые глаза искрятся лукавством, а сквозь глубокий вырез платья видна аппетитная аккуратная грудь. Парень с восторгом смотрит на экзотическую красавицу, пока её ловкие смуглые ручки освобождают его затвердевший член.'
        $PortNightAlleyText += '<br><br>Лизетта с явным аппетитом облизывает головку, обводит её кончиком языка и уверенно берет в рот. Несмотря на юный возраст, девчонка действует удивительно умело и раскованно: скользит губками по всей длине, причмокивает и заглатывает до самого основания, совершенно не стесняясь и ловя кайф от процесса.'
        $PortNightAlleyText += '<br><br>— Ох, ничего себе… где тебя так сладко сосать научили, смугляночка? — восторженно шепчет матрос, запустив пальцы в её пышные кудри. Лизетта озорно подмигивает снизу вверх, ускоряет темп и доводит парня до бурного финала. Он со стоном изливается ей в рот, и девушка с довольной улыбкой всё проглатывает, облизав розовые губки.'
        $PortNightAlleyText += '<br><br>Моряк щедро сыплет монеты ей в ладошку: — Ты просто чудо, красотка! Лучший подарок в этом порту! — Лизетта весело смеётся, пряча заработок: — Рада стараться, морячок! Заглядывай ещё!'

    elseif $PortNightAlleyTextId = 'lizette_wall':
        $PortNightAlleyText = 'Молодой плечистый докер с сияющей улыбкой подхватил восемнадцатилетнюю Лизетту на руки и прижал её к тёплым доскам сарая. Юная мулатка со звонким смехом обвила его талию гибкими смуглыми ножками, её тонкое платье задралось до пояса, а аккуратная упругая грудь часто колышется под расстёгнутым корсажем.'
        $PortNightAlleyText += '<br><br>Парень входит в неё стоя мощным и уверенным толчком, заставляя девушку сладко ахнуть. Лизетта не теряется: она прижимается к его груди, осыпает его щёки поцелуями и страстно двигает бёдрами навстречу каждому движению. Их тела сплетаются в едином горячем ритме на фоне ночной прохлады.'
        $PortNightAlleyText += '<br><br>— Ах, какой ты сильный, докер! Двигайся ещё, трахай меня! — задорно стонет мулатка, впиваясь пальчиками в его мускулистые плечи. Парень ускоряет шаг, и через минуту бешеной страсти они оба содрогаются в мощном одновременном экстазе. Парень заливает её горячим семенем, счастливо целуя её в шею.'
        $PortNightAlleyText += '<br><br>Опустив Лизетту на землю, он с восторгом отдаёт ей заработанные за смену монеты: — Ух, Лизетта, ты просто огонь! С тобой любая тяжесть забывается! — Девчонка весело поправляет юбку: — Для хороших парней у меня всегда огонь найдётся! Спасибо за серебро!'

    elseif $PortNightAlleyTextId = 'lizette_barrel':
        $PortNightAlleyText = 'Восемнадцатилетняя Лизетта задорно уселась на крышку большой пузатой бочки, широко расставив смуглые ножки и оплетя ими поясницу солидного пожилого торговца пряностями. Её тёмные кудри растрепались, голубые глаза горят азартом, а аккуратная девичья грудь выглядывает из ворота платья, дразня старика.'
        $PortNightAlleyText += '<br><br>Купец пыхтит от восторга, обнимая гибкую мулатку за талию и мерно входя в её узкое горячее лоно. Лизетта сама задаёт темп: изгибается, покачивает бёдрами и тихонько напевает озорную столичную песенку, царапая его плечи ноготками и не давая замедлиться ни на секунду.'
        $PortNightAlleyText += '<br><br>— Ох, егоза… довела старика до дрожи… — стонет торговец, зарываясь носом в её ароматные завитки. Лизетта победно смеётся и сжимает его нутром, когда оба замирают в сладком порыве оргазма. Купец со счастливым выдохом оседает ей на плечо, выплеснув всё до последней капли.'
        $PortNightAlleyText += '<br><br>Отдышавшись, торговец с улыбкой кладёт ей на колени тугой мешочек с монетами: — Спасибо за молодость, милая. Словно на двадцать лет назад вернулся. — Лизетта спрыгивает с бочки, пряча серебро: — Приходи почаще, дедушка, я тебя ещё не раз омоложу!'

    elseif $PortNightAlleyTextId = 'limit_georgett':
        $PortNightAlleyText = 'Жоржетта замечает ваш силуэт между бочками. Тридцатидвухлетняя блондинка лукаво улыбается голубыми глазами, прикладывает пальчик к губам и посылает вам воздушный поцелуй. Собрав заработанное серебро и поправив пышную грудь в корсете, она летящей походкой направляется вглубь порта — на сегодня её смена окончена.'
    elseif $PortNightAlleyTextId = 'limit_lizette':
        $PortNightAlleyText = 'Лизетта ловит ваш взгляд из-за угла склада. Юная мулатка весело смеётся, потряхивая шапкой тёмных кудрей, озорно подмигивает сияющими голубыми глазами и шутливо кланяется. Спрятав монеты за подвязку чулка, она скрывается в ночной темноте причалов до самого рассвета.'

    end

    killvar '$PortNightAlleyTextId'
---