! ================================================
! FILE: modules/events/port/port_legare_heist_text.qsps
! MODULE: events/port
! ! [AI-WORKED] Текст переработан / дополнен ассистентом 03.11.2026
! Тексты ночной вылазки на баркас Легаре с Лизеттой
! ================================================

#PortLegareHeistPrintText
    $TextKey = LCASE(TRIM($ARGS[0]))

    if $TextKey = 'start':
        *pl 'Вы с Лизеттой крадётесь по скользким доскам дальнего причала, пригибаясь за штабелями пустых бочек.'
        *pl 'У причала покачивается тяжёлый баркас под чёрным смолёным парусом. По бортам стоят бочки с вином, которые спешно грузят в темноте.'
        *pl '— Вон он, баркас Легаре, — шепчет Лизетта, указывая пальчиком на сходни. — Только у трапа двое стражников стоят, здоровенные как быки.'
        *pl 'Ты вглядываешься в темноту: наёмники переговариваются вполголоса, положив ладони на рукояти коротких абордажных тесаков. В лоб не пройти.'
        *pl '— Жди здесь, Стефан, — подмигивает Лизетта с хитрой улыбкой. — Я их сейчас так закручу, что они родную мать забудут. А ты дуй на палубу!'

    elseif $TextKey = 'distract':
        *pl 'Лизетта одёргивает подол короткой юбки, распускает завязки на корсаже и выходит в круг света от фонаря.'
        *pl 'Она идёт не спеша, покачивая округлыми бёдрами и заглядывая за каждую бочку, нарочно наклоняясь так, чтобы вырез платья щедро открывал упругую грудь.'
        *pl '— Ой, господа хорошие! — звенит её тонкий жалобный голосок. — Вы тут моего котика не видали? Маленький такой, пушистый, мяукает... Я его кличу-кличу, а он прямо к вашим сходням метнулся!'
        *pl 'Стражники замирают. Один из них сально скалится, оглядывая смуглые ножки девушки:'
        *pl '— Котика, говоришь? Да тут полно всякого зверья водится, цыпочка. Пойдём за ящики, посветим фонарём — мигом твоего котика отыщем.'
        *pl 'Они берут Лизетту под локотки и уводят за штабель тюков. Проход к сходням свободен. Ты бесшумно взбегаешь по трапу на борт.'

    elseif $TextKey = 'deck_clues':
        *pl 'Ты замираешь на пустой палубе, прислушиваясь к скрипу канатов и плеску волн за кормой. Нужно быстро найти настоящую накладную.'
        *pl ' '

        if LegareDocLocation = 1:
            *pl '<i>Взгляд цепляется за люк главного трюма: крышка приоткрыта, а на ступеньках трапа блестят свежие следы смолы и портовой грязи от сапог приказчика.</i>'
        elseif LegareDocLocation = 2:
            *pl '<i>В иллюминаторе капитанской каюты теплится слабый огонёк свечи: за мутным стеклом виден стол, заваленный бумагами и сургучными печатями.</i>'
        else:
            *pl '<i>Из приоткрытой двери матросского кубрика доносится богатырский пьяный храп: там на столе брошена связка ключей и кожаная сумка.</i>'
        end

    elseif $TextKey = 'found_doc':
        *pl 'Ты переворачиваешь бумаги и замираешь: под слоем ветоши лежит плотный лист гербового столичного пергамента с тёмно-красной сургучной печатью.'
        *pl 'Это подлинная грузовая накладная. В ней чёрным по белому прописаны партии отборного вина под видом дешёвого уксуса и личный вензель Альбера Легаре.'
        *pl 'Ты прячешь пергамент за пазуху: теперь у тебя есть железная улика против купца. Пора уходить.'

    elseif $TextKey = 'empty_search':
        *pl 'Ты торопливо обыскиваешь углы, сундуки и полки, но находишь лишь старую ветошь, пустые бутылки и обрывки канатов.'
        *pl 'Накладной здесь нет. Время уходит, нужно проверить другое место!'

    elseif $TextKey = 'lookout_tier1':
        *pl 'Ты выглядываешь из-за фальшборта к сходням.'
        *pl 'За ящиками стоит Лизетта между двух стражников. Наёмники уже вовсю лапают девушку: один засунул широкие ладони под короткую юбку, второй прижал ладонь к её обнажённой груди.'
        *pl 'Лизетта кокетливо извивается, тянет время и бросает быстрый тревожный взгляд в сторону трапа.'

    elseif $TextKey = 'lookout_tier2':
        *pl 'Ты выглядываешь за борт. Поиски затянулись, и охранники перешли к делу.'
        *pl 'Лизетта стоит на коленях на досках причала. Один наёмник распустил штаны и держит её за кудри, пока девушка ласкает его уд ртом. Второй стоит рядом, довольно похохатывая, пока её пальцы сжимают его стержень.'
        *pl 'Лизетта усердно работает губами, но в глазах мелькает напряжение: она ждёт сигнала.'

    elseif $TextKey = 'lookout_tier3':
        *pl 'Ты подбираешься к сходням. Поиски заняли слишком много времени.'
        *pl 'Охранники зажали Лизетту у бочек вдвоём: один крепко держит её за бёдра, входя сзади в узкое лоно, а второй жадно насаживает её рот. Девушка стонет сквозь кляп из плоти, принимая двойную близость.'
        *pl 'Она едва сдерживает стоны, изо всех сил стараясь ускорить финал обоих громил.'

    elseif $TextKey = 'escape_1':
        *pl 'Ты издаёшь негромкое, протяжное мяуканье из тени трапа.'
        *pl 'Лизетта мгновенно вздрагивает, ловко выворачивается из-под лап стражников и звонко вскрикивает:'
        *pl '— Ой, слышу! Вон он, мой котик, в кустах! Спасибо, мужики!'
        *pl 'Пока наёмники ошалело хлопают глазами, девушка стрелой несётся к пакгаузам и ныряет к тебе за штабель ящиков.'
        *pl 'Она тяжело дышит, поправляя сбившийся лиф, и слегка надувает губки:'
        *pl '— Ты чего так долго копался, Стефан?! Они меня чуть до нитки не раздели!'
        *pl '— Зато бумаги у нас, — ты показываешь край пергамента. — Ты держалась молодцом. В качестве извинений завтра же свожу тебя к Ирме — выберешь любое бельё, я оплачу.'
        *pl 'Глаза Лизетты загораются восторгом:'
        *pl '— К Ирме?! Ловлю на слове, хозяин!'

    elseif $TextKey = 'escape_2':
        *pl 'Ты подаёшь условный знак — громкое мяуканье разносится над причалом.'
        *pl 'Лизетта ускоряет движения губ и пальцев, заставляя обоих стражников захрипеть от накатившего финала. Они один за другим изливаются ей в рот.'
        *pl 'Проглотив густую влагу и утерев губы тыльной стороной ладони, Лизетта вскакивает на ноги:'
        *pl '— Котик нашёлся! Бегу-бегу!'
        *pl 'Через минуту она уже за ящиками рядом с тобой, тяжело переводя дыхание:'
        *pl '— Ну ты и соня, Стефан! Мне им отсосать пришлось, чтобы они меня на части не разорвали!'
        *pl '— Прости, пришлось повозиться, — виновато отвечаешь ты. — Но всё вышло! Завтра веду тебя к портнихе Ирме. Выбирай самое лучшее бельё, всё оплачу.'
        *pl 'Лизетта смеётся, смахивая растрепавшийся локон со смуглого лба:'
        *pl '— Ладно, не в первый раз. Но от Ирмы ты теперь точно не отвертишься!'

    elseif $TextKey = 'escape_3':
        *pl 'Ты подаёшь условный сигнал.'
        *pl 'Услышав зов, Лизетта изгибается всем телом и с удвоенной силой двигает бёдрами и губами. Оба наёмника со стоном сжимают её и кончают одновременно — один вглубь лона, второй ей в рот.'
        *pl 'Лизетта жадно глотает семя, вырывается из ослабевших рук и на ходу одёргивает платье, устремляясь в тень складов.'
        *pl 'Она падает к тебе на грудь, взмыленная и горячая, с искренней обидой в голосе:'
        *pl '— Ты там что, уснул?! Мне и в рот напихали, и в писю кончили по самые гланды!'
        *pl 'Ты крепко прижимаешь девушку к себе, чувствуя её частый пульс:'
        *pl '— Прости, Лизетта. Ты спасла всё дело. Завтра же идём к Ирме — куплю самые роскошные прозрачные трусики, какие только есть в лавке!'
        *pl 'Она переводит дух и с улыбкой утыкается тебе в ключицу:'
        *pl '— Вот за это я тебя и люблю, Стефан... За слова отвечать надо.'

    elseif $TextKey = 'after_blowjob':
        *pl 'Лизетта опускает взгляд и замечает бугор на твоих штанах. Её пухлые губы расплываются в озорной улыбке:'
        *pl '— Ого... А ты, я погляжу, времени зря не терял, пока за мной подглядывал.'
        *pl 'Она опускается на колени прямо перед тобой в темноте за ящиками:'
        *pl '— Раз уж ты ведёшь меня к Ирме за подарком, я просто обязана тебе помочь.'
        *pl 'Ловкие пальчики расстёгивают твой пояс и извлекают пульсирующий уд. Лизетта обхватывает стержень тёплыми влажными губами, лаская головку языком.'
        *pl 'Её движения жадные, ритмичные и страстные. Через пару минут накатывает сладкая волна: ты выплёскиваешь горячее семя ей прямо в рот. Лизетта аккуратно всё проглатывает и довольно облизывается.'
        *pl '— Теперь точно квиты. До завтра, Стефан! Буду ждать у Ирмы!'

    end

    killvar '$TextKey'
---
