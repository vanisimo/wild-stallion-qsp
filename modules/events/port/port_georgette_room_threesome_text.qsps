#PortGeorgetteRoomThreesomePrintText
$TextKey = LCASE(TRIM($ARGS[0]))

if $TextKey = 'invite':
    *pl 'Ты подходишь к закутку, где мать и дочь укрываются от лишних взглядов, и выкладываешь на доску тридцать звонких спринтриев.'
    *pl '— Девочки, а не повеселиться нам всем вместе? — говоришь ты прямо. — А то всегда выбирать надо.'
    *pl 'Жоржетта сгребает монеты в ладонь, пересчитывает их и с лёгким прищуром смотрит тебе в глаза:'
    *pl '— Плата хорошая. Но на улице будет не очень удобно. Ладно, для тебя сделаем исключение — заслужил. Пошли, покажем тебе наше убежище.'
    *pl 'Лизетта радостно хлопает в ладоши и прижимается к твоему плечу:'
    *pl '— Ой, как хорошо! Пошли, дома на кровати — у меня такое нечасто.'

elseif $TextKey = 'intro_warmup':
    *pl 'Вы поднимаетесь по лестнице на второй этаж дома. Жоржетта запирает засов и зажигает лампу.'
    *pl 'Широкая постель застелена плотным одеялом с горой подушек. Лизетта стягивает короткую юбку и остаётся нагой, садясь на край кровати.'
    *pl '— Ну что, доверенный клиент, садись посередине, — с усмешкой командует Жоржетта, распуская завязки на пышном лифе. — Посмотрим, хватит ли у тебя пыла на нас двоих.'
    *pl 'Девушки усаживаются по обе стороны от тебя. Жоржетта берёт инициативу: её тёплые пальцы ложатся на твоё бедро, а губы уверенно скользят по члену. Лизетта смеётся, подаётся ближе и подключается с другой стороны, лаская тебя озорным язычком.'
    *pl 'Обе женщины работают в лад, разогревая и обильно покрывая твой член слюной. Горячее дыхание матери и дочери обжигает кожу.'

elseif $TextKey = 'scissors':
    *pl 'Жоржетта мягко тянет тебя за руку, увлекая на середину широкого ложа.'
    *pl '— Ложись, Стефан, — командует Жоржетта. — Лиза, покажем трактирщику нашу позу.'
    *pl 'Они сплетают свои ноги над тобой, прижав твой член своими кисками. Тёплые, влажные лона смыкаются в одну пульсирующую линию.'
    *pl 'Ты откидываешься назад, смотря, как девушки направляют смазанный хуй прямо в тесный стык двух раскрытых кисок. Двойная волна жара охватывает член с первых же толчков: Жоржетта стонет глубоко и грудно, а Лизетта закусывает губу, вцепившись пальцами в одеяло.'
    *pl 'Девушки двигаются размеренно, позволяя тебе чувствовать, как влажные лепестки матери и дочери одновременно сжимают твой стержень.'

elseif $TextKey = 'finish_scissors':
    *pl 'Напряжение внизу живота достигает предела. Чувствуя приближение кульминации, ты подаёшься вперёд с мощным толчком и шумно кончаешь.'
    *pl 'Обе шлюшки синхронно подаются вперёд, прижимаясь к тебе в экстазе. Ты изливаешься прямо на их сомкнутые пиздёнки густыми белыми струями семени.'
    *pl 'Жоржетта с довольной улыбкой собирает горячую влагу ладонью и отправляет пальцы в рот, довольно щурясь:'
    *pl '— Славный урожай, Стефан. Густое, крепкое.'
    *pl 'Лизетта смеётся, подставляет свои ладошки и охотно слизывает капли с пальцев матери.'

elseif $TextKey = 'rear_setup':
    *pl 'Ты перехватываешь инициативу и помогаешь женщинам подняться на колени.'
    *pl '— Обе на четвереньки, — приказываешь ты с хрипотцой.'
    *pl 'Жоржетта и Лизетта без лишних слов встают рядом на мягком ложе, прогнув поясницы и выставив округлые аппетитные бёдра.'
    *pl 'Перед тобой колышутся две манящие попки: пышные зрелые формы Жоржетты и гладкие упругие бёдра смуглой Лизетты. Обе куртизанки оглядываются через плечо, ожидая, с кого ты начнёшь.'

elseif $TextKey = 'rear_georg':
    if ThreesomeRearSwaps = 0:
        *pl 'Ты встаёшь позади старшей женщины, плотно прижавшись к её широким ягодицам.'
        *pl 'Ты входишь в узкое тугое колечко Жоржетты. Зрелая куртизанка стонет от наслаждения и сама подаётся назад, принимая на всю длину:'
        *pl '— Ох, червец... будто орк присунул!'
        *pl 'Обильно смочив пальцы, свободной рукой ты тянешься к Лизетте, погружая влажные пальцы в её попку. Девушка виляет бёдрами в такт твоим толчкам в зад матери, постанывая от удовольствия.'
    elseif ThreesomeRearSwaps = 1:
        *pl 'Ты плавно выскальзываешь из Лизетты и переходишь к её матери. Жоржетта с готовностью подаётся назад, с жадным стоном принимая горячий стержень:'
        *pl '— Ох, червец... до самых печёнок!'
        *pl 'Ты мощно вбиваешься в зрелый зад Жоржетты, пока Лизетта с довольной улыбкой прижимается сбоку, поглаживая бёдра матери и помогая держать ритм.'
    end

elseif $TextKey = 'rear_liz':
    if ThreesomeRearSwaps = 0:
        *pl 'Ты встаёшь позади юной мулатки, обхватив ладонями её упругие бёдра. Лизетта оглядывается через плечо, затаив дыхание.'
        *pl 'Ты аккуратно направляешь смазанную головку к её аккуратному девичьему анусу. Мышцы девушки напрягаются, принимая непривычный объём. Лизетта ахает, крепко зажмурившись, но подаётся назад навстречу твоему давлению.'
        *pl 'Жоржетта тут же придвигается сбоку, гладит дочь по волосам и опускает пальцы к её клитору, помогая расслабиться:'
        *pl '— Дыши ровно, дочка. Принимай до конца.'
        *pl 'Ты плавно двигаешься в узком проходе Лизетты, пока твоя ладонь массирует сочные ягодицы Жоржетты. Девушка стонет всё громче, ловя сладкую волну запретного удовольствия.'
    else:
        *pl 'Ты вынимаешь плоть из Жоржетты и перемещаешься к юной мулатке. Лизетта оглядывается через плечо, сверкая озорными глазами:'
        *pl '— Теперь моя очередь?'
        *pl 'Ты без промедления входишь в её разогретый анус. Лизетта сладко вскрикивает, подаваясь бёдрами навстречу твоим толчкам.'
        *pl 'Жоржетта одобрительно посмеивается, лаская дочку спереди и направляя её движения:'
        *pl '— Вот так, милая... встречай трактирщика.'
    end

elseif $TextKey = 'finish_rear':
    *pl 'Анус сжимает твой член. С мощным рывком ты заходишь до основания и выплёскиваешь всё скопившееся семя глубоко в попку.'
    if ThreesomeTarget = 1:
        *pl 'Жоржетта подо тобой сладостно дрожит в долгом судорожном оргазме. Ты медленно отстраняешься, тяжело дыша.'
        *pl 'Лизетта тут же опускается на колени позади матери: её ловкий язычок просовывается в разскрытый твоим членом анус матери, вылизывая оттуда твою сперму.'
        *pl '- Ням ням вкусняшка, - облизывается она.'
        *pl 'после чего переходит к твоему члену, собирая с него остатки.'
    else:
        *pl 'Лизетта подо тобой сладостно дрожит в долгом судорожном оргазме, вцепившись пальцами в простыню. Ты отстраняешься, с громким "чпок", вытащив член из ануса.'
        *pl 'Жоржетта тут же опускается на колени позади дочери: она приподает губами, к раскрытому анусу Лизы, собирая все что оттуда пролилось после чего переходит к твоему члену, начисто очищая его от остатков.'
        *pl 'По заветам Ильматера, чистота, - важно сказала     она, еще раз нежно поцеловав дочку в раскрытый анус, - ну и после твоего жербца стефанчик,  немного смазать не повредит.'
    end
    *pl 'Жоржетта с удовлетворением оглядывается на тебя:'
    *pl '— Вот это по-нашему... Настоящий праздник для двоих.'

elseif $TextKey = 'finish_facial':
    *pl 'Ты чувствуешь скорое семяизвержение и рывком вынимаешь член. Обе шлюшки поворачиваются к тебе, поднимая сияющие раскрасневшиеся лица.'
    *pl '— Сюда, Стефан! — подбадривает Жоржетта, слегка приоткрывая рот и подмигивая дочке.'
    *pl 'Лизетта высовывает розовый кончик языка. Ты сжимаешь ствол у основания и выпускаешь мощные белые струи, щедро орошая лица обеих.'
    *pl 'Капли стекают по смуглым скулам Лизетты и бархатной коже Жоржетты. Они переглядываются, весело слизывают попавшее на губы семя и, кивнув друг другу, сливаются в поцелуе, сплетая языки и обмениваясь твоей спермой. После чего Лизетта опускается ниже, начисто облизывая всё до последней капли.'
    *pl '— Охуеть, — только и смог сказать ты. — Я сейчас опять кончу от такого зрелища, — вызвав задорный смех красавиц.'


elseif $TextKey = 'leave':
    *pl 'Ты переводишь дыхание, спускаешь ноги с постели и не спеша натягиваешь штаны и рубаху. Тело наполняет приятная, тяжёлая истома.'
    *pl 'Жоржетта накидывает на плечи цветастую шаль и подходит к тебе, пока Лизетта довольно потягивается на мягких простынях.'
    *pl '— Спасибо за щедрость, — негромко говорит Жоржетта, погладив тебя по груди. — Но ты помни наш уговор: в порту никому ни слова.'
    *pl '— Мой рот на замке, — отвечаешь ты.'
    *pl 'Лизетта машет тебе ладошкой из-под лоскутного одеяла:'
    *pl '— Приходи ещё, Стефан! Ты лучший любовник на всём побережье!'
    *pl 'Жоржетта приоткрывает дверь, выпускает тебя на деревянную галерею и тут же щёлкает засовом. Ты спускаешься по лестнице и выходишь на ночную улицу под свежий морской бриз.'

end

killvar '$TextKey'
---
