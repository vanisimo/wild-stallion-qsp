! ================================================
! FILE: modules/events/port/port_georgette_room_threesome_text.qsps
! MODULE: events/port
! ! [AI-WORKED] Текст переработан / дополнен ассистентом 03.11.2026
! Тексты тройничка: Жоржетта и Лизетта в личной комнате
! ================================================

#PortGeorgetteRoomThreesomePrintText
    $TextKey = LCASE(TRIM($ARGS[0]))

    if $TextKey = 'invite':
        *pl 'Ты подходишь к штабелю ящиков, где мать и дочь укрываются от холодного морского ветра. Достав увесистый кошель, ты выкладываешь на шершавую доску тридцать звонких спринтриев.'
        *pl '— Хватит стоять на сквозняке, — говоришь ты прямо. — Идёмте к тебе, Жоржетта. Втроём.'
        *pl 'Жоржетта медленно сгребает монеты в ладонь, оценивающе пересчитывает их и с лёгким прищуром смотрит тебе в глаза:'
        *pl '— Ты ведь знаешь, Стефан, мы с Лизеттой матросов в дом не водим. Для них причалов да пакгаузов хватает. Но для тебя сделаем исключение — заслужил.'
        *pl 'Лизетта радостно хлопает в ладоши и прижимается к твоему плечу:'
        *pl '— Наконец-то! А то у меня уже пальцы на ногах заледенели. Идём скорее, у мамы печка тёплая!'

    elseif $TextKey = 'intro_warmup':
        *pl 'Вы поднимаетесь по скрипучей деревянной лестнице на второй этаж дома над портовыми лавками. Жоржетта запирает массивный дубовый засов, зажигает масляную лампу и сбрасывает на сундук тяжёлый плащ.'
        *pl 'В комнате тепло и сухо. Широкая постель застелена плотным лоскутным одеялом с горой мягких подушек. Лизетта стягивает короткую юбку и остаётся в тонкой сорочке, садясь на край кровати.'
        *pl '— Ну что, хозяин, садись посередине, — с усмешкой командует Жоржетта, распуская завязки на пышном лифе. — Посмотрим, хватит ли у тебя пыла на нас двоих.'
        *pl 'Женщины усаживаются по обе стороны от тебя. Жоржетта берёт инициативу с опытной неспешностью: её тёплые пальцы ложатся на твоё бедро, а губы уверенно оглаживают напряжённую плоть. Лизетта смеётся, подаётся ближе и подключается с другой стороны, лаская тебя озорным язычком.'
        *pl 'Обе женщины работают в лад, разогревая и обильно покрывая твой уд влагой. Горячее дыхание матери и дочери обжигает кожу, подготавливая к долгой близости.'

    elseif $TextKey = 'scissors':
        *pl 'Жоржетта мягко тянет тебя за руку, увлекая на середину широкого ложа.'
        *pl '— Ложись, дочка, валетом ко мне, — командует старшая женщина. — Покажем трактирщику наш столичный приём.'
        *pl 'Они укладываются на постели навстречу друг другу, тесно прижав бёдра и сплетая ноги в позе ножниц. Тёплые, налитые соком лона смыкаются в одну пульсирующую линию.'
        *pl 'Ты опускаешься на колени между их бёдер, направляя смазанный уд прямо в тесный стык двух раскрытых кисок. Двойная волна жара охватывает плоть с первых же толчков: Жоржетта стонет глубоко и грудно, а Лизетта закусывает губу, вцепившись пальцами в лоскутное одеяло.'
        *pl 'Ты двигаешься размеренно, чувствуя, как влажные лепестки матери и дочери одновременно сжимают твой стержень.'

    elseif $TextKey = 'finish_scissors':
        *pl 'Напряжение внизу живота достигает предела. Чувствуя приближение кульминации, ты подаёшься вперёд с мощным толчком и шумно выдыхаешь.'
        *pl 'Обе женщины синхронно подаются навстречу, прижимаясь к тебе в экстазе. Ты изливаешься прямо на их сомкнутые бёдра густыми белыми струями семени.'
        *pl 'Жоржетта с довольной улыбкой собирает горячую влагу ладонью и отправляет пальцы в рот, довольно щурясь:'
        *pl '— Славный урожай, Стефан. Густое, крепкое.'
        *pl 'Лизетта смеётся, подставляет свои ладошки и охотно слизывает сладковатые капли с пальцев матери, счастливо глядя на тебя снизу вверх.'

    elseif $TextKey = 'rear_georg':
        *pl 'Ты перехватываешь инициативу и помогаешь женщинам подняться на колени.'
        *pl '— Обе на четвереньки, — приказываешь ты с хрипотцой.'
        *pl 'Жоржетта и Лизетта без лишних слов встают рядом, прогнув поясницы и выставив округлые аппетитные бёдра. Ты встаёшь позади старшей женщины, плотно прижавшись к её широким ягодицам.'
        *pl 'Обильно смочив пальцы, ты входишь в узкое тугое колечко Жоржетты. Зрелая куртизанка вскрикивает от неожиданности, но тут же шумно выдыхает, упираясь локтями в матрас:'
        *pl '— Ох, червец... Глубже, не жалей!'
        *pl 'Свободной рукой ты тянешься к Лизетте, погружая влажные пальцы в её сочную сочащуюся киску. Девушка виляет бёдрами в такт твоим толчкам в зад матери, постанывая от двойного удовольствия.'

    elseif $TextKey = 'rear_liz':
        *pl 'Ты меняешь положение, смещаясь к юной мулатке. Лизетта оглядывается через плечо, сверкая озорными глазами:'
        *pl '— Теперь моя очередь?'
        *pl 'Ты аккуратно направляешь смазанную головку к её аккуратному девичьему анусу. Мышцы девушки напрягаются, принимая непривычный объём. Лизетта ахает, крепко зажмурившись, но подаётся назад навстречу твоему давлению.'
        *pl 'Жоржетта тут же придвигается сбоку, гладит дочь по волосам и опускает пальцы к её клитору, помогая расслабиться:'
        *pl '— Дыши ровно, дочка. Принимай до конца.'
        *pl 'Ты плавно двигаешься в узком проходе Лизетты, пока твоя ладонь массирует сочные ягодицы Жоржетты. Девушка стонет всё громче, ловя сладкую волну запретного удовольствия.'

    elseif $TextKey = 'finish_rear':
        *pl 'Стенки сжимают твой уд до боли. С мощным рывком ты заходишь до основания и выплёскиваешь всё скопившееся семя глубоко в горячую глубину.'
        *pl 'Женщина подо тобой сладостно дрожит в долгом судорожном оргазме. Ты медленно отстраняешься, тяжело дыша.'
        *pl 'Вторая тут же опускается на колени позади первой: её ловкий язычок тщательно вылизывает потёки белой влаги с бёдер подруги, после чего переходит к твоему уду, начисто очищая его от следов близости.'
        *pl 'Жоржетта с удовлетворением оглядывается на тебя, тяжело переводя дух:'
        *pl '— Вот это по-нашему... Настоящий праздник для двоих.'

    elseif $TextKey = 'finish_facial':
        *pl 'Ты чувствуешь скорое семяизвержение и рывком вынимаешь плоть. Обе женщины послушно поворачиваются к тебе, поднимая сияющие раскрасневшиеся лица.'
        *pl '— Сюда, Стефан! — подбадривает Жоржетта, слегка приоткрывая рот и подмигивая дочке.'
        *pl 'Лизетта высовывает розовый кончик языка, предвкушая финал. Ты сжимаешь стержень у основания и выпускаешь мощные белые струи, щедро орошая щёки, губы и ресницы обеих женщин.'
        *pl 'Капли стекают по смуглым скулам Лизетты и зрелой бархатной коже Жоржетты. Они переглядываются, весело слизывают попавшее на губы семя и одобрительно улыбаются твоему мужскому напору.'

    elseif $TextKey = 'leave':
        *pl 'Ты переводишь дыхание, спускаешь ноги с постели и не спеша натягиваешь штаны и рубаху. Тело наполняет приятная, тяжёлая истома.'
        *pl 'Жоржетта накидывает на плечи цветастую шаль и подходит к тебе, пока Лизетта довольно потягивается на мягких простынях.'
        *pl '— Спасибо за щедрость, хозяин, — негромко говорит Жоржетта, ласково погладив тебя по груди. — Но ты помни наш уговор: в порту никому ни слова. Пусть думают, что мы просто стояли на ветру.'
        *pl '— Мой рот на замке, — отвечаешь ты.'
        *pl 'Лизетта машет тебе ладошкой из-под лоскутного одеяла:'
        *pl '— Приходи ещё, Стефан! Ты лучший любовник на всём побережье!'
        *pl 'Жоржетта приоткрывает дверь, выпускает тебя на деревянную галерею и тут же щёлкает массивным железным засовом. Ты спускаешься по лестнице и выходишь на ночную улицу под свежий морской бриз.'

    end

    killvar '$TextKey'
---
