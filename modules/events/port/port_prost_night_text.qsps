! ================================================
! FILE: modules/events/port/port_prost_night_text.qsps
! MODULE: events/port
! [AI-WORKED] 2026-09-08: canon prose overhaul
! Тексты ночного причала H1
! ================================================

#PortProstNightText
    $PortProstNightTextId = LCASE($ARGS[0])
    $PortProstNightText = ''

    if $PortProstNightTextId = 'intro':
        $PortProstNightText = 'У дальнего пакгауза в дрожащем жёлтом свете масляного фонаря стоят обе портовые красавицы — мать и дочь, яркие, раскованные и манящие на фоне ночной сонной гавани. Ночной ветер доносит запах солёной воды, смолы и пряностей. Тридцатидвухлетняя Жоржетта вальяжно привалилась к просмолённой бочке: золотистые локоны блондинки мягко колышутся, ясные голубые глаза смотрят с ленивой чувственной истомой, а глубокое декольте открывает взору пышную, налитую зрелую грудь. Рядом с ней крутится восемнадцатилетняя Лизетта — юная мулатка с бархатистой смуглой кожей, шапкой тёмных упругих кудрей, аккуратной девичьей грудью в узком корсаже и озорными, сияющими голубыми глазами.'
        $PortProstNightText += '<br><br>Обе девушки встречают вас открытыми, кокетливыми улыбками — здесь нет ни капли стеснения, стыда или притворства. Обе искренне любят своё ремесло, внимание крепких мужчин и звонкие монеты.'
        $PortProstNightText += '<br><br>— Десять спинтарий за ночь, Стефанчик, — с бархатистой усмешкой протягивает Жоржетта, поправляя вырез платья на высокой груди. — Выбирай, к кому душа лежит. Хочешь — мать уважь, хочешь — дочку порадуй. Мы обе толк в ласке знаем, ни та, ни другая в обиде не останется.'
        $PortProstNightText += '<br><br>— Ага, Стефанчик! — задорно подхватывает Лизетта, звонко смеясь и покачивая аппетитными бёдрами. — Мама у нас опытная, горячая львица, а я молодая, гибкая и неутомимая! Выбирай смелее, обид не будет — мы обе за то, чтобы ночь удалась на славу!'

    elseif $PortProstNightTextId = 'no_money':
        $PortProstNightText = 'Жоржетта примечает ваш неловкий жест в сторону пустого пояса и сочувственно цокает языком, покачивая пышными бёдрами, а Лизетта звонко прыскает в кулачок, насмешливо переглядываясь с матерью сияющими голубыми глазами:'
        $PortProstNightText += '<br><br>— Ой, Стефанчик, а в кошельке-то только ветер гуляет! — весело поддразнивает юная мулатка, тряхнув тёмными кудрями. — А мы уж губки раскатали!'
        $PortProstNightText += '<br><br>— Пусто в карманах, Стефан? — Жоржетта разводит руками, не скрывая широкой, добродушной усмешки. — Десять спинтарий на бочку — наш твёрдый уговор. Мы тебя уважаем и ласки не жалеем, но без звонкого серебра даже самым сладким мальчикам у нас ловить нечего. Портовый закон, сам понимаешь. Ступай в трактир, наливай гостям пиво, собирай выручку и приходи обратно. Мы никуда не уплывём — порт большой, а ночь долгая.'
        $PortProstNightText += '<br><br>— Будем ждать с полным кошельком, Стефанчик! — Лизетта посылает вам воздушный поцелуй, озорно подмигивая.'

    elseif $PortProstNightTextId = 'after_georgett':
        $PortProstNightText = 'Жоржетта выходит из густого полумрака за пакгаузом, не торопясь оправляя помятое платье. Её пышная, налитая грудь всё ещё тяжело и сладострастно вздымается под корсажем, золотистые пряди растрепались после жарких объятий, на щеках пылает сочный румянец, а в ясных голубых глазах плавает пьянящая сытая истома от пережитого яркого оргазма. Женщина с наслаждением оглаживает свои аппетитные бёдра, смакуя приятное покалывание в глубине лона.'
        $PortProstNightText += '<br><br>Лизетта, терпеливо дожидавшаяся у штабеля бочек, встречает их широкой, понимающей ухмылкой, окинув обоих лукавым взглядом из-под ресниц:'
        $PortProstNightText += '<br><br>— Ого, мам! По твоему сытому лицу видно, что Стефан времени зря не терял! Неужто наш хозяин трактира тебя так сладко ублажил, что у тебя даже походка ленивая стала?'
        $PortProstNightText += '<br><br>Жоржетта хрипловато и довольно смеётся, шутливо шлёпая дочку ладонью по округлой смуглой попке:'
        $PortProstNightText += '<br><br>— Много ты понимаешь, егоза! Стефан оказался парнем крепким, напористым и страстным — поболе многих хвалёных капитанов в деле смыслит. Уважил меня на славу, до сих пор в теле жар стоит.'
        $PortProstNightText += '<br><br>Она с удовольствием прячет заработанные десять спинтарий поглубже под корсет, подмигивая вам:'
        $PortProstNightText += '<br><br>— Славная вышла ночь, Стефан. Настоящий мужчина. Заходи почаще, для такого гостя у меня всегда найдётся местечко.'
        $PortProstNightText += '<br><br>Лизетта весело поддакивает, сверкая голубыми глазками:'
        $PortProstNightText += '<br><br>— Раз мама так хвалит, в следующий раз обязательно ко мне заглядывай, Стефанчик! Я тебе тоже покажу, как умеют радовать столичные девочки!'

    elseif $PortProstNightTextId = 'after_lizette':
        $PortProstNightText = 'Восемнадцатилетняя Лизетта первой выскальзывает из тёмного тупика за штабелями парусиновых мешков, сияя от чистого, незамутнённого восторга. Юная мулатка быстро оглаживает короткую юбку на стройных смуглых ножках, её аккуратная девичья грудь часто и сладко колышется под расшнурованным воротом платья, а копна тёмных пружинистых кудрей живописно растрепалась по обнажённым плечам. На бархатистой коже блестят бисеринки пота, а в ярких голубых глазах пляшет озорной триумф после мощного девичьего оргазма.'
        $PortProstNightText += '<br><br>— Ох, Стефанчик… — с восхищённым придыханием и звонким смехом шепчет она, поправляя бретельку платья. — А ты куда горячее и напористее, чем кажешься в фартуке за стойкой! Я думала, ты только кружки протирать умеешь, а ты меня так сладко раскачал, что у меня до сих пор колени дрожат! Обожаю, когда парень такой страстный!'
        $PortProstNightText += '<br><br>Ловким, отточенным движением мулатка прячет полученные десять монет за кружевную подвязку чулка на смуглом бедре, довольно похлопав по серебру ладошкой.'
        $PortProstNightText += '<br><br>Жоржетта встречает вас у пузатой бочки, оглядывая обоих ласковым, насмешливо-одобрительным материнским взглядом:'
        $PortProstNightText += '<br><br>— Ну что, дочка, не обидел Стефан мою девочку? По твоей довольной мордашке вижу, что оба получили всё сполна.'
        $PortProstNightText += '<br><br>Лизетта со смехом обнимает мать за плечи, лукаво подмигивая Стефану:'
        $PortProstNightText += '<br><br>— Ни капельки не обидел, мам! Он просто чудо! Пусть обязательно ещё приходит — я ему ещё не все свои секреты показала!'
        $PortProstNightText += '<br><br>Жоржетта одобрительно кивает Стефану: — Молодец, парень. Сразу видно — мужская стать и щедрая рука. Приходи в любую ночь!'

    end

    killvar '$PortProstNightTextId'
---