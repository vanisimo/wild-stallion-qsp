#PortProstNightText
$PortProstNightTextId = LCASE($ARGS[0])

if $PortProstNightTextId = 'intro':
    *pl 'У пакгауза под фонарём стоят Жоржетта и Лизетта. Мать привалилась к бочке, придерживая вырез платья, и с усмешкой смотрит тебе в глаза. Рядом крутится Лизетта: оглаживает тёмные кудри и улыбается тебе.'
    *pl ' '
    *pl 'Обе встречают тебя открыто — в порту не принято прятать ремесло.'
    *pl ' '
    *pl '— Десять спринтриев за ночь, Стефан, — тянет Жоржетта, скрестив руки под грудью. — Выбирай, к кому пойдёшь. Хочешь — меня уважь, хочешь — дочку порадуй. Обе толк в ласке знаем, обиженным не уйдёшь.'
    *pl ' '
    *pl '— Точно, Стефанчик! — подхватывает Лизетта, качнув бёдрами и рассмеявшись. — Мама у нас опытная, а я молодая и быстрая!'

elseif $PortProstNightTextId = 'no_money':
    *pl 'Жоржетта замечает твой взгляд на пустой пояс и цокает языком. Лизетта прыскает в кулак и переглядывается с матерью.'
    *pl ' '
    *pl '— В кошельке пусто, Стефанчик? — смеётся мулатка. — А мы уже приготовились!'
    *pl ' '
    *pl '— Пусто, Стефан? — Жоржетта разводит руками с усмешкой. — Десять спринтриев на бочку — наш уговор. Мы тебя уважаем, но без серебра ловить нечего.'
    *pl ' '
    *pl '— Ждём с монетами, Стефанчик! — Лизетта посылает воздушный поцелуй и подмигивает.'

elseif $PortProstNightTextId = 'after_georgett':
    if SexGirlExhausted = 1 or (SexGirlOrgasmCap > 0 and SexGirlCameInScene >= SexGirlOrgasmCap) or SexGirlCameInScene >= 5:
        *pl 'Жоржетта буквально выползает из-за пакгауза на негнущихся ногах враскоряку. Одной рукой она судорожно держится за стену, другой пытается запахнуть корсаж. Волосы растрёпаны, грудь тяжело вздымается, взгляд затуманен. Она с трудом добирается до бочки и тяжело приваливается к ней, широко расставив колени.'
        *pl ' '
        *pl 'Лизетта смотрит на неё круглыми глазами и прыскает в кулак:'
        *pl ' '
        *pl '— Ого, мам! Ты чего выглядишь как тогда, когда всю команду, включая шкипера, вернувшуюся из полугодового плавания, через себя пропустила?'
        *pl ' '
        *pl 'Жоржетта шумно выдыхает, пытаясь отдышаться:'
        *pl ' '
        *pl '— Угомонись, егоза… Ноги вообще не держат, в глазах круги плавают. Этот чертяка меня так затрахал, живого места не оставил.'
        *pl ' '
        *pl 'Она медленно убирает монеты за корсет и косится на тебя с уважением:'
        *pl ' '
        *pl '— Ну ты силён, Стефан… Отрахал так отрахал. Теперь до утра отлёживаться буду.'
        *pl ' '
        *pl 'Лизетта весело смеётся:'
        *pl ' '
        *pl '— Ничего себе! Я тоже так хочу, в следующий раз меня так!..'

    elseif SexGirlCameInScene >= 1:
        *pl 'Жоржетта выходит из полумрака за пакгаузом, не торопясь оправляя платье. На щеках горит румянец, волосы растрепались, взгляд довольный. Она поправляет корсаж и оглаживает бёдра.'
        *pl ' '
        *pl 'Лизетта у бочек встречает её усмешкой, окидывая обоих взглядом:'
        *pl ' '
        *pl '— По лицу вижу, мам: Стефан зря время не терял. Ублажил тебя трактирщик?'
        *pl ' '
        *pl 'Жоржетта смеётся и хлопает дочку ладонью по бедру:'
        *pl ' '
        *pl '— Стефан — парень крепкий, в деле толк знает. И денег даёт, и про нас не забывает, не только сам спускает.'
        *pl ' '
        *pl 'Она убирает заработанные спринтрии за корсет и подмигивает тебе:'
        *pl ' '
        *pl '— Хорошая вышла ночь, Стефан. Заходи ещё.'
        *pl ' '
        *pl 'Лизетта поддакивает, улыбаясь:'
        *pl ' '
        *pl '— В следующий раз ко мне заглядывай, Стефанчик! Я тоже знаю, чем порадовать!'

    else:
        *pl 'Жоржетта выходит из-за пакгауза свежая и собранная, поправляя платье одним привычным движением. Ни капли усталости на лице, лишь лёгкая усмешка в уголках губ. Она пересчитывает монеты на ладони и прячет их в кармашек.'
        *pl ' '
        *pl 'Лизетта удивлённо приподнимает бровь:'
        *pl ' '
        *pl '— Что-то вы быстро, мам. Неужто трактирщик спешил куда?'
        *pl ' '
        *pl 'Жоржетта посмеивается и пожимает плечами:'
        *pl ' '
        *pl '— Бывает, дочка. Стефан сегодня явно не в форме — пыхтел-старался, да сам спёкся раньше времени. Меня даже разогреть толком не успел.'
        *pl ' '
        *pl 'Она бросает на тебя насмешливый взгляд:'
        *pl ' '
        *pl '— Ничего, Стефан, серебро на бочке есть — а это главное. Портовый уговор выполнен. Отдохни, да приходи снова, когда силы подкопишь!'
        *pl ' '
        *pl 'Лизетта задорно прыскает со смеху:'
        *pl ' '
        *pl '— Не переживай, Стефанчик! В следующий раз ко мне иди — я тебя сама раскачаю, даже стараться не придётся!'
    end

elseif $PortProstNightTextId = 'after_lizette':
    if SexGirlExhausted = 1 or (SexGirlOrgasmCap > 0 and SexGirlCameInScene >= SexGirlOrgasmCap) or SexGirlCameInScene >= 5:
        *pl 'Лизетта еле выбирается из тупика за мешками. Ноги заплетаются, колени подгибаются, и девушка буквально ковыляет враскоряку, хватаясь за парусиновые тюки, чтобы не осесть на настил причала. Платье помято, кудри сбились набок, взгляд ошалелый.'
        *pl ' '
        *pl 'Жоржетта у бочки ахает и всплёскивает руками, глядя на дочку:'
        *pl ' '
        *pl '— Ильматер всеблагой! Дочка, ты чего на негнущихся ногах ковыляешь? Он тебя там укатал совсем?'
        *pl ' '
        *pl 'Лизетта сползает по бочке, тяжело и прерывисто дыша:'
        *pl ' '
        *pl '— Ох, мам… У меня ноги… просто как щупальца кальмара. Стефан как завёлся — и давай меня драть, я со счёта сбилась, сколько раз кончила! До сих пор всё внутри дрожит.'
        *pl ' '
        *pl 'Она с трудом достаёт монеты дрожащей рукой и неловко суёт в кармашек:'
        *pl ' '
        *pl '— Ну ты и здоров, Стефанчик… Но сейчас я даже ноги свести не могу.'
        *pl ' '
        *pl 'Жоржетта одобрительно качает головой и посмеивается:'
        *pl ' '
        *pl '— Вот это нам повезло, что Стефан к нам захаживает! Уважил девку — дырки теперь не закрываются. Приходи ещё, парень, с тобой не соскучишься!'

    elseif SexGirlCameInScene >= 1:
        *pl 'Лизетта первой выскальзывает из тупика за мешками. Она торопливо одёргивает юбку, поправляет ворот платья и смахивает кудри с плеч. На лбу блестит пот, глаза горят от восторга.'
        *pl ' '
        *pl '— Ох, Стефанчик… — выдыхает она со смехом, поправляя бретельку. — Хорошо с тобой, люблю такое: и деньги в кармане, и дырочки довольны! У меня колени до сих пор дрожат.'
        *pl ' '
        *pl 'Одним движением мулатка прячет полученные монеты и хлопает ладонью по ткани.'
        *pl ' '
        *pl 'Жоржетта ждёт у бочки, оглядывая вас с мягкой усмешкой:'
        *pl ' '
        *pl '— Ну что, дочка, удружил Стефан? По виду вижу — оба довольны.'
        *pl ' '
        *pl 'Лизетта со смехом обнимает мать за плечи и подмигивает тебе:'
        *pl ' '
        *pl '— Да он хороший парень, мам! Пусть обязательно приходит снова — я не всё ещё показала!'
        *pl ' '
        *pl 'Жоржетта кивает Стефану:'
        *pl ' '
        *pl '— Молодец, парень. Хватка есть. Приходи в любую ночь.'

    else:
        *pl 'Лизетта выходит из тупика бодрым шагом, словно просто ходила прогуляться за мешки. Одежда в порядке, на лице ни следа румянца — лишь озорная гримаска.'
        *pl ' '
        *pl '— Ну вот и всё, — вздыхает мулатка, поправляя пояс юбки. — А я только во вкус войти хотела. Стефанчик раз-два — и весь запал растерял!'
        *pl ' '
        *pl 'Она со звонким стуком подбрасывает монету на ладони и прячет её в чулок:'
        *pl ' '
        *pl '— Зато десять спринтриев честно заработаны, а это в нашем деле главное!'
        *pl ' '
        *pl 'Жоржетта у бочки весело качает головой, посматривая на тебя, сконфуженного:'
        *pl ' '
        *pl '— Не вешай нос, Стефан! Всякое у мужчин бывает: устал, или не дала девочка какая. Главное — плату отдал сполна.'
        *pl ' '
        *pl 'Лизетта лукаво подмигивает:'
        *pl ' '
        *pl '— Точно, Стефанчик! Отдохни, выспись — и приходи снова. Я терпеливая, в следующий раз подольше тебя помучаю!'
    end

end

killvar '$PortProstNightTextId'
