! ================================================
! FILE: modules/events/port/port_night_text.qsps
! MODULE: events/port
! [AI-WORKED] 2026-09-08: canon prose expansion
! Тексты ночного порта (B3 / H на главном экране)
! ================================================

#PortNightText
    $PortNightTextId = LCASE($ARGS[0])
    $PortNightText = ''

    if $PortNightTextId = 'dock_georgett':
        $PortNightText = 'У дальнего пакгауза в неровном свете качающегося фонаря виднеется знакомый силуэт. Жоржетта облокотилась на смолёную бочку, небрежно накинув на плечи тёмную шаль, из-под которой белеет глубокий вырез платья. Она не прячется в тень — лениво разглядывает редких полуночных прохожих и припозднившихся матросов, прекрасно зная, кто заглядывает на причал просто поглазеть, а у кого в кошеле позвякивает серебро. Заметив вас, она усмехается привычно и без капли смущения.'
    elseif $PortNightTextId = 'dock_both':
        $PortNightText = 'У штабеля ящиков стоят обе — мать и дочь, яркие и вызывающие на фоне сырых серых складов. Жоржетта что-то негромко втолковывает Лизетте, оглядывая причалы опытным взглядом бывалой портовой волчицы, а девчонка лишь перебирает цветные бусы на смуглой шее да с лёгкой полуулыбкой ловит порывы солёного ветра, задирающего подол тонкой юбки. Обе чувствуют себя здесь как рыбы в воде — чужой стыд и пересуды благочестивых горожан их нисколько не волнуют.'
    elseif $PortNightTextId = 'dock_lizette':
        $PortNightText = 'Лизетта устроилась возле ящиков со столичным грузом. Смуглая кожа отливает тёплой бронзой в дрожащем пламени фонаря, в тёмных волосах алеет яркая лента, а подол юбки слегка колышет ветер с моря. Она лениво болтает ножкой в такт плеску волн и не сводит с вас лукавого, оценивающего взгляда. Ни тени робости или наивности: девушка прекрасно понимает, зачем мужчины приходят на причал после полуночи, и не прочь подразнить молодого хозяина трактира.'
    elseif $PortNightTextId = 'busy_georgett':
        $PortNightText = 'У дальнего склада пусто — Жоржетты на привычном месте нет. Зато из узкого зазора между сараями доносятся приглушённые звуки: шорох тяжёлой ткани, скрип сырых досок и низкий, сдавленный женский стон, переходящий в довольное хрипловатое контральто. Похоже, кто-то из матросов или ночных гостей уже увлёк её в переулок и монеты пошли в ход. Сквозь щели между бочками пробивается тусклый свет — при желании нетрудно подобраться ближе и взглянуть, как Жоржетта отрабатывает свою плату.'
    elseif $PortNightTextId = 'busy_lizette':
        $PortNightText = 'Лизетты у ящиков не видно, но далеко уйти она не могла. Из тёмного переулка за соляным пакгаузом слышится сбивчивое мужское дыхание, глухой стук о деревянную перегородку и звонкий, сдавленный смешок девчонки, сменяющийся прерывистыми охами. Лизетта явно занята делом в глубине подворотни — кто-то из клиентов зажал молодую смуглянку в темноте. Если подойти бесшумно к углу склада, можно своими глазами увидеть, чем она там занята.'
    end

    killvar '$PortNightTextId'
---