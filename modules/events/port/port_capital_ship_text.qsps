! ================================================
! FILE: modules/events/port/port_capital_ship_text.qsps
! [AI-WORKED] 2026-09-07: rich atmospheric rewrite, suit reaction
! Тексты для корабля из столицы и редких товаров
! Используется логикой:
! modules/events/port/port_capital_ship.qsps
! Основные вызывающие локаторы:
! #PortCapitalShipMenu
! #PortCapitalShipBrowse
! #PortGiftShop
! ================================================

#PortCapitalShipText
    $PortCapitalShipTextId = LCASE($ARGS[0])
    $PortCapitalShipText = ''

    if $PortCapitalShipTextId = 'not_available':
        $PortCapitalShipText = 'У дальнего причала сегодня непривычно просторно. На серой ряби покачиваются лишь просмоленные рыбацкие баркасы да скрипят пустые причальные тумбы. Столичный торговый корабль приходит сюда лишь раз в седмицу — по средам, да и то если шторм в открытом море не задержит его в пути. Портовым грузчикам остаётся лишь сплёвывать в воду и ждать следующего прихода заморских купцов.'

    elseif $PortCapitalShipTextId = 'intro':
        $PortCapitalShipText = 'У дальнего мола пришвартовался трёхмачтовый торговый корабль из столицы. Его высокие борта потемнели от океанской соли, над палубой колышутся убранные паруса, а с борта на пирс перекинуты широкие деревянные сходни. Воздух здесь густой и пряный: пахнет шафраном, корицей, смолой, сухим табаком и далёкими южными морями.'
        $PortCapitalShipText += '<br><br>Прямо на дощатом настиле под полосатыми навесами развернулась бойкая торговля. Вокруг ящиков толпится народ со всего города: лавочники ожесточённо торгуются за тюки сукна, слуги зажиточных господ высматривают заморские вина, а городские девицы заворожённо разглядывают лотки с украшениями.'

        if StefanRespectableSuit = 1:
            $PortCapitalShipText += '<br><br>Купец — кряжистый мужчина в добротном суконном кафтане с медными пуговицами — зорко оглядывает причал и безошибочно вычисляет людей при деньгах. Заметив твой приличный наряд, он расплывается в широкой улыбке и ловко приподнимает край расшитого полотна:'
            $PortCapitalShipText += '<br><br>— Подходи, почтенный хозяин, не стесняйся! — зычно басит торговец, поблескивая перстнями на пальцах. — Столичный товар без обмана! Тончайшие шёлковые ленты, резные костяные гребни, стеклянные бусы с южных островов, серебряные вещицы да шкатулки тонкой работы. Любая красавица от такого подарка растает, только монеты не жалей!'
        else:
            $PortCapitalShipText += '<br><br>Купец — кряжистый мужчина в добротном суконном кафтане с медными пуговицами — лениво скользит по тебе скучающим, равнодушным взглядом. Для него парень в простой одежде — просто ещё один праздный зевака, каких сотни крутятся у причала. Лишь заметив твой пристальный интерес к товару и прислушиваясь к звону монет, он нехотя цедит сквозь зубы:'
            $PortCapitalShipText += '<br><br>— Гляди, парень, руками без толку не лапай. Товар столичный, не для нищих. Но коль серебро в мошне звенит — выбирай. Ленты, гребни, бусины заморские... Деньги на бочку — и забирай любую штуку.'
        end

    elseif $PortCapitalShipTextId = 'browse':
        $PortCapitalShipText = 'Ты неспешно проходишь вдоль разложенных на парусине товаров. Здесь и впрямь есть на что положить глаз: рядом с мешочками редких пряностей переливаются на солнце расписные гребни, тонкие платки, склянки с благовонными маслами и затейливые броши. Такие вещицы в нашем городке на вес золота — ими можно и сестру порадовать, и расположить к себе нужного человека.'

    elseif $PortCapitalShipTextId = 'gift_shop':
        if StefanRespectableSuit = 1:
            $PortCapitalShipText = 'Торговец прищуривается, оценивающе оглядывая твои плечи и приличный наряд:'
            $PortCapitalShipText += '<br><br>— Вижу человека с достатком, — уважительно кивает он, раскладывая товар поудобнее. — Выбирай, хозяин. Есть приятные безделушки попроще — ленты да бусины, а есть и тонкая работа для женщин с запросами. Мой товар краснеть не заставит.'
        else:
            $PortCapitalShipText = 'Торговец равнодушно скользит взглядом по твоей простой одежде, но едва слышит звон монет в твоей руке, как в его глазах вспыхивает деловой огонёк:'
            $PortCapitalShipText += '<br><br>— Раз есть чем платить — выбирай, парень, — хмыкает он, сдвигая в сторону пару тяжёлых тюков. — Товар дорогой, зато столичный. Забирай, что по карману, да не задерживай очередь.'
        end

    else:
        $PortCapitalShipText = 'Шум столичного корабля, крики матросов и пряный дух заморских стран наполняют причал.'
    end

    killvar '$PortCapitalShipTextId'
---
