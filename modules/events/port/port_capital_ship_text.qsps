! ================================================
! FILE: modules/events/port/port_capital_ship_text.qsps
! MODULE: events/port
! [AI-WORKED] Текст переработан / дополнен ассистентом 04.11.2026
! Тексты корабля из столицы и редких товаров
! ================================================

#PortCapitalShipText
$PortCapitalShipTextId = LCASE($ARGS[0])

if $PortCapitalShipTextId = 'not_available':
    *pl 'У дальнего причала сегодня непривычно просторно. На серой ряби покачиваются рыбацкие баркасы да поскрипывают причальные тумбы.'
    *pl ' '
    *pl 'Столичный корабль приходит сюда лишь раз в седмицу — по средам, если шторм не задержит его в море. Грузчикам остаётся сплёвывать в воду и ждать купцов.'

elseif $PortCapitalShipTextId = 'intro':
    *pl 'У дальнего мола пришвартовался торговый корабль из столицы. Борта потемнели от соли, над палубой сохнут паруса, а на пирс сброшены сходни. Матросы с криками крепят канаты к кнехтам, с борта сгружают кованые сундуки и бочки.'
    *pl ' '
    *pl 'Прямо на настиле под навесами идёт бойкая торговля. Вокруг ящиков толпится народ: лавочники торгуются за тюки сукна, слуги господ высматривают вина, а горожанки разглядывают лотки с украшениями.'

    if StefanRespectableSuit = 1:
        *pl ' '
        *pl 'Купец — кряжистый мужчина в суконном кафтане с медными пуговицами — оглядывает причал, безошибочно подмечая людей при деньгах. Заметив твой добротный наряд, он расплывается в улыбке и приподнимает край полотна:'
        *pl ' '
        *pl '— Подходи, почтенный хозяин, не стесняйся! — басит торговец, поблескивая перстнями на пальцах. — Столичный товар без обмана! Шёлковые ленты, костяные гребни, стеклянные бусы с островов, серебро да шкатулки искусной работы. Любая красавица от такого подарка растает, только спринтриев не жалей!'
    else:
        *pl ' '
        *pl 'Купец — кряжистый мужчина в суконном кафтане с медными пуговицами — скользит по тебе равнодушным взглядом. Для него парень в простом платье — лишний зевака у причала. Лишь заметив твой интерес к товару и звон монет на поясе, он нехотя цедит сквозь зубы:'
        *pl ' '
        *pl '— Гляди, парень, руками без толку не лапай. Товар столичный, не для бедняков. Но коль спринтрии в кошеле звенят — выбирай. Ленты, гребни, бусины… Монеты на бочку — и забирай любую штуку.'
    end

elseif $PortCapitalShipTextId = 'browse':
    *pl 'Ты проходишь вдоль разложенных товаров. Взгляд цепляется за диковинки: рядом с мешочками пряностей блестят расписные гребни, шелковые платки, склянки с маслами и серебряные броши.'
    *pl ' '
    *pl 'Такие вещицы в городке на вес золота — ими можно порадовать девушек или расположить к себе нужного человека.'

elseif $PortCapitalShipTextId = 'gift_shop':
    if StefanRespectableSuit = 1:
        *pl 'Торговец прищуривается, оценивая твой добротный наряд:'
        *pl ' '
        *pl '— Вижу человека с достатком, — уважительно кивает он, сдвигая ящики. — Выбирай, хозяин. Есть безделушки попроще — ленты да бусины, а есть вещи для женщин со вкусом. Мой товар краснеть не заставит.'
    else:
        *pl 'Торговец скользит взглядом по твоей одежде, но едва слышит звон монет, как в глазах загорается деловой огонёк:'
        *pl ' '
        *pl '— Раз есть чем платить — выбирай, парень, — хмыкает он, отодвигая тюки. — Товар столичный. Забирай, что по карману, да не держи очередь.'
    end

else:
    *pl 'Шум столичного корабля, скрип снастей и крики матросов заполняют причал.'
end

killvar '$PortCapitalShipTextId'
---
