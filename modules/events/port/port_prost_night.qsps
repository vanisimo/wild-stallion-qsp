! ================================================
! FILE: modules/events/port/port_prost_night.qsps
! MODULE: events/port
! Этап H1 — ночной порт: Жоржетта и Лизетта на причале
! ================================================

#PortProstNightCanEnter

PortProstNightOpen = 0

if LizetteProstPort = 0:
    exit
end

if time <> 5:
    exit
end

if GeorgetteKnown = 0:
    exit
end

if LizetteKnown = 0:
    exit
end

PortProstNightOpen = 1
---

#PortProstNightMenu

gt 'Port'
---

#PortProstNightHire

$PortProstNightReturnLoc = $ARGS[0]
$PortProstNightGirl = LCASE($ARGS[1])

if $PortProstNightReturnLoc = '':
    $PortProstNightReturnLoc = 'Port'
end

if money < 10:
    cls
    gs 'PortProstNightText', 'no_money'
    *pl ' '
    gs 'ActUiPrepare', 'Назад', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
    killvar '$PortProstNightGirl'
    exit
end

money -= 10

if $PortProstNightGirl = 'georgett':
    GeorgettePortSexPaidActive = 1
    PortProstNightSexActive = 1
    IntimStage['georgett'] = 5
    gt 'SexSceneStart', 'georgett', 'PortProstNightAfterGeorg', 'georgett_port_first'
elseif $PortProstNightGirl = 'lizette' and LizetteSexUnlocked = 1:
    PortProstNightSexActive = 1
    IntimStage['lizette'] = 5
    gt 'SexSceneStart', 'lizette', 'PortProstNightAfterLiz', 'normal'
else:
    money += 10
    gt 'Port'
end

killvar '$PortProstNightGirl'
---

#PortProstNightAfterGeorg

*clr
clr
cla

gs 'SceneShowVisual', 'images/events/port/port_prost_night/port_prost_night_after_georg', 'порт: после ночи с Жоржеттой', 'large', 'webp'
GeorgettePortSexPaidActive = 0
PortProstNightSexActive = 0
GeorgettePortNightGone = 1

if GeorgettePortSexDone = 0:
    GeorgettePortSexDone = 1
    gs 'GeorgetteChurchAloneSchedule'
end

gs 'PortProstNightText', 'after_georgett'

Friends['georgett'] += 1
gs 'ClampGirlSocialStats', 'georgett'

*pl ' '

gs 'ActUiPrepare', 'К причалу', 'return'
act $ActUiLabel, $ActUiIconPath:
    gt 'Port'
end
---

#PortProstNightAfterLiz

*clr
clr
cla

gs 'SceneShowVisual', 'images/events/port/port_prost_night/port_prost_night_after_liz', 'порт: после ночи с Лизеттой', 'large', 'webp'
PortProstNightSexActive = 0
LizettePortNightGone = 1

gs 'PortProstNightText', 'after_lizette'

Friends['lizette'] += 1
otkroven['lizette'] += 1
gs 'ClampGirlSocialStats', 'lizette'

*pl ' '

gs 'ActUiPrepare', 'К причалу', 'return'
act $ActUiLabel, $ActUiIconPath:
    gt 'Port'
end
---
