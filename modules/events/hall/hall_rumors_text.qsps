! ================================================
! FILE: modules/events/hall/hall_rumors_text.qsps
! Тексты слухов после событий в зале
! Используется:
! modules/events/hall/hall_rumors.qsps
! ================================================

#HallRumorText
    gs 'NormalizeGirlKey', $ARGS[0]
    $HallRumorTextGirl = $GirlKey
    $HallRumorTextEvent = LCASE($ARGS[1])
    HallRumorTextSeverity = ARGS[2]

    $HallRumorLastText = ''

    if $HallRumorTextGirl = '':
        exit
    end

    if $RealName[$HallRumorTextGirl] = '':
        gs 'EnsureGirlData', $HallRumorTextGirl
    end

    if $HallRumorTextEvent = 'hall_lewd' or $HallRumorTextEvent = 'lewd' or $HallRumorTextEvent = 'kitchen_lewd':
        if $HallRumorTextGirl = 'amanda':
            $HallRumorLastText = 'За соседним столом кто-то уже шепчет про Аманду. Не громко, но мерзко: мол, краснеет — а всё равно остаётся у стола.'
        elseif $HallRumorTextGirl = 'melissa':
            $HallRumorLastText = 'Мелиссу обсуждают иначе: не как жертву, а как ту, что сама знает цену взгляду и монете.'
        elseif $HallRumorTextGirl = 'sandra':
            $HallRumorLastText = 'Про Сандру говорят осторожнее. Вспоминают тяжёлый взгляд и то, как спокойно она выдерживает грязь зала или кухни.'
        else:
            $HallRumorLastText = 'По залу расползается новый грязный слух.'
        end

    elseif $HallRumorTextEvent = 'hall_missing' or $HallRumorTextEvent = 'missing':
        if $HallRumorTextGirl = 'amanda':
            $HallRumorLastText = 'Кто-то замечает, что Аманда снова пропадала из зала. В таких вещах гости всегда находят смысл грязнее правды.'
        elseif $HallRumorTextGirl = 'melissa':
            $HallRumorLastText = 'Исчезновение Мелиссы быстро превращается в шёпот: слишком уверенно она потом возвращается к работе.'
        elseif $HallRumorTextGirl = 'sandra':
            $HallRumorLastText = 'Когда Сандра пропадает, слухи тише, но тяжелее. Люди любят додумывать то, чего не видели.'
        else:
            $HallRumorLastText = 'По залу идёт шёпот: одна из девушек пропадала с глаз.'
        end

    elseif $HallRumorTextEvent = 'harassment' or $HallRumorTextEvent = 'hall_harassment':
        if $HallRumorTextGirl = 'amanda':
            $HallRumorLastText = 'Про Аманду уже бормочут у стойки: к ней полезли — и все смотрели, что сделает хозяин.'
        elseif $HallRumorTextGirl = 'melissa':
            $HallRumorLastText = 'Мелиссу вспоминают с ухмылкой: «Осадила» — или «почти. Главное, хозяин где был».'
        elseif $HallRumorTextGirl = 'sandra':
            $HallRumorLastText = 'Про кухню и Сандру шепчутся с опаской: туда без спроса лучше не соваться — если хозяин не слепой.'
        else:
            $HallRumorLastText = 'В зале обсуждают недавнюю наглость у столов и то, вмешался ли хозяин.'
        end

    elseif $HallRumorTextEvent = 'kitchen' or $HallRumorTextEvent = 'kitchen_customer':
        $HallRumorLastText = 'Кухонная возня тоже становится молвой. Где закрытая дверь — там всегда найдётся грязный язык.'

    else:
        $HallRumorLastText = 'Слухи о трактире становятся громче. Пока шёпот — но в маленьком городе он живёт дольше крика.'
    end

    if HallRumorTextSeverity >= 3:
        $HallRumorLastText += '<br><br>Это уже не мелкая болтовня. Если так пойдёт дальше, церковь или городские сплетники обязательно ухватятся за эту грязь.'
    end

    killvar '$HallRumorTextGirl'
    killvar '$HallRumorTextEvent'
    killvar 'HallRumorTextSeverity'
---
