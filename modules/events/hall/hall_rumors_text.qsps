! ================================================
! FILE: modules/events/hall/hall_rumors_text.qsps
! Тексты слухов после событий в зале
! Используется:
! modules/events/hall/hall_rumors.qsps
! ================================================

#HallRumorText
    gs 'NormalizeGirlKey', $ARGS[0]
    $HallRumorTextGirl = $GirlKey
    $HallRumorTextEvent = LCASE($ARGS[1])
    HallRumorTextSeverity = ARGS[2]

    $HallRumorLastText = ''

    if $HallRumorTextGirl = '':
        exit
    end

    if $RealName[$HallRumorTextGirl] = '':
        gs 'EnsureGirlData', $HallRumorTextGirl
    end

    if $HallRumorTextEvent = 'hall_lewd' or $HallRumorTextEvent = 'lewd' or $HallRumorTextEvent = 'kitchen_lewd':
        if $HallRumorTextGirl = 'amanda':
            $HallRumorLastText = 'За угловым столом пара завсегдатаев уже со смаком перешептывается, похотливо поглядывая на Аманду. Разговор негромкий, но липкий и сальный: мол, девчонка хоть и заливается краской до самых корней волос, а от стола не отходит, позволяя чужим рукам гулять опасно близко к подолу ради звонкой монеты.'
        elseif $HallRumorTextGirl = 'melissa':
            $HallRumorLastText = 'Мелиссу гости обсуждают с совсем иной интонацией — в мужских голосах сквозит язвительное уважение пополам с досадой: эту кудрявую книжницу не назовешь невинной жертвой. Она превосходно знает цену каждому своему насмешливому взгляду и заставляет гостей платить полновесным серебром за каждую иллюзию близости.'
        elseif $HallRumorTextGirl = 'sandra':
            $HallRumorLastText = 'О Сандре в зале говорят приглушенно и осторожно. Мужчины многозначительно хмыкают в кружки с элем, вспоминая её пышную, зрелую стать, тяжелый хозяйский взгляд и то, с каким невозмутимым спокойствием мать семейства гасит любую мужскую дерзость у своей жаркой печи.'
        else:
            $HallRumorLastText = 'По залу тихой змеей расползается свежий двусмысленный слушок, подогревающий нескромный интерес захмелевших посетителей к трактирным порядкам.'
        end

    elseif $HallRumorTextEvent = 'hall_missing' or $HallRumorTextEvent = 'missing':
        if $HallRumorTextGirl = 'amanda':
            $HallRumorLastText = 'Острые языки за дальними скамьями уже подметили, что Аманда надолго пропадала из зала в полумраке подсобки. В досужих трактирных пересудах люди всегда домысливают худшее: гости перемигиваются, гадая, какую именно плату девчонка взяла в темноте за свои ласки, пока в зале ждали заказов.'
        elseif $HallRumorTextGirl = 'melissa':
            $HallRumorLastText = 'Внезапное исчезновение Мелиссы за глухой дверью подсобки мгновенно обрастает едким шепотком: слишком уж гордо и невозмутимо она потом возвращается к своей работе, одергивая фартук с видом человека, провернувшего исключительно выгодную сделку.'
        elseif $HallRumorTextGirl = 'sandra':
            $HallRumorLastText = 'Когда Сандра надолго затихает на кухне вместе с заглянувшим гостем, трактирные слухи звучат глуше, но куда тяжелее. Завсегдатаи с жадным любопытством смакуют мысль о том, какие тайные страсти могут разгораться у пылающего кухонного очага вдали от хозяйских глаз.'
        else:
            $HallRumorLastText = 'Среди столов пробегает приглушенный гомон: завсегдатаи заметили, что одна из девушек надолго исчезала из виду в компании платежеспособного гостя.'
        end

    elseif $HallRumorTextEvent = 'harassment' or $HallRumorTextEvent = 'hall_harassment':
        if $HallRumorTextGirl = 'amanda':
            $HallRumorLastText = 'У стойки негромко судачат о недавней наглости гостей по отношению к Аманде. Весь зал затаил дыхание, наблюдая за тем, встанет ли молодой хозяин на защиту чести своей сестры или предпочтет промолчать ради мира с буйными клиентами.'
        elseif $HallRumorTextGirl = 'melissa':
            $HallRumorLastText = 'Поведение Мелиссы посетители вспоминают с кривыми ухмылками: одни восхищаются тем, как дерзко она осадила неотесанного хама своим острым языком, другие злословят, замечая, что хозяин трактира не слишком-то спешил вмешаться в перепалку.'
        elseif $HallRumorTextGirl = 'sandra':
            $HallRumorLastText = 'О шуме у кухонной двери завсегдатаи шепчутся с опаской: соваться на территорию Сандры без спроса рискованно, но если уж хозяин закрывает глаза на подобные вольности, границы дозволенного в заведении начинают стремительно таять.'
        else:
            $HallRumorLastText = 'В зале вполголоса обсуждают недавнюю дерзкую выходку у столов, прикидывая, насколько тверда рука хозяина трактира и где пролегает предел его терпения.'
        end

    elseif $HallRumorTextEvent = 'kitchen' or $HallRumorTextEvent = 'kitchen_customer':
        $HallRumorLastText = 'Глухая кухонная возня за деревянной перегородкой не укрывается от чутких ушей посетителей. Там, где захлопывается дверь перед носом зала, праздное воображение всегда дорисовывает самые скабрезные картины.'

    else:
        $HallRumorLastText = 'Шепотки и двусмысленные толки о порядках в трактире становятся всё громче. Пока это лишь невнятный гул за пивными кружками, но в тесном городке подобный шепот живет куда дольше любого крика.'
    end

    if HallRumorTextSeverity >= 3:
        $HallRumorLastText += '<br><br>Дело принимает нешуточный оборот — это уже не просто досужая пьяная болтовня. Если подобные кривотолки выплеснутся на рыночную площадь, блюстители нравов из церкви Ильматера непременно ухватятся за эту грязь, и тогда семье не избежать публичного порицания.'
    end

    killvar '$HallRumorTextGirl'
    killvar '$HallRumorTextEvent'
    killvar 'HallRumorTextSeverity'
---
