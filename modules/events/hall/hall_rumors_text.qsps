! ================================================
! FILE: modules/events/hall/hall_rumors_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты слухов после событий в зале
! Используется:
! modules/events/hall/hall_rumors.qsps
! ================================================

#HallRumorText
    gs 'NormalizeGirlKey', $ARGS[0]
    $HallRumorTextGirl = $GirlKey
    $HallRumorTextEvent = LCASE($ARGS[1])
    HallRumorTextSeverity = ARGS[2]

    $HallRumorLastText = ''

    if $HallRumorTextGirl = '':
        exit
    end

    if $RealName[$HallRumorTextGirl] = '':
        gs 'EnsureGirlData', $HallRumorTextGirl
    end

    if $HallRumorTextEvent = 'hall_lewd' or $HallRumorTextEvent = 'lewd' or $HallRumorTextEvent = 'kitchen_lewd':
        if $HallRumorTextGirl = 'amanda':
            $HallRumorLastText = 'За угловым столом пара завсегдатаев уже вовсю перешептывается, посматривая на Аманду. Разговор хмельной и оживленный: девчонка так задорно крутится между столами, стреляя глазками и дразня гостей улыбками, что щедрые медяки так и сыплются ей в фартук. Мужики хвастают друг перед другом, кто сумел заставить её улыбнуться или коснуться края подноса.'
        elseif $HallRumorTextGirl = 'melissa':
            $HallRumorLastText = 'Мелиссу гости обсуждают совсем иначе — с досадой пополам с невольным уважением. Эта кудрявая книжница смотрит на подвыпивших мужиков как на нерадивых школяров, осыпает их ледяной иронией и заставляет раскошеливаться на звонкое серебро ради одного лишь снисходительного кивка, пока сама копит на стопки бумаги и редкие книги.'
        elseif $HallRumorTextGirl = 'sandra':
            $HallRumorLastText = 'О Сандре в зале говорят вполголоса и уважительно. Мужчины хмыкают в кружки с элем, вспоминая её пышную, статную фигуру, тяжелый хозяйский взгляд и то, как спокойно и невозмутимо она ставит на место любого наглеца, решившего сунуться к её жаркой печи.'
        else:
            $HallRumorLastText = 'По залу пробегает свежий слушок, подогревающий нескромный интерес захмелевших посетителей к трактирным порядкам и подавальщицам.'
        end

    elseif $HallRumorTextEvent = 'hall_missing' or $HallRumorTextEvent = 'missing':
        if $HallRumorTextGirl = 'amanda':
            $HallRumorLastText = 'Острые языки за дальними скамьями уже подметили, что Аманда надолго исчезала из зала. Гости перемигиваются и судачат: пока одни дожидались кружек с элем, кто-то щедрый перехватил девчонку в полумраке задних комнат, угощая вином и выкладывая монету за веселое уединение и звонкий смех без посторонних глаз.'
        elseif $HallRumorTextGirl = 'melissa':
            $HallRumorLastText = 'Исчезновение Мелиссы за дверью боковой комнаты мигом обрастает шепотком. Гости усмехаются: эта заносчивая умница возвращается к столам с видом победительницы, невозмутимо поправляя манжеты, словно только что заключила исключительно выгодную сделку и обчистила чужой кошелек до последнего медяка.'
        elseif $HallRumorTextGirl = 'sandra':
            $HallRumorLastText = 'Когда Сандра надолго задерживается у очага в компании гостя, разговор в зале становится приглушенным. Завсегдатаи с хмельным любопытством переглядываются, гадая, какие душевные разговоры или тайные уговоры могут вестись на теплой кухне за закрытыми дверями.'
        else:
            $HallRumorLastText = 'Среди столов пробегает приглушенный гомон: гости подметили, что одна из девушек надолго отлучалась из зала в компании платежеспособного постояльца.'
        end

    elseif $HallRumorTextEvent = 'harassment' or $HallRumorTextEvent = 'hall_harassment':
        if $HallRumorTextGirl = 'amanda':
            $HallRumorLastText = 'У стойки вполголоса судачат о недавней суматохе вокруг Аманды. Гости оживленно обсуждают, как повел себя молодой хозяин: покажет ли Стефан твердую руку и осадит наглецов, или предпочтет не обострять ссору ради звонкой монеты в кассе.'
        elseif $HallRumorTextGirl = 'melissa':
            $HallRumorLastText = 'Стычку у стола с Мелиссой гости вспоминают с усмешками. Одни дивятся тому, как хладнокровно книжница срезала нахала парой язвительных фраз, другие подначивают, гадая, вмешается ли Стефан в следующий раз или позволит девице и дальше воспитывать мужланов собственным языком.'
        elseif $HallRumorTextGirl = 'sandra':
            $HallRumorLastText = 'О шуме возле кухонной двери завсегдатаи говорят с опаской. Соваться в хозяйство Сандры без спроса — верный способ получить ухватом по спине, и мужики прикидывают, насколько строго Стефан следит за порядком у печи.'
        else:
            $HallRumorLastText = 'В зале вполголоса обсуждают недавнюю дерзкую выходку у столов, прикидывая, насколько тверда рука хозяина трактира и где пролегает предел его терпения.'
        end

    elseif $HallRumorTextEvent = 'kitchen' or $HallRumorTextEvent = 'kitchen_customer':
        $HallRumorLastText = 'Глухой шум за кухонной дверью не укрылся от ушей посетителей. Стоит кому-то скрыться за перегородкой, как праздное трактирное воображение тут же начинает дорисовывать самые неожиданные подробности.'

    else:
        $HallRumorLastText = 'Шепотки и пересуды о порядках в заведении становятся оживленнее. Пока это лишь невнятный гомон за пивными кружками, но в небольшом городке подобные разговоры быстро расходятся по улицам.'
    end

    if HallRumorTextSeverity >= 3:
        $HallRumorLastText += '<br><br>Дело принимает нешуточный оборот — это уже не просто хмельная болтовня. Если подобные толки выплеснутся на городскую площадь, строгие ревнители благочестия из церкви Ильматера не упустят случая попенять трактирщику на вольные нравы под его крышей.'
    end

    killvar '$HallRumorTextGirl'
    killvar '$HallRumorTextEvent'
    killvar 'HallRumorTextSeverity'
---
