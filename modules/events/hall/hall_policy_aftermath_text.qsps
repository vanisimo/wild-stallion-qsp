! ================================================
! FILE: modules/events/hall/hall_policy_aftermath_text.qsps
! Текст последствий политики работы девушек
! Используется:
! modules/events/hall/hall_policy_aftermath.qsps
! ================================================

#HallPolicyAftermathText
    $HallPolicyTextGirl = LCASE($ARGS[0])
    $HallPolicyTextEvent = LCASE($ARGS[1])
    $HallPolicyTextResult = LCASE($ARGS[2])
    HallPolicyTextSeverity = ARGS[3]

    $HallPolicyAftermathText = ''

    if HallPolicyTextSeverity <= 0:
        killvar '$HallPolicyTextGirl'
        killvar '$HallPolicyTextEvent'
        killvar '$HallPolicyTextResult'
        killvar 'HallPolicyTextSeverity'
        exit
    end

    if HallPolicyTextSeverity = 1:
        $HallPolicyAftermathText = 'Произошедшее не растворяется бесследно в трактирном гуле. За парой ближайших столиков захмелевшие гости многозначительно переглядываются, обмениваясь быстрыми сальными ухмылками, однако вслух пока никто не решается подать голос, опасаясь строгого хозяйского взгляда.'
    elseif HallPolicyTextSeverity = 2:
        $HallPolicyAftermathText = 'По рядам скамей прокатывается приглушенный, сытый смешок. Кто-то из завсегдатаев уже с жадным упоением шепчет на ухо соседу по лавке, смакуя увиденное и на ходу присочиняя к случившемуся десяток пикантных подробностей.'
    elseif HallPolicyTextSeverity = 3:
        $HallPolicyAftermathText = 'Взгляды захмелевших мужчин в зале заметно меняются, тяжелея от нескромного вожделения. Для одних это просто хмельная забава, но для большинства — недвусмысленный знак: в «Диком Жеребце» привычные рамки приличий дают слабину, и хозяин готов спустить с рук куда больше вольностей, чем прежде.'
    elseif HallPolicyTextSeverity = 4:
        $HallPolicyAftermathText = 'Подобные вольности никогда не задерживаются надолго в четырех стенах заведения. К вечеру пересуды о случившемся разольются по ремесленным лавкам и торговым рядам, а к воскресной службе благочестивые прихожане непременно донесут эту грязную молву до бдительных ушей служителей Ильматера.'
    else:
        $HallPolicyAftermathText = 'Слишком много жадных глаз впивалось в эту сцену, чтобы о ней можно было забыть. Случившееся перешагнуло грань обычной трактирной перепалки — теперь это глубокая, несмываемая отметина на репутации «Дикого Жеребца», которая еще долго будет отзываться эхом в каждом шепотке за дверью.'
    end

    if $HallPolicyTextGirl = 'amanda':
        if HallPolicyTextSeverity >= 3:
            $HallPolicyAftermathText += '<br><br>Аманда всеми силами пытается изобразить беспечность, торопливо протирая пустые кружки, однако пылающие лихорадочным румянцем щеки и нервные, суетливые движения выдают её с головой: девушка прекрасно чувствует, как десятки мужских взглядов раздевают её девичью фигуру сквозь тонкую ткань платья, примеряясь к следующему удобному случаю.'
        end
    elseif $HallPolicyTextGirl = 'melissa':
        if HallPolicyTextSeverity >= 3:
            $HallPolicyAftermathText += '<br><br>Мелисса улавливает перемену в атмосфере зала мгновенно, едва окинув столы своим острым взглядом. В её темных глазах нет и тени девичьего страха — лишь холодный, безошибочный расчет. Если уж неизбежное мужское внимание обрушилось на неё столь откровенно, значит, настало время взять его под контроль и заставить приносить чистую прибыль.'
        end
    elseif $HallPolicyTextGirl = 'sandra':
        if HallPolicyTextSeverity >= 3:
            $HallPolicyAftermathText += '<br><br>Сандра на пороге кухни хранит ледяное молчание, но её тяжелый, налитый свинцом взгляд ранит острее любого попрека. Мать семейства не испытывает робости перед захмелевшей толпой, однако её материнское чутье безошибочно подсказывает: эта скользкая дорожка ведет трактир к настоящей беде, расплачиваться за которую придется их добрым именем.'
        end
    end

    if $HallPolicyAftermathText <> '':
        *pl $HallPolicyAftermathText
    end

    killvar '$HallPolicyTextGirl'
    killvar '$HallPolicyTextEvent'
    killvar '$HallPolicyTextResult'
    killvar '$HallPolicyAftermathText'
    killvar 'HallPolicyTextSeverity'
---
