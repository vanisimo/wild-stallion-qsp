! ================================================
! FILE: modules/events/hall/hall_policy_aftermath_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Текст последствий политики работы девушек
! Используется:
! modules/events/hall/hall_policy_aftermath.qsps
! ================================================

#HallPolicyAftermathText
    $HallPolicyTextGirl = LCASE($ARGS[0])
    $HallPolicyTextEvent = LCASE($ARGS[1])
    $HallPolicyTextResult = LCASE($ARGS[2])
    HallPolicyTextSeverity = ARGS[3]

    $HallPolicyAftermathText = ''

    if HallPolicyTextSeverity <= 0:
        killvar '$HallPolicyTextGirl'
        killvar '$HallPolicyTextEvent'
        killvar '$HallPolicyTextResult'
        killvar 'HallPolicyTextSeverity'
        exit
    end

    if HallPolicyTextSeverity = 1:
        $HallPolicyAftermathText = 'Произошедшее не растворяется бесследно в трактирном гуле. За парой ближайших столиков захмелевшие гости многозначительно переглядываются, обмениваясь быстрыми ухмылками, однако вслух пока никто не решается подать голос, чувствуя твердую хозяйскую руку Стефана.'
    elseif HallPolicyTextSeverity = 2:
        $HallPolicyAftermathText = 'По рядам скамей прокатывается приглушенный, довольный смешок. Кто-то из завсегдатаев уже со смаком пересказывает увиденное соседу по лавке, добавляя к случившемуся пару ярких подробностей.'
    elseif HallPolicyTextSeverity = 3:
        $HallPolicyAftermathText = 'Настроение в зале становится заметно раскованнее, а взгляды гостей — смелее. Публика чувствует, что в «Диком Жеребце» царит вольный, живой дух, где можно позволить себе больше шуток и откровенного веселья, если не скупиться на звонкую монету.'
    elseif HallPolicyTextSeverity = 4:
        $HallPolicyAftermathText = 'Слухи о вольных порядках в трактире быстро перешагивают порог заведения. К вечеру пересуды о бойких подавальщицах докатятся до ремесленных лавок и торговых рядов, а в воскресенье эти разговоры непременно дойдут и до ушей служителей церкви Ильматера.'
    else:
        $HallPolicyAftermathText = 'Случившееся вызвало слишком много шума, чтобы остаться рядовым эпизодом. Слава о раскованном нраве «Дикого Жеребца» разносится по всему городу, привлекая в трактир щедрых любителей ярких развлечений и одновременно приковывая к заведению пристальные взгляды знати.'
    end

    if $HallPolicyTextGirl = 'amanda':
        if HallPolicyTextSeverity >= 3:
            $HallPolicyAftermathText += '<br><br>Аманда старается держаться с непринужденной легкостью, унося пустые кружки. Щёки её горят маковым цветом, но в глазах пляшет озорной азарт: она отлично видит, как жадно гости следят за каждым её шагом и как охотно они теперь лезут в кошельки за чаевыми, стараясь привлечь внимание бойкой подавальщицы.'
        end
    elseif $HallPolicyTextGirl = 'melissa':
        if HallPolicyTextSeverity >= 3:
            $HallPolicyAftermathText += '<br><br>Мелисса мгновенно считывает перемену в настроении зала. В её взгляде нет смущения — лишь прохладный, ироничный расчет книжной зазнайки. Если захмелевшие простофили готовы платить чистое серебро за одно только её насмешливое внимание, значит, пришло время извлечь из их наивной похоти максимальную выгоду на новые книги, чернила и пергамент.'
        end
    elseif $HallPolicyTextGirl = 'sandra':
        if HallPolicyTextSeverity >= 3:
            $HallPolicyAftermathText += '<br><br>Сандра на пороге кухни оглядывает шумный зал с весомой хозяйской строгостью. Она не боится хмельных гуляк, но её практичный ум матери семейства предостерегает: вольная слава манит в трактир полновесную монету, однако за порядком в зале нужно следить в оба глаза, чтобы гульба не переросла в скандал на весь город.'
        end
    end

    if $HallPolicyAftermathText <> '':
        *pl $HallPolicyAftermathText
    end

    killvar '$HallPolicyTextGirl'
    killvar '$HallPolicyTextEvent'
    killvar '$HallPolicyTextResult'
    killvar '$HallPolicyAftermathText'
    killvar 'HallPolicyTextSeverity'
---
