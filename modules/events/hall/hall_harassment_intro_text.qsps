#HallHarassmentIntroFormTag
    if GirlUniformLevel[$HallHarassGirl] <> 1:
        exit
    end
    if HarassTier < 2:
        exit
    end

    ! Ситуация 2 (лестница): короткий подол открывает вид снизу
