! ---------- HALL T1 ----------

#HallHarassmentIntroT1
    if HallHarassType = 1:
        if $HallHarassGirl = 'amanda':
            *pl 'Аманда подходит принять заказ, и подвыпивший гость ловит её за запястье. Пальцы грубые, хватка липкая.'
            *pl 'Она краснеет до ушей, дёргает руку и тихо, почти срывающимся голосом: «Отпустите… мне нужно работать.»'
        elseif $HallHarassGirl = 'melissa':
            *pl 'Мелисса ставит кружки на стол. Гость перехватывает её руку, будто имеет право.'
            *pl 'Она смотрит на пальцы, потом ему в глаза — холодно: «Руку. Сейчас. Или я помогу.»'
        else:
            *pl $RealName[$HallHarassGirl] + ' принимает заказ, и гость слишком надолго держит её запястье.'
            *pl 'Она выпрямляется и смотрит так, что соседний стол притихает: «Отпусти.»'
        end
    elseif HallHarassType = 2:
        if $HallHarassGirl = 'amanda':
            *pl 'Когда Аманда наклоняется к лавке, ладонь гостя ложится ей на талию — не «случайно», а уверенно.'
            *pl 'Она вздрагивает, прижимает поднос к груди и оглядывается на зал: «Что… что вы делаете?»'
        elseif $HallHarassGirl = 'melissa':
            *pl 'Гость кладёт руку Мелиссе на талию, будто проводит её к месту. Улыбка у него широкая, глупая.'
            *pl 'Она снимает ладонь двумя пальцами, как грязь: «Дальше — только заказ. Понял?»'
        else:
            *pl 'Рука на талии ' + $RealName[$HallHarassGirl] + ' выглядит слишком домашней для чужого стола.'
            *pl 'Она медленно выпрямляется. «Руки при себе. Я не твоя жена.»'
        end
    elseif HallHarassType = 3:
        if $HallHarassGirl = 'amanda':
            *pl 'За шумным столом взгляды липнут к Аманде, когда она проходит с кувшином. Кто-то низко свистит, кто-то оценивает бёдра вслух.'
            *pl 'Она сжимает кувшин крепче, краснеет и ускоряет шаг — но уши горят: всё слышно.'
        elseif $HallHarassGirl = 'melissa':
            *pl 'Компания встречает Мелиссу грязной «оценкой» — вырез, походка, всё по пунктам.'
            *pl 'Она улыбается краешком губ, и в улыбке нож: «Заказывайте ртом. Руками — кружку.»'
        else:
            *pl 'Грязный взгляд и шёпот провожают ' + $RealName[$HallHarassGirl] + ' между лавками.'
            *pl 'Она не краснеет. Только оборачивается так, что шутник давится собственной шуткой.'
        end
    else:
        if $HallHarassGirl = 'amanda':
            *pl 'Аманда протискивается между лавками — и резкий щипок в бок заставляет её вскрикнуть.'
            *pl 'Поднос дрожит. «Ай!.. Прекратите!» — голос тонкий, щёки пылают.'
        elseif $HallHarassGirl = 'melissa':
            *pl 'Щипок в бок Мелисса ловит на проходе. Не взвизгивает — оборачивается мгновенно.'
            *pl '«Ещё раз — и кружка будет у тебя на лбу. Заказывай.»'
        else:
            *pl 'Гость щиплет ' + $RealName[$HallHarassGirl] + ' за бок, как на ярмарке.'
            *pl 'Она останавливается. Тяжёлый выдох. «Ещё палец — и пожалеешь.»'
        end
    end
