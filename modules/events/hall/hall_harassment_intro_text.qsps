! ---------- HALL T3 ----------

#HallHarassmentIntroT3
    if HallHarassType = 1:
        if $HallHarassGirl = 'melissa':
            *pl 'Мужик задирает Мелиссе юбку у всех на виду. Вокруг гогочут.'
            *pl 'Она одёргивает ткань и резко развернувшись: «Что нравится вид..., смотри глаза не потеряй».'
        else:
            *pl 'У дальнего стола мужик резко задирает Аманде юбку, хватая за бедро.'
            *pl 'Она вскрикивает, ловит подол и укоризнено говорит: «Ну то отличается от вида под юбкой вашей жены?»'
        end
    elseif HallHarassType = 2:
        if $HallHarassGirl = 'melissa':
            *pl 'Мелиссу сахают на колени, пальцы гостя лезут под юбку.'
            *pl 'Она зло коментирует: «Отпусти, или уроню на твоего дружка, кторый упирается мне в попу, кружку кипятка».'
        else:
            *pl 'Мужик с силой дёргает Аманду на колени, юбка задирается сама.'
            *pl 'Она трепыхается, пытаясь вырваться: «Пустите! Под юбки будет ко всяким девкам лезть!»'
        end
    elseif HallHarassType = 3:
        if $HallHarassGirl = 'melissa':
            *pl 'Гость дёргает Мелиссу так, что она на миг валится ему на пах.'
            *pl 'Она сразу вскакивает, глаза сузились: «Вижу по шатру у тебя в штанах тебе понравилось.»'
        else:
            *pl 'Аманда бежит за заказом, и натыкается на одного из посетителей — и падает прямо на пах упавего перед этим клиента.'
            *pl 'Густо краснеет, панически перебирает руками в воздухе и выдает: «А ваш десерт уже подан!»'
        end
    elseif HallHarassType = 4:
        gs 'HallHarassmentIntroT3Wall'
    else:
        gs 'HallHarassmentIntroT3Drop'
    end
