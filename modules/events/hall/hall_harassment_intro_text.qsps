#HallHarassmentPrintArtisticIntro
    if $RealName[$HallHarassGirl] = '':
        if $HallHarassGirl = 'amanda':
            $RealName[$HallHarassGirl] = 'Аманда'
        elseif $HallHarassGirl = 'melissa':
            $RealName[$HallHarassGirl] = 'Мелисса'
        elseif $HallHarassGirl = 'sandra':
            $RealName[$HallHarassGirl] = 'Сандра'
        else:
            $RealName[$HallHarassGirl] = UCASE(MID($HallHarassGirl, 1, 1)) + LCASE(MID($HallHarassGirl, 2))
        end
    end

    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
        gs 'HallHarassmentPrintKitchenArtisticIntro'
    else:
        gs 'HallHarassmentPrintHallArtisticIntro'
    end
