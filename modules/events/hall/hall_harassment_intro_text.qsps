#HallHarassmentIntroT3Drop
    if $HallHarassSubScene = 'drop_cutlery':
        if $HallHarassGirl = 'melissa':
            *pl 'Ложка падает под стол. Мелисса нагибается, и гость тут же лапает её за бедро под юбкой.'
            *pl 'Она хватает ложку и бьёт его по руке: «Ещё раз полезешь — есть будешь без пальцев».'
        else:
            *pl 'Вилка летит под лавку. «Подними, девка», — ржёт мужик. Аманда наклоняется, и он тут же сует руку ей под юбку.'
            *pl 'Она взвизгивает, чуть не ударившись о стол: «Вы нарочно!»'
        end
    elseif $HallHarassSubScene = 'drop_coin':
        gs 'HallHarassmentIntroT3DropCoin'
    else:
        if $HallHarassGirl = 'melissa':
            *pl 'Мужик бросает монету под стол. Мелисса наклоняется, и его рука ложится ей на задницу.'
            *pl 'Она выхватывает деньги и отбивает руку: «Чаевые на стол клади. А лапы к себе прижми».'
        else:
            *pl 'Монета летит под лавку. Аманда лезет за ней, а гость лапает её сзади за попу.'
            *pl 'Она дёргается, ударяясь плечом: «Не трогайте! Я только за монетой!»'
        end
