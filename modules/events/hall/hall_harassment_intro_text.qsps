        if GirlNoPantiesWork[$HallHarassGirl] = 1:
            *pl 'Глубокий наклон над дубовой столешницей превращает короткую форму в чистое откровение: подол задирается до самой поясницы, выставляя на обозрение всего зала сочные обнажённые ягодицы и соблазнительные очертания девичьей пещерки — розовеющую складочку между бёдер.'
        else
            *pl 'При наклоне над столом короткий подол задорно вздергивается, натягивая ткань тонкого белья на аппетитных девичьих полупопиях и дразня соседние столы белизной гладких бёдер.'
        end
        exit
    end

    ! Ситуация 4 (узкий проход / колени)
    if HallHarassType = 4:
        if GirlNoPantiesWork[$HallHarassGirl] = 1:
            *pl 'Оказавшись на чужих коленях, короткое форменное платьице задирается до самого паха. Мужская ладонь ложится прямо на голую, горячую кожу бедра, а пальцы нагло скользят в считанных дюймах от незащищенной, трепетной пещерки.'
        else
            *pl 'Короткий подол платья сбивается на чужих коленях высоко к поясу, обнажая гладкие бедра и край натянутого белья под жадными взглядами собутыльников.'
        end
        exit
    end

    ! Ситуация 1 (поднос): наклон и декольте
    if HallHarassType = 1 and HarassTier >= 2:
        if $HallHarassGirl = 'amanda':
            if GirlNoPantiesWork['amanda'] = 1:
                *pl 'Откровенный фасон платья без белья делает прикосновение к бедру особенно дерзким: пальцы гостя сразу ощущают шелковистую наготу кожи, а в вырезе корсажа колышется маленькая аккуратная грудь, сквозь тонкую ткань которой вызывающе проступают затвердевшие соски.'
            else
                *pl 'Короткий форменный подол при каждом шаге и наклоне с подносом колышется, а на маленькой девичьей груди Аманды сквозь ткань платья отчетливо проступают напряжённые сосочки, приковывая жадные взгляды всего трактира.'
            end
        else
            if GirlNoPantiesWork['melissa'] = 1:
                *pl 'Откровенный фасон без белья приоткрывает бедра, а изящная девичья грудь волнуется при дыхании: от духоты и возбуждения ее аккуратные соски наливаются и отчетливо очерчивают ткань корсажа.'
            else
                *pl 'Короткий форменный подол колышется при ходьбе, а в вырезе платья притягивает взгляд упругая девичья грудь, чьи соски от возбуждения начинают выпирать под тонкой тканью.'
            end
        end
    end
---

#HallHarassmentIntroMixedTail
    ! Девушка не устраивает скандала, тушуется или держит лицо ради порядка в трактире
    if $HallHarassGirl = 'amanda':
        if HallHarassType = 1:
            *pl 'Аманда поспешно отступает на пару шагов, балансируя с подносом. Щёки её пылают маковым цветом, ресницы вздрагивают — она виновато бросает взгляд на стойку, стараясь сделать вид, что ничего не произошло, и спешит дальше к столам.'
        elseif HallHarassType = 2:
            *pl 'Аманда торопливо сбегает по скрипучим ступенькам вниз, судорожно одёргивая подол обеими руками. Поправив выбившиеся локоны, она кусает губу и прячет растерянный взгляд от ухмыляющихся мужиков.'
        elseif HallHarassType = 3:
            *pl 'Выпрямившись у стола, Аманда нервно комкает влажную тряпку в дрожащих пальцах. Её маленькая грудь часто вздымается, напряжённые бугорки сосков очерчивают тонкую ткань платья, а румянец заливает шею до самых ключиц, но устраивать перебранку при гостях она не смеет.'
        else
            *pl 'Освободившись от захвата, Аманда застывает у прохода, потирая алеющие щёки. Она робко улыбается гостям через силу, сглаживая неловкость, и торопливо ускользает в сторону раздачи.'
        end
    elseif $HallHarassGirl = 'melissa':
        if HallHarassType = 1:
            *pl 'Мелисса невозмутимо расставляет кружки на стол, словно ничего не случилось. Лишь чуть сжатые побелевшие пальцы на ручке подноса выдают её скрытое бешенство, но перед залом она безупречно держит лицо.'
        elseif HallHarassType = 2:
            *pl 'Мелисса неторопливо спускается с лестницы с запыленной бутылью в руке. Одарив заглядывавшего под юбку клиента взглядом полнейшего ледяного презрения, она с достоинством направляется к стойке.'
        elseif HallHarassType = 3:
            *pl 'Мелисса спокойно бросает тряпку в ведро и расправляет воротник. Вздернув аккуратный подбородок, она холодно роняет: «Надеюсь, на этом проверка прочности мебели завершена». Зал понимающе умолкает.'
        else
            *pl 'Мелисса поднимается с лавки неторопливо, с абсолютным спокойствием одёргивая подол. Ни тени смущения — лишь ледяная полуулыбка хозяйки положения, пресекающая любые сальные шуточки.'
        end
    else
        *pl 'Сандра молча и тяжело возвращается к разделке, всем своим видом показывая, что любые поползновения хмельных гостей не стоят даже доброго слова.'
    end
