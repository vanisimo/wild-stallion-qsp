            *pl 'Пальцы давят на бельё между ног. Она перехватывает его руку: «Отойди от двери. Мне за продуктами нужно».'
        end
    elseif $HallHarassSubScene = 'drop_cutlery':
        *pl 'Ложка падает у печи. ' + $HallLewdClientWho + ' просит поднять, и когда Сандра наклоняется, его ладонь ложится ей на попу, жадно сжимая, пальцы уже скользят к промежности.'
        *pl 'Она выпрямляется с прибором в руке: «Ложку держи и иди в зал обедать, не отвлекай».'
    elseif $HallHarassSubScene = 'drop_coin' or HallHarassType = 5:
        gs 'HallHarassmentKitchenIntroDropCoinFloor'
    else
        *pl $HallHarassClient + ' проявляет излишнюю настойчивость на кухне, тяня руки к её талии и попке.'
        *pl 'Сандра спокойно указывает ему на дверь: «Твоё место в зале. Здесь тебе делать нечего».'
    end
---
#HallHarassmentKitchenIntroDropCoinFloor
    *pl $HallLewdClientCoin + ' со звоном катится по полу к печи. Сандра наклоняется за ней — спина прогнута, подол платья ползёт вверх.'
    if GirlNoPantiesWork['sandra'] = 1:
        *pl 'Без белья ' + $HallLewdClientWho + ' накрывает ладонью её голую промежность: пальцы раздвигают складки и гладят влажную щель. Сандра сдерживает короткий выдох.'
        *pl 'Она выпрямляется с серебром в кулаке, лицо строгое: «Лапы убрал. Деньги на стол и марш в зал».'
    elseif GirlUniformLevel['sandra'] = 1:
