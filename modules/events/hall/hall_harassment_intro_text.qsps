#HallHarassmentIntroT3Wall
    if $HallHarassGirl = 'melissa':
        *pl 'Мелиссу прижимают к стене у прохода, рука лезет под юбку.'
        *pl 'Она бьёт его в грудь: «Убрал лапу. Быстро. Или руку сломаю».'
    else:
        *pl 'Мужик вжимает Аманду спиной к стене и лезет рукой под юбку.'
        *pl 'Она бьётся, пытается оттолкнуть его коленом: «Не надо… не трогайте там, пожалуйста!»'
