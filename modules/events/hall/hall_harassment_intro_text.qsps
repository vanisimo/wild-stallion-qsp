#HallHarassmentIntroStanceTag
    ! лёгкий хвост по stance
    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
        if $HarassGirlStance = 'provoke':
            *pl 'Сандра даже шаг назад не делает. Смотрит, будто прикидывает, чем лучше стукнуть.'
        elseif $HarassGirlStance = 'mixed':
            *pl 'Устала и злится. Скрывать это даже не думает, шуточки мимо ушей больше не пропускает.'
        end
    else:
        if $HarassGirlStance = 'provoke':
            if $HallHarassGirl = 'amanda':
                *pl 'Она замирает на миг и смотрит в глаза — испугалась, но взгляд почему-то не отводит.'
            elseif $HallHarassGirl = 'melissa':
                *pl 'Она даже не дёргается. Ждёт секунду, глядя на гостя в упор: мол, давай, додумай сам, куда полез.'
            end
        elseif $HarassGirlStance = 'mixed':
            if $HallHarassGirl = 'amanda':
                *pl 'Краснеет от стыда, но руку убирает как-то медленно, будто ждёт твоей отмашки.'
            elseif $HallHarassGirl = 'melissa':
                *pl 'Возмущена, но не паникует. Терпит чуть долше — и этот миг уже точно не случайность.'
            end
        end
    end
