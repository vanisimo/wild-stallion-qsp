! ================================================
! FILE: modules/events/hall/hall_harassment_intro_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT — художественный текст приставаний в зале и на кухне
! КАНОН v2.2: 4 бытовые ситуации зала (поднос, лестница, стол, проход/колени)
! Сенсорные детали, живые голоса, звуки зала, обращения «ты/вы».
! Анатомические каноны:
!   - Аманда: маленькая аккуратная девичья грудь, бугорки сосков очерчивают ткань платья
!   - Мелисса: упругая девичья грудь, соски возбужденно твердеют
!   - Сандра: роскошная, тяжелая зрелая грудь, налившиеся соски
! Зал: только Аманда / Мелисса. Кухня: только Сандра.
! ================================================

#HallHarassmentPrintArtisticIntro
    if $RealName[$HallHarassGirl] = '':
        if $HallHarassGirl = 'amanda':
            $RealName[$HallHarassGirl] = 'Аманда'
        elseif $HallHarassGirl = 'melissa':
            $RealName[$HallHarassGirl] = 'Мелисса'
        elseif $HallHarassGirl = 'sandra':
            $RealName[$HallHarassGirl] = 'Сандра'
        else
            $RealName[$HallHarassGirl] = UCASE(MID($HallHarassGirl, 1, 1)) + LCASE(MID($HallHarassGirl, 2))
        end
    end
    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
        gs 'HallHarassmentPrintKitchenArtisticIntro'
    else
        gs 'HallHarassmentPrintHallArtisticIntro'
    end
---

#HallHarassmentPrintHallArtisticIntro
    gs 'HallHarassmentIntroClientTag'
    if HarassTier <= 1:
        gs 'HallHarassmentIntroT1'
    elseif HarassTier = 2:
        gs 'HallHarassmentIntroT2'
    else
        gs 'HallHarassmentIntroT3'
    end
    gs 'HallHarassmentIntroStanceTag'
---

#HallHarassmentPrintKitchenArtisticIntro
