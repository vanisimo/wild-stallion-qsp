! ================================================
! Debug-старт: ARGS girl, tier, type [, sub, cock, under_react]
! Пример: gt 'HallHarassmentDebugStart', 'amanda', 3, 5, 'drop_coin', 1, 'flee'
! ================================================

#HallHarassmentDebugStart
    $HallHarassDebugGirl = LCASE($ARGS[0])

    if $HallHarassDebugGirl = '':
        $HallHarassDebugGirl = 'amanda'
    end

    if $HallHarassDebugGirl <> 'amanda' and $HallHarassDebugGirl <> 'melissa' and $HallHarassDebugGirl <> 'sandra':
        $HallHarassDebugGirl = 'amanda'
    end

    HallHarassDebugForce = 1
    HallHarassDebugForceTier = ARGS[1]
    HallHarassDebugForceType = ARGS[2]
    $HallHarassDebugForceSub = LCASE($ARGS[3])
    HallHarassDebugForceCock = ARGS[4]
    $HallHarassDebugForceUnderReact = LCASE($ARGS[5])
    HallHarassDebugForceCockExplicit = 1

    if HallHarassDebugForceTier < 1 or HallHarassDebugForceTier > 3:
        HallHarassDebugForceTier = 2
    end

    if HallHarassDebugForceType < 1:
        HallHarassDebugForceType = 1
    end

    if HallHarassDebugForceTier < 3 and HallHarassDebugForceType > 4:
        HallHarassDebugForceType = 4
    end

    if HallHarassDebugForceTier >= 3 and HallHarassDebugForceType > 5:
        HallHarassDebugForceType = 5
    end

    ! гейты под forced tier + смена
    if LOC('HallHarassmentDebugApplyStaff') = 1:
        gs 'HallHarassmentDebugApplyStaff'
    end

    FamilyLiberationGateOpen = 1
    Act1MoralUnlocked = 1
    FamilyCouncilDone = 1

    if HallHarassDebugForceTier >= 3:
        FamilyCorruptionStage = 3
        sluttiness[$HallHarassDebugGirl] = 45
        GirlUniformLevel[$HallHarassDebugGirl] = 1
        HallHarassEverOccurred = 1
    elseif HallHarassDebugForceTier = 2:
        if FamilyCorruptionStage < 2:
            FamilyCorruptionStage = 2
        end
        if sluttiness[$HallHarassDebugGirl] < 25:
            sluttiness[$HallHarassDebugGirl] = 25
        end
    end

    if HallHarassDebugForceCock = 1:
        HallHarassEverOccurred = 1
        FamilyLiberationGateOpen = 1
        if FamilyCorruptionStage < 3:
            FamilyCorruptionStage = 3
        end
        GirlUniformLevel[$HallHarassDebugGirl] = 1
        if sluttiness[$HallHarassDebugGirl] < 40:
            sluttiness[$HallHarassDebugGirl] = 40
        end
    end

    ! сброс одноразового lock текущего слота
    HallHarassmentDay = 0
    HallHarassmentTime = 0
    HallHarassmentResolved = 0
    HallHarassPolicyChosen = 0
    KitchenHarassmentDay = 0
    KitchenHarassmentTime = 0

    if $HallHarassDebugGirl = 'sandra':
        SparkQueueConsumeKitchen = 1
        $SparkQueueConsumeGirl = 'sandra'
        SparkQueueConsumeHall = 0
        KitchenHarassmentDay = 0
        KitchenHarassmentTime = 0
        gt 'KitchenHarassment', 'Kitchen'
    else:
        SparkQueueConsumeHall = 1
        $SparkQueueConsumeGirl = $HallHarassDebugGirl
        SparkQueueConsumeKitchen = 0
        gt 'HallHarassment', 'TavernMain'
    end
---

#HallHarassmentDebugMenu
    ! полное меню гейтов + force — modules/debug/debug_hall_harassment.qsps
    if LOC('HallHarassmentGateDebugMenu') = 1:
        gt 'HallHarassmentGateDebugMenu'
    end

    *pl 'DEBUG: подключите modules/debug/debug_hall_harassment.qsps'
    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
