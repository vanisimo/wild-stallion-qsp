---

! ================================================
! Setup: AllowedTier / Tier / Type / Sub / Stance / art keys
! A2: T3 types 1-5 (4 wall, 5 drop + under-table cock subroll)
! B1: resist / mixed / provoke
! D1: HarassTier = RAND(1, AllowedTier)
! E2: Tier 3 only if GirlUniformLevel = 1
! F1: stance bands, not fine slut steps
! H: no full art yet — one common stub image
! ================================================

#HallHarassmentSetupScene
    $HallHarassSubScene = ''
    HallHarassUnderTableCock = 0
    $HallHarassUnderReact = ''
    HallHarassTextRoll = 1

    gs 'HallHarassmentCalculateAllowedTier'
    gs 'HallHarassmentPickTier'
    gs 'HallHarassmentPickType'
    gs 'HallHarassmentCalculateStance'
    gs 'HallHarassmentPickUnderTableCock'
    gs 'HallHarassmentApplyDebugForce'
    gs 'HallHarassmentBuildArtKeys'

    HallHarassTextRoll = RAND(1, 3)
---

#HallHarassmentApplyDebugForce
    ! Debug: HallHarassDebugForce=1 + ForceTier/Type/Sub/Cock/React
    if HallHarassDebugForce <> 1:
        exit
    end

    if HallHarassDebugForceTier >= 1 and HallHarassDebugForceTier <= 3:
        HarassTier = HallHarassDebugForceTier
        if HallHarassAllowedTier < HarassTier:
            HallHarassAllowedTier = HarassTier
        end
    end

    if HallHarassDebugForceType >= 1:
        HallHarassType = HallHarassDebugForceType
    end

    if HarassTier >= 3 and HallHarassType = 4:
        $HallHarassSubScene = 'wall'
    elseif HarassTier >= 3 and HallHarassType = 5:
        if $HallHarassDebugForceSub = 'drop_cutlery' or $HallHarassDebugForceSub = 'drop_coin':
            $HallHarassSubScene = $HallHarassDebugForceSub
        elseif $HallHarassSubScene <> 'drop_cutlery' and $HallHarassSubScene <> 'drop_coin':
            $HallHarassSubScene = 'drop_coin'
        end
    elseif HarassTier < 3:
        $HallHarassSubScene = ''
        HallHarassUnderTableCock = 0
        $HallHarassUnderReact = ''
    end

    if $HallHarassSubScene = 'drop_coin' and HallHarassDebugForceCock = 1:
        HallHarassUnderTableCock = 1
        if $HallHarassDebugForceUnderReact = 'flee' or $HallHarassDebugForceUnderReact = 'coin':
            $HallHarassUnderReact = $HallHarassDebugForceUnderReact
        elseif $HallHarassUnderReact <> 'flee' and $HallHarassUnderReact <> 'coin':
            $HallHarassUnderReact = 'flee'
        end
    elseif $HallHarassSubScene = 'drop_coin' and HallHarassDebugForceCock = 0 and HallHarassDebugForce = 1:
        if HallHarassDebugForceCockExplicit = 1:
            HallHarassUnderTableCock = 0
            $HallHarassUnderReact = 'groping'
        end
    end

    ! одноразовый force
    HallHarassDebugForce = 0
    HallHarassDebugForceCockExplicit = 0
---

#HallHarassmentCalculateAllowedTier
    HallHarassAllowedTier = 1

    if FamilyCorruptionStage >= 2 and sluttiness[$HallHarassGirl] >= 20:
        HallHarassAllowedTier = 2
    end

    ! E2: жёсткий тир только в откровенной форме
    if FamilyCorruptionStage >= 3 and sluttiness[$HallHarassGirl] >= 40 and GirlUniformLevel[$HallHarassGirl] = 1:
        HallHarassAllowedTier = 3
    end

    if GirlNoPantiesWork[$HallHarassGirl] = 1 and HallHarassAllowedTier < 3:
        HallHarassAllowedTier += 1
    end

    if GirlUniformLevel[$HallHarassGirl] <> 1 and HallHarassAllowedTier > 2:
        HallHarassAllowedTier = 2
    end

    if HallHarassAllowedTier < 1:
        HallHarassAllowedTier = 1
    end

    if HallHarassAllowedTier > 3:
        HallHarassAllowedTier = 3
    end
---

#HallHarassmentPickTier
    ! D1: равный шанс 1..Allowed
    if HallHarassAllowedTier <= 1:
        HarassTier = 1
    else:
        HarassTier = RAND(1, HallHarassAllowedTier)
    end
---

#HallHarassmentPickType
    ! T1/T2: types 1-4
    ! T3: types 1-5; 1-3 чаще, 4 wall ~19%, 5 drop ~15%
    $HallHarassSubScene = ''
    HallHarassUnderTableCock = 0
    $HallHarassUnderReact = ''

    if HarassTier >= 3:
        HallHarassTypeRoll = RAND(1, 100)

        if HallHarassTypeRoll <= 22:
            HallHarassType = 1
        elseif HallHarassTypeRoll <= 44:
            HallHarassType = 2
        elseif HallHarassTypeRoll <= 66:
            HallHarassType = 3
        elseif HallHarassTypeRoll <= 85:
            HallHarassType = 4
        else:
            HallHarassType = 5
        end

        killvar 'HallHarassTypeRoll'
        gs 'HallHarassmentPickSubScene'
    else:
        HallHarassType = RAND(1, 4)
    end
---

#HallHarassmentPickSubScene
    ! T3 type 4 = wall press; type 5 = drop_cutlery | drop_coin
    $HallHarassSubScene = ''

    if HarassTier < 3:
        exit
    end

    if HallHarassType = 4:
        $HallHarassSubScene = 'wall'
        exit
    end

    if HallHarassType <> 5:
        exit
    end

    if RAND(1, 2) = 1:
        $HallHarassSubScene = 'drop_cutlery'
    else:
        $HallHarassSubScene = 'drop_coin'
    end
---

#HallHarassmentPickUnderTableCock
    ! Член только под столом: drop_coin + гейты. Иначе groping / пусто.
    HallHarassUnderTableCock = 0
    $HallHarassUnderReact = ''

    if $HallHarassSubScene <> 'drop_coin':
        exit
    end

    ! Без гейтов — лапанье / попа под столом, без члена
    $HallHarassUnderReact = 'groping'

    ! low slut + policy «сдержанно» → только лапанье
    if sluttiness[$HallHarassGirl] < 35 and GirlWorkPolicy[$HallHarassGirl] = 1:
        exit
    end

    if FamilyLiberationGateOpen = 0:
        exit
    end

    if FamilyCorruptionStage < 3:
        exit
    end

    ! не на самом первом harass в кампании
    if HallHarassEverOccurred = 0:
        exit
    end

    HallHarassUnderTableCock = 1

    ! реакция harassment only: flee | coin (touch/hold → lewd/missing, не здесь)
    if $HarassGirlStance = 'provoke' or sluttiness[$HallHarassGirl] >= 50:
        $HallHarassUnderReact = 'coin'
    elseif $HarassGirlStance = 'resist' or sluttiness[$HallHarassGirl] < 40:
        $HallHarassUnderReact = 'flee'
    else:
        if RAND(1, 2) = 1:
            $HallHarassUnderReact = 'flee'
        else:
            $HallHarassUnderReact = 'coin'
        end
    end
---

#HallHarassmentCalculateStance
    ! B1 + F1: large bands
    $HarassGirlStance = 'resist'

    if sluttiness[$HallHarassGirl] >= 35 and FamilyCorruptionStage >= 2:
        $HarassGirlStance = 'mixed'
    end

    if sluttiness[$HallHarassGirl] >= 50 and FamilyCorruptionStage >= 3:
        $HarassGirlStance = 'provoke'
    end
---

#HallHarassmentBuildArtKeys
    if GirlUniformLevel[$HallHarassGirl] = 1:
        $HallHarassUniformKey = 'u1'
    else:
        $HallHarassUniformKey = 'u0'
    end

    if GirlNoPantiesWork[$HallHarassGirl] = 1:
        $HallHarassPantyKey = 'nop'
    else:
        $HallHarassPantyKey = 'panties'
    end

    ! Art path: shipped matrix is T1–T2 type1–4 (3/4 alias 1/2). T3 → T2 plate until T3 art exists.
    ! Sub/cock/nop suffixes stay on $HallHarassFutureImagePath for future oneshots only.
    HallHarassArtTier = HarassTier
    if HallHarassArtTier < 1:
        HallHarassArtTier = 1
    end

    if HallHarassArtTier > 2:
        HallHarassArtTier = 2
    end

    HallHarassArtType = HallHarassType
    if HallHarassArtType < 1:
        HallHarassArtType = 1
    end

    if HallHarassArtType > 4:
        HallHarassArtType = 4
    end

    ! Будущий oneshot (полный ключ):
    ! images/events/{girl}/hall_harass/t{tier}_type{n}[_sub][_cock_flee|coin]_{u0|u1}[_nop].webp
    $HallHarassFutureImagePath = 'images/events/' + $HallHarassGirl + '/hall_harass/t' + STR(HarassTier) + '_type' + STR(HallHarassType)

    if $HallHarassSubScene <> '':
        $HallHarassFutureImagePath += '_' + $HallHarassSubScene
    end

    if HallHarassUnderTableCock = 1 and $HallHarassUnderReact <> '':
        $HallHarassFutureImagePath += '_cock_' + $HallHarassUnderReact
    end

    $HallHarassFutureImagePath += '_' + $HallHarassUniformKey

    if $HallHarassPantyKey = 'nop':
        $HallHarassFutureImagePath += '_nop'
    end

    $HallHarassFutureImagePath = $HallHarassFutureImagePath + '.webp'

    $HallHarassStubImagePath = 'images/common/hall_harass_stub.png'

    ! Без FILEEXISTS: art/legacy только для девушек с отгруженной матрицей.
    ! Иначе $HallHarassArtBase всегда непустой → stub/legacy мёртвы (Сандра/кухня = broken img).
    HallHarassHasShippedArt = 0
    $HallHarassArtBase = ''
    $HallHarassLegacyArtBase = ''

    if $HallHarassGirl = 'amanda' or $HallHarassGirl = 'melissa':
        HallHarassHasShippedArt = 1

        ! Shipped art base (no ext): t{1|2}_type{1..4}_{u0|u1}
        $HallHarassArtBase = 'images/events/' + $HallHarassGirl + '/hall_harass/t' + STR(HallHarassArtTier) + '_type' + STR(HallHarassArtType) + '_' + $HallHarassUniformKey

        ! legacy: waitress_{1|2}_base.webp — type>2 maps to 1/2
        HallHarassLegacyType = HallHarassArtType
        if HallHarassLegacyType > 2:
            HallHarassLegacyType = HallHarassLegacyType - 2
        end

        if HallHarassLegacyType < 1:
            HallHarassLegacyType = 1
        end

        if HallHarassLegacyType > 2:
            HallHarassLegacyType = 2
        end

        $HallHarassLegacyArtBase = 'images/events/' + $HallHarassGirl + '/hall_harass/waitress_' + STR(HallHarassLegacyType) + '_base'
    end
---

#HallHarassmentPrintServiceIntro
    *pl '─── СЛУЖЕБНО: ПРИСТАВАНИЕ (заглушка) ───'
    *pl 'Девушка: ' + $RealName[$HallHarassGirl] + ' (' + $HallHarassGirl + ')'
    *pl 'Зона: ' + $HallHarassConsequenceArea + ' / job: ' + $HallHarassJob
    *pl 'AllowedTier: ' + STR(HallHarassAllowedTier) + ' → HarassTier: ' + STR(HarassTier) + ' / type: ' + STR(HallHarassType)

    if $HallHarassSubScene <> '':
        *pl 'SubScene: ' + $HallHarassSubScene
    end

    if $HallHarassSubScene = 'drop_coin':
        if HallHarassUnderTableCock = 1:
            *pl 'Under-table: cock + react=' + $HallHarassUnderReact + ' (flee|coin; touch/hold не harass)'
        else:
            *pl 'Under-table: groping only (без члена; react=' + $HallHarassUnderReact + ')'
        end
    end

    *pl 'Stance: ' + $HarassGirlStance + ' | uniform: ' + $HallHarassUniformKey + ' | panty: ' + $HallHarassPantyKey
    *pl 'stage=' + STR(FamilyCorruptionStage) + ' slut=' + STR(sluttiness[$HallHarassGirl]) + ' policy=' + STR(GirlWorkPolicy[$HallHarassGirl])
    gs 'HallHarassmentPrintTypeStubLine'
    *pl 'Художественный текст: пока stub-строка. Меню реакции — как обычно.'
    *pl '──────────────────────────────────────'

    if debug = 1:
        *pl '[DEBUG PATH] stub: ' + $HallHarassStubImagePath
        *pl '[DEBUG PATH] future: ' + $HallHarassFutureImagePath
        gs 'HallHarassmentDebug'
    end
---

#HallHarassmentPrintTypeStubLine
    ! Короткая служебная подпись type/sub (не USER-OWNED prose)
    if HarassTier <= 1:
        if HallHarassType = 1:
            *pl 'Жест T1-1: хватает за руку / запястье.'
        elseif HallHarassType = 2:
            *pl 'Жест T1-2: рука на талии.'
        elseif HallHarassType = 3:
            *pl 'Жест T1-3: взгляд / «оценка» (попа / декольте).'
        else:
            *pl 'Жест T1-4: щипок за бок.'
        end
    elseif HarassTier = 2:
        if HallHarassType = 1:
            *pl 'Жест T2-1: ладонь на попе (через юбку).'
        elseif HallHarassType = 2:
            *pl 'Жест T2-2: тянет / сажает на колени.'
        elseif HallHarassType = 3:
            *pl 'Жест T2-3: лицом в декольте (он прижал).'
        else:
            *pl 'Жест T2-4: сзади + трётся пахом.'
        end
    else:
        if HallHarassType = 1:
            *pl 'Жест T3-1: задирает юбку.'
        elseif HallHarassType = 2:
            *pl 'Жест T3-2: жёстко сажает на колени.'
        elseif HallHarassType = 3:
            *pl 'Жест T3-3: тянет → падает к нему на пах (не на лицо).'
        elseif HallHarassType = 4:
            *pl 'Жест T3-4 wall: прижал к стойке/стене, рука под юбкой.'
        elseif $HallHarassSubScene = 'drop_cutlery':
            *pl 'Жест T3-5 drop_cutlery: роняет вилку → она поднимает → рука под юбку.'
        elseif $HallHarassSubScene = 'drop_coin':
            if HallHarassUnderTableCock = 1:
                if $HallHarassUnderReact = 'flee':
                    *pl 'Жест T3-5 drop_coin + cock: она под столом, он достаёт член → она вылетает (flee).'
                else:
                    *pl 'Жест T3-5 drop_coin + cock: она под столом, он достаёт член → забрала монету, ушла (coin).'
                end
            else:
                *pl 'Жест T3-5 drop_coin: под стол за монетой → лапает / попа (без члена).'
            end
        else:
            *pl 'Жест T3-5 drop: subroll не задан.'
        end
    end
---

#HallHarassmentShowIntroImage
    ! 1) named art (только amanda/melissa)  2) legacy waitress_*  3) stub
    gs 'HallHarassmentBuildArtKeys'

    if LOC('ShowImagePath') = 1 and HallHarassHasShippedArt = 1 and $HallHarassArtBase <> '':
        gs 'ShowImagePath', $HallHarassArtBase, '', 'event', 'webp'
    elseif LOC('ShowImagePath') = 1 and HallHarassHasShippedArt = 1 and $HallHarassLegacyArtBase <> '':
        gs 'ShowImagePath', $HallHarassLegacyArtBase, '', 'event', 'webp'
    elseif LOC('ShowImage') = 1:
        gs 'ShowImage', 'common', '', 'hall_harass_stub', '', 'png', 'small'
    end

    if debug = 1:
        *pl '[DEBUG HALL IMAGE] shipped=' + STR(HallHarassHasShippedArt) + ' art: ' + $HallHarassArtBase + ' (tier=' + STR(HallHarassArtTier) + ' type=' + STR(HallHarassArtType) + ')'
        *pl '[DEBUG HALL IMAGE] legacy: ' + $HallHarassLegacyArtBase
        *pl '[DEBUG HALL IMAGE] future: ' + $HallHarassFutureImagePath
        *pl '[DEBUG HALL IMAGE] stub: ' + $HallHarassStubImagePath
        *pl ' '
    end
---

#HallHarassmentShowImage
    gs 'NormalizeGirlKey', $ARGS[0]
    $HallImageGirl = $GirlKey
    $HallImageJob = LCASE($ARGS[1])
    HallImageType = ARGS[2]
    $HallImageReaction = LCASE($ARGS[3])

    if $HallImageGirl = '':
        exit
    end

    if $HallImageJob = '':
        $HallImageJob = 'waitress'
    end

    if HallImageType <= 0:
        HallImageType = 1
    end

    if $HallImageReaction = '':
        $HallImageReaction = 'ignore'
    end

    ! reaction_* webp только у amanda/melissa; Сандра и прочие → stub
    HallHarassHasShippedReaction = 0
    $HallHarassReactionArtBase = ''

    if $HallImageGirl = 'amanda' or $HallImageGirl = 'melissa':
        HallHarassHasShippedReaction = 1
        $HallHarassReactionArtBase = 'images/events/' + $HallImageGirl + '/hall_harass/reaction_' + $HallImageReaction
    end

    if LOC('ShowImagePath') = 1 and HallHarassHasShippedReaction = 1 and $HallHarassReactionArtBase <> '':
        gs 'ShowImagePath', $HallHarassReactionArtBase, '', 'event', 'webp'
    elseif LOC('ShowImage') = 1:
        gs 'ShowImage', 'common', '', 'hall_harass_stub', '', 'png', 'small'
    end

    if debug = 1:
        *pl '[DEBUG HALL IMAGE] reaction shipped=' + STR(HallHarassHasShippedReaction) + ' path: ' + $HallHarassReactionArtBase
        *pl ' '
    end

    killvar '$HallImageGirl'
    killvar '$HallImageJob'
    killvar 'HallImageType'
    killvar '$HallImageReaction'
    killvar '$HallHarassReactionArtBase'
    killvar 'HallHarassHasShippedReaction'
---

#HallHarassmentClampStats
    if tavern_reputation < 0:
        tavern_reputation = 0
    end

    if tavern_reputation > 100:
        tavern_reputation = 100
    end

    if TavernScandal < 0:
        TavernScandal = 0
    end

    if TavernLewdFame < 0:
        TavernLewdFame = 0
    end

    if FamilyTrust < 0:
        FamilyTrust = 0
    end

    if FamilyTension < 0:
        FamilyTension = 0
    end
---

#HallHarassmentDebug
    if debug = 1:
        *pl ' '
        *pl '[DEBUG HALL HARASS] girl: ' + $HallHarassGirl
        *pl '[DEBUG HALL HARASS] job: ' + $HallHarassJob
        *pl '[DEBUG HALL HARASS] area: ' + $HallHarassConsequenceArea
        *pl '[DEBUG HALL HARASS] AllowedTier: ' + STR(HallHarassAllowedTier)
        *pl '[DEBUG HALL HARASS] HarassTier: ' + STR(HarassTier)
        *pl '[DEBUG HALL HARASS] type: ' + STR(HallHarassType)
        *pl '[DEBUG HALL HARASS] sub: ' + $HallHarassSubScene
        *pl '[DEBUG HALL HARASS] under_cock: ' + STR(HallHarassUnderTableCock) + ' react=' + $HallHarassUnderReact
        *pl '[DEBUG HALL HARASS] text_roll: ' + STR(HallHarassTextRoll)
        *pl '[DEBUG HALL HARASS] ever: ' + STR(HallHarassEverOccurred)
        *pl '[DEBUG HALL HARASS] stance: ' + $HarassGirlStance
        *pl '[DEBUG HALL HARASS] uniform: ' + $HallHarassUniformKey + ' (GirlUniformLevel=' + STR(GirlUniformLevel[$HallHarassGirl]) + ')'
        *pl '[DEBUG HALL HARASS] panty: ' + $HallHarassPantyKey + ' (NoPanties=' + STR(GirlNoPantiesWork[$HallHarassGirl]) + ')'
        *pl '[DEBUG HALL HARASS] stage: ' + STR(FamilyCorruptionStage) + ' slut: ' + STR(sluttiness[$HallHarassGirl])
