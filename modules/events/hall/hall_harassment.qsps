! ================================================
! FILE: modules/events/hall/hall_harassment.qsps
! Базовые приставания в главном зале
! Версия: v3 / меню «мне», inline-итог, футер с именем девушки
! Назначение:
! - ранний слой приставаний до hall_lewd и hall_missing
! - Аманда и Мелисса — официантки в зале; Сандра — отдельно в kitchen_harassment
! - три выбора: не вмешиваться / смотреть / вмешаться
! - сохранять последнее событие для разговоров и слухов
! - тексты в hall_harassment_text.qsps и hall_event_choice_thoughts_text.qsps
! ================================================

#HallHarassment
    *clr
    clr
    cla

    gs 'IsTavernOpen'
    gs 'UpdateGirlLocations'

    if LOC('CalculateTavernStaffEfficiency') = 1:
        gs 'CalculateTavernStaffEfficiency'
    end

    $HallHarassReturnLoc = $ARGS[0]

    if $HallHarassReturnLoc = '':
        $HallHarassReturnLoc = 'TavernMain'
    end

    if LOC($HallHarassReturnLoc) = 0:
        $HallHarassReturnLoc = 'TavernMain'
    end

    if HallHarassmentDay = day and HallHarassmentTime = time:
        if HallHarassmentResolved = 1 and $HallHarassGirl <> '':
            gs 'HallHarassmentRenderScreen'
            exit
        end

        gt $HallHarassReturnLoc
        exit
    end

    if TavernOpen = 0:
        *pl '══════════════════════════════════════════════'
        *pl ' ГЛАВНЫЙ ЗАЛ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        gs 'HallHarassmentPrintText', 'closed'

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться в главный зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $HallHarassReturnLoc
        end

        exit
    end

    if SparkQueueConsumeHall = 1 and $SparkQueueConsumeGirl <> '':
        $HallHarassGirl = $SparkQueueConsumeGirl
        $HallHarassJob = 'waitress'
    else:
        gs 'HallHarassmentPickGirl'
    end

    SparkQueueConsumeHall = 0
    killvar '$SparkQueueConsumeGirl'

    if $HallHarassGirl = '':
        *pl '══════════════════════════════════════════════'
        *pl ' ГЛАВНЫЙ ЗАЛ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        gs 'HallHarassmentPrintText', 'no_girl'

        if LOC('SaveLastHallEvent') = 1:
            gs 'SaveLastHallEvent', 'calm', '', 'Вы осмотрели главный зал, но ничего особенного не произошло.', 'none'
        end

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться в главный зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $HallHarassReturnLoc
        end

        exit
    end

    HallHarassmentDay = day
    HallHarassmentTime = time
    HallHarassmentResolved = 0
    HallHarassAfterStep = 0
    HallHarassPolicyChosen = 0
    HallHarassPolicyValue = 0
    $HallHarassJob = 'waitress'
    $HallHarassConsequenceArea = 'hall'
    $HallHarassEventLoc = 'HallHarassment'

    gs 'EnsureGirlData', $HallHarassGirl

    if $RealName[$HallHarassGirl] = '':
        $RealName[$HallHarassGirl] = UCASE(MID($HallHarassGirl, 1, 1)) + LCASE(MID($HallHarassGirl, 2))
    end

    gs 'HallHarassmentSetupScene'

    if $HallHarassGirl = 'amanda' and Amanda_FirstHallHarassment = 0:
        HallHarassFirstAmanda = 1
        Amanda_FirstHallHarassment = 1
        ! первое приставание Аманды — одна мягкая сцена (запястье), без T3 drop
        HarassTier = 1
        HallHarassType = 1
        $HallHarassSubScene = ''
        HallHarassUnderTableCock = 0
        $HallHarassUnderReact = ''
        HallHarassAllowedTier = 1
        gs 'HallHarassmentBuildArtKeys'
    else:
        HallHarassFirstAmanda = 0
    end

    gs 'HallHarassmentRenderScreen'
---

! ================================================
! FILE: modules/events/hall/hall_harassment.qsps
! Отрисовка экрана: intro, мысли, меню или итог
! ================================================

#HallHarassmentRenderScreen
    ! v2 экран 1: картинка → сцена → короткий tint правила → мысли → меню
    ! НЕ печатать полные PolicyReaction + SceneVariation (дублировали сцену)
    if HallHarassmentResolved = 0:
        *pl '══════════════════════════════════════════════'
        *pl ' ГЛАВНЫЙ ЗАЛ: НЕПРИЯТНЫЙ СЛУЧАЙ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        gs 'HallHarassmentShowIntroImage', $HallHarassGirl, $HallHarassJob, HallHarassType
        gs 'HallHarassmentIntro'
        *pl ' '
        gs 'HallHarassmentPrintPolicyTint'
        gs 'HallHarassmentPrintDecisionPrompt'
    else:
        if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
            gs 'HallHarassmentRenderAfterScreen'
            *pl ' '
            gs 'HallHarassmentPrintFooter'
        elseif HallHarassAfterStep >= 2:
            gs 'HallHarassmentRenderAfterTalkScreen'
            *pl ' '
            gs 'HallHarassmentPrintFooter'
        else
            gs 'HallHarassmentRenderActionScreen'
        end
    end
---

! ================================================
! FILE: modules/events/hall/hall_harassment.qsps
! Экран 2: итог → картинка → разговор о правилах
! ================================================

! H2 сёстры: действие гостя / её / Стефана после выбора
#HallHarassmentRenderActionScreen
    *pl '══════════════════════════════════════════════'
    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
        *pl ' КУХНЯ'
    else
        *pl ' ГЛАВНЫЙ ЗАЛ'
    end
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('HallHarassmentShowImage') = 1 and $HallHarassReaction <> '':
        gs 'HallHarassmentShowImage', $HallHarassGirl, $HallHarassJob, HallHarassType, $HallHarassReaction
        *pl ' '
    end

    if LOC('HallHarassmentPrintAfterBeat') = 1:
        gs 'HallHarassmentPrintAfterBeat'
    else
        gs 'HallHarassmentPrintHallReaction'
    end
    *pl ' '

    if debug = 1:
        *pl '[DEBUG AFTER] choice=' + $HallHarassReaction + ' beat=' + $HallHarassSceneBeat + ' client=' + $HallHarassClient + ' slap=' + STR(HallHarassSceneSlap) + ' band=' + STR(HallHarassAfterBand)
        *pl ' '
    end

    gs 'ActUiPrepare', 'Далее', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallHarassmentAfterContinue'
    end
---

#HallHarassmentAfterContinue
    HallHarassAfterStep = 2
    if $HallHarassEventLoc <> '' and LOC($HallHarassEventLoc) = 1:
        gt $HallHarassEventLoc, $HallHarassReturnLoc
    elseif $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
        if $HallHarassReturnLoc = '':
            $HallHarassReturnLoc = 'TavernMain'
        end
        gt 'KitchenHarassment', $HallHarassReturnLoc
    else
        if $HallHarassReturnLoc = '':
            $HallHarassReturnLoc = 'TavernMain'
        end
        gt 'HallHarassment', $HallHarassReturnLoc
    end
---

! H3 сёстры / after кухня: она к тебе + правило
#HallHarassmentRenderAfterTalkScreen
    *pl '══════════════════════════════════════════════'
    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
        *pl ' КУХНЯ'
    else
        *pl ' ГЛАВНЫЙ ЗАЛ'
    end
    *pl '══════════════════════════════════════════════'
    *pl ' '

    $PolicyTalkGirl = $HallHarassGirl
    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
        $PolicyTalkArea = 'kitchen'
    else
        $PolicyTalkArea = 'hall'
    end
    gs 'GirlWorkPolicyTalkEnsureName', $PolicyTalkGirl

    if LOC('HallHarassmentShowImage') = 1 and $HallHarassReaction <> '':
        gs 'HallHarassmentShowImage', $HallHarassGirl, $HallHarassJob, HallHarassType, $HallHarassReaction
        *pl ' '
    end

    gs 'HallHarassmentAftermathLineText'
    if $HallHarassAftermathLine <> '':
        *pl $RealName[$HallHarassGirl] + ' ' + $HallHarassAftermathLine
        *pl ' '
    end
    killvar '$HallHarassAftermathLine'

    if GirlOffenseDays[$HallHarassGirl] > 0:
        if LOC('OffenseDaysPrintSceneReaction') = 1:
            gs 'OffenseDaysPrintSceneReaction', $HallHarassGirl
            *pl ' '
        end
    end

    if debug = 1 and $HallHarassOffenseDebug <> '':
        if INSTR($HallHarassOffenseDebug, 'girl=' + $HallHarassGirl) > 0:
            *pl '[DEBUG OFFENSE] ' + $HallHarassOffenseDebug
            *pl ' '
        end
    end
    $HallHarassOffenseDebug = ''

    gs 'GirlWorkPolicyTalkPrintText', 'after_harass_intro'
    *pl ' '
    gs 'HallHarassmentBuildPolicyMenu'
    if HallHarassPolicyChosen = 0:
        gs 'GetMenuOpenLinkHref', 'HallHarassPolicyMenu', 'Обсудить правило поведения'
        *p $MenuOpenLinkHref + '.'
        killvar '$MenuOpenLinkHref'
        *pl ' '
    end

    if HallHarassPolicyChosen = 1:
        *pl ' '
        gs 'HallHarassmentShowPolicyReactionBlock'
    end

    killvar '$PolicyTalkGirl'
    killvar '$PolicyTalkArea'
---

#HallHarassmentRenderAfterScreen
    ! кухня (пока целиком): visual + beat + она к тебе + правило
    *pl '══════════════════════════════════════════════'
    if $HallHarassConsequenceArea = 'kitchen':
        *pl ' ПОСЛЕ: КУХНЯ'
    else
        *pl ' ПОСЛЕ: ЗАЛ'
    end
    *pl '══════════════════════════════════════════════'
    *pl ' '

    $PolicyTalkGirl = $HallHarassGirl
    if $HallHarassConsequenceArea = 'kitchen':
        $PolicyTalkArea = 'kitchen'
    else
        $PolicyTalkArea = 'hall'
    end
    gs 'GirlWorkPolicyTalkEnsureName', $PolicyTalkGirl

    ! A) visual
    if LOC('HallHarassmentShowImage') = 1 and $HallHarassReaction <> '':
        gs 'HallHarassmentShowImage', $HallHarassGirl, $HallHarassJob, HallHarassType, $HallHarassReaction
        *pl ' '
    end

    ! B) сцена / звуки (hall_harassment_after_text)
    if LOC('HallHarassmentPrintAfterBeat') = 1:
        gs 'HallHarassmentPrintAfterBeat'
    else
        gs 'HallHarassmentPrintHallReaction'
    end
    *pl ' '

    if debug = 1:
        *pl '[DEBUG AFTER] choice=' + $HallHarassReaction + ' beat=' + $HallHarassSceneBeat + ' slap=' + STR(HallHarassSceneSlap) + ' band=' + STR(HallHarassAfterBand)
        *pl ' '
    end

    ! C) реплика к Стефану
    gs 'HallHarassmentAftermathLineText'
    if $HallHarassAftermathLine <> '':
        *pl $RealName[$HallHarassGirl] + ' ' + $HallHarassAftermathLine
        *pl ' '
    end
    killvar '$HallHarassAftermathLine'

    if GirlOffenseDays[$HallHarassGirl] > 0:
        if LOC('OffenseDaysPrintSceneReaction') = 1:
            gs 'OffenseDaysPrintSceneReaction', $HallHarassGirl
            *pl ' '
        end
    end

    ! offense-debug только если про эту же девушку (не чужой хвост melissa на sandra)
    if debug = 1 and $HallHarassOffenseDebug <> '':
        if INSTR($HallHarassOffenseDebug, 'girl=' + $HallHarassGirl) > 0:
            *pl '[DEBUG OFFENSE] ' + $HallHarassOffenseDebug
            *pl ' '
        end
    end
    $HallHarassOffenseDebug = ''

    ! D) правила
    gs 'GirlWorkPolicyTalkPrintText', 'after_harass_intro'
    *pl ' '
    gs 'HallHarassmentBuildPolicyMenu'
    if HallHarassPolicyChosen = 0:
        gs 'GetMenuOpenLinkHref', 'HallHarassPolicyMenu', 'Обсудить правило поведения'
        *p $MenuOpenLinkHref + '.'
        killvar '$MenuOpenLinkHref'
        *pl ' '
    end

    if HallHarassPolicyChosen = 1:
        *pl ' '
        gs 'HallHarassmentShowPolicyReactionBlock'
    end

    killvar '$PolicyTalkGirl'
    killvar '$PolicyTalkArea'
---

! Короткий tint правила на intro (calc+consequences без полной перепечати сцены)
#HallHarassmentPrintPolicyTint
    if GirlWorkPolicy[$HallHarassGirl] <= 0:
        exit
    end

    $PolicyTintArea = 'hall'
    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
        $PolicyTintArea = 'kitchen'
    end

    ! применить реакцию на правило (stats), текст — одна строка
    if LOC('GirlPolicyResponseCalc') = 1:
        gs 'GirlPolicyResponseCalc', $HallHarassGirl, $PolicyTintArea, GirlWorkPolicy[$HallHarassGirl]

        if LOC('GirlPolicyResponseApplyConsequences') = 1:
            gs 'GirlPolicyResponseApplyConsequences', $HallHarassGirl, $PolicyTintArea, GirlWorkPolicy[$HallHarassGirl], PolicyResponseLevel
        end
    end

    if GirlWorkPolicy[$HallHarassGirl] = 1:
        if $PolicyTintArea = 'kitchen':
            *pl $RealName[$HallHarassGirl] + ' помнит ваш наказ: на кухне без вольностей, даже ценой чаевых.'
        else
            *pl $RealName[$HallHarassGirl] + ' помнит ваш наказ: без вольностей, даже ценой чаевых.'
        end
    elseif GirlWorkPolicy[$HallHarassGirl] = 2:
        *pl $RealName[$HallHarassGirl] + ' помнит: решать самой — и сейчас она на этом и держится.'
    elseif GirlWorkPolicy[$HallHarassGirl] = 3:
        if HallHarassUnderTableCock = 1 and $HallHarassUnderReact = 'flee':
            *pl $RealName[$HallHarassGirl] + ' помнит про «раскованнее» — но сейчас отшатнулась: даже ради выручки есть предел.'
        elseif $HallHarassSubScene = 'drop_coin' or HallHarassType = 5:
            *pl $RealName[$HallHarassGirl] + ' помнит про выручку — потому и полезла за монетой, а не сразу за вами.'
        elseif $PolicyTintArea = 'kitchen' and HarassTier >= 3 and HallHarassType = 3:
            ! crotch: сцена «выставила» — не «держит раскованно»
            *pl $RealName[$HallHarassGirl] + ' помнит про выручку, но этого гостя выставила сама: на кухне граница важнее «раскованнее».'
        elseif $PolicyTintArea = 'kitchen' and HarassTier >= 3 and HallHarassType = 4 and $HarassGirlStance <> 'provoke':
            *pl $RealName[$HallHarassGirl] + ' помнит про «раскованнее», но у кладовой сама ставит предел — не зовёт вас в голос.'
        elseif $PolicyTintArea = 'kitchen':
            *pl $RealName[$HallHarassGirl] + ' помнит про «раскованнее» и выручку — это видно в том, как она держит кухню.'
        else
            *pl $RealName[$HallHarassGirl] + ' помнит про «раскованнее» и выручку — это видно в том, как она держит стол.'
        end
    end

    *pl ' '
    killvar '$PolicyTintArea'
---

#HallHarassmentBuildPolicyMenu
    gs 'Menu.Destroy', 'HallHarassPolicyMenu'
    gs 'Menu.Create', 'HallHarassPolicyMenu'

    gs 'MenuUiAdd', 'HallHarassPolicyMenu', 'Вести себя сдержанно', ''
    gs 'Menu.AddModule', 'HallHarassPolicyMenu', {
        gs 'HallHarassmentPolicyChoose', 1
    }

    if FamilyLiberationGateOpen = 1:
        gs 'MenuUiAdd', 'HallHarassPolicyMenu', 'Решать самой', ''
        gs 'Menu.AddModule', 'HallHarassPolicyMenu', {
            gs 'HallHarassmentPolicyChoose', 2
        }

        gs 'MenuUiAdd', 'HallHarassPolicyMenu', 'Вести себя расковано', ''
        gs 'Menu.AddModule', 'HallHarassPolicyMenu', {
            gs 'HallHarassmentPolicyChoose', 3
        }
    end
---

#HallHarassmentPolicyChoose
    HallHarassPolicyValue = ARGS[0]

    if HallHarassPolicyValue < 1:
        HallHarassPolicyValue = 1
    end

    if HallHarassPolicyValue > 3:
        HallHarassPolicyValue = 3
    end

    if FamilyLiberationGateOpen = 0 and HallHarassPolicyValue > 1:
        HallHarassPolicyValue = 1
    end

    if $HallHarassConsequenceArea = '':
        $HallHarassConsequenceArea = 'hall'
    end

    if $HallHarassGirl = '':
        $HallHarassGirl = $HallLewdGirl
    end

    if $HallHarassGirl = '':
        $HallHarassGirl = $HallMissingGirl
    end

    gs 'GirlWorkPolicyTalkAfterHarassApply', $HallHarassGirl, $HallHarassConsequenceArea, HallHarassPolicyValue

    HallHarassPolicyChosen = 1
    HallEventDiscussed[$HallHarassGirl] = 1

    if $HallHarassEventLoc = '':
        $HallHarassEventLoc = 'HallHarassment'
    end

    ! lewd / missing: остаёмся на экране последствия + реакция на правило
    if $HallScenePolicySource = 'lewd' or $HallScenePolicySource = 'missing':
        *clr
        clr
        cla

        if LOC('ShowGirlSidebar') = 1:
            gs 'ShowGirlSidebar', $HallHarassGirl
        end

        *pl '══════════════════════════════════════════════'
        *pl ' ПРАВИЛО ОБНОВЛЕНО'
        *pl '══════════════════════════════════════════════'
        *pl ' '
        if LOC('SceneShowVisual') = 1:
            gs 'SceneShowVisual', 'images/events/' + $HallHarassGirl + '/hall_harass/policy_updated', 'правило обновлено: ' + $HallHarassGirl + ' / ' + $HallHarassConsequenceArea + ' — реакция на policy', 'large', 'webp'
        end

        if LOC('GirlWorkPolicyAssignmentReactionPrint') = 1:
            gs 'GirlWorkPolicyAssignmentReactionPrint', $HallHarassGirl, $HallHarassConsequenceArea, HallHarassPolicyValue
            *pl ' '
        end

        if $GirlTalkPendingNotice[$HallHarassGirl] <> '':
            *pl $GirlTalkPendingNotice[$HallHarassGirl]
            $GirlTalkPendingNotice[$HallHarassGirl] = ''
            *pl ' '
        end

        if $HallScenePolicySource = 'lewd' and $HallLewdReturnLoc <> '':
            $HallScenePolicyReturn = $HallLewdReturnLoc
        elseif $HallScenePolicySource = 'missing' and $HallMissingReturnLoc <> '':
            $HallScenePolicyReturn = $HallMissingReturnLoc
        else:
            $HallScenePolicyReturn = 'TavernMain'
        end

        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $HallScenePolicyReturn
        end

        killvar '$HallScenePolicySource'
        killvar '$HallScenePolicyReturn'
        exit
    end

    if $HallHarassConsequenceArea = 'kitchen':
        gt 'KitchenHarassment', $KitchenHarassReturnLoc
    else:
        gt 'HallHarassment', $HallHarassReturnLoc
    end
---

#HallHarassmentShowPolicyReactionBlock
    ! картинка уже на after-screen; здесь только реакция на выбранное правило
    if LOC('GirlWorkPolicyAssignmentReactionPrint') = 1:
        gs 'GirlWorkPolicyAssignmentReactionPrint', $HallHarassGirl, $HallHarassConsequenceArea, HallHarassPolicyValue
    end
---

#HallHarassmentBuildChoiceMenu
    gs 'Menu.Destroy', 'HallHarassmentChoiceMenu'
    gs 'Menu.Create', 'HallHarassmentChoiceMenu'

    gs 'MenuUiAdd', 'HallHarassmentChoiceMenu', 'Защитить', ''
    gs 'Menu.AddModule', 'HallHarassmentChoiceMenu', {
        gs 'HallHarassmentChoose', 'protect_hard'
    }

    if FamilyLiberationGateOpen = 1:
        gs 'MenuUiAdd', 'HallHarassmentChoiceMenu', 'Смотреть', ''
        gs 'Menu.AddModule', 'HallHarassmentChoiceMenu', {
            gs 'HallHarassmentChoose', 'watch'
        }

        gs 'MenuUiAdd', 'HallHarassmentChoiceMenu', 'Отвернуться', ''
        gs 'Menu.AddModule', 'HallHarassmentChoiceMenu', {
            gs 'HallHarassmentChoose', 'ignore'
        }
    end
---

#HallHarassmentChoose
    $HallHarassReaction = LCASE($ARGS[0])

    if $HallHarassReaction = '':
        $HallHarassReaction = 'ignore'
    end

    gs 'HallHarassmentApplyChoice'
    if HallHarassAfterStep < 1:
        HallHarassAfterStep = 1
    end

    ! v2 α: play + watch/ignore → шанс missing (без after-policy harass)
    if LOC('HallHarassTryMissingFromPlay') = 1:
        gs 'HallHarassTryMissingFromPlay'

        if HallHarassMissingTriggered = 1:
            HallMissingSkipNotice = 1
            if LOC('HallMissingBargainStart') = 1:
                gt 'HallMissingBargainStart', $HallHarassGirl, $HallHarassReturnLoc
            elseif LOC('HallMissingGirlStartFromPlay') = 1:
                gt 'HallMissingGirlStartFromPlay', $HallHarassGirl, $HallHarassReturnLoc
            end
        else
            HallMissingBargainDone = 0
            $HallMissingPromise = ''
            HallMissingPromiseBreak = 0
        end
    end

    if $HallHarassEventLoc = '':
        $HallHarassEventLoc = 'HallHarassment'
    end

    gt $HallHarassEventLoc, $HallHarassReturnLoc
---

#HallHarassmentApplyChoice
    gs 'EnsureGirlData', $HallHarassGirl

    if $HallHarassReaction = 'protect_hard':
        gs 'HallHarassmentResultProtectHard'
    elseif $HallHarassReaction = 'watch':
        gs 'HallHarassmentResultWatch'
    else:
        gs 'HallHarassmentResultIgnore'
        $HallHarassReaction = 'ignore'
    end

    gs 'HallHarassmentApplyHardSceneFlavor'
    gs 'HallHarassmentClampStats'
    gs 'ClampGirlSocialStats', $HallHarassGirl

    if $HallHarassConsequenceArea = '':
        $HallHarassConsequenceArea = 'hall'
    end

    ! память / family / last choice: play → event hall_lewd (стык со старыми talk hooks)
    if LOC('HallChoiceConsequencesApply') = 1:
        $HallMemEvent = 'harassment'
        $HallMemChoice = $HallHarassReaction

        if $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
            $HallMemEvent = 'hall_lewd'
            ! ignore на play ≈ «не мешаю / profit» для GirlRemembers*
            if $HallHarassReaction = 'ignore':
                $HallMemChoice = 'encourage'
            end
        end

        gs 'HallChoiceConsequencesApply', $HallHarassGirl, $HallMemEvent, $HallMemChoice, $HallHarassConsequenceArea
        killvar '$HallMemEvent'
        killvar '$HallMemChoice'
    end

    gs 'HallHarassmentRegisterExtraSystems'
    gs 'HallHarassmentDebug'

    ! флаг «уже был хотя бы один harass» — гейт under-table cock
    HallHarassEverOccurred = 1
    HallHarassmentResolved = 1
---

#HallHarassmentApplyHardSceneFlavor
    ! T3 wall / under-table cock: чуть сильнее след, если не оборвали
    if $HallHarassReaction = 'protect_hard':
        exit
    end

    if HallHarassUnderTableCock = 1:
        TavernScandal += 1
        TavernLewdFame += 1
        GirlPublicAttention[$HallHarassGirl] += 1

        if $HallHarassUnderReact = 'flee':
            fear[$HallHarassGirl] += 1
        elseif $HallHarassUnderReact = 'coin':
            if $HallHarassReaction = 'watch' or $HallHarassReaction = 'ignore':
                sluttiness[$HallHarassGirl] += 1
            end
        end

        exit
    end

    if HarassTier >= 3 and (HallHarassType = 4 or HallHarassType = 5):
        TavernScandal += 1
        GirlPublicAttention[$HallHarassGirl] += 1
    end
---

#HallHarassmentPrintGirlPolicyMenuLine
    gs 'HallHarassmentAftermathLineText'

    if $HallHarassAftermathLine = '':
        exit
    end

    if HallHarassPolicyChosen = 0:
        gs 'GetMenuOpenLinkHref', 'HallHarassPolicyMenu', $RealName[$HallHarassGirl]
        *p $MenuOpenLinkHref + ' ' + $HallHarassAftermathLine
        killvar '$MenuOpenLinkHref'
    else:
        *p $RealName[$HallHarassGirl] + ' ' + $HallHarassAftermathLine
    end

    killvar '$HallHarassAftermathLine'
---

#HallHarassmentAftermathLineText
    ! реплика к Стефану (band × choice) — hall_harassment_after_text.qsps
    $HallHarassAftermathLine = ''
    if LOC('HallHarassAfterBandCalc') = 1:
        gs 'HallHarassAfterBandCalc'
    end

    $HallHarassAfterId = ''
    if $HallHarassReaction = 'protect_hard':
        if $HallHarassTalkReaction = 'protect_dislike':
            $HallHarassAfterId = 'talk_protect_annoyed'
        elseif $HallHarassTalkReaction = 'protect_fail':
            $HallHarassAfterId = 'talk_protect_fail'
        else
            $HallHarassAfterId = 'talk_protect_thanks'
        end
    elseif $HallHarassReaction = 'watch':
        if HallHarassAfterBand = 0:
            $HallHarassAfterId = 'talk_watch_band0'
        elseif HallHarassAfterBand = 1:
            $HallHarassAfterId = 'talk_watch_band1'
        elseif HallHarassAfterBand = 2:
            $HallHarassAfterId = 'talk_watch_band2'
        else
            $HallHarassAfterId = 'talk_watch_band3'
        end
    else
        if HallHarassAfterBand = 0:
            $HallHarassAfterId = 'talk_ignore_band0'
        elseif HallHarassAfterBand = 1:
            $HallHarassAfterId = 'talk_ignore_band1'
        elseif HallHarassAfterBand = 2:
            $HallHarassAfterId = 'talk_ignore_band2'
        else
            $HallHarassAfterId = 'talk_ignore_band3'
        end
    end

    if $HallHarassAfterId <> '' and LOC('HallHarassmentAfterText') = 1:
        gs 'HallHarassmentAfterText', $HallHarassAfterId
        $HallHarassAftermathLine = $HallHarassmentAfterText
        killvar '$HallHarassmentAfterText'
    end
    killvar '$HallHarassAfterId'
---

#HallHarassmentPrintHallReaction
    ! экран 2: девушка + клиент (after_text); не «зал осудил хозяина»
    if $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
        if $HallHarassReaction = 'watch' or $HallHarassReaction = 'ignore':
            if LOC('HallHarassmentPrintAfterBeat') = 1:
                gs 'HallHarassmentPrintAfterBeat'
                exit
            end
        end
        if LOC('HallHarassmentPrintPlayResolve') = 1:
            gs 'HallHarassmentPrintPlayResolve'
            exit
        end
    end

    if LOC('HallHarassmentPrintAfterBeat') = 1:
        gs 'HallHarassmentPrintAfterBeat'
        exit
    end

    if $HallHarassReaction = 'protect_hard':
        gs 'HallHarassmentPrintText', 'hall_reaction_protect'
    elseif $HallHarassReaction = 'watch':
        gs 'HallHarassmentPrintText', 'hall_reaction_watch'
    else
        gs 'HallHarassmentPrintText', 'hall_reaction_ignore'
    end
---

#HallHarassmentPrintFooter
    *pl ' '

    act '<b>Вернуться в зал</b>', 'images/common/ui/tavern.png':
        HallHarassmentResolved = 0
        HallHarassAfterStep = 0
        HallHarassPolicyChosen = 0
        HallHarassPolicyValue = 0
        $HallHarassGirl = ''
        gt $HallHarassReturnLoc
    end
---

! ================================================
! FILE: modules/events/hall/hall_harassment.qsps
! «что же мне делать:» + меню выбора
! ================================================

#HallHarassmentPrintDecisionPrompt
    gs 'HallHarassmentBuildChoiceMenu'
    *p 'Что делать <a href="exec:gs ''Menu.Show'', ''HallHarassmentChoiceMenu''">Стефану</a>?'
---



#TavernHarassmentEvent
    gt 'HallHarassment', 'TavernMain'
---

#TavernHallEventHarassGirl
    gt 'HallHarassment', 'TavernMain'
---

#HallHarassmentTryFromBar
    $HallHarassReturnLoc = $ARGS[0]

    if $HallHarassReturnLoc = '':
        $HallHarassReturnLoc = 'TavernMain'
    end

    HallHarassmentStarted = 0

    if HallHarassmentDay = day and HallHarassmentTime = time:
        exit
    end

    gs 'SparkQueueTryStartHallFromLook', $HallHarassReturnLoc

    if HallHarassmentStarted = 1:
        exit
    end

    gs 'UpdateGirlLocations'

    if LOC('CalculateTavernStaffEfficiency') = 1:
        gs 'CalculateTavernStaffEfficiency'
    end

    gs 'HallHarassmentPickGirl'

    if $HallHarassGirl <> '':
        if RAND(1, 100) <= 35:
            HallHarassmentStarted = 1
            gt 'HallHarassment', $HallHarassReturnLoc
        else:
            gs 'SparkQueueEnqueueHall', $HallHarassGirl
        end
    end
---

#HallHarassmentTry
    $HallHarassReturnLoc = $ARGS[0]

    if $HallHarassReturnLoc = '':
        $HallHarassReturnLoc = 'TavernMain'
    end

    HallHarassmentStarted = 0

    ! Очередь AFK — всегда первой, даже если уже был слот (consume сам чистит).
    gs 'SparkQueueTryStartHallFromLook', $HallHarassReturnLoc

    if HallHarassmentStarted = 1:
        gt 'HallHarassment', $HallHarassReturnLoc
    end

    if HallHarassmentDay = day and HallHarassmentTime = time:
        exit
    end

    gs 'UpdateGirlLocations'

    if LOC('CalculateTavernStaffEfficiency') = 1:
        gs 'CalculateTavernStaffEfficiency'
    end

    gs 'HallHarassmentPickGirl'

    if $HallHarassGirl <> '':
        if RAND(1, 100) <= 25:
            HallHarassmentStarted = 1
            gt 'HallHarassment', $HallHarassReturnLoc
        else:
            gs 'SparkQueueEnqueueHall', $HallHarassGirl
        end
    end
---

#HallHarassmentPickGirl
    $HallHarassGirl = ''
    $HallHarassJob = ''
    HallHarassCandidateCount = 0

    ! Зал: только официантки (Аманда / Мелисса). Сандра — кухня (KitchenHarassment).
    if jobwaitress['amanda'] = 1 and $GirlLocation['amanda'] = 'TavernMain':
        HallHarassCandidateCount += 1
        $HallHarassCandidate[HallHarassCandidateCount] = 'amanda'
    end

    if jobwaitress['melissa'] = 1 and $GirlLocation['melissa'] = 'TavernMain':
        HallHarassCandidateCount += 1
        $HallHarassCandidate[HallHarassCandidateCount] = 'melissa'
    end

    if HallHarassCandidateCount <= 0:
        killvar 'HallHarassCandidateCount'
        killvar '$HallHarassCandidate'
        exit
    end

    if HallHarassCandidateCount = 1:
        $HallHarassGirl = $HallHarassCandidate[1]
        $HallHarassJob = 'waitress'
        $HallHarassLastGirl = $HallHarassGirl
        killvar 'HallHarassCandidateCount'
        killvar '$HallHarassCandidate'
        exit
    end

    ! Fair-ish: 70% шанс взять НЕ ту, что была в прошлый раз (если обе в зале)
    HallHarassPickRoll = RAND(1, 100)

    if $HallHarassLastGirl <> '' and HallHarassPickRoll <= 70:
        HallHarassAlt = 0

        if $HallHarassCandidate[1] <> $HallHarassLastGirl:
            $HallHarassGirl = $HallHarassCandidate[1]
            HallHarassAlt = 1
        elseif $HallHarassCandidate[2] <> $HallHarassLastGirl:
            $HallHarassGirl = $HallHarassCandidate[2]
            HallHarassAlt = 1
        end

        if HallHarassAlt = 0:
            HallHarassPickRoll = RAND(1, HallHarassCandidateCount)
            $HallHarassGirl = $HallHarassCandidate[HallHarassPickRoll]
        end

        killvar 'HallHarassAlt'
    else:
        HallHarassPickRoll = RAND(1, HallHarassCandidateCount)
        $HallHarassGirl = $HallHarassCandidate[HallHarassPickRoll]
    end

    $HallHarassJob = 'waitress'
    $HallHarassLastGirl = $HallHarassGirl

    killvar 'HallHarassCandidateCount'
    killvar 'HallHarassPickRoll'
    killvar '$HallHarassCandidate'
---

#HallHarassmentIntro
    ! Одна сцена: first amanda XOR artistic (не «запястье» + drop)
    if $HallHarassGirl = 'amanda' and HallHarassFirstAmanda = 1:
        gs 'HallHarassmentPrintText', 'amanda_first_intro'
        *pl ' '
        if $HarassGirlStance = 'mixed' or $HarassGirlStance = 'provoke':
            *pl 'Она всё ещё красная, но не орёт — будто ждёт, что вы сделаете на стойке.'
            *pl ' '
        end
    else
        if LOC('HallHarassmentPrintArtisticIntro') = 1:
            gs 'HallHarassmentPrintArtisticIntro'
        else
            gs 'HallHarassmentPrintServiceIntro'
        end

        if GirlNoPantiesWork[$HallHarassGirl] = 1:
            if $HallHarassSubScene = 'drop_cutlery' or $HallHarassSubScene = 'drop_coin':
                gs 'GirlNoPantiesEventPrintAddon', $HallHarassGirl, 'harassment', 'cleaning_bend'
            elseif HarassTier >= 3 and HallHarassType = 1:
                gs 'GirlNoPantiesEventPrintAddon', $HallHarassGirl, 'harassment', 'cleaning_bend'
            else
                gs 'GirlNoPantiesEventPrintAddon', $HallHarassGirl, 'harassment', 'default'
            end
            *pl ' '
        end
    end

    if debug = 1:
        *pl ' '
        *pl '[DEBUG] tier=' + STR(HarassTier) + ' type=' + STR(HallHarassType) + ' sub=' + $HallHarassSubScene + ' client=' + $HallHarassClient + ' stance=' + $HarassGirlStance
    end
---

#HallHarassmentResolve
    gs 'NormalizeGirlKey', $ARGS[0]
    $HallHarassGirl = $GirlKey
    $HallHarassJob = LCASE($ARGS[1])
    HallHarassType = ARGS[2]
    $HallHarassReaction = LCASE($ARGS[3])
    $HallHarassReturnLoc = $ARGS[4]

    if $HallHarassGirl = '':
        gt 'TavernMain'
    end

    if $HallHarassJob = '':
        $HallHarassJob = 'waitress'
    end

    if $HallHarassReaction = '':
        $HallHarassReaction = 'ignore'
    end

    if $HallHarassReturnLoc = '':
        $HallHarassReturnLoc = 'TavernMain'
    end

    if LOC($HallHarassReturnLoc) = 0:
        $HallHarassReturnLoc = 'TavernMain'
    end

    gs 'HallHarassmentChoose', $HallHarassReaction
---

#HallHarassmentPrintAftermathGirl
    if $HallHarassReaction = 'protect_hard':
        if $HallHarassTalkReaction = 'protect_dislike':
            gs 'HallHarassmentPrintText', 'aftermath_protect_annoyed'
        elseif $HallHarassTalkReaction = 'protect_fail':
            gs 'HallHarassmentPrintText', 'aftermath_protect_fail'
        else:
            gs 'HallHarassmentPrintText', 'aftermath_protect_thanks'
        end
    elseif $HallHarassReaction = 'watch':
        if $HallHarassTalkReaction = 'watch_bad' or $HallHarassTalkReaction = 'watch_lewd':
            gs 'HallHarassmentPrintText', 'aftermath_watch_angry'
        else:
            gs 'HallHarassmentPrintText', 'aftermath_watch_ok'
        end
    elseif $HallHarassReaction = 'ignore':
        if Friends[$HallHarassGirl] < 3 or fear[$HallHarassGirl] >= 2:
            gs 'HallHarassmentPrintText', 'aftermath_ignore_cold'
        else:
            gs 'HallHarassmentPrintText', 'aftermath_ignore_ok'
        end
    end
---

#HallHarassmentResultWatch
    HallWatchChance = 30 + Friends[$HallHarassGirl] / 2 + otkroven[$HallHarassGirl] / 4

    if $HallHarassGirl = 'melissa':
        HallWatchChance += 12
    elseif $HallHarassGirl = 'sandra':
        HallWatchChance += 8
    end

    if GirlWorkPolicy[$HallHarassGirl] = 3:
        HallWatchChance -= 15
    elseif GirlWorkPolicy[$HallHarassGirl] = 1:
        HallWatchChance += 10
    end

    ! v2 play: чаще «lewd»-исход watch (чаевые/scandal), не «злится что смотрел»
    if $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
        HallWatchChance += 25
    end

    if HallWatchChance > 88:
        HallWatchChance = 88
    end

    if HallWatchChance < 18:
        HallWatchChance = 18
    end

    HallWatchRoll = RAND(1, 100)

    if GirlWorkPolicy[$HallHarassGirl] = 3 or sluttiness[$HallHarassGirl] >= 35 or $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
        if HallWatchRoll <= HallWatchChance + 10:
            gs 'AwardGirlTipsFromBase', $HallHarassGirl, 5
            TavernScandal += 1
            TavernLewdFame += 1
            GirlPublicAttention[$HallHarassGirl] += 2
            otkroven[$HallHarassGirl] += 1
            sluttiness[$HallHarassGirl] += 1

            if $HallHarassGirl = 'amanda':
                AmandaPublicAttention += 1
                AmandaNpcPath += 1
            end

            $HallHarassTalkReaction = 'watch_lewd'
            $HallHarassEventText = 'Стефан стоял и смотрел, пока к ' + $RealName[$HallHarassGirl] + ' приставал посетитель, и зал это заметил.'
        else:
            Friends[$HallHarassGirl] -= 1
            GirlPublicAttention[$HallHarassGirl] += 1
            FamilyTension += 1

            $HallHarassTalkReaction = 'watch_bad'
            $HallHarassEventText = 'Стефан наблюдал за приставанием к ' + $RealName[$HallHarassGirl] + ', но не вмешался.'
        end
    elseif HallWatchRoll <= HallWatchChance:
        Friends[$HallHarassGirl] += 1
        otkroven[$HallHarassGirl] += 1
        GirlPublicAttention[$HallHarassGirl] += 1

        if $HallHarassGirl = 'amanda':
            AmandaWorkDiscipline += 1
        end

        $HallHarassTalkReaction = 'watch_ok'
        $HallHarassEventText = $RealName[$HallHarassGirl] + ' справилась сама, пока Стефан стоял рядом и смотрел.'
    else:
        Friends[$HallHarassGirl] -= 1
        fear[$HallHarassGirl] += 1
        GirlPublicAttention[$HallHarassGirl] += 1
        TavernScandal += 1
        FamilyTension += 1

        if $HallHarassGirl = 'amanda':
            AmandaSecretiveness += 1
        elseif $HallHarassGirl = 'melissa':
            MelissaControlNeed += 1
        elseif $HallHarassGirl = 'sandra':
            SandraFamilyConcern += 1
        end

        $HallHarassTalkReaction = 'watch_bad'
        $HallHarassEventText = 'Стефан наблюдал за приставанием к ' + $RealName[$HallHarassGirl] + ', но не вмешался.'
    end

    killvar 'HallWatchChance'
    killvar 'HallWatchRoll'
---

#HallHarassmentResultProtectHard
    HallProtectChance = 35 + strength + charisma + management_skill
    HallProtectChance = HallProtectChance / 2

    if HallProtectChance > 90:
        HallProtectChance = 90
    end

    if HallProtectChance < 20:
        HallProtectChance = 20
    end

    HallProtectRoll = RAND(1, 100)

    if HallProtectRoll <= HallProtectChance:
        if sluttiness[$HallHarassGirl] >= 70 or ($HallHarassGirl = 'amanda' and AmandaPublicAttention >= 40):
            Friends[$HallHarassGirl] -= 1
            otkroven[$HallHarassGirl] += 1
            sluttiness[$HallHarassGirl] += 1
            tavern_reputation += 1
            TavernScandal -= 1
            FamilyTrust += 1

            if $HallHarassGirl = 'amanda':
                AmandaRebellion += 1
                AmandaPublicAttention += 1
            end

            $HallHarassTalkReaction = 'protect_dislike'
            $HallHarassEventText = 'Стефан жёстко вмешался, когда к ' + $RealName[$HallHarassGirl] + ' приставал посетитель, но она решила, что могла справиться сама.'
        else:
            Friends[$HallHarassGirl] += 2
            love[$HallHarassGirl] += 1
            tavern_reputation += 1
            TavernScandal -= 1
            FamilyTrust += 1

            if $HallHarassGirl = 'amanda':
                AmandaTrustStefan += 2
                AmandaWorkDiscipline += 1
            end

            $HallHarassTalkReaction = 'protect_success'
            $HallHarassEventText = 'Стефан вступился за ' + $RealName[$HallHarassGirl] + ', когда к ней приставал посетитель.'
        end
    else:
        Friends[$HallHarassGirl] += 1
        tavern_reputation -= 1
        money -= 10
        FamilyTension += 1

        $HallHarassTalkReaction = 'protect_fail'
        $HallHarassEventText = 'Стефан попытался защитить ' + $RealName[$HallHarassGirl] + ', но вмешательство закончилось шумом и потерями.'
    end

    killvar 'HallProtectChance'
    killvar 'HallProtectRoll'
---

#HallHarassmentResultWarnClient
    HallWarnChance = 55 + charisma + management_skill
    HallWarnChance = HallWarnChance / 2

    if HallWarnChance > 92:
        HallWarnChance = 92
    end

    if HallWarnChance < 25:
        HallWarnChance = 25
    end

    HallWarnRoll = RAND(1, 100)

    if HallWarnRoll <= HallWarnChance:
        gs 'HallHarassmentPrintText', 'warn_client_success'

        Friends[$HallHarassGirl] += 1
        tavern_reputation += 1
        TavernScandal -= 1
        FamilyTrust += 1

        if $HallHarassGirl = 'amanda':
            AmandaTrustStefan += 1
            AmandaWorkDiscipline += 1
        end

        $HallHarassTalkReaction = 'protect_success'
        $HallHarassEventText = 'Стефан спокойно остановил клиента, который приставал к ' + $RealName[$HallHarassGirl] + '.'
    else:
        gs 'HallHarassmentPrintText', 'warn_client_fail'

        tavern_reputation -= 1
        FamilyTension += 1

        $HallHarassTalkReaction = 'protect_fail'
        $HallHarassEventText = 'Стефан попытался спокойно остановить клиента, но зал всё равно услышал шум.'
    end

    killvar 'HallWarnChance'
    killvar 'HallWarnRoll'
---

#HallHarassmentResultSelfHandle
    HallSelfChance = 35 + Friends[$HallHarassGirl] / 2 + otkroven[$HallHarassGirl] / 3 + GirlWorkPolicy[$HallHarassGirl] * 5

    if $HallHarassGirl = 'melissa':
        HallSelfChance += 15
    elseif $HallHarassGirl = 'sandra':
        HallSelfChance += 10
    end

    if HallSelfChance > 90:
        HallSelfChance = 90
    end

    if HallSelfChance < 20:
        HallSelfChance = 20
    end

    HallSelfRoll = RAND(1, 100)

    if HallSelfRoll <= HallSelfChance:
        gs 'HallHarassmentPrintText', 'self_handle_success'

        Friends[$HallHarassGirl] += 1
        otkroven[$HallHarassGirl] += 1
        GirlWorkPolicy[$HallHarassGirl] = 2
        GirlPublicAttention[$HallHarassGirl] += 1

        if $HallHarassGirl = 'amanda':
            AmandaWorkDiscipline += 1
            AmandaPublicAttention += 1
        end

        $HallHarassTalkReaction = 'self_success'
        $HallHarassEventText = $RealName[$HallHarassGirl] + ' сама справилась с приставшим посетителем, потому что Стефан дал ей решить.'
    else:
        gs 'HallHarassmentPrintText', 'self_handle_bad'

        Friends[$HallHarassGirl] -= 1
        fear[$HallHarassGirl] += 1
        FamilyTension += 1

        if $HallHarassGirl = 'amanda':
            AmandaSecretiveness += 1
        end

        $HallHarassTalkReaction = 'self_bad'
        $HallHarassEventText = 'Стефан велел ' + $RealName[$HallHarassGirl] + ' справиться самой, но ей это далось тяжело.'
    end

    killvar 'HallSelfChance'
    killvar 'HallSelfRoll'
---

#HallHarassmentResultProfit
    if GirlWorkPolicy[$HallHarassGirl] <> 3:
        GirlWorkPolicy[$HallHarassGirl] = 3
    end

    gs 'AwardGirlTipsFromBase', $HallHarassGirl, 8
    TavernScandal += 1
    TavernLewdFame += 1
    GirlPublicAttention[$HallHarassGirl] += 2
    GirlNpcPath[$HallHarassGirl] += 1

    if sluttiness[$HallHarassGirl] >= 20 or TavernScandal >= 15:
        gs 'HallHarassmentPrintText', 'profit_high'

        Friends[$HallHarassGirl] += 1
        sluttiness[$HallHarassGirl] += 1
        $HallHarassTalkReaction = 'profit_high'
        $HallHarassEventText = 'Стефан сделал вид, что приставание к ' + $RealName[$HallHarassGirl] + ' — часть работы, и зал это заметил.'
    else:
        gs 'HallHarassmentPrintText', 'profit_low'

        Friends[$HallHarassGirl] -= 2
        fear[$HallHarassGirl] += 1
        FamilyTension += 1
        $HallHarassTalkReaction = 'profit_low'
        $HallHarassEventText = 'Стефан закрыл глаза на приставание ради денег, и ' + $RealName[$HallHarassGirl] + ' это запомнила.'
    end

    if $HallHarassGirl = 'amanda':
        AmandaPublicAttention += 2
        AmandaNpcPath += 1
        AmandaScandalLevel += 1
    elseif $HallHarassGirl = 'melissa':
        MelissaScandalTolerance += 1
    elseif $HallHarassGirl = 'sandra':
        SandraFamilyConcern += 1
    end
---

#HallHarassmentResultIgnore
    Friends[$HallHarassGirl] -= 1
    GirlSecretiveness[$HallHarassGirl] += 1
    GirlPublicAttention[$HallHarassGirl] += 1
    TavernScandal += 1
    FamilyTension += 1

    if $HallHarassGirl = 'amanda':
        AmandaSecretiveness += 1
        AmandaRebellion += 1
    elseif $HallHarassGirl = 'melissa':
        MelissaControlNeed += 1
    elseif $HallHarassGirl = 'sandra':
        SandraFamilyConcern += 1
    end

    $HallHarassTalkReaction = 'ignore'
    $HallHarassEventText = 'Стефан не вмешался, когда к ' + $RealName[$HallHarassGirl] + ' приставал посетитель.'
---

#HallHarassmentAftermathFamily
    if $HallHarassGirl = 'amanda':
        if $HallHarassReaction = 'protect_hard' or $HallHarassReaction = 'warn_client':
            gs 'HallHarassmentPrintText', 'family_amanda_protected'

            MelissaFamilyConcern += 1
            SandraFamilyConcern += 1
            MelissaRespectStefan += 1
            SandraRespectStefan += 1
        elseif $HallHarassReaction = 'profit' or $HallHarassReaction = 'ignore' or $HallHarassReaction = 'watch':
            gs 'HallHarassmentPrintText', 'family_amanda_bad'

            MelissaFamilyConcern += 2
            SandraFamilyConcern += 2
            FamilyTension += 1
        else:
            gs 'HallHarassmentPrintText', 'family_amanda_self'

            MelissaFamilyConcern += 1
            SandraFamilyConcern += 1
        end
    elseif $HallHarassGirl = 'melissa':
        if $HallHarassReaction = 'protect_hard' or $HallHarassReaction = 'warn_client':
            MelissaRespectStefan += 1
        elseif $HallHarassReaction = 'watch':
            MelissaControlNeed += 1
            FamilyTension += 1
        else:
            MelissaControlNeed += 1
            FamilyTension += 1
        end
    elseif $HallHarassGirl = 'sandra':
        if $HallHarassReaction = 'protect_hard' or $HallHarassReaction = 'warn_client':
            SandraRespectStefan += 1
        else:
            SandraFamilyConcern += 1
            FamilyTension += 1
        end
    end
---

#HallHarassmentRegisterLastEvent
    if LOC('SaveLastHallEvent') = 1:
        gs 'SaveLastHallEvent', 'harassment', $HallHarassGirl, $HallHarassEventText, $HallHarassTalkReaction
    end

    HallEventDiscussed[$HallHarassGirl] = 0
    $LastHallEventType = 'harassment'
    $LastHallEventGirl = $HallHarassGirl

    if $HallHarassGirl = 'amanda':
        Amanda_AfterHarassmentTalk = 1
    end
---

#HallHarassmentRegisterExtraSystems
    gs 'HallHarassmentRegisterLastEvent'

    ! HallRecentMemory — frozen (thin memory A); лог = SaveLastHallEvent выше

    ! HallRumorRegister(ARGS): girl, event, severity — НЕ event, girl
    if LOC('HallRumorRegister') = 1:
        if $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
            if $HallHarassReaction = 'protect_hard':
                gs 'HallRumorRegister', $HallHarassGirl, 'hall_lewd', 1
            else
                gs 'HallRumorRegister', $HallHarassGirl, 'hall_lewd', 2
            end
        elseif $HallHarassReaction = 'profit' or ($HallHarassReaction = 'watch' and $HallHarassTalkReaction = 'watch_lewd'):
            gs 'HallRumorRegister', $HallHarassGirl, 'hall_lewd', 2
        elseif $HallHarassReaction = 'ignore' or $HallHarassReaction = 'watch':
            gs 'HallRumorRegister', $HallHarassGirl, 'hall_lewd', 2
        else
            gs 'HallRumorRegister', $HallHarassGirl, 'harassment', 1
        end
    end

    if LOC('KnowledgeRegisterFact') = 1:
        gs 'KnowledgeRegisterFact', 'HallHarassment_' + $HallHarassGirl
    end

    ! v2 play: факт «подыгрывала» + legacy-совместимые id
    if $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
        if LOC('KnowledgeRegisterFact') = 1:
            gs 'KnowledgeRegisterFact', 'HallPlay_' + $HallHarassGirl
            if $HallHarassGirl = 'amanda':
                gs 'KnowledgeRegisterFact', 'amanda_hall_lewd_witness'
            end
        end

        if ($HallHarassReaction = 'watch' or $HallHarassReaction = 'ignore') and LOC('KnowledgeRegisterPlayerKnows') = 1:
            gs 'KnowledgeRegisterPlayerKnows', 'HallPlay_' + $HallHarassGirl, 'witness'
            if $HallHarassGirl = 'amanda' and LOC('KnowledgeRegisterPlayerKnows') = 1:
                gs 'KnowledgeRegisterPlayerKnows', 'amanda_hall_lewd_witness', 'witness'
            end
        end
    end

    if LOC('OffenseDaysHarassmentAfter') = 1:
        gs 'OffenseDaysHarassmentAfter', $HallHarassGirl, $HallHarassConsequenceArea, $HallHarassReaction, $HallHarassTalkReaction
