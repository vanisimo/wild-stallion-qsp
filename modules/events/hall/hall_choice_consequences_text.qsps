! ================================================
! FILE: modules/events/hall/hall_choice_consequences_text.qsps
! MODULE: events/hall
! Последствия выбора: protect_hard/watch/ignore (+ kitchen stop/let_her/client)
! Меню lewd: ignore → encourage-prose; missing: watch→peek, protect→interrupt
! ================================================

#HallChoiceConsequenceText
    $HallChoiceConsequenceEventId = LCASE($ARGS[0])
    $HallChoiceConsequenceChoiceId = LCASE($ARGS[1])
    $HallChoiceConsequenceGirlId = LCASE($ARGS[2])
    $HallChoiceConsequenceText = ''

    if $HallChoiceConsequenceGirlId <> '':
        if $RealName[$HallChoiceConsequenceGirlId] = '':
            if LOC('EnsureGirlData') = 1:
                gs 'EnsureGirlData', $HallChoiceConsequenceGirlId
            end
        end
    end

    if $HallChoiceConsequenceEventId = 'harassment' or $HallChoiceConsequenceEventId = 'hall_harassment':
        gs 'HallChoiceConsequenceTextHarassment'
    elseif $HallChoiceConsequenceEventId = 'hall_lewd':
        gs 'HallChoiceConsequenceTextHallLewd'
    elseif $HallChoiceConsequenceEventId = 'kitchen_lewd':
        gs 'HallChoiceConsequenceTextKitchenLewd'
    elseif $HallChoiceConsequenceEventId = 'hall_missing':
        gs 'HallChoiceConsequenceTextHallMissing'
    elseif $HallChoiceConsequenceEventId = 'kitchen' or $HallChoiceConsequenceEventId = 'kitchen_customer':
        gs 'HallChoiceConsequenceTextKitchen'
    end

    killvar '$HallChoiceConsequenceEventId'
    killvar '$HallChoiceConsequenceChoiceId'
    killvar '$HallChoiceConsequenceGirlId'
---

#HallChoiceConsequenceTextHarassment
    if $HallChoiceConsequenceChoiceId = 'protect_hard':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Зал затихает неохотно, волнами: кто-то демонстративно утыкается носом в пенную кружку, кто-то отводит глаза с кривой усмешкой. ' + $RealName[$HallChoiceConsequenceGirlId] + ' торопливо отходит в сторону стойки, а Стефан ловит себя на тяжёлой мысли: теперь каждый пьянчуга под этой крышей понял, что хозяин готов драть глотку и махать кулаками за своих девок. Только вот одни увидят в этом надёжную защиту, а другие — лишь дурной хозяйский нрав и повод затаить обиду.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'warn_client':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Гроза проходит стороной, не переломившись в драку, но осадок виснет в воздухе густым чадом. Задетый гость обиженно сопит в усы, соседи понимающе переглядываются, а ' + $RealName[$HallChoiceConsequenceGirlId] + ' бросает на Стефана долгий, внимательный взгляд. Никакого дешёвого рыцарства, никаких уступок — хозяин просто и веско очертил черту, за которой кончается гостеприимство и начинается расплата.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'self_handle':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан остаётся на месте, не делая первого шага навстречу. Странное, скребущее чувство: вроде бы он проявил выдержку и доверил ей самой решить дело, а на деле — просто переложил на девичьи плечи всю грязь трактирного ремесла. ' + $RealName[$HallChoiceConsequenceGirlId] + ' выпутывается как может, но между ними повисает новая, чужая тишина — в ней больше нет прежней детской доверчивости.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'profit':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Звон серебра на дубовых досках звучит чертовски сладко. Слишком сладко для чистой совести. Довольный гость ухмыляется, в зале оживлённо гудят, предвкушая новые вольности, а Стефан с холодной ясностью понимает: люди чертовски быстро привыкают к тому, что однажды было куплено за монету. И ' + $RealName[$HallChoiceConsequenceGirlId] + ' теперь тоже знает эту цену — по-своему, без иллюзий.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'watch':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Он замирает на месте, не сдвинувшись ни на вершок и впившись взглядом в чужие пальцы. Со стороны эта неподвижность кажется ледяным контролем, но захмелевший зал уже жадно следит за обоими: за наглецом и за молодым хозяином. ' + $RealName[$HallChoiceConsequenceGirlId] + ' тоже ловит это молчаливое присутствие — и понимает, что Стефан не просто отвернулся, а осознанно позволил чужим рукам зайти так далеко.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'ignore':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Вроде бы беды не стряслось: посуда цела, кулаки в ход не пошли, кружки мерно стучат по столам. Но именно от этой благополучной тишины внутри разливается липкая горечь. Равнодушие оказалось слишком удобным щитом. Стефан ясно видит: ' + $RealName[$HallChoiceConsequenceGirlId] + ' запомнила вовсе не пьяного хама с его щипками. Она на всю жизнь запомнила, как хозяин и брат старательно отвёл глаза в сторону.</i></font>'
    end
---

#HallChoiceConsequenceTextHallLewd
    ! меню: protect_hard / watch / ignore (ignore печатает encourage-prose)
    if $HallChoiceConsequenceChoiceId = 'stop' or $HallChoiceConsequenceChoiceId = 'protect_hard' or $HallChoiceConsequenceChoiceId = 'protect':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан грубо обрывает бесстыдную сцену прежде, чем она успевает превратиться в потеху для всего захмелевшего сброда. За дальними столами разочарованно цокают языками, зато тяжёлый, липкий дурман в зале разом рассеивается. ' + $RealName[$HallChoiceConsequenceGirlId] + ' растерянно одёргивает смятое платье: во взгляде её мешается тихая благодарность за избавление и глухая девичья обида за то, что её судьбу снова решили без спроса.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'watch':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Он стоит не шелохнувшись, впитывая каждую деталь происходящего. Внешне — абсолютное хозяйское хладнокровие, но внутри всё натянуто, как тетива перед выстрелом. Зал тоже не спускает глаз: жадно пялятся на ' + $RealName[$HallChoiceConsequenceGirlId] + ', на наглого гостя, на застывшего у стойки Стефана. Ведь порой хозяин даёт благословение на любой грех не словами, а просто тем, что не делает ни единого шага.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'encourage' or $HallChoiceConsequenceChoiceId = 'ignore':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан делает вид, будто всё идёт строго по заведённому порядку — может, даже чересчур ладно. Монета льётся в лоток щедрее, пьяный гогот за столами звучит всё развязнее, а невидимая черта дозволенного под этой крышей сдвигается ещё на вершок в сторону блуда. ' + $RealName[$HallChoiceConsequenceGirlId] + ' безошибочно чует эту перемену затылком, даже не пытаясь облечь её в слова.</i></font>'
    end
---

#HallChoiceConsequenceTextKitchenLewd
    if $HallChoiceConsequenceChoiceId = 'stop' or $HallChoiceConsequenceChoiceId = 'protect_hard' or $HallChoiceConsequenceChoiceId = 'protect':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан ставит точку одним резким движением: чужим похотливым лапам у кухонного очага не место. Сандра молча отходит к кипящим котлам, а в зале за дощатой перегородкой даже не успевают сообразить, что произошло. Порядок на кухне отстоян — вот только останется ли за это благодарность в глазах взрослой стряпухи, знающей себе цену?</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'watch':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан замирает в кухонном простенке, тяжело опершись о косяк. В тесноте жаркой кухни, среди пара и брызг кипящего жира, каждый шорох звучит вдесятеро громче. Сандра спиной чувствует его пристальный взгляд поверх наглых пальцев гостя. И молчаливое присутствие молодого хозяина режет здесь куда больнее любого громогласного приказа.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'ignore' or $HallChoiceConsequenceChoiceId = 'encourage':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан нарочито неторопливо уходит в зал, предоставив кухне самой захлёбываться в пьяных домогательствах. Звонкая монета от сытого гостя, конечно, капнет в карман, но дубовый порог накрепко запомнит: в этот вечер хозяин трактира сознательно предпочёл не переступать черту.</i></font>'
    end
---

#HallChoiceConsequenceTextHallMissing
    ! меню: ignore / watch / protect_hard (watch → peek_scene+meet; protect → interrupt)
    if $HallChoiceConsequenceChoiceId = 'ignore_after' or $HallChoiceConsequenceChoiceId = 'ignore':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан шагает обратно к стойке с самым беззаботным видом, будто ничего не заметил. Самая сладкая и удобная ложь — та, которую не требуется произносить вслух. Если ' + $RealName[$HallChoiceConsequenceGirlId] + ' и впрямь просто отлучилась по делу, он избавил себя от нелепого переполоха. А если нет... он только что дал ей недвусмысленно понять: искать её и держать за руку никто не станет.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'peek_scene' or $HallChoiceConsequenceChoiceId = 'peek' or $HallChoiceConsequenceChoiceId = 'watch':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Теперь Стефан знает куда больше, чем следовало бы знать для спокойного сна. Тайное подглядывание из полумрака мало походит на братскую заботу или хозяйский надзор — после увиденного уже невозможно смотреть ей в глаза с прежней простотой. Если ' + $RealName[$HallChoiceConsequenceGirlId] + ' перехватила этот жадный взгляд сквозь щель, предстоящий разговор камнем ляжет на душу.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'peek_meet':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Он вырастает на пороге слишком тихо и расчётливо, чтобы это можно было списать на невинную случайность. ' + $RealName[$HallChoiceConsequenceGirlId] + ' моментально всё понимает: Стефан пришёл не звать её на помощь в зал, а проверить на вшивость. А правда, выслеженная тайком, всегда оборачивается немым и горьким обвинением.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'interrupt_scene' or $HallChoiceConsequenceChoiceId = 'interrupt' or $HallChoiceConsequenceChoiceId = 'protect_hard' or $HallChoiceConsequenceChoiceId = 'protect':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан с грохотом распахивает дверь, вдребезги разбивая интимный полумрак каморки. Разгорячённый гость моментально трезвеет, вспоминая, кому на самом деле принадлежат эти стены и всё, что под ними находится. ' + $RealName[$HallChoiceConsequenceGirlId] + ' испуганно отшатывается. Внезапное появление спасает от грязи, но оставляет незаживающий рубец: теперь она знает, что находится под неусыпной слежкой.</i></font>'
    end
---

#HallChoiceConsequenceTextKitchen
    if $HallChoiceConsequenceChoiceId = 'stop' or $HallChoiceConsequenceChoiceId = 'protect_hard':
        $HallChoiceConsequenceText = '<font color="#606080"><i>На кухонной половине развязка наступает мгновенно. Здесь душно, пахнет жареным мясом и кипятком — не место для пьяных выходок и сальных шуточек. Стефан властной рукой выставляет лишнее тело за порог, и пусть обиженный клиент ворчит на весь зал, остальные гости крепко зарубят себе на носу: совать нос на хозяйскую кухню без спроса себе дороже.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'let_her' or $HallChoiceConsequenceChoiceId = 'self_handle' or $HallChoiceConsequenceChoiceId = 'self':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан позволяет ей самой отстоять кухонное царство. Это не просторный зал, где можно мило отшутиться и ускользнуть к дальнему столу — у раскалённой плиты всё сходится вплотную, острее и опаснее. Осадит нахала сама — станет втрое сильнее и увереннее. Спасует — до конца дней будет помнить, как хозяин стоял в проходе и равнодушно ждал, чем всё закончится.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'client' or $HallChoiceConsequenceChoiceId = 'profit' or $HallChoiceConsequenceChoiceId = 'encourage':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Гость возвращается к кружкам сытый и довольный, а на кухне повисает странная, нехорошая тишина. Серебро в кошеле звенит полновесно, спору нет. Но Стефан чувствует нутром: стены кухни помнят всё не хуже зала. Стоит один раз закрыть глаза на чужую наглость — и завтра каждый бродяга решит, что в эту дверь можно входить без стука.</i></font>'
    end
---
