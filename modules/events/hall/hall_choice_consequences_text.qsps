! ================================================
! FILE: modules/events/hall/hall_choice_consequences_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты последствий выбора Стефана в зале и на кухне
! Вызывается через: HallChoiceConsequencesPrintText
! Канон: без драмы жертвы, без морализаторства, без сутенёрских клише.
! ================================================

#HallChoiceConsequenceText
    $HallChoiceConsequenceEventId = LCASE($ARGS[0])
    $HallChoiceConsequenceChoiceId = LCASE($ARGS[1])
    $HallChoiceConsequenceGirlId = LCASE($ARGS[2])
    $HallChoiceConsequenceText = ''

    if $HallChoiceConsequenceGirlId <> '':
        if $RealName[$HallChoiceConsequenceGirlId] = '':
            if LOC('EnsureGirlData') = 1:
                gs 'EnsureGirlData', $HallChoiceConsequenceGirlId
            end
        end
    end

    if $HallChoiceConsequenceEventId = 'harassment' or $HallChoiceConsequenceEventId = 'hall_harassment':
        gs 'HallChoiceConsequenceTextHarassment'
    elseif $HallChoiceConsequenceEventId = 'hall_lewd':
        gs 'HallChoiceConsequenceTextHallLewd'
    elseif $HallChoiceConsequenceEventId = 'kitchen_lewd':
        gs 'HallChoiceConsequenceTextKitchenLewd'
    elseif $HallChoiceConsequenceEventId = 'hall_missing':
        gs 'HallChoiceConsequenceTextHallMissing'
    elseif $HallChoiceConsequenceEventId = 'kitchen' or $HallChoiceConsequenceEventId = 'kitchen_customer':
        gs 'HallChoiceConsequenceTextKitchen'
    end

    killvar '$HallChoiceConsequenceEventId'
    killvar '$HallChoiceConsequenceChoiceId'
    killvar '$HallChoiceConsequenceGirlId'
---

#HallChoiceConsequenceTextHarassment
    if $HallChoiceConsequenceChoiceId = 'protect_hard':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Зал притихает: пьяные шутники ворчат в кружки, быстро смекнув, что молодой хозяин спуска не даст. ' + $RealName[$HallChoiceConsequenceGirlId] + ' спокойно отходит к стойке, бросая на Стефана одобрительный взгляд — приятно знать, что за спиной стоит надёжная хозяйская рука.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'warn_client':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан веско очерчивает черту: гостеприимство остаётся гостеприимством, пока гости держат руки при себе. Задетый клиент недовольно сопит в усы, но пыл умеряет. В зале уважительно переглядываются: хозяин держит порядок спокойно и без лишнего шума.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'self_handle':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан остаётся на месте, дав ей самой разобраться со столом. ' + $RealName[$HallChoiceConsequenceGirlId] + ' отлично справляется: осаживает гостя точным словом и ловко остужает его пыл. Зал видит, что здешние работницы знают себе цену и в обиду себя не дадут.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'profit':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Звонкая монета со стуком ложится на дубовые доски. Наглец платит втройне за лишнюю вольность, а ' + $RealName[$HallChoiceConsequenceGirlId] + ' с лёгкой усмешкой прячет серебро в карман фартука. Выручка растёт, но Стефан помнит: во всём нужен хозяйский расчёт.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'watch':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан не спускает глаз со стола, держа ситуацию под полным контролем. ' + $RealName[$HallChoiceConsequenceGirlId] + ' чувствует этот внимательный хозяйский взгляд и спокойно ставит гостю рамки, зная, что Стефан наблюдает и готов вмешаться в любой момент.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'ignore':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан делает вид, будто занят счётом и кружками. ' + $RealName[$HallChoiceConsequenceGirlId] + ' сама ловко выскальзывает из неловкого разговора и возвращается к стойке. Дело улажено без шума, но в зале остаётся понимание: каждый здесь отвечает за себя.</i></font>'
    end
---

#HallChoiceConsequenceTextHallLewd
    if $HallChoiceConsequenceChoiceId = 'stop' or $HallChoiceConsequenceChoiceId = 'protect_hard' or $HallChoiceConsequenceChoiceId = 'protect':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан твёрдым хозяйским словом обрывает откровенную сцену. За дальними столами разочарованно вздыхают — зрелище закончилось, толком не начавшись. Зато порядок восстановлен, а ' + $RealName[$HallChoiceConsequenceGirlId] + ' сдержанно оправляет платье: правила под этой крышей диктует хозяин.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'watch':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан наблюдает со стороны, скрестив руки на груди. ' + $RealName[$HallChoiceConsequenceGirlId] + ' ловит его взгляд и ведёт игру по своим правилам: умело держит гостя в разговоре, заставляет того раскошелиться на щедрый заказ и вовремя отступает, не позволяя переступить черту.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'encourage' or $HallChoiceConsequenceChoiceId = 'ignore':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан отворачивается к бочкам, позволяя захмелевшей компании кутить дальше. Серебро льётся в лоток щедрее, смех за столами звучит раскованнее, а ' + $RealName[$HallChoiceConsequenceGirlId] + ' ловко собирает чаевые, прекрасно понимая выгоду для заведения.</i></font>'
    end
---

#HallChoiceConsequenceTextKitchenLewd
    if $HallChoiceConsequenceChoiceId = 'stop' or $HallChoiceConsequenceChoiceId = 'protect_hard' or $HallChoiceConsequenceChoiceId = 'protect':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан одним движением выставляет незваного гостя из кухонного полумрака обратно в общий зал. Кухня — рабочее место, а не угол для пьяных похождений. Сандра лишь одобрительно кивает у плиты: порядок наведён быстро и без пустых пререканий.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'watch':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан задерживается в дверном проёме кухни, наблюдая за происходящим. Сандра чувствует его присутствие за спиной и со знанием дела остужает пыл гостя парой едких слов и взмахом тяжёлого половника.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'ignore' or $HallChoiceConsequenceChoiceId = 'encourage':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан не вмешивается и возвращается к делам в общем зале. Сандра на кухне сама отлично знает, как поставить наглеца на место или заставить его заплатить за двойную порцию жаркого. Главное — чтобы котлы кипели, а монета звенела.</i></font>'
    end
---

#HallChoiceConsequenceTextHallMissing
    if $HallChoiceConsequenceChoiceId = 'ignore_after' or $HallChoiceConsequenceChoiceId = 'ignore':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан шагает обратно к стойке с невозмутимым видом. Если ' + $RealName[$HallChoiceConsequenceGirlId] + ' отлучилась по делу или решила сорвать щедрый куш с клиента — она достаточно сообразительна, чтобы сделать это без лишней опеки.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'peek_scene' or $HallChoiceConsequenceChoiceId = 'peek' or $HallChoiceConsequenceChoiceId = 'watch':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан неслышно приглядывает сквозь щель приоткрытой двери. ' + $RealName[$HallChoiceConsequenceGirlId] + ' держит ситуацию в руках, ловко направляя разгорячённого гостя и не забывая про звонкую монету. Хозяйский надзор остаётся незамеченным.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'peek_meet':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан вырастает на пороге как раз в тот момент, когда сцена в каморке подходит к концу. ' + $RealName[$HallChoiceConsequenceGirlId] + ' моментально прячет выручку и оправляет платье: обошлось без лишнего шума, но оба понимают, что Стефан всё видел.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'interrupt_scene' or $HallChoiceConsequenceChoiceId = 'interrupt' or $HallChoiceConsequenceChoiceId = 'protect_hard' or $HallChoiceConsequenceChoiceId = 'protect':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан распахивает дверь, обрывая тайное свидание. Опешивший гость торопливо поправляет одежду и ретируется в общий зал, а ' + $RealName[$HallChoiceConsequenceGirlId] + ' одёргивает подол: хозяин ясно дал понять, где проходят границы дозволенного.</i></font>'
    end
---

#HallChoiceConsequenceTextKitchen
    if $HallChoiceConsequenceChoiceId = 'stop' or $HallChoiceConsequenceChoiceId = 'protect_hard':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан властной рукой выставляет лишнее тело за порог кухни. В чаду жаровен и звоне посуды посторонним делать нечего. Гости в зале лишний раз зарубят себе на носу: совать нос на хозяйскую кухню без спроса не стоит.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'let_her' or $HallChoiceConsequenceChoiceId = 'self_handle' or $HallChoiceConsequenceChoiceId = 'self':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Стефан позволяет стряпухе самой разобраться с наглецом. Сандра не теряется: острый язык и вид раскалённой сковороды остужают гостя быстрее любого окрика. На кухне снова воцаряется рабочий порядок.</i></font>'
    elseif $HallChoiceConsequenceChoiceId = 'client' or $HallChoiceConsequenceChoiceId = 'profit' or $HallChoiceConsequenceChoiceId = 'encourage':
        $HallChoiceConsequenceText = '<font color="#606080"><i>Гость возвращается к своим кружкам сытый и довольный, а в кухонном лотке остаётся звенеть щедрое серебро за особый заказ. Прибыль получена, обид нет — практичный расчёт снова побеждает пустые споры.</i></font>'
    end
---
