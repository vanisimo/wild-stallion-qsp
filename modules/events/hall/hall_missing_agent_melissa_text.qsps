! [S-ML-14] deepthroat
! try / partial / full / cum_mouth: одно начало, разные концовки (2 экрана).
! cum_throat: полная сцена, first-show + free-random.
! Soft/high нет — слот после лица, Explicit уже 1.
#HallMissingScene_deepthroat_melissa
    gs 'HallMissingHugFingerCount'
    *pl 'Мелисса стоит на коленях перед ' + $HallLewdClientWhoA + ', корсаж распущен, открывая пылающую девичью грудь.'
    *pl ' '
    gs 'HallMissingPrintSelfFingers'
    *pl ' '
    if $HallMissingClient = 'traveler' or $HallMissingClient = 'sailor':
        *pl '— До самого паха, книжница! — властно командует моряк, накрывая её затылок ладонью. — Глотай воздух носом и не вздумай дёргаться!'
    elseif $HallMissingClient = 'craftsman' or $HallMissingClient = 'local':
        *pl '— До конца, красавица, уважь мастера горлышком! — кряхтит ремесленник.'
    else
        *pl '— До живота бери, королева! За глубокую ласку купец золотом осыплет!'
    end
    *pl ' '
    *pl '— Попробую... только без резких рывков... — шепчет Мелисса. Она насаживается на ствол, пока её носик не упирается в курчавые волосы на его паху. Горло её округляется, пропуская головку внутрь, из глаз брызжут слёзки, но пальчики под юбкой бешено растирают клитор и анус, ловя пьянящий кайф от подчинения.'
---
#HallMissingScene_deepthroat_melissa_2
    if $HallMissingFinish = 'cum_throat':
        *pl 'Мужчина крепко держит её затылок, и горячие густые струи семени толчками бьют прямо в глубину пищевода Мелиссы! Её шея судорожно сокращается, проталкивая сперму напрямую в желудок. От этого горячего импульса в горле Мелисса остервенело вдавливает пальцы себе в щель и анус и содрогается в мощнейшем оргазме!'
        *pl ' '
        *pl 'Когда обмякающий ствол выскальзывает из её рта, на языке почти ничего не остаётся — лишь густая слюна. Она слегка покашливает, язычком начисто снимает последние капли с головки и платком подтирает подбородок.'
        orgasms['melissa'] += 1
        gs 'HallMissingRegisterSelfPlay', 1
    elseif $HallMissingFinish = 'cum_mouth':
        *pl 'В последний миг перед извержением мужчина чуть подаётся назад, высвобождая ствол из горла, и щедрые струи горячего семени густо заливают раскрытый рот Мелиссы. Она стойко держит всё внутри, глубоко сглатывает порцию до единой капли, вытирает подбородок салфеткой и начисто подчищает головку члена язычком.'
        gs 'HallMissingRegisterSelfPlay', 0
    elseif $HallMissingFinish = 'full':
        *pl 'Мелисса насаживается до самого основания, но на пике наслаждения мужчина с хрипом выдёргивает член наружу. Горячие, тугие струи бьют ей прямо в лицо — по щекам, векам, полуоткрытым губам и подбородку. Мелисса замирает, тяжело дыша, затем торопливо берёт платочек и тщательно оттирает личико до блеска.'
        gs 'HallMissingRegisterSelfPlay', 0
    elseif $HallMissingFinish = 'partial':
        *pl 'Она вбирает ствол глубже середины, но до самого паха пустить не успевает — гость отстраняется и разряжается ей на обнажённую грудь и ключицы. Белые струи обильно стекают по ложбинке. Мелисса вытирает кожу салфеткой и торопливо затягивает шнуровку корсажа.'
        gs 'HallMissingRegisterSelfPlay', 0
    else
        *pl 'Мелисса пытается заглотить плоть глубже, но давится от непривычного объёма, слёзы брызжут из глаз, и она со сдавленным кашлем отстраняется. Мужчина торопливо доводит себя рукой и с глухим стоном выплёскивает семя на рогожу у бочки. Мелисса ловит ртом воздух, прижимая ладошку к горлу.'
        gs 'HallMissingRegisterSelfPlay', 0
    end
    *pl ' '
    *pl 'Гость оставляет увесистую монету на бочке и выходит. Мелисса сидит секунду, касаясь пальцами своей шеи и переводя дыхание.'
    gs 'HallMissingRegisterMouth'
---
#HallMissingMeet_deepthroat_melissa
    *pl 'Мелисса слегка покашливает, поправляя воротник корсажа, и смущённо смотрит на вас.'
    *pl ' '
    if $HallMissingFinish = 'cum_throat':
        if HadSex['melissa'] >= 1:
            *pl '— Стефан... ты видел? Прямо в горло всё ушло... Горлышко до сих пор горит, а от оргазма ноги не держат! Зайдёшь вечером проверить глубину моего горла?'
            *pl '— Видел, как ты давилась, но сдюжила. Зайду вечером.'
            *pl '— Буду ждать с нетерпением!'
        else
            *pl '— Стефан... он прямо в горло кончил, но я всё проглотила! Зато отвалил кучу денег на мои трактаты! Ты ведь не злишься?'
            *pl '— Не злюсь. Попей водички из кувшина и иди работать.'
            *pl '— Уже бегу, спасибо, Стефан!'
        end
    elseif $HallMissingFinish = 'cum_mouth':
        if HadSex['melissa'] >= 1:
            *pl '— Стефан… он глубоко брал, но кончил в рот. Я всё сглотала! Вечером заглянешь?'
            *pl '— Видел твой глоток. Загляну.'
            *pl '— Жду вечера, Стефан!'
        else
            *pl '— Стефан! Он глубоко засунул, но кончил в рот, я всё до капли проглотила и рот вытерла! Монету забрала!'
            *pl '— Молодец. Ступай в зал.'
            *pl '— Бегу!'
        end
    elseif $HallMissingFinish = 'full':
        if HadSex['melissa'] >= 1:
            *pl '— Стефан… он вынул в последний миг и всё личико мне залил! Но я всё вытерла платком дочиста. Вечером зайдёшь?'
            *pl '— Видел. Лицо чистое. Зайду.'
            *pl '— Буду ждать!'
        else
            *pl '— Стефан… он на лицо кончил, но я платком всё досуха сняла, следов не осталось! Монеты в сундучке!'
            *pl '— Хорошо, что всё вытерла. Ступай в зал.'
            *pl '— Слушаюсь, Стефан!'
        end
    elseif $HallMissingFinish = 'partial':
        if HadSex['melissa'] >= 1:
            *pl '— Стефан… на грудь мне кончил, корсаж еле успела расправить. Вечером зайдёшь проверить?'
            *pl '— Зайду. Ступай за стойку.'
            *pl '— Жду вечером!'
        else
            *pl '— Стефан! Он на грудь мне налил, но я салфеткой всё оттёрла и шнуровку затянула! Не ругайся!'
            *pl '— Молодец. Иди работать.'
            *pl '— Уже бегу!'
        end
    else
        if HadSex['melissa'] >= 1:
            *pl '— Стефан… не удержала, подавилась… Он на пол кончил. Горлышко до сих пор помнит… Вечером утешишь меня?'
            *pl '— Утешу. Ступай в зал.'
            *pl '— Буду ждать, Стефан!'
        else
            *pl '— Стефан… я подавилась и не смогла глубоко взять, он на пол кончил… Но я пол вытерла и монету взяла!'
            *pl '— Главное, что убрала за собой. Ступай к заказам.'
            *pl '— Бегу!'
        end
    end
