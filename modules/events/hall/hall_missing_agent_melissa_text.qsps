#HallMissingScene_cuni_melissa_2
    gs 'HallMissingHugFingerCount'

    if HallMissingBargainExplicit = 1:
        if HallMissingHugFingers >= 3:
            *pl 'Гость жадно вминается носом в её клитор, пальцы погружает глубоко в щель, а горячий влажный язык ловко переводит ниже — и с влажным чавканьем проталкивает кончик прямо внутрь разработанного ануса Мелиссы! Книжница теряет всякий самоконтроль: она громко, протяжно стонет на всю подсобку, запрокидывает голову и судорожно впивается ноготками в волосы гостя, жадно насаживаясь бёдрами на его лицо:'
            *pl '— А-ах!.. Боже мой... прямо в попку... да-а... соси меня... я сейчас кончу!..'
        else
            *pl 'Гость жадно вминается носом в её клитор, а язык заталкивает глубоко в щель, вылизывая соки, попутно оглаживая пальцами её тугой анус. Мелисса больше не сдерживается — она запрокидывает голову, впивается ноготками в его затылок и сама насаживается бёдрами на его лицо:'
            *pl '— А-ах!.. Лижи глубже... соси мой клитор... я сейчас кончу!..'
        end
    elseif $HallMissingInitiative = 'high':
        if HallMissingHugFingers >= 3:
            *pl 'Язык мужчины умело кружит вокруг налившегося бугорка, а затем на мгновение соскальзывает ниже и настойчиво проникает в податливое колечко ануса. Мелисса всхлипывает от неожиданного пронзительного жара, её пальцы судорожно впиваются в край ящика, а из горла вырывается сдавленный, сладострастный стон:'
            *pl '— М-м-мх!.. Что ты делаешь... ах... не останавливайся...'
        else
            *pl 'Язык мужчины умело кружит вокруг налившегося бугорка. Мелисса часто дышит, сжимая край ящика пальцами. Сладкий жар волнами накатывает на низ живота, заставляя её бёдра сладостно подрагивать:'
            *pl '— М-м-м... да... вот так... какой правильный темп... ах!'
        end
    else
        *pl 'Непривычная острая ласка горячим импульсом пробивает всё тело девушки. Мелисса прижимает ладошку ко рту, чтобы не стонать на всю подсобку, но бёдра сами выгибаются навстречу его рту.'
    end
    *pl ' '
    *pl 'Оргазм накрывает Мелиссу сокрушительной волной: ноги её сводит сладкой судорогой, сочащаяся дырочка судорожно пульсирует, омывая язык мужчины девичьим соком, а сама она крупно дрожит, отдаваясь накатившей разрядке:'
    *pl '— А-а-ах!.. Кончаю... боже мой... держи меня!'
    orgasms['melissa'] += 1
