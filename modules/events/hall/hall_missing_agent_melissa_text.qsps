    *pl ' '
    if $HallMissingInitiative = 'high':
        *pl 'Мелисса преданно улыбается, обвивая его шею руками. Интеллектуальный соблазн и близость к миру знати лишают её воли: она сама расстёгивает верхние пуговицы его камзола, извлекает твёрдый ствол и начинает сочно поддрачивать его стоя, прижимаясь бёдрами к бархату.'
    else
        *pl 'Мелисса алеет румянцем, тая от признания её исключительности. Мужчина сжимает её талию, а Мелисса покорно смыкает пальчики на его члене, начиная размеренно двигать рукой.'
    end
    if HallMissingNobleScreens = 1:
        *pl ' '
        *pl 'Дворянин с глубоким вздохом подаётся вперёд, и горячие струи семени выплёскиваются Мелиссе на ладонь и подол платья. Мужчина самодовольно поправляет камзол, целует её пальчики и со снисходительной ухмылкой уходит в зал, не оставив ни единого гроша.'
        *pl ' '
        *pl 'Мелисса торопливо оттирает руки салфеткой, смущённо опуская глаза.'
        gs 'HallMissingRegisterHand'
    end
---

#HallMissingNobleS2_melissa
    *pl 'Дворянин властно направляет её головку к своим бёдрам:'
    *pl '— Опускайся на колени, моя учёная королева. Докажи свою исключительность ротиком…'
    *pl ' '
    if $HallMissingInitiative = 'high':
        *pl 'Мелисса грациозно опускается на колени перед бочкой. Заметив подглядывающего Стефана в щели, она подмигивает вам, широко раскрывает ротик и заглатывает благородный ствол до самого горла, виртуозно двигая головой и лаская мошонку!'
    else
        *pl 'Мелисса покорно приникает губами к члену дворянина, старательно водя ротиком вверх и вниз и доводя его до финала.'
    end
    if HallMissingNobleScreens = 2:
        *pl ' '
        *pl 'Дворянин крепко сжимает её затылок и горячими толчками кончает Мелиссе прямо в рот. Она глубоко сглатывает порцию, вытирая губы тыльной стороной ладони.'
        *pl ' '
        *pl '— Превосходно, милая… Ты истинно благородна душой, — небрежно роняет гость, застёгивает пояс и покидает подсобку без единой монеты.'
        *pl ' '
        *pl 'Мелисса поднимается с колен, поправляя юбку и пряча кружевной платок.'
        gs 'HallMissingRegisterMouth'
    end
---

#HallMissingNobleS3_melissa
    if $HallMissingNobleFinish = '':
        if $HallMissingFinish = 'cum_mouth':
            $HallMissingNobleFinish = 'mouth'
        elseif $HallMissingFinish = 'cum_face':
            $HallMissingNobleFinish = 'face'
        elseif $HallMissingFinish = 'anilingus':
            $HallMissingNobleFinish = 'anilingus'
        else
            noble_rnd = rand(1, 3)
            if noble_rnd = 1:
                $HallMissingNobleFinish = 'mouth'
            elseif noble_rnd = 2:
                $HallMissingNobleFinish = 'face'
            else
                $HallMissingNobleFinish = 'anilingus'
            end
        end
    end

    if $HallMissingNobleFinish = 'mouth':
        *pl 'Дворянин мощными толчками кончает Мелиссе прямо в рот. Мелисса принимает всё до капли, глубоко сглатывает и демонстрирует чистый язычок. Дворянин оглаживает камзол и уходит, не заплатив ни гроша.'
    elseif $HallMissingNobleFinish = 'face':
        *pl '— Вынимай из ротика! — командует дворянин, и горячие струи обильно заливают лоб и щёки Мелиссы. Она ловит капли высунутым язычком, стирает остатки платком, а дворянин вальяжно выходит без единого медяка.'
    else
        *pl 'Дворянин поворачивается спиной, требуя ласки сзади. Мелисса горячо вылизывает его анус, а в момент оргазма семя выплёскивается ей на тёмные кудри. Дворянин гордо уходит, не оставив ни монеты.'
    end
    gs 'HallMissingRegisterMouth'
---

#HallMissingNobleShow_melissa
    if LOC('SceneShowVisual') = 1:
        gs 'SceneShowVisual', 'images/events/melissa/hall_missing/storage/noble_s' + STR(HallMissingNobleCur), 'missing noble Мелисса: экран ' + STR(HallMissingNobleCur) + '/' + STR(HallMissingNobleScreens) + ' — подсобка, дворянин', 'large', 'webp'
    end
    *pl '─── НОБИЛЬ МЕЛИССА экран ' + STR(HallMissingNobleCur) + '/' + STR(HallMissingNobleScreens) + ' ───'
    *pl ' '

    if HallMissingNobleCur = 1:
        gs 'HallMissingNobleS1_melissa'
    elseif HallMissingNobleCur = 2:
        gs 'HallMissingNobleS2_melissa'
    else
        gs 'HallMissingNobleS3_melissa'
    end

    *pl ' '
    if HallMissingNobleCur < HallMissingNobleScreens:
        gs 'ActUiPrepare', 'Смотреть дальше…', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            HallMissingNobleCur += 1
            *clr
            clr
            cla
            if LOC('ShowGirlSidebar') = 1:
                gs 'ShowGirlSidebar', 'melissa'
            end
            gs 'HallMissingNobleShow_melissa'
        end
    else
        gs 'HallMissingMeet_noble_melissa'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            HallMissingNobleMulti = 0
            if $HallMissingReturnLoc = '':
                $HallMissingReturnLoc = 'TavernMain'
            end
            gt $HallMissingReturnLoc
        end
    end
---

#HallMissingMeet_noble_melissa
    *pl 'Мелисса выскальзывает из подсобки, поправляя подол платья. Её щёки горят густым румянцем, а во взгляде растерянность и стыд. Вы встречаете её в гневе:'
    *pl ' '
    *pl '— Мелисса! Ты совсем сдурела?! Этот павлиний урод назвал тебя королевой, заманил в подсобку и поимел нахаляву, не заплатив ни единого медяка и даже не глянув на твои стихи!'
    *pl ' '
    *pl 'Мелисса виновато опускает глаза, её губы подрагивают от стыда:'
    if HallMissingNobleScreens = 1:
        *pl '— Стефан… прости меня… Я позволила себе поверить его высокопарным речам про искусство и помогла руками… А он лишь посмеялся и ушёл! Сыграл на моей гордыне… Прости меня, Стефан, я была такой наивной дурой…'
    elseif HallMissingNobleScreens = 2:
        *pl '— Стефан… прости меня… Он обещал стать моим покровителем, а сам заставил встать на колени и взять в рот… А стихи даже слушать не стал! Прости, я так глупо поддалась его лести…'
    else
        *pl '— Стефан… прости меня… Прости, я совершила такую невыносимо глупую ошибку… Он говорил так красиво, обещал послушать мои стихи… А сам даже строчки не выслушал! Сыграл на моей гордыне, чтобы затащить в подсобку… Прости меня, Стефан, я была такой наивной дурой…'
    end
    $HallMissingNobleFinish = ''
---
