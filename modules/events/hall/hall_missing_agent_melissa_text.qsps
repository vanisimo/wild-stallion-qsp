#HallMissingScene_cuni_melissa_3
    gs 'HallMissingHugFingerCount'
    *pl 'Мужчина тяжело дышит, вытирает рот тыльной стороной ладони, поднимается на ноги и тут же принимается быстро надрачивать свой налившийся ствол перед её разведёнными ножками.'
    *pl ' '
    if $HallMissingClient = 'traveler' or $HallMissingClient = 'sailor':
        *pl '— Стой смирно, красавица! — сипит моряк. — За такой девичий мёд моряк щедро отплатит!'
    elseif $HallMissingClient = 'craftsman' or $HallMissingClient = 'local':
        *pl '— Ублажила мастера, Мелиссочка, — хрипит мастеровой, — прими горячий дар!'
    else
        *pl '— Купец своё слово держит! — довольно урчит купец.'
    end
    *pl ' '
    if HallMissingCuniToAnilingus = 1 or (HallMissingBargainExplicit = 1 and $HallMissingInitiative = 'high'):
        *pl 'Мелисса, ещё не оправившись от оргазма, разворачивается спиной к мужчине и встаёт на четвереньки прямо на ящике, глубоко прогибая поясницу. Она руками с силой раздвигает ягодицы, открывая мужчине вид на обе свои разгорячённые дырочки:'
        *pl '— Раз уж достал... кончай прямо на мою попку! — выдыхает она.'
        *pl ' '
        if HallMissingHugFingers >= 3:
            *pl 'Широко растянутое от ласк колечко ануса остаётся влажно приоткрытым и судорожно подрагивает. Густые горячие струи семени бьют точно по попке — белёсые потёки обильно затекают прямо в приоткрытую дырочку и медленно сочатся по межъягодичной складке к бёдрам.'
        else
            *pl 'Аккуратный розовый анус мелко пульсирует, постепенно смыкаясь после ласки. Горячие толчки семени заливают нежную кожу ягодиц и анус, часть спермы затекает в подрагивающую девичью дырочку, а излишки стекают вниз.'
        end
        *pl ' '
        *pl 'Мелисса изгибается, находит пальчиками тёплый подтёк на попе, пробует на кончике языка, а остаток начисто оттирает платочком. Обернувшись, она аккуратно язычком подчищает головку гостя:'
        *pl '— Вот теперь всё чисто.'
        gs 'HallMissingRegisterAnil'
    else
        *pl '— На живот и киску! — командует Мелисса. — Не на платье!'
        *pl ' '
        if HallMissingHugFingers >= 3:
            *pl 'Распаренная девичья щель остаётся приоткрытой и сладостно пульсирует в такт угасающему оргазму. Густые белёсые струи спермы мощными толчками выплёскиваются прямо в раскрытую дырочку, глубоко затекая внутрь и смешиваясь с прозрачной девичьей смазкой, а излишки текут по бёдрам и низу живота.'
        else
            *pl 'Густые горячие струи семени толчками выплёскиваются Мелиссе прямо на обнажённую, сочащуюся соками щель и низ живота, затекая в подрагивающую розовую ложбинку и смешиваясь с её собственными соками.'
        end
        *pl ' '
        if HallMissingBargainExplicit = 1:
            *pl 'Мелисса с томной улыбкой проводит пальчиком по мокрой щели, собирает белёсые капли спермы вперемешку со своими соками и медленно, со вкусом слизывает с пальца:'
            *pl '— М-м... терпко и солоновато... щедрый финал процедуры...'
        elseif $HallMissingInitiative = 'high':
            *pl 'Мелисса ловит капли пальцами, пробует терпкий вкус на кончике языка, а остальное начисто оттирает платочком.'
        else
            *pl 'Мелисса смущённо переводит дыхание, глядя на растёкшееся семя, и торопливо затирает всё чистым платочком досуха.'
        end
        gs 'HallMissingRegisterCuni'
    end
    *pl ' '
    if GirlNoPantiesWork['melissa'] = 1:
        *pl 'Она опускает подол, поправляет корсаж и сгребает оставленные монеты с крышки ящика.'
    else
        *pl 'Она натягивает обратно бельё, опускает подол, поправляет корсаж и сгребает оставленные монеты с крышки ящика.'
    end
