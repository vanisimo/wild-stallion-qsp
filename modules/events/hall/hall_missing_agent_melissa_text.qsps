! [S-ME-21] mouth_taste — капля на язык, не глоток-шоу.
#HallMissingScene_mouth_taste_melissa
    *pl 'Мелисса на коленях у ящиков. Перед ней ' + $HallLewdClientWho + '. Уговор — вкус, не том.'
    *pl ' '
    if $HallMissingClient = 'traveler' or $HallMissingClient = 'sailor':
        *pl '— На язык, русалка. Каплю. Шторм целиком — в другой главе.'
    elseif $HallMissingClient = 'craftsman' or $HallMissingClient = 'local':
        *pl '— Лизни, девка. Вкус узнай. Глотать не заставляю.'
    else
        *pl '— Дегустация, умница. Не издание.'
    end
    *pl ' '
    if $HallMissingInitiative = 'high' or HallMissingBargainExplicit = 1:
        *pl 'Берёт головку, языком по щели, втягивает. Когда пульс сбивается — сдёргивает губы, ловит каплю, держит на языке секунду, как абзац, и глотает только это. Остальное — салфетка с ладони и ствола.'
        *pl '— Попробовала. Глоток в прайсе не стоял. Спинтрии — на ящик.'
    else
        *pl 'Коротко облизывает, бровь вверх. Капля на губе — внутрь. Финиш ему в салфетку у её пальцев.'
        *pl '— Вкус есть. Поэма — нет.'
    end
    *pl ' '
    *pl 'Монеты. Губы начисто. Следов нет. Серебро уже её.'
    gs 'HallMissingRegisterMouth'
