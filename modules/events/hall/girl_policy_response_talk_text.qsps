! ================================================
! FILE: modules/events/hall/girl_policy_response_talk_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Разговор «как выполнила правило» после GirlPolicyResponse
! Stage: 0 refuse / 1 reluctant / 2 obey / 3 eager / 4 overstep
! ================================================

#GirlPolicyResponseTalkPrintText
    gs 'GirlPolicyResponseTalkText', $ARGS[0]

    if $GirlPolicyResponseTalkText <> '':
        *pl $GirlPolicyResponseTalkText
    end
---

#GirlPolicyResponseTalkText
    $GirlPolicyResponseTalkTextId = LCASE($ARGS[0])
    $GirlPolicyResponseTalkText = ''
    PolicyResponseStage = GirlPolicyLastResponse[$PolicyResponseTalkGirl]
    PolicyTalkRule = GirlPolicyLastRule[$PolicyResponseTalkGirl]

    if $RealName[$PolicyResponseTalkGirl] = '':
        gs 'EnsureGirlData', $PolicyResponseTalkGirl
    end

    if $GirlPolicyResponseTalkTextId = 'intro':
        if PolicyResponseStage = 0:
            if $PolicyResponseTalkGirl = 'amanda':
                $GirlPolicyResponseTalkText = 'Аманда стоит, сцепив пальцы. Нервничает не от страха, а от собственной растерянности: «Я… я помню, что ты говорил. Но не смогла через себя переступить. Мне было правда неприятно».'
            elseif $PolicyResponseTalkGirl = 'melissa':
                $GirlPolicyResponseTalkText = 'Мелисса смотрит прямо, без дежурной улыбки: «Ты сам-то веришь в это правило, Стефан? Или просто хотел проверить, промолчу я или нет?»'
            elseif $PolicyResponseTalkGirl = 'sandra':
                $GirlPolicyResponseTalkText = 'Сандра молча вытирает руки. Взгляд суровый, взрослый: «Наказать меня хочешь? На кухне порядок я держу, а глупых указаний мне давать не надо».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' не приняла правило. Стоит напряжённо и ждёт, что вы скажете дальше.'
            end
        elseif PolicyResponseStage = 1:
            if $PolicyResponseTalkGirl = 'amanda':
                $GirlPolicyResponseTalkText = 'Аманда мнётся, опустив глаза: «Я честно пыталась… Но трудно улыбаться, когда чувствуешь себя не на своём месте».'
            elseif $PolicyResponseTalkGirl = 'melissa':
                $GirlPolicyResponseTalkText = 'Мелисса коротко кивает: «Сделала, как просил. Только давай без иллюзий: выручка — это одно, а разыгрывать покорность я не собираюсь».'
            elseif $PolicyResponseTalkGirl = 'sandra':
                $GirlPolicyResponseTalkText = 'Сандра поправляет фартук: «Выполнила. Без особого желания. Если каждый день так работать — сама касса радовать перестанет».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' выполнила правило через силу и не скрывает этого.'
            end
        elseif PolicyResponseStage <= 3:
            if PolicyTalkRule = 3:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' говорит ровно: «Сделала, как договаривались. Клиент доволен, серебро в кассе. Обычная работа».'
            elseif PolicyTalkRule = 1:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' кивает: «Держалась строго. Границу поставила сразу — так и работать спокойнее».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' спокойно отзывается: «Справилась сама. Всё прошло нормально, границы я удержала».'
            end
        else:
            if $PolicyResponseTalkGirl = 'amanda':
                $GirlPolicyResponseTalkText = 'Аманда заливается краской: «Я… кажется, увлеклась немного больше, чем ты говорил. Не сразу сообразила, где остановиться».'
            elseif $PolicyResponseTalkGirl = 'melissa':
                $GirlPolicyResponseTalkText = 'Мелисса чуть усмехается: «Перегнула с улыбками? Может быть. Ты дал свободу — я посмотрела, как далеко готов зайти клиент».'
            elseif $PolicyResponseTalkGirl = 'sandra':
                $GirlPolicyResponseTalkText = 'Сандра смотрит твёрдо: «Сделала чуть больше обычного. Выручка от этого только выиграла, а за границы я зайти не дала».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' зашла дальше правила и теперь ждёт вашей реакции.'
            end
        end

    elseif $GirlPolicyResponseTalkTextId = 'hard':
        if $PolicyResponseTalkGirl = 'amanda':
            $GirlPolicyResponseTalkText = 'Вы говорите жёстко. Аманда краснеет, но сжимает губы: «Если всё равно будешь ругать… тогда зачем вообще спрашивать, как у меня дела?»'
        elseif $PolicyResponseTalkGirl = 'melissa':
            $GirlPolicyResponseTalkText = 'Вы давите тоном. Мелисса слушает молча, чуть вздёрнув подбородок: «Говори что хочешь, Стефан. Но командующего из себя передо мной не строй».'
        elseif $PolicyResponseTalkGirl = 'sandra':
            $GirlPolicyResponseTalkText = 'Вы ставите точку жёстко. Сандра отзывается сурово и холодно: «Ты ещё не настолько вырос, чтобы кричать на меня. Хочешь дела делать — говори по-человечески».'
        else:
            $GirlPolicyResponseTalkText = 'Жёсткий разговор ставит её на место, но во взгляде появляется отчуждение.'
        end

    elseif $GirlPolicyResponseTalkTextId = 'calm':
        if $PolicyResponseTalkGirl = 'amanda':
            $GirlPolicyResponseTalkText = 'Вы говорите спокойно. Аманда выдыхает и расслабляет плечи: «Спасибо, что… не кричишь. Мне важно понимать, почему мы делаем именно так».'
        elseif $PolicyResponseTalkGirl = 'melissa':
            $GirlPolicyResponseTalkText = 'Вы аргументируете спокойно. Мелисса кивает: «Когда ты говоришь дело, а не командуешь ради тона — со мной намного проще договориться».'
        elseif $PolicyResponseTalkGirl = 'sandra':
            $GirlPolicyResponseTalkText = 'Вы говорите без нажима. Сандра слушает спокойнее: «Вот это разговор. Без хозяйских замашек и дело спорится быстрее».'
        else:
            $GirlPolicyResponseTalkText = 'Спокойный тон сглаживает углы. Она слушает гораздо внимательнее.'
        end

    elseif $GirlPolicyResponseTalkTextId = 'admit':
        if $PolicyResponseTalkGirl = 'amanda':
            $GirlPolicyResponseTalkText = 'Вы признаёте, что требование могло быть не самым простым. Аманда смотрит с удивлением: «Я думала, ты разозлишься... Спасибо, Стефан. Мне правда стало легче».'
        elseif $PolicyResponseTalkGirl = 'melissa':
            $GirlPolicyResponseTalkText = 'Вы признаёте спорность указания. Мелисса смягчается: «Уважение в том и состоит, чтобы уметь признать ошибку. Я это ценю».'
        elseif $PolicyResponseTalkGirl = 'sandra':
            $GirlPolicyResponseTalkText = 'Вы признаёте, что перегнули. Сандра молчит, затем кивает: «Умение признать промах — черта взрослого мужчины. Ладно, проехали».'
        else:
            $GirlPolicyResponseTalkText = 'Вы признаёте, что правило было спорным. Разговор непростой, но честность оставляет хорошее впечатление.'
        end
    else:
        $GirlPolicyResponseTalkText = ''
    end

    killvar '$GirlPolicyResponseTalkTextId'
    killvar 'PolicyResponseStage'
    killvar 'PolicyTalkRule'
---
