! ================================================
! FILE: modules/events/hall/girl_policy_response_talk_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Разговор «как выполнила правило» после GirlPolicyResponse
! Stage: 0 refuse / 1 reluctant / 2 obey / 3 eager / 4 overstep
! ================================================

#GirlPolicyResponseTalkPrintText
    gs 'GirlPolicyResponseTalkText', $ARGS[0]

    if $GirlPolicyResponseTalkText <> '':
        *pl $GirlPolicyResponseTalkText
    end
---

#GirlPolicyResponseTalkText
    $GirlPolicyResponseTalkTextId = LCASE($ARGS[0])
    $GirlPolicyResponseTalkText = ''
    PolicyResponseStage = GirlPolicyLastResponse[$PolicyResponseTalkGirl]
    PolicyTalkRule = GirlPolicyLastRule[$PolicyResponseTalkGirl]

    if $RealName[$PolicyResponseTalkGirl] = '':
        gs 'EnsureGirlData', $PolicyResponseTalkGirl
    end

    if $GirlPolicyResponseTalkTextId = 'intro':
        if PolicyResponseStage = 0:
            if $PolicyResponseTalkGirl = 'amanda':
                $GirlPolicyResponseTalkText = 'Аманда стоит перед вами, нервно теребя краешек фартука и сцепив тонкие девичьи пальчики до белизны. В её ясных глазах блестят непролитые слёзы, но в голосе звучит твёрдая нотка: «Стефан... я помню каждое твоё слово про выгоду. Но я просто не смогла переломить себя, понимаешь? Когда этот гость потянул свои сальные руки к моему поясу, мне стало так гадко и тошно... Не могу я так. Хоть убей меня, не могу».'
            elseif $PolicyResponseTalkGirl = 'melissa':
                $GirlPolicyResponseTalkText = 'Мелисса встречает ваш взгляд с безупречно прямой спиной, скрестив руки на груди, а в её насмешливом прищуре читается неприкрытая снисходительность: «Ты всерьёз полагал, Стефан, будто я брошусь исполнять этот нелепый каприз? Торговать дешёвыми ужимками перед неотёсанными мужланами ради пары серебряных монет — затея, лишённая всякой логики и достоинства. Я сделаю трактиру кассу умом, но балаган устраивать не стану».'
            elseif $PolicyResponseTalkGirl = 'sandra':
                $GirlPolicyResponseTalkText = 'Сандра неторопливо отирает руки о льняное полотенце, глядя на вас тяжёлым, материнским взглядом из-под сдвинутых бровей: «Что, отчитывать меня вздумал, Стефан? Я на этой кухне спину гнула ещё когда ты пешком под стол ходил. Порядок я блюду железный, но заигрывать с пьяным сбродом у своей печи не стану — и глупых приказов мне раздавать не смей».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' наотрез отказывается принимать подобное правило. Она стоит перед вами напряжённая, всем видом показывая, что за перешагивание через её гордость придётся держать ответ.'
            end
        elseif PolicyResponseStage = 1:
            if $PolicyResponseTalkGirl = 'amanda':
                $GirlPolicyResponseTalkText = 'Аманда виновато мнётся, пряча глаза в дощатый пол: «Я честно... честно пыталась сделать всё так, как ты велел, Стефан. Но это так трудно — натягивать весёлую улыбку и ворковать со столами, когда внутри всё сжимается от неловкости и стыда...»'
            elseif $PolicyResponseTalkGirl = 'melissa':
                $GirlPolicyResponseTalkText = 'Мелисса сухо и холодно роняет, поправляя выбившийся локон: «Я выполнила твоё предписание ровно настолько, насколько требовала выручка. Но давай сразу без иллюзий, братец: звонкая монета в лотке лежит, а вот изображать перед тобой счастливую покорность я категорически не намерена».'
            elseif $PolicyResponseTalkGirl = 'sandra':
                $GirlPolicyResponseTalkText = 'Сандра недовольно поправляет плотную косынку на висках: «Сделала, как ты велел. Через силу и без всякой радости. Только если превратить такое потакание гостям в постоянный закон, Стефан — скоро от нашей доброй славы останутся одни пьяные плевки».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' неохотно подчинилась распоряжению, но в её сдержанном тоне ясно читается глубокая внутренняя досада.'
            end
        elseif PolicyResponseStage <= 3:
            if PolicyTalkRule = 3:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' говорит ровно и уверенно, с лёгкой полуулыбкой: «Всё вышло в точности так, как ты просил. Гость ушёл довольный, мошна трактира пополнилась звонким серебром, а за черту я его не пустила. Обычная трактирная сноровка — ничего лишнего».'
            elseif PolicyTalkRule = 1:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' с достоинством кивает: «Я держалась строго и холодно, как ты наказал. Границу очертила с первого слова — и знаешь, так работать куда спокойнее: гости понимают рамки и не лезут на рожон».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' спокойно пожимает плечами: «Я со всем разобралась сама, как ты и предоставил. Обстановка осталась под контролем, монета в кассе, а лишних вольностей я гостям спустить не позволила».'
            end
        else:
            if $PolicyResponseTalkGirl = 'amanda':
                $GirlPolicyResponseTalkText = 'Аманда мгновенно заливается густым маковым румянцем до самых ключиц, теребя подол: «Стефан... я, кажется, правда немного заигралась с этим столом. Сначала просто хотела выпросить побольше медяков, а потом... азарт какой-то накатил, и я не сразу сообразила, что перешагнула край... Ты очень злишься?»'
            elseif $PolicyResponseTalkGirl = 'melissa':
                $GirlPolicyResponseTalkText = 'Мелисса насмешливо щурит умные глаза, и на её губах играет лукавая полуулыбка зазнайки: «Считаешь, что я перегнула палку с раскованностью? Возможно. Но ты сам дал мне карт-бланш, Стефан. Мне было чертовски любопытно провести чистый социальный эксперимент и посмотреть, как далеко способен зайти этот наглец, если дать ему крошечную надежду».'
            elseif $PolicyResponseTalkGirl = 'sandra':
                $GirlPolicyResponseTalkText = 'Сандра веско и твёрдо встречает ваш взгляд, уперев кулак в бок: «Поступила резче обычного, не спорю. Но зато этот наглец вывернул карманы до последнего гроша и убрался восвояси на цыпочках. Доход в доме есть, а за святой порог кухни я его лапам хода не дала».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' зашла в общении с гостями значительно дальше положенного правила и теперь внимательно, с затаённым любопытством ждёт, как поведёт себя хозяин.'
            end
        end

    elseif $GirlPolicyResponseTalkTextId = 'hard':
        if $PolicyResponseTalkGirl = 'amanda':
            $GirlPolicyResponseTalkText = 'Вы чеканите слова жёстко и строго, не допуская возражений. Аманда вздрагивает, её ресницы испуганно трепещут, а щёки вспыхивают обиженным жаром: «Если ты всё равно собирался только отчитывать и ругать меня... зачем было вообще спрашивать, каково мне за этими столами?!» — бросает она, поспешно отворачиваясь, чтобы скрыть дрожащие губы.'
        elseif $PolicyResponseTalkGirl = 'melissa':
            $GirlPolicyResponseTalkText = 'Вы пытаетесь задавить её тяжёлым командным тоном. Мелисса выслушивает тираду с ледяным спокойствием, лишь чуть выше вздёрнув острый подбородок: «Ты можешь сотрясать воздух сколько угодно, Стефан. Но не пытайся строить из себя грозного военачальника передо мной — на меня дешёвый хозяйский крик не действует, а вот уважение потерять очень легко».'
        elseif $PolicyResponseTalkGirl = 'sandra':
            $GirlPolicyResponseTalkText = 'Вы обрушиваете на неё суровый выговор. Сандра медленно скрещивает руки на груди и обжигает вас колючим, остужающим взглядом: «Ты, Стефан, ещё силой не дорос на меня голос повышать. Если хочешь быть настоящим хозяином дома — говори делом и по совести, а барские замашки оставь для портовых гуляк».'
        else:
            $GirlPolicyResponseTalkText = 'Жёсткий окрик быстро ставит её на место и обрывает спор, однако во взгляде вспыхивает холодная искра затаённого отчуждения.'
        end

    elseif $GirlPolicyResponseTalkTextId = 'calm':
        if $PolicyResponseTalkGirl = 'amanda':
            $GirlPolicyResponseTalkText = 'Вы говорите негромко, мягко раскладывая всё по полочкам без лишнего упрёка. Аманда с облегчением шумно выдыхает, её напряжённые плечики опускаются: «Спасибо тебе, Стефан... правда спасибо, что не стал кричать. Мне просто нужно было услышать, что ты не бросаешь меня одну и сам понимаешь, как это непросто».'
        elseif $PolicyResponseTalkGirl = 'melissa':
            $GirlPolicyResponseTalkText = 'Вы спокойно и логично приводите веские доводы, не пытаясь давить авторитетом. Мелисса удовлетворённо кивает, и в её глазах мелькает искра неподдельного уважения: «Вот теперь это конструктивный диалог зрелых людей. Когда ты оперируешь здравым смыслом, а не слепым упрямством — находить общий язык с тобой одно удовольствие».'
        elseif $PolicyResponseTalkGirl = 'sandra':
            $GirlPolicyResponseTalkText = 'Вы излагаете свои мысли рассудительно, без лишнего гонора и нажима. Сандра слушает внимательно, морщины на её челе постепенно разглаживаются: «Вот это по-нашему, по-людски. Когда хозяин говорит с умом и уважением к чужому труду — и дело спорится втрое быстрее».'
        else:
            $GirlPolicyResponseTalkText = 'Спокойный, взвешенный тон мгновенно сглаживает остроту момента. Она слушает вас с заметно большим доверием и готовностью идти навстречу.'
        end

    elseif $GirlPolicyResponseTalkTextId = 'admit':
        if $PolicyResponseTalkGirl = 'amanda':
            $GirlPolicyResponseTalkText = 'Вы честно признаёте, что ваше требование было не самым справедливым и легло на неё тяжёлым бременем. Аманда смотрит на вас с искренним изумлением, её взгляд теплеет, а на губах расцветает робкая девичья улыбка: «Стефан... Я думала, ты начнёшь злиться и топать ногами. Спасибо тебе... Мне правда сразу стало намного легче на душе».'
        elseif $PolicyResponseTalkGirl = 'melissa':
            $GirlPolicyResponseTalkText = 'Вы прямо признаёте спорность и шероховатость своего распоряжения. Лицо Мелиссы заметно смягчается, насмешливая маска спадает: «Умение признать собственную неправоту перед подчинёнными — признак подлинного интеллекта и силы духа, Стефан. Я искренне ценю это в тебе».'
        elseif $PolicyResponseTalkGirl = 'sandra':
            $GirlPolicyResponseTalkText = 'Вы открыто говорите, что погорячились с наказом и перегнули палку. Сандра несколько мгновений молча вглядывается в ваше лицо, а затем одобрительно и веско кивает: «Признать свой промах перед старшими — поступок взрослого, зрелого мужика. Молодец, Стефан. Проехали, работаем дальше».'
        else:
            $GirlPolicyResponseTalkText = 'Вы без увиливаний признаёте огрехи своего правила. Разговор выходит непростым, но ваша мужская прямота и честность вызывают глубокое уважение.'
        end
    else:
        $GirlPolicyResponseTalkText = ''
    end

    killvar '$GirlPolicyResponseTalkTextId'
    killvar 'PolicyResponseStage'
    killvar 'PolicyTalkRule'
---
