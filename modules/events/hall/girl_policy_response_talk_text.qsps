! ================================================
! FILE: modules/events/hall/girl_policy_response_talk_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Разговор «как выполнила правило» после GirlPolicyResponse
! Stage: 0 refuse / 1 reluctant / 2 obey / 3 eager / 4 overstep
! ================================================

#GirlPolicyResponseTalkPrintText
    gs 'GirlPolicyResponseTalkText', $ARGS[0]

    if $GirlPolicyResponseTalkText <> '':
        *pl $GirlPolicyResponseTalkText
    end
---

#GirlPolicyResponseTalkText
    $GirlPolicyResponseTalkTextId = LCASE($ARGS[0])
    $GirlPolicyResponseTalkText = ''
    PolicyResponseStage = GirlPolicyLastResponse[$PolicyResponseTalkGirl]
    PolicyTalkRule = GirlPolicyLastRule[$PolicyResponseTalkGirl]

    if $RealName[$PolicyResponseTalkGirl] = '':
        gs 'EnsureGirlData', $PolicyResponseTalkGirl
    end

    if $GirlPolicyResponseTalkTextId = 'intro':
        if PolicyResponseStage = 0:
            if $PolicyResponseTalkGirl = 'amanda':
                $GirlPolicyResponseTalkText = 'Аманда упрямо вскидывает подбородок и задорно фыркает, скрестив руки на груди: «Стефан, ну ты сам его видел! Мы с тобой говорили, что можно быть поприветливее, но этот тип сразу начал хамить и совать руки куда не просят. Я  официантка, а не легкодоступная девушка, чтобы улыбаться каждому грубияну. С нормальными гостями я поболтаю с удовольствием, а с этим возись сам!»'
            elseif $PolicyResponseTalkGirl = 'melissa':
                $GirlPolicyResponseTalkText = 'Мелисса встречает вас с безупречно прямой осанкой, насмешливо приподняв бровь: «Стефан, твоё предложение быть любезнее ради прибылей звучало занятно в теории, но на практике этот гость оказался редким хамом без капли воображения. Слушать его плоские шутки — пытка для слуха и напрасная трата времени. Мужскую глупость я готова терпеть лишь тогда, когда она щедро оплачивается и не переходит границ. Так что этот стол я вычеркнула из списка своего внимания».'
            elseif $PolicyResponseTalkGirl = 'sandra':
                $GirlPolicyResponseTalkText = 'Сандра спокойно отряхивает фартук, глядя на вас с суховатой материнской усмешкой: «И не смотри на меня так строго, Стефан. Мы с тобой обсуждали, как привлечь гостей, но на кухне я хозяйка. Если пьяный гость лезет с глупостями к плите — он получает от меня не улыбку, а поварешкой в лоб. Порядок в трактире держится на уважении, а не на уступках пяным клиентам, и ты это прекрасно знаешь».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' спокойно и твёрдо встречает ваш взгляд: «Мы говорили о приветливости, но этот гость перешёл черту. Улыбаться хамам я не стану — у меня есть собственное достоинство, и в зале я рассчитываю на уважение, а не на потакание любой наглости».'
            end
        elseif PolicyResponseStage = 1:
            if $PolicyResponseTalkGirl = 'amanda':
                $GirlPolicyResponseTalkText = 'Аманда чуть заметно надувает губки и неловко ведёт плечиком: «Ну, я попробовала быть с ними помилее, как ты советовал... Но вышло как-то натянуто. Мужики попались шумные, шутки у них дурацкие, и я всё время чувствовала себя не в своей тарелке. Монеты они, конечно, оставили, но радости от этого никакой».'
            elseif $PolicyResponseTalkGirl = 'melissa':
                $GirlPolicyResponseTalkText = 'Мелисса с лёгкой гримасой поправляет волосы, закатывая глаза: «Я сделала над собой усилие и поддержала разговор, мне нужны деньги. Но признаюсь, Стефан: выслушивать их убогие комплименты было невыносимо скучно. Надеюсь, в следующий раз за этим столом окажется кто-то с более высоким запасом слов, иначе никаких денег не хватит на возмещение моих моральных страданий».'
            elseif $PolicyResponseTalkGirl = 'sandra':
                $GirlPolicyResponseTalkText = 'Сандра сдержанно качает головой: «Я уступила твоей просьбе и не вышвыриаю клиентов с кухни прежде чем они рот откроют, Стефан. Но всё-таки с такими поблажками надо держать ухо востро: если слишком часто спускать гостям вольности, они быстро забудут, где находятся».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' слегка хмурится, вздыхая: «Я постаралась уладить всё миром и быть любезнее, как мы обсуждали. Но компания попалась непростая, и поддерживать такой разговор было не слишком приятно. Главное, что всё обошлось без лишнего шума».'
            end
        elseif PolicyResponseStage <= 3:
            if PolicyTalkRule = 3:
                if $PolicyResponseTalkGirl = 'amanda':
                    $GirlPolicyResponseTalkText = 'Аманда сияет озорной улыбкой: «Стефан, ты видел, как они растаяли? Стоило пару раз улыбнуться и пошутить про пенную шапку на кружке — и монеты посыпались сами собой! И гость счастлив, и я довольна, и в кассе звенит. По-моему, отличный получился вечер!»'
                elseif $PolicyResponseTalkGirl = 'melissa':
                    $GirlPolicyResponseTalkText = 'Мелисса с лёгкой снисходительной усмешкой поправляет рукав: «Мужская психология до смешного проста, Стефан. Достаточно было слегка польстить их самолюбию и вовремя подлить вина — и они послушно выложили серебро, воображая себя галантными рыцарями. Часть монет, разумеется, пойдёт на пополнение моей книжной полки — за труды».'
                elseif $PolicyResponseTalkGirl = 'sandra':
                    $GirlPolicyResponseTalkText = 'Сандра удовлетворённо кивает, вытирая руки: «Всё обошлось мирно и с толком. Гости сыты, выпивка продана, а лишних разговоров я не допустила. Когда хозяин и кухня действуют слаженно — и в доме достаток, и честь на месте».'
                else:
                    $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' говорит с лёгкой уверенной улыбкой: «Всё прошло гладко: пара вежливых фраз, вовремя поданный заказ — и гость доволен, и серебро в кассе. Обычная сноровка, ничего сложного».'
                end
            elseif PolicyTalkRule = 1:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' с достоинством кивает: «Я держалась строго и сдержанно, как мы и решили. Границу очертила сразу — и знаешь, так работать куда спокойнее: гости понимают рамки и не лезут на рожон».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' спокойно пожимает плечами: «Я со всем разобралась сама. Обстановка осталась под контролем, монета в кассе, а лишних вольностей я гостям спустить не позволила».'
            end
        else:
            if $PolicyResponseTalkGirl = 'amanda':
                $GirlPolicyResponseTalkText = 'Аманда смущённо хихикает и слегка краснеет, пряча лукавые искорки в глазах: «Ой, Стефан... кажется, я и правда немного увлеклась с этим столом! Сначала просто хотела выманить чаевые пощедрее, а потом как-то само пошло — они рты разинули, а мне весело стало... Ну ладно тебе, не хмурься, я же знаю берега!»'
            elseif $PolicyResponseTalkGirl = 'melissa':
                $GirlPolicyResponseTalkText = 'Мелисса насмешливо щурит глаза, на её губах играет лукавая улыбка: «Считаешь, я перегнула палку с любезностью? Возможно. Но ты сам советовал быть раскованнее, Стефан. Мне было любопытно провести маленький эксперимент и посмотреть, как далеко зайдёт этот простофиля, если подарить ему каплю ложной надежды. Не волнуйся, монеты у меня, а его пыл я остудила одним холодным словом».'
            elseif $PolicyResponseTalkGirl = 'sandra':
                $GirlPolicyResponseTalkText = 'Сандра веско упирает руку в бок, глядя на вас без тени смущения: «Да, приструнила его жестче обычного, не спорю. Зато этот горлопан вывернул карманы до последнего гроша и убрался восвояси тише воды, ниже травы. Доход в трактире есть, порядок соблюдён, а на моей кухне лишних вольностей не будет никогда».'
            else:
                $GirlPolicyResponseTalkText = $RealName[$PolicyResponseTalkGirl] + ' слегка усмехается, ловя ваш взгляд: «Пожалуй, я немного увлеклась и зашла чуть дальше обычного. Но зато гость оставил солидные чаевые и остался в полном восторге. Впрочем, обещаю держать себя в руках».'
            end
        end

    elseif $GirlPolicyResponseTalkTextId = 'hard':
        if $PolicyResponseTalkGirl = 'amanda':
            $GirlPolicyResponseTalkText = 'Вы выговариваете ей строго и сухо, требуя дисциплины. Аманда обиженно вспыхивает, скрещивает руки и сердито отворачивается: «Ну конечно, чуть что — сразу отчитывать! Я между столами кручусь целый день, а ты только и знаешь, что командовать. Мог бы хоть раз сказать спасибо, а не строить из себя строгого начальника!»'
        elseif $PolicyResponseTalkGirl = 'melissa':
            $GirlPolicyResponseTalkText = 'Вы пытаетесь отчитать её суровым тоном. Мелисса выслушивает вас с невозмутимым видом, лишь слегка приподняв подбородок: «Ты можешь сотрясать воздух сколько угодно, Стефан. Но оставь этот командный голос для пьяных грузчиков в порту. Со мной лучше говорить на языке фактов и логики — криком ты добьёшься только того, что я перестану прислушиваться к твоим советам вовсе».'
        elseif $PolicyResponseTalkGirl = 'sandra':
            $GirlPolicyResponseTalkText = 'Вы пытаетесь повысить тон и потребовать строгого порядка. Сандра медленно скрещивает руки на груди и обжигает вас прохладным взглядом: «Остынь, Стефан. Ты хозяин трактира, а не гарнизонный капрал, и уж точно не тебе меня жизни учить. Хочешь порядка — говори спокойно и по делу, а спесь свою прибереги для улицы».'
        else:
            $GirlPolicyResponseTalkText = 'Строгий тон обрывает возражения, но оставляет после себя ощутимый осадок. Она молча кивает, однако по её сдержанному виду ясно: излишняя резкость доверия делу не прибавит.'
        end

    elseif $GirlPolicyResponseTalkTextId = 'calm':
        if $PolicyResponseTalkGirl = 'amanda':
            $GirlPolicyResponseTalkText = 'Вы спокойно и по-доброму разбираете с ней ситуацию, объясняя свои мысли без упрёка. Аманда улыбается и с облегчением выдыхает: «Вот так бы сразу, Стефан! Когда ты говоришь по-человечески, я и сама всё понимаю. Не переживай, в следующий раз я буду аккуратнее, чтобы и тебе спокойно было, и гости не наглели».'
        elseif $PolicyResponseTalkGirl = 'melissa':
            $GirlPolicyResponseTalkText = 'Вы рассудительно приводите доводы, объясняя свой взгляд на порядок в зале. Мелисса одобрительно кивает: «Вот теперь это разумный разговор. Когда ты оперируешь здравым смыслом и пользой для дела, а не слепым упрямством, находить общий язык с тобой — одно удовольствие. Я учту твои замечания».'
        elseif $PolicyResponseTalkGirl = 'sandra':
            $GirlPolicyResponseTalkText = 'Вы излагаете мысли рассудительно и с уважением. Сандра внимательно слушает и тепло усмехается: «Вот это разговор взрослого хозяина. Когда всё сказано спокойно и по уму, тогда и дело спорится. Не беспокойся, Стефан, мы с тобой всегда договоримся».'
        else:
            $GirlPolicyResponseTalkText = 'Спокойный, рассудительный разговор быстро снимает напряжение. Она слушает с готовностью и соглашается с вашими доводами: взаимное уважение делает общую работу куда проще.'
        end

    elseif $GirlPolicyResponseTalkTextId = 'admit':
        if $PolicyResponseTalkGirl = 'amanda':
            $GirlPolicyResponseTalkText = 'Вы честно признаёте, что ваш совет или нажим был не самым удачным. Аманда удивлённо распахивает глаза, а затем её лицо озаряет искренняя, сияющая улыбка: «Ого... Стефан, ты правда это говоришь? Спасибо! Я думала, ты из принципа будешь стоять на своём. Знаешь, за это я тебя и люблю — ты умеешь слышать других, даже когда стал главным».'
        elseif $PolicyResponseTalkGirl = 'melissa':
            $GirlPolicyResponseTalkText = 'Вы прямо признаёте, что в ваших указаниях был просчёт и ситуация требовала другого подхода. Лицо Мелиссы заметно теплеет, а в голосе звучит искреннее одобрение: «Признать тактическую ошибку и скорректировать курс — признак зрелого ума, братец. Рада видеть, что ты думаешь головой, а не слепым самолюбием. Я это очень ценю».'
        elseif $PolicyResponseTalkGirl = 'sandra':
            $GirlPolicyResponseTalkText = 'Вы открыто говорите, что поторопились с выводами и были не совсем правы. Сандра несколько секунд внимательно смотрит на вас, а затем одобрительно хлопает по плечу: «Уметь признать оплошность — верный признак настоящего хозяина, Стефан. Не ошибается только тот, кто ничего не делает. Ладно, проехали. Давай дальше работать».'
        else:
            $GirlPolicyResponseTalkText = 'Вы открыто признаёте, что поспешили с указанием. Такая честность и готовность считаться с чужим мнением вызывают у неё искреннее уважение и заметно укрепляют доверие.'
        end
    else:
        $GirlPolicyResponseTalkText = ''
    end

    killvar '$GirlPolicyResponseTalkTextId'
    killvar 'PolicyResponseStage'
    killvar 'PolicyTalkRule'
---
