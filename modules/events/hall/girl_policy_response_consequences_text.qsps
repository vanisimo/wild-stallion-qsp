! ================================================
! FILE: modules/events/hall/girl_policy_response_consequences_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Thought-хвост после фактической реакции на правило
! Stage: 0 refuse / 1 reluctant / 2 obey / 3 eager / 4 overstep
! Rule: 0 none / 1 decent / 2 own / 3 keep_client
! ================================================

#GirlPolicyResponseConsequenceText
    gs 'NormalizeGirlKey', $ARGS[0]
    $PolicyTextGirl = $GirlKey
    $PolicyTextArea = LCASE($ARGS[1])
    PolicyTextRule = ARGS[2]
    PolicyTextStage = ARGS[3]

    $GirlPolicyResponseConsequenceText = ''

    if $PolicyTextGirl = '':
        exit
    end

    if $RealName[$PolicyTextGirl] = '':
        gs 'EnsureGirlData', $PolicyTextGirl
    end

    if PolicyTextStage <= 0:
        if PolicyTextRule = 3:
            if $PolicyTextGirl = 'amanda':
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Аманда выслушала указ быть раскованнее, но переступить через себя не смогла. Копить на мечту она готова, но терпимости к чужим лапам в себе не находит.</i></font>'
            elseif $PolicyTextGirl = 'melissa':
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Мелисса видит намерение поднять выручку, но разыгрывать доступную служанку ради серебра категорически отказывается.</i></font>'
            elseif $PolicyTextGirl = 'sandra':
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Сандра игнорирует попытку учить её работе. На кухне порядок держится на её усмотрении, а не на заигрываниях с клиентами.</i></font>'
            else:
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>' + $RealName[$PolicyTextGirl] + ' отказывается от грязных методов работы с клиентом.</i></font>'
            end
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Сдержанность не помогла гасить вольности — граница плывёт, и клиент начинает чувствовать безнаказанность.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Напутствие «решай сама» воспринято без восторга. Она вынуждена сама разбираться с гостем, не чувствуя за собой твёрдого плеча.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Отсутствие чёткого правила путает работу. Ей приходится угадывать реакцию Стефана прямо на ходу.</i></font>'
        end

    elseif PolicyTextStage = 1:
        if PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Она подчиняется неохотно: мило улыбается и не спешит отходить, но никакой радости от такой работы не испытывает.</i></font>'
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Сдержанность соблюдается через силу. Порядок выдержан, но дистанция между персоналом и хозяином увеличивается.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Свобода выбора принята с трудом. Она берёт дело в свои руки, запоминая, что Стефан предпочёл остаться в стороне.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Она импровизирует на свой страх и риск, сохраняя недовольство неопределённостью.</i></font>'
        end

    elseif PolicyTextStage = 2:
        if PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Правило работает ровно. Она грамотно держит клиента: с улыбкой, за хорошим заказом и без лишнего повода перейти черту.</i></font>'
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Сдержанность работает. Дистанция с клиентом сохранена, в зале соблюдается порядок.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Самостоятельность оправдывает себя. Она уверенно контролирует ситуацию с гостем без подсказок.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Даже без указаний она справляется с залом благодаря собственному опыту.</i></font>'
        end

    elseif PolicyTextStage = 3:
        if PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Установка на выручку принята охотно. Она смело заигрывает с клиентом, удерживая его внимание и кошелёк.</i></font>'
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Строгое правило воспринимается как удобная броня. Ей проще отказать клиенту, ссылаясь на волю хозяина.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Полная свобода действий пришлась ей по душе. Она спокойно и уверенно вертит гостями ради чаевых.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Без рамок она берёт инициативу в свои руки и задаёт тон общению в зале.</i></font>'
        end

    else:
        if PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Формально держась строго, она не упускает случая проверить реакцию Стефана лишним взглядом или улыбкой.</i></font>'
        elseif PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Разрешение быть раскованнее трактуется максимально свободно. Она явно переходит обычные границы флирта.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Свобода выбора заходит дальше ожидаемого. Она держится с клиентами смелее и откровеннее.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Отсутствие рамок воспринимается как карт-бланш. Она сама определяет степень дозволенного в зале.</i></font>'
        end
    end

    killvar '$PolicyTextGirl'
    killvar '$PolicyTextArea'
    killvar 'PolicyTextRule'
    killvar 'PolicyTextStage'
---
