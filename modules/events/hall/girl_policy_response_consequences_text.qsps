! ================================================
! FILE: modules/events/hall/girl_policy_response_consequences_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Thought-хвост после фактической реакции на правило
! Stage: 0 refuse / 1 reluctant / 2 obey / 3 eager / 4 overstep
! Rule: 0 none / 1 decent / 2 own / 3 keep_client
! ================================================

#GirlPolicyResponseConsequenceText
    gs 'NormalizeGirlKey', $ARGS[0]
    $PolicyTextGirl = $GirlKey
    $PolicyTextArea = LCASE($ARGS[1])
    PolicyTextRule = ARGS[2]
    PolicyTextStage = ARGS[3]

    $GirlPolicyResponseConsequenceText = ''

    if $PolicyTextGirl = '':
        exit
    end

    if $RealName[$PolicyTextGirl] = '':
        gs 'EnsureGirlData', $PolicyTextGirl
    end

    if PolicyTextStage <= 0:
        if PolicyTextRule = 3:
            if $PolicyTextGirl = 'amanda':
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Аманда честно пыталась вспомнить мой наказ быть сговорчивее ради кассы, но переломить девичью гордость не смогла. Копить на свои мечты она готова, но терпеть чужие загребущие лапы выше её сил — и по её глазам видно, как больно ранит её такое указание.</i></font>'
            elseif $PolicyTextGirl = 'melissa':
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Мелисса отлично просчитала мою жажду наживы, но плясать под эту дудку не собирается. Вытрясти серебро за счёт острого ума — пожалуйста, но изображать из себя доступную кабацкую девку перед пьяным мужланом она считает ниже своего достоинства.</i></font>'
            elseif $PolicyTextGirl = 'sandra':
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Сандра на корню отметает любые попытки учить её поведению. На кухонной половине порядок держится исключительно на её собственном веском слове, и заигрывать с захмелевшими гостями у плиты она не станет ни ради какой выгоды.</i></font>'
            else:
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>' + $RealName[$PolicyTextGirl] + ' наотрез отвергает сомнительные способы завлечения клиентов, наглядно показывая, что её женское достоинство не продаётся за медные гроши.</i></font>'
            end
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Строгая сдержанность дала трещину: не хватило жёсткости и веса, граница приличий предательски поплыла, а разгорячённый клиент мгновенно почуял слабину и пошёл напролом.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Моё легкомысленное «решай сама» легло на её плечи непосильным грузом. Оставшись один на один с наглым гостем, она остро почувствовала себя брошенной без хозяйской защиты.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Отсутствие чёткого хозяйского слова сбивает с толку. Ей приходится на ощупь угадывать мои ожидания, разрываясь между страхом упустить монету и боязнью навлечь гнев.</i></font>'
        end

    elseif PolicyTextStage = 1:
        if PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Она пересиливает себя со скрипом: натянуто улыбается и не спешит отдёргивать руки, но в глазах застыла горечь — такая работа ради звонкой монеты не приносит ей ничего, кроме душевной пустоты.</i></font>'
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Холодная строгость выдерживается через силу. Внешний порядок за столом соблюдён, но глухая стена отчуждения между нами растёт с каждым таким инцидентом.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Предоставленная свобода не принесла радости. Она сама выкручивается перед захмелевшим столом, но в каждом её взгляде в сторону стойки сквозит немой упрёк за моё равнодушие.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Она импровизирует на свой страх и риск, балансируя между столами с затаённой обидой на моё молчание.</i></font>'
        end

    elseif PolicyTextStage = 2:
        if PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Установка работает как часы. Она виртуозно удерживает гостя: ласковое слово, вовремя подлитое пиво, щедрый заказ — и ни малейшего повода распускать руки под столом.</i></font>'
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Правило сдержанности приносит плоды. Лишние вольности отсекаются спокойно и твёрдо, дистанция соблюдена, а трактир сохраняет репутацию достойного заведения.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Самостоятельность полностью себя оправдала. Она уверенно ведёт разговор, осаживает хамов и контролирует обстановку без всяких подсказок со стойки.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Даже без моих указаний её природный такт и житейская смётка позволяют держать зал в узде, не доводя дело до греха.</i></font>'
        end

    elseif PolicyTextStage = 3:
        if PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Установка на звонкую монету воспринята с явным азартом. Она смело пускает в ход очарование, держит внимание зала и опустошает мужские кошельки с поразительной лёгкостью.</i></font>'
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Строгий хозяйский запрет стал для неё непробиваемой бронёй. Ей легко и приятно отказывать наглецам, прячась за нерушимую волю хозяина трактира.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Полная свобода рук пришлась ей точно по вкусу. Она чувствует себя полноправной хозяйкой положения, виртуозно лавируя между столами ради щедрых чаевых.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Почувствовав безнаказанность и свободу, она с удовольствием берёт бразды правления в свои руки и сама диктует залу правила игры.</i></font>'
        end

    else:
        if PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Внешне прикрываясь благопристойной строгостью, она нарочно испытывает мои нервы — ловит мой взгляд, провокационно прикусывает губку и дразнит наглеца на грани фола.</i></font>'
        elseif PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Наказ быть раскованнее истолкован чересчур вольно. Она балансирует на самом краю приличий, заставляя весь зал жадно пускать слюни и превращая трактир в рассадник опасных страстей.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Предоставленная свобода зашла куда дальше разумного. Она держится с захмелевшими гостями вызывающе смело, испытывая границы дозволенного прямо на моих глазах.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Отсутствие рамок она восприняла как полное попустительство, начав устанавливать в зале такие вольные порядки, от которых у благочестивых людей волосы встанут дыбом.</i></font>'
        end
    end

    killvar '$PolicyTextGirl'
    killvar '$PolicyTextArea'
    killvar 'PolicyTextRule'
    killvar 'PolicyTextStage'
---
