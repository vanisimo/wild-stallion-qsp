! ================================================
! FILE: modules/events/hall/girl_policy_response_consequences_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Thought-хвост после фактической реакции на рабочее поведение
! Stage: 0 refuse / 1 reluctant / 2 obey / 3 eager / 4 overstep
! Rule: 0 none / 1 decent / 2 own / 3 keep_client
! ================================================

#GirlPolicyResponseConsequenceText
    gs 'NormalizeGirlKey', $ARGS[0]
    $PolicyTextGirl = $GirlKey
    $PolicyTextArea = LCASE($ARGS[1])
    PolicyTextRule = ARGS[2]
    PolicyTextStage = ARGS[3]

    $GirlPolicyResponseConsequenceText = ''

    if $PolicyTextGirl = '':
        exit
    end

    if $RealName[$PolicyTextGirl] = '':
        gs 'EnsureGirlData', $PolicyTextGirl
    end

    if PolicyTextStage <= 0:
        if PolicyTextRule = 3:
            if $PolicyTextGirl = 'amanda':
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Аманда явно не собирается улыбаться гостю через силу. Одно дело — поболтать о щедрых чаевых, и совсем другое — терпеть наглые замашки неприятного клиента. Она гордо вскинула носик, показала характер и отошла в сторону. Что ж, её право — навязывать такое я ей точно не стану.</i></font>'
            elseif $PolicyTextGirl = 'melissa':
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Мелисса лишь насмешливо приподняла бровь и окатила гостя фунтом презрения, что тот сразу притих. Наши разговоры о выручке для неё не указания к действию — выслушивать плоские подкаты пьяного гостя она не станет ни за какое серебро. Характер у сестрицы ещё тот, но за её гордость мне даже неловко спорить.</i></font>'
            elseif $PolicyTextGirl = 'sandra':
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Сандра одним строгим взглядом пресекла любые намёки. Трактир для неё — это честный труд и порядок, а не заигрывания. Учить мать тому, как обходиться с гостями, явно было пустой затеей: её авторитет на кухне непререкаем, и спорить с ней я даже не пытаюсь.</i></font>'
            else:
                $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>' + $RealName[$PolicyTextGirl] + ' сразу дала понять, что терпеть навязчивые ухаживания не намерена. Она просто осадила гостя и отошла, показав, что у неё есть собственная гордость, и принуждать её к любезностям никто в этом зале не будет.</i></font>'
            end
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Попытка держать холодную дистанцию не сработала: гость оказался слишком настырным или захмелевшим, чтобы понять намёк. Строгий тон его только раззадорил, и теперь обстановка за столом накаляется.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Мой совет «разбирайся сама» оказался не лучшим решением для этой ситуации. Гость попался въедливый, разговор явно не клеится, и ей сейчас точно не помешала бы крепкая хозяйская поддержка.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Без ясной подсказки со стороны разговор за столом зашёл в тупик. Ей трудно понять, стоит ли дальше терпеть болтовню захмелевшего гостя или лучше просто отправить его восвояси.</i></font>'
        end

    elseif PolicyTextStage = 1:
        if PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Она пытается быть приветливее, помня о доплате, но разговор идёт с явным скрипом. Натянутая вежливая улыбка и осторожные ответы — ей явно не по душе этот гость, хоть она и старается ради трактира сгладить углы.</i></font>'
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Держать строгую дистанцию получается с трудом. Вежливое обращение за столом сохранёно, но напряжение повисло в воздухе, и беседа с гостем больше похожа на взаимную осаду.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Справляться самой оказалось сложнее, чем казалось. Она держится и пробует разные подходы, но по её напряжённой позе видно: с таким непростым столом ей хотелось бы опереться на помощь хозяина.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Она пробует импровизировать на ходу, то улыбаясь, то отступая назад. Разговор даётся нелегко, и чувствуется, что без понятного ориентира ей неуютно среди подвыпившей компании.</i></font>'
        end

    elseif PolicyTextStage = 2:
        if PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Вышло на редкость ловко. Пара милых улыбок, вовремя поданная кружка, лёгкий непринуждённый разговор — и гость растаял, охотно заказывая добавку и не пытаясь распускать руки. И выручка выросла, и приличия соблюдены.</i></font>'
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Спокойная вежливость сработала идеально. Лишние вольности гостя пресечены. Никакой ругани, дистанция сохранена, а трактир выглядит солидным и уважаемым местом.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Самостоятельность полностью себя оправдала. Она сама прекрасно чувствует обстановку: где надо — осадит, где надо — переведёт в шутку. Приятно видеть, как уверенно она управляется с залом.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>И без всяких советов её природный такт и житейская смётка прекрасно справились с делом. Гость доволен, разговор остался в рамках приличий, и в зале снова порядок.</i></font>'
        end

    elseif PolicyTextStage = 3:
        if PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Она вошла во вкус и играет с явным азартом! Очаровательная улыбка, искрящийся взгляд, ловкий флирт — и вот уже гость, одуревший от восторга, сам вытряхивает монеты на стол. Красивая работа, зал в восхищении, а в кружках звенит серебро.</i></font>'
        elseif PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Спокойная строгость пришлась ей точно по душе. Ей даже в радость обламывать наглых посетителей, уверенно напоминая, что здесь трактир приличного хозяина, а не портовый кабак.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Свобода действий пришлась ей точно по вкусу. Чувствуя себя полноправной хозяйкой за столом, она с блеском и юмором ведёт разговор, собирая и щедрые чаевые, и восторженные взгляды гостей.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Она чувствует себя на этой половине зала как рыба в воде. Сама задаёт тон беседе, легко удерживает внимание и виртуозно направляет подвыпившую публику туда, куда нужно ей самой.</i></font>'
        end

    else:
        if PolicyTextRule = 1:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Она явно затеяла собственную игру на грани фола. Прикрываясь напускной строгостью, она нарочно ловит мой взгляд, лукаво дразнит гостя и распаляет его так, что у того глаза на лоб лезут. Чертовски эффектно, но как бы этот спектакль не перерос в потасовку.</i></font>'
        elseif PolicyTextRule = 3:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Похоже, она чересчур увлеклась и зашла дальше, чем следовало. Её заигрывания стали слишком смелыми: гость уже дышит через раз и готов на всё, а соседние столы жадно вытягивают шеи. Выручка выручкой, но надо присматривать, чтобы дело не вышло из берегов.</i></font>'
        elseif PolicyTextRule = 2:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Она взяла столько свободы, сколько смогла унести, и теперь держится вызывающе смело. Гости вокруг буквально плавятся от её дерзких реплик и улыбок. Смело, ничего не скажешь, но градус страстей в зале явно подбирается к опасной черте.</i></font>'
        else:
            $GirlPolicyResponseConsequenceText = '<font color="#606080"><i>Без чётких рамок она развернулась на полную катушку. Её вольный тон и смелые жесты превратили обычную беседу в настоящее представление, от которого весь зал замер в предвкушении. Красиво, дерзко, но хозяйский глаз теперь с неё спускать нельзя.</i></font>'
        end
    end

    killvar '$PolicyTextGirl'
    killvar '$PolicyTextArea'
    killvar 'PolicyTextRule'
    killvar 'PolicyTextStage'
---
