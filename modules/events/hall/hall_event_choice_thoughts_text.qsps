! ================================================
! FILE: modules/events/hall/hall_event_choice_thoughts_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Мысли Стефана перед выбором (protect / watch / ignore)
! Меню: до liberation — в основном защитить; после — watch/ignore тоже
! Голос: Act1 — молодой хозяин, с умом, с практичностью, но без цинизма
! ================================================

#HallEventChoiceThoughtsPrint
    gs 'HallEventChoiceThoughtsText', $ARGS[0]

    if $HallEventChoiceThoughtsText <> '':
        *pl ' '
        gs 'PrintLegacyThoughtP', $HallEventChoiceThoughtsText
        *pl ' '
    end
---

#HallEventChoiceThoughtsBody
    gs 'HallEventChoiceThoughtsText', $ARGS[0]
---

#HallEventChoiceThoughtsText
    $HallEventChoiceThoughtsId = LCASE($ARGS[0])
    $HallEventChoiceThoughtsText = ''

    if $HallEventChoiceThoughtsId = 'harassment':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Руки гостя скользят не туда, зал наблюдает. Вмешаться резко — будет шум, и с этого стола чаевых уже не видать. Стоять рядом и не отводить глаз: пусть понимает, что я контролирую ситуацию. Или сделать вид, что занят у стойки… Но тогда она точно запомнит, что я предпочёл отвернуться.'
        else:
            $HallEventChoiceThoughtsText = 'Этот тип распускает руки прямо в зале. Посетители смотрят, и она тоже бросает на меня взгляд. Если сейчас не поднимусь, грош цена мне как хозяину трактира. Ладно, иду.'
        end

    elseif $HallEventChoiceThoughtsId = 'harassment_kitchen':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'На кухне тесно, кипит работа, а этот сунулся без спроса. Выставить его — дело пары секунд. Постоять у дверей: она и сама справится, а клиент поймёт, что я рядом. Или не вмешиваться… Только потом кухне придётся объяснять, почему чужаки разгуливают у печи.'
        else:
            $HallEventChoiceThoughtsText = 'Сюда клиентам ход закрыт. Там кипяток и горячая посуда, а этот мужик уже внутри. Моя кухня, мой трактир. Хватит думать — выставить его, пока дело не дошло до греха.'
        end

    elseif $HallEventChoiceThoughtsId = 'hall_lewd':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Зал замер в ожидании. Пресечь все вольности — будет порядок, но она решит, что я мешаю ей зарабатывать. Наблюдать со стороны: пусть сама держит грань, а я рядом. Отвернуться — мол, так и надо… Но тогда завтра от посетителей отбоя не будет.'
        else:
            $HallEventChoiceThoughtsText = 'Это уже не безобидная шутка у стойки. Хозяин здесь я — нужно встать и навести порядок, пока зал не решил, что здесь с клиентами дозволено всё.'
        end

    elseif $HallEventChoiceThoughtsId = 'hall_missing':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Её нет на месте. Не всегда тишина означает порядок. Пойти проверить сразу. Заглянуть тихонько, без шума. Или подождать у стойки… Выберу неверно — потом припомнит.'
        else:
            $HallEventChoiceThoughtsText = 'Её не видно в зале. Нечего гадать — нужно проверить и вернуть на место, пока кто-нибудь из гостей не решил воспользоваться моментом.'
        end

    elseif $HallEventChoiceThoughtsId = 'kitchen':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Посторонним на кухне делать нечего. Пар, ножи, теснота — и этот тип трётся у столов. Выгнать сразу. Постоять в проходе. Или уйти в зал… Но завтра таких умников станет вдвое больше.'
        else:
            $HallEventChoiceThoughtsText = 'Чужим на кухне ходить незачем. Хватит выжидать — выставить его в зал, пока они посуду не побили.'
        end

    elseif $HallEventChoiceThoughtsId = 'kitchen_lewd':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Кухня — не место для ухаживаний. Выставить гостя и поставить точку. Наблюдать: пусть сама осадит, а я на контроле. Или отвернуться… Завтра тогда заглядывать будут не за похлёбкой.'
        else:
            $HallEventChoiceThoughtsText = 'Гостю на кухне не место. Хватит смотреть — выгнать его в зал, пока шум не поднялся.'
        end

    elseif $HallEventChoiceThoughtsId = 'kitchen_client':
        $HallEventChoiceThoughtsText = 'Заказ богатый, звонкая монета на кону. Можно прикрыть глаза ради кассы. Только на кухне запомнят, кому я открыл дверь — и завтра припрутся снова.'
    else:
        $HallEventChoiceThoughtsText = ''
    end

    killvar '$HallEventChoiceThoughtsId'
---
