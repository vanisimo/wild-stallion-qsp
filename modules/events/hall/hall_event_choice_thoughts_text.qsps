! ================================================
! FILE: modules/events/hall/hall_event_choice_thoughts_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Мысли Стефана перед выбором (protect / watch / ignore)
! Меню: до liberation — в основном защитить; после — watch/ignore тоже
! Голос: Act1 — молодой хозяин, с умом, с практичностью, но без цинизма
! ================================================

#HallEventChoiceThoughtsPrint
    gs 'HallEventChoiceThoughtsText', $ARGS[0]

    if $HallEventChoiceThoughtsText <> '':
        *pl ' '
        gs 'PrintLegacyThoughtP', $HallEventChoiceThoughtsText
        *pl ' '
    end
---

#HallEventChoiceThoughtsBody
    gs 'HallEventChoiceThoughtsText', $ARGS[0]
---

#HallEventChoiceThoughtsText
    $HallEventChoiceThoughtsId = LCASE($ARGS[0])
    $HallEventChoiceThoughtsText = ''

    if $HallEventChoiceThoughtsId = 'harassment':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Чужие лапы скользят всё смелее, очерчивая девичьи изгибы, а захмелевший зал жадно ловит каждое движение. Вломиться напролом с кулаками — значит сорвать вечер, поднять дикий ор и своими руками вышвырнуть верную выручку за порог. Встать рядом, опершись о дубовую стойку, и сверлить наглеца ледяным взглядом: пусть чувствует хозяина затылком и не переступает черту. Или вовсе сделать вид, будто считаю медяки под доской?.. Только вот она мне этого малодушного равнодушия вовек не простит, да и мужики быстро решат, что девок в этом доме можно щупать даром.'
        else:
            $HallEventChoiceThoughtsText = 'Этот наглец уже в открытую распускает лапы прямо посреди полного зала. Мужики за соседними столами скалятся, а она бросает на меня испуганный, умоляющий взгляд поверх подноса. Если я сейчас не шагну вперёд и не осажу эту пьяную харю, грош мне цена как хозяину «Дикого Жеребца» и защитнику семьи. Хватит жевать губы — пора показать, кто здесь держит порядок.'
        end

    elseif $HallEventChoiceThoughtsId = 'harassment_kitchen':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'На кухне теснота, густой мясной чад и кипящие котлы, а этот нахал полез прямо под горячую руку, надеясь урвать лакомый кусок в полумраке. Выставить его пинком под зад — дело пары вздохов. С другой стороны, можно замереть на пороге и выждать: бабы у нас с характером, сами могут остудить нахала ухватом, а гость поймёт, что я держу руку на рукояти. Или не встревать вовсе?.. Но если позволить чужакам топтаться у чугунов, кухня мигом превратится в проходной двор.'
        else:
            $HallEventChoiceThoughtsText = 'Посторонним за эту дверь хода нет — закон заведения. Там раскалённая плита, острые ножи и кипящий бульон, а этот пьяный кобель уже сунул нос в полумрак кухни. Мой дом, мои правила. Довольно выжидать — пора вытряхнуть нахала обратно в общий зал, пока он не натворил беды или не обжёгся о жаровню.'
        end

    elseif $HallEventChoiceThoughtsId = 'hall_lewd':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Воздух в зале прямо густеет от жадного мужского внимания: затихли даже самые горластые забулдыги. Пресечь всё в зародыше одним окриком — значит сохранить благочестие, но девчонка потом весь вечер будет сверлить меня глазами за сорванный куш. Наблюдать со стороны, держа руку на поясе: пусть сама крутит наглецом и нащупывает грань, а я прикрою со спины. Или повернуться к полкам с вином, сделав вид, что ничего не вижу?.. Но если дать слабину сегодня, завтра за этими столами начнётся сущий вертеп.'
        else:
            $HallEventChoiceThoughtsText = 'Это уже переходит всякие границы приличия — не безобидные трактирные шуточки у стойки, а бесстыдство на виду у всех. Хозяин под этой крышей я, и мне решать, где кончается гостеприимство. Пора встать в полный рост и навести порядок, пока захмелевший сброд не решил, будто девок в «Диком Жеребце» можно тискать по праву сильного.'
        end

    elseif $HallEventChoiceThoughtsId = 'hall_missing':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Куда она запропастилась?.. В зале её не видать, а подозрительная тишина в дальних закоулках редко сулит что-то путное. Пойти проверить немедленно, пока дело не зашло слишком далеко? Или тихонько скользнуть следом, не поднимая лишнего шума, чтобы своими глазами увидеть, с кем она шепчется в полумраке?.. А может, просто остаться за стойкой и дать ей самой набить шишек?.. Ошибусь с выбором — потом не оберёшься попрёков.'
        else:
            $HallEventChoiceThoughtsText = 'Её след простыл, а в зале полно захмелевших гостей с маслеными глазами. Нечего тут гадать да высиживать за стойкой — нужно немедленно проверить дальние каморки и вернуть девчонку на место, пока какой-нибудь прощелыга не зажал её в тёмном углу.'
        end

    elseif $HallEventChoiceThoughtsId = 'kitchen':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Посторонним пьяным харям на кухонной половине делать нечего: тут жаровни пышут жаром, разделочные тесаки блестят, а этот боров крутится возле столов с сальной ухмылкой. Выставить взашей сразу? Постоять в простенке, держа на прицеле? Или вернуться к кружкам в зал?.. Только если я сегодня промолчу, завтра сюда станут ломиться толпами.'
        else:
            $HallEventChoiceThoughtsText = 'На кухонную половину гостям путь заказан — не хватало ещё, чтобы чужие руки шарили по моим горшкам и лапали стряпуху. Хватит топтаться на пороге — пора взять этого умника за шиворот и вышвырнуть в зал, пока он не перебил глиняную посуду.'
        end

    elseif $HallEventChoiceThoughtsId = 'kitchen_lewd':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Кухня — рабочее место, а не сеновал для пьяных ухаживаний. Вломиться и рявкнуть, отрезав все поползновения? Стоять в дверях и смотреть, как она сама осаживает гостя, готовый вмешаться в любую секунду? Или махнуть рукой и уйти?.. Но если дать повод, завтра сюда будут заглядывать не ради наваристой похлёбки, а чтобы безнаказанно полапать в тёмном углу.'
        else:
            $HallEventChoiceThoughtsText = 'Гостю у плиты делать нечего, особенно когда в глазах одна похоть. Довольно глазеть со стороны — пора выставить наглеца в общий зал, пока на кухне не вспыхнул скандал на всю улицу.'
        end

    elseif $HallEventChoiceThoughtsId = 'kitchen_client':
        $HallEventChoiceThoughtsText = 'Заказ жирный, в кошельке у этого господина побрякивает доброе серебро, а в трактире лишней копейки не бывает. Можно, конечно, и прикрыть один глаз ради богатой кассы... Только на кухне этот компромисс мигом запомнят: увидят, кому я распахнул дверь, и завтра на порог явятся новые ходоки с монетой наперевес.'
    else:
        $HallEventChoiceThoughtsText = ''
    end

    killvar '$HallEventChoiceThoughtsId'
---
