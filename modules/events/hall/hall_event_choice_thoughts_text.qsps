! ================================================
! FILE: modules/events/hall/hall_event_choice_thoughts_text.qsps
! Внутренние мысли Стефана перед выбором реакции
! Версия: v6 / harassment — мысли под Защитить / Наблюдать / Отвернуться (§0c)
! Назначение:
! - использоваться из hall_harassment, hall_lewd_behavior, hall_missing_girl, kitchen_customer_event
! - держать длинные поясняющие тексты отдельно от логики событий
! - показывать не механику кнопок, а сомнения и расчёт Стефана
! ================================================

#HallEventChoiceThoughtsPrint
    gs 'HallEventChoiceThoughtsText', $ARGS[0]

    if $HallEventChoiceThoughtsText <> '':
        *pl ' '
        gs 'PrintLegacyThoughtP', $HallEventChoiceThoughtsText
        *pl ' '
    end
---

#HallEventChoiceThoughtsBody
    gs 'HallEventChoiceThoughtsText', $ARGS[0]
---

#HallEventChoiceThoughtsText
    $HallEventChoiceThoughtsId = LCASE($ARGS[0])
    $HallEventChoiceThoughtsText = ''

    if $HallEventChoiceThoughtsId = 'harassment':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'Руки уже где не надо, зал смотрит. Могу врезаться между ними — шумно, по-хозяйски, чаевых не будет. Могу стоять рядом и не отводить глаз: пусть знает, что я вижу, и не лезет дальше. А могу сделать вид, что занят у стойки… Только потом не удивляться, если она запомнит, кто отвернулся.'
        else:
            $HallEventChoiceThoughtsText = 'Этот уже лапает, будто дома. Зал смотрит — и она тоже, на меня. Не на него. Если сейчас не встану, буду тем хозяином, который «не заметил». Ладно. Пошёл.'
        end

    elseif $HallEventChoiceThoughtsId = 'harassment_kitchen':
        if FamilyLiberationGateOpen = 1:
            $HallEventChoiceThoughtsText = 'На кухне тесно, пар в лицо, ножи на столе — а этот тип тут как у себя. Вышвырнуть? Легко, и пусть не возвращается. Постоять в дверях и смотреть — тоже вариант: она справится, а он почувствует, что хозяин не слепой. Или заняться залом и не слышать… Только кухня потом сама расскажет, кого я пустил.'
        else:
            $HallEventChoiceThoughtsText = 'Сюда гости без спроса не ходят. Жарко, тесно, кастрюли, ножи — а этот уже внутри, будто так и надо. Моя кухня. Мои. Хватит смотреть: выгонять, пока кто-нибудь не вскричал.'
        end

    elseif $HallEventChoiceThoughtsId = 'hall_lewd':
        $HallEventChoiceThoughtsText = 'Зал уже понял, куда клонится. Могу оборвать — порядок, но она решит, что не верю ей. Могу стоять и смотреть: пусть сама, а я не слепой. Или сделать вид, что так и надо… Тогда завтра «Жеребца» будут искать не по вывеске.'

    elseif $HallEventChoiceThoughtsId = 'hall_missing':
        $HallEventChoiceThoughtsText = 'Её нет. Тишина не всегда невинная. Могу сделать вид, что не заметил — если там болтовня, не выставлю дурака. Могу тихо глянуть, без крика. Или ворваться сразу: клиент поймёт про монету, она — что я рядом. Ошибусь — припомнит.'

    elseif $HallEventChoiceThoughtsId = 'kitchen':
        $HallEventChoiceThoughtsText = 'На кухне чужих не держат. Пар, ножи, теснота — и этот тип. Выгнать сейчас. Или стоять в проходе и смотреть. Или уйти в зал… Завтра таких будет двое.'

    elseif $HallEventChoiceThoughtsId = 'kitchen_client':
        $HallEventChoiceThoughtsText = 'Богатый, заказ хороший, монеты звякают. Можно закрыть глаза. Только кухня запоминает, кому я открыл дверь — и завтра припрётся не один.'
    end

    killvar '$HallEventChoiceThoughtsId'
---
