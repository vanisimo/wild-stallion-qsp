! ================================================
! FILE: modules/events/hall/girl_memory_of_stefan_text.qsps
! Тексты памяти девушек о поведении Стефана
! Используется:
! modules/events/hall/girl_memory_of_stefan.qsps
! ================================================
#GirlMemoryOfStefanText
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlMemoryTextGirl = $GirlKey
    $GirlMemoryText = ''

    if $GirlMemoryTextGirl = '':
        exit
    end

    if $GirlMemoryTextGirl = 'amanda':
        if GirlRemembersProfitChoices['amanda'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Аманда помнит звон брошенных на стол монет лучше любых ласковых речей. Если Стефан готов наживаться на её девичьем смущении и выставлять сестру на потеху гостям — она научится натягивать кукольную улыбку и прятать горькие слезы под маской покорной служанки.</i></font>'
        elseif GirlRemembersNeglect['amanda'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Аманда слишком глубоко запомнила то ледяное равнодушие, с которым Стефан стоял в стороне, пока чужие руки бесчинствовали на её теле. Теперь она знает: единственный её щит — это заученная холодная улыбка и умение хоронить боль глубоко на дне души.</i></font>'
        elseif GirlRemembersProtection['amanda'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>В глазах Аманды Стефан стал несокрушимой каменной стеной, за которой можно укрыться от любой трактирной грязи. Это дарит долгожданную защиту, но порой эта опека сдавливает горло слишком сильно, превращаясь в золотую клетку, из которой отчаянно хочется вырваться на волю.</i></font>'
        elseif GirlRemembersControl['amanda'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Забота Стефана всё навязчивее напоминает Аманде тугой железный поводок. Она всё еще послушно опускает глаза, но в юном сердце медленно, точно капля раскаленного свинца, зреет дерзкое девичье упрямство: «А что, если я перешагну запрет и сама решу свою судьбу?»</i></font>'
        end
    elseif $GirlMemoryTextGirl = 'melissa':
        if StefanInconsistentChoices >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Мелиссу до белого каления раздражает эта хозяйская половинчатость. Сегодня Стефан рядится в благородного защитника, а завтра закрывает глаза на низость ради лишней горсти серебра. Для её острого ума это не просто малодушие — это позорная слабость правителя, не умеющего твердо держать штурвал собственного дома.</i></font>'
        elseif GirlRemembersProtection['melissa'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Мелисса видит, что Стефан способен железной рукой держать зал в повиновении. С таким мужчиной можно яростно спорить до хрипоты, отстаивая свою правоту, но в одном она уверена твердо: за его стальной хребет его можно искренне уважать.</i></font>'
        elseif GirlRemembersProfitChoices['melissa'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Мелисса с первого взгляда раскусила суть этих негласных правил: если Стефан торгует девичьей честью ради звона в сундуке, значит, под этой крышей нет ничего святого. И она ни за что не позволит сделать себя безгласной разменной монетой в чужих руках.</i></font>'
        elseif GirlRemembersNeglect['melissa'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Мелисса не станет ронять слезы в темноте спальни. Она хладнокровно запечатлела в памяти каждый случай, когда Стефан предпочел трусливо отвернуться к стойке. Счета подведены, выводы сделаны — и хозяину они едва ли придутся по вкусу.</i></font>'
        end
    elseif $GirlMemoryTextGirl = 'sandra':
        if GirlRemembersProfitChoices['sandra'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Сандра с тяжелым предчувствием видит, куда неумолимо кренится их общий кров. Звон сыплющихся монет заглушает голос совести, но сердце матери не обманешь: с каждым подобным «выгодным» попустительством из их очага по капле уходит былое достоинство.</i></font>'
        elseif GirlRemembersProtection['sandra'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Сандра не всегда разделяет решения Стефана, но она бережно хранит в душе память о том, как он вставал надежной скалой между её семьей и похотью захмелевшего сброда. Для матери этот жест значит неизмеримо больше, чем сам юноша способен понять.</i></font>'
        elseif GirlRemembersNeglect['sandra'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Сандра умеет терпеливо хранить молчание, но её материнская память не прощает предательства. Когда хозяин дома закрывает глаза на унижение близких, весь дом начинает медленно осыпаться в прах.</i></font>'
        elseif GirlRemembersControl['sandra'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Сандра всё явственнее видит в поступках Стефана не сыновнюю заботу, а слепое упоение властью. Она чувствует, как его рука пытается сжаться на их шеях мертвой хваткой — но живая семья не тюремный острог и не мешок зерна, который можно просто запереть на засов.</i></font>'
        end
    end

    killvar '$GirlMemoryTextGirl'
---
