! ================================================
! FILE: modules/events/hall/girl_memory_of_stefan_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты памяти девушек о поведении Стефана
! Используется:
! modules/events/hall/girl_memory_of_stefan.qsps
! ================================================
#GirlMemoryOfStefanText
    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlMemoryTextGirl = $GirlKey
    $GirlMemoryText = ''

    if $GirlMemoryTextGirl = '':
        if $LastHallMemoryGirl <> '':
            $GirlMemoryTextGirl = $LastHallMemoryGirl
        else:
            exit
        end
    end

    if $GirlMemoryTextGirl = 'amanda':
        if GirlRemembersProfitChoices['amanda'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Аманда видит, что Стефан не прочь подтолкнуть её к щедрым гостям, но вовсе не спешит слепо слушаться брата: если посетитель ей не по нраву, она легко покажет характер и отойдёт в сторону. Но когда мужчина щедр и обходителен, отчего бы не пустить в ход девичье очарование? Звон серебра в фартуке и восхищённые взгляды кружат голову, и ей самой весело крутить захмелевшими гостями на своих условиях.</i></font>'
        elseif GirlRemembersNeglect['amanda'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Аманда привыкла, что Стефан не бросается опекать её при каждом шумном возгласе из зала, давая ей простор справляться самой. Порой ей хочется, чтобы брат лишний раз ободряюще взглянул из-за стойки, но такая самостоятельность лишь раззадоривает её девичью гордость: она быстро учится пускать в ход острый язычок и ставить на место назойливых гостей без чужой оглядки.</i></font>'
        elseif GirlRemembersProtection['amanda'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Аманда знает: за плечом Стефана она как за каменной стеной, и ни один пьяный нахал не посмеет распускать руки. Ей приятно чувствовать надёжную защиту взрослого брата, хоть она и надувает губки для виду, когда он чересчур строго разгоняет щедрых воздыхателей. Ведь она уже не маленькая девочка, и внимание мужчин ей вовсе не в тягость.</i></font>'
        elseif GirlRemembersControl['amanda'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Хозяйские порядки и строгие наставления Стефана вызывают у Аманды лишь озорное девичье упрямство. Она вовсе не спешит безоговорочно слушаться брата, и в её глазах так и пляшут смешинки: чем усерднее Стефан пытается следить за каждым её шагом в зале, тем слаще кажется искушение поступить по-своему.</i></font>'
        end
    elseif $GirlMemoryTextGirl = 'melissa':
        if StefanInconsistentChoices >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Мелисса с лёгкой усмешкой подмечает, как переменчиво Стефан управляется с залом. Сегодня он изображает непоколебимого защитника приличий, а завтра подмигивает, намекая быть ласковее с толстым кошельком гостя. Для её педантичного ума эта непоследовательность — повод снисходительно закатить глаза: брат явно выдумывает свои хозяйские правила на ходу, и его тактике явно недостаёт книжного порядка.</i></font>'
        elseif GirlRemembersProtection['melissa'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Мелисса видит, что у Стефана есть характер и твёрдая рука настоящего хозяина дома. Конечно, она и сама способна осадить любого глупца парой едких насмешек, но готовность брата встать рядом и уверенно навести порядок в зале внушает искреннее уважение. Приятно сознавать, что под этой крышей есть на кого положиться.</i></font>'
        elseif GirlRemembersProfitChoices['melissa'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Мелисса отлично помнит их разговоры о доходах, но вовсе не считает намёки Стефана обязательным правилом: если гость ей неприятен, она без колебаний выставит ледяную стену. Однако когда захмелевший простофиля сам готов платить за улыбку, его наивная похоть кажется ей лишь смешной и предсказуемой. Почему бы не вытряхнуть из него лишнее серебро? Она снисходительно слушает неуклюжую лесть, хладнокровно подсчитывая, сколько хорошей бумаги, чернил и редких книг это принесёт в её личный запас.</i></font>'
        elseif GirlRemembersNeglect['melissa'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Мелисса отлично видит, когда Стефан предпочитает остаться за стойкой и дать ей самой разобраться с посетителем. Впрочем, её это ничуть не тревожит: её остроумия и холодного взгляда более чем достаточно, чтобы остудить любой пыл. Но мысленную галочку она ставит: хозяин трактира явно не прочь переложить дипломатию зала на её плечи, о чём она при случае с улыбкой ему напомнит.</i></font>'
        elseif GirlRemembersControl['melissa'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Мелисса лишь насмешливо вскидывает бровь, когда Стефан пытается диктовать ей строгие рамки и командовать в зале. Она считает себя куда более сведущей в порядке и благоразумии, чем её новоявленный строгий наставник. Подчиняться приказам ради галочки она не станет, но непременно найдёт способ доказать брату, что её собственный ум управляет трактиром ничуть не хуже.</i></font>'
        end
    elseif $GirlMemoryTextGirl = 'sandra':
        if GirlRemembersProfitChoices['sandra'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Сандра прекрасно понимает: трактир — не обитель праведников, и без звонкой монеты в кассе дело не вытянешь. Они обсуждали возможности заработка, и Стефан пытается направлять девушек к большей приветливости с гостями, но матери спокойнее от мысли, что дочки знают себе цену и не станут делать то, к чему не лежит душа. Она видит хозяйскую сметку сына и прибыль в амбаре, радуясь, что семья учится зарабатывать с умом, не теряя девичьей гордости.</i></font>'
        elseif GirlRemembersProtection['sandra'] >= 3:
            $GirlMemoryText = '<font color="#606080"><i>Сандра с тихой материнской гордостью видит, как Стефан берёт на себя порядок и покой в зале. Долгие годы ей приходилось быть единственным волнорезом перед любыми невзгодами, но теперь, когда сын твёрдо встаёт на защиту семьи и осаживает наглецов, она может наконец перевести дух. В такие минуты она чувствует: трактир действительно обретает надёжного хозяина.</i></font>'
        elseif GirlRemembersNeglect['sandra'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Сандра подмечает, когда Стефан предпочитает остаться в стороне и дать событиям в зале идти своим чередом. Она понимает, что хозяин не обязан бросаться в каждую мелкую перебранку, но как мать и опора дома держит руку на пульсе. Для неё важно, чтобы за этим спокойствием не скрывалось равнодушие, ведь трактир требует постоянной чуткости и верного глаза.</i></font>'
        elseif GirlRemembersControl['sandra'] >= 2:
            $GirlMemoryText = '<font color="#606080"><i>Сандра с суховатой улыбкой наблюдает за тем, как Стефан входит во вкус власти, пытаясь упорядочить весь дом строгими указаниями. Она не спешит осаживать сына, но помнит: живая семья и трактир держатся на взаимном уважении и общем труде, а не на командирском тоне. Она даёт юноше проявить характер, терпеливо направляя его пыл в полезное русло.</i></font>'
        end
    end

    killvar '$GirlMemoryTextGirl'
---
