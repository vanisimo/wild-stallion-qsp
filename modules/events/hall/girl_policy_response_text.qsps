! ================================================
! FILE: modules/events/hall/girl_policy_response_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Реакция девушки на рабочее поведение (сцена, до выбора игрока)
! Policy: 0 no_rule / 1 decent / 2 own_choice / 3 keep_client
! Level: 0 refuse / 1 reluctant / 2 obey / 3 eager / 4 overstep
! (no_rule: 1 confused / 2 improvise / 3 self_willed)
! ================================================

#GirlPolicyResponseText
    $PolicyResponseText = ''

    if $PolicyResponseMode = 'keep_client':
        gs 'GirlPolicyResponseTextKeepClient'
    elseif $PolicyResponseMode = 'decent':
        gs 'GirlPolicyResponseTextDecent'
    elseif $PolicyResponseMode = 'own_choice':
        gs 'GirlPolicyResponseTextOwnChoice'
    else:
        gs 'GirlPolicyResponseTextNoRule'
    end
---

#GirlPolicyResponseTextKeepClient
    ! rule 3 — раскованнее / держать клиента
    if PolicyResponseLevel = 0:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда помнит совет быть приветливее к гостям ради хорошей выручки, но терпеть наглость не намерена. Когда захмелевший посетитель пытается бесцеремонно приобнять её за талию, девушка проворно отшатывается и выставляет перед собой жестяной поднос. Она награждает наглеца возмущённым взглядом, а затем выразительно смотрит на Стефана: с вежливыми гостями она поболтает с радостью, но спускать хамство ради пары монет не станет.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса встречает идею о «большей приветливости» с ироничным хладнокровием. Заметив, что гость путает вежливость с доступностью, она остужает его пыл одним насмешливым замечанием, от которого тот теряется. Мелисса бросает на Стефана снисходительный взгляд, приподняв бровь: мужскую глупость она готова обращать в звонкое серебро, но опускаться до угодничества перед хамом считает ниже своего достоинства.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра выслушала мысли о привлечении гостей, но у неё на этот счёт своё твёрдое мнение. Когда излишне развязный посетитель суёт нос на кухонную половину, она одаривает его таким суровым материнским взглядом поверх половника, что тот моментально трезвеет. На её кухне порядок держится на уважении к хозяйке, и заигрывать у плиты она не будет ни за какие барыши.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' решительно отказывается потакать навязчивым намёкам гостя, отступая на шаг и давая понять, что её приветливость имеет чёткие границы.'
        end
    elseif PolicyResponseLevel = 1:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда честно старается быть милее и поддержать разговор, как советовал Стефан, но даётся это с заметным трудом. Гость попался шумный, шутки у него плоские, и девушка смущённо краснеет, пытаясь перевести разговор на заказ выпивки. Она то и дело бросает взгляд на стойку, надеясь, что брат вовремя подключится и разбавит эту натянутую беседу.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса поддерживает разговор с гостем ради счёта за выпивку, но делает это с нескрываемой снисходительностью. Она вовремя наполняет кружку и отвечает на реплики, однако в каждом её слове и насмешливой полуулыбке звучит такая интеллектуальная ирония, что подвыпивший клиент чувствует себя школяром, отвечающим строгой наставнице.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра неохотно сглаживает углы, не желая устраивать переполох. Появившемуся у стойки гостю она отвечает коротко и по делу, отмеряя порцию жаркого с такой невозмутимой деловитостью, что посетитель забирает миску и спешит вернуться на своё место в зале.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' удерживает внимание гостя без особого воодушевления, поддерживая ровный разговор и следя за тем, чтобы собеседник держал дистанцию.'
        end
    elseif PolicyResponseLevel = 2:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда ловко пускает в ход своё природное обаяние. Она приветливо улыбается гостю, мило шутит про погоду и дорогу, а нескромные комплименты легко обращает в заказ кувшина лучшего эля. И гость сидит довольный, чувствуя себя желанным посетителем, и монеты весело звенят в её переднике.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса виртуозно берёт клиента в оборот. Тонкая ирония, вовремя подлитое вино и лёгкая снисходительная улыбка — гость сам не замечает, как заказывает самое дорогое блюдо и оставляет щедрые чаевые, польщённый тем, что столь умная и красивая девушка удостоила его содержательной беседой.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра действует по-хозяйски основательно и с толком. Без лишних ужимок, одним лишь сочным описанием свежего жаркого и доброго хлеба она побуждает гостей заказывать двойные порции, превращая сытный аппетит посетителей в стабильный доход трактира.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' уверенно и ловко ведёт разговор с гостем, удерживая его интерес и успешно пополняя трактирную кассу.'
        end
    elseif PolicyResponseLevel = 3:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда входит в настоящий азарт, управляя вниманием стола с поразительной лёгкостью. Озорной блеск в глазах, звонкий смех и меткие кокетливые реплики заставляют захмелевших гостей наперебой заказывать новые кружки и щедро сыпать серебро на поднос, пока весь зал любуется юной красавицей.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса разворачивает перед столом блестящую игру. Она виртуозно подыгрывает тщеславию посетителей, заставляя их чувствовать себя щедрыми господами, и с лёгкой усмешкой наблюдает, как их кошельки стремительно пустеют в пользу трактира — и её собственных книжных сбережений.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра действует с редкой хозяйской хваткой. Обед на кухне кипит ключом, запахи разносятся по всему залу, а её уверенные, веские слова заставляют посетителей охотно раскошеливаться на самые сытные и дорогие угощения.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' с явным удовольствием общается с посетителями, легко притягивая к себе внимание зала и щедрые чаевые.'
        end
    else:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда заходит в заигрываниях дальше обычного, увлёкшись открытым вниманием зала. Она наклоняется к столику непозволительно близко, лукаво хихикает на смелые шутки и бросает озорные взгляды на стойку — словно нарочно проверяя, как на эту вольность отреагирует Стефан.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса превращает общение с гостями в рискованную игру. Её двусмысленные намёки и колкие взгляды столь сильно распаляют воображение подвыпивших мужчин, что за соседними столами начинают вытягивать шеи, а градус мужского нетерпения подбирается к опасной черте.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра на кухонной половине действует чересчур напористо, осаживая захмелевшего гостя с такой безапелляционной прямотой и звоном чугунной посуды, что вокруг на мгновение воцаряется напряжённая тишина.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' увлекается свободой общения, балансируя на самой грани приличий и привлекая к себе излишне пристальное внимание зала.'
        end
    end
---

#GirlPolicyResponseTextDecent
    ! rule 1 — сдержанно / звать хозяина
    if PolicyResponseLevel = 0:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда пытается держаться строго и неприступно, но её природная мягкость не позволяет напустить должного холода. Неловкий отпор гость воспринимает скорее как кокетливую игру и продолжает наступать, вынуждая девушку поспешно пятиться к стойке под защиту брата.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса доводит установку на сдержанность до академического абсолюта. Вместо простой дистанции она обрушивает на посетителя столь высокомерную и колкую отповедь, что тот багровеет от досады и демонстративно отодвигает недопитую кружку.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра выслушала наказ о благочестии, но на своей кухне держит порядок по собственным проверенным правилам. Лишних наставлений ей не нужно: если гость забывается, она осадит его парой крепких слов куда быстрее любого писаного устава.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' сбивается со сдержанного тона, реагируя на вольности посетителя излишне резко и создавая за столом ненужную напряжённость.'
        end
    elseif PolicyResponseLevel = 1:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда добросовестно держит дистанцию, но напускная строгость даётся ей с трудом. Ей куда привычнее просто улыбнуться гостю или позвать Стефана, чем постоянно сдерживать себя и насупленно следить за каждым словом.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса держится подчёркнуто отстранённо и сухо. Дистанцию со столами она соблюдает безукоризненно, но её вид ясно даёт понять, что подобные мелкие инструкции она находит излишними для своего уровня ума.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра поддерживает строгость, но хмуро даёт понять, что на кухне её хозяйский авторитет и так незыблем, а лишние напоминания о приличиях лишь отвлекают от дел.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' соблюдает сдержанность с заметной прохладцей, ограничиваясь лишь самыми необходимыми служебными фразами.'
        end
    elseif PolicyResponseLevel = 2:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда уверенно опирается на понятные рамки. Стоит гостю позволить себе нескромный намёк, как она спокойно делает шаг назад и с достоинством указывает на стойку — осознание того, что за ней стоит надёжный брат, придаёт ей спокойствие и уверенность.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса очерчивает границу дозволенного с безупречной точностью. Никакого шума и лишних эмоций — лишь один вежливый, ледяной комментарий, заставляющий зарвавшегося посетителя смутиться и вернуться к своему элю.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра держит порядок у кухонного очага одним спокойным, веским взглядом. Хозяйский наказ беречь достоинство заведения полностью согласуется с её собственным укладом: чужим вольностям здесь места нет.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' с достоинством держится в рамках приличий, не позволяя посетителям переходить черту.'
        end
    elseif PolicyResponseLevel = 3:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда держит строгость легко и непринуждённо. Любую попытку распустить руки она отсекает вежливым, но твёрдым жестом, открыто напоминая залу, что в этом трактире хозяин всегда готов вступиться за сестру.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса с видимым удовольствием осаживает самоуверенных гостей. Безукоризненная осанка, ледяная вежливость и меткие замечания о нормах приличия мгновенно остужают даже самых горячих гуляк.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра с полным одобрением поддерживает строгий порядок. На её кухонной половине царит образцовая дисциплина: работа спорится, а праздным зевакам вход перекрыт наглухо.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' охотно поддерживает установленные границы, решительно и спокойно пресекая любые попытки вольностей.'
        end
    else:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда чересчур увлекается отпором, реагируя на невинную шутку гостя излишне резко и испуганно. Звякает посуда, за соседними столами умолкают разговоры, и в зале повисает неловкая пауза.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса отсекает подвыпившего клиента столь язвительно и высокомерно, что тот оскорбляется до глубины души и в сердцах оставляет кружку, не желая больше заказывать.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра ставит границу настолько круто, что даже завсегдатаи в зале опасливо косятся на кухонную дверь, стараясь не попадаться строгой хозяйке под горячую руку.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' перегибает палку в строгости, превращая спокойную сдержанность в холодную неприступность и смущая гостей.'
        end
    end
---

#GirlPolicyResponseTextOwnChoice
    ! rule 2 — решай сама
    if PolicyResponseLevel = 0:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда слегка теряется от напутствия «решай сама». Одно дело — дразнить гостей под присмотром брата, и совсем другое — в одиночку разбираться с настырным мужчиной. Девушка колеблется, явно ожидая от Стефана более понятного знака со стойки.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса принимает свободу действий с расчётливым спокойствием. Раз Стефан оставляет выбор за ней, она будет вести дела так, как считает нужным её собственный острый ум, не утруждая себя лишними отчётами.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра встречает слова «решай сама» понимающей усмешкой. На своей кухне она и без того привыкла всё решать сама, но мысленно отмечает, что молодой хозяин охотно доверяет ведение дел женскому опыту.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' принимает свободу действий с осторожностью, присматриваясь к обстановке и не спеша проявлять лишнюю инициативу.'
        end
    elseif PolicyResponseLevel = 1:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда пытается действовать по своему усмотрению, но пока чувствует себя неуверенно. Смущаясь под взглядами гостей, она балансирует между любезностью и осторожностью, то и дело поглядывая на брата в поисках одобрения.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса берёт управление ситуацией на себя, но без особого блеска. Она легко разруливает заминки у столов, хотя ироничные нотки в её голосе выдают лёгкое недовольство тем, что хозяин предпочитает наблюдать со стороны.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра ведёт дела на кухне привычной твёрдой рукой. Ей не в новинку самой разруливать любые вопросы с гостями, но она предпочитает, чтобы Стефан тоже не терял бдительности у стойки.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' берёт ответственность на себя, ориентируясь по обстановке, но действуя с некоторой осторожностью.'
        end
    elseif PolicyResponseLevel = 2:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда с видимым удовольствием учится самостоятельности. Она уже не теряется перед гостями: где надо — лукаво улыбнётся, где надо — шутливо увернётся, уверенно сохраняя дистанцию и очаровывая посетителей без подсказок.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса виртуозно пользуется предоставленной свободой. Её острый ум безошибочно читает гостей: она тонко балансирует между чаевыми и чувством собственного достоинства, держа хамов на расстоянии и опустошая их кошельки.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра действует основательно, прямо и спокойно. Огромный житейский опыт безошибочно подсказывает ей, где уместна сытная шутка с добрым гостем, а где следует осадить наглеца.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' уверенно держит ситуацию под контролем, руководствуясь здравым смыслом и чувством меры.'
        end
    elseif PolicyResponseLevel = 3:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда расцветает от доверия. Почувствовав свободу, она держится легко и задорно: её звонкий смех и меткие шутки покоряют зал, а границы дозволенного она чертит сама — грациозно и без малейшей неловкости.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса превращает зал в арену для своего блестящего ума. Она тонко управляет настроением столов, щёлкает самодовольных купцов по носу едкими репликами и собирает щедрый урожай серебра, оставляя гостей в полном восторге.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра чувствует себя полновластной хозяйкой кухонной половины. Любые недоразумения с гостями она гасит в зародыше одним метким словом или выразительным звоном сковороды, поддерживая безупречный порядок.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' с видимым удовольствием пользуется самостоятельностью, безупречно управляя настроением посетителей.'
        end
    else:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда слегка пьянеет от самостоятельности, пробуя заходить в общении с посетителями смелее обычного. Она кокетничает на самой грани и дразнит столы, с лукавым вызовом поглядывая на Стефана — проверяя, окликнет ли её брат.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса заигрывается в независимость, превращая зал в собственный сатирический театр. Её язвительные насмешки над подвыпившими клиентами становятся настолько дерзкими, что между задетыми гостями едва не вспыхивает ссора.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра на пороге кухни поступает чересчур круто, окатив настырного посетителя ледяной водой из ковша прямо на глазах у зала — урок вышел доходчивым, хотя шум поднялся изрядный.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' трактует свободу слишком широко, смело экспериментируя с настроением зала и создавая вокруг себя изрядный шум.'
        end
    end
---

#GirlPolicyResponseTextNoRule
    ! rule 0 — правила нет (confused / improvise / self_willed)
    if PolicyResponseLevel <= 1:
        $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' ориентируется в зале по ситуации, стараясь понять настрой посетителей без особых подсказок со стойки. Она то пробует улыбнуться ради заказа, то держится чуть строже, нащупывая верный тон.'
    elseif PolicyResponseLevel = 2:
        $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' берёт дело в свои руки, руководствуясь собственным чутьём и опытом. Спокойно и уверенно она ведёт разговор со столами, поддерживая порядок и доброжелательную атмосферу.'
    else:
        $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' действует совершенно свободно и раскованно. Без оглядки на стойку она ведёт собственную непринуждённую игру с залом, притягивая взгляды и собирая щедрые чаевые.'
    end
