! ================================================
! FILE: modules/events/hall/girl_policy_response_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Реакция девушки на правило Стефана (сцена, до выбора игрока)
! Policy: 0 no_rule / 1 decent / 2 own_choice / 3 keep_client
! Level: 0 refuse / 1 reluctant / 2 obey / 3 eager / 4 overstep
! (no_rule: 1 confused / 2 improvise / 3 self_willed)
! ================================================

#GirlPolicyResponseText
    $PolicyResponseText = ''

    if $PolicyResponseMode = 'keep_client':
        gs 'GirlPolicyResponseTextKeepClient'
    elseif $PolicyResponseMode = 'decent':
        gs 'GirlPolicyResponseTextDecent'
    elseif $PolicyResponseMode = 'own_choice':
        gs 'GirlPolicyResponseTextOwnChoice'
    else:
        gs 'GirlPolicyResponseTextNoRule'
    end
---

#GirlPolicyResponseTextKeepClient
    ! rule 3 — раскованнее / держать клиента
    if PolicyResponseLevel = 0:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда слышит указ про «раскованнее», но смущение побеждает. Она отшатывается и смотрит с немым упрёком: у неё не получается торговать фальшивой лаской.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса встречает правило с холодной иронией. Клиента держит на вытянутой руке: хорошую выручку сделает, но разыгрывать дешёвую лояльность не станет.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра встречает требование быть «раскованнее» тяжёлым взглядом. Сделает всё ровно так, как сама сочтёт правильным на своей кухне, и ни шагом больше.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' отказывается заигрывать с клиентом и держит дистанцию.'
        end
    elseif PolicyResponseLevel = 1:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда неохотно пробует подстроиться. Улыбка выходит натянутой, она мнётся и невольно оглядывается на Стефана, словно ища одобрения.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса выполняет установку без особого энтузиазма. Прибыль удержит, но в тоне чувствуется колкий холод: границы она помнит.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра подчиняется неохотно. Посетителю не нагрубит, но и развлекать его не станет — только работа и чёткие границы.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' держит клиента неохотно, без особого старания.'
        end
    elseif PolicyResponseLevel = 2:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда старается удержать клиента милым разговором. Смущается, но держится увереннее, пытаясь совместить вежливость и выгоду.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса технично берёт клиента в оборот. Лёгкая ирония, вовремя поднесенный кувшин — и кошелёк гостя опустеет раньше, чем он поймёт расклад.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра выполняет наказ по-взрослому: без лишнего кокетства, но с выгодой. Клиент доволен, деньги звенят в кассе.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' удерживает клиента по правилу, уверенно ведя диалог.'
        end
    elseif PolicyResponseLevel = 3:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда принимает наказ охотнее, чем можно было ждать. Краснеет, но активно вовлекается в общение ради щедрых чаевых.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса работает раскованностью мастера. Гость уверен, что сам проявляет инициативу, а она давно ведёт всю игру.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра выжимает из правила максимальную выгоду для заведения, твёрдо контролируя процесс.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' охотно следует напутствию и удерживает внимание клиента.'
        end
    else:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда заходит дальше простых улыбок, пробуя смелее общаться с гостями и приглядываясь к реакции Стефана.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса разворачивает перед залом целый ироничный спектакль, перегибая с раскованностью прямо на ваших глазах.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра действует слишком настойчиво: выбьет из клиента всё до последнего серебряного, не стесняясь в выражениях.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' заходит дальше, чем требовало правило.'
        end
    end
---

#GirlPolicyResponseTextDecent
    ! rule 1 — сдержанно / звать хозяина
    if PolicyResponseLevel = 0:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда старается быть строго сдержанной, но смущение мешает отказать твёрдо. Клиент чувствует её слабину раньше, чем она успевает позвать Стефана.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса принимает правило о сдержанности, но ставит границу наглухо — суше и резче, чем просил Стефан.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра выслушивает указ, но на своей кухне держит дистанцию по собственным строгим понятиям, а не по чужой указке.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' сбивает сдержанный тон и отвечает по-своему.'
        end
    elseif PolicyResponseLevel = 1:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда держится строго, хотя ей трудно. Ей хотелось бы просто чувствовать защиту Стефана за спиной, а не строго следовать предписаниям.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса сдержанна и суха. Дистанцию держит безупречно, но всем видом даёт понять, что опека ей не нужна.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра соглашается с необходимостью порядка, но напоминает, что границы своего хозяйства она и так знает.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' соблюдает сдержанность без особого восторга.'
        end
    elseif PolicyResponseLevel = 2:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда с облегчением опирается на понятное правило. Встретив наглость, оглядывается на Стефана, чувствуя себя защищённой.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса ставит границу легко и изящно. Без криков и сцен — гость сам вспоминает про свой бокал.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра держит порядок одним веским словом. Строгий наказ совпадает с её собственным взглядом на дела.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' уверенно держится в рамках установленного порядка.'
        end
    elseif PolicyResponseLevel = 3:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда цепляется за строгость как за щит. Чужую руку отбивает вежливо, но сразу даёт понять, что Стефан рядом.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса охотно держит дистанцию. Без театра и ссор — наглый гость мгновенно встаёт на место.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра принимает правило порядка с одобрением. На кухне тишина и сдержанность — именно то, что нужно.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' с готовностью поддерживает строгие рамки в общении.'
        end
    else:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда перегибает с отпором, реагируя излишне испуганно и резко. Зал затихает, атмосфера весёлости нарушена.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса отсекает наглеца настолько ледяным тоном, что отбивает у него желание вообще продолжать вечер.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра ставит границу так жёстко, что никто из соседних гостей даже не помышляет о шутках.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' перегибает строгость в слишком резкий отпор.'
        end
    end
---

#GirlPolicyResponseTextOwnChoice
    ! rule 2 — решай сама
    if PolicyResponseLevel = 0:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда теряется от слов «решай сама». Свобода пугает её, когда напротив оказывается хмельной и настойчивый гость.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса принимает свободу действий без сентиментов. В её взгляде читается: за все результаты работы в зале она ответит сама.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра принимает «решай сама» сдержанно. Порядок на кухне она удержит, но запомнит, что Стефан уклонился от прямого указания.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' принимает свободу решений с некоторой настороженностью.'
        end
    elseif PolicyResponseLevel = 1:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда берёт решение на себя, но нервничает. Краснеет, старается вести разговор вежливо, всё равно косясь на Стефана.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса решает ситуацию самостоятельно. Ей не привыкать брать дело в свои руки и выжимать из гостей максимум.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра берёт управление на себя без лишних слов. Ей не привыкать самой определять рамки дозволенного.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' самостоятельно решает, как действовать, но без особой радости.'
        end
    elseif PolicyResponseLevel = 2:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда осторожно пробует проявлять самостоятельность. Нервничает, но учится сама вести диалог с клиентом.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса уверенно берёт инициативу. Ей по душе свобода рук, хотя она и делает вид, что просто выполняет работу.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра действует хозяйственно и твёрдо. Ей свобода указов не нужна — она и так знает, где проходит черта.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' самостоятельно и уверенно держит ситуацию под контролем.'
        end
    elseif PolicyResponseLevel = 3:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда чувствует себя увереннее, распоряжаясь своим общением. Границы теперь — её собственный выбор.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса ведёт сцену остро и утончённо. Стефану остаётся только наблюдать за её мастерством.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра решает вопрос быстро и практично. Клиент понимает всё с первого слова.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' охотно берёт контроль в свои руки.'
        end
    else:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда пользуется свободой чуть смелее, проверяя, как далеко Стефан позволит ей зайти.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса превращает предоставленную свободу в свою собственную игру с залом.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра поступает слишком прямолинейно и резко, но гость запомнит этот урок навсегда.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' трактует свободу шире, чем вы ожидали.'
        end
    end
---

#GirlPolicyResponseTextNoRule
    ! rule 0 — правила нет (confused / improvise / self_willed)
    if PolicyResponseLevel <= 1:
        $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' работает без чётких указаний и слегка досадует на это. Ей приходится угадывать ожидания Стефана прямо на ходу.'
    elseif PolicyResponseLevel = 2:
        $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' справляется по собственному разумению. Раз правил нет — она сама устанавливает порядок.'
    else:
        $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' пользуется отсутствием рамок смело и уверенно. Раз хозяин молчит, она сама решит, как вести себя с залом.'
    end
---
