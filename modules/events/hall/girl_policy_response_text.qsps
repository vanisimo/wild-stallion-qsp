! ================================================
! FILE: modules/events/hall/girl_policy_response_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Реакция девушки на правило Стефана (сцена, до выбора игрока)
! Policy: 0 no_rule / 1 decent / 2 own_choice / 3 keep_client
! Level: 0 refuse / 1 reluctant / 2 obey / 3 eager / 4 overstep
! (no_rule: 1 confused / 2 improvise / 3 self_willed)
! ================================================

#GirlPolicyResponseText
    $PolicyResponseText = ''

    if $PolicyResponseMode = 'keep_client':
        gs 'GirlPolicyResponseTextKeepClient'
    elseif $PolicyResponseMode = 'decent':
        gs 'GirlPolicyResponseTextDecent'
    elseif $PolicyResponseMode = 'own_choice':
        gs 'GirlPolicyResponseTextOwnChoice'
    else:
        gs 'GirlPolicyResponseTextNoRule'
    end
---

#GirlPolicyResponseTextKeepClient
    ! rule 3 — раскованнее / держать клиента
    if PolicyResponseLevel = 0:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда помнит хозяйский наказ быть «посмелее ради выручки», но врождённая стыдливость берёт верх. Когда загребущая ладонь тянется к её талии, девушка испуганно отшатывается, прижимая жестяной поднос к девичьей груди как спасительный щит. Она бросает на Стефана взгляд, полный немой обиды: торговать фальшивой лаской и терпеть липкие щипки она не умеет и не хочет.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса встречает наказ о «раскованности» с ледяным, убийственным сарказмом. Она держит захмелевшего гостя на строгой дистанции взгляда: серебро за выпивку она из его кошелька выжмет до последнего гроша силой отточенной риторики, но разыгрывать дешёвую кабацкую кокетку ради чужой похоти категорически отказывается.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра встречает распоряжение быть «покладистее с гостями» тяжёлым, не предвещающим ничего хорошего взглядом из-под сдвинутых бровей. На своей кухне она сама решает, кому улыбаться, а кому указать на дверь ухватом — переступать через женскую гордость у плиты она не станет ни ради какого золота.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' наотрез отказывается заигрывать с захмелевшим гостем, демонстративно отступая на шаг и выстраивая между собой и наглецом ледяную стену отчуждения.'
        end
    elseif PolicyResponseLevel = 1:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда неловко пытается следовать наказу, но даётся это с огромным трудом. Её улыбка выходит вымученной и робкой, щёки заливает густой девичий румянец, а тонкие пальчики нервно сжимают край передника. Пытаясь отшутиться от сальной шутки, она то и дело тревожно оглядывается на стойку, словно моля Стефана о взгляде поддержки.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса исполняет установку со снисходительным вздохом человека, вынужденного снизойти до примитивной аудитории. Она умело удерживает гостя за столом, подливая пиво, но в каждом слове и насмешливом изгибе губ сквозит такой холод, что захмелевший клиент чувствует себя неучем на строгом экзамене.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра подчиняется неохотно, цедя вежливые слова сквозь зубы. Сунувшемуся на кухню гостю она не нагрубит, но одарит таким колючим взглядом поверх дымящегося чугунка, что тот сам поспешит заказать двойную порцию жаркого и убраться обратно в зал.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' удерживает внимание гостя через силу, поддерживая разговор без всякого душевного тепла и строго отслеживая каждую попытку сократить дистанцию.'
        end
    elseif PolicyResponseLevel = 2:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда старательно пускает в ход природное обаяние, стараясь удержать щедрого гостя милой беседой. Она всё ещё зардевается от нескромных комплиментов, но уже не прячется за поднос, а ловко обращает пьяное восхищение в заказ второй кружки крепкого эля, выгадывая звонкие чаевые.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса виртуозно берёт клиента в интеллектуальный оборот. Тонкая ирония, вовремя поднесённый кувшин с вином и снисходительная полуулыбка — захмелевший гость и сам не замечает, как его кошель стремительно пустеет, а он сам благодарит за возможность просто перекинуться словом с умной подавальщицей.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра ведёт дело по-хозяйски основательно и трезво. Никакого дешёвого кокетства — лишь аппетитные описания сочного окорока, густой наваристой похлёбки и веское слово хозяйки кухни, заставляющее гостей с готовностью выкладывать серебро на бочку.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' уверенно и ловко направляет беседу в нужное русло, удерживая гостя за столом и неуклонно наполняя трактирную кассу.'
        end
    elseif PolicyResponseLevel = 3:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда входит во вкус куда смелее, чем можно было ожидать. Смущённый румянец лишь красит её живое личико, когда она кокетливо покачивает подносом, воркуя с захмелевшими гостями и собирая богатую горсть серебряных монет под завистливые вздохи зала.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса разворачивает перед столом блестящую игру психологического манипулирования. Она держит посетителя в сладкой иллюзии, будто он сам ведёт разговор, а на деле ловко крутит его тщеславием, опустошая кошелёк на самые дорогие вина из трактирного погреба.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра извлекает из хозяйского наказа максимум выгоды, действуя уверенно и властно. Её сытные кухонные запахи и хваткий житейский расчёт приносят заведению щедрую прибыль, пока она цепко держит под контролем каждый медный грош.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' с явным азартом включается в общение с посетителями, без труда притягивая к себе внимание и щедрые чаевые.'
        end
    else:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда заходит куда дальше простых улыбок, заигрывая с гостями на самой рискованной грани дозволенного. Она позволяет клиентам наклоняться непозволительно близко к своей девичьей шее, жадно ловя взглядом реакцию Стефана — словно намеренно испытывая хозяйское терпение на прочность.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса превращает раскованность в едкий и вызывающий спектакль. Она столь откровенно провоцирует захмелевших мужчин насмешливыми полунамёками и дерзкими взглядами, что за соседними столами начинает закипать опасное, нездоровое возбуждение.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра на кухонной половине перегибает с хваткой, выжимая из подвыпившего гостя серебро с таким безапелляционным напором и язвительной прямотой, что на пороге кухни едва не вспыхивает шумная разборка.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' переступает границы разумного, отпуская поводья приличий и рискуя превратить обычный вечер в опасный скандал.'
        end
    end
---

#GirlPolicyResponseTextDecent
    ! rule 1 — сдержанно / звать хозяина
    if PolicyResponseLevel = 0:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда искренне пытается держаться холодно и строго, но врождённая мягкость подводит её: голос предательски дрожит, а робкий отпор лишь распаляет нахала. Клиент чувствует девичью растерянность раньше, чем она успевает сделать шаг к стойке и позвать на помощь брата.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса принимает правило о строгой сдержанности, но доводит его до абсурда. Вместо вежливой дистанции она одаривает гостя такой ледяной академической отповедью, что тот багровеет от унижения и с грохотом отодвигает недопитую кружку.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра молча выслушивает наказ о сдержанности, но на своей кухонной половине держит порядок исключительно по собственному вековому укладу. Чужих предписаний ей не требуется: если наглец сунется к печи, она приложит его словом покрепче любого хозяйского устава.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' сбивается со сдержанного тона, отвечая на вольности наглеца излишне резко и нарушая установленные рамки.'
        end
    elseif PolicyResponseLevel = 1:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда старается держаться строго и неприступно, но эта напускная суровость даётся ей с трудом. Ей хотелось бы просто ощущать за спиной надёжное плечо Стефана, а не зубрить строгие правила поведения, вздрагивая от каждого пьяного окрика.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса держится холодно и подчёркнуто отстранённо. Дистанцию со столами она блюдёт безупречно, но всем своим надменным видом демонстрирует Стефану, что в его мелочной регламентации совершенно не нуждается.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра соглашается с необходимостью строгого порядка, но хмуро даёт понять, что на кухне её авторитет непререкаем, и лишний надзор только отвлекает от котлов и сковородок.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' подчиняется правилу сдержанности с заметной прохладцей, избегая лишних слов и не скрывая скупости эмоций.'
        end
    elseif PolicyResponseLevel = 2:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда с облегчением опирается на понятное и строгое правило, как на надёжную опору. Едва за столом начинают звучать сальные намёки, она делает шаг назад и выразительно оборачивается к стойке — сознание того, что Стефан начеку, возвращает ей спокойствие и девичье достоинство.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса очерчивает границу дозволенного с изящной, филигранной чёткостью. Никаких криков и трактирных драм — лишь один точный, ледяной комментарий, заставляющий зарвавшегося господина вспомнить о правилах приличия и уткнуться обратно в кружку.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра держит порядок у кухонного очага одним веским, непререкаемым взглядом. Хозяйский наказ беречь благочестие полностью совпадает с её собственной крестьянской строгостью: чужим лапам здесь воли нет.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' уверенно и с достоинством держится в рамках установленного благопристойного порядка, не позволяя гостям лишних вольностей.'
        end
    elseif PolicyResponseLevel = 3:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда с радостью хватается за строгость как за спасительную броню. Чужую занесённую руку она отсекает вежливым, но твёрдым жестом, открыто давая понять захмелевшему залу, что за её спиной стоит хозяин трактира, готовый немедленно вступиться за честь сестры.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса с видимым удовольствием ставит наглых гостей на место. Ей по душе это оружие: холодная вежливость, безукоризненная осанка и колкие цитаты о нормах морали мгновенно остужают даже самые горячие головы без малейшего шума.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра с искренним одобрением поддерживает режим строгой благопристойности. На кухонной половине воцаряется идеальная деловая дисциплина: пар клубится, жар пышет, а праздным зевакам ход отрезан наглухо.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' охотно и последовательно поддерживает установленные рамки благопристойности, решительно пресекая любые намёки на распущенность.'
        end
    else:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда перегибает с отпором, реагируя на невинную шутку гостя с паническим страхом и чрезмерной резкостью. Звякают миски, соседние столы недоуменно замолкают, и беззаботное оживление в зале сменяется неловкой, натянутой тишиной.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса отсекает подвыпившего клиента столь беспощадным, высокомерным тоном, что напрочь отбивает у него желание тратить серебро под этой крышей. Оскорблённый в лучших чувствах гость демонстративно швыряет недопитый бокал на доски.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра ставит границу настолько жёстко и свирепо, занеся над порогом тяжёлую сечку для мяса, что даже самые бедовые завсегдатаи в зале опасливо косятся на кухонную дверь и шепчутся по углам.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' перегибает палку в строгости, превращая обычную сдержанность в открытую враждебность и отпугивая посетителей.'
        end
    end
---

#GirlPolicyResponseTextOwnChoice
    ! rule 2 — решай сама
    if PolicyResponseLevel = 0:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда окончательно теряется от слов «решай сама». Подобная свобода лишь пугает её неопытную душу: когда напротив нависает хмельной, грузный мужик с маслеными глазами, девушке отчаянно хочется твёрдого братского слова, а не тяжкого бремени выбора.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса принимает предоставленную автономию с холодной, расчётливой невозмутимостью. В её остром взгляде читается ясный расклад: раз Стефан умывает руки, она будет вести дела так, как выгодно лично ей, и отчитываться за каждый шаг не собирается.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра встречает напутствие «решай сама» сдержанной, сухой усмешкой. На своей кухне она и без того никогда не ждала барских милостей, но равнодушие Стефана зарубила себе на носу: хозяин предпочитает перекладывать ответственность на чужие плечи.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' принимает свободу действий с настороженным прищуром, не спеша радоваться отсутствию хозяйских указаний.'
        end
    elseif PolicyResponseLevel = 1:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда берёт решение на себя, но заметно робеет. Пунцовея до корней волос, она пытается неумело балансировать между вежливостью и строгостью, то и дело бросая беспокойные взгляды на стойку, словно ища подтверждения, что поступает правильно.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса распутывает щекотливые ситуации в зале своими силами, но без малейшего энтузиазма. Ей не привыкать брать контроль в свои руки, однако в её ироничных репликах сквозит лёгкая досада на отсутствие внятной хозяйской позиции.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра берёт бразды правления на кухне в свои мозолистые руки без лишних разговоров. Ей не в новинку самой чертить границы дозволенного, но хозяйское самоустранение оставляет неприятный привкус.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' вынужденно берёт ответственность на себя, действуя по обстоятельствам, но без особого восторга.'
        end
    elseif PolicyResponseLevel = 2:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда робко, шаг за шагом учится проявлять девичью самостоятельность. Она всё ещё смущается под маслеными взглядами, но уже находит в себе силы лукаво улыбнуться и мягко уклониться от назойливой руки, отстаивая свои границы без чужой подсказки.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса с видимым удовлетворением пользуется свободой манёвра. Её острый аналитический ум просчитывает каждого гостя на два хода вперёд: она безупречно держит баланс между чаевыми и гордостью, не подпуская хамов близко, но опустошая их мошну.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра действует по-хозяйски твёрдо, прямолинейно и спокойно. Ей не нужны бумажные инструкции: житейский опыт безошибочно подсказывает, где кончается добродушная трактирная шутка и начинается недопустимая наглость.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' уверенно и хладнокровно держит ситуацию под контролем, действуя сообразно обстановке и здравому смыслу.'
        end
    elseif PolicyResponseLevel = 3:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда расцветает от оказанного доверия. Почувствовав, что её не держат на коротком поводке, она держится раскованнее и увереннее: её звонкий девичий смех и меткие шутки очаровывают зал, а личные границы она теперь очерчивает сама — легко и грациозно.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса превращает зал в арену для демонстрации своего интеллектуального превосходства. Она виртуозно манипулирует настроением столов, щёлкает наглых купцов по носу едкими эпиграммами и снимает щедрые сливки серебром, пока Стефану остаётся лишь восхищаться её хваткой.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра хозяйничает на кухне с абсолютной, уверенной хозяйской хваткой. Любые недоразумения с посетителями она гасит в зародыше одним метким народным словом или выразительным звоном тесака о разделочную доску.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' с явным удовольствием пользуется независимостью, безупречно управляя настроением посетителей.'
        end
    else:
        if $PolicyResponseGirl = 'amanda':
            $PolicyResponseText = 'Аманда слишком опьяняется предоставленной свободой, пробуя заходить в общении с гостями дальше разумного. Она дерзко улыбается наглецам и кокетничает без оглядки, словно нарочно проверяя, на какой черте Стефан наконец сорвётся и окрикнет её.'
        elseif $PolicyResponseGirl = 'melissa':
            $PolicyResponseText = 'Мелисса окончательно заигрывается в независимость, превращая трактирный зал в собственный сатирический театр. Её язвительные насмешки над простоватыми клиентами становятся столь едкими и рискованными, что грозят перерасти в открытый мордобой.'
        elseif $PolicyResponseGirl = 'sandra':
            $PolicyResponseText = 'Сандра на кухонном пороге поступает чересчур круто и бескомпромиссно, окатив сунувшегося наглеца ледяной водой из ушата прямо на глазах у изумлённого зала — урок доходчивый, но на пользу репутации заведения явно не пошедший.'
        else:
            $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' трактует предоставленную свободу чересчур широко, переходя все мыслимые границы и ставя заведение под удар.'
        end
    end
---

#GirlPolicyResponseTextNoRule
    ! rule 0 — правила нет (confused / improvise / self_willed)
    if PolicyResponseLevel <= 1:
        $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' вынуждена работать в зале без каких-либо внятных указаний и явно досадует на такую неопределённость. Ей приходится на свой страх и риск гадать на каждом шагу, чего же от неё ждёт хозяин — благочестивой строгости или раскованной погони за прибылью.'
    elseif PolicyResponseLevel = 2:
        $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' берёт дело в свои руки, руководствуясь исключительно собственным чутьём и житейским разумением. Раз хозяин трактира не удосужился очертить рамки, она сама устанавливает для посетителей границы дозволенного.'
    else:
        $PolicyResponseText = $RealName[$PolicyResponseGirl] + ' смело и без оглядки пользуется полным отсутствием хозяйских рамок. Коль скоро Стефан хранит молчание, она ведёт свою собственную игру с захмелевшим залом, ни в малейшей степени не оглядываясь на стойку.'
    end
