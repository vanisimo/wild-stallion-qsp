! ================================================
! FILE: modules/events/hall/hall_choice_family_talk_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! Агентам: НЕ переписывать prose без явного «можно править тексты».
! Перед любой переделкой файла — спросить пользователя; сохранять формулировки.
! Тексты разговоров семьи о решении Стефана
! Используется:
! modules/events/hall/hall_choice_family_talk.qsps
! ================================================

#HallChoiceFamilyTalkPrintText
    gs 'HallChoiceFamilyTalkText', $ARGS[0]

    if $HallChoiceFamilyTalkText <> '':
        *p $HallChoiceFamilyTalkText
    end
---

#HallChoiceFamilyTalkText
    $HallChoiceFamilyTalkTextId = LCASE($ARGS[0])
    $HallChoiceFamilyTalkText = ''

    if $RealName[$HallChoiceFamilyTalkGirl] = '':
        gs 'EnsureGirlData', $HallChoiceFamilyTalkGirl
    end

    if $HallChoiceFamilyTalkTextId = 'intro':
        if $HallChoiceFamilyTalkGirl = 'amanda':
            $HallChoiceFamilyTalkText = '— Ну? — Аманда скрещивает руки. — Что в зале было? Я половину видела. Вторую ты расскажешь. Давай, пока я сама не додумала.'
        elseif $HallChoiceFamilyTalkGirl = 'melissa':
            $HallChoiceFamilyTalkText = '— Про зал, — Мелисса стоит, не садится. — Без вранья. Я знаю, чем кончилось. Скажи, что ты об этом думаешь. Это не одно и то же.'
        elseif $HallChoiceFamilyTalkGirl = 'sandra':
            $HallChoiceFamilyTalkText = 'Сандра не поднимает глаз от котла:<br><br>— Сел. Куда ты нас тащишь, Стефан?<br><br>Стучит ложкой.<br><br>— Трактир — это монеты. А мы — это мы. Если нам хреново, то зачем тебе полный кошель? Объясни мне.'
        else:
            $HallChoiceFamilyTalkText = $RealName[$HallChoiceFamilyTalkGirl] + ' хочет поговорить о зале — не о сплетнях, а о том, каким ты был хозяином.'
        end

    elseif $HallChoiceFamilyTalkTextId = 'reaction':
        if $LastHallChoiceType = 'protect':
            if $HallChoiceFamilyTalkGirl = 'amanda':
                $HallChoiceFamilyTalkText = '— Ой, да ладно тебе, — бурчит Аманда, красная до ушей. — Я б и сама ему врезала. Наверное.<br><br>Мнёт тряпку.<br><br>— Но спасибо. Орёшь там — ты хозяин. Бьёшь за меня морду — ты мой брат. Я не забуду. Только не жди, что я растаю второй раз. В следующий раз получишь подносом.'
            elseif $HallChoiceFamilyTalkGirl = 'melissa':
                $HallChoiceFamilyTalkText = '— Хорошо, что влез, — Мелисса выдыхает. — А то решат, что у нас тут бордель, а не трактир. И что мы — куклы для чаевых.<br><br>— Я тебя предупреждала: черту надо держать. Сегодня ты её показал. Завтра полезут снова. Но сейчас — спасибо. Без дураков. Правда спасибо.'
            elseif $HallChoiceFamilyTalkGirl = 'sandra':
                $HallChoiceFamilyTalkText = '— Правильно сделал, — Сандра кивает. — Не каждый день надо лезть в драку. Но своих защищаешь — и я спокойнее.<br><br>— Мы с девочками всё видели. Я это не забуду. И ты не задирай нос. И не делай вид, будто ничего не было.'
            else:
                $HallChoiceFamilyTalkText = 'Запомнили как защиту. В семье это весит больше слов — особенно когда стены трактира слышат всё.'
            end

        elseif $LastHallChoiceType = 'calm' or $LastHallChoiceType = 'own_choice' or $LastHallChoiceType = 'watch' or $LastHallChoiceType = 'ignore':
            if $HallChoiceFamilyTalkGirl = 'amanda':
                $HallChoiceFamilyTalkText = '— Ты промолчал, — Аманда говорит тихо. — Может, верил, что я справлюсь. Может, просто не захотел лезть. Я бы отгавкалась. Языком, не кулаками.<br><br>— Теперь я сама буду решать. И в зале, и тут. И не командуй мной потом. Ненавижу, когда за меня решают.'
            elseif $HallChoiceFamilyTalkGirl = 'melissa':
                $HallChoiceFamilyTalkText = '— Оставил на меня, — Мелисса пожимает плечами. — Ладно. Я справлюсь. Только не удивляйся, если я начну командовать. Всем. Тобой, Амандой, трактиром.<br><br>— Когда хозяин молчит — это тоже приказ. Я его услышала. И записала.'
            elseif $HallChoiceFamilyTalkGirl = 'sandra':
                $HallChoiceFamilyTalkText = '— Не полез, значит, — Сандра помолчала. — Может, ума хватило. Может, забоялся. В тот момент мы с Мелиссой сами разбирались.<br><br>— Я не прошу, чтобы ты всех резал. Я прошу, чтобы ты понимал: промолчать — тоже выбор. И он иногда спасает. А иногда нас продаёт. Подумай об этом.'
            else:
                $HallChoiceFamilyTalkText = 'Не вмешался. Запомнили. В доме такие вещи не остаются «между гостями» — они поднимаются наверх с запахом пива.'
            end

        elseif $LastHallChoiceType = 'encourage' or $LastHallChoiceType = 'client':
            if $HallChoiceFamilyTalkGirl = 'amanda':
                $HallChoiceFamilyTalkText = 'Аманда смеётся. Громко и мерзко.<br><br>— И что? Монета звякнула — значит, можно лапать?<br><br>Вертит поднос.<br><br>— Знаешь, что хуже всего? От пьяного урода я отобьюсь. Плюну в рожу. А когда ты сам киваешь... Куда мне плевать, Стефан? В твою похлёбку?'
            elseif $HallChoiceFamilyTalkGirl = 'melissa':
                $HallChoiceFamilyTalkText = '— Деньги в кармане, — цедит Мелисса. — А совесть ты где оставил?<br><br>Стоит спиной, плечи каменные.<br><br>— Я не монашка. Но я спрошу тебя, почему моя сестра ревела. И мама спросит.<br><br>Поворачивается:<br><br>— Так что не делай удивлённые глаза, если завтра я пройду мимо тебя как мимо пустого стула. Ты сам так решил.'
            elseif $HallChoiceFamilyTalkGirl = 'sandra':
                $HallChoiceFamilyTalkText = 'Сандра мешает в котле, на тебя не смотрит.<br><br>— Монеты ты взял, я слышала.<br><br>Стук ложки.<br><br>— Я тебе не священник, Стефан. Я твоя мать. Аманда вечером сидела как в воду опущенная. Мелисса злая как собака. Ты внизу деньги считал, а я наверху слёзы считала.<br><br>Смотрит в глаза:<br><br>— Накорми нас. Не только брюхо. Поговори со мной. Не сейчас. Когда остынешь.'
            else:
                $HallChoiceFamilyTalkText = 'Выгода есть — дом это чувствует. Пахнет не супом, а сделкой. Разговор тяжёлый, даже если никто не кричит.'
            end

        else:
            if $HallChoiceFamilyTalkGirl = 'amanda':
                $HallChoiceFamilyTalkText = '— Ты сегодня как чужой, — Аманда морщится. — Не злой. Не добрый. Никакой. Будто тебе плевать на нас, лишь бы зал гудел.<br><br>— Хочешь — говори. Не хочешь — молчи. Только я всё равно додумаю. И Мелисса додумает. И лучше тебе не знать, что мы надумаем.'
            elseif $HallChoiceFamilyTalkGirl = 'melissa':
                $HallChoiceFamilyTalkText = '— Тяжёлый вечер, — Мелисса не садится. — Я на тебя смотрела. Не на драку. На тебя. И не поняла, кто ты там был. Хозяин? Трус? Торгаш?<br><br>— Скажи мне сам, кем тебя звать. А то я начну звать тебя так, как ты заслужил. Про себя. Пока.'
            elseif $HallChoiceFamilyTalkGirl = 'sandra':
                $HallChoiceFamilyTalkText = '— В зале сегодня было паскудно, — Сандра вытирает руки. — Мне плевать на шум. Мне важно, на чьей ты стороне. Скажи мне прямо.<br><br>— Не надо мне подвигов. Мне нужна ясность. Я твоя мать, а не гадалка.'
            else:
                $HallChoiceFamilyTalkText = 'Тяжёлый разговор — не о событии, а о том, каким хозяином вы выглядели для семьи.'
            end
        end
    end

    killvar '$HallChoiceFamilyTalkTextId'
---