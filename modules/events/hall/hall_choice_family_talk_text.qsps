! ================================================
! FILE: modules/events/hall/hall_choice_family_talk_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Тексты разговоров семьи о решении Стефана
! Используется:
! modules/events/hall/hall_choice_family_talk.qsps
! ================================================

#HallChoiceFamilyTalkPrintText
    gs 'HallChoiceFamilyTalkText', $ARGS[0]

    if $HallChoiceFamilyTalkText <> '':
        *pl $HallChoiceFamilyTalkText
        *pl ' '
    end
---

#HallChoiceFamilyTalkText
    $HallChoiceFamilyTalkTextId = LCASE($ARGS[0])
    $HallChoiceFamilyTalkText = ''

    if $RealName[$HallChoiceFamilyTalkGirl] = '':
        gs 'EnsureGirlData', $HallChoiceFamilyTalkGirl
    end

    if $HallChoiceFamilyTalkTextId = 'intro':
        if $HallChoiceFamilyTalkGirl = 'amanda':
            $HallChoiceFamilyTalkText = 'Аманда скрещивает руки на груди и с любопытством склоняет голову набок:<br><br>— Ну что, Стефан, рассказывай! Что там в зале приключилось? Я краем глаза видела, но ты ведь был в самом центре. Давай, выкладывай, как всё было, пока я сама себе лишнего не напридумывала!'
        elseif $HallChoiceFamilyTalkGirl = 'melissa':
            $HallChoiceFamilyTalkText = 'Мелисса откладывает записи и внимательно смотрит на вас поверх стола:<br><br>— Я насчёт того случая в зале, Стефан. Итог я знаю, но мне куда интереснее логика твоего поступка. Скажи прямо, чем ты руководствовался? Для меня важно понимать, как ты мыслишь в качестве хозяина.'
        elseif $HallChoiceFamilyTalkGirl = 'sandra':
            $HallChoiceFamilyTalkText = 'Сандра отставляет ковш и вытирает руки льняным полотенцем, глядя на вас с материнской заботой:<br><br>— Присядь на минутку, Стефан. Хочу спросить про то, что сегодня в зале приключилось. Трактир — дело шумное, люди всякие заходят, и мне важно знать, как ты сам смотришь на свои решения. Расскажи матери.'
        else:
            $HallChoiceFamilyTalkText = '— Расскажи о том, что было в зале, — спокойно говорит ' + $RealName[$HallChoiceFamilyTalkGirl] + '. — Мне важно услышать твой собственный взгляд на то, как всё разрешилось.'
        end

    elseif $HallChoiceFamilyTalkTextId = 'reaction':
        if $LastHallChoiceType = 'protect':
            if $HallChoiceFamilyTalkGirl = 'amanda':
                $HallChoiceFamilyTalkText = 'Аманда краснеет до ушей и надувает губки, крутя в руках передник:<br><br>— Ой, ну ладно тебе... Я бы, может, и сама справилась! Наверное.<br><br>Она смущённо улыбается и тепло смотрит на вас:<br><br>— Но всё равно спасибо. Приятно знать, что за спиной есть старший брат, который вовремя вступится и осадит любого наглеца. Я это запомню, Стефан. Хотя зазнаваться не надейся — командовать мной я тебе всё равно не позволю!'
            elseif $HallChoiceFamilyTalkGirl = 'melissa':
                $HallChoiceFamilyTalkText = 'Мелисса сдержанно кивает, и в её глазах мелькает искреннее уважение:<br><br>— Правильно сделал, что вмешался, Стефан. Нельзя позволять пьяному сброду забывать о границах приличий. Трактир должен оставаться солидным заведением, а не балаганом для чьих-то примитивных выходок.<br><br>Она слегка улыбается:<br><br>— Ты показал твёрдый характер настоящего хозяина дома. Конечно, я и сама могла осадить этого глупца парой язвительных цитат, но видеть твою решительность было приятно. Спасибо.'
            elseif $HallChoiceFamilyTalkGirl = 'sandra':
                $HallChoiceFamilyTalkText = 'Сандра с тёплым одобрением кладёт ладонь вам на плечо:<br><br>— Верно поступил, сынок. Не каждый спор стоит доводить до драки, но когда дело касается семьи и порядка — хозяин должен уметь сказать твёрдое слово.<br><br>Она с облегчением улыбается:<br><br>— Мне спокойно на душе, когда я вижу, что ты становишься настоящей опорой для сестёр и дома. Только не задирай нос раньше времени — впереди ещё много забот.'
            else:
                $HallChoiceFamilyTalkText = '— Ты поступил как истинный защитник, — с признательностью произносит ' + $RealName[$HallChoiceFamilyTalkGirl] + '. — В трактире сразу чувствуется, когда за домом стоит надёжное мужское плечо.'
            end

        elseif $LastHallChoiceType = 'calm' or $LastHallChoiceType = 'own_choice' or $LastHallChoiceType = 'watch' or $LastHallChoiceType = 'ignore':
            if $HallChoiceFamilyTalkGirl = 'amanda':
                $HallChoiceFamilyTalkText = 'Аманда задумчиво хмыкает, крутя краешек косы:<br><br>— Ну, ты в этот раз решил не встревать и дать мне самой разобраться. С одной стороны, мне приятно, что ты не держишь меня за несмышлёную девчонку и веришь в мой острый язычок.<br><br>Она весело подмигивает:<br><br>— Но с другой стороны — из-за стойки всё-таки приглядывай! Самостоятельность — это здорово, но чувствовать, что брат рядом, мне куда спокойнее.'
            elseif $HallChoiceFamilyTalkGirl = 'melissa':
                $HallChoiceFamilyTalkText = 'Мелисса слегка приподнимает бровь с лёгкой ироничной усмешкой:<br><br>— Предоставил мне решать самой? Что ж, весьма разумный ход, Стефан. В тонких переговорах с захмелевшей публикой холодная логика и язвительное слово часто работают куда эффективнее, чем кулаки.<br><br>Она поправляет страницы книги:<br><br>— Я прекрасно умею ставить хамов на место без посторонней помощи. Но всё же помни: хозяин трактира должен держать общую картину под контролем, даже когда отдаёт инициативу другим.'
            elseif $HallChoiceFamilyTalkGirl = 'sandra':
                $HallChoiceFamilyTalkText = 'Сандра понимающе кивает, помешивая варево:<br><br>— Не стал вмешиваться сгоряча? Пожалуй, в этом был свой житейский расчёт. Хозяин не обязан бросаться на каждый пьяный выкрик — иногда куда мудрее дать человеку остыть или позволить нам самим сгладить неловкость.<br><br>Она бросает на вас внимательный материнский взгляд:<br><br>— Главное, Стефан, чтобы за этим спокойствием не скрывалась простая беспечность. Трактир требует зоркого глаза, и семья всегда должна чувствовать, что ты держишь руку на пульсе.'
            else:
                $HallChoiceFamilyTalkText = '— Ты доверил решение мне, — кивает ' + $RealName[$HallChoiceFamilyTalkGirl] + '. — Самостоятельность полезна, и я ценю это доверие, но хозяину всегда важно оставаться начеку.'
            end

        elseif $LastHallChoiceType = 'encourage' or $LastHallChoiceType = 'client':
            if $HallChoiceFamilyTalkGirl = 'amanda':
                $HallChoiceFamilyTalkText = 'Аманда взвешивает в ладошке пару серебряных монет, а затем лукаво улыбается:<br><br>— Ну что, Стефан, твой намёк быть с ними поласковее сработал — кошельки у гостей и правда развязались куда быстрее! Звон серебра мне, конечно, по душе, да и комплименты слушать приятно...<br><br>Она шутливо грозит вам пальчиком:<br><br>— Но ты смотри, не увлекайся! Я улыбаюсь тем, кто мне приятен, и на своих условиях. Если какой-нибудь неотёсанный мужлан решит, что за кружку пива ему всё позволено — получит подносом по лбу, и никакие твои хозяйские подмигивания ему не помогут!'
            elseif $HallChoiceFamilyTalkGirl = 'melissa':
                $HallChoiceFamilyTalkText = 'Мелисса с лёгкой снисходительной усмешкой перебирает края чистых листов бумаги:<br><br>— Твоё стремление выжать из визита щедрых гостей максимум выгоды вполне понятно, Стефан. Мужская натура до смешного наивна: стоит подыграть их глупому тщеславию, как они сами радостно выворачивают карманы, воображая себя щедрыми господами.<br><br>Она насмешливо щурится:<br><br>— Я с удовольствием направила их серебро на книги и хорошую бумагу. Но помни: дипломатия в зале должна быть тонкой и умной. Не пытайся превратить это в обязаловку — наше достоинство стоит куда дороже любого щедрого кошелька.'
            elseif $HallChoiceFamilyTalkGirl = 'sandra':
                $HallChoiceFamilyTalkText = 'Сандра накрывает глиняный горшок крышкой и негромко произносит:<br><br>— Выручка сегодня вышла знатная, Стефан, тут не поспоришь. Я сама знаю, что трактир — не монастырь, и без звонкой монеты в амбаре запасов не пополнишь, да и налоги платить надо.<br><br>Она строго, но тепло смотрит вам в глаза:<br><br>— Только помни, сынок: девчонки наши — живые, гордые, и каждая себе цену знает. Подталкивать их к приветливости ради достатка дома — дело понятное, но никогда не требуй от них того, к чему не лежит душа. Серебро приятно греет карман лишь тогда, когда в доме сохраняется доброе имя и покой.'
            else:
                $HallChoiceFamilyTalkText = '— Выгода для трактира важна, и мы это понимаем, — спокойно замечает ' + $RealName[$HallChoiceFamilyTalkGirl] + '. — Главное, чтобы это всегда оставалось в рамках взаимного уважения и здравого смысла.'
            end

        else:
            if $HallChoiceFamilyTalkGirl = 'amanda':
                $HallChoiceFamilyTalkText = 'Аманда слегка пожимает плечами и улыбается:<br><br>— Странный сегодня какой-то вечер в зале вышел, Стефан. То ли ты задумался о чём-то своём, то ли просто выжидал. Впрочем, всё обошлось без лишнего шума — и ладно. Главное, чтобы завтра пиво лилось повеселее!'
            elseif $HallChoiceFamilyTalkGirl = 'melissa':
                $HallChoiceFamilyTalkText = 'Мелисса задумчиво покачивает головой:<br><br>— Не могу сказать, что вполне уловила твой сегодняшний замысел в зале, Стефан. Твои действия выглядели несколько неопределённо. Хозяину полезно иметь чёткую систему и план, иначе гости начнут чувствовать колебания в воздухе. Надеюсь, в следующий раз ты проявишь больше решительности.'
            elseif $HallChoiceFamilyTalkGirl = 'sandra':
                $HallChoiceFamilyTalkText = 'Сандра устало, но по-доброму вздыхает:<br><br>— День выдался суматошный, Стефан. Главное, что крыша на месте, столы целы и никто не побил посуду. Учись понемногу хозяйствовать — опыт сам по себе с неба не падает, всё приходит со временем.'
            else:
                $HallChoiceFamilyTalkText = '— Вечер прошёл не совсем обычно, — говорит ' + $RealName[$HallChoiceFamilyTalkGirl] + '. — Но мы справились, и это главное.'
            end
        end
    end

    killvar '$HallChoiceFamilyTalkTextId'
---