        HallMissingSoftPlayDone[$g] = 0
    end
    if HallMissingHardLadderDone[$g] < 0:
        HallMissingHardLadderDone[$g] = 0
    end

    ! recover phase from flags (save/load / partial)
    if HallMissingHardLadderDone[$g] = 1:
        $HallMissingPhase[$g] = 'free'
    elseif HallMissingSoftPlayDone[$g] = 1:
        $HallMissingPhase[$g] = 'hard'
    elseif HallMissingSoftIntroDone[$g] = 1:
