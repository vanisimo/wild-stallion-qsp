! ================================================
! FILE: modules/events/hall/hall_missing_bargain.qsps
! MODULE: events/hall
! Уговор + phase-лесенка missing (catalog v0.16) — complete wire
!
! HallMissingPhase[girl]: soft_intro | soft_play | hard | free
! soft_intro: 3 hold (look/hug/cock)
! soft_play:  N=3 random soft ± break
! hard:       sisters h0a→mouth→h0b→face→throat; sandra mouth×6 (no cough step)
! free:       mix soft S3 + hard terminals; FlagFaceDone → explicit
!
! Advance: HallMissingPhaseAdvance on peek/ignore
! Text: hall_missing_bargain_text.qsps
! Hooks (offense/rumor code): hall_missing_bargain_hooks.qsps
! Prose archive: archive/hall_missing_text_v016_backup/
! ================================================

#HallMissingBargainEnsureFlags
    if HallMissingBargainSkip < 0:
        HallMissingBargainSkip = 0
    end
    if HallMissingBargainDone < 0:
        HallMissingBargainDone = 0
    end
    if HallMissingPromiseBreak < 0:
        HallMissingPromiseBreak = 0
    end
    if HallMissingSilverExtra < 0:
        HallMissingSilverExtra = 0
    end
    if HallMissingSoftPlayNeed < 1:
        HallMissingSoftPlayNeed = 3
    end
---

! ARGS[0]=girl
#HallMissingPhaseEnsure
    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $g = $HallMissingGirlKey
    if $g = '':
        exit
    end

    if HallMissingSoftPlayNeed < 1:
        HallMissingSoftPlayNeed = 3
    end

    if $HallMissingPhase[$g] = '':
        $HallMissingPhase[$g] = 'soft_intro'
    end

    if HallMissingSoftIntroStep[$g] < 0:
        HallMissingSoftIntroStep[$g] = 0
    end
    if HallMissingSoftPlayCount[$g] < 0:
        HallMissingSoftPlayCount[$g] = 0
    end
    if HallMissingHardStep[$g] < 0:
        HallMissingHardStep[$g] = 0
    end
    if HallMissingHardSub[$g] < 0:
        HallMissingHardSub[$g] = 0
    end
    if HallMissingFlagFaceDone[$g] < 0:
        HallMissingFlagFaceDone[$g] = 0
    end
    if HallMissingFlagMouthMature[$g] < 0:
        HallMissingFlagMouthMature[$g] = 0
    end
    if HallMissingSoftIntroDone[$g] < 0:
        HallMissingSoftIntroDone[$g] = 0
    end
    if HallMissingSoftPlayDone[$g] < 0:
        HallMissingSoftPlayDone[$g] = 0
    end
    if HallMissingHardLadderDone[$g] < 0:
        HallMissingHardLadderDone[$g] = 0
    end
    ! noble: 0=locked 1=after A3 (s1) 2=after A4 mouth (s1+s2) 3=after A6 throat (s1–s3 + free random)
    if HallMissingNobleTier[$g] < 0:
        HallMissingNobleTier[$g] = 0
    end
    if HallMissingNoblePending[$g] < 0:
        HallMissingNoblePending[$g] = 0
    end
    if HallMissingNobleInRandom[$g] < 0:
        HallMissingNobleInRandom[$g] = 0
    end

    ! recover phase from flags (save/load / partial)
    if HallMissingHardLadderDone[$g] = 1:
        $HallMissingPhase[$g] = 'free'
    elseif HallMissingSoftPlayDone[$g] = 1:
        $HallMissingPhase[$g] = 'hard'
    elseif HallMissingSoftIntroDone[$g] = 1:
        $HallMissingPhase[$g] = 'soft_play'
    else
        $HallMissingPhase[$g] = 'soft_intro'
    end

    killvar '$g'
---

! ARGS[0]=girl  ARGS[1]=newTier  — raise tier + pending first show
#HallMissingNobleUnlock
    $ng = $ARGS[0]
    HallMissingNobleNew = $ARGS[1]
    if $ng = 'sandra':
        killvar '$ng'
        killvar 'HallMissingNobleNew'
        exit
    end
    if HallMissingNobleNew < 1:
        HallMissingNobleNew = 1
    end
    if HallMissingNobleNew > 3:
        HallMissingNobleNew = 3
    end
    if HallMissingNobleTier[$ng] < HallMissingNobleNew:
        HallMissingNobleTier[$ng] = HallMissingNobleNew
        HallMissingNoblePending[$ng] = 1
        if HallMissingNobleNew >= 3:
            HallMissingNobleInRandom[$ng] = 1
        end
    end
    killvar '$ng'
    killvar 'HallMissingNobleNew'
---

! HallMissingBargainExplicit = 0|1
! 1 = «этаж прямого языка» в уговоре (не эвфемизмы)
!   сёстры (amanda/melissa): FlagFaceDone=1  — после first hard-лица (A5)
!   sandra: FlagMouthMature=1              — после проглота / зрелого рта
! 0 = мягкий/mid уговор («только гляну», «бутончик», «штурвал»…)
! Используется в hall_missing_bargain_text.qsps: if HallMissingBargainExplicit = 1
#HallMissingBargainIsExplicit
    HallMissingBargainExplicit = 0
    if $HallMissingGirl = '':
        exit
    end
    if $HallMissingGirl = 'sandra':
        if HallMissingFlagMouthMature['sandra'] = 1:
            HallMissingBargainExplicit = 1
        end
    else
        if HallMissingFlagFaceDone[$HallMissingGirl] = 1:
            HallMissingBargainExplicit = 1
        end
    end
---

! ARGS[0]=optional girl key (else $HallMissingGirl)
! out: $HallMissingHardSlot, HallMissingHardSubMax, HallMissingHardStepMax
#HallMissingHardGetSlot
    $hg = $ARGS[0]
    if $hg = '':
        $hg = $HallMissingGirl
    end

    $HallMissingHardSlot = ''
    HallMissingHardSubMax = 1
    HallMissingHardStepMax = 0

    if $hg = 'sandra':
        ! hard first-show: 6 steps (0..5), без DT+кашель
        ! 0 cum_mouth | 1 swallow | 2 show_mouth | 3 cum_face | 4 DT+cum_mouth | 5 DT+cum_throat
        HallMissingHardStepMax = 1
        if HallMissingHardStep[$hg] <= 0:
            $HallMissingHardSlot = 'mouth'
            HallMissingHardSubMax = 6
        end
    else
        ! amanda / melissa
        HallMissingHardStepMax = 5
        HallMissingHardStepIdx = HallMissingHardStep[$hg]
        if HallMissingHardStepIdx < 0:
            HallMissingHardStepIdx = 0
        end
        if HallMissingHardStepIdx = 0:
            $HallMissingHardSlot = 'h0a'
            HallMissingHardSubMax = 4
        elseif HallMissingHardStepIdx = 1:
            $HallMissingHardSlot = 'mouth'
            HallMissingHardSubMax = 5
        elseif HallMissingHardStepIdx = 2:
            $HallMissingHardSlot = 'h0b'
            HallMissingHardSubMax = 2
        elseif HallMissingHardStepIdx = 3:
            $HallMissingHardSlot = 'face'
            ! 0 soft на грудь → 1 high низ лица+рот → FlagFaceDone / Explicit
            HallMissingHardSubMax = 2
        elseif HallMissingHardStepIdx = 4:
            $HallMissingHardSlot = 'throat'
            HallMissingHardSubMax = 5
        else
            $HallMissingHardSlot = ''
            HallMissingHardSubMax = 1
        end
        killvar 'HallMissingHardStepIdx'
    end

    killvar '$hg'
---

! ARGS[0]=girl — after peek/ignore
#HallMissingPhaseAdvance
    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $g = $HallMissingGirlKey
    if $g = '':
        $g = $HallMissingGirl
    end
    if $g = '':
        exit
    end

    gs 'HallMissingPhaseEnsure', $g
    $ph = $HallMissingPhase[$g]

    ! нобиль — боковой слот: не ест soft_play count и не двигает hardStep/Sub
    if LCASE($HallMissingPromise) = 'noble':
        killvar '$g'
        killvar '$ph'
        exit
    end

    if $ph = 'soft_intro':
        HallMissingSoftIntroStep[$g] += 1
        if HallMissingSoftIntroStep[$g] >= 3:
            HallMissingSoftIntroDone[$g] = 1
            HallMissingSoftIntroStep[$g] = 3
            $HallMissingPhase[$g] = 'soft_play'
            ! после A3: нобиль s1 (сёстры)
            if $g <> 'sandra':
                gs 'HallMissingNobleUnlock', $g, 1
            end
        end

    elseif $ph = 'soft_play':
        HallMissingSoftPlayCount[$g] += 1
        if HallMissingSoftPlayCount[$g] >= HallMissingSoftPlayNeed:
            HallMissingSoftPlayDone[$g] = 1
            $HallMissingPhase[$g] = 'hard'
            HallMissingHardStep[$g] = 0
            HallMissingHardSub[$g] = 0
        end

    elseif $ph = 'hard':
        gs 'HallMissingHardGetSlot', $g
        $slot = $HallMissingHardSlot
        HallMissingHardSub[$g] += 1

        if $slot = 'face' and HallMissingHardSub[$g] >= HallMissingHardSubMax:
            HallMissingFlagFaceDone[$g] = 1
        end
        if $g = 'sandra' and $slot = 'mouth' and HallMissingHardSub[$g] >= 2:
            HallMissingFlagMouthMature['sandra'] = 1
        end
        if $g <> 'sandra' and $slot = 'mouth' and HallMissingHardSub[$g] >= 5:
            HallMissingFlagMouthMature[$g] = 1
        end

        if HallMissingHardSub[$g] >= HallMissingHardSubMax:
            HallMissingHardSub[$g] = 0
            ! слот только что закрыт
            if $g <> 'sandra':
                if $slot = 'mouth':
                    ! после A4 (рот): нобиль s1+s2
                    gs 'HallMissingNobleUnlock', $g, 2
                elseif $slot = 'throat':
                    ! после A6 (горло): s1–s3 + random
                    gs 'HallMissingNobleUnlock', $g, 3
                end
            end
            HallMissingHardStep[$g] += 1
            if HallMissingHardStep[$g] >= HallMissingHardStepMax:
                HallMissingHardLadderDone[$g] = 1
                $HallMissingPhase[$g] = 'free'
                if $g = 'sandra':
                    HallMissingFlagMouthMature['sandra'] = 1
                else
                    HallMissingFlagFaceDone[$g] = 1
                    gs 'HallMissingNobleUnlock', $g, 3
                end
            end
        end
        killvar '$slot'

    else
        ! free: no forced ladder advance
    end

    killvar '$g'
    killvar '$ph'
---

! full phase wipe (debug reset)
! ARGS[0]=girl optional; empty = all three
#HallMissingPhaseReset
    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $g = $HallMissingGirlKey
    if $g = '':
        gs 'HallMissingPhaseResetOne', 'amanda'
        gs 'HallMissingPhaseResetOne', 'melissa'
        gs 'HallMissingPhaseResetOne', 'sandra'
        exit
    end
    gs 'HallMissingPhaseResetOne', $g
    killvar '$g'
---

#HallMissingPhaseResetOne
    $g = $ARGS[0]
    $HallMissingPhase[$g] = 'soft_intro'
    HallMissingSoftIntroStep[$g] = 0
    HallMissingSoftPlayCount[$g] = 0
    HallMissingHardStep[$g] = 0
    HallMissingHardSub[$g] = 0
    HallMissingFlagFaceDone[$g] = 0
    HallMissingFlagMouthMature[$g] = 0
    HallMissingSoftIntroDone[$g] = 0
    HallMissingSoftPlayDone[$g] = 0
    HallMissingHardLadderDone[$g] = 0
    HallMissingNobleTier[$g] = 0
    HallMissingNoblePending[$g] = 0
    HallMissingNobleInRandom[$g] = 0
    killvar '$g'
---

! ARGS[0]=girl, ARGS[1]=return loc
#HallMissingBargainStart
    *clr
    clr
    cla

    gs 'HallSceneV2EnsureFlags'
    gs 'HallMissingBargainEnsureFlags'
    HallMissingCuniToAnilingus = 0

    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $HallMissingGirl = $HallMissingGirlKey
    $HallMissingReturnLoc = $ARGS[1]

    if $HallMissingGirl = '':
        $HallMissingGirl = $HallHarassGirl
    end
    if $HallMissingGirl = '':
        $HallMissingGirl = 'amanda'
    end
    if $HallMissingReturnLoc = '':
        $HallMissingReturnLoc = $HallHarassReturnLoc
    end
    if $HallMissingReturnLoc = '':
        $HallMissingReturnLoc = 'TavernMain'
    end
    if LOC($HallMissingReturnLoc) = 0:
        $HallMissingReturnLoc = 'TavernMain'
    end

    if HallMissingBargainSkip = 1:
        HallMissingBargainSkip = 0
        HallMissingBargainDone = 0
        gt 'HallMissingGirlStartFromPlay', $HallMissingGirl, $HallMissingReturnLoc
    end

    if FamilyLiberationGateOpen = 0 or Act1MoralUnlocked = 0 or FamilyCorruptionStage < 3:
        gt $HallMissingReturnLoc
    end

    gs 'HallMissingPhaseEnsure', $HallMissingGirl
    gs 'HallMissingGirlEnsureName', $HallMissingGirl
    gs 'HallMissingGirlGetStage', $HallMissingGirl

    $HallMissingFinish = ''
    HallMissingPromiseBreak = 0
    HallMissingSilverExtra = 0

    if $HallHarassClient <> '':
        $HallMissingClient = $HallHarassClient
    elseif $HallMissingClient = '':
        if LOC('HallMissingGirlPickClientV2') = 1:
            gs 'HallMissingGirlPickClientV2'
        else
            $HallMissingClient = 'rich_merchant'
        end
    end
    ! flavor tags ДО PickPromise / free-bias (Сандра PreferAct/Finish)
    if LOC('HallMissingApplyClientFlavorTags') = 1:
        gs 'HallMissingApplyClientFlavorTags'
    end

    $HallLewdClient = $HallMissingClient
    if LOC('HallLewdFillClientBits') = 1:
        gs 'HallLewdFillClientBits'
    else
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end

    gs 'HallMissingBargainIsExplicit'
    gs 'HallMissingBargainPickStyle'
    gs 'HallMissingBargainPickPromise'
    gs 'HallMissingBargainIsExplicit'

    HallMissingFromPlay = 1
    HallMissingBargainDone = 0

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $HallMissingGirl
    end

    ! из harass play+смотреть: дверь уже видели → сразу уговор
    if HallMissingSkipNotice = 1:
        HallMissingSkipNotice = 0
        gt 'HallMissingBargainTalk'
    end

    *pl '══════════════════════════════════════════════'
    if $HallMissingGirl = 'sandra':
        *pl ' У КУХОННОЙ ДВЕРИ'
    else
        *pl ' У ДВЕРИ ПОДСОБКИ'
    end
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('HallMissingGirlShowImage') = 1:
        gs 'HallMissingGirlShowImage', 'intro'
    end
    gs 'HallMissingBargainPrintNotice'
    *pl ' '

    gs 'ActUiPrepare', 'Подсмотреть', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'HallMissingBargainTalk'
    end
---

! окно 2 — уговор
#HallMissingBargainTalk
    *clr
    clr
    cla

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $HallMissingGirl
    end

    *pl '══════════════════════════════════════════════'
    *pl ' УГОВОР'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'HallMissingBargainShowImage'
    gs 'HallMissingBargainPrintText'
    if $HallMissingPromise = 'hug_waist' or $HallMissingPromise = 'kitchen_waist_hug':
        if HallMissingBargainRefused <> 1:
            *pl ' '
            gs 'HallMissingBargainPrintHugTail'
        end
    end
    *pl ' '

    if debug = 1:
        *pl '[DEBUG BARGAIN] girl=' + $HallMissingGirl + ' phase=' + $HallMissingPhase[$HallMissingGirl]
        *pl '[DEBUG BARGAIN] style=' + $HallMissingBargainStyle + ' promise=' + $HallMissingPromise + ' explicit=' + STR(HallMissingBargainExplicit)
        *pl '[DEBUG BARGAIN] intro=' + STR(HallMissingSoftIntroStep[$HallMissingGirl]) + '/' + STR(HallMissingSoftIntroDone[$HallMissingGirl]) + ' play=' + STR(HallMissingSoftPlayCount[$HallMissingGirl]) + '/' + STR(HallMissingSoftPlayDone[$HallMissingGirl])
        *pl '[DEBUG BARGAIN] hardStep=' + STR(HallMissingHardStep[$HallMissingGirl]) + ' hardSub=' + STR(HallMissingHardSub[$HallMissingGirl]) + ' face=' + STR(HallMissingFlagFaceDone[$HallMissingGirl]) + ' mouthMat=' + STR(HallMissingFlagMouthMature[$HallMissingGirl])
        *pl ' '
    end

    if HallMissingBargainRefused = 1:
        gs 'ActUiPrepare', 'Вернуться к работе', 'return'
        act $ActUiLabel, $ActUiIconPath:
            if $HallMissingReturnLoc <> '' and LOC($HallMissingReturnLoc) = 1:
                gt $HallMissingReturnLoc
            else
                gt 'TavernMain'
            end
        end
        exit
    end

    gs 'HallMissingBargainBuildMenu'
    *p 'Что делать <a href="exec:gs ''Menu.Show'', ''HallMissingBargainMenu''">Стефану</a>?'
---

#HallMissingBargainBuildMenu
    gs 'Menu.Destroy', 'HallMissingBargainMenu'
    gs 'Menu.Create', 'HallMissingBargainMenu'
    gs 'MenuUiAdd', 'HallMissingBargainMenu', 'Защитить', ''
    gs 'Menu.AddModule', 'HallMissingBargainMenu', {
        $HallMissingBargainNext = 'protect_hard'
        gt 'HallMissingBargainContinue'
    }
    if FamilyLiberationGateOpen = 1:
        gs 'MenuUiAdd', 'HallMissingBargainMenu', 'Смотреть', ''
        gs 'Menu.AddModule', 'HallMissingBargainMenu', {
            $HallMissingBargainNext = 'watch'
            gt 'HallMissingBargainContinue'
        }
        gs 'MenuUiAdd', 'HallMissingBargainMenu', 'Отвернуться', ''
        gs 'Menu.AddModule', 'HallMissingBargainMenu', {
            $HallMissingBargainNext = 'ignore'
            gt 'HallMissingBargainContinue'
        }
    end
---

#HallMissingBargainPickStyle
    $HallMissingBargainStyle = 'soft'
    HallMissingBargainBand = 1
    $ph = $HallMissingPhase[$HallMissingGirl]

    if $ph = 'soft_intro' or $ph = 'soft_play':
        $HallMissingBargainStyle = 'soft'
        HallMissingBargainBand = 1
    elseif $ph = 'hard':
        $HallMissingBargainStyle = 'hard'
        HallMissingBargainBand = 3
    else
        if HallMissingBargainExplicit = 1:
            if RAND(1, 100) <= 55:
                $HallMissingBargainStyle = 'hard'
                HallMissingBargainBand = 3
            else
                $HallMissingBargainStyle = 'soft'
                HallMissingBargainBand = 2
            end
        else
            if RAND(1, 100) <= 40:
                $HallMissingBargainStyle = 'hard'
                HallMissingBargainBand = 2
            else
                $HallMissingBargainStyle = 'soft'
                HallMissingBargainBand = 1
            end
        end
    end

    if $HallMissingBargainStyleForce = 'soft' or $HallMissingBargainStyleForce = 'hard':
        $HallMissingBargainStyle = $HallMissingBargainStyleForce
        $HallMissingBargainStyleForce = ''
    end

    killvar '$ph'
---

#HallMissingBargainPickPromise
    $ph = $HallMissingPhase[$HallMissingGirl]

    if $ph = 'soft_intro':
        $HallMissingInitiative = 'low'
    elseif HallMissingBargainExplicit = 1:
        $HallMissingInitiative = 'high'
    elseif GirlHallLewdStage[$HallMissingGirl] >= 3 or HallMissingGirlStage >= 4:
        $HallMissingInitiative = 'high'
    else
        $HallMissingInitiative = 'low'
    end

    HallMissingPromiseRoll = RAND(1, 100)
    $HallMissingPromise = ''
    $HallMissingFinish = ''

    ! debug / force
    if $HallMissingPromiseForce <> '':
        $HallMissingPromise = LCASE($HallMissingPromiseForce)
        $HallMissingPromiseForce = ''
        if $HallMissingPromise = 'noble':
            $HallMissingClient = 'noble'
            if HallMissingNobleTier[$HallMissingGirl] < 1:
                HallMissingNobleTier[$HallMissingGirl] = 1
            end
            HallMissingNobleScreens = HallMissingNobleTier[$HallMissingGirl]
            if HallMissingNobleScreens < 1:
                HallMissingNobleScreens = 1
            end
            if HallMissingNobleScreens > 3:
                HallMissingNobleScreens = 3
            end
        end
        killvar 'HallMissingPromiseRoll'
        killvar '$ph'
        exit
    end

    ! pending first noble after unlock (сёстры) — даже между hard-шагами (после A3/A4/A6)
    if $HallMissingGirl <> 'sandra' and HallMissingNoblePending[$HallMissingGirl] = 1 and $ph <> 'soft_intro':
        $HallMissingPromise = 'noble'
        $HallMissingClient = 'noble'
        HallMissingNoblePending[$HallMissingGirl] = 0
        HallMissingNobleScreens = HallMissingNobleTier[$HallMissingGirl]
        if HallMissingNobleScreens < 1:
            HallMissingNobleScreens = 1
        end
        if HallMissingNobleScreens > 3:
            HallMissingNobleScreens = 3
        end
        killvar 'HallMissingPromiseRoll'
        killvar '$ph'
        exit
    end

    if $ph = 'soft_intro':
        HallMissingIntroIdx = HallMissingSoftIntroStep[$HallMissingGirl]
        if HallMissingIntroIdx < 0:
            HallMissingIntroIdx = 0
        end
        if HallMissingIntroIdx > 2:
            HallMissingIntroIdx = 2
        end
        if HallMissingIntroIdx = 0:
            $HallMissingPromise = 'look_tits'
        elseif HallMissingIntroIdx = 1:
            $HallMissingPromise = 'hug_waist'
        else
            $HallMissingPromise = 'touch_cock'
        end
        if $HallMissingGirl = 'melissa' and $HallMissingPromise = 'look_tits':
            $HallMissingPromise = 'look_line'
        end
        killvar 'HallMissingIntroIdx'

    elseif $ph = 'soft_play':
        ! random soft only; noble — via pending after A3 (не random, чтобы не дублировать)
        if HallMissingPromiseRoll <= 33:
            $HallMissingPromise = 'look_tits'
        elseif HallMissingPromiseRoll <= 66:
            $HallMissingPromise = 'hug_waist'
        else
            $HallMissingPromise = 'touch_cock'
        end
        if $HallMissingGirl = 'melissa' and $HallMissingPromise = 'look_tits':
            $HallMissingPromise = 'look_line'
        end

    elseif $ph = 'hard':
        gs 'HallMissingHardGetSlot', $HallMissingGirl
        if $HallMissingHardSlot = 'h0a':
            if $HallMissingGirl = 'melissa':
                $HallMissingPromise = 'bud_smell'
            else
                $HallMissingPromise = 'piggy_look'
            end
        elseif $HallMissingHardSlot = 'h0b':
            if $HallMissingGirl = 'melissa':
                $HallMissingPromise = 'bud_cuni'
            else
                $HallMissingPromise = 'piggy_cuni'
            end
        elseif $HallMissingHardSlot = 'mouth':
            $HallMissingPromise = 'mouth_hard'
        elseif $HallMissingHardSlot = 'face':
            $HallMissingPromise = 'facial'
        elseif $HallMissingHardSlot = 'throat':
            $HallMissingPromise = 'deepthroat'
        else
            $HallMissingPromise = 'mouth_hard'
        end

    else
        ! free: полный нобиль s1–s3 только после A6 (InRandom)
        if $HallMissingGirl <> 'sandra' and HallMissingNobleInRandom[$HallMissingGirl] = 1 and HallMissingPromiseRoll <= 12:
            $HallMissingPromise = 'noble'
            $HallMissingClient = 'noble'
            HallMissingNobleScreens = 3
        elseif $HallMissingBargainStyle = 'soft':
            if HallMissingPromiseRoll <= 33:
                $HallMissingPromise = 'look_tits'
            elseif HallMissingPromiseRoll <= 66:
                $HallMissingPromise = 'hug_waist'
            else
                $HallMissingPromise = 'touch_cock'
            end
            if $HallMissingGirl = 'melissa' and $HallMissingPromise = 'look_tits':
                $HallMissingPromise = 'look_line'
            end
        else
            ! free hard: у Сандры bias по client flavor tags (см. HallMissingApplyClientFlavorTags)
            if $HallMissingGirl = 'sandra' and $HallMissingClientPreferAct <> '':
                HallMissingFreeHard = RAND(1, 100)
                if $HallMissingClientPreferAct = 'hand':
                    ! моряк: рука / большой член — чаще hand, реже titjob
                    if HallMissingFreeHard <= 55:
                        $HallMissingPromise = 'hand_quick'
                    elseif HallMissingFreeHard <= 80:
                        $HallMissingPromise = 'titjob'
                    else
                        $HallMissingPromise = 'mouth_hard'
                    end
                elseif $HallMissingClientPreferAct = 'mouth':
                    ! купец: отсос + в рот / толстый член
                    if HallMissingFreeHard <= 60:
                        $HallMissingPromise = 'mouth_hard'
                    elseif HallMissingFreeHard <= 85:
                        $HallMissingPromise = 'deepthroat'
                    else
                        $HallMissingPromise = 'facial'
                    end
                elseif $HallMissingClientPreferAct = 'facial':
                    ! мастеровой: на лицо, обильно
                    if HallMissingFreeHard <= 55:
                        $HallMissingPromise = 'facial'
                    elseif HallMissingFreeHard <= 80:
                        $HallMissingPromise = 'mouth_hard'
                    else
                        $HallMissingPromise = 'hand_quick'
                    end
                else
                    $HallMissingPromise = 'mouth_hard'
                end
                killvar 'HallMissingFreeHard'
            else
                HallMissingFreeHard = RAND(1, 100)
                if HallMissingFreeHard <= 28:
                    $HallMissingPromise = 'mouth_hard'
                elseif HallMissingFreeHard <= 48:
                    $HallMissingPromise = 'facial'
                elseif HallMissingFreeHard <= 68:
                    $HallMissingPromise = 'deepthroat'
                elseif $HallMissingGirl = 'sandra':
                    $HallMissingPromise = 'titjob'
                elseif $HallMissingGirl = 'melissa':
                    $HallMissingPromise = 'bud_cuni'
                else
                    $HallMissingPromise = 'piggy_cuni'
                end
                killvar 'HallMissingFreeHard'
            end
        end
    end

    killvar 'HallMissingPromiseRoll'
    killvar '$ph'
---

#HallMissingApplyPromiseToAct
    if $HallMissingPromise = '':
        exit
    end

    $p = LCASE($HallMissingPromise)
    HallMissingPromiseBreak = 0
    HallMissingSilverExtra = 0
    $ph = $HallMissingPhase[$HallMissingGirl]
    HallMissingCurSub = HallMissingHardSub[$HallMissingGirl]
    if HallMissingCurSub < 0:
        HallMissingCurSub = 0
    end

    HallMissingForceHold = 0
    if $ph = 'soft_intro':
        HallMissingForceHold = 1
    end

    if $p = 'look_tits' or $p = 'look_line':
        $HallMissingPrivateAct = 'look_tits'
        if HallMissingBargainExplicit = 1:
            HallMissingPromiseBreak = 1
        end

    elseif $p = 'hug_waist' or $p = 'kitchen_waist_hug':
        $HallMissingPrivateAct = 'hug_waist'
        if HallMissingBargainExplicit = 1:
            HallMissingPromiseBreak = 1
        end

    elseif $p = 'touch_cock':
        $HallMissingPrivateAct = 'hand'
        if HallMissingBargainExplicit = 1:
            HallMissingPromiseBreak = 1
        end

    elseif $p = 'bud_smell' or $p = 'piggy_look':
        if HallMissingCurSub <= 0:
            $HallMissingPrivateAct = 'look_tits'
        elseif HallMissingCurSub = 1:
            $HallMissingPrivateAct = 'touch_thigh'
        elseif HallMissingCurSub = 2:
            $HallMissingPrivateAct = 'hug_waist'
            HallMissingBargainExplicit = 1
            HallMissingPromiseBreak = 1
        else
            $HallMissingPrivateAct = 'cuni'
            HallMissingPromiseBreak = 1
        end

    elseif $p = 'bud_cuni' or $p = 'piggy_cuni':
        $HallMissingPrivateAct = 'cuni'
        if HallMissingCurSub > 0 and $HallMissingGirl <> 'sandra':
            HallMissingCuniToAnilingus = 1
            HallMissingBargainExplicit = 1
            $HallMissingInitiative = 'high'
        end

    elseif $p = 'mouth_hard' or $p = 'mouth_spit' or $p = 'mouth_swallow' or $p = 'mouth_price' or $p = 'swallow_trade':
        $HallMissingPrivateAct = 'mouth'
        if $HallMissingGirl = 'sandra':
            ! Sandra hard mouth ladder (×6, no cough):
            ! 0 mouth_mid+cum_mouth → 1 swallow → 2 show_mouth → 3 facial
            ! → 4 deepthroat+cum_mouth → 5 deepthroat+cum_throat → free
            ! free (ladder done): flavor finish по типажу
            if HallMissingHardLadderDone['sandra'] = 1:
                ! free mouth_hard: finish по типажу (face / mouth); hand-prefer → всё равно рот
                if $HallMissingClientPreferFinish = 'cum_face':
                    $HallMissingFinish = 'cum_face'
                    $HallMissingPrivateAct = 'mouth'
                else
                    $HallMissingFinish = 'cum_mouth'
                end
            elseif HallMissingCurSub = 0:
                $HallMissingFinish = 'cum_mouth'
            elseif HallMissingCurSub = 1:
                $HallMissingFinish = 'swallow'
            elseif HallMissingCurSub = 2:
                $HallMissingFinish = 'show_mouth'
            elseif HallMissingCurSub = 3:
                $HallMissingFinish = 'cum_face'
            elseif HallMissingCurSub = 4:
                $HallMissingPrivateAct = 'deepthroat'
                $HallMissingFinish = 'cum_mouth'
            else
                $HallMissingPrivateAct = 'deepthroat'
                $HallMissingFinish = 'cum_throat'
            end
        else
            ! сёстры mouth×5: wipe → taste → spit → hold_spit(=spit scene) → swallow
            ! finish=show_mouth НЕ выдаём (show = beat внутри swallow high). Late/debug only.
            if HallMissingCurSub <= 0:
                $HallMissingFinish = 'wipe'
            elseif HallMissingCurSub = 1:
                $HallMissingFinish = 'taste'
            elseif HallMissingCurSub = 2:
                $HallMissingFinish = 'spit'
            elseif HallMissingCurSub = 3:
                $HallMissingFinish = 'hold_spit'
            else
                $HallMissingFinish = 'swallow'
            end
        end
        if RAND(1, 100) <= 40:
            HallMissingSilverExtra = 1
        end

    elseif $p = 'facial':
        $HallMissingPrivateAct = 'mouth'
        if $HallMissingGirl = 'sandra' and HallMissingHardLadderDone['sandra'] = 1:
            $HallMissingFinish = 'cum_face'
        elseif $HallMissingGirl <> 'sandra' and (HallMissingFlagFaceDone[$HallMissingGirl] = 1 or HallMissingBargainExplicit = 1):
            $HallMissingFinish = 'cum_face_high'
        elseif HallMissingCurSub = 0:
            $HallMissingFinish = 'cum_face_soft'
        else
            $HallMissingFinish = 'cum_face'
        end

    elseif $p = 'deepthroat':
        $HallMissingPrivateAct = 'deepthroat'
        if $HallMissingGirl = 'sandra' and HallMissingHardLadderDone['sandra'] = 1:
            ! free DT: finish по типажу (купец → в рот; иначе горло)
            if $HallMissingClientPreferFinish = 'cum_mouth':
                $HallMissingFinish = 'cum_mouth'
            elseif $HallMissingClientPreferFinish = 'cum_face':
                $HallMissingFinish = 'cum_mouth'
            else
                $HallMissingFinish = 'cum_throat'
            end
        elseif HallMissingCurSub <= 0:
            $HallMissingFinish = 'try'
        elseif HallMissingCurSub = 1:
            $HallMissingFinish = 'partial'
        elseif HallMissingCurSub = 2:
            $HallMissingFinish = 'full'
        elseif HallMissingCurSub = 3:
            $HallMissingFinish = 'cum_mouth'
        else
            $HallMissingFinish = 'cum_throat'
        end

    elseif $p = 'titjob':
        if $HallMissingGirl = 'sandra':
            $HallMissingPrivateAct = 'titjob'
        else
            $HallMissingPrivateAct = 'look_tits'
        end

    elseif $p = 'noble':
        ! только amanda/melissa; экраны = HallMissingNobleScreens (1/2/3)
        if $HallMissingGirl = 'sandra':
            $HallMissingPrivateAct = 'hand'
            $HallMissingPromise = 'touch_cock'
        else
            $HallMissingPrivateAct = 'mouth'
            $HallMissingClient = 'noble'
            $HallMissingFinish = 'noble'
            HallMissingPromiseBreak = 0
            HallMissingSilverExtra = 0
            if HallMissingNobleScreens < 1:
                HallMissingNobleScreens = HallMissingNobleTier[$HallMissingGirl]
            end
            if HallMissingNobleScreens < 1:
                HallMissingNobleScreens = 1
            end
            if HallMissingNobleScreens > 3:
                HallMissingNobleScreens = 3
            end
        end

    elseif $p = 'hand_quick' or $p = 'hand_strict' or $p = 'hand_pragmatic':
        $HallMissingPrivateAct = 'hand'

    elseif $p = 'cuni':
        $HallMissingPrivateAct = 'cuni'

    else
        $HallMissingPrivateAct = 'hug_waist'
    end

    killvar '$p'
    killvar '$ph'
    killvar 'HallMissingForceHold'
    killvar 'HallMissingCurSub'
---

#HallMissingBargainShowImage
    if $HallMissingGirl = '':
        exit
    end
    ! тот же pipeline, что agent missing — stub + [VIS] caption
    if LOC('HallMissingGirlShowImage') = 1:
        gs 'HallMissingGirlShowImage', 'bargain'
    elseif LOC('SceneShowVisual') = 1:
        if $HallMissingGirl = 'sandra':
            gs 'SceneShowVisual', 'images/events/sandra/hall_missing/bargain_kitchen_uniform0', 'missing bargain: sandra kitchen', 'large', 'webp'
        else
            gs 'SceneShowVisual', 'images/events/' + $HallMissingGirl + '/hall_missing/bargain_hall_uniform0', 'missing bargain: ' + $HallMissingGirl + ' hall', 'large', 'webp'
        end
    elseif LOC('ShowImage') = 1:
        gs 'ShowImage', 'common', '', 'hall_scene_stub', '', 'png', 'large'
        *pl '<center><small>[VIS] missing bargain</small></center>'
        *pl ' '
    end
---

#HallMissingBargainContinue
    HallMissingBargainDone = 1
    if $HallMissingBargainNext = '':
        $HallMissingBargainNext = 'watch'
    end
    if $HallMissingReturnLoc = '':
        $HallMissingReturnLoc = 'TavernMain'
    end
    gt 'HallMissingGirlStartFromPlay', $HallMissingGirl, $HallMissingReturnLoc
---

! ARGS[0]=girl, ARGS[1]=soft|hard, ARGS[2]=return
#HallMissingBargainDebugStart
    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $HallMissingGirl = $HallMissingGirlKey
    if $HallMissingGirl = '':
        $HallMissingGirl = 'amanda'
    end

    $HallMissingBargainStyleForce = LCASE($ARGS[1])
    if $HallMissingBargainStyleForce <> 'soft' and $HallMissingBargainStyleForce <> 'hard':
        $HallMissingBargainStyleForce = ''
    end

    $HallMissingReturnLoc = $ARGS[2]
    if $HallMissingReturnLoc = '':
        $HallMissingReturnLoc = 'TavernMain'
    end

    FamilyLiberationGateOpen = 1
    Act1MoralUnlocked = 1
    FamilyCouncilDone = 1
    if FamilyCorruptionStage < 3:
        FamilyCorruptionStage = 3
    end

    HallMissingBargainSkip = 0
    HallMissingBargainDone = 0
    HallMissingFromPlay = 1
    $HallMissingClient = ''
    $HallMissingFinish = ''

    if $HallHarassClient = '':
        $HallHarassClient = 'craftsman'
    end
    $HallHarassGirl = $HallMissingGirl
    $HallHarassStanceCanon = 'play'
    $HarassGirlStance = 'provoke'

    gs 'HallMissingPhaseEnsure', $HallMissingGirl
    gt 'HallMissingBargainStart', $HallMissingGirl, $HallMissingReturnLoc
---

! ARGS[0]=girl ARGS[1]=soft_intro|soft_play|hard|free
#HallMissingPhaseDebugSet
    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $g = $HallMissingGirlKey
    if $g = '':
        $g = 'amanda'
    end

    gs 'HallMissingPhaseResetOne', $g
    $HallMissingPhase[$g] = LCASE($ARGS[1])

    if $HallMissingPhase[$g] = 'soft_play':
        HallMissingSoftIntroDone[$g] = 1
        HallMissingSoftIntroStep[$g] = 3
        $HallMissingPhase[$g] = 'soft_play'
    elseif $HallMissingPhase[$g] = 'hard':
        HallMissingSoftIntroDone[$g] = 1
        HallMissingSoftPlayDone[$g] = 1
        HallMissingSoftPlayCount[$g] = HallMissingSoftPlayNeed
        HallMissingHardStep[$g] = 0
        HallMissingHardSub[$g] = 0
        $HallMissingPhase[$g] = 'hard'
    elseif $HallMissingPhase[$g] = 'free':
        HallMissingSoftIntroDone[$g] = 1
        HallMissingSoftPlayDone[$g] = 1
        HallMissingHardLadderDone[$g] = 1
        HallMissingFlagFaceDone[$g] = 1
        HallMissingFlagMouthMature[$g] = 1
        $HallMissingPhase[$g] = 'free'
    else
        $HallMissingPhase[$g] = 'soft_intro'
    end

    if debug = 1:
        *pl '[DEBUG] phase set ' + $g + ' → ' + $HallMissingPhase[$g]
    end
    killvar '$g'
---
