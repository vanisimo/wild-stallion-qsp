! ================================================
! FILE: modules/events/hall/hall_family_reactions_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Тексты семейных реакций на события в зале
! Используется: hall_family_reactions.qsps
! ================================================

#HallFamilyReactionText
    $HallFamilyReactionTextGirl = LCASE($ARGS[0])

    if $HallFamilyReactionTextGirl = 'amanda':
        if HallRecentSeverity >= 2:
            *pl 'Аманда молчит дольше обычного, теребя ленту на фартуке. Наконец не выдерживает:'
            *pl '— Хватит на меня так смотреть, Стефан.'
            *pl 'Она поджимает губы, избегая прямого взгляда:'
            *pl '— Я пытаюсь отшучиваться с гостями, а внутри самой тошно. И не делай вид, будто ничего не произошло.'
        else:
            *pl 'Аманда наигранно смеётся, но смех выходит слишком звонким:'
            *pl '— Да ладно тебе, всё в порядке было!'
            *pl 'Тут же осекается и смущённо крутит края фартука: — Скажи хоть слово, а? А то я стою тут перед тобой и глупо себя чувствую.'
        end
    elseif $HallFamilyReactionTextGirl = 'melissa':
        if HallRecentSeverity >= 2:
            *pl 'Мелисса смотрит на тебя в упор, сложив руки на груди:'
            *pl '— Ты ведь всё видел, Стефан.'
            *pl 'Пауза.'
            *pl '— Я видела, что ты стоял и смотрел. Устраивать сцен я не буду, не дождёшься. Но я всё запомнила. И ты запомни.'
        else:
            *pl '— Подумаешь, обычное дело, — Мелисса равнодушно жмёт плечом. — В зале и не такое бывает.'
            *pl 'Однако её взгляд остаётся острым и внимательным:'
            *pl '— Ты лучше скажи прямо, что сам об этом думаешь. А то я решу за тебя, и тебе это точно не понравится.'
        end
    elseif $HallFamilyReactionTextGirl = 'sandra':
        if HallRecentSeverity >= 2:
            *pl 'Сандра с грохотом ставит кастрюлю на стол:'
            *pl '— Видел, что в зале творится?'
            *pl 'Она вытирает руки полотенцем, глядя на тебя сурово и твёрдо:'
            *pl '— Девчонки всё видят. Гости тоже. Я не собираюсь читать тебе нотации, Стефан. Я просто хочу знать: ты всё ещё наш брат и хозяин трактира или просто делец, считающий серебро?'
        else:
            *pl '— Зал есть зал, — Сандра отмахивается деревянной ложкой.'
            *pl 'Но тон её голоса звучит предостерегающе:'
            *pl '— Только не привыкай считать это нормой. Сегодня уступишь в малом — завтра из заведения притон сделают. А мне потом всё это разгребать.'
        end
    else:
        if HallRecentSeverity >= 2:
            *pl $RealName[$HallFamilyReactionTextGirl] + ' молчит, затем тяжело вздыхает:'
            *pl '— Все всё видели, хозяин.'
            *pl 'Она отворачивается к работе, но взгляд говорит сам за себя.'
        else:
            *pl $RealName[$HallFamilyReactionTextGirl] + ' хмыкает:'
            *pl '— Бывает, что уж тут. Зал шумный.'
            *pl 'Слегка качает головой:'
            *pl '— Ты бы присматривал за ними получше, а то в следующий раз одним шумом дело не обойдётся.'
        end
    end

    killvar '$HallFamilyReactionTextGirl'
---
