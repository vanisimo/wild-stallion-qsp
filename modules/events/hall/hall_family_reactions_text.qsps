! ================================================
! FILE: modules/events/hall/hall_family_reactions_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Тексты семейных реакций на события в зале
! Используется: hall_family_reactions.qsps
! ================================================

#HallFamilyReactionText
    $HallFamilyReactionTextGirl = LCASE($ARGS[0])

    if $HallFamilyReactionTextGirl = 'amanda':
        if HallRecentSeverity >= 2:
            *pl 'Аманда раздражённо скрещивает руки на груди, нервно притоптывая ножкой:'
            *pl '— Ну и шум подняли в зале, Стефан! Ты же видел, как этот гость начал наглеть? Я думала, у него совсем тормоза отказали.'
            *pl 'Она сердито дует на выбившуюся прядку и бросает на вас выразительный взгляд:'
            *pl '— Одно дело — мило поболтать и улыбнуться ради чаевых, и совсем другое — когда мужики начинают путать трактир с портовой дырой. Я, конечно, и сама могу подносом приложить, но ты за стойкой тоже клювом не щелкай! Хозяин ты тут или кто?'
        else:
            *pl 'Аманда беспечно отмахивается и слегка улыбается, хотя щёки её всё ещё слегка розовеют:'
            *pl '— Да ладно тебе хмуриться, Стефан! Подумаешь, хмельной гость решил лишний раз комплимент отвесить. Обошлось ведь без драки!'
            *pl 'Она весело фыркает и поправляет передник:'
            *pl '— Зато вина они заказали больше обычного. В следующий раз я с ними ещё ловчее справлюсь, вот увидишь.'
        end
    elseif $HallFamilyReactionTextGirl = 'melissa':
        if HallRecentSeverity >= 2:
            *pl 'Мелисса с безупречно прямой спиной скрещивает руки на груди, оглядывая вас с лёгкой ироничной прищуренностью:'
            *pl '— Ну что, Стефан, поздравляю с боевым крещением зала. Твоя хвалёная хозяйская дипломатия сегодня едва не закончилась грандиозной потасовкой.'
            *pl 'Она снисходительно качает головой, чуть приподняв бровь:'
            *pl '— Мужская примитивная похоть, конечно, штука предсказуемая, но когда захмелевшие гости начинают терять берега, одной вежливости мало. На будущее: держи границы чётче с самого начала. Трактир должен приносить серебро на книги и припасы, а не превращаться в балаган для дураков.'
        else:
            *pl '— Тривиальный случай трактирной невоспитанности, — Мелисса небрежно пожимает плечами, аккуратно поправляя воротник. — Впрочем, от публики подобного разлива тонких манер ожидать и не приходилось.'
            *pl 'Она бросает на вас внимательный, насмешливый взгляд:'
            *pl '— Главное, Стефан, чтобы твоя терпимость к чужой простоте не вошла в привычку. Доить их кошельки — дело полезное, но только пока мы сами управляем залом, а не подстраиваемся под чужую глупость.'
        end
    elseif $HallFamilyReactionTextGirl = 'sandra':
        if HallRecentSeverity >= 2:
            *pl 'Сандра с глухим стуком опускает медный ковш на разделочный стол и оборачивается к вам, вытирая руки полотенцем:'
            *pl '— Ты ведь сам видел, Стефан, до чего там чуть не дошло за столами?'
            *pl 'Она смотрит на вас строго, но с материнской заботой:'
            *pl '— Трактир нам достался не для того, чтобы под пьяные крики плясать. Девчонки молодые, они на тебя оглядываются, да и городские любят языками чесать. Прибыль дому нужна, это верно, но честь семьи и порядок дороже любых серебряных монет. Держи зал твёрже, сын, и не позволяй наглецам забывать, чей это дом.'
        else:
            *pl '— Трактир есть трактир, пьяной дури за столами всегда хватало, — Сандра спокойно отмахивается деревянной ложкой.'
            *pl 'Она бросает на вас внимательный, хозяйский взгляд:'
            *pl '— Обошлось сегодня малой кровью — и слава Ильматеру. Только ты, Стефан, ухо востро держи: спустишь гостям одну вольность ради кружки эля — завтра они сядут на шею. Следи за залом, чтобы мир в доме держался.'
        end
    else:
        if HallRecentSeverity >= 2:
            *pl $RealName[$HallFamilyReactionTextGirl] + ' озабоченно качает головой, глядя в сторону шумного зала:'
            *pl '— Жаркий сегодня денёк выдался, хозяин. Гости совсем разгулялись, едва до беды не дошло.'
            *pl 'Она серьёзно смотрит на вас:'
            *pl '— Хорошо, что обошлось, но порядок в зале надо держать строже, иначе публика быстро потеряет берега.'
        else:
            *pl $RealName[$HallFamilyReactionTextGirl] + ' слегка усмехается, продолжая протирать посуду:'
            *pl '— Бывает, чего уж там. Народ хмельной, язык без костей.'
            *pl 'Она ободряюще кивает:'
            *pl '— Главное — вовремя обозначить границы, и тогда всё будет спокойно.'
        end
    end

    killvar '$HallFamilyReactionTextGirl'
---
