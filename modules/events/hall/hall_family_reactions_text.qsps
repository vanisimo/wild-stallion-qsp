! ================================================
! FILE: modules/events/hall/hall_family_reactions_text.qsps
! Тексты семейных реакций на события в зале
! Используется:
! modules/events/hall/hall_family_reactions.qsps
! ================================================

#HallFamilyReactionText
    $HallFamilyReactionTextGirl = LCASE($ARGS[0])

    if $HallFamilyReactionTextGirl = 'amanda':
        if HallRecentSeverity >= 2:
            *p 'Аманда молчит дольше обычного. Потом не выдерживает:'
            *p '— Хватит на меня пялиться.'
            *p 'Крутит ленту в пальцах, не смотрит в глаза.'
            *p '— Я пытаюсь шутить. Получается хреново. Смеюсь — и сама себе противна.'
            *p 'Резко: — Не делай вид, что ничего не было. Я устала одна это тащить.'
        else:
            *p 'Аманда ржёт. Слишком громко.'
            *p '— Да ладно тебе, ничего же не было!'
            *p 'И тут же осекается, теребит фартук. — Скажи хоть что-нибудь, а? А то я тут стою как дура. Не стыдно мне. Стыдно, что ты молчишь.'
        end
    elseif $HallFamilyReactionTextGirl = 'melissa':
        if HallRecentSeverity >= 2:
            *p 'Мелисса не орёт. От этого страшнее.'
            *p '— Ты видел.'
            *p 'Пауза.'
            *p '— Я видела, что ты видел. И что ты сделал. Или не сделал.'
            *p 'Складывает руки. — Я не буду истерить. Я запомню. И ты запомни.'
        else:
            *p '— Было и было, — Мелисса жмёт плечами. — В зале всякое бывает.'
            *p 'Но смотрит так, что ясно — не «было и было».'
            *p '— Ты скажи, как ты к этому относишься. А то я решу за тебя. И тебе не понравится.'
        end
    elseif $HallFamilyReactionTextGirl = 'sandra':
        if HallRecentSeverity >= 2:
            *p 'Сандра ставит котёл так, что гремит.'
            *p '— Видел?'
            *p 'Не ждёт ответа.'
            *p '— Я видела. Девчонки видели. Гости видели.'
            *p 'Вытирает руки. Медленно. — Я не буду тебя пилить. Я мать. Я просто хочу знать, ты ещё мой сын или уже просто хозяин, который считает монеты.'
        else:
            *p '— Ну было, — Сандра отмахивается ложкой. — Зал есть зал.'
            *p 'Но голос не такой.'
            *p '— Только не делай вид, что это норма. Сегодня норма, завтра правилом станет. Мне потом это разгребать.'
        end
    else:
        if HallRecentSeverity >= 2:
            *p $RealName[$HallFamilyReactionTextGirl] + ' молчит. Потом сплёвывает.'
            *p '— Я всё видел, хозяин.'
            *p '— И не я один.'
            *p 'Больше ничего не говорит. Но смотрит так, что хочется провалиться.'
        else:
            *p $RealName[$HallFamilyReactionTextGirl] + ' хмыкает:'
            *p '— Ну, бывает. Зал же.'
            *p 'Но усмешка кривая.'
            *p '— Ты бы приглядел, а? А то в следующий раз не только посуда полетит.'
        end
    end

    killvar '$HallFamilyReactionTextGirl'
---