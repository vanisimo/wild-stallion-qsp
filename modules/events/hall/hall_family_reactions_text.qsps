! ================================================
! FILE: modules/events/hall/hall_family_reactions_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Тексты семейных реакций на события в зале
! Используется: hall_family_reactions.qsps
! ================================================

#HallFamilyReactionText
    $HallFamilyReactionTextGirl = LCASE($ARGS[0])

    if $HallFamilyReactionTextGirl = 'amanda':
        if HallRecentSeverity >= 2:
            *pl 'Аманда долго молчит, уставившись в дощатый пол и нервно перебирая тесёмки фартука. Тонкие девичьи плечи её слегка подрагивают, а когда она поднимает глаза, в них блестит нескрываемая обида:'
            *pl '— Хватит сверлить меня взглядом, Стефан.'
            *pl 'Она судорожно сглатывает, закусывая губу до белизны:'
            *pl '— Я изо всех сил старалась улыбаться и отшучиваться перед этими гостями, а у самой внутри всё переворачивалось от стыда. И не делай вид, будто ничего особенного не стряслось — ты ведь сам всё видел!'
        else:
            *pl 'Аманда пытается неестественно, звонко рассмеяться, стряхивая несуществующие крошки со стойки, но смех этот выходит нервным и ломким:'
            *pl '— Ну полно тебе хмуриться, Стефан! Подумаешь, обычное дело в зале, обошлось ведь!'
            *pl 'Она тут же запинается под вашим взглядом, густо краснеет и прячет тонкие пальчики в складках передника: — Ну скажи хоть что-нибудь, а?.. Не стой столбом, я же чувствую себя круглой дурой.'
        end
    elseif $HallFamilyReactionTextGirl = 'melissa':
        if HallRecentSeverity >= 2:
            *pl 'Мелисса скрещивает руки на груди и впивается в вас колючим, пронизывающим взглядом книжной умницы, в котором нет и следа дежурной вежливости:'
            *pl '— Ты ведь стоял и хладнокровно всё созерцал, Стефан. От начала и до конца.'
            *pl 'Она выдерживает тяжёлую, звенящую паузу, чуть приподняв тонкую бровь:'
            *pl '— Устраивать бабские истерики со слезами я не стану — не надейся, для этого у меня слишком много самоуважения. Но каждый твой жест и каждую секунду твоего молчания я зафиксировала и запомнила. И тебе советую хорошо это зарубить на носу.'
        else:
            *pl '— Велика важность, тривиальный случай плебейской распущенности, — Мелисса небрежно пожимает плечами, поправляя воротник с безупречной педантичностью. — В заведениях подобного толка ожидать возвышенных манер было бы верхом наивности.'
            *pl 'Однако её взгляд исподлобья остаётся расчётливо-цепким:'
            *pl '— Но мне любопытно услышать твою собственную оценку, братец. Скажи прямо, что ты думаешь по этому поводу. Иначе я сама сделаю логические выводы о твоих моральных приоритетах, и поверь, они тебе вряд ли польстят.'
        end
    elseif $HallFamilyReactionTextGirl = 'sandra':
        if HallRecentSeverity >= 2:
            *pl 'Сандра с тяжёлым, глухим стуком опускает медный таз на разделочный стол, отчего жалобно вздрагивает кухонная утварь:'
            *pl '— Ты собственными глазами видел, что творится за этими столами?!'
            *pl 'Она с силой отирает взмокшие руки о край фартука, сверля вас суровым, властным взглядом хозяйки кухни:'
            *pl '— Девчонки ещё молодые, они на тебя смотрят! И гости этот срам видят. Читать тебе нотации я не стану, Стефан — ты уже вырос. Я просто хочу понять: ты в этом доме хозяин, способный защитить честь семьи, или просто бессовестный счетовод, готовый за звонкую монету родных девчонок на растерзание отдать?!'
        else:
            *pl '— Трактир есть трактир, пьяной дури за столами всегда хватало, — Сандра устало отмахивается закопчённой шумовкой.'
            *pl 'Но в её густом, низком голосе звенит жёсткое материнское предупреждение:'
            *pl '— Только не вздумай делать из этого привычку, Стефан. Ильматер свидетель: сегодня закроешь глаза на один щипок ради выручки — завтра по залу будут разгуливать как по притону. А разгребать весь этот позор и смывать грязь снова придётся нам.'
        end
    else:
        if HallRecentSeverity >= 2:
            *pl $RealName[$HallFamilyReactionTextGirl] + ' долго молчит, затем тяжело и горько вздыхает:'
            *pl '— Все всё видели, хозяин. Стыд на весь трактир.'
            *pl 'Она демонстративно отворачивается к работе, но её застывшая спина говорит красноречивее любых упрёков.'
        else:
            *pl $RealName[$HallFamilyReactionTextGirl] + ' кривит губы в короткой усмешке:'
            *pl '— Бывает, чего уж там. Зал хмельной, руки у мужиков чешутся.'
            *pl 'Она предостерегающе качает головой:'
            *pl '— Ты бы приглядывал за порядком построже, Стефан. Сегодня обошлось шумом, а завтра и кружки в ход пойдут.'
        end
    end

    killvar '$HallFamilyReactionTextGirl'
---
