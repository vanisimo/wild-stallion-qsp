! ================================================
! FILE: modules/events/hall/hall_missing_bargain_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT — экран уговоров перед сценкой ухода (missing)
!
! Механика:
! soft — клиент просит малого («только глянуть», «понюхать бутончик», «только рукой»),
!        раздвигая границы для последующего ухода в подсобку.
! hard — прямой поздний торг на рот, проглот или сочную работу.
!
! Мелисса (канон голоса, docs/design-npc-voices.md §3):
! книжная зазнайка КАК Гермиона Грейнджер (Гарри Поттер) — типаж, не кроссовер.
! НЕ злая проститутка. Похоть = смешная/предсказуемая/наивная;
! закатывает глаза; ирония; серебро → бумага, книги, стихи.
! ================================================

#HallMissingBargainPrintText
    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end

    if $HallLewdClientWho = '':
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end

    if $HallMissingBargainStyle = 'hard':
        gs 'HallMissingBargainPrintHard'
    else
        gs 'HallMissingBargainPrintSoft'
    end
---

! ================================================
! SOFT — уламывание («только это»)
! ================================================
#HallMissingBargainPrintSoft
    *pl 'Вы не вмешиваетесь в разговор — только слышите, как ' + $HallLewdClientWho + ' уговаривает ' + $RealName[$HallMissingGirl] + ' отойти на пару минут в тень. Голос у него пьяный и низкий, а смысл слов далёк от заказа эля.'
    *pl ' '

    if $HallMissingPromise = 'look_tits':
        *pl '— Да я только глазком гляну, — сально шепчет ' + $HallLewdClientWho + ' ' + $HallLewdClientManner + '. — На грудь. Расшнуруй корсаж на пальчик, дай вздохнуть яблочкам. Юбку даже не задену — только посмотреть!'
        *pl ' '
        gs 'HallMissingBargainSoftGirl', 'look_tits'

    elseif $HallMissingPromise = 'smell':
        *pl '— Ну покажи, милая, — с пьяной ухмылкой сипит ' + $HallLewdClientWho + ', нависая ближе. — Свой… бутончик между ног. Приподними подол в темноте, дай хоть понюхать твой сладкий сок. Уткнусь носом на секунду — и ровно ' + $HallLewdClientCoin + ' твоя. Руки видишь? За спиной держу!'
        *pl ' '
        gs 'HallMissingBargainSoftGirl', 'smell'

    elseif $HallMissingPromise = 'touch_cock':
        *pl '— Потрогай только, — ' + $HallLewdClientWho + ' выразительно кидает взгляд вниз, где под сукном штанов натянулся тугой бугор. — Пожми ладошкой сквозь ткань. Ничего больше! Сама увидишь, какой я стану шелковый.'
        *pl ' '
        gs 'HallMissingBargainSoftGirl', 'touch_cock'

    elseif $HallMissingPromise = 'hand':
        *pl '— Поработай ручкой до конца, — тише добавляет ' + $HallLewdClientWho + ', поглаживая её пальцы. — За ' + $HallLewdClientCoin + '. В рот брать не заставлю. Честное слово.'
        *pl ' '
        gs 'HallMissingBargainSoftGirl', 'hand'

    else
        *pl '— Шагни ближе в тень, — шепчет ' + $HallLewdClientWho + '. — Прижму к себе, поглажу бочок, поцелую в шею. Без глупостей! Зато получишь блестящее серебро.'
        *pl ' '
        gs 'HallMissingBargainSoftGirl', 'petting'
    end

    *pl ' '
    *pl 'Они медленно отходят от линии стойки — к двери кладовой, к тёмному углу под лестницей. Слова тонут в шуме зала. Если пойдёте следом — увидите, чем кончился этот уговор.'
---

#HallMissingBargainSoftGirl
