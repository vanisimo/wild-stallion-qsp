! ================================================
! FILE: modules/events/hall/hall_missing_bargain_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT — уговоры перед missing (catalog v0.16 + промпты владельца)
! Архив старой prose: archive/hall_missing_text_v016_backup/hall_missing_bargain_text.qsps
!
! Мелисса: книжная зазнайка (типаж «как Гермиона») — ирония, не злая шлюха;
! серебро/спинтрии → бумага, книги. Спинтрии = монеты = серебро.
! Сандра: всё на КУХНЕ (не кладовая); тон сдержанный→разврат по лесенке.
! Сёстры: подсобка (не «за бочками»).
! Аманда: смущение / азарт; «аккуратные» / первая любовь.
!
! Комментарии [B-…] — якоря для сцен missing, не удалять.
!
! --- HallMissingBargainExplicit (0/1) — «этаж прямого языка» ---
! Считает: #HallMissingBargainIsExplicit в hall_missing_bargain.qsps
!   = 1  сёстры: после FlagFaceDone (прошли first hard-лицо A5)
!   = 1  Сандра: после FlagMouthMature (проглот / зрелый рот A4)
!   = 0  раньше: эвфемизмы («только гляну», «бутончик», «штурвал»)
! if HallMissingBargainExplicit = 1:  → ветка ПРЯМОГО уговора (развратнее клиент + ответ)
! else:                              → ветка МЯГКОГО / mid уговора
! ================================================

#HallMissingBargainPrintText
    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end
    if $HallLewdClientWho = '':
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end
    if LOC('HallMissingBargainIsExplicit') = 1:
        gs 'HallMissingBargainIsExplicit'
    end

    if $HallMissingGirl = 'sandra':
        *pl 'Вы не лезете в разговор — только слышите, как у печи ' + $HallLewdClientWho + ' уговаривает Сандру отойти на минуту. Запах рагу мешается с его тяжёлым дыханием.'
    else
        *pl 'Вы не вмешиваетесь — только слышите, как ' + $HallLewdClientWho + ' уговаривает ' + $RealName[$HallMissingGirl] + ' отойти на пару минут в тень. Голос низкий, смысл далёк от заказа эля.'
    end
    *pl ' '

    if $HallMissingGirl = 'amanda':
        gs 'HallMissingBargainPrintAmanda'
    elseif $HallMissingGirl = 'melissa':
        gs 'HallMissingBargainPrintMelissa'
    else
        gs 'HallMissingBargainPrintSandra'
    end

    *pl ' '
    if $HallMissingGirl = 'sandra':
        *pl 'Они не уходят с кухни — только глубже в помещение, за стол, к стене у печи. Шипение сковороды и звон мисок. Если заглянете — увидите, чем кончился уговор. Прямо здесь, на кухне.'
    else
        *pl 'Они медленно отходят от стойки — к двери подсобки, в полумрак. Если пойдёте следом — увидите, чем кончился этот уговор.'
    end
---

