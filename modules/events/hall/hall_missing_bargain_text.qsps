    if $HallMissingGirl = 'amanda':
        gs 'HallMissingBargainSoftAmanda', $HallMissingBargainReply
    elseif $HallMissingGirl = 'melissa':
        gs 'HallMissingBargainSoftMelissa', $HallMissingBargainReply
    else
        gs 'HallMissingBargainSoftSandra', $HallMissingBargainReply
    end

    killvar '$HallMissingBargainReply'
