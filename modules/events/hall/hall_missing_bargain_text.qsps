! ================================================
! FILE: modules/events/hall/hall_missing_bargain_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT — уговоры перед missing (канон 2026-08)
!
! Мелисса: книжная зазнайка (типаж «как Гермиона») — ирония, не злая шлюха;
! серебро/спинтрии → редкие книги, трактаты, издание сборника стихов.
!
! Сандра: всё на КУХНЕ (не кладовая, БЕЗ зала); тон сдержанный→разврат по лесенке.
! Мотивация: редкие заморские специи и накопления на спокойную старость.
!
! Аманда: смущение / девичий азарт; копит на крема, косметику и богатое приданое.
!
! ТИПЫ КЛИЕНТОВ ($c = $HallMissingClient):
!   'noble' — дворянин (полные сцены уговора)
!   'traveler' / 'sailor' — моряк (грубый, берет силой, командует; Сандре нравится, сестры подчиняются)
!   'craftsman' / 'local' — мастеровой (комплименты, сравнения с молодостью/матерью)
!   'rich_merchant' / 'merchant' — купец (серебро, монеты, товар, привык покупать)
!   'drunk_guest' / 'drunk' — захмелевший гость (отказ/выдворение)
! ================================================

! окно 1: клиент у двери (ещё не уговор)
#HallMissingBargainPrintNotice
    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end
    if $HallLewdClientWho = '':
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
    end
    if $HallMissingGirl = 'sandra':
        *pl 'Вы замечаете, как ' + $HallLewdClientWho + ' подходит к кухонной двери и открывает её, оглядываясь по сторонам.'
        *pl ' '
        *pl 'За дверью — пар и звон посуды. Сандра у плиты. Гость уже на пороге.'
    else
        if $HallMissingGirl = 'melissa':
            *pl 'Вы замечаете, как ' + $HallLewdClientWho + ' отходит от стойки вместе с Мелиссой — прямо к двери подсобки.'
        else
            *pl 'Вы замечаете, как ' + $HallLewdClientWho + ' отходит от стойки вместе с Амандой — прямо к двери подсобки.'
        end
        *pl ' '
        *pl 'Речь совсем не про заказ эля. Они уже у порога.'
    end
---

! окно 2: один уговор (клиент × Explicit), без входа и без сцены
#HallMissingBargainPrintText
    HallMissingBargainRefused = 0
    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end
    if $HallLewdClientWho = '':
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end
    if LOC('HallMissingBargainIsExplicit') = 1:
        gs 'HallMissingBargainIsExplicit'
    end

    if $HallMissingGirl = 'amanda':
        gs 'HallMissingBargainPrintAmanda'
    elseif $HallMissingGirl = 'melissa':
        gs 'HallMissingBargainPrintMelissa'
    else
        gs 'HallMissingBargainPrintSandra'
    end

    if HallMissingBargainRefused = 1:
        *pl ' '
        *pl 'Уговор сорвался — пьяный гость отступает ни с чем, а ' + $RealName[$HallMissingGirl] + ' возвращается к своей работе.'
    end
---

! ================================================
! АМАНДА
! ================================================
#HallMissingBargainPrintAmanda
    $p = LCASE($HallMissingPromise)
    $c = LCASE($HallMissingClient)

    if $c = 'drunk_guest' or $c = 'drunk':
        pol_val = GirlWorkPolicy['amanda']
        HallMissingBargainRefused = 1
        *pl '— Заходи в подсобку... п-поцелуемся! — валясь на Аманду и одуряюще дыша перегаром, заплетающимся языком говорит захмелевший гость, хватая её за попу.'
        *pl ' '
        if pol_val = 3:
            *pl '— Ой, какой ты тёпленький... Иди сначала проветрись да проспись! А точно, и приходите в нашу таверну, мы всегда рады гостям, когда протрезвеешь. — мягко отстраняет его с улыбкой.'
        else
            *pl '— Ой! Идите проспаться! Вы очень пьяны и пугаете меня... Я никуда с вами не пойду, убери руки! — сжимается от чувственного испуга, вырывая руки и отползая за поднос.'
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'noble' or $p = 'noble':
        if HallMissingBargainExplicit = 1:
            *pl 'Дворянин бесцеремонно усаживает Аманду на колени, его рука скользит под платье, лаская её бёдра, пока девушка задыхается от нахлынувшей страсти и безумных надежд.'
            *pl '— Твоё тело создано для роскоши, Аманда, эта изящная грудь и горящий взгляд просто сводят меня с ума. Как жаль, что сословные законы связывают мне руки! Если бы в твоих жилах текла хоть капля благородной крови, я бы обвенчался с тобой в главном соборе. Но увы… наше счастье возможно только в тени. Пойдём уединимся, моя принцесса, утоли мою жажду.'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— В соборе?! Боже, я стану настоящей леди… — Аманда лихорадочно, глупо хихикает, её глаза дико блестят от похоти и амбиций. Она бесстыдно ёрзает у него на коленях, заставляя юбку задраться, и возбуждённо трёт ноги друг о дружку, ловя ртом воздух. — Господин, мой брат Стефан обязательно добудет благородное имя, он сильный! И как только это случится… вы ведь правда… правда возьмёте меня в свой замок?!'
                    *pl '— О чём речь, моя красавица? Как только — так сразу под венец, обещаю! А теперь утиши мой голод, покажи, на что способна будущая графиня…'
                    *pl '— Ах!.. Я вся горю, я на всё согласна ради нашего будущего! Пойдём, мой господин, мой будущий муж! Я устрою тебе такое в подсобке, что ты сам захочешь жениться на мне прямо сегодня, наплевав на все запреты!'
                else
                    *pl '— Под венец… в соборе… — Аманда совершенно теряет голову, глупо и прерывисто хихикая от сладостных перспектив. Её дыхание перехватывает, она вся дрожит, возбуждённо трётся коленями друг о дружку и умоляюще шепчет: — Господин, послушайте… мой брат Стефан! Он ведь почти благородный, он может… может выбиться в люди и получить благородный титул! Тогда ведь… тогда ведь преграда исчезнет?'
                    *pl '— Разумеется, моя сладкая! Как только твой брат получит титул — я сразу же объявлю нас мужем и женой перед всем светом, даю слово! А пока — докажи мне свою верность в тишине…'
                    *pl '— О-ох… да, мой наречённый, да!.. Я на всё согласна, всё для тебя сделаю! Пошли скорее, я отдам тебе всю себя, только помни про своё обещание…'
                end
            end
        else
            *pl 'Дворянин в бархатном камзоле засыпает Аманду приторными комплиментами в зале, нагло и жадно разглядывая её цветущую молодость.'
            *pl '— Ах, какая нежная дитя… Какая статная, цветущая красавица! — приторно воркует дворянин. — Твоя молодость и безупречная кожа затмевают любые королевские шелка. Покажи-ка, милая, где тут у вас укромный уголок, чтобы никто нам не помешал? Страсть как хочу наедине полюбоваться твоими прелестями… Видит Ильматер, была бы ты благородных кровей — я бы, не раздумывая, хоть завтра повёл тебя к алтарю и надел на этот пальчик кольцо с рубином!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— К-к алтарю?.. Под венец?! — Аманда восторженно хихикает, её щёки горят от возбуждения, а перед глазами уже плывут картины богатой жизни. Она ловит каждое его слово, сияя от счастья. — Ах, благородный господин! Низкий статус, почему мир так несправедлив? Пойдёмте же скорее, я покажу наш укромный уголок, там нам точно никто не помешает насладиться друг другом!'
                else
                    *pl '— К-к алтарю?.. Кольцо?.. — Аманда глупо хихикает, заливаясь пылающим румянцем. Голова кружится от невероятных перспектив, она мгновенно теряет волю и смотрит на дворянина расширившимися, абсолютно восхищёнными глазами. — Ах, милостивый господин… вы правда… правда так думаете?.. У нас… у нас есть тихая подсобка за кухней, идите за мной, там сейчас никого нет!'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'traveler' or $c = 'sailor':
        if HallMissingBargainExplicit = 1:
            *pl 'Пьяный моряк без лишних прелюдий бесцеремонно притягивает Аманду к себе за талию, по-хозяйски сжимая ладонью её ягодицу и зарываясь носом в её волосы у шеи.'
            *pl '— Хватит тут жопой вертеть, девка! Пойдём где тут у вас место поспокойней. Всю дорогу в море снилось, как сожму задницу молодой девки, а она у тебя ничего, сиськи подкачали, но ничего, вырастут!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— Ой-ой... Разок повернулась — уже жопой верчу... и сиськи мои ему маленькие...'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                    *pl '— Чего бубнишь? В порту прямо говорят, что в "Диком жеребце" любого жеребца объездить могут!'
                else
                    *pl '— Да не маленькие сиськи, не злись! Пойдём уже, в темноте всё хорошеет!'
                end
                *pl '— Иди посмотри, какие у мамки моей, у меня такие же будут, а попочка у меня и правда что надо, ладно пойдём... — тихо вздыхает, краснея, но попой сама подаётся к его ладони и уводит за собой.'
            end
        else
            *pl 'Моряк ловко притягивает проходящую Аманду за руку, нагибается к её шее и шепчет на ухо:'
            *pl '— Ого, какая русалка! Красавица, ты похожа на мою первую любовь, когда мы молодые были... Как вспомню, как мы любились всю ночь напролёт! Её сиси так и мелькали перед лицом, точь-в-точь как твои были... Показывай курс! Поможешь мне молодость вспомнить!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Аха-ха! Молодость по моим маленьким сиськам вспоминать собрался? У меня работа вообще-то, меня потерять могут!'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Никто тебя не потеряет, не ломайся! И сисечки у тебя не маленькие, а аккуратненькие, да и в порту мне сказали, что у вас в таверне девки за монету помогут не только молодость вспомнить!'
                    else
                        *pl '— Никто тебя не потеряет! И сисечки у тебя не маленькие, а аккуратненькие, пошли, я за воспоминание молодости спинтриев тебе отсыплю — не пожалеешь!'
                    end
                    *pl '— Шагай в подсобку, уважаемый! Покажу твою молодость поближе, раз монету даёшь... — задорно подмигивает и, крутя попой, утягивает его за собой.'
                else
                    *pl '— Ой... Вы что! И у меня маленькие сиси?.. Меня же Стефан в зале потеряет...'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Никто тебя не потеряет, не ломайся! И сисечки у тебя не маленькие, а аккуратненькие, да и в порту мне сказали, что у вас в таверне девки за монету помогут не только молодость вспомнить!'
                    else
                        *pl '— Никто тебя не потеряет! И сисечки у тебя не маленькие, а аккуратненькие, пошли, я за воспоминание молодости спинтриев тебе отсыплю — не пожалеешь!'
                    end
                    *pl '— Аккуратненькие, л-ладно... пойдём, пока Стефан не заметил... — заливается румянцем, с азартом прикусывает губку и спешно утягивает его в полумрак.'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'craftsman' or $c = 'local':
        if HallMissingBargainExplicit = 1:
            *pl 'Мастеровой резким движением подтягивает Аманду за подол ближе к себе, хватает её за попку и, не отпуская, говорит:'
            *pl '— Аманда, девонька, что за манеры! Ни тебе здрасьте, ни пожалуйста! Я тут постоянный клиент или где? Пошли в подсобку! Пожмакаю тебя в качестве извинений!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— Ах... дядька... ты вроде приличным казался... пьяный что ли, или взаправду обиделся.'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                    *pl '— Не строй скромницу! Пьяный не пьяный, обиделся не обиделся. Вся слобода знает, что у вас в таверне девки сговорчивые.'
                else
                    *pl '— Кто пьяный? Я пьяный? Когда я пьяный, я буйный, а раз я не буйный, я не пьяный понятно, но обиделся взаправду! Пошли пожмакаю!'
                end
                *pl '— Ну раз так — пошли в кладовую... Только давай без лишнего! — покрывается румянцем и тяжело выдыхает.'
            end
        else
            *pl 'Ремесленник цепляет Аманду за шнуровку корсажа, когда она забирает пустую посуду:'
            *pl '— Эй, Аманда! Какая ты красавица, вся в мать, тоже в молодости девка огонь была... кхм, то есть она и щас огонь. У нас вся слобода на неё копытом била как ваш "жеребец", а ты прям она в молодости. Пойдём в подсобку за дверь, посидим — поможешь мне молодость вспомнить, да я за такое серебра не пожалею!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Аха-ха! Мамка не дала, так ты ко мне лезешь? У меня не те формы! Да и у меня вообще-то подносы и заказы, Стефан заметит, что я пропала!'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Никто тебя не потеряет! А так формы-то конечно не такие, у каждого свои недостатки, вырастут как в подоле принесёшь! Но ты не думай, всё равно ты очень красивая, и очень хотелось поподробней рассмотреть красоту растакую. И вообще, чего жопой крутишь? Вся слобода знает, что у вас в подсобке за звонкую монету девки завсегда помогают!'
                    else
                        *pl '— Никто тебя не потеряет! А так формы-то конечно не такие, у каждого свои недостатки, вырастут как в подоле принесёшь! Но ты не думай, всё равно ты очень красивая, и очень хотелось поподробней рассмотреть красоту растакую. Пойдём в подсобку, я тебе полновесное серебро отсчитаю!'
                    end
                    *pl '— Пойдём в подсобку, дядька! На маму похожа, рассмотришь поближе да сравнишь, раз монету не зажилил... — задорно подмигивает и утягивает в полумрак.'
                else
                    *pl '— Ой... Господин мастеровой, вы что! Не похожа я на маму, она вон какая... и Стефан меня в зале потеряет...'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Никто тебя не потеряет! А так формы-то конечно не такие, у каждого свои недостатки, вырастут как в подоле принесёшь! Но ты не думай, всё равно ты очень красивая, и очень хотелось поподробней рассмотреть красоту растакую. И вообще, чего жопой крутишь? Вся слобода знает, что у вас в подсобке за звонкую монету девки завсегда помогают!'
                    else
                        *pl '— Никто тебя не потеряет! А так формы-то конечно не такие, у каждого свои недостатки, вырастут как в подоле принесёшь! Но ты не думай, всё равно ты очень красивая, и очень хотелось поподробней рассмотреть красоту растакую. Пойдём в подсобку, я тебе полновесное серебро отсчитаю!'
                    end
                    *pl '— П-подробней... красоту. Л-ладно, пойдём в подсобку... Только быстро и чтобы никто не видел! — виновато прикусывает губку и уводит его.'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'rich_merchant' or $c = 'merchant':
        if HallMissingBargainExplicit = 1:
            *pl 'Купец властно сжимает ручку Аманды и тянет её к своей расстёгнутой ширинке, роняя на стол блестящий серебряник.'
            *pl '— Что мне твои поглаживания! Веди где тут у вас поспокойней, у меня тут вопрос поднялся, глядя как ты попкой крутишь в зале, возьмёшься отвечать! Монет подкину, купишь себе чё-нибудь ваше бабское!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— Ой, купец... ну ты и затейник, вопрос у него стоит, это ты образно, или "ОН" у тебя кривой такой!'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                    *pl '— Купеческие вопросы всегда в приоритете должны решаться. К тому же слышал я, вы тут стараетесь оказывать разносторонний сервис, так что пошли — я с дороги недоласканный, и у меня как раз поставка новых кремов да прочей бабской дребедени для вашего города, дам тебе выбрать.'
                else
                    *pl '— Купеческие вопросы всегда в приоритете должны решаться, давай пошли — я с дороги недоласканный, и у меня как раз поставка новых кремов да прочей бабской дребедени для вашего города, дам тебе выбрать.'
                end
                *pl '— Что?? Новые крема, чего раньше молчал — пойдём в подсобку... Решу все твои вопросы, и стоящие и упавшие, если упали, так что ходить не можешь, тогда я и выберу что мне нужно. — жадно приоткрывает губы и, виляя попой, идёт в сторону подсобки.'
            end
        else
            *pl 'Купец весомо стучит кружкой, поманивает Аманду серебряной монетой и заглядывается в вырез:'
            *pl '— Эй, принцесса, помоги путнику, что кучу времени потратил, чтобы привести караван в вашу глушь: недоедал, недосыпал, недоласкан был, от зверей диких оборону держал вот этими руками! Пойдём уединимся, поможешь снять усталость!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Ха-ха, ты, судя по брюху, от зверей отбился и съел! Недоедал он, у меня работа, некогда мне с тобой уединяться!'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Брюхо у меня — это знак гильдии, что за купец без брюха? А работа — работа не волк. Да и чего ты упёрлась как коза, купеческий люд болтает, что вы за звонкую монету на всё согласные. Показывай, где тут у вас место поспокойней — спинтрии на дороге не валяются, купишь себе что вы девки любите, ленту атласную аль крем какой!'
                    else
                        *pl '— Брюхо у меня — это знак гильдии, что за купец без брюха? А работа — работа не волк. Показывай, где тут у вас место поспокойней — спинтрии на дороге не валяются, купишь себе что вы девки любите, ленту атласную аль крем какой!'
                    end
                    *pl '— Ленту, ха-ха, купец, ты одной лентой не отделаешься! Пошли рассмотрим твой гильдейский знак, не схуднул ли! — задорно подмигивает и манит за собой.'
                else
                    *pl '— Нет, вы что, мне сейчас так нельзя, я не такая, и меня работа ждёт...'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Работа не волк, и чегой-то ты не такая, пизда поперёк что ли! Я слышал, что всё у тебя там в порядке, пойдём — денег дам, купишь себе что вы девки любите, ленту атласную аль крем какой!'
                    else
                        *pl '— Работа не волк, и чегой-то ты не такая, смотрю — всё на месте, девка справная! Пойдём — денег дам, купишь себе что вы девки любите, ленту атласную аль крем какой!'
                    end
                    *pl '— Л-ладно... Крем — это хорошо... Пойдём покажу тебе нашу таверну, пока Стефан не заметил... — виновато приоткрывает губки и уводит купца.'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    ! Fallback
    *pl '— Пойдём в подсобку... — шепчет ' + $HallLewdClientWho + '.'
    *pl ' '
    gs 'HallMissingBargainTryOffenseAnswer'
    if HallMissingBargainOffenseAnswered = 0:
        *pl '— Л-ладно... Только быстро... — краснеет Аманда и уводит его в полумрак.'
    end
    killvar '$p'
    killvar '$c'
---

! ================================================
! МЕЛИССА
! ================================================
#HallMissingBargainPrintMelissa
    $p = LCASE($HallMissingPromise)
    $c = LCASE($HallMissingClient)

    if $c = 'drunk_guest' or $c = 'drunk':
        pol_val = GirlWorkPolicy['melissa']
        HallMissingBargainRefused = 1
        *pl 'Пьяный горожанин сидит за столиком, с мычанием хватается за край фартука Мелиссы и пытается залезть пальцами ей под юбку, вытаскивая из кармана монету:'
        *pl '— Э-эй, кудрявая... Ы-ых, давай в уголок... Порадуешь меня за монету, а? Чё тебе, трудно, что ль...'
        *pl ' '
        if pol_val = 3:
            *pl 'Мелисса даже не вздрагивает — она выразительно закатывает глаза, упирает руку в бок и одаривает пьянчугу насмешливо-презрительным взглядом, как на неразумное животное:'
            *pl '— Ты руки свои придержи, давай домой собирайся, тебе сегодня хватит. Пойди водичкой себя окати из колодца, а то у тебя руки и язык заплетаются туже, чем шнуровка на моём платье. Иди проветри мозги, пока Стефан тебя за шкирку на улицу не выставил!'
        else
            *pl 'Мелисса с глубоким отвращением морщит носик, брезгливо отстраняется и звонким, метким щелчком по пальцам отбивает его тянущуюся руку:'
            *pl '— Фу, отвали, пьяное чучело! От тебя сивухой и перегаром воняет за версту, даже дышать рядом трудно, не то что слушать твоё мычание. Руки при себе держи и проспись сначала!'
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'noble' or $p = 'noble':
        if HallMissingBargainExplicit = 1:
            *pl 'Дворянин властно усаживает Мелиссу к себе на колени прямо за дальним столом. Его ладонь медленно, но неумолимо поднимается по её бедру под платьем, бережно, словно дорогую шёлковую ткань, поглаживая обнажённую кожу. Он говорит полушёпотом, обжигая её шею дыханием.'
            *pl '— Ты — редкое сокровище, Мелисса, удивительное сочетание острого ума и безупречной внешности. Но истинно умная девушка должна понимать, что в высшем свете, признания которого вы жаждете, вкусы... весьма специфичны. Настоящая аристократия пресытилась обычной, пресной романтикой. Нам требуются изысканные, порочные контрасты. Острый ум должен уметь вкусить подлинный экстаз от того, что серая масса считает неприемлемым. Готовы ли вы доказать свою исключительность не только стихами?'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl 'Мелисса маняще и преданно улыбается. Интеллектуальный соблазн и близость к тайному миру знати полностью лишают её воли; она покорно подаётся вперёд, обвивая его шею руками и медленно расстёгивая верхние пуговицы его камзола:'
                *pl '— Разумеется, я всё понимаю, мой благородный господин... Книги научили меня многому, и я не боюсь ваших специфических вкусов. Заходите в тень, я готова на многое ради вас. Я опущусь перед тобой на колени и приму твою гордость так сладко, искусно и преданно, я вся в вашей власти.'
            end
        else
            *pl 'Дворянин, изящно покачивая бокал с дорогим вином, преграждает Мелиссе путь у лестницы. Он смотрит на неё с лёгким интересом, осторожно касаясь кончиками пальцев её тонкого запястья.'
            *pl '— Помилуйте, милое создание, но тебе абсолютно не место в этой захудалой таверне среди неуклюжего сброда! Ты — неогранённый алмаз, запертый в этой дыре. Я чувствую, я вижу по твоему одухотворённому лицу, что ты создана для созерцания прекрасного, проводи меня в отдельный кабинет... Расскажи мне, правда ли, что ты изливаешь свою прекрасную душу в стихах? Умоляю, прочти мне пару строк в уединении, подальше от этих людей!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl 'Мелисса густо вспыхивает горделивым восторгом, её глаза сияют, а маска неприступной подавальщицы мгновенно тает перед признанием её таланта:'
                *pl '— Вы... вы действительно способны оценить утончённый ум и изящный слог, благородный господин? Да, я пишу стихи, но до сих пор никто в этой глуши не считал их чем-то стоящим... Пройдёмте туда, где намного тише. Я с радостью прочту вам свои стихи и докажу, что простая трактирщица способна пленить вашу душу...'
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'traveler' or $c = 'sailor':
        if HallMissingBargainExplicit = 1:
            *pl 'Моряк без лишних прелюдий нагло притягивает Мелиссу, схватив за подол, и засовывает руку под платье, сжимая попу.'
            *pl '— Хватит жопой вертеть и делать вид, что ты меня не видишь! Пошли уединимся, в такой шторм попали, думал так утону необласканным, но слава всем богам, не сгинул!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— О, так ты у нас герой, спасшийся из пучины? Открою секрет: «необласканным» ты рискуешь остаться как раз из-за своего длинного языка. Уединиться он захотел! Я слишком ценный приз...'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                    *pl '— Хех, а ты с характером, мне нравится! — он ухмыляется, прижимая Мелиссу ещё ближе к себе и не убирая руку с её попки. — В порту сказывали, что в "Диком жеребце" девки за звонкую монету тоже дикие! Я чуть богам душу не отдал, так что на ценный приз спинтриев не пожалею!'
                else
                    *pl '— Хех, а ты с характером, мне нравится! — он ухмыляется, прижимая Мелиссу ещё ближе к себе и не убирая руку с её попки. — Я чуть богам душу не отдал, так что на ценный приз спинтриев не пожалею!'
                end
                *pl '— Ого, спинтриев он не пожалеет? Какой щедрый моряк... Значит, и в штанах у тебя не пусто. — Мелисса мягко, но ощутимо сжимает его промежность пальцами, заставляя моряка перевести дыхание. — Ладно, выживший, твоя наглость меня завела. Пошли, посмотрим, так ли ты хорош в деле, как языком чешешь.'
            end
        else
            *pl 'Моряк нагло преграждает путь у лестницы, заглядывая в вырез платья:'
            *pl '— Слышь, русалочка! Ты чего тут с подносами, а не в море плаваешь? Не пробегай мимо, всё плавание без женской ласки, из красоты только деревянные сиськи Медузы на носу корабля, а тут ты — и сиськи, как я погляжу, у тебя не деревянные! Пошли, напомнишь, что такое настоящая дева!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Надо же, какой наблюдательный морячок! — Мелисса насмешливо приподнимает бровь, чуть качнув грудью. — Только учти, «капитан»: Русалочки заманивают матросов на глубину и топят их корабли. С русалкой шутки плохи, освободи дорогу, пиво само себя не принесёт, а то останешься и без ласки.'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                        *pl '— Не ломайся, умница! В порту сказывали, что в "Диком жеребце" девки за звонкую монету тоже дикие!'
                    else
                        *pl '— Ничего, подождут! Давай скроемся с глаз в подсобке, отсчитаю серебра, такая умная русалка найдёт им применение!'
                    end
                    *pl '— Твой напор мне даже нравится... Заходи за дверь, покажу тебе умную девушку, но с тебя достойная плата! — маняще улыбается и увлекает в полумрак.'
                else
                    *pl '— Ваши познания в мифологии несколько обрывочны. На носу кораблей вырезают русалок или Галатей, а не Медуз. Уберите руки и освободите проход, пиво само себя не принесёт, иначе вы на личном опыте узнаете, что бывает от удара подносом по голове, или она у вас тоже деревянная. Поверьте, это гораздо менее приятно, чем женская ласка...'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                        *pl '— Не ломайся, умница! В порту сказывали, что в "Диком жеребце" девки за звонкую монету тоже дикие!'
                    else
                        *pl '— Ничего, подождут! Давай скроемся с глаз в подсобке, отсчитаю серебра, такая умная русалка найдёт им применение!'
                    end
                    *pl '— Что ж... Загородили дорогу — сдаюсь грубому напору, придётся уступить. Пойдём в подсобку! — слегка вздыхает и идёт впереди.'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'craftsman' or $c = 'local':
        if HallMissingBargainExplicit = 1:
            *pl 'Мастеровой без лишних прелюдий нагло хватает Мелиссу за попку, бесцеремонно забирается рукой под ткань и с силой сжимает её ягодицу:'
            *pl '— Хватит тут вилять и строить из себя святошу! Я знаю, что ты тут прямо в таверне и живёшь, и небось уже половину постоянных гостей через подсобку провела! Пошли уединимся, истосковался я по ласкам женским, а ты девка — чистый огонь!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— О, так ты у нас местный счетовод, ведёшь учёт моим гостям в подсобке? — Мелисса, ничуть не испугавшись, уверенно кладёт ладонь прямо на его тугую промежность и с вкрадчивой ухмылкой смотрит ему прямо в глаза. — Язык побереги, или что другое! Уединиться он захотел!'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                    *pl '— Да брось ты притворяться недотрогой! В слободе мужики после третьей кружки только и хвастают, как ты у разделочного стола сладко стонешь, стоит только ладонь под подол запустить. Перед кем ломаешься?'
                else
                    *pl '— Хех, какая дикая лошадка, мне нравится! — мастеровой ухмыляется, прижимая Мелиссу ещё ближе к себе и продолжая по-хозяйски мять её попу пальцами. — Насмотрелся я на твоих смазливых кавалеров. Я мужик крепкий, заработок верный, так что на ценный приз спинтриев не пожалею, отсыплю от души!'
                end
                *pl '— Ого, спинтриев он не пожалеет? Какой щедрый мастер... — она с иронией прищуривается и начинает водить рукой вверх-вниз по стволу в штанах, заставляя его шумно выдохнуть. — Значит, твоё хозяйство такое же твёрдое, как твои породы дерева, раз ты так уверенно им хвастаешь. Ладно, твоя наглость меня даже заинтриговала. Раз уж ты так рвёшься проверить мою «подсобную статистику» — пошли.'
            end
        else
            *pl 'Мастеровой, крепко сжимая в руке кружку, нагло преграждает Мелиссе дорогу у лестницы, сально ухмыляясь:'
            *pl '— Куда спешишь, огонь-девка? Я твою матушку Сандру ещё молодой помню, та ещё штучка была, мужикам головы кружила только так! А ты прямо в неё пошла — кровь с молоком, изгибы такие, что никакое кружало не выверит. Бросай свои подносы, пойдём потолкуем по-соседски, покажешь, унаследовала ли ты мамин задор!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Надо же, какой ценитель семейных традиций выискался! Матушку он мою помнит... Только учти, мастер: огонь, который ты в нас разглядел, капризный. Освободи дорогу, пиво само себя не принесёт.'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                        *pl '— Да ладно тебе цену набивать! В квартале поговаривают, что ты в этой таверне живёшь и за звонкую монету в подсобку ходишь. Не строй из себя недотрогу!'
                    else
                        *pl '— Ух, грозная какая, точно мамина порода! Ну ничего, я мастер терпеливый, дерево любой твёрдости гнуть умею. Давай в подсобку отойдём, отсыплю серебра, договоримся по-хорошему!'
                    end
                    *pl '— А ты упрямый, мне такие нравятся... Раз уж пришёл с серебром — заходи за дверь. Посмотрим, так ли ты хорош в работе руками, как хвастаешь, но плата должна быть достойной! — игриво подмигивает и увлекает его за собой.'
                else
                    *pl '— Упоминание моей матери в столь вульгарном контексте не делает чести вашему воспитанию. Мои изгибы и семейное древо — абсолютно не ваше дело, а ваши плотницкие метафоры столь же неотёсаны, как и ваши манеры. Уберите локти и освободите проход, пока я не организовала вам кружку промеж глаз!'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                        *pl '— Да ладно тебе цену набивать! В квартале поговаривают, что ты в этой таверне живёшь и за звонкую монету в подсобку ходишь. Не строй из себя недотрогу!'
                    else
                        *pl '— Ух, грозная какая, точно мамина порода! Ну ничего, я мастер терпеливый, дерево любой твёрдости гнуть умею. Давай в подсобку отойдём, отсыплю серебра, договоримся по-хорошему!'
                    end
                    *pl '— Твоё упрямство уступает разве что твоей грубости... Что ж, раз дорогу не уступишь, придётся принять твоё предложение. Заходи в подсобку, только не шуми. — сдержанно вздыхает и делает шаг к двери.'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'rich_merchant' or $c = 'merchant':
        if HallMissingBargainExplicit = 1:
            *pl 'Купец, откинувшись на скамью, манит Мелиссу спинтрием, зажатым между пальцев. Когда она подходит, он перехватывает Мелиссу за талию и тянет на свои колени, заставляя присесть. Его рука крепко ложится на её бедро:'
            *pl '— Куда же ты вечно ускользаешь, радость моя? Я столько дорог исходил, но такой стати не видел. Ты ведь не просто разносишь еду, я вижу блеск ума в твоих глазах. Посиди со мной, поговори с усталым путником, а я в долгу не останусь!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— О, великий путешественник! Видала я таких "путников" — у каждого второго в кармане только дорожная пыль да сказки о заморских чудесах. Думаете, я из тех, кто бежит на звон монет к первому встречному?'
                *pl '— Хех, норовистая, мне нравится! — купец похотливо ухмыляется, сжимая её бедро крепче и понижая голос до доверительного шёпота. — Думаешь, я обычный купец? Ошибаешься, умничка. Я везу целый воз умностей — редчайшие свитки и древние книги. Я вижу, ты девка грамотная. Хочешь первой запустить руки в этот либрариум?'
                *pl '— Целый воз книг?.. Настоящих, из дальних стран? Ох, торговец... Умеешь же ты ударить по слабому месту. Ладно, к чёрту твои монеты. Если ты клянешься, что позволишь мне самой выбрать любой фолиант из твоей телеги... я подарю тебе такую компанию, что ты забудешь как нужно ходить. Пошли в подсобку, пока я не остыла. Но уговор: на рассвете книга будет моей. Веди, мой щедрый меценат!'
            end
        else
            *pl 'Купец, поправляя расшитый кафтан, преграждает Мелиссе путь у лестницы. Он заглядывает ей в вырез платья, потирая руки:'
            *pl '— Эй, егоза! Чего ты тут с мисками бегаешь, ноги бьёшь? Пойдём покажешь где тут у вас укромный уголок. Будешь паинькой — отсыплю серебра. Пойдём, побалуешь купца, я до девичьей ласки щедрый, когда меня ублажают как надо!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Ого, какие важные гости к нам на огонёк заглянули! Спинтриями манит, перстнями хвастает... Только учти, почтенный: птица моего полёта на дешёвый бисер не клюёт. Освободи дорогу, дай гостям заказы разнести. Если к полуночи твоя щедрость не испарится вместе с хмелем, так и быть, разрешу тебе угостить меня дорогим вином. А пока — не мешай работать.'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                        *pl '— Да брось ты ломаться! Мне известно, что в "Диком жеребце" за звонкую монету девки с гостями ласковые. Называй свою цену, купеческое слово — не обижу!'
                    else
                        *pl '— Ух, норовистая! Люблю таких, за характер и доплатить не жалко! Не строй из себя недотрогу, девка, моё серебро любой замок открывает. Пошли уединимся, не обижу!'
                    end
                    *pl '— Тяжёлый ты человек, торговец, во всех смыслах... Ну ладно, уговорил, люблю мужчин с тугим кошельком, и не только. Пошли пока я не передумала! — игриво подмигивает, заставляя его поспешить.'
                else
                    *pl '— Ваша щедрость, сударь, уступает разве что вашему пузу. Прежде чем предлагать мне денег, вам следовало бы купить себе немного манер. Моё время и внимание не продаются вразвес, как ваша парча. Уберите свой живот с прохода!'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                        *pl '— Да брось ты ломаться! Мне известно, что в "Диком жеребце" за звонкую монету девки с гостями ласковые. Называй свою цену, купеческое слово — не обижу!'
                    else
                        *pl '— Ух, норовистая! Люблю таких, за характер и доплатить не жалко! Не строй из себя недотрогу, девка, моё серебро любой замок открывает. Пошли уединимся, не обижу!'
                    end
                    *pl '— Ваша настойчивость утомляет... Что ж, раз купеческое слово твёрдое, проверим ваши запасы. Пошли за мной, только без глупостей.'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    ! Fallback
    *pl '— В тень, — шепчет ' + $HallLewdClientWho + '.'
    *pl ' '
    gs 'HallMissingBargainTryOffenseAnswer'
    if HallMissingBargainOffenseAnswered = 0:
        *pl '— Заходи, — Мелисса. — Комплименты короче, серебро честнее.'
    end
    killvar '$p'
    killvar '$c'
