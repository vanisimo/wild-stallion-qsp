! ================================================
! FILE: modules/events/hall/hall_missing_bargain_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT — уговоры перед missing (строго по канон-промту E:\promt.txt)
! Архив старой prose: archive/hall_missing_text_v016_backup/hall_missing_bargain_text.qsps
!
! Мелисса: книжная зазнайка (типаж «как Гермиона») — ирония, не злая шлюха;
! серебро/спинтрии → бумага, книги. Спинтрии = монеты = серебро.
! При Explicit=1 — сменяет насмешку на пьянящую томность и искушённое превосходство.
! Сандра: всё на КУХНЕ (не кладовая, БЕЗ зала); тон сдержанный→разврат по лесенке.
!   При выпадении Сандры ГГ замечает, как гость зашёл на кухню, проходит проследить —
!   и вся сцена (уговаривание и действие) происходит прямо на кухне без зала.
! Сёстры: подсобка (не «за бочками»).
! Аманда: смущение / азарт; «аккуратные» / первая любовь.
!
! ВАЖНОЕ ПРАВИЛО ДЛЯ A4, A5, A6 (рот / минет / лицо / горло):
!   В зале/на кухне уговор ВСЕГДА идёт про МИНЕТ (ласка губами / отсос).
!   Расширение услуг (кончить на лицо в A5, глубокое горло в A6) происходит
!   непосредственно внутри самой сцены missing!
!
! ТИПЫ КЛИЕНТОВ ($c = $HallMissingClient):
!   'traveler' / 'sailor' — моряк / путешественник (морская брань, гавани, компас, брутальность)
!   'craftsman' / 'local' — ремесленник / местный (свойский, кузница, грубые простонародные шутки)
!   'rich_merchant' / 'merchant' — купец / торговец (серебро, монеты, товар, привык покупать)
!   'drunk_guest' / else — захмелевший гость (перегар, эль, хриплый наглый натиск)
!
! Комментарии [B-…] — якоря для сцен missing, не удалять.
! ================================================

#HallMissingBargainPrintText
    HallMissingBargainRefused = 0
    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end
    if $HallLewdClientWho = '':
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end
    if LOC('HallMissingBargainIsExplicit') = 1:
        gs 'HallMissingBargainIsExplicit'
    end

    if $HallMissingGirl = 'sandra':
        *pl 'Вы замечаете, как ' + $HallLewdClientWho + ' бесцеремонно отодвигает кухонную занавеску и проходит на кухню, оглядываясь по сторонам. Вы тихо проходите следом проследить — и прямо от входа видите всю сцену.'
    else
        *pl 'Вы не вмешиваетесь — лишь из тени слышите, как ' + $HallLewdClientWho + ' сдавленным, хриплым от вожделения голосом уговаривает ' + $RealName[$HallMissingGirl] + ' отступить на пару минут в тёмный уголок за подсобку. Речь его совсем не о заказе эля.'
    end
    *pl ' '

    if $HallMissingGirl = 'amanda':
        gs 'HallMissingBargainPrintAmanda'
    elseif $HallMissingGirl = 'melissa':
        gs 'HallMissingBargainPrintMelissa'
    else
        gs 'HallMissingBargainPrintSandra'
    end

    *pl ' '
    if HallMissingBargainRefused = 1:
        *pl 'Уговор сорвался — пьяный гость отступает ни с чем, а ' + $RealName[$HallMissingGirl] + ' возвращается к своей работе.'
        exit
    end

    if $HallMissingGirl = 'sandra':
        *pl 'Всё происходит прямо здесь, на кухне — в полумраке за кухонным столом, под шипение сковороды и густой пар. Если останетесь проследить — своими глазами увидите продолжение этой сцены прямо у печи.'
    else
        *pl 'Они медленно и бесшумно выскальзывают от стойки — прямо к тяжелой дубовой двери подсобки, в прохладный полумрак. Если шмыгнёте следом — своими глазами увидите, чем закончилась эта тёмная сделка.'
    end
---

! ================================================
! АМАНДА (канон E:\promt.txt строки 3-19)
! ================================================
#HallMissingBargainPrintAmanda
    $p = LCASE($HallMissingPromise)
    $c = LCASE($HallMissingClient)

    if $c = 'drunk_guest' or $c = 'drunk':
        pol_val = GirlWorkPolicy['amanda']
        HallMissingBargainRefused = 1
        *pl '— Заходи в подсобку... п-поцелуемся! — валясь на Аманду и одуряюще дыша перегаром, заплетающимся языком говорит захмелевший гость, хватая её за попу.'
        *pl ' '
        if pol_val = 3:
            *pl '— Ой, какой ты тепленький... Иди сначала проветрись да проспись! А точно, и приходите в нашу таверну, мы всегда рады гостям, когда протрезвеешь. — мягко отстраняет его с улыбкой.'
        else
            *pl '— Ой! Идите проспаться! Вы очень пьяны и пугаете меня... Я никуда с вами не пойду, убери руки! — сжимается от чувственного испуга, вырывая руки и отползая за поднос.'
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    ! [B-AM-01] soft A1 грудь — маленькие / аккуратные / первая любовь
    if $p = 'look_tits':
        ! Explicit=1: прямой откровенный разговор (после лица A5)
        if HallMissingBargainExplicit = 1:
            *pl 'Гость подзывает Аманду ближе, беглым движением пальцев оттягивает шнуровку её корсажа и бесстыдно заглядывает внутрь. В открывшемся вырезе показываются маленькие сиси Аманды с задорно стоящими розовыми сосками.'
            *pl '— Эй! Руки! — вспыхивает Аманда, попытавшись прикрыть подносом вырез.'
            *pl '— Да чего ты, я же с лаской! — ухмыляется гость, не сводя взглядов с её груди. — Вон как торчат, того и гляди глаза выколют! Идём, посмотрю поближе, помну их немного — больно ладные они у тебя!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— Ну уж нет... просто так мять не дам!'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                    *pl '— Чего выкобениваешься? Все знают, что вы тут, за дополнительную плату, на всё согласны!'
                else
                    *pl '— На вот, держи серебряник! Сразу повеселеешь! — засовывает монету ей в корсаж.'
                end
                *pl '— Хорошо, пошли, уговорил... Только быстро, пока Стефан отвернулся! — заливается румянцем, с томным азартом прикусывает губку, сама оттягивает вырез и спешно утягивает гостя в подсобку.'
            end
        else
            if $c = 'craftsman':
                *pl 'Мастеровой подзывает Аманду к столику, когда она забирает пустую посуду. Он вальяжно откидывается на лавке и цепляется затуманенным взглядом за шнуровку её корсажа.'
                *pl '— Ой, совсем как у моей первой девушки, когда мы молодые были... Как же я её любил! Помню, затащил её на сеновал, а она мне только сисечки свои и показала — точь-в-точь как у тебя. А потом замуж за другого вышла... эх. Пойдём, я знаю, где тут у вас укромное местечко, не первый год сюда хожу! Я только гляну, молодость вспомню — покажешь, не обижу!'
            elseif $c = 'traveler':
                *pl 'Моряк ловко притягивает проходящую Аманду за фартук, нагибается ближе и с жадным причмокиванием заглядывает ей прямо в вырез.'
                *pl '— Ой, совсем как у моей первой девушки, когда мы молодые были... Как вспомню, как мы любились всю ночь напролёт! Её сиси так и мелькали перед лицом, точь-в-точь как твои были... Показывай курс! Я только посмотрю, молодость вспомню — идём покажешь, не обижу!'
            elseif $c = 'rich_merchant' or $c = 'merchant':
                *pl 'Купец весомо стучит кружкой, поманивает Аманду золотой монетой и, когда она наклоняется за заказом, откровенно засматривается на её аккуратные формы.'
                *pl '— Ой, совсем как у моей первой девушки, когда мы молодые были... Как вспомню, раздеваю её в первый раз, а у меня руки дрожат, когда её за холмики схватил... Пойдём, не обижу, монету дам — купишь себе ленту цветную! Я только посмотрю, молодость вспомню — покажешь, не обижу!'
            else
                *pl '— Да я только глазком гляну, — сально шепчет ' + $HallLewdClientWho + '. — На твою молодую грудь. Расшнуруй на пальчик. Юбку не трону — клянусь!'
            end
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Аха-ха! Чужую молодость по моим сиськам вспоминать собрался? — Аманда смело выпрямляет спинку, кокетливо оттягивает вырез корсажа и с дразнящей улыбкой приоткрывает аккуратную грудь.'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— А то я не слышал про вашего "жеребца"! Мужики на пристани хвастали, что тут за монету не только на холмики можно любоваться!'
                    else
                        *pl '— Точь-в-точь как у неё! Пойдём покажешь в подсобке, серебром не обижу!'
                    end
                    *pl '— Шагай в подсобку, уважаемый! Покажу тебе девичьи холмики поближе, раз монету даёшь... Только быстро и руки не распускай, а то Стефан заметит! — задорно подмигивает и утягивает его за собой.'
                else
                    *pl '— Т-только посмотреть?.. Они же... маленькие, что там смотреть... — Аманда заливается румянцем и прижимает поднос к груди.'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Не ломайся, красавица! В городе только и разговоров, что вы в этой подсобке гостям не отказываете. А мне что, жалко пару секунд под корсаж глянуть?'
                    else
                        *pl '— Не маленькие! Аккуратненькие, аккуратненькие! Точь-в-точь как у моей первой любви. Пойдём с глаз скроемся, дай глянуть на такую прелесть!'
                    end
                    *pl '— Л-ладно... очень быстро. В подсобке. Чтобы никто не увидел!'
                end
            end
        end

    ! [B-AM-02] soft A2 обнять / поцеловать / вдохнуть запах
    elseif $p = 'hug_waist':
        ! Explicit=1: прямой язык (после лица / зрелого рта)
        if HallMissingBargainExplicit = 1:
            if $c = 'traveler':
                *pl 'Пьяный моряк без лишних прелюдий бесцеремонно притягивает Аманду к себе за талию, по-хозяйски сжимая ладонью её ягодицу и зарываясь носом в её волосы у шеи.'
                *pl '— Хватит тут жопой вертеть, девка! Пойдём где тут у вас место поспокойней. Прижму тебя к себе, задеру подол да помну твою сочную попу как следует! Всю дорогу в море снилось, как сожму чью-то задницу, а она у тя ничего, сиськи подкачали, но ничего, вырастут!'
                *pl ' '
                gs 'HallMissingBargainTryOffenseAnswer'
                if HallMissingBargainOffenseAnswered = 0:
                    *pl '— Ой-ой... Разок повернулась — уже жопой верчу... и сиськи мои ему маленькие...'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Чего бубнишь? В порту прямо говорят, что ты за монету долго не ломаешься!'
                    else
                        *pl '— Да нормальные сиськи, пойдём уже, в темноте всё хорошеет!'
                    end
                    *pl '— ...иди посмотри какие у мамки моей, у меня такие же будут, а попочка у меня и правда что надо, ладно пойдем, помнёшь мою попку... — тихо вздыхает, краснея, но бёдрами сама подаётся к его ладони.'
                end
            elseif $c = 'craftsman':
                *pl 'Мастеровой резким движением подтягивает Аманду за подол ближе к себе, хватает ее за попку, и не отпуская говорит:'
                *pl '— Аманда, девка, что за манеры! Ни тебе здрасьте, ни пожалуйста! Я тут постоянный клиент или где? Пошли в подсобку! Пожмакаю тебя в качестве извинений!'
                *pl ' '
                gs 'HallMissingBargainTryOffenseAnswer'
                if HallMissingBargainOffenseAnswered = 0:
                    *pl '— Ах... дядька... ты вроде приличным казался... пьяный что ли, или взаправду обиделся.'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Не строй скромницу! Пьяный, обиделся... Вся слобода знает, что у вас в таверне девки сговорчивые!'
                    else
                        *pl '— Кто пьяный? Я пьяный? Когда я пьяный, я буйный, а раз я не буйный, я не пьяный понятно, но обиделся взаправду! Пошли пожмакаю!'
                    end
                    *pl '— Ну раз так — пошли в кладовую... Только давай без лишнего! — покрывается румянцем и тяжело выдыхает.'
                end
            elseif $c = 'rich_merchant' or $c = 'merchant':
                *pl 'Купец бесцеремонно обхватывает наклонившуюся Аманду за талию, ладонью накрывает её бедро и роняет на стол спинтрий.'
                *pl '— Ну-ка бросай свои кружки, девка! Пошли пособишь мне, обниму горячо да зажму твою круглую попу обеими ладонями! Покажу, за какую ласку купцы серебро отдают!'
                *pl ' '
                gs 'HallMissingBargainTryOffenseAnswer'
                if HallMissingBargainOffenseAnswered = 0:
                    *pl '— Ой... ну и задор у тебя...'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Что выкобениваешься? На тракте говорят, как вы тут за монеты гостям не отказываете!'
                    else
                        *pl '— Купеческий задор да за серебро! Пошли, не пожалеешь!'
                    end
                    *pl '— ...Ладно, раз за серебро — пойдём покажи где тут у вас укромное местечко... посмотрим, на что способны твои руки... — приоткрывает губы от волнения и виновато улыбается.'
                end
            else
                *pl '— Хватит обжиматься сквозь платье! — хрипит ' + $HallLewdClientWho + ', запуская ладонь под фартук. — Пойдём в подсобку, там задеру юбку и подомну тебя как следует!'
                *pl ' '
                gs 'HallMissingBargainTryOffenseAnswer'
                if HallMissingBargainOffenseAnswered = 0:
                    *pl '— Ой-ой... — Аманда сладостно стонет, кусая губу, а её бёдра сами невольно подаются назад, ощущая его стояк. — Раз уж зашли в тень... можно и не только обнять... Пойдём, помнёшь мою попку по-настоящему...'
                end
            end
        else
            if $c = 'traveler':
                *pl 'Моряк, выловив момент, когда Аманда проходит мимо с пустым подносом, ловко сгребает её за попу и притягивает ближе к своей лавке.'
                if $HallMissingInitiative = 'high':
                    *pl 'Аманда смотрит на него и опускает ладонь ему на плечо, слегка покачивая бёдрами и приоткрывая губы.'
                else
                    *pl 'Аманда робко ойкает, прижимает поднос к груди и пытается смущённо отстраниться, краснея до корней волос.'
                end
                *pl '— Эй, девчуля! Полрейса в море только и снилось, как прижму молодую девку к груди. Пойдём на минутку в подсобку, в тишине поговорим — мне в радость просто обнять тебя, уткнуться носом в шею да вдохнуть твой девичий запах, и мне легче станет!'
                *pl ' '
                gs 'HallMissingBargainTryOffenseAnswer'
                if HallMissingBargainOffenseAnswered = 0:
                    if $HallMissingInitiative = 'high':
                        *pl '— Правда... просто обнимешь — и легче?..'
                        if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                            *pl '— Так мне в порту прямо сказали: Девки "жеребца" в подсобке долго не ломаются! Пойдём уже!'
                        else
                            *pl '— Сразу полегчает, красавица! А за ласку монетой одарю!'
                        end
                        *pl '— Ну идём в подсобку, обниму тебя, морячок... и дам подержаться за разные места... Заслужил за долгое плавание! — виновато краснеет, но сама подаётся бёдрами навстречу.'
                    else
                        *pl '— П-правда просто обнимете — и вам легче станет?.. Ну хорошо... но только пообниматься и всё...'
                        if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                            *pl '— Чего ломаешься? В порту все экипажи толкуют, что вы в этой таверне мужикам не откажете! Наслушался я про вас, так что не стесняйся!'
                        else
                            *pl '— Только пообнимаемся, малютка, слово моряка! Пойдём в тень, никому до нас дела нет! — придерживает её за талию.'
                        end
                        *pl '— Хорошо идемте... только не прижимайте крепко, а то я закричу! — мелко поддрагивает от смущения, прижимая поднос к корсажу.'
                    end
                end
            elseif $c = 'craftsman':
                *pl 'Мастеровой, отставив пустую кружку, перехватывает Аманду за подол, когда она протирает соседний стол, и хозяйски похлопывает по лавке рядом с собой.'
                if $HallMissingInitiative = 'high':
                    *pl 'Аманда смело подсаживается на край стола прямо перед его лицом, глубоко наклоняясь и демонстрируя упругую ложбинку.'
                else
                    *pl 'Аманда останавливается, сжимая тряпку в ручке, и виновато опускает глазки, переступая с ноги на ногу.'
                end
                *pl '— Аманда, дочка, ты совсем расцвела! Зайди на миг в подсобку, дай я тебя за талию обниму да в румяную щёку поцелую. Ты же меня с детства знаешь, не обижу. Просто прижмусь на секунду, отдохну душой от забот.'
                *pl ' '
                gs 'HallMissingBargainTryOffenseAnswer'
                if HallMissingBargainOffenseAnswered = 0:
                    if $HallMissingInitiative = 'high':
                        *pl '— Ну ладно... душой это ко мне...'
                        if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                            *pl '— А то я не слышал молву про ваш трактир! На базаре мужики только и хвалят, какие вы тут сговорчивые!'
                        else
                            *pl '— Пойдём-пойдём, за хорошую ласку и серебром отблагодарю!'
                        end
                        *pl '— ...идём в подсобку, отдохнёшь... Дам тебе и талию обнять, и попку погладить... Ты только монету на ящик положить не забудь! — кокетливо улыбается и поправляет вырез.'
                    else
                        *pl '— Ой, дяденька... точно только за талию?..'
                        if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
