#HallMissingBargainSoftAmanda
    $r = LCASE($ARGS[0])

    if $r = 'look_tits':
        if $HallMissingClient = 'rich_merchant':
            *pl '— Ты такая миленькая, точь-в-точь как моя первая любовь в молодости… — нежно шепчет купец, нависая ближе. — Дай только расшнуровать корсаж на пальчик, взглянуть на яблочки… Руками не задену!'
        else
            *pl '— Не смог удержаться… Ты мне давно нравишься, Амандочка, — тихо шепчет ' + $HallLewdClientWho + '. — Разреши только на пальчик ослабить шнуровку на груди… Одним глазком гляну — и отступлю!'
        end
        *pl ' '
        if $HallMissingInitiative = 'high':
            *pl '— Т-правда миленькая?.. — Аманда томно выдыхает, сладостно заливаясь румянцем. Пальцы её сами несмело касаются льняной ленты на вырезе. — Шагай за мной в подсобку… только пока Стефан не заметил.'
        else
            *pl '— Т-только посмотреть?.. — Аманда сгорает от смущения, прижимая поднос к груди и озираясь на зал. — Ладно… Только очень быстро за бочкой, чтобы никто не увидел!'
        end

    elseif $r = 'kiss_small':
        *pl '— Всего один маленький поцелуйчик… — ласково просит ' + $HallLewdClientWho + ', осторожно касаясь её пальцев. — В губки или в нежную шейку за дверью… И я сразу отсяду за свой стол!'
        *pl ' '
        if $HallMissingInitiative = 'high':
            *pl '— Всего один?.. — Аманда виновато прикусывает губу, но глаза ее блестят от тайного азарта. Она сама несмело подается навстречу и утягивает его у подсобки: — Только губками…'
        else
            *pl '— О-один поцелуй?.. — Аманда дрожит от нахлынувшего нежного страха. — Только в щечку или в шею… и не держите меня крепко!'
        end

    elseif $r = 'touch_cock':
        *pl '— Посмотри, какой бугор тугой… — ' + $HallLewdClientWho + ' сипит тише, кивая вниз. — Это же всё из-за тебя! Потрогай только сквозь сукно штанов, пожми ладошкой…'
        *pl ' '
        if $HallMissingInitiative = 'high':
            *pl 'Аманда на миг замирает, с невольным жаром косясь на его пах. Пальцы её сами задерживаются на натянутом сукне: — Какой ты горячий… Шагай за мной у подсобки, там я потрогаю получше.'
        else
            *pl '— Я… ладошкой? — Аманда краснеет до корней волос и пугливо опускает глаза. — Только поверх ткани! И сразу отпустите!'
        end

    elseif $r = 'smell':
        *pl '— Приподними подол у бочки, — шепчет ' + $HallLewdClientWho + '. — Дай только понюхать твой сладостный бутончик между ног… Уткнусь носом на секунду — и вернусь в зал!'
        *pl ' '
        if $HallMissingInitiative = 'high':
            *pl '— Понюхать?.. — Аманда виновато прикрывает глаза, но в животе её сладостно тянет. Она тихо кивает: — Заходи в кладовую… в самый тёмный угол.'
        else
            *pl '— Боже… это же так неприлично… — Аманда судорожно комкает край платья, оглядываясь. — Только в темноте за бочкой… и не вздумайте трогать руками!'
        end

    else
        *pl '— Шагни со мной в тень, — шепчет ' + $HallLewdClientWho + '. — Прижму к себе, поцелую нежно. Без глупостей!'
        *pl ' '
        *pl '— Только чуть-чуть в темноте… — еле слышно соглашается Аманда.'
    end

