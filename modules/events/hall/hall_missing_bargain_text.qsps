!        раздвигая границы для последующего ухода в подсобку.
! hard — прямой поздний торг на рот, проглот или сочную работу.
!
! Мелисса (канон голоса, docs/design-npc-voices.md §3):
! книжная зазнайка КАК Гермиона Грейнджер (Гарри Поттер) — типаж, не кроссовер.
! НЕ злая проститутка. Похоть = смешная/предсказуемая/наивная;
! закатывает глаза; ирония; серебро → бумага, книги, стихи.
! ================================================

#HallMissingBargainPrintText
    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end

    if $HallLewdClientWho = '':
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end

    if $HallMissingBargainStyle = 'hard':
        gs 'HallMissingBargainPrintHard'
    else
        gs 'HallMissingBargainPrintSoft'
    end
