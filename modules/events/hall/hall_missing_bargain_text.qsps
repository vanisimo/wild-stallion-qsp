! ================================================
! FILE: modules/events/hall/hall_missing_bargain_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT — уговоры перед missing (канон 2026-08)
!
! Мелисса: книжная зазнайка (типаж «как Гермиона») — ирония, интеллектуальное превосходство;
! серебро/спинтрии → редкие книги, трактаты, издание сборника стихов.
!
! Сандра: всё на КУХНЕ (не кладовая, БЕЗ зала); печь, плита, разделочные столы.
! Мотивация: редкие заморские специи и накопления на спокойную старость.
!
! Аманда: смущение / девичий азарт; копит на крема, косметику и богатое приданое.
!
! ТИПЫ КЛИЕНТОВ ($c = $HallMissingClient):
!   'noble' — дворянин (полные сцены уговора)
!   'traveler' / 'sailor' — моряк (грубый, берет напором; Сандре нравится, сестры подчиняются)
!   'craftsman' / 'local' — мастеровой (комплименты, сравнения с молодостью/матерью)
!   'rich_merchant' / 'merchant' — купец (серебро, монеты, товар, привык покупать)
!   'drunk_guest' / 'drunk' — захмелевший гость (отказ/выдворение)
! ================================================

! окно 1: клиент у двери (ещё не уговор)
#HallMissingBargainPrintNotice
    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end
    if $HallLewdClientWho = '':
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
    end
    if $HallMissingGirl = 'sandra':
        *pl 'Краем глаза вы замечаете, как ' + $HallLewdClientWho + ', выждав удобный момент, бесшумно выскальзывает из зала и шмыгает за кухонную дверь — прямо к гудящей печи и разделочным столам.'
        *pl ' '
        *pl 'Из щели приотворенной створки тянет пряным жаром очага, запахом жареного мяса и печеного хлеба. Сандра стоит у массивной плиты с поварешкой в руках, а незваный гость уже настигает её в тесном пространстве между чугунными котлами и полками со специями.'
    else
        if $HallMissingPlace = 'stairs':
            *pl 'Вы замечаете, как ' + $HallLewdClientWho + ', крадучись за ' + $RealName[$HallMissingGirl] + ', перехватывает её в полумраке под лестничным пролетом — у самого спуска в прохладный погреб.'
        else
            *pl 'Вы замечаете, как ' + $HallLewdClientWho + ', неотступно следовавший за ' + $RealName[$HallMissingGirl] + ' после шумной возни у столиков, настигает её в тихом коридоре у приоткрытой двери подсобки.'
        end
        *pl ' '
        *pl 'По его лицу сразу видно: разговор пойдет вовсе не о заказе новой кружки эля. Оказавшись наедине в густой тени, вдали от чужих глаз, они тихо переговариваются.'
    end
---

! окно 2: один уговор (клиент × Explicit), без входа и без сцены
#HallMissingBargainPrintText
    HallMissingBargainRefused = 0
    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end
    if $HallLewdClientWho = '':
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end
    if LOC('HallMissingBargainIsExplicit') = 1:
        gs 'HallMissingBargainIsExplicit'
    end

    if $HallMissingGirl = 'amanda':
        gs 'HallMissingBargainPrintAmanda'
    elseif $HallMissingGirl = 'melissa':
        gs 'HallMissingBargainPrintMelissa'
    else
        gs 'HallMissingBargainPrintSandra'
    end

    if HallMissingBargainRefused = 1:
        *pl ' '
        *pl 'Уговор сорвался — несолоно хлебавши, захмелевший гость ворчливо пятится назад, а ' + $RealName[$HallMissingGirl] + ' с облегчением поправляет фартук и возвращается к своей привычной работе.'
    end
---

! ================================================
! АМАНДА
! ================================================
#HallMissingBargainPrintAmanda
    $p = LCASE($HallMissingPromise)
    $c = LCASE($HallMissingClient)

    if $c = 'drunk_guest' or $c = 'drunk':
        pol_val = GirlWorkPolicy['amanda']
        HallMissingBargainRefused = 1
        *pl 'Тяжело наваливаясь на косяк и обдавая девушку удушливой волной кислого перегара, захмелевший гость неуклюже шарит ладонью по подолу Аманды, пытаясь сгрести её за округлые ягодицы:'
        *pl '— Слышь, красава... айда в коморку... потискаемся, а? Угощу медной денежкой... чё ломаешься-то...'
        *pl ' '
        if pol_val = 3:
            *pl '— Ой, какой шустрый нашелся... Руки убери, говорю! — Аманда звонко цокает языком и с плутовской улыбкой упирается ладошкой прямо ему в грудь, не подпуская ни на шаг. — Шагай-ка на свежий воздух, охлади свой пыл да проспись как следует у коновязи. Вот протрезвеешь, приведешь себя в порядок — тогда и приходи в трактир, трезвым гостям мы всегда рады. А пока марш на улицу!'
        else
            *pl '— Ой! Да отвяжись ты, очумел совсем! — Аманда мгновенно вспыхивает краской до самых корней волос и сердито выставляет перед собой тяжелый деревянный поднос, точно щит. — Ты на ногах едва стоишь, языка не ворочаешь, а всё туда же — лапать лезет! Ни в какую подсобку я с тобой не пойду, убирай свои клешни, пока Стефана не кликнула!'
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'noble' or $p = 'noble':
        if HallMissingBargainExplicit = 1:
            *pl 'Дворянин без тени робости усаживает Аманду к себе на колени. Его ухоженная ладонь с перстнем бесцеремонно скользит под подол её платья, гладя нежную девичью кожу бедра, пока девушка часто и прерывисто дышит, замирая от безумных надежд и пьянящей близости высшего света.'
            *pl '— Твоя цветущая прелесть рождена для шелков и бархата, Аманда, — вкрадчиво шепчет он ей на самое ухо, обжигая шею горячим дыханием. — Эта аккуратная, сводящая с ума грудь, тонкая талия... Будь в твоих жилах хоть капля благородной крови, я бы без раздумий повел тебя под венец в кафедральном соборе. Но сословные законы жестоки, моя прелестница... Наша нежность возможна лишь в спасительной тени. Пойдем со мной в полумрак, покажи мне свою преданность.'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— В соборе?.. Ильматер всеблагой, я... я стану настоящей госпожой!.. — Аманда восторженно и прерывисто хихикает, её глаза лихорадочно блестят от волнения и дерзкого девичьего тщеславия. Она нетерпеливо ерзает на его коленях, заставляя край юбки подняться еще выше, и закусывает губу от сладкого жара в груди: — Господин... а мой брат Стефан! Он ведь сильный, предприимчивый, он непременно добьется уважения и выслужит благородное звание! И тогда... вы ведь правда возьмете меня в свой замок?!'
                    *pl '— О чем разговор, моя сладкая голубка? Слово дворянина: как только брат получит патент — сразу объявим помолвку перед всем миром. А теперь покажи мне, насколько пылка будущая госпожа...'
                    *pl '— Ах!.. У меня голова кругом идет, я на всё согласна ради нашей судьбы! Пойдемте скорее за дверь, мой господин, мой будущий муж... Я всё сделаю так сладко, что вы и думать забудете о столичных барышнях!'
                else
                    *pl '— Под венец... в соборе перед алтарем?.. — дыхание Аманды перехватывает от невероятных картин, щеки заливает яркий румянец смущения. Она трепетно сжимает пальцы на его камзоле, заглядывая дворянину в глаза с наивной мольбой: — Господин, послушайте... мой брат Стефан ведь такой упорный! Он непременно добьется дворянского герба, я знаю! И тогда... тогда сословная преграда исчезнет, правда?'
                    *pl '— Разумеется, моя прелесть, — дворянин самодовольно ухмыляется, лаская её колено. — Стоит брату выбиться в дворяне, и мы предстанем перед епископом. А пока докажи мне, что твоя верность не знает сомнений...'
                    *pl '— Ох... да, мой суженый, да!.. Только бы вы не забыли свое обещание... Идемте скорей в подсобку, пока в коридоре никого нет!'
                end
            end
        else
            *pl 'Дворянин в тонком камзоле преграждает Аманде путь в полумраке прохода, осыпая её изысканными, тягучими комплиментами и жадно разглядывая её свежую девичью красу.'
            *pl '— Какое дивное, цветущее создание... — сладкозвучно роняет он, касаясь пальцами её горячей щеки. — Твоя девичья прелесть затмевает столичных модниц. Покажи мне, красавица, где тут у вас укромное местечко, чтобы нам не мешал этот трактирный гвалт? Страсть как хочу полюбоваться тобой без посторонних глаз. Видит Ильматер, будь ты благородного сословия — я бы, не колеблясь, надел тебе на пальчик кольцо с чистейшим сапфиром!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Кольцо с сапфиром?.. Мне?! — Аманда счастливо охает, её глазки сияют восторгом, а сердце колотится как птица в силках. Она прижимает ладони к пылающим щекам, не в силах оторвать взгляд от благородного гостя. — Ах, милостивый господин! До чего же несправедлив этот мир... Пойдемте скорее, я покажу нашу тихую подсобку за перегородкой, там нам точно никто не помешает насладиться беседой!'
                else
                    *pl '— К-кольцо?.. Алтарь?.. — Аманда растерянно замирает, заливаясь девичьим румянцем. От таких речей у неё кружится голова, она робко теребит передник и шепчет, смущенно опуская ресницы: — Ах, ваша милость... вы правда... правда не шутите?.. У нас... у нас есть тихий уголок за лестницей, идите следом, там сейчас совсем пусто...'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'traveler' or $c = 'sailor':
        if HallMissingBargainExplicit = 1:
            *pl 'Крепкий моряк, пахнущий соленым ветром и крепким портовым ромом, без долгих экивоков притягивает Аманду к себе за талию. Его огрубевшая ладонь по-хозяйски опускается на её аппетитную девичью попку, сжимая сквозь тонкую ткань юбки, а сам он нахально утыкается носом в её душистую шею:'
            *pl '— Хватит глазки строить да вилять подолом, девка! Показывай, где у вас тут угол поглуше. Всю дорогу в трюме снилось, как сожму в кулаке тугую девичью плоть. Стан у тебя ладный, попка сахарная, да и грудка девичья под корсажем так и просится в ладонь! Шагай вперед!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— Ой-ой... Стой смирно, медведь портовый! Разок прошла мимо — а он уже за подол хватает...'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                    *pl '— Чего ты ворчишь? — моряк хрипло гогочет, прижимая её бедро к своим грубым парусиновым штанам. — В гавани прямым текстом бают: в «Диком Жеребце» любая молодка готова утешить бывалого матроса, была бы монета звонкой!'
                else
                    *pl '— Не серчай, красавица, я от щедрой души! Пойдем скорей, в полумраке любая ласка слаще меда!'
                end
                *pl '— Ишь, какой прыткий... Всё-то ему подавай! — Аманда прерывисто вздыхает, густо алея щеками, однако сама подается попкой навстречу его настойчивой хватке и манит за собой в тень: — Ладно уж, шагай следом, только не шуми...'
            end
        else
            *pl 'Моряк ловко перехватывает проходящую мимо Аманду за тонкое запястье, наклоняется к её зарумянившемуся ушку и проникновенно шепчет:'
            *pl '— Вот это русалочка в трактирные сети попалась! Красавица, ты же точь-в-точь моя первая любовь на дальнем острове... Как вспомню, как мы до рассвета миловались на теплом песке! Её упругая девичья грудь так и ходила ходуном перед глазами — точь-в-точь как твоя под этим шнурованным лифом! Держи курс в укромный уголок, помоги моряку молодость вспомнить!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Ха-ха! Молодость он вспомнить надумал? — Аманда звонко смеется, кокетливо вскидывая подбородок и чуть ведя плечиком. — У меня вообще-то полон поднос заказов, Стефан мигом меня хватится, если зал без эля останется!'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Да никто тебя не потеряет, брось кокетничать! — подмигивает моряк, позвякивая увесистым кошелем на поясе. — В порту все знают: здешние девчата за звонкую монету не только молодость вспомнить помогут, но и в рай морской унесут!'
                    else
                        *pl '— Не потеряет твой хозяин ничего! Я за ласку и доброе воспоминание чистых спинтриев отсыплю — век помнить будешь!'
                    end
                    *pl '— Ладно уж, уговорил, краснобай морской! Показывай свою монету да шагай за мной в подсобку — покажу тебе молодость во всей красе... — весело шепчет Аманда и, соблазнительно покачивая бедрами, уводит его в тишину коридора.'
                else
                    *pl '— Ой... ну что вы такое выдумываете! — Аманда смущенно прижимает поднос к аккуратной девичьей груди, пряча горящий взор. — Меня же Стефан по всему залу искать станет...'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Никто не станет тебя искать, будет тебе скромницу строить! В гавани прямо говорят: в «Диком Жеребце» девчата за щедрое серебро ласковы, как майское солнце!'
                    else
                        *pl '— Брось тревожиться, красавица! За твою нежную ласку я звонкой монеты не пожалею, накупишь себе лент атласных!'
                    end
                    *pl '— Л-лент... ну хорошо... только тихо, пока брат не заметил! — Аманда с азартом прикусывает пухлую губку и торопливо ведет моряка в полумрак под лестницей.'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'craftsman' or $c = 'local':
        if HallMissingBargainExplicit = 1:
            *pl 'Местный мастеровой с огрубевшими, сильными руками резким движением притягивает Аманду за край фартука к своему крепкому плечу, бесцеремонно оглаживая её бедро:'
            *pl '— Аманда, лапушка, ну что за спешка? Я тут свойский человек, каждую неделю к вам захожу! Неужто доброго соседа лаской обойдешь? Пойдем в каморку, разомну твои нежные бока да потискаю в знак добрососедства!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— Ах... дяденька, а с виду ведь приличный ремесленник... Хмельной эль в голову ударил, что ли, или взаправду обиду держишь?'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                    *pl '— Да брось ты строить из себя невинную овечку! Вся слобода судачит, что в трактире у девчат на ласку рука легкая, была бы плата по уговору!'
                else
                    *pl '— Кто хмельной? Я в полном разуме! А вот ласки от такой цветущей молодки истосковался донельзя. Пойдем, уважь мастера, серебром не обижу!'
                end
                *pl '— Ну раз серебром... пошли в кладовую, — Аманда густо краснеет, опуская ресницы, но послушно делает шаг в полумрак. — Только уговор: без лишней грубости!'
            end
        else
            *pl 'Ремесленник игриво цепляет пальцем тесемку на корсаже Аманды, когда та собирает со стола опорожненные глиняные кружки:'
            *pl '— Эй, Амандочка! До чего ж хороша уродилась — вся в матушку Сандру! Та в молодые годы ох и кружила головы парням на ярмарках, огонь-баба была... впрочем, она и сейчас в полном соку. А ты — прямо копия её юности! Пойдем отойдем на минутку за перегородку, посидим рядком. Порадуешь старого соседа, а я за такое дело полновесного серебра не пожалею!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Ха-ха! До матушки не дотянулся, так ко мне ластишься? — Аманда задорно прыскает в кулачок, смерив соседа плутовским взглядом. — Да и дела у меня, посуду мыть надо, Стефан мигом пропажу заметит!'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Не заметит он ничего! А про твои прелести вся улица знает: в подсобке за звонкую монету ты и выслушаешь, и приголубишь на славу!'
                    else
                        *pl '— Никто тебя не потеряет! А красоту такую на бегу разглядывать грех. Пойдем, я тебе чистое серебро отсчитаю — на новые гребни да пудру!'
                    end
                    *pl '— Ну коли на серебро не скупишься — пойдем, мастер! Разглядишь поближе, на кого я похожа... — весело шепчет Аманда и шмыгает в приоткрытую дверь.'
                else
                    *pl '— Ой... господин мастер, ну что вы право такое говорите... — Аманда робко сжимает ручки на груди, алея до ушей. — Матушка вон какая видная, а я... и Стефан в зале заругает...'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Не станет он ругать, брось робеть! По слободе давно слушок идет, что за щедрый магарыч вы в подсобке сговорчивые!'
                    else
                        *pl '— Не бойся, лапушка! За твой кроткий нрав я отсыплю добрую монету, на всё хватит!'
                    end
                    *pl '— Л-ладно... пойдемте, только быстренько и чтобы никто не приметил... — виновато шепчет девушка и ведет его за собой.'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'rich_merchant' or $c = 'merchant':
        if HallMissingBargainExplicit = 1:
            *pl 'Купец с золотыми перстнями на мясистых пальцах властно перехватывает ручку Аманды и с силой тянет её к своему поясу, роняя на скамью тяжелый серебряный кругляш:'
            *pl '— Что мне твои вежливые улыбочки, девица! Веди туда, где тихо и темно. Глядел я, как ты бедрами в зале водишь, и в штанах у меня такой пожар занялся — сил нет терпеть! Снимешь напряжение с купца — отсыплю столько звонкой монеты, что скупишь весь галантерейный ряд!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— Ой, купец... ну и прыть у тебя! — Аманда смущенно округляет глаза, глядя на блеснувшее серебро.'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                    *pl '— У купцов дело не ждет! Да и в торговых рядах болтают, что здешние молодки знают толк в ласке и без награды гостя не оставят. У меня как раз в обозе заморские притирания, душистые масла и пудра для знатных дам — выбирай любое!'
                else
                    *pl '— У купцов дело спорится быстро! С дороги я истосковался по нежным девичьим ручкам. А в обозе у меня заморские масла, душистые мази и розовые крема — дам тебе выбрать самую лучшую склянку!'
                end
                *pl '— Заморские крема и душистые масла?! — Аманда жадно приоткрывает губки, глаза её загораются девичьим восторгом. — Что ж ты раньше молчал! Идем в подсобку скорее... Всё для тебя сделаю, гость дорогой, ублажу как положено — только склянку покажи!'
            end
        else
            *pl 'Сытый купец весомо стучит донышком оловянной кружки, подмигивает Аманде блестящим спинтрием в жирных пальцах и сально заглядывает ей в вырез лифа:'
            *pl '— Эй, голубушка! Пожалей усталого караванщика: сколько верст по тракту отмахал, от лесных разбойников оборону держал, пыль глотал, тепла женского не ведал! Пойдем уединимся на минутку, снимешь с меня дорожную тяготу!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Ха-ха! От разбойников он отбивался, скажи лучше — в карете на мягких перинах спал! — Аманда задорно подбоченивается, игриво сверкая глазами. — Работа у меня, не до баловства!'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Работа подождет, красавица! Торговый люд сказывает, что в «Диком Жеребце» девчата за звонкое серебро и согреют, и приголубят от всего сердца. Показывай, где тут у вас тихий угол — куплю тебе шелковую шаль да румяна!'
                    else
                        *pl '— Не сердись, лапушка! Серебро на дороге не валяется. Пойдем за ширму — одарю монетой, купишь себе лент в косу да сладких пряников!'
                    end
                    *pl '— Одной шалью ты от меня не отделаешься, торговец! — весело подмигивает Аманда и тянет его за расшитый рукав в полумрак: — Пошли, посмотрим, насколько щедра твоя купеческая душа!'
                else
                    *pl '— Нет-нет, что вы... мне нельзя отлучаться, Стефан за порядком строго следит... — Аманда робко отступает на шаг, теребя подол.'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['amanda'] = 1:
                        *pl '— Брось скромничать, красавица! Мне верные люди шепнули, что в трактире девки к гостям ласковые. Пойдем, не обижу золотом!'
                    else
                        *pl '— Да брось ты дрожать, девица! Я человек щедрый, за доброе обхождение осыплю серебром — на целое приданое скопишь!'
                    end
                    *pl '— Н-на приданое... ну хорошо... — Аманда взволнованно облизывает пересохшие губки и торопливо ведет купца в тихую подсобку: — Только тихо, ради Ильматера...'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    ! Fallback
    *pl '— Пойдем за перегородку... — вкрадчиво шепчет ' + $HallLewdClientWho + ', не отрывая жадного взгляда от девушки.'
    *pl ' '
    gs 'HallMissingBargainTryOffenseAnswer'
    if HallMissingBargainOffenseAnswered = 0:
        *pl '— Х-хорошо... Только быстрее, пока брат не заметил... — вспыхивает Аманда и послушно уводит его в полумрак.'
    end
    killvar '$p'
    killvar '$c'
---

! ================================================
! МЕЛИССА
! ================================================
#HallMissingBargainPrintMelissa
    $p = LCASE($HallMissingPromise)
    $c = LCASE($HallMissingClient)

    if $c = 'drunk_guest' or $c = 'drunk':
        pol_val = GirlWorkPolicy['melissa']
        HallMissingBargainRefused = 1
        *pl 'Захмелевший посетитель, покачиваясь на лавке, неуклюже тянется за край платья Мелиссы, пытаясь достать из замызганного кармана кривую монетку:'
        *pl '— Э-эй, кудрявая умница... Ик! Айда за шторку... Порадуй работягу за медяк, чё тебе, жалко, что ль...'
        *pl ' '
        if pol_val = 3:
            *pl 'Мелисса даже не вздрагивает — она выразительно закатывает глаза к потолочным балкам, надменно упирает руку в бок и одаривает пьянчугу взглядом строгой учительницы, оценивающей безнадежного неуча:'
            *pl '— Придержи свои хватательные рефлексы при себе, любезный, и немедленно отправляйся восвояси. Тебе на сегодня эля более чем достаточно. Окати свою хмельную голову студеной водой из колодца — твои ноги и язык заплетаются куда безнадежнее, чем шнуровка на моем корсаже. Проветри свои скудные мысли, пока Стефан не вышвырнул тебя за шиворот прямо в дорожную грязь!'
        else
            *pl 'Мелисса с неприкрытым отвращением морщит точеный носик, брезгливо отстраняется и точным, звонким щелчком по пальцам отбивает его тянущуюся пятерню:'
            *pl '— Убери руки, ходячее недоразумение! От тебя разит перегаром и дешевой сивухой на три сажени вокруг, рядом с тобой дышать тошно, не то что слушать твое нечленораздельное мычание. Ступай прочь и хорошенько проспись!'
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'noble' or $p = 'noble':
        if HallMissingBargainExplicit = 1:
            *pl 'Дворянин с властной небрежностью усаживает Мелиссу к себе на колени за полутемным столом в глубине зала. Его пальцы с фамильным перстнем медленно поднимаются по её бедру под тканью юбки, поглаживая шелковистую кожу. Он говорит негромко, надменно обжигая её висок дыханием:'
            *pl '— Ты — редкостное сокровище для этой захудалой дыры, Мелисса. Удивительное сочетание пытливого книжного ума и безупречной телесной стати. Но истинно образованная особа должна сознавать: в высшем свете, о признании которого ты грезишь, вкусы... весьма прихотливы и тонки. Истинная знать пресытилась пресной мещанской добродетелью. Нам потребны изысканные, порочные контрасты. Острый ум должен уметь вкусить экстаз от того, что серая толпа считает грехом. Готова ли ты доказать свою исключительность не только виршами?'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl 'Мелисса тонко и понимающе усмехается. Интеллектуальный вызов и прикосновение к тайным порокам столичной знати ничуть не пугают её — напротив, в её глазах вспыхивает холодный азарт превосходства. Она плавно подается вперед, опираясь ладонью о его плечо и неспешно расстегивая верхнюю филигранную пуговицу его камзола:'
                *pl '— Полноте, ваша светлость, оставьте эту напыщенную риторику для наивных провинциалок. Я прочла достаточно трактатов по философии и древней истории, чтобы понимать природу ваших «утонченных вкусов». Вы жаждете власти над острым умом точно так же, как простой мужлан жаждет женского тела. Что ж, пройдемте в тень кабинета. Я докажу вам, что простая трактирщица владеет искусством наслаждения куда тоньше, чем ваши чопорные столичные дамы. Но уговор: за этот урок вы заплатите сполна — чистым золотом на издание моих стихов.'
            end
        else
            *pl 'Дворянин, медленно покачивая кубок с выдержанным вином, преграждает Мелиссе дорогу у лестницы. Он свысока оглядывает её гордую осанку, осторожно касаясь кончиками пальцев её тонкого запястья:'
            *pl '— Помилуйте, прелестное создание, но тебе решительно не место среди этого неотесанного трактирного сброда! Ты — неограненный алмаз, затерянный в навозной куче. Я вижу по твоему одухотворенному лицу, что ты рождена для возвышенного. Скажи мне, правда ли молва доносит, будто ты доверяешь пергаменту прекрасные стихи? Умоляю, прочти мне пару строк в уединении, вдали от этой пьяной ярмарки!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl 'Мелисса с трудом сдерживает самодовольную улыбку — признание её поэтического дара благородным господином бьет точно в её тайную гордость. Её глаза оживляются, а надменный тон сменяется светской иронией:'
                *pl '— Надо же... Неужели среди посетителей трактира сыскался человек, способный отличить изящный гекзаметр от пьяных матросских куплетов? Да, я пишу, господин. И если у вас действительно есть слух для высокой поэзии — пройдемте в тихий уголок. Я прочту вам несколько строф, а вы докажете, что благородное происхождение обязывает быть щедрым меценатом.'
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'traveler' or $c = 'sailor':
        if HallMissingBargainExplicit = 1:
            *pl 'Загорелый моряк без лишних церемоний прихватывает Мелиссу за талию, бесцеремонно запуская широкую ладонь под подол её платья и крепко сминая упругую ягодицу:'
            *pl '— Будет тебе нос задирать да делать вид, будто перед тобой пустое место! Пошли за перегородку, девка. Мы в такой свирепый шторм у рифов попали — думал, на дно пойду неласканым! Слава Ильматеру всеблагому, вынесло на берег. А тут ты — чистое пламя!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— О, так ты воображаешь себя бесстрашным героем морской пучины? — Мелисса насмешливо приподнимает бровь, ничуть не теряясь от его наглой хватки. — Открою тебе простую житейскую истину: «неласканым» ты рискуешь остаться исключительно из-за своего развязного языка и неуместных рук. Мое внимание стоит куда дороже твоих морских баек.'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                    *pl '— Ха, с характером деваха, люблю норовистых! — ухмыляется моряк, не убирая ладони с её бедра. — В гавани божились, что в «Диком Жеребце» девчата за звонкое серебро и шторм утихомирят! На такой редкий приз я спинтриев жалеть не стану!'
                else
                    *pl '— Ха, с гонором краля, это по мне! — моряк притягивает её ближе. — Я едва душу морскому божеству не отдал, так что на ласку и звонкой монеты не пожалею, отсыплю горстью!'
                end
                *pl '— Спинтриев он не пожалеет... Надо же, какой щедрый мореплаватель, — Мелисса с легкой иронией опускает ладонь прямо на его тугой пах сквозь грубую ткань штанов, заставляя моряка шумно втянуть воздух сквозь зубы. — Что ж, смелость похвальная. Пойдем проверим, насколько твои подвиги соответствуют твоим морским россказням.'
            end
        else
            *pl 'Моряк преграждает Мелиссе дорогу у лестницы, не сводя глаз с волнующего выреза её платья:'
            *pl '— Слышь, русалочка! Чего ты с подносами по трактиру бегаешь, точно простая крестьянка? Всё плавание провел без женского тепла, из всей отрады была лишь деревянная дева на носу бригантины, а тут ты — и плоть у тебя, видит Ильматер, живая и сладкая! Пойдем, уважь моряка, напомни вкус настоящей ласки!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                if $HallMissingInitiative = 'high':
                    *pl '— Надо же, какой начитанный мореход к нам приплыл! — Мелисса насмешливо щурит глаза, сложив руки на груди. — Только учти, «капитан»: сирены заманивают беспечных мореплавателей на рифы и топят их суденышки без малейшей жалости. Уступи дорогу, пиво само по кружкам не разольется.'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                        *pl '— Брось комедию ломать, умница! В портовых тавернах говорят, что в «Диком Жеребце» девчата за полновесную монету творят чудеса!'
                    else
                        *pl '— Погоди с пивом! Пойдем в тишину подсобки, отсчитаю чистого серебра — такая умная дева мигом найдет ему достойное применение!'
                    end
                    *pl '— Твой напор даже забавен... Что ж, заходи за дверь. Покажу тебе, на что способна умная девушка, но помни: плата должна быть царской! — язвительно улыбается Мелисса и манит его в тень.'
                else
                    *pl '— Ваши познания в корабельной скульптуре и мифологии весьма обрывочны, любезный, — холодно замечает Мелисса, окидывая его взглядом с ног до головы. — На носу судов вырезают Галатей или нереид, а вовсе не то, что вам померещилось в хмельном угаре. Уберите локти и освободите проход, иначе вы на собственном опыте узнаете траекторию полета медного подноса. Уверяю, это куда менее приятно, чем женская ласка.'
                    if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                        *pl '— Экая колючая! В гавани прямо толкуют, что за щедрый куш ты сговорчивее шелковой ленты становишься!'
                    else
                        *pl '— Ух, злющая какая! Да не серчай, я же с монетой пришел. Пойдем, отсыплю серебра на твои ученые книги!'
                    end
                    *pl '— Серебро на книги?.. Что ж, ваша наглость уступает лишь вашей щедрости. Пройдемте в подсобку, раз уж вы так настойчивы, — вздыхает Мелисса и ступает в коридор.'
                end
            end
        end
        killvar '$p'
        killvar '$c'
        exit
    end

    if $c = 'craftsman' or $c = 'local':
        if HallMissingBargainExplicit = 1:
            *pl 'Местный плотник с тяжелыми, мозолистыми руками нагло перехватывает Мелиссу за талию у дверного косяка, бесцеремонно сжимая её ягодицу через ткань фартука:'
            *pl '— Будет тебе строить из себя городскую недотрогу! Я тебя с малых лет знаю, ты тут в трактире выросла, а гонору набралась, будто принцесса заморская! Пойдем в каморку, истосковался я по женской ласке, а ты девка — чистый огонь, глаз не отвести!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
            if HallMissingBargainOffenseAnswered = 0:
                *pl '— О, неужели наш слободской мастер решил заняться переписью чужих достоинств? — Мелисса, даже бровью не поведя, уверенно кладет ладонь прямо на его твердеющую промежность и с язвительной усмешкой смотрит прямо в глаза опешившему мужчине: — Руки побереги, ремесленник. Уединиться он надумал!'
                if TavernGirlsEasyRumor = 1 or TavernBackroomRumor = 1 or HallMissingSoftPlayDone['melissa'] = 1:
                    *pl '— Да брось ты притворяться неприступной! В ремесленных рядах мужики после второй кружки только и хвалят, какая ты сговорчивая, стоит лишь монетой звякнуть!'
                else
                    *pl '— Хех, какая хватка! — плотник крякает от удовольствия, продолжая по-хозяйски сжимать её бедро. — Я мужик мастеровой, заработок верный. За твою ласку я спинтриев не пожалею, насыплю от души!'
                end
                *pl '— Спинтриев насыплет... Какой щедрый цеховой мастер, — Мелисса с насмешливым прищуром плавно оглаживает его напрягшийся сквозь штаны ствол. — Раз уж твое мужское естество такое же крепкое, как дубовые доски в твоей мастерской, пойдем. Посмотрим, насколько ты ловок в деле.'
            end
        else
            *pl 'Мастеровой, покручивая в руках кружку, преграждает Мелиссе путь у лестницы, сально ухмыляясь в бороду:'
            *pl '— Куда летишь, краля ученая? Я матушку твою Сандру в её лучшие годы помню — мужикам головы кружила так, что щепки летели! А ты вся в её породу пошла — стать гордая, изгибы такие, что ни одним рубанком не выверить. Бросай свои миски, пойдем потолкуем по-соседски за дверью!'
            *pl ' '
            gs 'HallMissingBargainTryOffenseAnswer'
