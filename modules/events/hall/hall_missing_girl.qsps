! FILE: modules/events/hall/hall_missing_girl.qsps
! Пропажа девушки из зала с клиентом
! Версия: v1.1 / policy talk hook
! Назначение:
! - поздняя скандальная система для всех девушек трактира
! - девушка исчезает из зала с клиентом / у дальнего стола / в подсобке / на кухне
! - у игрока только 3 понятных выбора: ничего не делать / подсмотреть / ворваться
! - система картинок обязательна через ShowImage и debug-путь
! - после события даёт живой разговор о правилах, если подключён GirlWorkPolicyTalk
!
! Тексты берутся из:
! сцены: hall_missing_agent_*_text.qsps | уговор: hall_missing_bargain_text.qsps
!
! ВАЖНО:
! Это НЕ замена hall_harassment.
! hall_harassment = клиент грубо пристаёт, девушка против / терпит / отбивается.
! hall_missing_girl = поздняя скандальная ветка, когда девушка уже может сама
! использовать внимание клиентов ради чаевых и славы трактира.
! ================================================

#HallMissingGirlCanStart
    HallMissingGirlCanStart = 0
    $HallMissingGirlSelected = ''

    ! v2: missing только из play (α) — auto-roll с look/dispatcher выключен
    if LOC('HallSceneV2EnsureFlags') = 1:
        gs 'HallSceneV2EnsureFlags'
    end

    if HallMissingOnlyFromPlay = 1:
        exit
    end

    if FamilyLiberationGateOpen = 0:
        exit
    end

    if Act1MoralUnlocked = 0:
        exit
    end

    if FamilyCorruptionStage < 3:
        exit
    end

    if HallMissingGirlDisabled = 1:
        exit
    end

    if time = 5:
        exit
    end

    if week = 7:
        exit
    end

    if week = 5 and time = 4:
        exit
    end

    if HallMissingGirlLastGlobalDay = day and HallMissingGirlLastGlobalTime = time:
        exit
    end

    if LOC('IsTavernOpen') = 1:
        gs 'IsTavernOpen'

        if TavernOpen = 0:
            exit
        end
    end

    gs 'HallMissingGirlPickCandidate'

    if $HallMissingGirlSelected <> '':
        HallMissingGirlCanStart = 1
    end
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Попытка автозапуска
! ARGS[0] — куда возвращаться после события
! ================================================

#HallMissingGirlTryAutoStart
    $HallMissingReturnLoc = $ARGS[0]

    if $HallMissingReturnLoc = '':
        $HallMissingReturnLoc = 'TavernMain'
    end

    if LOC($HallMissingReturnLoc) = 0:
        $HallMissingReturnLoc = 'TavernMain'
    end

    gs 'HallMissingGirlCanStart'

    if HallMissingGirlCanStart = 1:
        gt 'HallMissingGirlStart', $HallMissingGirlSelected, $HallMissingReturnLoc
    end
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Подбор девушки-кандидата
! ================================================

#HallMissingGirlPickCandidate
    $HallMissingGirlSelected = ''
    HallMissingCandidateCount = 0

    gs 'HallMissingGirlCheckCandidate', 'amanda'
    gs 'HallMissingGirlCheckCandidate', 'melissa'
    gs 'HallMissingGirlCheckCandidate', 'sandra'

    if HallMissingCandidateCount <= 0:
        exit
    end

    HallMissingPick = RAND(1, HallMissingCandidateCount)
    $HallMissingGirlSelected = $HallMissingCandidate[HallMissingPick]

    killvar 'HallMissingPick'
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Проверка конкретной девушки
! ================================================

#HallMissingGirlCheckCandidate
    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $HallMissingCheckGirl = $HallMissingGirlKey

    if $HallMissingCheckGirl = '':
        exit
    end

    if HallMissingGirlLastDay[$HallMissingCheckGirl] = day:
        exit
    end

    ! Канон: сёстры — зал-пропажа; Сандра — только kitchen place (ниже)
    if $HallMissingCheckGirl <> 'amanda' and $HallMissingCheckGirl <> 'melissa' and $HallMissingCheckGirl <> 'sandra':
        exit
    end

    ! Personal gate: sisters slut>=35; Sandra slut>=38 or pol3+agr>=2
    HallMissingReady = 0

    if $HallMissingCheckGirl = 'sandra':
        if sluttiness[$HallMissingCheckGirl] >= 38:
            HallMissingReady = 1
        end

        if GirlWorkPolicy[$HallMissingCheckGirl] = 3 and GirlPolicyAgreement[$HallMissingCheckGirl] >= 2:
            HallMissingReady = 1
        end
    else:
        if sluttiness[$HallMissingCheckGirl] >= 35:
            HallMissingReady = 1
        end

        if GirlNpcPath[$HallMissingCheckGirl] >= 28:
            HallMissingReady = 1
        end

        if GirlWorkPolicy[$HallMissingCheckGirl] = 3 and GirlPolicyAgreement[$HallMissingCheckGirl] >= 2:
            HallMissingReady = 1
        end
    end

    if HallMissingReady = 0:
        killvar 'HallMissingReady'
        exit
    end

    killvar 'HallMissingReady'

    if GirlWorkPolicy[$HallMissingCheckGirl] = 3 and GirlPolicyAgreement[$HallMissingCheckGirl] <= 1 and sluttiness[$HallMissingCheckGirl] < 35:
        exit
    end

    gs 'HallMissingGirlGetStage', $HallMissingCheckGirl

    if HallMissingGirlStage < 3:
        exit
    end

    if TavernScandal < 18 and TavernLewdFame < 8 and GirlWorkPolicy[$HallMissingCheckGirl] <> 3:
        exit
    end

    HallMissingCandidateChance = 10

    if HallMissingGirlStage >= 4:
        HallMissingCandidateChance = 22
    end

    if GirlWorkPolicy[$HallMissingCheckGirl] = 3:
        if GirlPolicyAgreement[$HallMissingCheckGirl] >= 2:
            HallMissingCandidateChance += 12
        else:
            HallMissingCandidateChance += 2
        end
    elseif GirlWorkPolicy[$HallMissingCheckGirl] = 1:
        HallMissingCandidateChance -= 18
    end

    if GirlUniformLevel[$HallMissingCheckGirl] = 1:
        HallMissingCandidateChance += 10
    end

    if HallMissingCandidateChance < 5:
        HallMissingCandidateChance = 5
    end

    if HallMissingCandidateChance > 80:
        HallMissingCandidateChance = 80
    end

    if RAND(1, 100) <= HallMissingCandidateChance:
        HallMissingCandidateCount += 1
        $HallMissingCandidate[HallMissingCandidateCount] = $HallMissingCheckGirl
    end

    killvar '$HallMissingCheckGirl'
    killvar 'HallMissingCandidateChance'
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Нормализация ключа девушки
! ================================================

#HallMissingGirlNormalizeKey
    if LOC('NormalizeGirlKey') = 1:
        gs 'NormalizeGirlKey', $ARGS[0]
        $HallMissingGirlKey = $GirlKey
    else:
        $HallMissingGirlKey = LCASE($ARGS[0])
    end

    if $HallMissingGirlKey <> 'amanda' and $HallMissingGirlKey <> 'melissa' and $HallMissingGirlKey <> 'sandra':
        $HallMissingGirlKey = ''
    end
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Имя девушки
! ================================================

#HallMissingGirlEnsureName
    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $HallMissingNameGirl = $HallMissingGirlKey

    if $RealName[$HallMissingNameGirl] = '':
        if $HallMissingNameGirl = 'amanda':
            $RealName[$HallMissingNameGirl] = 'Аманда'
        elseif $HallMissingNameGirl = 'melissa':
            $RealName[$HallMissingNameGirl] = 'Мелисса'
        elseif $HallMissingNameGirl = 'sandra':
            $RealName[$HallMissingNameGirl] = 'Сандра'
        else:
            $RealName[$HallMissingNameGirl] = $HallMissingNameGirl
        end
    end

    killvar '$HallMissingNameGirl'
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Расчёт стадии скандального поведения девушки в зале
! ================================================

#HallMissingGirlGetStage
    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $HallMissingStageGirl = $HallMissingGirlKey

    HallMissingGirlStage = 0
    HallMissingGirlScore = 0

    if $HallMissingStageGirl = '':
        exit
    end

    HallMissingGirlScore += TavernScandal / 2
    HallMissingGirlScore += TavernLewdFame / 2
    HallMissingGirlScore += TavernGirlsEasyRumor * 4
    if TavernBackroomRumor = 1:
        HallMissingGirlScore += 8
    end

    if GirlHallLewdStage[$HallMissingStageGirl] < 0:
        GirlHallLewdStage[$HallMissingStageGirl] = 0
    end

    if GirlHallLewdStage[$HallMissingStageGirl] > 4:
        GirlHallLewdStage[$HallMissingStageGirl] = 4
    end

    HallMissingGirlScore += GirlHallLewdStage[$HallMissingStageGirl] * 8
    HallMissingGirlScore += GirlPublicAttention[$HallMissingStageGirl] / 2
    HallMissingGirlScore += GirlNpcPath[$HallMissingStageGirl] / 2
    HallMissingGirlScore += GirlSecretiveness[$HallMissingStageGirl] / 2
    HallMissingGirlScore += GirlRebellion[$HallMissingStageGirl] / 2
    HallMissingGirlScore += sluttiness[$HallMissingStageGirl] / 2

    if GirlUniformLevel[$HallMissingStageGirl] > 1:
        GirlUniformLevel[$HallMissingStageGirl] = 1
    end

    if GirlUniformLevel[$HallMissingStageGirl] < 0:
        GirlUniformLevel[$HallMissingStageGirl] = 0
    end

    if GirlUniformLevel[$HallMissingStageGirl] = 1:
        HallMissingGirlScore += 10
    end

    if GirlWorkPolicy[$HallMissingStageGirl] = 1:
        HallMissingGirlScore -= 18
    elseif GirlWorkPolicy[$HallMissingStageGirl] = 2:
        HallMissingGirlScore += 4
    elseif GirlWorkPolicy[$HallMissingStageGirl] = 3:
        if GirlPolicyAgreement[$HallMissingStageGirl] >= 2:
            HallMissingGirlScore += 16
        else:
            HallMissingGirlScore += 3
        end
    end

    if $HallMissingStageGirl = 'amanda':
        HallMissingGirlScore += AmandaScandalLevel / 2

        if uniform_purchased['amanda'] = 1 or revealing_uniform_worn = 1:
            GirlUniformLevel['amanda'] = 1
        end
    elseif $HallMissingStageGirl = 'melissa':
        HallMissingGirlScore += MelissaScandalTolerance / 2
        HallMissingGirlScore += MelissaJealousy / 3

        if uniform_purchased['melissa'] = 1 or revealing_uniform_worn = 1:
            GirlUniformLevel['melissa'] = 1
        end
    elseif $HallMissingStageGirl = 'sandra':
        HallMissingGirlScore += SandraPragmatism / 3
        HallMissingGirlScore -= SandraMoralResistance / 2

        if uniform_purchased['sandra'] = 1 or revealing_uniform_worn = 1:
            GirlUniformLevel['sandra'] = 1
        end
    end

    if HallMissingGirlScore < 0:
        HallMissingGirlScore = 0
    end

    if HallMissingGirlScore < 50:
        HallMissingGirlStage = 0
    elseif HallMissingGirlScore < 80:
        HallMissingGirlStage = 1
    elseif HallMissingGirlScore < 110:
        HallMissingGirlStage = 2
    elseif HallMissingGirlScore < 145:
        HallMissingGirlStage = 3
    else:
        HallMissingGirlStage = 4
    end

    ! Не перезаписываем GirlHallLewdStage вычисленным score

    killvar '$HallMissingStageGirl'
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Выбор места пропажи
! ================================================

#HallMissingGirlPickPlace
    ! Сандра — только kitchen. Сёстры — under_table / storage / stairs (без kitchen, без 2nd floor).
    $HallMissingPlace = 'storage'
    HallMissingPlaceRoll = RAND(1, 100)

    if $HallMissingGirl = 'sandra':
        $HallMissingPlace = 'kitchen'
        killvar 'HallMissingPlaceRoll'
        exit
    end

    if HallMissingGirlStage >= 4 and HallMissingPlaceRoll <= 30:
        $HallMissingPlace = 'under_table'
    elseif HallMissingPlaceRoll <= 55:
        $HallMissingPlace = 'storage'
    elseif HallMissingPlaceRoll <= 80:
        $HallMissingPlace = 'stairs'
    else:
        $HallMissingPlace = 'under_table'
    end

    killvar 'HallMissingPlaceRoll'
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Выбор типа клиента
! ================================================

#HallMissingGirlPickClient
    HallMissingClientRoll = RAND(1, 100)

    if HallMissingClientRoll <= 35:
        $HallMissingClient = 'drunk_guest'
    elseif HallMissingClientRoll <= 65:
        $HallMissingClient = 'rich_merchant'
    elseif HallMissingClientRoll <= 85:
        $HallMissingClient = 'craftsman'
    else:
        $HallMissingClient = 'traveler'
    end

    killvar 'HallMissingClientRoll'
    gs 'HallMissingApplyClientFlavorTags'
---

! Метки типажа для prose / free-bias (канон Сандра + общие client flavor):
! traveler/sailor  — hand, большой член
! rich_merchant    — mouth, толстый член, finish cum_mouth
! craftsman/local  — facial, обильный finish cum_face
! drunk_guest      — без favor (уговор срывается)
#HallMissingApplyClientFlavorTags
    $c = LCASE($HallMissingClient)
    $HallMissingClientCock = ''
    $HallMissingClientPreferAct = ''
    $HallMissingClientPreferFinish = ''
    HallMissingClientCumHeavy = 0

    if $c = 'traveler' or $c = 'sailor':
        $HallMissingClientCock = 'big'
        $HallMissingClientPreferAct = 'hand'
        $HallMissingClientPreferFinish = 'hand'
        HallMissingClientCumHeavy = 0
    elseif $c = 'rich_merchant' or $c = 'merchant':
        $HallMissingClientCock = 'thick'
        $HallMissingClientPreferAct = 'mouth'
        $HallMissingClientPreferFinish = 'cum_mouth'
        HallMissingClientCumHeavy = 0
    elseif $c = 'craftsman' or $c = 'local':
        $HallMissingClientCock = 'average'
        $HallMissingClientPreferAct = 'facial'
        $HallMissingClientPreferFinish = 'cum_face'
        HallMissingClientCumHeavy = 1
    elseif $c = 'drunk_guest':
        $HallMissingClientCock = ''
        $HallMissingClientPreferAct = ''
        $HallMissingClientPreferFinish = ''
        HallMissingClientCumHeavy = 0
    else
        $HallMissingClientCock = 'average'
        $HallMissingClientPreferAct = ''
        $HallMissingClientPreferFinish = ''
        HallMissingClientCumHeavy = 0
    end

    killvar '$c'
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Выбор приватного действия
! ================================================

#HallMissingGirlPickPrivateAct
    ! early: petting/tits/pussy/cock_touch
    ! mid: hand, mouth, cuni (+titjob Sandra)
    ! late: mouth_balls, deepthroat, anilingus
    ! без room_invite / second_floor
    $HallMissingPrivateAct = 'petting'
    HallMissingPrivateActRoll = RAND(1, 100)
    HallMissingActBand = 1

    if HallMissingGirlStage >= 4 and (HallMissingGirlPrivateCount[$HallMissingGirl] >= 2 or GirlHallLewdStage[$HallMissingGirl] >= 3):
        HallMissingActBand = 3
    elseif HallMissingGirlStage >= 4 or HallMissingGirlPrivateCount[$HallMissingGirl] >= 1:
        HallMissingActBand = 2
    end

    if HallMissingActBand = 1:
        if HallMissingPrivateActRoll <= 25:
            $HallMissingPrivateAct = 'hug_waist'
        elseif HallMissingPrivateActRoll <= 45:
            $HallMissingPrivateAct = 'look_tits'
        elseif HallMissingPrivateActRoll <= 65:
            $HallMissingPrivateAct = 'hug_waist'
        elseif HallMissingPrivateActRoll <= 85:
            $HallMissingPrivateAct = 'cock_touch'
        else:
            $HallMissingPrivateAct = 'hand'
        end
    elseif HallMissingActBand = 2:
        if $HallMissingGirl = 'sandra' and HallMissingPrivateActRoll <= 25:
            $HallMissingPrivateAct = 'titjob'
        elseif HallMissingPrivateActRoll <= 40:
            $HallMissingPrivateAct = 'hand'
        elseif HallMissingPrivateActRoll <= 70:
            $HallMissingPrivateAct = 'mouth'
        else:
            $HallMissingPrivateAct = 'cuni'
        end
    else:
        if HallMissingPrivateActRoll <= 30:
            $HallMissingPrivateAct = 'mouth_balls'
        elseif HallMissingPrivateActRoll <= 55:
            $HallMissingPrivateAct = 'deepthroat'
        elseif HallMissingPrivateActRoll <= 80:
            if $HallMissingGirl = 'sandra':
                $HallMissingPrivateAct = 'cuni'
            else
                $HallMissingPrivateAct = 'anilingus'
            end
        elseif $HallMissingGirl = 'sandra' and HallMissingPrivateActRoll <= 92:
            $HallMissingPrivateAct = 'titjob'
        else:
            $HallMissingPrivateAct = 'cuni'
        end
    end

    killvar 'HallMissingPrivateActRoll'
    killvar 'HallMissingActBand'
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Вход в событие
! ================================================

#HallMissingGirlStart
    *clr
    clr
    cla

    gs 'HallMissingGirlNormalizeKey', $ARGS[0]
    $HallMissingGirl = $HallMissingGirlKey
    $HallMissingReturnLoc = $ARGS[1]

    if $HallMissingGirl = '' and LOC($ARGS[0]) = 1:
        $HallMissingReturnLoc = $ARGS[0]
    end

    if $HallMissingReturnLoc = '':
        $HallMissingReturnLoc = 'TavernMain'
    end

    if LOC($HallMissingReturnLoc) = 0:
        $HallMissingReturnLoc = 'TavernMain'
    end

    if FamilyLiberationGateOpen = 0 or Act1MoralUnlocked = 0 or FamilyCorruptionStage < 3:
        gt $HallMissingReturnLoc
    end

    if $HallMissingGirl = '':
        gs 'HallMissingGirlPickCandidate'
        $HallMissingGirl = $HallMissingGirlSelected
    else:
        HallMissingCandidateCount = 0
        gs 'HallMissingGirlCheckCandidate', $HallMissingGirl

        if HallMissingCandidateCount <= 0:
            $HallMissingGirl = ''
        end
    end

    if $HallMissingGirl = '':
        gt $HallMissingReturnLoc
    end

    HallMissingCuniToAnilingus = 0
    gs 'HallMissingGirlEnsureName', $HallMissingGirl
    gs 'HallMissingGirlGetStage', $HallMissingGirl

    ! v0.16: always через уговор+phase (единый вход)
    if LOC('HallMissingBargainStart') = 1 and HallMissingBargainSkip = 0:
        gt 'HallMissingBargainStart', $HallMissingGirl, $HallMissingReturnLoc
    end

    if LOC('HallMissingPhaseEnsure') = 1:
        gs 'HallMissingPhaseEnsure', $HallMissingGirl
    end
    gs 'HallMissingGirlPickPlace'
    if $HallMissingClient = '':
        gs 'HallMissingGirlPickClient'
    end
    if LOC('HallMissingBargainPickPromise') = 1 and LOC('HallMissingApplyPromiseToAct') = 1:
        gs 'HallMissingBargainIsExplicit'
        gs 'HallMissingBargainPickStyle'
        gs 'HallMissingBargainPickPromise'
        gs 'HallMissingApplyPromiseToAct'
        HallMissingBargainDone = 1
    else
        gs 'HallMissingGirlPickPrivateAct'
    end

    HallMissingUniform = GirlUniformLevel[$HallMissingGirl]

    if HallMissingUniform > 1:
        HallMissingUniform = 1
    end

    if HallMissingUniform < 0:
        HallMissingUniform = 0
    end

    HallMissingGirlLastGlobalDay = day
    HallMissingGirlLastGlobalTime = time
    HallMissingGirlLastDay[$HallMissingGirl] = day
    HallMissingGirlActive = 1

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $HallMissingGirl
    end

    gs 'HallMissingPrintHeader'
    *pl ' '
    if HallMissingBargainDone = 1:
        gs 'HallMissingGirlShowImage', 'intro'
        gs 'HallMissingPrintAfterBargain'
    else
        gs 'HallMissingGirlPrintText', 'intro'
        *pl ' '
        if LOC('PolicyEventContextPrintStart') = 1:
            gs 'PolicyEventContextPrintStart', $HallMissingGirl, 'hall_missing'
            *pl ' '
        end
        if LOC('PolicyEventReactionPrint') = 1:
            if $HallMissingReturnLoc = '':
                $HallMissingReturnLoc = 'TavernMain'
            end
            gs 'PolicyEventReactionPrint', $HallMissingGirl, 'hall', 'hall_missing', $HallMissingReturnLoc
            *pl ' '
        end
        if LOC('PolicyEventSceneVariationPrint') = 1:
            gs 'PolicyEventSceneVariationPrint', $HallMissingGirl, 'hall_missing', 'start'
            *pl ' '
        end
        gs 'HallMissingGirlPrintDecisionThoughts'
    end

    *pl ' '

    if debug = 1:
        gs 'PolicyEventDebugPrintStart', 'HALL MISSING', $HallMissingGirl, HallMissingGirlStage, HallMissingGirlScore, 'place', $HallMissingPlace, $HallMissingClient, HallMissingUniform, GirlWorkPolicy[$HallMissingGirl]
        *pl '[DEBUG HALL MISSING] act: ' + $HallMissingPrivateAct
    end

    gs 'HallMissingGirlBuildMenu'

    *p 'Что делать <a href="exec:gs ''Menu.Show'', ''HallMissingGirlMenu''">Стефану</a>?'
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Меню выбора
! ================================================


! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Мысли Стефана перед выбором
! ================================================

#HallMissingGirlPrintDecisionThoughts
    gs 'HallEventChoiceThoughtsPrint', 'hall_missing'
---

#HallMissingPrintHeader
    *pl '══════════════════════════════════════════════'
    if $HallMissingGirl = 'sandra' or $HallMissingPlace = 'kitchen':
        *pl ' НА КУХНЕ'
    else
        *pl ' ДЕВУШКА ПРОПАЛА ИЗ ЗАЛА'
    end
    *pl '══════════════════════════════════════════════'
---

! после одного уговора: не повторять вход / «уговаривает её…»
#HallMissingPrintAfterBargain
    if $HallMissingGirl = 'sandra':
        *pl 'Вы остаётесь у кухонной двери. Уговор уже слышали. Дальше — смотреть в щель, ворваться или отойти к стойке.'
    else
        *pl 'Они уже отошли в полумрак. Вы у двери подсобки. Дальше — заглянуть, ворваться или вернуться к стойке.'
    end
---

#HallMissingGirlBuildMenu
    ! Канон §0c: Защитить / Наблюдать / Отвернуться
    ! (interrupt / peek / ignore → protect_hard / watch / ignore)
    gs 'Menu.Destroy', 'HallMissingGirlMenu'
    gs 'Menu.Create', 'HallMissingGirlMenu'

    gs 'MenuUiAdd', 'HallMissingGirlMenu', 'Защитить', ''
    gs 'Menu.AddModule', 'HallMissingGirlMenu', {
        gt 'HallMissingGirlResolve', 'protect_hard', $HallMissingReturnLoc
    }

    if FamilyLiberationGateOpen = 1:
        gs 'MenuUiAdd', 'HallMissingGirlMenu', 'Смотреть', ''
        gs 'Menu.AddModule', 'HallMissingGirlMenu', {
            gt 'HallMissingGirlResolve', 'watch', $HallMissingReturnLoc
        }

        gs 'MenuUiAdd', 'HallMissingGirlMenu', 'Отвернуться', ''
        gs 'Menu.AddModule', 'HallMissingGirlMenu', {
            gt 'HallMissingGirlResolve', 'ignore', $HallMissingReturnLoc
        }
    end
---

! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Разрешение события
! ================================================

#HallMissingGirlResolve
    *clr
    clr
    cla

    $HallMissingChoice = LCASE($ARGS[0])
    $HallMissingReturnLoc = $ARGS[1]

    if $HallMissingReturnLoc = '':
        $HallMissingReturnLoc = 'TavernMain'
    end

    if LOC($HallMissingReturnLoc) = 0:
        $HallMissingReturnLoc = 'TavernMain'
    end

    gs 'HallMissingGirlNormalizeKey', $HallMissingGirl
    $HallMissingGirl = $HallMissingGirlKey

    if $HallMissingGirl = '':
        gs 'HallMissingGirlPickCandidate'
        $HallMissingGirl = $HallMissingGirlSelected
    end

    if $HallMissingGirl = '':
        gt $HallMissingReturnLoc
    end

    gs 'HallMissingGirlEnsureName', $HallMissingGirl

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $HallMissingGirl
    end

    HallMissingGirlActive = 0
    HallMissingGirlLastChoice[$HallMissingGirl] = 0

    gs 'HallMissingPrintHeader'
    *pl ' '

    if $HallMissingChoice = 'interrupt':
        $HallMissingChoice = 'protect_hard'
    elseif $HallMissingChoice = 'peek':
        $HallMissingChoice = 'watch'
    end

    if FamilyLiberationGateOpen = 0:
        $HallMissingChoice = 'protect_hard'
    end

    if $HallMissingChoice = 'ignore':
        HallMissingGirlLastChoice[$HallMissingGirl] = 1
        gs 'HallMissingGirlApplyConsequences', 'ignore'
        gs 'HallMissingGirlPrintText', 'ignore_after'
        *pl ' '
        gs 'PolicyEventChoiceConsequencePrint', 'hall_missing', 'ignore', $HallMissingGirl
        if LOC('SaveLastHallEvent') = 1:
            gs 'SaveLastHallEvent', 'hall_missing', $HallMissingGirl, 'Стефан не стал смотреть, когда ' + $RealName[$HallMissingGirl] + ' была с клиентом.', 'ignore'
        end
        if debug = 1:
            *pl ' '
            *pl '[DEBUG HALL MISSING] choice: ignore'
        end
        $HallScenePolicySource = ''
        HallHarassPolicyChosen = 0
        HallHarassPolicyValue = 0
        HallMissingFromPlay = 0
        gs 'ActUiPrepare', 'Вернуться в зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $HallMissingReturnLoc
        end
        exit

    elseif $HallMissingChoice = 'watch':
        HallMissingGirlLastChoice[$HallMissingGirl] = 2
        gs 'HallMissingGirlApplyConsequences', 'peek'
        gs 'HallMissingScenePageInit'
        gt 'HallMissingGirlShowScene'

    elseif $HallMissingChoice = 'protect_hard':
        HallMissingGirlLastChoice[$HallMissingGirl] = 3
        gs 'HallMissingGirlApplyConsequences', 'interrupt'
        gs 'HallMissingGirlPrintText', 'interrupt_scene'
        *pl ' '
        gs 'ActUiPrepare', 'Далее', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'HallMissingGirlMeet'
        end
        exit

    else:
        $HallMissingChoice = 'protect_hard'
        HallMissingGirlLastChoice[$HallMissingGirl] = 3
        gs 'HallMissingGirlApplyConsequences', 'interrupt'
