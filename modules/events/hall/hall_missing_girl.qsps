! ================================================
! FILE: modules/events/hall/hall_missing_girl.qsps
! Показ картинки
! ================================================

#HallMissingGirlShowImage
    $HallMissingImageOutcome = LCASE($ARGS[0])

    if $HallMissingImageOutcome = '':
        $HallMissingImageOutcome = 'after'
    end

    if $HallMissingGirl = '':
        $HallMissingGirl = 'amanda'
    end

    if $HallMissingPlace = '':
        if $HallMissingGirl = 'sandra':
            $HallMissingPlace = 'kitchen'
        else
            $HallMissingPlace = 'storage'
        end
    end

    HallMissingUniform = GirlUniformLevel[$HallMissingGirl]

    if HallMissingUniform > 1:
        HallMissingUniform = 1
    end

    if HallMissingUniform < 0:
        HallMissingUniform = 0
    end

    $HallMissingStubPath = 'images/common/hall_scene_stub'

    if $HallMissingImageOutcome = 'bargain':
        if $HallMissingGirl = 'sandra':
            $HallMissingBargainArea = 'kitchen'
        else
            $HallMissingBargainArea = 'hall'
        end
        $HallMissingFuturePath = 'images/events/' + $HallMissingGirl + '/hall_missing/bargain_' + $HallMissingBargainArea + '_uniform' + STR(HallMissingUniform)
        killvar '$HallMissingBargainArea'
    elseif $HallMissingImageOutcome = 'intro':
        $HallMissingFuturePath = 'images/events/' + $HallMissingGirl + '/hall_missing/' + $HallMissingPlace + '_uniform' + STR(HallMissingUniform) + '_intro'
    elseif $HallMissingImageOutcome = 'scene' or $HallMissingImageOutcome = 'peek':
        ! scene key: act + finish hint
        $hmAct = LCASE($HallMissingPrivateAct)
        if $hmAct = '':
            $hmAct = 'petting'
        end
        $HallMissingFuturePath = 'images/events/' + $HallMissingGirl + '/hall_missing/' + $HallMissingPlace + '/' + $hmAct + '_u' + STR(HallMissingUniform)
        if $HallMissingFinish <> '':
            $HallMissingFuturePath = $HallMissingFuturePath + '_' + LCASE($HallMissingFinish)
        end
        killvar '$hmAct'
    else
        $HallMissingFuturePath = 'images/events/' + $HallMissingGirl + '/hall_missing/' + $HallMissingPlace + '_uniform' + STR(HallMissingUniform) + '_' + $HallMissingImageOutcome
    end

    ! канон: нет пустых экранов + подпись ассета (AGENTS / SceneShowVisual)
    $HallMissingImageCaption = 'missing ' + $HallMissingGirl + ' / ' + $HallMissingPlace + ' / ' + $HallMissingImageOutcome
    if $HallMissingPrivateAct <> '':
        $HallMissingImageCaption = $HallMissingImageCaption + ' act=' + $HallMissingPrivateAct
    end
    if $HallMissingFinish <> '':
        $HallMissingImageCaption = $HallMissingImageCaption + ' finish=' + $HallMissingFinish
    end

    if HallMissingArtUseReal = 1:
        SceneArtUseReal = 1
    end
    if LOC('SceneShowVisual') = 1:
        gs 'SceneShowVisual', $HallMissingFuturePath, $HallMissingImageCaption, 'large', 'webp'
    elseif LOC('ShowImage') = 1:
        gs 'ShowImage', 'common', '', 'hall_scene_stub', '', 'png', 'large'
        *pl '<center><small>[VIS] ' + $HallMissingImageCaption + '</small></center>'
        *pl ' '
    end

    killvar '$HallMissingImageOutcome'
    killvar '$HallMissingStubPath'
    killvar '$HallMissingFuturePath'
    killvar '$HallMissingImageCaption'
