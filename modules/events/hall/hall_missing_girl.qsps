    end

    HallMissingUniform = GirlUniformLevel[$HallMissingGirl]

    if HallMissingUniform > 1:
        HallMissingUniform = 1
    end

    if HallMissingUniform < 0:
        HallMissingUniform = 0
    end

    $HallMissingStubPath = 'images/common/hall_scene_stub.png'

    if $HallMissingImageOutcome = 'bargain':
        if $HallMissingGirl = 'sandra':
            $HallMissingBargainArea = 'kitchen'
        else
            $HallMissingBargainArea = 'hall'
        end
        $HallMissingFuturePath = 'images/events/' + $HallMissingGirl + '/hall_missing/bargain_' + $HallMissingBargainArea + '_uniform' + STR(HallMissingUniform) + '.webp'
        killvar '$HallMissingBargainArea'
    else
        $HallMissingFuturePath = 'images/events/' + $HallMissingGirl + '/hall_missing/' + $HallMissingPlace + '_uniform' + STR(HallMissingUniform) + '_' + $HallMissingImageOutcome + '.webp'
    end

    if LOC('ShowImage') = 1:
        gs 'ShowImage', 'common', '', 'hall_scene_stub', '', 'png', 'small'
    end

    if debug = 1:
        *pl '[DEBUG HALL MISSING IMAGE] stub: ' + $HallMissingStubPath
        *pl '[DEBUG HALL MISSING IMAGE] future: ' + $HallMissingFuturePath
        *pl '[DEBUG HALL MISSING IMAGE] place=' + $HallMissingPlace + ' act=' + $HallMissingPrivateAct + ' outcome=' + $HallMissingImageOutcome
        *pl ' '
    end

    killvar '$HallMissingImageOutcome'
    killvar '$HallMissingStubPath'
    killvar '$HallMissingFuturePath'
