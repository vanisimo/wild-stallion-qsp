! ================================================
! FILE: modules/events/hall/hall_harassment_text.qsps
! MODULE: events/hall
! After / policy / hall-reaction / talk-recall (intro — hall_harassment_intro_text)
! Структура: protect / watch / ignore × girl × early|late
! Late (stance mixed/provoke, stage≥3, slut≥40): терпеливее, меньше злости
! Зал: Аманда/Мелисса. Кухня: Сандра.
! Не USER-OWNED
! ================================================

#HallHarassmentPrintText
    gs 'HallHarassmentText', $ARGS[0]

    if $HallHarassmentText <> '':
        *pl $HallHarassmentText
    end
---

#HallHarassmentTextLateFlag
    ! 1 = поздний тон (терпеливее / менее «я сама ударю»)
    HallHarassmentTextLate = 0

    if $HallHarassGirl = '':
        exit
    end

    if $HarassGirlStance = 'provoke' or $HarassGirlStance = 'mixed':
        HallHarassmentTextLate = 1
    elseif FamilyCorruptionStage >= 3:
        HallHarassmentTextLate = 1
    elseif sluttiness[$HallHarassGirl] >= 40:
        HallHarassmentTextLate = 1
    end
---

#HallHarassmentText
    $HallHarassmentTextId = LCASE($ARGS[0])
    $HallHarassmentText = ''

    gs 'HallHarassmentTextLateFlag'

    ! ---------- служебные ----------
    if $HallHarassmentTextId = 'no_repeat':
        $HallHarassmentText = 'После недавнего шума зал ведёт себя осторожнее. Девушки работают настороженнее обычного.'
    elseif $HallHarassmentTextId = 'closed':
        $HallHarassmentText = 'Сейчас таверна закрыта. В зале пусто — приставать некому.'
    elseif $HallHarassmentTextId = 'no_girl':
        $HallHarassmentText = 'Вы смотрите зал. Ничего особенного: гости пьют, девушки не попадают под руки.'
    elseif $HallHarassmentTextId = 'choice_prompt':
        $HallHarassmentText = 'Зал уже смотрит. Клиент перешёл черту — дальше решать хозяину.'

    ! ---------- policy (перед/после, контекст) ----------
    elseif $HallHarassmentTextId = 'policy_none':
        $HallHarassmentText = 'Чёткого правила вы ей не давали. Она смотрит и на гостя, и на вас: вмешается хозяин или снова оставит на её догадку?'
    elseif $HallHarassmentTextId = 'policy_decent':
        $HallHarassmentText = 'Она помнит: сдержанно, звать хозяина, если распускают руки. Но правило — одно, а зал уже смотрит.'
    elseif $HallHarassmentTextId = 'policy_own':
        $HallHarassmentText = 'Вы сказали решать самой. Теперь это не слова: клиент проверяет её границы, зал — вашу выдержку.'
    elseif $HallHarassmentTextId = 'policy_profit':
        $HallHarassmentText = 'Она помнит: улыбка, ручка, чаевые — раскованнее, не на колени. Сейчас грань проверяют уже лапами.'

    ! ---------- first amanda (ещё вызывается из Intro) ----------
    elseif $HallHarassmentTextId = 'amanda_first_intro':
        $HallHarassmentText = 'Аманда несёт поднос к дальнему столу. Пьяный мастеровой ловит её за запястье и тянет ближе. Она замирает, краснеет, пытается вырвать руку: «Отпустите… пожалуйста.»'

    ! ---------- resolve: protect ----------
    elseif $HallHarassmentTextId = 'protect_hard_success':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Вы подходите ровно, без крика. Гость убирает руки, бормочет про шутку. Мелисса поправляет фартук и коротко кивает: «Ладно. Спасибо. Но я бы и сама…» — без злости, скорее привычка.'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Вы ставите гостя на место. Сандра вытирает руки о фартук: «Вовремя. Только не делай из меня фарфоровую куклу каждый раз.»'
            else:
                $HallHarassmentText = 'Вы вмешиваетесь спокойно, но твёрдо. Гость отступает. Аманда выдыхает, щёки ещё розовые: «Спасибо… что не дал продолжить.»'
            end
        else:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Вы резко, по-хозяйски, обрываете сцену. Мелисса смотрит на гостя, потом на вас: «Спасибо. Хотя я уже почти…» — и криво усмехается.'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Вы выгоняете наглеца с кухни/зала. Сандра кивает тяжело: «Спасибо. Здесь чужих лап не держат.»'
            else:
                $HallHarassmentText = 'Вы подходите так, что стол понимает: шутка кончилась. Аманда переводит дыхание: «Спасибо… что не дал ему продолжить.»'
            end
        end

    elseif $HallHarassmentTextId = 'protect_hard_dislike':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Гость отступает, но Мелисса смотрит на вас чуть устало: «Я уже почти сама. Не надо каждый раз, будто я без рук.» Без крика — скорее привычка к независимости.'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра кивает на уходящего гостя: «Спасибо. Но я не фарфор. Иногда дай мне самой.»'
            else:
                $HallHarassmentText = 'Аманда благодарит тихо, но мнётся: «Спасибо… только я уже могла сама. Не всегда надо… так сразу.»'
            end
        else:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Клиент отступает. Мелисса смотрит раздражённо: «Я сама могла. Не делай вид, будто я беспомощная.»'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра хмурится: «Спасибо. Но я не ребёнок. Иногда хватит и моего слова.»'
            else:
                $HallHarassmentText = 'Аманда смотрит не с благодарностью, а с досадой: «Я сама могла… Не надо каждый раз, будто я не справлюсь.»'
            end
        end

    elseif $HallHarassmentTextId = 'protect_hard_fail':
        $HallHarassmentText = 'Вы вмешиваетесь резко — клиент шумит, часть зала ворчит. Порядок всё же восстановлен, но осадок остался.'

    elseif $HallHarassmentTextId = 'warn_client_success':
        $HallHarassmentText = 'Вы спокойно предупреждаете клиента — не громко, но так, чтобы соседние столы услышали. Он убирает руки: «Ладно… пошутил.»'
    elseif $HallHarassmentTextId = 'warn_client_fail':
        $HallHarassmentText = 'Спокойно не выходит: клиент пьян и уверен. Спор громче, чем хотелось. Он отступает — зал запоминает шум.'

    ! ---------- resolve: self / profit (legacy ids) ----------
    elseif $HallHarassmentTextId = 'self_handle_success':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы даёте ей взглядом: решай. ' + $RealName[$HallHarassGirl] + ' выходит из сцены сама — твёрдо, без истерики. «Я справилась.»'
        else:
            $HallHarassmentText = 'Вы не лезете сразу. ' + $RealName[$HallHarassGirl] + ' справляется — не идеально, но достаточно. «Я… я сама. Правда.»'
        end
    elseif $HallHarassmentTextId = 'self_handle_bad':
        $HallHarassmentText = 'Вы ждёте, что она справится. Она выбирается, но взгляд ищет вас: «Почему ты молчал?»'
    elseif $HallHarassmentTextId = 'profit_high':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы не мешаете. Гость дозаказывает, монеты звенят, ' + $RealName[$HallHarassGirl] + ' держит грань. Потом коротко: «Заплатил… ладно.» Без радости, но и без слёз.'
        else:
            $HallHarassmentText = 'Вы не мешаете. Гость дозаказывает, зал оживляется. «Зато он заплатил… правда?» — в голосе нет радости.'
        end
    elseif $HallHarassmentTextId = 'profit_low':
        $HallHarassmentText = 'Вы делаете вид, что не заметили. ' + $RealName[$HallHarassGirl] + ' выбирается сама, поздно и одна. «Я справилась. Но мне было неприятно, что ты отвернулся.»'

    ! ---------- resolve: watch ----------
    elseif $HallHarassmentTextId = 'watch_calm':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Вы стоите и смотрите. Мелисса сама обрывает гостя — холодно, без крика. Взгляд на вас: «Видел. Хорошо, что хотя бы видел.»'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Вы в проходе. Сандра ставит гостя на место сама. Короткий кивок: «Справилась. Ты видел — и ладно.»'
            else:
                $HallHarassmentText = 'Вы смотрите, не вмешиваясь. Аманда выходит из сцены сама, ещё красная. «Я… справилась. Ты видел?»'
            end
        else:
            $HallHarassmentText = 'Вы стоите и смотрите. ' + $RealName[$HallHarassGirl] + ' сама ставит клиента на место — не идеально, но твёрдо. Зал это замечает. И вы тоже.'
        end
    elseif $HallHarassmentTextId = 'watch_bad':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы наблюдаете. ' + $RealName[$HallHarassGirl] + ' выбирается, но во взгляде вопрос без крика: «Ты видел — и всё равно стоял?»'
        else:
            $HallHarassmentText = 'Вы наблюдаете. ' + $RealName[$HallHarassGirl] + ' выбирается растерянно. «Ты видел всё и всё равно молчал?»'
        end
    elseif $HallHarassmentTextId = 'watch_lewd':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы не мешаете — только смотрите. Клиент смелеет, монеты звенят, ' + $RealName[$HallHarassGirl] + ' держит на грани. Она не орёт — скорее устало: зал понял, что хозяин видит и не останавливает.'
        else:
            $HallHarassmentText = 'Вы не мешаете. Клиент смелеет, чаевые звенят, ' + $RealName[$HallHarassGirl] + ' на грани. Вы показали: хозяин видит и не вмешивается.'
        end

    ! ---------- aftermath (полная строка) ----------
    elseif $HallHarassmentTextId = 'aftermath_protect_thanks':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса подходит ближе, без театра: «Спасибо, что вмешался. Не люблю, когда за меня решают… но сейчас — вовремя.»'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра кивает: «Спасибо. Здесь без хозяина иногда не обходится.»'
            else:
                $HallHarassmentText = 'Аманда говорит тихо: «Спасибо… что не сделал вид, будто ничего нет.»'
            end
        else:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса: «Спасибо. Мне важно, что ты не отвернулся.»'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра: «Спасибо, что вмешался.»'
            else:
                $HallHarassmentText = 'Аманда, не глядя в глаза: «Спасибо, что вмешался. Мне было важно, что ты не сделал вид, будто ничего не происходит.»'
            end
        end

    elseif $HallHarassmentTextId = 'aftermath_protect_annoyed':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса вздыхает: «Я почти сама. Не надо каждый раз, будто я без рук.» Спокойно, без яда.'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра: «Спасибо. Но я не беспомощная. Иногда дай мне самой.»'
            else:
                $HallHarassmentText = 'Аманда мнётся: «Спасибо… только я уже могла. Не всегда надо так сразу.»'
            end
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' смотрит с раздражением: «Я сама могла с этим справиться. Не надо каждый раз делать вид, будто я беспомощная.»'
        end

    elseif $HallHarassmentTextId = 'aftermath_protect_fail':
        $HallHarassmentText = $RealName[$HallHarassGirl] + ' вздыхает: «Шумно вышло… но ты хотя бы попытался.»'

    elseif $HallHarassmentTextId = 'aftermath_watch_ok':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса коротко: «Я справилась. Ты видел — и не полез. Иногда так тоже нормально.»'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра: «Справилась. Ты стоял — ладно. Главное, не отвернулся совсем.»'
            else:
                $HallHarassmentText = 'Аманда тихо: «Я… справилась. Ты всё видел. Просто… стоял.» Без упрёка — скорее усталость.'
            end
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' бросает взгляд: «Я справилась. Но запомни — ты тоже всё видел.»'
        end

    elseif $HallHarassmentTextId = 'aftermath_watch_angry':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса подходит ближе: «Ты смотрел. Иногда это… тяжело. Но кричать не буду. Просто запомни.»'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра ровно: «Видел и стоял. В другой раз — ближе, если надо.» Без крика.'
            else:
                $HallHarassmentText = 'Аманда краснеет: «Ты стоял и смотрел… Мне от этого… странно. Не злись, просто…»'
            end
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' с покрасневшими щеками: «Я видела, как ты стоял и смотрел. Иногда это хуже, чем если бы тебя не было рядом.»'
        end

    elseif $HallHarassmentTextId = 'aftermath_ignore_cold':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса проходит мимо: «Сделал вид, что не видел? Понятно. Не удобно — так и скажи в следующий раз.»'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра коротко: «Не заметил? Ладно. Кухня/зал запомнит.»'
            else:
                $HallHarassmentText = 'Аманда шепчет: «Ты правда… не видел? Ладно. Забудь.» Голос тише злости — скорее обида.'
            end
        else:
            $HallHarassmentText = 'Через минуту ' + $RealName[$HallHarassGirl] + ' шепчет сквозь зубы: «Ты правда ничего не видел?.. Ладно. Забудь.»'
        end

    elseif $HallHarassmentTextId = 'aftermath_ignore_ok':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' возвращается к работе. Молча. Без сцены — будто решила не раздувать.'
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' молча проходит мимо и возвращается к работе, будто ничего не было.'
        end

    ! ---------- aftermath lines (для склейки, без имени) ----------
    elseif $HallHarassmentTextId = 'aftermath_protect_thanks_line':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'тихо: «Спасибо. Вовремя. Хотя я почти сама.»'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'кивает: «Спасибо. Здесь без хозяина иногда никак.»'
            else:
                $HallHarassmentText = 'тихо: «Спасибо… что не сделал вид, будто ничего.»'
            end
        else:
            $HallHarassmentText = 'тихо, не глядя: «Спасибо, что вмешался. Мне было важно, что ты не сделал вид, будто ничего не происходит.»'
        end
    elseif $HallHarassmentTextId = 'aftermath_protect_annoyed_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'без яда: «Я почти сама. Не каждый раз надо.»'
        else:
            $HallHarassmentText = 'с раздражением: «Я сама могла. Не надо каждый раз, будто я беспомощная.»'
        end
    elseif $HallHarassmentTextId = 'aftermath_protect_fail_line':
        $HallHarassmentText = 'вздыхает: «Шумно… но ты хотя бы попытался.»'
    elseif $HallHarassmentTextId = 'aftermath_watch_ok_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'коротко: «Я справилась. Ты видел — и ладно.»'
        else:
            $HallHarassmentText = '«Я справилась. Но запомни — ты тоже всё видел.»'
        end
    elseif $HallHarassmentTextId = 'aftermath_watch_angry_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'тише: «Ты смотрел. Иногда это тяжело. Просто запомни.»'
        else:
            $HallHarassmentText = 'с покрасневшими щеками: «Ты стоял и смотрел. Иногда это хуже, чем если бы тебя не было.»'
        end
    elseif $HallHarassmentTextId = 'aftermath_ignore_cold_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'мимо: «Не видел? Понятно. В следующий раз — хоть слово.»'
        else:
            $HallHarassmentText = 'сквозь зубы: «Ты правда ничего не видел?.. Ладно. Забудь.»'
        end
    elseif $HallHarassmentTextId = 'aftermath_ignore_ok_line':
        $HallHarassmentText = 'молча возвращается к работе, будто ничего не было.'

    ! ---------- ignore generic ----------
    elseif $HallHarassmentTextId = 'ignore':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы делаете вид, что заняты. ' + $RealName[$HallHarassGirl] + ' выходит из ситуации сама и возвращается к работе — без крика, но и без тепла.'
        else:
            $HallHarassmentText = 'Вы делаете вид, что не заметили. ' + $RealName[$HallHarassGirl] + ' сама выходит из ситуации. Теперь она избегает смотреть в вашу сторону.'
        end

    ! ---------- family (Аманда-сцена) ----------
    elseif $HallHarassmentTextId = 'family_amanda_protected':
        $HallHarassmentText = 'Позже Мелисса замечает, что вы не дали ситуации разрастись. Сандра тоже слышит — и молча смотрит на Аманду дольше обычного.'
    elseif $HallHarassmentTextId = 'family_amanda_bad':
        $HallHarassmentText = 'Случай не остаётся незамеченным. Мелисса холодеет. Сандра вечером слишком долго смотрит на Аманду — будто взвешивает, во что превращается зал.'
    elseif $HallHarassmentTextId = 'family_amanda_self':
        $HallHarassmentText = 'Мелисса видит, что Аманда справилась сама, но всё равно хмурится. Сандра молчит — и молчание тяжелее слов.'

    ! ---------- зал как публика ----------
    elseif $HallHarassmentTextId = 'hall_reaction_ignore':
        $HallHarassmentText = 'За соседним столом тихо фыркают. Сцена кончилась сама — не потому что зал успокоился, а потому что хозяин сделал вид, что его это не касается.'
    elseif $HallHarassmentTextId = 'hall_reaction_watch':
        $HallHarassmentText = 'Несколько гостей переглядываются. Кто-то отводит взгляд, кто-то смотрит слишком внимательно — не только на неё, но и на вас.'
    elseif $HallHarassmentTextId = 'hall_reaction_watch_bad':
        $HallHarassmentText = 'За дальним столом усмехаются. Сцена кончилась криво: запомнили и её, и то, что хозяин всё видел.'
    elseif $HallHarassmentTextId = 'hall_reaction_watch_lewd':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Зал оживляется шёпотом. Кто-то поднимает кружку, чтобы лучше видеть. Хозяин не остановил — и это уже тон трактира.'
        else:
            $HallHarassmentText = 'Зал оживляется. Кто-то поднимает кружку. Хозяин не только заметил — позволил смотреть дальше.'
        end
    elseif $HallHarassmentTextId = 'hall_reaction_protect':
        $HallHarassmentText = 'Зал на миг притихает. Клиент бурчит, но руки убирает — теперь ясно, кто ставит точку.'
    elseif $HallHarassmentTextId = 'hall_reaction_protect_fail':
        $HallHarassmentText = 'Шум вспыхивает громче, чем хотелось. Сцена кончилась, шёпот за столами только разгорелся.'

    ! ---------- legacy intro ids (на случай старых вызовов; intro — в intro_text) ----------
    elseif $HallHarassmentTextId = 'waitress_intro_1' or $HallHarassmentTextId = 'waitress_intro_2' or $HallHarassmentTextId = 'waitress_intro_3' or $HallHarassmentTextId = 'waitress_intro_4':
        $HallHarassmentText = ''
    elseif $HallHarassmentTextId = 'kitchen_intro_1' or $HallHarassmentTextId = 'kitchen_intro_2' or $HallHarassmentTextId = 'kitchen_intro_3' or $HallHarassmentTextId = 'kitchen_intro_4':
        $HallHarassmentText = ''

    else:
        $HallHarassmentText = ''
    end

    killvar '$HallHarassmentTextId'
    killvar 'HallHarassmentTextLate'
---

#HallHarassmentTalkPrintText
    gs 'HallHarassmentTalkText', $ARGS[0]

    if $HallHarassmentTalkText <> '':
        *pl $HallHarassmentTalkText
    end
---

#HallHarassmentTalkText
    $HallHarassmentTalkTextId = LCASE($ARGS[0])
    $HallHarassmentTalkText = ''

    gs 'HallHarassmentTextLateFlag'

    if $HallHarassmentTalkTextId = 'no_event':
        $HallHarassmentTalkText = 'Вы пытаетесь заговорить о зале — тема быстро сходит на нет.'
    elseif $HallHarassmentTalkTextId = 'wrong_girl':
        $HallHarassmentTalkText = $RealName[$TalkEventGirl] + ' не понимает, о каком случае вы говорите.'
    elseif $HallHarassmentTalkTextId = 'reaction_protect_dislike':
        if HallHarassmentTextLate = 1:
            $HallHarassmentTalkText = 'Вы вспоминаете зал. ' + $RealName[$TalkEventGirl] + ' без яда: «Я почти сама. Не надо каждый раз, будто я без рук.»'
        else:
            $HallHarassmentTalkText = 'Вы вспоминаете зал. ' + $RealName[$TalkEventGirl] + ' с лёгким раздражением: «Я сама могла. Не надо каждый раз делать вид, будто я беспомощная.»'
        end
    elseif $HallHarassmentTalkTextId = 'reaction_protect_success':
        $HallHarassmentTalkText = 'Вы вспоминаете зал. ' + $RealName[$TalkEventGirl] + ' тихо: «Спасибо, что вмешался. Мне было важно, что ты не сделал вид, будто ничего не происходит.»'
    elseif $HallHarassmentTalkTextId = 'reaction_protect_fail':
        $HallHarassmentTalkText = 'Вы вспоминаете шум. ' + $RealName[$TalkEventGirl] + ' вздыхает: «Вышло некрасиво… но ты хотя бы попытался.»'
    elseif $HallHarassmentTalkTextId = 'reaction_watch':
        if HallHarassmentTextLate = 1:
            $HallHarassmentTalkText = 'Вы заводите разговор о зале. ' + $RealName[$TalkEventGirl] + ' ровно: «Ты смотрел. Иногда это тяжело. Просто запомни.»'
        else:
            $HallHarassmentTalkText = 'Вы заводите разговор о зале. ' + $RealName[$TalkEventGirl] + ' напряжённо: «Я видела, как ты стоял и смотрел. Иногда это хуже, чем если бы тебя не было.»'
        end
    elseif $HallHarassmentTalkTextId = 'reaction_profit':
        if HallHarassmentTextLate = 1:
            $HallHarassmentTalkText = 'Вы вспоминаете тот случай. ' + $RealName[$TalkEventGirl] + ' криво усмехается: «Не видел — или сделал вид? Для зала удобно. Для меня… по-разному.»'
        else:
            $HallHarassmentTalkText = 'Вы вспоминаете тот случай. ' + $RealName[$TalkEventGirl] + ' криво: «Ты правда не видел? Или сделал вид? Для зала — удобно. Для меня — нет.»'
        end
    elseif $HallHarassmentTalkTextId = 'instruction_intro':
        $HallHarassmentTalkText = 'После такого случая нужно решить, как ей действовать дальше. Без правил зал сам придумает свои.'
    else:
        $HallHarassmentTalkText = ''
    end

    killvar '$HallHarassmentTalkTextId'
    killvar 'HallHarassmentTextLate'
---
