! ================================================
! FILE: modules/events/hall/hall_harassment_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! After / policy / hall-reaction / talk-recall (intro — hall_harassment_intro_text)
! Структура: protect / watch / ignore × girl × early|late
! Зал: Аманда/Мелисса. Кухня: Сандра.
! ================================================

#HallHarassmentPrintText
    gs 'HallHarassmentText', $ARGS[0]

    if $HallHarassmentText <> '':
        *pl $HallHarassmentText
    end
---

#HallHarassmentTextLateFlag
    ! 1 = поздний тон (терпеливее / менее «я сама ударю»)
    HallHarassmentTextLate = 0

    if $HallHarassGirl = '':
        exit
    end

    if $HarassGirlStance = 'provoke' or $HarassGirlStance = 'mixed':
        HallHarassmentTextLate = 1
    elseif FamilyCorruptionStage >= 3:
        HallHarassmentTextLate = 1
    elseif sluttiness[$HallHarassGirl] >= 40:
        HallHarassmentTextLate = 1
    end
---

#HallHarassmentText
    $HallHarassmentTextId = LCASE($ARGS[0])
    $HallHarassmentText = ''

    gs 'HallHarassmentTextLateFlag'

    ! ---------- служебные ----------
    if $HallHarassmentTextId = 'no_repeat':
        $HallHarassmentText = 'После недавнего шума зал притих. Девушки работают осторожнее, поглядывают по сторонам — никто не хочет снова привлекать внимание.'
    elseif $HallHarassmentTextId = 'closed':
        $HallHarassmentText = 'Таверна закрыта. В зале тихо и пусто — приставать некому.'
    elseif $HallHarassmentTextId = 'no_girl':
        $HallHarassmentText = 'Вы окидываете зал взглядом. Гости спокойно пьют, девушки заняты своим делом — ничего особенного не происходит.'
    elseif $HallHarassmentTextId = 'choice_prompt':
        $HallHarassmentText = 'Посетители уже поглядывают в вашу сторону. Ситуация явно заходит слишком далеко — теперь решать вам.'

    ! ---------- policy (перед/после, контекст) ----------
    elseif $HallHarassmentTextId = 'policy_none':
        $HallHarassmentText = 'Чёткого указания вы ей не давали. Она смотрит на вас выжидающе: будете ли вы вмешиваться или оставите всё на её усмотрение?'
    elseif $HallHarassmentTextId = 'policy_decent':
        $HallHarassmentText = 'Она помнит ваш наказ не допускать волностей, даже если после этого будет меньше чаевых.'
    elseif $HallHarassmentTextId = 'policy_own':
        $HallHarassmentText = 'Вы сказали ей решать самой. Теперь она сама держит гостей на расстоянии, а посетители внимательно следят, как вы себя поведёте.'
    elseif $HallHarassmentTextId = 'policy_profit':
        $HallHarassmentText = 'Она помнит вашу установку: улыбаться и не сбегать от гостей ради выручки. Сейчас эта терпимость проходит настоящую проверку.'

    ! ---------- first amanda (ещё вызывается из Intro) ----------
    elseif $HallHarassmentTextId = 'amanda_first_intro':
        $HallHarassmentText = 'Аманда несёт поднос к дальнему столу. Подвыпивший посетитель придерживает её за запястье и тянет чуть ближе. Она теряется, заливается краской и робко пытается забрать руку: «Отпустите, пожалуйста...»'

    ! ---------- resolve: protect ----------
    elseif $HallHarassmentTextId = 'protect_hard_success':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Вы подходите грозно нахмурив брови. Почувствовав уверенность хозяина, гость убирает руки. Мелисса спокойно поправляет фартук и кивает: «Спасибо, Стефан. Впрочем, я бы и сама справилась...» — без раздражения, скорее привычка держать лицо.'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Вы ставите гостя на место. Сандра вытирает руки о полотенце: «Вовремя зашёл. Только опекать меня не надо, я на своей кухне порядок знаю».'
            else:
                $HallHarassmentText = 'Вы вмешиваетесь твёрдо и уверенно. Посетитель отступает. Аманда выдыхает: «Спасибо, Стефан... Хорошо, что ты подошёл».'
            end
        else:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Вы по-хозяйски обрываете вольности клиента. Мелисса сохраняет вежливую мину: «Спасибо за своевременность, Стефан. Хотя я почти уладила всё сама».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Вы строго выставляете наглеца с кухни. Сандра веско кивает: «Спасибо. Посторонним лапам у печи делать нечего».'
            else:
                $HallHarassmentText = 'Вы пресекаете вольности. Аманда тихо благодарит: «Спасибо... Я не знала, как его потактичнее осадить, чтобы не испортить вечер».'
            end
        end

    elseif $HallHarassmentTextId = 'protect_hard_dislike':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Гость отступает, но Мелисса смотрит на вас с лёгкой иронией: «Стефан, ну зачем раздувать сцену? Я сама его почти проучила. Не стоит спугивать клиентов из-за пустяков».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра провожает гостя ровным взглядом: «Спасибо, конечно. Но я за свои кастрюли отвечаю сама. Не делай из меня беспомощную девчонку».'
            else:
                $HallHarassmentText = 'Аманда вздыхает: «Спасибо... только я уже сама собиралась перевести всё в шутку. Не обязательно было так резко подходить».'
            end
        else:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Клиент убирает руки. Мелисса поджимает губы: «Я сама способна постоять за себя, Стефан. Не нужно устраивать опеку при всём зале».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра хмурится: «Спасибо, Стефан. Но на кухне хватило бы и моего слова. Не нужно устраивать представление».'
            else:
                $HallHarassmentText = 'Аманда смотрит с досадой: «Я пыталась уладить всё сама... Не стоит сразу прибегать, а то все подумают, что я глупая и со всем бегу к брату».'
            end
        end

    elseif $HallHarassmentTextId = 'protect_hard_fail':
        $HallHarassmentText = 'Вы вмешиваетесь излишне резко — клиент начинает громко спорить, часть зала недовольно ворчит из-за шума. Порядок восстановлен, но настроение у всех подпорчено.'

    elseif $HallHarassmentTextId = 'warn_client_success':
        $HallHarassmentText = 'Вы спокойно и негромко делаете посетителю замечание. Он понимает намёк и вежливо отступает. Граница между вежливостью персонала и наглостью успешно обозначена.'
    elseif $HallHarassmentTextId = 'warn_client_fail':
        $HallHarassmentText = 'Уладить дело миром не выходит: клиент пререкается, спор выходит громким. Прибыль от этого стола теперь под вопросом, что явно злит работающую здесь девушку.'

    ! ---------- resolve: self / profit (legacy ids) ----------
    elseif $HallHarassmentTextId = 'self_handle_success':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы даёте ей понять взглядом: разбирайся сама. ' + $RealName[$HallHarassGirl] + ' хладнокровно гасит наглость клиента, переводя всё в дорогой заказ: «Я со всем справилась».'
        else:
            $HallHarassmentText = 'Вы не лезете вперёд. ' + $RealName[$HallHarassGirl] + ' находит способ осадить клиента сама, сохраняя вежливость ради кассы: «Я сама справилась, всё в порядке».'
        end
    elseif $HallHarassmentTextId = 'self_handle_bad':
        $HallHarassmentText = 'Вы медлите, ожидая, что она разберётся сама. Она выбирается из ситуации, но бросает на вас короткий взгляд: «Ты мог бы хотя бы поближе подойти, Стефан».'
    elseif $HallHarassmentTextId = 'profit_high':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы демонстративно погружаетесь в другие дела. Клиент доволен, оставляет чаевые и делает повторный заказ. ' + $RealName[$HallHarassGirl] + ' приносит выручку, ровно роняя: «Серебро на столе. Главное, чтобы эти чаевые того стоили».'
        else:
            $HallHarassmentText = 'Вы решаете не вмешиваться. Довольный клиент оставляет хорошие чаевые. ' + $RealName[$HallHarassGirl] + ' возвращается к стойке: «По крайней мере, касса сегодня вырастет...» — но в её голосе нет радости.'
        end
    elseif $HallHarassmentTextId = 'profit_low':
        $HallHarassmentText = 'Вы делаете вид, что ничего не заметили. ' + $RealName[$HallHarassGirl] + ' сама выпутывается, но улучив минуту, тихо бросает: «Выручку я с него выжала. Но мог бы хоть для вида сделать шаг в нашу сторону».'

    ! ---------- resolve: watch ----------
    elseif $HallHarassmentTextId = 'watch_calm':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Вы просто наблюдаете. Мелисса осаживает посетителя одной ироничной фразой. После она кивает вам: «Видел? Справилась. Хорошо, что не стал устраивать драку из-за пустяка».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Вы в дверях кухни. Сандра сама указывает наглецу на дверь: «Сама справилась. Приглядывал со стороны — и правильно».'
            else:
                $HallHarassmentText = 'Вы наблюдаете, не вмешиваясь. Аманда аккуратно выходит из ситуации: «Я... я сама смогла. Ты ведь контролировал всё, да?»'
            end
        else:
            $HallHarassmentText = 'Вы стоите в стороне и наблюдаете. ' + $RealName[$HallHarassGirl] + ' сама находит слова, чтобы поставить клиента на место, не теряя его как покупателя.'
        end
    elseif $HallHarassmentTextId = 'watch_bad':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы молча наблюдаете. ' + $RealName[$HallHarassGirl] + ' находит выход, но бросает вам: «Приглядывать мог бы и поближе, Стефан».'
        else:
            $HallHarassmentText = 'Вы продолжаете наблюдать. ' + $RealName[$HallHarassGirl] + ' сама справляется, но шепчет: «Стоять и просто смотреть — это так себе помощь, брат».'
        end
    elseif $HallHarassmentTextId = 'watch_lewd':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы не вмешиваетесь. Почувствовав свободу, клиент смелеет, монеты звенят, а ' + $RealName[$HallHarassGirl] + ' балансирует на грани приличия. Клиенты понимают: за хорошую выручку хозяин пропустит мелкие вольности.'
        else:
            $HallHarassmentText = 'Вы остаётесь на месте. Гость становится наглее, чаевые звенят, ' + $RealName[$HallHarassGirl] + ' вынуждена терпеть на грани дозволенного. Посетители видят: выручка для трактира сейчас важнее.'
        end

    ! ---------- aftermath (полная строка) ----------
    elseif $HallHarassmentTextId = 'aftermath_protect_thanks':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса подходит к вам у стойки: «Спасибо, что пресёк это. Я не люблю, когда вмешательство лишнее, но этот тип совсем рамок не знал».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра кивает: «Спасибо, Стефан. Порядок на кухне должен быть железным, тут ты прав».'
            else:
                $HallHarassmentText = 'Аманда негромко: «Спасибо, Стефан... Я пыталась свести всё в шутку, но одной мне было бы тяжело».'
            end
        else:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса ровно произносит: «Спасибо, Стефан. Мне важно знать, что ты готов поддержать нас в зале, а не просто считать выручку».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра веско роняет: «Спасибо, что вовремя зашёл и пресёк эти вольности».'
            else:
                $HallHarassmentText = 'Аманда, смущённо опустив глаза, шепчет: «Спасибо, что заступился. Мне было тяжело одной перед всем этим столом...»'
            end
        end

    elseif $HallHarassmentTextId = 'aftermath_protect_annoyed':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса негромко вздыхает: «Я почти уладила всё сама, Стефан. Не нужно бросаться на мою защиту каждый раз, ты мне клиента спугнул».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра вполоборота: «Спасибо за заботу, конечно. Но я на своей кухне сама справляюсь, не нужно раздувать ссору».'
            else:
                $HallHarassmentText = 'Аманда мнётся: «Спасибо... только я уже сама собиралась перевести тему ради чаевых. Ты слишком резко вмешался».'
            end
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' смотрит с досадой: «Я вполне способна сама постоять за себя. Не нужно каждый раз опекать меня перед залом, будто я беспомощная».'
        end

    elseif $HallHarassmentTextId = 'aftermath_protect_fail':
        $HallHarassmentText = $RealName[$HallHarassGirl] + ' вздыхает: «Шумно вышло, весь зал теперь судачит... Но я вижу, что ты по крайней мере пытался всё исправить».'

    elseif $HallHarassmentTextId = 'aftermath_watch_ok':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса сухо констатирует: «Я со всем справилась, монета в кассе. Ты контролировал со стороны и не раздул скандал — нормально».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра: «Сама с ним разобралась. Главное, что ты приглядывал и держал ситуацию на контроле».'
            else:
                $HallHarassmentText = 'Аманда: «Я... я сама справилась. Немного непривычно самой отшучиваться от таких гостей, но обошлось без скандала».'
            end
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' бросает на вас долгий взгляд: «Как видишь, я со всем разобралась сама. Но я запомнила, Стефан, что ты просто стоял в стороне и молча наблюдал».'
        end

    elseif $HallHarassmentTextId = 'aftermath_watch_angry':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса подходит ближе: «Ты просто стоял и смотрел. Чувствовать себя приманкой — удовольствие среднее, Стефан».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра роняет: «Видел, как ко мне лезут, и просто выжидал. В следующий раз будь добр подойди поближе».'
            else:
                $HallHarassmentText = 'Аманда розовеет: «Ты просто стоял и смотрел... Мне всё равно было жутко. Мог бы хоть подойти поближе для вида!»'
            end
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' с упрёком: «Твоё молчаливое созерцание со стороны в такие минуты всё равно задевает, брат».'
        end

    elseif $HallHarassmentTextId = 'aftermath_ignore_cold':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса сухо: «Предпочёл не заметить? Серебро я с него стрясла. Но не вздумай превращать такое в систему, Стефан».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра: «Решил совсем не замечать вольностей на моей кухне? Я сама с ним разобралась, но запомню».'
            else:
                $HallHarassmentText = 'Аманда: «Вообще не вмешался... Я понимаю, что надо зарабатывать, но бросать меня одну против полного зала — это слишком».'
            end
        else:
            $HallHarassmentText = 'Спустя минуту ' + $RealName[$HallHarassGirl] + ' сдержанно цедит: «Ты правда предпочёл закрыть на это глаза ради выручки?.. Это было очень неприятно».'
        end

    elseif $HallHarassmentTextId = 'aftermath_ignore_ok':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' молча возвращается к своим обязанностям, решив не раздувать конфликт и самостоятельно отвечать за свой заработок.'
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' молча проходит мимо вас к столам и демонстративно погружается в работу.'
        end

    ! ---------- aftermath lines (для склейки, без имени) ----------
    elseif $HallHarassmentTextId = 'aftermath_protect_thanks_line':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'тихо произносит: «Спасибо, вовремя пресёк. Этот тип рамок приличия вообще не знал».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'кивает вам: «Спасибо. На кухонной половине без твоего веского слова порядок держать тяжело».'
            else:
                $HallHarassmentText = 'негромко шепчет: «Спасибо, Стефан... Я честно пыталась свести всё в шутку, но тут без тебя было не обойтись».'
            end
        else:
            $HallHarassmentText = 'не глядя вам в глаза, тихо шепчет: «Спасибо, что заступился. Одной перед всеми этими людьми мне стало по-настоящему страшно».'
        end
    elseif $HallHarassmentTextId = 'aftermath_protect_annoyed_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'без лишней колкости замечает: «Я почти уладила всё сама и выбила чаевые. Не стоило так резко вмешиваться».'
        else:
            $HallHarassmentText = 'с досадой бросает: «Я вполне способна сама постоять за себя. Твоя излишняя опека только уменьшает мои чаевые».'
        end
    elseif $HallHarassmentTextId = 'aftermath_protect_fail_line':
        $HallHarassmentText = 'вздыхает: «Вышло слишком шумно, доходам это точно не на пользу... но я вижу, что ты по крайней мере пытался помочь».'
    elseif $HallHarassmentTextId = 'aftermath_watch_ok_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'сухо констатирует: «Я со всем справилась сама, прибыль в кассе. Ты контролировал ситуацию со стороны и не стал устраивать скандал — умница».'
        else:
            $HallHarassmentText = 'ровно замечает: «Как видишь, я со всем разобралась сама. Но имей в виду — я видела, что ты просто стоял в стороне и молча наблюдал».'
        end
    elseif $HallHarassmentTextId = 'aftermath_watch_angry_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'вполголоса произносит: «Ты просто стоял и смотрел... Чувствовать себя приманкой — удовольствие ниже среднего. Контролируй зал получше, Стефан».'
        else:
            $HallHarassmentText = 'с упрёком шепчет: «Твоё молчаливое созерцание со стороны в такие минуты всё равно задевает, брат».'
        end
    elseif $HallHarassmentTextId = 'aftermath_ignore_cold_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'проходя мимо, сухо роняет: «Предпочёл не заметить? Серебро я с него стрясла. Но не вздумай превращать такое попустительство в правило, Стефан».'
        else:
            $HallHarassmentText = 'сдержанно цедит сквозь зубы: «Ты правда предпочёл сделать вид, что ничего не видишь ради денег?.. Это было неприятно».'
        end
    elseif $HallHarassmentTextId = 'aftermath_ignore_ok_line':
        $HallHarassmentText = 'молча возвращается к своим обязанностям, решив не раздувать конфликт и самостоятельно отвечать за свой заработок.'

    ! ---------- ignore generic ----------
    elseif $HallHarassmentTextId = 'ignore':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы демонстративно погружаетесь в свои дела. ' + $RealName[$HallHarassGirl] + ' хладнокровно находит способ выйти из ситуации сама и возвращается к работе, но бросая на вас короткий колючий взгляд.'
        else:
            $HallHarassmentText = 'Вы делаете вид, что увлечены другими делами. ' + $RealName[$HallHarassGirl] + ' самостоятельно выпутывается из положения ради прибыли и своей доли, но подчёркнуто избегает смотреть в вашу сторону.'
        end

    ! ---------- family (Аманда-сцена) ----------
    elseif $HallHarassmentTextId = 'family_amanda_protected':
        $HallHarassmentText = 'Позже Мелисса отмечает про себя, что Стефан не даёт сестру в обиду, даже когда нужно зарабатывать. Сандра на кухне молча одобряет: вы ведёте себя правильно.'
    elseif $HallHarassmentTextId = 'family_amanda_bad':
        $HallHarassmentText = 'Этот случай обсуждается в кругу семьи. Мелисса упрекает вас, что ради лишней монеты вы готовы закрыть глаза на всё. Сандра хмурится: хозяин трактира и брат обязан следить за тем, чтобы клиенты не наглели.'
    elseif $HallHarassmentTextId = 'family_amanda_self':
        $HallHarassmentText = 'Мелисса видит, что Аманда сама справляется с прилипчивыми гостями ради чаевых. Сандра на кухне хранит веское молчание — девчонки взрослеют и учатся постоять за себя.'

    ! ---------- зал как публика ----------
    elseif $HallHarassmentTextId = 'hall_reaction_ignore':
        $HallHarassmentText = 'За соседним столом кто-то согласно фыркает. Инцидент угасает сам собой — вы наглядно продемонстрировали залу, что персонал готов крутиться самостоятельно.'
    elseif $HallHarassmentTextId = 'hall_reaction_watch':
        $HallHarassmentText = 'Несколько завсегдатаев за столами красноречиво переглядываются. Кто-то начинает наблюдать за происходящим с удвоенным вниманием — причём не столько за девушкой, сколько за вашей реакцией.'
    elseif $HallHarassmentTextId = 'hall_reaction_watch_bad':
        $HallHarassmentText = 'За дальним столом раздаются смешки. Ситуация разрешилась без прямого участия Стефана: присутствующие отлично запомнили вольность гостя и ваше безучастие.'
    elseif $HallHarassmentTextId = 'hall_reaction_watch_lewd':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Зал заметно оживляется, по столам пробегает одобрительный шёпот. Кое-кто приподнимает кружку. Раз вы не пресекли такое — значит, дальше можно делать так же.'
        else:
            $HallHarassmentText = 'Зал мгновенно оживляется, посетители оборачиваются к столу. Кто-то с ухмылкой поднимает кружку. Похоже, вы открыто позволяете публике смаковать эту сцену дальше, ставя прибыль трактира выше приличий.'
        end
    elseif $HallHarassmentTextId = 'hall_reaction_protect':
        $HallHarassmentText = 'Шумный зал на мгновение заметно притихает. Клиент недовольно бурчит, но послушно убирает руки — теперь всем присутствующим ясно, кто здесь устанавливает финальную точку.'
    elseif $HallHarassmentTextId = 'hall_reaction_protect_fail':
        $HallHarassmentText = 'Гул и споры за столами вспыхивают с новой силой. Сама сцена окончена, но взбудораженный шёпот по всему залу только разгорается.'

    ! ---------- legacy intro ids ----------
    elseif $HallHarassmentTextId = 'waitress_intro_1' or $HallHarassmentTextId = 'waitress_intro_2' or $HallHarassmentTextId = 'waitress_intro_3' or $HallHarassmentTextId = 'waitress_intro_4':
        $HallHarassmentText = ''
    elseif $HallHarassmentTextId = 'kitchen_intro_1' or $HallHarassmentTextId = 'kitchen_intro_2' or $HallHarassmentTextId = 'kitchen_intro_3' or $HallHarassmentTextId = 'kitchen_intro_4':
        $HallHarassmentText = ''

    else:
        $HallHarassmentText = ''
    end

    killvar '$HallHarassmentTextId'
    killvar 'HallHarassmentTextLate'
---

#HallHarassmentTalkPrintText
    gs 'HallHarassmentTalkText', $ARGS[0]

    if $HallHarassmentTalkText <> '':
        *pl $HallHarassmentTalkText
    end
---

#HallHarassmentTalkText
    $HallHarassmentTalkTextId = LCASE($ARGS[0])
    $HallHarassmentTalkText = ''

    gs 'HallHarassmentTextLateFlag'

    if $HallHarassmentTalkTextId = 'no_event':
        $HallHarassmentTalkText = 'Вы пытаетесь завести разговор о порядке в зале, но тема быстро сходит на нет, не встретив интереса.'
    elseif $HallHarassmentTalkTextId = 'wrong_girl':
        $HallHarassmentTalkText = $RealName[$TalkEventGirl] + ' лишь искренне недоумевает и не понимает, о каком именно случае в зале вы сейчас говорите.'
    elseif $HallHarassmentTalkTextId = 'reaction_protect_dislike':
        if HallHarassmentTextLate = 1:
            $HallHarassmentTalkText = 'Вы возвращаетесь к разговору о том случае в зале. ' + $RealName[$TalkEventGirl] + ' отвечает без лишней колкости: «Я почти справилась сама и выбила чаевые, Стефан. Не стоило так резко прибегать».'
        else:
            $HallHarassmentTalkText = 'Вы заводите разговор о происшедшем. ' + $RealName[$TalkEventGirl] + ' отзывается с досадой: «Я вполне могла сама вежливо перевести тему ради кассы. Твоя излишняя опека только уменьшает мои чаевые».'
        end
    elseif $HallHarassmentTalkTextId = 'reaction_protect_success':
        $HallHarassmentTalkText = 'Вы вспоминаете недавний инцидент. ' + $RealName[$TalkEventGirl] + ' негромко произносит: «Спасибо, что вовремя подошёл. Я честно пыталась мило улыбаться ради чаевых, но этот тип совсем страх потерял. Хорошо, что ты не отвернулся».'
    elseif $HallHarassmentTalkTextId = 'reaction_protect_fail':
        $HallHarassmentTalkText = 'Вы упоминаете недавний шум в зале. ' + $RealName[$TalkEventGirl] + ' тихо вздыхает: «Вышло излишне громко, доходам это точно не на пользу... Но я вижу и ценю, что ты по крайней мере попытался заступиться».'
    elseif $HallHarassmentTalkTextId = 'reaction_watch':
        if HallHarassmentTextLate = 1:
            $HallHarassmentTalkText = 'Вы заводите разговор о поведении гостей в зале. ' + $RealName[$TalkEventGirl] + ' отвечает ровным тоном: «Ты просто стоял и контролировал всё со стороны. Ощущать себя приманкой — удовольствие ниже среднего. Контролируй зал получше, Стефан».'
        else:
            $HallHarassmentTalkText = 'Вы пытаетесь обсудить недавнюю сцену. ' + $RealName[$TalkEventGirl] + ' поджимает губы: «Я прекрасно видела, как ты просто стоял в стороне и молча наблюдал. Твоё молчаливое созерцание со стороны в такие минуты просто бесит, брат».'
        end
    elseif $HallHarassmentTalkTextId = 'reaction_profit':
        if HallHarassmentTextLate = 1:
            $HallHarassmentTalkText = 'Вы заговариваете о том прибыльном вечере. ' + $RealName[$TalkEventGirl] + ' иронично усмехается: «Чаевые я с него получила, тут спорить не буду — серебро лишним не бывает. Но балансировать на этой грани каждый день я не собираюсь».'
        else:
            $HallHarassmentTalkText = 'Вы вспоминаете щедрого, но наглого клиента. ' + $RealName[$TalkEventGirl] + ' усмехается: «Серебро пополнило наши кошельки, тут всё честно. Растущие доходы — это отлично, но присматривай за залом внимательнее, Стефан».'
        end
    elseif $HallHarassmentTalkTextId = 'instruction_intro':
        $HallHarassmentTalkText = 'После подобного случая в зале вам необходимо чётко определить для неё правила поведения с настойчивыми гостями. Если вы не установите границы, зал быстро начнёт устанавливать границы сам.'
    else:
        $HallHarassmentTalkText = ''
    end

    killvar '$HallHarassmentTalkTextId'
    killvar 'HallHarassmentTextLate'
---
