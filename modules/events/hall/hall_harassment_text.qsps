! ================================================
! FILE: modules/events/hall/hall_harassment_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT (legacy + talk-recall)
!
! ЭКРАН 2 (after beat + talk band) → hall_harassment_after_text.qsps
! Intro → hall_harassment_intro_text.qsps
! Здесь: служебные id, protect_hard_* legacy, talk-recall, family, старые hall_reaction
!   (hall_reaction_* — fallback; live path → AfterBeat)
! ================================================

#HallHarassmentPrintText
    gs 'HallHarassmentText', $ARGS[0]

    if $HallHarassmentText <> '':
        *pl $HallHarassmentText
    end
---

#HallHarassmentTextLateFlag
    ! 1 = поздний тон (терпеливее / менее «я сама ударю»)
    HallHarassmentTextLate = 0

    if $HallHarassGirl = '':
        exit
    end

    if $HarassGirlStance = 'provoke' or $HarassGirlStance = 'mixed':
        HallHarassmentTextLate = 1
    elseif FamilyCorruptionStage >= 3:
        HallHarassmentTextLate = 1
    elseif sluttiness[$HallHarassGirl] >= 40:
        HallHarassmentTextLate = 1
    end
---

#HallHarassmentText
    $HallHarassmentTextId = LCASE($ARGS[0])
    $HallHarassmentText = ''

    gs 'HallHarassmentTextLateFlag'

    ! ---------- служебные ----------
    if $HallHarassmentTextId = 'no_repeat':
        $HallHarassmentText = 'После недавней вспышки шума зал заметно притих. Девушки лавируют между лавками с удвоенной осторожностью, чутко прислушиваясь к каждому пьяному оклику, и никто из гостей пока не спешит нарываться на новый хозяйский окрик.'
    elseif $HallHarassmentTextId = 'closed':
        $HallHarassmentText = 'Трактир закрыт. Тяжёлые дубовые ставни наглухо заперты на засовы, длинные столы пусты, а в полумраке пахнет лишь остывшей смолой и старым деревом. Ни гостей, ни лишних рук — тишина и покой.'
    elseif $HallHarassmentTextId = 'no_girl':
        $HallHarassmentText = 'Вы окидываете зал спокойным взглядом. Над столами клубится сытный пар от похлёбки, мерно постукивают кружки, а девушки легко скользят между лавками, уверенно держа дистанцию. Вечер катится своим чередом без лишних трений.'
    elseif $HallHarassmentTextId = 'choice_prompt':
        $HallHarassmentText = 'Соседние столы уже настороженно притихли, захмелевшие взгляды скользят то на разгорячённого наглеца, то в вашу сторону. Напряжение в воздухе сгущается, как перед грозой: зал ждёт, проглотит ли молодой хозяин эту выходку или покажет, кто здесь держит порядок.'

    ! ---------- policy (перед/после, контекст) ----------
    elseif $HallHarassmentTextId = 'policy_none':
        $HallHarassmentText = 'Чётких указаний на такой случай вы ей не давали. Встретившись с вами взглядом, она на миг замирает — в расширенных глазах читается немой вопрос: вмешается ли брат или предоставит ей самой выпутываться из чужих загребущих рук?'
    elseif $HallHarassmentTextId = 'policy_decent':
        $HallHarassmentText = 'Она твёрдо помнит ваш строгий наказ: никакого распутства и вольностей под этой крышей, даже если на кону звонкая монета. Девушка отчаянно держит оборону, стараясь не уронить ни девичьей чести, ни достоинства дома.'
    elseif $HallHarassmentTextId = 'policy_own':
        $HallHarassmentText = 'Вы оставили выбор за ней самой. Теперь она лавирует между наглыми пальцами и столами на свой страх и риск, а посетители с живым любопытством косятся на стойку: вмешается ли Стефан, когда черта начнёт стираться?'
    elseif $HallHarassmentTextId = 'policy_profit':
        $HallHarassmentText = 'В её памяти крепко сидит ваш недвусмысленный наказ: улыбаться, терпеть и выжимать из захмелевших глоток каждую медную монетку ради общей мошны. И сейчас эта выдержка проходит жестокую проверку под тяжестью чужих бесстыжих лап.'

    ! ---------- first amanda (ещё вызывается из Intro) ----------
    elseif $HallHarassmentTextId = 'amanda_first_intro':
        $HallHarassmentText = 'Аманда несёт тяжёлый дубовый поднос к дальнему столу, её тонкие девичьи пальчики побелели от напряжения. Внезапно косматый завсегдатай цепко перехватывает её за запястье и рывком тянет на себя. Посуда испуганно вздрагивает, миски едва не летят на пол. Девушка замирает, её щёки и нежная шея заливаются жарким, густым румянцем. Она робко пятится, силясь высвободить руку, и умоляюще шепчет: «Пусти... пожалуйста, господин, пусти, я всё разолью...»'

    ! ---------- resolve: protect ----------
    elseif $HallHarassmentTextId = 'protect_hard_success':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Вы решительно выходите из-за стойки, нависая над наглецом тяжёлой хозяйской фигурой. Почувствовав непреклонную хватку и холодный блеск в ваших глазах, гость торопливо отдёргивает загребущие руки. Мелисса невозмутимо одёргивает смятые складки платья и встречает вас насмешливым, острым взглядом книжной умницы: «Весьма своевременно, Стефан. Хотя с точки зрения элементарной риторики я как раз собиралась растолковать этому невежде границы дозволенного приличным тоном... впрочем, твой кулак подействовал куда доходчивее».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Вы широким шагом входите в жаркий полумрак кухни, преграждая путь наглецу, сунувшему нос к очагу. Гость пятится к дверям под вашим тяжёлым взглядом. Сандра неторопливо отирает замучненные ладони о льняное полотенце и ровно бросает: «Ильматер свидетель, вовремя ты заглянул, Стефан. Только не строй из меня кисейную барышню — на своей кухне я и сама умею управляться с чужими лапами ухватом, но спасибо».'
            else:
                $HallHarassmentText = 'Вы решительно встаёте между сестрой и распалённым гостем, холодно глядя тому в переносицу. Мужик моментально остывает и прячет руки под стол. Аманда шумно переводит дух, щёки её всё ещё пылают девичьим румянцем, но в ясных глазах светится безграничное облегчение: «Стефан... Спасибо тебе. Я уже совсем не знала, куда деваться...»'
            end
        else:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Вы уверенным хозяйским жестом перехватываете занесённую руку клиента, пресекая всякую попытку распускать пальцы. Гость стушёвывается и отсаживается глубже на лавку. Мелисса с безупречной осанкой поправляет воротник, смерив вас снисходительно-ироничным взглядом: «Благодарю за оперативность, братец. Хотя эмпирический опыт подсказывает, что этот мужлан уже готов был капитулировать перед силой логики. Но демонстрация грубой силы, признаю, тоже имеет право на существование».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Вы властно выставляете наглого гостя за порог кухни, не давая ему опомниться. Сандра веско кивает, переводя дыхание у разделочного стола: «Вот и правильно. Мужским ручищам возле моих кастрюль и жаровни делать нечего. Спасибо, Стефан».'
            else:
                $HallHarassmentText = 'Вы отсекаете наглеца одним резким словом и тяжёлым плечом. Тот испуганно моргает и вжимается в угол лавки. Аманда прижимает поднос к груди, пряча зардевшееся личико и сияющие от благодарности глаза: «Ох, Стефан... Спасибо, что вмешался. Я так боялась разбить посуду или нагрубить гостю...»'
            end
        end

    elseif $HallHarassmentTextId = 'protect_hard_dislike':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Гость нехотя отсаживается, пряча руки в карманы, но Мелисса встречает вас скептическим прищуром, в котором сквозит явная досада: «Стефан, ну к чему этот напыщенный рыцарский пафос? У этого господина в кошельке звенело чистое серебро, и я почти убедила его удвоить заказ за пару невинных улыбок. Ты распугал ходячую выручку из-за пустячной возни!»'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра хмуро провожает выскочившего с кухни гостя долгим взглядом, затем скрещивает руки на пышной груди: «Благодарствую за прыть, конечно. Но я в этих стенах не первый десяток лет хозяйничаю. Сама бы выставила взашей, нечего было перед кухней шум подымать».'
            else:
                $HallHarassmentText = 'Аманда с тихим вздохом переступает с ноги на ногу, теребя край передника: «Стефан... спасибо, конечно. Но я ведь уже почти перевела всё в невинную шутку и выпросила щедрые медяки. Не нужно было налетать на него коршуном, он теперь и гроша не оставит».'
            end
        else:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Гость убирает пальцы, обиженно сопя. Мелисса поджимает тонкие губы и смотрит на вас поверх вздёрнутого подбородка: «Я прекрасно способна защитить свои границы силой интеллекта, Стефан. Не стоит устраивать шумный спектакль на потеху всему залу — ты выставил меня беспомощной дурочкой».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра недовольно морщится, поправляя косынку на висках: «Спасибо за заботу, Стефан. Но на кухне и моего строгого слова хватило бы за глаза. Не приучай гостей думать, будто я без твоей опеки шагу ступить не могу».'
            else:
                $HallHarassmentText = 'Аманда дует губки, в её глазах мелькает задетое девичье самолюбие: «Стефан, ну зачем так грубо?.. Я пыталась договориться с ним по-хорошему! Теперь весь трактир решит, что я глупая пичужка и по каждому пустяку бегу прятаться за спину старшего брата».'
            end
        end

    elseif $HallHarassmentTextId = 'protect_hard_fail':
        $HallHarassmentText = 'Вы вмешиваетесь сгоряча, перегибая палку: захмелевший гость багровеет, вскакивает с лавки и принимается шумно качать права, брызжа слюной. Соседние столы недовольно гудят, требуя покоя и грозя выпивкой. Стычку удаётся замять, но тяжёлый осадок и повисшая в воздухе ругань надолго сбивают весёлое настроение гостей.'

    elseif $HallHarassmentTextId = 'warn_client_success':
        $HallHarassmentText = 'Вы, не повышая голоса, подходите к столу и кладёте тяжёлую ладонь на дубовый край, глядя наглецу прямо в переносицу. Спокойный, ледяной тон хозяина отрезвляет захмелевшую голову лучше ушата колодезной воды: гость торопливо прячет руки, смущённо бормочет извинения и тянется к кружке. Граница дозволенного проведена безупречно — без лишнего шума и потерь для кассы.'
    elseif $HallHarassmentTextId = 'warn_client_fail':
        $HallHarassmentText = 'Миром разрешить дело не удаётся: почувствовав заминку, гость начинает нагло скалиться и пререкаться на весь зал, привлекая внимание зевак. Возникает нелепая перепалка, монеты с этого стола теперь точно уплыли, а девушка ловит ваш взгляд с плохо скрываемым раздражением за испорченный вечер.'

    ! ---------- resolve: self / profit (legacy ids) ----------
    elseif $HallHarassmentTextId = 'self_handle_success':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы ловите её взгляд и лишь едва заметно киваете, предоставляя ей полную свободу действий. ' + $RealName[$HallHarassGirl] + ' с поразительным хладнокровием перехватывает инициативу: ловкая насмешка, мимолётное движение плеч — и вот уже осаженный наглец послушно заказывает самое дорогое вино, пряча масленые глаза. Проходя мимо стойки, она роняет с победной полуулыбкой: «Монета в кассе, порядок соблюдён. Всё под контролем».'
        else:
            $HallHarassmentText = 'Вы не вмешиваетесь, оставаясь на месте. ' + $RealName[$HallHarassGirl] + ' ловко выскальзывает из-под чужой руки, обращая неуклюжую похоть гостя в невинный повод заказать ещё выпивки. Девушка с достоинством отходит к стойке: «Видишь? Я и сама в состоянии остудить горячую голову, не устраивая побоища».'
        end
    elseif $HallHarassmentTextId = 'self_handle_bad':
        $HallHarassmentText = 'Вы медлите, рассчитывая, что она сама разберётся с нахалом. Ей действительно удаётся с трудом вырваться и отступить за соседний стол, но проходя мимо стойки с пылающими щеками, она бросает на вас полный горькой укоризны взгляд: «Мог бы хотя бы подойти ближе, Стефан... Я ведь чуть не упала».'
    elseif $HallHarassmentTextId = 'profit_high':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы демонстративно протираете бокалы за стойкой, закрыв глаза на происходящее. Почувствовав безнаказанность, разгорячённый гость не скупится: на стол щедро сыплются звонкие серебряные монеты. Спустя пару минут ' + $RealName[$HallHarassGirl] + ' сбрасывает увесистую выручку в лоток стойки, бросая вам с кривой усмешкой: «Серебро на бочку. Надеюсь, трактиру эти монеты принесут больше радости, чем мне».'
        else:
            $HallHarassmentText = 'Вы решаете не портить выгодную сделку и остаётесь в стороне. Ошалевший от покладистости девицы гость щедро расплачивается за выпивку и сыплет чаевые. ' + $RealName[$HallHarassGirl] + ' возвращается к вам бледная, ссыпая медяки на стойку с глухим стуком: «Держи свою драгоценную кассу... Только не проси меня радоваться такой выручке».'
        end
    elseif $HallHarassmentTextId = 'profit_low':
        $HallHarassmentText = 'Вы делаете вид, будто увлечены счетами за стойкой. ' + $RealName[$HallHarassGirl] + ' кое-как выпутывается из лап скряги, оставившего лишь жалкие медные гроши. Поравнявшись с вами, она тихо цедит сквозь зубы: «Гроши он бросил, а лапал на целый золотой. Мог бы хоть для виду кашлянуть в его сторону, хозяин...»'

    ! ---------- resolve: watch ----------
    elseif $HallHarassmentTextId = 'watch_calm':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Вы спокойно стоите, сложив руки на груди и наблюдая за происходящим. Мелисса буквально уничтожает наглеца одной высокомерной, отточенной книжной фразой о первобытных повадках низших сословий. Ошарашенный клиент моргает, не зная, куда девать глаза, а Мелисса поворачивается к вам с победной, лукавой ухмылкой зазнайки: «Видал, как подействовала сила слова? Вот видишь, обошлось без твоих кулаков и перебитой посуды».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Вы замираете в дверном проёме кухни, внимательно держа руку наготове. Сандра перехватывает пузатую чугунную сковороду с таким красноречивым выражением лица, что сунувшийся на кухню прощелыга с позором ретируется сам. Хозяйка поворачивается к вам, пряча усмешку: «Вот и ладушки. Присматривал за порогом — и правильно, а со своими сковородками я и сама управляюсь».'
            else:
                $HallHarassmentText = 'Вы не спускаете глаз со сцены, готовый в любой миг сорваться с места. Почувствовав вашу незримую защиту за спиной, Аманда находит в себе силы лукаво улыбнуться и ловко выскользнуть из-за стола, унося полный поднос: «Стефан... Я ведь справилась, правда? Ты ведь подстраховывал меня взглядом?»'
            end
        else:
            $HallHarassmentText = 'Вы держите ситуацию на прицеле глаз, не делая резких движений. ' + $RealName[$HallHarassGirl] + ' чутко улавливает ваше молчаливое присутствие и уверенно выставляет границы, не позволяя гостю распускать руки, но и не ссорясь с ним окончательно.'
        end
    elseif $HallHarassmentTextId = 'watch_bad':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы лишь молча наблюдаете, не сдвинувшись с места. ' + $RealName[$HallHarassGirl] + ' с трудом высвобождается из захвата и спешит к стойке, бросая на вас тяжёлый, уязвлённый взгляд: «Приглядывать — это прекрасно, Стефан. Но стоять столбом, когда меня прижимают к лавке — совсем не то, чего ждёшь от хозяина».'
        else:
            $HallHarassmentText = 'Вы продолжаете холодно наблюдать со стороны. ' + $RealName[$HallHarassGirl] + ' кое-как справляется с нахалом сама, но проходя мимо, роняет со жгучей девичьей обидой в голосе: «Просто пялиться и считать ворон в такие секунды — дрянная помощь, брат...»'
        end
    elseif $HallHarassmentTextId = 'watch_lewd':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы не вмешиваетесь, позволяя происходящему идти своим чередом. Ощутив молчаливое попустительство хозяина, гость наглеет пуще прежнего: его пальцы скользят всё смелее, монеты со звоном катятся по дубовой столешнице, а ' + $RealName[$HallHarassGirl] + ' балансирует на самой опасной грани дозволенного. Зал жадно ловит этот негласный знак: если мошна полна серебра, молодой хозяин закроет глаза на любые шалости.'
        else:
            $HallHarassmentText = 'Вы остаётесь стоять за стойкой, не шелохнувшись. Захмелевший посетитель откровенно распускает руки, чувствуя слабину, чаевые сыплются на стол, а ' + $RealName[$HallHarassGirl] + ' вынуждена терпеть наглые прикосновения, сгорая от стыда. Завсегдатаи переглядываются с сальными усмешками: ради звонкой монеты Стефан готов закрыть глаза на всё.'
        end

    ! ---------- aftermath (полная строка) ----------
    elseif $HallHarassmentTextId = 'aftermath_protect_thanks':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса неторопливо подходит к стойке, плавно поправляя манжеты платья: «Благодарю за решительность, Стефан. Я не питаю иллюзий насчёт мужской природы, но этот неотёсанный субъект явно перепутал наш приличный трактир с портовым притоном».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра веско кивает вам от кухонного порога: «Спасибо, Стефан. На кухне должен быть железный порядок, и ты всё сделал по уму. Нечего чужакам совать нос к печи».'
            else:
                $HallHarassmentText = 'Аманда неслышно подходит к стойке, трогательно заглядывая вам в глаза: «Спасибо тебе большое, Стефан... Я правда старалась отшутиться, но у меня внутри всё так сжалось от страха... Хорошо, что ты рядом».'
            end
        else:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса аккуратно ставит пустой графин на стойку и произносит с непривычной мягкостью в голосе: «Спасибо, Стефан. Мне важно знать, что за твоими расчётами выручки стоит готовность встать за нас горой. Это... внушает уважение».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра утирает пот со лба чистым полотенцем и веско роняет: «Спасибо, что вовремя пресёк эти вольности. Порядок в доме беречь надо смолоду».'
            else:
                $HallHarassmentText = 'Аманда, пряча пылающее от смущения личико и боясь поднять глаза, едва слышно шепчет: «Спасибо, что защитил меня, Стефан... Одной перед всей этой пьяной гурьбой мне было до слёз страшно...»'
            end
        end

    elseif $HallHarassmentTextId = 'aftermath_protect_annoyed':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса разочарованно качает головой, сложив руки на груди: «Я почти выжала из него двойную плату за жаркое, Стефан! Ну к чему было так грубо вламываться? Ты перепугал отличный кошелёк на ножках».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра вполоборота бросает от кухонной плиты: «За заботу спасибо, конечно. Но я в своём закутке сама порядок держу, не надо было шум на весь трактир поднимать».'
            else:
                $HallHarassmentText = 'Аманда виновато мнёт краешек фартука: «Спасибо, Стефан... Но я ведь правда почти уговорила его на щедрые чаевые. Ты налетел слишком уж грозно, он теперь и гроша не добавит».'
            end
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' с досадой притопывает ножкой: «Я вполне взрослая, чтобы постоять за себя самой! Не нужно каждый раз бросаться на защиту при всём честном народе, будто я малая неразумная девчонка!»'
        end

    elseif $HallHarassmentTextId = 'aftermath_protect_fail':
        $HallHarassmentText = $RealName[$HallHarassGirl] + ' тяжело вздыхает, глядя на взбудораженный зал: «Вышло слишком громко и неуклюже, теперь весь вечер судачить будут... Но я хотя бы вижу, что ты честно пытался помочь, Стефан».'

    elseif $HallHarassmentTextId = 'aftermath_watch_ok':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса с лёгкой полуулыбкой опускает поднос на стойку: «Дело сделано, серебро в кошельке. Ты грамотно держал дистанцию и не стал раздувать бурю в стакане воды — хвалю за выдержку».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра спокойно констатирует: «Сама выставила нахала за дверь. Главное, что ты был начеку и держал проход под присмотром — большего и не требовалось».'
            else:
                $HallHarassmentText = 'Аманда переводит дух, румянец на её щеках медленно сменяется робкой улыбкой: «Я... я сама смогла с ним сладить! Немного жутко было отшучиваться от такой наглости, но ведь обошлось совсем без драки!»'
            end
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' бросает на вас долгий, пронизывающий взгляд: «Как видишь, я управилась сама. Но я запомнила, Стефан, с каким спокойным любопытством ты наблюдал за этой сценой из угла».'
        end

    elseif $HallHarassmentTextId = 'aftermath_watch_angry':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса подходит вплотную, её взгляд острее бритвы: «Ты просто стоял и молча глазел. Ощущать себя живой наживкой для пьяных похотливых взглядов — сомнительное удовольствие, Стефан. Научись держать марку заведения».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра тяжело опускает ухват на лавку: «Видел же, как этот боров ко мне тянется, и ждал у моря погоды. В следующий раз имей совесть подойти на шаг ближе, а не ворон считай».'
            else:
                $HallHarassmentText = 'Аманда вспыхивает до кончиков ушей, в её голосе дрожат слёзы: «Ты просто стоял и смотрел!.. Мне было так стыдно и жутко... Мог бы хоть подойти для вида, чтобы он испугался!»'
            end
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' с нескрываемой горечью шепчет: «Твоё равнодушное созерцание со стороны ранит больнее чужих грубых рук, братец...»'
        end

    elseif $HallHarassmentTextId = 'aftermath_ignore_cold':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'Мелисса с ледяным стуком ставит глиняный кувшин на доски: «Предпочёл отвести глазки? Монеты я с него вытрясла до последнего медяка. Но если ты думаешь превратить это в постоянное правило, Стефан — мы очень быстро разойдёмся во взглядах».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'Сандра с грохотом опускает чугунок на плиту: «Решил вовсе не замечать, что творится на кухонном пороге? Я наглеца осадила, но твоё бесстыжее равнодушие запомню крепко».'
            else:
                $HallHarassmentText = 'Аманда отворачивается к стене, кусая губы: «Ты даже головы не повернул... Я знаю, что трактиру нужны деньги, но бросать меня одну на растерзание пьяной толпе — это жестоко, Стефан».'
            end
        else:
            $HallHarassmentText = 'Спустя минуту ' + $RealName[$HallHarassGirl] + ' сдавленно цедит сквозь стиснутые зубы: «Ты правда готов был сквозь землю провалиться ради пары лишних медяков?.. Это было отвратительно и унизительно».'
        end

    elseif $HallHarassmentTextId = 'aftermath_ignore_ok':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' молча разворачивается и уходит к столам с невозмутимым лицом, решив не тратить пустые слова и впредь полагаться исключительно на свои собственные силы.'
        else:
            $HallHarassmentText = $RealName[$HallHarassGirl] + ' с подчёркнуто прямой спиной проходит мимо стойки, даже не повернув головы в вашу сторону, и с головой уходит в работу.'
        end

    ! ---------- aftermath lines (для склейки, без имени) ----------
    elseif $HallHarassmentTextId = 'aftermath_protect_thanks_line':
        if HallHarassmentTextLate = 1:
            if $HallHarassGirl = 'melissa':
                $HallHarassmentText = 'тихо роняет, смахнув невидимую пылинку с плеча: «Спасибо, вовремя осадил наглеца. Этот субъект понятия не имел о приличиях».'
            elseif $HallHarassGirl = 'sandra':
                $HallHarassmentText = 'одобрительно кивает от кухонной двери: «Спасибо, Стефан. На кухне хозяйское веское слово всегда к месту».'
            else:
                $HallHarassmentText = 'благодарно шепчет, зардевшись: «Спасибо, Стефан... Я правда пыталась свести всё в шутку, но без тебя не справилась бы».'
            end
        else:
            $HallHarassmentText = 'не поднимая глаз и густо алея щеками от смущения, тихо шепчет: «Спасибо, что заступился за меня... Одной перед всем этим столом мне было ужасно неловко».'
        end
    elseif $HallHarassmentTextId = 'aftermath_protect_annoyed_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'со вздохом замечает: «Я почти договорилась с ним по-хорошему и выбила чаевые. Не стоило так резко ломать мне сделку».'
        else:
            $HallHarassmentText = 'с досадой прикусывает губу: «Я вполне способна постоять за себя сама. Твоя излишняя строгость только распугивает мою честную выручку».'
        end
    elseif $HallHarassmentTextId = 'aftermath_protect_fail_line':
        $HallHarassmentText = 'печально качает головой: «Вышло слишком уж шумно, доходам такой скандал не на пользу... но я ценю, что ты хотя бы попытался вмешаться».'
    elseif $HallHarassmentTextId = 'aftermath_watch_ok_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'сухо констатирует с полуулыбкой: «Я со всем разобралась сама, монета в кассе. Ты приглядывал со стороны и не дал разгореться скандалу — умно сработано».'
        else:
            $HallHarassmentText = 'ровно произносит, глядя прямо в глаза: «Как видишь, я справилась без потерь. Но имей в виду: я отлично видела, как ты молча любовался этой сценой со стороны».'
        end
    elseif $HallHarassmentTextId = 'aftermath_watch_angry_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'вполголоса роняет с холодной усмешкой: «Стоять и молча глазеть... Быть приманкой для чужой похоти — сомнительная радость. Держи зал строже, Стефан».'
        else:
            $HallHarassmentText = 'с горьким упрёком шепчет: «Твоё молчаливое любопытство в такие мгновения ранит куда больнее чужих щипков, брат...»'
        end
    elseif $HallHarassmentTextId = 'aftermath_ignore_cold_line':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'проходя мимо, ледяным тоном цедит: «Решил сделать вид, что ослеп? Серебро я с него вытрясла. Но не надейся сделать такое попустительство привычкой, Стефан».'
        else:
            $HallHarassmentText = 'сдавленно цедит, не глядя на вас: «Ты правда предпочёл закрыть глаза и глупо улыбаться ради чужих монет?.. Мне было гадко».'
        end
    elseif $HallHarassmentTextId = 'aftermath_ignore_ok_line':
        $HallHarassmentText = 'молча уходит к столам с гордо поднятой головой, решив впредь рассчитывать только на свою хватку и не ждать хозяйской руки.'

    ! ---------- ignore generic ----------
    elseif $HallHarassmentTextId = 'ignore':
        if HallHarassmentTextLate = 1:
            $HallHarassmentText = 'Вы демонстративно отворачиваетесь к полкам с кружками, делая вид, будто полностью поглощены подсчётом остатков. ' + $RealName[$HallHarassGirl] + ' с холодной выдержкой находит способ выпутаться из назойливых объятий сама и возвращается к работе, наградив вас мимолётным, обжигающе-колючим взглядом.'
        else:
            $HallHarassmentText = 'Вы старательно делаете вид, будто протирание стойки — самое важное занятие на свете. ' + $RealName[$HallHarassGirl] + ' в одиночку выкручивается из унизительного положения ради звонкой монеты, но возвращаясь назад, подчёркнуто смотрит сквозь вас, словно на пустое место.'
        end

    ! ---------- family (Аманда-сцена) ----------
    elseif $HallHarassmentTextId = 'family_amanda_protected':
        $HallHarassmentText = 'Позже Мелисса с одобрением отмечает про себя, что Стефан не готов бросать младшую сестру на растерзание похотливым взглядам даже ради хорошей выручки. Сандра на кухне молча и веско кивает: молодой хозяин держит семейную честь на должной высоте.'
    elseif $HallHarassmentTextId = 'family_amanda_bad':
        $HallHarassmentText = 'Этот вечер надолго оставляет горький осадок в семейном кругу. Мелисса без обиняков бросает вам в лицо, что ради лишней медной монеты вы готовы продать девичью гордость сестры. Сандра на кухне хмурится темнее тучи: брат и хозяин обязан быть каменной стеной, а не равнодушным счетоводом.'
    elseif $HallHarassmentTextId = 'family_amanda_self':
        $HallHarassmentText = 'Мелисса с тайным уважением видит, что юная Аманда постепенно учится сама осаживать прилипчивых гостей, не роняя выручки. Сандра у плиты хранит веское молчание: девочки взрослеют на глазах и начинают понимать, по каким жёстким законам живёт этот мир.'

    ! ---------- зал (LEGACY fallback; live → hall_harassment_after_text) ----------
    elseif $HallHarassmentTextId = 'hall_reaction_ignore':
        $HallHarassmentText = 'За соседним столом лениво скользнули взглядами по тонкой девичьей талии и снова уткнулись в пенные кружки. Инцидент заглох сам собой — к стойке никто даже не обернулся.'
    elseif $HallHarassmentTextId = 'hall_reaction_watch':
        $HallHarassmentText = 'За дальним дубовым столом кто-то хрипло присвистнул, захмелевшие головы жадно подались вперёд — поглазеть, куда ляжет чужая ладонь. Мужские взгляды прикованы к девушке и наглецу, хозяин за стойкой никому не интересен.'
    elseif $HallHarassmentTextId = 'hall_reaction_watch_bad':
        $HallHarassmentText = 'По рядам столов прокатился сальный пьяный смешок по поводу задранного подола и чужих загребущих пальцев. Все жадно пялятся на чужой стол, забыв про пиво — зрелище само кормит себя вниманием.'
    elseif $HallHarassmentTextId = 'hall_reaction_watch_lewd':
        $HallHarassmentText = 'Зал заметно оживляется: раздаётся одобрительный свист, пара подвыпивших забулдыг бесстыдно пригибается, пытаясь заглянуть под край юбки. Гости распалены чужой податливостью, и никому нет дела до молчащего за стойкой Стефана.'
    elseif $HallHarassmentTextId = 'hall_reaction_protect':
        $HallHarassmentText = 'Осаженный гость нехотя отдёргивает руки и плюхается обратно на лавку, обиженно бурча под нос. Соседние столы ещё мгновение жадно провожают девичий стан — и нехотя возвращаются к кислому пиву.'
    elseif $HallHarassmentTextId = 'hall_reaction_protect_fail':
        $HallHarassmentText = 'Шумная волна прокатывается по залу и постепенно гаснет. Огрызающийся наглец больше не лезет к девушке, и любопытные шеи лениво поворачиваются обратно к глиняным кружкам.'

    ! ---------- legacy intro ids ----------
    elseif $HallHarassmentTextId = 'waitress_intro_1' or $HallHarassmentTextId = 'waitress_intro_2' or $HallHarassmentTextId = 'waitress_intro_3' or $HallHarassmentTextId = 'waitress_intro_4':
        $HallHarassmentText = ''
    elseif $HallHarassmentTextId = 'kitchen_intro_1' or $HallHarassmentTextId = 'kitchen_intro_2' or $HallHarassmentTextId = 'kitchen_intro_3' or $HallHarassmentTextId = 'kitchen_intro_4':
        $HallHarassmentText = ''

    else:
        $HallHarassmentText = ''
    end

    killvar '$HallHarassmentTextId'
    killvar 'HallHarassmentTextLate'
---

#HallHarassmentTalkPrintText
    gs 'HallHarassmentTalkText', $ARGS[0]

    if $HallHarassmentTalkText <> '':
        *pl $HallHarassmentTalkText
    end
---

#HallHarassmentTalkText
    $HallHarassmentTalkTextId = LCASE($ARGS[0])
    $HallHarassmentTalkText = ''

    gs 'HallHarassmentTextLateFlag'

    if $HallHarassmentTalkTextId = 'no_event':
        $HallHarassmentTalkText = 'Вы пытаетесь завести разговор о порядке в зале и поведении гостей, но беседа быстро затухает сама собой, не встретив ни понимания, ни живого отклика.'
    elseif $HallHarassmentTalkTextId = 'wrong_girl':
        $HallHarassmentTalkText = $RealName[$TalkEventGirl] + ' лишь искренне недоумевает, удивлённо хлопая ресницами — она понятия не имеет, о каком именно случае в зале вы сейчас пытаетесь толковать.'
    elseif $HallHarassmentTalkTextId = 'reaction_protect_dislike':
        if HallHarassmentTextLate = 1:
            $HallHarassmentTalkText = 'Вы возвращаетесь к разговору о недавнем шуме у столов. ' + $RealName[$TalkEventGirl] + ' с лёгким прищуром роняет: «Я почти уговорила его раскошелиться на двойную порцию, Стефан. Не стоило влетать со своим спасением так резко — только серебро спугнул».'
        else:
            $HallHarassmentTalkText = 'Вы пытаетесь обсудить происшедшее. ' + $RealName[$TalkEventGirl] + ' раздражённо передёргивает плечами: «Я отлично могла сама свести всё к невинной шутке ради звонкой монеты. Твоя чрезмерная опека только мешает мне зарабатывать чаевые».'
        end
    elseif $HallHarassmentTalkTextId = 'reaction_protect_success':
        $HallHarassmentTalkText = 'Вы вспоминаете недавний инцидент у столов. ' + $RealName[$TalkEventGirl] + ' негромко и тепло произносит: «Спасибо, что вовремя подошёл тогда. Я честно пыталась улыбаться ради выгоды, но этот тип совсем берегов не видел. Хорошо, что ты не отвернулся и поддержал меня».'
    elseif $HallHarassmentTalkTextId = 'reaction_protect_fail':
        $HallHarassmentTalkText = 'Вы неловко упоминаете недавний шумный спор. ' + $RealName[$TalkEventGirl] + ' тихо вздыхает, пряча взгляд: «Шуму вышло многовато, трактиру такой скандал явно не на пользу... Но я всё равно ценю, что ты не струсил и попытался за меня вступиться».'
    elseif $HallHarassmentTalkTextId = 'reaction_watch':
        if HallHarassmentTextLate = 1:
            $HallHarassmentTalkText = 'Вы заводите разговор о том, как нагло вели себя гости. ' + $RealName[$TalkEventGirl] + ' холодно встречает ваш взгляд: «Ты просто стоял столбом и глазел, как чужие лапы щупают моё платье. Ощущать себя приманкой ради твоего спокойствия — тошно, Стефан. Научись наводить порядок, как подобает хозяину».'
        else:
            $HallHarassmentTalkText = 'Вы пытаетесь подступиться к недавней сцене. ' + $RealName[$TalkEventGirl] + ' с досадой поджимает губы: «Я прекрасно видела, как ты смаковал это зрелище со стороны, даже не шелохнувшись. Твоё молчаливое любопытство в такие секунды просто бесит, Стефан».'
        end
    elseif $HallHarassmentTalkTextId = 'reaction_profit':
        if HallHarassmentTextLate = 1:
            $HallHarassmentTalkText = 'Вы заговариваете о том прибыльном, но скользком вечере. ' + $RealName[$TalkEventGirl] + ' кривит губы в язвительной усмешке: «Звонкую монету я с него выжала, спорить не стану — серебро на дороге не валяется. Но если ты думаешь, что я готова терпеть чужие слюни каждый божий день, то ты сильно ошибаешься».'
        else:
            $HallHarassmentTalkText = 'Вы вспоминаете щедрого наглеца. ' + $RealName[$TalkEventGirl] + ' саркастично усмехается: «Кошель наш потяжелел, тут не поспоришь. Прибыль — дело хорошее, но смотри в оба, Стефан, чтобы наш трактир однажды не перепутали с дешёвым портовым вертепом».'
        end
    elseif $HallHarassmentTalkTextId = 'instruction_intro':
        $HallHarassmentTalkText = 'После подобного происшествия в зале вам необходимо чётко определить для неё правила поведения с настойчивыми посетителями. Если вы не установите твёрдые границы сами, пьяный зал очень быстро начнёт устанавливать свои собственные порядки.'
    else:
        $HallHarassmentTalkText = ''
    end

    killvar '$HallHarassmentTalkTextId'
    killvar 'HallHarassmentTextLate'
---
