! ================================================
! FILE: modules/events/hall/hall_recent_talk.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! FROZEN (variant A thin memory, 2026-07)
! Тема «Недавний случай в зале» отключена.
! Рабочие темы: hall_event (LastHallEvent/harassment), policy, family choice.
! Тексты ниже сохранены в каноне на случай ручного/debug-вызова.
! ================================================

#HallRecentTalkCanShow
    ! frozen: never offer in menus
    HallRecentTalkCanShow = 0
    HallRecentTalkAvailable = 0
---

#HallRecentTalkStart
    ! frozen entry: redirect to hall_event compat / policy fallback
    gs 'NormalizeGirlKey', $ARGS[0]
    $HallRecentTalkGirl = $GirlKey
    $HallRecentTalkReturnLoc = $ARGS[1]

    if $HallRecentTalkReturnLoc = '':
        $HallRecentTalkReturnLoc = 'TavernMain'
    end

    if LOC($HallRecentTalkReturnLoc) = 0:
        $HallRecentTalkReturnLoc = 'TavernMain'
    end

    if LOC('GirlTalkHallEventReaction') = 1:
        gt 'GirlTalkHallEventReaction', $HallRecentTalkGirl, $HallRecentTalkReturnLoc
    end

    gt $HallRecentTalkReturnLoc
---

#HallRecentTalkPrintText
    gs 'HallRecentTalkText', $ARGS[0]

    if $HallRecentTalkText <> '':
        *pl $HallRecentTalkText
    end
---

#HallRecentTalkText
    $HallRecentTalkTextId = LCASE($ARGS[0])
    $HallRecentTalkText = ''

    if $HallRecentTalkTextId = 'intro':
        if $HallRecentTalkGirl = 'amanda':
            if GirlWorkPolicy['amanda'] = 3:
                $HallRecentTalkText = 'Аманда с легкой лукавой улыбкой поправляет передник. В зале было шумно и весело, но она ловко лавировала между столами, стреляла глазками и собрала внушительную горку звонких монет.'
            elseif GirlWorkPolicy['amanda'] = 1:
                $HallRecentTalkText = 'Аманда держится чинно и аккуратно. Она вела себя сдержанно, не давая лишнего повода для пересудов, и теперь с довольным видом поглядывает на тебя, уверенная, что всё сделала как надо.'
            else:
                $HallRecentTalkText = 'Аманда оживленно жестикулирует, вспоминая недавнюю суматоху в зале. Ей явно понравилось внимание гостей, хотя щеки у неё до сих пор горят румянцем.'
            end
        elseif $HallRecentTalkGirl = 'melissa':
            if GirlWorkPolicy['melissa'] = 3:
                $HallRecentTalkText = 'Мелисса слегка усмехается краешком губ. Гости охотно раскошеливались на серебро за пару её едких замечаний и насмешливых взглядов, а выручка на новые книги и бумагу приятно пополнилась.'
            elseif GirlWorkPolicy['melissa'] = 1:
                $HallRecentTalkText = 'Мелисса говорит сухо и спокойно. Она держала строгую дистанцию, осаждая наглецов парой холодных фраз, и ожидает, что в трактире и дальше будет поддерживаться должный порядок.'
            else:
                $HallRecentTalkText = 'Мелисса с легкой иронией комментирует недавний случай у столов, давая понять, что прекрасно контролировала обстановку и не позволила пьяным мужланам перейти черту.'
            end
        elseif $HallRecentTalkGirl = 'sandra':
            if GirlWorkPolicy['sandra'] = 3:
                $HallRecentTalkText = 'Сандра хмыкает, деловито помешивая варево в котле. В зале было жарко и шумно, но звонкая монета в трактирной кассе вполне оправдывает суету, пока дело не выходит за рамки приличий.'
            elseif GirlWorkPolicy['sandra'] = 1:
                $HallRecentTalkText = 'Сандра одобрительно кивает. Когда в зале поддерживается строгий порядок и гости не распускают руки, работа у печи спорится куда спокойнее.'
            else:
                $HallRecentTalkText = 'Сандра вытирает руки полотенцем и смотрит на тебя с хозяйской рассудительностью. Она привыкла к трактирным будням и знает цену каждому медяку и спокойствию под этой крышей.'
            end
        else:
            $HallRecentTalkText = $RealName[$HallRecentTalkGirl] + ' вспоминает недавний случай в зале.'
        end
    end

    killvar '$HallRecentTalkTextId'
---
