! ================================================
! FILE: modules/events/hall/hall_family_state_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Тексты семейного состояния после решений Стефана
! Используется: hall_family_state.qsps
! Стиль: внутренний вывод Стефана, коротко
! ================================================

#HallFamilyStatePrintText
    gs 'HallFamilyStateText', $ARGS[0]

    if $HallFamilyStateText <> '':
        *pl ' '
        gs 'PrintLegacyThoughtP', $HallFamilyStateText
    end
---

#HallFamilyStateText
    $HallFamilyStateTextId = LCASE($ARGS[0])
    $HallFamilyStateText = ''

    if $HallFamilyStateTextId = 'after_choice':
        if HallFamilyStateLastCorruptionDelta > 0:
            ! stage до apply (HallFamilyStateLastStageBefore), не после bump
            if HallFamilyStateLastStageBefore <= 0:
                $HallFamilyStateText = '<font color="#606080"><i>Стефан подмечает: в зале сделан первый шаг к более вольной обстановке. Дома всё ещё держатся прежней скромности, но воздух в трактире стал чуть смелее — девчонки присматриваются, а гости чувствуют, что здесь можно позволить себе чуть больше улыбок.</i></font>'
            elseif HallFamilyStateLastStageBefore = 1:
                $HallFamilyStateText = '<font color="#606080"><i>Стефан ловит себя на мысли, что зал понемногу привыкает к новой игре. Домашние ещё помнят строгие порядки, но хмельные шутки и откровенные взгляды гостей уже не вызывают прежней робости — девчонки начинают понимать свои выгоды.</i></font>'
            elseif HallFamilyStateLastStageBefore = 2:
                $HallFamilyStateText = '<font color="#606080"><i>Стефан замечает, насколько проще и раскованнее стало общение в зале. Прежней скованности почти не осталось: девчонки смело принимают внимание гостей, ловко направляя их щедрость в нужную сторону и уверенно держа границы.</i></font>'
            elseif HallFamilyStateLastStageBefore = 3:
                $HallFamilyStateText = '<font color="#606080"><i>Стефан с усмешкой подмечает, насколько раскрепостился их трактир. Скромность окончательно уступила место задорному флирту и хозяйскому расчету: то, что раньше казалось слишком смелым, теперь воспринимается как часть весёлой трактирной жизни.</i></font>'
            else:
                $HallFamilyStateText = '<font color="#606080"><i>Стефан видит, что от былой чопорности в зале не осталось и следа. Под крышей «Дикого Жеребца» царит полная раскованность: домашние чувствуют себя совершенно свободно, уверенно играя с желаниями гостей ради общего звонкого дохода.</i></font>'
            end
        elseif HallFamilyStateLastTensionDelta > 0:
            $HallFamilyStateText = '<font color="#606080"><i>В зале снова зазвучали привычные разговоры, но за стойкой повис лёгкий холодок. Вслух упрёков никто не бросает, но Стефан чувствует: инцидент оставил шероховатый осадок, и домашним нужно немного времени, чтобы остыть.</i></font>'
        elseif HallFamilyStateLastTrustDelta > 0:
            $HallFamilyStateText = '<font color="#606080"><i>Порой хозяину вовсе не обязательно лезть в драку — достаточно вовремя показать твёрдую руку. Спокойный взгляд и уверенное слово Стефана дали понять: в трактире есть надёжная опора, и лишней наглости гостям здесь не спустят.</i></font>'
        else:
            $HallFamilyStateText = '<font color="#606080"><i>Шум в зале постепенно затих, кружки снова застучали по доскам. Стефан окидывает зал спокойным хозяйским взглядом: дело сделано, порядок на месте, а трактир продолжает жить своей обычной чередой.</i></font>'
        end
    end

    killvar '$HallFamilyStateTextId'
---
