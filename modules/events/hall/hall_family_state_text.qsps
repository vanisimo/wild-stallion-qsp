! ================================================
! FILE: modules/events/hall/hall_family_state_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Тексты семейного состояния после решений Стефана
! Используется: hall_family_state.qsps
! Стиль: внутренний вывод Стефана, коротко
! ================================================

#HallFamilyStatePrintText
    gs 'HallFamilyStateText', $ARGS[0]

    if $HallFamilyStateText <> '':
        *pl ' '
        gs 'PrintLegacyThoughtP', $HallFamilyStateText
    end
---

#HallFamilyStateText
    $HallFamilyStateTextId = LCASE($ARGS[0])
    $HallFamilyStateText = ''

    if $HallFamilyStateTextId = 'after_choice':
        if HallFamilyStateLastCorruptionDelta > 0:
            ! stage до apply (HallFamilyStateLastStageBefore), не после bump
            if HallFamilyStateLastStageBefore <= 0:
                $HallFamilyStateText = '<font color="#606080"><i>Стефан чувствует, как в прежнем порядке появляется первая заметная трещина. Ничего непоправимого ещё не случилось, но подобные уступки не проходят даром.</i></font>'
            elseif HallFamilyStateLastStageBefore = 1:
                $HallFamilyStateText = '<font color="#606080"><i>Это уже не первый подобный случай. Семья всё ещё старается держать привычные рамки, но Стефан видит: границы дозволенного в трактире начинают сдвигаться.</i></font>'
            elseif HallFamilyStateLastStageBefore = 2:
                $HallFamilyStateText = '<font color="#606080"><i>Дом ещё помнит о приличиях, но всё чаще предпочитает промолчать. Главное — чтобы эти вольности не привели к совсем уж громкому скандалу.</i></font>'
            elseif HallFamilyStateLastStageBefore = 3:
                $HallFamilyStateText = '<font color="#606080"><i>Семья уже привыкает к вольным порядкам. Стефану даже становится не по себе: то, что раньше вызвало бы ссору, теперь считают просто частью работы.</i></font>'
            else:
                $HallFamilyStateText = '<font color="#606080"><i>Старые приличия держатся разве что по привычке. Стефан понимает: семья изменилась, и его решения сыграли в этом не последнюю роль.</i></font>'
            end
        elseif HallFamilyStateLastTensionDelta > 0:
            $HallFamilyStateText = '<font color="#606080"><i>С виду ситуация улеглась, но внутри дома осадок остался. Кто-то промолчит, но Стефан знает: недоверия и напряжения прибавилось.</i></font>'
        elseif HallFamilyStateLastTrustDelta > 0:
            $HallFamilyStateText = '<font color="#606080"><i>Иногда хозяину достаточно вовремя показать свою поддержку. Без кулаков и крика дать понять: в этом доме своих в обиду не дают.</i></font>'
        else:
            $HallFamilyStateText = '<font color="#606080"><i>Сцена окончена, выбор сделан. Но Стефан знает трактир: настоящие последствия дадут о себе знать позже, когда первый шум утихнет.</i></font>'
        end
    end

    killvar '$HallFamilyStateTextId'
---
