! ================================================
! FILE: modules/events/hall/hall_family_state_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Тексты семейного состояния после решений Стефана
! Используется: hall_family_state.qsps
! Стиль: внутренний вывод Стефана, коротко
! ================================================

#HallFamilyStatePrintText
    gs 'HallFamilyStateText', $ARGS[0]

    if $HallFamilyStateText <> '':
        *pl ' '
        gs 'PrintLegacyThoughtP', $HallFamilyStateText
    end
---

#HallFamilyStateText
    $HallFamilyStateTextId = LCASE($ARGS[0])
    $HallFamilyStateText = ''

    if $HallFamilyStateTextId = 'after_choice':
        if HallFamilyStateLastCorruptionDelta > 0:
            ! stage до apply (HallFamilyStateLastStageBefore), не после bump
            if HallFamilyStateLastStageBefore <= 0:
                $HallFamilyStateText = '<font color="#606080"><i>Стефан чувствует, как по вековому семейному укладу побежала первая тонкая, но опасная трещина. Ничего непоправимого пока не произошло, но в воздухе уже повеяло уступкой — а такие компромиссы с совестью в трактире никогда не проходят бесследно.</i></font>'
            elseif HallFamilyStateLastStageBefore = 1:
                $HallFamilyStateText = '<font color="#606080"><i>Это уже не случайный сбой, а тревожная привычка. Домашние всё ещё силятся держаться за прежние строгие приличия, но Стефан ловит себя на мысли: граница дозволенного под крышей «Дикого Жеребца» медленно, но неумолимо сползает вниз.</i></font>'
            elseif HallFamilyStateLastStageBefore = 2:
                $HallFamilyStateText = '<font color="#606080"><i>В доме всё ещё помнят о девичьей чести и приличиях, но при виде звонкой монеты всё чаще предпочитают отвести глаза и промолчать. Теперь главное — чтобы эта молчаливая податливость не выплеснулась в позорный скандал на весь город.</i></font>'
            elseif HallFamilyStateLastStageBefore = 3:
                $HallFamilyStateText = '<font color="#606080"><i>Семья пугающе быстро обживается в новых, раскованных порядках. Стефану временами становится не по себе от собственного успеха: то, что ещё месяц назад обернулось бы слезами и бурей, теперь буднично списывают на издержки трактирной службы.</i></font>'
            else:
                $HallFamilyStateText = '<font color="#606080"><i>От прежней благочестивой строгости осталась лишь тонкая скорлупа показных приличий. Стефан отчётливо сознаёт: семья переродилась до неузнаваемости, и именно его расчётливые хозяйские решения шаг за шагом сломали старые запреты.</i></font>'
            end
        elseif HallFamilyStateLastTensionDelta > 0:
            $HallFamilyStateText = '<font color="#606080"><i>С виду в трактире снова воцарился привычный покой, но в комнатах за стойкой повисло тяжёлое, давящее напряжение. Лишних упрёков вслух никто не скажет, но Стефан чует нутром: тонкая ниточка доверия между ним и близкими натянулась до предела.</i></font>'
        elseif HallFamilyStateLastTrustDelta > 0:
            $HallFamilyStateText = '<font color="#606080"><i>Порой хозяину вовсе не обязательно крушить чужие челюсти — достаточно вовремя и твёрдо обозначить своё плечо. Простой хозяйский жест, спокойный холодный взгляд, и семья чувствует: за этими стенами они под защитой, и своих здесь на поругание не отдадут.</i></font>'
        else:
            $HallFamilyStateText = '<font color="#606080"><i>Шум в зале затих, выбор сделан, кружки снова стучат по доскам. Но Стефан знает волчью натуру трактира: истинные плоды любого решения созревают не в пылу перебранки, а позже — в тишине закрытых дверей.</i></font>'
        end
    end

    killvar '$HallFamilyStateTextId'
---
