        $HallMissingGirlText = ''

    elseif $HallMissingTextId = 'ignore_after':
        if HallMissingGirlStage >= 4:
            $HallMissingGirlText = $RealName[$HallMissingGirl] + ' возвращается через несколько минут. Губы припухшие, юбка сбита, на подбородке — блестящая капля, которую она быстро смахивает. ' + $HallLewdClientWho + ' застёгивает штаны, щедрее обычного. Зал делает вид, что не понял.'
