! ================================================
! FILE: modules/events/hall/hall_missing_girl_text.qsps
! MODULE: events/hall
! STUB + LOGIC missing print (ready for prose fill)
! Archive: archive/hall_missing_text_v016_backup/
! ================================================

#HallMissingGirlPrintText
    $HallMissingPrintTextId = LCASE($ARGS[0])

    if $HallMissingPrintTextId = 'intro':
        $HallMissingSceneKey = ''
        gs 'HallMissingPrintIntro'
    elseif $HallMissingPrintTextId = 'ignore_after':
        gs 'HallMissingPrintIgnoreAfter'
    elseif $HallMissingPrintTextId = 'peek_scene':
        $HallMissingSceneKey = ''
        gs 'HallMissingResolveSceneKey'
        gs 'HallMissingPrintPeekScene'
    elseif $HallMissingPrintTextId = 'peek_meet':
        if $HallMissingSceneKey = '':
            gs 'HallMissingResolveSceneKey'
        end
        gs 'HallMissingPrintPeekMeet'
    elseif $HallMissingPrintTextId = 'interrupt_scene':
        gs 'HallMissingPrintInterrupt'
    end

    killvar '$HallMissingPrintTextId'
---

#HallMissingEnsurePrintContext
    gs 'HallMissingGirlNormalizeKey', $HallMissingGirl
    $HallMissingGirl = $HallMissingGirlKey
    if $HallMissingGirl = '':
        $HallMissingGirl = 'amanda'
    end
    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end
    if $HallMissingClient = '':
        $HallMissingClient = 'rich_merchant'
    end
    $HallLewdClient = $HallMissingClient
    if LOC('HallLewdFillClientBits') = 1:
        gs 'HallLewdFillClientBits'
    else
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end
    if LOC('HallMissingPhaseEnsure') = 1:
        gs 'HallMissingPhaseEnsure', $HallMissingGirl
    end
    if LOC('HallMissingBargainIsExplicit') = 1:
        gs 'HallMissingBargainIsExplicit'
    end
---

#HallMissingGetActBand
    HallMissingActBand = 1
    if HallMissingGirlStage >= 4 and (HallMissingGirlPrivateCount[$HallMissingGirl] >= 2 or GirlHallLewdStage[$HallMissingGirl] >= 3):
        HallMissingActBand = 3
    elseif HallMissingGirlStage >= 4 or HallMissingGirlPrivateCount[$HallMissingGirl] >= 1:
        HallMissingActBand = 2
    end
---

#HallMissingResolveSceneKey
    gs 'HallMissingEnsurePrintContext'
    gs 'HallMissingGetActBand'

    $act = LCASE($HallMissingPrivateAct)
    $g = $HallMissingGirl
    $pr = LCASE($HallMissingPromise)
    $fin = LCASE($HallMissingFinish)
    HallMissingRSub = HallMissingHardSub[$g]
    if HallMissingRSub < 0:
        HallMissingRSub = 0
    end

    if $act = 'client_mouth':
        $act = 'cuni'
    end
    if $act = 'touch':
        $act = 'pussy_touch'
    end

    if $pr = 'noble' or $fin = 'noble' or $HallMissingClient = 'noble':
        $HallMissingSceneKey = 'noble_' + $g
        $HallMissingSceneBlurb = 'Нобиль multi-screen. soft/high + finish. Prose: archive noble_*'
    elseif $act = 'look_tits':
        $HallMissingSceneKey = 'look_tits_' + $g
        $HallMissingSceneBlurb = 'Hold: смотрит грудь/вырез.'
    elseif $act = 'hug_waist':
        $HallMissingSceneKey = 'hug_waist_' + $g
        $HallMissingSceneBlurb = 'Hold: обнять/талия. Сандра: юбка/попа (u1 no panties).'
    elseif $act = 'cock_touch_cloth':
        $HallMissingSceneKey = 'cock_touch_cloth_' + $g
        $HallMissingSceneBlurb = 'Hold: ладонь сквозь ткань.'
    elseif $act = 'tits_lick':
        $HallMissingSceneKey = 'tits_lick_' + $g
        $HallMissingSceneBlurb = 'Break: мнёт/лижет соски.'
    elseif $act = 'petting':
        $HallMissingSceneKey = 'petting_' + $g
        $HallMissingSceneBlurb = 'Petting. S3: «ерунда или делом».'
    elseif $act = 'pussy_touch':
        $HallMissingSceneKey = 'pussy_touch_' + $g
        $HallMissingSceneBlurb = 'Пальцы/лоно (+оргазм). H0.a sub2 / S3.'
    elseif $act = 'hand':
        $HallMissingSceneKey = 'hand_' + $g
        $HallMissingSceneBlurb = 'Handjob. Finish пол/руки.'
    elseif $act = 'touch_thigh':
        $HallMissingSceneKey = 'touch_thigh_' + $g
        $HallMissingSceneBlurb = 'Бедро/нюх (H0.a / bud).'
    elseif $act = 'cuni':
        $HallMissingSceneKey = 'cuni_' + $g
        $HallMissingSceneBlurb = 'Cuni. H0.b / bud / Sandra post-A2.'
    elseif $act = 'anilingus':
        $HallMissingSceneKey = 'anilingus_' + $g
        $HallMissingSceneBlurb = 'Anilingus + пальцы (H0.last).'
    elseif $act = 'titjob':
        $HallMissingSceneKey = 'titjob_' + $g
        $HallMissingSceneBlurb = 'Titjob (Sandra A1 glue / free).'
    elseif $act = 'deepthroat':
        $HallMissingSceneKey = 'deepthroat_' + $g + '_s' + STR(HallMissingRSub)
        $HallMissingSceneBlurb = 'DT sub=' + STR(HallMissingRSub) + ' finish=' + $fin
    elseif $act = 'mouth' or $act = 'mouth_balls':
        if $fin = 'cum_face' or $fin = 'cum_face_soft' or $fin = 'cum_face_high' or $pr = 'facial':
            $HallMissingSceneKey = 'mouth_' + $g + '_facial_s' + STR(HallMissingRSub)
            $HallMissingSceneBlurb = 'Facial LITE sub=' + STR(HallMissingRSub) + ' (' + $fin + ').'
        elseif $fin = 'swallow':
            $HallMissingSceneKey = 'mouth_' + $g + '_swallow'
            $HallMissingSceneBlurb = 'Проглот / mouth mature (Sandra).'
        elseif $fin = 'show_mouth':
            $HallMissingSceneKey = 'mouth_' + $g + '_show'
            $HallMissingSceneBlurb = 'Покажи что во рту.'
        elseif $fin = 'wipe' or $fin = 'taste' or $fin = 'spit' or $fin = 'hold_spit':
            $HallMissingSceneKey = 'mouth_' + $g + '_' + $fin
            $HallMissingSceneBlurb = 'Mouth early sub: ' + $fin
        else
            $HallMissingSceneKey = 'mouth_' + $g + '_mid_s' + STR(HallMissingRSub)
            $HallMissingSceneBlurb = 'Mouth mid sub=' + STR(HallMissingRSub) + ' finish=' + $fin
        end
    else
        $HallMissingSceneKey = 'fallback_' + $g
        $HallMissingSceneBlurb = 'Fallback act=' + $act + ' promise=' + $pr
    end

    if HallMissingPromiseBreak = 1:
        $HallMissingSceneBlurb = $HallMissingSceneBlurb + ' [BREAK]'
    end
    if HallMissingBargainExplicit = 1:
        $HallMissingSceneBlurb = $HallMissingSceneBlurb + ' [EXPLICIT]'
    end
    $HallMissingSceneBlurb = $HallMissingSceneBlurb + ' phase=' + $HallMissingPhase[$g]

    killvar '$act'
    killvar '$g'
    killvar '$pr'
    killvar '$fin'
    killvar 'HallMissingRSub'
---

#HallMissingStubPrintLine
    *pl '[' + $HallMissingSceneKey + ']'
    *pl $HallMissingSceneBlurb
    if debug = 1:
        *pl '[STUB] promise=' + $HallMissingPromise + ' act=' + $HallMissingPrivateAct + ' finish=' + $HallMissingFinish + ' client=' + $HallMissingClient
        *pl '[STUB] hardStep=' + STR(HallMissingHardStep[$HallMissingGirl]) + ' hardSub=' + STR(HallMissingHardSub[$HallMissingGirl]) + ' face=' + STR(HallMissingFlagFaceDone[$HallMissingGirl])
    end
---

#HallMissingPrintPeekScene
    if $HallMissingSceneKey = '':
        gs 'HallMissingResolveSceneKey'
    end
    *pl '─── ПОДСМОТРЕТЬ (stub) ───'
    gs 'HallMissingStubPrintLine'
    if HallMissingPromiseBreak = 1:
        *pl ' '
        *pl '[M-BREAK-TAIL] Клиент перешёл границу уговора (promise=' + $HallMissingPromise + ').'
    end
---

#HallMissingPrintPeekMeet
    if $HallMissingSceneKey = '':
        gs 'HallMissingResolveSceneKey'
    end
    *pl '─── ВСТРЕЧА ПОСЛЕ (stub meet) ───'
    *pl '[' + $HallMissingSceneKey + '_meet]'
    *pl 'Отмазка/разговор со Стефаном. Prose → archive + agent fill.'
---

#HallMissingPrintIntro
    gs 'HallMissingEnsurePrintContext'
    *pl '[M-INTRO] ' + $RealName[$HallMissingGirl] + ' исчезла с ' + $HallLewdClientWhoA + '.'
    *pl 'place=' + $HallMissingPlace + ' act=' + $HallMissingPrivateAct + ' phase=' + $HallMissingPhase[$HallMissingGirl]
    if HallMissingBargainDone = 1:
        *pl 'уговор: ' + $HallMissingPromise + ' break=' + STR(HallMissingPromiseBreak) + ' explicit=' + STR(HallMissingBargainExplicit)
    end
    *pl 'Выбор: вмешаться / подсмотреть / не вмешиваться.'
---

#HallMissingPrintIgnoreAfter
    gs 'HallMissingEnsurePrintContext'
    *pl '[M-IGNORE] Не вмешались. ' + $RealName[$HallMissingGirl] + ' вернулась (stub).'
---

#HallMissingPrintInterrupt
    gs 'HallMissingEnsurePrintContext'
    *pl '[M-INTERRUPT] Вмешались. Реакция ' + $RealName[$HallMissingGirl] + ' (stub).'
---

#HallMissingConflictMoodText
    $HallMissingConflictMoodText = ''
---

#HallMissingPrintPromiseBreakTail
    if HallMissingPromiseBreak <> 1:
        exit
    end
    *pl ' '
    *pl '[M-BREAK-TAIL] Граница уговора нарушена (' + $HallMissingPromise + ').'
---
