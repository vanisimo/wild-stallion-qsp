! ================================================
! FILE: modules/events/hall/hall_missing_girl_text.qsps
! MODULE: events/hall
! STUB + LOGIC — missing print (catalog v0.16)
! Архив прозы: archive/hall_missing_text_v016_backup/hall_missing_girl_text.qsps
!
! Печать сцен: номер + кратко. Полную prose вернём из архива/агентов.
! ================================================

#HallMissingGirlPrintText
    $HallMissingPrintTextId = LCASE($ARGS[0])

    if $HallMissingPrintTextId = 'intro':
        $HallMissingSceneKey = ''
        gs 'HallMissingPrintIntro'
    elseif $HallMissingPrintTextId = 'ignore_after':
        gs 'HallMissingPrintIgnoreAfter'
    elseif $HallMissingPrintTextId = 'peek_scene':
        $HallMissingSceneKey = ''
        gs 'HallMissingResolveSceneKey'
        gs 'HallMissingPrintPeekScene'
    elseif $HallMissingPrintTextId = 'peek_meet':
        if $HallMissingSceneKey = '':
            gs 'HallMissingResolveSceneKey'
        end
        gs 'HallMissingPrintPeekMeet'
    elseif $HallMissingPrintTextId = 'interrupt_scene':
        gs 'HallMissingPrintInterrupt'
    end

    killvar '$HallMissingPrintTextId'
---

#HallMissingEnsurePrintContext
    gs 'HallMissingGirlNormalizeKey', $HallMissingGirl
    $HallMissingGirl = $HallMissingGirlKey
    if $HallMissingGirl = '':
        $HallMissingGirl = 'amanda'
    end
    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end
    if $HallMissingClient = '':
        $HallMissingClient = 'rich_merchant'
    end
    $HallLewdClient = $HallMissingClient
    if LOC('HallLewdFillClientBits') = 1:
        gs 'HallLewdFillClientBits'
    else
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end
---

#HallMissingGetActBand
    HallMissingActBand = 1
    if HallMissingGirlStage >= 4 and (HallMissingGirlPrivateCount[$HallMissingGirl] >= 2 or GirlHallLewdStage[$HallMissingGirl] >= 3):
        HallMissingActBand = 3
    elseif HallMissingGirlStage >= 4 or HallMissingGirlPrivateCount[$HallMissingGirl] >= 1:
        HallMissingActBand = 2
    end
---

! key + blurb from act / promise / phase
#HallMissingResolveSceneKey
    gs 'HallMissingEnsurePrintContext'
    gs 'HallMissingGetActBand'
    if LOC('HallMissingPhaseEnsure') = 1:
        gs 'HallMissingPhaseEnsure', $HallMissingGirl
    end
    if LOC('HallMissingBargainIsExplicit') = 1:
        gs 'HallMissingBargainIsExplicit'
    end

    $act = LCASE($HallMissingPrivateAct)
    $g = $HallMissingGirl
    $pr = LCASE($HallMissingPromise)

    if $act = 'client_mouth':
        $act = 'cuni'
    end
    if $act = 'touch':
        $act = 'pussy_touch'
    end

    if $pr = 'noble' or $HallMissingClient = 'noble':
        $HallMissingSceneKey = 'noble_' + $g
        $HallMissingSceneBlurb = 'Нобиль multi-screen (архив). soft/high ответы, finish mouth/face/anilingus.'
    elseif $act = 'look_tits':
        $HallMissingSceneKey = 'look_tits_' + $g
        $HallMissingSceneBlurb = 'Hold: клиент смотрит грудь/вырез. Compliance.'
    elseif $act = 'hug_waist':
        $HallMissingSceneKey = 'hug_waist_' + $g
        $HallMissingSceneBlurb = 'Hold: обнимашки / талия.'
    elseif $act = 'cock_touch_cloth':
        $HallMissingSceneKey = 'cock_touch_cloth_' + $g
        $HallMissingSceneBlurb = 'Hold: ладонь сквозь ткань.'
    elseif $act = 'tits_lick':
        $HallMissingSceneKey = 'tits_lick_' + $g
        $HallMissingSceneBlurb = 'Break/S3: мнёт, лижет соски. Сандра→возможен titjob glue.'
    elseif $act = 'petting':
        $HallMissingSceneKey = 'petting_' + $g
        $HallMissingSceneBlurb = 'Petting / руки по телу. S3: делом.'
    elseif $act = 'pussy_touch':
        $HallMissingSceneKey = 'pussy_touch_' + $g
        $HallMissingSceneBlurb = 'Пальцы / касание лона (+оргазм вариант).'
    elseif $act = 'hand':
        $HallMissingSceneKey = 'hand_' + $g
        $HallMissingSceneBlurb = 'Handjob. Finish пол/руки по initiative.'
    elseif $act = 'touch_thigh':
        $HallMissingSceneKey = 'touch_thigh_' + $g
        $HallMissingSceneBlurb = 'Бедро / нюх (H0.a mid).'
    elseif $act = 'cuni':
        $HallMissingSceneKey = 'cuni_' + $g
        $HallMissingSceneBlurb = 'Cuni. Мелисса H0 / Аманда H0.b / Сандра post-A2.'
    elseif $act = 'anilingus':
        $HallMissingSceneKey = 'anilingus_' + $g
        $HallMissingSceneBlurb = 'Anilingus (+пальцы). H0.last / Сандра post-A2.'
    elseif $act = 'titjob':
        $HallMissingSceneKey = 'titjob_' + $g
        $HallMissingSceneBlurb = 'Titjob (Сандра post-A1 / glue).'
    elseif $act = 'mouth' or $act = 'mouth_balls':
        if $HallMissingFinish = 'cum_face' or $pr = 'facial':
            $HallMissingSceneKey = 'mouth_' + $g + '_facial'
            $HallMissingSceneBlurb = 'Окончание на лицо (A5 LITE / mouth sub).'
        elseif HallMissingHardSub[$g] >= 4 and $pr = 'mouth_hard':
            $HallMissingSceneKey = 'mouth_' + $g + '_swallow'
            $HallMissingSceneBlurb = 'Проглот / late mouth sub.'
        else
            $HallMissingSceneKey = 'mouth_' + $g + '_mid'
            $HallMissingSceneBlurb = 'Отсос mid: spit/show/hold (sub по hardSub).'
        end
    elseif $act = 'deepthroat':
        $HallMissingSceneKey = 'deepthroat_' + $g
        $HallMissingSceneBlurb = 'Deepthroat ladder sub (кашель→full→cum throat).'
    else
        $HallMissingSceneKey = 'petting_' + $g
        $HallMissingSceneBlurb = 'Fallback petting. act=' + $act
    end

    if HallMissingPromiseBreak = 1:
        $HallMissingSceneBlurb = $HallMissingSceneBlurb + ' [BREAK уговора]'
    end
    if HallMissingBargainExplicit = 1:
        $HallMissingSceneBlurb = $HallMissingSceneBlurb + ' [EXPLICIT]'
    end

    killvar '$act'
    killvar '$g'
    killvar '$pr'
---

#HallMissingStubPrintLine
    *pl '[' + $HallMissingSceneKey + ']'
    *pl $HallMissingSceneBlurb
    if debug = 1:
        *pl '[STUB meta] promise=' + $HallMissingPromise + ' act=' + $HallMissingPrivateAct + ' phase=' + $HallMissingPhase[$HallMissingGirl] + ' client=' + $HallMissingClient
    end
---

#HallMissingPrintPeekScene
    if $HallMissingSceneKey = '':
        gs 'HallMissingResolveSceneKey'
    end
    *pl '─── ПОДСМОТРЕТЬ (stub) ───'
    gs 'HallMissingStubPrintLine'
    if HallMissingPromiseBreak = 1 and LOC('HallMissingPrintPromiseBreakTail') = 1:
        gs 'HallMissingPrintPromiseBreakTail'
    end
---

#HallMissingPrintPeekMeet
    if $HallMissingSceneKey = '':
        gs 'HallMissingResolveSceneKey'
    end
    *pl '─── ВСТРЕЧА ПОСЛЕ (stub meet) ───'
    *pl '[' + $HallMissingSceneKey + '_meet]'
    *pl 'Короткая отмазка/разговор со Стефаном после сцены. Позже — prose из архива.'
---

#HallMissingPrintIntro
    gs 'HallMissingEnsurePrintContext'
    *pl '[M-INTRO] ' + $RealName[$HallMissingGirl] + ' пропала с ' + $HallLewdClientWhoA + '. place=' + $HallMissingPlace + '. Выбор: вмешаться / подсмотреть / не вмешиваться.'
---

#HallMissingPrintIgnoreAfter
    gs 'HallMissingEnsurePrintContext'
    *pl '[M-IGNORE] Не вмешались. ' + $RealName[$HallMissingGirl] + ' вернулась позже (stub).'
---

#HallMissingPrintInterrupt
    gs 'HallMissingEnsurePrintContext'
    *pl '[M-INTERRUPT] Вмешались, оборвали. Реакция ' + $RealName[$HallMissingGirl] + ' (stub).'
---

#HallMissingPrintPromiseBreakTail
    if HallMissingPromiseBreak <> 1:
        exit
    end
    *pl ' '
    *pl '[M-BREAK-TAIL] Клиент перешёл границу уговора (stub по promise=' + $HallMissingPromise + ').'
---

#HallMissingConflictMoodText
    $HallMissingConflictMoodText = ''
---
