! ================================================
! FILE: modules/events/hall/hall_missing_girl_text.qsps
! Основные тексты события
! ================================================

#HallMissingGirlText
    $HallMissingTextId = LCASE($ARGS[0])
    $HallMissingGirlText = ''

    gs 'HallMissingGirlNormalizeKey', $HallMissingGirl
    $HallMissingGirl = $HallMissingGirlKey

    if $HallMissingGirl = '':
        exit
    end

    if $RealName[$HallMissingGirl] = '':
        gs 'HallMissingGirlEnsureName', $HallMissingGirl
    end

    ! клиент (v2) — тот же, что в harass/play
    if $HallMissingClient = '':
        $HallMissingClient = 'rich_merchant'
    end
    $HallLewdClient = $HallMissingClient
    if LOC('HallLewdFillClientBits') = 1:
        gs 'HallLewdFillClientBits'
    else
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end

    if $HallMissingTextId = 'intro':
        ! хвост «после play» — ушла не из воздуха
        if HallMissingFromPlay = 1:
            $HallMissingFromPlayLead = 'Только что в зале ' + $RealName[$HallMissingGirl] + ' ещё подыгрывала ' + $HallLewdClientWhoA + ' — крутила попой, терпела руки, стонала тише смеха. И вот её уже нет на месте. '
        else
            $HallMissingFromPlayLead = ''
        end

        if $HallMissingPlace = 'under_table':
            if HallMissingGirlStage >= 4:
                $HallMissingGirlText = $HallMissingFromPlayLead + 'У дальнего стола ' + $HallLewdClientWho + ' откинулся, довольный до подбородка. Под скатертью — шорох, приглушённый всхлип. ' + $RealName[$HallMissingGirl] + ' пропала вниз: разговор давно не про кружку.'
            else
                $HallMissingGirlText = $HallMissingFromPlayLead + $RealName[$HallMissingGirl] + ' задержалась у дальнего стола. ' + $HallLewdClientWho + ' говорит почти в ухо ' + $HallLewdClientManner + ', рука под столом — покупает не только пиво.'
            end
        elseif $HallMissingPlace = 'kitchen':
            if HallMissingGirlStage >= 4:
                $HallMissingGirlText = $HallMissingFromPlayLead + $RealName[$HallMissingGirl] + ' ушла на кухню с ' + $HallLewdClientWhoA + '. За дверью не жалоба на еду: тяжёлое дыхание, звон ' + $HallLewdClientCoin + ' о стол, приглушённый стон.'
            else
                $HallMissingGirlText = $HallMissingFromPlayLead + $RealName[$HallMissingGirl] + ' повела ' + $HallLewdClientWhoA + ' к кухне — будто из-за заказа. Он шагает слишком охотно, рука у неё на талии.'
            end
        elseif $HallMissingPlace = 'stairs':
            if HallMissingGirlStage >= 4:
                $HallMissingGirlText = $HallMissingFromPlayLead + $RealName[$HallMissingGirl] + ' пропала у лестницы. ' + $HallLewdClientWho + ' шептал, показывал ' + $HallLewdClientCoin + ' — теперь под ступенями тишина, прерываемая тихим стоном.'
            else
                $HallMissingGirlText = $HallMissingFromPlayLead + $RealName[$HallMissingGirl] + ' у лестницы с ' + $HallLewdClientWhoA + ': слишком близко, рука на попе, слишком тихо для зала.'
            end
        elseif $HallMissingPlace = 'second_floor':
            $HallMissingGirlText = $HallMissingFromPlayLead + $RealName[$HallMissingGirl] + ' ушла наверх с ' + $HallLewdClientWhoA + '. Сверху не «показать комнату» — скрип двери, шорох одежды, запах сделки.'
