            if HallMissingGirlStage >= 4:
                $HallMissingGirlText = $HallMissingFromPlayLead + $RealName[$HallMissingGirl] + ' исчезла у подсобки. ' + $HallLewdClientWho + ' держал её за талию, шептал про ' + $HallLewdClientCoin + ' и «только минуту» — дверь щёлкнула. Изнутри — глухой стон.'
