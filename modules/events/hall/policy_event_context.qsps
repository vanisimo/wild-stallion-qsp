! ================================================
! FILE: modules/events/hall/policy_event_context.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Контекст до выбора: family / girl / tavern
! События: hall_lewd, hall_missing, kitchen, kitchen_lewd, harassment…
! ================================================

#PolicyEventContextPrint
    gs 'NormalizeGirlKey', $ARGS[0]
    $PolicyContextGirl = $GirlKey
    $PolicyContextEvent = LCASE($ARGS[1])

    if $PolicyContextGirl = '':
        exit
    end

    if $PolicyContextEvent = '':
        $PolicyContextEvent = 'hall'
    end

    if $RealName[$PolicyContextGirl] = '':
        if LOC('EnsureGirlData') = 1:
            gs 'EnsureGirlData', $PolicyContextGirl
        end
    end

    gs 'PolicyEventContextTextFamily'

    if $PolicyContextFamilyText <> '':
        *pl $PolicyContextFamilyText
        *pl ' '
    end

    gs 'PolicyEventContextTextGirl'

    if $PolicyContextGirlText <> '':
        *pl $PolicyContextGirlText
        *pl ' '
    end

    gs 'PolicyEventContextTextTavern'

    if $PolicyContextTavernText <> '':
        *pl $PolicyContextTavernText
        *pl ' '
    end

    killvar '$PolicyContextGirl'
    killvar '$PolicyContextEvent'
---

#PolicyEventContextTextFamily
    $PolicyContextFamilyText = ''

    if FamilyCorruptionStage >= 4:
        $PolicyContextFamilyText = 'Стефан ловит себя на мысли: домашняя раскрепощенность зашла уже так далеко, что вольности в зале кажутся естественным продолжением. За семейным столом теперь мало кого смутишь откровенностью, но сейчас важно показать, кто в доме и в трактире настоящий хозяин.'
    elseif FamilyCorruptionStage >= 2 or FamilyLiberationGateOpen = 1:
        $PolicyContextFamilyText = 'Семейные заботы дают о себе знать. Сейчас Стефан решает не просто сиюминутный спор с клиентом: за вечерним столом неизбежно вспомнят происшедшее, и важно показать, что заведение держится в крепких хозяйских руках.'
    elseif FamilyTension > FamilyTrust + 15:
        $PolicyContextFamilyText = 'Дома и без того хватает трений. Стоит допустить промашку — и вечерний разговор за ужином легко перерастет в очередную бурную перепалку.'
    elseif FamilyTrust > FamilyTension + 20:
        $PolicyContextFamilyText = 'В семье есть крепкий запас доверия. Стефан может позволить себе смелые решения, но его поступок увидят все — и сами девушки, и гости в зале, ожидающие от молодого трактирщика уверенности и твердости.'
    end
---

#PolicyEventContextTextGirl
    $PolicyContextGirlText = ''
    $PolicyContextGirlNoPantiesText = ''

    if GirlNoPantiesWork[$PolicyContextGirl] = 1:
        if LOC('GirlNoPantiesWorkText') = 1:
            gs 'GirlNoPantiesWorkNormalizeKey', $PolicyContextGirl
            gs 'GirlNoPantiesWorkText', 'policy_context'
            $PolicyContextGirlNoPantiesText = $GirlNoPantiesEventText
        end
    end

    if sluttiness[$PolicyContextGirl] >= 55 or GirlNpcPath[$PolicyContextGirl] >= 55:
        if $PolicyContextEvent = 'kitchen' or $PolicyContextEvent = 'kitchen_lewd' or $PolicyContextEvent = 'kitchen_customer':
            $PolicyContextGirlText = $RealName[$PolicyContextGirl] + ' держится уверенно и раскованно. Даже на кухне, среди жара печи, один её выразительный взгляд и пауза действуют на гостя сильнее любых слов.'
        else:
            $PolicyContextGirlText = $RealName[$PolicyContextGirl] + ' уже привыкла к мужскому вниманию сильнее, чем раньше. Может отступить, может подыграть — Стефан видит это в её легкой, уверенной походке.'
        end
    elseif sluttiness[$PolicyContextGirl] >= 30 or GirlNpcPath[$PolicyContextGirl] >= 30:
        $PolicyContextGirlText = $RealName[$PolicyContextGirl] + ' уже не смущается от каждого взгляда, как в первые дни. Она научилась быстро оценивать гостей: где безобидное мужское хвастовство, где щедрая монета за улыбку, а где наглец, которого пора осадить.'
    elseif sluttiness[$PolicyContextGirl] <= 10 and GirlNpcPath[$PolicyContextGirl] <= 10:
        $PolicyContextGirlText = $RealName[$PolicyContextGirl] + ' держится напряженно и строго. Для неё подобные вольности гостей в новинку, и она ждет, что хозяин трактира четко обозначит границы дозволенного.'
    end

    if $PolicyContextGirlNoPantiesText <> '':
        if $PolicyContextGirlText <> '':
            $PolicyContextGirlText = $PolicyContextGirlNoPantiesText + '<br><br>' + $PolicyContextGirlText
        else:
            $PolicyContextGirlText = $PolicyContextGirlNoPantiesText
        end
    end

    killvar '$PolicyContextGirlNoPantiesText'
---

#PolicyEventContextTextTavern
    $PolicyContextTavernText = ''
    PolicyContextReputation = TavernReputation

    if PolicyContextReputation <= 0:
        PolicyContextReputation = tavern_reputation
    end

    if TavernScandal >= 65 or TavernLewdFame >= 45:
        $PolicyContextTavernText = 'Зал реагирует мгновенно. «Дикий Жеребец» уже успел заработать славу места с весьма свободными нравами, и каждый гость норовит проверить, как далеко здесь позволят зайти.'
    elseif TavernScandal >= 35:
        $PolicyContextTavernText = 'Слухи о заведении уже расходятся по городу. Кто-то ворчит у церкви, а кто-то заглянул в зал специально — проверить, насколько вольные порядки царят под этой крышей.'
    elseif PolicyContextReputation > 0 and PolicyContextReputation < 25:
        $PolicyContextTavernText = 'Репутация заведения оставляет желать лучшего. Даже если подавальщица просто осадит нахала, досужие сплетники завтра присочинят лишнего.'
    elseif PolicyContextReputation >= 60 and TavernScandal < 20:
        $PolicyContextTavernText = 'У трактира держится доброе имя. Именно поэтому лишняя шумиха в зале сразу бросается в глаза: почтенные гости ждут сытной еды и порядка, а не балагана.'
    end

    killvar 'PolicyContextReputation'
---

#PolicyEventContextPrintStart
    if LOC('PolicyEventContextPrint') = 1:
        gs 'PolicyEventContextPrint', $ARGS[0], $ARGS[1]
    end
---
