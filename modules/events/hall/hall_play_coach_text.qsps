! ================================================
! FILE: modules/events/hall/hall_play_coach_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Обучение play — подслушанные разговоры (не диалог ГГ с наставником):
! 1) Аманда ↔ Лизетта (воскресенье, комната Аманды)
! 2) Мелисса ↔ Кларисса (воскресенье, лавка Легаре)
! 3) Сандра ↔ Бекки (воскресенье, лавка Бекки)
! Канон: docs/design-hall-scene-unified.md §0.4
! ================================================

#HallPlayCoachText
    $HallPlayCoachTextId = LCASE($ARGS[0])
    $HallPlayCoachText = ''
    $HallPlayCoachText2 = ''
    $HallPlayCoachText3 = ''
    $HallPlayCoachText4 = ''

    if $HallPlayCoachTextId = 'amanda':
        $HallPlayCoachText = 'Привалившись к стене у приоткрытой двери комнаты Аманды, вы замираете, вслушиваясь в негромкие девичьи голоса. Лизетта говорит бойко, вкрадчивым шепотом, с непринужденной уверенностью опытной соблазнительницы, а Аманда отвечает несмело, сдавленно хихикая и то и дело краснея.'
        $HallPlayCoachText2 = '— Глупенькая, ты всё еще свято веришь, будто щедрые чаевые дают за чисто отдраенные кружки и скромное опускание глазок? — доносится насмешливый шепот Лизетты, сопровождаемый шуршанием юбок. — Мужчина приходит в трактир не на глину глазеть, а за пьянящей сказкой. Слушай внимательно: подаешь кувшин — не суетись. Наклоняйся плавнее, не спеша, когда ставишь эль на дубовую доску. Пусть корсаж на мгновение приоткроет нежную линию девичьей грудки, пусть юбка обтянет округлые бедра. Взгляд брось из-под ресниц — лукавый, зовущий, будто только ему одному улыбнулась. Одно лишнее мгновение сладостного ожидания — и гость уже сам лихорадочно лезет за тугим кошельком!'
        $HallPlayCoachText3 = '— Лизка... ну что ты такое говоришь! — Аманда смущенно прыскает в кулачок, но в её голосе сквозит неподдельный девичий азарт. — Это же... это ведь почти бесстыдство! А если Стефан приметит? Он ведь хозяин... если увидит, что я перед гостями бедрами вожу — такой разнос устроит, до слез доведет!'
        $HallPlayCoachText4 = '— А ты не будь овечкой на заклании, — звонко цокает языком Лизетта. — Та, кто умеет тонко играть чужими желаниями, сама правит балом и сама решает, кому и сколько дозволено. Не вздумай пищать или шарахаться в угол, если кто ладонь поближе положит — улыбнись, плавно качни бедром, будто невзначай выскользнула, и оставь его с носом и пустой надеждой. Главную науку я тебе шепнула. А дальше смотри сама: либо брат тебя в монастырской строгости держать станет, либо с гордостью увидит, что его сестренка приносит в кассу трактира больше золота, чем все бочки в погребе!'

    elseif $HallPlayCoachTextId = 'melissa':
        $HallPlayCoachText = 'У закрытой на щеколду винной лавки Легаре в узком тенистом переулке сквозь щель дощатой ставни доносятся приглушенные женские голоса. Кларисса и Мелисса беседуют негромко, но в воскресной тишине каждое слово звенит отчетливо и резко.'
        $HallPlayCoachText2 = '— Твоя младшая сестрица... — с ядовитой усмешкой роняет Кларисса, и по нажиму в голосе сразу ясно, о ком речь. — Весь город только и судачит о том, как ловко Аманда крутит подолом перед захмелевшими гостями в зале. Мужчины теряют голову, медяки и серебро сами сыплются на её поднос. А ты, наша непревзойденная умница, первая красавица и поэтесса, всё держишься за свое ледяное книжное достоинство? «Честь дороже звонкой монеты», так? И каков итог, Мелисса? Пустые карманы фартука и вздохи над рукописями, на издание которых у тебя нет ни единого спинтрия?'
        $HallPlayCoachText3 = '— Не смей сравнивать меня с ней, — в голосе Мелиссы звенит сдержанная, колючая ярость уязвленной гордости. — Я не собираюсь опускаться до повадок площадной девки и торговать ужимками лишь ради того, чтобы не отстать от глупой младшей сестры!'
        $HallPlayCoachText4 = '— А никто и не предлагает тебе становиться девкой, дурочка, — Кларисса с тонким звоном ставит хрустальный бокал на конторку. — Речь о власти и женском триумфе. Неужели ты позволишь несмышленой девчонке затмить тебя под крышей твоего же собственного дома? Мужскую похоть можно презирать, но глупо не заставлять её служить твоим целям. Докажи, что холодный, утонченный ум и порочная женская грация способны вытянуть из мужских кошельков вдесятеро больше золота, чем наивные улыбочки Аманды... Мелисса долго молчит, тяжело дыша, затем глухо роняет: «Я услышала тебя, Кларисса.» Дальше она будет решать сама.'

    elseif $HallPlayCoachTextId = 'sandra':
        $HallPlayCoachText = 'Возле задней стены продуктовой лавки Бекки из приотворенной форточки доносится незлобивый, раскатистый женский смех и усталый, глубокий голос Сандры. Вы замираете в тени навеса, боясь скрипнуть рассохшейся половицей под ногами.'
        $HallPlayCoachText2 = '— Девчонки твои в зале совсем стыд растеряли, Сандра, — посмеивается Бекки, с мерным стуком перебирая связки сушеных трав. — И младшая, и старшая так перед гостями изгибаются, что у мужиков слюни до полу капают. Весь торговый ряд шушукается! А кухня, чай, первой все эти шепотки чует?'
        $HallPlayCoachText3 = '— Полно тебе языком чесать, Бекки... — с тяжелым вздохом отзывается Сандра. — У меня на кухне жаркая плита, чугунные котлы да хлеб в печи, а не ярмарочный балаган. Я мать семейства, а не вертихвостка...'
        $HallPlayCoachText4 = '— Ой, брось ты строить из себя святую великомученицу перед алтарем Ильматера! — Бекки лукаво и смачно фыркает. — Ты сама женщина в самом соку, фигуристая, статная — мужики шеи сворачивают, когда ты с корзиной по рынку идешь! Поверь моему слову: у печи тоже можно приласкать так, что у любого купца или моряка дух захватит. Заглянет гость на кухню похвалить жаркое — не хватайся сразу за кочергу, позволь взглядом скользнуть по твоим прелестям, обнять за стан, принять ласку. И серебро на хозяйство появится, и сама вспомнишь, каково это — быть желанной... Сандра молчит, не перечит, но и лавку не покидает. Зерно упало на благодатную почву. Если на трактирной кухне станет жарко вовсе не от огня — удивляться уже не придется.'
    end

    killvar '$HallPlayCoachTextId'
---
