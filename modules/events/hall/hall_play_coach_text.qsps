! ================================================
! FILE: modules/events/hall/hall_play_coach_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Обучение play — подслушанные разговоры (не диалог ГГ с наставником):
! 1) Аманда ↔ Лизетта (воскресенье, комната Аманды)
! 2) Мелисса ↔ Кларисса (воскресенье, лавка Легаре)
! 3) Сандра ↔ Бекки (воскресенье, лавка Бекки)
! Канон: docs/design-hall-scene-unified.md §0.4
! ================================================

#HallPlayCoachText
    $HallPlayCoachTextId = LCASE($ARGS[0])
    $HallPlayCoachText = ''
    $HallPlayCoachText2 = ''
    $HallPlayCoachText3 = ''
    $HallPlayCoachText4 = ''

    if $HallPlayCoachTextId = 'amanda':
        $HallPlayCoachText = 'За дверью комнаты Аманды — два женских голоса. Лизетта говорит бойко, почти шёпотом, но чётко; Аманда отвечает тише, смущённо.'
        $HallPlayCoachText2 = '— Ты всё ещё думаешь, что хорошие чаевые — это чистые кружки и милая улыбка, — слышится голос Лизетты. — Слушай: подавай кувшин чуть медленнее. Наклоняйся плавнее, когда ставишь эль. Чтобы было видно… ну, чуть сисек, попку. Взгляд озорной, улыбка шире. Лишнее мгновение внимания — и клиент уже роет кошелёк.'
        $HallPlayCoachText3 = '— Лизка… — Аманда давится смешком. — Это же… неприлично. Стефан… если увидит…'
        $HallPlayCoachText4 = '— Кто умеет играть, тот сам решает, кому и что позволено, — Лизетта хихикает. — Не ори, не убегай — крутни попой, будто случайно. Я тебе шепнула. Дальше — зал. Либо брат тебя в строгости держит, либо смотрит, как ты учишься.'

    elseif $HallPlayCoachTextId = 'melissa':
        $HallPlayCoachText = 'У закрытой винной лавки Легаре сквозь щель ставни доносятся голоса Клариссы и Мелиссы — негромко, но достаточно ясно, если стоять у угла.'
        $HallPlayCoachText2 = '— Эта мелкая… — Кларисса почти шипит, и ясно, что речь об Аманде. — Говорят, в вашем зале уже крутит жопой так, что медяки сами прыгают на стол. А ты, умница, красотка, — достоинство важнее серебра. И что? Пустой фартук?'
        $HallPlayCoachText3 = '— Я не… — Мелисса сдержанно, но в голосе злость. — Я не стану шлюхой из-за младшей.'
        $HallPlayCoachText4 = '— Не для того, чтобы ты стала шлюхой, — Кларисса ставит бокал (звон стекла). — Чтобы не проиграла мелкой в своём же доме. «Ещё посмотрим, кто лучше» — вот как. Мелисса молчит… потом тихо: «Услышала.» Дальше она сама решит, крутить или нет.'

    elseif $HallPlayCoachTextId = 'sandra':
        $HallPlayCoachText = 'У закрытой продуктовой лавки Бекки за приоткрытым окном — смех без злости и сухой, усталый голос Сандры. Вы замираете у угла, чтобы не скрипнула доска.'
        $HallPlayCoachText2 = '— Девки у вас совсем стыд потеряли, — Бекки кивает в сторону трактира. — Жопами крутят, говорят: и мелкая, и старшая. Город шепчет, а кухня-то слышит всё первой.'
        $HallPlayCoachText3 = '— Бекки… — Сандра. — У меня плита, не лавка. Я не…'
        $HallPlayCoachText4 = '— А у тебя тоже есть чем покрутить, — Бекки подмигивает в голосе. — Только у печи, не на лавке. Не святая же ты мне в исповеди. Я так и сказала. Сандра молчит… но не уходит. Значит, зерно упало. Если на кухне станет жарче не от печи — не удивляйся.'
    end

    killvar '$HallPlayCoachTextId'
---
