! ================================================
! FILE: modules/events/hall/hall_play_coach_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Обучение play — подслушанные воскресные разговоры:
! 1) Аманда ↔ Лизетта (воскресенье, комната Аманды)
! 2) Мелисса ↔ Кларисса (воскресенье, лавка Легаре)
! 3) Сандра ↔ Бекки (воскресенье, лавка Бекки)
! Канон: docs/design-hall-scene-unified.md §0.4, docs/design-hall-harassment.md
! ================================================

#HallPlayCoachText
    $HallPlayCoachTextId = LCASE($ARGS[0])
    $HallPlayCoachText = ''
    $HallPlayCoachText2 = ''
    $HallPlayCoachText3 = ''
    $HallPlayCoachText4 = ''

    if $HallPlayCoachTextId = 'amanda':
        $HallPlayCoachText = 'Привалившись к стене у приоткрытой двери комнаты Аманды, вы замираете, вслушиваясь в негромкие девичьи голоса. Лизетта говорит бойко, вкрадчивым шепотом, с непринужденной уверенностью опытной соблазнительницы, а Аманда отвечает несмело, сдавленно хихикая и то и дело розовея.'
        $HallPlayCoachText2 = '— Глупенькая, ты всё еще веришь, будто щедрые чаевые дают за чисто отдраенные кружки и скромное опускание глазок? — доносится насмешливый шепот Лизетты, сопровождаемый шелестом юбок. — Мужчины приходят в трактир не на глину глазеть, а за пьянящей сказкой. Слушай внимательно: подаешь заказ — не суетись. Наклоняйся плавнее, не спеша, когда ставишь эль на дубовую доску. Пусть корсаж на миг приоткроет аккуратную грудь, пусть ткань подчеркнет стройные бедра. Взгляд брось из-под ресниц — лукавый, зовущий, будто только ему одному улыбнулась. Одно лишнее мгновение ожидания — и гость уже сам тянется к тугому кошельку!'
        $HallPlayCoachText3 = '— Лизка... ну что ты такое говоришь! — Аманда смущенно прыскает в кулачок, но в её голосе сквозит неподдельный девичий азарт. — Это же... это ведь почти бесстыдство! А если Стефан приметит? Он ведь за стойкой хозяин... если увидит, что я перед гостями бедрами вожу — начнет ворчать, что я порядок нарушаю или гостей балую!'
        $HallPlayCoachText4 = '— А ты не давай повода ворчать! — звонко цокает языком Лизетта. — Умная девушка не шарахается от мужского взгляда, а сама направляет игру. Не вздумай пищать или прятаться, если кто ладонь поближе положит — улыбнись, плавно качни бедром, будто невзначай выскользнула, и оставь его с носом и разгоряченным любопытством. Главную науку я тебе шепнула. Стефан увидит, сколько звонкой монеты ты собираешь в кассу, и сам будет сестренкой гордиться!'

    elseif $HallPlayCoachTextId = 'melissa':
        $HallPlayCoachText = 'У закрытой на щеколду винной лавки Легаре в узком тенистом переулке сквозь щель дощатой ставни доносятся приглушенные женские голоса. Кларисса и Мелисса беседуют негромко, но в воскресной тишине каждое слово звенит отчетливо и резко.'
        $HallPlayCoachText2 = '— Ты часами просиживаешь над трактатами и стихами, Мелисса, — неторопливо произносит Кларисса, и в ее голосе слышится деловая насмешка. — А в лавке книгочея считаешь каждый медный грош, вздыхая над редкими рукописями. Между тем мужчины в трактире готовы платить чистое серебро за одно только снисходительное внимание красивой и образованной девушки. Зачем тратить твое ледяное достоинство впустую, когда его можно выгодно обратить на пользу делу?'
        $HallPlayCoachText3 = '— Я не собираюсь опускаться до банального трактирного кокетства, Кларисса, — в голосе Мелиссы звенит холодная, уязвленная гордость. — Мой ум и рассудок существуют не для того, чтобы услаждать взоры подвыпивших невежд за кружкой эля.'
        $HallPlayCoachText4 = '— А кто говорит о банальности? — Кларисса с тонким звоном ставит стеклянный бокал на конторку. — Речь о власти ума над примитивной натурой. Мужская похоть предсказуема, наивна и проста до смешного. Не презирай ее даром — заставь ее служить твоим целям! Один твой насмешливый взгляд сверху вниз, пара отточенных книжных фраз, и эти простофили сами выложат серебро за право услышать ответ умницы. Пусть их тугие кошельки оплатят твои книги, чернила и пергамент... Мелисса долго молчит, затем ровно и сдержанно роняет: «Я услышала тебя, Кларисса». Зерно упало в благодатную почву: теперь книжница видит в гостях не обузу, а расчетливый источник дохода.'

    elseif $HallPlayCoachTextId = 'sandra':
        $HallPlayCoachText = 'Возле задней стены продуктовой лавки Бекки из приотворенной форточки доносится незлобивый женский смех и мягкий, глубокий голос Сандры. Вы замираете в тени навеса, боясь скрипнуть рассохшейся половицей под ногами.'
        $HallPlayCoachText2 = '— Дела-то у вас в «Жеребце» заметно оживились, Сандра, — посмеивается Бекки, с мерным стуком перебирая связки сушеных трав. — Гости валом валят, в зале смех и звон монет. Только ты всё у жаркой плиты спину гнешь, словно на тебе одной весь дом держится. Пора бы и о себе подумать!'
        $HallPlayCoachText3 = '— Полно тебе, Бекки... — с тихим вздохом отзывается Сандра. — У меня на кухне жаркие котлы да свежий хлеб в печи, а не ярмарочный балаган. Я хозяйка, мать семейства — мне за сытными обедами да порядком в доме следить надо.'
        $HallPlayCoachText4 = '— Ой, брось ты прибедняться перед алтарем Ильматера! — Бекки лукаво и смачно фыркает. — Ты сама женщина статная, видная — купцы да мастера шеи сворачивают, когда ты за провизией идешь! Заглянет щедрый гость на кухню похвалить рагу — не хватайся сразу за ухват. Улыбнись по-хозяйски, позволь взглядом скользнуть по твоим прелестям, скажи доброе слово. И лишний серебряный на хозяйство осядет, и сама почувствуешь себя желанной женщиной, а не просто стряпухой... Сандра молчит, задумчиво перебирая край полотенца, но лавку не покидает. Слова подруги легли точно в цель: от теплого женского взгляда и выручка в трактире сытнее, и в доме мир.'
    end

    killvar '$HallPlayCoachTextId'
---
