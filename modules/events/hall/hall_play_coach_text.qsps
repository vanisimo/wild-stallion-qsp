! ================================================
! FILE: modules/events/hall/hall_play_coach_text.qsps
! MODULE: events/hall
! Тексты обучения play (Лизетта / Кларисса / Бекки)
! ================================================

#HallPlayCoachText
    $HallPlayCoachTextId = LCASE($ARGS[0])
    $HallPlayCoachText = ''
    $HallPlayCoachText2 = ''
    $HallPlayCoachText3 = ''

    if $HallPlayCoachTextId = 'amanda':
        $HallPlayCoachText = 'Лизетта поправляет ленту и смотрит на вас так, будто обсуждает погоду, а не чужую сестру.'
        $HallPlayCoachText2 = '— Аманда ещё считает, что чаевые — от улыбки и чистых кружек. В столице так не живут. Скажи ей от меня, или пусть сама услышит: наклонись ниже, когда ставишь пиво. Чуть сильнее вырез — не стыд, а свет. И попой можно «случайно» крутнуть, когда уходишь от стола. Не ляг на лавку — просто не будь доской.'
        $HallPlayCoachText3 = 'Она усмехается: — Кто умеет играть, тот выбирает, кто трогает. Кто только краснеет — того трогают все. Я ей уже шептала. Теперь очередь зала… и твоя: либо запретишь, либо посмотришь, как она учится.'

    elseif $HallPlayCoachTextId = 'melissa':
        $HallPlayCoachText = 'Кларисса протирает бокал и понижает голос, хотя в лавке никого нет.'
        $HallPlayCoachText2 = '— Эта мелкая… — она имеет в виду Аманду, и в голосе и зависть, и азарт. — Говорят, в вашем зале уже крутит жопой так, что медяки сами прыгают на стол. А Мелисса у вас — умная, красивая, и… считает, что достоинство важнее серебра.'
        $HallPlayCoachText3 = 'Кларисса ставит бокал: — Я ей сказала: «Ещё посмотрим, кто лучше». Не для того, чтобы она стала шлюхой. Для того, чтобы не проиграла младшей в своём же доме. Мелисса вспыхнула. Значит — услышала. Дальше она сама решит, крутить или нет. А ты решай, хозяин: смотреть или рвать.'

    elseif $HallPlayCoachTextId = 'sandra':
        $HallPlayCoachText = 'Бекки опирается на прилавок, как на свой родной порог, и смеётся без злости.'
        $HallPlayCoachText2 = '— Девки у тебя совсем стыд потеряли, — кивает она в сторону трактира. — Жопами крутят, говорят, и мелкая, и старшая. Город шепчет, а кухня-то слышит всё первой.'
        $HallPlayCoachText3 = 'Она подмигивает: — А ты что, Сандра? У тебя тоже есть чем покрутить — только у плиты, не на лавке. Не святая же ты мне в исповеди. Я ей так и сказала. Она молчала… но не ушла. Значит, зерно упало. Теперь не удивляйся, если на кухне станет жарче не от печи.'
    end

    killvar '$HallPlayCoachTextId'
---
