! ================================================
! FILE: modules/events/hall/hall_harass_play_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT — исходы при stance play / заигрывании (Канон v2.2)
! Вызывается из HallHarassmentPrintHallReaction / Kitchen
! Клиент: $HallHarassClient → HallLewdFillClientBits
! ================================================

#HallHarassmentPrintPlayResolve
    ! ARGS none — читает $HallHarassReaction, $HallHarassGirl, stance
    if $HallHarassStanceCanon <> 'play' and $HarassGirlStance <> 'provoke':
        exit
    end

    $HallLewdClient = $HallHarassClient
    if $HallLewdClient = '':
        $HallLewdClient = 'drunk_guest'
    end

    if LOC('HallLewdFillClientBits') = 1:
        gs 'HallLewdFillClientBits'
    else
        $HallLewdClientWho = 'гость'
        $HallLewdClientWhoA = 'гостя'
        $HallLewdClientCoin = 'монету'
        $HallLewdClientManner = 'нагло'
    end

    if $RealName[$HallHarassGirl] = '':
        if LOC('HallLewdEnsureName') = 1:
            gs 'HallLewdEnsureName', $HallHarassGirl
        end
    end

    $g = $HallHarassGirl
    u_lvl = GirlUniformLevel[$g]
    nop_lvl = GirlNoPantiesWork[$g]

    ! ============================================================
    ! 1. PROTECT_HARD: Стефан резко вмешивается и обрывает заигрывание
    ! ============================================================
    if $HallHarassReaction = 'protect_hard':
        if $g = 'amanda':
            *pl 'Вы решительно шагаете вперёд и твёрдо перехватываете руку ' + $HallLewdClientWhoA + ': «Руки при себе держи. Здесь трактир, а не портовый вертеп».'
            *pl ' '
            *pl $HallLewdClientWho + ' ошарашенно моргает, с досадой сплёвывает на доски пола и прячет зажатую ' + $HallLewdClientCoin + ' обратно в кошель, что-то недовольно бурча себе под нос.'
            *pl ' '
            if u_lvl = 1:
                *pl 'Аманда мгновенно вспыхивает до самых корней волос. Её короткая юбка едва прикрывает бёдра, а аккуратная девичья грудь часто вздымается от испуга и стыда — напряжённые соски возбуждённо и вызывающе торчат сквозь тонкую ткань открытого платья. Она судорожно одёргивает подол и прячет горящее лицо за деревянным подносом.'
            else
                *pl 'Аманда густо заливается румянцем, закусывая губу. Её аккуратная грудь быстро ходит ходуном под холщовым платьем, на ткани отчётливо проступают затвердевшие бугорки сосков. Смущённо пряча глаза от взглядов соседних столов, она торопливо отступает за вашу спину.'
            end
            *pl ' '
            *pl 'За дальними столами раздаются смешки завсегдатаев: «Ишь, хозяин свою девчонку как коршун стережёт! А ведь девка-то сама глазки строила!» В дверном проёме кухни на миг показалась встревоженная Сандра, готовая выскочить на защиту дочери, но, увидев вас рядом с Амандой, успокоенно вернулась к плите.'

        elseif $g = 'melissa':
            *pl 'Вы встаёте между ними, коротко бросая гостю: «Хватит лапать. Расплатись за выпивку и остынь».'
            *pl ' '
            *pl $HallLewdClientWho + ' недовольно кряхтит, нехотя разжимая пальцы на талии девушки: «Да ладно тебе, трактирщик... Мы ж просто шутили...» Звякнув монетой об стол, мужик неловко отваливается назад.'
            *pl ' '
            if u_lvl = 1:
                *pl 'Мелисса ничуть не тушуется. Она медленно и с подчеркнутым достоинством поправляет глубокий вырез короткой формы, выставляющий напоказ её аккуратную, упругую грудь. Соски ещё возбуждённо твердеют от чужого внимания, но на губах девушки играет тонкая, чуть насмешливая улыбка книжной зазнайки.'
            else
                *pl 'Мелисса спокойно одёргивает юбку и приглаживает волосы, бросая на вас насмешливый, ироничный взгляд: мол, она прекрасно контролировала ситуацию и держала мужлана на коротком поводке, и ваше шумное вмешательство было совершенно излишним.'
            end
            *pl ' '
            *pl '«Спасибо за заботу, Стефан, — негромко произносит Мелисса с лёгким сарказмом. — Хотя я как раз собиралась избавить его ещё от пары серебряных монет на книги».'

        else
            ! sandra
            *pl 'Вы шагаете на кухню и кладёте тяжёлую ладонь на плечо гостя, нависшего над Сандрой у разделочного стола: «Остынь, приятель. Сандра здесь хозяйка и повариха, а не забава к пиву. Проваливай в зал».'
            *pl ' '
            *pl $HallLewdClientWho + ' вздрагивает от вашего голоса, неловко убирает руки, пятится к дверям в зал и бурчит: «Да понял я, понял... Угостить просто хотел...»'
            *pl ' '
            if u_lvl = 1:
                *pl 'Сандра облегчённо переводит дух, опираясь о разделочный стол, но её щёки алеют густым зрелым румянцем. Короткий передник едва сдерживает её роскошную, пышную грудь — соски напряжённо очерчивают ткань. Она торопливо оглаживает платье на широких бёдрах, пряча смущение.'
            else
                *pl 'Сандра по-хозяйски одёргивает юбку у плиты и поправляет сбившийся чепец. Её пышная, тяжелая грудь вздымается от быстрого дыхания. Она бросает на вас тёплый, благодарный материнский взгляд, в котором, однако, сквозит лёгкая женская неловкость.'
            end
            *pl ' '
            *pl '«Спасибо, Стефан, — вполголоса говорит Сандра, возвращаясь к котлу. — Совсем хмель мужикам головы кружит, уже на кухню лезут...»'
        end

    ! ============================================================
    ! 2. WATCH: Стефан наблюдает, не пресекая (девушка держит игру)
    ! ============================================================
    elseif $HallHarassReaction = 'watch':
        if $g = 'amanda':
            *pl 'Вы остаётесь стоять неподалёку, пристально наблюдая за происходящим. ' + $HallLewdClientWho + ', чувствуя ваше молчаливое попустительство, наглеет с каждой секундой — его жадная ладонь по-хозяйски опускается на девичью попу, сжимая податливую плоть.'
            *pl ' '
            if u_lvl = 1:
                if nop_lvl = 1:
                    *pl 'Аманда вспыхивает до ушей, понимая, что под короткой юбкой на ней совсем нет белья! Пальцы гостя задирают лёгкий подол, и в полумраке зала открывается вид на её абсолютно голую, гладкую попку и манящую ложбинку. Девушка закусывает губу, тихо постанывая сквозь сжатые зубки: её аккуратная девичья грудь часто ходит ходуном, напряжённые соски пронзают ткань платья, а гость ошалело хрипит, роняя ' + $HallLewdClientCoin + ' прямо в её протянутую ладонь.'
                else
                    *pl 'Аманда заливается краской, но помнит про чаевые и не отстраняется. Она чуть прогибается в пояснице, дразня гостя соблазнительным изгибом бёдер. Короткая юбка задралась, открывая тонкую полоску белья и круглые девичьи ягодицы. Аккуратная девичья грудь с вызывающе торчащими сосками часто вздымается под горячим дыханием мужчины, пока гость жадно тискает её бёдра и звенит серебром.'
                end
            else
                *pl 'Аманда густо краснеет, но стойко держит игривую улыбку. Позволяя гостю бесстыдно поглаживать свои бёдра поверх подола, она кокетливо склоняет голову, шепча что-то на ухо подвыпившему мужчине. Её аккуратные грудки с затвердевшими бугорками сосков прижимаются к его плечу, заставляя гостя судорожно лезть в карман за новой монетой.'
            end
            *pl ' '
            *pl 'У соседних столов раздаются одобрительные возгласы и сальный свист: «Вот это трактир! Вот это девка, огонь!»'
            *pl ' '
            *pl 'Ловко забрав серебро, Аманда чуть подаётся вперёд и обжигает ухо гостя горячим шёпотом: «Не при всём же зале... Руки освобожу — найди меня у подсобки...»'

        elseif $g = 'melissa':
            *pl 'Вы не двигаетесь с места, спокойно наблюдая от стойки. ' + $HallLewdClientWho + ' с пьяной ухмылкой притягивает Мелиссу за талию, и его грубая ладонь скользит по её бедру, сминая ткань платья.'
            *pl ' '
            if u_lvl = 1:
                if nop_lvl = 1:
                    *pl 'Мелисса держится с невозмутимым видом, хотя румянец выдаёт волнение: под задранным подолом короткой формы гость нащупывает абсолютно голую кожу бёдер! Лишённая белья попка девушки оказывается под пальцами мужчины. Мелисса лишь приподнимает бровь с лукавой усмешкой — её упругая девичья грудь волнующе колышется, соски наливаются и заметно твердеют, пока она мастерски вытягивает ' + $HallLewdClientCoin + ' за монетой из размякшего купца.'
                else
                    *pl 'Мелисса с лёгкой насмешливой улыбкой позволяет гостю оглаживать свои упругие бёдра. Короткая юбка задрана, открывая бельё. Её аккуратная грудь аппетитно подрагивает при каждом движении, возбуждённые соски отчётливо натягивают материю.'
                end
            else
                *pl 'Мелисса держит дистанцию, позволяя гостю щупать бёдра ровно настолько, чтобы тот не скупился на серебро. Её соски бугорками проступают сквозь скромное платье, а во взгляде читается расчёт: она знает цену мужскому вожделению и обращает его в звонкие монеты.'
            end
            *pl ' '
            *pl 'Завсегдатаи довольно стучат кружками: «У Мелиссы хватка! И мужика ублажит, и карманы вычистит!»'
            *pl ' '
            *pl 'Она легко ускользает из объятий, бросая гостю с задорным прищуром: «Терпение, господин хороший... Заказы разнесу — и потолкуем без лишних ушей».'

        else
            ! sandra
            *pl 'Вы остаётесь в кухонном проходе, молча наблюдая за происходящим. ' + $HallLewdClientWho + ' проник на кухню и прижимает Сандру к краю разделочного стола, пока его ладонь бесцеремонно ложится на её ягодицы.'
            *pl ' '
            if u_lvl = 1:
                *pl 'Сандра глубоко и прерывисто вздыхает. Её открытый передник едва сдерживает сиски — роскошная, грудь вздымается от частого дыхания, а сквозь ткань платья отчётливо проступают очертания напряжённых сосков. Гость тяжело сглатывает слюну, сжимая податливое бедро женщины, и выкладывает серебро прямо на разделочную доску.'
            else
                *pl 'Сандра заливается румянцем, но опыт берёт своё: не поднимая шума на весь трактир, она позволяет гостю оглаживать округлые бёдра, пока монета звенит на деревянном столе. Её богатый бюст волнующе ходит ходуном под платьем от каждого вздоха.'
            end
            *pl ' '
            *pl 'Из приоткрытой двери зала доносится пьяный гогот — кто-то из завсегдатаев успел подглядеть в щёлку: «Эх, хороша хозяйка! Настоящая женщина!»'
            *pl ' '
            *pl 'Сандра мягко, но уверенно упирается ладонями в плечи гостя: «Полно тебе распускать руки, мне жаркое проверить надо... Погоди, коли не остынешь».'
        end

    ! ============================================================
    ! 3. IGNORE: Стефан демонстративно отворачивается к стойке
    ! ============================================================
    else
        *pl 'Вы нарочито отворачиваетесь к стойке и берётесь протирать кружки, делая вид, что происходящее в зале вас совершенно не касается.'
        *pl ' '
        *pl 'За спиной отчётливо слышен шум разгорающейся сцены: хохот ' + $HallLewdClientWhoA + ', звонкий шлепок ладони по податливому мягкому месту и приглушённый девичий вздох. Зал одобрительно гудит, гости переглядываются и стучат кубками по столам.'
        *pl ' '
        if $g = 'amanda':
            if u_lvl = 1 and nop_lvl = 1:
                *pl 'Аманда остаётся без вашей защиты. Слышен её прерывистый шёпот и говор мужика, запустившего ладонь под короткую юбку прямо к голой попке. Понимая, что хозяин отвернулся, девушка сама берёт плату: серебро звенит на столе, а Аманда, с горящими от стыда щеками и напряжёнными сосками, дразнит клиента.'
            else
                *pl 'Аманда понимает намёк: хозяин не вмешивается, значит, чаевые важнее правил. Сзади доносится звон монет, шуршание задираемого подола и девичий смешок, в котором смущение тонет в азарте лёгкой наживы.'
            end
            *pl ' '
            *pl 'Когда вы украдкой оглядываетесь — гость уже тяжело дышит у края стола с пустым кошелём, а Аманда, алея щеками и пряча монеты в корсаж, бросает ему горячий намёк встретиться у подсобки.'

        elseif $g = 'melissa':
            *pl 'Мелисса моментально оценивает ваше молчание. Оставшись хозяйкой положения, она раскручивает гостя: слышен её бархатный голос, поддразнивающий мужское самолюбие, и тяжёлые вздохи гостя, жадно сжимающего её упругие бёдра.'
            *pl ' '
            *pl 'Когда вы бросаете взгляд через плечо, Мелисса уже держит в кулачке несколько монет. Её упругая грудь возбуждённо вздымается под тканью, соски вызывающе твердеют, а на губах играет победная улыбка: она получила всё, что хотела, и сама направляет разомлевшего гостя к выходу в коридор.'

        else
            ! sandra
            *pl 'Сандра остаётся на кухне один на один с распалённым гостем. Из-за приоткрытой двери слышен скрип кухонной лавки, тяжёлое сопение мужика и глубокий, хрипловатый вздох женщины. Гость бесцеремонно сжимает её пышные бёдра, пока серебро со звоном ложится на край стола.'
            *pl ' '
            *pl 'Заглянув позже на кухню, вы видите Сандру, оглаживающую подол на широких бёдрах. Её роскошная зрелая грудь вздымается от прилива крови к щекам, а в глазах читается готовность: она сама решила, как поступить с этим серебром.'
        end
    end

    killvar '$g'
    killvar 'u_lvl'
    killvar 'nop_lvl'
    killvar '$HallLewdClient'
    killvar '$HallLewdClientWho'
    killvar '$HallLewdClientWhoA'
    killvar '$HallLewdClientCoin'
    killvar '$HallLewdClientManner'
---
