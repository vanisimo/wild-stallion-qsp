! ================================================
! FILE: modules/events/hall/noble_attack.qsps
! MODULE: events/hall
! Конфликт с дворянином в главном зале
! Открывает арку Сандры и главный сюжет о происхождении Стефана
! ================================================

#NobleAttackShowImage
    ! shipped png: всегда через SceneShowVisual → [VIS] + debug future
    SceneArtUseReal = 1
    if LOC('SceneShowVisual') = 1:
        gs 'SceneShowVisual', 'images/events/hall/noble_attack/poor_young_noble', 'noble attack: бедный молодой дворянин в зале', 'large', 'png'
    elseif LOC('ShowImagePath') = 1:
        gs 'ShowImagePath', 'images/events/hall/noble_attack/poor_young_noble', '', 'event', 'png'
        gs 'VisPrintCaption', 'noble attack: бедный молодой дворянин в зале', 'images/events/hall/noble_attack/poor_young_noble', 'png'
    elseif LOC('ShowImage') = 1:
        gs 'ShowImage', 'common', '', 'hall_scene_stub', '', 'png', 'large'
        gs 'VisPrintCaption', 'noble attack: бедный молодой дворянин в зале', 'images/events/hall/noble_attack/poor_young_noble', 'png'
    end
    SceneArtUseReal = 0
---

#NobleAttackCanStart
    NobleAttackCanStart = 0

    if NobleAttackStage > 0:
        exit
    end

    if time >= 5:
        exit
    end

    if week = 7:
        exit
    end

    if week = 5 and time = 4:
        exit
    end

    gs 'IsTavernOpen'

    if TavernOpen = 0:
        exit
    end

    if day < 6:
        exit
    end

    if tavernvisitors < 12:
        exit
    end

    NobleAttackCanStart = 1
---

#NobleAttackStart
    *clr
    clr
    cla

    $NobleAttackReturnLoc = $ARGS[0]

    if $NobleAttackReturnLoc = '':
        $NobleAttackReturnLoc = 'TavernMain'
    end

    if LOC($NobleAttackReturnLoc) = 0:
        $NobleAttackReturnLoc = 'TavernMain'
    end

    gs 'IsTavernOpen'
    gs 'UpdateGirlLocations'

    NobleAttackStage = 1
    NobleAttackDay = day
    NobleAttackTime = time

    *pl '══════════════════════════════════════════════'
    *pl ' ДВОРЯНИН В ЗАЛЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'NobleAttackShowImage'

    gs 'NobleAttackIntroText'

    *pl ' '

    if debug = 1:
        *pl '[DEBUG NOBLE ATTACK] day: ' + STR(day) + ', time: ' + STR(time)
        *pl '[DEBUG NOBLE ATTACK] FamilyTrust: ' + STR(FamilyTrust)
        *pl ' '
    end

    gs 'NobleAttackBuildMenu'

    *p 'Как <a href="exec:gs ''Menu.Show'', ''NobleAttackMenu''">реагировать</a>?'
---

#NobleAttackBuildMenu
    gs 'Menu.Destroy', 'NobleAttackMenu'
    gs 'Menu.Create', 'NobleAttackMenu'

    gs 'MenuUiAdd', 'NobleAttackMenu', 'Не отступать', ''
    gs 'Menu.AddModule', 'NobleAttackMenu', {
        gs 'NobleAttackPickChoice', 'stand_firm'
    }

    gs 'MenuUiAdd', 'NobleAttackMenu', 'Отступить', ''
    gs 'Menu.AddModule', 'NobleAttackMenu', {
        gs 'NobleAttackPickChoice', 'retreat'
    }

    gs 'MenuUiAdd', 'NobleAttackMenu', 'Согнуться и извиниться', ''
    gs 'Menu.AddModule', 'NobleAttackMenu', {
        gs 'NobleAttackPickChoice', 'yield'
    }
---

#NobleAttackPickChoice
    $NobleAttackLastChoice = LCASE($ARGS[0])

    if $NobleAttackLastChoice = '':
        exit
    end

    gt 'NobleAttackAction', $NobleAttackReturnLoc
---

#NobleAttackAction
    *clr
    clr
    cla

    $NobleAttackReturnLoc = $ARGS[0]

    if $NobleAttackReturnLoc = '':
        $NobleAttackReturnLoc = 'TavernMain'
    end

    if LOC($NobleAttackReturnLoc) = 0:
        $NobleAttackReturnLoc = 'TavernMain'
    end

    $NobleAttackChoice = $NobleAttackLastChoice

    if $NobleAttackChoice = '':
        gt $NobleAttackReturnLoc
        exit
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ДВОРЯНИН В ЗАЛЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'NobleAttackShowImage'
    gs 'NobleAttackChoiceText', $NobleAttackChoice

    *pl ' '

    if $NobleAttackChoice = 'stand_firm':
        tavern_reputation += 1
        FamilyTension += 2
        TavernScandal += 2
        gs 'NobleAttackApplyFine'

        gs 'ActUiPrepare', 'Очнуться в комнате', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'NobleAttackKnockoutWake', $NobleAttackReturnLoc
        end

        exit

    elseif $NobleAttackChoice = 'retreat':
        tavern_reputation -= 2
        FamilyTension += 2
        TavernScandal += 1

        if tavern_reputation < 0:
            tavern_reputation = 0
        end

        gs 'NobleAttackAftermathText'
        gs 'NobleAttackMarkReveal', 1
        gs 'NobleAttackRegisterMemory', $NobleAttackLastChoice

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться в главный зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $NobleAttackReturnLoc
        end

        exit

    elseif $NobleAttackChoice = 'yield':
        tavern_reputation -= 1
        FamilyTension += 3
        FamilyTrust += 1
        TavernScandal += 2
        SandraTrustStefan += 1

        if tavern_reputation < 0:
            tavern_reputation = 0
        end

        gs 'NobleAttackYieldAftermathText'
        gs 'NobleAttackMarkReveal', 2
        gs 'NobleAttackRegisterMemory', $NobleAttackLastChoice

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться в главный зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt $NobleAttackReturnLoc
        end

        exit
    end

    gs 'NobleAttackAftermathText'
    gs 'NobleAttackMarkReveal', 0
    gs 'NobleAttackRegisterMemory', $NobleAttackLastChoice

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в главный зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $NobleAttackReturnLoc
    end
---

#NobleAttackApplyFine
    NobleAttackFinePaid = NobleAttackFineAmount

    if NobleAttackFinePaid <= 0:
        NobleAttackFinePaid = 80
    end

    if money < 150:
        NobleAttackFinePaid = 50
    end

    if money < NobleAttackFinePaid + 10:
        NobleAttackFinePaid = money - 10

        if NobleAttackFinePaid < 0:
            NobleAttackFinePaid = 0
        end
    end

    money -= NobleAttackFinePaid
---

#NobleAttackKnockoutWake
    time += 1

    if time > 5:
        time = 5
    end

    gs 'NobleAttackKnockoutWakeText'

    *p 'Стража списала ' + STR(NobleAttackFinePaid) + ' спинтарий — оскорбление дворянина.'

    SandraBirthRevealTalkReady = 1
    SandraBirthRevealTiming = 0
    SandraBirthRevealNightPending = 0

    gs 'NobleAttackRegisterMemory', 'stand_firm'

    *pl ' '

    gs 'ActUiPrepare', 'Слушать мать', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'SandraTalkAboutBirthSecret', 'PlayerRoom'
    end

    gs 'ActUiPrepare', 'Пока отдохнуть', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'PlayerRoom'
    end
---

#NobleAttackMarkReveal
    SandraBirthRevealTalkReady = 1
    SandraBirthRevealTiming = ARGS[0]
    SandraBirthRevealNightPending = 0

    if SandraBirthRevealTiming = 1:
        SandraBirthRevealNightPending = 1
    end
---

#NobleAttackFinishHall
    $NobleAttackFinishReturnLoc = $ARGS[0]

    if $NobleAttackFinishReturnLoc = '':
        $NobleAttackFinishReturnLoc = 'TavernMain'
    end

    if LOC($NobleAttackFinishReturnLoc) = 0:
        $NobleAttackFinishReturnLoc = 'TavernMain'
    end

    gs 'NobleAttackRegisterMemory', $NobleAttackLastChoice

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в главный зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $NobleAttackFinishReturnLoc
    end
---

#NobleAttackRegisterMemory
    $NobleAttackMemoryChoice = LCASE($ARGS[0])

    if $NobleAttackMemoryChoice = '':
        $NobleAttackMemoryChoice = 'yield'
    end

    $LastHallEventType = 'noble_attack'
    $LastHallEventGirl = 'sandra'
    $LastHallEventText = 'В зале дворянин устроил сцену — Стефан прошёл мимо, не заметив его в углу.'
    $LastHallEventReaction = $NobleAttackMemoryChoice

    LastHallEventDay = day
    LastHallEventTime = time
    LastHallEventWeek = week
    $LastHallChoiceType = $NobleAttackMemoryChoice
    $LastHallChoiceGirl = 'sandra'
    $LastHallChoiceEvent = 'noble_attack'
    LastGirlChoiceDay['sandra'] = day
    $LastGirlChoiceType['sandra'] = $NobleAttackMemoryChoice

    if LOC('KnowledgeRegisterFact') = 1:
        gs 'KnowledgeRegisterFact', 'Stefan_NobleAttack_1'
    end

    Fact_StefanNobleAttack = 1

    killvar '$NobleAttackMemoryChoice'
---