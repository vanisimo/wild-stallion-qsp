! ================================================
! FILE: modules/events/hall/girl_policy_scene_variations_text.qsps
! MODULE: events/hall
! USER-OWNED TEXT
! Фактическое поведение в сцене после GirlPolicyResponse
! Stage: <=1 resist/reluctant · <=3 follow · 4 overstep
! PolicySceneRule: 0–3 (из GirlPolicyLastRule)
! ================================================

#GirlPolicySceneVariationText
    $GirlPolicySceneVariationText = ''

    if PolicySceneResponseStage <= 1:
        gs 'GirlPolicySceneVariationTextResist'
    elseif PolicySceneResponseStage <= 3:
        gs 'GirlPolicySceneVariationTextFollow'
    else:
        gs 'GirlPolicySceneVariationTextOverstep'
    end
---

#GirlPolicySceneVariationTextResist
    if $PolicySceneGirl = 'amanda':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Аманда помнит хозяйский наказ быть раскованнее ради звонкой монеты, но непреодолимая девичья стыдливость сковывает её по рукам и ногам. Когда пьяный гость тянется облапить её за талию, девушка судорожно прижимает поднос к груди и с испугом пятится: «Не нужно... господин, пожалуйста, пустите...» О щедрых чаевых в этот миг она даже не вспоминает, пряча запылавшее лицо.'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Аманда честно пытается выдерживать холодную строгость, но нежная натура берёт своё. Пытаясь отстранить навязчивую ладонь гостя, она путается в словах, заикается и заливается краской до самых мочек ушей, растерянно озираясь на стойку в поисках братского плеча.'
        else:
            $GirlPolicySceneVariationText = 'Аманда вспыхивает от чужих бесстыжих прикосновений и резко выдёргивает руку: «Руки при себе держите!» Всякая покорность и мысли о вежливости ради выручки мгновенно улетучиваются перед лицом девичьей гордости.'
        end
    elseif $PolicySceneGirl = 'melissa':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Мелисса наказ Стефана о доступности отлично слышала, но слепо следовать чужой глупости не собирается. Она с подчёркнутым отвращением стряхивает ладонь захмелевшего клиента и смеривает вас ледяным взглядом поверх плеча: серебро за выпивку она заберёт, но ломать из себя кабацкую девку не станет ни за какие коврижки.'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Мелисса выставляет дистанцию без лишних криков, но с такой безжалостной язвительностью, что гость чувствует себя оплёванным. Она наглядно демонстрирует залу, что границы её личного пространства определяет исключительно она сама, а не хозяйские предписания.'
        else:
            $GirlPolicySceneVariationText = 'Мелисса на корню сбивает спесь с зарвавшегося господина одной беспощадной книжной фразой. Заниматься дешёвеньким заигрыванием ради пары медных грошей она считает ниже своего достоинства.'
        end
    elseif $PolicySceneGirl = 'sandra':
        if $PolicySceneEvent = 'kitchen' or $GirlPolicyLastArea['sandra'] = 'kitchen':
            if PolicySceneRule = 3:
                $GirlPolicySceneVariationText = 'Сандра на кухне гасит любые поползновения без лишней суеты. Ей хватает одного веского окрика и тяжёлого взгляда из-под насупленных бровей, чтобы выскочивший обратно в зал гость намертво уяснил: на кухне заигрывания у печи заканчиваются синяками.'
            else:
                $GirlPolicySceneVariationText = 'Сандра держит кухню железной хозяйской хваткой. Одно её появление на пороге с чугунной сковородой в руках заставляет любого захмелевшего зеваку вспомнить о приличиях и попятиться к столам.'
            end
        else:
            $GirlPolicySceneVariationText = 'Сандра наводит порядок с привычной спокойной невозмутимостью: на чужой наглый напор у неё всегда найдётся тяжёлое хозяйское слово.'
        end
    else:
        $GirlPolicySceneVariationText = $RealName[$PolicySceneGirl] + ' поступает исключительно по собственному разумению, демонстративно проигнорировав полученное указание и выстроив жёсткую дистанцию с гостем.'
    end
---

#GirlPolicySceneVariationTextFollow
    if $PolicySceneGirl = 'amanda':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Аманда изо всех сил старается следовать напутствию: она ласково улыбается гостю и звонко отшучивается от нескромных намёков, выгадывая щедрые чаевые. Щёки её всё ещё горят румянцем, но она стойко держит разговор, бросая украдкой робкие взгляды на стойку — одобрит ли Стефан её старания?'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Аманда аккуратно и с достоинством держит благочестивую сдержанность. Наглую мужскую руку она отстраняет мягким, но непреклонным движением, ловя взгляд Стефана за стойкой с тихой благодарностью за установленный порядок.'
        else:
            $GirlPolicySceneVariationText = 'Аманда берёт ситуацию в свои тонкие ручки, но то и дело ищет глазами Стефана. Смущаясь от сальных взглядов, она тем не менее ловко и грациозно переводит чужой интерес в заказ дорогого эля.'
        end
    elseif $PolicySceneGirl = 'melissa':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Мелисса виртуозно крутит захмелевшим клиентом, словно опытный кукловод. Она поддерживает лёгкий, дразнящий интеллектуальный флирт, вытягивая из гостя серебро за серебром, но ни на волосок не подпуская его загребущие пальцы к подолу платья.'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Мелисса чертит границу с математической точностью и филигранным изяществом. Посетителю не остаётся ничего иного, кроме как сконфуженно убрать руки под стол и смирно дожидаться своего заказа.'
        else:
            $GirlPolicySceneVariationText = 'Мелисса хладнокровно и расчётливо ведёт диалог сама, безупречно удерживая столы на нужной дистанции и извлекая максимум выгоды для заведения.'
        end
    elseif $PolicySceneGirl = 'sandra':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Сандра исполняет наказ о прибыли по-хозяйски основательно и без тени пустого кокетства. Она уверенно забирает звонкую монету за двойные порции жаркого, а любые неуклюжие попытки прикоснуться к ней на кухонной половине обрывает на полуслове.'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Сандра поддерживает железный порядок у горячей плиты ровным, уверенным тоном. Руки при себе, горячее на стол — в её владениях нет места пустому трёпу и пьяной суете.'
        else:
            $GirlPolicySceneVariationText = 'Сандра улаживает дело одной увесистой фразой, недвусмысленно отправляя заглянувшего на кухню гостя обратно за дубовый стол в зале.'
        end
    else:
        $GirlPolicySceneVariationText = $RealName[$PolicySceneGirl] + ' спокойно и добросовестно выполняет хозяйское распоряжение, уверенно держа гостей в руках.'
    end
---

#GirlPolicySceneVariationTextOverstep
    if $PolicySceneGirl = 'amanda':
        if PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Она должна была блюсти строгую сдержанность, но почему-то задерживается у стола дольше положенного. Девушка лукаво поглядывает на стойку из-под полуопущенных ресниц, словно намеренно дразня Стефана и проверяя, где именно заканчивается его строгое правило.'
        elseif PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Аманда заходит куда дальше невинной трактирной беседы. Она увлекается азартной игрой с гостем, её щёки пылают, а звонкий смех разносится по всему залу: смущаясь собственной неожиданной смелости, она тем не менее позволяет клиенту наклониться к себе слишком близко.'
        else:
            $GirlPolicySceneVariationText = 'Аманда проявляет неожиданную, почти дерзкую инициативу, увлекаясь вниманием зала и то и дело жадно проверяя реакцию Стефана.'
        end
    elseif $PolicySceneGirl = 'melissa':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Мелисса неприкрыто паясничает и переигрывает в раскованность, устраивая перед захмелевшим столом и вами целый вызывающий фарс, словно насмешливо бросая Стефану вызов: «Ну что, братец, любуйся — вот она, твоя хвалёная выручка!»'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Мелисса срезает подвыпившего наглеца столь убийственным сарказмом и ледяным высокомерием, что мужик буквально вжимается в лавку, а вместе с его спесью улетучивается и всякое желание платить за ужин.'
        else:
            $GirlPolicySceneVariationText = 'Мелисса обращает предоставленную свободу в свою собственную едкую и рискованную игру, держа весь зал на острие сатирического ножа.'
        end
    elseif $PolicySceneGirl = 'sandra':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Сандра выжимает из наглого клиента серебро столь свирепо и бескомпромиссно, нависая над ним у кухонного проёма, что гость торопливо выворачивает карманы, лишь бы не получить по шее тяжёлой лопаткой.'
        else:
            $GirlPolicySceneVariationText = 'Сандра обрывает любые попытки сунуться на кухню столь прямолинейно и грозно, что у опешившего гостя напрочь пропадает охота не то что шутить, а вообще поднимать глаза от миски.'
        end
    else:
        $GirlPolicySceneVariationText = $RealName[$PolicySceneGirl] + ' откровенно переходит все общепринятые рамки, действуя на грани дозволенного и накаляя обстановку вокруг стола.'
    end
---
