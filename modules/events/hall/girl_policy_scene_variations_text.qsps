! ================================================
! FILE: modules/events/hall/girl_policy_scene_variations_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Фактическое поведение в сцене после GirlPolicyResponse
! Stage: <=1 resist/reluctant · <=3 follow · 4 overstep
! PolicySceneRule: 0–3 (из GirlPolicyLastRule)
! ================================================

#GirlPolicySceneVariationText
    $GirlPolicySceneVariationText = ''

    if PolicySceneResponseStage <= 1:
        gs 'GirlPolicySceneVariationTextResist'
    elseif PolicySceneResponseStage <= 3:
        gs 'GirlPolicySceneVariationTextFollow'
    else:
        gs 'GirlPolicySceneVariationTextOverstep'
    end
---

#GirlPolicySceneVariationTextResist
    if $PolicySceneGirl = 'amanda':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Аманда помнит разговоры о том, что можно быть приветливее ради выручки, но терпеть наглость не собирается. Когда захмелевший гость пытается бесцеремонно потянуть её за талию, девушка ловко отступает назад, преграждая ему путь подносом: «Руки при себе держите, господин! Я вам напитки разношу». Она сердито вскидывает подбородок и бросает взгляд на стойку, давая понять, что угождать хамам не станет.'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Аманда старается держать строгость, подражая Мелиссе, но напускная суровость даётся ей нелегко: строгий взгляд получается скорее обиженным, а голос звучит слишком мягко. Заметив, что гость не воспринимает её насупленный вид всерьёз и продолжает посмеиваться, девушка отстраняется и выразительно оглядывается на стойку, ожидая поддержки Стефана.'
        else:
            $GirlPolicySceneVariationText = 'Аманда вспыхивает от бесцеремонного жеста и решительно отдёргивает руку: «Не распускайте руки!» Всякая мысль о вежливости ради выгоды моментально уступает место девичьей гордости, и она гордо отступает на шаг.'
        end
    elseif $PolicySceneGirl = 'melissa':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Мелисса выслушала мысли о большей приветливости, но потакать дурному вкусу не намерена. Она хладнокровно отстраняет ладонь захмелевшего клиента и смеривает его ледяным, убийственно спокойным взглядом: «Ваше право — заказывать вино, господин, но не воображать, будто вместе с кружкой вы покупаете моё снисхождение». Бросив на Стефана насмешливый взгляд через плечо, она даёт понять, что разменивать своё достоинство на пустые ужимки перед невеждами не станет.'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Мелисса обозначает дистанцию, с такой язвительностью, что гость мгновенно теряет спесь. Она  напоминает посетителю о нормах приличия, демонстрируя, что рамки в этом зале диктует она сама, а не чужие капризы.'
        else:
            $GirlPolicySceneVariationText = 'Мелисса осаживает зарвавшегося посетителя одной точной, колкой фразой. Заниматься угодничеством ради пары медяков она считает пустой тратой времени, оставляя сконфуженного гостя наедине с его кружкой.'
        end
    elseif $PolicySceneGirl = 'sandra':
        if $PolicySceneEvent = 'kitchen' or $GirlPolicyLastArea['sandra'] = 'kitchen':
            if PolicySceneRule = 3:
                $GirlPolicySceneVariationText = 'Сандра на кухне пресекает любые вольности сразу и на корню. Ей хватает одного веского слова и строгого взгляда из-под насупленных бровей, чтобы сунувшийся к плите гость моментально уяснил: хозяйка кухни шутить не любит, а заигрывания у горячего очага быстро заканчиваются ухватом по боку.'
            else:
                $GirlPolicySceneVariationText = 'Сандра держит кухонный порог твёрдой рукой. Одно её внушительное появление с тяжёлой поварёшкой в руках заставляет захмелевшего гостя забыть о дерзостях и поспешно пятиться обратно за столы в зал.'
            end
        else:
            $GirlPolicySceneVariationText = 'Сандра наводит порядок с привычной невозмутимостью: на любую чужую наглость у неё всегда наготове веское хозяйское слово, осаживающее гостя на месте.'
        end
    else:
        $GirlPolicySceneVariationText = $RealName[$PolicySceneGirl] + ' поступает исключительно по собственному разумению, спокойно и твёрдо осаживая гостя и выстраивая чёткую дистанцию.'
    end
---

#GirlPolicySceneVariationTextFollow
    if $PolicySceneGirl = 'amanda':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Аманда с явным удовольствием пускает в ход очарование: она приветливо улыбается гостю, мило шутит про долгую дорогу и ловко отводит разговор от нескромных жестов прямо к заказу лучшего вина. Монеты весело звенят в её переднике, а довольная девушка бросает озорной взгляд в сторону стойки, ловя одобрение Стефана.'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Аманда аккуратно и с достоинством держит дистанцию. Лишние вольности гостя она отстраняет мягким, но твёрдым движением, спокойно напоминая о порядке в зале и уверенно чувствуя за спиной надёжное плечо брата.'
        else:
            $GirlPolicySceneVariationText = 'Аманда ловко управляется с ситуацией сама: смущаясь для виду, она тем не менее грациозно переводит чужой интерес в заказ двойной порции эля и щедрые чаевые.'
        end
    elseif $PolicySceneGirl = 'melissa':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Мелисса виртуозно направляет захмелевшего клиента, ведя тонкую игру на его тщеславии. Она поддерживает лёгкую, дразнящую беседу, заставляя гостя охотно раскошеливаться на дорогое вино и чувствовать себя благородным рыцарем, но ни на палец не подпуская его руки к себе.'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Мелисса чертит границу дозволенного с безупречной чёткостью и элегантностью. Посетителю не остаётся ничего иного, кроме как умерить пыл, вернуть руки на стол и смирно дожидаться своего заказа под её строгим взглядом.'
        else:
            $GirlPolicySceneVariationText = 'Мелисса хладнокровно и расчётливо ведёт разговор сама, безупречно удерживая стол на нужной дистанции и извлекая из наивной мужской щедрости максимум серебра.'
        end
    elseif $PolicySceneGirl = 'sandra':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Сандра действует по-хозяйски основательно и с толком. Без тени пустого кокетства она аппетитно нахваливает свежее жаркое и горячий хлеб, уверенно собирая плату за двойные порции и пресекая любые глупости в зародыше.'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Сандра поддерживает образцовый порядок у горячей плиты спокойным и уверенным тоном. В её владениях нет места пустому трёпу и пьяной суете: еда подаётся вовремя, а руки гости держат при себе.'
        else:
            $GirlPolicySceneVariationText = 'Сандра улаживает дело одной увесистой фразой, недвусмысленно и спокойно отправляя заглянувшего гостя обратно за дубовый стол в зале.'
        end
    else:
        $GirlPolicySceneVariationText = $RealName[$PolicySceneGirl] + ' спокойно и уверенно держит разговор с гостями, не допуская лишних вольностей и успешно пополняя кассу заведения.'
    end
---

#GirlPolicySceneVariationTextOverstep
    if $PolicySceneGirl = 'amanda':
        if PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Она должна была держать сдержанную дистанцию, но почему-то задерживается у стола дольше положенного. Аманда лукаво поглядывает из-под полуопущенных ресниц, поддразнивая захмелевшего гостя и словно нарочно испытывая терпение Стефана за стойкой.'
        elseif PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Аманда входит в настоящий азарт, заходя в заигрываниях дальше обычной трактирной беседы. Её щёки пылают, звонкий смех разносится по залу, и, увлёкшись открытым вниманием, она позволяет гостю наклониться к себе слишком близко, заставляя соседние столы жадно вытягивать шеи.'
        else:
            $GirlPolicySceneVariationText = 'Аманда проявляет неожиданную, почти дерзкую смелость: воодушевлённая успехом, она дразнит гостя на грани фола, то и дело озорно поглядывая на Стефана и проверяя его реакцию.'
        end
    elseif $PolicySceneGirl = 'melissa':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Мелисса чересчур увлекается своей интеллектуальной провокацией. С тонкой насмешливой улыбкой она балансирует на грани двусмысленности, даря простофиле каплю обманчивой надежды и распаляя его воображение так, что за столом закипает опасное возбуждение. Бросив взгляд на Стефана, она словно бросает немой вызов: «Ну что, братец, любуйся — вот как работает твоя выгода».'
        elseif PolicySceneRule = 1:
            $GirlPolicySceneVariationText = 'Мелисса срезает подвыпившего гостя столь ледяным сарказмом и академическим высокомерием, что тот багровеет от унижения и в сердцах швыряет недопитую кружку на стол, напрочь отказываясь заказывать что-либо ещё.'
        else:
            $GirlPolicySceneVariationText = 'Мелисса превращает предоставленную свободу в собственный сатирический театр, столь едко высмеивая манеры захмелевших гостей, что обстановка за столом накаляется до предела.'
        end
    elseif $PolicySceneGirl = 'sandra':
        if PolicySceneRule = 3:
            $GirlPolicySceneVariationText = 'Сандра вытряхивает из настырного гостя серебро с такой грозной хозяйской прямотой, буквально нависая над ним у кухонного проёма с тяжёлой поварёшкой, что тот торопливо выворачивает карманы, лишь бы поскорее убраться обратно в зал.'
        else:
            $GirlPolicySceneVariationText = 'Сандра обрывает попытку сунуться на кухню столь резко и сокрушительно, огрев наглеца полотенцем и окатив ковшом холодной воды, что в зале поднимается изрядный переполох.'
        end
    else:
        $GirlPolicySceneVariationText = $RealName[$PolicySceneGirl] + ' явно переступает границы привычного, действуя слишком смело и накаляя обстановку вокруг стола.'
    end
---
