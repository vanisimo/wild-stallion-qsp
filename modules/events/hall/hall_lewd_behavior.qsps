! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Скандальное поведение девушки в зале
! Версия: v1.1 / policy talk hook
! Назначение:
! - отдельная система для случаев, когда девушка уже сама играет вниманием клиентов
! - работает для Аманды, Мелиссы и Сандры
! - не заменяет hall_harassment и hall_missing_girl
! - выбор игрока короткий: пресечь / наблюдать / поощрить ради чаевых
! - картинки обязательны через ShowImage и debug-путь
! - после события даёт живой разговор о правилах, если подключён GirlWorkPolicyTalk
!
! Тексты берутся из:
! modules/events/hall/hall_lewd_behavior_text.qsps
! ================================================

#HallLewdBehaviorCanStart
    HallLewdBehaviorCanStart = 0
    $HallLewdSelectedGirl = ''

    ! Не «ранний» контент: до семейного ужина / liberation — только harassment.
    if FamilyLiberationGateOpen = 0:
        exit
    end

    if Act1MoralUnlocked = 0:
        exit
    end

    if HallLewdBehaviorDisabled = 1:
        exit
    end

    if time = 5:
        exit
    end

    if week = 7:
        exit
    end

    if week = 5 and time = 4:
        exit
    end

    if HallLewdLastGlobalDay = day and HallLewdLastGlobalTime = time:
        exit
    end

    if LOC('IsTavernOpen') = 1:
        gs 'IsTavernOpen'

        if TavernOpen = 0:
            exit
        end
    end

    gs 'HallLewdPickCandidate'

    if $HallLewdSelectedGirl <> '':
        HallLewdBehaviorCanStart = 1
    end
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Попытка автозапуска
! ARGS[0] — куда возвращаться после события
! ================================================

#HallLewdBehaviorTryAutoStart
    $HallLewdReturnLoc = $ARGS[0]

    if $HallLewdReturnLoc = '':
        $HallLewdReturnLoc = 'TavernMain'
    end

    if LOC($HallLewdReturnLoc) = 0:
        $HallLewdReturnLoc = 'TavernMain'
    end

    gs 'HallLewdBehaviorCanStart'

    if HallLewdBehaviorCanStart = 1:
        gt 'HallLewdBehaviorStart', $HallLewdSelectedGirl, $HallLewdReturnLoc
    end
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Подбор девушки
! ================================================

#HallLewdPickCandidate
    $HallLewdSelectedGirl = ''
    HallLewdCandidateCount = 0

    gs 'HallLewdCheckCandidate', 'amanda'
    gs 'HallLewdCheckCandidate', 'melissa'
    gs 'HallLewdCheckCandidate', 'sandra'

    if HallLewdCandidateCount <= 0:
        exit
    end

    HallLewdPick = RAND(1, HallLewdCandidateCount)
    $HallLewdSelectedGirl = $HallLewdCandidate[HallLewdPick]

    killvar 'HallLewdPick'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Проверка девушки
! ================================================

#HallLewdCheckCandidate
    gs 'HallLewdNormalizeKey', $ARGS[0]
    $HallLewdCheckGirl = $HallLewdGirlKey

    if $HallLewdCheckGirl = '':
        exit
    end

    if HallLewdLastDay[$HallLewdCheckGirl] = day:
        exit
    end

    ! «Сама играет» — не когда только что приказали и она отказывается.
    ! Нужна личная готовность ИЛИ согласие с раскованной политикой.
    if sluttiness[$HallLewdCheckGirl] < 22 and GirlNpcPath[$HallLewdCheckGirl] < 18:
        if GirlWorkPolicy[$HallLewdCheckGirl] <> 3 or GirlPolicyAgreement[$HallLewdCheckGirl] < 2:
            killvar '$HallLewdCheckGirl'
            exit
        end
    end

    if GirlWorkPolicy[$HallLewdCheckGirl] = 3 and GirlPolicyAgreement[$HallLewdCheckGirl] <= 1 and sluttiness[$HallLewdCheckGirl] < 28:
        ! Приказ «раскованнее», но фактически refuse/against — это harassment, не lewd.
        killvar '$HallLewdCheckGirl'
        exit
    end

    gs 'HallLewdGetStage', $HallLewdCheckGirl

    ! Это не ранняя сцена. Для ранних случаев есть hall_harassment.
    if HallLewdStage < 2:
        killvar '$HallLewdCheckGirl'
        exit
    end

    HallLewdChance = 12

    if HallLewdStage = 2:
        HallLewdChance = 20
    elseif HallLewdStage = 3:
        HallLewdChance = 32
    elseif HallLewdStage >= 4:
        HallLewdChance = 45
    end

    if GirlUniformLevel[$HallLewdCheckGirl] = 1:
        HallLewdChance += 8
    end

    if GirlNoPantiesWork[$HallLewdCheckGirl] = 1:
        HallLewdChance += 6
    end

    if GirlWorkPolicy[$HallLewdCheckGirl] = 1:
        HallLewdChance -= 25
    elseif GirlWorkPolicy[$HallLewdCheckGirl] = 3:
        if GirlPolicyAgreement[$HallLewdCheckGirl] >= 2:
            HallLewdChance += 15
        else:
            HallLewdChance += 3
        end
    end

    if HallLewdChance < 3:
        HallLewdChance = 3
    end

    if HallLewdChance > 75:
        HallLewdChance = 75
    end

    if RAND(1, 100) <= HallLewdChance:
        HallLewdCandidateCount += 1
        $HallLewdCandidate[HallLewdCandidateCount] = $HallLewdCheckGirl
    end

    killvar '$HallLewdCheckGirl'
    killvar 'HallLewdChance'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Нормализация ключа девушки
! ================================================

#HallLewdNormalizeKey
    if LOC('NormalizeGirlKey') = 1:
        gs 'NormalizeGirlKey', $ARGS[0]
        $HallLewdGirlKey = $GirlKey
    else:
        $HallLewdGirlKey = LCASE($ARGS[0])
    end
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Имя девушки
! ================================================

#HallLewdEnsureName
    gs 'HallLewdNormalizeKey', $ARGS[0]
    $HallLewdNameGirl = $HallLewdGirlKey

    if $RealName[$HallLewdNameGirl] = '':
        if $HallLewdNameGirl = 'amanda':
            $RealName[$HallLewdNameGirl] = 'Аманда'
        elseif $HallLewdNameGirl = 'melissa':
            $RealName[$HallLewdNameGirl] = 'Мелисса'
        elseif $HallLewdNameGirl = 'sandra':
            $RealName[$HallLewdNameGirl] = 'Сандра'
        else:
            $RealName[$HallLewdNameGirl] = $HallLewdNameGirl
        end
    end

    killvar '$HallLewdNameGirl'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Расчёт стадии скандального поведения в зале
! ================================================

#HallLewdGetStage
    gs 'HallLewdNormalizeKey', $ARGS[0]
    $HallLewdStageGirl = $HallLewdGirlKey

    HallLewdStage = 0
    HallLewdScore = 0

    if $HallLewdStageGirl = '':
        exit
    end

    ! Таверна / слухи (смягчено: раньше скандал один-в-один раздувал stage)
    HallLewdScore += TavernScandal / 2
    HallLewdScore += TavernLewdFame / 2
    HallLewdScore += TavernGirlsEasyRumor * 4

    ! GirlHallLewdStage — прогресс от прошлых lewd-сцен (не *20: была петля → score 100+)
    if GirlHallLewdStage[$HallLewdStageGirl] < 0:
        GirlHallLewdStage[$HallLewdStageGirl] = 0
    end

    if GirlHallLewdStage[$HallLewdStageGirl] > 4:
        GirlHallLewdStage[$HallLewdStageGirl] = 4
    end

    HallLewdScore += GirlHallLewdStage[$HallLewdStageGirl] * 6

    HallLewdScore += GirlPublicAttention[$HallLewdStageGirl] / 2
    HallLewdScore += GirlNpcPath[$HallLewdStageGirl] / 2
    HallLewdScore += GirlSecretiveness[$HallLewdStageGirl] / 3
    HallLewdScore += GirlRebellion[$HallLewdStageGirl] / 2
    HallLewdScore += sluttiness[$HallLewdStageGirl] / 3

    if GirlUniformLevel[$HallLewdStageGirl] > 1:
        GirlUniformLevel[$HallLewdStageGirl] = 1
    end

    if GirlUniformLevel[$HallLewdStageGirl] < 0:
        GirlUniformLevel[$HallLewdStageGirl] = 0
    end

    if GirlUniformLevel[$HallLewdStageGirl] = 1:
        HallLewdScore += 10
    end

    if GirlWorkPolicy[$HallLewdStageGirl] = 1:
        HallLewdScore -= 15
    elseif GirlWorkPolicy[$HallLewdStageGirl] = 2:
        HallLewdScore += 3
    elseif GirlWorkPolicy[$HallLewdStageGirl] = 3:
        ! Приказ «раскованнее» без согласия почти не поднимает lewd-stage
        if GirlPolicyAgreement[$HallLewdStageGirl] >= 2:
            HallLewdScore += 18
        elseif GirlPolicyAgreement[$HallLewdStageGirl] = 1:
            HallLewdScore += 6
        else:
            HallLewdScore += 2
        end
    end

    ! Только уникальные шкалы (без дубля GirlPublicAttention / GirlNpcPath)
    if $HallLewdStageGirl = 'amanda':
        HallLewdScore += AmandaScandalLevel / 2

        if uniform_purchased['amanda'] = 1 or revealing_uniform_worn = 1:
            GirlUniformLevel['amanda'] = 1
        end
    elseif $HallLewdStageGirl = 'melissa':
        HallLewdScore += MelissaScandalTolerance / 2
        HallLewdScore += MelissaJealousy / 3
        HallLewdScore += MelissaControlNeed / 3

        if uniform_purchased['melissa'] = 1 or revealing_uniform_worn = 1:
            GirlUniformLevel['melissa'] = 1
        end
    elseif $HallLewdStageGirl = 'sandra':
        HallLewdScore += SandraPragmatism / 3
        HallLewdScore -= SandraMoralResistance / 2
        HallLewdScore += SandraBitterness / 3

        if uniform_purchased['sandra'] = 1 or revealing_uniform_worn = 1:
            GirlUniformLevel['sandra'] = 1
        end
    end

    if HallLewdScore < 0:
        HallLewdScore = 0
    end

    ! Пороги выше: stage 2+ только когда девушка реально «играет»
    if HallLewdScore < 35:
        HallLewdStage = 0
    elseif HallLewdScore < 60:
        HallLewdStage = 1
    elseif HallLewdScore < 90:
        HallLewdStage = 2
    elseif HallLewdScore < 125:
        HallLewdStage = 3
    else:
        HallLewdStage = 4
    end

    ! Не перезаписываем GirlHallLewdStage вычисленным stage (ломало прогресс +=1 после сцен)

    killvar '$HallLewdStageGirl'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Выбор типа сцены
! ================================================

#HallLewdPickScene
    $HallLewdScene = 'bend'
    $HallLewdJob = 'waitress'

    if jobcleaning[$HallLewdGirl] = 1 and jobwaitress[$HallLewdGirl] = 0:
        $HallLewdJob = 'cleaning'
    elseif jobcleaning[$HallLewdGirl] = 1 and jobwaitress[$HallLewdGirl] = 1:
        if RAND(1, 2) = 1:
            $HallLewdJob = 'cleaning'
        end
    end

    HallLewdSceneRoll = RAND(1, 100)

    if $HallLewdJob = 'cleaning':
        if HallLewdSceneRoll <= 35:
            $HallLewdScene = 'floor'
        elseif HallLewdSceneRoll <= 65:
            $HallLewdScene = 'ladder'
        else:
            $HallLewdScene = 'fall'
        end
    else:
        if HallLewdStage <= 2:
            if HallLewdSceneRoll <= 45:
                $HallLewdScene = 'bend'
            elseif HallLewdSceneRoll <= 75:
                $HallLewdScene = 'waist'
            else:
                $HallLewdScene = 'sit_near'
            end
        elseif HallLewdStage = 3:
            if HallLewdSceneRoll <= 30:
                $HallLewdScene = 'waist'
            elseif HallLewdSceneRoll <= 60:
                $HallLewdScene = 'sit_near'
            elseif HallLewdSceneRoll <= 85:
                $HallLewdScene = 'lap'
            else:
                $HallLewdScene = 'kiss'
            end
        else:
            if HallLewdSceneRoll <= 25:
                $HallLewdScene = 'sit_near'
            elseif HallLewdSceneRoll <= 55:
                $HallLewdScene = 'lap'
            elseif HallLewdSceneRoll <= 80:
                $HallLewdScene = 'kiss'
            else:
                $HallLewdScene = 'bend'
            end
        end
    end

    if GirlConflictUntilDay[$HallLewdGirl] >= day and HallLewdStage >= 3 and $HallLewdJob <> 'cleaning':
        if HallLewdSceneRoll <= 45:
            $HallLewdScene = 'lap'
        elseif HallLewdSceneRoll <= 75:
            $HallLewdScene = 'kiss'
        else:
            $HallLewdScene = 'sit_near'
        end
    end

    killvar 'HallLewdSceneRoll'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Выбор клиента
! ================================================

#HallLewdPickClient
    HallLewdClientRoll = RAND(1, 100)

    if HallLewdClientRoll <= 35:
        $HallLewdClient = 'drunk_guest'
    elseif HallLewdClientRoll <= 65:
        $HallLewdClient = 'rich_merchant'
    elseif HallLewdClientRoll <= 85:
        $HallLewdClient = 'craftsman'
    else:
        $HallLewdClient = 'traveler'
    end

    killvar 'HallLewdClientRoll'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Вход в событие
! ================================================

#HallLewdBehaviorStart
    *clr
    clr
    cla

    gs 'HallLewdNormalizeKey', $ARGS[0]
    $HallLewdGirl = $HallLewdGirlKey
    $HallLewdReturnLoc = $ARGS[1]

    ! Защита от старых/ошибочных вызовов вида:
    ! gt 'HallLewdBehaviorStart', 'TavernMain'
    ! В этом случае TavernMain — это локация возврата, а не девушка.
    if $HallLewdGirl <> 'amanda' and $HallLewdGirl <> 'melissa' and $HallLewdGirl <> 'sandra':
        if LOC($HallLewdGirl) = 1 and $HallLewdReturnLoc = '':
            $HallLewdReturnLoc = $HallLewdGirl
        end

        $HallLewdGirl = ''
    end

    if $HallLewdReturnLoc = '':
        $HallLewdReturnLoc = 'TavernMain'
    end

    if LOC($HallLewdReturnLoc) = 0:
        $HallLewdReturnLoc = 'TavernMain'
    end

    ! Жёсткий гейт (CanStart + debug/dispatcher обходы)
    if FamilyLiberationGateOpen = 0 or Act1MoralUnlocked = 0:
        gt $HallLewdReturnLoc
    end

    if $HallLewdGirl = '':
        gs 'HallLewdPickCandidate'
        $HallLewdGirl = $HallLewdSelectedGirl
    else:
        ! Явный вызов с именем — всё равно фильтр «играет / не refuse»
        HallLewdCandidateCount = 0
        gs 'HallLewdCheckCandidate', $HallLewdGirl

        if HallLewdCandidateCount <= 0:
            $HallLewdGirl = ''
        end
    end

    if $HallLewdGirl = '':
        gt $HallLewdReturnLoc
    end

    gs 'HallLewdEnsureName', $HallLewdGirl
    gs 'HallLewdGetStage', $HallLewdGirl
    gs 'HallLewdPickScene'
    gs 'HallLewdPickClient'

    HallLewdUniform = GirlUniformLevel[$HallLewdGirl]

    if HallLewdUniform > 1:
        HallLewdUniform = 1
    end

    if HallLewdUniform < 0:
        HallLewdUniform = 0
    end

    HallLewdLastGlobalDay = day
    HallLewdLastGlobalTime = time
    HallLewdLastDay[$HallLewdGirl] = day

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $HallLewdGirl
    end

    gs 'HallLewdShowImage', 'base'

    *pl '══════════════════════════════════════════════'
    *pl ' СКАНДАЛЬНОЕ ПОВЕДЕНИЕ В ЗАЛЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'HallLewdPrintText', 'intro'

    *pl ' '

    if GirlNoPantiesWork[$HallLewdGirl] = 1:
        gs 'GirlNoPantiesEventPrintAddon', $HallLewdGirl, 'hall_lewd', 'default'
        *pl ' '
    end

    ! Краткий контекст правила — без полного refuse-текста (он ломал intro)
    if LOC('PolicyEventContextPrintStart') = 1:
        gs 'PolicyEventContextPrintStart', $HallLewdGirl, 'hall_lewd'
        *pl ' '
    end

    gs 'HallLewdPrintDecisionThoughts'

    *pl ' '

    if debug = 1:
        gs 'PolicyEventDebugPrintStart', 'HALL LEWD', $HallLewdGirl, HallLewdStage, HallLewdScore, 'scene', $HallLewdScene, $HallLewdClient, HallLewdUniform, GirlWorkPolicy[$HallLewdGirl]
    end

    gs 'HallLewdBuildMenu'

    *p 'Что делать <a href="exec:gs ''Menu.Show'', ''HallLewdMenu''">Стефану</a>?'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Меню
! ================================================


! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Мысли Стефана перед выбором
! ================================================

#HallLewdPrintDecisionThoughts
    gs 'HallEventChoiceThoughtsPrint', 'hall_lewd'
---

#HallLewdBuildMenu
    ! Канон §0c: Защитить / Наблюдать / Отвернуться (как harassment)
    gs 'Menu.Destroy', 'HallLewdMenu'
    gs 'Menu.Create', 'HallLewdMenu'

    gs 'MenuUiAdd', 'HallLewdMenu', 'Защитить', ''
    gs 'Menu.AddModule', 'HallLewdMenu', {
        gt 'HallLewdResolve', 'protect_hard', $HallLewdReturnLoc
    }

    if FamilyLiberationGateOpen = 1:
        gs 'MenuUiAdd', 'HallLewdMenu', 'Наблюдать', ''
        gs 'Menu.AddModule', 'HallLewdMenu', {
            gt 'HallLewdResolve', 'watch', $HallLewdReturnLoc
        }

        gs 'MenuUiAdd', 'HallLewdMenu', 'Отвернуться', ''
        gs 'Menu.AddModule', 'HallLewdMenu', {
            gt 'HallLewdResolve', 'ignore', $HallLewdReturnLoc
        }
    end
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Разрешение
! ================================================

#HallLewdResolve
    *clr
    clr
    cla

    $HallLewdChoice = LCASE($ARGS[0])
    $HallLewdReturnLoc = $ARGS[1]

    if $HallLewdReturnLoc = '':
        $HallLewdReturnLoc = 'TavernMain'
    end

    if LOC($HallLewdReturnLoc) = 0:
        $HallLewdReturnLoc = 'TavernMain'
    end

    if $HallLewdGirl <> 'amanda' and $HallLewdGirl <> 'melissa' and $HallLewdGirl <> 'sandra':
        gs 'HallLewdPickCandidate'
        $HallLewdGirl = $HallLewdSelectedGirl
    end

    if $HallLewdGirl = '':
        $HallLewdGirl = 'amanda'
    end

    gs 'HallLewdEnsureName', $HallLewdGirl

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $HallLewdGirl
    end

    *pl '══════════════════════════════════════════════'
    *pl ' СКАНДАЛЬНОЕ ПОВЕДЕНИЕ В ЗАЛЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    ! Alias legacy keys → канон
    if $HallLewdChoice = 'stop':
        $HallLewdChoice = 'protect_hard'
    elseif $HallLewdChoice = 'encourage':
        $HallLewdChoice = 'ignore'
    end

    if FamilyLiberationGateOpen = 0:
        $HallLewdChoice = 'protect_hard'
    end

    if $HallLewdChoice = 'protect_hard':
        gs 'HallLewdApplyConsequences', 'protect_hard'
        gs 'HallLewdShowImage', 'stop'
        gs 'HallLewdPrintText', 'stop'

    elseif $HallLewdChoice = 'watch':
        gs 'HallLewdApplyConsequences', 'watch'
        gs 'HallLewdShowImage', 'watch'
        gs 'HallLewdPrintText', 'watch'

    elseif $HallLewdChoice = 'ignore':
        gs 'HallLewdApplyConsequences', 'ignore'
        gs 'HallLewdShowImage', 'encourage'
        gs 'HallLewdPrintText', 'encourage'

    else:
        $HallLewdChoice = 'protect_hard'
        gs 'HallLewdApplyConsequences', 'protect_hard'
        gs 'HallLewdShowImage', 'stop'
        gs 'HallLewdPrintText', 'stop'
    end

    gs 'PolicyEventChoiceConsequencePrint', 'hall_lewd', $HallLewdChoice, $HallLewdGirl

    *pl ' '

    if debug = 1:
        *pl '[DEBUG HALL LEWD] choice: ' + $HallLewdChoice
        *pl '[DEBUG HALL LEWD] TavernScandal: ' + STR(TavernScandal)
        *pl '[DEBUG HALL LEWD] TavernLewdFame: ' + STR(TavernLewdFame)
        *pl '[DEBUG HALL LEWD] GirlPublicAttention: ' + STR(GirlPublicAttention[$HallLewdGirl])
        *pl '[DEBUG HALL LEWD] GirlNpcPath: ' + STR(GirlNpcPath[$HallLewdGirl])
        *pl ' '
    end

    ! После сцены — то же policy-меню, что у harassment (сдержанно / сама / расковано)
    $HallHarassGirl = $HallLewdGirl
    $HallHarassConsequenceArea = 'hall'
    $HallHarassReturnLoc = $HallLewdReturnLoc
    $HallHarassReaction = $HallLewdChoice
    $HallScenePolicySource = 'lewd'
    HallHarassPolicyChosen = 0
    HallHarassPolicyValue = 0

    gs 'GirlWorkPolicyTalkPrintText', 'after_harass_intro'
    *pl ' '
    gs 'HallHarassmentBuildPolicyMenu'
    gs 'HallHarassmentPrintGirlPolicyMenuLine'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $HallLewdReturnLoc
    end

    killvar '$HallLewdChoice'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Последствия
! ================================================

#HallLewdApplyConsequences
    $HallLewdApplyChoice = LCASE($ARGS[0])
    HallLewdPreviousPolicy = GirlWorkPolicy[$HallLewdGirl]

    if $HallLewdApplyChoice = 'stop' or $HallLewdApplyChoice = 'protect_hard':
        ! Не форсим policy=1 здесь — правило задаётся в after-menu
        GirlPublicAttention[$HallLewdGirl] -= 1
        GirlNpcPath[$HallLewdGirl] -= 1
        GirlSecretiveness[$HallLewdGirl] += 1
        GirlRebellion[$HallLewdGirl] += 1
        TavernScandal -= 1

        if GirlTrustStefan[$HallLewdGirl] > 0:
            GirlTrustStefan[$HallLewdGirl] += 1
        end

        if HallLewdPreviousPolicy = 3 and HallLewdStage >= 3:
            GirlConflictUntilDay[$HallLewdGirl] = day + 2
            GirlConflictLevel[$HallLewdGirl] += 1
            hate[$HallLewdGirl] += 1
        end

    elseif $HallLewdApplyChoice = 'watch':
        gs 'AwardGirlTipsFromBase', $HallLewdGirl, 10 + HallLewdStage * 5
        TavernScandal += 1
        TavernLewdFame += 1
        GirlPublicAttention[$HallLewdGirl] += 1
        GirlNpcPath[$HallLewdGirl] += 1

        if GirlWorkPolicy[$HallLewdGirl] = 1:
            GirlSecretiveness[$HallLewdGirl] += 2
        end

        if $HallLewdGirl = 'amanda':
            if LOC('KnowledgeRegisterFact') = 1:
                gs 'KnowledgeRegisterFact', 'amanda_hall_lewd_witness'
            end

            if LOC('KnowledgeRegisterPlayerKnows') = 1:
                gs 'KnowledgeRegisterPlayerKnows', 'amanda_hall_lewd_witness', 'witness'
            end
        end

    elseif $HallLewdApplyChoice = 'encourage' or $HallLewdApplyChoice = 'ignore':
        ! «Отвернуться» = самый выгодный исход (чаевые), policy не форсим
        gs 'AwardGirlTipsFromBase', $HallLewdGirl, 20 + HallLewdStage * 10
        TavernScandal += 2
        TavernLewdFame += 2
        TavernGirlsEasyRumor = 1
        GirlPublicAttention[$HallLewdGirl] += 2
        GirlNpcPath[$HallLewdGirl] += 2
        GirlHallLewdStage[$HallLewdGirl] += 1

        if $HallLewdGirl = 'amanda':
            if LOC('KnowledgeRegisterFact') = 1:
                gs 'KnowledgeRegisterFact', 'amanda_hall_lewd_witness'
            end

            if LOC('KnowledgeRegisterPlayerKnows') = 1:
                gs 'KnowledgeRegisterPlayerKnows', 'amanda_hall_lewd_witness', 'witness'
            end
        end
    end

    if GirlPublicAttention[$HallLewdGirl] < 0:
        GirlPublicAttention[$HallLewdGirl] = 0
    end

    if GirlNpcPath[$HallLewdGirl] < 0:
        GirlNpcPath[$HallLewdGirl] = 0
    end

    if TavernScandal < 0:
        TavernScandal = 0
    end

    ! Мосты к индивидуальным переменным.
    if $HallLewdGirl = 'amanda':
        AmandaPublicAttention = GirlPublicAttention['amanda']
        AmandaNpcPath = GirlNpcPath['amanda']
        AmandaSecretiveness = GirlSecretiveness['amanda']
        AmandaRebellion = GirlRebellion['amanda']
        AmandaScandalLevel += 1
    elseif $HallLewdGirl = 'melissa':
        MelissaNpcPath = GirlNpcPath['melissa']
        MelissaScandalTolerance += 1
        MelissaFamilyConcern += 1
    elseif $HallLewdGirl = 'sandra':
        SandraNpcPath = GirlNpcPath['sandra']
        SandraMoralResistance -= 1
        SandraFamilyConcern += 1

        if SandraMoralResistance < 0:
            SandraMoralResistance = 0
        end
    end

killvar '$HallLewdApplyChoice'
killvar 'HallLewdPreviousPolicy'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Показ картинки
! ================================================

#HallLewdShowImage
    $HallLewdImageOutcome = LCASE($ARGS[0])

    if $HallLewdImageOutcome = '':
        $HallLewdImageOutcome = 'base'
    end

    if $HallLewdGirl = '':
        exit
    end

    if $HallLewdScene = '':
        $HallLewdScene = 'bend'
    end

    HallLewdUniform = GirlUniformLevel[$HallLewdGirl]

    if HallLewdUniform > 1:
        HallLewdUniform = 1
    end

    if HallLewdUniform < 0:
        HallLewdUniform = 0
    end

    if $HallLewdImageOutcome = 'base':
        $HallLewdImageAction = 'hall_lewd/' + $HallLewdScene
        $HallLewdImagePose = 'uniform' + STR(HallLewdUniform) + '_base'
    else:
        $HallLewdImageAction = 'hall_lewd/reaction'
        $HallLewdImagePose = 'uniform' + STR(HallLewdUniform) + '_' + $HallLewdImageOutcome
    end

    if LOC('ShowImage') = 1:
        gs 'ShowImage', 'event', $HallLewdGirl, $HallLewdImageAction, $HallLewdImagePose, 'webp', 'large'
    end

    if debug = 1:
        *pl '[DEBUG HALL LEWD IMAGE] expected: images/events/' + $HallLewdGirl + '/' + $HallLewdImageAction + '_' + $HallLewdImagePose + '.webp'
        *pl ' '
    end

    killvar '$HallLewdImageOutcome'
    killvar '$HallLewdImageAction'
    killvar '$HallLewdImagePose'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Debug-старт
! ================================================

#HallLewdDebugStart
    $DebugHallLewdGirl = LCASE($ARGS[0])

    if $DebugHallLewdGirl = '':
        $DebugHallLewdGirl = 'amanda'
    end

    TavernScandal = 35
    TavernLewdFame = 20
    TavernGirlsEasyRumor = 1

    GirlUniformLevel[$DebugHallLewdGirl] = 1
    GirlWorkPolicy[$DebugHallLewdGirl] = 2
    GirlHallLewdStage[$DebugHallLewdGirl] = 3
    GirlPublicAttention[$DebugHallLewdGirl] = 30
    GirlNpcPath[$DebugHallLewdGirl] = 20
    GirlSecretiveness[$DebugHallLewdGirl] = 10
    GirlRebellion[$DebugHallLewdGirl] = 10

    if $DebugHallLewdGirl = 'amanda':
        AmandaScandalLevel = 35
        AmandaPublicAttention = 30
        AmandaNpcPath = 20
        AmandaSecretiveness = 10
        AmandaRebellion = 10
    end

    gt 'HallLewdBehaviorStart', $DebugHallLewdGirl, 'TavernMain'
---

! ================================================
! FILE: modules/events/hall/hall_lewd_behavior.qsps
! Debug-сброс
! ================================================

#HallLewdDebugReset
    HallLewdBehaviorDisabled = 0
    HallLewdBehaviorCanStart = 0
    HallLewdLastGlobalDay = 0
    HallLewdLastGlobalTime = 0

    killvar '$HallLewdSelectedGirl'
    killvar '$HallLewdGirl'
    killvar '$HallLewdScene'
    killvar '$HallLewdClient'
---

