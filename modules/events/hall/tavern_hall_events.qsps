! ================================================
! FILE: modules/events/hall/tavern_hall_events.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! События главного зала таверны
! Запускаются через кнопку "Осмотреть зал"
! Одно событие на одну часть дня
! Сохраняют последнее событие для панели трактира
! Visual: #TavernHallEventShowVisual → SceneShowVisual + [VIS]
! ================================================

! ARGS[0]=asset key  ARGS[1]=русская подпись кадра
#TavernHallEventShowVisual
    $thvKey = LCASE($ARGS[0])
    $thvCap = $ARGS[1]

    if $thvKey = '':
        $thvKey = 'look'
    end

    if $thvCap = '':
        $thvCap = 'осмотр зала: ' + $thvKey
    end

    if LOC('SceneShowVisual') = 1:
        gs 'SceneShowVisual', 'images/events/tavern/hall_look/' + $thvKey, $thvCap, 'large', 'webp'
    elseif LOC('ShowImage') = 1:
        gs 'ShowImage', 'common', '', 'hall_scene_stub', '', 'png', 'large'
        *pl '<center><small>[VIS] ' + $thvCap + '</small></center>'
        if debug = 1 or debug_images = 1:
            *pl '<center><small>[VIS future] images/events/tavern/hall_look/' + $thvKey + '.webp</small></center>'
        end
        *pl ' '
    end

    killvar '$thvKey'
    killvar '$thvCap'
---

#TavernHallEventStart
    *clr
    clr
    cla

    gs 'GetDateTimeNames'
    gs 'IsTavernOpen'
    gs 'UpdateGirlLocations'

    if LOC('CalculateTavernStaffEfficiency') = 1:
        gs 'CalculateTavernStaffEfficiency'
    end

    if TavernOpen = 0:
        *pl '══════════════════════════════════════════════'
        *pl ' ОСМОТР ГЛАВНОГО ЗАЛА'
        *pl '══════════════════════════════════════════════'
        *pl ' '
        gs 'TavernHallEventShowVisual', 'closed', 'зал закрыт: пустые столы, погашенный свет'

        *pl 'Сейчас таверна закрыта, и наблюдать в зале не за чем.'

        if $TavernClosedReason <> '':
            *pl 'Причина: ' + $TavernClosedReason
        end

        gs 'SaveLastHallEvent', 'closed', '', 'Стефан осмотрел главный зал, но таверна была закрыта.', 'none'

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end

        exit
    end

    if TavernHallEventDay = day and TavernHallEventTime = time:
        *pl '══════════════════════════════════════════════'
        *pl ' ОСМОТР ГЛАВНОГО ЗАЛА'
        *pl '══════════════════════════════════════════════'
        *pl ' '
        gs 'TavernHallEventShowVisual', 'already_looked', 'зал: уже осматривали в эту часть дня — привычная суета'

        *pl 'Стефан уже обходил столы совсем недавно. В зале всё идёт заведённым чередом: кружки пенятся, мясо шкворчит, а гости мирно тянут хмель, не требуя хозяйского вмешательства.'

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end

        exit
    end

    TavernHallEventDay = day
    TavernHallEventTime = time

    ! Реакция на активное дневное макро-событие (крысы, бочка, караван)
    if TavernDayEventActive = 1 and $TavernDayEventId <> '':
        TavernDayEventMacroRoll = RAND(1, 100)

        if $TavernDayEventId = 'rats' and TavernRepairOrdered = 0 and TavernDayEventMacroRoll <= 60:
            killvar 'TavernDayEventMacroRoll'
            gt 'TavernHallEventDayRatsIncident'
        elseif $TavernDayEventId = 'broken' and TavernRepairOrdered = 0 and TavernDayEventMacroRoll <= 60:
            killvar 'TavernDayEventMacroRoll'
            gt 'TavernHallEventDayBrokenBarrel'
        elseif $TavernDayEventId = 'caravan' and TavernDayEventMacroRoll <= 50:
            killvar 'TavernDayEventMacroRoll'
            gt 'TavernHallEventDayCaravan'
        elseif $TavernDayEventId = 'delicious_kitchen' and TavernDayEventMacroRoll <= 65:
            killvar 'TavernDayEventMacroRoll'
            gt 'TavernHallEventDayDeliciousKitchen'
        elseif $TavernDayEventId = 'tavern_praise' and TavernDayEventMacroRoll <= 65:
            killvar 'TavernDayEventMacroRoll'
            gt 'TavernHallEventDayTavernPraise'
        end

        killvar 'TavernDayEventMacroRoll'
    end

    ! Стандартный ролл бытовых событий зала
    TavernHallEventRoll = RAND(1, 100)

    if debug = 1:
        *pl '[DEBUG] TavernHallEventRoll = ' + STR(TavernHallEventRoll)
        *pl ' '
    end

    if TavernHallEventRoll <= 18:
        gt 'TavernHallEventTips'
    elseif TavernHallEventRoll <= 35:
        gt 'TavernHallEventSlowService'
    elseif TavernHallEventRoll <= 50:
        gt 'TavernHallEventDirtyTable'
    elseif TavernHallEventRoll <= 68:
        gt 'TavernHallEventQuarrel'
    elseif TavernHallEventRoll <= 80:
        gt 'TavernHallEventMinstrel'
    elseif TavernHallEventRoll <= 90:
        gt 'TavernHallEventDice'
    else:
        gt 'TavernHallEventCalm'
    end
---

#SaveLastHallEvent
    $LastHallEventType = LCASE($ARGS[0])
    $LastHallEventGirl = LCASE($ARGS[1])
    $LastHallEventText = $ARGS[2]
    $LastHallEventReaction = LCASE($ARGS[3])

    LastHallEventDay = day
    LastHallEventTime = time
    LastHallEventWeek = week

    if $LastHallEventGirl <> '':
        gs 'EnsureGirlData', $LastHallEventGirl
    end
---

#TavernHallEventPickWorker
    $TavernHallEventWorkerJob = LCASE($ARGS[0])
    $TavernHallEventWorker = ''
    TavernHallEventWorkerCount = 0

    if $TavernHallEventWorkerJob = 'cleaning':
        if jobcleaning['amanda'] = 1:
            TavernHallEventWorkerCount += 1
            $TavernHallEventWorkerCandidate[TavernHallEventWorkerCount] = 'amanda'
        end

        if jobcleaning['melissa'] = 1:
            TavernHallEventWorkerCount += 1
            $TavernHallEventWorkerCandidate[TavernHallEventWorkerCount] = 'melissa'
        end

        if jobcleaning['sandra'] = 1:
            TavernHallEventWorkerCount += 1
            $TavernHallEventWorkerCandidate[TavernHallEventWorkerCount] = 'sandra'
        end
    else:
        if jobwaitress['amanda'] = 1:
            TavernHallEventWorkerCount += 1
            $TavernHallEventWorkerCandidate[TavernHallEventWorkerCount] = 'amanda'
        end

        if jobwaitress['melissa'] = 1:
            TavernHallEventWorkerCount += 1
            $TavernHallEventWorkerCandidate[TavernHallEventWorkerCount] = 'melissa'
        end

        if jobwaitress['sandra'] = 1:
            TavernHallEventWorkerCount += 1
            $TavernHallEventWorkerCandidate[TavernHallEventWorkerCount] = 'sandra'
        end
    end

    if TavernHallEventWorkerCount > 0:
        TavernHallEventWorkerRoll = RAND(1, TavernHallEventWorkerCount)
        $TavernHallEventWorker = $TavernHallEventWorkerCandidate[TavernHallEventWorkerRoll]
    end

    killvar '$TavernHallEventWorkerJob'
    killvar 'TavernHallEventWorkerCount'
    killvar 'TavernHallEventWorkerRoll'
    killvar '$TavernHallEventWorkerCandidate'
---

#TavernHallEventDayRatsIncident
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: ПЕРЕПОЛОХ У КЛАДОВОЙ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'rats_incident', 'зал: следы крыс, суета у дверей кладовой'

    *pl 'В зале поднимается нервный шумок. Возле кухонной перегородки раздаётся приглушённый стук ухвата и сердитый голос Сандры — утренний набег хвостатых вредителей всё ещё даёт о себе знать.'
    *pl 'Одна особо наглая серая тварь умудряется шмыгнуть вдоль плинтуса прямо на глазах у степенных гостей. Пожилой купец с брезгливой гримасой поджимает ноги к перекладине скамьи, а соседи начинают недовольно переглядываться.'
    *pl ' '

    gs 'ActUiPrepare', 'Помочь заделать лаз', 'work'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'rats_incident', 'зал: Стефан заделывает лаз'
        *pl 'Стефан не тратит времени на пустые споры: пара крепких дубовых плашек, молоток из кладовой и несколько верных ударов намертво перекрывают ход наглому зверью.'
        *pl 'Гости с уважением следят за хозяйской хваткой — когда хозяин заведения не гнушается лично приложить руку к делу, доверие к трактиру только крепнет. Сандра из проёма кухни благодарно отирает лоб краешком фартука.'
        tavern_reputation += 1
        if tavern_reputation > 100: tavern_reputation = 100
        gs 'SaveLastHallEvent', 'rats_incident', 'sandra', 'Стефан лично заделал крысиный лаз на глазах у гостей.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Успокоить гостей шуткой', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'calm', 'зал: гости успокоились за кружкой эля'
        *pl 'Стефан громко и раскатисто усмехается, выходя на середину зала и упирая руки в бока:'
        *pl '— Спокойно, почтенные господа! Даже городские крысы нутром чуют, что в «Диком Жеребце» лучшее зерно во всём посаде! Налейте-ка за этот стол по доброй кружке эля за счёт заведения — запьём суету!'
        if beernum > 0: beernum -= 1
        *pl 'Пенное за чужой счёт творит чудеса: брезгливые мины тут же сменяются довольными ухмылками, и гости дружно поднимают кубки. Но про себя Стефан делает крепкую зарубку — столяру Драупниру нужно заплатить за ремонт без промедления.'
        gs 'SaveLastHallEvent', 'rats_incident', '', 'Стефан разрядил неловкость из-за крыс шуткой и кружкой эля.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end
---

#TavernHallEventDayBrokenBarrel
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: ТЕЧЬ В ПОДВАЛЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'broken_barrel', 'зал: влажный пол у стойки, запах разлитого пива'

    *pl 'Воздух в зале густеет от ядрёного хмельного духа и запаха сырого дуба.'
    *pl 'Утренняя беда с треснувшей клёпкой даёт о себе знать: из подпола тянет стылой сыростью, а доски возле стойки потемнели от просочившегося эля. Работницы спешно забрасывают потёки золотистыми опилками, скребя вениками по полу.'
    *pl ' '

    gs 'ActUiPrepare', 'Спуститься и спасти остатки', 'work'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'broken_barrel', 'зал: Стефан проверяет бочки в погребе'
        *pl 'Стефан спрыгивает по узким ступеням в полумрак погреба. При свете сальной свечи он на ощупь проверяет кованые обручи соседних бочек и ловко подбивает клин, направляя пенную струю в чистое корыто.'
        *pl 'Рукава промокли, пальцы пахнут горьковатым солодом, но добрую пару кувшинов отборного эля удаётся отстоять.'
        beernum += 2
        gs 'SaveLastHallEvent', 'broken_barrel', '', 'Стефан спустился в погреб и спас часть уцелевшего пива.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Приказать навести порядок', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'calm', 'зал: опилки на полу, порядок восстановлен'
        *pl '— Живее с опилками! — негромко, но властно распоряжается Стефан. — Да распахните верхние форточки, чтобы хмельной чад ушёл под крышу.'
        *pl 'Зал быстро проветривается, а посетители охотно списывают густой аромат на то, что хозяин только что распечатал свежую бочку отменного пойла. Однако Стефан отлично понимает: без визита к столяру Драупниру погреб долго не протянет.'
        gs 'SaveLastHallEvent', 'broken_barrel', '', 'Стефан оперативно навел порядок в зале после аварии с бочкой.', 'neutral'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end
---

#TavernHallEventDayCaravan
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: КУПЦЫ КАРАВАНА'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'caravan_hall', 'зал: заезжие купцы с тюками, наплыв заказов'

    *pl 'В зале яблоку негде упасть: караванщики в запылённых шерстяных кафтанах и заезжие приказчики плотно оккупировали дубовые столы.'
    *pl 'Звон серебра тонет в хриплом гуле торговых споров о тюках шерсти, соляных обозах и цене на заморское сукно. Люди эти сытые, при деньгах — и требуют к себе хозяйского уважения.'
    *pl ' '

    gs 'ActUiPrepare', 'Предложить дорогое вино', 'wine'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'tips', 'зал: купцы щедро платят за вино'
        if winenum >= 2:
            winenum -= 2
            money += 24
            *pl 'Стефан лично несёт на стол два пузатых кувшина лучшего выдержанного вина. Торговцы причмокивают языками, пробуя терпкий напиток, и благодушно рассыпают по столешнице полновесные серебряные спинтарии.'
            *pl 'В кассу трактира поступило 24 спинтарии — караванная торговля умеет быть щедрой!'
            gs 'SaveLastHallEvent', 'caravan', '', 'Стефан выгодно сбыл дорогое вино купцам каравана.', 'good'
        else:
            *pl 'Стефан подходит к купеческому столу, но погреб пуст — предложить купцам остаётся лишь кружки с местным янтарным элем. Торговцы нехотя отсчитывают монету, сетуя, что в таком славном трактире не нашлось кувшина доброй лозы.'
            money += 8
            *pl 'В кассу поступило 8 спинтарий.'
            gs 'SaveLastHallEvent', 'caravan', '', 'Купцы каравана выпили эля, но запасов вина не хватило.', 'neutral'
        end
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Присмотреть за порядком', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'calm', 'зал: купцы спокойно отдыхают'
        *pl 'Опершись локтями о полированную стойку, Стефан цепким взглядом ведёт весь зал. В набитом караванщиками трактире легко вспыхнуть потасовке из-за случайного толчка или упавшего кошелька, но холодный хозяйский надзор остужает горячие головы ещё до того, как руки потянутся к поясам.'
        tavern_reputation += 1
        if tavern_reputation > 100: tavern_reputation = 100
        gs 'SaveLastHallEvent', 'caravan', '', 'Стефан обеспечил образцовый порядок во время наплыва каравана.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end
---

#TavernHallEventDayDeliciousKitchen
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: ПРЯНЫЙ ПИР'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'feast', 'зал: гости смакуют пряные блюда за общими столами'

    *pl 'В зале стоит густой, упоительный аромат заморских трав, чеснока и жареного мяса. Разговоры за столами стихли — гости увлечённо орудуют деревянными ложками и ножами, макают ломти каравая в пряную подливу и вычищают миски до последней капли.'
    *pl 'На столах пенится добрый эль, то и дело слышатся сытые вздохи и одобрительные возгласы в адрес трактирной кухни.'
    *pl ' '

    gs 'ActUiPrepare', 'Пройти по столам и спросить о похлёбке', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'tips', 'зал: довольные гости хвалят стол'
        *pl 'Стефан неторопливо обходит дубовые столы, справляясь, довольны ли гости угощением.'
        *pl '— Клянусь Ильматером, Стефан, такой пряной баранины я даже в столичном трактире не пробовал! — зычно басит бородатый старшина плотницкой артели. — Передай поварихе наш низкий поклон!'
        *pl 'Довольные гости звонко ссыпают на край стола серебряные спинтарии на чай работницам. Трактир гудит от сытого благодушия.'
        money += 18
        tavern_reputation += 1
        if tavern_reputation > 100: tavern_reputation = 100
        if jobkitchen['sandra'] = 1:
            SandraTrust += 1
            SandraRespect += 1
        end
        gs 'SaveLastHallEvent', 'delicious_kitchen', '', 'Стефан выслушал восторженные отзывы гостей о пряных блюдах.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Поднять кувшин за кухню и угостить зал', 'wine'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'tips', 'зал: Стефан поднимает тост за кухню'
        if beernum >= 2:
            beernum -= 2
            *pl 'Стефан выходит на середину зала с двумя запотевшими кувшинами холодного эля и громко провозглашает тост за старания трактирных хозяек. Зал взрывается дружным гулом одобрения!'
            *pl 'Гости с восторгом подставляют кружки. Такое радушие хозяина запомнится надолго — слава о «Диком Жеребце» разлетится по всем лавкам и торговым рядам.'
            tavern_reputation += 2
            if tavern_reputation > 100: tavern_reputation = 100
            tavernvisitors += RAND(4, 8)
            if jobkitchen['sandra'] = 1:
                SandraTrust += 2
            end
            gs 'SaveLastHallEvent', 'delicious_kitchen', '', 'Стефан устроил угощение в зале в честь удачного блюда.', 'good'
        else:
            *pl 'Стефан приветствует гостей добрым словом и шуткой, обещая, что на кухне и впредь не пожалеют специй для добрых людей. Зал встречает слова хозяина весёлым стуком кружек о дубовые столешницы.'
            tavern_reputation += 1
            if tavern_reputation > 100: tavern_reputation = 100
            gs 'SaveLastHallEvent', 'delicious_kitchen', '', 'Стефан поддержал праздничное настроение сытых гостей.', 'good'
        end
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Присматривать за стойкой и радоваться выручке', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'calm', 'зал: Стефан наблюдает за сытым залом'
        *pl 'Стефан скрещивает руки на груди, опершись о край стойки, и с тихой хозяйской гордостью наблюдает за набитым до отказа залом. Тарелки пустеют мгновенно, кружки наполняются снова и снова, а тяжёлый трактирный кошель заметно толстеет.'
        *pl 'Порядок безупречен, а сытый гость — самый щедрый и спокойный гость.'
        money += 12
        gs 'SaveLastHallEvent', 'delicious_kitchen', '', 'Стефан спокойно руководил залом во время сытного обеда.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end
---

#TavernHallEventDayTavernPraise
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: ДОБРАЯ СЛАВА'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'tips', 'зал: степенные горожане нахваливают трактир'

    *pl 'В зале царит благодушная, уважительная атмосфера. За центральным столом у камина расположились почтенные городские ремесленники и заезжие торговцы. Они степенно потягивают солод, обсуждая городские вести без обычной трактирной ругани и пьяных криков.'
    *pl 'Чисто выскобленные полы, свежий хмель в кувшинах и приветливые работницы явно расположили гостей к долгой и щедрой беседе.'
    *pl ' '

    gs 'ActUiPrepare', 'Поговорить со старейшинами гостей', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'tips', 'зал: беседа с почтенными горожанами'
        *pl 'Стефан подходит к почтенным мастерам. Пожилой ткач одобрительно кивает молодому хозяину:'
        *pl '— Вот это я понимаю — порядок, Стефан! Ни пьяного отребья под ногами, ни кислого пива. В таком трактире и сделку обмыть не грех, и вечер провести приятно. Будем к тебе почаще захаживать.'
        *pl 'Мастера оставляют щедрую оплату за стол и дружески жмут руку Стефану.'
        money += 20
        tavern_reputation += 2
        if tavern_reputation > 100: tavern_reputation = 100
        gs 'SaveLastHallEvent', 'tavern_praise', '', 'Почтенные мастера похвалили порядок и чистоту в трактире.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Похвалить работниц в зале', 'waitress'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'calm', 'зал: Стефан одобряет работу девушек'
        *pl 'Стефан не упускает случая открыто подбодрить девушек, разносящих заказы. Похвала хозяина на глазах у всего зала окрыляет работниц — они двигаются ещё проворнее, улыбаются гостям искренне и приветливо.'
        *pl 'Гости, видя столь слаженную работу, охотно опускают медные и серебряные монеты в карманы девичьих фартуков.'
        if jobwaitress['amanda'] = 1:
            AmandaTrustStefan += 1
            gs 'AwardGirlTipsFromBase', 'amanda', 6
        end
        if jobwaitress['melissa'] = 1:
            MelissaRespectStefan += 1
            gs 'AwardGirlTipsFromBase', 'melissa', 6
        end
        if jobwaitress['sandra'] = 1:
            SandraRespect += 1
            gs 'AwardGirlTipsFromBase', 'sandra', 6
        end
        tavern_reputation += 1
        if tavern_reputation > 100: tavern_reputation = 100
        gs 'SaveLastHallEvent', 'tavern_praise', '', 'Стефан отметил безупречную работу девушек в зале.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end
---

#TavernHallEventTips
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: ЩЕДРЫЕ ЧАЕВЫЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'tips', 'зал: щедрые чаевые у стойки или стола'

    if tavern_waitress_power >= 30:
        gs 'PickFamilyWaitressForTips'

        if $FamilyTipsGirl = '':
            gs 'TavernHallEventPickWorker', 'waitress'
            $FamilyTipsGirl = $TavernHallEventWorker
        end

        if $FamilyTipsGirl <> '':
            TavernHallTipsBase = 10 + RAND(5, 25)
            gs 'AwardGirlTipsFromBase', $FamilyTipsGirl, TavernHallTipsBase

            *pl 'За одним из сытных столов компания довольных гостей со звоном оставляет пригоршню монет поверх счёта.'
            *pl 'Им явно пришлась по вкусу расторопность и ладная улыбка ' + $RealName[$FamilyTipsGirl] + ' — серебро и медь с тихим звоном перекочёвывают прямо в потайной кармашек её передника.'

            *pl ' '
            *pl $GirlTipsAwardLine

            if tavern_reputation < 100:
                tavern_reputation += 1
            end

            gs 'SaveLastHallEvent', 'tips', $FamilyTipsGirl, 'Гости оставили щедрые чаевые за хорошее обслуживание.', 'good'
        else:
            *pl 'Гости со звоном выкладывают на край стойки несколько блестящих монет, оценив добрый порядок в заведении.'
            TavernHallTipsBase = 10 + RAND(5, 25)
            money += TavernHallTipsBase
            gs 'FormatSpintry', TavernHallTipsBase
            $FormatSpintry_TavernHallTipsBase = $FormatSpintry
            killvar '$FormatSpintry'
            *pl ' '
            *pl 'В кассу трактира поступило: ' + $FormatSpintry_TavernHallTipsBase + '.'
            gs 'SaveLastHallEvent', 'tips', '', 'Гости оставили чаевые за стойкой.', 'good'
        end
    else:
        *pl 'Один из гостей уже достал было кошель, намереваясь отблагодарить за расторопность, но кружка неслась к столу слишком долго.'
        *pl 'В итоге мужчина лишь с досадой сплюнул сквозь зубы и спрятал монеты обратно за пазуху.'

        gs 'SaveLastHallEvent', 'tips_failed', '', 'Гость хотел оставить чаевые, но обслуживание было слишком медленным.', 'bad'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end

    killvar 'TavernHallTipsBase'
    killvar '$FamilyTipsGirl'
---

#TavernHallEventDirtyTable
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: ПРОВЕРКА ЧИСТОТЫ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'dirty_table', 'зал: проверка чистоты столов'

    if tavern_cleaning_power < 35:
        *pl 'Один из солидных горожан брезгливо кривит губы и демонстративно отставляет кружку на самый краешек стола.'
        *pl 'Дубовая доска липнет от засохших капель вчерашнего эля, а в пазах застряли хлебные крошки, которые уборщицы не успели смахнуть тряпкой. Мужчина недовольно ворчит на весь угол, портя заведению доброе имя.'

        tavern_reputation -= 1

        if tavern_reputation < 0:
            tavern_reputation = 0
        end

        *pl ' '
        *pl 'Репутация таверны снизилась на 1.'

        gs 'SaveLastHallEvent', 'dirty_table', '', 'Посетитель пожаловался на липкий стол и недосмотр уборки.', 'bad'
    else:
        *pl 'Один из въедливых гостей придирчиво ведёт сухим пальцем по столешнице, надеясь найти повод для брюзжания.'
        *pl 'Однако придраться не к чему: дубовые доски чисто выскоблены, пахнут сухими травами и лоснятся от чистоты. Гость уважительно хмыкает в усы и заказывает щедрый обед.'

        gs 'SaveLastHallEvent', 'dirty_table', '', 'Посетитель пытался придраться к чистоте, но столы были убраны на совесть.', 'neutral'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#TavernHallEventSlowService
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: НАПЛЫВ ЗАКАЗОВ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'slow_service', 'зал: наплыв гостей / раздача заказов'

    if tavern_waitress_power < 35:
        *pl 'В зале поднимается недовольный гул: сразу три шумных стола враз требуют новой выпивки и горячего жаркого.'
        *pl 'Заказы запаздывают, пустые кружки с глухим стуком бьют о столешницы, а захмелевшие гости начинают нервно свистеть и окликать работниц.'

        tavern_reputation -= 1

        if tavern_reputation < 0:
            tavern_reputation = 0
        end

        *pl ' '
        *pl 'Репутация таверны снизилась на 1.'

        gs 'SaveLastHallEvent', 'slow_service', '', 'Посетители ворчали из-за задержки заказов.', 'bad'
    else:
        *pl 'Несмотря на густой наплыв народа, в зале всё идёт как по маслу.'
        *pl 'Работницы порхают между рядами скамей с удивительной ловкостью: пенные кружки и дымящиеся миски с похлёбкой вырастают перед гостями в тот самый миг, когда те только успевают подумать о заказе.'

        if tavern_reputation < 100:
            tavern_reputation += 1
        end

        gs 'SaveLastHallEvent', 'slow_service', '', 'Зал был полон, но обслуживание отлично справилось с наплывом.', 'good'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#TavernHallEventQuarrel
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: ССОРА ГОСТЕЙ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'quarrel', 'зал: ссора у дальнего стола, гости оборачиваются'

    *pl 'У дальнего стола двое захмелевших завсегдатаев сцепились языками, повышая голос до хрипоты.'
    *pl 'Один резко вскакивает на ноги, тяжёлая дубовая скамья с визгом едет по доскам пола, а сидевшие рядом гости спешно отодвигают кружки и вжимают головы в плечи в ожидании кулачного боя.'
    *pl ' '

    gs 'ActUiPrepare', 'Вмешаться спокойно', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernHallEventQuarrelCalm'
    end

    gs 'ActUiPrepare', 'Прикрикнуть и осадить', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernHallEventQuarrelHard'
    end

    gs 'ActUiPrepare', 'Не вмешиваться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernHallEventQuarrelIgnore'
    end
---

#TavernHallEventQuarrelCalm
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: ССОРА'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'quarrel_calm', 'зал: ссора — Стефан вмешивается спокойно'

    TavernQuarrelChance = 45 + charisma + management_skill

    if TavernQuarrelChance > 90:
        TavernQuarrelChance = 90
    end

    TavernQuarrelRoll = RAND(1, 100)

    if TavernQuarrelRoll <= TavernQuarrelChance:
        *pl 'Стефан неторопливо шагает к спорщикам, не повышая голоса, но вкладывая в каждое слово холодную хозяйскую весомость.'
        *pl 'Пара коротких, точных фраз о том, кому принадлежит эта крыша и сколько стоит выбитый зуб, действуют безотказно. Забияки ещё секунду зло сопят, но под ровным взглядом хозяина сдуваются, как проколотые бурдюки, и неловко опускаются обратно на лавку.'

        tavern_reputation += 1

        if tavern_reputation > 100:
            tavern_reputation = 100
        end

        *pl ' '
        *pl 'Зал облегчённо выдыхает — в «Диком Жеребце» порядок блюдут крепко.'

        gs 'SaveLastHallEvent', 'quarrel', '', 'Стефан спокойно погасил ссору между посетителями.', 'good'
    else:
        *pl 'Стефан пытается урезонить крикунов миром, но хмель уже намертво ударил спорщикам в головы — увещевания тонут в пьяной брани.'
        *pl 'Один из забияк с грохотом впечатывает оловянную кружку в стол, плюёт на пол и убирается восвояси, оставив за собой дурной осадок и шлейф отборных ругательств.'

        tavern_reputation -= 1

        if tavern_reputation < 0:
            tavern_reputation = 0
        end

        *pl ' '
        *pl 'Репутация таверны снизилась на 1.'

        gs 'SaveLastHallEvent', 'quarrel', '', 'Стефан попытался успокоить спорщиков, но один из гостей ушел недовольным.', 'bad'
    end

    if debug = 1:
        *pl ' '
        *pl '[DEBUG] Шанс успокоить: ' + STR(TavernQuarrelChance)
        *pl '[DEBUG] Бросок: ' + STR(TavernQuarrelRoll)
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end

    killvar 'TavernQuarrelChance'
    killvar 'TavernQuarrelRoll'
---

#TavernHallEventQuarrelHard
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: ССОРА'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'quarrel_hard', 'зал: ссора — жёсткий разгон / сила'

    TavernQuarrelChance = 35 + strength + management_skill

    if TavernQuarrelChance > 90:
        TavernQuarrelChance = 90
    end

    TavernQuarrelRoll = RAND(1, 100)

    if TavernQuarrelRoll <= TavernQuarrelChance:
        *pl 'Тяжёлый хозяйский кулак со звоном обрушивается на дубовую стойку, а рявкнувший голос Стефана звенит подобно набату.'
        *pl 'Крикуны испуганно вздрагивают и приседают на лавках, моментально протрезвев. В повисшей тишине становится ясно каждому: испытывать терпение молодого Лонгкока сегодня себе дороже.'

        *pl ' '
        *pl 'Ссора пресечена в зародыше.'

        gs 'SaveLastHallEvent', 'quarrel', '', 'Стефан жёстко пресёк ссору в главном зале.', 'hard_success'
    else:
        *pl 'Громогласный окрик Стефана вместо порядка лишь подливает масла в огонь пьяной гордыни.'
        *pl 'Один из гостей в бешенстве смахивает глиняный кувшин на пол, черепки со звоном разлетаются во все стороны, а сам буян торопливо вываливается за порог, так и не расплатившись за выпивку.'

        money -= 10
        tavern_reputation -= 1

        if money < 0:
            money = 0
        end

        if tavern_reputation < 0:
            tavern_reputation = 0
        end

        *pl ' '
        *pl 'Потери: 10 спинтарий за битую посуду.'
        *pl 'Репутация таверны снизилась на 1.'

        gs 'SaveLastHallEvent', 'quarrel', '', 'Жёсткое вмешательство в ссору привело к шуму и потерям.', 'hard_fail'
    end

    if debug = 1:
        *pl ' '
        *pl '[DEBUG] Шанс жёстко погасить: ' + STR(TavernQuarrelChance)
        *pl '[DEBUG] Бросок: ' + STR(TavernQuarrelRoll)
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end

    killvar 'TavernQuarrelChance'
    killvar 'TavernQuarrelRoll'
---

#TavernHallEventQuarrelIgnore
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: ССОРА'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'quarrel_ignore', 'зал: ссора — Стефан не вмешивается, сомнение гостей'

    *pl 'Стефан решает не вмешиваться, предоставив пьяным крикунам самим охрипнуть от взаимных упрёков.'
    *pl 'Спор постепенно выдыхается сам по себе, но сидящие по соседству степенные горожане с явным неодобрением поглядывают в сторону стойки: оставлять буянов без хозяйского окрика в приличном доме не пристало.'

    tavern_reputation -= 1

    if tavern_reputation < 0:
        tavern_reputation = 0
    end

    *pl ' '
    *pl 'Репутация таверны снизилась на 1.'

    gs 'SaveLastHallEvent', 'quarrel', '', 'Стефан не вмешался в ссору посетителей, и часть гостей осталась недовольна.', 'ignore'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#TavernHallEventMinstrel
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: БРОДЯЧИЙ МЕНЕСТРЕЛЬ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'minstrel', 'зал: бродячий музыкант с лютней просит кружку эля'

    *pl 'Дверь скрипит, и на пороге вырастает бродячий менестрель в выцветшем от дождей дорожном плаще. За его плечом на потертом ремне покачивается ладная пузатая лютня.'
    *pl 'Музыкант вежливо снимает шляпу с пером и с легким поклоном обращается к Стефану:'
    *pl '— Мир и достаток твоему очагу, почтенный хозяин! Дозволь потешить добрый люд песнями? Гостям будет отрада, стойке — звонкая прибыль, а мне многого не надо: кружка хмельного эля с дороги да тепло очага.'
    *pl ' '

    gs 'ActUiPrepare', 'Угостить элем и пустить петь', 'beer'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'calm', 'зал: музыкант играет на лютне, гости подпевают'
        if beernum > 0: beernum -= 1
        MinstrelIncome = RAND(6, 15)
        money += MinstrelIncome
        tavern_reputation += 1
        if tavern_reputation > 100: tavern_reputation = 100
        *pl 'Стефан щедрой рукой наливает парню высокую кружку пенного эля и кивает на лавку возле очага.'
        *pl 'Звонкие струны лютни и озорные дорожные куплеты мгновенно растапливают хмурое молчание зала: гости дружно подпевают, стучат кубками по доскам в такт припеву и всё чаще требуют повторить выпивку.'
        *pl 'Всеобщее веселье пошло на пользу торговле — в кассу трактира капнуло лишних ' + STR(MinstrelIncome) + ' спинтарий!'
        killvar 'MinstrelIncome'
        gs 'SaveLastHallEvent', 'minstrel', '', 'Бродячий менестрель развеселил гостей в зале.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Попросить песню об Ильматере', 'church'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'calm', 'зал: благочестивая баллада об Ильматере'
        *pl 'Стефан просит менестреля отложить ярмарочные шутовские куплеты и спеть строгую балладу о святом Круге и трудах во славу Ильматера всеблагого.'
        *pl 'Чистый, возвышенный напев разливается под дубовыми балками, заставляя смолкнуть даже самых шумных выпивох. Гости с благоговением слушают песнь, а заглянувший прихожанин с одобрительной улыбкой осеняет себя священным кругом, кивая молодому хозяину.'
        if TavernScandal > 0: TavernScandal -= 1
        tavern_reputation += 1
        if tavern_reputation > 100: tavern_reputation = 100
        gs 'SaveLastHallEvent', 'minstrel', '', 'Менестрель спел благочестивую балладу, укрепив доброе имя трактира.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Отказать музыканту', 'return'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'calm', 'зал: музыкант уходит'
        *pl '— Не сегодня, лютнист, — качает головой Стефан. — Мои гости пришли сюда выпить и поговорить в тишине, а не слушать ярмарочные трели.'
        *pl 'Музыкант со сдержанным вздохом прижимает шляпу к груди, отвешивает поклон и тихо растворяется за дверью. В зале остаётся привычный, неспешный гул.'
        gs 'SaveLastHallEvent', 'minstrel', '', 'Стефан отказал бродячему музыканту, сохранив тишину.', 'neutral'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end
---

#TavernHallEventDice
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: КОСТИ ЗА УГЛОВЫМ СТОЛОМ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'dice', 'зал: наемники и завсегдатаи шумно режутся в кости'

    *pl 'За угловым столом трое подвыпивших мужиков азартно грохочут костяными кубиками в глиняном стаканчике.'
    *pl 'Медные и серебряные монеты со звоном перелетают из руки в руку, глаза игроков блестят лихорадочным блеском, а споры о выпавших точках звучат всё громче, отвлекая остальных посетителей.'
    *pl ' '

    gs 'ActUiPrepare', 'Потребовать трактирный сбор', 'money'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'tips', 'зал: игроки делятся монетой с хозяином'
        if charisma >= 35 or management_skill >= 20:
            money += 6
            *pl 'Стефан подходит к азартной компании и со спокойной усмешкой постукивает костяшками пальцев по краю стола:'
            *pl '— Кидать кости под крышей «Дикого Жеребца» дозволено лишь до тех пор, пока стол исправно помнит про долю заведения.'
            *pl 'Игроки переглядываются, понимающе хмыкают и без лишних пререканий отсыпают в хозяйскую ладонь 6 серебряных спинтарий с общего кона.'
            gs 'SaveLastHallEvent', 'dice', '', 'Стефан взял положенный сбор с азартных игроков.', 'good'
        else:
            *pl 'Стефан заявляет о трактирной доле, но игроки хмурятся, быстро сгребая монеты со скатерти по глубоким карманам:'
            *pl '— Да ладно тебе, хозяин! Видишь же — просто забавы ради сидим, копейки считаем. Больно ты скор на поборы!'
            *pl 'Серебра они не дали, но от греха подальше кубики спрятали.'
            gs 'SaveLastHallEvent', 'dice', '', 'Игроки свернули кости после замечания Стефана.', 'neutral'
        end
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Запретить игру ради порядка', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'calm', 'зал: спокойный порядок без азартных игр'
        *pl 'Стефан решительно шагает к столу и широкой ладонью накрывает костяные кубики прямо посреди броска:'
        *pl '— Прячьте кости, господа. Слуги Ильматера и городская стража на азартные игры смотрят косо, а мне лишние досмотры под этой крышей ни к чему.'
        *pl 'Игроки обиженно бурчат себе под нос, но кубики убирают. Зато сидевшие неподалёку почтенные купцы с явным одобрением кивают строгому хозяину.'
        tavern_reputation += 1
        if tavern_reputation > 100: tavern_reputation = 100
        gs 'SaveLastHallEvent', 'dice', '', 'Стефан пресек азартную игру, поддержав порядок.', 'good'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Не вмешиваться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        *clr
        cla
        gs 'TavernHallEventShowVisual', 'calm', 'зал: игра продолжается'
        *pl 'Стефан решает не портить гостям азартную забаву. Пока игра идёт мирно и руки не тянутся к ножнам, пусть мужики развлекаются — чем азартнее партия, тем быстрее пустеют кувшины с элем.'
        gs 'SaveLastHallEvent', 'dice', '', 'Стефан позволил гостям спокойно доиграть партию.', 'neutral'
        *pl ' '
        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end
---

#TavernHallEventCalm
    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' ГЛАВНЫЙ ЗАЛ: СПОКОЙНЫЙ ЧАС'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    gs 'TavernHallEventShowVisual', 'calm', 'зал: спокойные посетители, без скандала'

    *pl 'Стефан некоторое время неторопливо наблюдает за залом из-за стойки.'
    *pl 'Посетители мирно хлебают горячую похлёбку, смакуют пенный эль и ведут неспешные беседы о городских новостях. Ни криков, ни битой посуды — всё работает ладно и спокойно.'
    *pl 'Такой размеренный час вряд ли войдёт в городские байки, но именно из подобных мирных часов и куётся добрая слава надёжного трактира.'

    gs 'SaveLastHallEvent', 'calm', '', 'День в главном зале прошёл спокойно, без происшествий.', 'none'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#TavernHallEventWaitressAttention
    gt 'TavernHallEventTips'
---

#TavernHallEventCleaningAttention
    gt 'TavernHallEventDirtyTable'
---
