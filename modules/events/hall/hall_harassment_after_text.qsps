! ================================================
! FILE: modules/events/hall/hall_harassment_after_text.qsps
! MODULE: events/hall
! Экран 2 harass: реакция ДЕВУШКИ + КЛИЕНТА на выбор Стефана
! (не «зал осудил хозяина», не «клиент смеётся что хозяин не против»)
!
! Канон (владелец 2026-08):
! - Экран 1 = схватили/щупают → выбор
! - Экран 2 = она + он (к ней); зал смотрит на ИНЦИДЕНТ (свист, подглядывание), не на ГГ
! - Клиент почти не «читает» Стефана; при protect просто уходит
! - Меньше осуждения игрока; злость на ГГ — по FamilyCorruptionStage (band)
! - ignore: visual стойка (HallHarassmentShowImage); текст = звуки инцидента за спиной
!
! band (HallHarassAfterBand):
!   0 stage≤1 — злость / страх, «ты просто смотрел»
!   1 stage=2 — «смотрели, чтобы не обидели»
!   2 stage=3 — «я сама бы справилась»
!   3 stage≥4 — «такой хороший… деньги, а ты лезешь / вмешиваешься»
!
! Intro приставания — hall_harassment_intro_text.qsps (отдельно)
! ================================================

#HallHarassAfterBandCalc
    HallHarassAfterBand = 0
    if FamilyCorruptionStage >= 4:
        HallHarassAfterBand = 3
    elseif FamilyCorruptionStage >= 3:
        HallHarassAfterBand = 2
    elseif FamilyCorruptionStage >= 2:
        HallHarassAfterBand = 1
    else
        HallHarassAfterBand = 0
    end
    ! play / high slut чуть сдвигает к «позже»
    if ($HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke') and HallHarassAfterBand < 3:
        HallHarassAfterBand += 1
    elseif sluttiness[$HallHarassGirl] >= 45 and HallHarassAfterBand < 2:
        HallHarassAfterBand += 1
    end
    if HallHarassAfterBand > 3:
        HallHarassAfterBand = 3
    end
---

! Один roll сцены на инцидент: watch = видно, ignore = звуки/возгласы ИЗ ТОЙ ЖЕ сцены
! → $HallHarassSceneBeat, HallHarassSceneSlap (0/1 — пощёчина в исходе)
#HallHarassAfterScenePick
    if $HallHarassSceneBeat <> '' and HallHarassScenePicked = 1:
        exit
    end

    $HallHarassSceneBeat = 'grab_generic'
    HallHarassSceneSlap = 0

    ! play
    if $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
        $HallHarassSceneBeat = 'play_tip'
    elseif GirlNoPantiesWork[$HallHarassGirl] = 1 and (HallHarassType >= 3 or HarassTier >= 2 or $HallHarassSubScene = 'drop_coin' or $HallHarassSubScene = 'drop_cutlery'):
        $HallHarassSceneBeat = 'hand_bare'
    elseif HarassTier >= 3 and HallHarassType = 4:
        $HallHarassSceneBeat = 'wall'
    elseif HarassTier >= 3 and (HallHarassType = 5 or $HallHarassSubScene = 'drop_coin' or $HallHarassSubScene = 'drop_cutlery'):
        $HallHarassSceneBeat = 'drop_bend'
    elseif HallHarassType = 2 or (HarassTier >= 2 and HallHarassType >= 2):
        $HallHarassSceneBeat = 'grab_ass'
    elseif HallHarassType = 1:
        $HallHarassSceneBeat = 'grab_tits'
    else
        HallHarassSceneRoll = RAND(1, 100)
        if HallHarassSceneRoll <= 40:
            $HallHarassSceneBeat = 'grab_tits'
        elseif HallHarassSceneRoll <= 75:
            $HallHarassSceneBeat = 'grab_ass'
        else
            $HallHarassSceneBeat = 'hand_skirt'
        end
        killvar 'HallHarassSceneRoll'
    end

    ! пощёчина в исходе (чаще early/resist)
    HallHarassSlapChance = 35
    if $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
        HallHarassSlapChance = 10
    elseif $HarassGirlStance = 'resist' or FamilyCorruptionStage <= 1:
        HallHarassSlapChance = 55
    elseif FamilyCorruptionStage >= 4:
        HallHarassSlapChance = 20
    end
    if $HallHarassSceneBeat = 'play_tip':
        HallHarassSlapChance = 8
    end
    if RAND(1, 100) <= HallHarassSlapChance:
        HallHarassSceneSlap = 1
    end
    killvar 'HallHarassSlapChance'
    HallHarassScenePicked = 1
---

! Печать beat «она + клиент» (+ короткий фон зала на инцидент)
#HallHarassmentPrintAfterBeat
    gs 'HallHarassAfterBandCalc'
    gs 'HallHarassAfterScenePick'

    $HallHarassAfterId = ''
    if $HallHarassReaction = 'protect_hard':
        $HallHarassAfterId = 'after_protect'
    elseif $HallHarassReaction = 'ignore':
        $HallHarassAfterId = 'after_ignore'
    elseif $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
        $HallHarassAfterId = 'after_watch_play'
    else
        $HallHarassAfterId = 'after_watch'
    end

    gs 'HallHarassmentAfterText', $HallHarassAfterId
    if $HallHarassmentAfterText <> '':
        *pl $HallHarassmentAfterText
    end
    killvar '$HallHarassAfterId'
    killvar '$HallHarassmentAfterText'
---

! Реплика к Стефану (policy-склейка) — band для watch/ignore; protect — thanks/annoyed
#HallHarassmentPrintAfterTalkLine
    gs 'HallHarassAfterBandCalc'
    $HallHarassAfterId = ''

    if $HallHarassReaction = 'protect_hard':
        if $HallHarassTalkReaction = 'protect_dislike':
            $HallHarassAfterId = 'talk_protect_annoyed'
        elseif $HallHarassTalkReaction = 'protect_fail':
            $HallHarassAfterId = 'talk_protect_fail'
        else
            $HallHarassAfterId = 'talk_protect_thanks'
        end
    elseif $HallHarassReaction = 'watch':
        if HallHarassAfterBand = 0:
            $HallHarassAfterId = 'talk_watch_band0'
        elseif HallHarassAfterBand = 1:
            $HallHarassAfterId = 'talk_watch_band1'
        elseif HallHarassAfterBand = 2:
            $HallHarassAfterId = 'talk_watch_band2'
        else
            $HallHarassAfterId = 'talk_watch_band3'
        end
    else
        if HallHarassAfterBand = 0:
            $HallHarassAfterId = 'talk_ignore_band0'
        elseif HallHarassAfterBand = 1:
            $HallHarassAfterId = 'talk_ignore_band1'
        elseif HallHarassAfterBand = 2:
            $HallHarassAfterId = 'talk_ignore_band2'
        else
            $HallHarassAfterId = 'talk_ignore_band3'
        end
    end

    gs 'HallHarassmentAfterText', $HallHarassAfterId
    if $HallHarassmentAfterText <> '':
        *pl $RealName[$HallHarassGirl] + ' ' + $HallHarassmentAfterText
    end
    killvar '$HallHarassAfterId'
    killvar '$HallHarassmentAfterText'
---

#HallHarassmentAfterText
    $id = LCASE($ARGS[0])
    $HallHarassmentAfterText = ''
    $g = $HallHarassGirl
    if $g = '':
        $g = 'amanda'
    end
    if $RealName[$g] = '':
        if LOC('HallMissingGirlEnsureName') = 1:
            gs 'HallMissingGirlEnsureName', $g
        end
    end

    ! ========== BEAT: protect — клиент УХОДИТ, без «залу ясно кто хозяин» ==========
    if $id = 'after_protect':
        gs 'HallHarassAfterProtectFromClient'
        if $HallHarassmentAfterText = '':
            if $g = 'melissa':
                $HallHarassmentAfterText = 'Вы делаете решительный шаг вперёд, одним уверенным движением вставая между гостем и девушкой. Мужчина недовольно цыкает зубом, нехотя разжимает пальцы и делает вид, будто просто решил поправить ремень, после чего медленно пятится обратно к своей кружке. Мелисса неторопливо и подчеркнуто плавно оглаживает ткань корсажа на груди, смерив спину уходящего насмешливым, острым взглядом книжной зазнайки: на её щеках играет легкий румянец, но на губах уже цветет снисходительная улыбка.'
                $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>За дальними столами кто-то разочарованно присвистывает, провожая глазами стройный девичий стан, но перечить хозяину никто не спешит: интерес зала был прикован к спектаклю, а не к разборкам.'
            elseif $g = 'sandra':
                $HallHarassmentAfterText = 'Вы перешагиваете порог кухни и властно обрываете наглеца прямо у пышущей жаром плиты. Гость осекается, мгновенно убирая руки от хозяйки, и торопливо проскальзывает мимо вас в полумрак зала, стараясь не встречаться взглядом. Сандра шумно переводит дух, вытирая о холщовый передник раскрасневшиеся от жара ладони, и строгим кивком указывает на дубовую дверь. Створка захлопывается — кухня вновь надежно укрыта от любопытных взоров.'
            else
                $HallHarassmentAfterText = 'Вы решительно вмешиваетесь, перехватывая запястье наглеца и оттесняя его от девушки. Мужик сконфуженно бормочет невнятные извинения, не решаясь идти наперекор трактирщику, и спешно ретируется к своей лавке. Аманда судорожно прижимает круглый поднос к груди, как спасительный щит, заливаясь густым девичьим румянцем до самых кончиков ушей. Её аккуратная грудка взволнованно ходит ходуном под холщовым корсажем, пока она дрожащими пальчиками торопливо одёргивает сбившийся вырез платья.'
                $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>За соседними лавками одобрительно переглядываются и звенят кубками — взгляды гостей прикованы к грациозным движениям смущённой подавальщицы.'
            end
        end

    ! ========== BEAT: watch / ignore — см. FromBeat (тот же $HallHarassSceneBeat) ==========
    elseif $id = 'after_watch' or $id = 'after_watch_play':
        gs 'HallHarassAfterWatchFromBeat'
    elseif $id = 'after_ignore':
        gs 'HallHarassAfterIgnoreFromBeat'

    ! ========== TALK lines (к Стефану) — band ==========
    ! protect — Аманда: смущение/неловкость, не «страх»; Сандра: как к сыну
    elseif $id = 'talk_protect_thanks':
        if HallHarassAfterBand >= 2:
            if $g = 'melissa':
                $HallHarassmentAfterText = 'с легкой иронией приподнимает бровь, неторопливо оправляя воротничок: «Признательна за участие, Стефан... хотя я и сама держала его на коротком поводке. Впредь будь чуточку мягче: состоятельные господа пугливы, а их звонкое серебро трактиру лишним не будет».'
            elseif $g = 'sandra':
                $HallHarassmentAfterText = 'смахивает со лба влажную прядь и тепло улыбается, словно непутевому, но заботливому сыну: «Спасибо, Стефан. Только не кидайся грудью на каждого выпивоху — я на этой кухне всю жизнь хозяйничаю и спуску мужланам никогда не давала».'
            else
                $HallHarassmentAfterText = 'закусывает губку и смущенно шепчет, опуская сияющие девичьи глаза: «Спасибо тебе, Стефан... Я правда совсем растерялась и не знала, как отшутиться от его наглых лап».'
            end
        else
            if $g = 'melissa':
                $HallHarassmentAfterText = 'сдержанно кивает, пряча вспыхнувший румянец за маской книжной невозмутимости: «Спасибо, Стефан. Вовремя подоспел — его манеры решительно выходили за рамки элементарных приличий».'
            elseif $g = 'sandra':
                $HallHarassmentAfterText = 'качает головой, оправляя широкий передник на бедрах: «Спасибо, сынок. Наглецам у котлов не место — ты всё сделал по-хозяйски правильно».'
            else
                $HallHarassmentAfterText = 'густо краснеет, пряча пылающее личико за подносом: «Спасибо, Стефан... Он так внезапно схватил меня, что у меня аж дыхание перехватило... Хорошо, что ты подошёл».'
            end
        end

    elseif $id = 'talk_protect_annoyed':
        if HallHarassAfterBand >= 3:
            if $g = 'sandra':
                $HallHarassmentAfterText = 'с мягкой укоризной качает головой, глядя на вас как на горячего юнца: «Он уже за кошелем полез, Стефан... а ты налетел как буря. Не распугивай тех, кто щедро платит за сытный обед, сынок».'
            elseif $g = 'melissa':
                $HallHarassmentAfterText = 'язвительно хмыкает, скрещивая руки на груди: «Какая трогательная доблесть, сударь... Он уже почти выложил серебро на стол, а ты ворвался и всё испортил. Трактиру нужны доходы, а не рыцарские турниры».'
            else
                $HallHarassmentAfterText = 'надувает пухлые губки с легкой досадой: «Стефан, ну зачем же так... Он уже серебро доставал, я бы всё тихо уладила. Не спугивай гостей, они ведь просто шутят».'
            end
        elseif HallHarassAfterBand >= 2:
            if $g = 'sandra':
                $HallHarassmentAfterText = 'тяжело вздыхает, возвращаясь к чану: «Я бы и сама с ним сладила, сынок. Не стоило поднимать шум из-за пьяных шуток».'
            elseif $g = 'amanda':
                $HallHarassmentAfterText = 'с досадой одёргивает передник, пряча смущение: «Я уже почти перевела всё в шутку... Не обязательно было так резко бросаться на него».'
            else
                $HallHarassmentAfterText = 'с прохладной усмешкой пожимает плечами: «Право слово, Стефан, я способна парировать выпады подвыпивших невежд без посторонней опеки».'
            end
        else
            if $g = 'sandra':
                $HallHarassmentAfterText = 'мягко, но веско кладёт ладонь вам на плечо: «Спасибо за защиту, Стефан. Только не выставляй меня беспомощной при всем честном народе — я хозяйка, а не пугливая девчонка».'
            elseif $g = 'amanda':
                $HallHarassmentAfterText = 'поджимает губки и отводит взгляд: «Я могла и сама отшутиться... Теперь завсегдатаи решат, будто я без твоей спины и шагу ступить не смею».'
            else
                $HallHarassmentAfterText = 'поджимает губы, бросая колкий взгляд: «Могла разобраться сама. Теперь весь зал шепчется, будто подавальщицы здесь не в силах постоять за себя».'
            end
        end

    elseif $id = 'talk_protect_fail':
        if $g = 'sandra':
            $HallHarassmentAfterText = 'сокрушённо вздыхает, поправляя выбившуюся прядь: «Громко вышло, сынок, на весь трактир... Ну да ладно, хоть руки этот мужлан убрал».'
        elseif $g = 'melissa':
            $HallHarassmentAfterText = 'морщит носик, бросая взгляд на притихший зал: «Шумно получилось, Стефан. Тонкая дипломатия явно уступила место грубой силе... Впрочем, наглец хотя бы ретировался».'
        else
            $HallHarassmentAfterText = 'неловко кусает губу, оглядываясь на гостей: «Ох, шумно как вышло... Все теперь на нас смотрят. Но всё равно спасибо, что отогнал его».'
        end

    ! watch band 0–3
    elseif $id = 'talk_watch_band0':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'чеканит ледяным тоном книжной зазнайки, скрестив руки на корсаже: «Ты просто стоял и наблюдал, Стефан. Чужие сальные руки на моем теле, а ты изучал сцену со стороны. Это было омерзительно — и тебе, судя по всему, совершенно безразлично».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'смотрит строго, с неподдельной материнской горечью: «Стефан... Видел, как ко мне лезут под подол у самой печи, и палец о палец не ударил. Я не держу зла, сынок, но хочу знать, что в этом трактире у меня есть защитник, а не просто праздный зритель».'
        else
            $HallHarassmentAfterText = 'всхлипывает от жгучего девичьего стыда, не поднимая покрасневших глаз: «Ты... ты просто стоял и смотрел, Стефан! Мне было так стыдно, я сгорала со стыда под его лапами, а ты даже шагу не сделал...»'
        end

    elseif $id = 'talk_watch_band1':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'негромко произносит, пытаясь скрыть досаду за холодной усмешкой: «Ты хотя бы не сводил глаз. Приятного мало, но по крайней мере я знала, что ты вмешаешься, если наглость перейдет все границы».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'смягчается, устало проводя ладонью по переднику: «Приглядывал из прохода — и то ладно, сынок. Я и сама отбилась. Главное, что не отвернулся вовсе».'
        else
            $HallHarassmentAfterText = 'теребит край фартука, густо алея щеками: «Ты смотрел со стороны... Наверное, чтобы он не посмел сделать лишнего. Но мне всё равно было до смерти неловко под его взглядом».'
        end

    elseif $id = 'talk_watch_band2':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'одаривает вас тонкой, понимающей улыбкой с легким прищуром: «Напрасно ты так пристально буравил его затылок взглядом, Стефан. Я прекрасно держала ситуацию под контролем — моих аргументов вполне хватило».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'усмехается в усыпанные мукой пальцы, покачивая головой: «На кухне я сама себе закон, сынок. Выставила бы его взашей и без присмотра — но то, что ты был настороже, я приметила».'
        else
            $HallHarassmentAfterText = 'чуть смущенно, но уверенно улыбается: «Я... я и сама бы справилась, Стефан. Не обязательно было так напряженно караулить каждый его жест».'
        end

    elseif $id = 'talk_watch_band3':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'с лукавой насмешкой пересчитывает звякнувшие в ладони монеты: «Мужчина был вполне сговорчив и щедр на серебро. А ты стоял с таким грозным видом, будто вершишь суд Ильматера. Не мешай делу, когда монеты сами плывут в карман».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'деловито поправляет передник, пряча серебряный в карман: «Гость щедрый попался, рагу похвалил и монету кинул. Ты не лезь на рожон, сынок, пока я сама не позову — я отлично знаю, как обращаться с такими гуляками».'
        else
            $HallHarassmentAfterText = 'прячет лукавую улыбку, звеня чаевыми в кулачке: «Он вовсе не злой был... и монету дал щедрую! Зачем ты смотрел так сурово, Стефан, будто на меня напали разбойники?»'
        end

    ! ignore band
    elseif $id = 'talk_ignore_band0':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'холодно роняет, проходя мимо стойки с подчеркнутым презрением: «Демонстративно отвернулся к бочкам и кружкам. Я слышала, как ты протирал стойку, пока меня лапали у всех на виду. Очень удобно, Стефан. Спасибо за чуткость».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'хмурится от обиды, утирая испарину полотенцем: «Даже в кухонный проём не заглянул, Стефан. Слышал шум котлов и перебранку, и сделал вид, что глух. Я выставила наглеца — но трактирщик должен беречь своих людей, сынок».'
        else
            $HallHarassmentAfterText = 'тихо шепчет с нескрываемой девичьей обидой в голосе: «Ты отвернулся... Он распускал руки, а ты делал вид, что протираешь посуду. Неужели тебе совсем всё равно, что со мной происходит?..»'
        end

    elseif $id = 'talk_ignore_band1':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'тихо хмыкает, наливая эль: «Не стал вмешиваться — быть может, и к лучшему, обошлось без публичного скандала. Но впредь держи ухо востро, Стефан».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'вздыхает, бросая взгляд на кухонную дверь: «Не зашел помочь — ну и Ильматер с ним. Сама управилась с половником. Главное, что жива и кастрюли целы».'
        else
            $HallHarassmentAfterText = 'прячет смущенный взгляд, оправляя фартук: «Ты нарочно отвернулся... Наверное, чтобы не смущать меня ещё сильнее. Я выкрутилась, Стефан, но это было очень непросто».'
        end

    elseif $id = 'talk_ignore_band2':
        if $g = 'sandra':
            $HallHarassmentAfterText = 'деловито бросает через плечо: «Сама справилась, сынок. Стоять над душой не нужно — но и делать вид, будто тебя здесь нет, тоже лишнее».'
        elseif $g = 'amanda':
            $HallHarassmentAfterText = 'спокойно поправляет подол платья: «Я справилась сама. Не нужно было бросаться с кулаками — но и отворачиваться к стойке с таким равнодушием тоже не стоило».'
        else
            $HallHarassmentAfterText = 'с иронией приподнимает бровь: «Прекрасная выдержка, Стефан. Я разобралась сама, но твое демонстративное игнорирование выглядело весьма картинно».'
        end

    elseif $id = 'talk_ignore_band3':
        if $g = 'sandra':
            $HallHarassmentAfterText = 'с довольной усмешкой хлопает по звякнувшему карману: «Обошлось к общей пользе, ещё и звонкая монета осталась. Стоишь у стойки и не мешаешь торговле — вот и молодец, сынок, так и держи».'
        else
            $HallHarassmentAfterText = 'с лукавым прищуром звенит чаевыми на подносе: «Всё разрешилось в лучшем виде, и касса трактира пополнилась. Ты правильно сделал, что не стал лезть под руку: серебро любит тишину».'
        end

    else
        $HallHarassmentAfterText = ''
    end

    killvar '$id'
    killvar '$g'
---

! --- client tags (зал): traveler / craftsman / rich_merchant ---
! out: $HallHarassAfterClientTag (коротко «кто»), $HallHarassAfterClientAct (как действует)
#HallHarassAfterClientBits
    $cc = LCASE($HallHarassClient)
    if $cc = '':
        $cc = LCASE($HallMissingClient)
    end
    ! nom / gen (ладонь X) / dat (с X-ом) — без склейки «мастеровойа»
    $HallHarassAfterClientTag = 'гость'
    $HallHarassAfterClientGen = 'гостя'
    $HallHarassAfterClientIns = 'гостем'
    if $cc = 'traveler' or $cc = 'sailor':
        $HallHarassAfterClientTag = 'моряк'
        $HallHarassAfterClientGen = 'моряка'
        $HallHarassAfterClientIns = 'моряком'
    elseif $cc = 'craftsman' or $cc = 'local':
        $HallHarassAfterClientTag = 'мастеровой'
        $HallHarassAfterClientGen = 'мастерового'
        $HallHarassAfterClientIns = 'мастеровым'
    elseif $cc = 'rich_merchant' or $cc = 'merchant':
        $HallHarassAfterClientTag = 'купец'
        $HallHarassAfterClientGen = 'купца'
        $HallHarassAfterClientIns = 'купцом'
    elseif $cc = 'drunk_guest' or $cc = 'drunk':
        $HallHarassAfterClientTag = 'пьяный'
        $HallHarassAfterClientGen = 'пьяного'
        $HallHarassAfterClientIns = 'пьяным'
    end
    killvar '$cc'
---

! protect: уход клиента × типаж × girl (зал / кухня)
#HallHarassAfterProtectFromClient
    gs 'HallHarassAfterClientBits'
    $g = $HallHarassGirl
    $HallHarassmentAfterText = ''
    $ct = $HallHarassAfterClientTag

    if $g = 'sandra' or $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
        if $ct = 'моряк':
            $HallHarassmentAfterText = 'Вы решительно шагаете на кухню, разрезая густой пар от кипящих котлов, и тяжелой ладонью ложитесь на плечо гостя. Моряк вздрагивает, оборачивается с перекошенным от хмеля лицом, но, натолкнувшись на ваш непреклонный взгляд, сквозь зубы сплёвывает на каменный пол. Одёрнув мокрый от брызг пояс, он нехотя пятится прочь в шумный зал. Сандра шумно выдыхает, поправляя сбившийся передник на роскошных бёдрах, и с благодарным прищуром кивает вам от плиты: «Ишь, распустил клешни, морской бродяга... Вовремя подоспел, Стефан». Скрипит тяжелая створка двери — кухня снова остаётся во владениях хозяйки.'
        elseif $ct = 'мастеровой':
            $HallHarassmentAfterText = 'Вы делаете шаг в кухонный проём и властно встаёте между ними. Мастеровой виновато втягивает голову в плечи, торопливо отнимая заскорузлые ладони от талии Сандры: «Да полно тебе, хозяин, свой же человек... так, приобнял по-соседски, похвалил похлёбку...» Сандра строгим взглядом указывает ему на выход, смахивая испарину со лба тыльной стороной руки: «Шути за столом, сосед, а к печи не суйся». Мужчина сконфуженно ретируется в полумрак зала, а Сандра с мягкой полуулыбкой возвращается к своему половнику.'
        elseif $ct = 'купец':
            $HallHarassmentAfterText = 'Вы обрываете наглеца прямо у разделочного стола, припечатав кулак к дубовой доске. Купец вздрагивает, торопливо прячет звякнувший кошель в складки богатого суконного кафтана и напускает на лощеное лицо маску оскорбленного достоинства: «Подумаешь, какая строгость... просто хотел заказать жаркое погорячее». Под вашим тяжелым взглядом он спешит ретироваться обратно в зал. Сандра лишь с усмешкой качает головой, постукивая ложкой по краю чана: «Видал павлина? Думал, за пару монет хозяйку трактира к лавке прижмет... Спасибо, сынок».'
        else
            $HallHarassmentAfterText = 'Вы резко вторгаетесь на кухню, окликая непрошеного гостя. Захмелевший гуляка вздрагивает, выпускает из пальцев край ткани передника и испуганно моргает, пятясь назад спиной: «Уже ухожу, хозяин, право слово, заглянул спросить добавки...» Сандра вытирает влажные ладони о холст, бросая строгий взгляд на кухонный порог: «Хмель совсем мужикам головы кружит. Хорошо, что ты рядом, Стефан — а то пришлось бы поварёшкой по лбу учить». Дверь захлопывается, отрезая кухонный жар от зала.'
        end
    elseif $g = 'melissa':
        if $ct = 'моряк':
            $HallHarassmentAfterText = 'Вы выходите из-за стойки, настигая гостя у лавки, и встаёте плечом к плечу с сестрой. Моряк с досадой сплёвывает под ноги, неохотно разжимая хватку на тонком девичьем предплечье, и валится обратно на деревянную скамью, бормоча что-то неразборчивое про строгих столичных штучек. Мелисса медленно, с подчеркнутым достоинством оглаживает корсаж, расправляя воротничок; румянец на её скулах выдаёт волнение, но насмешливый взгляд книжной зазнайки полон холодного превосходства: «Надеюсь, свежий морской бриз выветрит из вашей головы излишки хмеля быстрее, чем наш эль, сударь». За соседними столами мужики одобрительно гогочут, оценивая бойкий ум и стройный стан девушки.'
        elseif $ct = 'мастеровой':
            $HallHarassmentAfterText = 'Вы решительно вмешиваетесь, перехватывая мозолистую ладонь мастерового. Мужчина виновато кряхтит, пряча хитрые глаза: «Да ладно тебе, трактирщик, мы ж по-соседски... девка больно пригожая, глаз не отвести...» — и неловко плюхается на лавку, утыкаясь носом в глиняную кружку. Мелисса неторопливо поправляет глубокий вырез платья, одаривая вас ироничным взглядом из-под ресниц: мол, спасение благородного рыцаря было эффектным, хотя она и сама держала наглеца в интеллектуальной узде.'
        elseif $ct = 'купец':
            $HallHarassmentAfterText = 'Вы шагаете вплотную, нависая над купцом с непоколебимым спокойствием хозяина заведения. Торговец мгновенно убирает пальцы с талии девушки, торопливо одёргивает суконные полы кафтана и делает вид, будто лишь проверял чистоту стеклянного кубка: «Кхм... превосходное обслуживание, любезный». Мелисса плавно отступает за ваше плечо, бросая едкую шпильку с неподражаемым сарказмом: «Какая невосполнимая утрата для купеческой дипломатии». По залу прокатывается волна смешков — гости явно оценили находчивость книжницы.'
        else
            $HallHarassmentAfterText = 'Вы подходите без лишнего шума, но с той весомой уверенностью, которая не оставляет сомнений. Гость нехотя снимает руки с Мелиссы, бубнит под нос невнятные оправдания и отваливается к своей кружке. Девушка одёргивает подол короткого платья, бросая на уходящего взгляд, полный интеллектуального пренебрежения, после чего поворачивается к вам с лукавой, чуть насмешливой улыбкой.'
        end
    else
        ! amanda
        if $ct = 'моряк':
            $HallHarassmentAfterText = 'Вы стремительно вмешиваетесь, железной хваткой отводя засаленную ладонь матроса от девушки. Моряк хмельно моргает, наталкивается на ваш холодный взгляд и сконфуженно плюхается обратно на лавку, бормоча под нос хриплые извинения. Аманда судорожно прижимает круглый деревянный поднос к своей аккуратной девичьей грудке, заливаясь пунцовым румянцем до самых корней волос. Её грудь взволнованно вздымается под холщовым корсажем, пока она дрожащими пальчиками поправляет сбившийся вырез платья. За дальними столами мужики с удовольствием цокают языками, любуясь смущённой прелестью подавальщицы, а из кухонного проёма на шум на миг выглядывает Сандра — заметив вас подле дочери, мать успокоенно скрывается за дверью.'
        elseif $ct = 'мастеровой':
            $HallHarassmentAfterText = 'Вы встаёте между гостем и сестрой, заставляя мастерового убрать руки. Работяга смущённо чешет в затылке, виновато улыбаясь в бороду: «Да полно тебе, Стефан, не серчай... Уж больно девчонка славная, так и манит взглянуть поближе...» Аманда прячет пылающие щёки за подносом, закусывая губку от смущения, и спешно одёргивает лёгкий подол платья. Соседи по лавке весело посмеиваются над неловкостью товарища, не спуская восхищённых взглядов с тонкой талии юной сестры.'
        elseif $ct = 'купец':
            $HallHarassmentAfterText = 'Вы твёрдо пресекаете вольности, кладя ладонь на край стола прямо перед носом гостя. Купец торопливо убирает пухлые пальцы с бедра Аманды, напуская на себя невинный вид, и торопливо припадает к своей кружке с вином. Девушка переводит дух, румянец волнами заливает её шею и щёчки, а аккуратная грудка часто ходит ходуном от пережитого волнения. Завсегдатаи довольно гудят, обсуждая развернувшуюся сцену.'
        else
            $HallHarassmentAfterText = 'Вы властно встаёте на защиту сестры. Захмелевший посетитель нехотя разжимает пальцы, что-то невнятно мычит и отваливается назад на лавку. Аманда сжимает поднос обеими ручками, алея щеками от девичьей неловкости, и торопливо прячется за ваше крепкое плечо. В дверном проёме кухни на секунду мелькает Сандра с полотенцем в руках: убедившись, что дочка под вашей защитой, она с легким сердцем возвращается к огню.'
        end
    end

    killvar '$g'
    killvar '$ct'
    killvar '$HallHarassAfterClientTag'
    killvar '$HallHarassAfterClientGen'
    killvar '$HallHarassAfterClientIns'
---

! Видимая сцена (watch) по $HallHarassSceneBeat + client (сёстры)
! кухня: БЕЗ «соседний стол / свист зала»
#HallHarassAfterWatchFromBeat
    gs 'HallHarassAfterClientBits'
    $g = $HallHarassGirl
    $b = $HallHarassSceneBeat
    $ct = $HallHarassAfterClientTag
    $cg = $HallHarassAfterClientGen
    $ci = $HallHarassAfterClientIns
    $HallHarassmentAfterText = ''
    HallHarassAfterKitchen = 0
    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen' or $g = 'sandra':
        HallHarassAfterKitchen = 1
    end

    if $b = 'hand_bare':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = 'Сквозь приоткрытую кухонную дверь видно, как в густом тепле кухни, подле разделочного стола, ' + $ct + ' бесцеремонно запускает широкую ладонь глубоко под подол Сандры. Пальцы мужчины с жадным восторгом погружаются под ткань, мгновенно находя округлые, разгоряченные жаром очага зрелые бёдра, на которых вовсе нет исподнего! Сандра на миг замирает, прикусив губу, а затем с весомой силой упирается локтем наглецу под ребра, не повышая голоса выше строгого шепота: «Руки при себе держи, полоумный, не то половником огрею так, что память отшибет!» Мужчина хрипло, довольно посмеивается, отступая на шаг и растирая ушибленный бок, а за кухонной дверью лишь мерно потрескивают угли в печи и сытно побулькивает похлёбка — тайна остаётся на кухне.'
        elseif $g = 'melissa':
            $HallHarassmentAfterText = $ct + ' с сальной, хмельной усмешкой запускает ладонь глубоко под вызывающе короткий форменный подол Мелиссы — и его огрубевшие пальцы бесстыдно сжимают нежную, шелковистую кожу абсолютно голой девичьей попки! По щекам Мелиссы мгновенно разливается яркий девичий румянец, выдавая вспыхнувшее волнение, однако книжница виртуозно держит удар: смерив мужчину насмешливым прищуром превосходства, она гибко выскальзывает из его хватки, расправляя воротничок. «Ваша безграничная наглость, любезный, способна соперничать лишь с убожеством вашего кругозора», — чеканит она с филигранной иронией. За соседними лавками мужики жадно вытягивают шеи, грохая кружками о столы и заливаясь восторженным свистом: «Видит Ильматер, у умницы под юбкой ни единой ниточки! Ай да трактир, вот это обслуживание!»'
        else
            $HallHarassmentAfterText = $ct + ' пользуется суматохой и бесцеремонно запускает широкую ладонь под лёгкий край платья Аманды, тут же сминая округлые, ничем не прикрытые девичьи ягодицы! Аманда испуганно ахает, вспыхивая пунцовым румянцем до самых корней волос: её аккуратная грудка часто и взволнованно ходит ходуном под натянутым холстом корсажа, а напряжённые соски от волнения рельефно очерчивают плотную ткань. Судорожно прижимая круглый поднос к груди, девушка гибко выскальзывает из наглых мужских пальцев, пряча горящее личико. Завсегдатаи у лавок одобрительно стучат кубками по столешницам: «Глядите, братцы, да подавальщица-то совсем без исподнего порхает! Вот это щедрость хозяина!» В дверном проёме кухни на долю секунды мелькает встревоженная Сандра, но, приметив, что дочь уже юрко упорхнула к другим столам, тихо возвращается к котлам.'
        end
    elseif $b = 'grab_tits':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = 'В полумраке кухни, пропитанном ароматами пряностей и дыма, ' + $ct + ' жадно прижимает Сандру к разделочному столу, нагло накрывая широкой ладонью её роскошную, зрелую грудь. Холщовый передник сминается под грубыми пальцами, ткань натягивается на аппетитных формах, но Сандра не теряет самообладания. Спокойно и неторопливо постукивая тяжелым половником по краю медного чана, она с весомой прохладой роняет: «Руки при себе держи, дядька. Чай не в портовом притоне, здесь хозяйка порядок знает». Мужчина хрипло посмеивается, оценив зрелую статью женщины, и нехотя разжимает пальцы, уступая ее спокойной силе.'
        elseif $g = 'melissa':
            $HallHarassmentAfterText = $ct + ' жадно тянется к глубокому вырезу форменного корсажа Мелиссы, бесцеремонно сминая её аккуратную, упругую девичью грудь. Тонкая ткань натягивается под чужими пальцами, отчётливо очерчивая налившиеся жаром бугорки возбужденных сосков. Мелисса лишь язвительно выгибает тонкую бровь, неторопливо отстраняя чужое запястье кончиками пальцев: «Неужели вам непременно нужно осязать руками всё, что категорически отказывается укладываться в ваш куцый рассудок, сударь?» За дальними столами раздается раскатистый хохот и одобрительный звон глиняных кружек: «Ишь как припечатала книжница! А грудки-то у девки — чистое загляденье!»'
        else
            $HallHarassmentAfterText = 'Тяжёлая ладонь ' + $cg + ' бесстыдно ложится на аккуратную девичью грудку Аманды, нагло сминая её сквозь открытый вырез платья. «Пусти... пожалуйста... не надо при всех...» — смущённо лепечет девушка, вспыхивая жарким румянцем от неловкости. Её юное тело вздрагивает, соски возбуждённо и маняще проступают сквозь тонкий холст под горячими пальцами гостя, пока она, неловко балансируя с подносом, пятится прочь из его хватки. Соседи по лавке весело присвистывают: «Сладкая какая подавальщица! И заказ донесет, и потискать позволит!»'
        end
    elseif $b = 'grab_ass' or $b = 'hand_skirt':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = 'Звонкий, сочный шлепок тяжелой мужской ладони эхом прокатывается по каменным сводам кухни — ' + $ct + ' не сдержался и от души припечатал Сандру по зрелым, крутым ягодицам. Сандра величаво и тяжело оборачивается от кипящей плиты, сверкнув строгим, предостерегающим взором: «Совсем хмель последние мозги высушил? Ещё раз тронешь — кипятком из чана окроплю, мигом протрезвеешь!» Мужчина сконфуженно, но довольно хмыкает, отступая обратно к двери.'
        elseif $g = 'melissa':
            $HallHarassmentAfterText = 'Тяжёлая ладонь ' + $cg + ' смачно опускается на округлые бёдра Мелиссы, бесцеремонно сжимая упругую плоть. Девушка резко разворачивается на каблуках, смерив наглеца уничтожающим взглядом интеллектуального превосходства: «Ваша галантность, любезный, уступает лишь манерам портового грузчика в сезон штормов». С соседних лавок гремит пьяный гогот: «Вот это шлепок! За такую бойкую девку и двойной счет оплатить не жалко!»'
        else
            $HallHarassmentAfterText = $ct + ' крепко прихватывает Аманду за аппетитную попку, бесстыдно задирая и сминая подол платья. Девушка ойкает, вспыхивает от макушки до пят густой краской стыда и спешно одёргивает юбку, юрко выскальзывая из пальцев наглеца. Взгляды доброй половины зала жадно прикованы к её стройным ножкам, а завсегдатаи одобрительно цокают языками: «Какая ладная девчонка! Стефан знает толк в подавальщицах!»'
        end
    elseif $b = 'wall':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $ct + ' вваливается на кухню и решительно прижимает Сандру к теплой каменной стене возле очага, нависая всем телом. Сандра упирается ладонями в его широкую грудь и со спокойной силой отталкивает мужлана: «Ошалел совсем? Проваливай к своей кружке, пока я мужиков из зала на подмогу не кликнула!» В кухонном полумраке гудит огонь в печи, укрывая легкий румянец хозяйки.'
        elseif $g = 'melissa':
            $HallHarassmentAfterText = $ct + ' уверенно преграждает дорогу Мелиссе, оттесняя девушку к резному деревянному столбу зала. Мелисса не теряет ледяного спокойствия: ловко уперев локоть в ребра наглеца, она заставляет его отшатнуться назад. «Премного польщена столь неуклюжей осадой, сударь, однако расписание моих трудов не предусматривает пустых пауз на пьяные любезности». Гости за соседними столами с восторгом следят за перепалкой, поднимая кубки за острую на язык книжницу.'
        else
            $HallHarassmentAfterText = $ct + ' оттесняет Аманду к бревенчатой стене трактира, жадно нависая над хрупкой девушкой и отрезая путь к отступлению. Аманда вся алеет от сладкого смущения, её аккуратная грудка взволнованно ходит ходуном под корсажем, а напряжённые соски от волнения отчетливо очерчивают материю. «Пусти же, мне посуду снести надо...» — смущённо шепчет она, выставляя деревянный поднос как преграду и юрко проскальзывая под рукой гостя.'
        end
    elseif $b = 'drop_bend':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = 'Сандра нагибается к нижнему коробу за овощами, и её плотная юбка соблазнительно натягивается на роскошных, зрелых бёдрах. ' + $ct + ' не упускает удобного случая и жадно проводит мозолистой ладонью по округлым формам. Сандра мгновенно выпрямляется, смерив его строгим укором: «Видит Ильматер, совести у тебя ни на грош!» В полумраке кухни лишь трещат поленья в печи — никто из гостей в зале не приметил этой тайной вольности.'
        elseif $g = 'melissa':
            $HallHarassmentAfterText = 'Мелисса наклоняется за упавшей с подноса оловянной ложкой, грациозно прогибаясь в пояснице. Короткий подол платья слегка задирается, открывая взглядам точеные девичьи бёдра. ' + $ct + ' немедля пользуется моментом и смачно шлёпает её сзади по упругой попке. Мелисса мгновенно распрямляется, смерив мужчину насмешливым прищуром: «Ваша реакция опережает ваше воспитание ровно на три столетия, сударь». Завсегдатаи с лавок громко присвистывают, провожая жадными глазами изящные изгибы её фигуры.'
        else
            $HallHarassmentAfterText = 'Аманда нагибается за упавшей медной монеткой, очаровательно прогибаясь в пояснице. Мужская ладонь тут же смачно припечатывает её сзади, оглаживая аппетитные девичьи округлости. Аманда испуганно ойкает, мгновенно выпрямляясь и заливаясь краской до самых корней волос: «Ой... ну зачем же так при всех...» За соседними столами раздаётся дружный хохот: «Вот это поклон! Ради такого зрелища я бы и серебряного не пожалел!»'
        end
    elseif $b = 'play_tip':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = 'Сандра не спешит прогонять гостя прочь: опытным и плавным движением она принимает тяжёлую серебряную монету прямо на край разделочной доски, позволяя ' + $ci + ' лишь на миг приобнять себя за роскошные бёдра. «На выпивку не скупись, рагу нахваливай, а руки сильно не распускай», — с мягкой хозяйской усмешкой роняет она, пряча блеснувшую монету в карман передника.'
        elseif $g = 'melissa':
            $HallHarassmentAfterText = 'Мелисса виртуозно ведёт тонкую игру: одарив ' + $cg + ' снисходительной, чарующей полуулыбкой, она грациозно принимает блеснувшую монету из его пальцев. Её аккуратная, упругая грудь волнующе вздымается в открытом вырезе платья, соски наливаются жаром от азарта легкой наживы, пока книжница мурлычет: «Ваша щедрость почти искупает вашу дерзость, любезный». Размякший гость блаженно улыбается над кружкой, а зал одобрительно гудит.'
        else
            $HallHarassmentAfterText = 'Аманда, алея от девичьего смущения, позволяет ' + $ci + ' коснуться своей тонкой талии, пока его пальцы опускают монету в её ладошку. Её аккуратная грудка вздымается от частого дыхания, затвердевшие бугорки сосков маняще проступают сквозь ткань, а на губах играет робкая, дразнящая улыбка. Мужчины вокруг одобрительно стучат кружками: «Ай да подавальщица! И карманы облегчит, и глаз порадует!»'
        end
    else
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = 'У пышущей печи ' + $ct + ' не торопится отпускать Сандру — пьяный шёпот, жаркие ладони скользят по ткани; хозяйка с неподражаемым спокойствием выкручивается сама, не устраивая шума. Никаких праздных глаз: прикрытая кухонная дверь надёжно прячет происходящее.'
        else
            $HallHarassmentAfterText = $ct + ' не спешит разжимать объятия — хмельной смех, нетерпеливые пальцы комкают платье на бёдрах; ' + $RealName[$g] + ' ловко выскальзывает на свободу, вызывая новую волну одобрительного свиста и шуток среди гостей.'
        end
    end

    if HallHarassSceneSlap = 1 and $b <> 'play_tip':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>В воздухе гулко разносится звонкая, увесистая пощёчина! ' + $ct + ' ошарашенно пятится к выходу, потирая алеющую щёку, пока Сандра с горделивым достоинством одёргивает передник и как ни в чём не бывало возвращается к своему котлу.'
        elseif $g = 'amanda':
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Над шумом зала раздаётся звонкий, хлёсткий хлопок пощёчины! ' + $ct + ' ошалело моргает, хватаясь за пылающую щёку, а Аманда, с горящими от девичьей гордости глазами, спешно поправляет подол платья и с высоко поднятой головой ускользает к другим столам.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Хлёсткая пощёчина звучит сухо и четко, словно удар бича! ' + $ct + ' отшатывается в изумлении, а Мелисса с ледяным презрением отряхивает тонкие пальцы, поправляет вырез корсажа и с поистине царственным достоинством удаляется к стойке.'
        end
    end

    killvar '$g'
    killvar '$b'
    killvar '$ct'
    killvar '$cg'
    killvar '$ci'
    killvar 'HallHarassAfterKitchen'
    killvar '$HallHarassAfterClientTag'
    killvar '$HallHarassAfterClientGen'
    killvar '$HallHarassAfterClientIns'
---

! Звуки ignore из ТОГО ЖЕ beat + client flavor
#HallHarassAfterIgnoreFromBeat
    gs 'HallHarassAfterClientBits'
    $g = $HallHarassGirl
    $b = $HallHarassSceneBeat
    $ct = $HallHarassAfterClientTag
    $cg = $HallHarassAfterClientGen
    $HallHarassmentAfterText = ''
    HallHarassAfterKitchen = 0
    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen' or $g = 'sandra':
        HallHarassAfterKitchen = 1
    end

    if HallHarassAfterKitchen = 1:
        $HallHarassmentAfterText = 'Вы нарочно остаётесь стоять за дубовой стойкой зала, всем своим безучастным видом показывая, будто происходящее на кухне вас нисколько не заботит. Густой шум зала смешивается со звуками из кухонного проёма: за тяжелой приоткрытой дверью не видно лиц, и о развернувшейся там стычке остаётся судить лишь по шорохам, звону утвари и приглушенным голосам.'
    else
        $HallHarassmentAfterText = 'Вы подчеркнуто хладнокровно отворачиваетесь к стойке, неторопливо переставляя глиняные кувшины и делая вид, будто всецело поглощены хозяйскими хлопотами. Взглядом вы не прикасаетесь к развернувшейся сцене — но слух, обострённый до предела, жадно ловит каждую интонацию, каждый шорох одежды и скрип лавок за вашей спиной.'
    end
    $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>'

    if $b = 'hand_bare':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Из-за кухонной двери доносится прерывистый шелест поднимаемого подола, хриплый, ошарашенный смешок ' + $cg + ', нащупавшего ничем не прикрытую шелковистую наготу бёдер, и хлесткий, приглушенный голос Сандры: «Руки убрал, охальник, пока половник в ход не пустила!» Слышится звон медной крышки, шлепок ладони по дереву и тяжелые, поспешные шаги гостя, остудившего пыл.'
        elseif $g = 'amanda':
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'За спиной шуршит тонкий подол холщового платья, раздаётся жадный мужской вздох ' + $cg + ' и смущённое, испуганное девичье ойканье. Зал на мгновение захлебывается тишиной, а затем взрывается сальным шёпотом завсегдатаев: «Ильматер всеблагой... да у подавальщицы под юбкой ни единой нитки!» Глухой стук деревянного подноса и торопливые легкие шаги выдают, что Аманда смогла юрко выскользнуть из наглых мужских пальцев.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Сзади слышится шорох задираемой юбки, победный хриплый гогот ' + $cg + ' и ледяное, острое, словно бритва, шипение Мелиссы: «Уберите руки немедленно, сударь, если вам дороги ваши пальцы». По залу прокатывается восторженный свист и одобрительный стук кубков: «Гляньте-ка, умница-книжница совсем без исподнего щеголяет!» — после чего раздается четкий, уверенный перестук девичьих каблучков, разорвавшей дистанцию.'
        end
    elseif $b = 'grab_tits':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'С кухни долетает глухой шорох сминаемой на груди ткани, утробное кряхтение ' + $cg + ' и веское, строгое предупреждение Сандры: «Руки прочь от хозяйки, дядька. Не в хлеву!» Следом шумно шипит рагу на углях, а гость миролюбиво бубнит под нос, отступая от плиты.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'За вашей спиной раздаётся прерывистый женский вздох ' + $RealName[$g] + ', довольное мычание захмелевшего ' + $cg + ' и характерный шорох плотно сминаемой на девичьей груди ткани. За соседними лавками одобрительно цокают языками и приглушенно гогочут завсегдатаи, жадно смакуя каждую секунду открывшейся картины.'
        end
    elseif $b = 'grab_ass' or $b = 'hand_skirt':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Звонкий, сочный шлепок ладони по крутым ягодицам Сандры гулко долетает из кухонного полумрака. Слышится её сердитый окрик, увесистый стук деревянной ложки о разделочный стол и виноватое бормотание гостя, которому недвусмысленно указали на дверь.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Пространство зала оглашает хлесткий, аппетитный шлепок ладони по девичьим округлостям. Мужики за столами дружно взрываются одобрительным хохотом, поддерживая удаль ' + $cg + ', а сзади доносится торопливый шелест одёргиваемой ткани и смущённое сопение девушки.'
        end
    elseif $b = 'wall':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Глухой стук о каменную кладку кухни, скрип ларя, тяжелое мужское дыхание и резкий, решительный толчок — Сандра без лишних церемоний выставила наглеца на почтительное расстояние от очага.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Глуховатый стук спины о бревенчатую стену, скрип дубовой скамьи и пьяное бормотание. Следом звучит решительный девичий отпор, глухой стук подноса и быстрый шелест юбок: девушке удалось ловко ускользнуть из угла.'
        end
    elseif $b = 'drop_bend':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Звон покатившейся глиняной миски, шорох наклона и звонкий хлопок мужской ладони по натянувшейся на бёдрах ткани. Возмущенное шипение Сандры тонет в мерном гудении кухонного очага.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Тонкий звон оброненной на дощатый пол монетки, шелест подола нагнувшейся девушки и смачный, жадный шлепок сзади. Зал дружно взрывается присвистом и одобрительным гулом: завсегдатаи в полной мере насладились соблазнительным ракурсом.'
        end
    elseif $b = 'play_tip':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Мягкий, сдержанный женский смешок с кухни, звонкий щелчок полновесной серебряной монеты о край стола и довольное хмыканье ' + $cg + '. Торг окончен миром, а звонкое серебро надежно осело в кармане хозяйки.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Тихий, кокетливый девичий смех, отчетливый перестук тяжелых серебряных монет о столешницу и одобрительный гомон захмелевшей компании: девушка мастерски обернула мужскую похоть в звонкую монету.'
        end
    else
        $HallHarassmentAfterText = $HallHarassmentAfterText + 'Хмельные шутки ' + $cg + ', шорох примятой ткани, приглушенный девичий голос и звон глиняной посуды на подносе.'
    end

    if HallHarassSceneSlap = 1 and $b <> 'play_tip':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Следом с кухни раздаётся звонкий, хлесткий звук полновесной пощёчины! Слышны ошарашенные ругательства гостя, тяжелый топот пятившихся в зал сапог и мерный, невозмутимый стук кухонного ножа о доску.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Над шумом трактира гремит сухой, сокрушительный хлопок пощёчины! Зал изумленно ахает, после чего разражается дружным гоготом над сконфуженным наглецом, а быстрые девичьи шаги возвещают о том, что честь отстояна.'
        end
    else
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Скрипит тяжелая кухонная дверь, гость сконфуженно возвращается за свой стол в зале, а с кухни вновь доносится мерное побулькивание похлёбки.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Шаги отдаляются, и зал трактира вновь погружается в привычный разноголосый хмельной гул.'
        end
    end

    killvar '$g'
    killvar '$b'
    killvar '$ct'
    killvar '$cg'
    killvar 'HallHarassAfterKitchen'
    killvar '$HallHarassAfterClientTag'
    killvar '$HallHarassAfterClientGen'
    killvar '$HallHarassAfterClientIns'
---
