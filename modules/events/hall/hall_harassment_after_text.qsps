! ================================================
! FILE: modules/events/hall/hall_harassment_after_text.qsps
! MODULE: events/hall
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Экран 2 harass: реакция ДЕВУШКИ + КЛИЕНТА на выбор Стефана
! КАНОН v2.2:
! - 4 бытовые ситуации зала (tray, ladder, table_wipe, lap_seat)
! - Кухня Сандры (плита, разделочный стол, очаг)
! - Клиент уходит при protect; звуки ignore соответствуют ситуации
! - Канон голосов без слёз, истерик и обвинений Стефана
! - band (HallHarassAfterBand):
!   0 stage<=1 — строгость / требование держать порядок
!   1 stage=2  — «смотрел, чтобы не обидели»
!   2 stage=3  — «я сама бы справилась»
!   3 stage>=4 — «щедрый гость, не мешай звонкой монете»
! ================================================

#HallHarassAfterBandCalc
    HallHarassAfterBand = 0
    if FamilyCorruptionStage >= 4:
        HallHarassAfterBand = 3
    elseif FamilyCorruptionStage >= 3:
        HallHarassAfterBand = 2
    elseif FamilyCorruptionStage >= 2:
        HallHarassAfterBand = 1
    else
        HallHarassAfterBand = 0
    end
    ! play / high slut чуть сдвигает к «позже»
    if ($HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke') and HallHarassAfterBand < 3:
        HallHarassAfterBand += 1
    elseif sluttiness[$HallHarassGirl] >= 45 and HallHarassAfterBand < 2:
        HallHarassAfterBand += 1
    end
    if HallHarassAfterBand > 3:
        HallHarassAfterBand = 3
    end
---

#HallHarassAfterScenePick
    if $HallHarassSceneBeat <> '' and HallHarassScenePicked = 1:
        exit
    end

    $HallHarassSceneBeat = 'tray'
    HallHarassSceneSlap = 0

    ! 1. Подыгрывание (play / provoke)
    if $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
        $HallHarassSceneBeat = 'play_tip'
    ! 2. Без белья на высоких тирах (фокус на наготе)
    elseif GirlNoPantiesWork[$HallHarassGirl] = 1 and HarassTier >= 2:
        $HallHarassSceneBeat = 'hand_bare'
    ! 3. Соответствие 4 бытовым ситуациям Канона v2.2
    elseif HallHarassType = 2:
        $HallHarassSceneBeat = 'ladder'
    elseif HallHarassType = 3:
        $HallHarassSceneBeat = 'table_wipe'
    elseif HallHarassType = 4:
        $HallHarassSceneBeat = 'lap_seat'
    else
        $HallHarassSceneBeat = 'tray'
    end

    ! Пощёчина в исходе (только при отпоре / ранней игре, никогда при play)
    HallHarassSlapChance = 25
    if $HallHarassSceneBeat = 'play_tip' or $HarassGirlStance = 'provoke':
        HallHarassSlapChance = 0
    elseif $HarassGirlStance = 'resist' or FamilyCorruptionStage <= 1:
        HallHarassSlapChance = 45
    elseif FamilyCorruptionStage >= 4:
        HallHarassSlapChance = 10
    end

    if RAND(1, 100) <= HallHarassSlapChance:
        HallHarassSceneSlap = 1
    end
    killvar 'HallHarassSlapChance'
    HallHarassScenePicked = 1
---

#HallHarassmentPrintAfterBeat
    gs 'HallHarassAfterBandCalc'
    gs 'HallHarassAfterScenePick'

    $HallHarassAfterId = ''
    if $HallHarassReaction = 'protect_hard':
        $HallHarassAfterId = 'after_protect'
    elseif $HallHarassReaction = 'ignore':
        $HallHarassAfterId = 'after_ignore'
    elseif $HallHarassStanceCanon = 'play' or $HarassGirlStance = 'provoke':
        $HallHarassAfterId = 'after_watch_play'
    else
        $HallHarassAfterId = 'after_watch'
    end

    gs 'HallHarassmentAfterText', $HallHarassAfterId
    if $HallHarassmentAfterText <> '':
        *pl $HallHarassmentAfterText
    end
    killvar '$HallHarassAfterId'
    killvar '$HallHarassmentAfterText'
---

#HallHarassmentPrintAfterTalkLine
    gs 'HallHarassAfterBandCalc'
    $HallHarassAfterId = ''

    if $HallHarassReaction = 'protect_hard':
        if $HallHarassTalkReaction = 'protect_dislike':
            $HallHarassAfterId = 'talk_protect_annoyed'
        elseif $HallHarassTalkReaction = 'protect_fail':
            $HallHarassAfterId = 'talk_protect_fail'
        else
            $HallHarassAfterId = 'talk_protect_thanks'
        end
    elseif $HallHarassReaction = 'watch':
        if HallHarassAfterBand = 0:
            $HallHarassAfterId = 'talk_watch_band0'
        elseif HallHarassAfterBand = 1:
            $HallHarassAfterId = 'talk_watch_band1'
        elseif HallHarassAfterBand = 2:
            $HallHarassAfterId = 'talk_watch_band2'
        else
            $HallHarassAfterId = 'talk_watch_band3'
        end
    else
        if HallHarassAfterBand = 0:
            $HallHarassAfterId = 'talk_ignore_band0'
        elseif HallHarassAfterBand = 1:
            $HallHarassAfterId = 'talk_ignore_band1'
        elseif HallHarassAfterBand = 2:
            $HallHarassAfterId = 'talk_ignore_band2'
        else
            $HallHarassAfterId = 'talk_ignore_band3'
        end
    end

    gs 'HallHarassmentAfterText', $HallHarassAfterId
    if $HallHarassmentAfterText <> '':
        *pl $RealName[$HallHarassGirl] + ' ' + $HallHarassmentAfterText
    end
    killvar '$HallHarassAfterId'
    killvar '$HallHarassmentAfterText'
---

#HallHarassmentAfterText
    $id = LCASE($ARGS[0])
    $HallHarassmentAfterText = ''
    $g = $HallHarassGirl
    if $g = '':
        $g = 'amanda'
    end
    if $RealName[$g] = '':
        if LOC('HallMissingGirlEnsureName') = 1:
            gs 'HallMissingGirlEnsureName', $g
        end
    end

    ! ========== BEAT: protect — клиент уходит, девушка приходит в себя ==========
    if $id = 'after_protect':
        gs 'HallHarassAfterProtectFromClient'

    ! ========== BEAT: watch / ignore по ситуациям ==========
    elseif $id = 'after_watch' or $id = 'after_watch_play':
        gs 'HallHarassAfterWatchFromBeat'
    elseif $id = 'after_ignore':
        gs 'HallHarassAfterIgnoreFromBeat'

    ! ========== TALK lines (к Стефану) — band 0..3 ==========
    elseif $id = 'talk_protect_thanks':
        if HallHarassAfterBand >= 2:
            if $g = 'melissa':
                $HallHarassmentAfterText = 'с легкой иронией приподнимает бровь, неторопливо расправляя воротничок: «Признательна за участие, Стефан... хотя я и сама держала его в интеллектуальной узде. Впредь действуй мягче: состоятельные господа пугливы, а их серебро трактиру лишним не будет».'
            elseif $g = 'sandra':
                $HallHarassmentAfterText = 'смахивает со лба влажную прядь и тепло улыбается: «Спасибо, Стефан. Только не кидайся грудью на каждого выпивоху — на кухне хозяйка я, спуску мужланам никогда не давала».'
            else
                $HallHarassmentAfterText = 'облегчённо переводит дух и весело улыбается, поправляя поднос: «Спасибо, Стефан! Вовремя ты подошёл — мужик совсем разошёлся, я уж думала подносом по лбу приложить!»'
            end
        else
            if $g = 'melissa':
                $HallHarassmentAfterText = 'сдержанно кивает с безупречной осанкой: «Спасибо, Стефан. Вовремя подоспел — манеры этого господина решительно выходили за рамки элементарных приличий».'
            elseif $g = 'sandra':
                $HallHarassmentAfterText = 'веско кивает, вытирая руки о передник: «Спасибо, сынок. Наглецам у котлов не место — ты всё сделал по-хозяйски правильно».'
            else
                $HallHarassmentAfterText = 'слегка розовеет щеками, но с благодарной улыбкой прячет пальчики за край подноса: «Спасибо, Стефан! Он так внезапно вцепился, что я едва кружки не выронила. Хорошо, что ты рядом».'
            end
        end

    elseif $id = 'talk_protect_annoyed':
        if HallHarassAfterBand >= 3:
            if $g = 'melissa':
                $HallHarassmentAfterText = 'язвительно хмыкает, скрещивая руки на груди: «Какая трогательная доблесть, сударь... Он уже полез за серебром в кошель, а ты ворвался коршуном. Трактиру нужны доходы на книги и припасы, а не рыцарские турниры».'
            elseif $g = 'sandra':
                $HallHarassmentAfterText = 'с мягкой укоризной качает головой: «Он уже за тройную порцию платить собирался, Стефан. Не распугивай тех, кто щедро платит за сытный обед, сынок — я бы и сама с ним сладила».'
            else
                $HallHarassmentAfterText = 'надувает губки с задорной досадой: «Стефан, ну зачем же так резко? Он уже монету на чай доставал! Я бы всё шуткой уладила, а ты гостя спугнул!»'
            end
        elseif HallHarassAfterBand >= 2:
            if $g = 'melissa':
                $HallHarassmentAfterText = 'с прохладной усмешкой пожимает плечами: «Право слово, Стефан, я способна парировать выпады захмелевших невежд без столь бурного вмешательства».'
            elseif $g = 'sandra':
                $HallHarassmentAfterText = 'вздыхает, возвращаясь к чану: «Я бы и сама с ним сладила, сынок. Не стоило поднимать шум из-за пьяных шуток».'
            else
                $HallHarassmentAfterText = 'с легкой досадой одёргивает передник: «Я уже почти перевела всё в шутку, Стефан... Не обязательно было так резко бросаться на него».'
            end
        else
            if $g = 'melissa':
                $HallHarassmentAfterText = 'поджимает губы, бросая колкий взгляд: «Могла разобраться сама. Не стоит выставлять меня перед залом беспомощной барышней, Стефан».'
            elseif $g = 'sandra':
                $HallHarassmentAfterText = 'мягко, но твёрдо кладёт ладонь вам на плечо: «Спасибо за защиту, Стефан. Только не делай из меня немощную — я в этом доме хозяйка, а не пугливая девчонка».'
            else
                $HallHarassmentAfterText = 'дует губки и гордо вскидывает подбородок: «Я и сама могла за себя постоять! Теперь завсегдатаи решат, будто я без твоей спины и шагу ступить не смею».'
            end
        end

    elseif $id = 'talk_protect_fail':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'морщит носик, глядя на притихшие лавки: «Шумно получилось, Стефан. Тонкая дипломатия явно уступила место грубой силе... Впрочем, наглец хотя бы ретировался».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'сокрушённо вздыхает, поправляя выбившуюся прядь: «Громко вышло, сынок, на весь трактир... Ну да ладно, хоть руки этот мужлан убрал».'
        else
            $HallHarassmentAfterText = 'неловко кусает губку, оглядываясь на гостей: «Ох, шумно как вышло... Все теперь на нас смотрят. Но всё равно спасибо, что отогнал его».'
        end

    ! ---------- watch band 0..3 (КАНОН: без слез и обвинений Стефана) ----------
    elseif $id = 'talk_watch_band0':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'скрещивает руки на груди, смерив вас взглядом строгой книжной зазнайки: «Любопытная позиция научного наблюдателя, Стефан. Твоя непоколебимая вера в мои педагогические таланты прямо-таки восхищает, хотя пара веских слов от хозяина избавила бы меня от необходимости тратить время на нотации этому невежде».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'строго смотрит от плиты, уперев руки в бока: «Стоишь в проёме и любуешься, Стефан? Я наглеца и сама половником осадила, но ты в этом доме хозяин или праздный зевака? В следующий раз сам его за шиворот из кухни выставляй».'
        else
            $HallHarassmentAfterText = 'раздражённо скрещивает ручки на груди и сердито дует на выбившуюся чёлку: «Стефан, ты там за стойкой уснул, что ли?! Стоял и спокойно смотрел, как этот хам ко мне руки тянет! Я, конечно, и сама могу подносом огреть, но ты же хозяин трактира — мог бы хоть прикрикнуть для острастки!»'
        end

    elseif $id = 'talk_watch_band1':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'одаривает вас насмешливой полуулыбкой, расправляя воротничок: «Ты хотя бы держал ситуацию в поле зрения. Приятного мало, но по крайней мере я знала, что за спиной есть кому осадить наглеца, если он окончательно потеряет берега».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'смягчается, устало утирая лоб тыльной стороной руки: «Приглядывал из зала — и то ладно, сынок. Я и сама отбилась, но то, что ты был начеку, приметила».'
        else
            $HallHarassmentAfterText = 'поправляет передник, пряча легкое смущение: «Ты со стойки наблюдал... Наверное, чтобы он границ не перешёл. Я выкрутилась, Стефан, но гость попался больно уж настырный».'
        end

    elseif $id = 'talk_watch_band2':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'одаривает вас тонкой, понимающей улыбкой с легким прищуром: «Напрасно ты так напряжённо буравил его затылок взглядом, Стефан. Я прекрасно держала ситуацию под контролем — моих аргументов вполне хватило».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'усмехается в мучные пальцы, покачивая головой: «На кухне я сама себе закон, сынок. Выставила бы его взашей и без присмотра — но то, что ты был настороже, дело хозяйское».'
        else
            $HallHarassmentAfterText = 'уверенно улыбается, ловко подкручивая поднос на пальцах: «Я и сама отлично справилась, Стефан! Не нужно было так сурово караулить каждый его жест — я знаю, как обращаться с подвыпившими гостями».'
        end

    elseif $id = 'talk_watch_band3':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'с лукавой насмешкой пересчитывает звякнувшие в ладони серебряные монеты: «Мужчина оказался на редкость сговорчив и щедр на серебро. Не мешай делу грозным видом, Стефан — эти монеты отлично послужат для покупки книг и пергамента».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'деловито поправляет передник, пряча серебряный в карман: «Гость щедрый попался, рагу похвалил и монету кинул. Не лезь на рожон, сынок, пока я сама не позову — я отлично знаю, как обращаться с такими гуляками».'
        else
            $HallHarassmentAfterText = 'весело звенит чаевыми в кулачке, озорно стреляя глазками: «Он вовсе не злой был... и монету дал щедрую! Зачем ты смотрел так хмуро, Стефан, будто на меня напали разбойники?»'
        end

    ! ---------- ignore band 0..3 (КАНОН: без драмы и обвинений) ----------
    elseif $id = 'talk_ignore_band0':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'проходит мимо стойки с подчеркнутым интеллектуальным превосходством: «Демонстративно увлечься мытьем кувшинов — ход, безусловно, оригинальный, Стефан. Я, разумеется, справилась сама, но на будущее: трактир держится на авторитете хозяина, а не на его выборочной глухоте».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'недовольно хмурится, вытирая руки полотенцем: «Оглох за стойкой, Стефан? Шум на кухне стоял такой, что на улице слышно было, а ты и носа не сунул. Я со сковородой управляюсь ловко, но порядок в доме надо держать вместе».'
        else
            $HallHarassmentAfterText = 'с легким возмущением ставит поднос на край стойки: «Отличная помощь, Стефан! Нарочно отвернулся к бочонкам, пока ко мне руки тянут! В следующий раз я гостю подносом по лбу заеду, а счет за разбитую посуду на тебя запишу!»'
        end

    elseif $id = 'talk_ignore_band1':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'тихо хмыкает, аккуратно расставляя кружки: «Не стал вмешиваться — быть может, и к лучшему, обошлось без публичного скандала на весь зал. Но впредь держи ухо востро, Стефан».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'вздыхает, бросая строгий взгляд на кухонный порог: «Не зашёл помочь — ну и Ильматер с ним. Сама управилась половником. Главное, что посуда цела».'
        else
            $HallHarassmentAfterText = 'поправляет сбившийся локон с легкой улыбкой: «Ты нарочно не стал вмешиваться... Ладно, обошлось без шума, я сама вывернулась. Но в другой раз хоть поглядывай в мою сторону!»'
        end

    elseif $id = 'talk_ignore_band2':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'с иронией приподнимает бровь: «Прекрасная выдержка, Стефан. Я разобралась сама, но твоё показное равнодушие к шуму выглядело весьма картинно».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'деловито бросает через плечо: «Сама справилась, сынок. Стоять над душой не нужно — но и делать вид, будто тебя здесь нет, тоже лишнее».'
        else
            $HallHarassmentAfterText = 'спокойно одёргивает платье с легкой усмешкой: «Я справилась сама. Не нужно было бросаться с кулаками — но и отворачиваться к стойке с таким равнодушием тоже не стоило».'
        end

    elseif $id = 'talk_ignore_band3':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'с прохладной усмешкой звенит серебром на подносе: «Инцидент исчерпан, касса пополнена. Твоё невмешательство сберегло гостю самолюбие, а нам принесло полновесную монету».'
        elseif $g = 'sandra':
            $HallHarassmentAfterText = 'с довольной хозяйской усмешкой хлопает по звякнувшему карману: «Обошлось к общей пользе, ещё и звонкая монета осталась. Стоишь у стойки и не мешаешь торговле — вот и молодец, сынок, так и держи».'
        else
            $HallHarassmentAfterText = 'с лукавым прищуром подмигивает от стойки: «Всё разрешилось в лучшем виде, и чаевые в кармане! Ты правильно сделал, что не стал лезть под руку: серебро любит тишину».'
        end

    else
        $HallHarassmentAfterText = ''
    end

    killvar '$id'
    killvar '$g'
---

#HallHarassAfterClientBits
    $cc = LCASE($HallHarassClient)
    if $cc = '':
        $cc = LCASE($HallMissingClient)
    end
    $HallHarassAfterClientTag = 'гость'
    $HallHarassAfterClientGen = 'гостя'
    $HallHarassAfterClientIns = 'гостем'
    if $cc = 'traveler' or $cc = 'sailor':
        $HallHarassAfterClientTag = 'моряк'
        $HallHarassAfterClientGen = 'моряка'
        $HallHarassAfterClientIns = 'моряком'
    elseif $cc = 'craftsman' or $cc = 'local':
        $HallHarassAfterClientTag = 'мастеровой'
        $HallHarassAfterClientGen = 'мастерового'
        $HallHarassAfterClientIns = 'мастеровым'
    elseif $cc = 'rich_merchant' or $cc = 'merchant':
        $HallHarassAfterClientTag = 'купец'
        $HallHarassAfterClientGen = 'купца'
        $HallHarassAfterClientIns = 'купцом'
    elseif $cc = 'drunk_guest' or $cc = 'drunk':
        $HallHarassAfterClientTag = 'пьяный'
        $HallHarassAfterClientGen = 'пьяного'
        $HallHarassAfterClientIns = 'пьяным'
    end
    killvar '$cc'
---

#HallHarassAfterProtectFromClient
    gs 'HallHarassAfterClientBits'
    $g = $HallHarassGirl
    $HallHarassmentAfterText = ''
    $ct = $HallHarassAfterClientTag

    if $g = 'sandra' or $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen':
        if $ct = 'пьяный':
            $HallHarassmentAfterText = 'Вы резко шагаете на кухню, разрезая густой пар от кипящих котлов, и тяжелой рукой осаживаете наглеца за ворот: «Руки убрал и проваливай в зал, пока не вышвырнул!» Пьяный ошалело моргает, натыкается на ваш холодный взгляд и, спотыкаясь о порог, нехотя пятится прочь. Сандра шумно переводит дух, поправляя широкий передник на роскошных бёдрах: «Вовремя подоспел, Стефан. Ишь, распустил лапы... Спасибо, сынок». Скрипит тяжелая дубовая створка — кухня снова надёжно укрыта от посторонних глаз.'
        elseif $ct = 'моряк':
            $HallHarassmentAfterText = 'Вы решительно шагаете на кухню и встаёте между гостем и плитой: «Сударь, кухня — не место для прогулок. Ваш заказ принесут в зал». Моряк недовольно цыкает зубом, сплёвывает в сторону и, одёрнув мокрый пояс, нехотя пятится прочь. Сандра отирает замучненные ладони о льняное полотенце и с благодарным прищуром кивает вам от плиты: «Морской бродяга... думал, хозяйку врасплох застанет. Спасибо, Стефан».'
        elseif $ct = 'купец':
            $HallHarassmentAfterText = 'Вы обрываете гостя прямо у разделочного стола, веско положив ладонь на дубовую доску: «Сударь, хозяйка занята обедом, а не беседами. Прошу за свой стол». Купец вздрагивает, торопливо прячет звякнувший кошель в складки суконного кафтана и напускает на лощеное лицо маску достоинства: «Кхм... просто хотел заказать жаркое погорячее». Под вашим взглядом он спешит ретироваться. Сандра усмехается, постукивая ложкой: «Видал павлина? Думал, за пару монет хозяйку трактира к лавке прижмет... Спасибо, сынок».'
        else
            $HallHarassmentAfterText = 'Вы делаете шаг в кухонный проём и властно встаёте между ними: «Сосед, руки при себе держи. Шути в зале, а к печи не суйся». Мужчина сконфуженно втягивает голову в плечи: «Да полно тебе, хозяин, свой же человек... так, похвалил похлёбку...» Сандра строгим взглядом указывает ему на дверь, а затем с мягкой полуулыбкой поворачивается к вам: «Хмель мужикам головы кружит. Спасибо, что рядом, Стефан».'
        end
    elseif $g = 'melissa':
        if $ct = 'пьяный':
            $HallHarassmentAfterText = 'Вы выходите из-за стойки, нависая над наглецом тяжёлой хозяйской фигурой: «Руки убрал от девушки и сел на место, пока цел». Пьяный мужлан ошалело трезвеет от вашего тона, виновато бубнит под нос и плюхается обратно на лавку. Мелисса медленно, с царственным достоинством расправляет воротничок; насмешливый взгляд книжной зазнайки полон холодного превосходства: «Надеюсь, холодный эль остудит ваши примитивные порывы быстрее, чем кулак хозяина». Повернувшись к вам, она с иронией приподнимает бровь: «Грубовато, Стефан, но для столь неразвитого рассудка — весьма доходчиво».'
        elseif $ct = 'купец':
            $HallHarassmentAfterText = 'Вы шагаете вплотную, нависая над купцом со спокойной уверенностью хозяина: «Сударь, обслуживание в нашем заведении вежливое, но границы переходить не стоит». Торговец мгновенно убирает пальцы с талии девушки, торопливо одёргивая суконные полы кафтана: «Кхм... превосходное заведение, любезный». Мелисса плавно отступает за ваше плечо, бросая язвительную шпильку с неподражаемым сарказмом: «Какая невосполнимая утрата для купеческой дипломатии, сударь». За соседними столами мужики одобрительно гогочут, оценивая бойкий ум книжницы.'
        elseif $ct = 'моряк':
            $HallHarassmentAfterText = 'Вы решительно вмешиваетесь, становясь плечом к плечу с сестрой: «Сударь, держите руки при себе, если хотите спокойно допить свой эль». Моряк с досадой сплёвывает под ноги, неохотно разжимая хватку, и валится обратно на скамью. Мелисса невозмутимо оглаживает ткань платья на бедрах: «Надеюсь, свежий морской бриз выветрит из вашей головы излишки хмеля быстрее, чем наш эль, сударь». Гости вокруг весело шумят, оценивая стройный стан и острый язык подавальщицы.'
        else
            $HallHarassmentAfterText = 'Вы подходите без лишнего шума, но с той весомой уверенностью, которая не оставляет сомнений. Гость нехотя снимает руки с Мелиссы, бубнит извинения и отсаживается глубже к кружке. Девушка одёргивает подол короткого платья, бросая на уходящего взгляд, полный интеллектуального пренебрежения, после чего поворачивается к вам с лукавой, чуть насмешливой улыбкой: «Спасенье прошло успешно, Стефан».'
        end
    else
        ! amanda
        if $ct = 'пьяный':
            $HallHarassmentAfterText = 'Вы стремительно вмешиваетесь, перехватывая засаленную ладонь наглеца и оттесняя его от сестры: «Руки убрал и сиди смирно, пока не выставил взашей!» Пьяница пугливо моргает, натыкается на ваш ледяной взгляд и сконфуженно вжимается в угол лавки. Аманда прижимает круглый деревянный поднос к своей аккуратной девичьей груди, облегчённо переводя дух. Её щёки слегка розовеют, но в глазах пляшут озорные искорки: «Ух, спасибо, Стефан! Чуть весь поднос не опрокинула из-за этого увальня!» За дальними лавками одобрительно стучат кружками.'
        elseif $ct = 'купец':
            $HallHarassmentAfterText = 'Вы твёрдо пресекаете вольности, кладя ладонь на край стола перед гостем: «Сударь, заказ на столе, а лишние вольности оставьте за порогом». Купец торопливо убирает пухлые пальцы с бедра Аманды, напуская невинный вид, и припадает к кубку. Девушка переводит дух, румянец волнами заливает её шею и щёчки, пока она дрожащими пальчиками поправляет край платья. С благодарной улыбкой она шепчет: «Спасибо, Стефан... я уж думала подносом отбиваться!» Завсегдатаи довольно гудят, одобряя порядок.'
        elseif $ct = 'моряк':
            $HallHarassmentAfterText = 'Вы выходите вперед, отсекая руку матроса: «Сударь, в нашем трактире подавальщицы разносят эль, а не девичьи ласки». Моряк хмельно хмыкает, наталкивается на ваш холодный взгляд и отваливается обратно на лавку. Аманда ловко перехватывает поднос обеими ручками, алея щеками от девичьей неловкости, и торопливо прячется за ваше крепкое плечо: «Стефан... спасибо! Так крепко вцепился, прямо не продохнуть было». Мужики за соседними столами восхищённо цокают языками, провожая взглядами её стройные ножки.'
        else
            $HallHarassmentAfterText = 'Вы властно встаёте на защиту сестры. Посетитель смущённо разжимает пальцы, виновато улыбаясь: «Да ладно тебе, Стефан, не серчай... Уж больно девчонка славная!» Аманда с улыбкой одёргивает подол платья, пряча зардевшиеся щёчки за краем подноса: «Спасибо, братец! Вовремя ты подошёл». В дверном проёме кухни на секунду мелькает Сандра — убедившись, что дочка под вашей защитой, она со спокойной душой возвращается к очагу.'
        end
    end

    killvar '$g'
    killvar '$ct'
    killvar '$HallHarassAfterClientTag'
    killvar '$HallHarassAfterClientGen'
    killvar '$HallHarassAfterClientIns'
---

#HallHarassAfterWatchFromBeat
    gs 'HallHarassAfterClientBits'
    $g = $HallHarassGirl
    $b = $HallHarassSceneBeat
    $ct = $HallHarassAfterClientTag
    $cg = $HallHarassAfterClientGen
    $ci = $HallHarassAfterClientIns
    $HallHarassmentAfterText = ''
    HallHarassAfterKitchen = 0
    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen' or $g = 'sandra':
        HallHarassAfterKitchen = 1
    end

    ! 1. Подыгрывание (play_tip)
    if $b = 'play_tip':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = 'Сандра не спешит прогонять гостя прочь: опытным и плавным движением она принимает тяжёлую серебряную монету прямо на край разделочной доски, позволяя ' + $ci + ' лишь на миг приобнять себя за роскошные бёдра. «На выпивку не скупись, рагу нахваливай, а руки сильно не распускай», — с мягкой хозяйской усмешкой роняет она, пряча блеснувшую монету в карман передника.'
        elseif $g = 'melissa':
            $HallHarassmentAfterText = 'Мелисса виртуозно ведёт тонкую игру: одарив ' + $cg + ' снисходительной, чарующей полуулыбкой, она грациозно принимает блеснувшую монету из его пальцев. Её аккуратная, упругая грудь волнующе вздымается в открытом вырезе платья, соски заметно твердеют от азарта легкой наживы, пока книжница мурлычет: «Ваша щедрость почти искупает вашу дерзость, любезный». Размякший гость блаженно улыбается над кружкой, а зал одобрительно гудит.'
        else
            $HallHarassmentAfterText = 'Аманда, алея от задорного смущения, позволяет ' + $ci + ' коснуться своей тонкой талии, пока его пальцы опускают звонкую монету в её ладошку. Её аккуратная грудка вздымается от частого дыхания, затвердевшие бугорки сосков маняще проступают сквозь ткань, а на губах играет дразнящая улыбка. Мужчины вокруг одобрительно стучат кружками: «Ай да подавальщица! И карманы облегчит, и глаз порадует!»'
        end

    ! 2. Без белья на высоких тирах (hand_bare)
    elseif $b = 'hand_bare':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = 'Сквозь приоткрытую кухонную дверь видно, как ' + $ct + ' бесцеремонно запускает широкую ладонь под подол Сандры, находя округлые, разгоряченные жаром зрелые бёдра, на которых вовсе нет исподнего! Сандра на миг замирает, а затем с весомой силой упирается локтем наглецу под ребра: «Руки при себе держи, охальник, не то половником огрею так, что память отшибет!» Мужчина хрипло посмеивается, отступая на шаг и растирая ушибленный бок — тайна кухни остаётся за дверью.'
        elseif $g = 'melissa':
            $HallHarassmentAfterText = $ct + ' с сальной усмешкой запускает ладонь под вызывающе короткий форменный подол Мелиссы — его огрубевшие пальцы сжимают нежную кожу абсолютно голой девичьей попки! По щекам Мелиссы разливается яркий румянец, однако книжница виртуозно держит удар: смерив мужчину насмешливым прищуром, она гибко выскальзывает из его пальцев. «Ваша дерзость, сударь, способна соперничать лишь с убожеством вашего кругозора», — чеканит она с филигранной иронией. За соседними лавками мужики жадно вытягивают шеи: «Видит Ильматер, у умницы под юбкой ни единой ниточки! Ай да трактир!»'
        else
            $HallHarassmentAfterText = $ct + ' пользуется суматохой и запускает широкую ладонь под лёгкий край платья Аманды, тут же сминая округлые, ничем не прикрытые девичьи ягодицы! Аманда вспыхивает пунцовым румянцем до корней волос: её аккуратная грудка взволнованно ходит ходуном под корсажем, а напряжённые сосочки рельефно очерчивают ткань. Судорожно прижимая круглый поднос к груди, девушка гибко выскальзывает из наглых пальцев, пряча горящее личико. Завсегдатаи одобрительно стучат кубками: «Глядите, да подавальщица-то совсем без исподнего порхает!»'
        end

    ! 3. Ситуация 1: Поднос с заказами (tray)
    elseif $b = 'tray':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = 'На кухне ' + $ct + ' пытается перехватить Сандру с горячим блюдом в руках. Сандра величаво опускает край тяжелого медного блюда прямо перед носом гостя, отсекая чужую руку: «Обжечься захотел, касатик? Чай не на гулянье, отойди от жаровни». Мужчина хмыкает и пятится к двери.'
        elseif $g = 'melissa':
            $HallHarassmentAfterText = 'Мелисса с безупречным хладнокровием удерживает поднос одной рукой, а свободным локтем ловко блокирует загребущие пальцы ' + $cg + '. Опустив кружку на стол со звонким стуком, она с прохладной иронией произносит: «Берегите пальцы, сударь, тяжелая оловянная посуда имеет обыкновение соскальзывать на руки неуклюжих гостей». Мужчина недовольно бурчит, убирая руки под стол, а Мелисса с царственной осанкой направляется к следующему заказу.'
        else
            $HallHarassmentAfterText = 'Аманда, балансируя с круглым подносом на весу, изящным поворотом корпуса уворачивается от цепких пальцев ' + $cg + '. Задорно фыркнув, она выставляет поднос как легкий щит, прикрывая свою аккуратную девичью грудь, где сквозь корсаж маняще проступают затвердевшие сосочки: «Эй, поосторожнее! Разольёте выпивку — будете сами мыть пол!» Зал дружно гогочет, а Аманда юрко упорхивает между лавками.'
        end

    ! 4. Ситуация 2: Лестница у стеллажа (ladder)
    elseif $b = 'ladder':
        if $HallHarassSubScene = 'on_face':
            if $g = 'melissa':
                $HallHarassmentAfterText = 'Соскользнув со ступеньки, Мелисса приземляется округлыми ягодицами прямо на лицо ошалевшего ' + $cg + ', сбивая того на лавку! Не теряя ледяного самообладания, она грациозно поднимается на ноги, расправляя короткую форму под оглушительный рев зала: «Надеюсь, сударь, осмотр архитектуры трактира завершён к вашему полнейшему удовлетворению? Дышите глубже». Размякший гость блаженно моргает, потирая нос.'
            else
                $HallHarassmentAfterText = 'Оступившись на ступеньке, Аманда с испуганным девичьим «ой!» соскальзывает вниз, шурша юбками, и приземляется аппетитными ягодицами прямо на физиономию заглядывавшего снизу ' + $cg + '! Зал взрывается гомерическим хохотом. Аманда, заливаясь пунцовым румянцем, быстро вскакивает на ножки, одёргивая подол платья обеими ручками: «Ой... простите, дяденька! Я же говорила — не стойте под лестницей!» Гость сидит ошарашенный и счастливый.'
            end
        else
            if $g = 'melissa':
                $HallHarassmentAfterText = 'Стоя на ступенях лестницы, Мелисса неторопливо снимает запыленную бутыль с полки. Одарив заглядывающего под юбку ' + $cg + ' взглядом полнейшего интеллектуального пренебрежения, она аккуратно наступает носком туфельки ему на пальцы у перекладины: «Внимание к деталям похвально, сударь, однако гравитация не прощает столь примитивного любопытства». Гость отдёргивает руку, а Мелисса с достоинством спускается вниз.'
            else
                $HallHarassmentAfterText = 'Аманда на ступеньках быстро переставляет кувшин, стараясь не потерять равновесие под масляным взглядом снизу. Когда ладонь ' + $cg + ' касается её щиколотки, девушка ловко сбегает на две ступеньки вниз и легко соскакивает на пол, одёргивая короткий подол: «Да пустите же, упаду ведь!» Одарив наглеца озорной улыбкой, она ускользает в шумный зал.'
            end
        end

    ! 5. Ситуация 3: Протирка стола (table_wipe)
    elseif $b = 'table_wipe':
        if $HallHarassSubScene = 'on_crotch':
            if $g = 'melissa':
                $HallHarassmentAfterText = 'Почувствовав за спиной хватку, Мелисса резко отталкивается ладонями от досок стола, выворачиваясь из объятий ' + $cg + ' в считанные мгновения до того, как ее прижали к его паху. Выпрямившись с безупречной осанкой, она холодно роняет: «Ваша пылкость опережает здравый смысл ровно на три столетия, сударь». Зал уважительно притихает.'
            else
                $HallHarassmentAfterText = 'Оказавшись на миг прижатой спиной к крепким бедрам гостя, Аманда сдавленно ахает, чувствуя его возбужденный напор. Ловко извернувшись у края скамьи, она бросает влажную тряпку на стол и гибко выскальзывает в проход, заливаясь ярким румянцем: «Ну всё, стол чистый, а мне бежать пора!» Мужики за столом весело подбадривают товарища.'
            end
        else
            if $g = 'melissa':
                $HallHarassmentAfterText = 'Закончив протирать стол, Мелисса неторопливо выпрямляется, плавным движением убирая бедра из-под тянущейся руки ' + $cg + '. Смерив наглеца насмешливым взглядом книжницы, она сухо бросает: «Столешница чиста, сударь. Вашим манерам, боюсь, столь быстрая очистка не грозит». По залу прокатываются смешки.'
            else
                $HallHarassmentAfterText = 'Выпрямившись над начищенным столом, Аманда в последний миг уворачивается от смачного шлепка по попке, игриво махнув перед носом гостя концом влажной тряпки: «Эй, любезный, руки к себе! А то тряпкой по носу схлопочете!» Соседи по столу дружно гогочут над сконфуженным приятелем.'
            end
        end

    ! 6. Ситуация 4: Проход / посадка на колени (lap_seat)
    elseif $b = 'lap_seat':
        if $g = 'melissa':
            $HallHarassmentAfterText = 'Оказавшись на коленях гостя, Мелисса не устраивает суматохи. Сохраняя царственное спокойствие, она кладёт ладонь на его запястье, мягко, но непреклонно сжимая пальцы, и соскальзывает на пол: «Аудиенция окончена, сударь. Закажите кувшин доброго вина и займите руки делом». Завсегдатаи с восхищением следят за каждым её движением.'
        else
            $HallHarassmentAfterText = 'Оказавшись на чужих коленях в тесном проходе, Аманда сердито дует губки и обеими ладошками упирается в мужскую грудь, сталкивая себя на ноги: «Да пустите же, дяденька, не до шуток мне, заказы ждут!» Мужик со смехом разжимает пальцы, а Аманда, поправляя легкое платьице на стройных бёдрах, юрко скрывается за стойкой.'
        end

    ! Дефолт
    else
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = 'У пышущей печи ' + $ct + ' не торопится отпускать Сандру — хозяйка с неподражаемым спокойствием выкручивается сама, огрев наглеца полотенцем и выставив за дверь.'
        else
            $HallHarassmentAfterText = $ct + ' не спешит разжимать объятия — ' + $RealName[$g] + ' ловко выскальзывает на свободу, вызывая новую волну одобрительного свиста и шуток среди гостей.'
        end
    end

    ! Пощёчина в исходе
    if HallHarassSceneSlap = 1 and $b <> 'play_tip':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>В воздухе гулко разносится звонкая, увесистая пощёчина! ' + $ct + ' ошарашенно пятится к выходу, потирая алеющую щёку, пока Сандра с горделивым достоинством одёргивает передник и как ни в чём не бывало возвращается к своему котлу.'
        elseif $g = 'amanda':
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Над шумом зала раздаётся звонкий, хлёсткий хлопок пощёчины! ' + $ct + ' ошалело моргает, хватаясь за пылающую щёку, а Аманда, с горящими от девичьей гордости глазами, спешно поправляет подол платья и с высоко поднятой головой ускользает к другим столам.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Хлёсткая пощёчина звучит сухо и четко, словно удар бича! ' + $ct + ' отшатывается в изумлении, а Мелисса с ледяным презрением отряхивает тонкие пальцы, поправляет вырез корсажа и с поистине царственным достоинством удаляется к стойке.'
        end
    end

    killvar '$g'
    killvar '$b'
    killvar '$ct'
    killvar '$cg'
    killvar '$ci'
    killvar 'HallHarassAfterKitchen'
    killvar '$HallHarassAfterClientTag'
    killvar '$HallHarassAfterClientGen'
    killvar '$HallHarassAfterClientIns'
---

#HallHarassAfterIgnoreFromBeat
    gs 'HallHarassAfterClientBits'
    $g = $HallHarassGirl
    $b = $HallHarassSceneBeat
    $ct = $HallHarassAfterClientTag
    $cg = $HallHarassAfterClientGen
    $HallHarassmentAfterText = ''
    HallHarassAfterKitchen = 0
    if $HallHarassConsequenceArea = 'kitchen' or $HallHarassJob = 'kitchen' or $g = 'sandra':
        HallHarassAfterKitchen = 1
    end

    if HallHarassAfterKitchen = 1:
        $HallHarassmentAfterText = 'Вы нарочно остаётесь стоять за дубовой стойкой зала, всем своим безучастным видом показывая, будто происходящее на кухне вас нисколько не заботит. Густой шум зала смешивается со звуками из кухонного проёма: за тяжелой приоткрытой дверью не видно лиц, и о развернувшейся там стычке остаётся судить лишь по шорохам, звону утвари и приглушенным голосам.'
    else
        $HallHarassmentAfterText = 'Вы подчеркнуто хладнокровно отворачиваетесь к стойке, неторопливо переставляя глиняные кувшины и делая вид, будто всецело поглощены хозяйскими хлопотами. Взглядом вы не прикасаетесь к развернувшейся сцене — но слух, обострённый до предела, чутко ловит каждую интонацию, каждый шорох одежды и скрип лавок за вашей спиной.'
    end
    $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>'

    if $b = 'play_tip':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Мягкий, сдержанный женский смешок с кухни, звонкий щелчок полновесной серебряной монеты о край стола и довольное хмыканье ' + $cg + '. Торг окончен миром, а звонкое серебро надежно осело в кармане хозяйки.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Тихий, кокетливый девичий смех за спиной, отчетливый перестук звонких монет о столешницу и одобрительный гомон захмелевшей компании: девушка мастерски обернула мужскую похоть в звонкую монету.'
        end
    elseif $b = 'hand_bare':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Из-за кухонной двери доносится прерывистый шелест поднимаемого подола, хриплый смешок ' + $cg + ' и строгий голос Сандры: «Руки убрал, охальник, пока половник в ход не пустила!» Слышится звон медной крышки и тяжелые, поспешные шаги гостя, остудившего пыл.'
        elseif $g = 'amanda':
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'За спиной шуршит тонкий подол холщового платья, раздаётся жадный мужской вздох ' + $cg + ' и смущённое девичье ойканье. Зал взрывается сальным шёпотом завсегдатаев: «Ильматер всеблагой... да у подавальщицы под юбкой ни единой нитки!» Глухой стук деревянного подноса и торопливые шаги возвещают, что Аманда юрко выскользнула из цепких пальцев.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Сзади слышится шорох задираемой юбки, победный гогот ' + $cg + ' и ледяное, острое шипение Мелиссы: «Уберите руки немедленно, сударь, если вам дороги ваши пальцы». По залу прокатывается восторженный свист: «Гляньте-ка, умница-книжница совсем без исподнего!» — после чего раздается четкий перестук каблучков сестры, разорвавшей дистанцию.'
        end
    elseif $b = 'tray':
        $HallHarassmentAfterText = $HallHarassmentAfterText + 'Глухой звон оловянных кружек на подносе, предостерегающий девичий возглас, скрип скамьи и торопливый шелест юбок: ловкий уворот с полным заказом на весу увенчался успехом.'
    elseif $b = 'ladder':
        if $HallHarassSubScene = 'on_face':
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Скрип ступеней, приглушенный вскрик, внезапный грохот покатившейся скамьи и сдавленное мужское мычание, потонувшее в гомерическом хохоте всего зала! Следом звучат быстрые шаги вскочившей на ноги девушки.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + 'Скрип деревянных ступеней приставной лестницы, звон стекла, масленый свист снизу и сухое постукивание каблучков, быстро сбегающих на пол под одобрительный гул зала.'
        end
    elseif $b = 'table_wipe':
        $HallHarassmentAfterText = $HallHarassmentAfterText + 'Влажный шлепок тряпки по дубовым доскам стола, скрип сдвинутой лавки, нетерпеливое кряхтение гостя и звонкий стук деревянного подноса, остудившего наглеца.'
    elseif $b = 'lap_seat':
        $HallHarassmentAfterText = $HallHarassmentAfterText + 'Тяжелый скрип дубовой скамьи, хмельной мужской бас, шорох сминаемого платья и решительное: «Пустите, работать надо!» — после чего легкие шаги девушки торопливо удаляются в сторону раздачи.'
    else
        $HallHarassmentAfterText = $HallHarassmentAfterText + 'Хмельные шутки ' + $cg + ', шорох примятой ткани, приглушенный девичий голос и звон глиняной посуды.'
    end

    if HallHarassSceneSlap = 1 and $b <> 'play_tip':
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Следом с кухни раздаётся звонкий звук полновесной пощёчины! Слышны ошарашенные ругательства гостя, тяжелый топот пятившихся в зал сапог и мерный, невозмутимый стук кухонного ножа о разделочную доску.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Над шумом трактира гремит сухой, хлесткий хлопок пощёчины! Зал изумленно ахает, после чего разражается дружным гоготом над сконфуженным наглецом, а быстрые девичьи шаги возвещают о том, что границы восстановлены.'
        end
    else
        if HallHarassAfterKitchen = 1:
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Скрипит тяжелая кухонная дверь, гость сконфуженно возвращается за свой стол в зале, а с кухни вновь доносится мерное побулькивание похлёбки.'
        else
            $HallHarassmentAfterText = $HallHarassmentAfterText + '<br><br>Шаги отдаляются, и зал трактира вновь погружается в привычный разноголосый хмельной гул.'
        end
    end

    killvar '$g'
    killvar '$b'
    killvar '$ct'
    killvar '$cg'
    killvar 'HallHarassAfterKitchen'
    killvar '$HallHarassAfterClientTag'
    killvar '$HallHarassAfterClientGen'
    killvar '$HallHarassAfterClientIns'
---
