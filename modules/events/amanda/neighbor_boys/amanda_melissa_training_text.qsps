! ================================================
! FILE: modules/events/amanda/neighbor_boys/amanda_melissa_training_text.qsps
! MODULE: events/amanda/neighbor_boys
! [AI-WORKED] Текст переработан / дополнен ассистентом 17.09.2026
! USER-OWNED TEXT
! Тексты ночных разговоров и тренировок Аманды и Мелиссы (сцены в два экрана):
! - talk1: предварительный визит (отказ Мелиссы)
! - talk2: предварительный визит (уговоры Аманды, согласие на подготовку)
! - visit1: визит 1 (Экран 1: Аманда / Экран 2: Мелисса)
! - visit2: визит 2 (Экран 1: Аманда / Экран 2: Мелисса + квест на масло)
! - visit3: визит 3 (Экран 1: Аманда / Экран 2: Мелисса + сговор на 4 этап)
! - visit4: визит 4 (Экран 1: Аманда / Экран 2: Мелисса + финал)
!
! Визуальные ассеты:
! images/events/amanda/amanda_events/amanda_neighbor_boys_action — Аманда и Мелисса ночью
! ================================================

#AmandaMelissaNightTrainingText
    $Step = $ARGS[0]
    Screen = ARGS[1]
    if Screen = 0: Screen = 1

    if $Step = 'talk1':
        *pl 'Ночной коридор второго этажа залит лунным светом. Вы бесшумно ступаете по половицам и замираете у приоткрытой двери Мелиссы.'
        *pl 'Внутри горит тусклая масляная лампа. Аманда сидит на краю кровати сестры в одной ночной сорочке, нервно комкая край ткани на коленях.'
        *pl 'Мелисса сидит за столом над раскрытым фолиантом, поверх очков строго и с крайним изумлением глядя на младшую сестру:'
        *pl '— ...Ты в своём уме, Аманда?! — потрясённо выдыхает Мелисса, откладывая перо. — Два члена одновременно в твою писечку?! Да ещё и подмастерье кузнеца Питер с огромным хуищем?! Ты что, вообще удержу не знаешь, с половиной города намерилась перетрахаться?!'
        *pl '— Мелисса, ну не кричи ты, мама услышит... — испуганно шепчет Аманда, густо краснея до самых кончиков ушей. — Они ссорятся постоянно, кто первый, придумывают всякое, да и нравятся они мне... А Питер огромный, и добрый — жалко его! Я испугалась, отказала им всем. Но сама всё думаю и думаю, у меня прям течёт от мыслей об этом, пиво несу, а у меня под юбкой хлюпает, клиенты скалятся и слюни пускают... Ты ведь столько умных книг прочитала! Помоги мне, подскажи, как такое сделать!'
        *pl 'Мелисса с грохотом захлопывает книгу и вскакивает из-за стола, уперев руки в бока:'
        *pl '— Видит Ильматер, это уже за гранью — хлюпает у неё! Иди дай кому-нибудь, и пройдёт. Я не собираюсь потакать твоим диким выходкам! Тебе пизду порвут, кому ты будешь нужна! А ну марш к себе в комнату, пока я матушке всё не рассказала! И думать забудь!'
        *pl 'Аманда прячет лицо в ладонях и, понурив голову, выбегает в коридор. Вы едва успеваете отступить в тень лестницы.'

    elseif $Step = 'talk2':
        *pl 'Спустя пару ночей в коридоре снова слышатся осторожные шаги — Аманда опять пробирается в комнату Мелиссы.'
        *pl 'Прильнув к дверной щели, вы видите, что на этот раз младшая сестра держится куда решительнее.'
        *pl '— Мелисса, ну выслушай меня, пожалуйста, — настойчиво шепчет Аманда, подходя к сестре. — Я же не просто так прошу! Парни не отстанут, да и мне самой покоя нет... Я пробовала с Питером, но он слишком огромен! Пожалуйста! Ты ведь читала всякие книжки по медицине. Если ты мне не поможешь и не научишь — я им так дам, и будь что будет!'
        *pl 'Мелисса замирает, поражённая смелостью и искренностью сестры. В её взгляде сквозь строгую маску пробивается научное любопытство и исследовательский азарт всезнайки:'
        *pl '— Ильматер всеблагой... ты действительно не остановишься, — медленно произносит Мелисса. — Ладно... Чем ты позволишь этим жеребцам изувечить себя, лучше я лично подготовлю тебя по одной замечательной книге.'
        *pl '— Правда?! Мелисса, милая, спасибо! — Аманда с горячей радостью тянется обнять сестру.'
        *pl '— Тихо, не шуми! — строго осаживает её Мелисса. — Но ставлю жёсткое условие: делаем всё как в книжке написано и под моим полным контролем! Подготовка будет проходить поэтапно, будешь ко мне ходить: начнём с малого — пальцы, расслабление, придание эластичности. Никакой самодеятельности! Придёшь через пару ночей — начнём первый этап.'
        *pl 'Аманда с облегчением кивает. Вы тихо отступаете от двери обратно в свою комнату, поражённый сговором сестёр.'

    elseif $Step = 'visit1':
        if Screen = 1:
            ! ЭКРАН 1: Аманда
            *pl 'Ночью в коридоре снова раздаётся скрип половиц — Аманда приходит в комнату Мелиссы на первый урок обещанной подготовки.'
            *pl 'Младшая сестра смущённо скидывает ночную сорочку и ложится на постель, разводя белые стройные бёдра.'
            *pl 'Мелисса достаёт глиняную баночку с травяным маслом, садится между её колен и растирает масло в ладонях:'
            *pl '— Как мы и договаривались: первый этап — три пальца. Никакой самодеятельности, слушай моё дыхание. Сделай глубокий вдох животом и на выдохе полностью расслабь тазовый пояс.'
            *pl 'Мелисса медленно погружает три пальца во влажное лоно Аманды. Младшая сестра судорожно охает, пальцы впиваются в простыню.'
            *pl '— Дыши, не зажимайся, — строго командует Мелисса, плавно двигая пальцами внутри и растягивая стенки по кругу. — Чувствуешь? Мышцы привыкают к натяжению, спазм уходит.'
            *pl 'Плавные круговые движения пальцев Мелиссы натягивают нежные девичьи ткани, разжигая внизу живота горячий пульсирующий огонь. Аманда сладостно всхлипывает, выгибая спину дугой:'
            *pl '— Ох-х... Мелисса... как хорошо... я... я сейчас кончу!..'
            *pl 'Внезапная сладкая судорога сотрясает всё тело младшей сестры — Аманда стонет в голос, бурно и сладостно оргазмируя на пальцах сестры.'
            *pl 'Мелисса аккуратно извлекает пальцы, довольно оглядывая запыхавшуюся девушку.'
        else:
            ! ЭКРАН 2: Мелисса
            *pl 'Едва переведя дух, Аманда с горящими глазами тянет Мелиссу за руку к себе:'
            *pl '— Ох, Мелисса... это невероятно! Спасибо тебе! Теперь моя очередь тебя отблагодарить!'
            *pl 'Не слушая слабых возражений, Аманда проворно задирает сорочку сестры, раздвигает её бёдра и опускается лицом прямо между её стройных ножек. Её горячий язычок начинает жадно вылизывать сочащуюся киску Мелиссы, упиваясь её вкусом и дразня набухший бугорок клитора.'
            *pl '— Аманда... ах!.. Что ты... перестань... о-ох! — Мелисса пытается отстраниться, но уже через секунду пальцы её впиваются в волосы сестры, бёдра начинают жадно двигаться навстречу языку, и Мелисса громко стонет, сотрясаясь в бурном оргазме.'
            *pl 'Мелисса тяжело переводит дыхание, поправляя растрёпанные волосы:'
            *pl '— Вот Аманда, ты нимфоманка! Ладно, на первый раз достаточно... Тканям нужно время адаптироваться и отдохнуть. Придёшь через пару ночей на второй этап. И да, спасибо, мне понравилось тоже.'
            *pl 'Вы тихо отступаете от двери обратно в спальню, взбудораженный увиденным уроком.'
        end

    elseif $Step = 'visit2':
        if Screen = 1:
            ! ЭКРАН 1: Аманда
            *pl 'Спустя пару ночей вы снова слышите осторожные шаги — Аманда опять пробирается в комнату Мелиссы на второй урок.'
            *pl 'Младшая сестра уже без лишних слов скидывает сорочку и ложится на постель, широко разводя бёдра.'
            *pl '— Мышцы не болят после прошлого раза? — деловито спрашивает Мелисса, поправляя очки.'
            *pl '— Нет... наоборот, всё горит и ноет, как будто просит ещё, — смущённо признаётся Аманда.'
            *pl '— Хорошо. Переходим ко второму этапу: четыре пальца лодочкой. И добавим прямую стимуляцию клитора языком, чтобы проверить растяжку при максимальном возбуждении.'
            *pl 'Мелисса обильно смазывает ладонь травяным маслом, складывает четыре пальца плотной лодочкой и начинает медленно проталкивать их вглубь девичьего лона, одновременно прижимаясь горячим языком к набухшему клитору Аманды.'
            *pl 'Аманда прикусывает край подушки, неистово стонет от дикой распирающей полноты: четыре пальца плотно распирают девичье нутро, а влажный язык сестры кружит по клитору, взвинчивая наслаждение до небес.'
            *pl 'Тело Аманды натягивается струной, и оглушительный оргазм сотрясает её до кончиков пальцев, заставляя судорожно сжимать бёдрами руку Мелиссы.'
        else:
            ! ЭКРАН 2: Мелисса
            *pl 'Едва придя в себя, Аманда с плутовской улыбкой переворачивает сестру на бочок:'
            *pl '— Теперь моя благодарность, сестрёнка... Дай-ка я проверю, что ты любишь больше всего!'
            *pl 'Аманда начинает ласково вылизывать мокрую киску Мелиссы, а затем, обильно смазав свои тонкие пальчики слюной и маслом, осторожно касается плотного сжатого колечка ануса сестры и аккуратно проталкивает пальчик внутрь.'
            *pl 'Мелисса издаёт прерывистый судорожный вздох — от ласки в попке по её телу пробегает обжигающая волна! Аманда чувствует, как бешено трепещет её колечко, и добавляет второй пальчик, двигая ими в тугом анусе и продолжая вылизывать киску.'
            *pl 'Необычайная, острая чувствительность попки заставляет Мелиссу содрогаться всем телом: она яростно вскрикивает в простыни и бьётся в сильнейшем оргазме, сжимая кулаки.'
            *pl 'Когда страсти утихают, Мелисса извлекает пальцы Аманды из своей попки и озабоченно хмурит брови:'
            *pl '— Четыре пальца твоя пещерка принимает. Но дальше травяным маслом не обойтись.'
            *pl '— Почему, Мелисса?! — пугается Аманда.'
            *pl '— Потому что для двоих сразу — или чтобы принять, как ты говоришь, молот кузнеца Питера — нужен целый кулак! А обычные травяные масла исчерпали свой предел: если я сейчас попытаюсь ввести кулак, ты можешь порваться!'
            *pl '— И что же делать?!'
            *pl '— В той книжке описано особое <b>масло из Диких земель</b>. Его варят степные знахари из редких трав. Это масло проникает в глубокие волокна и делает их сверхэластичными, податливыми, как шёлк. С ним кулак войдёт легко. Так что пока не достанешь масло — тренировки остановлены, а к парням и Питеру даже близко не подходи!'
            *pl 'Аманда в отчаянии роняет голову на подушку. Стоя за дверью, вы понимаете: достать редкое масло предстоит именно вам.'
        end

    elseif $Step = 'visit3':
        if Screen = 1:
            ! ЭКРАН 1: Аманда
            *pl 'Ночью в комнате Мелиссы снова горит масляная лампа. Заветный флакон с маслом из Диких земель уже доставлен.'
            *pl 'Прильнув к замочной скважине, вы видите, как Мелисса держит пузырёк из тёмного стекла, изучая янтарную жидкость:'
            *pl '— Настоящее масло из Диких земель! Густое, пахнет степным вереском и терпкими травами. С ним твоя писька станет мягкой, как воск!'
            *pl 'Аманда уже лежит на постели, широко раскинув стройные ноги. Мелисса обильно наносит масло на ладонь и тщательно втирает его в раскрывшиеся лепестки и внутренние стенки сестры. Ткани мгновенно теплеют и расслабляются.'
            *pl 'Мелисса собирает ладонь в кулачок: «Самый глубокий вдох... медленный выдох... расслабляйся!»'
            *pl 'Мелисса приставляет костяшки к входу и начинает плавно подавать руку вперёд. Под действием чудодейственного масла ткани растягиваются невероятно мягко, кулак Мелиссы полностью погружается в девичье лоно, а её язык одновременно опускается на набухший клитор сестры!'
            *pl 'Аманда кричит от дикого восторга, чувствуя колоссальное, ни с чем не сравнимое распирание, и бьётся в сладкой судороге сокрушительного оргазма!'
        else:
            ! ЭКРАН 2: Мелисса
            *pl 'Обессиленная, но сияющая от счастья Аманда целует сестру: поняв, что самое чувствительное место Мелиссы — её анус, Аманда с озорным блеском в глазах укладывает её на животик:'
            *pl '— Теперь твоя очередь наслаждаться, моя строгая наставница!'
            *pl 'Аманда начинает трепетно вылизывать тугой анус сестры языком, делая страстный анилингус, а затем наносит масло и запускает в её попку уже три пальчика, плавно растягивая тугие стенки.'
            *pl 'Мелисса задыхается от накатившего безумного восторга, стонет на всю комнату и содрогается в мощнейшем оргазме, выгибая бёдра навстречу ласкам.'
            *pl 'Придя в себя, Аманда с восторгом шепчет:'
            *pl '— Мелисса... а давай в следующий раз используем это масло из Диких земель на твоей попке по-настоящему?!'
            *pl 'Мелисса, зардевшись и поправляя очки, с трудом сдерживает ответный азарт:'
            *pl '— Договорились... Но и с тобой мы ещё не закончили! Чтобы Питера принять нормально, надо не только вширь, но и в глубину маслом обработать — а то пока вход обработали, а внутренности не привыкли к длине! Хорошо, что масло уникальное: киска растягивается под нажимом, а потом собирается обратно. В следующий визит сделаем четвёртый, финальный этап!'
            *pl 'Сёстры сговариваются о решающей ночи, а вы бесшумно отступаете в коридор.'
        end

    elseif $Step = 'visit4':
        if Screen = 1:
            ! ЭКРАН 1: Аманда
            *pl 'Ночью в комнате Мелиссы разворачивается финальное испытание.'
            *pl 'Аманда лежит на спине, широко раскинув стройные ножки навстречу сестре. Мелисса обильно смазывает ладонь и предплечье чудодейственным маслом из Диких земель.'
            *pl '— Дыши ровно и глубоко, Аманда. Сейчас мы идём на полную глубину.'
            *pl 'Сложив ладонь плотным клином, Мелисса медленно и уверенно погружает всю кисть в податливое лоно сестры, проталкивая руку всё дальше и глубже в девичье нутро.'
            *pl 'Аманда судорожно выдыхает, запрокинув голову — рука Мелиссы уходит почти по самое предплечье! <b>Сквозь гладкую белую кожу девичьего животика Аманды отчётливо проступает выпуклый бугорок от движений ладони сестры!</b>'
            *pl 'Мелисса удерживает руку на предельной глубине, приучая влагалище к предельному натяжению, а затем плавно извлекает руку и снова погружает её до упора несколькими мощными, скользящими движениями.'
            *pl 'Неземная полнота и глубочайшая стимуляция взрывают сознание Аманды: девушка истошно кричит в восторге, её бёдра сводит судорога, и мощнейший оргазм вырывается обильным сквиртом, щедро заливая простыни и руку сестры!'
        else:
            ! ЭКРАН 2: Мелисса
            *pl 'Аманда обессиленно оседает на подушки, тяжело дыша, но на её лице сияет победная улыбка:'
            *pl '— О-ох... Ильматер всеблагой... Я как заново родилась... А теперь — твоя очередь, моя всезнающая сестрёнка!'
            *pl 'Мелисса, пылая щеками от возбуждения, встаёт на колени на постели и припадает грудью к подушкам, выставив свои аппетитные белые ягодицы.'
            *pl 'Аманда щедро наносит масло из Диких земель на попку сестры. Медленно, дразняще она погружает пальчики в её тугой анус один за другим: один... два... три... четыре!'
            *pl 'Мелисса громко и протяжно стонет, впиваясь пальцами в постель: под воздействием редкого масла её плотное колечко становится податливым и эластичным, как мёд!'
            *pl 'Не останавливаясь, Аманда складывает ладонь конусом и уверенным, мягким нажимом погружает всю кисть в узкую попку сестры!'
            *pl 'От такого развратного, невероятного заполнения у Мелиссы пропадает голос: её тело выгибается струной, истошный крик наслаждения сотрясает комнату, и сокрушительный экстаз накрывает её с головой — Мелисса бьётся в неистовом оргазме, изливаясь обильным, фонтанирующим сквиртом на мокрые простыни!'
            *pl 'Обе сестры в сладком изнеможении падают в объятия друг друга, прижимаясь разгорячёнными телами и тихо смеясь от пережитого восторга.'
            *pl '— Теперь твоё влагалище и мой анус так разработаны, что любой член принять могут, хоть с конём трахайся, хоть с драконом, — шепчет Мелисса.'
            *pl '— Ага, — кивает Аманда. — Надо будет попробовать наоборот, и тогда наши дырочки будут готовы к чему угодно!'
            *pl 'Вы бесшумно отступаете от двери: все барьеры сняты раз и навсегда! Тело Аманды подготовлено к любым размерам богатыря Питера и к одновременному приёму обоих братьев-погодок.'
        end
    end

    killvar '$Step'
    killvar 'Screen'
---
