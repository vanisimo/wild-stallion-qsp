! ================================================
! FILE: modules/events/amanda/neighbor_boys/amanda_boys_giant_text.qsps
! MODULE: events/amanda/neighbor_boys
! [AI-WORKED] Текст переработан / дополнен ассистентом 17.09.2026
! USER-OWNED TEXT
! Тексты ветки Питера (кузнец-великан)
!
! Визуальные ассеты:
! images/events/amanda/amanda_events/amanda_neighbor_boys_event — Питер и Аманда за сараем
! images/events/amanda/amanda_events/amanda_neighbor_boys_action — Исход встречи с кузнецом
! ================================================

#AmandaBoyGiantEventText
    $Step = $ARGS[0]

    if $Step = 'early_fear':
        *pl 'У поленницы за сараем возвышается могучая фигура Питера — рослого молотобойца из кузницы на краю слободки.'
        *pl 'Питер широко ухмыляется, подперев бока закопчёнными ручищами, и настойчиво прижимает хрупкую Аманду к штабелю брёвен.'
        *pl 'Сестра испуганно вжимается в дерево, не сводя взгляда с того, как кузнец распускает поясной ремень и неторопливо извлекает наружу своё чудовищное мужское достоинство — тяжёлое, толстое, словно кузнечный боёк.'
        *pl 'Лицо Аманды мгновенно белеет: она в ужасе закрывает рот ладошкой, явно не ожидая увидеть столь внушительные размеры.'

    elseif $Step = 'stage1_ready':
        *pl 'Питер снова караулит Аманду у дровяника, не скрывая жадного блеска в глазах.'
        *pl 'Однако на сей раз сестра не шарахается прочь: хоть её щёки и полыхают ярким девичьим румянцем, она с тайным вожделением и волнением разглядывает исполинский член кузнеца.'
        *pl '— Только попробуй полезть внутрь — укушу! — нервно шепчет она, закусив губу. — Сперва снаружи... оботрись аккуратно, а то я тебя знаю, медведя!'
        *pl 'Кузнец довольно басит и послушно кивает, готовый довольствоваться внешними ласками.'

    elseif $Step = 'stage1_repeat':
        *pl 'Аманда встречает Питера у поленницы уже без тени прежней робости.'
        *pl 'Она с озорной, плутовской улыбкой разглядывает его богатырскую фигуру и уверенно шагает навстречу:'
        *pl '— Ну что, соскучился, верзила? — тихо смеётся сестра, поправляя фартук. — Расстёгивай портки... Только внутрь пока рано, погрей меня снаружи, как в прошлый раз — больно уж сладко у тебя выходит.'
        *pl 'Кузнец довольно скалится, предвкушая горячие ласки.'

    elseif $Step = 'stage2_ready':
        *pl 'В полумраке сарая Аманда уже без долгих уговоров стоит перед кузнецом, слегка опёршись о борт телеги.'
        *pl 'Её подол подобран, дыхание прерывистое и горячее. Питер бережно, насколько способны его мозолистые ладони, придерживает девушку за бёдра, примериваясь широкой головкой к её влажному лону.'
        *pl '— Медленно, Питер... только чуть-чуть... — сдавленно молит сестра, жмурясь от накатывающего трепета.'

    elseif $Step = 'stage2_repeat':
        *pl 'В сарае Аманда сама уверенно ведёт Питера к телеге, повиливая бёдрами.'
        *pl 'Её взгляд горит нетерпеливым огнём, на губах играет дерзкая усмешка:'
        *pl '— Помнишь наш уговор? — шепчет сестра, закидывая подол и подставляя разгорячённое лоно. — Не спеши, дай мне самой насадиться на вершок... Твоя треть — это как у других целиком, медведь ты эдакий, но моё тело уже помнит эту тяжесть.'
        *pl 'Питер хрипло дышит, жадно придерживая её за талию.'

    elseif $Step = 'stage3_ready':
        *pl 'За сараем на душистом сене развернулась сцена полной капитуляции.'
        *pl 'Аманда больше не осторожничает и не ставит условий: она жадно подаётся всем телом навстречу могучему молотобойцу, готовая принять его целиком.'
        *pl 'Её пальцы впиваются в широкие плечи кузнеца, а глаза затуманены неистовым восторгом покорения перед грубой силой.'

    elseif $Step = 'stage3_repeat':
        *pl 'В полумраке сарая на мягком плаще Аманда встречает кузнеца уже как опытная, уверенная госпожа его богатырской мощи.'
        *pl 'Она не ждёт уговоров и не боится чудовищных размеров: с дерзкой, пьянящей улыбкой сестра сбрасывает передник и широко распахивает бёдра навстречу великану:'
        *pl '— Ну давай, мой кузнец, вбивай свой молот до упора — сегодня я не выпущу тебя, пока не зальёшь меня до самых краёв!'
    end

    killvar '$Step'
---

#AmandaBoyGiantActionText
    $Choice = $ARGS[0]
    $Step = $ARGS[1]
    GiantScreen = $ARGS[2]

    if $Choice = 'send_away':
        *pl 'Вы решительно выходите из-за угла и рявкаете на весь двор:'
        *pl '— А ну прочь отсюда, кузнец! Забыл, где твоя наковальня стоит?!'
        *pl 'Питер недовольно хмурится, смерив вас тяжёлым взглядом из-под насупленных бровей, но связываться с хозяином трактира не решается — молча заправляет исполинский ствол в штаны и тяжело уходит со двора.'
        *pl 'Аманда шумно переводит дух, поправляя подол, но бросает в вашу сторону досадливый взгляд.'

    elseif $Choice = 'ask':
        *pl 'Вы подходите к сестре, когда Питер нехотя ретируется в проулок:'
        *pl '— И давно ты водишь дружбу с кузнечными подмастерьями, Аманда?'
        *pl 'Сестра густо краснеет, теребя тесёмки фартука:'
        *pl '— Мы просто разговаривали, Стефан! Ничего такого... Он просто забавный и сильный, вот и всё!'

    elseif $Choice = 'watch':
        if $Step = 'early_fear':
            if oralacts['amanda'] >= 5:
                if GiantScreen = 1:
                    *pl 'Вы затаились в тени поленницы, наблюдая за происходящим.'
                    *pl 'Аманда испуганно качает головой, пятится от наступающего Питера и горячо шепчет:'
                    *pl '— Нет, Питер, даже не проси! Туда — ни за что, ты же меня просто разорвёшь!'
                    *pl 'Она опускается на колени прямо в сухую траву, примирительно глядя на кузнеца снизу вверх:'
                    *pl '— Давай... давай я лучше ротиком тебе помогу, ладно? Только будь смирным и не вздумай давить!'
                    *pl 'Дрожащими пальчиками она обхватывает толстый горячий ствол кузнеца.'
                    if oraldeep['amanda'] > 0 or oralacts['amanda'] >= 7:
                        *pl 'Девушка широко растягивает губы и ловко, без малейшего кашля заглатывает массивную головку, уверенно совершая плавные движения вверх и вниз.'
                    else:
                        *pl 'Она с трудом растягивает девичьи губы, несмело оглаживая языком налитую головку и тихо покашливая от рвотного позыва, едва ствол погружается чуть глубже.'
                    end
                else:
                    *pl 'Питер с хриплым урчанием запрокидывает голову, впиваясь широкими ладонями в её хрупкие плечи.'
                    *pl 'Его бёдра мелко вздрагивают, и мощный толчок выстреливает густую горячую струю семени прямо Аманде на язык и щёки.'
                    *pl 'Девушка судорожно сглатывает обильную порцию, тщательно слизывает остатки с массивной головки и утирает подбородок кружевным платочком, тяжело переводя дыхание.'
                    *pl 'Кузнец заправляет обмякший уд в штаны и довольно уходит, а сестра с пылающим лицом спешит на кухню.'
                end
            else:
                *pl 'Вы наблюдаете, как Аманда в панике вскрикивает, едва Питер делает шаг к ней навстречу:'
                *pl '— О Ильматер! Ты сумасшедший! Уйди от меня!'
                *pl 'Не дав опешившему кузнецу опомниться, сестра проворно выскальзывает у него под рукой и со всех ног бросается к спасительной кухонной двери, оставив парня в одиночестве запахивать портки.'
            end

        elseif $Step = 'stage1_ready':
            if GiantScreen = 1:
                *pl 'Сквозь щели забора вы следите за необычным действом.'
                *pl 'Питер осторожно прижимает Аманду к дощатой стене поленницы. Девушка послушно раздвигает колени, но строго держит уговор: внутрь не пускает.'
                *pl 'Кузнец упирается массивной багровой головкой во влажные половые губы сестры и начинает размеренно, с тяжёлым нажимом тереться о её сочащуюся смазкой девичью щёлочку.'
                *pl 'От густого горячего трения и непривычной чудовищной тяжести Аманда сладко стонет, зажмурив глаза и судорожно сминая пальцами ткань его рубахи.'
            else:
                *pl 'Кузнец взвинчивает темп, его дыхание сбивается на хриплый бас.'
                *pl 'С яростным глухим стоном он прижимает пульсирующий ствол к её лобку и мощными толчками изливает густое семя прямо ей на бёдра и подол платья.'
                *pl 'Аманда облегчённо выдыхает, сползая по брёвнам и глядя на стекающие белые струи: первая проба сил окончилась победой, и порочный азарт всё сильнее туманит ей голову.'
            end

        elseif $Step = 'stage1_repeat':
            if GiantScreen = 1:
                *pl 'Вы наблюдаете, как за сараем разворачивается уже привычная игра страсти.'
                *pl 'Аманда сама задирает юбку и прижимается спиной к тёплым брёвнам поленницы. Никакого страха больше нет: своими пальчиками она направляет исполинский ствол Питера прямо в ложбинку между своих разгорячённых бёдер.'
                *pl 'Кузнец мерно и жарко скользит тяжёлой головкой по её обильно сочащимся половым губам. Аманда сладострастно выгибает спину, притираясь лобком к его пульсирующей плоти, и громко стонет на весь двор, наслаждаясь грубым и мощным трением.'
            else:
                *pl 'Питер яростно рычит, ускоряя фрикции до предела, и с силой прижимает свой ствол к её лону.'
                *pl 'Обильный горячий поток семени щедро заливает низ девичьего живота и её гладкие бёдра. Аманда с томной улыбкой проводит ладонью по белым струям, слизывает каплю с пальца и озорно подмигивает кузнецу — внешних ласк её жадному телу уже явно мало.'
            end

        elseif $Step = 'stage2_ready':
            if GiantScreen = 1:
                *pl 'Притаившись за бочками, вы наблюдаете за осторожной пробой сил в сарае.'
                *pl 'Аманда полулежит на мягком сене, разведя стройные ножки. Кузнец нависает сверху, бережно придерживая её за бёдра своими ручищами.'
                *pl 'Обильно смазав головку слюной, Питер приставляет её к нежному лону сестры и медленно, с неодолимой силой продавливает вход.'
                *pl 'Девичьи стенки натягиваются до предела вокруг исполинской плоти. Аманда жалобно, сладострастно всхлипывает, впиваясь ногтями в солому:'
                *pl '— Ох-х... какой огромный... Питер, замри, дай привыкнуть!..'
                *pl 'Кузнец послушно замирает, сдерживая порыв и погрузив ствол лишь на треть его невероятной длины, пока её ткани постепенно растягиваются.'
            else:
                *pl 'Убедившись, что Аманда перестала сжиматься от боли, Питер делает лишь короткие, плавные толчки на треть длины, бережно приучая её лоно к своей небывалой мощи.'
                *pl 'Не сдержав нахлынувшей страсти, молотобоец с глухим стоном кончает, изливая горячую сперму во вход её лона.'
                *pl 'Когда он медленно извлекает ствол, Аманда тяжело выдыхает. <b>Её девичья щёлочка припухла и остаётся раскрытой, заметно растянутой круглой пещеркой</b>, из которой медленно сочится сперма. Сестра осторожно трогает <b>напрягшийся низ живота</b>, поражённая тем, что её тело сумело вместить хотя бы треть этого гиганта.'
            end

        elseif $Step = 'stage2_repeat':
            if GiantScreen = 1:
                *pl 'Сквозь дверную щель вам открывается вид на уверенную и смелую любовную игру.'
                *pl 'Аманда сама усаживается на край телеги и широко разводит стройные бёдра. Она ловко направляет толстый уд Питера во вход своего лона.'
                *pl 'Кузнец уверенно входит на треть длины. Теперь сестра не молит о пощаде — её разработанные ткани эластично и мягко принимают чудовищную толщину! Аманда сама двигает бёдрами навстречу каждому удару, жадно постанывая и требуя прижиматься ещё плотнее.'
            else:
                *pl 'Кузнец взвинчивает темп и с хриплым басовым стоном изливает порцию кипящего семени в глубину входа.'
                *pl 'Когда Питер плавно вытягивает уд наружу, взгляду предстаёт возбуждающая картина:'
                *pl '<b>Раскрытая после акта щёлочка Аманды остаётся зияющей и влажной</b>, не смыкаясь сразу от привычной растяжки, и густые белые капли спермы сочатся из неё на солому. <b>Низ девичьего животика слегка округлился и потеплел</b> от глубоких толчков. Аманда оглаживает себя между бёдер с гордой улыбкой — её тело уже готово принять исполина целиком.'
            end

        elseif $Step = 'stage3_ready':
            if GiantScreen = 1:
                *pl 'Вы смотрите на настоящий триумф девичьей ненасытности.'
                *pl 'На куче душистого сена Аманда широко распахивает бёдра навстречу великану. Никаких полумер больше нет: она готова принять молотобойца на всю глубину.'
                *pl 'Питер упирается головкой во вход и мощным, неумолимым движением начинает вдавливать исполинский ствол внутрь. Аманда вскрикивает, запрокидывая голову — её девичьи стенки натягиваются до предела, с трудом пропуская чудовищную толщину.'
                *pl 'Дюйм за дюймом, преодолевая сопротивление, член кузнеца погружается до самого основания! <b>Сквозь нежную белую кожу девичьего живота отчётливо проступает выпуклый бугорок от движения массивного ствола.</b> Питер мерно и тяжело вбивает свой молот в податливое тело девушки, заставляя всю телегу сотрясаться в такт ударам, а Аманда стонет в голос от распирающего, дикого наслаждения.'
            else:
                *pl 'Финальная вспышка накрывает обоих: кузнец с победным рыком вжимается в неё до корня и щедро заливает всю глубину её нутра колоссальным потоком горячего семени.'
                *pl 'Аманда бьётся в содрогающем оргазме, судорожно сжимая бёдрами его талию.'
                *pl 'Спустя минуту Питер с влажным, чмокающим звуком медленно вытягивает свой исполинский ствол наружу.'
                *pl 'От небывалой длины члена и огромного объёма влитой спермы <b>низ живота Аманды заметно вздулся и округлился, образовав отчётливый упругий бугорок</b>. Сестра обессиленно лежит на спине, с блаженной улыбкой оглаживая свой надувшийся животик.'
                *pl 'Её <b>влажная щёлочка остаётся широко раскрытой, растянутой и зияющей круглой пещеркой</b>, не в силах сразу сомкнуться после такого гиганта, и из глубины на солому густыми толчками вытекает белое семя молотобойца.'
            end

        elseif $Step = 'stage3_repeat':
            if GiantScreen = 1:
                *pl 'Сквозь доски сарая вам открывается зрелище полной власти над плотью.'
                *pl 'Аманда лежит на мягком плаще, закинув стройные ножки на широкие плечи кузнеца. Её разработанное лоно уже привычно к богатырским размерам и жадно сочится обильной смазкой.'
                *pl 'Питер без заминки входит одним мощным, уверенным толчком, погружая весь колоссальный ствол до упора. Аманда лишь сладостно охает, выгибая спину: её тело уже натренировано и легко принимает исполина.'
                *pl '<b>На её животике снова отчётливо вздувается рельефный бугорок от ходящего внутри ствола.</b> Она сама яростно подмахивает бёдрами навстречу каждому пушечному удару молотобойца, стонет на весь сарай и царапает его спину ноготками, упиваясь своей невероятной женской силой.'
            else:
                *pl 'Оглушительный парный оргазм сотрясает любовников: Аманда истошно кричит от накатившей волны наслаждения, а Питер рычит зверем, до краёв заполняя её нутро кипящим семенем.'
                *pl 'Когда кузнец неторопливо вытягивает свой длиннющий влажный член, взгляду предстаёт потрясающая картина:'
                *pl '<b>Низ живота Аманды вновь отчётливо вздулся и выпятился округлым холмиком</b>, натянувшись от колоссального распирания и обилия влитой спермы. Сестра лежит в сладком изнеможении, с горделивой улыбкой лаская ладонью свой надутый животик.'
                *pl 'Её <b>растянутая щёлочка остаётся широко распахнутой и зияющей</b>, влажно блестя в полумраке, и из неё на плащ обильными толчками выплёскивается густая белая сперма кузнеца.'
            end
        end

    elseif $Choice = 'ignore':
        *pl 'Вы нарочно отворачиваетесь и проходите мимо, оставив парочку за сараем.'
        *pl 'Аманда прекрасно знает, что вы рядом, и этот молчаливый попустительский жест лишь подталкивает её смелее исследовать границы дозволенного.'
    end

    killvar '$Choice'
    killvar '$Step'
    killvar 'GiantScreen'
---
