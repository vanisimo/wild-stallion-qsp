! ================================================
! FILE: modules/events/amanda/neighbor_boys/amanda_boys_giant.qsps
! MODULE: events/amanda/neighbor_boys
! Ветка: Питер (подмастерье кузнеца — огромный размер)
! Поэтапное привыкание:
! - Ранний визит: испуг при виде габаритов, развилка по оральному опыту (oralacts >= 5)
! - Стадия 1 (sluttiness >= 45, sexacts >= 10): ласки и внешнее трение без проникновения
! - Стадия 2 (sluttiness >= 50, sexacts >= 12): неполное, осторожное проникновение
! - Стадия 3 (sluttiness >= 55, sexacts >= 15): полноценный контакт
! ================================================

#AmandaBoyGiantCanStart
    if AmandaBoyGiantStage = 0:
        AmandaBoyGiantCanStart = 1
    elseif AmandaBoyGiantStage = 1:
        if sluttiness['amanda'] >= 50 and sexacts['amanda'] >= 12:
            AmandaBoyGiantCanStart = 1
        else:
            AmandaBoyGiantCanStart = 0
        end
    elseif AmandaBoyGiantStage = 2:
        if sluttiness['amanda'] >= 55 and sexacts['amanda'] >= 15 and AmandaGiantTrained = 1:
            AmandaBoyGiantCanStart = 1
        elseif sluttiness['amanda'] >= 55 and sexacts['amanda'] >= 15 and AmandaGiantTrained = 0:
            AmandaBrothersMelissaTalkPending = 1
            AmandaMelissaTrainingPending = 1
            AmandaBoyGiantCanStart = 0
        else:
            AmandaBoyGiantCanStart = 0
        end
    else
        AmandaBoyGiantCanStart = 1
    end
---

#AmandaBoyGiantEvent
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_event', 'Питер-кузнец и Аманда на заднем дворе', 'large', 'webp'
    $CurrentGirl = 'amanda'
    AmandaNeighborBoysToday = 1
    gs 'EnsureGirlData', 'amanda'

    ! Определение доступной стадии Питера
    if AmandaBoyGiantStage = 0:
        ! Ранняя встреча
        if sluttiness['amanda'] >= 45 and sexacts['amanda'] >= 10:
            $GiantTargetStep = 'stage1_ready'
        else:
            $GiantTargetStep = 'early_fear'
        end
    elseif AmandaBoyGiantStage = 1:
        if sluttiness['amanda'] >= 50 and sexacts['amanda'] >= 12:
            $GiantTargetStep = 'stage2_ready'
        else:
            $GiantTargetStep = 'stage1_ready'
        end
    elseif AmandaBoyGiantStage = 2:
        if sluttiness['amanda'] >= 55 and sexacts['amanda'] >= 15 and AmandaGiantTrained = 1:
            $GiantTargetStep = 'stage3_ready'
        else:
            if sluttiness['amanda'] >= 55 and sexacts['amanda'] >= 15 and AmandaGiantTrained = 0:
                AmandaBrothersMelissaTalkPending = 1
                AmandaMelissaTrainingPending = 1
            end
            $GiantTargetStep = 'stage2_ready'
        end
    else
        ! Завершённая ветка: пост-луп из двух отдельных сцен (минет или вагинальный секс)
        if RAND(1, 2) = 1:
            $GiantTargetStep = 'loop_oral'
        else:
            $GiantTargetStep = 'loop_sex'
        end
    end

    gs 'ShowLocationScreenTitle', 'ПИТЕР-КУЗНЕЦ НА ЗАДНЕМ ДВОРЕ'

    if LOC('AmandaBoyGiantEventText') = 1:
        gs 'AmandaBoyGiantEventText', $GiantTargetStep
    else:
        *pl 'Широкоплечий Питер, подмастерье кузнеца, зажал Аманду за сараем.'
    end

    *pl ' '

    gs 'AmandaBoyGiantBuildMenu'

    *p 'Что вы будете <a href="exec:gs ''Menu.Show'', ''AmandaBoyGiantMenu''">делать</a>?'
---

#AmandaBoyGiantBuildMenu
    gs 'Menu.Destroy', 'AmandaBoyGiantMenu'
    gs 'Menu.Create', 'AmandaBoyGiantMenu'

    gs 'MenuUiAdd', 'AmandaBoyGiantMenu', 'Прогнать кузнеца', ''
    gs 'Menu.AddModule', 'AmandaBoyGiantMenu', {
        gt 'AmandaBoyGiantAction', 'send_away'
    }

    gs 'MenuUiAdd', 'AmandaBoyGiantMenu', 'Спросить прямо', ''
    gs 'Menu.AddModule', 'AmandaBoyGiantMenu', {
        gt 'AmandaBoyGiantAction', 'ask'
    }

    if AmandaWatchNpcPath = 1 or FamilyCorruptionStage >= 2:
        gs 'MenuUiAdd', 'AmandaBoyGiantMenu', 'Наблюдать издалека', ''
        gs 'Menu.AddModule', 'AmandaBoyGiantMenu', {
            gt 'AmandaBoyGiantAction', 'watch'
        }
    end

    gs 'MenuUiAdd', 'AmandaBoyGiantMenu', 'Сделать вид, что не заметили', ''
    gs 'Menu.AddModule', 'AmandaBoyGiantMenu', {
        gt 'AmandaBoyGiantAction', 'ignore'
    }
---

#AmandaBoyGiantAction
    *clr
    clr
    cla

    $GiantChoice = LCASE($ARGS[0])

    if $GiantChoice = 'watch':
        if $GiantTargetStep = 'early_fear' and oralacts['amanda'] < 5:
            gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_giant_fear_closeup', 'Аманда опешила при виде Питера-кузнеца', 'large', 'webp'
        elseif $GiantTargetStep = 'loop_oral':
            gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_giant_oral_screen1', 'Аманда берёт исполинский член кузнеца в рот', 'large', 'webp'
        elseif $GiantTargetStep = 'loop_sex':
            gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_giant_sex_screen1', 'Питер-кузнец вбивает свой молот в лоно Аманды', 'large', 'webp'
        else:
            gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_event', 'Питер-кузнец и Аманда за сараем', 'large', 'webp'
        end
    else:
        gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_action', 'Исход встречи с кузнецом', 'large', 'webp'
    end

    if $GiantChoice = 'send_away':
        AmandaTrustStefan += 1
        Friends['amanda'] += 1
        AmandaPlayerPath += 1
        AmandaRebellion += 1
        TavernScandal += 1

    elseif $GiantChoice = 'ask':
        AmandaTrustStefan += 1
        AmandaSecretiveness += 1
        AmandaNpcPath += 1

    elseif $GiantChoice = 'watch':
        AmandaWatchNpcPath = 1
        AmandaNpcPath += 2
        AmandaSecretiveness += 1
        TavernScandal += 1
        AmandaScandalLevel += 1

        if LOC('KnowledgeRegisterFact') = 1:
            gs 'KnowledgeRegisterFact', 'amanda_neighbors_peek'
            if $GiantTargetStep = 'stage2_ready' or $GiantTargetStep = 'stage3_ready' or $GiantTargetStep = 'loop_oral' or $GiantTargetStep = 'loop_sex':
                gs 'KnowledgeRegisterFact', 'amanda_boy_giant'
            end
        end
        if LOC('KnowledgeRegisterPlayerKnows') = 1:
            gs 'KnowledgeRegisterPlayerKnows', 'amanda_neighbors_peek', 'witness'
        end

        ! Разрешение сцены наблюдения
        if $GiantTargetStep = 'early_fear':
            if oralacts['amanda'] >= 5:
                oralacts['amanda'] += 1
                sluttiness['amanda'] += 1
                AmandaBoyGiantOralDone = 1
            end
        elseif $GiantTargetStep = 'stage1_ready':
            AmandaBoyGiantStage = MAX(AmandaBoyGiantStage, 1)
            sluttiness['amanda'] += 2
            sexacts['amanda'] += 1
        elseif $GiantTargetStep = 'stage2_ready':
            AmandaBoyGiantStage = MAX(AmandaBoyGiantStage, 2)
            sluttiness['amanda'] += 2
            vaginalacts['amanda'] += 1
            sexacts['amanda'] += 1
        elseif $GiantTargetStep = 'stage3_ready':
            AmandaBoyGiantStage = 3
            sluttiness['amanda'] += 3
            vaginalacts['amanda'] += 1
            cuminside['amanda'] += 1
            sexacts['amanda'] += 1
        elseif $GiantTargetStep = 'loop_oral':
            sluttiness['amanda'] += 2
            oralacts['amanda'] += 1
            swallow['amanda'] += 1
            sexacts['amanda'] += 1
        elseif $GiantTargetStep = 'loop_sex':
            sluttiness['amanda'] += 3
            vaginalacts['amanda'] += 1
            cuminside['amanda'] += 1
            sexacts['amanda'] += 1
        end

    elseif $GiantChoice = 'ignore':
        AmandaNpcPath += 2
        AmandaSecretiveness += 2
        AmandaRebellion += 1
        MelissaFamilyConcern += 1
    end

    gs 'ClampGirlSocialStats', 'amanda'

    if $GiantChoice = 'watch' and not ($GiantTargetStep = 'early_fear' and oralacts['amanda'] < 5):
        if $GiantTargetStep = 'loop_oral':
            gs 'ShowLocationScreenTitle', 'КУЗНЕЦ-ВЕЛИКАН И АМАНДА: ОРАЛЬНЫЕ ЛАСКИ'
        else:
            gs 'ShowLocationScreenTitle', 'КУЗНЕЦ-ВЕЛИКАН И АМАНДА: САМ АКТ'
        end
    else:
        gs 'ShowLocationScreenTitle', 'ПОСЛЕ ВСТРЕЧИ'
    end

    if LOC('AmandaBoyGiantActionText') = 1:
        gs 'AmandaBoyGiantActionText', $GiantChoice, $GiantTargetStep, 1
    else:
        *pl 'Питер исчезает в переулке, а Аманда возвращается в трактир.'
    end

    *pl ' '

    if $GiantChoice = 'watch' and not ($GiantTargetStep = 'early_fear' and oralacts['amanda'] < 5):
        gs 'ActUiPrepare', 'Дальше', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AmandaBoyGiantActionScreen2'
        end
    else:

        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            killvar '$GiantChoice'
            killvar '$GiantTargetStep'
            gt 'TavernMain'
        end
    end
---

#AmandaBoyGiantActionScreen2
    *clr
    clr
    cla

    if $GiantTargetStep = 'loop_oral':
        gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_giant_oral_screen2', 'Кузнец изливает густое семя в рот Аманде', 'large', 'webp'
    elseif $GiantTargetStep = 'loop_sex' or $GiantTargetStep = 'stage3_ready':
        gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_giant_sex_screen2', 'Вздувшийся животик Аманды и зияющая щёлочка после великана', 'large', 'webp'
    else:
        gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_action', 'Кульминация и исход встречи с кузнецом', 'large', 'webp'
    end

    gs 'ShowLocationScreenTitle', 'ПОСЛЕ ВСТРЕЧИ: КУЛЬМИНАЦИЯ'

    if LOC('AmandaBoyGiantActionText') = 1:
        gs 'AmandaBoyGiantActionText', 'watch', $GiantTargetStep, 2
    else:
        *pl 'Питер заправляет портки и исчезает в проулке, оставив запыхавшуюся Аманду в сарае.'
    end

    *pl ' '


    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        killvar '$GiantChoice'
        killvar '$GiantTargetStep'
        gt 'TavernMain'
    end
---
