! ================================================
! FILE: modules/events/amanda/neighbor_boys/amanda_boys_brothers.qsps
! MODULE: events/amanda/neighbor_boys
! Ветка: Братья-погодки (Йенс и Бруно)
! Особенности:
! - Всегда ходят парой
! - До гейта (sluttiness >= 50, analacts >= 1): отказ ("вас двое, я не такая")
! - Ступень 1: поочерёдный формат (один ласкает, второй смотрит)
! - Ступень 2: параллельное вовлечение (один сзади, второй у лица / смена)
! - Финал открывает флаг групповых визитов остальных парней (AmandaBoysGroupUnlocked = 1)
! ================================================

#AmandaBoyBrothersCanStart
    AmandaBoyBrothersCanStart = 1
---

#AmandaBoyBrothersEvent
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_event', 'Братья Йенс и Бруно с Амандой', 'large', 'webp'
    $CurrentGirl = 'amanda'
    AmandaNeighborBoysToday = 1
    gs 'EnsureGirlData', 'amanda'

    ! Определение доступной стадии с братьями (ступени 1-6)
    if AmandaBoyBrothersStage = 0:
        if sluttiness['amanda'] >= 50 and analacts['amanda'] >= 1:
            $BrothersTargetStep = 'stage1_ready'
        else:
            $BrothersTargetStep = 'early_refusal'
        end
    elseif AmandaBoyBrothersStage = 1:
        if sluttiness['amanda'] >= 52:
            $BrothersTargetStep = 'stage2_ready'
        else:
            $BrothersTargetStep = 'stage1_repeat'
        end
    elseif AmandaBoyBrothersStage = 2:
        if sluttiness['amanda'] >= 55:
            $BrothersTargetStep = 'stage3_ready'
        else:
            $BrothersTargetStep = 'stage2_repeat'
        end
    elseif AmandaBoyBrothersStage = 3:
        if sluttiness['amanda'] >= 58:
            $BrothersTargetStep = 'stage4_ready'
        else:
            $BrothersTargetStep = 'stage3_repeat'
        end
    elseif AmandaBoyBrothersStage = 4:
        if sluttiness['amanda'] >= 60:
            $BrothersTargetStep = 'stage5_ready'
        else:
            $BrothersTargetStep = 'stage4_repeat'
        end
    elseif AmandaBoyBrothersStage = 5:
        if sluttiness['amanda'] >= 62:
            $BrothersTargetStep = 'stage6_ready'
        else:
            $BrothersTargetStep = 'stage5_repeat'
        end
    elseif AmandaBoyBrothersStage = 6:
        if AmandaBrothersTrained = 1:
            $BrothersTargetStep = 'stage7_ready'
        else:
            $BrothersTargetStep = 'stage6_repeat'
        end
    else:
        $BrothersTargetStep = 'stage7_repeat'
    end

    *pl '══════════════════════════════════════════════'
    *pl ' БРАТЬЯ-ПОГОДКИ ЗА САРАЕМ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaBoyBrothersEventText') = 1:
        gs 'AmandaBoyBrothersEventText', $BrothersTargetStep
    else:
        *pl 'Братья-погодки Йенс и Бруно обступили Аманду у сарая.'
    end

    *pl ' '

    gs 'AmandaBoyBrothersBuildMenu'

    *p 'Что вы будете <a href="exec:gs ''Menu.Show'', ''AmandaBoyBrothersMenu''">делать</a>?'
---

#AmandaBoyBrothersBuildMenu
    gs 'Menu.Destroy', 'AmandaBoyBrothersMenu'
    gs 'Menu.Create', 'AmandaBoyBrothersMenu'

    gs 'MenuUiAdd', 'AmandaBoyBrothersMenu', 'Прогнать братьев', ''
    gs 'Menu.AddModule', 'AmandaBoyBrothersMenu', {
        gt 'AmandaBoyBrothersAction', 'send_away'
    }

    gs 'MenuUiAdd', 'AmandaBoyBrothersMenu', 'Спросить прямо', ''
    gs 'Menu.AddModule', 'AmandaBoyBrothersMenu', {
        gt 'AmandaBoyBrothersAction', 'ask'
    }

    if AmandaWatchNpcPath = 1 or FamilyCorruptionStage >= 2:
        gs 'MenuUiAdd', 'AmandaBoyBrothersMenu', 'Наблюдать издалека', ''
        gs 'Menu.AddModule', 'AmandaBoyBrothersMenu', {
            gt 'AmandaBoyBrothersAction', 'watch'
        }
    end

    gs 'MenuUiAdd', 'AmandaBoyBrothersMenu', 'Сделать вид, что не заметили', ''
    gs 'Menu.AddModule', 'AmandaBoyBrothersMenu', {
        gt 'AmandaBoyBrothersAction', 'ignore'
    }
---

#AmandaBoyBrothersAction
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_action', 'Исход встречи с братьями', 'large', 'webp'
    $BrothersChoice = LCASE($ARGS[0])

    if $BrothersChoice = 'send_away':
        AmandaTrustStefan += 1
        Friends['amanda'] += 1
        AmandaPlayerPath += 1
        AmandaRebellion += 1
        TavernScandal += 1

    elseif $BrothersChoice = 'ask':
        AmandaTrustStefan += 1
        AmandaSecretiveness += 1
        AmandaNpcPath += 1

    elseif $BrothersChoice = 'watch':
        AmandaWatchNpcPath = 1
        AmandaNpcPath += 2
        AmandaSecretiveness += 1
        TavernScandal += 2
        AmandaScandalLevel += 2

        if LOC('KnowledgeRegisterFact') = 1:
            gs 'KnowledgeRegisterFact', 'amanda_neighbors_peek'
        end
        if LOC('KnowledgeRegisterPlayerKnows') = 1:
            gs 'KnowledgeRegisterPlayerKnows', 'amanda_neighbors_peek', 'witness'
        end

        if $BrothersTargetStep = 'stage1_ready' or $BrothersTargetStep = 'stage1_repeat':
            AmandaBoyBrothersStage = 1
            sluttiness['amanda'] += 2
            vaginalacts['amanda'] += 1
            sexacts['amanda'] += 1
            gt 'AmandaBoyBrothersWatchStage1'
        elseif $BrothersTargetStep = 'stage2_ready' or $BrothersTargetStep = 'stage2_repeat':
            AmandaBoyBrothersStage = 2
            sluttiness['amanda'] += 3
            oralacts['amanda'] += 1
            vaginalacts['amanda'] += 1
            sexacts['amanda'] += 2
            AmandaBoysGroupUnlocked = 1
        elseif $BrothersTargetStep = 'stage3_ready' or $BrothersTargetStep = 'stage3_repeat':
            AmandaBoyBrothersStage = 3
            sluttiness['amanda'] += 3
            analacts['amanda'] += 1
            vaginalacts['amanda'] += 1
            sexacts['amanda'] += 2
        elseif $BrothersTargetStep = 'stage4_ready' or $BrothersTargetStep = 'stage4_repeat':
            AmandaBoyBrothersStage = 4
            sluttiness['amanda'] += 3
            oralacts['amanda'] += 1
            sexacts['amanda'] += 2
        elseif $BrothersTargetStep = 'stage5_ready' or $BrothersTargetStep = 'stage5_repeat':
            AmandaBoyBrothersStage = 5
            sluttiness['amanda'] += 3
            oralacts['amanda'] += 2
            sexacts['amanda'] += 2
        elseif $BrothersTargetStep = 'stage6_ready' or $BrothersTargetStep = 'stage6_repeat':
            AmandaBoyBrothersStage = 6
            sluttiness['amanda'] += 4
            vaginalacts['amanda'] += 2
            sexacts['amanda'] += 2
            AmandaBrothersMelissaTalkPending = 1
        elseif $BrothersTargetStep = 'stage7_ready' or $BrothersTargetStep = 'stage7_repeat':
            AmandaBoyBrothersStage = 7
            sluttiness['amanda'] += 5
            vaginalacts['amanda'] += 2
            sexacts['amanda'] += 2
        end

    elseif $BrothersChoice = 'ignore':
        AmandaNpcPath += 2
        AmandaSecretiveness += 2
        AmandaRebellion += 1
        MelissaFamilyConcern += 1
    end

    gs 'ClampGirlSocialStats', 'amanda'

    *pl '══════════════════════════════════════════════'
    *pl ' ПОСЛЕ ВСТРЕЧИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaBoyBrothersActionText') = 1:
        gs 'AmandaBoyBrothersActionText', $BrothersChoice, $BrothersTargetStep
    else:
        *pl 'Братья исчезают в переулке, довольно переговариваясь.'
    end

    *pl ' '

    if AmandaPathChoiceDone = 0:
        AmandaPathChoiceReady = 1
        if LOC('AmandaPathChoiceTryAutoStart') = 1:
            gs 'AmandaPathChoiceTryAutoStart', 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end

    killvar '$BrothersChoice'
    killvar '$BrothersTargetStep'
---

#AmandaBrothersNightTalkMelissa
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_action', 'Аманда и Мелисса ночью', 'large', 'webp'
    $CurrentGirl = 'amanda'
    gs 'EnsureGirlData', 'amanda'
    gs 'EnsureGirlData', 'melissa'

    if AmandaBrothersMelissaTalkStage = 0:
        AmandaBrothersMelissaTalkStage = 1
        AmandaBrothersMelissaNextDay = day + 2
        AmandaBrothersMelissaTalkPending = 0
        AmandaWatchNpcPath = 1
        AmandaNpcPath += 1
        MelissaFamilyConcern += 1
        FamilyCorruptionStage = MAX(FamilyCorruptionStage, 2)
        $BrothersNightStep = 'talk1'
    else:
        AmandaBrothersMelissaTalkStage = 2
        AmandaBrothersMelissaTalkDone = 1
        AmandaBrothersMelissaTalkPending = 0
        AmandaBrothersTrained = 1
        AmandaWatchNpcPath = 1
        AmandaNpcPath += 2
        MelissaNpcPath += 2
        sluttiness['amanda'] += 3
        sluttiness['melissa'] += 2
        FamilyCorruptionStage = MAX(FamilyCorruptionStage, 3)
        $BrothersNightStep = 'talk2'
    end

    if LOC('KnowledgeRegisterFact') = 1:
        gs 'KnowledgeRegisterFact', 'amanda_brothers_confession'
    end
    if LOC('KnowledgeRegisterPlayerKnows') = 1:
        gs 'KnowledgeRegisterPlayerKnows', 'amanda_brothers_confession', 'witness'
    end

    *pl '══════════════════════════════════════════════'
    *pl ' НОЧНОЙ РАЗГОВОР В КОМНАТЕ МЕЛИССЫ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaBrothersNightTalkMelissaText') = 1:
        gs 'AmandaBrothersNightTalkMelissaText', $BrothersNightStep
    else:
        *pl 'Вы тихо подходите к приоткрытой двери комнаты Мелиссы...'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Отойти от двери', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end

    killvar '$BrothersNightStep'
---

#AmandaBoyBrothersWatchStage1
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_event', 'Йенс и Аманда у телеги', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' ЗА САРАЕМ: ЙЕНС И АМАНДА'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaBoyBrothersActionText') = 1:
        gs 'AmandaBoyBrothersActionText', 'watch_stage1_screen1'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Дальше', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaBoyBrothersWatchStage1Screen2'
    end
---

#AmandaBoyBrothersWatchStage1Screen2
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_action', 'Очередь Бруно у телеги', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' ЗА САРАЕМ: ОЧЕРЕДЬ БРУНО'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaBoyBrothersActionText') = 1:
        gs 'AmandaBoyBrothersActionText', 'watch_stage1_screen2'
    end

    *pl ' '

    if AmandaPathChoiceDone = 0:
        AmandaPathChoiceReady = 1
        if LOC('AmandaPathChoiceTryAutoStart') = 1:
            gs 'AmandaPathChoiceTryAutoStart', 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

