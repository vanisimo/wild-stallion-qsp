! ================================================
! FILE: modules/events/amanda/neighbor_boys/amanda_boys_curved_text.qsps
! MODULE: events/amanda/neighbor_boys
! [AI-WORKED] Текст переработан / дополнен ассистентом 17.09.2026
! USER-OWNED TEXT
! Тексты ветки Отто («Кривой», сын кожевенника)
! ================================================

#AmandaBoyCurvedEventText
    $Step = $ARGS[0]

    if $Step = 'early_intro':
        *pl 'На заднем дворе трактира, возле старой телеги, топчется Отто — долговязый, нескладный сын кожевенника.'
        *pl ' '
        *pl 'В руках он сжимает скромный букетик полевых цветов, перевязанный травинкой. Заметив Аманду, парень мгновенно заливается краской до корней соломенных волос и начинает судорожно прятать букет за спину.'
        *pl ' '
        *pl '— А-Аманда... здравствуй... — заикается он, смущённо ковыряя носком сапога землю. — Я вот... мимо луга шёл... подумал, тебе понравится...'
        *pl ' '
        *pl 'Аманда упирает руки в бока и оглядывает его с насмешливой улыбкой:'
        *pl ' '
        *pl '— Цветочки приволок, кожевенник? Ишь какой галантный выискался! А чего голос дрожит? Боишься, что укушу?'
        *pl ' '
        *pl 'Отто неловко переминается с ноги на ногу, не смея поднять на неё влюблённых глаз.'

    elseif $Step = 'stage1_ready' or $Step = 'stage1_repeat':
        *pl 'У гружёной сеном телеги снова переминается Отто, робко сжимая свежий букет колокольчиков.'
        *pl ' '
        *pl '— Опять ты со своими вениками? — фыркает Аманда, но в её тоне уже нет былой колкости. — Ладно, давай сюда свои цветы. Иди за телегу, пока Стефан из трактира не выглянул. Сжалюсь над тобой сегодня, посмотрю, чего ты стоишь.'
        *pl ' '
        *pl 'Отто расплывается в счастливой, глуповатой улыбке и послушно семенит следом за сестрой в укромный уголок.'

    elseif $Step = 'stage2_ready' or $Step = 'stage2_repeat':
        *pl 'За телегой Отто встречает Аманду с сияющими глазами и маленьким плетёным венком из ромашек.'
        *pl ' '
        *pl '— Аманда... я всё о прошлом разе думал... — тихо бормочет парень, протягивая подарок. — Никак из головы не идёт...'
        *pl ' '
        *pl 'Сестра примеряет венок, довольно улыбается и лукаво щурит глаза:'
        *pl ' '
        *pl '— Думал он, надо же. Я вот тоже кое о чём подумала. Интересно мне стало, каков твой занятный крючок на вкус. Пойдём, проверим.'

    elseif $Step = 'stage3_ready' or $Step = 'stage3_repeat':
        *pl 'Возле телеги Отто преданно поджидает Аманду. Завидев её лёгкую походку, он торопливо протягивает сорванную на речном берегу лилию.'
        *pl ' '
        *pl '— Красивая, — хвалит Аманда, проводя лепестком по своей щеке. — Молодец, Отто. Руками да губами мы с тобой позабавились, теперь пора к главному переходить. Залезай в телегу на сено, сегодня я сама решу, как нам удобнее будет.'
        *pl ' '
        *pl 'Парень взволнованно сглатывает и без лишних слов лезет через борт, готовый исполнить любое её желание.'

    elseif $Step = 'stage4_ready':
        *pl 'В сумерках заднего двора Аманда сама подходит к Отто, который несмело переминается возле сена.'
        *pl ' '
        *pl '— Ну что, влюбчивый мой, — шепчет сестра, дразняще проводя ноготком по его плечу. — Спереди мы с тобой всё изучили, ощущения отменные. А теперь я хочу проверить, как твой особенный изгиб поведёт себя с другой стороны. Забирайся в телегу и приготовь масло.'
        *pl ' '
        *pl 'Отто послушно кивает, с благоговением глядя на решительную красавицу.'

    else
        *pl 'За телегой на заднем дворе Отто с благоговейной улыбкой ждёт Аманду, готовый исполнить любое её веление.'
    end
---

#AmandaBoyCurvedActionText
    $Choice = $ARGS[0]
    $Step = $ARGS[1]
    CurvedScreen = $ARGS[2]

    if $Choice = 'send_away':
        *pl 'Вы решительно выходите из-за угла и окликаете Отто.'
        *pl 'Парень испуганно вздрагивает, роняет цветы в пыль и, заикаясь на каждом слове, торопливо пятится прочь к воротам.'
        *pl 'Аманда недовольно поджимает губы, но спорить с вами при свидетелях не решается.'

    elseif $Choice = 'ask':
        *pl 'Вы окликаете Аманду и строго спрашиваете, что здесь за посиделки посреди рабочего дня.'
        *pl 'Отто тут же ретируется в переулок, а Аманда прячет букетик в карман фартука и с невинным видом щебечет, что просто вышла подышать воздухом.'

    elseif $Choice = 'ignore':
        *pl 'Вы решаете не вмешиваться в ухаживания долговязого кожевенника и возвращаетесь к делам трактира.'

    elseif $Choice = 'watch':
        if $Step = 'stage1_ready' or $Step = 'stage1_repeat':
            ! ЭТАП 1: Ручная ласка за телегой (1 экран)
            *pl 'Притаившись за бочками, вы наблюдаете за происходящим за телегой.'
            *pl ' '
            *pl 'Аманда усаживает смущённого Отто на край повозки и ловко распускает завязки его штанов.'
            *pl ' '
            *pl 'Когда парень освобождает своё мужское достоинство, Аманда ошеломлённо замирает, округлив глаза:'
            *pl ' '
            *pl '— Ильматер всеблагой... — вырывается у неё тихий шёпот. — Да он же у тебя набок загнут! Надо же, и такие диковины на свете бывают!'
            *pl ' '
            *pl 'Она с живым исследовательским любопытством берет изогнутый ствол в ладошку. Осторожно пробует слегка выпрямить пальцами, но орган пружинит, сохраняя крутой изгиб. Аманда склоняется ближе, касается кончиком язычка влажной головки — на вкус различий нет.'
            *pl ' '
            *pl 'Хмыкнув, сестра начинает размеренно двигать ладонью вверх и вниз, подмечая, как необычный изгиб ложится в ладонь. Отто закатывает глаза, тяжело дыша и сжимая пальцами доски телеги. Спустя пару минут парень глухо стонет и изливается прямо на девичьи пальцы.'
            *pl ' '
            *pl 'Аманда весело смеётся, вытирая руку чистым платком:'
            *pl ' '
            *pl '— Ну вот, а я-то думала, и семя у тебя набок брызжет! Нет, тут всё точно так же, как у остальных.'

        elseif $Step = 'stage2_ready' or $Step = 'stage2_repeat':
            if CurvedScreen = 1:
                ! ЭТАП 2: Экран 1 (Оральная ласка — процесс)
                *pl 'В полумраке за телегой Аманда опускается на колени перед Отто.'
                *pl ' '
                *pl 'Ей не терпится проверить, как необычный изгиб поведёт себя во рту. Пальцами направляя изогнутый ствол, она обхватывает головку влажными губами и плавно скользит вниз.'
                *pl ' '
                *pl '— М-м-м... — одобрительно мычит сестра, насаживаясь глубже. Необычная дуга идеально ложится под нёбо, не вызывая тошноты. В её голове мелькает мысль: если уложить его на спину, такой ствол пойдёт прямо по дуге в самое горло без малейшего сопротивления.'
                *pl ' '
                *pl 'Аманда активно работает язычком, обводя причудливые изгибы и заставляя Отто тихо всхлипывать от неземного удовольствия.'
            else:
                ! ЭТАП 2: Экран 2 (Оральная ласка — финал)
                *pl 'Дыхание Отто сбивается в прерывистый хрип. Он робко кладёт ладони на девичьи плечи, не в силах сдерживать нарастающую волну.'
                *pl ' '
                *pl 'Аманда ускоряет движение губ, и парень со стоном изливается ей в рот. Сестра спокойно сглатывает тёплую влагу, облизывает пухлые губки и поднимается на ноги, довольно улыбаясь:'
                *pl ' '
                *pl '— Удобный у тебя орган, Отто. Ложится прямо как надо.'

            end

        elseif $Step = 'stage3_ready' or $Step = 'stage3_repeat':
            if CurvedScreen = 1:
                ! ЭТАП 3: Экран 1 (У борта телеги сзади)
                *pl 'В глубине заднего двора Аманда командует Отто подойти к борту повозки.'
                *pl ' '
                *pl 'Она упирается ладонями в борт, приподнимает короткий подол и отводит бёдра назад. Парень с трепетом приставляет свой изогнутый ствол к её влажной ложбинке и плавно входит.'
                *pl ' '
                *pl '— О-о-ох... — вырывается у Аманды громкий стон. При таком угле изгиб направлен прямо на внутреннюю переднюю стенку, мягко и настойчиво массируя самые чувствительные ткани. — Вот это да... как глубоко достаёт...'
                *pl ' '
                *pl 'Отто неторопливо двигается сзади, пока Аманда сладостно покачивает бёдрами, смакуя необычные ощущения.'
            elseif CurvedScreen = 2:
                ! ЭТАП 3: Экран 2 (Наездница в телеге)
                *pl 'Желая испробовать обратный угол, Аманда велит парню лечь на спину прямо в сено телеги.'
                *pl ' '
                *pl 'Подтянув юбку, сестра грациозно опускается на него сверху. Изгиб разворачивается в противоположную сторону — и в этот момент кончик попадает в особую, сокровенную точку глубоко внутри.'
                *pl ' '
                *pl '— А-а-ах! — вскрикивает Аманда, закидывая голову назад. По её телу прокатывается мощнейшая волна оргазма, ноги подкашиваются, а пальцы судорожно впиваются в его плечи. Никто из них не знает мудрёных названий, но ощущения накрывают её с такой силой, какой она ещё никогда не испытывала.'
            else:
                ! ЭТАП 3: Экран 3 (Финал в телеге)
                *pl 'Не в силах больше терпеть, Отто сдавленно стонет и мощными толчками заполняет лоно Аманды горячим семенем.'
                *pl ' '
                *pl 'Разрядка стихает, но обессиленная Аманда так и остаётся сидеть на нём сверху, уткнувшись носом в его плечо и тяжело переводя дух. Она даже не думает вставать, всё ещё дрожа от пережитого восторга.'

            end

        elseif $Step = 'stage4_ready':
            if CurvedScreen = 1:
                ! ЭТАП 4: Экран 1 (Эксперимент в телеге сзади)
                *pl 'В укромном полумраке телеги Аманда велит Отто щедро смазать пальцы и ствол благовонным маслом.'
                *pl ' '
                *pl 'Она становится на четвереньки в сено, выставив аккуратную попку. Парень осторожно прижимает головку к её тугой дырочке и медленно проталкивается внутрь.'
                *pl ' '
                *pl 'Благодаря анатомическому изгибу ствол скользит по дуге, задевая совершенно особые внутренние точки, недоступные обычному прямому члену. Аманда утыкается лицом в солому, издавая глухой, вибрирующий стон неземного наслаждения.'
            else:
                ! ЭТАП 4: Экран 2 (Финал в попку)
                *pl 'Отто размеренно двигается в тугой попке сестры, заставляя её тело вздрагивать от каждого толчка.'
                *pl ' '
                *pl 'На пике наслаждения парень глубоко вдавливается внутрь и до краёв заполняет её задний проход горячим семенем. Аманда шумно выдыхает, расслабленно роняя голову на солому и тихо шепча, что этот эксперимент превзошёл все её ожидания.'
            end

        elseif $Step = 'loop':
            if CurvedScreen = 1:
                ! ПОВТОРЯЕМЫЙ ЦИКЛ: Экран 1 (Оральная разминка)
                *pl 'В полумраке за телегой Аманда привычно берёт дело в свои руки.'
                *pl ' '
                *pl 'Опустившись на колени, она с явным знанием дела ласкает изогнутый ствол губами и язычком, разогревая Отто перед дальнейшими забавами.'
            elseif CurvedScreen = 2:
                ! ПОВТОРЯЕМЫЙ ЦИКЛ: Экран 2 (Основная близость в телеге)
                if CurvedLoopPos = 1:
                    *pl 'Поднявшись в телегу, Аманда опирается на борт и принимает Отто сзади. Знакомый изгиб сладко массирует стенки её лона, вызывая протяжные стоны.'
                else
                    *pl 'Аманда укладывает парня в сено и опускается сверху наездницей. Точное попадание в заветную точку вновь заставляет её задыхаться от наслаждения.'
                end
            elseif CurvedScreen = 3:
                ! ПОВТОРЯЕМЫЙ ЦИКЛ: Экран 3 (Дополнительный эксперимент сзади)
                *pl 'Раззадорившись, Аманда поворачивается к нему попкой и велит войти сзади. Плавный вход по дуге приносит обоим острую, ни с чем не сравнимую сладость.'
            else:
                ! ПОВТОРЯЕМЫЙ ЦИКЛ: Экран 4 (Финал)
                if CurvedLoopHadAnal = 1:
                    *pl 'Отто со стоном изливается в её попку, до краёв заполняя тугой проход семенем. Аманда блаженно замирает на сене.'
                elseif CurvedLoopFinish = 1:
                    *pl 'Парень финиширует Аманде прямо в рот, и девушка аккуратно сглатывает сладкую влагу.'
                else
                    *pl 'Глубокий толчок в девичье лоно завершается бурной разрядкой, оставляя Аманду обессиленной и довольной.'
                end
            end
        end
    end
---
