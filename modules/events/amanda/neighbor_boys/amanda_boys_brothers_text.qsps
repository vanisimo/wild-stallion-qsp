! ================================================
! FILE: modules/events/amanda/neighbor_boys/amanda_boys_brothers_text.qsps
! MODULE: events/amanda/neighbor_boys
! [AI-WORKED] Текст переработан / дополнен ассистентом 16.09.2026
! USER-OWNED TEXT
! Тексты ветки братьев-погодок (Йенс и Бруно)
!
! Визуальные ассеты:
! images/events/amanda/amanda_events/amanda_neighbor_boys_event — Братья и Аманда за сараем
! images/events/amanda/amanda_events/amanda_neighbor_boys_action — Исход встречи с братьями
! ================================================

#AmandaBoyBrothersEventText
    $Step = $ARGS[0]

    if $Step = 'early_refusal':
        *pl 'У задней стены сарая слышны приглушённые голоса.'
        *pl 'Братья Йенс и Бруно снова крутятся возле Аманды, нагло ухмыляясь и перекрывая ей дорогу к трактиру.'
        *pl '— Аманда, ну куда ты так торопишься? — лениво тянет Йенс, окинув её фигуру масляным взглядом. — Постой, поболтай с нами. Ты такая красивая, прям хочется укусить, как персик.'
        *pl 'Бруно прислоняется к стене рядом и скалится:'
        *pl '— Точно. В зале мужикам старым улыбается, а молодым и красивым и слова не скажешь? Нехорошо, красавица.'
        *pl 'Аманда упирает руки в бока и смеривает обоих язвительным взглядом с ног до головы:'
        *pl '— А о чём мне с вами лясы точить? Обходительные такие. Вас двое, а я одна — губу-то закатайте, я не такая! Идите в доки, там девкам мозги пудрите, пока я Стефана не позвала.'
        *pl 'Братья весело перемигиваются за её спиной: её колючий отпор их только раззадоривает.'

    elseif $Step = 'stage1_ready' or $Step = 'stage1_repeat':
        *pl 'Йенс и Бруно перехватывают Аманду прямо у поленницы, сразу беря её в плотные клещи.'
        *pl 'Йенс шагает вплотную с одного бока, а Бруно заходит с другого, отрезая проход к двери.'
        *pl '— Хватит вредничать, Аманда, — говорит Йенс, уверенно опуская ладонь ей на плечо и скользя пальцами к вырезу платья. — Ты же сама глаз с нас не спускаешь, когда мимо ходишь.'
        *pl '— Руки при себе держи! — огрызается сестра, но от прикосновений её дыхание предательски сбивается. — Ишь, шустрые какие! Сразу вдвоём навалились!'
        *pl 'Бруно наклоняется к самому её уху и шепчет:'
        *pl '— А помнишь как мы в детстве играли в замри, ты всегда выигрывала. Так вот ЗАМРИ...'

    elseif $Step = 'stage2_ready' or $Step = 'stage2_repeat':
        *pl 'После прошлого раза братья встречают Аманду с улыбками.'
        *pl '— Ну что, строптивая? — подначивает Бруно. — В прошлый раз вырвалась, а сама-то вся горела. Между ножек потом не хлюпало?.'
        *pl '— Если и хлюпало, то не про вашу честь, дурачьё, — фыркает Аманда, демонстративно поправляя юбку. — Думали, руки мне под юбку вдвоём запустите — и я сразу растаю?'
        *pl '— Раз вдвоём ты несогласная — давай по очереди, — предлагает Йенс с хитрым прищуром, переглядываясь с братом. — По-честному. Сначала с одним за сарай сходишь, потом с другим. Мы уважаем твои принципы. едь ты не боишься со мной прогуляться'
        *pl 'Аманда язвительно хмыкает, окинув обоих насмешливым взглядом:'
        *pl '— Я? Боюсь? Да я пяных матросов не боюсь, пошли пройдемся.'

    elseif $Step = 'stage3_ready' or $Step = 'stage3_repeat':
        *pl 'У приоткрытой двери сарая братья снова берут Аманду в оборот.'
        *pl '— Ротиком ты нас знатно порадовала, Аманда, — ухмыляется Йенс. — Но сколько можно тянуть? Пора к настоящему делу переходить, сено в сарае мягкое.'
        *pl '— Размечтались! — насмешливо вскидывает бровь сестра. — Вдвоём со мной на сено полезете? Много чести!'
        *pl '— Да кто говорит вдвоём? — подмигивает Бруно, толкая брата локтем. — Один с тобой за закрытыми дверями побудет, а второй снаружи покараулит, чтоб никто из кабака не сунулся. Всё по справедливости.'
        *pl 'Аманда с прищуром оглядывает сарай:'
        *pl '— Ладно. Только один в деле, а второй носа внутрь не суёт! И попробуйте только смухлевать — мигом на улицу выставлю.'

    elseif $Step = 'stage4_ready' or $Step = 'stage4_repeat':
        *pl 'Братья подкарауливают Аманду уже по-хозяйски, без лишних предисловий.'
        *pl '— Ну что, Аманда, убедилась, что с нами весело? — скалится Бруно, бесцеремонно приобнимая её за талию.'
        *pl '— Весело ей, как же, — усмехается Аманда, не торопясь сбрасывать его руку. — Думали, я не заметила, как ты в щель подглядывал и штаны наглаживал? Хиттрецы нашлись.'
        *pl '— Ну раз заметила — чего теперь прятаться? — хрипло говорит Йенс. — Хватит поодиночке. Зайдём внутрь — один тебя спереди приласкает, второй сзади займётся. Ты же сама об этом думаешь, глаза-то так и блестят.'
        *pl 'Аманда дерзко вспыхивает, в глазах мелькает азартный огонёк:'
        *pl '— С двух сторон захотели? Наглецы... Ну пошли в сарай. Посмотрим, у кого из вас двоих силёнок больше.'

    elseif $Step = 'stage5_ready' or $Step = 'stage5_repeat':
        *pl 'В полумраке за сараем братья встречают Аманду уверенно и нагло.'
        *pl '— Ты у нас ненасытная стала, — подначивает Бруно. — Но мы ещё не все лазейки проверили.'
        *pl '— Это какие же лазейки? — фыркает Аманда с надменной ухмылкой. — Неужто в ту дырочку метите, куда только по особому разрешению пускают?'
        *pl '— Именно туда, — шепчет Йенс ей прямо в губы. — По очереди. Один в киску войдёт, другой в попку. Чтоб ни одно местечко без внимания не осталось.'
        *pl 'Аманда на секунду прикусывает губу, глядя на них с хищным прищуром:'
        *pl '— Губа не дура у вас, мальчики... Ладно. Только драть как попало не позволю: всё будет по моим правилам. Марш в сарай.'

    elseif $Step = 'stage6_ready' or $Step = 'stage6_repeat':
        *pl 'У поленницы братья сразу прижимают Аманду к брёвнам.'
        *pl '— Сегодня твоя очередь нас обоих разом уважить, — заявляет Йенс, расстёгивая пряжку пояса.'
        *pl '— Командовать вздумал? — Аманда вздёргивает подбородок, насмешливо оглядывая их ширинки. — Разом двоих в рот захотели?'
        *pl '— А ты попробуй, — скалится Бруно. — Ротик у тебя ловкий, язычок жадный. Поместимся оба, ещё и добавки попросишь.'
        *pl '— Ильматер всеблагой, соревнование они устроили, — язвительно хмыкает сестра с чувством полного превосходства. — Заходите внутрь и снимайте портки. Сейчас покажу, как надо с вами управляться.'

    elseif $Step = 'stage7_ready' or $Step = 'stage7_repeat':
        *pl 'Перед входом в сарай братья заметно волнуются, хоть и хорохорятся друг перед другом.'
        *pl '— Ну что, Аманда... готова к главному? — негромко спрашивает Йенс, сглотнув слюну.'
        *pl 'Сестра смотрит на них спокойно и насмешливо, чувствуя себя хозяйкой положения:'
        *pl '— Я-то готова. И масло взяла, и знаю, как дышать, чтобы не порвали. Я с Мелиссой всё обсудила, так что в анатомии получше вашего разбираюсь. А вот вы не робейте, смельчаки.'
        *pl '— Мы-то не оплошаем, — ухмыляется Бруно, нервно переглядываясь с братом. — Вдвоём войдём — синхронно, шаг за шагом.'
        *pl '— Только попробуйте спешить, — строго обрывает Аманда. — Сказано: всё под мой счёт и по моей команде. За мной.'

    elseif $Step = 'stage8_ready' or $Step = 'stage8_repeat':
        *pl 'В сарае уже расстелен мягкий шерстяной плащ на свежем сене.'
        *pl 'Братья встречают Аманду взглядами, полными жадного желания и благоговения.'
        *pl '— Высшая ступень, Аманда, — тихо говорит Йенс. — В одну щелку — вдвоём. Такого во всём городе ни с одной девкой не было.'
        *pl 'Аманда не спеша сбрасывает фартук и распускает волосы, улыбаясь вызывающе и властно:'
        *pl '— Сравнили меня с вашими городскими замухрышками! Я беру от вас обоих всё сполна, потому что сама так хочу. Стели плащ поровнее, мальчики. Покажите, на что способны.'
    end

    killvar '$Step'
---

#AmandaBoyBrothersActionText
    $Choice = $ARGS[0]
    $Step = $ARGS[1]

    if $Choice = 'send_away':
        *pl 'Вы с суровым окриком вышагиваете из-за угла сарая:'
        *pl '— А ну брысь отсюда оба, пока я вам бока не намял!'
        *pl 'Братья шарахаются назад, но быстро натягивают наглые ухмылки, пятясь к переулку:'
        *pl '— Да ладно, Стефан, чего ты сразу взъелся! Мы уже уходим, уходим!'
        *pl 'Парни воровски перемигиваются и скрываются за углом. Аманда же с досадой одёргивает подол, уперев руки в бока и сердито глядя на вас:'
        *pl '— Ну вот вечно ты суёшься не в своё дело! — фыркает сестра, сверкая глазами. — Сама прекрасно знаю, как с ними обращаться. Ничего они мне не сделают, пока я сама не позволю. Раскомандовался тут!'

    elseif $Choice = 'ask':
        *pl 'Когда братья с насмешливыми ухмылками растворяются в переулке, вы подходите к сестре:'
        *pl '— И о чём это вы тут так жарко толковали в три голоса?'
        *pl 'Аманда насмешливо смотрит на вас, демонстративно поправляя шнуровку на груди:'
        *pl '— Да всё о том же, о чём все мужики думают, — с ехидной ухмылкой отвечает сестра. — Губу раскатали на двоих сразу. Думают, если вдвоём навалиться, я растаю и сразу ноги раздвину. Пусть побегают за мной, поупрашивают. Я им не дешёвка из портового трактира, чтоб за здорово живёшь отдаваться.'

    elseif $Choice = 'watch_stage1_screen1':
        *pl 'Притаившись в тени навеса, вы наблюдаете за падением барьеров.'
        *pl 'Аманда соглашается на уговоры братьев: Бруно отходит к калитке, не отрывая взгляда от происходящего.'
        *pl 'Йенс подводит Аманду к сену, осыпая её лицо и шею поцелуями. Не давая опомниться, он поворачивает её к себе попкой, задирает подол и стягивает панталончики. Девушка тихо охает, выставляя попку на обозрение; голая влажная пещерка сестры блестит смазкой.'
        *pl 'Йенс улыбается и, приставив член к вагине сестры, медленно, но уверенно вводит свой твердый член. Она вскрикивает, прижавшись попкой теснее к парню.'
        *pl 'Йенс начинает двигаться, медленно и глубоко, проникая всё дальше. Аманда извивается под его напором. Каждый толчок сопровождается глухим хлюпом, и ты видишь, как она закрывает глаза, отдаваясь наслаждению.'
        *pl 'Бруно внимательно наблюдает за происходящим. Он, не сводя взгляда с Аманды, начинает мастурбировать. Ты слышишь, как его дыхание становится всё более тяжёлым, и он жадно смотрит на Аманду, наслаждаясь её стонами, раскинутыми ножками и звуками хлюпающей киски.'
        *pl 'Стоны Аманды становятся чаще и громче. Йенс увеличивает скорость и глубину проникновений и, глухо застонав, заливает пиздёнку твоей сестры своей спермой. Аманда, почувствовав в себе сперму, заголосила в оргазменном стоне, подавшись назад и стараясь, чтобы член вошёл как можно глубже.'
        *pl 'Дрожа от оргазма, она падает головой в солому телеги.'


    elseif $Choice = 'watch_stage1_screen2':
        *pl 'Не успела Аманда перевести дух, как Бруно уже тут как тут — «обещание только караулить» мгновенно забыто.'
        *pl 'Член Йенса с влажным звуком покидает сестру, выпуская белые струйки спермы, а Бруно уже перехватывает её бёдра, плотоядно ухмыляясь:'
        *pl '— Так, а теперь моя очередь, золотко... Я же так старался, так переживал за вас!'
        *pl 'Аманда пытается протестовать: «Мы же договаривались только по очереди!..», но Бруно уже прижимает горячий ствол к её ягодицам, обнимает за талию и нашёптывает умильные оправдания, не давая опомниться. Через мгновение он со стоном кончает, щедро заливая обе дырочки сестры своим семенем.'
        *pl 'Братья довольно перемигиваются за спиной запыхавшейся девушки, пока та вытирает сперму подолом и растерянно дуется:'
        *pl '— Обещали одно, а сперму я от обоих из письки вытираю! Вот и верь вам, кавалерам!'
        *pl '— Не дуйся, красавица, смотри как чудно получилось! — с масляной улыбкой разводит руками Бруно, подмигивая брату. — Зато оба тебя порадовали! В следующий раз сделаем в точности, как ты прикажешь. Ты же сама нас не остановила!'

    elseif $Choice = 'watch':
        if $Step = 'early_refusal':
            *pl 'Притаившись за бочками, вы наблюдаете за искусной осадой.'
            *pl 'Братья действуют слаженно, как бывалые городские ловеласы: Йенс мягко перекрывает дорогу к двери, осыпая Аманду комплиментами, а Бруно ластится сбоку, целуя ей пальчики.'
            *pl 'Стоит сестре смущённо отвести взгляд, как парни переглядываются за её спиной и весело перемигиваются, явно довольные тем, как умело заговаривают ей зубы.'
            *pl 'Но Аманда пока ещё чует подвох: хоть и хихикает польщённо, всё же вырывает ручки и упрямо пятится к трактиру:'
            *pl '— Хватит соловьями заливать! Сказала же — по домам идите, балагуры! Знаю я ваши ужимки!'
            *pl 'Она ловко выскальзывает из их полукольца и убегает к дверям. Братья провожают её виляющие бёдра масляными взглядами, перемигиваются ещё раз и с ухмылкой расходятся — первый шаг развода уже сделан.'

        elseif $Step = 'stage1_ready' or $Step = 'stage1_repeat':
            *pl 'Притаившись за поленницей, вы наблюдаете за происходящим прямо на месте разговора.'
            *pl 'Йенс и Бруно больше не скрывают своих намерений. Йенс прижимается к Аманде с одного бока, горячо целуя её в шею и с ловкостью распуская шнуровку корсажа.'
            *pl 'Бруно обнимает сестру с другого бока, сжимая её талию и запуская руку прямо под распахнутую ткань платья. Ладони парней смыкаются на её обнажившейся груди, жадно разминая соски.'
            *pl 'Аманда замерев часто и прерывисто дышит, запрокидывая голову; её глаза затуманиваются, а тело само подаётся навстречу наглым ласкам. Ей явно нравится происходящее, щёки пылают румянцем.'
            *pl 'Ободрённые её стонами, братья смелеют: Йенс продолжает целовать её в губы, а Бруно уже задирает подол юбки, скользя пальцами по бёдрам и начиная стягивать вниз кружевные панталончики.'
            *pl 'Едва ощутив, как ткань сползает с ягодиц, Аманда резко приходит в себя. Она с силой упирается ладонями в грудь обоих братьев и отталкивает их от себя:'
            *pl '— А ну притормозите коней! — с выпаливает сестра, торопливо одёргивая подол и затягивая тесёмки корсажа. — С двумя сразу я кувыркаться не собираюсь! И еще подловили меня этим "замри", ловеласы!'
            *pl 'Хоть слова её и звучат строго, её пылающий взгляд и вздымающаяся грудь выдают крайнее возбуждение. Братья переглядываются пряча победные ухмылки: -Но ты проиграла, не смогла замереть, - засмеялись они поняв, что крепость готова пасть.'

        elseif $Step = 'stage2_ready' or $Step = 'stage2_repeat':
            *pl 'Сквозь щели в досках сарая вам открывается вид на Аманду и её двух ухажёров. Она стоит на четвереньках на сене, подол платья уже задрал Йенс. Он стянул с неё трусики, развёл ягодицы и одним сильным толчком вошёл в её влажную киску.'
*pl 'Его бёдра сразу начали отбивать быстрый, жёсткий ритм, раскачивая её тело вперёд. Аманда всхлипнула, но тут же подалась назад, насаживаясь глубже.'
*pl 'Бруно в это время встал перед ней, притянул её лицо к своему возбуждённому члену и скомандовал:'
*pl '— Открывай рот, красотка.'
*pl 'Аманда послушно открыла ротик, и толстый ствол Бруно проскользнул ей между губ. Она сразу начала двигать головой, стараясь взять глубже, пока Йенс сзади нещадно долбил её киску. Парни насаживали её на оба члена одновременно — один сзади, другой в рот.'
*pl 'Влажные шлепки тел и приглушённые стоны Аманды наполнили сарай. Йенс держал её за бёдра мёртвой хваткой, ускоряя темп, а Бруно запускал пальцы ей в волосы, задавая ритм.'
*pl '— Кончаю, принимай, крошка… — рыкнул Йенс и всадил член до упора, заливая её нутро горячей спермой.'
*pl 'Аманда затряслась в оргазме, сжимаясь вокруг него. Бруно тут же вытащил свой член у неё изо рта. Густая струя брызнула ей прямо на язык и губы. Аманда тяжело дышала, но послушно сглотнула всё, что попало в рот, пока остатки стекали по подбородку и капали на сено.'
*pl 'Йенс медленно вышел из неё. Из раскрытой киски сразу потекла белая смесь спермы и её соков. Братья переглянулись, явно довольные.'
*pl '— Хорошая девочка, — сказал Бруно, проводя пальцем по её перепачканным губам. — Всё до последней капли приняла.'

        elseif $Step = 'stage3_ready' or $Step = 'stage3_repeat':
          *pl 'Из укрытия ты видишь, Аманду лежит на мягкой куче соломы, грудь тяжело вздымается. Братья склонились над ней с обеих сторон — Йенс спереди, Бруно сзади.'
*pl 'Бруно уже между её разведённых бёдер. Он проводит языком по ее пизднке, от клитора вниз, обводя вход во влагалище, а потом выше и касается языком сжатого анального колечка. Аманда вздрагивает, но Йенс целует, шепча в губы:'
*pl '— Тихо, малышка… дыши глубоко… Вот так. Мы аккуратненько. Ты у нас умница…'
*pl 'Его ладони гладят её грудь, сжимают соски, отвлекая. Бруно продолжает вылизывать её, чередуя нежные движения с толчками языка внутрь. Он смазывает её обильно — и попку, и киску, — пока Аманда не начинает дрожать и постанывать ему в рот Йенсу.'
*pl 'Йенс отрывается от её губ только на секунду, чтобы лечь на спину в сено. Он подхватывает Аманду и усаживает её сверху, лицом к себе. Его твёрдый член уже стоит вертикально. Он направляет головку к её влажной пещерке и медленно входит в неё. Аманда выдыхает протяжный стон, когда он заполняет её полностью.'
*pl 'Йенс тут же притягивает её грудью к своей, обхватывает руками и двигает бедрами — не давая ей сосредоточиться на том, что происходит сзади. Бруно встаёт на колени позади. Он разводит её ягодицы, приставляет головку своего члена. Нажимает осторожно. Йенс помогает ему руками, хватает попку Аманды и растягивает её в стороны.'
*pl 'Аманда напрягается, пытается что-то сказать, но Йенс усиливает ласки — целует глубже, ускоряет движения члена, пронзая пизденку девушки.'
*pl '— Расслабься… выдохни… — шепчет Йенс. — Всё будет хорошо, тебе понравится.'
*pl 'Бруно, полюбовавшись на кончик члена, засунутый в широко распахнутый анус Аманды, давит сильнее. Головка медленно, с влажным звуком, протискивается внутрь. Аманда всхлипывает, пальцы впиваются Йенсу в плечи. Бруно замирает, давая ей привыкнуть. Потом подаётся ещё чуть вперёд. И ещё. Пока не входит почти полностью.'
*pl 'Теперь Аманда нанизана на оба члена. Йенс снизу, Бруно сзади. Они чувствуют друг друга через тонкую стенку внутри неё. Братья переглядываются через её плечо и перемигиваются друг с другом, явно довольные происходящим.'
*pl '— Во мне… два члена… одновременно… — явно шокированно произносит Аманда. — И мне это нравится.'
*pl 'Сначала медленно. Йенс поднимает бёдра вверх, когда Бруно почти выходит, и наоборот. Короткие, синхронные толчки. Аманда стонет уже в полный голос — низко. Каждый раз, когда оба входят в неё одновременно, её тело выгибается дугой. Влажные звуки хлюпающих дырок и стоны тройцы заполнили сарай.'
*pl 'Постепенно ритм ускоряется. Братья трахают её уже жёстче. Йенс удерживает её за бёдра, не переставая двигаться, а Бруно впивается пальцами в ягодицы и вгоняет член до упора. Аманда больше не пытается сдерживаться. Она пытается подмахивать обоим, стонет, ругается сквозь зубы.'
*pl 'Кульминация накрывает почти одновременно. Йенс первым сжимает её сильнее, вбивает снизу несколько коротких толчков и кончает внутрь, низко рыча и обхватив её руками. Бруно ещё несколько секунд продолжает двигаться, чувствуя, как внутри неё пульсирует член брата, а потом и сам кончает — горячей спермой, заполняя её анус.'
*pl 'Не выдержав двойного заполнения, Аманда протяжно застонав, начинает биться в конвульсиях оргазма. Они медленно выходят из неё. Аманда безвольно оседает на сено, дрожащая, мокрая, из обеих дырочек вытекает сперма и стекает по бёдрам. Братья остаются рядом и смотрят, как девушка дрожит, всё ещё переживая оргазм.'
*pl 'Переглянувшись опять и видимо что-то сказав друг другу без слов, они поднимают Аманду. Йенс подносит свой измазанный спермой и выделениями член к её губам. Аманда, сфокусировав взгляд, спокойно открывает рот и тщательно вылизывает его. Бруно, кинув взгляд на брата, подходит следом. Аманда на мгновение замирает, потом всё же открывает рот и начинает обсасывать член, который только что был у неё в попке.'
*pl '— Молодец, крошка, мне понравилось, а тебе как? — покрутив свой член в руках, говорит Йенс.'
*pl '— Меня никогда в жизни так не трахали, — покраснев немного, отвечает Аманда.'
*pl '— Ха, Йенс же говорил, что тебе понравится, — смеётся Бруно. — В следующий раз сама нас сюда потащишь.'
*pl '— Вот ещё, девушку надо уговаривать, а не наоборот, — возмущается ваша сестра, встав и ни капли не стесняясь братьев, принялась вытирать обе свои дырочки. — Идите, мне себя в порядок надо привести, мне ещё работать, а у меня ноги в раскоряку, натёрли мне всё, и сперма из обеих дырок течёт.'

        elseif $Step = 'stage4_ready' or $Step = 'stage4_repeat':
            *pl 'Братья заманили Аманду в полутёмный сарай. 
            Йенс и Бруно сразу принялись за корсаж, быстро расшнуровывая его. Их ладони скользнули под ткань, сжимая и разминая её маленькие сиськи. Аманда тихо всхлипнула, но не отстранилась.'
*pl '— Давай, красотка, возьми меня в рот, — хрипло попросил Йенс.'
*pl '— Нет, сначала мне, — тут же перебил Бруно, подставляя свой член.'
*pl 'Аманда усмехнулась и успокоила обоих. Сначала она наклонилась к Йенсу, обхватила губами его головку и начала сосать, одновременно обхватывая пальцами ствол Бруно и быстро двигая рукой. Через минуту она поменяла их местами — теперь глубоко принимала Бруно, а свободной рукой дрочила Йенсу.'
*pl 'Йенс перемигнулся с братом и нагло подставил свой член рядом с первым. Аманда на секунду удивилась, но, уже сильно возбуждённая, открыла рот шире и попыталась взять оба сразу. Головки протиснулись между губ, и она начала старательно облизывать и посасывать их вместе.'
*pl 'Одной рукой она задрала юбку, запустила пальцы под трусики и принялась быстро теребить свою мокрую пиздёнку. Чем глубже она пыталась заглотить оба члена, тем жёстче работали её пальцы.'
*pl 'Вид Аманды, сосущей сразу двоих и дрочащей себе, окончательно добил братьев. Йенс первым глухо застонал и начал кончать ей прямо в рот. Бруно тут же последовал за ним, добавляя свою порцию. Густая сперма заполнила рот девушки.'
*pl 'Это зрелище и вкус на языке толкнули Аманду через край. Она сильно сжалась вокруг собственных пальцев и кончила, продолжая удерживать оба члена губами.'
*pl 'Аманда отстранилась, приоткрыла рот и показала братьям, сколько они туда настреляли. Языком она медленно перемешивала густую белую массу, вызывая у парней восторженные комментарии.'
*pl '— Вот это да… — выдохнул Йенс.'
*pl '— Глотай, крошка, — добавил Бруно.'
*pl 'Аманда послушно сглотнула всё до последней капли, потом тщательно вылизала и обсосала оба члена начисто. Поднявшись, она поправила корсаж и строго сказала:'
*pl '— Всё, идите уже. Мне теперь рот мыть надо, а то от меня спермой несёт. Мама сразу поймёт, что я кому-то отсосала.'

        elseif $Step = 'stage5_ready' or $Step = 'stage5_repeat':
            ! ================================================
            ! [БРИФ ДЛЯ SILLYTAVERN: СТАДИЯ 5]
            ! Механика: oralacts + 2, двойное обслуживание
            ! Обстановка: Сарай, золотистый свет сквозь щели, пыльная трава.
            ! Участники: Аманда стоит на коленях между Йенсом и Бруно.
            ! Шаги:
            ! 1. Позиция: Аманда на коленях в соломе между Йенсом и Бруно, которые стоят перед ней с двух сторон.
            ! 2. Процесс: Она одновременно уделяет внимание обоим парням, работая ртом и руками, переключаясь с одного на другого в быстром темпе.
            ! 3. Накал: Братья подгоняют её, удерживая за волосы и направляя движения.
            ! 4. Кульминация: Оба одновременно изливаются ей на лицо и в рот; Аманда покорно всё принимает.
            ! ================================================
            ! === [СЮДА_ТЕКСТ_СТАДИЯ_5: НАЧАЛО] ===
            *pl 'Вы видите, как Аманда опустилась на колени меж двумя братьями в золотистом полумраке сарая.'
*pl 'Братья заманили Аманду в полутёмный сарай. 
            Йенс и Бруно сразу принялись за корсаж, быстро расшнуровывая его. Их ладони скользнули под ткань, сжимая и разминая её маленькие сиськи. Аманда тихо всхлипнула, но не отстранилась.'
*pl '— Давай, красотка, возьми меня в рот, — хрипло попросил Йенс.'
*pl '— Нет, сначала мне, — тут же перебил Бруно, подставляя свой член.'
*pl 'Аманда усмехнулась и успокоила обоих. Сначала она наклонилась к Йенсу, обхватила губами его головку и начала сосать, одновременно обхватывая пальцами ствол Бруно и быстро двигая рукой. Через минуту она поменяла их местами — теперь глубоко принимала Бруно, а свободной рукой дрочила Йенсу.'
*pl 'Йенс перемигнулся с братом и нагло подставил свой член рядом с первым. Аманда на секунду удивилась, но, уже сильно возбуждённая, открыла рот шире и попыталась взять оба сразу. Головки протиснулись между губ, и она начала старательно облизывать и посасывать их вместе.'
*pl 'Одной рукой она задрала юбку, запустила пальцы под трусики и принялась быстро теребить свою мокрую пиздёнку. Чем глубже она пыталась заглотить оба члена, тем жёстче работали её пальцы.'
*pl 'Вид Аманды, сосущей сразу двоих и дрочащей себе, окончательно добил братьев. Йенс первым глухо застонал и начал кончать ей прямо в рот. Бруно тут же последовал за ним, добавляя свою порцию. Густая сперма заполнила рот девушки.'
*pl 'Это зрелище и вкус на языке толкнули Аманду через край. Она сильно сжалась вокруг собственных пальцев и кончила, продолжая удерживать оба члена губами.'
*pl 'Аманда отстранилась, приоткрыла рот и показала братьям, сколько они туда настреляли. Языком она медленно перемешивала густую белую массу, вызывая у парней восторженные комментарии.'
*pl '— Вот это да… — выдохнул Йенс.'
*pl '— Глотай, крошка, — добавил Бруно.'
*pl 'Аманда послушно сглотнула всё до последней капли, потом тщательно вылизала и обсосала оба члена начисто. Поднявшись, она поправила корсаж и строго сказала:'
*pl '— Всё, идите уже. Мне теперь рот мыть надо, а то от меня спермой несёт. Мама сразу поймёт, что я кому-то отсосала.'
            ! === [СЮДА_ТЕКСТ_СТАДИЯ_5: КОНЕЦ] ===

        elseif $Step = 'stage6_ready' or $Step = 'stage6_repeat':
            ! ================================================
            ! [БРИФ ДЛЯ SILLYTAVERN: СТАДИЯ 6]
            ! Механика: vaginalacts + 2, Аманда ведёт процесс
            ! Обстановка: Задняя стена дровяника, полутень.
            ! Участники: Аманда в роли ведущей, послушные братья.
            ! Шаги:
            ! 1. Смена ролей: Аманда сама командует парнями, указывая, кому встать сзади, а кому опуститься перед ней.
            ! 2. Контроль: Она задаёт медленный ритм движений, заставляя парней сдерживаться и двигаться исключительно по её сигналам.
            ! 3. Процесс: Поочерёдное и одновременное соитие, в котором Аманда упивается своей властью над обоими воздыхателями.
            ! 4. Финал: Братья обессиленно падают рядом с ней на солому после долгой выматывающей кульминации.
            ! ================================================
            ! === [СЮДА_ТЕКСТ_СТАДИЯ_6: НАЧАЛО] ===
            *pl 'Сквозь щели сарая видно, как Аманда виртуозно руководит обоими воздыхателями.'
            *pl 'Она нежно распределяет их ласки, заставляя парней двигаться в её собственном неторопливом ритме. Братья беспрекословно слушаются каждого девичьего вздоха, боясь разрушить хрупкую гармонию момента.'
            *pl 'Когда они замирают в долгой кульминации, Аманда лежит в их объятиях с тихой, умиротворённой улыбкой истинной госпожи их сердец.'
            ! === [СЮДА_ТЕКСТ_СТАДИЯ_6: КОНЕЦ] ===

        elseif $Step = 'stage7_ready' or $Step = 'stage7_repeat':
            ! ================================================
            ! [БРИФ ДЛЯ SILLYTAVERN: СТАДИЯ 7]
            ! Механика: vaginalacts + 2, высшая ступень единения
            ! Обстановка: Ложе из свежего сена, застеленное тёмным шерстяным плащом.
            ! Участники: Аманда, Йенс и Бруно.
            ! Шаги:
            ! 1. Начало: Братья укладывают Аманду на плащ. Полное отсутствие спешки, абсолютная слаженность и взаимная раскрепощённость.
            ! 2. Процесс: Непрерывное соитие со сменой позиций — братья сменяют друг друга, окружая девушку лаской со всех сторон.
            ! 3. Кульминация: Мощный групповой финал, полное телесное единение и изнеможение всех троих.
            ! 4. Исход: Братья заботливо укрывают уставшую Аманду краем плаща и целуют её перед уходом.
            ! ================================================
            ! === [СЮДА_ТЕКСТ_СТАДИЯ_7: НАЧАЛО] ===
            *pl 'Вы становитесь свидетелем удивительного финала: на мягком шерстяном плаще среди сена братья и Аманда сливаются в абсолютном доверии.'
            *pl 'Благодаря спокойствию и чуткой заботе братьев, всё происходит плавно, глубоко и без малейшей боли.'
            *pl 'Сарай наполняется тихим шёпотом ласковых признаний, прерывистым дыханием и блаженными вздохами Аманды, согретой двойным потоком любви и тепла.'
            *pl 'Когда братья бережно укрывают уставшую сестру плащом и целуют её сонные веки, в их движениях сквозит безграничная преданность.'
            ! === [СЮДА_ТЕКСТ_СТАДИЯ_7: КОНЕЦ] ===

        elseif $Step = 'stage8_ready' or $Step = 'stage8_repeat':
            *pl 'Вы становитесь свидетелем наивысшего пика чувственного бесстыдства — двойного вагинального проникновения.'
            *pl 'На мягком шерстяном плаще среди душистого сена Аманда лежит на спине, широко разведя стройные ножки глядя на обоих парней.'
            *pl 'Братья опускаются на колени перед ней. Обильно покрыв свои стволы густым маслом, они прижимают головки вплотную друг к другу.'
            *pl 'Аманда глубоко дышит, полностью расслабляя мышцы таза по наставлениям сестры, и своими пальцами направляет оба мужских орудия в раскрывшийся вход своего женского лона.'
            *pl 'Медленно, дюйм за дюймом, преодолевая упругое сопротивление растянутых стенок, оба члена протискиваются внутрь одной киски. Аманда шумно выдыхает, запрокидывая голову, её лицо озаряет торжествующая улыбка истинной госпожи их плоти.'
            *pl 'Когда оба ствола погружаются до упора, сарай наполняется единым вздохом троих участников. Двигаясь в унисон, братья совершают короткие, плотные толчки, а Аманда стонет в голос, упиваясь своей невероятной женской силой и способностью вместить обоих сразу.'
            *pl 'Финальная вспышка накрывает их одновременно: издав победный стон, братья до упора вдавливаются в её бездонное нутро, щедро заливая его двойным потоком горячего семени. Аманда стонет в изнеможении, с победной улыбкой сжимая обоих любовников в своих объятиях.'
        end

    elseif $Choice = 'ignore':
        *pl 'Вы решаете не вмешиваться, позволяя братьям продолжать баловать сестру сладкими речами и заботой.'
        *pl 'Аманда замечает ваш удаляющийся силуэт — и понимает, что никто не станет осуждать её за стремление к ласке и вниманию.'
    end

    killvar '$Choice'
    killvar '$Step'
---

#AmandaBrothersNightTalkMelissaText
    $NightStep = $ARGS[0]

    if $NightStep = 'talk1':
        *pl 'Ночной коридор второго этажа залит лунным светом. Вы бесшумно ступаете по половицам и замираете у приоткрытой двери Мелиссы.'
        *pl 'Внутри горит тусклая масляная лампа. Аманда сидит на краю кровати сестры, нервно комкая ночную сорочку на коленях.'
        *pl 'Мелисса сидит за столом над объёмистым фолиантом, поверх очков строго и с лёгкой иронией глядя на младшую сестру:'
        *pl '— ...Ты совершенно потеряла голову, Аманда? — с язвительным изумлением произносит Мелисса. — С двумя братьями-погодками? Они же ходят за тобой как привязанные щенки и заглядывают в рот каждому твоему слову!'
        *pl '— Мелисса, пожалуйста!.. — умоляюще шепчет Аманда, заливаясь густым румянцем. — Они такие ласковые, они стихи мне читают и руки целуют... Но они оба хотят быть со мной одновременно! А я боюсь, что моё тело не справится... Ты ведь столько умных книг прочитала! Помоги мне понять, как расслабить мышцы и подготовить тело, чтобы не было больно!'
        *pl 'Мелисса с сухим хлопком закрывает книгу и насмешливо складывает руки на груди:'
        *pl '— Ильматер всеблагой, какая трогательная пастораль! Два портовых воздыхателя напели ей в уши соловьиных трелей, и вместо того, чтобы думать о семейной чести, она пришла ко мне на лекцию по прикладной физиологии! Марш спать, пока я матушке не рассказала про твоих обожателей!'
        *pl 'Аманда всхлипывает, прячет лицо в ладонях и поспешно выбегает в коридор. Вы успеваете скрыться в тени лестницы.'

    elseif $NightStep = 'talk2':
        *pl 'Спустя несколько ночей в коридоре снова слышатся осторожные шаги — Аманда опять пробирается в комнату Мелиссы.'
        *pl 'Прильнув к дверной щели, вы видите, что на этот раз младшая сестра держится куда увереннее.'
        *pl '— Мелисса, выслушай меня серьёзно, — настойчиво шепчет Аманда. — Ты же сама говорила, что знание должно служить делу, а не пылиться на полках! Они всё равно не отстанут, да и я сама этого хочу. Но без правильной науки я могу пораниться! Ты ведь читала столичные медицинские трактаты о женской анатомии и мышечной эластичности? Научи меня, как правильно дышать и подготавливать связки шаг за шагом!'
        *pl 'Мелисса замирает, окинув сестру долгим, оценивающим взглядом. В её строгих глазах пробивается исследовательский азарт и тайное любопытство книжной всезнайки:'
        *pl '— Хм... Апелляция к авторитету медицинских трактатов? Признаю, звучит на удивление разумно для твоей ветреной головки, — медленно произносит Мелисса, поправляя очки. — Если уж ты твёрдо вознамерилась потакать этим двум воздыхателям, то лучше подойти к делу со строгим научным расчётом, чем калечить себя по глупости.'
        *pl 'Мелисса достаёт чистый лист бумаги и чернильницу:'
        *pl '— Садись прямо и слушай меня предельно внимательно. Начнём с механики диафрагмального дыхания и постепенного расслабления тазового пояса. Повторять будешь строго по моим инструкциям — никакой самодеятельности!'
        *pl 'Аманда с горячей благодарностью обнимает сестру. Вы тихо отступаете обратно в спальню, поражённый услышанным научным сговором.'
    end

    killvar '$NightStep'
---
