! ================================================
! FILE: modules/events/amanda/neighbor_boys/amanda_boys_brothers_text.qsps
! MODULE: events/amanda/neighbor_boys
! [AI-WORKED] Текст переработан / дополнен ассистентом 17.09.2026
! USER-OWNED TEXT
! Тексты ветки братьев-погодок (Йенс и Бруно)
!
! Визуальные ассеты:
! images/events/amanda/amanda_events/amanda_neighbor_boys_event — Братья и Аманда за сараем
! images/events/amanda/amanda_events/amanda_neighbor_boys_action — Исход встречи с братьями
! ================================================

#AmandaBoyBrothersEventText
    $Step = $ARGS[0]

    if $Step = 'early_refusal':
        *pl 'У задней стены сарая слышны приглушённые голоса.'
        *pl 'Братья Йенс и Бруно снова крутятся возле Аманды, нагло ухмыляясь и перекрывая ей дорогу к трактиру.'
        *pl '— Аманда, ну куда ты так торопишься? — лениво тянет Йенс, окинув её фигуру масляным взглядом. — Постой, поболтай с нами. Ты такая красивая, прям хочется укусить, как персик.'
        *pl 'Бруно прислоняется к стене рядом и скалится:'
        *pl '— Точно. В зале мужикам старым улыбается, а молодым и красивым и слова не скажешь? Нехорошо, красавица.'
        *pl 'Аманда упирает руки в бока и смеривает обоих язвительным взглядом с ног до головы:'
        *pl '— А о чём мне с вами лясы точить? Обходительные такие. Вас двое, а я одна — губу-то закатайте, я не такая! Идите в доки, там девкам мозги пудрите, пока я Стефана не позвала.'
        *pl 'Братья весело перемигиваются за её спиной: её колючий отпор их только раззадоривает.'

    elseif $Step = 'stage1_ready' or $Step = 'stage1_repeat':
        *pl 'Йенс и Бруно перехватывают Аманду прямо у поленницы, сразу беря её в плотные клещи.'
        *pl 'Йенс шагает вплотную с одного бока, а Бруно заходит с другого, отрезая проход к двери.'
        *pl '— Хватит вредничать, Аманда, — говорит Йенс, уверенно опуская ладонь ей на плечо и скользя пальцами к вырезу платья. — Ты же сама глаз с нас не спускаешь, когда мимо ходишь.'
        *pl '— Руки при себе держи! — огрызается сестра, но от прикосновений её дыхание предательски сбивается. — Ишь, шустрые какие! Сразу вдвоём навалились!'
        *pl 'Бруно наклоняется к самому её уху и шепчет:'
        *pl '— А помнишь как мы в детстве играли в замри, ты всегда выигрывала. Так вот ЗАМРИ...'

    elseif $Step = 'stage2_ready' or $Step = 'stage2_repeat':
        *pl 'После прошлого раза братья встречают Аманду с улыбками.'
        *pl '— Ну что, строптивая? — подначивает Бруно. — В прошлый раз вырвалась, а сама-то вся горела. Между ножек потом не хлюпало?.'
        *pl '— Если и хлюпало, то не про вашу честь, дурачьё, — фыркает Аманда, демонстративно поправляя юбку. — Думали, руки мне под юбку вдвоём запустите — и я сразу растаю?'
        *pl '— Раз вдвоём ты несогласная — давай по очереди, — предлагает Йенс с хитрым прищуром, переглядываясь с братом. — По-честному. Сначала с одним за сарай сходишь, потом с другим. Мы уважаем твои принципы. Ведь ты не боишься со мной прогуляться'
        *pl 'Аманда язвительно хмыкает, окинув обоих насмешливым взглядом:'
        *pl '— Я? Боюсь? Да я пяных матросов не боюсь, пошли пройдемся.'

    elseif $Step = 'stage3_ready' or $Step = 'stage3_repeat':
        *pl 'У приоткрытой двери сарая братья снова берут Аманду в оборот.'
        *pl '— Ротиком ты нас порадовала, Аманда, — ухмыляется Йенс. — Но сколько можно тянуть? Пора к настоящему делу переходить, сено в сарае мягкое.'
        *pl '— Размечтались! — насмешливо вскидывает бровь сестра. — Вдвоём со мной на сено полезете? Еще раз говорю я не такая!'
        *pl '— Да кто говорит вдвоём? Мы уже поняличто ты не такая — подмигивает Бруно, толкая брата локтем. — Один с тобой побудет, а второй покараулит, чтоб никто из таверны не сунулся. Всё как ты говоришь.'
        *pl 'Аманда с оглядывает сарай:'
        *pl '— Ладно, нравитесь вы мне. Только с одним перепехнусь, а второй свой уд в штанах держит! И попробуйте только придумать что то — мигом уйду недотраханой даже.'

    elseif $Step = 'stage4_ready' or $Step = 'stage4_repeat':
        *pl 'Братья поджидают Аманду у сарая, и как только она показывается, снова окружают ее как охотники, обложив с двух сторон.'
        *pl '— Ну что, Аманда, убедилась, что с нами весело? — скалится Бруно, приобнимая её за талию, и по хозяйски сжимает попку.'
        *pl '— Весело мне, как же, — усмехается Аманда, не торопясь сбрасывать его руку. — второй раз меня обманываете, один кончает второй туда же добавляет, что за привычка.'
        *pl '— Ну есть такое, мы же братья, все привыкли делить поровну — так что может уже хватит притворятся, ведь видно что мы тебе оба глянулись, и ты не против с обими — хрипло говорит Йенс. Зайдём внутрь — одного ротиком порадуешь,второй тебе писечку потрахает. Ты же сама об этом думаешь, глаза-то так и блестят, себя не обманывай.'
        *pl 'Аманда дерзко вспыхивает, в глазах мелькает азартный огонёк:'
        *pl '— С двух сторон меня выебать захотели? Наглецы...'
        *pl '- Аманда что за выражения, мы тебя с двух сторон нежно и с любовью трахнем. Выбирай кто спереди кто сзади'

    elseif $Step = 'stage5_ready' or $Step = 'stage5_repeat':
        *pl 'За сараем, куда прибежала, Аманда, увидев на улице братьев.'
        *pl '— Привет  красавица, не нас ищешь, — подначивает Бруно. — Мы еще не все дырочки попробовали.'
        *pl '— Это какие же ? — фыркает Аманда. — Неужто в ту дырочку метите, куда только по особому разрешению пускают?'
        *pl '— Именно туда, — говорит Йенс. — Мы с братом еще обсуждали какая у тебя попка красивая, и какая дырочка в попе замечательная, розовая чистая, видно что ты Таро используешь, и хорошо о себе заботишься, так и тянет свой член туда засунуть.'
        *pl 'Аманда на секунду прикусывает губу, глядя на них с хищным прищуром:'
        *pl '— Губа не дура у вас, мальчики... Ладно. Только не оба в попку, а то я потом ходить не смогу. Марш в сарай.'

    elseif $Step = 'stage6_ready' or $Step = 'stage6_repeat':
        *pl 'У поленницы братья сразу прижимают Аманду к брёвнам.'
        *pl '— Аманда мы такое придумали — ты нам минет сделаешь одновременно, — заявляет Йенс, расстёгивая пряжку пояса.'
        *pl '— Что! Значит одновременно? — Аманда вздёргивает подбородок, насмешливо оглядывая их ширинки.'
        *pl '— Ну мы подумали оба члена, тебе в рот засунуть — смешался Бруно. — Мы же братья, нам всегда все достается поровну. А у тебя ротик ловкий, язычок верткий. Поместимся оба.'
        *pl '— Ильматер всеблагой, вот вы выдумщики развратные, — ошалев от такого предложения говорит ваша сестра. — Самой интересно что получится, только аккуратненько рот мне не порвите.'

    elseif $Step = 'stage7_ready' or $Step = 'stage7_repeat':
        *pl 'Перед входом в сарай стоят братья, ожидая Аманду.'
        *pl '— Ну что, Аманда... будем стонать вместе? — негромко спрашивает Йенс, сглотнув слюну.'
        *pl 'Сестра смотрит на них, и смеётся:'
        *pl '— Что снова придумали развратники?'
        *pl '— Вдвоём войдём — один в писечку, второй в попочку, — ухмыляется Бруно, переглядываясь с братом.'
        *pl '— Эй я же порвусь, от такого, - возмущается Аманда. - Может в рот?'
        *pl '— Не бойся милая, мы оба нежно и с любовью, — говорит Йенс. — Это будет лучший трах в твоей жизни, поверь мне.'

    elseif $Step = 'stage8_ready' or $Step = 'stage8_repeat':
        if AmandaBrothersTrained = 0:
            *pl 'Братья поджидают Аманду у сарая, переглядываясь с нетерпением и тайным волнением.'
            *pl '— Аманда, мы тут всё обдумали... — начинает Йенс, подходя вплотную и заглядывая ей в глаза. — Мы хотим высшую ступень. В одну щёлку — сразу вдвоём.'
            *pl '— Что?! — Аманда ошарашенно округляет глаза и отступает на шаг. — Разом вдвоём в одну писечку?! Вы совсем сдурели, мальчики?!'
            *pl '— Да ты послушай, — подхватывает Бруно, пытаясь приобнять её за плечи. — Мы аккуратно, мы с маслом, синхронно... Такого во всём городе ни с одной девкой не было!'
            *pl '— И со мной не будет! — сердито скидывает его руку сестра, уперев руки в бока. — Вы меня разорвёте пополам! Я себе не враг, чтобы из-за вашей дури потом калекой остаться! И думать забудьте!'
            *pl 'Аманда резко разворачивается и быстрым шагом уходит к трактиру, оставив братьев ни с чем, но в её взгляде мелькает растерянное и тревожное любопытство.'
        else:
            *pl 'В сарае уже расстелен мягкий шерстяной плащ на свежем сене.'
            *pl 'Братья встречают Аманду взглядами, полными жадного желания.'
            *pl '— Ну что, Аманда... готова к высшей ступени? — негромко спрашивает Йенс, сглотнув слюну. — В одну щелку — вдвоём.'
            *pl 'Сестра смотрит на них спокойно и насмешливо, чувствуя себя полной хозяйкой положения:'
            *pl '— Я-то готова. И масло взяла, и знаю, как дышать, чтобы не порвали — меня Мелисса всему научила и подготовила, так что в анатомии я получше вашего разбираюсь. А вот вы не робейте, смельчаки. Всё строго под мой счёт!'
            *pl '— Мы-то не оплошаем, — ухмыляется Бруно, переглядываясь с братом. — Стели плащ поровнее, покажем, на что способны.'
        end
    end

    killvar '$Step'
---

#AmandaBoyBrothersActionText
    $Choice = $ARGS[0]
    $Step = $ARGS[1]
    BrothersScreen = ARGS[2]
    if BrothersScreen = 0: BrothersScreen = 1

    if $Choice = 'send_away':
        *pl 'Вы с суровым окриком вышагиваете из-за угла сарая:'
        *pl '— А ну брысь отсюда оба, пока я вам бока не намял!'
        *pl 'Братья шарахаются назад, но быстро натягивают наглые ухмылки, пятясь к переулку:'
        *pl '— Да ладно, Стефан, чего ты сразу взъелся! Мы уже уходим, уходим!'
        *pl 'Парни воровски перемигиваются и скрываются за углом. Аманда же с досадой одёргивает подол, уперев руки в бока и сердито глядя на вас:'
        *pl '— Ну вот вечно ты суёшься не в своё дело! — фыркает сестра, сверкая глазами. — Сама прекрасно знаю, как с ними обращаться. Ничего они мне не сделают, пока я сама не позволю. Раскомандовался тут!'

    elseif $Choice = 'ask':
        *pl 'Когда братья с насмешливыми ухмылками растворяются в переулке, вы подходите к сестре:'
        *pl '— И о чём это вы тут так жарко толковали в три голоса?'
        *pl 'Аманда насмешливо смотрит на вас, демонстративно поправляя шнуровку на груди:'
        *pl '— Да всё о том же, о чём все мужики думают, — с ехидной ухмылкой отвечает сестра. — Губу раскатали на двоих сразу. Думают, если вдвоём навалиться, я растаю и сразу ноги раздвину. Пусть побегают за мной, поупрашивают. Я им не дешёвка из портового трактира, чтоб за здорово живёшь отдаваться.'
   
    elseif $Choice = 'watch':
        if $Step = 'early_refusal':
            *pl 'Притаившись за бочками, вы наблюдаете за искусной осадой.'
            *pl 'Братья действуют слаженно, как бывалые городские ловеласы: Йенс мягко перекрывает дорогу к двери, осыпая Аманду комплиментами, а Бруно ластится сбоку, целуя ей пальчики.'
            *pl 'Стоит сестре смущённо отвести взгляд, как парни переглядываются за её спиной и весело перемигиваются, явно довольные тем, как умело заговаривают ей зубы.'
            *pl 'Но Аманда пока ещё чует подвох: хоть и хихикает польщённо, всё же вырывает ручки и упрямо пятится к трактиру:'
            *pl '— Хватит соловьями заливать! Сказала же — по домам идите, балагуры! Знаю я ваши ужимки!'
            *pl 'Она ловко выскальзывает из их полукольца и убегает к дверям. Братья провожают её виляющие бёдра масляными взглядами, перемигиваются ещё раз и с ухмылкой расходятся — первый шаг развода уже сделан.'

        elseif $Step = 'stage1_ready' or $Step = 'stage1_repeat':
            if BrothersScreen = 1:
                ! ЭТАП 1: Петтинг у поленницы на месте разговора — сам процесс
                *pl 'Притаившись за поленницей, вы наблюдаете за происходящим прямо на месте разговора.'
                *pl 'Йенс и Бруно больше не скрывают своих намерений. Йенс прижимается к Аманде с одного бока, горячо целуя её в шею и с ловкостью распуская шнуровку корсажа.'
                *pl 'Бруно обнимает сестру с другого бока, сжимая её талию и запуская руку прямо под распахнутую ткань платья. Ладони парней смыкаются на её обнажившейся груди, жадно разминая соски.'
                *pl 'Аманда замерев часто и прерывисто дышит, запрокидывая голову; её глаза затуманиваются, а тело само подаётся навстречу наглым ласкам. Ей явно нравится происходящее, щёки пылают румянцем.'
                *pl 'Ободрённые её стонами, братья смелеют: Йенс продолжает целовать её в губы, а Бруно уже задирает подол юбки, скользя пальцами по бёдрам и начиная стягивать вниз кружевные панталончики.'
            else:
                ! ЭТАП 1: Петтинг у поленницы на месте разговора — окончание
                *pl 'Едва ощутив, как ткань сползает с ягодиц, Аманда резко приходит в себя. Она с силой упирается ладонями в грудь обоих братьев и отталкивает их от себя:'
                *pl '— А ну притормозите коней! — выпаливает сестра, торопливо одёргивая подол и затягивая тесёмки корсажа. — С двумя сразу я кувыркаться не собираюсь! И еще подловили меня этим "замри", ловеласы!'
                *pl 'Хоть слова её и звучат строго, её пылающий взгляд и вздымающаяся грудь выдают крайнее возбуждение. Братья переглядываются, пряча победные ухмылки:'
                *pl '— Но ты проиграла, не смогла замереть! — засмеялись они, поняв, что крепость готова пасть.'
            end

        elseif $Step = 'stage2_ready' or $Step = 'stage2_repeat':
            if BrothersScreen = 1:
                ! ЭТАП 2: Минет по очереди за сараем — сам акт
                *pl 'Йенс завел аманду в полутёмный сарай.'
                *pl 'И не теряя времени сразу принялся за корсаж, быстро расшнуровывая его.'
                *pl 'Ладони Йенса скользнули под ткань, сжимая и разминая её маленькие сиськи. Аманда тихо всхлипнула, но не отстранилась.'
                *pl '— Давай, красотка, возьми в ротик, — хрипло попросил Йенс.'
                *pl '— Нет, сначала мне, — тут же перебил Бруно, выскочив из за двери сарая.'
                *pl 'Аманда хихикнула: - Ладно давайте вдвоем, а то передеретесь, и соседи услышат. Сначала она наклонилась к Йенсу, обхватила губами головку его члена и принялась старательно посасывать, одновременно обхватив пальцами ствол Бруно и принялась быстро двигать рукой. Затем поменяла их местами — теперь сосала член Бруно, лаская языком его уздечку, а свободной рукой размеренно дрочила Йенсу.'
                *pl 'Не забывая посасывать их яица, заставляя парней стонать от удовольствия.'
            else:
                ! ЭТАП 2: Минет по очереди за сараем — окончание
                *pl 'Йенс первым не выдержал ласки и, глухо застонав, оторвал ротАманды от члена брата, засунул член ей в рот, и просунув его глубже начал кончать. Следом за ним сдавленно охнул Бруно, развернул ее обратно и не дав девушке сглонуть предидущуюю порцию, спустил сперму прямо в заполненый ротик.'
                *pl 'Аманда постояв немного с наполненым ртом словно размышляя что ей теперь делать, все же сглотнула все что ей накончали в рот братья, облизала губы и, поднявшись с колен, поправила вырез:'
                *pl '— Ну вот, оба довольны. А теперь идите, мне рот сполоснуть надо, а то от меня спермой несет, как от тети Бекки, после того как к ней матросы заглядывают.'
            end

        elseif $Step = 'stage3_ready' or $Step = 'stage3_repeat':
            if BrothersScreen = 1:
                ! ЭТАП 3: Один занимается сексом, второй наблюдает и мастурбирует — сам акт
                *pl 'Притаившись в тени навеса, вы наблюдаете за происходящим в сарае.'
                *pl 'Аманда соглашается на уговоры братьев: Бруно отходит к входу, карауля и не отрывая жадного взгляда от происходящего.'
                *pl 'Йенс подводит Аманду к сену, осыпая её лицо и шею поцелуями. Не давая опомниться, он поворачивает её к себе попкой, задирает подол и стягивает панталончики. Девушка тихо охает, выставляя попку на обозрение; голая влажная пещерка сестры блестит смазкой.'
                *pl 'Йенс улыбается и, приставив член к вагине сестры, медленно, но уверенно вводит свой твердый член. Она вскрикивает, прижавшись попкой теснее к парню.'
                *pl 'Йенс начинает двигаться, медленно и глубоко, проникая всё дальше. Аманда извивается под его напором. Каждый толчок сопровождается глухим хлюпом, и ты видишь, как она закрывает глаза, отдаваясь наслаждению.'
                *pl 'Бруно внимательно наблюдает за происходящим. Не сводя взгляда с Аманды, он начинает жадно мастурбировать. Его дыхание становится всё более тяжёлым, он упивается её стонами, движениями попки двигающей навстречу члена брата и звуками хлюпающей киски.'
            else:
                ! ЭТАП 3: Один занимается сексом, второй наблюдает и мастурбирует — окончание
                *pl 'Стоны Аманды становятся чаще и громче. Йенс увеличивает скорость и глубину толчков и, глухо застонав, заливает пиздёнку твоей сестры спермой. Аманда, почувствовав что ее наполняют, заголосила в оргазменном стоне, подавшись назад.'
                *pl 'Член Йенса с влажным звуком покидает сестру, а Бруно уже тут как тут — отстраняет брата, прижимает свой горячий ствол к её попке и через мгновение он со стоном кончает, щедро заливая обе дырочки своим семенем.'
                *pl 'Братья довольно перемигиваются за спиной запыхавшейся девушки, пока та вытирает сперму платком и растерянно дуется:'
                *pl '— Обещали одно, а сперму я от обоих из письки вытираю! Вот и верь вам, кавалерам!'
                *pl '— Не дуйся, красавица, смотри как чудно получилось! — с хитрой улыбкой разводит руками Бруно, подмигивая брату. — Зато оба тебя порадовали! В следующий раз сделаем в точности, как ты скажешь.'
            end

        elseif $Step = 'stage4_ready' or $Step = 'stage4_repeat':
            if BrothersScreen = 1:
                ! ЭТАП 4: Секс с двумя (в рот и в киску) — сам акт
                *pl 'Сквозь щели в досках сарая вам открывается вид на Аманду и её двух ухажёров. Она стоит на четвереньках, подол платья уже задрал Йенс. Он стянул с неё трусики, развёл ягодицы и одним сильным толчком вошёл в её влажную киску.'
                *pl 'Его бёдра сразу начали отбивать быстрый, жёсткий ритм, раскачивая её тело вперёд. Аманда всхлипнула, но тут же подалась назад, насаживаясь глубже.'
                *pl 'Бруно в это время встал перед ней, притянул её лицо к своему возбуждённому члену и скомандовал:'
                *pl '— Открывай рот, красотка.'
                *pl 'Аманда открыла ротик, и толстый ствол Бруно проскользнул ей между губ. Она начала двигать головой, стараясь взять глубже, пока Йенс сзади нещадно долбил её киску.'
                *pl 'Аманда, чувствуя, как член Йенса наполняет её всё глубже, выгнула спину, запрокидывая голову прямо в руки стоявшего перед ней Бруно.'
                *pl 'Йенс с наслаждением упёрся ладонями ей в поясницу, насаживая её до самого упора, пока Бруно спереди придерживал сестру за волосы, направляя её ротик.'
                *pl 'Приглушённые стоны Аманды глушились членом Бруно, смешиваясь с влажными шлепками сзади и тяжёлым дыханием братьев.'
            else:
                ! ЭТАП 4: Секс с двумя (в рот и в киску) — окончание
                *pl 'Йенс первым шумно зарычал: всадив свой ствол до предела, он забился в частых судорогах, глубоко заливая её девичью киску горячим семенем.'
                *pl 'От накатившей изнутри горячей волны Аманда затрепетала всем телом, судорожно сжав губки. Бруно сдавленно охнул от этой ласки и тоже кончил, щедро наполнив её ротик плотной струёй.'
                *pl 'Аманда послушно всё сглотнула, облизав перепачканные губы, пока Йенс медленно выходил из её влажного лона, оставляя на бёдрах молочные потёки. Обессилев, девушка опустилась на локти, тяжело переводя дыхание.'
                *pl '— Да блядь, я не такая! — сказала Аманда, - поэтому у меня сейчас сперма двух разных парней во рту и в пизде.'
            end

        elseif $Step = 'stage5_ready' or $Step = 'stage5_repeat':
            if BrothersScreen = 1:
                ! ЭТАП 5: Секс по очереди (киска и попка) — сам акт
                *pl 'В полумраке сарая братья укладывают Аманду на солому, решая проверить её по своим новым правилам.'
                *pl 'Сначала к ней опускается Йенс. Разведя девичьи бёдра, он без долгих прелюдий прижимает головку к её влажному лону и плавно входит, головка члена,проскальзывает между влажными губками Аманды. Девушка, почувствовав член растягивающий её киску, обхватывает парня ногами за поясницу и начинает двигаться навстречу его сильным, ритмичным толчкам.'
                *pl '— Завелась ты от нашего предложения? — спрашивает Йенс, всаживая ствол поглубже.'
                *pl 'Аманда протяжно стонет, ответ тут не требуется.'
                *pl 'Йенс насаживает её глубоко, заставляя сестру подмахивать ему навстречу. Спустя пару минут яростных фрикций он прижимается к ней всем телом и с глухим рыком изливает своё семя в самую глубину её девичего лона. Заставив пищать и Аманду, получившей свой оргазм'
                *pl 'Едва Йенс выходит, освобождая место брату, как Бруно поднимает ноги Аманды повыше, выставляя её круглую попку на обозрение. Он всаживает член в киску Аманды, и глядя на удивленное лицо Аманды говорит: - Для смазки, не по сухому же тебя драть, - сделав несколько фрикций во влажной щели запалненой спермой Йенса, он вынимает член а затем аккуратно приставляет головку своего члена к розовому анусу.'
                *pl '— Дыши глубже, детка, — шепчет Бруно, придерживая её за бёдра.'
                *pl 'Аманда прикусывает губу. Головка с влажным натяжением проталкивается в узкий проход. Сестра тихо вскрикивает от полноты в попке, но постепенно расслабляет мышцы, позволяя Бруно войти целиком.'
            else:
                ! ЭТАП 5: Секс по очереди (киска и попка) — окончание
                *pl 'Бруно начинает неторопливо двигаться в её попке, придерживая девушку за ноги. С каждым толчком темп нарастает, Аманда хрипло стонет и выгибается, Бруно двигает тазом, тараня анус девушки, пока не вбивает последний глубокий толчок, до упора заполняя её дырочку горячей спермой.'
                *pl 'Братья отступают, глядя, как из обеих дырочек запыхавшейся сестры медленно сочится белое семя.'
                *pl '— Ну вот... теперь все дырки проверили, — усмехается Аманда, с трудом садясь на сено и вытирая бёдра. — Настоящие черти.'
            end

        elseif $Step = 'stage6_ready' or $Step = 'stage6_repeat':
            if BrothersScreen = 1:
                ! ЭТАП 6: Минет двум сразу (оба ствола одновременно) — сам акт
                *pl 'Братья завели Аманду в полутёмный сарай, достали члены.'
                *pl 'Аманда опустилась перед ними на колени в солому. Йенс перемигнулся с братом и нагло подставил свой член рядом со стволом Бруно.'
                *pl '— Как две сосиски рядом, — хихикнула Аманда, — вот почему мамка кричала не бери по две сразу в рот, я думала она жадничает, а она думала о двух членах разом. Тоже видать покуролесила.'
                *pl 'Аманда успокоив себя что мамка у нее тоже не промах, открыла рот шире и попыталась взять оба сразу.'
                *pl 'Головки протиснулись между губ, и она начала старательно облизывать и посасывать их вместе.'
                *pl 'Одной рукой она задрала юбку, запустила пальцы под трусики и принялась быстро теребить свою мокрую пиздёнку. Чем глубже она пыталась заглотить оба члена, тем глубже работали её пальцы.'
            else:
                ! ЭТАП 6: Минет двум сразу (оба ствола одновременно) — окончание
                *pl 'Вид Аманды, сосущей сразу два хуя и дрочащей себе, добил братьев. Йенс первым глухо застонал и начал кончать ей прямо в рот. Бруно тут же последовал за ним, добавляя свою порцию. Густая сперма заполнила рот девушки.'
                *pl 'Два члена одновременно изливающиеся в рот и вкус на языке толкнули Аманду через край. Она сильно сжалась вокруг собственных пальцев и кончила.'
                *pl 'Девушка отстранилась, приоткрыла рот и показала братьям, сколько они туда настреляли. Языком она медленно перемешивала густую белую массу, вызывая у парней восторженные комментарии.'
                *pl '— Вот это ты шлюшка… — выдохнул Йенс.'
                *pl '— Глотай, солнышко, не слушай этого дебила — добавил Бруно.'
                *pl 'Аманда сглотнула всё до последней капли, потом тщательно вылизала и обсосала оба члена начисто. Поднявшись, она поправила свой наряд и строго сказала:'
                *pl '— Всё, идите уже. Мне теперь рот мыть надо, а то от меня спермой пахнет, мама сразу поймёт, что я кому-то отсосала.'
            end

        elseif $Step = 'stage7_ready' or $Step = 'stage7_repeat':
            if BrothersScreen = 1:
                ! ЭТАП 7: Двойное проникновение (вагинальное + анальное) — сам акт
                *pl 'Из укрытия ты видишь, как Аманда лежит на мягкой куче соломы, грудь тяжело вздымается. Братья склонились над ней с обеих сторон — Йенс спереди, Бруно сзади.'
                *pl 'Бруно уже между её разведённых бёдер. Он проводит языком по её пиздёнке, от клитора вниз, обводя вход во влагалище, а потом выше и касается языком сжатого анального колечка. Аманда вздрагивает, но Йенс целует, шепча в губы:'
                *pl '— Тихо, малышка… дыши глубоко… Вот так. Мы аккуратненько. Ты у нас умница…'
                *pl 'Его ладони гладят её грудь, сжимают соски, отвлекая. Бруно продолжает вылизывать её, чередуя нежные движения с толчками языка внутрь. Он смазывает её обильно — и попку, и киску, — пока Аманда не начинает дрожать и постанывать в рот Йенсу.'
                *pl 'Йенс отрывается от её губ только на секунду, чтобы лечь на спину в сено. Он подхватывает Аманду и усаживает её сверху, лицом к себе. Его твёрдый член уже стоит вертикально. Он направляет головку к её влажной пещерке и медленно входит в неё. Аманда выдыхает протяжный стон, когда он заполняет её полностью.'
                *pl 'Йенс тут же притягивает её грудью к своей, обхватывает руками и двигает бедрами — не давая ей сосредоточиться на том, что происходит сзади. Бруно встаёт на колени позади. Он разводит её ягодицы, приставляет головку своего члена. Нажимает осторожно. Йенс помогает ему руками, хватает попку Аманды и растягивает её в стороны.'
                *pl 'Аманда напрягается, пытается что-то сказать, но Йенс усиливает ласки — целует глубже, ускоряет движения члена, пронзая пиздёнку девушки.'
                *pl '— Расслабься… выдохни… — шепчет Йенс. — Всё будет хорошо, тебе понравится.'
                *pl 'Бруно, полюбовавшись на член, прижатый к анусу Аманды, давит сильнее. Головка медленно, с влажным звуком, протискивается внутрь. Аманда всхлипывает, пальцы впиваются Йенсу в плечи. Бруно замирает, давая ей привыкнуть. Потом подаётся ещё чуть вперёд. И ещё. Пока не входит почти полностью.'
                *pl 'Теперь Аманда нанизана на оба члена. Йенс снизу, Бруно сзади. Они чувствуют друг друга через тонкую стенку внутри неё. Братья переглядываются через её плечо и перемигиваются друг с другом, явно довольные происходящим.'
                *pl '— Во мне… два члена… одновременно… — явно шокированно произносит Аманда. — И мне это нравится.'
                *pl 'Сначала медленно. Йенс поднимает бёдра вверх, когда Бруно почти выходит, и наоборот. Короткие, синхронные толчки. Аманда стонет уже в полный голос — низко. Каждый раз, когда оба входят в неё одновременно, её тело выгибается дугой. Влажные звуки хлюпающих дырок и стоны троицы заполнили сарай.'
                *pl 'Постепенно ритм ускоряется. Братья трахают её уже жёстче. Йенс удерживает её за бёдра, не переставая двигаться, а Бруно впивается пальцами в ягодицы и вгоняет член до упора. Аманда больше не пытается сдерживаться. Она пытается подмахивать обоим, стонет, ругается сквозь зубы.'
            else:
                ! ЭТАП 7: Двойное проникновение (вагинальное + анальное) — окончание
                *pl 'Кульминация накрывает их почти одновременно. Йенс первым сжимает её сильнее, вбивает снизу несколько коротких толчков и кончает внутрь, низко рыча и обхватив её руками. Бруно ещё несколько секунд продолжает двигаться, чувствуя, как внутри неё пульсирует член брата, а потом и сам кончает — горячей спермой, заполняя её анус.'
                *pl 'Не выдержав двойного заполнения, Аманда, протяжно застонав, начинает биться в конвульсиях оргазма. Они медленно выходят из неё. Аманда безвольно оседает на сено, дрожащая, мокрая, из обеих дырочек вытекает сперма и стекает по бёдрам. Братья остаются рядом и смотрят, как девушка дрожит, всё ещё переживая оргазм.'
                *pl 'Переглянувшись опять и видимо что-то сказав друг другу без слов, они поднимают Аманду. Йенс подносит свой измазанный спермой и выделениями член к её губам. Аманда, сфокусировав взгляд, спокойно открывает рот и тщательно вылизывает его. Бруно, кинув взгляд на брата, подходит следом. Аманда на мгновение замирает, потом всё же открывает рот и начинает обсасывать член, который только что был у неё в попке.'
                *pl '— Молодец, крошка, мне понравилось, а тебе как? — покрутив свой член в руках, говорит Йенс.'
                *pl '— Меня никогда в жизни так не трахали, — покраснев немного, отвечает Аманда.'
                *pl '— Ха, Йенс же говорил, что тебе понравится, — смеётся Бруно. — В следующий раз сама нас сюда потащишь.'
                *pl '— Вот ещё, девушку надо уговаривать, а не наоборот, — возмущается ваша сестра, встав и ни капли не стесняясь братьев, принялась вытирать обе свои дырочки. — Идите, мне себя в порядок надо привести, мне ещё работать, а у меня ноги в раскоряку, натёрли мне всё, и сперма из обеих дырок течёт.'
            end

        elseif $Step = 'stage8_ready' or $Step = 'stage8_repeat':
            if AmandaBrothersTrained = 0:
                *pl 'Притаившись за бочками, вы наблюдаете за резким спором у сарая.'
                *pl 'Братья наперебой пытаются уговорить Аманду на одновременное проникновение в одну щёлку, расписывая неземные удовольствия.'
                *pl 'Но Аманда непреклонна: она яростно жестикулирует, упирается руками парням в грудь и наотрез отказывается рисковать собой:'
                *pl '— Сказала — нет! — доносится её звонкий возмущённый голос. — Порвёте пополам — кто меня лечить будет?! Марш по домам, балагуры!'
                *pl 'Сестра сердито хлопает дверью заднего хода трактира. Братья разочарованно переглядываются, почёсывая затылки, и не солоно хлебавши уходят в слободку.'
            else:
                if BrothersScreen = 1:
                    ! ЭТАП 8: Двойное вагинальное проникновение (два члена в одно лоно) — сам акт
                    *pl 'Вы становитесь свидетелем наивысшего пика чувственного бесстыдства — двойного вагинального проникновения.'
                    *pl 'На мягком шерстяном плаще среди душистого сена Аманда лежит на спине, широко разведя стройные ножки глядя на обоих парней.'
                    *pl 'Братья опускаются на колени перед ней. Обильно покрыв свои стволы густым маслом, они прижимают головки вплотную друг к другу.'
                    *pl 'Аманда глубоко дышит, полностью расслабляя мышцы таза по наставлениям сестры, и своими пальцами направляет оба мужских орудия в раскрывшийся вход своего женского лона.'
                    *pl 'Медленно, дюйм за дюймом, преодолевая упругое сопротивление растянутых стенок, оба члена протискиваются внутрь одной киски. Аманда шумно выдыхает, запрокидывая голову, её лицо озаряет торжествующая улыбка истинной госпожи их плоти.'
                    *pl 'Когда оба ствола погружаются до упора, сарай наполняется единым вздохом троих участников. Двигаясь в унисон, братья совершают короткие, плотные толчки, а Аманда стонет в голос, упиваясь своей невероятной женской силой и способностью вместить обоих сразу.'
                else:
                    ! ЭТАП 8: Двойное вагинальное проникновение — окончание
                    *pl 'Финальная вспышка накрывает их одновременно: издав победный стон, братья до упора вдавливаются в её бездонное нутро, щедро заливая его двойным потоком горячего семени. Аманда стонет в изнеможении, с победной улыбкой сжимая обоих любовников в своих объятиях.'
                    *pl 'Некоторое время в сарае слышно лишь их прерывистое, хриплое дыхание. Братья осторожно извлекают оба ствола, и из широко растянутой, подрагивающей щёлки Аманды обильно выплёскивается густая белая пена — смесь семени обоих братьев и её собственной девичьей влаги.'
                    *pl '— Ну что, мальчики... — с томной, властной улыбкой шепчет Аманда, поглаживая их по плечам. — Убедились, кто тут хозяйка? Теперь вы оба навеки мои.'
                    *pl 'Йенс и Бруно, ошалевшие от пережитого восторга, лишь согласно кивают, не в силах оторвать восхищённых взглядов от ненасытной красавицы.'
                end
            end
        end

    elseif $Choice = 'ignore':
        *pl 'Вы решаете не вмешиваться, позволяя братьям продолжать баловать сестру сладкими речами и заботой.'
        *pl 'Аманда замечает ваш удаляющийся силуэт — и понимает, что никто не станет осуждать её за стремление к ласке и вниманию.'
    end

    killvar '$Choice'
    killvar '$Step'
    killvar 'BrothersScreen'
---
