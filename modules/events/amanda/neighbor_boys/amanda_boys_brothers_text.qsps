! USER-OWNED TEXT
! Тексты ветки братьев-погодок (Йенс и Бруно)
!
! Визуальные ассеты:
! images/events/amanda/amanda_events/amanda_neighbor_boys_event — Братья и Аманда за сараем
! images/events/amanda/amanda_events/amanda_neighbor_boys_action — Исход встречи с братьями
! ================================================

#AmandaBoyBrothersEventText
    $Step = $ARGS[0]

    if $Step = 'early_refusal':
        *pl 'За сараем у телеги с сухим сеном слышатся оживлённые, вкрадчивые голоса.'
        *pl 'Братья-погодки Йенс и Бруно — румяные, крепкие парни из портовой слободы — взяли Аманду в полукольцо, не давая ей быстро ускользнуть к трактиру.'
        *pl 'Йенс придерживает сестру за талию, заглядывая в глаза с улыбкой, а Бруно осыпая девушку комплиментами:'
        *pl '— Амандочка, золотко, ну постой минутку... Куда ты вечно спешишь? Мы же соскучились, глаз от тебя отвести не можем!'
        *pl 'Но Аманда, хоть её щёки и вспыхивают густым смущённым румянцем от такого двойного внимания, упрямо скрещивает руки на груди и сверкает сердитыми глазами:'
        *pl '— А ну руки убрали! Ишь, как сладко заливаете! Вас двое, а я одна девушка, чтобы сразу с обоими за сарай ходить! Проваливайте!'

    elseif $Step = 'stage1_ready' or $Step = 'stage1_repeat':
        *pl 'Братья снова подкараулили Аманду на заднем дворе, но на этот раз они не отсупают.'
        *pl 'Йенс обнимает сестру за талию, пока Бруно вкрадчиво шепчет ей на самое ухо, рассеивая девичьи тревоги:'
        *pl '— Да полно тебе, Амандочка... Ну чего ты боишься? Разве мы тебя когда-нибудь обижали? Никто на тебя вдвоём не набросится, мы же обещали! Давай тихонечко, по очереди: Йенс сегодня с тобой поласкается, а я у калитки постою, покараулю, чтобы ни одна живая душа не помешала... А в следующий раз я буду первым!'
        *pl '— Если что не понравится, скажешь нет — вторит Йенс, — и мы тут же остановимся.'
        *pl 'Аманда кусает губы, бросая смущённые взгляды на парней, и под напором их сладких речей её сопротивление тает.'

    elseif $Step = 'stage2_ready' or $Step = 'stage2_repeat':
        *pl 'Аманда сидит на душистой соломе, раскрасневшаяся, в кольце рук. Братья окружили её с двух сторон, не оставляя места сомнениям.'
        *pl 'Йенс мягко обнимает её сзади прижимаясь к попке, целуя в шею, а Бруно опустился перед ней на колени:'
        *pl '— Вот видишь, как славно... —  шепчет Бруно, поднимая подол платья. — Не бойся нас, Амандочка, смотри какая карсота, у тебя тут, — не двавя опомнится он разводет твоей сестренке ноги, и целует, прямо туда.'
        *pl 'Сестра учащённо дышит, растворяясь в поглаживаниях и поцелуях, готовая отдатся обоими.'

    elseif $Step = 'stage3_ready' or $Step = 'stage3_repeat':
        *pl 'В густой тени сарая братья проявляют удивительную чуткость и терпение, зная, как волнуется Аманда перед новым шагом.'
        *pl 'Никакой спешки или неловких движений: Бруно согревает в ладонях немного душистого травяного масла, а Йенс бережно прижимает сестру к своей груди, убаюкивая её страхи поцелуями в макушку:'
        *pl '— Дыши спокойно, птичка наша, — шепчет Йенс, нежно оглаживая её спину. — Мы всё сделаем очень медленно и ласково. Ты только скажи, если станет тревожно, мы тут же остановимся...'
        *pl '— Ты у нас самая красивая, самая дорогая, — вторит Бруно, осторожно касаясь её бёдер тёплыми ладонями. — Мы с тебя пылинки сдувать будем.'
        *pl 'Аманда утыкается пылающим лицом в плечо Йенса, тихо всхлипывая от переполняющей её неги, полностью доверяясь братьям.'

    elseif $Step = 'stage4_ready' or $Step = 'stage4_repeat':
        *pl 'За поленницей слышатся приглушённые, шутливые уговоры братьев, наперебой ластящихся к Аманде.'
        *pl 'Парни не ссорятся, а словно соревнуются в нежности, стараясь заслужить благосклонный девичий взгляд.'
        *pl 'Йенс целует Аманду в щёку, бережно перебирая пряди её распущенных волос, пока Бруно с колен осыпает поцелуями её тонкие пальцы:'
        *pl '— Амандочка, ну скажи, кто из нас сегодня заботливее? Удели и мне минутку, золотко, погладь меня тоже!'
        *pl '— Не слушай его, милая, я тебе первый цветок принёс! Поцелуй меня первым!'
        *pl 'Аманда смущённо и счастливо смеётся, зажатая между двумя влюблёнными воздыхателями, чувствуя себя единственной и желанной.'

    elseif $Step = 'stage5_ready' or $Step = 'stage5_repeat':
        *pl 'В укромном закутке за сараем царит полумрак и трепетное молчание.'
        *pl 'Братья опустились перед Амандой на колени в пыльной траве, глядя на неё снизу вверх с нескрываемым благоговением и обожанием.'
        *pl '— Подари нам обоим радость, Амандочка, — тихо просит Йенс, бережно кладя ладони ей на колени. — Мы же от одной твоей улыбки с ума сходим. Позволь нам любить тебя вместе, никому ни слова не скажем...'
        *pl '— Мы твои верные защитники навек, — ласково добавляет Бруно, целуя край её передника. — Только коснись нас, сделай счастливыми.'
        *pl 'Аманда с томным вздохом опускает руки на их головы, перебирая пальцами светлые вихры, упиваясь своей безграничной властью.'

    elseif $Step = 'stage6_ready' or $Step = 'stage6_repeat':
        *pl 'У задней стены дровяника роли окончательно переменились: Аманда мягко, но уверенно направляет братьев, а те послушно ловят каждый её вздох.'
        *pl 'Стоя между ними, сестра ласково прижимает ладонь к груди Йенса, а вторую руку кладёт на плечо Бруно:'
        *pl '— Ну-ка, угомонитесь оба... — с мягкой девичьей властностью шепчет она, улыбаясь раскрасневшимся парням. — Никакой суеты. Йенс, ты постой рядышком, приобними меня за талию и поцелуй в шейку... А ты, Бруно, будь первым, но очень чутко и осторожно. Кто будет ласковее всех — того и награда.'
        *pl 'Братья преданно кивают, готовые на всё ради её довольной улыбки.'

    elseif $Step = 'stage7_ready' or $Step = 'stage7_repeat':
        *pl 'За сараем братья заботливо приготовили для Аманды мягкое ложе из свежей охапки сена, укрыв его чистым шерстяным плащом.'
        *pl 'Они не спорят и не делят очередь — между ними царит полное согласие и единое желание окружить девушку безграничной нежностью.'
        *pl '— Ложись, наше золотко, — бережно поддерживает её под локоток Йенс. — Мы всё сделаем так, как ты сама захочешь, сладко и бережно.'
        *pl '— Ты у нас самая смелая и прекрасная на всём белом свете, — шепчет Бруно, нежно гладя её по раскрасневшимся щекам.'
        *pl 'Аманда с доверчивой улыбкой опускается на плащ, готовая к полному единению с двумя преданными воздыхателями.'
    end

    killvar '$Step'
---

#AmandaBoyBrothersActionText
    $Choice = $ARGS[0]
    $Step = $ARGS[1]

    if $Choice = 'send_away':
        *pl 'Вы с суровым окриком вышагиваете из-за угла сарая:'
        *pl '— А ну брысь отсюда оба, пока я вам бока не намял!'
        *pl 'Братья — застигнутые врасплох, шарахаются назад, переглядываются и начинают спектакль:'
        *pl '— Да мы ничего, Стефан, видит Ильматер! Мы только поговорить, Амандочке помочь по хозяйству хотели!..'
        *pl 'Парни бочком проскальзывают мимо вас и быстро исчезают в переулке. Аманда же с досадой одёргивает подол, уперев руки в бока:'
        *pl '— Ну вот вечно ты все портишь! — с упрёком бросает она. — Они такие ласковые были, ни одного грубого слова не сказали... Вечно тебе надо всё испортить! — и, топнув ножкой, убегает в трактир.'

    elseif $Choice = 'ask':
        *pl 'Когда братья с вежливыми улыбками и тихими вздохами растворяются в переулке, вы подходите к сестре:'
        *pl '— И о чём это вы тут так сладко ворковали в три голоса?'
        *pl 'Аманда густо краснеет, теребя завязки передника, но в её глазах пляшут кокетливые озорные искорки:'
        *pl '— Они просто очень обходительные, Стефан... Не то что некоторые увальни в зале. Они говорили что я самая красивая и за руки держали, ну не только за руки, конечно. Но неужели девушке нельзя немного личного пространства?'

    elseif $Choice = 'watch_stage1_screen1':
        *pl 'Притаившись в тени навеса, вы наблюдаете за падением барьеров.'
        *pl 'Аманда соглашается на уговоры братьев: Бруно отходит к калитке, не отрывая взгляда от происходящего.'
        *pl 'Йенс подводит Аманду к сену, осыпая её лицо и шею нежными поцелуями. Не давая опомниться, он поворачивает её к себе попкой, задирает подол и стягивает панталончики. Девушка тихо охает, выставляя попку на обозрение; голая влажная пещерка сестры блестит смазкой.'
        *pl 'Йенс улыбается и, приставив член к вагине сестры, медленно, но уверенно вводит свой твердый член. Она вскрикивает, прижавшись попкой теснее к парню.'
        *pl 'Йенс начинает двигаться, медленно и глубоко, проникая всё дальше. Аманда извивается под его напором. Каждый толчок сопровождается глухим хлюпом, и ты видишь, как она закрывает глаза, отдаваясь наслаждению.'
        *pl 'Бруно внимательно наблюдает за происходящим. Он, не сводя взгляда с Аманды, начинает мастурбировать. Ты слышишь, как его дыхание становится всё более тяжёлым, и он жадно смотрит на Аманду, наслаждаясь её стонами, раскинутыми ножками и звуками хлюпающей киски.'
        *pl 'Стоны Аманды становятся чаще и громче. Йенс увеличивает скорость и глубину проникновений и, глухо застонав, заливает пиздёнку твоей сестры своей спермой. Аманда, почувствовав в себе сперму, заголосила в оргазменном стоне, подавшись назад и стараясь, чтобы член вошёл как можно глубже.'
        *pl 'Дрожа от оргазма, она падает головой в солому телеги.'

    elseif $Choice = 'watch_stage1_screen2':
        *pl 'Бруно, не прекращая дрочить, отодвигает брата. Член Йенса выходит из Аманды с лёгким хлюпом, открыв тебе и братьям вид на обе дырочки сестры. Из раскрытой дырки между стройных ножек тут же начинает сочиться сперма, капая на солому.'
        *pl '— Так, теперь моя очередь, — говорит второй брат и, сжав попку свободной рукой, то раздвигая, то отпуская обратно, жадно смотрит на раскрывающиеся дырочки.'
        *pl 'Аманда что-то протестующе промычала, но, похоже, вовсе не собиралась сопротивляться, оставив попку во власти Бруно. Парень, направив член, со стоном начал изливаться, покрывая дырочки Аманды дополнительной порцией семени.'
        *pl 'Немного придя в себя, Аманда принялась чиститься от спермы парней и возмущаться:'
        *pl '— Обещали одно, а сперму я от обоих из письки вытираю!'
        *pl '— Не дуйся, солнышко, хорошо же вышло! — ухмыляется парень. — Все довольны, у всех теперь хорошее настроение. В следующий раз сделаем как ты скажешь. К тому же ты не сказала остановиться.'

    elseif $Choice = 'watch':
        if $Step = 'early_refusal':
            *pl 'Притаившись за бочками, вы наблюдаете, как Аманда отбивается от сладких уговоров братьев.'
            *pl 'Парни наперебой сулят ей любовь и ласку и обещают носить на руках, но сестра, хоть и хихикает польщённо, упрямо пятится к двери:'
            *pl '— Хватит заливать соловьями! Сказала же — по домам идите, балагуры!'
            *pl 'Она ловко выскальзывает из их кольца и убегает к трактиру. Братья лишь вздыхают с улыбками, провожая её похотливыми взглядами.'

        elseif $Step = 'stage1_ready' or $Step = 'stage1_repeat':
            gt 'AmandaBoyBrothersWatchStage1'

        elseif $Step = 'stage2_ready' or $Step = 'stage2_repeat':
            *pl 'Сквозь щели в досках сарая вам открывается картина глубокой чувственности и взаимной заботы.'
            *pl 'Йенс согревает Аманду сзади, бережно удерживая её в объятиях и мерно покачивая, пока Бруно опустился перед ней на колени, осыпая ласками её губы и щёки.'
            *pl '— Какая же ты сладкая, Амандочка... — шепчет Бруно меж поцелуями. — Самая желанная наша девочка.'
            *pl 'Сестра блаженно прикрывает глаза, разделяя ласку между обоими братьями, отдаваясь двойному потоку тепла и нежности без остатка.'

        elseif $Step = 'stage3_ready' or $Step = 'stage3_repeat':
            *pl 'Из укрытия за штабелем досок вы видите, с каким трепетом братья готовят Аманду к новому опыту.'
            *pl 'Бруно ласково растирает душистое масло по её нежной коже, согревая каждый изгиб девичьего тела, а Йенс непрерывно целует её в висок, успокаивая частое дыхание:'
            *pl '— Тихо, маленькая наша, дыши глубоко... Вот так, умница, мы очень бережно...'
            *pl 'Аманда постепенно расслабляется, доверяя братьям каждую частичку себя, и вскоре её испуганный шёпот сменяется стонами сладкого облегчения.'

        elseif $Step = 'stage4_ready' or $Step = 'stage4_repeat':
            *pl 'Притаившись в полумраке, вы наблюдаете трогательное соревнование братьев за внимание сестры.'
            *pl 'Они не толкаются и не спорят грубо — каждый стремится быть самым чутким, осыпая Аманду ласковыми прикосновениями, целуя её ладони, плечи и ключицы.'
            *pl 'Аманда млеет от этого тихого, сладкого внимания, поочерёдно одаривая братьев поцелуями и улыбками, наслаждаясь своей властью над их горячими сердцами.'

        elseif $Step = 'stage5_ready' or $Step = 'stage5_repeat':
            *pl 'Вы видите, как Аманда опустилась на колени меж двумя братьями в золотистом полумраке сарая.'
            *pl 'Она бережно и любовно уделяет внимание обоим парням сразу, гладя их сильные плечи и осыпая ласками, а Йенс и Бруно трепетно перебирают её волосы, не сводя с неё влюблённых глаз.'
            *pl 'Их сбивчивое, горячее дыхание и тихие слова признаний сливаются в единую песнь благодарности и восторга.'

        elseif $Step = 'stage6_ready' or $Step = 'stage6_repeat':
            *pl 'Сквозь щели сарая видно, как Аманда виртуозно руководит обоими воздыхателями.'
            *pl 'Она нежно распределяет их ласки, заставляя парней двигаться в её собственном неторопливом ритме. Братья беспрекословно слушаются каждого девичьего вздоха, боясь разрушить хрупкую гармонию момента.'
            *pl 'Когда они замирают в долгой кульминации, Аманда лежит в их объятиях с тихой, умиротворённой улыбкой истинной госпожи их сердец.'

        elseif $Step = 'stage7_ready' or $Step = 'stage7_repeat':
            *pl 'Вы становитесь свидетелем удивительного финала: на мягком шерстяном плаще среди сена братья и Аманда сливаются в абсолютном доверии.'
            *pl 'Благодаря спокойствию и чуткой заботе братьев, всё происходит плавно, глубоко и без малейшей боли.'
            *pl 'Сарай наполняется тихим шёпотом ласковых признаний, прерывистым дыханием и блаженными вздохами Аманды, согретой двойным потоком любви и тепла.'
            *pl 'Когда братья бережно укрывают уставшую сестру плащом и целуют её сонные веки, в их движениях сквозит безграничная преданность.'
        end

    elseif $Choice = 'ignore':
        *pl 'Вы решаете не вмешиваться, позволяя братьям продолжать баловать сестру сладкими речами и заботой.'
        *pl 'Аманда замечает ваш удаляющийся силуэт — и понимает, что никто не станет осуждать её за стремление к ласке и вниманию.'
    end

    killvar '$Choice'
    killvar '$Step'
---

#AmandaBrothersNightTalkMelissaText
    $NightStep = $ARGS[0]

    if $NightStep = 'talk1':
        *pl 'Ночной коридор второго этажа залит лунным светом. Вы бесшумно ступаете по половицам и замираете у приоткрытой двери Мелиссы.'
        *pl 'Внутри горит тусклая масляная лампа. Аманда сидит на краю кровати сестры, нервно комкая ночную сорочку на коленях.'
        *pl 'Мелисса сидит за столом над объёмистым фолиантом, поверх очков строго и с лёгкой иронией глядя на младшую сестру:'
        *pl '— ...Ты совершенно потеряла голову, Аманда? — с язвительным изумлением произносит Мелисса. — С двумя братьями-погодками? Они же ходят за тобой как привязанные щенки и заглядывают в рот каждому твоему слову!'
        *pl '— Мелисса, пожалуйста!.. — умоляюще шепчет Аманда, заливаясь густым румянцем. — Они такие ласковые, они стихи мне читают и руки целуют... Но они оба хотят быть со мной одновременно! А я боюсь, что моё тело не справится... Ты ведь столько умных книг прочитала! Помоги мне понять, как расслабить мышцы и подготовить тело, чтобы не было больно!'
        *pl 'Мелисса с сухим хлопком закрывает книгу и насмешливо складывает руки на груди:'
        *pl '— Ильматер всеблагой, какая трогательная пастораль! Два портовых воздыхателя напели ей в уши соловьиных трелей, и вместо того, чтобы думать о семейной чести, она пришла ко мне на лекцию по прикладной физиологии! Марш спать, пока я матушке не рассказала про твоих обожателей!'
        *pl 'Аманда всхлипывает, прячет лицо в ладонях и поспешно выбегает в коридор. Вы успеваете скрыться в тени лестницы.'

    elseif $NightStep = 'talk2':
        *pl 'Спустя несколько ночей в коридоре снова слышатся осторожные шаги — Аманда опять пробирается в комнату Мелиссы.'
        *pl 'Прильнув к дверной щели, вы видите, что на этот раз младшая сестра держится куда увереннее.'
        *pl '— Мелисса, выслушай меня серьёзно, — настойчиво шепчет Аманда. — Ты же сама говорила, что знание должно служить делу, а не пылиться на полках! Они всё равно не отстанут, да и я сама этого хочу. Но без правильной науки я могу пораниться! Ты ведь читала столичные медицинские трактаты о женской анатомии и мышечной эластичности? Научи меня, как правильно дышать и подготавливать связки шаг за шагом!'
        *pl 'Мелисса замирает, окинув сестру долгим, оценивающим взглядом. В её строгих глазах пробивается исследовательский азарт и тайное любопытство книжной всезнайки:'
        *pl '— Хм... Апелляция к авторитету медицинских трактатов? Признаю, звучит на удивление разумно для твоей ветреной головки, — медленно произносит Мелисса, поправляя очки. — Если уж ты твёрдо вознамерилась потакать этим двум воздыхателям, то лучше подойти к делу со строгим научным расчётом, чем калечить себя по глупости.'
        *pl 'Мелисса достаёт чистый лист бумаги и чернильницу:'
        *pl '— Садись прямо и слушай меня предельно внимательно. Начнём с механики диафрагмального дыхания и постепенного расслабления тазового пояса. Повторять будешь строго по моим инструкциям — никакой самодеятельности!'
        *pl 'Аманда с горячей благодарностью обнимает сестру. Вы тихо отступаете обратно в спальню, поражённый услышанным научным сговором.'
    end

    killvar '$NightStep'
---
