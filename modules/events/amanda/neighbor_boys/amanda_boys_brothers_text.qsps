! ================================================
! FILE: modules/events/amanda/neighbor_boys/amanda_boys_brothers_text.qsps
! MODULE: events/amanda/neighbor_boys
! [AI-WORKED] Текст переработан / дополнен ассистентом 13.09.2026
! USER-OWNED TEXT
! Тексты ветки братьев-погодок (Йенс и Бруно)
!
! Визуальные ассеты:
! images/events/amanda/amanda_events/amanda_neighbor_boys_event — Братья и Аманда за сараем
! images/events/amanda/amanda_events/amanda_neighbor_boys_action — Исход встречи с братьями
! ================================================

#AmandaBoyBrothersEventText
    $Step = $ARGS[0]

    if $Step = 'early_refusal':
        *pl 'За сараем у телеги слышится оживлённый мужской гомон.'
        *pl 'Братья-погодки Йенс и Бруно, двое жилистых и нахальных парней из портовой слободки, взяли Аманду в плотное полукольцо.'
        *pl 'Один дерзко держит её за локоток, второй заглядывает за корсаж, осыпая девушку плоскими дворовыми шуточками. Но Аманда упрямо скрещивает руки на груди и сверкает сердитыми глазами:'
        *pl '— А ну руки убрали, кобели! Вас двое, а я не портовая шлюха, чтобы сразу с обоими хороводы водить! Проваливайте!'
    elseif $Step = 'stage1_ready' or $Step = 'stage1_repeat':
        *pl 'Братья снова подстерегли Аманду в тупике за поленницей, но на этот раз тон разговора совсем иной.'
        *pl 'Почувствовав в сестре зрелую слабину, парни берут её в оборот ласковым напором:'
        *pl '— Да брось ты, Амандочка, никто тебя вдвоём терзать не станет! Давай по-честному, по очереди: Йенс с тобой забавляется, а я просто рядом постою, покараулю, чтоб никто не вошёл... А в следующий раз я буду первым!'
        *pl 'Аманда нервно кусает губы, бросая взгляд на распущенные пояса парней, и её щеки заливает смущённый, порочный румянец.'
    elseif $Step = 'stage2_ready' or $Step = 'stage2_repeat':
        *pl 'В глубине дровяника царит полумрак и сдавленный, жадный шёпот.'
        *pl 'Братья уже не скрывают своих намерений: правила приличия отброшены, а Аманда стоит на четвереньках на охапке свежего сена, раскрасневшаяся и податливая.'
        *pl 'Йенс уже пристроился сзади, а Бруно опустился на колени перед её лицом, настойчиво требуя ласки.'
    elseif $Step = 'stage3_ready' or $Step = 'stage3_repeat':
        *pl 'За сараем братья уже не стесняются: они окружили Аманду вдвоём, отрезав всякий путь к отступлению.'
        *pl 'Йенс прижимает её сзади, а Бруно встает вплотную спереди, требуя ласки от раскрасневшейся сестры.'
        *pl '— Хватит капризничать, Аманда, — ухмыляется Бруно. — Сегодня ты принадлежишь нам обоим разом!'
    elseif $Step = 'stage4_ready' or $Step = 'stage4_repeat':
        *pl 'В дальнем углу двора слышатся приглушённые препирательства братьев.'
        *pl 'Йенс и Бруно жадно делят внимание сестры, хватая её за руки и споря, чья очередь быть первым.'
        *pl 'Аманда тяжело дышит, зажатая между двумя распалёнными парнями, и пытается их утихомирить:'
        *pl '— Тише вы оба!.. Если Стефан или матушка услышат, вам не сносить головы!'
    elseif $Step = 'stage5_ready' or $Step = 'stage5_repeat':
        *pl 'За поленницей царит напряжённое, горячее молчание.'
        *pl 'Братья на этот раз требуют одновременной покорности: оба подошли к Аманде плечом к плечу, не желая уступать ни пяди.'
        *pl '— Давай, милая, — шепчет Йенс, — покажи, как ловко ты умеешь управляться с двумя сразу!'
    elseif $Step = 'stage6_ready' or $Step = 'stage6_repeat':
        *pl 'За сараем разгорается настоящая ссора: парни толкают друг друга в грудь, не желая уступать право первого удара.'
        *pl '— Я старше, я первый! — рычит Йенс.'
        *pl '— А в прошлый раз ты уже был первым! — огрызается Бруно.'
        *pl 'Аманда с румянцем на щеках решительно встаёт между ними, кладя ладони обоим на плечи:'
        *pl '— Замолчите оба! Я сама решу, кто пойдёт первым, а кто вторым... иначе оба останетесь ни с чем!'
    elseif $Step = 'stage7_ready' or $Step = 'stage7_repeat':
        *pl 'За сараем братья снова сцепились в яростном споре, хватая друг друга за грудки и оглашая задворки бранью.'
        *pl 'Каждый из них упрямо требует быть первым, забыв обо всякой осторожности.'
        *pl 'Аманда с вызовом складывает руки на груди, властно повышая голос:'
        *pl '— Хватит собачиться! Никакой очереди не будет. Если хотите быть со мной — сегодня войдёте оба разом!'
        *pl 'Йенс и Бруно замирают с открытыми ртами, ошеломлённые неслыханной девичьей дерзостью.'
    end

    killvar '$Step'
---

#AmandaBoyBrothersActionText
    $Choice = $ARGS[0]
    $Step = $ARGS[1]

    if $Choice = 'send_away':
        *pl 'Вы с суровым окриком вышагиваете из-за угла:'
        *pl '— А ну брысь отсюда оба, пока я вам хребты не переломал!'
        *pl 'Братья слаженно шарахаются в стороны, на ходу подтягивая портки, злобно огрызаются сквозь зубы и быстро растворяются в переулках.'
        *pl 'Аманда сердито одёргивает подол и с обидой бросает: «Вечно ты всё портишь!» — после чего убегает в кухню.'

    elseif $Choice = 'ask':
        *pl 'Когда братья с насмешливым посвистом уходят, вы подходите к сестре:'
        *pl '— И что за интерес крутиться сразу с двумя?'
        *pl 'Аманда отводит глаза, но в её голосе звучит вызов:'
        *pl '— Они просто хвастались, Стефан. Я прекрасно знаю, как поставить таких наглецов на место!'

    elseif $Choice = 'watch':
        if $Step = 'early_refusal':
            *pl 'Вы наблюдаете из-за угла, как Аманда решительно отталкивает обоих братьев:'
            *pl '— Сказала же — пошли вон! Не дождётесь!'
            *pl 'Она ловко выскальзывает меж парнями и быстрым шагом спешит к трактиру. Братья лишь досадливо сплёвывают в пыль, провожая её взглядами.'

        elseif $Step = 'stage1_ready' or $Step = 'stage1_repeat':
            *pl 'Притаившись за бочками, вы следите за падением очередного запрета.'
            *pl 'Аманда соглашается на уговоры: Бруно покорно отходит к калитке, жадно наблюдая, как Йенс обнимает девушку.'
            *pl 'Прижав девушку грудью к телеге, Йенс мерно и глубоко ласкает её податливое тело. Аманда глухо стонет в солому, сгорая от стыда под немигающим взглядом второго брата, но этот взгляд свидетеля лишь распаляет её страсть до предела.'
            *pl 'Когда Йенс шумно выдыхает в кульминации, Аманда судорожно вздрагивает в оргазме, а Бруно довольно ухмыляется: «Молодец, девка... в следующий раз очередь за мной!»'

        elseif $Step = 'stage2_ready' or $Step = 'stage2_repeat':
            *pl 'Сквозь щели сарая вам открывается зрелище полного разврата.'
            *pl 'Йенс насаживает Аманду сзади, ухватив её за бёдра, а Бруно опускается перед её лицом, требуя уступок:'
            *pl '— Ну же, милая, открой ротик... уважь и второго братца!'
            *pl 'Аманда затуманенными глазами смотрит на него, сладко стонет от толчков сзади и послушно распахивает губы.'
            *pl 'Под сдавленные вздохи и глухие стоны братья упиваются своей общей добычей, поочерёдно меняясь местами и изливая страсть в её ненасытное тело.'

        elseif $Step = 'stage3_ready' or $Step = 'stage3_repeat':
            *pl 'Из-за штабеля досок вам открывается сцена полного подчинения Аманды.'
            *pl 'Братья действуют слаженно и безжалостно: Йенс берет её сзади, а Бруно ласкает её спереди, заполняя всё девичье тело.'
            *pl 'Аманда глухо стонет, зажмурившись от переполняющего её стыда и острого, запретного жара, отдаваясь обоим братьям одновременно.'
            *pl 'Парни упиваются властью над трактирной дочкой, пока оба не содрогаются в общей кульминации.'

        elseif $Step = 'stage4_ready' or $Step = 'stage4_repeat':
            *pl 'Притаившись в тени, вы видите, как братья продолжают делить девушку прямо во время близости.'
            *pl 'Они яростно спорят за право завершить ласку, толкая друг друга и сменяя позиции, пока Аманда послушно принимает их страсть.'
            *pl 'Наконец, оба шумно и жадно кончают, едва не затеяв драку из-за того, кому досталось больше девичьего внимания.'
            *pl 'Аманда сидит на охапке соломы, растрёпанная и обессиленная, чувствуя на себе последствия их бурной ревности.'

        elseif $Step = 'stage5_ready' or $Step = 'stage5_repeat':
            *pl 'Вы наблюдаете, как Аманда опускается перед братьями на колени в пыльном полумраке сарая.'
            *pl 'С поразительным старанием она уделяет внимание обоим парням по очереди, осыпая их ласками и не давая поводов для обид.'
            *pl 'Йенс и Бруно шумно дышат, зарываясь пальцами в её растрёпанные волосы, пока оба одновременно не содрогаются от мощного наслаждения.'

        elseif $Step = 'stage6_ready' or $Step = 'stage6_repeat':
            *pl 'Вы видите, как Аманда берёт ситуацию в свои руки, виртуозно усмиряя горячность братьев.'
            *pl 'Она властным жестом указывает Йенсу приготовиться первым, а Бруно заставляет терпеливо ждать своей очереди, успокаивая его поцелуем.'
            *pl 'Один за другим братья овладевают ею, изливая всю скопившуюся похоть глубоко в её разгорячённое нутро.'
            *pl 'Когда они уходят, пошатываясь от усталости, Аманда медленно поправляет юбки. В её взгляде сквозит глубокая тревога от того, как далеко зашла эта опасная игра.'

        elseif $Step = 'stage7_ready' or $Step = 'stage7_repeat':
            *pl 'Притаившись за бочками, вы становитесь свидетелем невероятного финала соперничества братьев.'
            *pl 'Опешившие от предложения девушки, Йенс и Бруно отбрасывают рознь и слаженно укладывают Аманду на охапку душистого сена.'
            *pl 'Благодаря тайным наставлениям и подготовленности, сестра принимает обоих братьев одновременно. Сарай наполняется их тяжёлым дыханием и сдавленными стонами Аманды, разделяющей ласки между обоими парнями.'
            *pl 'Братья содрогаются в общей сокрушительной кульминации, окончательно покорённые её бесстрашием и ненасытностью.'
            *pl 'Когда они, ошарашенные и присмиревшие, убираются со двора, Аманда лежит на сене с затуманенной, торжествующей улыбкой.'
        end

    elseif $Choice = 'ignore':
        *pl 'Вы делаете вид, что ничего не заметили, давая событиям развиваться своим чередом.'
        *pl 'Аманда ловит ваш удаляющийся силуэт — и понимает, что преград для безумных экспериментов больше не существует.'
    end

    killvar '$Choice'
    killvar '$Step'
---

#AmandaBrothersNightTalkMelissaText
    $NightStep = $ARGS[0]

    if $NightStep = 'talk1':
        *pl 'Ночной коридор второго этажа залит лунным светом. Вы бесшумно ступаете по половицам и замираете у приоткрытой двери Мелиссы.'
        *pl 'Внутри горит тусклая масляная лампа. Аманда сидит на краю кровати сестры, нервно комкая ночную сорочку на коленях.'
        *pl 'Мелисса сидит за столом над книгой, поверх очков строго глядя на взволнованную сестру:'
        *pl '— ...Ты совсем рассудок потеряла, Аманда? — с язвительным изумлением произносит Мелисса. — С двумя братьями-погодками? Они же глупы как пробки и передерутся прямо у нас под окнами!'
        *pl '— Мелисса, пожалуйста!.. — умоляюще шепчет Аманда, заливаясь густым румянцем. — Они мне нравятся оба, но они постоянно ссорятся из-за очереди! Они толкаются и тянут меня каждый к себе... Помоги мне, сестрёнка! Ты ведь столько всего знаешь... помоги мне подготовить и растянуть тело, чтобы я могла принять обоих и они перестали драться!'
        *pl 'Мелисса с грохотом захлопывает книгу и вскакивает из-за стола, уперев руки в бока:'
        *pl '— Видит Ильматер, это уже за гранью любого безумия! Я не собираюсь потакать твоим диким выходкам с портовой шантрапой! А ну марш к себе в комнату, пока я матушке всё не рассказала!'
        *pl 'Аманда всхлипывает, прячет лицо в ладонях и, понурив голову, выбегает в коридор. Вы успеваете скрыться в тени лестницы.'

    elseif $NightStep = 'talk2':
        *pl 'Спустя несколько ночей в коридоре снова слышатся осторожные шаги — Аманда опять пробирается в комнату Мелиссы.'
        *pl 'Прильнув к дверной щели, вы видите, что на этот раз младшая сестра настроена куда решительнее.'
        *pl '— Мелисса, послушай меня, — настойчиво шепчет Аманда. — Я же не просто так прошу! Я могу познакомить тебя с хорошими, крепкими парнями... даже с кузнецом Питером, у которого силища нечеловеческая и инструмент как у жеребца!'
        *pl 'Мелисса насмешливо фыркает, скрещивая руки на груди:'
        *pl '— О, какая щедрость! Вот пусть этот твой кузнец-великан тебя и растягивает, раз он такой могучий!'
        *pl 'Аманда опускает глаза, краснея до самых кончиков ушей, и тихо признаётся:'
        *pl '— Я... я уже пробовала с ним, Мелисса. Но он слишком огромен! Без тренировок и правильной подготовки это просто пытка... Пожалуйста! Ты ведь сама читала трактаты о женском теле. Если ты мне не поможешь научиться расслаблять мышцы шаг за шагом — я же покалечусь!'
        *pl 'Мелисса замирает, поражённая смелостью признания сестры. В её взгляде сквозь строгую маску пробивается научное любопытство и тайный азарт.'
        *pl '— Ильматер всеблагой... ты действительно не остановишься, — медленно произносит Мелисса. — Ладно. Садись на кровать и слушай меня очень внимательно. Будем делать всё строго по правилам, поэтапно — от одного пальца до кулака, чтобы ткани успевали привыкать. И если пикнешь от боли — сразу прекращаем.'
        *pl 'Аманда с горячей благодарностью обнимает сестру. Вы тихо отступаете обратно в спальню, поражённый услышанным сговором.'
    end

    killvar '$NightStep'
---
