! ================================================
! FILE: modules/events/amanda/neighbor_boys/amanda_neighbor_boys.qsps
! MODULE: events/amanda/neighbor_boys
! Ветка: Соседские парни (Ганс, Курт, Феликс) на заднем дворе трактира
! ================================================

#CheckAmandaEvents

    if $CurrentGirl <> 'amanda':
        exit
    end

    if LOC('AmandaNeighborBoysTryStart') = 1:
        gs 'AmandaNeighborBoysTryStart'
    end

    tmp = Rand(1, 100)

    if tmp <= 25 and AmandaVar['lizafriends'] >= 1 and otkroven['amanda'] >= 20 and AmandaVar['liza_event_shown'] = 0:
        AmandaVar['liza_event_shown'] = 1
        *pl '=== ОСОБОЕ СОБЫТИЕ ==='
        *p 'Аманда краснеет и тихо говорит тебе на ушко:'
        *p '"Стефан... Лиза вчера спрашивала про тебя... Она сказала, что ты очень... интересный."'
        *p 'Аманда смущённо отводит взгляд.'
        Friends['amanda'] += 2
        otkroven['amanda'] += 3
        gs 'CorruptionProgress', 'amanda', 'talk'
        gs 'ActUiPrepare', 'Продолжить', 'generic'
        act $ActUiLabel, $ActUiIconPath: exit
    end

    if tmp <= 40 and otkroven['amanda'] >= 30 and sluttiness['amanda'] >= 25 and AmandaVar['amanda_initiative'] = 0:
        AmandaVar['amanda_initiative'] = 1
        *pl '=== ОСОБОЕ СОБЫТИЕ ==='
        *p 'Аманда вдруг сама подходит ближе и тихо шепчет:'
        *p '"Я... я иногда думаю о тебе по ночам..."'
        *p 'Её щёки горят, она быстро отворачивается.'
        Friends['amanda'] += 4
        otkroven['amanda'] += 5
        gs 'CorruptionProgress', 'amanda', 'flirt'
        gs 'ActUiPrepare', 'Продолжить', 'generic'
        act $ActUiLabel, $ActUiIconPath: exit
    end

    if tmp <= 55 and (jobwaitress['amanda'] = 1 or jobwhore['amanda'] = 1) and sluttiness['amanda'] < 40:
        *pl '=== ОСОБОЕ СОБЫТИЕ ==='
        *p 'Пьяный посетитель слишком нагло прижал Аманду к стене и пытается засунуть руку ей под юбку.'
        *p 'Аманда выглядит очень испуганной и пытается вырваться.'
        Friends['amanda'] -= 2
        gs 'ActUiPrepare', 'Вмешаться', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            *p 'Ты резко оттаскиваешь мужчину.'
            Friends['amanda'] += 5
            gs 'ActUiPrepare', 'Продолжить', 'generic'
            act $ActUiLabel, $ActUiIconPath: exit
        end
        gs 'ActUiPrepare', 'Не вмешиваться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gs 'CorruptionProgress', 'amanda', 'flirt'
            gs 'ActUiPrepare', 'Продолжить', 'generic'
            act $ActUiLabel, $ActUiIconPath: exit
        end
    end

    if tmp <= 70 and otkroven['amanda'] >= 35 and AmandaVar['secret_shared'] = 0:
        AmandaVar['secret_shared'] = 1
        *pl '=== ОСОБОЕ СОБЫТИЕ ==='
        *p 'Аманда неожиданно говорит:'
        *p '"Знаешь... я иногда представляю, как ты меня целуешь... когда остаюсь одна в комнате."'
        *p 'Она тут же закрывает лицо руками от стыда.'
        otkroven['amanda'] += 6
        Friends['amanda'] += 3
        gs 'CorruptionProgress', 'amanda', 'talk'
        gs 'ActUiPrepare', 'Продолжить', 'generic'
        act $ActUiLabel, $ActUiIconPath: exit
    end

    if tmp <= 85 and otkroven['amanda'] >= 40 and sluttiness['amanda'] >= 35:
        *pl '=== ОСОБОЕ СОБЫТИЕ ==='
        *p 'Аманда сама подходит к тебе ближе, чем обычно, и тихо говорит:'
        *p '"Ты сегодня очень хорошо выглядишь..."'
        *p 'Она краснеет и быстро отходит.'
        Friends['amanda'] += 3
        gs 'CorruptionProgress', 'amanda', 'flirt'
        gs 'ActUiPrepare', 'Продолжить', 'generic'
        act $ActUiLabel, $ActUiIconPath: exit
    end

    exit
---

#AmandaNeighborBoysCanStart

    AmandaNeighborBoysCanStart = 0

    if AmandaLegareFirstSexDone = 0 and AmandaPlayerAlleySexEver = 0 and AmandaHomeSex = 0:
        exit
    end

    if AmandaNeighborBoysStage >= 3:
        exit
    end

    if AmandaProhibitGuys = 1:
        exit
    end

    if AmandaNeighborBoysToday = 1:
        exit
    end

    if time < 3:
        exit
    end

    if sluttiness['amanda'] < 15 and AmandaNpcPath < 12:
        exit
    end

    AmandaNeighborBoysCanStart = 1
---

#AmandaNeighborBoysTryStart

    AmandaNeighborBoysStarted = 0

    if LOC('AmandaNeighborBoysCanStart') = 1:
        gs 'AmandaNeighborBoysCanStart'

        if AmandaNeighborBoysCanStart = 1:
            NeighborBoysRoll = RAND(1, 100)

            if NeighborBoysRoll <= 28:
                AmandaNeighborBoysStarted = 1
                gt 'AmandaNeighborBoysEvent'
            end

            killvar 'NeighborBoysRoll'
        end
    end
---

#AmandaNeighborBoysEvent

    *clr
    clr
    cla

    $CurrentGirl = 'amanda'
    AmandaNeighborBoysToday = 1
    AmandaNeighborBoysStage += 1

    gs 'EnsureGirlData', 'amanda'

    NeighborBoyRoll = RAND(1, 10)

    if NeighborBoyRoll = 1:
        gs 'AmandaBoyGiantCanStart'
        if AmandaBoyGiantCanStart = 1:
            killvar 'NeighborBoyRoll'
            gt 'AmandaBoyGiantEvent'
        else
            NeighborBoyRoll = RAND(3, 10)
        end
    end

    if NeighborBoyRoll = 2:
        killvar 'NeighborBoyRoll'
        gt 'AmandaBoyBrothersEvent'
    elseif NeighborBoyRoll = 3:
        $AmandaNeighborBoyName = 'Отто'
        $AmandaNeighborBoyDesc = 'сын кожевенника'
        AmandaNeighborBoyCurved = 1
    elseif NeighborBoyRoll = 4:
        $AmandaNeighborBoyName = 'Томас'
        $AmandaNeighborBoyDesc = 'сын мясника'
        AmandaNeighborBoyCurved = 0
    elseif NeighborBoyRoll = 5:
        $AmandaNeighborBoyName = 'Ханс'
        $AmandaNeighborBoyDesc = 'племянник пекаря'
        AmandaNeighborBoyCurved = 0
    elseif NeighborBoyRoll = 6:
        $AmandaNeighborBoyName = 'Курт'
        $AmandaNeighborBoyDesc = 'подмастерье бондаря'
        AmandaNeighborBoyCurved = 0
    elseif NeighborBoyRoll = 7:
        $AmandaNeighborBoyName = 'Феликс'
        $AmandaNeighborBoyDesc = 'подручный сапожника'
        AmandaNeighborBoyCurved = 0
    elseif NeighborBoyRoll = 8:
        $AmandaNeighborBoyName = 'Люк'
        $AmandaNeighborBoyDesc = 'помощник мельника'
        AmandaNeighborBoyCurved = 0
    elseif NeighborBoyRoll = 9:
        $AmandaNeighborBoyName = 'Якоб'
        $AmandaNeighborBoyDesc = 'подручный плотника'
        AmandaNeighborBoyCurved = 0
    else:
        $AmandaNeighborBoyName = 'Финн'
        $AmandaNeighborBoyDesc = 'конюх с постоялого двора'
        AmandaNeighborBoyCurved = 0
    end

    killvar 'NeighborBoyRoll'

    ! Проверка на случайного второго парня, если открыт групповой флаг
    $AmandaNeighborBoyName2 = ''
    if AmandaBoysGroupUnlocked = 1 and AmandaNeighborBoyCurved = 0:
        if RAND(1, 100) <= 25:
            SecondBoyRoll = RAND(1, 6)
            if SecondBoyRoll = 1 and $AmandaNeighborBoyName <> 'Томас':
                $AmandaNeighborBoyName2 = 'Томас'
            elseif SecondBoyRoll = 2 and $AmandaNeighborBoyName <> 'Ханс':
                $AmandaNeighborBoyName2 = 'Ханс'
            elseif SecondBoyRoll = 3 and $AmandaNeighborBoyName <> 'Курт':
                $AmandaNeighborBoyName2 = 'Курт'
            elseif SecondBoyRoll = 4 and $AmandaNeighborBoyName <> 'Феликс':
                $AmandaNeighborBoyName2 = 'Феликс'
            elseif SecondBoyRoll = 5 and $AmandaNeighborBoyName <> 'Люк':
                $AmandaNeighborBoyName2 = 'Люк'
            elseif $AmandaNeighborBoyName <> 'Финн':
                $AmandaNeighborBoyName2 = 'Финн'
            end
            killvar 'SecondBoyRoll'
        end
    end

    gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_event', 'Аманда и соседский парень на заднем дворе', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' СОСЕДСКИЕ ПАРНИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaNeighborBoysEventText') = 1:
        gs 'AmandaNeighborBoysEventText', AmandaNeighborBoysStage
    else:
        if $AmandaNeighborBoyName2 <> '':
            *pl 'Вы натыкаетесь на Аманду у служебного входа трактира. Рядом — ' + $AmandaNeighborBoyName + ' и ' + $AmandaNeighborBoyName2 + ', окружившие её вдвоём.'
        else:
            *pl 'Вы натыкаетесь на Аманду у служебного входа трактира. Рядом — ' + $AmandaNeighborBoyName + ', стоящий к ней слишком близко.'
        end
        *pl 'Она явно не ожидала, что её увидят.'
    end

    *pl ' '

    gs 'AmandaNeighborBoysBuildMenu'

    *p 'Что вы будете <a href="exec:gs ''Menu.Show'', ''AmandaNeighborBoysMenu''">делать</a>?'
---

#AmandaNeighborBoysBuildMenu

    gs 'Menu.Destroy', 'AmandaNeighborBoysMenu'
    gs 'Menu.Create', 'AmandaNeighborBoysMenu'

    gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Прогнать парня', ''
    gs 'Menu.AddModule', 'AmandaNeighborBoysMenu', {
        gt 'AmandaNeighborBoysAction', 'send_away'
    }

    gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Спросить Аманду прямо', ''
    gs 'Menu.AddModule', 'AmandaNeighborBoysMenu', {
        gt 'AmandaNeighborBoysAction', 'ask'
    }

    if AmandaWatchNpcPath = 1 or FamilyCorruptionStage >= 2:
        gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Наблюдать издалека', ''
        gs 'Menu.AddModule', 'AmandaNeighborBoysMenu', {
            gt 'AmandaNeighborBoysAction', 'watch'
        }
    end

    if FamilyCorruptionStage >= 3 and sluttiness['amanda'] >= 30:
        gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Присоединиться', ''
        gs 'Menu.AddModule', 'AmandaNeighborBoysMenu', {
            gt 'AmandaNeighborBoysAction', 'join'
        }
    end

    gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Сделать вид, что не заметили', ''
    gs 'Menu.AddModule', 'AmandaNeighborBoysMenu', {
        gt 'AmandaNeighborBoysAction', 'ignore'
    }
---

#AmandaNeighborBoysAction

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_neighbor_boys_action', 'Исход встречи на заднем дворе', 'large', 'webp'
    $NeighborBoysChoice = LCASE($ARGS[0])

    if $NeighborBoysChoice = 'send_away':
        AmandaTrustStefan += 1
        Friends['amanda'] += 1
        AmandaPlayerPath += 1
        AmandaRebellion += 1
        TavernScandal += 1

    elseif $NeighborBoysChoice = 'ask':
        AmandaTrustStefan += 1
        AmandaSecretiveness += 1
        AmandaNpcPath += 1

    elseif $NeighborBoysChoice = 'watch':
        AmandaWatchNpcPath = 1
        AmandaNpcPath += 2
        AmandaSecretiveness += 1
        TavernScandal += 1
        AmandaScandalLevel += 1

        if sluttiness['amanda'] >= 42 or AmandaNeighborBoysStage >= 3:
            oralacts['amanda'] += 1
        end

        if LOC('KnowledgeRegisterFact') = 1:
            gs 'KnowledgeRegisterFact', 'amanda_neighbors_peek'
        end

        if LOC('KnowledgeRegisterPlayerKnows') = 1:
            gs 'KnowledgeRegisterPlayerKnows', 'amanda_neighbors_peek', 'witness'
        end

    elseif $NeighborBoysChoice = 'join':
        AmandaNpcPath += 3
        sluttiness['amanda'] += 2
        otkroven['amanda'] += 2
        TavernScandal += 2
        AmandaScandalLevel += 2
        FamilyCorruptionStage += 1

        if FamilyCorruptionStage > 5:
            FamilyCorruptionStage = 5
        end

        if LOC('KnowledgeRegisterFact') = 1:
            gs 'KnowledgeRegisterFact', 'amanda_neighbors_peek'
        end

        if LOC('KnowledgeRegisterPlayerKnows') = 1:
            gs 'KnowledgeRegisterPlayerKnows', 'amanda_neighbors_peek', 'witness'
        end

    elseif $NeighborBoysChoice = 'ignore':
        AmandaNpcPath += 2
        AmandaSecretiveness += 2
        AmandaRebellion += 1
        MelissaFamilyConcern += 1
    end

    gs 'ClampGirlSocialStats', 'amanda'

    *pl '══════════════════════════════════════════════'
    *pl ' ПОСЛЕ ВСТРЕЧИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaNeighborBoysActionText') = 1:
        gs 'AmandaNeighborBoysActionText', $NeighborBoysChoice
    else:
        *pl 'Соседский парень исчезает в переулке. Аманда остаётся рядом — слишком тихая.'
    end

    *pl ' '

    if AmandaPathChoiceDone = 0 and AmandaNeighborBoysStage >= 1:
        AmandaPathChoiceReady = 1

        if LOC('AmandaPathChoiceTryAutoStart') = 1:
            gs 'AmandaPathChoiceTryAutoStart', 'TavernMain'
        end
    end

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end

    killvar '$NeighborBoysChoice'
---

#AmandaNeighborBoysDebugReset

    AmandaNeighborBoysStage = 0
    AmandaNeighborBoysToday = 0
    AmandaNeighborBoysCanStart = 0
    AmandaNeighborBoysStarted = 0
    AmandaPlayerAlleySexEver = 0
    AmandaAlleyMmfDone = 0
    $AmandaNeighborBoyName = ''
---
