! [AI-WORKED] Текст переработан / дополнен ассистентом 17.09.2026
! Ветка: Соседские парни (Томас, Ханс, Курт, Феликс, Люк, Якоб, Финн) на заднем дворе трактира
! Архитектура:
! - Одиночные встречи: орал (sluttiness < 35), вагинал в телеге (sluttiness >= 35), анал в телеге (AmandaHomeAnalDone = 1 и sluttiness >= 50)
! - Парные встречи (2 парня): последовательные ступени 1 -> 2 -> 3 (гейт AmandaHomeAnalDone = 1) -> цикл
! - Тройные встречи (3 парня): открываются после завершения ветки братьев (AmandaBoyBrothersStage >= 8 или AmandaBrothersTrained = 1)
! - Все интимные сцены строго 2 экрана: процесс -> финал/развязка
! ================================================

#CheckAmandaEvents

    if $CurrentGirl <> 'amanda':
        exit
    end

    if LOC('AmandaNeighborBoysTryStart') = 1:
        gs 'AmandaNeighborBoysTryStart'
    end

    tmp = Rand(1, 100)

    if tmp <= 25 and AmandaVar['lizafriends'] >= 1 and otkroven['amanda'] >= 20 and AmandaVar['liza_event_shown'] = 0:
        AmandaVar['liza_event_shown'] = 1
        *pl '=== ОСОБОЕ СОБЫТИЕ ==='
        *p 'Аманда краснеет и тихо говорит тебе на ушко:'
        *p '"Стефан... Лиза вчера спрашивала про тебя... Она сказала, что ты очень... интересный."'
        *p 'Аманда смущённо отводит взгляд.'
        Friends['amanda'] += 2
        otkroven['amanda'] += 3
        gs 'CorruptionProgress', 'amanda', 'talk'
        gs 'ActUiPrepare', 'Продолжить', 'generic'
        act $ActUiLabel, $ActUiIconPath: exit
    end

    if tmp <= 40 and otkroven['amanda'] >= 30 and sluttiness['amanda'] >= 25 and AmandaVar['amanda_initiative'] = 0:
        AmandaVar['amanda_initiative'] = 1
        *pl '=== ОСОБОЕ СОБЫТИЕ ==='
        *p 'Аманда вдруг сама подходит ближе и тихо шепчет:'
        *p '"Я... я иногда думаю о тебе по ночам..."'
        *p 'Её щёки горят, она быстро отворачивается.'
        Friends['amanda'] += 4
        otkroven['amanda'] += 5
        gs 'CorruptionProgress', 'amanda', 'flirt'
        gs 'ActUiPrepare', 'Продолжить', 'generic'
        act $ActUiLabel, $ActUiIconPath: exit
    end

    if tmp <= 55 and (jobwaitress['amanda'] = 1 or jobwhore['amanda'] = 1) and sluttiness['amanda'] < 40:
        *pl '=== ОСОБОЕ СОБЫТИЕ ==='
        *p 'Пьяный посетитель слишком нагло прижал Аманду к стене и пытается засунуть руку ей под юбку.'
        *p 'Аманда выглядит очень испуганной и пытается вырваться.'
        Friends['amanda'] -= 2
        gs 'ActUiPrepare', 'Вмешаться', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            *p 'Ты резко оттаскиваешь мужчину.'
            Friends['amanda'] += 5
            gs 'ActUiPrepare', 'Продолжить', 'generic'
            act $ActUiLabel, $ActUiIconPath: exit
        end
        gs 'ActUiPrepare', 'Не вмешиваться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gs 'CorruptionProgress', 'amanda', 'flirt'
            gs 'ActUiPrepare', 'Продолжить', 'generic'
            act $ActUiLabel, $ActUiIconPath: exit
        end
    end

    if tmp <= 70 and otkroven['amanda'] >= 35 and AmandaVar['secret_shared'] = 0:
        AmandaVar['secret_shared'] = 1
        *pl '=== ОСОБОЕ СОБЫТИЕ ==='
        *p 'Аманда неожиданно говорит:'
        *p '"Знаешь... я иногда представляю, как ты меня целуешь... когда остаюсь одна в комнате."'
        *p 'Она тут же закрывает лицо руками от стыда.'
        otkroven['amanda'] += 6
        Friends['amanda'] += 3
        gs 'CorruptionProgress', 'amanda', 'talk'
        gs 'ActUiPrepare', 'Продолжить', 'generic'
        act $ActUiLabel, $ActUiIconPath: exit
    end

    if tmp <= 85 and otkroven['amanda'] >= 40 and sluttiness['amanda'] >= 35:
        *pl '=== ОСОБОЕ СОБЫТИЕ ==='
        *p 'Аманда сама подходит к тебе ближе, чем обычно, и тихо говорит:'
        *p '"Ты сегодня очень хорошо выглядишь..."'
        *p 'Она краснеет и быстро отходит.'
        Friends['amanda'] += 3
        gs 'CorruptionProgress', 'amanda', 'flirt'
        gs 'ActUiPrepare', 'Продолжить', 'generic'
        act $ActUiLabel, $ActUiIconPath: exit
    end

    exit
---

#AmandaNeighborBoysCanStart

    AmandaNeighborBoysCanStart = 0

    if AmandaLegareFirstSexDone = 0 and AmandaPlayerAlleySexEver = 0 and AmandaHomeSex = 0:
        exit
    end

    if AmandaProhibitGuys = 1:
        exit
    end

    if AmandaNeighborBoysToday = 1:
        exit
    end

    if time < 3:
        exit
    end

    if sluttiness['amanda'] < 15 and AmandaNpcPath < 12:
        exit
    end

    AmandaNeighborBoysCanStart = 1
---

#AmandaNeighborBoysTryStart

    AmandaNeighborBoysStarted = 0

    if LOC('AmandaNeighborBoysCanStart') = 1:
        gs 'AmandaNeighborBoysCanStart'

        if AmandaNeighborBoysCanStart = 1:
            NeighborBoysRoll = RAND(1, 100)

            if NeighborBoysRoll <= 28:
                AmandaNeighborBoysStarted = 1
                gt 'AmandaNeighborBoysEvent'
            end

            killvar 'NeighborBoysRoll'
        end
    end
---

#AmandaNeighborBoysSetBoyData
    ! $ARGS[0] = слот ('1', '2', '3'), ARGS[1] = индекс (1..7)
    _boySlot = $ARGS[0]
    _boyIdx = ARGS[1]

    if _boyIdx = 1:
        $_tempName = 'Томас'
        $_tempDesc = 'сын мясника'
    elseif _boyIdx = 2:
        $_tempName = 'Ханс'
        $_tempDesc = 'племянник пекаря'
    elseif _boyIdx = 3:
        $_tempName = 'Курт'
        $_tempDesc = 'подмастерье бондаря'
    elseif _boyIdx = 4:
        $_tempName = 'Феликс'
        $_tempDesc = 'помощник сапожника'
    elseif _boyIdx = 5:
        $_tempName = 'Люк'
        $_tempDesc = 'помощник мельника'
    elseif _boyIdx = 6:
        $_tempName = 'Якоб'
        $_tempDesc = 'подручный плотника'
    else:
        $_tempName = 'Финн'
        $_tempDesc = 'конюх с постоялого двора'
    end

    if _boySlot = '1':
        $AmandaNeighborBoyName = $_tempName
        $AmandaNeighborBoyDesc = $_tempDesc
    elseif _boySlot = '2':
        $AmandaNeighborBoyName2 = $_tempName
        $AmandaNeighborBoyDesc2 = $_tempDesc
    elseif _boySlot = '3':
        $AmandaNeighborBoyName3 = $_tempName
        $AmandaNeighborBoyDesc3 = $_tempDesc
    end

    killvar '_boySlot'
    killvar '_boyIdx'
    killvar '$_tempName'
    killvar '$_tempDesc'
---

#AmandaNeighborBoysEvent

    *clr
    clr
    cla

    $CurrentGirl = 'amanda'
    AmandaNeighborBoysToday = 1
    AmandaNeighborBoysStage += 1

    gs 'EnsureGirlData', 'amanda'

    NeighborBoyRoll = RAND(1, 10)

    if NeighborBoyRoll = 1:
        gs 'AmandaBoyGiantCanStart'
        if AmandaBoyGiantCanStart = 1:
            killvar 'NeighborBoyRoll'
            gt 'AmandaBoyGiantEvent'
        else
            NeighborBoyRoll = RAND(3, 10)
        end
    end

    if NeighborBoyRoll = 2:
        killvar 'NeighborBoyRoll'
        gt 'AmandaBoyBrothersEvent'
    elseif NeighborBoyRoll = 3:
        killvar 'NeighborBoyRoll'
        gt 'AmandaBoyCurvedEvent'
    end

    killvar 'NeighborBoyRoll'

    ! Определение типа встречи в общем пуле: trio, pair или single
    $NeighborEncounterType = 'single'

    ! Проверка на трио: открыто после завершения ветки братьев
    if AmandaBoyBrothersStage >= 8 or AmandaBrothersTrained = 1:
        if RAND(1, 100) <= 25:
            $NeighborEncounterType = 'trio'
        end
    end

    ! Проверка на пару: если не трио и открыт групповой флаг
    if $NeighborEncounterType = 'single' and (AmandaBoysGroupUnlocked = 1 or AmandaBoyBrothersStage >= 5 or AmandaBoysPairStage > 0):
        if RAND(1, 100) <= 40:
            $NeighborEncounterType = 'pair'
        end
    end

    ! Выбор персонажей из пула 7 парней
    if $NeighborEncounterType = 'trio':
        _b1 = RAND(1, 7)
        _b2 = RAND(1, 6)
        if _b2 >= _b1: _b2 += 1

        _min = _b1
        _max = _b2
        if _min > _max:
            _min = _b2
            _max = _b1
        end
        _b3 = RAND(1, 5)
        if _b3 >= _min: _b3 += 1
        if _b3 >= _max: _b3 += 1

        gs 'AmandaNeighborBoysSetBoyData', '1', _b1
        gs 'AmandaNeighborBoysSetBoyData', '2', _b2
        gs 'AmandaNeighborBoysSetBoyData', '3', _b3

        killvar '_b1'
        killvar '_b2'
        killvar '_b3'
        killvar '_min'
        killvar '_max'

    elseif $NeighborEncounterType = 'pair':
        $AmandaNeighborBoyName3 = ''
        $AmandaNeighborBoyDesc3 = ''

        _b1 = RAND(1, 7)
        _b2 = RAND(1, 6)
        if _b2 >= _b1: _b2 += 1

        gs 'AmandaNeighborBoysSetBoyData', '1', _b1
        gs 'AmandaNeighborBoysSetBoyData', '2', _b2

        killvar '_b1'
        killvar '_b2'

        ! Определение ступени парной встречи
        if AmandaBoysPairStage = 0:
            NeighborPairStep = 1
        elseif AmandaBoysPairStage = 1:
            NeighborPairStep = 2
        elseif AmandaBoysPairStage = 2:
            if AmandaHomeAnalDone = 1:
                NeighborPairStep = 3
            else
                NeighborPairStep = 2
            end
        else
            ! Цикл повторов (AmandaBoysPairStage >= 3)
            if AmandaHomeAnalDone = 1:
                NeighborPairStep = RAND(1, 3)
            else
                NeighborPairStep = RAND(1, 2)
            end
        end

    else
        ! Single (один парень)
        $AmandaNeighborBoyName2 = ''
        $AmandaNeighborBoyDesc2 = ''
        $AmandaNeighborBoyName3 = ''
        $AmandaNeighborBoyDesc3 = ''

        _b1 = RAND(1, 7)
        gs 'AmandaNeighborBoysSetBoyData', '1', _b1
        killvar '_b1'

        ! Определение формата одиночной встречи
        if sluttiness['amanda'] < 35:
            $SingleActionType = 'oral'
        else
            if AmandaHomeAnalDone = 1 and sluttiness['amanda'] >= 50:
                if RAND(1, 2) = 1:
                    $SingleActionType = 'cart_vaginal'
                else
                    $SingleActionType = 'cart_anal'
                end
            else
                $SingleActionType = 'cart_vaginal'
            end
        end
    end

    NeighborFinishType = RAND(1, 3)

    ! Показ вступительного визуала
    if $NeighborEncounterType = 'trio':
        gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_trio_intro', 'Аманда и трое парней на заднем дворе', 'large', 'webp'
    elseif $NeighborEncounterType = 'pair':
        gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_pair_intro', 'Аманда и двое парней на заднем дворе', 'large', 'webp'
    else
        gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_single_intro', 'Аманда и соседский парень на заднем дворе', 'large', 'webp'
    end

    *pl '══════════════════════════════════════════════'
    *pl ' СОСЕДСКИЕ ПАРНИ НА ЗАДНЕМ ДВОРЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaNeighborBoysEventText') = 1:
        gs 'AmandaNeighborBoysEventText'
    else:
        if $NeighborEncounterType = 'trio':
            *pl 'Вы натыкаетесь на Аманду в глухом углу за сараем. Рядом — ' + $AmandaNeighborBoyName + ', ' + $AmandaNeighborBoyName2 + ' и ' + $AmandaNeighborBoyName3 + ', окружившие её втроём.'
        elseif $NeighborEncounterType = 'pair':
            *pl 'Вы натыкаетесь на Аманду у служебного входа трактира. Рядом — ' + $AmandaNeighborBoyName + ' и ' + $AmandaNeighborBoyName2 + ', окружившие её вдвоём.'
        else:
            *pl 'Вы натыкаетесь на Аманду у служебного входа трактира. Рядом — ' + $AmandaNeighborBoyName + ', стоящий к ней слишком близко.'
        end
        *pl 'Она явно не ожидала, что её увидят.'
    end

    *pl ' '

    gs 'AmandaNeighborBoysBuildMenu'

    *p 'Что вы будете <a href="exec:gs ''Menu.Show'', ''AmandaNeighborBoysMenu''">делать</a>?'
---

#AmandaNeighborBoysBuildMenu

    gs 'Menu.Destroy', 'AmandaNeighborBoysMenu'
    gs 'Menu.Create', 'AmandaNeighborBoysMenu'

    if $NeighborEncounterType = 'single':
        gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Прогнать парня', ''
    else:
        gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Прогнать парней', ''
    end
    gs 'Menu.AddModule', 'AmandaNeighborBoysMenu', {
        gt 'AmandaNeighborBoysAction', 'send_away'
    }

    if $NeighborEncounterType = 'single':
        gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Спросить прямо', ''
    else:
        gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Окликнуть', ''
    end
    gs 'Menu.AddModule', 'AmandaNeighborBoysMenu', {
        gt 'AmandaNeighborBoysAction', 'ask'
    }

    if AmandaWatchNpcPath = 1 or FamilyCorruptionStage >= 2:
        gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Наблюдать издалека', ''
        gs 'Menu.AddModule', 'AmandaNeighborBoysMenu', {
            gt 'AmandaNeighborBoysAction', 'watch'
        }
    end

    if FamilyCorruptionStage >= 3 and sluttiness['amanda'] >= 30:
        gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Присоединиться', ''
        gs 'Menu.AddModule', 'AmandaNeighborBoysMenu', {
            gt 'AmandaNeighborBoysAction', 'join'
        }
    end

    gs 'MenuUiAdd', 'AmandaNeighborBoysMenu', 'Сделать вид, что не заметили', ''
    gs 'Menu.AddModule', 'AmandaNeighborBoysMenu', {
        gt 'AmandaNeighborBoysAction', 'ignore'
    }
---

#AmandaNeighborBoysAction

    *clr
    clr
    cla

    $NeighborBoysChoice = LCASE($ARGS[0])

    ! Ветвление выбора Стефана: короткие выборы (1 экран) или интимное наблюдение/участие (2 экрана)
    if $NeighborBoysChoice = 'send_away':
        AmandaTrustStefan += 1
        Friends['amanda'] += 1
        AmandaPlayerPath += 1
        AmandaRebellion += 1
        TavernScandal += 1
        gs 'ClampGirlSocialStats', 'amanda'

        gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_boys_action', 'Исход встречи на заднем дворе', 'large', 'webp'

        *pl '══════════════════════════════════════════════'
        *pl ' ПОСЛЕ ВСТРЕЧИ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        if LOC('AmandaNeighborBoysActionText') = 1:
            gs 'AmandaNeighborBoysActionText', $NeighborBoysChoice, 1
        else:
            *pl 'Вы прогнали парней со двора. Аманда сердито возвращается к работе.'
        end

        *pl ' '


        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gs 'AmandaNeighborBoysCleanup'
            gt 'TavernMain'
        end

    elseif $NeighborBoysChoice = 'ask':
        AmandaTrustStefan += 1
        AmandaSecretiveness += 1
        AmandaNpcPath += 1
        gs 'ClampGirlSocialStats', 'amanda'

        gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_boys_action', 'Исход встречи на заднем дворе', 'large', 'webp'

        *pl '══════════════════════════════════════════════'
        *pl ' ПОСЛЕ ВСТРЕЧИ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        if LOC('AmandaNeighborBoysActionText') = 1:
            gs 'AmandaNeighborBoysActionText', $NeighborBoysChoice, 1
        else:
            *pl 'Вы окликнули Аманду, и парень поспешил ретироваться.'
        end

        *pl ' '


        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gs 'AmandaNeighborBoysCleanup'
            gt 'TavernMain'
        end

    elseif $NeighborBoysChoice = 'ignore':
        AmandaNpcPath += 2
        AmandaSecretiveness += 2
        AmandaRebellion += 1
        MelissaFamilyConcern += 1
        gs 'ClampGirlSocialStats', 'amanda'

        gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_boys_action', 'Исход встречи на заднем дворе', 'large', 'webp'

        *pl '══════════════════════════════════════════════'
        *pl ' ПОСЛЕ ВСТРЕЧИ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        if LOC('AmandaNeighborBoysActionText') = 1:
            gs 'AmandaNeighborBoysActionText', $NeighborBoysChoice, 1
        else:
            *pl 'Вы сделали вид, что ничего не заметили, оставив их наедине.'
        end

        *pl ' '


        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gs 'AmandaNeighborBoysCleanup'
            gt 'TavernMain'
        end

    else
        ! watch или join -> Экран 1 интимной сцены
        if $NeighborEncounterType = 'trio':
            gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_trio_process', 'Трое парней и Аманда на сеновале', 'large', 'webp'
        elseif $NeighborEncounterType = 'pair':
            if NeighborPairStep = 1:
                gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_pair_knees_process', 'Аманда на коленях между двумя парнями', 'large', 'webp'
            elseif NeighborPairStep = 2:
                gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_pair_allfours_process', 'Аманда на четвереньках между парнями', 'large', 'webp'
            else
                gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_pair_cart_double_process', 'Параллельная близость в телеге', 'large', 'webp'
            end
        else
            if $SingleActionType = 'oral':
                gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_single_oral_process', 'Оральные ласки за сараем: ' + $AmandaNeighborBoyName + ' и Аманда', 'large', 'webp'
            elseif $SingleActionType = 'cart_vaginal':
                gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_single_cart_vaginal_process', 'В телеге на сене: ' + $AmandaNeighborBoyName + ' и Аманда', 'large', 'webp'
            else
                gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_single_cart_anal_process', 'В телеге сзади: ' + $AmandaNeighborBoyName + ' и Аманда', 'large', 'webp'
            end
        end

        *pl '══════════════════════════════════════════════'
        *pl ' ЗА САРАЕМ НА ЗАДНЕМ ДВОРЕ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        if LOC('AmandaNeighborBoysActionText') = 1:
            gs 'AmandaNeighborBoysActionText', $NeighborBoysChoice, 1
        else:
            *pl 'Вы наблюдаете за разворачивающейся сценой за сараем.'
        end

        *pl ' '

        gs 'ActUiPrepare', 'Дальше', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AmandaNeighborBoysActionScreen2'
        end
    end
---

#AmandaNeighborBoysActionScreen2

    *clr
    clr
    cla

    ! Экран 2: Финал и кульминация интимной сцены
    if $NeighborEncounterType = 'trio':
        gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_trio_finish', 'Тройной финал', 'large', 'webp'
    elseif $NeighborEncounterType = 'pair':
        if NeighborPairStep = 1:
            gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_pair_knees_finish', 'Финал двойных ласк на коленях', 'large', 'webp'
        elseif NeighborPairStep = 2:
            gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_pair_allfours_finish', 'Финал близости с двух сторон', 'large', 'webp'
        else
            gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_pair_cart_double_finish', 'Финал параллельной близости в телеге', 'large', 'webp'
        end
    else
        if $SingleActionType = 'oral':
            gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_single_oral_finish', 'Финал оральных ласк', 'large', 'webp'
        elseif $SingleActionType = 'cart_vaginal':
            gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_single_cart_vaginal_finish', 'Финал в телеге', 'large', 'webp'
        else
            gs 'SceneShowVisual', 'images/events/amanda/neighbor_boys/amanda_neighbor_single_cart_anal_finish', 'Финал сзади в телеге', 'large', 'webp'
        end
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ЗАВЕРШЕНИЕ БЛИЗОСТИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaNeighborBoysActionText') = 1:
        gs 'AmandaNeighborBoysActionText', $NeighborBoysChoice, 2
    else:
        *pl 'Близость завершается, и возбуждённые участники приходят в себя.'
    end

    *pl ' '

    ! Фиксация игровых параметров и статистики
    AmandaWatchNpcPath = 1
    AmandaNpcPath += 2
    sluttiness['amanda'] += 2
    TavernScandal += 1
    LastSexDay['amanda'] = day

    if $NeighborBoysChoice = 'join':
        FamilyCorruptionStage += 1
        if FamilyCorruptionStage > 5:
            FamilyCorruptionStage = 5
        end
        TavernScandal += 1
        AmandaScandalLevel += 1
    end

    if LOC('KnowledgeRegisterFact') = 1:
        gs 'KnowledgeRegisterFact', 'amanda_neighbors_peek'
    end

    if LOC('KnowledgeRegisterPlayerKnows') = 1:
        gs 'KnowledgeRegisterPlayerKnows', 'amanda_neighbors_peek', 'witness'
    end

    ! Статистика по типам сцен
    if $NeighborEncounterType = 'single':
        if $SingleActionType = 'oral':
            oralacts['amanda'] += 1
            oralswallow['amanda'] += 1
        elseif $SingleActionType = 'cart_vaginal':
            vaginalacts['amanda'] += 1
            sexacts['amanda'] += 1
            gs 'RegisterSex', 'amanda', 'vaginal', 0, 0
        elseif $SingleActionType = 'cart_anal':
            analacts['amanda'] += 1
            sexacts['amanda'] += 1
            gs 'RegisterSex', 'amanda', 'anal', 0, 0
            AmandaNeighborBoysAnalDone = 1
        end

    elseif $NeighborEncounterType = 'pair':
        if NeighborPairStep = 1:
            oralacts['amanda'] += 1
            CaressCount['amanda'] += 1
            if AmandaBoysPairStage = 0:
                AmandaBoysPairStage = 1
            end
        elseif NeighborPairStep = 2:
            oralacts['amanda'] += 1
            vaginalacts['amanda'] += 1
            sexacts['amanda'] += 1
            gs 'RegisterSex', 'amanda', 'vaginal', 0, 0
            if AmandaBoysPairStage = 1:
                AmandaBoysPairStage = 2
            end
        elseif NeighborPairStep = 3:
            vaginalacts['amanda'] += 1
            analacts['amanda'] += 1
            sexacts['amanda'] += 1
            gs 'RegisterSex', 'amanda', 'vaginal', 0, 0
            gs 'RegisterSex', 'amanda', 'anal', 0, 0
            AmandaNeighborBoysAnalDone = 1
            if AmandaBoysPairStage = 2:
                AmandaBoysPairStage = 3
            end
        end

    elseif $NeighborEncounterType = 'trio':
        oralacts['amanda'] += 1
        vaginalacts['amanda'] += 1
        analacts['amanda'] += 1
        sexacts['amanda'] += 1
        gs 'RegisterSex', 'amanda', 'vaginal', 0, 0
        gs 'RegisterSex', 'amanda', 'anal', 0, 0
        AmandaNeighborBoysAnalDone = 1
        AmandaBoysTrioDone = 1
    end

    gs 'ClampGirlSocialStats', 'amanda'


    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gs 'AmandaNeighborBoysCleanup'
        gt 'TavernMain'
    end
---

#AmandaNeighborBoysCleanup

    killvar '$NeighborBoysChoice'
    killvar '$NeighborEncounterType'
    killvar '$SingleActionType'
    killvar 'NeighborPairStep'
    killvar 'NeighborFinishType'
    killvar '$AmandaNeighborBoyName'
    killvar '$AmandaNeighborBoyDesc'
    killvar '$AmandaNeighborBoyName2'
    killvar '$AmandaNeighborBoyDesc2'
    killvar '$AmandaNeighborBoyName3'
    killvar '$AmandaNeighborBoyDesc3'
---

#AmandaNeighborBoysDebugReset

    AmandaNeighborBoysStage = 0
    AmandaNeighborBoysToday = 0
    AmandaNeighborBoysCanStart = 0
    AmandaNeighborBoysStarted = 0
    AmandaPlayerAlleySexEver = 0
    AmandaAlleyMmfDone = 0
    AmandaBoysPairStage = 0
    AmandaBoysTrioDone = 0
    $AmandaNeighborBoyName = ''
    $AmandaNeighborBoyDesc = ''
    $AmandaNeighborBoyName2 = ''
    $AmandaNeighborBoyDesc2 = ''
    $AmandaNeighborBoyName3 = ''
    $AmandaNeighborBoyDesc3 = ''
---
