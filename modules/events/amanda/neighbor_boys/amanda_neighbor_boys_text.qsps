#AmandaNeighborBoysEventText

    if $NeighborEncounterType = 'trio':
        *pl 'Выйдя на задний двор трактира, вы замечаете приглушённый смех в дальнем тенистом углу за поленницей.'
        *pl 'Там, окружённая сразу тремя крепкими парнями, стоит Аманда. ' + $AmandaNeighborBoyName + ' (' + $AmandaNeighborBoyDesc + '), ' + $AmandaNeighborBoyName2 + ' (' + $AmandaNeighborBoyDesc2 + ') и ' + $AmandaNeighborBoyName3 + ' (' + $AmandaNeighborBoyDesc3 + ') обступили её со всех сторон, наперебой нашептывая пылкие комплименты.'
        *pl 'Сестра, давно привыкшая к жадному мужскому вниманию, ничуть не смущается: её щёки алеют румянцем, корсаж слегка распущен, а в глазах пляшут озорные, бесстыдные искорки.'
        *pl 'Она лукаво хихикает, то и дело дразня парней то взмахом подола, то лёгким прикосновением ладони.'

    elseif $NeighborEncounterType = 'pair':
        *pl 'В простенке между хозяйственным сараем и дровяным навесом слышится оживлённая возня.'
        *pl 'Двое соседских парней — ' + $AmandaNeighborBoyName + ' (' + $AmandaNeighborBoyDesc + ') и ' + $AmandaNeighborBoyName2 + ' (' + $AmandaNeighborBoyDesc2 + ') — прижали Аманду к борту телеги с душистым сеном.'
        if NeighborPairStep = 1:
            *pl 'Они осторожно, но настойчиво трогают её за талию и плечи, подбивая спуститься пониже на сено. Аманда лукаво отнекивается, но не делает ни шагу в сторону спасительной кухни.'
        elseif NeighborPairStep = 2:
            *pl 'Парни уже уверенно хозяйничают вокруг неё: один нетерпеливо гладит распущенные по плечам косы, второй бесцеремонно приподнимает край её фартука. Аманда часто дышит, поддаваясь их напору.'
        else:
            *pl 'Оба воздыхателя уже затащили девушку к самой телеге: Аманда задорно улыбается, закинув ногу на ступеньку колеса, явно предвкушая редкую и смелую забаву.'
        end

    else
        ! Single
        *pl 'Выходя во внутренний двор через служебную дверь, вы застаёте Аманду у дровяника.'
        *pl 'Рядом с ней крутится ' + $AmandaNeighborBoyName + ' — ' + $AmandaNeighborBoyDesc + ', давно бросавший жадные взгляды на молоденьких подавальщиц трактира.'
        if sluttiness['amanda'] < 35:
            *pl 'Он увлечённо распускает хвост, уперев руки в бока и ухмыляясь, а Аманда хихикает в ладошку, кокетливо накручивая на палец светлый локон.'
            *pl 'Парень то и дело подаётся вперёд, сокращая расстояние до опасной близости.'
        else:
            *pl 'Он уже без стеснения прижимает сестру к потемневшим от дождей брёвнам сарая, положив горячую ладонь на её талию.'
            *pl 'Аманда томно прикрывает глаза, закусив губу и всем телом отвечая на его нетерпеливые прикосновения.'
        end
    end
---

#AmandaNeighborBoysActionText
    $NeighborBoysActionChoice = $ARGS[0]
    NeighborBoysScreen = ARGS[1]

    if $NeighborBoysActionChoice = 'send_away':
        *pl 'Вы выходите из тени и гаркаете во весь голос:'
        if $NeighborEncounterType = 'single':
            *pl '— А ну проваливай отсюда, бездельник, пока я тебе рёбра не пересчитал!'
            *pl $AmandaNeighborBoyName + ' в панике шарахается к забору, едва не сшибая ведро, испуганно лепечет извинения и со всех ног удирает в проулок.'
        else:
            *pl '— А ну брысь отсюда, дворовые кобели! Живо, пока я пса не спустил и бока вам кольями не обломал!'
            *pl 'Парни в ужасе переглядываются, спотыкаются друг о друга и гурьбой сигают через плетень, растворяясь в огородах.'
        end
        *pl ' '
        *pl 'Аманда остаётся на месте, пылая щеками от возмущения:'
        *pl '— Стефан! Вечно ты врываешься как медведь из чащи! Мы просто перекинулись парой слов, а ты на всю слободу разорёшься!'
        *pl 'Она сердито одёргивает подол и, громко топая башмачками, убегает в кухню.'

    elseif $NeighborBoysActionChoice = 'ask':
        *pl 'Вы неторопливо подходите ближе и строго смотрите сестре в глаза:'
        *pl '— И что за тайные шашни посреди бела дня за сараем?'
        if $NeighborEncounterType = 'single':
            *pl $AmandaNeighborBoyName + ' торопливо пятится, бормоча, что просто зашёл узнать насчёт свежего солода, и исчезает за воротами.'
        else:
            *pl 'Парни, неловко переминаясь с ноги на ногу, торопливо кланяются и спешат ретироваться в переулок.'
        end
        *pl ' '
        if FamilyCorruptionStage < 3:
            *pl 'Аманда заливается краской до самых корней волос и прячет руки за спину:'
            *pl '— Никаких шашней! Соседи просто спросили дорогу к мельнику... Не выдумывай себе невесть что, Стефан!'
        else:
            *pl 'Аманда с вызовом улыбается, заправив прядь волос за ушко:'
            *pl '— А что такого? Парни в слободке вежливые, ласковые... Девушке приятно доброе слово услышать, раз уж родной брат вечно занят своими бочками.'
        end

    elseif $NeighborBoysActionChoice = 'ignore':
        *pl 'Вы делаете вид, будто увлечены осмотром пустых бочек у стены, и проходите мимо, не поворачивая головы.'
        *pl 'Аманда с облегчением переводит дыхание, а за сараем раздаётся довольный сдавленный смешок.'
        *pl 'Границы дозволенного вновь мягко сдвинулись, и все участники это прекрасно понимают.'

    else
        ! watch или join
        if NeighborBoysScreen = 1:
            ! ЭКРАН 1: ПРОЦЕСС БЛИЗОСТИ
            if $NeighborEncounterType = 'trio':
                *pl 'Притаившись в тени за штабелем свежих досок, вы наблюдаете за редким и поразительным зрелищем.'
                *pl 'В дальнем глухом закоулке за сараем трое парней окружили Аманду. Сестра полностью отдалась их власти: её платье расшнуровано, пышная грудь часто вздымается, а на губах играет пьянящая улыбка.'
                *pl $AmandaNeighborBoyName + ' опустился перед ней на колени, и Аманда с готовностью принимает его горячий твердеющий уд в свои губы, лаская языком головку и прикрывая веки от запретного наслаждения.'
                *pl 'В то же время ' + $AmandaNeighborBoyName2 + ' бережно укладывает её на копну свежего сена, раздвигая стройные бёдра и плавно входя в её нежное девичье лоно.'
                *pl 'А позади пристраивается ' + $AmandaNeighborBoyName3 + ': осторожно нанеся целебное травяное масло, он медленно и уверенно направляет свой ствол в её тесный задний проход, заставляя Аманду сладостно вскрикнуть в губы первого воздыхателя.'
                *pl 'Все трое движутся в едином слаженном ритме, заполняя девушку целиком. Аманда дрожит всем телом, её пальцы впиваются в крепкие плечи парней, а из горла вырываются приглушённые, полные восторга стоны.'

            elseif $NeighborEncounterType = 'pair':
                if NeighborPairStep = 1:
                    *pl 'Сквозь щели в дощатом заборе вы наблюдаете за происходящим за поленницей.'
                    *pl 'Аманда послушно опустилась на колени прямо в мягкую солому меж двумя молодыми подмастерьями — ' + $AmandaNeighborBoyName + ' и ' + $AmandaNeighborBoyName2 + '.'
                    *pl 'Парни распустили завязки штанов, с горящими глазами глядя на податливую сестру хозяина трактира.'
                    *pl 'Сестра берёт один напряжённый ствол в свою нежную ладонь, rhythmично поглаживая его тёплую кожу, а второй с тихим вздохом отправляет себе в ротик, упиваясь сладким вкусом запретной ласки.'
                    *pl 'Она попеременно одаривает вниманием то одного, то другого парня, игриво закатывая глаза и наслаждаясь их сдавленным, хриплым дыханием.'

                elseif NeighborPairStep = 2:
                    *pl 'Сквозь щель в приоткрытых воротах сарая открывается развратная картина.'
                    *pl 'Аманда стоит на четвереньках в сухом сене, выгнув спинку и высоко приподняв пышные бёдра.'
                    *pl $AmandaNeighborBoyName + ' стоит прямо перед её лицом, придерживая её за светлые локоны, пока Аманда усердно и влажно ласкает его ствол губами и языком.'
                    *pl 'Тем временем ' + $AmandaNeighborBoyName2 + ' устроился сзади: задрав её нижние юбки, он уверенными и мощными толчками входит в её увлажнённое женское лоно.'
                    *pl 'Сестра стонет в унисон каждому толчку, содрогаясь от двойного напора. Её щёки горят, а тело трепещет от сладостной тяжести двоих сильных любовников.'

                else
                    ! NeighborPairStep = 3 (Телега параллельно с двух сторон)
                    *pl 'В глубине двора стоит высокая грузовая телега, доверху набитая пахучим луговым сеном.'
                    *pl 'Один из парней, ' + $AmandaNeighborBoyName + ', улёгся на спину прямо на мягкую копну, выставив кверху крепкий горячий уд.'
                    *pl 'Аманда взобралась на него верхом, спиной к его лицу, и медленно, с протяжным томным вздохом опустилась упругой попкой прямо на его ствол, принимая его глубоко в свой задний проход.'
                    *pl 'В этот же миг второй парень, ' + $AmandaNeighborBoyName2 + ', стоя на земле у борта телеги, разводит её колени и прямо спереди плавно вонзает своё естество в её податливую девичью плоть.'
                    *pl 'Аманда оказывается нанизанной сразу на два горячих ствола: запрокинув голову к небу, она судорожно хватает ртом воздух, пока двое парней ласкают её спереди и сзади в идеальном упоительном согласии.'
                end

            else
                ! Single
                if $SingleActionType = 'oral':
                    *pl 'Притаившись за грудой ящиков, вы наблюдаете за тайной забавой сестры.'
                    *pl $AmandaNeighborBoyName + ' вальяжно прислонился спиной к теплой деревянной стене сарая, распахнув штаны.'
                    *pl 'Аманда уже стоит перед ним на коленях в дорожной пыли, бережно подобрав подол, чтобы не испачкать платье.'
                    *pl 'Она берёт его налившийся уд тонкими пальчиками, смачивает губы и начинает мягко, плавно заглатывать его головку, закатывая глазки от греховного упоения.'
                    *pl 'Парень тяжело дышит, зарываясь пальцами в её волосы и глухо постанывая от нежности её влажного рта.'

                elseif $SingleActionType = 'cart_vaginal':
                    *pl 'В полумраке дровяника стоит старая телега с душистым сеном.'
                    *pl 'Аманда лежит на спине на мягкой соломенной подстилке, высоко задрав пышные юбки и раскинув гладкие бёдра.'
                    *pl $AmandaNeighborBoyName + ' стоит сбоку у колеса телеги, придерживая девушку за бёдра и размеренно, глубоко погружаясь в её сочащееся соками девичье лоно.'
                    *pl 'Скрип рассохшихся досок телеги сливается с частыми, прерывистыми стонами Аманды. Она обнимает парня ногами за талию, прижимая его всё ближе и отдаваясь пылкой юношеской страсти.'

                else
                    ! cart_anal
                    *pl 'Сквозь слуховое окно сарая вы наблюдаете за происходящим в телеге.'
                    *pl 'Аманда стоит на коленях, облокотившись грудью на дощатый борт телеги и высоко подставив округлые упругие ягодицы.'
                    *pl $AmandaNeighborBoyName + ' стоит позади: бережно смазав её нежный задний проход, он медленно проникает в её тесную глубину.'
                    *pl 'Аманда закусывает зубами край деревянной планки, из её горла вырывается сдавленный, сладкий стон. Её тело податливо принимает плотный напор, а парень размеренно набирает темп, упиваясь невиданной уступчивостью хозяйской сестры.'
                end
            end

        else
            ! ЭКРАН 2: ФИНАЛ И РАЗВЯЗКА
            if $NeighborEncounterType = 'trio':
                *pl 'Движения парней становятся всё более частыми и лихорадочными. Страсть достигает наивысшей точки.'
                *pl 'С хриплым синхронным рыком все трое достигают упоения: один щедро изливает горячее семя ей на губы и подбородок, второй наполняет до краёв её лоно, а третий пульсирует в глубине её тесного зада.'
                *pl 'Аманда сотрясается в мощнейшем экстазе, вскрикивая от безумной волны наслаждения, и бессильно опускается на сено, совершенно разомлевшая и покрытая следами безудержной страсти.'

            elseif $NeighborEncounterType = 'pair':
                if NeighborPairStep = 1:
                    *pl 'Оба парня сдавленно стонут, не в силах больше сдерживать натиск наслаждения.'
                    *pl 'Горячие струи семени выплёскиваются на ладони Аманды, на её фартук и пышный вырез корсажа. Сестра довольно щурится, аккуратно облизывает пальчики и тихо посмеивается над ошалелыми от восторга лицами парней.'

                elseif NeighborPairStep = 2:
                    *pl 'Парень сзади делает последний глубокий толчок и замирает, обильно наполняя её нутро горячим семенем.'
                    *pl 'В то же мгновение стоящий спереди воздыхатель дрожит всем телом, окропляя её губы и щёки густыми белыми каплями.'
                    *pl 'Аманда со сладостным выдохом опускает голову на сено, тяжело дыша и наслаждаясь пьянящим ароматом двойной мужской силы.'

                else
                    ! NeighborPairStep = 3 (Телега финал)
                    *pl 'Оба любовника находят вершину наслаждения почти одновременно.'
                    *pl 'Снизу и спереди в Аманду ударяют две горячие пульсирующие волны, заполняя её тело целиком. Сестра выгибается дугой, захлёбываясь от восторга, и со стоном падает грудью на сено, чувствуя, как внутри неё переливается горячее мужское тепло.'
                end

            else
                ! Single finish
                if $SingleActionType = 'oral':
                    if NeighborFinishType = 1:
                        *pl $AmandaNeighborBoyName + ' судорожно вздрагивает и выпускает горячую струю прямо в ротик Аманды. Сестра послушно сглатывает до последней капли и с улыбкой облизывает влажные губы.'
                    elseif NeighborFinishType = 2:
                        *pl 'Парень подаётся назад, и горячие капли покрывают её щёку и подбородок. Аманда насмешливо щурится, вытирая лицо тыльной стороной ладони.'
                    else:
                        *pl 'Семя щедро выплёскивается на пыльную траву у сарая. Аманда легко поднимается на ноги, победоносно глядя на обессилевшего воздыхателя.'
                    end

                elseif $SingleActionType = 'cart_vaginal':
                    if NeighborFinishType = 1:
                        *pl 'Парень с глубоким стоном вдавливается в неё до предела, щедро изливаясь в самую глубину её девичьего лона. Аманда трепещет в объятиях, прижимая его к себе.'
                    else:
                        *pl 'В последний миг парень выходит наружу, и семя расплывается тёплой лужицей по гладкому животику Аманды. Девушка сладко потягивается на мягкой соломе.'
                    end

                else
                    ! cart_anal finish
                    *pl 'Парень замирает, пульсируя в её тесной глубине, пока горячая волна заполняет её изнутри. Аманда блаженно вздыхает, уронив голову на скрещенные руки и смакуя необыкновенное чувство наполненности.'
                end
            end

            *pl ' '
            ! Разговоры и реакция Аманды в зависимости от уровня развращённости и выбора Стефана
            if $NeighborBoysActionChoice = 'join':
                if FamilyCorruptionStage < 3:
                    *pl 'Заметив вашу фигуру, Аманда испуганно вздрагивает, торопливо запахивая платье:'
                    *pl '— Стефан?! Ильматер всеблагой... ты... ты стоял там всё это время?!'
                    *pl 'Она заливается краской стыда, но в глубине её расширенных зрачков плещется тайное, запретное возбуждение.'
                else:
                    *pl 'Поймав ваш взгляд, Аманда томно улыбается, не спеша прикрывать наготу:'
                    *pl '— Смотри, братец... любуйся, как твоя сестрёнка развлекается. Парни знают своё дело, но ты-то ведь всё равно лучше всех...'
                    *pl 'Она шлёт вам лукавую воздушную улыбку, купаясь в вашем одобрении.'
                end
            else
                if FamilyCorruptionStage < 3:
                    *pl 'Пока парни торопливо оправляют одежду, Аманда пугливо шепчет:'
                    *pl '— Скорее уходите... Если Стефан или матушка увидят, мне несдобровать!'
                else:
                    *pl 'Аманда неторопливо поправляет корсаж и задорно подмигивает парням:'
                    *pl '— Приходите ещё, соколики! Сено в телеге мягкое, а я гостей всегда рада приветить!'
                end
            end
        end
    end

    killvar '$NeighborBoysActionChoice'
    killvar 'NeighborBoysScreen'
---
