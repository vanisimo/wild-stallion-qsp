#AmandaNeighborBoysEventText
    AmandaNeighborBoysTextStage = $ARGS[0]

    if AmandaNeighborBoysTextStage = 1:
        *pl 'Выйдя на задний двор через служебную дверь трактира, вы застаёте Аманду у сарая.'
        *pl 'Рядом с ней крутится ' + $AmandaNeighborBoyName + ' — соседский парень из ремесленной слободки, давно бросавший жадные взгляды на молоденьких подавальщиц.'
        *pl 'Он увлечённо распускает хвост, уперев руки в бока и скаля зубы в наглой ухмылке, а Аманда хихикает в кулачок, кокетливо накручивая на палец выбившийся из косы локон.'
        *pl 'Завидев вашу внушительную фигуру на пороге, сестра вздрагивает и испуганно отшатывается от парня, торопливо оглаживая передник.'
    elseif AmandaNeighborBoysTextStage = 2:
        *pl 'Обходя трактир со стороны хозяйственных построек, вы замечаете возню в узком простенке меж забором и стеной дровяника.'
        *pl $AmandaNeighborBoyName + ' прижал Аманду спиной к потемневшим от дождей брёвнам, что-то вкрадчиво нашептывая ей на самое ухо. Его заскорузлая ладонь без лишних церемоний лежит на её талии, перебирая тесёмки корсажа.'
        *pl 'Аманда часто дышит, закусив нижнюю губу, и совсем не спешит его отталкивать.'
        *pl 'Скрип вашей поступи заставляет её вскинуть голову. В глазах сестры вспыхивает тревога — её застали не просто за пустой болтовнёй, а в шаге от откровенного бесстыдства.'
    else:
        *pl 'Это уже не случайный дворовый флирт, а вошедшая в привычку тайная забава.'
        *pl 'За сараем, в густой тени старой ракиты, ' + $AmandaNeighborBoyName + ' нетерпеливо тянет Аманду за руку к телеге с сухим сеном. Сестра делает вид, будто слегка упирается, бросая вороватые взгляды на окна кухни, но послушно идёт следом.'
        *pl 'Шнуровка её платья распущена шире обычного, обнажая пышный край девичьей груди. Если не вмешаться прямо сейчас, соседские шашни перерастут в настоящий дворовый разврат.'
    end

    killvar 'AmandaNeighborBoysTextStage'
---

#AmandaNeighborBoysWatchSceneText
    NeighborWatchRoll = RAND(1, 2)

    if $AmandaNeighborBoyName2 <> '':
        *pl 'Притаившись за поленницей, вы наблюдаете за редкой и развратной картиной.'
        *pl 'Двое парней — ' + $AmandaNeighborBoyName + ' и ' + $AmandaNeighborBoyName2 + ' — зажали Аманду прямо у борта телеги. Один держит её сзади за бёдра, нетерпеливо пристраиваясь к задраному подолу, пока второй жадно подсовывает член ей в рот.'
        *pl 'Аманда часто дышит, её глаза лихорадочно блестят от запретного восторга: она упивается двойным вниманием дворовых воздыхателей, повизгивая от удовольствия, когда парни с хохотом меняются местами и поочерёдно наслаждаются её податливым молодым телом.'

    elseif AmandaNeighborBoyCurved = 1 and sluttiness['amanda'] >= 35 and sexacts['amanda'] >= 4:
        *pl 'Сквозь щель в досках сарая вы наблюдаете за уединением с Отто.'
        *pl 'Сын кожевенника прислонил Аманду к штабелю ящиков и, задрав её юбки, уверенно входит внутрь. Его член имеет заметный, крутой изгиб кверху — и этот непривычный угол заставляет Аманду испуганно-сладко вскрикнуть!'
        *pl 'Головка упирается прямо в самую чувствительную, глубокую точку её лона. Сестра судорожно запрокидывает голову, впиваясь ногтями в плечи парня, а из её приоткрытого рта вырываются протяжные, прерывистые стоны:'
        *pl '— О-ох... Отто... куда ты... как ты так достаёшь?! Там... там ещё никто так не доставал!..'
        *pl 'Парень довольно ухмыляется, чувствуя, как её стенки бьются в мелких спазмах вокруг его изогнутого ствола, и мощными короткими толчками доводит девушку до бурного, содрогающего оргазма.'

    elseif sluttiness['amanda'] >= 42 or AmandaNeighborBoysStage >= 3:
        if NeighborWatchRoll = 1:
            *pl 'Притаившись за гружённой дровами телегой, вы наблюдаете за происходящим из глубокой тени.'
            *pl $AmandaNeighborBoyName + ' вальяжно прислонился к тележному колесу, распустив завязки штанов и высвободив отвердевший багровый уд. Аманда уже стоит перед ним на коленях прямо в дорожной пыли, задрав подол, чтобы не запачкать ткань.'
            *pl 'Дрожащими пальчиками она бережно направляет головку себе в рот и начинает жадно, с влажными причмокиваниями насаживаться на член, запрокидывая голову и закатывая глаза от порочного восторга.'
            *pl 'Когда парень, прерывисто хрипя, пытается податься назад и излиться на землю, Аманда цепко хватает его за бёдра, мычит сквозь набитый рот и принимает всю горячую струю семени прямо себе в глотку, до последней капли.'
            *pl 'Проглотив всё без остатка и облизав влажные губы, она поднимает на тяжело дышащего парня озорные, затуманенные глаза:'
            *pl '— Дурак, только бы платье мне испортил! Мать бы сразу учуяла, чем пахнет, и живьём содрала бы шкуру!'
            *pl 'Поднявшись на ноги и отряхнув колени, она самодовольно улыбается, пока парень торопливо запахивает портки.'
        else:
            *pl 'Дверь дровяного сарая прикрыта на щеколду, но с обратной стороны под крышей зияет слуховое окошко. Взобравшись на штабель ящиков, вы осторожно заглядываете внутрь.'
            *pl 'Сквозь щели досок пробиваются золотистые пыльные лучи солнца. На куче душистого сухого сена развалился ' + $AmandaNeighborBoyName + ', лениво заложив руки за затылок.'
            *pl 'Аманда склонилась над ним на четвереньках. Её волосы рассыпались по его животу, а рот ритмично и глубоко заглатывает его толстый член, наполняя полумрак сарая чавкающими звуками.'
            *pl 'Сестра двигается уверенно и сноровисто, будто подобные ласки за сараем стали для неё привычным делом. Парень глухо рычит, впиваясь пальцами в её плечи, и судорожно кончает ей в горло.'
            *pl 'Аманда аккуратно принимает семя, терпеливо сглатывает и вытирает подбородок тыльной стороной ладони, явно наслаждаясь своей тайной властью над дворовым дружком.'
        end
    elseif sluttiness['amanda'] >= 28 or AmandaNeighborBoysStage >= 2:
        *pl 'Сквозь узкую щель забора вы наблюдаете за укромным уголком за поленницей.'
        *pl $AmandaNeighborBoyName + ' судорожно прижался спиной к брёвнам, запрокинув голову и сдавленно постанывая. Аманда запустила руку глубоко под его распущенные портки и уверенно, в такт его дыханию, сжимает и двигает кулачок по мокрому стволу.'
        *pl 'Она то и дело косится в сторону трактирного двора, вздрагивая от каждого шороха, но руки не убирает — пальцы её двигаются всё быстрее и жёстче.'
        *pl 'Парень всхлипывает, кончая прямо на сухую траву и пыльные лопухи у забора. Аманда брезгливо-насмешливо отступает, вытирает пальцы о клочок чистого сена и с лукавой усмешкой оглядывает обмякшего воздыхателя.'
    else:
        *pl 'Вы затаились за штабелем свежих досок, наблюдая за парочкой.'
        *pl $AmandaNeighborBoyName + ' наклоняется к самому лицу Аманды, нашептывая пылкие похвалы её девичьей красе, и осторожно припадает к её губам несмелым, но настойчивым поцелуем.'
        *pl 'Аманда вспыхивает румянцем до самых ушей. На пару мгновений она замирает, отвечая на ласку, но затем мягко упирается ладонями в его плечи и отстраняется, сбивчиво дыша:'
        *pl '— Хватит, ' + $AmandaNeighborBoyName + '... пусти! Брат или матушка в любой миг могут во двор выйти, а ты распускаешь руки!'
    end

    killvar 'NeighborWatchRoll'
---

#AmandaNeighborBoysActionText
    $NeighborBoysTextChoice = LCASE($ARGS[0])

    if $NeighborBoysTextChoice = 'send_away':
        *pl 'Вы с суровым видом делаете шаг вперёд и гаркаете во весь голос:'
        *pl '— А ну пошёл отсюда вон, пока я тебе рёбра не пересчитал!'
        *pl 'Соседский парень в панике шарахается, едва не ломая плетень, испуганно лепечет извинения и со всех ног удирает в проулок.'
        *pl 'Аманда остаётся на месте, пылая щеками от злости и стыда:'
        *pl '— Стефан! Вечно ты как медведь из чащи выламываешься! Мы просто перемолвились парой слов, а ты на весь квартал орёшь!'
        *pl 'Она сердито одёргивает подол и, сердито топая башмачками, убегает в кухню.'
    elseif $NeighborBoysTextChoice = 'ask':
        *pl 'Вы подходите к сестре и строго смотрите ей в глаза:'
        *pl '— И что это за тайные свидания за сараем посреди рабочего дня?'
        if virginity['amanda'] = 1:
            *pl 'Аманда вскидывает подбородок и гневно сверкает глазами:'
            *pl '— Да как ты смеешь обо мне такое думать?! Я честная девушка и никакой грязи себе не позволяю! Сосед просто спросил про свежее пиво, а ты уже себе невесть что навоображал!'
        else:
            *pl 'Аманда отводит глаза в сторону, но старается держаться с дерзким вызовом:'
            *pl '— Никаких свиданий. Мы просто перекинулись парой фраз, пока посуда мылась. Я уже не маленькая девочка, Стефан, и сама разберусь, с кем мне здороваться у забора.'
        end
        *pl 'Всей правды она, разумеется, не скажет, но по её бегающему взгляду ясно: соседские парни основательно взяли её в оборот.'
    elseif $NeighborBoysTextChoice = 'watch':
        gs 'AmandaNeighborBoysWatchSceneText'
    elseif $NeighborBoysTextChoice = 'join':
        *pl 'Вы неторопливо выходите из тени, не выказывая ни гнева, ни возмущения, и с многозначительной усмешкой оглядываете застигнутую парочку.'
        *pl 'Парень от неожиданности теряет дар речи: подтянув сползающие портки, он в ужасе пятится, сигает через забор и растворяется в огородах.'
        *pl 'Аманда медленно поднимается на ноги, пунцовая до самых корней волос. Её глаза испуганно расширены, но в глубине зрачков сквозит порочное, пьянящее волнение:'
        *pl '— Стефан... ты... ты стоял там всё это время? И... и просто смотрел?!'
        *pl 'Она тяжело дышит, судорожно теребя тесёмки платья, и не знает, провалиться ли сквозь землю от стыда или отдаться нахлынувшему запретному возбуждению.'
    elseif $NeighborBoysTextChoice = 'ignore':
        *pl 'Вы делаете вид, будто заняты осмотром бочек у задней стены, не глядя в их сторону.'
        *pl 'Аманда облегчённо выдыхает, поспешно отстраняясь от парня. Тот со сдавленным смешком ныряет в калитку, а сестра торопливо семенит обратно к служебному входу, стараясь не привлекать внимания.'
        *pl 'Границы дозволенного вновь сдвинулись на шаг вперёд, и оба вы об этом прекрасно знаете.'
    end

    killvar '$NeighborBoysTextChoice'
---
