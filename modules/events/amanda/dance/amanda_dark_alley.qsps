    *pl ' '

    if debug = 1:
        *pl '[DEBUG ALLEY] Stage: ' + STR(AmandaAlleyStage) + ' | Cart: ' + STR(AmandaAlleyCart) + ' | Place: ' + STR(AmandaAlleyPlace)
        *pl '[DEBUG ALLEY] Risk: ' + STR(AmandaAlleyRisk) + ' | Caught: ' + STR(AmandaAlleyCaught)
