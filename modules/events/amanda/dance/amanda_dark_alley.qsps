        end

        *pl ' '

        gs 'ActUiPrepare', 'В трактир', 'tavern'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end

    else:
        gs 'SceneShowVisual', 'images/dance/amanda/YouClose', 'ВОЗВРАЩЕНИЕ НА ПЛОЩАДЬ', 'large', 'webp'
        gs 'ShowLocationScreenTitle', 'ПОДВОРОТНЯ У ПЛОЩАДИ'

        if LOC('AmandaDanceAlleyEndText') = 1:
            gs 'AmandaDanceAlleyEndText'
        else:
            *pl 'Вы решаете не заходить дальше и выходите из тёмного прохода обратно к праздничной площади.'
            *pl 'Аманда тихо переводит дух, поправляет платье и улыбается вам.'
        end

        *pl ' '

        gs 'ActUiPrepare', 'На площадь', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MarketDance'
        end
    end

    killvar '$AmandaAlleyGirl'
    killvar '$AmandaAlleyResumeAction'
    killvar 'AmandaAlleyInterrupted'
---
