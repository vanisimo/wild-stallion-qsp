! ================================================
! FILE: modules/events/amanda/dance/amanda_dark_alley.qsps
! Подворотня после танца с Амандой
! Версия: FridayDance / compact menu v1
! Назначение:
! - заменить старый большой AmandaDarkAlley
! - сделать подворотню отдельным сюжетным ивентом после танца
! - использовать наше меню через Menu.Show
! - не дублировать sex_scene_core и не делать отдельные 12 поз
!
! Тексты берутся из:
! modules/events/dance/amanda_dark_alley_text.qsps
!
! Вход сюда идёт из:
! modules/events/dance/amanda_dance.qsps
! через локатор #AmandaDanceAlleyEvent
! ================================================

#AmandaDanceAlleyCanOffer

    AmandaDanceAlleyCanOffer = 0

    if AmandaHomeStage < 1:
        exit
    end

    if AmandaDanceKiss = 0:
        exit
    end

    if AmandaDanceAlley = 1:
        exit
    end

    AmandaDanceAlleyCanOffer = 1
---

#AmandaDanceAlleyMmfCanStart

    AmandaDanceAlleyMmfCanStart = 0

    if AmandaAlleyMmfDone = 1:
        exit
    end

    if AmandaAlleyCaught < 2:
        exit
    end

    if FamilyCorruptionStage < 3:
        exit
    end

    if AmandaAlleyClose = 0:
        exit
    end

    if AmandaHomeSex = 0:
        exit
    end

    AmandaDanceAlleyMmfCanStart = 1
---

#AmandaDanceAlleyEvent

    *clr
    clr
    cla

    $AmandaAlleyGirl = 'amanda'

    gs 'EnsureGirlData', $AmandaAlleyGirl

    if $RealName[$AmandaAlleyGirl] = '':
        $RealName[$AmandaAlleyGirl] = 'Аманда'
    end

    if AmandaAlleyDay <> day:
        gs 'AmandaDanceAlleyReset'
    end

    if AmandaAlleyStage = 0:
        AmandaAlleyStage = 1
        AmandaAlleyRisk = 10 + AmandaDancePublicRisk + AmandaPublicAttention / 5
        AmandaSecretiveness += 1
    end

    if LOC('ShowImage') = 1:
        gs 'ShowImage', 'amanda', 'dance', 'alley', 'intro'
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ПОДВОРОТНЯ У ПЛОЩАДИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaDanceAlleyMainText') = 1:
        gs 'AmandaDanceAlleyMainText'
    else:
        if $AmandaAlleyLastText <> '':
            *p $AmandaAlleyLastText
        else:
            *p 'Вы с Амандой отходите с шумной площади в тёмный проход между домами.'
            *p 'Музыка всё ещё слышна, но здесь каждый звук кажется опаснее.'
        end
    end

    *pl ' '

    if debug = 1:
        *pl '[DEBUG ALLEY] Stage: ' + STR(AmandaAlleyStage)
        *pl '[DEBUG ALLEY] Risk: ' + STR(AmandaAlleyRisk)
        *pl '[DEBUG ALLEY] Kiss: ' + STR(AmandaAlleyKiss)
        *pl '[DEBUG ALLEY] Close: ' + STR(AmandaAlleyClose)
        *pl '[DEBUG ALLEY] AfterSex: ' + STR(AmandaAlleyAfterSex)
        *pl '[DEBUG ALLEY] Caught: ' + STR(AmandaAlleyCaught)
        *pl '[DEBUG ALLEY] IntimStage Amanda: ' + STR(IntimStage[$AmandaAlleyGirl])
        *pl ' '
    end

    gs 'AmandaDanceAlleyBuildMenu'

    *p 'Что вы будете <a href="exec:gs ''Menu.Show'', ''AmandaAlleyMenu''">делать</a>?'
---

! ================================================
! FILE: modules/events/amanda/dance/amanda_dark_alley.qsps
! Сброс подворотни на новый день
! ================================================

#AmandaDanceAlleyReset

    AmandaAlleyDay = day
    AmandaAlleyStage = 0
    AmandaAlleyRisk = 0
    AmandaAlleyKiss = 0
    AmandaAlleyClose = 0
    AmandaAlleyOralDone = 0
    AmandaAlleyAfterSex = 0
    AmandaAlleyCaught = 0
    $AmandaAlleyLastText = ''
---

! ================================================
! FILE: modules/events/amanda/dance/amanda_dark_alley.qsps
! Меню подворотни
! Все пункты идут через Menu.Show
! ================================================

#AmandaDanceAlleyBuildMenu

    gs 'Menu.Destroy', 'AmandaAlleyMenu'
    gs 'Menu.Create', 'AmandaAlleyMenu'

    gs 'MenuUiAdd', 'AmandaAlleyMenu', 'Оглядеться', ''
    gs 'Menu.AddModule', 'AmandaAlleyMenu', {
        gt 'AmandaDanceAlleyAction', 'look'
    }

    if AmandaAlleyKiss = 0:
        gs 'MenuUiAdd', 'AmandaAlleyMenu', 'Поцеловать', ''
        gs 'Menu.AddModule', 'AmandaAlleyMenu', {
            gt 'AmandaDanceAlleyAction', 'kiss'
        }
    end

    if AmandaAlleyKiss = 1 and AmandaAlleyClose = 0:
        gs 'MenuUiAdd', 'AmandaAlleyMenu', 'Прижать ближе', ''
        gs 'Menu.AddModule', 'AmandaAlleyMenu', {
            gt 'AmandaDanceAlleyAction', 'close'
        }
    end

    if AmandaAlleyClose = 1:
        gs 'AmandaDanceAlleyMmfCanStart'

        if AmandaDanceAlleyMmfCanStart = 1:
            gs 'MenuUiAdd', 'AmandaAlleyMenu', 'Принять компанию прохожего', ''
            gs 'Menu.AddModule', 'AmandaAlleyMenu', {
                gt 'AmandaDanceAlleyMmfScene'
            }
        end

        killvar 'AmandaDanceAlleyMmfCanStart'

        if AmandaAlleyOralDone = 0:
            gs 'MenuUiAdd', 'AmandaAlleyMenu', 'Склонить к ласкам (минет)', ''
            gs 'Menu.AddModule', 'AmandaAlleyMenu', {
                gt 'AmandaDanceAlleyOralScene'
            }
        end
    end

    gs 'MenuUiAdd', 'AmandaAlleyMenu', 'Вернуться на площадь', ''
    gs 'Menu.AddModule', 'AmandaAlleyMenu', {
        gt 'AmandaDanceAlleyEnd'
    }
---

! ================================================
! FILE: modules/events/amanda/dance/amanda_dark_alley.qsps
! Обработка пунктов меню подворотни
! ================================================

#AmandaDanceAlleyAction

    $AmandaAlleyAction = LCASE($ARGS[0])
    $AmandaAlleyGirl = 'amanda'

    gs 'EnsureGirlData', $AmandaAlleyGirl

    if $AmandaAlleyAction = 'look':
        AmandaAlleyRisk += 2

    elseif $AmandaAlleyAction = 'kiss':
        AmandaAlleyKiss = 1
        AmandaAlleyStage = 2
        AmandaAlleyRisk += 5

        Friends[$AmandaAlleyGirl] += 1
        love[$AmandaAlleyGirl] += 1
        otkroven[$AmandaAlleyGirl] += 1
        AmandaPlayerPath += 1
        AmandaSecretiveness += 1

    elseif $AmandaAlleyAction = 'close':
        AmandaAlleyClose = 1
        AmandaAlleyStage = 3
        AmandaAlleyRisk += 8

        love[$AmandaAlleyGirl] += 1
        otkroven[$AmandaAlleyGirl] += 1
        sluttiness[$AmandaAlleyGirl] += 1
        AmandaScandalLevel += 1
        AmandaSecretiveness += 1

    else:
        AmandaAlleyRisk += 1
    end

    if LOC('AmandaDanceAlleyActionText') = 1:
        gs 'AmandaDanceAlleyActionText', $AmandaAlleyAction
    else:
        if $AmandaAlleyAction = 'look':
            $AmandaAlleyLastText = 'Вы оглядываетесь. Проход кажется пустым, но с площади всё ещё доносятся голоса.'
        elseif $AmandaAlleyAction = 'kiss':
            $AmandaAlleyLastText = 'Вы целуете Аманду. Она прислушивается к шагам на площади, но не отстраняется.'
        elseif $AmandaAlleyAction = 'close':
            $AmandaAlleyLastText = 'Вы притягиваете её ближе. Аманда оглядывается, но остаётся рядом.'
        else:
            $AmandaAlleyLastText = 'Вы задерживаетесь в подворотне ещё на несколько мгновений.'
        end
    end

    gs 'ClampGirlSocialStats', $AmandaAlleyGirl
    gs 'AmandaDanceAlleyRiskCheck'

    killvar '$AmandaAlleyAction'

    gt 'AmandaDanceAlleyEvent'
---

! ================================================
! FILE: modules/events/amanda/dance/amanda_dark_alley.qsps
! Проверка риска быть замеченными
! Пока это лёгкое последствие и рост скандальности, не наказание
! ================================================

#AmandaDanceAlleyRiskCheck

    AmandaAlleyRoll = RAND(1, 100)
    AmandaAlleyChance = AmandaAlleyRisk

    if AmandaAlleyChance > 60:
        AmandaAlleyChance = 60
    end

    if AmandaAlleyRoll <= AmandaAlleyChance:
        AmandaAlleyCaught += 1
        TavernScandal += 1
        TavernScandalLevel += 1
        AmandaScandalLevel += 1

        if LOC('AmandaDanceAlleyRiskText') = 1:
            gs 'AmandaDanceAlleyRiskText'
        else:
            $AmandaAlleyLastText += '<br><br>С улицы доносится чужой голос. Вы оба на мгновение замираете.'
        end
    end

    killvar 'AmandaAlleyRoll'
    killvar 'AmandaAlleyChance'
---

! ================================================
! FILE: modules/events/amanda/dance/amanda_dark_alley.qsps
! Ласки в подворотне — минет (максимум для ГГ на улице)
! ================================================

#AmandaDanceAlleyToSexScene
    gt 'AmandaDanceAlleyOralScene'
---

#AmandaDanceAlleyOralScene

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/amanda_dark_alley/amanda_dance_alley_oral', 'ПОДВОРОТНЯ — МИНЕТ', 'large', 'webp'
    $AmandaAlleyGirl = 'amanda'

    gs 'EnsureGirlData', $AmandaAlleyGirl

    *pl '══════════════════════════════════════════════'
    *pl ' ПОДВОРОТНЯ У ПЛОЩАДИ — ЛАСКИ В ТЕМНОТЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaDanceAlleyOralIntroText') = 1:
        gs 'AmandaDanceAlleyOralIntroText'
    else:
        *p 'Вы прижимаете Аманду к каменной стене, пытаясь зайти дальше.'
        *p 'Она смеётся и мягко перехватывает вашу руку:'
        *p '«Погоди, братик! В грязной подворотне я тебе не дамся — платье испортим, да и стыдно перед людьми. Если хочешь меня всю — дождись спальни дома! А здесь… здесь я могу порадовать тебя ротиком.»'
        *p 'Она опускается перед вами на колени и с жадным любопытством высвобождает ваш налитый член.'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Спустить ей в ротик', 'cum_mouth'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaDanceAlleyOralFinish', 'mouth'
    end

    gs 'ActUiPrepare', 'Спустить на лицо и грудь', 'cum_face'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaDanceAlleyOralFinish', 'face'
    end
---

#AmandaDanceAlleyOralFinish

    $OralFinishType = LCASE($ARGS[0])
    if $OralFinishType = '':
        $OralFinishType = 'mouth'
    end

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/amanda_dark_alley/amanda_dance_alley_oral_finish', 'ПОДВОРОТНЯ — ФИНАЛ МИНЕТА', 'large', 'webp'
    $AmandaAlleyGirl = 'amanda'

    gs 'EnsureGirlData', $AmandaAlleyGirl

    AmandaAlleyOralDone = 1
    AmandaAlleyAfterSex = 1
    AmandaPlayerAlleySexEver = 1
    oralacts[$AmandaAlleyGirl] += 1
    sluttiness[$AmandaAlleyGirl] += 1
    love[$AmandaAlleyGirl] += 1
    otkroven[$AmandaAlleyGirl] += 1
    AmandaPlayerPath += 1
    AmandaScandalLevel += 1
    TavernScandal += 1

    gs 'RegisterPlayerCum'

    if LOC('KnowledgeRegisterFact') = 1:
        gs 'KnowledgeRegisterFact', 'amanda_alley_player'
    end

    if LOC('KnowledgeRegisterPlayerKnows') = 1:
        gs 'KnowledgeRegisterPlayerKnows', 'amanda_alley_player', 'witness'
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ПОДВОРОТНЯ У ПЛОЩАДИ — ФИНАЛ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaDanceAlleyOralFinishText') = 1:
        gs 'AmandaDanceAlleyOralFinishText', $OralFinishType
    else:
        if $OralFinishType = 'mouth':
            *p 'Вы кончаете Аманде прямо в рот. Она жадно сглатывает горячие струи семени и довольно облизывает губы.'
        else:
            *p 'Вы кончаете Аманде на лицо и открытое декольте. Белые горячие капли покрывают её разгорячённую кожу.'
        end
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaDanceAlleyEnd'
    end

    killvar '$OralFinishType'
    killvar '$AmandaAlleyGirl'
---

! ================================================
! FILE: modules/events/amanda/dance/amanda_dark_alley.qsps
! Завершение подворотни и возврат на танцы
! ================================================

#AmandaDanceAlleyMmfScene

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/amanda_dark_alley/amanda_dance_alley_mmf_scene', 'ПОДВОРОТНЯ — ТРОЕ', 'large', 'webp'
    $AmandaAlleyGirl = 'amanda'

    gs 'EnsureGirlData', $AmandaAlleyGirl

    AmandaAlleyMmfDone = 1
    AmandaAlleyAfterSex = 1
    AmandaPlayerAlleySexEver = 1
    AmandaScandalLevel += 2
    TavernScandal += 2
    sluttiness['amanda'] += 2
    AmandaNpcPath += 1
    AmandaPlayerPath += 1

    if LOC('KnowledgeRegisterFact') = 1:
        gs 'KnowledgeRegisterFact', 'amanda_alley_mmf'
    end

    if LOC('KnowledgeRegisterPlayerKnows') = 1:
        gs 'KnowledgeRegisterPlayerKnows', 'amanda_alley_mmf', 'witness'
    end

    gs 'RegisterSex', 'amanda', 'group', 0, 1
    vaginalacts['amanda'] += 1

    *pl '══════════════════════════════════════════════'
    *pl ' ПОДВОРОТНЯ — ТРОЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaDanceAlleyMmfText') = 1:
        gs 'AmandaDanceAlleyMmfText'
    else:
        *p 'Из тени выходит пьяный горожанин — слишком смелый для своего ранга, но слишком пьян, чтобы стесняться.'
        *p 'Аманда вздрагивает, потом смотрит на вас: не «спаси», а «решай».'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaDanceAlleyEnd'
    end

    killvar '$AmandaAlleyGirl'
---

#AmandaDanceAlleyEnd

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/amanda_dark_alley/amanda_dance_alley_end', 'ВОЗВРАЩЕНИЕ НА ПЛОЩАДЬ', 'large', 'webp'
    $AmandaAlleyGirl = 'amanda'

    gs 'EnsureGirlData', $AmandaAlleyGirl

    if AmandaAlleyAfterSex = 1:
        AmandaPlayerAlleySexEver = 1
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ВОЗВРАЩЕНИЕ НА ПЛОЩАДЬ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaDanceAlleyEndText') = 1:
        gs 'AmandaDanceAlleyEndText'
    else:
        *p 'Вы возвращаетесь к шуму площади. Аманда старается выглядеть спокойно, но после подворотни это получается не сразу.'
    end

    AmandaDanceEnded = 1

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end

    killvar '$AmandaAlleyGirl'
---
