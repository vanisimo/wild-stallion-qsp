    end

    gs 'AmandaDanceAlleyBuildForeplayMenu'

    *p 'Что ты будешь <a href="exec:gs ''Menu.Show'', ''AmandaAlleyMenu''">делать</a>?'

    gs 'ActUiPrepare', 'Уйти', 'return'
