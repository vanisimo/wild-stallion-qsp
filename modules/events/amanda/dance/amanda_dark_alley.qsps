! - Осознанный выбор места близости (у каменной стены или в арбе с сеном, если арба в переулке)
! - Минет (начало -> разгар / глубокий минет -> финал)
! - Полноценный секс (начало -> разгар -> переходы между всеми позами -> финал + ATM)
! - Застукивание соседскими парнями (единый пул из 10 парней с привязкой к заднему двору)
! - Чистая интеграция с RegisterSex, CanCumToday и утренними реакциями
! ================================================

#AmandaDanceAlleyCanOffer
    AmandaDanceAlleyCanOffer = 0

    if AmandaHomeStage < 3:
        exit
    end

    if AmandaDanceKiss = 0:
        exit
    end

    if AmandaDanceAlley = 1:
        exit
    end

    AmandaDanceAlleyCanOffer = 1
---

#AmandaDanceAlleyReset
    AmandaAlleyDay = day
    AmandaAlleyStage = 0
    AmandaAlleyRisk = 0
    AmandaAlleyKiss = 0
    AmandaAlleyClose = 0
    AmandaAlleyPetting = 0
    AmandaAlleyPlace = 0
    AmandaAlleyCart = 0
    AmandaAlleyPeeperTriggered = 0
    AmandaDanceSleep = 0
    AmandaAlleyAfterSex = 0
    AmandaAlleyCaught = 0
    AmandaAlleyInterrupted = 0
    $AmandaAlleyLastText = ''
    $AmandaAlleyResumeAction = ''
    $AmandaAlleyLastTransition = ''
---

#AmandaDanceAlleyEvent
    *clr
    clr
    cla

    $AmandaAlleyGirl = 'amanda'
    gs 'EnsureGirlData', $AmandaAlleyGirl

    if $RealName[$AmandaAlleyGirl] = '':
        $RealName[$AmandaAlleyGirl] = 'Аманда'
    end

    if AmandaAlleyDay <> day:
        gs 'AmandaDanceAlleyReset'
    end

    if AmandaAlleyStage = 0:
        AmandaAlleyStage = 1
        AmandaAlleyRisk = 10 + AmandaDancePublicRisk + AmandaPublicAttention / 5
        AmandaSecretiveness += 1
        if RAND(1, 100) <= 50:
            AmandaAlleyCart = 1
            AmandaAlleyPlace = 2
        else
            AmandaAlleyCart = 0
            AmandaAlleyPlace = 1
        end
    end

    SceneArtUseReal = 1
    if AmandaAlleyPetting = 1:
        gs 'SceneShowVisual', 'images/events/amanda/grope/dresspanties', 'ПОДВОРОТНЯ — ПОД ЮБКУ', 'large', 'webp'
    elseif AmandaAlleyClose = 1:
        gs 'SceneShowVisual', 'images/dance/amanda/YouClose', 'ПОДВОРОТНЯ — ОБЪЯТИЯ', 'large', 'webp'
    elseif AmandaAlleyKiss = 1:
        gs 'SceneShowVisual', 'images/dance/amanda/YouKiss', 'ПОДВОРОТНЯ — ПОЦЕЛУЙ', 'large', 'webp'
    else
        gs 'SceneShowVisual', 'images/dance/amanda/YouClose', 'ПОДВОРОТНЯ У ПЛОЩАДИ', 'large', 'webp'
    end

    gs 'ShowLocationScreenTitle', 'ПОДВОРОТНЯ У ПЛОЩАДИ'

    if AmandaAlleyStage = 1 and $AmandaAlleyLastText = '' and LOC('AmandaDanceAlleyText') = 1:
        gs 'AmandaDanceAlleyText'
        *pl ' '
    end

    if LOC('AmandaDanceAlleyMainText') = 1:
        gs 'AmandaDanceAlleyMainText'
    else
        if $AmandaAlleyLastText <> '':
            *p $AmandaAlleyLastText
        else
            *pl 'Ты уводишь Аманду с шумной площади в тёмный проход между домами.'
            *pl 'Музыка всё ещё слышна, но здесь каждый шорох кажется опаснее.'
        end
    end

    if AmandaAlleyCart = 1:
        *pl ' '
        if AmandaAlleyPlace = 2:
            *pl 'В глубине переулка стоит высокая деревянная арба с сухим сеном — вы с Амандой укрылись прямо у её борта.'
        else
