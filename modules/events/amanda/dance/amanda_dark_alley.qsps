! ================================================
! FILE: modules/events/dance/amanda_dark_alley.qsps
! ╨Я╨╛╨┤╨▓╨╛╤А╨╛╤В╨╜╤П ╨┐╨╛╤Б╨╗╨╡ ╤В╨░╨╜╤Ж╨░ ╤Б ╨Р╨╝╨░╨╜╨┤╨╛╨╣
! ╨Т╨╡╤А╤Б╨╕╤П: FridayDance / compact alley scene v2
! ╨Э╨░╨╖╨╜╨░╤З╨╡╨╜╨╕╨╡:
! - ╤Б╤О╨╢╨╡╤В╨╜╤Л╨╣ ╨╕╨▓╨╡╨╜╤В ╨┐╨╛╤Б╨╗╨╡ ╨┐╤П╤В╨╜╨╕╤З╨╜╨╛╨│╨╛ ╤В╨░╨╜╤Ж╨░ ╤Б ╨Р╨╝╨░╨╜╨┤╨╛╨╣
! - ╨┐╨╡╤В╤В╨╕╨╜╨│ ╨┐╨╛╨┤ ╤О╨▒╨║╨╛╨╣
! - ╨╝╨╕╨╜╨╡╤В (2 ╤Н╨║╤А╨░╨╜╨░ + ╤Д╨╕╨╜╨░╨╗) ╤Б ╨┐╤А╨╛╨▓╨╡╤А╨║╨╛╨╣ ╨│╨╗╤Г╨▒╨╕╨╜╤Л ╨│╨╛╤А╨╗╨░ ╨╕ ╨║╨╛╤А╤А╤Г╨┐╤Ж╨╕╨╕
! - ╨┐╨╛╨╗╨╜╨╛╤Ж╨╡╨╜╨╜╤Л╨╣ ╤Б╨╡╨║╤Б (╤Б╤В╨╡╨╜╨░ / ╨░╤А╨▒╨░, ╨▓╨░╨│╨╕╨╜╨░╨╗╤М╨╜╤Л╨╣ / ╨░╨╜╨░╨╗╤М╨╜╤Л╨╣ + ATM ╨┐╤А╨╛╨▓╨╡╤А╨║╨░)
! - ╨╖╨░╤Б╤В╤Г╨║╨╕╨▓╨░╨╜╨╕╨╡ ╤Б╨╛╤Б╨╡╨┤╤Б╨║╨╕╨╝╨╕ ╨┐╨░╤А╨╜╤П╨╝╨╕ (10 ╨▓╨░╤А╨╕╨░╨╜╤В╨╛╨▓ ╤Б ╤А╨╡╨░╨║╤Ж╨╕╨╡╨╣ ╨┐╨╛ ╤А╨░╨╖╨▓╤А╨░╤Й╤С╨╜╨╜╨╛╤Б╤В╨╕)
! - ╨╕╨╜╤В╨╡╨│╤А╨░╤Ж╨╕╤П ╤Б ╨╛╨▒╤Й╨╕╨╝╨╕ ╤Б╤З╨╡╤В╤З╨╕╨║╨░╨╝╨╕ ╤Б╨╡╨║╤Б╨░ ╨╕ ╤Б╨╡╨╝╤П╨╕╨╖╨▓╨╡╤А╨╢╨╡╨╜╨╕╨╣
!
! ╨в╨╡╨║╤Б╤В╤Л ╨▒╨╡╤А╤Г╤В╤Б╤П ╨╕╨╖:
! modules/events/dance/amanda_dark_alley_text.qsps
!
! ╨Т╤Е╨╛╨┤ ╤Б╤О╨┤╨░ ╨╕╨┤╤С╤В ╨╕╨╖:
! modules/events/dance/amanda_dance.qsps
! ╤З╨╡╤А╨╡╨╖ ╨╗╨╛╨║╨░╤В╨╛╤А #AmandaDanceAlleyEvent
! ================================================

#AmandaDanceAlleyCanOffer

    AmandaDanceAlleyCanOffer = 0

    if AmandaHomeStage < 3:
        exit
    end

    if AmandaDanceKiss = 0:
        exit
    end

    if AmandaDanceAlley = 1:
        exit
    end

    AmandaDanceAlleyCanOffer = 1
---


#AmandaDanceAlleyEvent

    *clr
    clr
    cla

    $AmandaAlleyGirl = 'amanda'

    gs 'EnsureGirlData', $AmandaAlleyGirl

    if $RealName[$AmandaAlleyGirl] = '':
        $RealName[$AmandaAlleyGirl] = '╨Р╨╝╨░╨╜╨┤╨░'
    end

    if AmandaAlleyDay <> day:
        gs 'AmandaDanceAlleyReset'
    end

    if AmandaAlleyStage = 0:
        AmandaAlleyStage = 1
        AmandaAlleyRisk = 10 + AmandaDancePublicRisk + AmandaPublicAttention / 5
        AmandaSecretiveness += 1
    end

    SceneArtUseReal = 1
    if AmandaAlleyPetting = 1:
        gs 'SceneShowVisual', 'images/events/amanda/grope/dresspanties', '╨Я╨Ю╨Ф╨Т╨Ю╨а╨Ю╨в╨Э╨п тАФ ╨Я╨Ю╨Ф ╨о╨С╨Ъ╨г', 'large', 'webp'
    elseif AmandaAlleyClose = 1:
        gs 'SceneShowVisual', 'images/dance/amanda/YouClose', '╨Я╨Ю╨Ф╨Т╨Ю╨а╨Ю╨в╨Э╨п тАФ ╨Ю╨С╨к╨п╨в╨Ш╨п', 'large', 'webp'
    elseif AmandaAlleyKiss = 1:
        gs 'SceneShowVisual', 'images/dance/amanda/YouKiss', '╨Я╨Ю╨Ф╨Т╨Ю╨а╨Ю╨в╨Э╨п тАФ ╨Я╨Ю╨ж╨Х╨Ы╨г╨Щ', 'large', 'webp'
    else:
        gs 'SceneShowVisual', 'images/dance/amanda/YouClose', '╨Я╨Ю╨Ф╨Т╨Ю╨а╨Ю╨в╨Э╨п ╨г ╨Я╨Ы╨Ю╨й╨Р╨Ф╨Ш', 'large', 'webp'
    end

    *pl 'тХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХР'
    *pl ' ╨Я╨Ю╨Ф╨Т╨Ю╨а╨Ю╨в╨Э╨п ╨г ╨Я╨Ы╨Ю╨й╨Р╨Ф╨Ш'
    *pl 'тХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХРтХР'
    *pl ' '

    if LOC('AmandaDanceAlleyMainText') = 1:
        gs 'AmandaDanceAlleyMainText'
    else:
        if $AmandaAlleyLastText <> '':
            *p $AmandaAlleyLastText
        else:
            *p '╨Т╤Л ╤Б ╨Р╨╝╨░╨╜╨┤╨╛╨╣ ╨╛╤В╤Е╨╛╨┤╨╕╤В╨╡ ╤Б ╤И╤Г╨╝╨╜╨╛╨╣ ╨┐╨╗╨╛╤Й╨░╨┤╨╕ ╨▓ ╤В╤С╨╝╨╜╤Л╨╣ ╨┐╤А╨╛╤Е╨╛╨┤ ╨╝╨╡╨╢╨┤╤Г ╨┤╨╛╨╝╨░╨╝╨╕.'
            *p '╨Ь╤Г╨╖╤Л╨║╨░ ╨▓╤Б╤С ╨╡╤Й╤С ╤Б╨╗╤Л╤И╨╜╨░, ╨╜╨╛ ╨╖╨┤╨╡╤Б╤М ╨║╨░╨╢╨┤╤Л╨╣ ╨╖╨▓╤Г╨║ ╨║╨░╨╢╨╡╤В╤Б╤П ╨╛╨┐╨░╤Б╨╜╨╡╨╡.'
        end
    end

    *pl ' '

    if debug = 1:
        *pl '[DEBUG ALLEY] Stage: ' + STR(AmandaAlleyStage)
        *pl '[DEBUG ALLEY] Risk: ' + STR(AmandaAlleyRisk)
        *pl '[DEBUG ALLEY] Kiss: ' + STR(AmandaAlleyKiss)
        *pl '[DEBUG ALLEY] Close: ' + STR(AmandaAlleyClose)
        *pl '[DEBUG ALLEY] Petting: ' + STR(AmandaAlleyPetting)
        *pl '[DEBUG ALLEY] AfterSex: ' + STR(AmandaAlleyAfterSex)
        *pl '[DEBUG ALLEY] Caught: ' + STR(AmandaAlleyCaught)
        *pl '[DEBUG ALLEY] IntimStage Amanda: ' + STR(IntimStage[$AmandaAlleyGirl])
        *pl ' '
    end

    gs 'AmandaDanceAlleyBuildMenu'

    *p '╨з╤В╨╛ ╨▓╤Л ╨▒╤Г╨┤╨╡╤В╨╡ <a href="exec:gs ''Menu.Show'', ''AmandaAlleyMenu''">╨┤╨╡╨╗╨░╤В╤М</a>?'
---

#AmandaDanceAlleyReset

    AmandaAlleyDay = day
    AmandaAlleyStage = 0
    AmandaAlleyRisk = 0
    AmandaAlleyKiss = 0
    AmandaAlleyClose = 0
    AmandaAlleyPetting = 0
    AmandaAlleyPlace = 0
    AmandaAlleyPeeperTriggered = 0
    AmandaDanceSleep = 0
    AmandaAlleyAfterSex = 0
    AmandaAlleyCaught = 0
    $AmandaAlleyLastText = ''
---

#AmandaDanceAlleyBuildMenu

    gs 'Menu.Destroy', 'AmandaAlleyMenu'
    gs 'Menu.Create', 'AmandaAlleyMenu'

    gs 'MenuUiAdd', 'AmandaAlleyMenu', '╨Ю╨│╨╗╤П╨┤╨╡╤В╤М╤Б╤П', ''
    gs 'Menu.AddModule', 'AmandaAlleyMenu', {
        gt 'AmandaDanceAlleyAction', 'look'
    }

    if AmandaAlleyKiss = 0:
        gs 'MenuUiAdd', 'AmandaAlleyMenu', '╨Я╨╛╤Ж╨╡╨╗╨╛╨▓╨░╤В╤М', ''
        gs 'Menu.AddModule', 'AmandaAlleyMenu', {
            gt 'AmandaDanceAlleyAction', 'kiss'
        }
    end

    if AmandaAlleyKiss = 1 and AmandaAlleyClose = 0:
        gs 'MenuUiAdd', 'AmandaAlleyMenu', '╨Я╤А╨╕╨╢╨░╤В╤М ╨▒╨╗╨╕╨╢╨╡', ''
        gs 'Menu.AddModule', 'AmandaAlleyMenu', {
            gt 'AmandaDanceAlleyAction', 'close'
        }
    end

    if AmandaAlleyClose = 1:
        if AmandaAlleyPetting = 0:
            gs 'MenuUiAdd', 'AmandaAlleyMenu', '╨Ч╨░╨╗╨╡╨╖╤В╤М ╨┐╨╛╨┤ ╤О╨▒╨║╤Г ╨▓ ╤В╤А╤Г╤Б╨╕╨║╨╕ (╨┐╨╡╤В╤В╨╕╨╜╨│)', ''
            gs 'Menu.AddModule', 'AmandaAlleyMenu', {
                gt 'AmandaDanceAlleyAction', 'petting'
            }
        else:
            gs 'MenuUiAdd', 'AmandaAlleyMenu', '╨Я╨╛╨╗╨░╤Б╨║╨░╤В╤М ╨┐╨╛╨┤ ╤О╨▒╨║╨╛╨╣', ''
            gs 'Menu.AddModule', 'AmandaAlleyMenu', {
                gt 'AmandaDanceAlleyAction', 'petting'
            }
        end


        if (AmandaHomeStage >= 3 or BlowjobCount['amanda'] >= 1 or oralacts['amanda'] >= 1):
            gs 'MenuUiAdd', 'AmandaAlleyMenu', '╨Ь╨╕╨╜╨╡╤В ╨▓ ╨┐╨╛╨┤╨▓╨╛╤А╨╛╤В╨╜╨╡', ''
            gs 'Menu.AddModule', 'AmandaAlleyMenu', {
                gt 'AmandaDanceAlleyBlowjob'
            }
        end

        if (AmandaHomeSex >= 1 or HadVaginalWithPlayer['amanda'] >= 1):
            gs 'MenuUiAdd', 'AmandaAlleyMenu', '╨Я╨╛╨╗╨╜╨╛╤Ж╨╡╨╜╨╜╨░╤П ╨▒╨╗╨╕╨╖╨╛╤Б╤В╤М ╨▓ ╨┐╨╡╤А╨╡╤Г╨╗╨║╨╡', ''
            gs 'Menu.AddModule', 'AmandaAlleyMenu', {
                gt 'AmandaDanceAlleySex'
            }
        else:
            gs 'MenuUiAdd', 'AmandaAlleyMenu', '╨Я╤А╨╛╨┤╨╛╨╗╨╢╨╕╤В╤М ╨▒╨╗╨╕╨╖╨╛╤Б╤В╤М', ''
            gs 'Menu.AddModule', 'AmandaAlleyMenu', {
                gt 'AmandaDanceAlleyToSexScene'
            }
        end
    end

    if AmandaHomeStage >= 3 and (AmandaAlleyKiss = 1 or AmandaAlleyClose = 1):
        gs 'MenuUiAdd', 'AmandaAlleyMenu', '╨г╨╣╤В╨╕ ╨▓╨╝╨╡╤Б╤В╨╡ ╨▓ ╤В╤А╨░╨║╤В╨╕╤А (╨╛╨▒╨╜╨╕╨╝╨░╤И╨║╨╕)', ''
        gs 'Menu.AddModule', 'AmandaAlleyMenu', {
            gt 'AmandaDanceLeaveHome'
        }
    end

    gs 'MenuUiAdd', 'AmandaAlleyMenu', '╨г╨╣╤В╨╕ ╤Б ╨┐╨╗╨╛╤Й╨░╨┤╨╕ ╨▓ ╤В╤А╨░╨║╤В╨╕╤А', ''
    gs 'Menu.AddModule', 'AmandaAlleyMenu', {
        gt 'AmandaDanceAlleyEnd'
    }
---

#AmandaDanceAlleyAction

    $AmandaAlleyAction = LCASE($ARGS[0])
    $AmandaAlleyGirl = 'amanda'

    gs 'EnsureGirlData', $AmandaAlleyGirl

    if $AmandaAlleyAction = 'look':
        AmandaAlleyRisk += 2

    elseif $AmandaAlleyAction = 'kiss':
        AmandaAlleyKiss = 1
        AmandaAlleyStage = 2
        AmandaAlleyRisk += 5

        Friends[$AmandaAlleyGirl] += 1
        love[$AmandaAlleyGirl] += 1
        otkroven[$AmandaAlleyGirl] += 1
        AmandaPlayerPath += 1
        AmandaSecretiveness += 1

    elseif $AmandaAlleyAction = 'close':
        AmandaAlleyClose = 1
        AmandaAlleyStage = 3
        AmandaAlleyRisk += 8

        love[$AmandaAlleyGirl] += 1
        otkroven[$AmandaAlleyGirl] += 1
        sluttiness[$AmandaAlleyGirl] += 1
        AmandaScandalLevel += 1
        AmandaSecretiveness += 1

    elseif $AmandaAlleyAction = 'petting':
        AmandaAlleyPetting = 1
        AmandaAlleyStage = 4
        AmandaAlleyRisk += 10

        love[$AmandaAlleyGirl] += 1
        otkroven[$AmandaAlleyGirl] += 1
        sluttiness[$AmandaAlleyGirl] += 1
        AmandaScandalLevel += 1
        AmandaSecretiveness += 1

    else:
        AmandaAlleyRisk += 1
    end

    if LOC('AmandaDanceAlleyActionText') = 1:
        gs 'AmandaDanceAlleyActionText', $AmandaAlleyAction
    else:
        if $AmandaAlleyAction = 'look':
            $AmandaAlleyLastText = '╨Т╤Л ╨╛╨│╨╗╤П╨┤╤Л╨▓╨░╨╡╤В╨╡╤Б╤М. ╨Я╤А╨╛╤Е╨╛╨┤ ╨║╨░╨╢╨╡╤В╤Б╤П ╨┐╤Г╤Б╤В╤Л╨╝, ╨╜╨╛ ╤Б ╨┐╨╗╨╛╤Й╨░╨┤╨╕ ╨▓╤Б╤С ╨╡╤Й╤С ╨┤╨╛╨╜╨╛╤Б╤П╤В╤Б╤П ╨│╨╛╨╗╨╛╤Б╨░.'
        elseif $AmandaAlleyAction = 'kiss':
            $AmandaAlleyLastText = '╨Т╤Л ╤Ж╨╡╨╗╤Г╨╡╤В╨╡ ╨Р╨╝╨░╨╜╨┤╤Г. ╨Ю╨╜╨░ ╨┐╤А╨╕╤Б╨╗╤Г╤И╨╕╨▓╨░╨╡╤В╤Б╤П ╨║ ╤И╨░╨│╨░╨╝ ╨╜╨░ ╨┐╨╗╨╛╤Й╨░╨┤╨╕, ╨╜╨╛ ╨╜╨╡ ╨╛╤В╤Б╤В╤А╨░╨╜╤П╨╡╤В╤Б╤П.'
        elseif $AmandaAlleyAction = 'close':
            $AmandaAlleyLastText = '╨Т╤Л ╨┐╤А╨╕╤В╤П╨│╨╕╨▓╨░╨╡╤В╨╡ ╨╡╤С ╨▒╨╗╨╕╨╢╨╡. ╨Р╨╝╨░╨╜╨┤╨░ ╨╛╨│╨╗╤П╨┤╤Л╨▓╨░╨╡╤В╤Б╤П, ╨╜╨╛ ╨╛╤Б╤В╨░╤С╤В╤Б╤П ╤А╤П╨┤╨╛╨╝.'
        elseif $AmandaAlleyAction = 'petting':
            $AmandaAlleyLastText = '╨Т╤Л ╨╛╤Б╤В╨╛╤А╨╛╨╢╨╜╨╛ ╨╗╨░╤Б╨║╨░╨╡╤В╨╡ ╨Р╨╝╨░╨╜╨┤╤Г ╨┐╨╛╨┤ ╤О╨▒╨║╨╛╨╣. ╨Ю╨╜╨░ ╤Б╨╝╤Г╤Й╤С╨╜╨╜╨╛ ╨▓╨╖╨┤╤А╨░╨│╨╕╨▓╨░╨╡╤В, ╨╜╨╛ ╨╜╨╡ ╨╛╤В╤Б╤В╤А╨░╨╜╤П╨╡╤В╤Б╤П.'
        else:
            $AmandaAlleyLastText = '╨Т╤Л ╨╖╨░╨┤╨╡╤А╨╢╨╕╨▓╨░╨╡╤В╨╡╤Б╤М ╨▓ ╨┐╨╛╨┤╨▓╨╛╤А╨╛╤В╨╜╨╡ ╨╡╤Й╤С ╨╜╨░ ╨╜╨╡╤Б╨║╨╛╨╗╤М╨║╨╛ ╨╝╨│╨╜╨╛╨▓╨╡╨╜╨╕╨╣.'
        end
    end

    gs 'ClampGirlSocialStats', $AmandaAlleyGirl
    gs 'AmandaDanceAlleyRiskCheck'

    killvar '$AmandaAlleyAction'

    gt 'AmandaDanceAlleyEvent'
---

#AmandaDanceAlleyRiskCheck

    AmandaAlleyRoll = RAND(1, 100)
    AmandaAlleyChance = AmandaAlleyRisk

    if AmandaAlleyChance > 60:
        AmandaAlleyChance = 60
    end

    if AmandaAlleyRoll <= AmandaAlleyChance:
        AmandaAlleyCaught += 1
        TavernScandal += 1
        TavernScandalLevel += 1
        AmandaScandalLevel += 1

        if LOC('AmandaDanceAlleyRiskText') = 1:
            gs 'AmandaDanceAlleyRiskText'
        else:
            $AmandaAlleyLastText += '<br><br>╨б ╤Г╨╗╨╕╤Ж╤Л ╨┤╨╛╨╜╨╛╤Б╨╕╤В╤Б╤П ╤З╤Г╨╢╨╛╨╣ ╨│╨╛╨╗╨╛╤Б. ╨Т╤Л ╨╛╨▒╨░ ╨╜╨░ ╨╝╨│╨╜╨╛╨▓╨╡╨╜╨╕╨╡ ╨╖╨░╨╝╨╕╤А╨░╨╡╤В╨╡.'
        end
    end

    killvar 'AmandaAlleyRoll'
    killvar 'AmandaAlleyChance'
---

#AmandaAlleyPeepersInit

    $AmandaAlleyBoyName[0] = '╨в╨╛╨╝╨░╤Б'
    $AmandaAlleyBoyDesc[0] = '╤Б╤Л╨╜ ╨╝╤П╤Б╨╜╨╕╨║╨░ ╤Б ╤А╤Л╨╜╨║╨░'
    $AmandaAlleyBoyName[1] = '╨Я╨╕╤В╨╡╤А'
    $AmandaAlleyBoyDesc[1] = '╨┐╨╛╨┤╨╝╨░╤Б╤В╨╡╤А╤М╨╡ ╨║╤Г╨╖╨╜╨╡╤Ж╨░'
    $AmandaAlleyBoyName[2] = '╨С╤А╤Г╨╜╨╛'
    $AmandaAlleyBoyDesc[2] = '╨┐╨░╤А╨╡╨╜╤С╨║ ╨╕╨╖ ╨┐╨╛╤А╤В╨╛╨▓╤Л╤Е ╨┤╨╛╨║╨╛╨▓'
    $AmandaAlleyBoyName[3] = '╨Ы╤О╨║'
    $AmandaAlleyBoyDesc[3] = '╨┐╨╛╨╝╨╛╤Й╨╜╨╕╨║ ╨╝╨╡╨╗╤М╨╜╨╕╨║╨░'
    $AmandaAlleyBoyName[4] = '╨е╨░╨╜╤Б'
