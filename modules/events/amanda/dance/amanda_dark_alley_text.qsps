! USER-OWNED TEXT
! ╨в╨╡╨║╤Б╤В╤Л ╨┐╨╛╨┤╨▓╨╛╤А╨╛╤В╨╜╨╕ ╨┐╨╛╤Б╨╗╨╡ ╤В╨░╨╜╤Ж╨░ ╤Б ╨Р╨╝╨░╨╜╨┤╨╛╨╣
! ╨а╨░╤Б╤И╨╕╤А╨╡╨╜╨╜╨░╤П ╨▓╨╡╤А╤Б╨╕╤П ╤Б ╨│╨╗╤Г╨▒╨╛╨║╨╕╨╝╨╕ ╨┤╨╡╤В╨░╨╗╤П╨╝╨╕ ╨╕ ╨▓╨░╤А╨╕╨░╤Ж╨╕╤П╨╝╨╕
! ╨Ы╨╡╤Б╤В╨╜╨╕╤Ж╨░ ╤Б╤В╤А╨╛╨│╨╛ ╨┐╤А╨╕╨▓╤П╨╖╨░╨╜╨░ ╨║ AmandaHomeStage
! ╨Э╨╡╨▓╨╕╨╜╨╜╨╛╤Б╤В╨╕ ╨▓ ╨┐╨╛╨┤╨▓╨╛╤А╨╛╤В╨╜╨╡ ╨╜╨╡ ╨╗╨╕╤И╨░╨╡╨╝ ╨╜╨╕╨║╨╛╨│╨┤╨░
! ================================================

#AmandaDanceAlleyMainText
    if $AmandaAlleyLastText <> '':
        *p $AmandaAlleyLastText
    elseif AmandaAlleyStage = 1:
        *pl '╨Т╤Л ╤Б ╨Р╨╝╨░╨╜╨┤╨╛╨╣ ╤Б╨▓╨╛╤А╨░╤З╨╕╨▓╨░╨╡╤В╨╡ ╤Б ╨╖╨░╨╗╨╕╤В╨╛╨╣ ╤Д╨░╨║╨╡╨╗╤М╨╜╤Л╨╝ ╤Б╨▓╨╡╤В╨╛╨╝ ╤П╤А╨╝╨░╤А╨╛╤З╨╜╨╛╨╣ ╨┐╨╗╨╛╤Й╨░╨┤╨╕ ╨▓ ╤Г╨╖╨║╨╕╨╣, ╤В╤С╨╝╨╜╤Л╨╣ ╨┐╤А╨╛╤Е╨╛╨┤ ╨╝╨╡╨╢ ╨│╨╗╤Г╤Е╨╕╨╝╨╕ ╤Б╤В╨╡╨╜╨░╨╝ ╨┤╨╛╨╝╨╛╨▓.'
        *pl '╨Ч╨░ ╤Б╨┐╨╕╨╜╨╛╨╣ ╨▓╤Б╤С ╨╡╤Й╤С ╨│╤Г╨┤╨╕╤В ╨▓╨╡╤Б╤С╨╗╤Л╨╣ ╨┐╤А╨░╨╖╨┤╨╜╨╕╨║: ╤Б╨╗╤Л╤И╨╜╤Л ╤Б╨║╤А╨╕╨┐╨║╨╕, ╨▒╤Г╤Е╨░╨╡╤В ╨▒╨░╤А╨░╨▒╨░╨╜, ╤Б╨╗╤Л╤И╨░╤В╤Б╤П ╨┐╤М╤П╨╜╤Л╨╡ ╨▓╨╛╨╖╨│╨╗╨░╤Б╤Л ╨╕ ╤Б╨╝╨╡╤Е ╤В╨░╨╜╤Ж╤Г╤О╤Й╨╕╤Е ╨│╨╛╤А╨╛╨╢╨░╨╜. ╨Э╨╛ ╨╖╨┤╨╡╤Б╤М, ╨╖╨░ ╨┐╨╛╨▓╨╛╤А╨╛╤В╨╛╨╝, ╤И╤Г╨╝ ╤Б╤В╨░╨╜╨╛╨▓╨╕╤В╤Б╤П ╨┐╤А╨╕╨│╨╗╤Г╤И╤С╨╜╨╜╤Л╨╝, ╨░ ╤В╨╡╨╜╨╕ тАФ ╨│╤Г╤Б╤В╤Л╨╝╨╕.'
        *pl '╨Ю╨╜╨░ ╨┐╤А╨╕╤Б╨╗╨╛╨╜╤П╨╡╤В╤Б╤П ╤Б╨┐╨╕╨╜╨╛╨╣ ╨║ ╤И╨╡╤А╤И╨░╨▓╨╛╨╣ ╨║╨░╨╝╨╡╨╜╨╜╨╛╨╣ ╨║╨╗╨░╨┤╨║╨╡, ╨┐╤Л╤В╨░╤П╤Б╤М ╨╛╤В╨┤╤Л╤И╨░╤В╤М╤Б╤П ╨┐╨╛╤Б╨╗╨╡ ╨▒╤Л╤Б╤В╤А╨╛╨│╨╛ ╤В╨░╨╜╤Ж╨░. ╨Х╤С ╨│╤А╤Г╨┤╤М ╨▓╨╖╨┤╤Л╨╝╨░╨╡╤В╤Б╤П ╨┐╨╛╨┤ ╤И╨╜╤Г╤А╨╛╨▓╨║╨╛╨╣, ╨░ ╨│╨╗╨░╨╖╨░ ╨▒╨╗╨╡╤Б╤В╤П╤В ╨▓ ╤В╨╡╨╝╨╜╨╛╤В╨╡ ╤Б ╨╗╤О╨▒╨╛╨┐╤Л╤В╤Б╤В╨▓╨╛╨╝ ╨╕ ╨╗╤С╨│╨║╨╛╨╣ ╤В╤А╨╡╨▓╨╛╨│╨╛╨╣.'
    elseif AmandaAlleyStage = 2:
        *pl '╨Я╨╛╤Б╨╗╨╡ ╤Г╨║╤А╨░╨┤╨║╨╛╨╣ ╤Б╨╛╤А╨▓╨░╨╜╨╜╨╛╨│╨╛ ╨┐╨╛╤Ж╨╡╨╗╤Г╤П ╨Р╨╝╨░╨╜╨┤╨░ ╨▓╨╖╨▓╨╛╨╗╨╜╨╛╨▓╨░╨╜╨╜╨╛ ╤Б╨╝╨╛╤В╤А╨╕╤В ╨▓ ╤Б╤В╨╛╤А╨╛╨╜╤Г ╤Б╨▓╨╡╤В╨╗╨╛╨│╨╛ ╨▓╤Л╤Е╨╛╨┤╨░ ╨╜╨░ ╨┐╨╗╨╛╤Й╨░╨┤╤М.'
        *pl '╨Ю╨╜╨░ ╨┐╤А╨╕╨╢╨╕╨╝╨░╨╡╤В ╨║╨╛╨╜╤З╨╕╨║╨╕ ╨┐╨░╨╗╤М╤Ж╨╡╨▓ ╨║ ╤Б╨▓╨╛╨╕╨╝ ╨▓╨╗╨░╨╢╨╜╤Л╨╝, ╤З╤Г╤В╤М ╨┐╤А╨╕╨┐╤Г╤Е╤И╨╕╨╝ ╨│╤Г╨▒╨░╨╝, ╨┐╤А╨╕╤Б╨╗╤Г╤И╨╕╨▓╨░╤П╤Б╤М ╨║ ╨┤╨░╨╗╤С╨║╨╛╨╝╤Г ╨│╨╛╨╝╨╛╨╜╤Г ╤В╨╛╨╗╨┐╤Л.'
        *pl '╨г╤Е╨╛╨┤╨╕╤В╤М ╨╛╨╜╨░ ╤П╨▓╨╜╨╛ ╨╜╨╡ ╤Б╨┐╨╡╤И╨╕╤В тАФ ╨╡╤С ╤А╨░╤Б╨┐╨░╨╗╤П╨╡╤В ╤Н╤В╨╛╤В ╨▓╨╛╨╗╨╜╤Г╤О╤Й╨╕╨╣ ╨┐╨╛╨╗╤Г╨╝╤А╨░╨║.'
    elseif AmandaAlleyStage = 3:
        *pl '╨Т╤Л ╤Б╤В╨╛╨╕╤В╨╡ ╨▓╨┐╨╗╨╛╤В╨╜╤Г╤О ╨┤╤А╤Г╨│ ╨║ ╨┤╤А╤Г╨│╤Г. ╨б╤В╨╡╨╜╨░ ╨┐╨╡╤А╨╡╤Г╨╗╨║╨░ ╨╖╨░╤Б╨╗╨╛╨╜╤П╨╡╤В ╨▓╨░╤Б ╨╛╤В ╤Б╨╗╤Г╤З╨░╨╣╨╜╤Л╤Е ╨▓╨╖╨╛╤А╨╛╨▓, ╨╜╨╛ ╨▒╨╗╨╕╨╖╨╛╤Б╤В╤М ╤Г╨╗╨╕╤Ж╤Л ╨┐╤М╤П╨╜╨╕╤В.'
        *pl '╨Р╨╝╨░╨╜╨┤╨░ ╨╛╤Й╤Г╤Й╨░╨╡╤В ╨▓╨░╤И╨╡ ╨╢╨░╤А╨║╨╛╨╡ ╨┤╤Л╤Е╨░╨╜╨╕╨╡ ╨╜╨░ ╤Б╨▓╨╛╨╡╨╣ ╤Й╨╡╨║╨╡ ╨╕ ╨╜╨╡ ╨┤╨╡╨╗╨░╨╡╤В ╨╜╨╕ ╤И╨░╨│╤Г ╨╜╨░╨╖╨░╨┤ тАФ ╤Е╨╛╤В╤П ╨╡╤Й╤С ╨╜╨╡╨┤╨░╨▓╨╜╨╛ ╨┐╨╛╨▒╨╛╤П╨╗╨░╤Б╤М ╨▒╤Л ╨┤╨░╨╢╨╡ ╨▓╨╖╨│╨╗╤П╨╜╤Г╤В╤М ╨╜╨░ ╨▓╨░╤Б ╤В╨░╨║ ╨╛╤В╨║╤А╤Л╤В╨╛.'
    elseif AmandaAlleyStage = 4:
        *pl '╨Т╨╛╨╖╨┤╤Г╤Е ╨╝╨╡╨╢╨┤╤Г ╨▓╨░╨╝╨╕ ╨╜╨░╨║╨░╨╗╤С╨╜ ╨┤╨╛ ╨┐╤А╨╡╨┤╨╡╨╗╨░. ╨Я╨╛╤Б╨╗╨╡ ╨┤╨╡╤А╨╖╨║╨╕╤Е ╨╗╨░╤Б╨║ ╨┐╨╛╨┤ ╤О╨▒╨║╨╛╨╣ ╤Й╤С╨║╨╕ ╨Р╨╝╨░╨╜╨┤╤Л ╨│╨╛╤А╤П╤В ╨╢╨╕╨▓╤Л╨╝ ╤А╤Г╨╝╤П╨╜╤Ж╨╡╨╝, ╨░ ╨┐╨░╨╗╤М╤Ж╤Л ╤Б╤Г╨┤╨╛╤А╨╛╨╢╨╜╨╛ ╨║╨╛╨╝╨║╨░╤О╤В ╤В╨║╨░╨╜╤М ╨▓╨░╤И╨╡╨│╨╛ ╤А╤Г╨║╨░╨▓╨░.'
        *pl '╨Ю╨╜╨░ ╤Б╨╝╤Г╤Й╤С╨╜╨╜╨╛ ╨┐╤А╤П╤З╨╡╤В ╨│╨╗╨░╨╖╨░, ╨╜╨╛ ╨╡╤С ╨┤╤Л╤Е╨░╨╜╨╕╨╡ ╨▓╤Л╨┤╨░╤С╤В ╨▒╤Г╤А╤О ╤З╤Г╨▓╤Б╤В╨▓, ╤А╨░╨╖╨│╨╛╤А╨╡╨▓╤И╤Г╤О╤Б╤П ╨▓ ╨╡╤С ╤О╨╜╨╛╨╝ ╤В╨╡╨╗╨╡.'
    else:
        *pl '╨У╤Г╤Б╤В╨░╤П ╤В╨╡╨╜╤М ╨┐╨╡╤А╨╡╤Г╨╗╨║╨░ ╨╜╨░╨┤╤С╨╢╨╜╨╛ ╤Б╨║╤А╤Л╨▓╨░╨╡╤В ╨▓╨░╤Б ╨╛╨▒╨╛╨╕╤Е ╨╛╤В ╤П╤А╨╝╨░╤А╨╛╤З╨╜╨╛╨│╨╛ ╤И╤Г╨╝╨░, ╨╜╨╛ ╨▓╨╛╨╗╨╜╤Г╤О╤Й╨╡╨╡ ╤З╤Г╨▓╤Б╤В╨▓╨╛ ╨╖╨░╨┐╤А╨╡╤В╨╜╨╛╨│╨╛ ╤А╨╕╤Б╨║╨░ ╨╜╨╕ ╨╜╨░ ╤Б╨╡╨║╤Г╨╜╨┤╤Г ╨╜╨╡ ╨┐╨╛╨║╨╕╨┤╨░╨╡╤В ╤Н╤В╨╛ ╨╝╨╡╤Б╤В╨╛.'
    end
---

! ================================================
! ╨в╨╡╨║╤Б╤В ╨┤╨╡╨╣╤Б╤В╨▓╨╕╤П ╨▓ ╨┐╨╛╨┤╨▓╨╛╤А╨╛╤В╨╜╨╡ тАФ ╨┐╤А╨╕╨▓╤П╨╖╨░╨╜ ╨║ HomeStage
! ================================================

#AmandaDanceAlleyActionText
    $AmandaAlleyTextAction = LCASE($ARGS[0])

    if $AmandaAlleyTextAction = 'look':
        $AmandaAlleyLastText = '╨Т╤Л ╨╛╤Б╤В╨╛╤А╨╛╨╢╨╜╨╛ ╨▓╤Л╨│╨╗╤П╨┤╤Л╨▓╨░╨╡╤В╨╡ ╨╕╨╖-╨╖╨░ ╨▓╤Л╤Б╤В╤Г╨┐╨░ ╤Б╤В╨╡╨╜╤Л. ╨Э╨░ ╨┐╨╗╨╛╤Й╨░╨┤╨╕ ╨▓╤Б╨╡ ╨╕╨┤╤С╤В ╤Б╨▓╨╛╨╕╨╝ ╤З╨╡╤А╨╡╨┤╨╛╨╝: ╤В╨╛╤А╨│╨╛╨▓╤Ж╤Л ╨╖╨░╨╖╤Л╨▓╨░╤О╤В ╨╖╨╡╨▓╨░╨║, ╨┐╨░╤А╤Л ╨║╤А╤Г╨╢╨░╤В╤Б╤П ╨▓ ╤В╨░╨╜╤Ж╨╡ ╤Г ╤Д╨╛╨╜╨░╤А╨╡╨╣, ╨░ ╨│╨╛╤А╨╛╨┤╤Б╨║╨░╤П ╤Б╤В╤А╨░╨╢╨░ ╨╝╨╕╤А╨╜╨╛ ╨│╤А╨╡╨╡╤В╤Б╤П ╤Г ╨║╨╛╤Б╤В╤А╨░ ╤Б ╨║╤А╤Г╨╢╨║╨░╨╝╨╕ ╤Н╨╗╤П.'
        $AmandaAlleyLastText += '<br>╨Э╨╕╨║╤В╨╛ ╨╜╨╡ ╨╛╨▒╤А╨░╤Й╨░╨╡╤В ╨▓╨╜╨╕╨╝╨░╨╜╨╕╤П ╨╜╨░ ╤В╤С╨╝╨╜╤Г╤О ╤Й╨╡╨╗╤М ╨╝╨╡╨╢╨┤╤Г ╨┤╨╛╨╝╨░╨╝╨╕. ╨Р╨╝╨░╨╜╨┤╨░ ╨╜╨╡╤Б╨╗╤Л╤И╨╜╨╛ ╨┐╨╛╨┤╤Е╨╛╨┤╨╕╤В ╨║ ╨▓╨░╨╝ ╤Б╨╖╨░╨┤╨╕, ╨║╨╗╨░╨┤╤С╤В ╨╗╨░╨┤╨╛╤И╨║╤Г ╨╜╨░ ╨▓╨░╤И╨╡ ╨┐╨╗╨╡╤З╨╛ ╨╕ ╨▓╨╖╨▓╨╛╨╗╨╜╨╛╨▓╨░╨╜╨╜╨╛ ╤И╨╡╨┐╤З╨╡╤В ╨┐╤А╤П╨╝╨╛ ╨▓ ╤Г╤Е╨╛: ┬л╨Э╤Г ╤З╤В╨╛ ╤В╨░╨╝, ╨б╤В╨╡╤Д╨░╨╜? ╨Э╨╕╨║╤В╨╛ ╨╜╨░╤Б ╨╜╨╡ ╤Е╨▓╨░╤В╨╕╨╗╤Б╤П?┬╗ тАФ ┬л╨Я╨╛╨║╨░ ╨▓╤Б╤С ╤В╨╕╤Е╨╛, ╤Б╨╡╤Б╤В╤А╤С╨╜╨║╨░. ╨Ь╤Л ╨╖╨┤╨╡╤Б╤М ╨╛╨┤╨╜╨╕┬╗. ╨Ю╨╜╨░ ╤Б ╨╛╨▒╨╗╨╡╨│╤З╨╡╨╜╨╕╨╡╨╝ ╨┐╨╡╤А╨╡╨▓╨╛╨┤╨╕╤В ╨┤╤Г╤Е, ╨╜╨╛ ╨▓ ╨╡╤С ╨│╨╗╨░╨╖╨░╤Е ╨╝╨╡╨╗╤М╨║╨░╨╡╤В ╨╛╨╖╨╛╤А╨╜╨░╤П ╨╕╤Б╨║╤А╨░.'

    elseif $AmandaAlleyTextAction = 'kiss':
        if AmandaHomeStage <= 2:
            $AmandaAlleyLastText = '╨Т╤Л ╨╜╨░╨║╨╗╨╛╨╜╤П╨╡╤В╨╡╤Б╤М ╨║ ╨╡╤С ╨╗╨╕╤Ж╤Г, ╨╢╨╡╨╗╨░╤П ╨┐╨╛╤Ж╨╡╨╗╨╛╨▓╨░╤В╤М ╨╡╤С ╨▓ ╨│╤Г╨▒╤Л. ╨Р╨╝╨░╨╜╨┤╨░ ╨╜╨░ ╨╝╨╕╨│ ╨╖╨░╨╝╨╕╤А╨░╨╡╤В, ╨╡╤С ╨┤╤Л╤Е╨░╨╜╨╕╨╡ ╨┐╤А╨╡╤А╤Л╨▓╨░╨╡╤В╤Б╤П, ╨╜╨╛ ╨╖╨░╤В╨╡╨╝ ╨╛╨╜╨░ ╤Б╨╝╤Г╤Й╤С╨╜╨╜╨╛ ╨╛╤В╨▓╨╛╤А╨░╤З╨╕╨▓╨░╨╡╤В ╨│╨╛╨╗╨╛╨▓╤Г ╨╕ ╨╝╤П╨│╨║╨╛ ╤Г╨┐╨╕╤А╨░╨╡╤В╤Б╤П ╨╗╨░╨┤╨╛╤И╨║╨░╨╝╨╕ ╨▓╨░╨╝ ╨▓ ╨│╤А╤Г╨┤╤М.'
