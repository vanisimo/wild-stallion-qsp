! ================================================
! FILE: modules/events/amanda/dance/amanda_dark_alley_text.qsps
! MODULE: events/amanda/dance
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты подворотни после танца с Амандой
! Используется кодом:
! modules/events/dance/amanda_dark_alley.qsps
!
! Сюда вынесены описания, чтобы не смешивать код и большие тексты.
! ================================================

#AmandaDanceAlleyMainText
    if $AmandaAlleyLastText <> '':
        *p $AmandaAlleyLastText
    elseif AmandaAlleyStage = 1:
        *p 'Вы с Амандой отходите с шумной площади к узкому проходу между домами.'
        *p 'Музыка, смех и голоса остаются совсем рядом, но здесь уже достаточно темно, чтобы каждое движение казалось смелее.'
        *p 'Аманда оглядывается на площадь, потом смотрит на вас и неуверенно поправляет волосы.'
    elseif AmandaAlleyStage = 2:
        *p 'После поцелуя Аманда молчит. Она явно прислушивается к шагам и голосам, но не делает попытки вернуться на площадь.'
    elseif AmandaAlleyStage = 3:
        *p 'Вы стоите слишком близко друг к другу. Аманда нервничает, но сама не отстраняется.'
    else:
        *p 'Подворотня скрывает вас от большей части площади, но ощущение риска никуда не исчезает.'
    end
---

! ================================================
! FILE: modules/events/amanda/dance/amanda_dark_alley_text.qsps
! Текст действия в подворотне
! ================================================

#AmandaDanceAlleyActionText
    $AmandaAlleyTextAction = LCASE($ARGS[0])

    if $AmandaAlleyTextAction = 'look':
        $AmandaAlleyLastText = 'Вы осторожно выглядываете из подворотни. На площади всё ещё танцуют, а ближайшие прохожие заняты своими разговорами.'
    elseif $AmandaAlleyTextAction = 'kiss':
        $AmandaAlleyLastText = 'Вы целуете Аманду. Она замирает, едва слышно выдыхает и на мгновение забывает, что площадь совсем рядом.'
    elseif $AmandaAlleyTextAction = 'close':
        $AmandaAlleyLastText = 'Вы притягиваете Аманду ближе. Она краснеет и шепчет, что вас могут заметить, но остаётся на месте.'
    else:
        $AmandaAlleyLastText = 'Вы задерживаетесь в подворотне ещё на несколько мгновений.'
    end

    killvar '$AmandaAlleyTextAction'
---

! ================================================
! FILE: modules/events/amanda/dance/amanda_dark_alley_text.qsps
! Текст риска быть замеченными
! ================================================

#AmandaDanceAlleyRiskText
    if AmandaAlleyCaught <= 1:
        $AmandaAlleyLastText += '<br><br>С площади доносится чужой смех. Аманда вздрагивает и шепчет, что кто-то мог пройти совсем рядом.'
    elseif AmandaAlleyCaught = 2:
        $AmandaAlleyLastText += '<br><br>На этот раз вы почти уверены, что вас кто-то заметил. Аманда быстро отворачивается, пытаясь скрыть лицо.'
    else:
        $AmandaAlleyLastText += '<br><br>Риск становится слишком заметным. Если о вас заговорят, слухи быстро доберутся до трактира.'
    end
---

#AmandaDanceAlleyOralIntroText
    *pl 'Ты прижимаешь Аманду к шероховатой каменной стене в глубокой тени переулка. Музыка и звонкий смех с площади доносятся совсем близко, но здесь вас укрывает густая ночная темнота.'
    *pl 'Твоя рука скользит вниз, пытаясь нащупать край подола и задрать юбку... но Аманда вдруг звонко фыркает и озорно перехватывает твоё запястье своими тёплыми пальчиками.'
    *pl ' '
    *pl '«Погоди-ка, братик! Полегче на поворотах!» — шепчет она, блестя глазами в полумраке. — «В грязной подворотне, где в любой миг из-за угла может вывернуть пьяный стражник, я тебе писечку не подставлю! Матушка Сандра с нас обоих шкуру спустит, если я праздничное платье перепачкаю, да и вообще — я тебе не портовая девка, чтобы у мокрой стены раскорячиваться. Если хочешь меня всю — дождись, пока вернёмся домой и запрём спальню!»'
    *pl ' '
    *pl 'Она лукаво щурится, проводя ладонью по твоей груди:'
    *pl '«А здесь… здесь я могу порадовать тебя ротиком. Опускайся сам, или давай я перед тобой на колени встану…»'
    *pl ' '
    *pl 'Не дожидаясь ответа, Аманда со знанием дела подбирает подол и легко опускается на колени прямо на сухие доски у стены. Её ловкие пальчики торопливо распускают шнуровку твоих штанов.'
    *pl 'Твой налитый, каменный ствол с глухим стуком вырывается наружу, обдавая прохладный ночной воздух горячим жаром. На бордовой головке уже поблёскивает прозрачная капелька смазки.'
    *pl ' '
    *pl '«Ого… как налился-то, торчком стоит,» — шепчет Аманда, обдавая головку горячим дыханием. Её щёки заливает яркий румянец, но во взгляде нет и следа робости — только сладкое женское бесстыдство и предвкушение утех.'
    *pl 'Она обхватывает ствол пальчиками, склоняется и мягко касается кончиком язычка самого чувствительного ободка. Затем приоткрывает влажные губки и с жадным причмокиванием насаживается на головку, вбирая её в горячую тесноту своего рта.'
    *pl ' '
    *pl 'Аманда двигает головой всё увереннее: прячет зубки, втягивает щёчки и ласкает ствол языком снизу вверх, жадно сглатывая выступающую смазку. С площади доносится весёлый припев танцевальной песни, а прямо у твоих ног родная сестрёнка самозабвенно ублажает твою плоть, заглядывая снизу вверх с пьянящим озорством.'
---

#AmandaDanceAlleyOralFinishText
    $OralFinishChoice = LCASE($ARGS[0])

    if $OralFinishChoice = 'mouth':
        *pl 'Ты предупреждающе сжимаешь её шелковистые каштановые волосы, подаваясь бедрами вперёд. Член бьётся в преддверии оргазма, готовый взорваться.'
        *pl ' '
        *pl 'Аманда прекрасно понимает намёк. Вместо того чтобы отпрянуть, она с готовностью раскрывает горлышко шире и насаживается до самого основания, упираясь носиком в твой пах. Горячие, мощные струи семени толчками выстреливают ей в глубь рта.'
        *pl ' '
        *pl 'Она судорожно и жадно сглатывает раз за разом, жмурясь от сладостного напряжения. Когда судороги наконец стихают, Аманда медленно отстраняется, облизывает мокрые губы и с горделивой улыбкой высовывает чистый розовый язычок:'
        *pl ' '
        *pl '«Всё до капли, братик…» — шепчет она, тяжело дыша. — «Видит Ильматер, ты самый сладкий! Ни капли мимо не пролила… Ну что, доволен своей сестрёнкой?»'
        *pl 'Она поднимается с колен, одёргивая подол и лукаво подмигивая.'
    else
        *pl 'В самый последний миг ты перехватываешь Аманду за плечи и выдёргиваешь пульсирующий ствол из её податливого, влажного ротика.'
        *pl ' '
        *pl 'Со сдавленным стоном ты изливаешься прямо перед собой. Густые, обжигающие струи семени выстреливают щедрым веером, заливая её милое личико, щёки и пышное декольте. Белые горячие капли стекают по её нежной коже, пачкая губы и застревая в ложбинке между грудей.'
        *pl ' '
        *pl 'Аманда зажмуривает один глазик, часто дыша приоткрытым ртом. Она проводит пальчиком по щеке, пробует каплю языком и тихо смеётся:'
        *pl ' '
        *pl '«Ох, Стефан… ну ты и стрелок! Всё личико мне разукрасил!» — шепчет она, торопливо отирая подбородок батистовым платком. — «Хорошо хоть на платье не попало, а то матушка Сандра сразу бы всё поняла… Ну что, пойдём на площадь, пока нас не хватились?»'
    end

    killvar '$OralFinishChoice'
---

#AmandaDanceAlleyMmfText
    AlleyMmfBoyRoll = RAND(1, 2)

    if AlleyMmfBoyRoll = 1:
        *p 'Горожанин не спрашивает разрешения — только хрипло смеётся и подталкивает Аманду к стене. Вы остаётесь рядом: слишком поздно делать вид, что это случайность.'
        *p 'Она стонет в кулак, когда он входит сзади, а вы держите её за запястья — не жестоко, но твёрдо. Площадь за углом всё ещё играет музыка, и это делает сцену ещё грязнее.'
    else
        *p 'Аманда сначала шепчет «нет» — но голос срывается, когда прохожий целует её в шею. Вы смотрите, как она подчиняется сразу двоим: вам и чужаку из темноты.'
        *p 'Финал наступает быстро и шумно. Когда горожанин исчезает в переулке, на её щеке остаётся чужой след — и ваш взгляд, который она боится поднять.'
    end

    killvar 'AlleyMmfBoyRoll'
---

#AmandaDanceAlleyEndText
    if AmandaAlleyAfterSex = 1:
        *p 'Вы возвращаетесь к площади не сразу. Аманда поправляет одежду и старается отдышаться, прежде чем снова выйти к людям.'
    elseif AmandaAlleyCaught > 0:
        *p 'Вы выходите из подворотни осторожно. Аманда старается смотреть в сторону, будто ничего не произошло.'
    else:
        *p 'Вы возвращаетесь к шуму площади. Аманда всё ещё краснеет, но быстро пытается сделать вид, что всё было обычной прогулкой.'
    end
---
