! ================================================
! FILE: modules/events/amanda/dance/amanda_dance_text.qsps
! MODULE: events/amanda
! ! [AI-WORKED] Текст переработан / дополнен ассистентом 18.09.2026
! Тексты танца Аманды на пятничных танцах
! Реакции в зависимости от FamilyCorruptionStage и развратности
! Цепочка: танец -> талия -> попа -> сжать -> поцелуй -> подворотня
! ================================================

#AmandaDanceMainText
    if $AmandaDanceLastText <> '':
        *pl $AmandaDanceLastText
    elseif AmandaDanceStage = 0:
        if FamilyCorruptionStage <= 1 and sluttiness['amanda'] < 15:
            *pl 'На ярмарочной площади царит весёлый праздничный шум. Скрипки и дудки задорно наигрывают танцевальный мотив, в свете чадящих смоляных факелов кружатся пары, а в воздухе сладко пахнет жареными орехами, хмельным элем и вечерней прохладой.'
            *pl 'Аманда стоит у деревянной колоннады, придерживая складки праздничного платья. Её коса аккуратно перекинута через плечо, а глаза с живым блеском следят за хороводом.'
            *pl 'Заметив ваш взгляд, сестрёнка смущённо вспыхивает румянцем и торопливо отводит глаза, теребя пальцами шнуровку лифа. Она явно хочет потанцевать, но девичья скромность и страх перед пересудами соседей заставляют её держаться в стороне.'
        elseif FamilyCorruptionStage <= 3 and sluttiness['amanda'] < 30:
            *pl 'Вечерняя ярмарка гудит на все лады: гремит барабан, горожане шумно веселятся у бочек с пивом, а в освещённом факелами кругу без устали кружатся танцующие пары.'
            *pl 'Аманда стоит чуть впереди толпы, покачивая бёдрами в такт музыке. Праздничный наряд сидит на ней безупречно, а лента на лифе завязана чуть свободнее обычного, приоткрывая волнующий вид на нежную ложбинку.'
            *pl 'Поймав ваш взгляд, она не отворачивается — напротив, её губы трогает лукавая полуулыбка, а в карих глазах вспыхивает озорной огонёк. Она словно дразнит вас, призывно поправляя волосы и ожидая, когда вы наконец решитесь подойти.'
        else:
            *pl 'Ярмарочная площадь наполнена пьяным хмельным угаром, визгом дудок и топотом сотен ног. Факелы бросают пляшущие багровые тени на стены ратуши и разгорячённые лица горожан.'
            *pl 'Аманда держится с вызывающей, чувственной уверенностью. Её наряд откровенно подчёркивает каждый изгиб спелого тела, глубокое декольте вздымается от частого дыхания, а на припухших губах играет томная, греховная усмешка.'
            *pl 'Заметив вас среди толпы, она окидывает вашу фигуру откровенным, голодным взглядом, скользя глазами от широких плеч прямо к поясу штанов. Сестра даже не пытается скрыть своё желание — она открыто ждёт, когда вы подойдёте и заберёте её в круг.'
        end
    elseif AmandaDanceStage = 1:
        if FamilyCorruptionStage <= 1:
            *pl 'Вы кружитесь с Амандой в хороводе горожан. Музыка ведёт пару за парой, и сестра старается двигаться чинно, смущённо улыбаясь и пряча сияющие глаза.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Вы ведёте Аманду в танце. Она грациозно и легко откликается на каждый шаг, придвигаясь к вам чуть ближе, чем требуют приличия, и ловя ваши взгляды.'
        else:
            *pl 'Вы танцуете с Амандой посреди шумной толпы. Сестра не скрывает наслаждения — её движения полны откровенной грации, а глаза блестят пьянящим желанием.'
        end
    elseif AmandaDanceStage = 2:
        if FamilyCorruptionStage <= 1:
            *pl 'Ваши руки лежат на тонкой талии Аманды. Девушка держится напряжённо, её щёчки алеют, но она послушно кружится с вами, не разрывая дистанцию.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Ваши руки уверенно обнимают гибкую талию сестры. Аманда ласково льнёт ближе, покачивая бёдрами и не скрывая удовольствия от близости.'
        else:
            *pl 'Ваши пальцы сжимают гибкую талию Аманды, а она бесстыдно вжимается животом в ваше тело, с вызовом поглядывая на глазеющих зевак.'
        end
    elseif AmandaDanceStage = 3:
        if FamilyCorruptionStage <= 1:
            *pl 'Ваши ладони покоятся на ягодицах сестры. Аманда кусает губы от стыда и страха, боясь, что кто-то из знакомых заметит эти непозволительные ласки.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Ваши руки лежат на упругой попе Аманды. Сестра не убирает ваших ладоней, её дыхание прерывисто, а в глазах плещется жаркое пламя греха.'
        else:
            *pl 'Вы ведёте танец, держа сестру за сочную круглую попку. Аманда томно двигает бёдрами в такт мелодии, бесстыдно прижимаясь к вашему паху.'
        end
    elseif AmandaDanceStage = 4:
        if FamilyCorruptionStage <= 1:
            *pl 'Ваши пальцы продолжают сминать податливые округлости сестры. Аманда прячет лицо у вас на плече, дрожа от запретного наслаждения.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Вы крепко сжимаете попу сестры в танце. Аманда тяжело дышит вам в ключицу, её тело горит огнём, готовое отдаться в любой момент.'
        else:
            *pl 'Вы по-хозяйски мнёте ягодицы сестры на глазах у пляшущих людей. Аманда затуманенным взглядом смотрит на вас, сгорая от жажды уединения.'
        end
    elseif AmandaDanceStage = 5:
        if FamilyCorruptionStage <= 1:
            *pl 'После украдкой сорванного поцелуя Аманда не может поднять на вас глаз. Её губы горят, а дыхание сбилось от пережитого потрясения.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'После сладкого поцелуя между вами висит густое эротическое напряжение. Аманда смотрит на вас влажными глазами, едва сдерживая дрожь во всём теле.'
        else:
            *pl 'После развратного, влажного поцелуя Аманда облизывает губы и судорожно сжимает ваши пальцы, едва удерживаясь на ногах от накатившей похоти.'
        end
    else:
        *pl 'Танец подошёл к концу, но шумная ярмарка вокруг вас словно растворилась в полумраке.'
    end
---

#AmandaDanceActionText
    $AmandaDanceTextAction = LCASE($ARGS[0])
    $AmandaDanceTextResult = LCASE($ARGS[1])

    if $AmandaDanceTextAction = 'talk':
        if $AmandaDanceTextResult = 'talk_eager' or Friends['amanda'] >= 7:
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Вы подходите к Аманде и заводите лёгкий, непринуждённый разговор о празднике. Сестрёнка охотно откликается, звонко смеётся вашим шуткам и делится впечатлениями о музыкантах, но то и дело бросает сияющие взгляды на танцующих горожан, ожидая, когда музыка снова зазовёт всех в хоровод.'
            elseif FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Вы заводите с Амандой весёлую болтовню. Сестра с улыбкой слушает вас, но держится заметно ближе, чем положено приличной девушке: она озорно толкает вас локотком, лукаво шепчет сплетни про танцующих соседей и смеётся, глядя вам прямо в глаза с волнующим теплом.'
            else:
                $AmandaDanceLastText = 'Вы заводите разговор, но Аманда слушает вас с томной, вызывающей усмешкой. Подойдя почти вплотную, она обдаёт вашу щёку тёплым дыханием: «Стефанчик, неужели ты подошёл ко мне только для того, чтобы болтать языком? Музыка гремит, ночь на дворе, а ты тратишь время на пустые слова… Пойдём лучше в круг, покажи, на что ты способен!»'
            end
        elseif $AmandaDanceTextResult = 'talk_warm':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Вы перебрасываетесь с Амандой парой тёплых фраз о ярмарочной суете. Незатейливая беседа помогает сестре расслабиться — она благодарно улыбается вам, чувствуя вашу заботу и уверенность.'
            elseif FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Короткий разговор быстро перерастает в весёлое поддразнивание. Аманда лукаво щурится, оценивающе оглядывает вас и с тихим смешком замечает, что в праздничной рубахе вы выглядите куда солиднее обычного.'
            else:
                $AmandaDanceLastText = 'Вы обмениваетесь шутливыми репликами, но взгляд Аманды недвусмысленно блуждает по вашей фигуре. «Ты сегодня очень хорош, братец, — с придыханием роняет она. — Смотри, не заглядывайся на других девок, а то я начну ревновать…»'
            end
        else:
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Вы немного болтаете с Амандой о ярмарочных пустяках. Разговор выходит простым и обыденным, и вскоре она вновь отвлекается на звонкие переливы скрипки.'
            elseif FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Вы перекидываетесь парой слов о ценах в лавках и шуме толпы. Аманда слушает с полуулыбкой, но её пальцы задумчиво теребят подол платья — ей явно не терпится перейти к чему-то более живому.'
            else:
                $AmandaDanceLastText = 'Вы пытаетесь завести разговор о пустяках, но Аманда лишь насмешливо фыркает: «Стефан, не будь занудой! Мы на празднике, а ты говоришь как старый писарь из ратуши… Хватит болтать!»'
            end
        end

    elseif $AmandaDanceTextAction = 'dance':
        if $AmandaDanceTextResult = 'dance_fail':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = '«Стефан, ты что, сдурел?! — Аманда вспыхивает краской от возмущения и испуганно отступает назад, скрещивая руки на груди. — Ты мой брат! Чего это ты лезешь ко мне с танцами посреди ярмарки на глазах у всех?! Иди вон, трактирных девок кружи!»<br><br>Расстроенный резким отказом, вы остаётесь у колоннады в полном одиночестве.'
            else:
                $AmandaDanceLastText = '«Не сейчас, Стефан, — недовольно фыркает Аманда, отстраняясь. — Ты ведёшь себя как-то неловко и странно. Если хочешь танцевать со мной — умей подойти красиво, а не хватай меня за рукав при людях!»<br><br>Она сердито отворачивается, оставляя вас ни с чем.'
            end
        elseif $AmandaDanceTextResult = 'dance_shy':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = '«Ты же брат… Зачем мне с тобой в хоровод идти? Люди же смотреть будут…» — смущённо бормочет Аманда, опуская ресницы. Однако её щёчки уже алеют от приятного волнения, и когда вы протягиваете раскрытую ладонь, её тонкие пальчики нерешительно ложатся в вашу руку.<br><br>Вы мягко выводите сестру в танцевальный круг, и она послушно подхватывает ритм хоровода, стараясь держаться скромно.'
            else:
                $AmandaDanceLastText = '«Братец решил вспомнить, каково это — танцевать с сестрой? — посмеивается Аманда, хотя её глаза блестят неподдельным интересом. — Ну ладно, пойдём, только смотри, туфли мне не истопчи!»<br><br>Она уверенно берёт вашу руку и увлекает за собой в пляс, легко и грациозно кружась под праздничные напевы.'
            end
        else:
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Аманда с радостным вздохом вкладывает свою тёплую ладонь в вашу руку: «Ну наконец-то! А я уже думала, ты так и простоишь весь вечер в стороне!»<br><br>Вы выходите в круг горожан, и звонкая музыка тут же закручивает вас в весёлом хороводе. Глаза сестрёнки сияют от неподдельного счастья, её шаги легки и быстры, а лёгкий румянец на щеках делает её невероятно очаровательной.'
            elseif FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Аманда с готовностью протягивает руку и крепко сжимает ваши пальцы, одаривая вас многообещающей улыбкой: «Я ждала, когда ты подойдёшь, Стефан… Пойдём скорее в круг!»<br><br>С первых же па она кружится легко и раскованно, то и дело придвигаясь к вам чуть ближе, чем положено между приличными родственниками. В воздухе кружится аромат её волос, а её сияющий взгляд прикован только к вам.'
            else:
                $AmandaDanceLastText = 'Аманда жарко выдыхает и почти бросается в ваши объятия, вплетая свои пальцы в вашу ладонь: «Наконец-то! Я уже вся истомилась, глядя, как ты медлишь! — с томным, порочным смешком шепчет она, всем телом прижимаясь к вам так тесно, что вы ощущаете каждое движение её бёдер через тонкую ткань. — Кружи меня, Стефан… Пусть все видят, с кем сегодня танцует хозяйка трактира!»'
            end
        end

    elseif $AmandaDanceTextAction = 'continue':
        if $AmandaDanceHandPosition = 'waist':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Вы продолжаете кружиться в танце. Ваши ладони бережно и крепко обнимают тонкую девичью талию сестры. Аманда старается держаться ровно, но её щёки пылают живым румянцем, а дыхание то и дело сбивается, когда ваши пальцы слегка сжимают ткань её платья.'
            elseif FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Вы уверенно ведёте Аманду по кругу, не ослабляя хватки на её талии. Девушка с наслаждением отдаётся танцу: её стройное тело податливо изгибается в ваших руках, а улыбка становится всё более нежной и открытой.'
            else:
                $AmandaDanceLastText = 'Музыка кружит вас по брусчатке, и ваши ладони хозяйски удерживают сестру за талию. Аманда почти повисает на ваших руках, бесстыдно прижимаясь бёдрами и животом к вашему телу в такт ритмичным ударам барабана.'
            end
        elseif $AmandaDanceHandPosition = 'ass':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Танец продолжается, но ваши руки по-прежнему лежат на округлых ягодицах Аманды. Сестрёнка закусывает губу от смятения, пряча горящее лицо у вас на груди. Ей безумно неловко перед танцующими вокруг людьми, но она так и не решается убрать ваши ладони.'
            elseif FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Вы кружитесь в хороводе, и ваши пальцы чувствуют упругое тепло девичьего зада под юбкой. Аманда с плутовским огоньком во взгляде шепчет вам на ухо: «Стефанчик… ты невыносим… Смотри, не урони меня, пока лапаешь!» — и сама плавно покачивает бёдрами в ваших руках.'
            else:
                $AmandaDanceLastText = 'Вы танцуете посреди ярмарочной толпы, откровенно держа сестру за аппетитный, округлый зад. Аманда сладострастно выгибает спину навстречу вашим рукам, бросая дерзкие взгляды на зевак и тихо шепча, как сильно её заводит этот греховный танец.'
            end
        elseif $AmandaDanceHandPosition = 'ass2':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Под звонкие переливы скрипок вы продолжаете танец, крепко сжимая податливые половинки зада Аманды. Девушка прерывисто дышит, её пальчики судорожно комкают ваш рукав. Страх разоблачения и греховный дурман заставляют её сердце бешено колотиться.'
            elseif FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Вы ведёте Аманду в танце, властно сминая её упругую попку в такт мелодии. Сестра тихо стонет вам в шею, обжигая горячим дыханием: «Стефан… Ильматер всеблагой… У меня всё горит между ног от твоих пальцев…»'
            else:
                $AmandaDanceLastText = 'Танец превратился в откровенную прелюдию: ваши пальцы грубо и жадно сжимают ягодицы сестры, а она сладострастно трётся задницей о ваш напрягшийся пах. Её взгляд затуманен чистой похотью — она уже едва понимает, где находится.'
            end
        else:
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Вы продолжаете кружиться в танце вместе с Амандой, подхватывая быстрый праздничный темп. Сестра радостно улыбается, легко ступая по брусчатке.'
            elseif FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Вы уверенно ведёте Аманду в танце. Её взгляд полон нежности и задора, она с удовольствием следует за каждым вашим движением.'
            else:
                $AmandaDanceLastText = 'Вы кружитесь с Амандой среди танцующих пар. Сестра двигается вызывающе и плавно, ловя каждое ваше прикосновение с неприкрытым восторгом.'
            end
        end

    elseif $AmandaDanceTextAction = 'waist':
        if $AmandaDanceTextResult = 'waist_fail':
            $AmandaDanceLastText = '«Стефан, что ты такое делаешь?! — испуганно вскрикивает Аманда, с силой сбрасывая ваши руки со своей талии. — Мы же на виду у всего честного люда! Не смей распускать руки!»<br><br>С пылающим от обиды лицом она вырывается из танцевального круга и уходит прочь.'
        elseif $AmandaDanceTextResult = 'waist_timid':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Вы осторожно опускаете руки на талию Аманды. Девушка вздрагивает, словно от удара током, и на мгновение сбивается с шага.<br><br>«Стефан… потише, — испуганно шепчет она, заливаясь румянцем до самых кончиков ушей. — Руки не распускай, люди же кругом… Мы же брат и сестра!». Тем не менее, она не отталкивает ваши ладони, лишь настороженно оглядывает соседей по хороводу.'
            else:
                $AmandaDanceLastText = 'Ваши руки ложатся на талию сестры. Аманда слегка вздрагивает и наигранно хмурит бровки: «Стефан, полегче… Мы всё-таки на ярмарке, а не дома. Хотя… веди меня крепче, раз уж взялся». Она не убирает ваших рук и продолжает танец.'
            end
        else:
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Вы уверенно обнимаете Аманду за талию и притягиваете чуть ближе к себе. Девушка застенчиво улыбается, её щёчки розовеют, но она послушно сокращает расстояние: «Ой, Стефан… Только держи крепко, ладно? Музыка уж очень быстрая…»'
            elseif FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Едва ваши руки властно ложатся на её тонкую талию, как Аманда сладко выдыхает и охотно подаётся навстречу. Она обвивает ваши плечи и заглядывает прямо в глаза с плутовской улыбкой:<br><br>«Вот так-то лучше… Приятно, когда мужчина ведёт уверенно. Даже если этот мужчина — мой собственный братец».'
            else:
                $AmandaDanceLastText = 'Ваши руки крепко сжимают гибкую талию сестры, прижимая её вплотную. Аманда тихо мурлычет от удовольствия, прогибая спинку и с бесстыдным блеском в глазах шепча вам на ухо:<br><br>«М-м-м, Стефанчик… Наконец-то твои лапы там, где надо. Держи меня крепче… Пусть все видят, чья эта талия».'
            end
        end

    elseif $AmandaDanceTextAction = 'ass':
        if $AmandaDanceTextResult = 'ass_fail':
            $AmandaDanceLastText = '«Я твоя сестра, а не девка из портового кабака!» — звенит звонкая пощёчина. Аманда, задыхаясь от гнева и стыда, стремительно выбегает из круга, оставив вас посреди танцующей толпы.'
        elseif $AmandaDanceTextResult = 'ass_warn':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Едва ваши пальцы соскальзывают ниже талии на девичьи ягодицы, как Аманда испуганно ойкает. Глаза её распахиваются от ужаса:<br><br>«Стефан! Ты с ума сошёл?! — торопливо и нервно шепчет она, перехватывая ваши запястья и силой возвращая их обратно на поясницу. — На нас же вся площадь смотрит! Ильматер всеблагой, держи руки прилично!»'
            else:
                $AmandaDanceLastText = '«Стефан, полегче на поворотах! — посмеивается Аманда, хотя её щёки вспыхивают румянцем, а дыхание заметно сбивается. Она аккуратно сдвигает ваши ладони обратно на талию: — Не здесь и не так нагло, братец. У честных горожан удар случится, если увидят… Потерпи немного».'
            end
        elseif $AmandaDanceTextResult = 'ass_tease':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Ваши руки опускаются ниже и накрывают округлые, упругие ягодицы Аманды прямо через ткань платья. Девушка судорожно втягивает воздух, её бёдра напрягаются.<br><br>«Стефан… что ты… что ты творишь?! — в её шёпоте паника смешивается со странным сладким трепетом. — Ильматер видит, это же грех… Все увидят!». Она испуганно озирается по сторонам, но убрать ваши наглые ладони так и не решается.'
            else:
                $AmandaDanceLastText = 'Ощутив ваши ладони на своей попке, Аманда сладостно вздрагивает. Она прикусывает губу и шепчет вам в самое ухо с лукавой укоризной:<br><br>«Стефанчик, ты совсем стыд потерял?.. Руки у него сами сползли, да? Смотри, если матушка Сандра заметит — не сносить тебе головы… Впрочем… только не сжимай слишком сильно при всех».'
            end
        else:
            if FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Аманда даже не делает попытки убрать ваши руки — напротив, она довольно прищуривается и чуть подаёт таз назад, позволяя вашим ладоням в полной мере ощутить аппетитную упругость её зада.<br><br>«Ого… прямо за попу? — тихонько посмеивается она в такт музыке. — А ты стал очень дерзким, братец. Но мне нравится, как твои руки греют меня сквозь платье… Танцуй дальше».'
            else:
                $AmandaDanceLastText = 'Сладострастный стон срывается с приоткрытых губ Аманды. Она с готовностью прогибается, бесстыдно упираясь круглым горячим задом прямо в ваш пах, и начинает плавно двигать бёдрами в такт барабанам:<br><br>«Да, Стефан… хватай меня за задницу… — шепчет она с похотливым блеском в глазах. — Прямо при всех этих святошах! Чувствуешь, какая она мягкая и горячая? Гладь её… Она вся принадлежит тебе!»'
            end
        end

    elseif $AmandaDanceTextAction = 'grip':
        if $AmandaDanceTextResult = 'grip_fail':
            $AmandaDanceLastText = '«Ты перешёл всякие границы!» — в ярости кричит Аманда. Звонкая пощёчина оставляет след на вашей щеке, и девушка в слезах выбегает прочь с площади.'
        elseif $AmandaDanceTextResult = 'grip_warn':
            $AmandaDanceLastText = '«Стефан, прекрати сейчас же! — Аманда с силой перехватывает ваши пальцы, возвращая их на талию, и испуганно шипит: — Ты мне юбку задерёшь прямо посреди хоровода! Совсем ошалел?! Держи руки прилично!»'
        elseif $AmandaDanceTextResult = 'grip_tease':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Вы крепко сжимаете податливые полушария девичьего зада через юбку. Аманда издаёт сдавленный писк и утыкается пылающим лицом в ваше плечо.<br><br>«Стефанчик… Ильматер милосердный, что ты делаешь со мной… — умоляюще шепчет она, дрожа всем телом. — У меня ноги подкашиваются… Если кто заметит — я со стыда сквозь брусчатку провалюсь… Пожалуйста… не мни так сильно…». Её пальцы судорожно впиваются в вашу рубаху, но она не отстраняется ни на дюйм.'
            else:
                $AmandaDanceLastText = 'Ваши пальцы властно сминают упругую плоть её ягодиц. Аманда шумно выдыхает сквозь зубы, её бёдра вздрагивают от острой волны возбуждения.<br><br>«Ах… Стефан… — вырывается у неё горячий шёпот. — Какой же ты ненасытный… Прямо сжимаешь, да? Видит Ильматер, у меня внизу всё горит от твоей хватки. Ещё немного, и я прямо тут растаю… Уведи меня куда-нибудь, слышишь?»'
            end
        else:
            if FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Когда ваши пальцы по-хозяйски мнут её попу, Аманда сладостно стонет вам в шею, ещё теснее вжимаясь в ваше тело. Её дыхание становится прерывистым и влажным:<br><br>«М-м-м… Стефан… крепче… Вот так… Какой ты сильный. Мне так нравится, когда ты берёшь меня вот так властно и без спроса…»'
            else:
                $AmandaDanceLastText = 'Вы с силой сжимаете обе аппетитные половинки зада сестры, сминая складки её наряда. Аманда запрокидывает голову и стонет во весь голос, ничуть не заботясь о перешёптываниях в хороводе. Её бёдра с диким бесстыдством вжимаются в ваш напряжённый пах:<br><br>«О-о-х-х… Стефан! Да-а… сжимай сильнее! — выдыхает она с безумной страстью во взгляде. — Мни мою задницу, пусть все видят, как ты лапаешь свою сестричку! Я вся промокла, Стефан… У меня трусики насквозь мокрые! Забирай меня отсюда и сделай со мной всё, что хочешь!»'
            end
        end

    elseif $AmandaDanceTextAction = 'kiss':
        if $AmandaDanceTextResult = 'kiss_early':
            $AmandaDanceLastText = '«Стефан, ты что, с ума сошёл?! — Аманда в панике отстраняется и прижимает ладонь к губам, дико озираясь по сторонам на танцующих горожан. — На нас же вся площадь смотрит! Мы брат и сестра, Ильматер всеблагой! Не смей лезть целоваться на людях!»'
        elseif $AmandaDanceTextResult = 'kiss_fail':
            $AmandaDanceLastText = '«Я твоя сестра, а не шлюха!» — звонкая пощёчина разносится в шуме ярмарки, и оскорблённая Аманда убегает с площади прочь.'
        elseif $AmandaDanceTextResult = 'kiss_warn':
            $AmandaDanceLastText = '«Стефанчик, ты с ума сошёл… Мы же брат и сестра! — Аманда торопливо отворачивает лицо, подставляя под ваши губы лишь горящую щеку. — Не надо… не при всех же! Все вокруг сразу всё поймут…»'
        elseif $AmandaDanceTextResult = 'kiss_tease':
            if FamilyCorruptionStage <= 1:
                $AmandaDanceLastText = 'Вы притягиваете Аманду к себе и накрываете её губы поцелуем прямо в центре хоровода. Девушка ошеломлённо замирает с распахнутыми глазами. Первое мгновение она пытается отстраниться, но от жара ваших губ её сопротивление тает — её веки трепетно опускаются, а рот приоткрывается в робком, трепетном ответе.<br><br>Когда вы размыкаете объятия, Аманда тяжело дышит, прижимая пальчики к своим припухшим губам: «Стефан… Ильматер всеблагой… Все же смотрели… Что мы делаем… У меня земля уходит из-под ног…»'
            else:
                $AmandaDanceLastText = 'Ваши губы сливаются в чувственном поцелуе прямо под мерцающим светом ярмарочных факелов. Аманда сладостно стонет сквозь сомкнутые губы и охотно отвечает, её тёплый язычок робко касается ваших губ. Музыка и гомон толпы словно отдаляются в густой туман.<br><br>Оторвавшись от вас лишь ради глотка воздуха, раскрасневшаяся девушка шепчет с волнующей улыбкой: «Стефан… ты совсем безумный… Все вокруг переглядываются! Но губы у тебя такие сладкие… Я не смогла устоять…»'
            end
        else:
            if FamilyCorruptionStage <= 3:
                $AmandaDanceLastText = 'Аманда страстно и самозабвенно отвечает на поцелуй. Её тонкие пальцы путаются в ваших волосах на затылке, а губы с жадностью приникают к вашим. Она сбивается с шага, но ей уже всё равно — весь мир для неё сузился до вкуса ваших губ.<br><br>Разомкнув поцелуй, она смотрит на вас потемневшими от желания глазами: «Стефан… голова кругом. Зачем нам эта площадь?.. Уведи меня куда-нибудь…»'
            else:
                $AmandaDanceLastText = 'Едва ваши губы касаются её рта, как Аманда жадно впивается в поцелуй по-взрослому. Её влажный, гибкий язык без малейшего стеснения проникает в ваш рот, сплетаясь с вашим прямо под звонкие переливы скрипок. Она сладострастно причмокивает, прижимаясь всем телом и не обращая внимания на ошарашенные взгляды соседей по хороводу.<br><br>Оторвавшись лишь на миг, она томно облизывает мокрые губы: «М-м-м… Стефанчик… Мой ненасытный жеребец. Какой же ты горячий… Хочу тебя прямо сейчас. Уведи меня в темноту, пока я не раздела тебя прямо тут!»'
            end
        end

    elseif $AmandaDanceTextAction = 'alley':
        if FamilyCorruptionStage <= 1:
            $AmandaDanceLastText = 'Вы предлагаете Аманде отойти с шумной, ярко освещённой площади в полумрак узкого переулка. Девушка пугливо вздрагивает и долго молчит, кусая губы и не решаясь поднять глаз.<br><br>«Туда?.. Но там же совсем темно… — с замиранием сердца шепчет она, нервно комкая подол. — Если кто-то увидит, как мы уходим вдвоём… Но… хорошо. Только веди меня сам…»'
        elseif FamilyCorruptionStage <= 3:
            $AmandaDanceLastText = 'Вы шепчете Аманде на ухо предложение скрыться в спасительной тени переулка. Её глаза вспыхивают шальным блеском, а дыхание мгновенно учащается.<br><br>«В подворотню?.. — с придыханием переспрашивает она, лукаво улыбаясь. — Ты задумал что-то неприличное, братец? Ладно… веди скорее, пока нас никто не окликнул!»'
        else:
            $AmandaDanceLastText = 'Вы киваете в сторону тёмного проулка между каменными домами. На губах Аманды расцветает бесстыдная, торжествующая улыбка.<br><br>«Давно бы так! — жарко выдыхает она, вцепляясь в вашу руку и буквально увлекая вас за собой в спасительную тьму. — Я уже вся извелась на виду у этих дураков. Пойдём скорее!»'
        end

    else:
        $AmandaDanceLastText = 'Танец продолжается под праздничную музыку.'
    end

    killvar '$AmandaDanceTextAction'
    killvar '$AmandaDanceTextResult'
---

#AmandaDanceAlleyText
    if FamilyCorruptionStage <= 1:
        *pl 'Вы увлекаете Аманду с залитой факельным светом ярмарочной площади в узкий тёмный проход между каменными домами.'
        *pl 'Позади постепенно стихает весёлый праздник: звуки скрипок, визг дудок и пьяный смех горожан становятся приглушёнными. Здесь, в глубоких тенях переулка, прохладно и тихо, а каждый шорох отдаётся гулким эхом.'
        *pl 'Аманда робко останавливается у шершавой каменной стены, прижимая ладошку к пылающей щеке. Её глаза испуганно блестят в темноте.'
        *pl '«Стефан… зачем мы сюда свернули? — тихо, с прерывающимся от волнения дыханием шепчет она, оглядываясь на освещённый выход на площадь. — Здесь же совсем темно… Ильматер видит, если кто-нибудь из соседей или матушка Сандра заметит нас вдвоём в подворотне — позора не оберёшься… Что ты задумал?..»'
    elseif FamilyCorruptionStage <= 3:
        *pl 'Крепко держа Аманду за руку, вы сворачиваете с шумной площади в густую тень узкого переулка.'
        *pl 'Ярмарочный гул остаётся за поворотом. В прохладном полумраке между высокими глухими стенами свет факелов лишь слабыми отблесками играет на складках её праздничного платья.'
        *pl 'Аманда прислоняется спиной к холодному камню, шумно и часто переводя дух после быстрого танца. Её грудь волнующе вздымается под шнуровкой, а на губах играет шальная полуулыбка.'
        *pl '«Стефан… Ильматер всеблагой, у меня сердце из груди выпрыгивает… — жарко шепчет она, глядя вам прямо в глаза и не пытаясь высвободить свою ладонь. — Все же видели, как мы прижимались в хороводе! Ты нарочно увёл меня туда, где нас никто не найдёт?.. Ну… и что мы теперь будем делать?»'
    else:
        *pl 'Вы решительно тянете Аманду прочь от ярмарочного шума, ныряя в глухой, непроглядный полумрак соседней подворотни.'
        *pl 'Едва шаги смолкают в тишине проулка, как Аманда сама вжимается спиной в каменную кладку и рывком притягивает вас к себе за пояс штанов. Её тело пылает жаром, а глаза горят откровенным, пьянящим бесстыдством.'
        *pl '«Наконец-то, братец… — сладострастно выдыхает она вам в самые губы, жадно втягивая ноздрями ваш запах. — Я думала, ты так и будешь топтаться на виду у этих святош и зевак. В темноте дышится куда слаще… Моё тело горит огнём после твоего танца. Ну же, Стефанчик… бери меня, пока никто не видит!»'
    end
---
