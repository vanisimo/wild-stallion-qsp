            gs 'AmandaOralBumpTo', 3
        end
    elseif AmandaOralLizetteSlot = 3:
        if AmandaOralStage >= 3 and AmandaLizaInfluence >= 5 and AmandaLizetteAnalTalkDone = 1:
            gs 'AmandaOralBumpTo', 5
        end
    end

    killvar 'AmandaOralLizetteSlot'
---

#AmandaOralOnOverhearPhrase
    gs 'AmandaOralEnsureVars'

    $AmandaOralOverhearId = LCASE($ARGS[0])

    if $AmandaOralOverhearId = 'lizette_oral_practice':
        if AmandaOralStage >= 1:
            gs 'AmandaOralBumpTo', 2
        end

    elseif $AmandaOralOverhearId = 'lizette_balls_hint':
        if AmandaOralStage >= 2 and AmandaLizaInfluence >= 3:
            gs 'AmandaOralBumpTo', 3
        end

    elseif $AmandaOralOverhearId = 'lizette_atm_clean':
        if AmandaOralStage >= 3 and AmandaLizaInfluence >= 5 and AmandaLizetteAnalTalkDone = 1:
