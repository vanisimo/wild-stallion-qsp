#AmandaOralEnsureVars
    if AmandaOralStage < 0:
        AmandaOralStage = 0
    end

    if AmandaOralStage > 6:
        AmandaOralStage = 6
    end
---

#AmandaOralBumpTo
    gs 'AmandaOralEnsureVars'

    AmandaOralBumpTarget = $ARGS[0]

    if AmandaOralBumpTarget < 0:
        AmandaOralBumpTarget = 0
    end

    if AmandaOralBumpTarget > 6:
        AmandaOralBumpTarget = 6
    end

    if AmandaOralStage < AmandaOralBumpTarget:
        AmandaOralStage = AmandaOralBumpTarget
    end

    killvar 'AmandaOralBumpTarget'
---

#AmandaLizaTalkOralSlutTier
    gs 'EnsureGirlData', 'amanda'

    AmandaLizaTalkOralSlutTier = 1

    if sluttiness['amanda'] >= 38:
        AmandaLizaTalkOralSlutTier = 3
    elseif sluttiness['amanda'] >= 22:
        AmandaLizaTalkOralSlutTier = 2
    end
---

#AmandaOralTryAdvanceFromLizette
    gs 'AmandaOralEnsureVars'

    AmandaOralLizetteSlot = $ARGS[0]

    if AmandaLizaInfluence < 2:
        killvar 'AmandaOralLizetteSlot'
        exit
    end

    if AmandaOralLizetteSlot = 0:
