#AmandaHomeFirstSexAppendEnter
    gs 'AmandaHomeFirstSexResolveContext'

    if virginity['amanda'] = 1:
        if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known':
            $AmandaHomeText += '<br><br>Ты входишь медленно, чувствуя, как горячая плоть обхватывает тебя — узко и тесно. Аманда тихо всхлипывает и цепляется за твои плечи.'
            $AmandaHomeText += '<br><br>— Альберчик только в рот давал, — шепчет она прерывисто. — А тут… впервые. Не торопись.'
            $AmandaHomeText += '<br><br>Ты целуешь её в лоб и замираешь, давая привыкнуть. Она смотрит влажными глазами.'
            $AmandaHomeText += '<br><br>— Ты мой брат, Стефан. Запомни это. Сейчас — только ты.'

        elseif $AmandaFirstSexContext = 'legare_hidden':
            $AmandaHomeText += '<br><br>Ты входишь медленно, и Аманда сжимается сильнее, чем ты ожидал для «первого раза». Её дыхание сбивается, но бёдра подаются навстречу слишком умело.'
            $AmandaHomeText += '<br><br>— Не смотри так, — шепчет она, отворачиваясь. — Будто обманываю.'
            $AmandaHomeText += '<br><br>Ты успокаиваешь её поцелуем в висок и ждёшь, пока напряжение уйдёт из её тела.'

        else:
            $AmandaHomeText += '<br><br>Ты входишь осторожно, и Аманда вцепляется в простыню, приглушённо вскрикнув. Её тело сопротивляется, сжимается, дрожит.'
            $AmandaHomeText += '<br><br>— Тише, тише, — шепчешь ты, обнимая её и замирая.'
            $AmandaHomeText += '<br><br>Она дышит часто и мелко, потом медленно расслабляется в твоих руках.'
            $AmandaHomeText += '<br><br>— Теперь можно, — выдыхает она едва слышно. — Двигайся.'
        end
    else:
        if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known':
            $AmandaHomeText += '<br><br>Твой член легко проскальзывает в уже знакомую с мужчиной мокрую киску. Аманда охает и запрокидывает голову.'
            $AmandaHomeText += '<br><br>— Альберчик хорошо разработал, — шепчет она с усмешкой, — но ты, братик, входишь глубже.'
            $AmandaHomeText += '<br><br>Она обхватывает тебя ногами и притягивает ближе, ловя ритм бёдрами.'
        elseif $AmandaFirstSexContext = 'legare_hidden':
            $AmandaHomeText += '<br><br>Ты входишь удивительно легко и глубоко — тело Аманды принимает тебя без малейшего сопротивления. Она охает и улыбается бесстыдно.'
            $AmandaHomeText += '<br><br>— Просто трахай, — шепчет она, глядя прямо в глаза. — Без вопросов. Я хочу этого.'
            $AmandaHomeText += '<br><br>Её бёдра двигаются навстречу с голодной уверенностью.'
        else:
            $AmandaHomeText += '<br><br>Ты входишь глубоко в набухшую мокрую киску, и Аманда прикусывает губу, сдерживая стон. Её тело сразу ловит ритм — жарко, влажно, жадно.'
            $AmandaHomeText += '<br><br>— Да, — выдыхает она, закрывая глаза. — Вот так.'
            $AmandaHomeText += '<br><br>Она двигается с тобой в унисон, не скрывая наслаждения.'
        end
    end

    killvar '$AmandaFirstSexContext'
