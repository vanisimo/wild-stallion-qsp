#AmandaHomeStepText
    $AmandaHomeTextStep = LCASE($ARGS[0])
    gs 'AmandaHomeFirstSexResolveContext'

    if $AmandaHomeTextStep = 'hug':
        $AmandaHomeText = 'За дверью спальни ещё слышен приглушённый вечерний гул — трактир внизу не затихает до полуночи. Ты садишься на край кровати, продавливая перину, и ловишь взглядом тонкий, трепещущий язычок свечи на прикроватном столике. Аманда, в простой ночнушке до колен, устраивается рядом, поджав под себя одну ногу.'
        $AmandaHomeText += '<br><br>Она без умолку тараторит про Сандру — та опять разнесла лоток с яблоками у западных ворот, и теперь полгорода обсуждает, платил ли купец за побитый товар из своего кармана или вычел из жалованья. Ты слушаешь вполуха, кивая в такт её жестикуляции, пока её голос не стихает на полуслове.'
        $AmandaHomeText += '<br><br>В наступившей тишине Аманда вдруг подаётся вперёд и крепко обнимает тебя за шею, утыкаясь носом куда-то в ключицу. Тёплое дыхание щекочет кожу, когда она шепчет, едва шевеля губами: «Ты такой хороший, Стефан…»'

        if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
            $AmandaHomeText += '<br><br>Ты обнимаешь её за плечи, притягивая ближе, и сквозь тонкую ткань ночнушки чувствуешь частое, взволнованное биение её сердца. Аманда трётся щекой о твоё плечо и признаётся — Альберчик, конечно, красиво ухаживал, и вино у него было сладкое, не чета местному пойлу. Но стоит ей прижаться к братику, как всё внутри замирает от спокойной, надёжной теплоты. Она просит не ругать её за любовь к ласкам — и тут же довольно мурлычет, когда твоя ладонь ложится ей на поясницу и начинает поглаживать круговыми движениями.'

        else
            $AmandaHomeText += '<br><br>Ты обнимаешь её бережно, почти невесомо, словно боишься спугнуть. Аманда на миг замирает — плечи напряжены, дыхание сбивается — а потом порывисто обвивает твою шею руками. Она шепчет, что ещё утром вы ругались из-за какой-то ерунды, а сейчас ей не хочется тебя отпускать ни на шаг, ни на мгновение.'
        end

    elseif $AmandaHomeTextStep = 'kiss':
        $AmandaHomeText = 'Полумрак спальни густеет, и только редкий, цокающий стук подков за окном нарушает тишину. Лампа на столике почти догорела, выхватывая из темноты то край подушки, то рассыпанные по плечам Аманды пряди. Она всё ещё болтает — про скупого купца и сплетницу Ирму — но её взгляд то и дело скользит к твоим губам, задерживаясь на мгновение дольше нужного.'
        $AmandaHomeText += '<br><br>Ты поднимаешь руку и касаешься её щеки — кожа горит под пальцами. Болтовня обрывается на полувздохе, ресницы вздрагивают, но она не отпрянула. В наступившей тишине слышно только, как потрескивает фитиль в масле.'
        $AmandaHomeText += '<br><br>Её губы приоткрыты, влажно блестят в полумраке, и ты чувствуешь, как она едва заметно подаётся вперёд — неосознанно, всем телом.'

        if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
            $AmandaHomeText += '<br><br>Ты целуешь её настойчиво, без предисловий, и Аманда сразу откликается — приоткрывает губы, впуская твой язык, и трётся бёдрами о твою ногу сквозь тонкую ткань. Она с улыбкой сравнивает — Альберчик смешно причмокивал, словно рыба на берегу, а от твоего поцелуя у неё пальчики на ногах поджимаются сами собой. И льнёт снова, уже требовательно.'

        else
            $AmandaHomeText += '<br><br>Сначала поцелуй выходит робким — только сухое, осторожное прикосновение губ. Но ты не отступаешь, и она раскрывается навстречу, впуская тебя глубже. Это её первый настоящий поцелуй, и когда ваши языки соприкасаются, Аманда испуганно всхлипывает, но тут же крепче вцепляется в твои плечи. Отдышавшись, она шепчет, что Ильматер, наверное, и сам не знал, как кружится голова от такого, — но тут же грозит, что во всём покоряться не собирается.'
        end

    elseif $AmandaHomeTextStep = 'petting':
        $AmandaHomeText = 'Аманда сидит к тебе спиной, перебирая пальцами пряди светлой косы — распускает её медленно, прядь за прядью, и волосы тяжёлой волной ложатся на плечи. Ты убираешь одну прядь с её шеи, открывая нежную кожу, и кладёшь ладони на талию. Она откидывается затылком к твоему плечу, прикрывая глаза.'
        $AmandaHomeText += '<br><br>Твои руки скользят вверх по рёбрам, забираясь под тонкую ткань ночнушки. Ладони накрывают упругую грудь — соски сразу твердеют под пальцами, и Аманда делает резкий, прерывистый вдох.'
        $AmandaHomeText += '<br><br>Она не отстраняется — наоборот, чуть выгибает спину, вжимаясь в твои ладони.'

        if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
            $AmandaHomeText += '<br><br>Аманда судорожно выдыхает и просит трогать её везде — не оставлять ни одного уголка без ласки. Ты запускаешь руку под подол ночнушки, проводя ладонью по гладкой от «Таро» коже бёдер, всё выше и выше, пока пальцы не находят горячие, влажные складки.'
            if virginity['amanda'] = 0:
                $AmandaHomeText += '<br><br>Пальцы погружаются в горячую влагу, и Аманда стонет в голос, не сдерживаясь. Она признаётся — Альберчик уже лапал её за бочками на заднем дворе и хорошенько разработал пальцами, но братик ласкает в сто раз слаще. И просит мять грудь сильнее и гладить клитор — вот тут, кругами.'
            else
                $AmandaHomeText += '<br><br>Аманда всхлипывает от первого же прикосновения к влажной ложбинке. Она шепчет, что Альберчик, дурак такой, только за декольте хватал да тискал через платье, а туда, глубже, ещё никто не пробирался.'
            end
            $AmandaHomeText += '<br><br>Ты кружишь пальцем по набухшему клитору, и Аманда, чтобы не закричать в голос, кусает тебя в плечо — сильно, до ломоты. Её бёдра подмахивают навстречу твоей руке, насаживаясь на палец всё быстрее и жаднее.'

        else
            $AmandaHomeText += '<br><br>Аманда вздрагивает всем телом, когда твои губы касаются нежной кожи за ушком. Ты сжимаешь её грудь чуть сильнее, перекатывая твёрдый сосок между пальцами, и она судорожно хватает ртом воздух.'
            $AmandaHomeText += '<br><br>Твоя рука спускается ниже, забираясь под ночнушку к гладким от «Таро» бёдрам. Аманда сперва испуганно сводит колени и шепчет: «Ильматер накажет…» — но ты не останавливаешься, поглаживая внутреннюю сторону бедра круговыми, успокаивающими движениями.'
            $AmandaHomeText += '<br><br>Постепенно её ноги раскрываются, и она сама, несмело, подаётся бёдрами навстречу. Пальцы находят влажное тепло, и когда ты касаешься клитора, Аманда издаёт длинный, протяжный стон — удивлённый и жадный одновременно.'
            $AmandaHomeText += '<br><br>Она цепляется за твои плечи, зажмуривается до искр в глазах и шепчет что-то бессвязное про круги Ильматера и про то, что так, наверное, и выглядит грехопадение — сладкое до дрожи в коленях.'
        end

    elseif $AmandaHomeTextStep = 'handjob':
        $AmandaHomeText = 'Аманда подаётся вперёд и обнимает тебя за шею — прохладные пальцы сплетаются на затылке, притягивают ближе. Её дыхание касается твоей щеки, когда она шепчет: «Дай-ка глянуть, что ты там прячешь, братик». Ладошка скользит вниз по твоей груди, животу — и накрывает каменный стояк через ткань. Пальчики сжимаются, пробуя твёрдость, и она тихо ахает. Другая рука уже тянет завязки штанов — резко, нетерпеливо, узел поддаётся с мягким шорохом.'
        $AmandaHomeText += '<br><br>Твой член вырывается на свободу — толстый, вздёрнутый к животу, с блестящей каплей на багровой головке. Аманда замирает. Глаза распахиваются, губы приоткрыты, она забывает вдохнуть. Её пальцы застывают в воздухе в паре дюймов от твоей плоти. «Ильматер милосердный…» — выдыхает она едва слышно. Потом переводит взгляд на твоё лицо, и в этом взгляде — изумление пополам с голодом.'
        $AmandaHomeText += '<br><br>— Здоровенный-то какой… — голос у неё садится до шёпота. Она облизывает пересохшие губы. — И твёрдый — как железный.'
        $AmandaHomeText += '<br><br>Ты стоишь, чувствуя, как воздух холодит влажную головку. Аманда наконец подносит ладонь — осторожно, словно к раскалённому металлу.'

        if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
            $AmandaHomeText += '<br><br>Аманда переводит блестящий взгляд с твоего набухшего члена на твоё лицо. Губы растягиваются в довольной ухмылке.'
            $AmandaHomeText += '<br><br>— А ты, братец, покрепче Альберчика будешь, — пальцы обхватывают горячий ствол, пробно сжимаются. — У того ствол солидный, но вяловат. А тут… каменный и жжётся.'
            $AmandaHomeText += '<br><br>Она не спрашивает разрешения, просто начинает вести кулачок вверх-вниз, пробуя упругость. Ноздри раздуваются от сбитого дыхания.'
            $AmandaHomeText += '<br><br>— Дай-ка я сама… погляжу, что у братика в штанах прячется.'
        else
            $AmandaHomeText += '<br><br>Аманда закусывает губу, смотрит на подрагивающий член почти испуганно. Ладонь замирает в воздухе, не решаясь коснуться.'
            $AmandaHomeText += '<br><br>— Я… никогда такого не держала, — голос срывается на шёпот. — Ты только не смейся, если неловко выйдет.'
            $AmandaHomeText += '<br><br>Она осторожно, самыми кончиками прохладных пальцев, проводит по вздувшейся вене. Задерживает дыхание, будто прикасается к чему-то запретному.'
        end

        $AmandaHomeText += '<br><br>Прохладная ладонь накрывает головку, скользит вниз по стволу. Аманда обхватывает тебя плотнее, большой палец задевает уздечку — ты вздрагиваешь, и она тут же ловит этот ритм.'
        $AmandaHomeText += '<br><br>Движения становятся увереннее, размереннее. Влажные звуки наполняют комнату, когда она размазывает выступившую смазку по всей длине. Ладонь скользит легко, без сухости.'
        $AmandaHomeText += '<br><br>— Сильнее? — выдыхает она, заглядывая в лицо. Ты рычишь сквозь зубы, толкаясь бёдрами навстречу. Аманда ускоряется, кулачок ходит быстро и плотно.'
        $AmandaHomeText += '<br><br>— Давай… выплесни всё на руки, — просит она хрипло. — Я хочу почувствовать.'

        $AmandaHomeText += '<br><br>Сокрушительная волна накрывает тебя с головой. Первая горячая струя выстреливает, заливая Аманде пальцы и запястье. Вторая — ложится на подол задравшейся ночнушки, оставляя мутные разводы.'
        $AmandaHomeText += '<br><br>Ты рычишь, изливаясь до последней капли. Аманда не отрывает взгляда от пульсирующей головки, перепачканные пальцы сжимаются, собирая густое семя.'
        $AmandaHomeText += '<br><br>Она подносит ладонь к лицу, кончиком языка осторожно слизывает белёсую каплю. Причмокивает, пробуя на вкус. Брови удивлённо ползут вверх.'
        $AmandaHomeText += '<br><br>— Ого… солоновато и тепло. И совсем не противно.'

        if AmandaLizaInfluence >= 2:
            gs 'AmandaHomeLizetteLessonAppend', 'handjob'
        end

    elseif $AmandaHomeTextStep = 'blowjob':
        $AmandaHomeText = 'Ты прикрываешь тяжёлый засов, отсекая звуки таверны. Аманда сидит на краю кровати, щёки горят румянцем, но взгляд прикован к твоему поясу.'
        $AmandaHomeText += '<br><br>Пальцы справляются с пряжкой, штаны падают к сапогам. Освобождённый член встаёт, подрагивая, прямо перед её лицом. Аманда облизывает пересохшие губы.'

        if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
            $AmandaHomeText += '<br><br>Лукавая улыбка трогает её губы. Она наклоняется ближе, горячее дыхание обдаёт влажную головку.'
            $AmandaHomeText += '<br><br>— Уже пробовала у Альберчика за бочками, — признаётся она шёпотом. — Но для братика постараюсь ещё слаще.'
            $AmandaHomeText += '<br><br>Аманда соскальзывает с кровати, становясь на колени между твоих разведённых бёдер.'
        else
            $AmandaHomeText += '<br><br>Румянец заливает не только щёки, но и ключицы, уходя под ворот ночнушки. Она смотрит на подрагивающий член почти благоговейно.'
            $AmandaHomeText += '<br><br>— Я… слышала, что мужчины любят ласку губами, — голос дрожит. — Ты покажешь, как правильно?'
            $AmandaHomeText += '<br><br>Аманда опускается на колени, сжимая пальцами подол ночнушки.'
        end

        $AmandaHomeText += '<br><br>На коленях она кладёт тёплые ладони, и они ложатся на твои бёдра. Она подаётся вперёд и целует самую макушку — нежно, почти целомудренно. Губы приоткрываются, обхватывают головку влажным теплом.'
        $AmandaHomeText += '<br><br>Она старательно прячет зубы, язык ведёт снизу по уздечке, пробуя на вкус. Движения осторожные, изучающие. Ты кладёшь ладонь ей на затылок, направляя. Аманда понимает без слов — берёт глубже, до нёба, и комнату наполняет влажное чавканье.'
        $AmandaHomeText += '<br><br>Твои пальцы сжимаются в её волосах, бёдра начинают двигаться навстречу. Она не отстраняется, только часто дышит носом. Когда спазм подступает к паху, ты пытаешься отодвинуть её — но Аманда мотает головой и принимает семя глубоко в горло.'
        $AmandaHomeText += '<br><br>Слёзы выступают на глазах от напряжения, но она глотает. Облизывает припухшие губы, проводит тыльной стороной ладони по подбородку, стирая вытекшую каплю.'

        if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
            $AmandaHomeText += '<br><br>Аманда облизывает пальцы, собирая остатки семени с губ. Сытая улыбка растягивает рот.'
            $AmandaHomeText += '<br><br>— У Альберчика солонее, — замечает она, поднимаясь с колен. — А у тебя густое и сладкое. Так и быть, никому из вас двоих спуску не дам.'
            $AmandaHomeText += '<br><br>Она поправляет сбившуюся ночнушку и подмигивает тебе.'
        else
            $AmandaHomeText += '<br><br>Аманда утирает подбородок дрожащей ладонью, пытается отдышаться. Грудь вздымается под тканью ночнушки.'
            $AmandaHomeText += '<br><br>— Я… справилась? — спрашивает она, заглядывая в глаза. — Тебе понравилось?'
            $AmandaHomeText += '<br><br>В голосе смесь надежды и страха. Она ждёт твоего вердикта, всё ещё стоя на коленях.'
        end

        if AmandaLizaInfluence >= 2:
            gs 'AmandaHomeLizetteLessonAppend', 'blowjob'
        end

    elseif $AmandaHomeTextStep = 'cuni':
        $AmandaHomeText = 'Ты впиваешься в её губы с голодной жадностью, отбрасывая все сомнения. Ладонь зарывается в светлые волосы, а вторая уже тянет подол тонкой ночнушки вверх. Аманда, не прерывая поцелуя, послушно поднимает руки — и ткань летит на пол, оставляя её нагой в мягком свете масляной лампы.'
        $AmandaHomeText += '<br><br>Ты укладываешь сестру на подушки, не давая опомниться. Губы проходятся по шее, чувствуя, как бьётся жилка под нежной кожей. Ниже, к ключицам — Аманда выдыхает сквозь зубы и выгибается навстречу. Ты обводишь языком напряжённый сосок, втягиваешь его в рот, и она вскрикивает, хватаясь за твои плечи.'
        $AmandaHomeText += '<br><br>Ты спускаешься поцелуями по животу, чувствуя, как дрожат мышцы под губами. Аманда задерживает дыхание, когда ты устраиваешься между её бёдер. Она медленно, сама, разводит ноги шире. Кожа внизу безупречно гладкая — порошок «Таро» не оставил и намёка на волосы. Ты видишь только розовые, припухшие лепестки, влажно блестящие в полумраке, и чувствуешь лёгкий, пьянящий мускус её возбуждения.'

        if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
            $AmandaHomeText += '<br><br>Аманда задыхается, глядя на тебя сверху расширенными зрачками. Пальцы её путаются в твоих волосах, подталкивая ближе. «Туда… туда ещё никто языком не залезал, — выдыхает она сбивчиво, с грязноватой усмешкой. — Альберчик только пальцами лапал неумело да сзади пристраивался. А ты… не вздумай переставать, слышишь?»'
        else
            $AmandaHomeText += '<br><br>Из её глаз текут слёзы — не от боли, от переполняющего восторга. Аманда лепечет, глядя в потолок невидящим взглядом: «Стефан… я не знала, что так бывает… Ильматер всемилостивый, я думала, это всё сказки для дурочек…» Она всхлипывает и снова стонет, прижимая твою голову к себе.'
        end

        $AmandaHomeText += '<br><br>Ты прижимаешься лицом к горячим, истекающим соком лепесткам. Язык кружит по набухшему клитору, то замирая, то пульсируя, а затем скользит вниз и погружается в узкий, обжигающе-горячий вход. Аманда кричит, бёдра её ходят ходуном, и тебе приходится держать их, чтобы не вырвалась.'
        $AmandaHomeText += '<br><br>«Стефанчик… ой, Стефанчик…» — её голос срывается на визг, она уже не контролирует себя. Ты чувствуешь, как внутри неё всё сжимается в тугую пружину, и ускоряешь темп, не давая передышки.'
        $AmandaHomeText += '<br><br>Её первый всесокрушающий оргазм накрывает волной. Аманда сжимает твою голову бёдрами так, что в ушах звенит, из горла вырывается долгий, хриплый стон. Горячая влага брызжет тебе на подбородок и губы. Ты жадно слизываешь всё до капли, не отпуская её, пока она дрожит и всхлипывает в подушку.'

    elseif $AmandaHomeTextStep = 'presex':
        $AmandaHomeText = 'Сегодня никаких недомолвок. Ты запираешь дубовый засов на двери, отрезая весь остальной мир. Аманда уже скинула ночнушку — та небрежно висит на спинке стула. Сестра сидит на краю постели нагая, лишь слегка прикрыв грудь ладонями. Упругая грудь с розовыми сосками, тонкая талия, безупречно гладкая кожа в дрожащем свете лампы.'
        $AmandaHomeText += '<br><br>Ты подходишь, берёшь её лицо в ладони и целуешь глубоко, требовательно. Она отвечает с той же страстью, а когда вы отрываетесь друг от друга, шёпотом спрашивает: «Я красивая, Стефан?..» В её глазах — неожиданная уязвимость.'
        $AmandaHomeText += '<br><br>Ты отвечаешь не словом — действием. Аманда сама опускается на спину, раскинув светлые волосы по подушке. Она медленно, глядя тебе прямо в глаза, разводит бёдра, приоткрывая блестящие от влаги лепестки. Грудь её вздымается часто и неровно.'

        if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
            if virginity['amanda'] = 0:
                $AmandaHomeText += '<br><br>Аманда ловит твой взгляд и шепчет с пьянящей, чуть порочной улыбкой: «Знаю, о чём думаешь. Да, Альберчик брал меня за бочками, быстро и скучно. Но сейчас… сейчас я хочу тебя, братик. По-настоящему хочу. Входи уже, не томи.»'
            else
                $AmandaHomeText += '<br><br>Аманда вдруг закусывает губу и шепчет, краснея: «Тот дурак Альберчик… он только за грудь хватал жадными лапами да в рот давал, как кобель. А в писечку… никому не давала. Ни разу», — она смотрит на тебя с отчаянной решимостью. — «Хочу, чтобы это был ты. Здесь, в этой кровати. Лиши меня невинности, Стефан.»'
            end
        else
            $AmandaHomeText += '<br><br>На глазах у Аманды выступают слёзы, но она улыбается. Её шёпот полон счастья: «После этого… я стану твоей женщиной. Перед людьми и перед Ильматером. Никаких больше игр и глупостей. Прошу тебя… не мучай больше, сделай это сейчас.»'
        end

        $AmandaHomeText += '<br><br>Ты кладёшь широкую ладонь на гладкое бедро Аманды, чувствуя жар её кожи. Пальцы скользят по внутренней стороне, касаются сочащихся жаром губок. Она сладко, протяжно стонет, запрокидывая голову, и послушно распахивает ноги шире, приглашая тебя.'

    else
        $AmandaHomeText = 'Между вами повисает тихое, волнующее напряжение.'
    end

    killvar '$AmandaHomeTextStep'
---

#AmandaHomeAfterSexText
    $AmandaHomeText = 'Аманда сидит на постели, натягивая на плечи помятую ночнушку. Светлые волосы растрепались, на щеках горит яркий румянец, а губы припухли от поцелуев. Движения её медленные, немного ошалевшие.'
    $AmandaHomeText += '<br><br>Она вдруг касается твоей ладони, переплетая пальцы. Смотрит не с вызовом, как обычно, а с тёплой, новой нежностью. «Теперь ты не просто старший брат, Стефан…», — её голос звучит чуть хрипло. — «Ильматер всеблагой, у меня до сих пор голова кругом идёт. Но я ни о чём не жалею. Ни о единой секунде.»'
    $AmandaHomeText += '<br><br>Она прижимается к твоему плечу и тихо, умиротворённо вздыхает.'
---

#AmandaDanceLeaveHomeText
    $AmandaDanceLastText = 'Ты берёшь Аманду за руку и решительно уводишь с шумной площади, подальше от масляных взглядов и пьяных выкриков. Она не сопротивляется, даже прибавляет шаг. «Спасибо, — бормочет она, поправляя выбившуюся прядь. — Там ещё немного, и пришлось бы кому-нибудь колено в пах вбивать. Пошли скорее в трактир, пока мать считает выручку и не заметила, что мы улизнули.»'
