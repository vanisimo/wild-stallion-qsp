#AmandaHomeLizetteLessonAppend
    $AmandaLizetteLessonStep = LCASE($ARGS[0])

    if AmandaLizaInfluence < 2:
        killvar '$AmandaLizetteLessonStep'
        exit
    end

    if $AmandaLizetteLessonStep = 'handjob':
        if AmandaLizaInfluence >= 5:
            $AmandaHomeText += '<br><br>Аманда зачерпывает белёсую каплю с запястья и принимается деловито растирать семя по тыльной стороне ладони. Кожа становится влажной и блестящей.'
            $AmandaHomeText += '<br><br>— Лизетта не врала, — бормочет она, разглядывая результат. — Говорила, что мужское семя для кожи лучше любого столичного крема. И не тянет совсем.'
            $AmandaHomeText += '<br><br>Она подносит руку к лицу, придирчиво осматривая каждый палец.'
        elseif AmandaLizaInfluence >= 3:
            $AmandaHomeText += '<br><br>Аманда облизывает пальцы один за другим, собирая с них остатки семени. Язык двигается неторопливо, смакуя.'
            $AmandaHomeText += '<br><br>— Лизетта учила, — поясняет она, заметив твой взгляд. — Говорит, надо пробовать на вкус, чтобы не обидеть мужскую силу. А то некоторые дуются, если брезгуешь.'
            $AmandaHomeText += '<br><br>Она причмокивает и улыбается.'
        else
            $AmandaHomeText += '<br><br>Аманда замирает, глядя на перепачканные пальцы. Щёки заливает краска.'
            $AmandaHomeText += '<br><br>— Лизетта как-то обмолвилась… — она запинается. — Что у сытого здорового мужчины семя сладковатое.'
            $AmandaHomeText += '<br><br>Она подносит палец к губам, но медлит, будто не решаясь проверить.'
        end
    elseif $AmandaLizetteLessonStep = 'blowjob':
        if AmandaLizaInfluence >= 5:
            $AmandaHomeText += '<br><br>Аманда на секунду отрывается от своего занятия и шепчет, облизывая припухшие губы. Взгляд у неё мутный от страсти, но довольный. «Лизетта уверяла… — она снова касается тебя языком, заставляя застонать, — что нужно чувствовать каждый толчок. Таять самой, пропускать через себя. Кажется, я начинаю понимать, о чём она…»'
        elseif AmandaLizaInfluence >= 3:
            $AmandaHomeText += '<br><br>Проглотив всё до последней капли, Аманда отстраняется и открывает рот, показывая тебе чистый розовый язычок. Движение точь-в-точь как учила Лизетта — с вызовом и обещанием. Но через секунду она смущённо фыркает и утыкается горячим лицом в твоё бедро, пряча довольную улыбку.'
        else
            $AmandaHomeText += '<br><br>Аманда вытирает подбородок тыльной стороной ладони и морщит нос, но без отвращения. «Лизетта строго-настрого велела глотать, — поясняет она хрипловато. — Сказала, чтобы не кривилась, как от горького зелья, а то мужчина обидится. Привычка, говорит, дело наживное.»'
        end

        if AmandaOralStage >= 1 and RAND(1, 3) = 1:
            $AmandaHomeText += '<br><br>Аманда вдруг замирает и прячет лицо в сгибе твоего локтя. Шепчет оттуда, смущённо, но настойчиво: «Лизетта втолковывала мне… если после попки, то сначала чистое омовение. Вода с мылом, тщательно. И только потом — губы. Она была очень строга насчёт этого, говорила, здоровье дороже удовольствия.»'
        end
    end

    killvar '$AmandaLizetteLessonStep'
