#AmandaHomeStepText
    $AmandaHomeTextStep = LCASE($ARGS[0])
    gs 'AmandaHomeFirstSexResolveContext'

if $AmandaHomeTextStep = 'hug':
    $AmandaHomeText = 'Вечерний гул таверны остался внизу, за толстой дубовой дверью. В маленькой спальне Аманды пахло сушёной мятой, чистым бельём и тёплым воском оплывающей свечи.'

    $AmandaHomeText += '<br><br>Ты присел к ней на край узкой кровати. Аманда подобрала под себя босые ноги, кутаясь в простую льняную ночнушку. Сначала она по привычке щебетала о пустяках — как матушка Сандра отчитала разносчика за битые яблоки, как в зале расплескали брагу, и как к вечеру гудят ноги от бесконечной беготни по лестницам.'

    $AmandaHomeText += '<br><br>Но посреди фразы её голос вдруг дрогнул и стих. В тишине комнаты стало слышно только мерное потрескивание фитиля. Аманда посмотрела на тебя снизу вверх — открыто, без тени привычной насмешки, — и внезапно потянулась всем телом, крепко обхватив тебя за плечи. Уткнулась носом в твою шею, зажмурившись, словно искала спасения.'

    $AmandaHomeText += '<br><br>«Ты такой хороший, Стефан…» — выдохнула она прямо в ключицу, и от её горячего дыхания по твоей коже побежали мурашки.'

    if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
        $AmandaHomeText += '<br><br>Ты обнимаешь её за хрупкие плечи и притягиваешь вплотную. Тонкий лён ночнушки не скрывает жара девичьего тела — под твоей ладонью отчётливо частит её сердечко, а аккуратная грудь вздымается, прижимаясь к твоей груди.'
        $AmandaHomeText += '<br><br>«Ты же знаешь, как мне нравится, когда за мной ухаживают…» — шепчет Аманда, уютно утыкаясь подбородком в твоё плечо. — «Альберчик так красиво говорил, угощал сладким вином и ласкал… Но к тебе я всё равно прижимаюсь крепче всего! Не сердись на меня, братик. Я просто люблю, когда тепло, сладко и приятно. Ты ведь не станешь меня ругать за то, что я падкая на ласки?..»'
        $AmandaHomeText += '<br><br>Ты медленно опускаешь руку к её пояснице. Аманда довольно мурлычет, трётся щёчкой о твою шею и замирает в твоих руках, всем телом наслаждаясь близостью.'

    else
        $AmandaHomeText += '<br><br>Ты обнимаешь её бережно, но уверенно, смыкая руки за её спиной. Аманда на мгновение цепенеет от непривычной близости, а затем издаёт тихий вздох облегчения и обвивает твою шею обеими руками.'
        $AmandaHomeText += '<br><br>Её кожа пахнет цветочным мылом и девичьей свежестью, маленькая грудь доверчиво упирается тебе в грудь. «Ты меня совсем с толку сбиваешь…» — еле слышно шепчет она, утыкаясь носом в твою щёку. — «Мы же вроде ругались утром… А сейчас я сижу и не хочу тебя отпускать.»'
    end

elseif $AmandaHomeTextStep = 'kiss':
    $AmandaHomeText = 'В спальне царил полумрак. С улицы доносился редкий стук подков по булыжникам, а на подоконнике тихо догорала масляная лампа.'

    $AmandaHomeText += '<br><br>Аманда сидела на постели, расправляя подол ночнушки и тихо рассказывая о городской суете — какой-то приезжий купец пытался сунуть ей медную монетку за лишнюю улыбку, а соседка Ирма нахваливала новые отрезы сукна. Но взгляд её то и дело соскальзывал на твои губы, выдавая волнение.'

    $AmandaHomeText += '<br><br>Ты не стал перебивать её словами — просто подался вперёд и коснулся ладонью её горящей щеки. Болтовня оборвалась на полуслове. Глаза Аманды распахнулись, в них плеснула растерянность, но назад она не отпрянула.'

    if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
        $AmandaHomeText += '<br><br>Твои губы накрывают её рот — настойчиво, пробуя нежную, податливую мягкость. Аманда сладко ахает и сразу приоткрывает губы навстречу, впуская твой язык. Она отвечает на поцелуй с жадным задором, запуская тонкие пальцы в твои волосы и бесстыдно прижимаясь бёдрами к твоей ноге.'
        $AmandaHomeText += '<br><br>«Стефан…» — шепчет она, когда ты на миг отстраняешься, чтобы перевести дух. Глаза её блестят от возбуждения, а губы пылают от поцелуев. — «Альберчик целует с жадным причмокиванием, как зрелый господин, а ты целуешь так, что у меня пальчики на ногах поджимаются! Мне нравится целоваться и с ним, и с тобой… Но с тобой слаще всего. Ну же, поцелуй меня ещё!..»'
        $AmandaHomeText += '<br><br>Она сама снова льнёт к твоим губам, прижимаясь всем телом, пока твоя ладонь уверенно ложится на её талию под тонкую ткань.'

    else
        $AmandaHomeText += '<br><br>Ты склоняешься к ней и целуешь — сначала робко, касаясь лишь уголков губ, затем глубже, настойчивее. Аманда мелко дрожит, её ресницы трепещут. Её первый настоящий поцелуй: неловкий, трогательный, полный искреннего девичьего трепета.'
        $AmandaHomeText += '<br><br>Когда ваши языки впервые соприкасаются, она испуганно всхлипывает, но тут же крепче вцепляется в твои плечи, отвечая со всей нежностью, на какую способна.'
        $AmandaHomeText += '<br><br>«Ильматер милосердный… у меня голова кружится,» — выдыхает она, едва оторвавшись от твоих губ. Глаза её сияют в полумраке. — «Не думай только, что я теперь во всём тебе покоряться стану, братец…»'
    end

elseif $AmandaHomeTextStep = 'petting':
    $AmandaHomeText = 'В комнате было тепло. Аманда сидела спиной к тебе на краю постели, распуская густую косу; её каштановые пряди рассыпались по плечам мягкой волной.'

    $AmandaHomeText += '<br><br>Ты подсел ближе, перехватил шелковистую прядь, убирая её с нежной девичьей шеи, и опустил ладони ей на талию. Аманда замерла, сбивчиво вздохнув, но отстраняться не стала — лишь откинула голову назад, прислоняясь затылком к твоему плечу.'

    $AmandaHomeText += '<br><br>Твои руки медленно скользнули по её рёбрам вверх. Под тонким холстом ночнушки девичье тело пылало жаром. Пальцы накрыли её небольшую, упругую грудь, идеально ложащуюся в ладонь. Сквозь ткань ты почувствовал, как моментально набухли и затвердели соски.'

    if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
        $AmandaHomeText += '<br><br>Аманда судорожно выдохнула и прижала твои руки к своей упругой груди ещё плотнее.'
        $AmandaHomeText += '<br><br>«Стефан… трогай меня везде! Хочу, чтобы твои руки были повсюду…» — простонала она, запрокидывая лицо.'
        $AmandaHomeText += '<br><br>Ты запустил руку под подол ночнушки. Гладкая, бархатистая кожа бедра обожгла пальцы. Сандра строго следила за чистотой по канонам Ильматера, и на девичьем теле не было ни единого лишнего волоска благодаря порошку Таро — лишь гладкий, шелковистый холмик и пылающие жаром складки.'
        if virginity['amanda'] = 0:
            $AmandaHomeText += '<br><br>Когда твои пальцы погрузились в сочащуюся горячую влагу между её бёдер, Аманда громко простонала и широко развела колени: «Ах!.. Стефан… как приятно! Альберчик уже лапал меня за бочками и разработал мою дырочку, но твои пальчики ласкают так глубоко и сладко!.. Мни мои сисечки, гладь клитор, я просто таю от твоих рук! Ещё, братик, пожалуйста, ещё!..»'
        else:
            $AmandaHomeText += '<br><br>Когда твои пальцы коснулись влажной ложбинки между её бёдер, Аманда всхлипнула от наслаждения и широко развела колени: «Ох!.. Стефан… Альберчик только за декольте хватал, а туда ещё никто не пробирался… Как же сладко! Трогай меня, братик, я обожаю твои руки!..»'
        end
        $AmandaHomeText += '<br><br>Ты кружишь пальцем по набухшему клитору, собирая обильную смазку. Аманда кусает собственное плечо, чтобы не закричать, и судорожно подмахивает бёдрами навстречу каждому твоему движению.'

    else
        $AmandaHomeText += '<br><br>Аманда вздрогнула всем телом, из её груди вырвался изумлённый, прерывистый стон. Она попыталась прикрыть лицо ладошками, но ты перехватил её запястье, целуя за ушком.'
        $AmandaHomeText += '<br><br>Ты нежно сжимаешь её девичью грудь, чувствуя, как под пальцами бешено колотится её сердце. Вторая рука скользит под подол льняной рубашки, оглаживая безупречно гладкие, чистые бёдра.'
        $AmandaHomeText += '<br><br>Аманда испуганно свела колени: «Стефан… постой… там же нельзя… Ильматер накажет…» Но ты ласково раздвигаешь её бёдра, и пальцы находят сочащуюся горячим соком ложбинку. Кожа гладкая, благоухающая травами от порошка Таро, а лепестки пылают жаром.'
        $AmandaHomeText += '<br><br>Ты осторожно гладишь её сокровенный бугорок. Аманда стонет, выгибая спину дугой: «Ой… мамочки… что ты со мной делаешь… Стефан, не переставай!..»'
    end

elseif $AmandaHomeTextStep = 'handjob':
    $AmandaHomeText = 'Этим вечером слова были не нужны. Стоило закрыть за собой дверь, как Аманда сама потянулась к тебе, обвивая руками за шею и жадно прижимаясь всем телом.'

    $AmandaHomeText += '<br><br>Её пальцы робко, но неотвратимо скользнули вниз по твоему животу, нащупывая сквозь ткань штанов тугой, каменный стояк. Аманда судорожно сглотнула, чувствуя его тяжесть и пульсирующий жар, а затем медленно распустила завязки твоих штанов.'

    $AmandaHomeText += '<br><br>Твой член с глухим стуком освободился из плена ткани, горячий и сочащийся прозрачной капелькой смазки на бордовой головке. Аманда затаила дыхание, разглядывая его в полумраке комнаты с благоговейным восторгом.'
    $AmandaHomeText += '<br><br>«Он… такой большой… и твёрдый, как дуб,» — прошептала она, и её щёки вспыхнули румянцем. — «И весь пульсирует…»'

    if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
        $AmandaHomeText += '<br><br>«Я хочу сама подержать его… своими ручками,» — с улыбкой шепчет Аманда, разглядывая твой стоящий колом член блестящими глазами. — «У Альберчика член солидный, толстый, но твой, братик — ещё крепче и горячее! Я видела, как он наливается, и у меня сразу слюнки потекли. Давай, я сама его поглажу, мне так нравится сжимать его в кулачке!..»'
    else
        $AmandaHomeText += '<br><br>«Я никогда в жизни такого не держала…» — прошептала она с детской непосредственностью. — «Только не смейся надо мной, если сделаю неловко…»'
    end

    $AmandaHomeText += '<br><br>Её маленькая, прохладная ладонь сомкнулась вокруг горячего ствола. Сначала движения были неуверенными, робкими, но Аманда быстро поймала ритм. Кожа заскользила по натянутому стволу вверх и вниз, большой палец ласково размазывал предсеменную смазку по чувствительному ободку головки.'

    $AmandaHomeText += '<br><br>Ты сдавленно зарычал, запрокинув голову. Видя, как сильно ты заводишься от её прикосновений, Аманда вошла во вкус — её глазки заблестели, дыхание участилось, а темп стал быстрее и крепче:'
    $AmandaHomeText += '<br>«Давай… выплесни всё мне на руки… Стефан, я хочу увидеть, сколько во мне твоего семени поместится!..»'

    $AmandaHomeText += '<br><br>Разрядка накрыла тебя сокрушительной волной. Густые, горячие струи выстрелили из уретры, заливая её тонкие пальцы, запястье и подол ночнушки. Аманда заворожённо ахнула, ощущая обжигающие толчки твоей плоти, но руки не отняла — продолжала мягко сжимать ствол, выжимая всё до единой капли.'

    $AmandaHomeText += '<br><br>Когда судороги утихли, она с любопытством поднесла испачканную белым ладошку к лицу, вдохнула пряный терпкий запах и кончиком розового язычка осторожно коснулась капли на пальце.'
    $AmandaHomeText += '<br><br>«Ого… солоновато и тепло,» — смущённо улыбнулась она, облизывая губы. — «И совсем не противно. Даже сладко…»'

    if AmandaLizaInfluence >= 2:
        gs 'AmandaHomeLizetteLessonAppend', 'handjob'
    end

elseif $AmandaHomeTextStep = 'blowjob':
    $AmandaHomeText = 'Ты вошёл в комнату и прикрыл засов. Аманда сидела на кровати, спустив ноги на коврик, её щёки заливал неровный лихорадочный румянец.'

    $AmandaHomeText += '<br><br>Ты подошёл ближе, расстёгивая пояс. Твой возбуждённый, пылающий член вырвался наружу, подрагивая прямо перед её лицом. Аманда подняла на тебя глаза — в них смешались благоговение, робость и неистовое женское любопытство.'

    if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
        $AmandaHomeText += '<br><br>«Сегодня я возьму его в ротик…» — с лукавой улыбкой шепчет она. — «Я уже пробовала у Альберчика за бочками — он так сладко кряхтел и хвалил меня, когда я сосала его шишку! А теперь я хочу твой член попробовать. Ты не думай, братик, для тебя я постараюсь ещё слаще! Становлюсь на колени… смотри, какой у меня послушный язычок…»'
    else
        $AmandaHomeText += '<br><br>«Я видела… то есть, я слышала, что мужчины любят, когда их ласкают губами…» — прошептала Аманда, краснея до самых ключиц.'
    end

    $AmandaHomeText += '<br><br>Она опустилась на колени прямо перед тобой, упёршись ладонями в твои бёдра. Её горячее дыхание овеяло головку члена. Аманда сначала робко поцеловала натянутую кожицу, лизнула капельку смазки, а затем бережно обхватила ствол мягкими влажными губами.'

    $AmandaHomeText += '<br><br>Она начала медленно двигать головой вперёд и назад, стараясь прятать зубки за губами. Её язычок ласково массировал нижнюю сторону члена. С каждым толчком она брала всё глубже, пока головка не упёрлась ей в мягкое нёбо. Влажные, чавкающие звуки наполнили тишину спальни.'

    $AmandaHomeText += '<br><br>Ты запустил пальцы в её шелковистые волосы, направляя её движения. Аманда с готовностью подавалась навстречу, её щёки втягивались, массируя ствол горячими тисками рта.'

    $AmandaHomeText += '<br><br>Когда волна оргазма подступила к горлу, ты предупреждающе сжал её волосы. Аманда не отстранилась — лишь шире распахнула свои глаза и приняла первый мощный толчок в самую глубину рта.'

    $AmandaHomeText += '<br><br>Горячее семя залило её рот и горло. Она судорожно сглотнула раз, другой, широко открывая горлышко. По её щекам катились слёзы от напряжения, но когда ты выскользнул из её влажных губ, она облизнула подбородок и с гордостью прошептала:'

    if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
        $AmandaHomeText += '<br>«Ого, сколько налило… у Альберчика солонее было, а у тебя густое и сладкое! Обожаю это дело… Братик, я теперь никому из вас двоих спуску не дам!»'
    else
        $AmandaHomeText += '<br>«Фух… как горячо,» — прошептала она, утирая подбородок. — «Я справилась, Стефан?.. Тебе правда понравилось?..»'
    end

    if AmandaLizaInfluence >= 2:
        gs 'AmandaHomeLizetteLessonAppend', 'blowjob'
    end

elseif $AmandaHomeTextStep = 'cuni':
    $AmandaHomeText = 'Сегодня ты пришёл в её спальню с ясным намерением вернуть долг наслаждения. Аманда сидела на расстеленной постели, кутаясь в ночную рубашку, и с нетерпением смотрела на дверь.'

    $AmandaHomeText += '<br><br>Ты подошёл к ней, крепко обнял и впился в её губы поцелуем — долгим, властным и сладким, не давая опомниться. Аманда затрепетала в твоих руках, отвечая со всей девичьей пылкостью.'

    $AmandaHomeText += '<br><br>«Сегодня моя очередь баловать тебя,» — шепнул ты ей на ухо, перехватывая подол её ночнушки. Аманда понятливо и послушно подняла руки, позволяя стянуть сорочку через голову. Ткань упала на пол, оставив её совершенно нагой в мягком свете лампы.'

    $AmandaHomeText += '<br><br>Ты уложил её на подушки и принялся осыпать поцелуями: от нежной девичьей шеи и хрупких ключиц — к аккуратной груди. Твой язык обвёл затвердевший сосок, отчего Аманда выгнулась дугой с протяжным стоном. Затем поцелуи спустились по бархатному животику к самому низу.'

    $AmandaHomeText += '<br><br>Аманда всхлипнула и без тени сомнения широко развела стройные бёдра, отдавая себя на твою милость. Благодаря порошку Таро её нежная кожа была безупречно гладкой, благоухающей чистотой и сладковатым мускусом девичьего желания. Розовые лепестки уже блестели от обильной влаги.'

    if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
        $AmandaHomeText += '<br><br>«О Ильматер… туда ещё никто языком не залезал!» — задыхаясь от возбуждения, стонет Аманда, вцепляясь пальцами в твои волосы. — «Альберчик только пальцами лапал да сзади пристраивался, а ты прямо губами… А-а-ах! Стефанчик, милый, не переставай! Я слаба на такие ласки, я сейчас просто растаю!..»'
    else
        $AmandaHomeText += '<br><br>«Стефан… я не знала, что так бывает… Ильматер всемилостивый…» — лепетала она сквозь слёзы чистого восторга.'
    end

    $AmandaHomeText += '<br><br>Ты прижался лицом к её пылающему естеству. Горячий кончик языка скользнул по нежной ложбинке, собирая сладковато-пряный девичий нектар. Аманда громко ахнула и вцепилась пальцами в простыни.'

    $AmandaHomeText += '<br><br>Ты нашёл губами крошечный, набухший клитор и принялся ласкать его круговыми движениями языка, то слегка прикусывая губами, то погружая язык глубже в узкий вход. Бёдра Аманды заходили ходуном, она забилась на простынях, стоная и всхлипывая от неописуемого блаженства.'

    $AmandaHomeText += '<br><br>«О Ильматер… Стефан! Стефанчик!.. Я сейчас… я не могу!..» — закричала она, теряя остатки контроля.'

    $AmandaHomeText += '<br><br>Её накрыл первый в жизни всесокрушающий женский оргазм. Аманда забилась в твоих руках, её бёдра судорожно сжали твою голову, а из недр её лона брызнула горячая влага. Ты жадно слизывал её соки, пока она плакала и дрожала от переполнявшего её счастья.'

elseif $AmandaHomeTextStep = 'presex':
    $AmandaHomeText = 'Ваши встречи в спальне перешагнули все прежние границы. Сегодня между вами не осталось ни недомолвок, ни притворства. Ты вошёл и запер дверь на прочный дубовый засов.'

    $AmandaHomeText += '<br><br>Аманда сидела на кровати, обняв колени. Её ночнушка уже лежала на стуле — при твоём появлении она даже не попыталась прикрыться. В мягком сиянии масляной лампы её юное обнажённое тело казалось выточенным из тёплого мрамора: аккуратная упругая грудь с тёмно-розовыми сосками, тонкая талия и безупречно чистая, гладкая кожа бёдер.'

    $AmandaHomeText += '<br><br>Ты опустился на постель рядом с ней и притянул к себе. Аманда доверчиво прильнула, обняв тебя за шею. Её губы нашли твои — поцелуй был глубоким, долгим, полным пьянящей решимости.'

    $AmandaHomeText += '<br><br>«Я красивая, Стефан?..» — прошептала она, глядя тебе в глаза с трепетной надеждой и лёгким вызовом.'

    $AmandaHomeText += '<br><br>Она медленно опустилась на спину, чуть приоткрывая бёдра. Между её розовых лепестков уже поблёскивала влага нетерпения.'

    if $AmandaFirstSexContext = 'legare' or $AmandaFirstSexContext = 'legare_known' or $AmandaFirstSexContext = 'legare_hidden':
        if virginity['amanda'] = 0:
            $AmandaHomeText += '<br><br>«Стефан… ты же знаешь, что Альберчик уже брал меня за винными бочками и лишил невинности,» — шепчет она, глядя тебе прямо в глаза с пьянящей улыбкой. — «Было больно сначала, а потом так сладко! Но я хочу и тебя тоже! Хочу обоих! Входи в меня, братик, твоя сестрёнка созрела и ждёт твоего члена!..»'
        else:
            $AmandaHomeText += '<br><br>«Стефан… Альберчик только за декольте хватал да в ротик давал, а в писечку я ещё никому не давала!» — шепчет она, широко раздвигая бёдра. — «Разорви мне плёночку, братик, я хочу стать настоящей женщиной именно с тобой в этой кровати!»'
        end
    else
        $AmandaHomeText += '<br><br>«Стефан… если ты сделаешь это — назад дороги нет. Я стану твоей женщиной перед людьми и Ильматером,» — прошептала она, и её глаза наполнились слезами счастья. — «Я так долго этого ждала… Не мучай меня больше. Возьми меня…»'
    end

    $AmandaHomeText += '<br><br>Твоя рука легла на её гладкое бедро, пальцы ласково коснулись сочащихся жаром губок. Аманда сладко простонала и распахнула ноги шире навстречу твоей близости.'

else:
    $AmandaHomeText = 'Между вами повисает тихое, волнующее напряжение.'
end

killvar '$AmandaHomeTextStep'
