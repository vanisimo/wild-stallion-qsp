#AmandaHomeLizetteLessonAppend
    $AmandaLizetteLessonStep = LCASE($ARGS[0])

    if AmandaLizaInfluence < 2:
        killvar '$AmandaLizetteLessonStep'
        exit
    end

    if $AmandaLizetteLessonStep = 'handjob':
        if AmandaLizaInfluence >= 5:
            $AmandaHomeText += '<br><br>«Лизетта говорила, что мужское семя для девичьей кожи полезнее любого столичного крема…» — шепчет Аманда, с лукавым прищуром растирая капли по нежной коже запястья. — «Не смейся, Стефан! Я просто проверяю столичные премудрости…»'
        elseif AmandaLizaInfluence >= 3:
            $AmandaHomeText += '<br><br>«Лизетта рассказывала, что когда мужчина кончает тебе на ладонь — нужно обязательно попробовать на вкус,» — бормочет Аманда, облизывая кончики пальцев. — «Иначе покажешь, будто брезгуешь его мужественностью. А я тобой не брезгую… ни капли.»'
        else
            $AmandaHomeText += '<br><br>«Лизетта как-то обмолвилась, что семя сладковато на вкус, если мужчина сыт и здоров…» — краснеет Аманда, пряча глаза. — «Вот я и проверила. Только никому не болтай, слышишь?..»'
        end
    elseif $AmandaLizetteLessonStep = 'blowjob':
        if AmandaLizaInfluence >= 5:
            $AmandaHomeText += '<br><br>«Лизетта уверяла, что когда даришь мужчине ласку губами — нужно чувствовать каждый его толчок и самой таять от этого…» — шепчет Аманда, облизывая влажные губы. — «Теперь я понимаю, о чём она говорила… Это сводит с ума, Стефан.»'
        elseif AmandaLizaInfluence >= 3:
            $AmandaHomeText += '<br><br>Проглотив всё до последней капли, Аманда послушно приоткрывает ротик и показывает чистый розовый язычок — в точности так, как учила столичная куртизанка: «Видишь? Чисто… Лизетта говорила, мужчины с ума сходят, когда видят, что их дар принят без остатка.» Затем она смущённо утыкается тебе в бедро.'
        else
            $AmandaHomeText += '<br><br>«Лизетта строго-настрого велела: если берёшь в ротик — глотай и не кривись, как от горького зелья,» — шепчет Аманда, вытирая подбородок. — «Я всё сделала как надо, Стефан?..»'
        end

        if AmandaOralStage >= 1 and RAND(1, 3) = 1:
            $AmandaHomeText += '<br><br>«И ещё… Лизетта втолковывала: если когда-нибудь дело дойдёт до попки — после неё сначала чистое омовение водой с мылом, и только потом губы,» — бормочет она едва слышным шёпотом, пряча лицо. — «Я на всю жизнь запомнила.»'
        end
    end

    killvar '$AmandaLizetteLessonStep'
