#FamilyFirstSexTalkStart
    *clr
    clr
    cla

    gs 'NormalizeGirlKey', $ARGS[0]
    $TalkGirl = $GirlKey
    $TargetGirl = $ARGS[1]
    $TalkMode = $ARGS[2]
    $TalkReturnLoc = $ARGS[3]

    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    if $TalkMode = 'worry':
        gs 'SceneShowVisual', 'images/events/family/talk_' + $TalkGirl + '_worry', 'РАЗГОВОР: ' + $RealName[$TalkGirl], 'large', 'webp'
    elseif $TalkMode = 'marathon_after':
        gs 'SceneShowVisual', 'images/events/family/talk_' + $TalkGirl + '_marathon', 'РАЗГОВОР: ' + $RealName[$TalkGirl], 'large', 'webp'
    elseif $TalkMode = 'no_finish_apology':
        gs 'SceneShowVisual', 'images/events/family/talk_' + $TalkGirl + '_apology', 'РАЗГОВОР: ' + $RealName[$TalkGirl], 'large', 'webp'
    else
        gs 'SceneShowVisual', 'images/events/family/talk_' + $TalkGirl + '_' + $TalkMode + '_' + $TargetGirl, 'РАЗГОВОР: ' + $RealName[$TalkGirl], 'large', 'webp'
    end

    gs 'GirlTalkShowSidebarWithAnchor', $TalkGirl

    gs 'ShowLocationScreenTitle', 'СЕМЕЙНЫЙ РАЗГОВОР: ' + $RealName[$TalkGirl]

    gs 'FamilyFirstSexTalkIntroText', $TalkGirl, $TargetGirl, $TalkMode
    *pl ' '

    if $TalkGirl = 'sandra' and $TalkMode = 'suspicion':
        gs 'ActUiPrepare', 'Отрицать всё', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'deny', $TalkReturnLoc
        end

        gs 'ActUiPrepare', 'Спокойно успокоить её', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'calm', $TalkReturnLoc
        end

        gs 'ActUiPrepare', 'Перевести разговор на дела', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'deflect', $TalkReturnLoc
        end

    elseif $TalkGirl = 'melissa' and $TalkMode = 'suspicion':
        gs 'ActUiPrepare', 'Пошутить в ответ', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'banter', $TalkReturnLoc
        end

        gs 'ActUiPrepare', 'Попросить о благоразумии', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'discretion', $TalkReturnLoc
        end

        gs 'ActUiPrepare', 'Оборвать разговор', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'dismiss', $TalkReturnLoc
        end

    elseif $TalkGirl = 'amanda' and $TalkMode = 'suspicion':
        gs 'ActUiPrepare', 'Отшутиться и потрепать по щеке', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'banter', $TalkReturnLoc
        end

        gs 'ActUiPrepare', 'Попросить держать язык за зубами', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'discretion', $TalkReturnLoc
        end

    elseif $TalkMode = 'worry':
        gs 'ActUiPrepare', 'Успокоить и обнять', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'reassure', $TalkReturnLoc
        end

        gs 'ActUiPrepare', 'Призвать к осторожности', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'caution', $TalkReturnLoc
        end

    elseif $TalkMode = 'marathon_after':
        gs 'ActUiPrepare', 'Подразнить её с улыбкой', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'tease', $TalkReturnLoc
        end

        gs 'ActUiPrepare', 'Похвалить её страстность', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'praise', $TalkReturnLoc
        end

    elseif $TalkMode = 'no_finish_apology':
        gs 'ActUiPrepare', 'Пообещать наверстать сегодня ночью', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'promise', $TalkReturnLoc
        end

    elseif $TalkMode = 'alley_peeper':
        gs 'ActUiPrepare', 'Пригрозить парню, чтобы молчал', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'protect', $TalkReturnLoc
        end

        gs 'ActUiPrepare', 'Подразнить: тебе ведь понравилось внимание', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'tease_peeper', $TalkReturnLoc
        end

    else
        gs 'ActUiPrepare', 'Выслушать', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyFirstSexTalkChoice', $TalkGirl, $TargetGirl, $TalkMode, 'listen', $TalkReturnLoc
        end
    end
---

#FamilyFirstSexTalkChoice
    *clr
    clr
    cla

    gs 'NormalizeGirlKey', $ARGS[0]
    $TalkGirl = $GirlKey
    $TargetGirl = $ARGS[1]
    $TalkMode = $ARGS[2]
    $Choice = $ARGS[3]
    $TalkReturnLoc = $ARGS[4]

    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'SceneShowVisual', 'images/events/family/talk_react_' + $TalkGirl + '_' + $Choice, 'РЕАКЦИЯ: ' + $RealName[$TalkGirl], 'large', 'webp'

    gs 'GirlTalkShowSidebarWithAnchor', $TalkGirl

    gs 'ShowLocationScreenTitle', 'СЕМЕЙНЫЙ РАЗГОВОР: ' + $RealName[$TalkGirl]

    gs 'FamilyFirstSexTalkChoiceText', $TalkGirl, $TargetGirl, $TalkMode, $Choice
    *pl ' '

    if $TalkGirl = 'sandra' and $TalkMode = 'suspicion':
        FamilyIntimSuspicionTalkDone['sandra', $TargetGirl] = 1

        if $TargetGirl = 'amanda':
            SandraAmandaSuspicionTalkDone = 1
        elseif $TargetGirl = 'melissa':
            SandraMelissaSuspicionTalkDone = 1
        end

        if $Choice = 'deny':
            AmandaFirstSexSandraTalkResponse = 1
            FamilyTension += 4
            SandraFamilyConcern += 1
        elseif $Choice = 'calm':
            AmandaFirstSexSandraTalkResponse = 2
            FamilyTrust += 2
            SandraTrust += 1
        else
            AmandaFirstSexSandraTalkResponse = 3
            FamilyTension += 2
        end

    elseif $TalkGirl = 'melissa' and $TalkMode = 'suspicion':
        FamilyIntimTeaseTalkDone['melissa', $TargetGirl] = 1

        if $TargetGirl = 'amanda':
            MelissaAmandaTeaseDone = 1
        elseif $TargetGirl = 'sandra':
            MelissaSandraSuspicionTalkDone = 1
        end

        if $Choice = 'banter':
            Friends['melissa'] += 2
            love['melissa'] += 1
        elseif $Choice = 'discretion':
            FamilyTrust += 1
            MelissaTrustStefan += 1
        else
            FamilyTension += 3
        end

    elseif $TalkGirl = 'amanda' and $TalkMode = 'suspicion':
        FamilyIntimSuspicionTalkDone['amanda', $TargetGirl] = 1

        if $TargetGirl = 'melissa':
            AmandaMelissaSuspicionTalkDone = 1
        elseif $TargetGirl = 'sandra':
            AmandaSandraSuspicionTalkDone = 1
        end

        if $Choice = 'banter':
            Friends['amanda'] += 2
            love['amanda'] += 1
        else
            FamilyTrust += 1
            AmandaTrustStefan += 1
        end

    elseif $TalkMode = 'worry':
        FamilyIntimWorryTalkDone[$TalkGirl] = 1
        if $TalkGirl = 'amanda':
            AmandaFirstSexAmandaWorryTalkDone = 1
            if $Choice = 'reassure':
                AmandaTrustStefan += 2
                love['amanda'] += 2
            else
                AmandaWorkDiscipline += 1
                AmandaSecretiveness += 1
            end
        elseif $TalkGirl = 'melissa':
            MelissaFirstSexWorryTalkDone = 1
            if $Choice = 'reassure':
                MelissaTrustStefan += 2
                love['melissa'] += 2
            else
                FamilyTrust += 1
            end
        elseif $TalkGirl = 'sandra':
            SandraFirstSexWorryTalkDone = 1
            if $Choice = 'reassure':
                SandraTrust += 2
                love['sandra'] += 2
            else
                FamilyTrust += 1
            end
        end

    elseif $TalkMode = 'marathon_after':
        FamilyMorningMarathonTalkPending[$TalkGirl] = 0
        Friends[$TalkGirl] += 1
        love[$TalkGirl] += 2
        otkroven[$TalkGirl] += 1

    elseif $TalkMode = 'no_finish_apology':
        FamilyMorningNoFinishTalkPending[$TalkGirl] = 0
        Friends[$TalkGirl] += 2
        love[$TalkGirl] += 1

    elseif $TalkMode = 'alley_peeper':
        AmandaAlleyPeeperTalkPending = 0
        if $Choice = 'protect':
            AmandaTrustStefan += 2
            AmandaPlayerPath += 1
        else
            sluttiness['amanda'] += 2
            otkroven['amanda'] += 1
            AmandaNpcPath += 1
        end

    elseif $TalkMode = 'understood':
        FamilyIntimUnderstoodTalkDone[$TalkGirl, $TargetGirl] = 1

        if $TalkGirl = 'sandra':
            if $TargetGirl = 'amanda':
                SandraAmandaUnderstoodTalkDone = 1
            elseif $TargetGirl = 'melissa':
                SandraMelissaUnderstoodTalkDone = 1
            end

            FamilyCorruptionStage += 1
            if FamilyCorruptionStage > 5:
                FamilyCorruptionStage = 5
            end

        elseif $TalkGirl = 'melissa':
            if $TargetGirl = 'amanda':
                MelissaAmandaUnderstoodTalkDone = 1
            elseif $TargetGirl = 'sandra':
                MelissaSandraUnderstoodTalkDone = 1
            end

            MelissaTrustStefan += 2
            FamilyTrust += 1

        elseif $TalkGirl = 'amanda':
            if $TargetGirl = 'melissa':
                AmandaMelissaUnderstoodTalkDone = 1
            elseif $TargetGirl = 'sandra':
                AmandaSandraUnderstoodTalkDone = 1
            end

            AmandaTrustStefan += 1
            FamilyTrust += 1
        end
    end

    Friends[$TalkGirl] += 1

    if love[$TalkGirl] > 0:
        love[$TalkGirl] += 1
    end

    if FamilyTension > 100:
        FamilyTension = 100
    end

    if FamilyTrust > 100:
        FamilyTrust = 100
    end

    gs 'ClampGirlSocialStats', $TalkGirl
    gs 'UsefulTalkRegister', $TalkGirl, 'family_aftermath'

    killvar '$TalkGirl'
    killvar '$TargetGirl'
    killvar '$TalkMode'
    killvar '$Choice'

    gs 'GirlTalkAddReturnButton', $TalkReturnLoc
