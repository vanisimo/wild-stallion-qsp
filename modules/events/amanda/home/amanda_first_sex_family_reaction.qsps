! ================================================
! FILE: modules/events/amanda/home/amanda_first_sex_family_reaction.qsps
! MODULE: events/amanda/home
! Двухэкранные утренние мини-ивенты после интима (первая ночь, лимит/шумная ночь, не в форме, светится от счастья) и семейные разговоры
! ================================================

#FamilyFirstSexMorningMarkPending
    gs 'NormalizeGirlKey', $ARGS[0]
    $IntimTargetGirl = $GirlKey

    if $IntimTargetGirl = '':
        $IntimTargetGirl = 'amanda'
    end

    if FamilyFirstSexMorningShown[$IntimTargetGirl] = 1:
        killvar '$IntimTargetGirl'
        exit
    end

    FamilyFirstSexMorningPending[$IntimTargetGirl] = 1

    if $IntimTargetGirl = 'amanda':
        AmandaFirstSexMorningPending = 1
    end

    ! Если у других членов семьи уже была близость со Стефаном, они сразу всё понимают
    if $IntimTargetGirl <> 'amanda' and (AmandaHomeFirstVaginalRegistered = 1 or AmandaHomeSex = 1 or HadSex['amanda'] > 0):
        gs 'FamilyFirstSexMarkUnderstood', 'amanda', $IntimTargetGirl
        gs 'FamilyFirstSexMarkUnderstood', $IntimTargetGirl, 'amanda'
    end

    if $IntimTargetGirl <> 'melissa' and (MelissaHomeSex = 1 or HadSex['melissa'] > 0):
        gs 'FamilyFirstSexMarkUnderstood', 'melissa', $IntimTargetGirl
        gs 'FamilyFirstSexMarkUnderstood', $IntimTargetGirl, 'melissa'
    end

    if $IntimTargetGirl <> 'sandra' and (SandraHomeSex = 1 or HadSex['sandra'] > 0):
        gs 'FamilyFirstSexMarkUnderstood', 'sandra', $IntimTargetGirl
        gs 'FamilyFirstSexMarkUnderstood', $IntimTargetGirl, 'sandra'
    end

    gs 'FamilyMorningAfterRecordNight', $IntimTargetGirl, 'first_sex'

    killvar '$IntimTargetGirl'
---

#AmandaFirstSexMorningMarkPending
    if AmandaHomeFirstVaginalRegistered = 0 and AmandaHomeSex = 0:
        exit
    end

    if AmandaFirstSexMorningShown = 1 or FamilyFirstSexMorningShown['amanda'] = 1:
        exit
    end

    gs 'FamilyFirstSexMorningMarkPending', 'amanda'
---

#FamilyMorningAfterPickWitness
    $MorningTarget = $ARGS[0]
    $FamilyMorningWitnessOut = ''

    if $MorningTarget = 'amanda':
        if $GirlLocation['sandra'] = 'Kitchen' or $GirlLocation['sandra'] = 'TavernMain':
            $FamilyMorningWitnessOut = 'sandra'
        elseif $GirlLocation['melissa'] = 'Kitchen' or $GirlLocation['melissa'] = 'TavernMain':
            $FamilyMorningWitnessOut = 'melissa'
        elseif RAND(1, 2) = 1:
            $FamilyMorningWitnessOut = 'sandra'
        else
            $FamilyMorningWitnessOut = 'melissa'
        end
    elseif $MorningTarget = 'melissa':
        if $GirlLocation['sandra'] = 'Kitchen' or $GirlLocation['sandra'] = 'TavernMain':
            $FamilyMorningWitnessOut = 'sandra'
        elseif $GirlLocation['amanda'] = 'Kitchen' or $GirlLocation['amanda'] = 'TavernMain':
            $FamilyMorningWitnessOut = 'amanda'
        elseif RAND(1, 2) = 1:
            $FamilyMorningWitnessOut = 'sandra'
        else
            $FamilyMorningWitnessOut = 'amanda'
        end
    elseif $MorningTarget = 'sandra':
        if $GirlLocation['melissa'] = 'Kitchen' or $GirlLocation['melissa'] = 'TavernMain':
            $FamilyMorningWitnessOut = 'melissa'
        elseif $GirlLocation['amanda'] = 'Kitchen' or $GirlLocation['amanda'] = 'TavernMain':
            $FamilyMorningWitnessOut = 'amanda'
        elseif RAND(1, 2) = 1:
            $FamilyMorningWitnessOut = 'melissa'
        else
            $FamilyMorningWitnessOut = 'amanda'
        end
    end

    killvar '$MorningTarget'
---

#FamilyMorningAfterRecordNight
    gs 'NormalizeGirlKey', $ARGS[0]
    $MorningRecGirl = $GirlKey
    $MorningExplicitType = LCASE($ARGS[1])

    if $MorningRecGirl <> 'amanda' and $MorningRecGirl <> 'melissa' and $MorningRecGirl <> 'sandra':
        killvar '$MorningRecGirl'
        killvar '$MorningExplicitType'
        exit
    end

    ! Если уже запланировано событие первой ночи — не перетираем его обычным событием
    if FamilyMorningAfterPending = 1 and $FamilyMorningAfterType = 'first_sex' and $MorningExplicitType <> 'first_sex':
        killvar '$MorningRecGirl'
        killvar '$MorningExplicitType'
        exit
    end

    $MorningDetectedType = ''

    if $MorningExplicitType <> '':
        $MorningDetectedType = $MorningExplicitType
    elseif FamilyFirstSexMorningPending[$MorningRecGirl] = 1 and FamilyFirstSexMorningShown[$MorningRecGirl] = 0:
        $MorningDetectedType = 'first_sex'
    elseif SexGirlExhausted = 1 or (SexGirlOrgasmCap > 0 and SexGirlCameInScene >= SexGirlOrgasmCap) or SexMarathonGossipPending[$MorningRecGirl] = 1:
        $MorningDetectedType = 'marathon'
    elseif SexSceneHadActivity = 1 and SexGirlCameInScene = 0:
        $MorningDetectedType = 'no_finish'
    elseif SexSceneHadActivity = 1 and SexGirlCameInScene >= 1:
        if FamilyMorningHappyLastDay <> day and RAND(1, 100) <= 35:
            $MorningDetectedType = 'happy_normal'
            FamilyMorningHappyLastDay = day
        end
    end

    if $MorningDetectedType = '':
        killvar '$MorningRecGirl'
        killvar '$MorningExplicitType'
        killvar '$MorningDetectedType'
        exit
    end

    gs 'FamilyMorningAfterPickWitness', $MorningRecGirl

    FamilyMorningAfterPending = 1
    FamilyMorningAfterRecordedDay = day
    $FamilyMorningAfterGirl = $MorningRecGirl
    $FamilyMorningAfterWitness = $FamilyMorningWitnessOut
    $FamilyMorningAfterType = $MorningDetectedType

    killvar '$FamilyMorningWitnessOut'
    killvar '$MorningRecGirl'
    killvar '$MorningExplicitType'
    killvar '$MorningDetectedType'
---

#FamilyFirstSexMorningCanShow
    FamilyFirstSexMorningCanShow = 0
    $FamilyFirstSexMorningTargetGirl = ''

    if time <> 1:
        exit
    end

    if FamilyFirstSexMorningPending['amanda'] = 1 and FamilyFirstSexMorningShown['amanda'] = 0:
        FamilyFirstSexMorningCanShow = 1
        $FamilyFirstSexMorningTargetGirl = 'amanda'
    elseif AmandaFirstSexMorningPending = 1 and AmandaFirstSexMorningShown = 0:
        FamilyFirstSexMorningCanShow = 1
        $FamilyFirstSexMorningTargetGirl = 'amanda'
    elseif FamilyFirstSexMorningPending['melissa'] = 1 and FamilyFirstSexMorningShown['melissa'] = 0:
        FamilyFirstSexMorningCanShow = 1
        $FamilyFirstSexMorningTargetGirl = 'melissa'
    elseif FamilyFirstSexMorningPending['sandra'] = 1 and FamilyFirstSexMorningShown['sandra'] = 0:
        FamilyFirstSexMorningCanShow = 1
        $FamilyFirstSexMorningTargetGirl = 'sandra'
    end
---

#AmandaFirstSexMorningCanShow
    gs 'FamilyFirstSexMorningCanShow'
    AmandaFirstSexMorningCanShow = 0

    if FamilyFirstSexMorningCanShow = 1 and $FamilyFirstSexMorningTargetGirl = 'amanda':
        AmandaFirstSexMorningCanShow = 1
    end
---

#FamilyMorningAfterCanShow
    FamilyMorningAfterCanShow = 0

    if time <> 1:
        exit
    end

    ! Миграция старых флагов первой ночи, если они были выставлены напрямую
    if FamilyMorningAfterPending = 0:
        gs 'FamilyFirstSexMorningCanShow'
        if FamilyFirstSexMorningCanShow = 1 and $FamilyFirstSexMorningTargetGirl <> '':
            gs 'FamilyMorningAfterRecordNight', $FamilyFirstSexMorningTargetGirl, 'first_sex'
        end
    end

    if FamilyMorningAfterPending = 1 and $FamilyMorningAfterGirl <> '' and $FamilyMorningAfterType <> '':
        ! Просроченные обычные утренние сценки сбрасываем, если прошло больше 2 дней, кроме первой ночи
        if $FamilyMorningAfterType <> 'first_sex' and FamilyMorningAfterRecordedDay > 0 and (day - FamilyMorningAfterRecordedDay > 2):
            FamilyMorningAfterPending = 0
            $FamilyMorningAfterGirl = ''
            $FamilyMorningAfterWitness = ''
            $FamilyMorningAfterType = ''
            exit
        end
        FamilyMorningAfterCanShow = 1
    end
---

#FamilyFirstSexMorningTryShow
    gs 'FamilyMorningAfterCanShow'

    if FamilyMorningAfterCanShow = 0:
        exit
    end

    if $curloc <> '':
        gt 'FamilyMorningAfterScreen1', $curloc
    else
        gt 'FamilyMorningAfterScreen1', 'TavernMain'
    end
---

#AmandaFirstSexMorningTryShow
    gs 'FamilyFirstSexMorningTryShow'
---

#FamilyMorningAfterScreen1
    *clr
    clr
    cla

    if $ARGS[0] <> '':
        $FamilyMorningAfterReturnLoc = $ARGS[0]
    end

    if $FamilyMorningAfterReturnLoc = '':
        $FamilyMorningAfterReturnLoc = 'TavernMain'
    end

    if $FamilyMorningAfterGirl = '':
        $FamilyMorningAfterGirl = 'amanda'
    end

    if $FamilyMorningAfterWitness = '' or $FamilyMorningAfterWitness = $FamilyMorningAfterGirl:
        gs 'FamilyMorningAfterPickWitness', $FamilyMorningAfterGirl
        $FamilyMorningAfterWitness = $FamilyMorningWitnessOut
        killvar '$FamilyMorningWitnessOut'
    end

    if $FamilyMorningAfterType = '':
        $FamilyMorningAfterType = 'first_sex'
    end

    if $FamilyMorningAfterType = 'first_sex':
        $MorningTitle1 = 'УТРО ПОСЛЕ ПЕРВОЙ НОЧИ: ВЗГЛЯД СО СТОРОНЫ'
    elseif $FamilyMorningAfterType = 'marathon':
        $MorningTitle1 = 'УТРО ПОСЛЕ БУРНОЙ НОЧИ: НЕДОВОЛЬСТВО В ДОМЕ'
    elseif $FamilyMorningAfterType = 'no_finish':
        $MorningTitle1 = 'НАПРЯЖЁННОЕ УТРО: ТЯЖЁЛЫЙ ВЗГЛЯД'
    else
        $MorningTitle1 = 'УТРО В ТРАКТИРЕ: ЗАМЕТНЫЕ ПЕРЕМЕНЫ'
    end

    gs 'ShowLocationScreenTitle', $MorningTitle1
    gs 'SceneShowVisual', 'images/events/family/morning_' + $FamilyMorningAfterType + '_witness_' + $FamilyMorningAfterWitness, 'УТРЕННЯЯ РЕАКЦИЯ: ' + $RealName[$FamilyMorningAfterWitness], 'large', 'webp'

    gs 'FamilyMorningAfterScreen1Text', $FamilyMorningAfterGirl, $FamilyMorningAfterWitness, $FamilyMorningAfterType
    *pl ' '

    killvar '$MorningTitle1'

    gs 'ActUiPrepare', 'Посмотреть на реакцию (' + $RealName[$FamilyMorningAfterGirl] + ')', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FamilyMorningAfterScreen2'
    end
---

#FamilyMorningAfterScreen2
    *clr
    clr
    cla

    if $FamilyMorningAfterReturnLoc = '':
        $FamilyMorningAfterReturnLoc = 'TavernMain'
    end

    if $FamilyMorningAfterType = 'first_sex':
        $MorningTitle2 = 'УТРО ПОСЛЕ ПЕРВОЙ НОЧИ: ОПРАВДАНИЯ'
    elseif $FamilyMorningAfterType = 'marathon':
        $MorningTitle2 = 'УТРО ПОСЛЕ БУРНОЙ НОЧИ: СМУЩЕНИЕ И УСТАЛОСТЬ'
    elseif $FamilyMorningAfterType = 'no_finish':
        $MorningTitle2 = 'УТРЕННИЙ УПРЁК: НЕ В ФОРМЕ'
    else
        $MorningTitle2 = 'УТРО В ТРАКТИРЕ: СИЯЮЩИЕ ГЛАЗА'
    end

    gs 'ShowLocationScreenTitle', $MorningTitle2
    gs 'SceneShowVisual', 'images/events/family/morning_' + $FamilyMorningAfterType + '_girl_' + $FamilyMorningAfterGirl, 'УТРО ПОСЛЕ НОЧИ: ' + $RealName[$FamilyMorningAfterGirl], 'large', 'webp'

    gs 'FamilyMorningAfterScreen2Text', $FamilyMorningAfterGirl, $FamilyMorningAfterWitness, $FamilyMorningAfterType
    *pl ' '

    ! Применяем последствия по типу утреннего мини-ивента
    if $FamilyMorningAfterType = 'first_sex':
        FamilyFirstSexMorningPending[$FamilyMorningAfterGirl] = 0
        FamilyFirstSexMorningShown[$FamilyMorningAfterGirl] = 1
        $FamilyFirstSexMorningWitness[$FamilyMorningAfterGirl] = $FamilyMorningAfterWitness

        if $FamilyMorningAfterGirl = 'amanda':
            AmandaFirstSexMorningPending = 0
            AmandaFirstSexMorningShown = 1
            $AmandaFirstSexMorningWitness = $FamilyMorningAfterWitness
            GirlSuspectsAmandaStefan['sandra'] = 1
            GirlSuspectsAmandaStefan['melissa'] = 1
            GirlSuspectsFamilyIntim['sandra', 'amanda'] = 1
            GirlSuspectsFamilyIntim['melissa', 'amanda'] = 1
        elseif $FamilyMorningAfterGirl = 'melissa':
            GirlSuspectsFamilyIntim['sandra', 'melissa'] = 1
            GirlSuspectsFamilyIntim['amanda', 'melissa'] = 1
        elseif $FamilyMorningAfterGirl = 'sandra':
            GirlSuspectsFamilyIntim['melissa', 'sandra'] = 1
            GirlSuspectsFamilyIntim['amanda', 'sandra'] = 1
        end

        ! Если у кого-то из других уже был интим со Стефаном, выставляем флаг понимания
        if $FamilyMorningAfterGirl <> 'amanda' and (AmandaHomeFirstVaginalRegistered = 1 or AmandaHomeSex = 1 or HadSex['amanda'] > 0):
            gs 'FamilyFirstSexMarkUnderstood', 'amanda', $FamilyMorningAfterGirl
            gs 'FamilyFirstSexMarkUnderstood', $FamilyMorningAfterGirl, 'amanda'
        end
        if $FamilyMorningAfterGirl <> 'melissa' and (MelissaHomeSex = 1 or HadSex['melissa'] > 0):
            gs 'FamilyFirstSexMarkUnderstood', 'melissa', $FamilyMorningAfterGirl
            gs 'FamilyFirstSexMarkUnderstood', $FamilyMorningAfterGirl, 'melissa'
        end
        if $FamilyMorningAfterGirl <> 'sandra' and (SandraHomeSex = 1 or HadSex['sandra'] > 0):
            gs 'FamilyFirstSexMarkUnderstood', 'sandra', $FamilyMorningAfterGirl
            gs 'FamilyFirstSexMarkUnderstood', $FamilyMorningAfterGirl, 'sandra'
        end

        if FamilyCorruptionStage < 4:
            FamilyTension += 3
            if FamilyTension > 100:
                FamilyTension = 100
            end
        end

    elseif $FamilyMorningAfterType = 'marathon':
        FamilyMorningMarathonTalkPending[$FamilyMorningAfterGirl] = 1
        love[$FamilyMorningAfterGirl] += 1
        otkroven[$FamilyMorningAfterGirl] += 1
        if FamilyCorruptionStage < 3:
            FamilyTension += 2
            if FamilyTension > 100:
                FamilyTension = 100
            end
        end
        gs 'ClampGirlSocialStats', $FamilyMorningAfterGirl

    elseif $FamilyMorningAfterType = 'no_finish':
        FamilyMorningNoFinishTalkPending[$FamilyMorningAfterGirl] = 1
        if FamilyCorruptionStage < 3:
            FamilyTension += 1
            if FamilyTension > 100:
                FamilyTension = 100
            end
        end

    elseif $FamilyMorningAfterType = 'happy_normal':
        Friends[$FamilyMorningAfterGirl] += 1
        gs 'ClampGirlSocialStats', $FamilyMorningAfterGirl
    end

    FamilyMorningAfterPending = 0
    $FamilyMorningAfterGirl = ''
    $FamilyMorningAfterWitness = ''
    $FamilyMorningAfterType = ''
    killvar '$MorningTitle2'

    gs 'ActUiPrepare', 'К утренним делам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        $MorningExitLoc = $FamilyMorningAfterReturnLoc
        killvar '$FamilyMorningAfterReturnLoc'
        gt $MorningExitLoc
    end
---

#FamilyFirstSexMarkUnderstood
    $UnderstoodObserver = $ARGS[0]
    $UnderstoodTarget = $ARGS[1]

    if $UnderstoodObserver = '' or $UnderstoodTarget = '':
        killvar '$UnderstoodObserver'
        killvar '$UnderstoodTarget'
        exit
    end

    if FamilyFirstSexMorningShown[$UnderstoodTarget] = 1 or ($UnderstoodTarget = 'amanda' and AmandaFirstSexMorningShown = 1):
        FamilyIntimUnderstood[$UnderstoodObserver, $UnderstoodTarget] = 1

        if $UnderstoodObserver = 'melissa' and $UnderstoodTarget = 'amanda':
            MelissaAmandaStefanUnderstood = 1
        elseif $UnderstoodObserver = 'sandra' and $UnderstoodTarget = 'amanda':
            SandraAmandaStefanUnderstood = 1
        end
    end

    killvar '$UnderstoodObserver'
    killvar '$UnderstoodTarget'
---

#AmandaFirstSexMarkMelissaUnderstood
    gs 'FamilyFirstSexMarkUnderstood', 'melissa', 'amanda'
    if MelissaHomeSex = 1 or HadSex['melissa'] > 0:
        gs 'FamilyFirstSexMarkUnderstood', 'amanda', 'melissa'
    end
---

#AmandaFirstSexMarkSandraUnderstood
    gs 'FamilyFirstSexMarkUnderstood', 'sandra', 'amanda'
    if SandraHomeSex = 1 or HadSex['sandra'] > 0:
        gs 'FamilyFirstSexMarkUnderstood', 'amanda', 'sandra'
    end
    if MelissaHomeSex = 1 or HadSex['melissa'] > 0:
        gs 'FamilyFirstSexMarkUnderstood', 'sandra', 'melissa'
        gs 'FamilyFirstSexMarkUnderstood', 'melissa', 'sandra'
    end
---

#FamilyFirstSexTalkCount
    gs 'NormalizeGirlKey', $ARGS[0]
    $CountGirl = $GirlKey
    FamilyFirstSexTalkAvailableCount = 0

    if $CountGirl = 'sandra':
        if FamilyFirstSexMorningShown['sandra'] = 1 and SandraFirstSexWorryTalkDone = 0 and FamilyCorruptionStage < 4:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if (GirlSuspectsFamilyIntim['sandra', 'amanda'] = 1 or GirlSuspectsAmandaStefan['sandra'] = 1) and SandraAmandaSuspicionTalkDone = 0 and SandraHomeSex = 0 and FamilyCorruptionStage < 4:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if GirlSuspectsFamilyIntim['sandra', 'melissa'] = 1 and SandraMelissaSuspicionTalkDone = 0 and SandraHomeSex = 0 and FamilyCorruptionStage < 4:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if (SandraAmandaStefanUnderstood = 1 or FamilyIntimUnderstood['sandra', 'amanda'] = 1) and SandraAmandaUnderstoodTalkDone = 0:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if FamilyIntimUnderstood['sandra', 'melissa'] = 1 and SandraMelissaUnderstoodTalkDone = 0:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if FamilyMorningMarathonTalkPending['sandra'] = 1:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if FamilyMorningNoFinishTalkPending['sandra'] = 1:
            FamilyFirstSexTalkAvailableCount += 1
        end

    elseif $CountGirl = 'melissa':
        if FamilyFirstSexMorningShown['melissa'] = 1 and MelissaFirstSexWorryTalkDone = 0 and FamilyCorruptionStage < 4:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if (GirlSuspectsFamilyIntim['melissa', 'amanda'] = 1 or GirlSuspectsAmandaStefan['melissa'] = 1) and MelissaAmandaTeaseDone = 0 and MelissaHomeSex = 0 and FamilyCorruptionStage < 4:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if GirlSuspectsFamilyIntim['melissa', 'sandra'] = 1 and MelissaSandraSuspicionTalkDone = 0 and MelissaHomeSex = 0 and FamilyCorruptionStage < 4:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if (MelissaAmandaStefanUnderstood = 1 or FamilyIntimUnderstood['melissa', 'amanda'] = 1) and MelissaAmandaUnderstoodTalkDone = 0:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if FamilyIntimUnderstood['melissa', 'sandra'] = 1 and MelissaSandraUnderstoodTalkDone = 0:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if FamilyMorningMarathonTalkPending['melissa'] = 1:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if FamilyMorningNoFinishTalkPending['melissa'] = 1:
            FamilyFirstSexTalkAvailableCount += 1
        end

    elseif $CountGirl = 'amanda':
        if (FamilyFirstSexMorningShown['amanda'] = 1 or AmandaFirstSexMorningShown = 1) and AmandaFirstSexAmandaWorryTalkDone = 0 and FamilyCorruptionStage < 4:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if GirlSuspectsFamilyIntim['amanda', 'melissa'] = 1 and AmandaMelissaSuspicionTalkDone = 0 and AmandaHomeFirstVaginalRegistered = 0 and FamilyCorruptionStage < 4:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if GirlSuspectsFamilyIntim['amanda', 'sandra'] = 1 and AmandaSandraSuspicionTalkDone = 0 and AmandaHomeFirstVaginalRegistered = 0 and FamilyCorruptionStage < 4:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if FamilyIntimUnderstood['amanda', 'melissa'] = 1 and AmandaMelissaUnderstoodTalkDone = 0:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if FamilyIntimUnderstood['amanda', 'sandra'] = 1 and AmandaSandraUnderstoodTalkDone = 0:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if FamilyMorningMarathonTalkPending['amanda'] = 1:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if FamilyMorningNoFinishTalkPending['amanda'] = 1:
            FamilyFirstSexTalkAvailableCount += 1
        end

        if AmandaAlleyPeeperTalkPending = 1:
            FamilyFirstSexTalkAvailableCount += 1
        end
    end

    killvar '$CountGirl'
---

#FamilyFirstSexTalkAddMenuItems
    gs 'NormalizeGirlKey', $ARGS[0]
    $MenuGirl = $GirlKey
    $MenuReturnLoc = $ARGS[1]

    if $MenuReturnLoc = '':
        $MenuReturnLoc = 'TavernMain'
    end

    if $MenuGirl = 'sandra':
        if FamilyFirstSexMorningShown['sandra'] = 1 and SandraFirstSexWorryTalkDone = 0 and FamilyCorruptionStage < 4:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* О том, не заметили ли дочери', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyFirstSexTalkStart', 'sandra', 'sandra', 'worry', $TalkReturnLoc
            }
        end

        if (GirlSuspectsFamilyIntim['sandra', 'amanda'] = 1 or GirlSuspectsAmandaStefan['sandra'] = 1) and SandraAmandaSuspicionTalkDone = 0 and SandraHomeSex = 0 and FamilyCorruptionStage < 4:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* О подозрениях насчёт Аманды', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyFirstSexTalkStart', 'sandra', 'amanda', 'suspicion', $TalkReturnLoc
            }
        end

        if GirlSuspectsFamilyIntim['sandra', 'melissa'] = 1 and SandraMelissaSuspicionTalkDone = 0 and SandraHomeSex = 0 and FamilyCorruptionStage < 4:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* О подозрениях насчёт Мелиссы', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyFirstSexTalkStart', 'sandra', 'melissa', 'suspicion', $TalkReturnLoc
            }
        end

        if (SandraAmandaStefanUnderstood = 1 or FamilyIntimUnderstood['sandra', 'amanda'] = 1) and SandraAmandaUnderstoodTalkDone = 0:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* О том утре с Амандой', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyFirstSexTalkStart', 'sandra', 'amanda', 'understood', $TalkReturnLoc
            }
        end

        if FamilyIntimUnderstood['sandra', 'melissa'] = 1 and SandraMelissaUnderstoodTalkDone = 0:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* О том утре с Мелиссой', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyFirstSexTalkStart', 'sandra', 'melissa', 'understood', $TalkReturnLoc
            }
        end

        if FamilyMorningMarathonTalkPending['sandra'] = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* О бурной ночи и усталости', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyFirstSexTalkStart', 'sandra', 'sandra', 'marathon_after', $TalkReturnLoc
            }
        end

        if FamilyMorningNoFinishTalkPending['sandra'] = 1:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* Загладить вину за прошлую ночь', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyFirstSexTalkStart', 'sandra', 'sandra', 'no_finish_apology', $TalkReturnLoc
            }
        end

    elseif $MenuGirl = 'melissa':
        if FamilyFirstSexMorningShown['melissa'] = 1 and MelissaFirstSexWorryTalkDone = 0 and FamilyCorruptionStage < 4:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* О том, не догадалась ли мама', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyFirstSexTalkStart', 'melissa', 'melissa', 'worry', $TalkReturnLoc
            }
        end

        if (GirlSuspectsFamilyIntim['melissa', 'amanda'] = 1 or GirlSuspectsAmandaStefan['melissa'] = 1) and MelissaAmandaTeaseDone = 0 and MelissaHomeSex = 0 and FamilyCorruptionStage < 4:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* О том утре на кухне', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyFirstSexTalkStart', 'melissa', 'amanda', 'suspicion', $TalkReturnLoc
            }
        end

        if GirlSuspectsFamilyIntim['melissa', 'sandra'] = 1 and MelissaSandraSuspicionTalkDone = 0 and MelissaHomeSex = 0 and FamilyCorruptionStage < 4:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* О подозрениях насчёт мамы', 'talk'
            gs 'Menu.AddModule', 'GirlTalkMainMenu', {
                gt 'FamilyFirstSexTalkStart', 'melissa', 'sandra', 'suspicion', $TalkReturnLoc
            }
        end

        if (MelissaAmandaStefanUnderstood = 1 or FamilyIntimUnderstood['melissa', 'amanda'] = 1) and MelissaAmandaUnderstoodTalkDone = 0:
            gs 'MenuUiAdd', 'GirlTalkMainMenu', '* О том утре с Амандой', 'talk'
