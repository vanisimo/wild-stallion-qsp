#AmandaCucumberBeckyShopEvent
    *clr
    clr
    cla

    if FamilyCorruptionStage >= 3 or sluttiness['amanda'] >= 50:
        $BeckyCucumberTone = 'bold'
        gs 'SceneShowVisual', 'images/events/amanda/home_anal/amanda_cucumber_becky_bold', 'АМАНДА В ЛАВКЕ БЕККИ: СМЕЛЫЙ ВЫБОР', 'large', 'webp'
    else:
        $BeckyCucumberTone = 'shy'
        gs 'SceneShowVisual', 'images/events/amanda/home_anal/amanda_cucumber_becky_shy', 'АМАНДА В ЛАВКЕ БЕККИ: СМУЩЕНИЕ', 'large', 'webp'
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ЛАВКА БЕККИ — НЕОБЫЧНАЯ ПОКУПКА'
    *pl '══════════════════════════════════════════════'
