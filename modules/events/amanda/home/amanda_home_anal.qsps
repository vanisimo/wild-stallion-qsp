    gs 'AmandaHomeAnalText', 'becky_shop', $BeckyCucumberTone
    *pl ' '

    AmandaHomeAnalStage = 2
    sluttiness['amanda'] += 1

    if $BeckyCucumberTone = 'bold':
        AmandaNpcPath += 1
    end

    killvar '$BeckyCucumberTone'
    gs 'ClampGirlSocialStats', 'amanda'

    gs 'ActUiPrepare', 'Остаться в лавке', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShop'
    end

    gs 'ActUiPrepare', 'Выйти на рынок', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
