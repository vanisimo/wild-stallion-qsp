#FamilyFirstSexMorningText
    $IntimGirl = $ARGS[0]
    $WitnessGirl = $ARGS[1]

    if $IntimGirl = '':
        $IntimGirl = 'amanda'
    end

    if $WitnessGirl = '':
        $WitnessGirl = 'sandra'
    end

    if $IntimGirl = 'amanda':
        *pl 'Ранний серый свет едва пробивается сквозь ставни, рисуя тусклые полосы на грубых половицах. Ты просыпаешься первым. Рядом, подбившись под край одеяла, безмятежно спит Аманда — одна рука закинута за голову, на губах блуждает лёгкая, сонная улыбка.'
        *pl 'Спускаясь по скрипучей лестнице в жилую часть, ты всё ещё ощущаешь на себе тепло этой ночи, запах сушёной лаванды и лёгкую неловкость.'

        if $WitnessGirl = 'sandra':
            *pl 'На кухне уже хлопочет Сандра. Глиняный кувшин звонко стукается о край котла. Стоит Аманде спуститься следом за тобой — с раскрасневшимися щеками и второпях застёгнутым воротом платья, — как половник в руках матери замирает.'
            *pl 'Сандра медленно оборачивается. Её взгляд — тяжёлый, пристальный, изучающий — медленно скользит от тебя к младшей дочери. Она не повышает голоса, но воздух на кухне мгновенно густеет.'
            *pl '— Что-то вы оба сегодня… больно тихие, — ровно произносит она, вытирая руки о фартук. — И глаза друг на друга не поднимаете. Не иначе как полночи секретами делились?'
            *pl 'Аманда вспыхивает до самых корней волос, торопливо хватается за кружку и опускает глаза, пряча смущение.'
        else
            *pl 'В коридоре возле кладовой навстречу выходит Мелисса с толстой гроссбух-книгой и связкой перьев. Она уже собрана, затянута в корсаж и строга, как монастырский писец.'
            *pl 'Проходя мимо, она вдруг притормаживает, втягивает носом воздух и бросает на вас двоих острый, цепкий взгляд. На её губах появляется ехидная, понимающая усмешка.'
            *pl '— Какое трогательное согласие в семье с самого утра, — негромко шепчет Мелисса, наклоняясь ближе, чтобы слышали только вы. — Аманда, воротник поправь. След на шее никакой шалью не скроешь, если стоять прямо у окна.'
            *pl 'Аманда испуганно закрывает ладонью шею и толкает тебя локтем, сгорая от стыда.'
        end

    elseif $IntimGirl = 'melissa':
        *pl 'Утро наступает непривычно тихо. Мелисса, обычно встающая с первыми петухами, медлит под теплым одеялом, прижимаясь щекой к твоей руке. В её глазах сквозит непривычная мягкость, сменившая привычную книжную строгость.'
        *pl 'Когда вы спускаетесь вниз, стараясь не скрипеть половицами, в трактире уже начинается утренний распорядок.'

        if $WitnessGirl = 'sandra':
            *pl 'Сандра, растапливающая печь, оборачивается на шаги. Увидев вас вместе — Мелиссу с чуть растрёпанными волосами и тебя, замершего в дверном проёме, — мать медленно опускает кочергу.'
            *pl 'Её брови сдвигаются. Она молчит несколько долгих мгновений, но в этом молчании читается больше тревоги, чем в любом крике.'
            *pl '— Мелисса, ты сегодня припозднилась, — медленно говорит Сандра. — Я думала, книги читала. А вид у тебя такой, будто тяжести всю ночь носила.'
            *pl 'Мелисса старается держать осанку, но предательский румянец выдаёт её с головой.'
        else
            *pl 'Из кухни выскакивает Аманда с подносом. Увидев вас, она замирает на месте и широко распахивает глаза.'
            *pl '— Ой... — вырывается у неё. Она переводит взгляд с тебя на старшую сестру, подмечая каждую мелочь: и непривычно мягкий взгляд Мелиссы, и то, как вы держитесь рядом.'
            *pl '— Мелисса... ты? — шепчет Аманда с недоверием и внезапной затаённой ревностью в голосе.'
        end

    elseif $IntimGirl = 'sandra':
        *pl 'С первыми лучами солнца в комнате разливается тепло. Сандра тихо лежит рядом, бережно укрыв твоё плечо краем одеяла. В её лице смешались глубокая нежность, материнская вина и смирение перед запретным чувством.'
        *pl '— Надо вставать, Стефан... — шепчет она, тяжело вздыхая. — Девочки скоро спустятся. Ильматер всеблагой, если они увидят...'

        if $WitnessGirl = 'melissa':
            *pl 'Когда вы спускаетесь на кухню, Мелисса уже сидит за столом, обмакивая перо в чернильницу. Она поднимает глаза от пергамента.'
            *pl 'Её внимательный, испытующий взгляд моментально ловит перемену: как осторожно Сандра завязывает фартук, как избегает встречаться с тобой взглядом, как дрожат её пальцы.'
            *pl 'Мелисса медленно откладывает перо. В её взгляде нет злобы, но холодный расчёт и ошеломление видны без всяких слов.'
        else
            *pl 'Аманда напевает что-то в углу, протирая столешницу. При вашем появлении песня обрывается.'
            *pl 'Младшая сестра с удивлением смотрит на мать, чьи щёки непривычно горят, а затем переводит взгляд на тебя.'
            *pl '— Мам, ты заболела? — наивно спрашивает Аманда. — Ты вся какая-то... странная.'
            *pl 'Сандра торопливо отворачивается к котлу, пряча смущение.'
        end
    end

    $AmandaHomeText = 'Утреннее напряжение повисает в воздухе дома.'

    killvar '$IntimGirl'
    killvar '$WitnessGirl'
---

#AmandaFirstSexMorningText
    gs 'FamilyFirstSexMorningText', 'amanda', $AmandaFirstSexMorningWitness
---

#FamilyFirstSexTalkIntroText
    $TalkGirl = $ARGS[0]
    $TargetGirl = $ARGS[1]
    $TalkMode = $ARGS[2]

    if $TalkGirl = 'sandra' and $TalkMode = 'suspicion':
        *pl 'Сандра откладывает деревянный половник в сторону, тщательно вытирает руки чистым полотенцем и поворачивается к тебе. На её лице нет гнева, но в глазах застыла тяжёлая, материнская тревога.'
        *pl 'Она делает знак подойти ближе и говорит негромко, чтобы звук не долетал до зала:'
        *pl '— Я не слепая, Стефан. И не глухая. То, как вы с ' + $RealName[$TargetGirl] + ' держитесь в последнее время... этот воздух в доме. Я слишком хорошо знаю жизнь, чтобы принимать это за простую усталость.'
        *pl 'Она делает паузу, вглядываясь в твоё лицо:'
        *pl '— Наш дом и так держится на волоске. Если по городу пойдут слухи — нас с лица земли сотрут. Скажи мне прямо, Стефан: мне стоит бояться за наш очаг?'

    elseif $TalkGirl = 'melissa' and $TalkMode = 'suspicion':
        *pl 'Мелисса перехватывает тебя в тихом уголке возле винного погреба, держа под мышкой конторскую книгу. На её губах играет тонкая, язвительная усмешка, но в карих глазах светится неподдельный интерес.'
        *pl '— Ну что, хозяин трактира, — говорит она тихо, с лёгким смешком. — Думаешь, ваши ночные тайны так надёжно спрятаны за старыми дверями? Трактирный шум заглушает звон кружек, но не выдаёт то, что происходит прямо над залом.'
        *pl 'Она делает шаг ближе, наклоняя голову:'
        *pl '— У ' + $RealName[$TargetGirl] + ' с утра глаза блестят, как у кошки, дорвавшейся до сливок. А ты ходишь гоголем. Считать и сопоставлять факты я умею получше всех в этом доме. Что скажешь в своё оправдание?'

    elseif $TalkGirl = 'amanda' and $TalkMode = 'worry':
        *pl 'Аманда ловит тебя за рукав в полутёмном переходе за лестницей и тревожно тянет в сторону. Её щёки слегка алеют, а в глазах плещется паника пополам с волнением.'
        *pl '— Стефан... — шепчет она, торопливо оглядываясь по сторонам. — Ты видел, как мама на нас смотрела за завтраком? А Мелисса так и норовит что-то съязвить! Мне кажется, они обо всём догадались!'
        *pl 'Она нервно прикусывает нижнюю губу и заглядывает тебе в глаза:'
        *pl '— Что нам делать? Если в трактире или в городе узнают... я даже думать об этом боюсь! Скажи, что всё будет в порядке?'

    elseif $TalkGirl = 'sandra' and $TalkMode = 'understood':
        *pl 'Сандра садится на лавку напротив тебя. В трактире тихо — все дела на кухне завершены. Лицо матери спокойно, но во взгляде читается глубокая горечь пополам с нежностью.'
        *pl '— Теперь я понимаю... то утро, — произносит она едва слышно. — Когда вы с ' + $RealName[$TargetGirl] + ' спустились вниз. Я тогда чувствовала сердцем, но боялась даже мысль такую впустить.'
        *pl 'Она качает головой и кладёт тёплую ладонь поверх твоей руки:'
        *pl '— Ильматер свидетель, я хотела сохранить дом чистым. Но теперь, когда я сама... перед тобой беззащитна, я не смею никого судить. Только прошу тебя: береги сестёр. Что бы ни случилось, мы должны держаться вместе.'

    elseif $TalkGirl = 'melissa' and $TalkMode = 'understood':
        *pl 'Мелисса закрывает книгу учёта, аккуратно складывает пальцы в замок и долго смотрит на тебя с тихой, чуть усталой улыбкой.'
        *pl '— Знаешь, Стефан... я ведь вспомнила то утро, когда вы с ' + $RealName[$TargetGirl] + ' спустились на кухню. Я тогда насмехалась, думала, что поймала вас на глупости.'
        *pl 'Она тихо вздыхает и отводит взгляд в сторону:'
        *pl '— А теперь, когда между нами произошло то же самое... вся моя книжная спесь улетучилась. Мы теперь повязаны одним секретом, братец. Только маме не давай повода — она и так всё нутром чует.'

    elseif $TalkGirl = 'amanda' and $TalkMode = 'understood':
        *pl 'Аманда мягко подходит к тебе со спины и осторожно кладёт подбородок на твоё плечо.'
        *pl '— Стефан... я ведь знаю про тебя и ' + $RealName[$TargetGirl] + ', — шепчет она на ухо. — Раньше я бы, наверное, разозлилась или разревелась. А сейчас... понимаю.'
        *pl 'Она чуть крепче сжимает твои плечи:'
        *pl '— Наша семья уже совсем не такая, как у других. Но мне кажется, мы стали только ближе. Главное — никому чужому об этом не знать.'
    end

    killvar '$TalkGirl'
    killvar '$TargetGirl'
    killvar '$TalkMode'
---

#FamilyFirstSexTalkChoiceText
    $TalkGirl = $ARGS[0]
    $TargetGirl = $ARGS[1]
    $TalkMode = $ARGS[2]
    $Choice = $ARGS[3]

    if $TalkGirl = 'sandra' and $TalkMode = 'suspicion':
        if $Choice = 'deny':
            *pl 'Ты небрежно пожимаешь плечами и говоришь, что Сандра ищет тайны на пустом месте: просто тяжелая смена, усталость и духота в комнатах.'
            *pl 'Сандра смотрит на тебя долго, не мигая. Её губы сжимаются в тонкую полоску.'
            *pl '— Не держи меня за дуру, Стефан, — сухо отвечает она. — Я пока промолчу. Но помни: этот дом держится на том, что мы соблюдаем приличия перед людьми и перед Ильматером. Если я увижу лишнее снова — разговор будет другим.'
        elseif $Choice = 'calm':
            *pl 'Ты спокойно и твёрдо берёшь Сандру за плечи, глядя прямо ей в глаза. Ты говоришь, что дом и семья для тебя — святое, и ты никогда не позволишь ни слухам, ни беде коснуться их очага.'
            *pl 'Тяжёлое напряжение медленно покидает плечи матери. Она глубоко выдыхает, опуская веки.'
            *pl '— Хорошо, — шепчет она с облегчением. — Я верю тебе, Стефан. Мне больше некому верить в этом мире. Только будь осторожен... ради всех нас.'
        else
            *pl 'Ты торопливо переводишь разговор на запасы муки, цену на солонину и вечерний приток гостей из порта. Сандра внимательно слушает твою суету.'
            *pl 'Она не спорит, но в её глазах остаётся тень недоверия.'
            *pl '— Делай своё дело, трактирщик, — ровно говорит она. — Но не забывай: от твоих поступков зависит не только выручка, но и судьба девушек.'
        end

    elseif $TalkGirl = 'melissa' and $TalkMode = 'suspicion':
        if $Choice = 'banter':
            *pl 'Ты усмехаешься и парируешь её выпад: мол, считать она умеет отлично, только вот за руку никого не ловила, а чужие спальни её книжному уму покоя не дают.'
            *pl 'Мелисса закатывает глаза, но уголки её губ вздрагивают в искренней, лукавой улыбке.'
            *pl '— Остроумие прямо через край, братец, — фыркает она, поправляя перья. — Но если не хочешь, чтобы мама устроила нам допрос с пристрастием, умерь свой хозяйский пыл. И воротники проверяй почаще.'
        elseif $Choice = 'discretion':
            *pl 'Ты серьёзно смотришь на сестру и просишь её проявить благоразумие: в доме и так тяжело, и лишняя смута разрушит хрупкий мир между всеми.'
            *pl 'Мелисса умолкает. Ирония сходит с её лица, уступая место собранности.'
            *pl '— Я не болтушка с базара, Стефан, — негромко отвечает она. — Понимаю не хуже тебя. Разносить слухи я не стану. Но не забывай, кто в этой семье вовремя замечает беду.'
        else
            *pl 'Ты холодно обрываешь её, заявляя, что не обязан отчитываться перед младшей сестрой о том, как и с кем проводишь ночи.'
            *pl 'В глазах Мелиссы вспыхивает холодная обида. Она демонстративно захлопывает книгу.'
            *pl '— Вот как, — с ледяной вежливостью роняет она. — Что ж, хозяин-барин. Только помни: когда дом начнёт трещать по швам, не приходи ко мне за советом.'
        end

    elseif $TalkGirl = 'amanda' and $TalkMode = 'worry':
        if $Choice = 'reassure':
            *pl 'Ты осторожно обнимаешь Аманду за плечи, привлекая к себе, и мягко шепчешь, что никто ничего не докажет, а ты никому не дашь её в обиду.'
            *pl 'Аманда на мгновение прижимается щекой к твоей груди, судорожно выдыхает и улыбается с робкой благодарностью.'
            *pl '— Спасибо, Стефан... — шепчет она, поднимая сияющие глаза. — С тобой мне правда ничего не страшно. Я постараюсь не глупить.'
        else
            *pl 'Ты строго напоминаешь ей, что сейчас не время для паники: нужно вести себя как обычно, не отлынивать от работы и не давать поводов для сплетен.'
            *pl 'Аманда вздрагивает, быстро вытирает уголок глаза и дисциплинированно кивает.'
            *pl '— Я поняла, Стефан. Буду держаться смирно. Никто ничего не заметит, обещаю.'
        end
    end

    killvar '$TalkGirl'
    killvar '$TargetGirl'
    killvar '$TalkMode'
    killvar '$Choice'
