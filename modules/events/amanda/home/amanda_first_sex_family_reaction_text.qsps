#FamilyMorningAfterScreen1Text
    $TargetGirl = $ARGS[0]
    $WitnessGirl = $ARGS[1]
    $EventType = $ARGS[2]

    if $TargetGirl = '':
        $TargetGirl = 'amanda'
    end
    if $WitnessGirl = '':
        $WitnessGirl = 'sandra'
    end
    if $EventType = '':
        $EventType = 'first_sex'
    end

    if $EventType = 'first_sex':
        if $WitnessGirl = 'sandra':
            *pl 'Ты спускаешься вниз на рассвете. Сандра уже стоит у очага, перетирает полотенцем глиняную миску и встречает тебя пристальным взглядом.'
            if FamilyCorruptionStage >= 4:
                *pl 'Она замечает твоё приподнятое настроение, качает головой и переводит взгляд на лестницу:'
                *pl '— Рано ты сегодня поднялся, хозяин. И шаги наверху всю ночь раздавались не в одной спальне. Посмотрим, с каким лицом сейчас спустится ' + $RealName[$TargetGirl] + '.'
            elseif FamilyCorruptionStage >= 2:
                *pl 'Сандра откладывает полотенце на край стола и хмурит брови, прислушиваясь к шагам на верхней площадке:'
                *pl '— Половицы ночью скрипели над самым залом, Стефан. Ты думаешь, материнское ухо не отличит сквозняк от чужих шагов у двери спальни?'
            else
                *pl 'Лицо Сандры сразу становится строгим. Она ставит миску на полку и негромко произносит, глядя тебе прямо в глаза:'
                *pl '— Стефан, что за хождения были ночью по второму этажу? Я слышала, как открывалась дверь у спальни, где спит ' + $RealName[$TargetGirl] + '. Видит Ильматер, мне не нравятся такие секреты под нашей крышей.'
            end
        elseif $WitnessGirl = 'melissa':
            *pl 'Внизу у конторки уже сидит Мелисса, раскладывая листы учёта. Когда ты спускаешься со второго этажа, она медленно поднимает голову.'
            if FamilyCorruptionStage >= 4:
                *pl 'На её губах появляется откровенная усмешка. Она постукивает пером по крышке чернильницы:'
                *pl '— Ну надо же, какие ранние пташки. А судя по ночному шороху за стеной, вы с ' + $RealName[$TargetGirl] + ' времени даром не теряли.'
            elseif FamilyCorruptionStage >= 2:
                *pl 'Мелисса прищуривается, оглядывая твой расстёгнутый ворот и слегка растрёпанные волосы:'
                *pl '— Любопытная арифметика получается, братец. Ночью скрипит одна дверь, а утром вы спускаетесь друг за другом с самым невинным видом.'
            else
                *pl 'Мелисса откладывает перо, поправляет манжету и смеривает тебя цепким, подозрительным взглядом:'
                *pl '— Ты сегодня странно держишься, Стефан. И ночью в коридоре было слишком много шороха возле двери ' + $RealName[$TargetGirl] + '. Уж не решил ли ты завести в доме тайные порядки?'
            end
        else
            *pl 'У лестницы тебе попадается Аманда. Она протирает край стойки, но при твоём появлении тут же замирает и складывает руки на груди.'
            if FamilyCorruptionStage >= 4:
                *pl 'Она хитро прищуривается и кивает в сторону второго этажа:'
                *pl '— А я всё слышала, братик! Думаешь, не заметила, к кому ты ночью проскользнул в спальню?'
            else
                *pl 'Аманда с любопытством и ревнивым прищуром переводит взгляд с тебя на верхнюю площадку лестницы:'
                *pl '— Постой-ка, Стефан... А чего это ты ночью не в своей комнате спал? Я слышала голоса за стеной, где была ' + $RealName[$TargetGirl] + '!'
            end
        end

    elseif $EventType = 'marathon':
        if $WitnessGirl = 'sandra':
            *pl 'Едва ты входишь, Сандра с глухим стуком ставит тяжёлый чугунок на плиту и поворачивается к тебе, уперев руки в бока.'
            if FamilyCorruptionStage >= 4:
                *pl 'На её лице усталость пополам с насмешливым укором:'
                *pl '— Имейте совесть, Стефан! Пол-ночи кто-то стонал за стеной и тряс кровать так, что со потолка побелка сыпалась. Даже мне глаз сомкнуть не дали.'
            else
                *pl 'Под глазами матери залегли тени от недосыпа. Она строго сдвигает брови и качает головой:'
                *pl '— Ради Ильматера, что за грохот стоял ночью наверху? Половицы трещали, кто-то вскрикивал в подушку до самого рассвета! Мне утром у печи стоять, а в доме спать невозможно!'
            end
            *pl 'В этот момент на лестнице раздаются медленные, осторожные шаги — вниз спускается ' + $RealName[$TargetGirl] + ', придерживаясь ладонью за перила.'
            *pl 'Сандра прищуривается, глядя на её походку:'
            *pl '— Гляньте-ка на неё. А чего это ты с утра так странно враскоряку идёшь, будто мешки с мукой всю ночь таскала?'
        elseif $WitnessGirl = 'melissa':
            *pl 'Мелисса сидит за столом, подперев щёку кулаком, и демонстративно зевает, прикрывая рот ладонью.'
            if FamilyCorruptionStage >= 4:
                *pl 'Увидев тебя, она закатывает глаза и язвительно усмехается:'
                *pl '— Поздравляю с личным рекордом, хозяин. Такого скрипа кровати и сдавленных криков на втором этаже этот трактир ещё не знал.'
            else
                *pl 'Она раздражённо захлопывает тетрадь и смотрит на тебя с укоризной:'
                *pl '— Очень мило, Стефан. Кто-то пол-ночи кричал и бился изголовьем о стену, а мне теперь с больной головой сводить утренние счета!'
            end
            *pl 'Сверху осторожно спускается ' + $RealName[$TargetGirl] + '. Каждая ступенька даётся ей с трудом, колени заметно дрожат.'
            *pl 'Мелисса наклоняет голову набок и громко хмыкает:'
            *pl '— О, а вот и виновница ночного землетрясения. И чего это мы так странно шагаем враскоряку, держась за стенку?'
        else
            *pl 'Аманда стоит у окна, потирая сонные глаза, и при виде тебя недовольно надувает губы.'
            if FamilyCorruptionStage >= 4:
                *pl 'Она лукаво грозит тебе пальцем, хотя голос звучит сонно:'
                *pl '— Ну вы даёте, Стефан! Пол-ночи охали да стонали за перегородкой, я чуть с постели от зависти и шума не свалилась!'
            else
                *pl 'Она сердито топнула ногой и скрестила руки на груди:'
                *pl '— Между прочим, некоторые ночью спать пытались! Кто там так громко кричал за стеной и скрипел досками до третьих петухов?'
            end
            *pl 'Тут в проёме двери появляется ' + $RealName[$TargetGirl] + ', ступая непривычно широко и морщась при каждом шаге.'
            *pl 'Аманда тут же округляет глаза и прыскает в кулачок:'
            *pl '— Ой! А чего это ты сегодня так странно враскоряку ходишь, словно верхом без седла скакала?'
        end

    elseif $EventType = 'no_finish':
        if $WitnessGirl = 'sandra':
            *pl 'Утро начинается с резкого звона посуды. Сандра оборачивается от стола и с недоумением смотрит в угол, где ' + $RealName[$TargetGirl] + ' сердито швыряет деревянные ложки в ящик.'
            *pl 'Мать переводит взгляд на тебя и пожимает плечами:'
            *pl '— Что это за грозовая туча у нас с утра пораньше? Ходит мрачная, кувшинами стучит, на слова огрызается. Уж не ты ли её чем обидел, Стефан?'
            *pl 'Закончив с тестом, Сандра уходит в кладовую за мукой, оставляя вас вдвоём.'
        elseif $WitnessGirl = 'melissa':
            *pl 'Мелисса сидит на краю лавки и с ироничным любопытством наблюдает, как ' + $RealName[$TargetGirl] + ' резкими движениями протирает стол, едва не сбивая кружки.'
            *pl 'Поймав твой взгляд, Мелисса негромко хмыкает:'
            *pl '— Кажется, кто-то сегодня встал явно не с той ноги. Искры во все стороны летят, того и гляди занавески вспыхнут. Разбирайся сам со своим персоналом, хозяин.'
            *pl 'Подхватив гроссбух, Мелисса благоразумно отходит к дальнему окну.'
        else
            *pl 'Аманда с опаской косится на то, как ' + $RealName[$TargetGirl] + ' с силой захлопывает дверцу буфета, и тихонько машет тебе рукой:'
            *pl '— Стефан, ты только погляди на неё... С самого рассвета злющая, кусается на каждое слово! Пойду-ка я лучше подальше, пока под горячую руку не попала.'
            *pl 'Аманда быстро выскальзывает за дверь, оставляя тебя наедине с недовольной девушкой.'
        end

    else
        if $WitnessGirl = 'sandra':
            *pl 'Утренний свет падает на чистые столы. Сандра разливает тёплый отвар по кружкам и вдруг останавливается, удивлённо разглядывая ' + $RealName[$TargetGirl] + '.'
            *pl 'Мать качает головой и обращается к тебе с лёгкой улыбкой:'
            *pl '— Ты только посмотри на неё, Стефан. С самого рассвета вся светится, напевает себе под нос, глаза горят, будто ей сундук серебра подарили. Что это за праздник посреди рабочей недели?'
        elseif $WitnessGirl = 'melissa':
            *pl 'Мелисса поднимает глаза от бумаг и с прищуром следит за тем, как ' + $RealName[$TargetGirl] + ' легко кружится у стойки, поправляя волосы.'
            *pl 'Повернувшись к тебе, Мелисса иронично приподнимает бровь:'
            *pl '— Подозрительное зрелище, братец. Работы в трактире невпроворот, а кое-кто с утра вся светится от радости и улыбается пустому углу. Интересно, чья это заслуга?'
        else
            *pl 'Аманда ставит поднос на стойку, подпирает щёки ладонями и во все глаза разглядывает ' + $RealName[$TargetGirl] + '.'
            *pl 'Она звонко хихикает и толкает тебя локтем:'
            *pl '— Стефан, ты видишь? Она же с утра вся светится, как начищенный медный таз! Румяная, довольная, улыбку спрятать не может!'
        end
    end

    killvar '$TargetGirl'
    killvar '$WitnessGirl'
    killvar '$EventType'
---

#FamilyMorningAfterScreen2Text
    $TargetGirl = $ARGS[0]
    $WitnessGirl = $ARGS[1]
    $EventType = $ARGS[2]

    if $TargetGirl = '':
        $TargetGirl = 'amanda'
    end
    if $WitnessGirl = '':
        $WitnessGirl = 'sandra'
    end
    if $EventType = '':
        $EventType = 'first_sex'
    end

    if $EventType = 'first_sex':
        if $TargetGirl = 'amanda':
            *pl 'Аманда спускается с последней ступеньки, на ходу приглаживая юбку. Поймав на себе цепкий взгляд ' + $RealName[$WitnessGirl] + ' и увидев тебя рядом, она мгновенно вспыхивает до корней волос.'
            if FamilyCorruptionStage >= 4:
                *pl 'Однако смущение длится всего секунду. Аманда потягивается, ничуть не скрывая довольной улыбки, и стреляет в тебя блестящими глазами:'
                *pl '— Просто кровать у меня скрипучая, вот и ворочалась! — беспечно бросает она и, проходя мимо тебя, тайком проводит ладонью по твоему поясу.'
            elseif FamilyCorruptionStage >= 2:
                *pl 'Аманда прикусывает губу, торопливо отводит глаза от ' + $RealName[$WitnessGirl] + ' и принимается перебирать чистые тарелки:'
                *pl '— Мне просто душно было ночью, я окно открывала! — звонко оправдывается она, но, когда ' + $RealName[$WitnessGirl] + ' отворачивается, дарит тебе быстрый, горячий взгляд.'
            else
                *pl 'Пальцы Аманды мелко дрожат. Она низко опускает голову, пряча алые щёки, и торопливо бормочет:'
                *pl '— Я... я просто воды хотела попить ночью и оступилась в темноте. Ничего такого не было!'
                *pl 'Она бросает на тебя короткий, испуганный взгляд, словно умоляя поддержать её неловкую выдумку.'
            end
        elseif $TargetGirl = 'melissa':
            *pl 'Мелисса входит следом, крепко прижимая к груди стопку бумаг. Под пристальным взглядом ' + $RealName[$WitnessGirl] + ' на её скулах проступает непривычный румянец.'
            if FamilyCorruptionStage >= 4:
                *pl 'Она быстро берёт себя в руки, поправляет воротник и отвечает с лёгкой полуулыбкой:'
                *pl '— Мы со Стефаном обсуждали ночной баланс трактира. И должна признать, сошёлся он просто великолепно.'
            elseif FamilyCorruptionStage >= 2:
                *pl 'Мелисса сухо кашляет в кулак, поправляет причёску и произносит максимально деловым тоном:'
                *pl '— Мне понадобилась старая книга податей с верхней полки, вот половицы и скрипели. Не ищите заговоров там, где их нет.'
                *pl 'Когда ' + $RealName[$WitnessGirl] + ' отходит, Мелисса выразительно смотрит на тебя и едва заметно качает головой.'
            else
                *pl 'Обычно находчивая Мелисса вдруг теряется, роняет уголок пергамента и торопливо подхватывает его со стола:'
                *pl '— Я... просто долго не могла уснуть из-за отчётов и выходила в коридор. Всё в полном порядке.'
                *pl 'Её взгляд скользит по твоему лицу с немым вопросом: неужели дома уже догадались?'
            end
        else
            *pl 'Сандра на мгновение замирает у стола, встречаясь взглядом с дочерью, и машинально поправляет выбившийся локон у виска.'
            if FamilyCorruptionStage >= 4:
                *pl 'Она спокойно выдерживает паузу и с тёплой, хозяйской усмешкой смотрит на тебя:'
                *pl '— В моём доме я сама решаю, когда мне спать, а когда со старшим мужчиной дела обсуждать. За работу, нечего глазами хлопать.'
            elseif FamilyCorruptionStage >= 2:
                *pl 'Лёгкая краска трогает её щёки. Сандра быстро берёт нож для хлеба и строго обрезает расспросы:'
                *pl '— Половицы старые, от каждого шага гудят. Мне нужно было проверить замки и поговорить со Стефаном.'
                *pl 'Украдкой она бросает на тебя долгий, смущённый и нежный взгляд.'
            else
                *pl 'Сандра заметно тушуется перед собственной дочерью, торопливо отворачивается к полкам с крупой и глухо говорит:'
                *pl '— Голова с вечера разболелась, вот и ходила за травяным сбором. Хватит пустых разговоров, несите воду.'
                *pl 'Её плечи напряжены, и по тому, как она избегает смотреть при дочери в твою сторону, видно, как сильно её волнует эта тайна.'
            end
        end

    elseif $EventType = 'marathon':
        if $TargetGirl = 'amanda':
            *pl 'Аманда густо краснеет от ушей до самой шеи. Она осторожно опускается на лавку, тихонько ойкнув, когда бёдра касаются жёсткого дерева, и пытается сохранить невозмутимый вид.'
            if FamilyCorruptionStage >= 4:
                *pl 'Поймав твой взгляд, она бесстыдно облизывает губы и отвечает во всеуслышание:'
                *pl '— Между прочим, у меня после ночной разминки все мышцы гудят! Не у всех же хватает сил на нашего хозяина, вот ножки и не слушаются!'
            elseif FamilyCorruptionStage >= 2:
                *pl 'Она сердито взмахивает ресницами, потирая поясницу, и торопливо выдумывает на ходу:'
                *pl '— Ничего я не враскоряку! Просто ногу под одеялом свело под утро и на лестнице оступилась! А скрипело... это ветер ставню качал!'
                *pl 'Стоит ' + $RealName[$WitnessGirl] + ' отвернуться, как Аманда грозит тебе кулачком и одними губами шепчет: «Изверг ненасытный!»'
            else
                *pl 'Аманда вжимает голову в плечи, крепко сжимая край передника, и лепечет сдавленным голосом:'
                *pl '— Я вчера в погребе бочонок двигала и спину потянула... а ночью мне кошмар приснился, вот я и вскрикнула во сне!'
                *pl 'Она смотрит на тебя сквозь опущенные ресницы — совершенно измотанная, смущённая, но до краёв полная вчерашним жаром.'
            end
        elseif $TargetGirl = 'melissa':
            *pl 'Мелисса медленно подходит к конторке, стараясь держать спину идеально прямо, хотя каждый шаг отзывается лёгкой дрожью в коленях.'
            if FamilyCorruptionStage >= 4:
                *pl 'Она подкладывает мягкую подушку на табурет, садится с тихим стоном облегчения и насмешливо косится на тебя:'
                *pl '— Просто кое-кто не знает чувства меры в практических занятиях. Ещё одна такая ночь, Стефан, и отчёты ты будешь носить мне прямо в постель.'
            elseif FamilyCorruptionStage >= 2:
                *pl 'Пунцовый румянец заливает её щёки. Мелисса высоко вскидывает подбородок и чеканит слова:'
                *pl '— Я просто засиделась в неудобной позе за бумагами, оттого и мышцы затекли. А ночной шум — следствие рассохшихся балок перекрытия.'
                *pl 'Но как только ' + $RealName[$WitnessGirl] + ' отходит, Мелисса устало прикрывает глаза и выдыхает тебе: «У меня до сих пор всё внутри дрожит из-за тебя...»'
            else
                *pl 'Мелисса нервно кусает губу, опираясь рукой о край стола, чтобы не пошатнуться:'
                *pl '— Я оступилась на верхней ступеньке в потёмках и ушибла бедро. И вовсе незачем устраивать из этого утренний допрос.'
                *pl 'Она бросает на тебя быстрый взгляд, в котором книжная строгость окончательно капитулировала перед полной физической истомой.'
            end
        else
            *pl 'Сандра медленно подходит к столу, придерживаясь рукой за поясницу, и тяжело опирается ладонями о столешницу.'
            if FamilyCorruptionStage >= 4:
                *pl 'Она переводит дух, ничуть не стесняясь утомлённого блеска в глазах, и усмехается уголком губ:'
                *pl '— Посмотрела бы я на вас, если бы вас до рассвета так в оборот взяли, что ни вздохнуть, ни повернуться. Налейте матери воды, ноги совсем не держат.'
            elseif FamilyCorruptionStage >= 2:
                *pl 'Щёки Сандры горят румянцем. Она сердито поправляет платок на плечах и отмахивается от расспросов:'
                *pl '— Поясницу у печи прихватило, вот и ступаю осторожно! А ночью ставня на чердаке билась, давно пора петли смазать!'
                *pl 'Встретившись с тобой глазами, она беспомощно качает головой, словно признавая, что ты выжал из неё все силы до последней капли.'
            else
                *pl 'Сандра низко наклоняется над котлом, пряча вспыхнувшее лицо от дочери, и глухо произносит:'
                *pl '— Ноги к непогоде крутит, всю ночь проворочалась без сна. Не выдумывайте глупостей и беритесь за метлу.'
                *pl 'Когда дочь отворачивается, Сандра тяжело выдыхает и бросает на тебя долгий, укоризненно-ласковый взгляд.'
            end
        end

    elseif $EventType = 'no_finish':
        if $TargetGirl = 'amanda':
            *pl 'Едва шаги ' + $RealName[$WitnessGirl] + ' стихают за дверью, Аманда резко поворачивается к тебе, скрестив руки на груди и гневно сверкая глазами:'
            *pl '— И не смотри на меня так, Стефан! — горячо шепчет она, подходя вплотную. — Что-то ты вчера ночью был совсем не в форме! Раздразнил меня до дрожи, распалил, а сам на полпути остановился!'
            *pl 'Она обиженно надувает губы и толкает тебя ладонью в грудь:'
            *pl '— Я потом до самого утра в подушку кусалась и уснуть не могла! Если взялся за девушку, хозяин, так доводи дело до конца!'
        elseif $TargetGirl = 'melissa':
            *pl 'Оставшись с тобой наедине, Мелисса откладывает тряпку и смеривает тебя холодным, пронзительным взглядом:'
            *pl '— Надеюсь, ты доволен результатом, Стефан, — вполголоса чеканит она, и на её скулах играют сердитые пятна румянца. — Что-то ты вчера был совершенно не в форме. Столько громких намёков, столько жара в начале — и такой бесславный финал на полдороге.'
            *pl 'Она раздражённо поправляет ворот платья:'
            *pl '— Оставить женщину на самом краю и уйти спать — это верх дурного тона. В следующий раз потрудись рассчитать свои силы заранее.'
        else
            *pl 'Когда вы остаётесь одни, Сандра медленно подходит к тебе и останавливается в шаге, качая головой с горьковатым упрёком:'
            *pl '— Эх, Стефан... — тихо произносит она, глядя тебе в глаза. — Что-то ты вчера был совсем не в форме, родной. Разбудил во мне такой огонь, заставил забыть обо всём на свете — и оставил ни с чем на самом пике.'
            *pl 'Она проводит ладонью по своему горячему лицу и вздыхает:'
            *pl '— Я ведь живая женщина, а не камень. Всю ночь потом металась на простынях. Не делай так больше со мной.'
        end

    else
        if $TargetGirl = 'amanda':
            *pl 'Аманда звонко смеётся, кружась с подносом в руках, и её щёки розовеют от удовольствия:'
            *pl '— Да просто утро чудесное и спалось мне крепко-крепко! — весело отвечает она на замечание ' + $RealName[$WitnessGirl] + '.'
            if FamilyCorruptionStage >= 4:
                *pl 'Она лукаво подмигивает тебе поверх плеча и добавляет с мурлыкающей интонацией:'
                *pl '— Когда в доме такой умелый хозяин, грех с утра не светиться от счастья!'
            else
                *pl 'Проходя мимо тебя со стопкой тарелок, она незаметно касается плечом твоего локтя и шепчет одними губами: «Спасибо за ночь, Стефан...»'
            end
        elseif $TargetGirl = 'melissa':
            *pl 'Мелисса пытается состроить строгое лицо, но уголки её губ упрямо ползут вверх, выдавая редкое умиротворение:'
            *pl '— Ничего особенного, просто квартальные подсчёты наконец сошлись без единой ошибки, — ровно отвечает она.'
            if FamilyCorruptionStage >= 4:
                *pl 'Она поднимает на тебя сияющие глаза и с тёплой иронией замечает:'
                *pl '— Хотя должна признать, ночные консультации с хозяином трактира отлично снимают усталость.'
            else
                *pl 'Стоит ' + $RealName[$WitnessGirl] + ' отвернуться, как Мелисса дарит тебе удивительно мягкую, открытую улыбку, в которой нет ни капли обычной колючести.'
            end
        else
            *pl 'Сандра мягко улыбается, поправляя чистый передник, и её лицо кажется помолодевшим на несколько лет:'
            *pl '— И порадоваться уже нельзя в собственном доме? — добродушно отзывается она. — Тесто подошло пышное, день ясный, вот на душе и легко.'
            if FamilyCorruptionStage >= 4:
                *pl 'Она подходит к тебе, подавая кружку, и ласково проводит ладонью по твоей груди:'
                *pl '— С таким мужчиной под одной крышей любая женщина расцветёт.'
            else
                *pl 'Передавая тебе утренний хлеб, она задерживает пальцы на твоей руке и смотрит на тебя с глубокой, светлой благодарностью.'
            end
        end
    end

    killvar '$TargetGirl'
    killvar '$WitnessGirl'
    killvar '$EventType'
---

#FamilyFirstSexMorningText
    $TargetGirl = $ARGS[0]
    $WitnessGirl = $ARGS[1]
    gs 'FamilyMorningAfterScreen1Text', $TargetGirl, $WitnessGirl, 'first_sex'
    *pl ' '
    gs 'FamilyMorningAfterScreen2Text', $TargetGirl, $WitnessGirl, 'first_sex'
    killvar '$TargetGirl'
    killvar '$WitnessGirl'
---

#AmandaFirstSexMorningText
    gs 'FamilyFirstSexMorningText', 'amanda', $AmandaFirstSexMorningWitness
---

#FamilyFirstSexTalkIntroText
    $TalkGirl = $ARGS[0]
    $TargetGirl = $ARGS[1]
    $TalkMode = $ARGS[2]

    if $TalkGirl = 'sandra' and $TalkMode = 'suspicion':
        *pl 'Сандра откладывает деревянный половник в сторону, вытирает руки чистым полотенцем и поворачивается к тебе. На её лице нет гнева, но в глазах застыла материнская тревога.'
        *pl 'Она делает знак подойти ближе и говорит негромко, чтобы звук не долетал до зала:'
        *pl '— Я не слепая, Стефан. И не глухая. То, как вы с ' + $RealName[$TargetGirl] + ' держитесь в последнее время... Я слишком хорошо знаю жизнь, чтобы принимать это за простую усталость.'
        *pl 'Она делает паузу, вглядываясь в твоё лицо:'
        *pl '— Наш дом и так на виду у всего города. Если пойдут слухи — нас сотрут в порошок. Скажи мне прямо, Стефан: мне стоит бояться за наш очаг?'

    elseif $TalkGirl = 'melissa' and $TalkMode = 'suspicion':
        *pl 'Мелисса перехватывает тебя в тихом уголке возле винного погреба, держа под мышкой конторскую книгу. На её губах играет язвительная усмешка, но в глазах светится живой интерес.'
        *pl '— Ну что, хозяин трактира, — говорит она тихо, с лёгким смешком. — Думаешь, ваши ночные тайны так надёжно спрятаны за старыми дверями?'
        *pl 'Она делает шаг ближе, наклоняя голову:'
        *pl '— У ' + $RealName[$TargetGirl] + ' с утра глаза блестят, как у кошки, дорвавшейся до сливок. А ты ходишь гоголем. Сопоставлять факты я умею получше всех в этом доме. Что скажешь в своё оправдание?'

    elseif $TalkGirl = 'amanda' and $TalkMode = 'suspicion':
        *pl 'Аманда подкарауливает тебя у лестницы, складывает руки на груди и с лукавым прищуром заглядывает тебе в лицо.'
        *pl '— Ага, попался, братик! — вполголоса заявляет она, оглянувшись на дверь зала. — Думаешь, одна я в этом доме ничего не замечаю?'
        *pl 'Она подаётся вперёд и понижает голос до заговорщического шёпота:'
        *pl '— Я же видела, как вы с ' + $RealName[$TargetGirl] + ' утром переглядывались! И шаги ночью за стеной слышала! Ну-ка колись, какие у вас там ночные секреты от меня завелись?'

    elseif $TalkGirl = 'amanda' and $TalkMode = 'worry':
        *pl 'Аманда ловит тебя за рукав в полутёмном переходе за лестницей и тревожно тянет в сторону. Её щёки алеют, а в глазах плещется волнение.'
        *pl '— Стефан... — шепчет она, торопливо оглядываясь по сторонам. — Ты видел, как на нас смотрели утром? Мне кажется, дома обо всём догадались!'
        *pl 'Она прикусывает нижнюю губу и заглядывает тебе в глаза:'
        *pl '— Что нам делать? Если в трактире или в городе узнают... Скажи, что всё будет в порядке?'

    elseif $TalkGirl = 'melissa' and $TalkMode = 'worry':
        *pl 'Мелисса отзывает тебя к дальней полке в кладовой и плотно прикрывает дверь. Несмотря на сдержанный вид, она нервно теребит пальцами край манжеты.'
        *pl '— Стефан, нам нужно быть осмотрительнее, — негромко произносит она. — Сегодня утром на нас смотрели слишком пристально. Ещё одна такая оплошность, и разговоров внутри семьи не избежать.'
        *pl 'Она поднимает на тебя серьёзный, ждущий поддержки взгляд:'
        *pl '— Ты ведь не позволишь, чтобы из-за нашей ночи в доме начался разлад?'

    elseif $TalkGirl = 'sandra' and $TalkMode = 'worry':
        *pl 'Сандра останавливает тебя у двери кухни, когда девочки уходят в зал, и тревожно поправляет ворот твоего кафтана.'
        *pl '— Стефан, родной... — тихо выдыхает она, глядя тебе в глаза. — Я сегодня утром чуть со стыда не сгорела под взглядом дочерей. Они у нас умные, сразу чуют перемену.'
        *pl 'Она прижимает ладонь к твоей груди:'
        *pl '— Скажи мне, как нам теперь держаться, чтобы сохранить мир в семье?'

    elseif $TalkGirl = 'sandra' and $TalkMode = 'understood':
        *pl 'Сандра садится на лавку напротив тебя. В трактире тихо — утренние дела завершены. Лицо матери спокойно, но во взгляде читается лёгкая горечь пополам с нежностью.'
        *pl '— Теперь я понимаю то утро, — произносит она едва слышно. — Когда вы с ' + $RealName[$TargetGirl] + ' спустились вниз. Я тогда чувствовала сердцем, но боялась даже мысль такую впустить.'
        *pl 'Она качает головой и кладёт тёплую ладонь поверх твоей руки:'
        *pl '— Ильматер свидетель, я хотела сохранить дом прежним. Но теперь, когда я сама перед тобой беззащитна, я не смею никого судить. Только прошу тебя: береги сестёр и держи семью вместе.'

    elseif $TalkGirl = 'melissa' and $TalkMode = 'understood':
        *pl 'Мелисса закрывает книгу учёта, складывает пальцы в замок и долго смотрит на тебя с тихой улыбкой.'
        *pl '— Знаешь, Стефан... я ведь вспомнила то утро, когда вы с ' + $RealName[$TargetGirl] + ' спустились вниз. Я тогда подшучивала, думала, что поймала вас на слабости.'
        *pl 'Она тихо вздыхает и переводит взгляд на твои руки:'
        *pl '— А теперь, когда между нами произошло то же самое, вся моя книжная спесь улетучилась. Мы теперь повязаны одним секретом, братец.'

    elseif $TalkGirl = 'amanda' and $TalkMode = 'understood':
        *pl 'Аманда мягко подходит к тебе со спины и осторожно кладёт подбородок на твоё плечо.'
        *pl '— Стефан... я ведь теперь всё понимаю про тебя и ' + $RealName[$TargetGirl] + ', — шепчет она на ухо. — Раньше я бы, наверное, разозлилась или приревновала. А сейчас понимаю.'
        *pl 'Она крепче обнимает твои плечи:'
        *pl '— Наша семья стала совсем особенной. Главное — держаться друг за друга и никому чужому не открывать наших тайн.'

    elseif $TalkMode = 'marathon_after':
        if $TalkGirl = 'amanda':
            *pl 'Аманда прислоняется к притолоке, потирая поясницу, и при твоём приближении заливается ярким румянцем:'
            *pl '— Ты ещё спрашиваешь, как я себя чувствую?! — полушёпотом возмущается она, хотя глаза сияют восторгом. — Из-за тебя надо мной с утра посмеиваются, что я враскоряку хожу! Ты выжал из меня все соки до последней капли!'
        elseif $TalkGirl = 'melissa':
            *pl 'Мелисса сидит за конторкой, положив под спину мягкую подушку, и встречает тебя выразительным взглядом:'
            *pl '— Надеюсь, ты пришёл не для того, чтобы снова подшучивать над моей походкой, Стефан. После твоих ночных безумств я с трудом спустилась по лестнице, да ещё и выслушала утренние колкости.'
        else
            *pl 'Сандра присаживается на край скамьи, разминая уставшие плечи, и качает головой с тёплой, смущённой улыбкой:'
            *pl '— Ну и ночку ты мне устроил, Стефан... Дочери с утра смотрят и спрашивают, отчего я еле ноги передвигаю. Разве можно быть таким неутомимым?'
        end

    elseif $TalkMode = 'no_finish_apology':
        if $TalkGirl = 'amanda':
            *pl 'Аманда стоит у окна, всё ещё надув губки после неудачной ночи, и искоса поглядывает на тебя:'
            *pl '— Ну и зачем ты подошёл? Снова наобещаешь с три короба, раздразнишь и оставишь меня одну считать трещины на потолке?'
        elseif $TalkGirl = 'melissa':
            *pl 'Мелисса поднимает глаза от счётов, сохраняя подчёркнуто прохладное выражение лица:'
            *pl '— Слушаю тебя, Стефан. Если ты решил объяснить причину своего вчерашнего отступления в самый ответственный момент, советую подбирать веские аргументы.'
        else
            *pl 'Сандра поворачивается к тебе от стола, и в её взгляде сквозит тихая женская обида:'
            *pl '— Скажи честно, Стефан... я вчера что-то сделала не так, или у тебя просто сил на меня не хватило?'
        end
    end

    killvar '$TalkGirl'
    killvar '$TargetGirl'
    killvar '$TalkMode'
---

#FamilyFirstSexTalkChoiceText
    $TalkGirl = $ARGS[0]
    $TargetGirl = $ARGS[1]
    $TalkMode = $ARGS[2]
    $Choice = $ARGS[3]

    if $TalkGirl = 'sandra' and $TalkMode = 'suspicion':
        if $Choice = 'deny':
            *pl 'Ты небрежно пожимаешь плечами и говоришь, что Сандра ищет тайны на пустом месте: просто тяжёлая смена и усталость.'
            *pl 'Сандра смотрит на тебя долго, не мигая. Её губы сжимаются в тонкую линию.'
            *pl '— Не держи меня за дуру, Стефан, — сухо отвечает она. — Я пока промолчу. Но помни: этот дом держится на порядке перед людьми и перед Ильматером.'
        elseif $Choice = 'calm':
            *pl 'Ты спокойно берёшь Сандру за плечи, глядя прямо ей в глаза, и твёрдо говоришь, что дом и семья для тебя превыше всего, и ты не позволишь ни единому слуху коснуться вашего порога.'
            *pl 'Напряжение медленно покидает плечи матери. Она глубоко выдыхает и опускает веки.'
            *pl '— Хорошо, — шепчет она с облегчением. — Я верю тебе, Стефан. Только будь осторожен ради всех нас.'
        else
            *pl 'Ты торопливо переводишь разговор на запасы муки, цену на солонину и вечерний приток гостей. Сандра молча слушает тебя.'
            *pl 'Она не спорит, но в её глазах остаётся тень тревоги.'
            *pl '— Делай своё дело, хозяин, — ровно говорит она. — Но не забывай: от твоих поступков зависит судьба девушек.'
        end

    elseif $TalkGirl = 'melissa' and $TalkMode = 'suspicion':
        if $Choice = 'banter':
            *pl 'Ты усмехаешься и парируешь её выпад: мол, считать она умеет отлично, только вот за руку никого не ловила, а чужие спальни её книжному уму покоя не дают.'
            *pl 'Мелисса закатывает глаза, но уголки её губ вздрагивают в лукавой улыбке.'
            *pl '— Остроумие через край, братец, — фыркает она, поправляя перья. — Но если не хочешь лишних расспросов в доме, умерь свой пыл и проверяй воротник по утрам.'
        elseif $Choice = 'discretion':
            *pl 'Ты серьёзно смотришь на сестру и просишь её проявить благоразумие: в доме и так непросто, и лишняя смута никому не пойдёт на пользу.'
            *pl 'Мелисса умолкает. Ирония сходит с её лица, уступая место собранности.'
            *pl '— Я не болтушка с базара, Стефан, — негромко отвечает она. — Разносить слухи я не стану. Но не забывай, кто в этой семье вовремя замечает опасность.'
        else
            *pl 'Ты холодно обрываешь её, заявляя, что не обязан отчитываться перед сестрой о том, как проводишь ночи.'
            *pl 'В глазах Мелиссы вспыхивает обида. Она демонстративно захлопывает книгу.'
            *pl '— Вот как, — сухо роняет она. — Что ж, хозяин в доме ты. Только потом не приходи ко мне за советом.'
        end

    elseif $TalkGirl = 'amanda' and $TalkMode = 'suspicion':
        if $Choice = 'banter':
            *pl 'Ты с ухмылкой треплешь Аманду по щеке и советуешь ей поменьше подслушивать у чужих дверей по ночам, чтобы нос от любопытства не вытянулся.'
            *pl 'Аманда возмущённо фыркает, уворачиваясь от твоей ладони, но тут же звонко хихикает:'
            *pl '— Ах так! Значит, я ещё и любопытная! Ну погоди, братик, я вас всё равно на чистую воду выведу!'
        else
            *pl 'Ты притягиваешь Аманду ближе и серьёзно просишь держать язык за зубами, чтобы в доме и в зале не начались пустые пересуды.'
            *pl 'Аманда сразу становится важной, проводит пальцем по губам, словно запирая их на ключик, и заговорщически кивает:'
            *pl '— Могила, Стефан! Я же своя, неужели я стану трепаться? Но ты мне теперь за молчание задолжал!'
        end

    elseif $TalkMode = 'worry':
        if $Choice = 'reassure':
            *pl 'Ты крепко обнимаешь ' + $RealName[$TalkGirl] + ' за плечи, привлекая к себе, и мягко шепчешь, что никто ничего не докажет, а ты всегда прикроешь её и защитишь от любых пересудов.'
            *pl 'Она на мгновение прижимается щекой к твоей груди, глубоко выдыхает и поднимает на тебя потеплевший взгляд:'
            *pl '— Спасибо, Стефан... Рядом с тобой мне и правда спокойно. Будем держаться вместе.'
        else
            *pl 'Ты спокойно и твёрдо говоришь, что главное сейчас — вести себя на людях как обычно, заниматься делами и не обмениваться долгими взглядами при остальных.'
            *pl 'Она собранно кивает, расправляя плечи:'
            *pl '— Ты прав. Будем осторожнее, чтобы никто не нашёл повода для сплетен.'
        end

    elseif $TalkMode = 'marathon_after':
        if $Choice = 'tease':
            *pl 'Ты наклоняешься к самому её уху и с усмешкой шепчешь, что кричала она ночью так сладко, что остановиться было просто невозможно.'
            *pl 'Её щёки мгновенно вспыхивают жарким румянцем. Она легонько стукает тебя ладонью по плечу, пряча счастливую улыбку:'
            *pl '— Бесстыдник ты, Стефан... Только попробуй ещё раз довести меня до того, что я ходить не могу!'
        else
            *pl 'Ты бережно проводишь ладонью по её талии и говоришь, что такой горячей и откровенной женщины невозможно насытиться.'
            *pl 'В её глазах зажигается тёплый, томный блеск. Она мягко подаётся навстречу твоей руке:'
            *pl '— Умеешь ты сказать так, что вся усталость пропадает... Дай мне только денёк отдышаться, хорошо?'
        end

    elseif $TalkMode = 'no_finish_apology':
        *pl 'Ты притягиваешь ' + $RealName[$TalkGirl] + ' за талию, смотришь прямо в глаза и твёрдо обещаешь, что сегодня ночью сполна вернёшь ей долг и не остановишься, пока она сама не попросит пощады.'
        *pl 'Недавняя обида тает на глазах. По её губам скользит предвкушающая улыбка:'
        *pl '— Ловлю тебя на слове, Стефан. Смотри не обмани сегодня ночью — спрашивать буду со всей строгостью.'

    elseif $TalkMode = 'understood':
        *pl 'Ты молча сжимаешь ладонь ' + $RealName[$TalkGirl] + ', принимая её слова. Тайна, которая раньше могла бы разделить дом, теперь окончательно связывает вас в один общий круг.'
        *pl 'Она отвечает на твоё рукопожатие долгим, понимающим взглядом и возвращается к делам с лёгким сердцем.'
    end

    killvar '$TalkGirl'
    killvar '$TargetGirl'
    killvar '$TalkMode'
    killvar '$Choice'
