! ================================================

#AmandaLizaTalkText
    $AmandaLizaTalkTextId = LCASE($ARGS[0])
    $AmandaLizaTalkText = ''

    gs 'EnsureGirlData', 'amanda'

    if $AmandaLizaTalkTextId = 'play_coach_amanda':
        ! v2: coach text в hall_play_coach_text (подслушивание Аманда↔Лизетта)
        if LOC('HallPlayCoachBuildCombinedText') = 1:
            gs 'HallPlayCoachBuildCombinedText', 'amanda'
            $AmandaLizaTalkText = $HallPlayCoachCombined
            killvar '$HallPlayCoachCombined'
        else:
            $AmandaLizaTalkText = 'За дверью Лизетта учит Аманду наклоняться плавнее и крутить попой ради чаевых. Аманда смущается, но жадно слушает каждое слово.'
        end

    elseif $AmandaLizaTalkTextId = 'naive_not_only_kiss':
        $AmandaLizaTalkText = '— Лизка, только не смейся... а правда, что когда парень остаётся с тобой наедине, вы не только целуетесь? Ну... за закрытыми дверями? — шепчет Аманда, сгорая от любопытства и нервно теребя кончик косы.<br><br>Лизетта весело фыркает, откидываясь на подушку и закинув ногу на ногу:<br>— Ну конечно не только, глупая! Поцелуи — это так, чтобы разогреть и посмотреть, не сбежит ли он в испуге. А потом юбка взлетает, его руки скользят по бедрам, и он входит в тебя весь, до упора... Если парень умеет обращаться с девушкой, у тебя в животе всё огнём горит, а в голове ни одной связной мысли не остаётся. Словами это не передать — самой пробовать надо!'

    elseif $AmandaLizaTalkTextId = 'naive_mother_many_kids':
        $AmandaLizaTalkText = '— Лизетта... а в городе шепчутся, будто твоя мама под венец ни разу не ходила, а детей у неё... чуть не полдюжины от разных отцов. Это правда? — нерешительно спрашивает Аманда, боясь обидеть подругу.<br><br>Лизетта беспечно усмехается и машет ладонью с медными колечками:<br>— Правда, конечно. Мама у меня женщина вольная, в четырёх стенах ей тошно. Говорит: «Муж — это ярмо на шею, стирай ему портки да слушай брань, а влюблённые мужчины — щедрые, ласковые и подарки несут». Отказать крепкому моряку или заезжему купцу ей всегда было тяжело. Вот и вздыхает теперь: мол, опять чьё-то дитя под сердцем забилось не ко времени... Зато каждый в порту знает, что Жоржетта живёт как сама хочет, а не как святоши на проповеди велят.'

    elseif $AmandaLizaTalkTextId = 'curious_stefan':
        $AmandaLizaTalkText = '— Лизка... а ты со Стефаном... ну, вы же были вместе? — Аманда подаётся вперёд, её глаза лихорадочно блестят, а дыхание сбивается. — Скажи честно... каков он? Ну, в постели?<br><br>Лизетта лукаво щурится, подперев щёку ладонью, и с растяжкой усмехается:<br>— О-о, твой братец только с виду увалень и ворчун за стойкой. А когда дело доходит до ласок — настойчивый, горячий, рук не жалеет. Знает, где прижать, где языком пройтись, чтобы колени подогнулись. А уж инструмент у него — Ильматер свидетель, редкой девке в нашем городишке такой богатырский размер перепадает! У меня после него ещё полдня внутри всё сладко ныло и пульсировало... Везёт же кому-то с таким хозяином в доме!'

    elseif $AmandaLizaTalkTextId = 'curious_oral':
        $AmandaLizaTalkText = '— Лиза... а городские девки у колодца болтали... будто ты мужчинам в рот берёшь? Ну... прямо туда, губами? — Аманда заливается густой краской до самых корней волос и прижимает ладони к пылающим щекам.<br><br>Лизетта звонко смеётся, ничуть не смущаясь:<br>— Да пусть болтают, завистницы! Конечно беру. Мужчины от этого вовсе голову теряют, готовы последние монеты из кошеля вытрясти и шёлковые ленты к ногам бросить, лишь бы ты их приласкала губками. Главное — чтобы тело чистое было, да зубами не скрести. Если научишься правильно языком работать, любой зазнавшийся кавалер будет у твоих ног как ручной щенок скулить.'

    elseif $AmandaLizaTalkTextId = 'curious_first_time':
        $AmandaLizaTalkText = '— А когда... в самый первый раз... — Аманда вздрагивает и обхватывает колени руками, с трепетом глядя на подругу. — Больно было? Мне Мелисса говорила, что это сущий кошмар, кровь и слёзы...<br><br>Лизетта снисходительно качает головой:<br>— Твоя Мелисса слишком много книжек читает, вот у неё от страха голова и пухнет. Больно — только секунду, в самом начале, когда преграда рвётся. Будто крапивой обожгло. А если парень не торопится, целует сладко да ласкает снизу пальцами, чтобы ты промокла — боли почти и не заметишь. Зато потом... волна за волной накатывает такое блаженство, что я потом сама на себя злилась: чего ради столько лет в девках дрожала и берегла то, от чего можно столько радости получать?'

    elseif $AmandaLizaTalkTextId = 'curious_before_wedding':
        $AmandaLizaTalkText = '— Матушка твердит, и старейшины на проповедях пугают, что до свадьбы девице беречься надо, — вздыхает Аманда, глядя в окно на улицу. — Мол, честную девушку только в венце муж познать должен... Как ты вообще решилась не ждать?<br><br>Лизетта фыркает с нескрываемым сарказмом:<br>— До свадьбы? А ты посмотри на наших замужних баб в Верхнем городе! Свадьбы дождались, а теперь мужья их за людей не считают, по кабакам шляются да кулаками по столу стучат. А молодость-то уходит, Аманда! Пока ты юная, свежая и кровь кипит — надо жить и радоваться. А свадьба... будет ли она вообще, и захочешь ли ты под чужую указку идти? Жизнь одна, и отказывать себе в ласках ради мнения соседок — самая глупая трата на свете.'

    elseif $AmandaLizaTalkTextId = 'bed_deflower_talk':
        $AmandaLizaTalkText = '— Лиза... ты упадёшь, если я скажу! — Аманда нервно хватает подругу за запястье, её голос срывается на взволнованный шёпот, а щёки пылают. — Меня... Стефан женщиной сделал! Он пришёл ночью в комнату... был такой настойчивый, горячий, обнимал так, что у меня дух захватило. И я не удержалась, пустила его под одеяло! А теперь места себе не нахожу... Правильно ли это? Ведь он мой брат, а если матушка узнает — со свету сживёт!<br><br>Лизетта на миг замирает, округлив глаза, а затем её лицо расплывается в широкой, восхищённой улыбке:<br>— Ну ничего себе поворот! Поздравляю, подруга, скинула-таки эту обузу! А насчёт брата — брось ты терзаться. В богатых дворянских домах, говорят, и не такое творят, чтобы кровь и богатство в семье сберечь. Стефан парень видный, крепкий, трактир держит. Уж лучше пусть он тебя научит сладости, чем какой-нибудь пьяный матрос в переулке силой возьмёт. Главное — помалкивай перед Сандрой, а Стефана теперь держи на коротком поводке: ты для него теперь не просто сестрёнка, а желанная женщина!'

    elseif $AmandaLizaTalkTextId = 'ban_legare_low':
        $AmandaLizaTalkText = '— Лизка, беда! — дует губки Аманда, с досадой притопывая ножкой. — Стефан устроил мне выволочку и наотрез запретил даже близко подходить к мессиру Легаре на площади! А Альбер такой обходительный, бархатный камзол носит, на танцы зовёт, комплименты шепчет... Ну почему Стефан вечно мне всё портит?<br><br>Лизетта хитро щурится и прыскает в кулак:<br>— Почему-почему... Ревнует твой братец, вот почему! Сам на тебя как кот на сметану смотрит, вот и бесится, что богатый купец вокруг тебя хороводы водит.<br>— Да ты с ума сошла, Лиза! Он же мой брат!<br>— Брат-то брат, да мужик в первую очередь. Ты на его рык внимания не обращай: покричит и остынет. Просто будь хитрее — не попадайся Стефану на глаза, когда Альбер тебе улыбается. А от красивых речей Легаре грех отказываться, если они тебе по вкусу.'

    elseif $AmandaLizaTalkTextId = 'ban_legare_high':
        $AmandaLizaTalkText = '— Лизетта, я больше не могу! — возмущается Аманда, нервно меряя шагами комнату. — Стефан возомнил себя моим тюремщиком! Запретил даже глядеть в сторону Альбера Легаре. Следит за каждым шагом, отчитывает при всех! Да какое он право имеет? Я уже взрослая девушка, а не сопливая девчонка из кухни!<br><br>Лизетта скрещивает руки на груди и одобрительно кивает:<br>— Вот это правильный настрой, Аманда. Почувствовал власть над трактиром — и решил, что и тобой теперь командовать может. Мужчины всегда так: дай им волю, они тебя в сундук запрут и ключ проглотят. Не вздумай прогибаться. Ты хозяйка своему телу и сама вольна решать, с кем кружиться в танце. Хочет Альбер тебя угощать да осыпать похвалами — принимай! А брату покажи, что его приказы за порогом твоей спальни силы не имеют.'

    elseif $AmandaLizaTalkTextId = 'ban_lizette':
        $AmandaLizaTalkText = '— Лизочка... ты не представляешь, что Стефан учудил, — шепчет Аманда, виновато опуская ресницы. — Запретил мне с тобой водиться! Наговорил гадостей, будто ты из меня вертихвостку сделаешь и дурному научишь...<br><br>Лизетта запрокидывает голову и звонко хохочет:<br>— Ой, держите меня! Дурному научу? Да он просто боится, что я открою тебе глаза на то, как устроен этот мир, и ты перестанешь быть покорной овечкой, разносящей пиво по его указке! И вообще — раз ты прямо сейчас сидишь здесь и шепчешься со мной, значит, грош цена его запретам. Умница, Аманда, своя голова на плечах есть!'

    elseif $AmandaLizaTalkTextId = 'ban_guys':
        $AmandaLizaTalkText = '— Лизка, Стефан вчера такую бурю поднял — земля дрожала! — жалуется Аманда, теребя кружево на вороте. — Я всего лишь постояла у ворот с парнями с мельничной улицы. Ну приятно же, когда на тебя смотрят, подмигивают, яблоки сладкие суют! А брат налетел, разогнал всех, на меня накричал — мол, работать надо, а не вертеть подолом перед каждым встречным оборванцем. Он меня вообще взаперти сгноить хочет!<br><br>Лизетта ухмыляется, лениво потягиваясь:<br>— Зависть мужская, чистая как слеза. Парни на тебя слюни пускают, а Стефана от одной мысли корчит, что до тебя чужие руки дотянутся. Ты внимание принимай — девичья краса не вечна, когда ещё тебе полгорода в рот заглядывать будет? Но и на шею каждому встречному вешаться не спеши: пусть сначала побегают, поухаживают да кошельки растрясут. А на крики брата кивай смирно, а делай всё равно по-своему.'

    elseif $AmandaLizaTalkTextId = 'legare_deflower':
        $AmandaLizaTalkText = '— Лизетта... я больше не девочка! — взволнованно выдыхает Аманда, падая на кровать рядом с подругой и пряча пылающее лицо в подушку. — Альбер... он увёл меня, был такой нежный, ласковый... Такие слова говорил, каких мне отродясь никто не шептал! Платье расстегнул, целовал всю... и сделал меня женщиной! Поздравь меня, Лиза, я до сих пор как во сне!<br><br>Лизетта с неподдельным интересом приподнимается на локте:<br>— Вот это новость! Сам мессир Легаре, первый богач на винной улице! Ну поздравляю, подруга, теперь ты взрослая женщина, а не робкая девица. Рассказывай давай всё до капли: хорош ли он оказался в постели? Небось, светился от гордости, что сорвал такой сладкий цветок?<br>— Ой, Лиза, он так старался... я чуть с ума от счастья не сошла!'

    elseif $AmandaLizaTalkTextId = 'legare_suck_advice':
        $AmandaLizaTalkText = '— Лиза... ты только никому, заклинаю Ильматером! — Аманда смущённо кусает губу, её глаза горят шальным огоньком. — Я... я взяла у Альбера в рот! Он позвал меня к себе в лавку за дальние бочки, расстегнул штаны... Я сначала испугалась страшно, думала — неумехой покажусь, но он так ласково гладил меня по волосам, шептал, какая я красавица и сокровище... И я решилась!<br><br>Лизетта довольно прищёлкивает пальцами:<br>— Вот умница, растёшь на глазах! Мужчины за такое обращение душу готовы продать. Альбер теперь от тебя ни на шаг не отвяжется, будет подарками осыпать, лишь бы ты повторила. Ну а дальше что? В постель-то с ним пойдёшь, раз он такой обходительный?<br>— Ой, Лиза... я даже не знаю, страшно ещё...<br>— Чего бояться, глупая? Раз ротиком уважила, в постели и подавно сладко будет. Не робей, бери от него всё, пока он тобой очарован!'

    elseif $AmandaLizaTalkTextId = 'legare_give_him':
        $AmandaLizaTalkText = '— Лиза, посоветуй, у меня голова кругом! — Аманда садится рядом, жалобно заглядывая в глаза подруге. — Альбер так нежно кружит меня в танцах, так смотрит... но я же вижу, что одних взглядов ему мало. Он всё норовит в темноту увести, руки на талию кладёт всё ниже, шепчет такие вещи, от которых дыхание перехватывает. Что мне делать? Он взрослый, богатый, статный...<br><br>Лизетта усмехается опытной, взрослой улыбкой:<br>— А чего тут думать, Аманда? Мужчинам вроде Легаре одних вздохов при луне мало, им плоть подавай. Если он тебе самой нравится и сердце замирает от его прикосновений — отдайся ему! Зачем мучить и себя, и его? Только помни: купцы любят брать даром то, за что можно не платить. Держи его на крючке, пусть раскошелится на дорогие платья да шелка, прежде чем получит всё до конца!'

    elseif $AmandaLizaTalkTextId = 'oral_but_virgin':
        $AmandaLizaTalkText = '— Лизочка... я вот губами ласкать уже научилась, — смущённо шепчет Аманда, разглядывая свои пальцы. — А невинность всё ещё берегу. И любопытно до дрожи узнать, каково это — когда мужчина входит внутрь, и страшно... А вдруг нестерпимо больно будет? Или стыдно потом?<br><br>Лизетта ласково приобнимает подругу за плечи:<br>— Да брось ты дрожать, как овечка перед стрижкой! Все через это проходят. Первые пару толчков перетерпишь — а потом такое блаженство накроет, что о стыде и не вспомнишь. Ты уже не ребёнок, тело твоё созрело и само ласки просит. Выбери того, кому доверяешь больше всего, расслабься — и пусть сделает тебя настоящей женщиной. Поверь мне, ни секунды жалеть не будешь!'

    elseif $AmandaLizaTalkTextId = 'whore_joy':
        $AmandaLizaTalkText = '— Лиза! Ты даже не представляешь, какое это невероятное чувство — жить по-настоящему! — сияет Аманда, кружась по комнате с распущенными волосами. — Словно с меня тяжёлые оковы сбросили. Мужчины смотрят с вожделением, шепчут комплименты, а по ночам в постели творится такое сладкое безумие! Всё вышло в точности, как ты говорила. Зачем я столько времени боялась каждого шороха и слушала матушкины нотации?<br><br>Лизетта смотрит на неё с искренней гордостью и смеётся:<br>— А я тебе что твердила? Мир устроен просто: либо ты сидишь в углу и боишься собственной тени, либо берёшь от жизни все радости и сводишь мужчин с ума своей красотой. Я так рада за тебя, Аманда! Куда только подевалась та испуганная девчушка, которая от одного слова краснела? Теперь ты настоящая искусительница!'

    elseif $AmandaLizaTalkTextId = 'marriage_worry':
        $AmandaLizaTalkText = '— Лизочка... ласки ласками, а меня всё равно червь сомнения точит, — вздыхает Аманда, садясь на сундук. — Я теперь знаю, что такое страсть, и назад дороги нет. Но вдруг из-за этого меня замуж никто приличный не возьмёт? Вдруг прознают, что я не невинна, и ославят на весь город?<br><br>Лизетта фыркает и беспечно машет рукой:<br>— Ой, нашла о чём печалиться! Да кто сейчас на свадьбу невинной идёт? Разве что кривые да горбатые, на которых и взглянуть-то страшно. Моя мама всегда говорит: мужчине в жёнах нужна страстная, умелая хозяйка, а не холодное бревно, дрожащее от каждого прикосновения. Если парень тебя по-настоящему полюбит — ему до твоей девственности дела не будет. А если захочет проверить — капнешь на простыню, и вся недолга! Выбрось эту дурь из головы.'

    elseif $AmandaLizaTalkTextId = 'stefan_brother_fuck':
