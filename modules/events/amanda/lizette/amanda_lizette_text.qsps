! #AmandaLizetteBanChoice
! #AmandaLizetteSecretVisit
! ================================================

#AmandaLizetteText
    $AmandaLizetteTextId = LCASE($ARGS[0])
    $AmandaLizetteText = ''

    if $AmandaLizetteTextId = 'first_talk_intro':
        $AmandaLizetteText = 'Ты замечаешь Аманду в дальнем углу зала. Сестра делает вид, будто занята делом — прилежно трёт мокрой тряпкой край столешницы, но её взгляд то и дело воровато соскальзывает к входной двери.<br><br>Спустя пару минут мимо тяжёлых дубовых створок в зал бесшумно проскальзывает тонкая девичья фигурка — Лизетта, дочь портовой торговки Жоржетты. Смуглая, с копной буйных тёмных кудрей и дерзкими синими глазами, она держится с той раскованной столичной грацией, которая сразу выделяет её среди горожанок. Оперевшись бедром о винную бочку, Лизетта что-то оживлённо шепчет сестре на ухо, лукаво щурясь и кивая в сторону подвыпивших гостей за угловым столом.<br><br>В её словах нет явной опасности: она учит Аманду ловить мужские взгляды, показывать стать, держать осанку и обращать внимание поклонников себе на пользу. Но щёки Аманды горят ярким румянцем, а пальцы нервно комкают край фартука — эти речи зацепили её куда глубже, чем простая девичья болтовня.'

    elseif $AmandaLizetteTextId = 'first_choice_calm':
        $AmandaLizetteText = 'Ты подходишь к девушкам спокойным, неторопливым шагом, не выказывая подозрения. Заметив тебя, Аманда испуганно вздрагивает и прячет тряпку за спину, готовая к нагоняю.<br><br>— Ну что, сестрёнка, винные бочки сегодня протираются особенно тщательно? — с лёгкой усмешкой бросаешь ты, переводя взгляд на гостью.<br><br>Лизетта ничуть не тушуется: она плавно выпрямляется, откидывая кудри за плечо, и одаривает тебя открытой, приветливой улыбкой.<br><br>— Доброго дня, хозяин. Я как раз хвалила Аманду — у неё редкое природное изящество, жаль прятать такую грацию за грязными кружками.<br><br>— Разговаривать не запрещено, — спокойно отвечаешь ты, глядя обеим прямо в глаза. — Пока подносы разносятся вовремя, а за спиной не плетутся секреты от меня. Аманда, гости за третьим столом ждут пиво.<br><br>Аманда с явным облегчением выдыхает, щёки её алеют от благодарности за твою сдержанность. Она хватает поднос и спешит к стойке, а Лизетта провожает тебя долгим, оценивающим взглядом с хитрой полуулыбкой — похоже, она поняла, что молодой хозяин не станет орать как деревенский самодур, и с ним можно иметь дело.'

    elseif $AmandaLizetteTextId = 'first_choice_ignore':
        $AmandaLizetteText = 'Ты решаешь не обострять и проходишь мимо, сделав вид, будто всецело поглощён проверкой амбарных записей и бочек у входа.<br><br>Аманда украдкой провожает тебя тревожным взглядом, но видя, что ты не стал окликать её, заметно расслабляется. Лизетта тут же пользуется твоим невмешательством. Наклонившись к самому ушку сестры, она шепчет что-то с лукавой, победной улыбкой. Аманда вспыхивает до кончиков ушей, прикрывает рот ладошкой и сдавленно хихикает, косясь в твою сторону.<br><br>Формально ничего не произошло, но ты кожей ощущаешь: между девчонками завязался маленький заговор, и отсутствие хозяйского присмотра лишь раззадорило их интерес к запретным тайнам.'

    elseif $AmandaLizetteTextId = 'first_choice_strict':
        $AmandaLizetteText = 'Ты подходишь с хмурым лицом и решительно встаёшь между девушками, обрывая их шушуканье.<br><br>— Так, довольно лясы точить, — резко отрезаешь ты хозяйским тоном. — Аманда, зал полон народу, а ты тут прохлаждаешься. Бегом на кухню за жарким! А вам, юная госпожа, если не заказываете выпивку, здесь делать нечего. Трактир — не место для праздных сплетен.<br><br>Аманда густо багровеет от обиды и унижения перед подругой. Она молча швыряет тряпку в ведро и, вздёрнув подбородок, убегает, бросив на тебя колючий, упрямый взгляд исподлобья. Лизетта же не спорит: она лишь примирительно поднимает ладони, легко скользит к выходу, но перед самой дверью оборачивается и подмигивает Аманде с заговорщической усмешкой.<br><br>Сцена завершилась, но на душе остаётся неприятный осадок. Ты прогнал гостью, но взамен посеял в сердце сестры бунт — и теперь она явно будет искать встречи с Лизеттой втайне от тебя.'

    elseif $AmandaLizetteTextId = 'room_visit_intro':
        $AmandaLizetteText = 'Поздним вечером, поднявшись на второй этаж трактира, ты проходишь по скрипучему дощатому коридору мимо комнаты Аманды. Из-под щели под дверью пробивается тёплая полоска свечного пламени, а изнутри доносится приглушённый девичий шёпот и звонкий, сдавленный смешок.<br><br>Один голос — несомненно, Аманды: в нём звучит девичье изумление и стыдливый восторг. Второй — грудной, уверенный и насмешливый — принадлежит Лизетте.<br><br>Они сидят на постели, перешёптываясь так тихо, что отдельные слова тонут в шорохе ткани. Лизетта что-то втолковывает с лёгкой столичной небрежностью, а Аманда то испуганно охает, то прыскает со смеху, то вдруг затихает, точно услышала нечто до головокружения запретное.<br><br>Похоже, девичьи беседы окончательно переместились из шумного зала туда, где их не достанут строгие глаза Сандры и лишние уши.'

    elseif $AmandaLizetteTextId = 'caught_enter':
        $AmandaLizetteText = 'Ты коротко стучишь костяшками пальцев по дубовой двери и, не дожидаясь ответа, решительно нажимаешь на медную ручку.<br><br>Дверь распахивается. Аманда вскрикивает и испуганно вскакивает с узкой кровати, на лету пытаясь одёрнуть подол ночной сорочки и спрятать за спину какие-то пёстрые ленты. Лизетта сидит на покрывале, подогнув под себя стройные ножки; она оборачивается медленно, плавно, и на её смуглом лице нет ни тени страха — лишь ироничное любопытство.<br><br>В комнате пахнет лавандовой водой, воском и девичьим теплом. На столике у зеркала стоят две чашки с остывшим ромашковым взваром. Ничего преступного здесь нет, но сам воздух наэлектризован тайнами.<br><br>— Стефан?! — сдавленно лепечет Аманда, пылая щеками от досады и стыда. — Ты… ты стучать должен!<br><br>Лизетта же неторопливо оправляет край подола и молча смотрит на тебя снизу вверх, с интересом ожидая, как поведёт себя хозяин трактира.'

    elseif $AmandaLizetteTextId = 'caught_listen':
        $AmandaLizetteText = 'Ты замираешь у дверного косяка, затаив дыхание, и прислушиваешься к разговору за тонкой деревянной переборкой.<br><br>— …да брось ты, Аманда, — негромко, но веско звучит голос Лизетты. — Все эти городские святоши во главе с пастырем только на проповедях о чистоте кричат. А в сумерках господа вроде твоего Альбера или городских судей первыми ищут тех, кто умеет дарить настоящую страсть. Вся разница между шлюхой и госпожой — в том, кто командует в постели.<br><br>— Но мама говорит… Ильматер заповедал скромность, — робко шепчет Аманда, но в её голосе уже сквозит сомнение.<br><br>— Мама твоя живёт страхом, — усмехается Лизетта. — Запомни главное: твоё тело принадлежит только тебе. Ни священник, ни брат, ни богатый щёголь не вправе указывать тебе, пока ты сама не пожелаешь отдаться. Когда ты отдаёшься по своей воле — это твоя сила, твой выбор.<br><br>Аманда долго молчит, заворожённая этими речами, а затем тихо, с придыханием спрашивает:<br><br>— А если… если мне самой этого хочется? Даже если это грех?..<br><br>Продолжения ты уже не разбираешь, но услышанного более чем достаточно: дочь Жоржетты открывает сестре глаза на мир так дерзко, как никто прежде.'

    elseif $AmandaLizetteTextId = 'caught_leave':
        $AmandaLizetteText = 'Поколебавшись мгновение, ты решаешь не ломать дверь и не устраивать ночных разборок. Бесшумно отступив от косяка, ты направляешься обратно по полутёмному коридору.<br><br>За твоей спиной девичий шёпот вспыхивает с новой силой, переходя в приглушённый заговорщический смех. Возможно, это просто невинная болтовня двух девчонок-ровесниц, делящих первые взрослые мечты. А возможно, Лизетта методично подталкивает Аманду к той черте, за которой начинаются опасные игры с мужчинами и городской молвой.<br><br>С каждым шагом по лестнице чувство смутной тревоги лишь крепнет: ты оставил без присмотра то, что может очень скоро перевернуть весь твой дом.'

    elseif $AmandaLizetteTextId = 'ban_hard':
        $AmandaLizetteText = '— Хватит этих посиделок, — отрезаешь ты жёстким, непререкаемым голосом. — Лизетта, собирайся и уходи. Чтобы духу твоего в комнатах наверху больше не было. Аманда, ты хозяйская сестра, а не портовая гулёна. Любые встречи с этой девицей — отныне только с моего прямого разрешения. Ясно?<br><br>Аманда резко вскидывает подбородок. В её глазах больше нет девичьего испуга — там полыхает горькая обида и глухая, упрямая злость на тебя. Она до боли стискивает край покрывала, судорожно глотая воздух.<br><br>Лизетта же ни на йоту не теряет самообладания. Она грациозно встаёт с постели, приглаживает подол платья и бросает на Аманду красноречивый взгляд, уголок её губ трогает тонкая, ядовитая усмешка: твой грубый запрет в точности доказал сестре все её слова о мужском деспотизме.<br><br>— Доброй ночи, Стефан, — мурлычет гостья, плавно выскальзывая за порог.<br><br>Дверь захлопывается. Аманда отворачивается к стене, наотрез отказываясь смотреть на тебя. Формально приказ отдан, но ты нутром чуешь: этим запретом ты лишь научил сестру врать и прятаться искуснее прежнего.'

    elseif $AmandaLizetteTextId = 'ban_soft_allow':
        $AmandaLizetteText = 'Ты переводишь дух и опираешься плечом о дверной косяк, заговорив спокойно и рассудительно:<br><br>— Кричать и запирать двери на засов я не собираюсь. Вы обе уже не дети. Но зарубите себе на носу: это мой трактир, и я не потерплю тайных заговоров под собственной крышей. Лизетта, хочешь общаться с Амандой — приходи открыто, днём, не прячась по углам и не забивая ей голову дурными советами. А ты, Аманда, помни, кто за тебя в ответе перед городом и матерью.<br><br>Аманда, явно ожидавшая разноса и крика, опешив моргает. Обида на её лице сменяется изумлением и робкой благодарностью.<br><br>— Я поняла, Стефан… Мы просто разговаривали, правда, — тихо роняет она, опуская глаза.<br><br>Лизетта удивлённо приподнимает бровь, внимательно изучая твоё лицо. Похоже, в порту и столице она привыкла к грубой брани и побоям от старших, и твоя твёрдая, но лишённая унижения речь застала её врасплох.<br><br>— Разумно сказано, хозяин, — кивает она с непривычным уважением в голосе. — Прятаться никто не собирался.<br><br>Напряжение в спальне спадает, и хотя дистанция между вами остаётся, разговор завершается без скандала и взаимной вражды.'

    elseif $AmandaLizetteTextId = 'ban_freedom':
        $AmandaLizetteText = 'Ты недолго молчишь, разглядывая притихших девушек, а затем негромко усмехаешься:<br><br>— Знаете что? Аманда уже совершеннолетняя девушка, а не сопливая девчонка. Хватит нянчиться. Дружи с кем хочешь, Аманда, и слушай кого угодно — я не надсмотрщик в монастыре. Но помни одно: за каждый свой поступок, за каждое слово и за каждую ошибку перед городом расплачиваться будешь ты сама. Свобода — штука дорогая, сестрёнка.<br><br>Аманда ошеломлённо замирает. В её широко распахнутых глазах вспыхивает пьянящая радость вперемешку с робостью: ещё никто в семье не признавал за ней права быть взрослой женщиной.<br><br>— Спасибо, Стефан… — выдыхает она с сияющей улыбкой.<br><br>Лизетта же довольно щурится, грациозно потягиваясь на постели. Она не произносит ни слова, но её лукавый взгляд прямо кричит о триумфе: запретов больше нет, и теперь перед ней открыто всё поле для самых смелых уроков обольщения.'

    elseif $AmandaLizetteTextId = 'secret_visit_intro':
        $AmandaLizetteText = 'Твой строгий запрет продержался недолго. Глубокой ночью, когда весь трактир погрузился в сон, чуткий слух улавливает осторожный скрип оконной рамы на втором этаже и мягкие шаги на галерее.<br><br>Подобравшись к комнате Аманды, ты видишь, что дверь притворена неплотно, а изнутри доносится горячечный, сдавленный шёпот. Лизетта не побоялась пробраться в дом по приставной лестнице или через крышу сарая, прямо в спальню сестры!<br><br>— …он может запрещать сколько влезет, но запереть тебя не посмеет, — страстно шепчет Лизетта.<br><br>— Тише, Лизетка, если Стефан проснётся — будет буря… — в голосе Аманды звучит не столько испуг, сколько пьянящий азарт тайного неповиновения.<br><br>Ты с силой распахиваешь дверь. Свеча на столике тревожно колеблется от сквозняка. Аманда вздрагивает всем телом и испуганно прижимает руки к груди, пойманная с поличным. А вот Лизетта лишь невозмутимо откидывается на подушки, глядя на тебя с дерзкой, вызывающей улыбкой — она словно нарочно провоцировала этот ночной взрыв.'

    elseif $AmandaLizetteTextId = 'secret_choice_demand':
        $AmandaLizetteText = '— Это что за ночные фокусы?! — с глухой яростью цедишь ты, наступая на девушек. — Я русским языком сказал: ноги твоей здесь быть не должно! Аманда, ты совсем ум потеряла — водить тайных гостей по ночам в мой дом?! Отвечай, немедленно!<br><br>Аманда сперва робко пытается выдавить оправдание, лепеча что-то про забытую ленту, но под градом твоих резких упрёков окончательно замыкается в себе. Лицо её каменеет, губы сжимаются в тонкую упрямую нить, а во взгляде, устремлённом в пол, кристаллизуется холодная, недетская ненависть к твоему диктату.<br><br>Лизетта молча поднимается с кровати. Она даже не пытается спорить — её невозмутимое, презрительное молчание бьёт по твоему авторитету сильнее любых оскорблений.<br><br>— Уже ухожу, грозный хозяин, — роняет она с усмешкой и выскальзывает в коридор.<br><br>На этот вечер ты силой навязал свой порядок, но хрупкая нить доверия между тобой и сестрой натянулась до опасного предела — теперь Аманда видит в тебе не защитника, а тюремщика.'

    elseif $AmandaLizetteTextId = 'secret_choice_calm':
        $AmandaLizetteText = 'Ты делаешь глубокий вдох, подавляя вспышку раздражения, и закрываешь за собой дверь, не повышая голоса:<br><br>— Сказать, что я разочарован — ничего не сказать. Лизетта, лезть в чужой дом посреди ночи через окно — это не смелость, а глупость. Случись что на улице или в доме — виноват буду я. Аманда, я ведь просил по-человечески: без тайн за спиной. Неужели ты думаешь, что я враг тебе?<br><br>Аманда, сжавшаяся в комок в ожидании крика и ругани, медленно поднимает на тебя полные слёз глаза. В твоих словах нет оскорблений — лишь искренняя хозяйская тревога и горечь. Ей становится по-настоящему совестно за эту детскую эскападу.<br><br>— Прости, Стефан… — едва слышно шепчет она, теребя край одеяла. — Мы не хотели ничего дурного…<br><br>Лизетта впервые за всё время теряет свою нагловатую уверенность. Смутившись, она потупляет взор и неловко одёргивает рукав платья.<br><br>— Ладно… Пожалуй, я и правда перегнула палку, — нехотя признаёт гостья. — Я уйду через дверь, хозяин.<br><br>Когда Лизетта уходит, в комнате остаётся осадок неловкости, но стена непонимания между тобой и Амандой треснула: сестра видит, что ты держишь слово и готов говорить с ней как с равной.'

    elseif $AmandaLizetteTextId = 'secret_choice_wait':
        $AmandaLizetteText = 'Ты несколько долгих секунд молча смотришь на замерших девушек, взвешивая последствия. Скандал сейчас лишь распалит бунт и толкнёт сестру на глупости.<br><br>— Лизетта, вон из дома. Сейчас же, — ровно и глухо произносишь ты, посторонившись у двери. — А с тобой, Аманда, мы поговорим завтра на свежую голову. Ложись спать.<br><br>Аманда растерянно моргает, явно ожидавшая бурной ссоры, но в твоём холодном спокойствии чудится куда более весомая угроза. Лизетта молча подхватывает туфельки и бесшумно выскальзывает в коридор, не празднуя победы, но и не чувствуя себя побеждённой.<br><br>Ты закрываешь дверь, оставляя Аманду наедине со своими мыслями. Взятая пауза позволит страстям остыть, но ты понимаешь: влияние столичной гостьи пустило глубокие корни, и этот узел ещё придётся распутывать.'

    else:
        $AmandaLizetteText = '[Текст ветки Лизетты не найден: ' + $AmandaLizetteTextId + ']'
    end

    killvar '$AmandaLizetteTextId'
---

