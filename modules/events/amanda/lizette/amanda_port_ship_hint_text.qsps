! ================================================
! FILE: modules/events/amanda/lizette/amanda_port_ship_hint_text.qsps
! MODULE: events/amanda/lizette
! ! [AI-WORKED] Текст переработан / дополнен ассистентом 17.09.2026
! Тексты разговора о визите Аманды в порт (среда, столичный корабль)
! ================================================

#AmandaPortShipHintText
    $AmandaPortShipHintTextId = LCASE($ARGS[0])
    $AmandaPortShipHintText = ''

    if $AmandaPortShipHintTextId = 'melissa':
        $AmandaPortShipHintText = 'Мелисса даже не отрывает взгляда от гроссбуха, аккуратно занося очередную цифру на полях пожелтевшего пергамента. Лишь кончик гусиного пера на мгновение замирает в воздухе, а на губах мелькает снисходительная усмешка.<br><br>'
        $AmandaPortShipHintText += '— Ищешь нашу вертихвостку? — негромко роняет она, обмакнув перо в чернильницу. — Можешь не оглядывать углы: Аманды в зале сегодня не будет. Матушка расщедрилась и отпустила её к причалам. Столичный трёхмачтовик причалил, шум на весь залив, тюки с заморскими редкостями... Младшая чуть из фартука не выпрыгнула от восторга — побежала глазеть на столичные диковинки, словно дикарка за стеклянными бусами.<br><br>'
        $AmandaPortShipHintText += 'Мелисса тихо фыркает и перелистывает страницу, бросая на вас ироничный взгляд из-под каштановых кудрей:<br>'
        $AmandaPortShipHintText += '— Так что кружки с элем сегодня придётся таскать нам с тобой. Но пусть уж подышит солёным ветром раз в неделю, пока ещё верит, что за столичным шёлком скрываются прекрасные принцы, а не наглые матросы да пьяные приказчики.'

    elseif $AmandaPortShipHintTextId = 'sandra':
        $AmandaPortShipHintText = 'Сандра неторопливо протирает край дубовой стойки чистым льняным рушником, прислушиваясь к гулу зала. Заметив, как вы высматриваете сестру, мать мягко вздыхает и очерчивает пальцами священный знак Круга во славу Ильматера.<br><br>'
        $AmandaPortShipHintText += '— Аманду ищешь, Стефан? Не будет её сегодня в зале, — говорит Сандра ровным, спокойным голосом, в котором сквозит материнская забота. — Я сама позволила ей отлучиться в порт. Столичный корабль не каждый день в нашу гавань заходит — раз в неделю всего. Девочка все дни напролёт работает без устали, спины не разгибая. Пусть поглядит на заморские ткани да диковинки, развеется немного.<br><br>'
        $AmandaPortShipHintText += 'Она откладывает полотенце и строго, по-хозяйски смотрит вам прямо в глаза:<br>'
        $AmandaPortShipHintText += '— Мелисса, конечно, недовольно бурчит, что лишние руки из зала увели. Но молодость коротка, Стефан. Если сам решишь дойти до причала за припасами — присмотри там за сестрой краем глаза. В порту народ шумный да разношёрстный, матросы после долгого плавания глазами так и рыщут. Пусть порадуется, но чтоб к вечеру, до заката, была дома цела и невредима.'

    elseif $AmandaPortShipHintTextId = 'hall_note':
        $AmandaPortShipHintText = 'Аманды сегодня в зале нет: в порт прибыл столичный корабль, и Сандра сделала исключение, отпустив младшую дочь к причалам поглядеть на заморские товары и редкости.'

    else:
        $AmandaPortShipHintText = 'Аманды сегодня нет в трактире — Сандра отпустила её в порт поглядеть на столичный корабль с заморскими диковинками.'
    end

    killvar '$AmandaPortShipHintTextId'
---