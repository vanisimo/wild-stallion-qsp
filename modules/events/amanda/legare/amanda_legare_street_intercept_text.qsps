#MelissaTalkAboutLegareStreetClashActionText
    $MelissaTextChoice = LCASE($ARGS[0])

    if $MelissaTextChoice = 'plan':
        *pl 'Вы усмехаетесь:'
        *pl '— Раз ты такая умная — подскажи, как прижать торгаша без кулаков?'
        *pl 'Мелисса довольно щурится, оценив вашу готовность слушать:'
        *pl '— Во-первых, не лезть на рожон. Легаре силён связями и деньгами, но у него есть уязвимое место — его собственная лавка и... его супруга Кларисса. Она далеко не глупа и давно устала от его выходок. Если подойти к делу с умом, через Клариссу можно выведать такие подробности его бухгалтерии, что месье сам приползёт договариваться о скидках на вино.'
    elseif $MelissaTextChoice = 'amanda':
        *pl '— Что нам с Амандой делать? Она как с цепи сорвалась.'
        *pl 'Мелисса чуть хмурится, теряя ироничный тон:'
        *pl '— Аманда жаждет внимания. Ей осточертели серые будни и грязные кружки, а Легаре для неё — олицетворение красивой жизни из романов. Если просто запереть её — она сбежит в окно. Нужно дать ей почувствовать собственную ценность здесь, в трактире. И не спускать глаз. Я, так и быть, пригляжу за её перемещениями.'
    elseif $MelissaTextChoice = 'force':
        *pl 'Вы сжимаете кулак:'
        *pl '— Такие наглецы понимают только хорошую зуботычину. Если будет крутиться рядом — получит ещё раз.'
        *pl 'Мелисса закатывает глаза с глубоким вздохом:'
        *pl '— Святой Ильматер, дай мне терпения... Мужчины не меняются. Помахать кулаками проще, чем подумать на два хода вперёд. Только не удивляйся потом, когда стража явится опечатывать трактир по доносу "пострадавшего гражданина".'
    elseif $MelissaTextChoice = 'business':
        *pl 'Вы деловито замечаете:'
        *pl '— Скандалы нам ни к чему. Если клиенты испугаются потасовок, выручка упадёт, а запасы вина надо пополнять.'
        *pl 'Мелисса уважительно кивает, одобрительно улыбнувшись:'
        *pl '— Вот это уже речь настоящего хозяина, а не драчливого мальчишки. Слухи улягутся за пару дней, если мы встретим гостей хорошим элем и безупречным обслуживанием. А по поставкам вина я проверю другие амбары у порта — есть пара купцов, готовых сбить спесь с Легаре.'
    else:
        *pl 'Мелисса с лёгкой улыбкой возвращается к своим бухгалтерским записям.'
    end

    killvar '$MelissaTextChoice'
---
