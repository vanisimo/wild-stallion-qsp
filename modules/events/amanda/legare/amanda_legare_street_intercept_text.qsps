! [AI-WORKED] Текст переработан / дополнен ассистентом 16.09.2026
! Тексты утренних разговоров после ночной стычки с Легаре
! ================================================

#AmandaTalkAboutLegareStreetClashIntroText
    if $FridayClashType = 'win':
        *pl 'Аманда стоит у стойки, нервно перебирая деревянные кружки.'
        *pl 'Завидев вас, она невольно бросает взгляд на ваши сбитые в драке костяшки пальцев, и щёки её слегка розовеют.'
        *pl '— Ты вчера... чуть не убил его, Стефан. Зачем надо было устраивать это побоище на глазах у полуночных зевак?'
        *pl 'Она сердито поджимает губы, но в голосе нет прежней спеси:'
        *pl '— Теперь Альбер затаит злобу, а на меня в городе будут пальцем показывать как на причину кулачного боя!'
    elseif $FridayClashType = 'defeat':
        *pl 'Аманда хмуро протирает деревянный стол, но её глаза то и дело возвращаются к свежей ссадине на вашем виске.'
        *pl '— Ты выглядишь ужасно, Стефан... Ну и зачем надо было кидаться на него с кулаками?'
        *pl 'Она сердито швыряет тряпку в ведро, но в глазах мелькает искреннее беспокойство:'
        *pl '— Он взрослый, сильный купец, а ты... чуть шею себе не свернул на этих булыжниках! Я же не просила тебя драться за меня!'
    elseif $FridayClashType = 'jail':
        *pl 'Аманда кусает губы и избегает прямого взгляда, комкая край фартука.'
        *pl '— Мама с утра вся на иголках, только и твердит про отца Герхарда и позор перед приходом... Ты провёл ночь за решёткой из-за меня, Стефан.'
        *pl 'Она поднимает на вас виноватые глаза:'
        *pl '— Зачем ты полез в бутылку со стражниками? Мог ведь просто заплатить или разойтись по-хорошему!'
    elseif $FridayClashType = 'letgo' or $FridayClashType = 'police_letgo':
        *pl 'Аманда холодно и независимо смотрит на вас, демонстративно скрестив руки на груди.'
        *pl '— О чём нам разговаривать, Стефан? Вчера ночью ты стоял как истукан и позволил Альберу увести меня.'
        *pl 'Она язвительно вскидывает подбородок:'
        *pl '— Ты даже слова против не сказал, словно тебе вовсе плевать, что со мной будет в темноте переулка. А теперь вдруг вспомнил, что ты хозяин и старший брат?'
    else:
        *pl 'Аманда недовольно поджимает губки, вспоминая ночные события.'
        *pl '— Ну и переполох ты устроил со стражей... Вся улица на уши встала из-за ваших криков с Альбером. Хорошо хоть кошельком отделались, а не нарами в ратуше.'
    end
