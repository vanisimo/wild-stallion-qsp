#SandraTalkAboutLegareStreetClashActionText
    $SandraTextChoice = LCASE($ARGS[0])

    if $SandraTextChoice = 'honor':
        *pl 'Вы твёрдо смотрите матери в глаза:'
        *pl '— Я хозяин этого дома, мама. И пока я дышу, ни один наглый купец не посмеет лапать мою сестру в подворотнях. Если придётся драться снова — я буду драться.'
        *pl 'Сандра сглатывает комок в горле. В её глазах сквозь тревогу проступает тёплая материнская гордость:'
        *pl '— Ты становишься совсем взрослым, Стефан... Вылитый отец в лучшие годы. Пусть Ильматер хранит тебя от беды. Только будь осторожен, сынок. Сила силой, а мир вокруг очень коварен.'
    elseif $SandraTextChoice = 'revenge':
        *pl 'Вы мрачно усмехаетесь:'
        *pl '— Легаре думает, что монеты дают ему право на всё. Но если он посмеет навредить нам через поставки — найдём, чем ответить. В городе он не единственный, кто возит вино.'
        *pl 'Сандра призадумывается, одобрительно кивая:'
        *pl '— Тут ты прав. Старый винодел с мельницы давно предлагал возить своё яблочное и сливовое сусло. Надо будет разузнать цены... Не позволим Альберу выкручивать нам руки.'
    elseif $SandraTextChoice = 'strict':
        *pl 'Вы делитесь своим решением:'
        *pl '— Главная беда — не Легаре, а Аманда. Ей льстят дорогие подарки и сладкие речи. С этого дня она будет загружена работой на кухне и в зале от зари до заката, чтобы на гулянки сил не оставалось.'
        *pl 'Сандра истово кивает:'
        *pl '— Истинно так. Праздность — мать греха, так отец Герхард всегда учит. Я приставлю её к котлам и тесту, пусть знает цену честному труду.'
    elseif $SandraTextChoice = 'calm':
        *pl 'Вы мягко приобнимаете мать за плечи:'
        *pl '— Всё уже позади, мама. Пошумят на базаре день-два и забудут, у людей своих забот хватает. Главное, что все целы и трактир работает.'
        *pl 'Сандра с облегчением выдыхает, прислоняясь к вашему плечу:'
        *pl '— Твои бы слова да Ильматеру в уши... Ладно, пойду на кухню, пироги уже подошли.'
    else:
        *pl 'Сандра выслушивает вас и тихо вздыхает, возвращаясь к очагу.'
    end

    killvar '$SandraTextChoice'
