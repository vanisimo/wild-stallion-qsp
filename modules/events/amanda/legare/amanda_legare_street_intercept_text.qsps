#AmandaTalkAboutLegareStreetClashActionText
    $AmandaTextChoice = LCASE($ARGS[0])

    if $AmandaTextChoice = 'warn':
        *pl 'Вы кладёте ладонь на стойку и говорите твёрдо, без лишней злобы:'
        *pl '— Легаре вдвое старше тебя, Аманда. У него за плечами десятки таких интрижек, а у тебя — только наивность и тяга к лести. Для него ты просто смазливая подавальщица из таверны, которой можно похвастаться за бокалом вина. А расплачиваться за позор придётся всей семье.'
        *pl 'Аманда закусывает губу. В её взгляде на мгновение проскальзывает растерянность — слова явно задели за живое, хоть гордость и мешает ей признать это открыто.'
    elseif $AmandaTextChoice = 'shame':
        *pl 'Вы резко отчитываете сестру:'
        *pl '— Ты хоть понимаешь, каково матери слушать утренние пересуды на базаре? Ты бегаешь за чужими женатыми купцами по ночным закоулкам, словно портовая вертихвостка!'
        *pl 'Аманда мгновенно вспыхивает, её глаза наполняются слезами ярости:'
        *pl '— Не смей меня так называть! Ты сам не святой, а строишь из себя праведника перед всем миром! Я не крепостная в этом трактире, слышишь?!'
    elseif $AmandaTextChoice = 'care':
        *pl 'Вы устало вздыхаете и делаете шаг ближе, смягчив голос:'
        *pl '— Думаешь, мне в радость соваться под чужие кулаки или лаяться со стражниками? Ты моя сестра, глупая. Если с тобой что-то случится в темноте за углом — кто за тебя заступится, кроме меня?'
        *pl 'Аманда замирает. Вся её колючая спесь осыпается, щёки заливает тёплый румянец, и она тихо шепчет, уткнувшись взглядом в пол:'
        *pl '— Я... я знаю, Стефан. Прости. Я правда не хотела, чтобы всё так вышло...'
    elseif $AmandaTextChoice = 'work':
        *pl 'Вы строго указываете на кухонную дверь:'
        *pl '— Хватит пустых разговоров. До следующей ярмарки из трактира после заката — ни шагу. Бери поднос, на кухне остывает похлёбка для гостей. За работой дурные мысли быстрее из головы выветрятся.'
        *pl 'Аманда сердито фыркает и с грохотом хватает поднос, но перечить вслух не решается.'
    else:
        *pl 'Аманда выслушивает вас и молча возвращается к работе в зале.'
    end

    killvar '$AmandaTextChoice'
