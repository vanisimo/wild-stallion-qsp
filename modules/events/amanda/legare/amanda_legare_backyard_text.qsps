    if tmpFinishSexType = 5:
        *pl 'В самый последний миг купец с хриплым стоном выдёргивает ствол из её тугой попки и щедро заливает горячим семенем круглые девичьи ягодицы, поясницу и ложбинку между бёдер.'
        *pl ' '
        *pl 'Аманда сладостно выдыхает, опираясь на бочку и чувствуя, как по её коже медленно стекают густые белые струи.'
        *pl 'Легаре довольно любуется плодами своей страсти, поглаживая мокрую кожу сестры: «Вот так, моя красавица... Настоящее сокровище!»'
        *pl 'Аманда кокетливо посмеивается, аккуратно промокая бёдра шёлковым платком.'
    else:
        *pl 'В самый последний миг купец резко выдёргивает ствол из девушки и с хриплым стоном изливается прямо на её круглые девичьи ягодицы и поясницу.'
        *pl ' '
        *pl 'Тугие белые струи семени щедро покрывают гладкую кожу Аманды, медленно стекая каплями на дубовые клёпки бочки.'
        if AmandaLegareBackyardCount <= 1:
            *pl 'Сестра облегчённо выдыхает, чмокает купца в щёку и берёт платок, чтобы стереть горячие капли:'
            *pl '— Вот и умница, что вовремя вытащил! А то как бы я потом перед матушкой и братом оправдывалась, если б брюхо выросло?'
        else:
            *pl 'Легаре любовно проводит ладонью по залитой семенем попке Аманды, довольно выдыхая:'
            *pl '— Ах, какая же ты сладкая кобылка... Настоящее сокровище!'
            *pl 'Аманда кокетливо посмеивается, промокая горячие капли кружевным платочком.'
        end
    end
    killvar 'tmpFinishSexType'
