#AmandaLegareBackyardStep4Text
    tmpSexType = $ARGS[0]

    if tmpSexType = 0 or tmpSexType = 1:
        if AmandaLegareBackyardCount <= 1:
            *pl 'Старания Аманды приносят скорые плоды. Дыхание виноторговца сбивается на отрывистый, хриплый хрип.'
            *pl ' '
            *pl 'Его бёдра начинают самопроизвольно подёргиваться, подаваясь навстречу девичьему рту, а пальцы стискивают её волосы, прижимая девичье личико всё ближе к паху. Аманда чувствует, как ствол под её языком наливается каменной твёрдостью и вот-вот взорвётся семенем.'
        else:
            *pl 'Ритмичные ласки сестры доводят купца до исступления. Тяжело дыша, он ласково, но настойчиво придерживает её затылок:'
            *pl '— Ох, чертовка... как же сладко сосёшь! Сейчас брызнет... сглотай всё, Амандочка, до последней капельки!'
            *pl ' '
            if FamilyCorruptionStage <= 1:
                *pl 'Аманда сосредоточенно кивает, стараясь изо всех сил удержать горячий ствол в губах.'
            elseif FamilyCorruptionStage <= 3:
                *pl 'Аманда усердно ускоряет движения, громко чмокая и постанывая вокруг напряжённого ствола.'
            else:
                *pl 'Аманда похотливо мычит, прижимаясь к его паху всем лицом и с жадностью выжидая горячую струю семени.'
            end
        end

    elseif tmpSexType = 2:
        *pl 'Дав сестре немного времени, чтобы перевести дух и привыкнуть к непривычной полноте внутри, Легаре начинает двигаться.'
        *pl 'Сперва медленно, с тягучей осторожностью, а затем всё быстрее и размашистее он вбивает свой ствол в её тесное, сжимающее нутро.'
        *pl ' '
        *pl 'Боль быстро растворяется в накатившей волне сладострастия. Аманда перестаёт хныкать; по её телу пробегает дрожь, щёки пылают, и она сама начинает судорожно двигать попкой навстречу каждому толчку купца, постанывая от сладкого чувства.'

    elseif tmpSexType = 3:
        *pl 'Легаре мощно вбивает свой член в Аманду, отчего дворик наполняется хлюпающими звуками текущей пиздёнки. В перерыве между хриплыми выдохами он жадно шепчет ей в ухо:'
        *pl '— Ох, милая... А ведь ты уже совсем не девочка! Кто же этот счастливец, что сорвал твой невинный бутон раньше меня?'
        *pl ' '
        if FamilyCorruptionStage <= 2:
            *pl 'Аманда смущённо и виновато хихикает прямо в ночную тьму, подмахивая его толчкам:'
            *pl '— Ни за что не угадаешь, Альберчик... Это был мой ненасытный братец Стефан! Он взял меня прямо в моей кровати!'
        else:
            *pl 'Аманда нагло и громко хохочет, смакуя каждую деталь:'
            *pl '— Ни за что не угадаешь, Альберчик! Это был мой ненасытный братец Стефан! Он драл меня прямо в спальне, пока мать не слышала! А ты сможешь выебать меня крепче, чем он?!'
        end
        *pl ' '
        *pl 'Такое откровение действует на купца возбуждающе: в глазах его вспыхивает похотливое пламя, и он начинает вколачивать свой член в сестру с удвоенной скоростью, доводя девушку до визга.'

    elseif tmpSexType = 5:
        *pl 'Дав сестре немного привыкнуть к натяжению внутри, Легаре начинает мерно двигаться вперёд и назад.'
        *pl 'В тишине ночного двора отчётливо слышны чавкающие звуки масла и глухие шлепки его бёдер о круглые ягодицы Аманды.'
        *pl ' '
        *pl 'Сестра прерывисто дышит, уткнувшись лицом в сгиб локтя. Острое ощущение наполненности разжигает в ней пожар возбуждения:'
        *pl '— М-м-м... Ильматер видит... как это неприлично... и как сладко... Альберчик, двигайся, не останавливайся!'
        *pl ' '
        *pl 'Купец жадно хрипит, сжимая её талию ладонями и с упоением вбивая свой ствол в её тугой, горячий зад:'
        *pl '— Ох, чертовка... Какая же ты ненасытная! Ни у одной женщины я такой узкой и горячей попки не встречал!'
        if FamilyCorruptionStage >= 3:
            *pl 'Аманда стонет в голос, сама подаваясь назад на каждый толчок и с наслаждением сжимая сфинктер вокруг его ствола.'
        end

    else:
        *pl 'Ритм движений купца становится по-настоящему быстрым.'
        *pl ' '
        *pl 'Аманда прерывисто дышит, закусив нижнюю губу от накатившей волны оргазма. Её лоно судорожно пульсирует, сжимая член купца, а Легаре с хриплым рыком ускоряет удары, чувствуя, как внутри него закипает разрядка.'
        if FamilyCorruptionStage >= 4:
            *pl 'Сестра громко, не таясь стонет на весь переулок, призывая ночных прохожих слушать, как её берут на заднем дворе.'
        end
    end
    killvar 'tmpSexType'
