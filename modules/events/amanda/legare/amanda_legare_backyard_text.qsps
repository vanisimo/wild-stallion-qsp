#AmandaLegareBackyardInterruptText
    ! $ARGS[0] — AmandaNesluh (0: испуг, 1: уход в дом, 2: язвительное продолжение)
    tmpNesluh = $ARGS[0]

    *pl 'Не в силах больше выносить этого непотребства, ты во всё горло рявкаешь из-за штабеля бочек:'
    *pl '— Аманда! А ну прочь от него! Какого дьявола ты творишь посреди ночи на чужом дворе?! Живо домой!'
    *pl ' '

    if tmpNesluh = 0:
        *pl 'Аманда испуганно вскрикивает, роняя юбку, и в ужасе отскакивает на шаг. Покраснев до корней волос, она судорожно запахивает корсаж платья:'
        *pl '— Стефан?! Ильматер всеблагой... это... это вовсе не то, что ты подумал!'
        *pl 'Пока опешивший Легаре спешно натягивает и застёгивает штаны, сестра мышкой проскальзывает в калитку и со всех ног мчится в сторону трактира.'
    elseif tmpNesluh = 1:
        *pl 'Аманда лишь раздражённо закатывает глаза и шепчет купцу:'
        *pl '— Альберчик, мой несносный братец караулит нас за бочками. Пойдём лучше в дом, там он нам точно не помешает.'
        *pl 'Купец понимающе кивает, отпирает заднюю дверь лавки, и парочка быстро скрывается внутри дома, задвинув за собой массивный засов.'
    else:
        *pl 'Аманда даже не думает прерываться. Она дерзко и вызывающе выкрикивает:'
        *pl '— Что, завидно стало, Стефан?! Думаешь, раз трактиром заправляешь, можешь мне указывать?! Смотри и завидуй!'
        *pl 'И она с удвоенным упоением продолжает ласкать купца прямо на твоих глазах.'
    end
    killvar 'tmpNesluh'
---

#AmandaLegareBackyardRevealText
    *pl 'Желая не поднимать крика, но дать понять, что они не одни, ты нарочно толкаешь ногой тяжёлый камень на вершине штабеля. Тот с гулким стуком падает оземь.'
    *pl ' '
    *pl 'Парочка вздрагивает и оборачивается на шум.'
    *pl ' '
    if sluttiness['amanda'] >= 35 or FamilyCorruptionStage >= 4:
        *pl 'Аманда мгновенно угадывает твоё присутствие в тени. Лукаво улыбнувшись в сторону бочек, она демонстративно оглаживает голое бедро и подмигивает невидимому зрителю.'
        *pl 'Легаре хрипло усмехается: «Наверное, кошка бродит... На чём мы остановились, моя прелесть?»'
    else:
        *pl 'Аманда испуганно ёжится от ночного шороха:'
        *pl '— Ой, Альбер... Тут кто-то ходит, мне страшно стало. Пойдём лучше в дом!'
        *pl 'Она утягивает купца к порогу, и тяжёлая дубовая дверь захлопывается перед твоим носом.'
    end
