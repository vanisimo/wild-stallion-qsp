#AmandaLegareBackyardFinishInsideText
    tmpFinishSexType = ARGS[0]

    if tmpFinishSexType = 5:
        *pl 'Легаре делает глубокий, мощный толчок, вонзаясь в тугую девичью попку до самого упора, и замирает с хриплым победным стоном.'
        *pl ' '
        *pl 'Горячее семя толчками изливается прямо в прямую кишку Аманды. Девушка сладко вскрикивает, чувствуя обжигающее тепло, заполняющее её зад.'
        *pl 'Когда купец медленно извлекает член, из зияющей, растянутой розовой дырочки вытекает густая струйка белого семени вперемешку с маслом, стекая по ложбинке бёдер.'
        *pl ' '
        *pl '— Ух... Альберчик... — тяжело переводя дух, шепчет Аманда и кокетливо оглядывается через плечо. — Полная попка твоего семени... Зато теперь точно никакого ребёночка не будет!'
        *pl 'Купец с самодовольной улыбкой оглаживает её бедро: «Вот видишь, золотце! И сладко, и без лишних хлопот. Ты была великолепна!»'
    else:
        *pl 'Легаре делает последний толчок, вонзаясь в девушку особенно глубоко, и замирает, судорожно содрогаясь всем телом.'
        *pl ' '
        *pl 'Горячее мужское семя толчками изливается глубоко в разгорячённое нутро Аманды. Девушка стонет, чувствуя, как её наполняют обжигающие волны семени.'
        *pl 'Когда купец со вздохом медленно извлекает ствол, белые струйки спермы, смешанные с её соками, медленно вытекают наружу и стекают по бёдрам.'
        *pl ' '
        *pl '— Альберчик... — шепчет Аманда, коснувшись пальчиками липкой влаги. — Ты прямо в меня всё спустил? А я ребёночка от этого не нагуляю?'
        if AmandaLegareBackyardCount <= 1:
            *pl '— Ну что ты, прелестница, — фальшиво и сладко улыбается купец, торопливо оглаживая её бедро и застёгивая штаны. — С одного раза дитя не зарождается, поверь моему опыту! Ты была просто божественна.'
        else:
            *pl '— Не бойся, прелестница, — самодовольно посмеивается купец, застёгивая пояс. — Если что, дядя Альбер в беде тебя не оставит. Да и Стефан твой поможет, коли что. Зато как сладко было, а?'
            if FamilyCorruptionStage >= 3:
                *pl 'Аманда довольно поглаживает сытый живот и хихикает:'
                *pl '— И правда сладко... Пусть твоё семя побулькает внутри. Лишь бы братик не догадался!'
            end
        end
    end
    killvar 'tmpFinishSexType'
