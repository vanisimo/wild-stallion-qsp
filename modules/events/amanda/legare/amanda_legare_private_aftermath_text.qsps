! modules/events/amanda/legare/amanda_legare_private_aftermath.qsps
! ================================================

#AmandaLegarePrivateAftermathIntroText
    if PlayerKnows_AmandaLegarePrivateTalk = 1:
        *pl 'Вы застаёте Аманду в пустом зале перед началом смены, когда она неторопливо расставляет солонки по столам.'
        *pl 'Услышав ваши шаги и заметив прямой, выжидающий взгляд, сестра тут же настораживается, а её пальцы судорожно комкают льняную салфетку.'
        *pl ' '
        *pl '— Ты ведь о вчерашнем хочешь спросить, да? — тихо произносит она, упрямо вскидывая подбородок, хотя в глазах её мелькает неприкрытая тревога. — Стефан, мы просто постояли у колоннады и перекинулись парой слов. Ничего дурного я не сделала, клянусь Ильматером.'
    else:
        *pl 'Аманда натирает дальний дубовый стол, тихонько напевая себе под нос вчерашнюю праздничную мелодию.'
        *pl 'На её щеках ещё горит румянец, а в движениях сквозит непривычная, рассеянная мечтательность.'
        *pl ' '
        *pl 'Заметив ваше появление, сестра вздрагивает и торопливо хватается за кувшин, делая вид, что полностью поглощена работой. Вы ещё не произнесли ни слова, но её настороженность выдаёт её с головой: вчерашний разговор с Легаре оставил в её душе глубокий след, и она явно боится прямых расспросов.'
    end
---

#AmandaLegarePrivateAftermathActionText
    $PrivateAftermathTextChoice = LCASE($ARGS[0])

    if $PrivateAftermathTextChoice = 'calm_ask':
        *pl 'Вы присаживаетесь на край лавки и заговариваете спокойно, по-братски, без окриков и показной строгости.'
        *pl ' '
        *pl 'Аманда долго смотрит в пол, перебирая пальцами кружевную оторочку передника. Спокойный, доверительный тон действует лучше любых угроз: плечи девушки опускаются, и она нерешительно признаётся:'
        *pl '— Альбер... то есть, месье Легаре... он говорил, что мне не место среди сальных кружек и пьяных выкриков. Сказал, что у меня стать настоящей дамы, и на столичном балу на меня бы все заглядывались. Спрашивал, нравится ли мне шёлк, угостил засахаренным миндалём...'
        *pl 'Она поднимает на вас смущённые глаза:'
        *pl '— Стефан, мне просто было приятно, понимаешь? Со мной ещё никто не говорил как со взрослой красавицей. Я правда не хотела ничего дурного. Просто боялась, что ты рассердишься и запретишь ходить на площадь.'

    elseif $PrivateAftermathTextChoice = 'demand_truth':
        *pl 'Вы упираетесь ладонями в столешницу и жёстко требуете ответа: о чём таком шептался с ней виноторговец за спиной семьи?'
        *pl ' '
        *pl 'Аманда мгновенно закрывается в глухую оборону. Её лицо вспыхивает возмущённым румянцем, а брови сердито сходятся к переносице:'
        *pl '— Правду?! Да какая тебе разница?! Мы перекинулись парой фраз о танцах и погоде, ясно тебе?! Или я теперь за каждый вдох должна перед тобой на коленях отчитываться?!'
        *pl 'Она с силой швыряет тряпку в ведро с водой, обдав брызгами пол:'
        *pl '— Ты мне брат, а не тюремщик, Стефан! Хватит лезть во всё, что меня касается!'
        *pl ' '
        *pl 'Правды вы не добились, но стало очевидно: теперь сестра будет прятать любые связи с купцом с удвоенным усердием.'

    elseif $PrivateAftermathTextChoice = 'indirect_ask':
        *pl 'Вы издалека заводите разговор о вчерашнем вечере: расспрашиваете о музыке, хвалите праздничную выпечку и как бы невзначай интересуетесь, с кем она успела поболтать у торговых рядов.'
        *pl ' '
        *pl 'Аманда отвечает слишком бойко и гладко, словно заранее отрепетировала каждое слово перед зеркалом. Музыканты были громкими, портниха Ирма надела нелепый чепец, а о господине Легаре — ни единого звука, будто его и вовсе не существовало на площади.'
        *pl ' '
        *pl 'Это нарочитое, подчеркнутое молчание выдаёт её вернее любого признания: сестра прекрасно понимает двусмысленность вчерашнего разговора и старательно обходит острые углы.'

    elseif $PrivateAftermathTextChoice = 'pretend_not_know':
        *pl 'Вы решаете не выдавать своей осведомлённости. Окинув зал хозяйским взглядом, вы просто хвалите сестру за расторопность и говорите пару ободряющих слов.'
        *pl ' '
        *pl 'Аманда заметно облегчённо выдыхает. Напряжение в её лице тает, а в уголках губ появляется плутовская, самодовольная улыбка: она искренне верит, что сумела провести старшего брата и её маленькая тайна осталась нераскрытой.'
        *pl ' '
        *pl 'Она весело подхватывает поднос и порхает между столами, не подозревая, что её уверенность в собственной безнаказанности только развязывает купцу руки.'

    elseif $PrivateAftermathTextChoice = 'remind_instruction':
        *pl 'Вы опираетесь о стойку и веско напоминаете сестре о том, что Легаре — опытный, тёртый купец, привыкший покупать всё за звонкую монету, и что девичья честь в трактире дороже любых заморских подарков.'
        *pl ' '
        *pl 'Аманда слушает, понурив голову и глядя на носки своих башмачков.'
        *pl 'Если вы и раньше наставляли её держаться скромно — в её глазах мелькает искреннее раскаяние: слова старшего брата заставляют её призадуматься, а романтический флёр купца слегка блекнет.'
        *pl 'Однако если бунтарский дух в ней уже силён, на её губах проскальзывает едва заметная упрямая усмешка. Она покорно кивает на словах, но внутри остаётся при своём.'

    elseif $PrivateAftermathTextChoice = 'watch_closer':
        *pl 'Вы смотрите сестре прямо в глаза и холодно предупреждаете: отныне ни один её разговор с господином Легаре не останется без вашего пристального внимания.'
        *pl ' '
        *pl 'Аманда резко выпрямляется, её пальцы впиваются в край стола:'
        *pl '— Значит, надзирателя решил из себя строить?! Глаз с меня не спускать, как с воровки какой-то?!'
        *pl 'Она тяжело дышит, глядя на вас с неприкрытой обидой:'
        *pl '— Ну и смотри! Подавись своим надзором! Только не думай, что сможешь держать меня на привязи вечно!'
        *pl 'Она демонстративно отворачивается и уходит в кладовую, хлопнув дверью.'

    else:
        *pl 'Аманда отвечает коротко и отстранённо, стараясь как можно быстрее свернуть неудобный разговор.'
    end

    killvar '$PrivateAftermathTextChoice'
---

#MelissaTalkAboutAmandaLegarePrivateText
    *pl 'Мелисса сидит за угловым столом, аккуратно раскладывая гроссбух и счёты. Услышав ваш рассказ о том, как Легаре увивался за младшей сестрой после танцев, она ничуть не удивляется — лишь устало и выразительно закатывает глаза, откладывая гусиное перо:'
    *pl ' '
    *pl '— Кто бы сомневался. Наш почтенный месье Легаре возомнил себя трубадуром из столичного романа, а Аманда тут же развесила уши. Ей кажется, что если холёный мужчина в шёлке сыплет банальностями о «глазах цвета южной ночи», то это возвышенная поэзия, а не примитивная купеческая охота за свежим личиком.'
    *pl ' '
    *pl 'Она подпирает подбородок ладонью и переводит на вас проницательный, серьёзный взгляд:'
    *pl '— Ты же знаешь её натуру, Стефан. Аманда падка на блеск, подарки и лесть. Ей хочется чувствовать себя взрослой дамой, а не девчонкой на побегушках у мойки. Если пустить дело на самотёк, Легаре обведёт её вокруг пальца за пару недель. Я могу взять на себя часть смен в зале и приглядывать за сестрой. Уж поверь, при мне этот павлин быстро подавится своими сладкими речами.'
---

#ClarissaTalkAboutAmandaLegarePrivateText
    *pl 'Госпожа Легаре сидит в полумраке у витражного окна, мелкими глотками потягивая пряное вино. Услышав ваше замечание о том, как её супруг настойчиво уединялся с юной Амандой после танцев, она на мгновение замирает. Тонкие пальцы сжимают оловянный кубок так, что белеют костяшки.'
    *pl ' '
    *pl '— Альбер в своём репертуаре, — с горькой, ледяной усмешкой роняет она, не поднимая глаз. — Он привык считать себя хозяином всего, на что падает его взгляд, и искренне верит, что любая молоденькая девушка должна млеть от одной его улыбки.'
    *pl ' '
    *pl 'Она медленно поднимает на вас взгляд — породистый, усталый, в котором за светской маской мерцает опасный огонёк уязвлённой гордости:'
    *pl '— Берегите сестру, Стефан. Для Альбера это всего лишь охотничья забава, прихоть сытого господина. Но если вы намерены показать ему, что не всё в этом городе продаётся за его золото... что ж, возможно, наши с вами интересы в этом вопросе совпадают куда сильнее, чем кажется.'
---
