! ================================================
! FILE: modules/events/amanda/legare/amanda_legare_talk_text.qsps
! MODULE: events/amanda/legare
! [AI-WORKED] Текст переработан / дополнен ассистентом 13.09.2026
! Тексты разговоров после события "Легаре замечает Аманду"
! Используется кодом:
! modules/events/amanda/legare/amanda_legare_talk.qsps
!
! Сюда вынесены диалоги, чтобы не смешивать код и текст.
! ================================================

#AmandaTalkAboutLegareIntroText
    *pl 'Аманда сперва делает вид, что не понимает, о чём вы хотите поговорить.'
    *pl 'Но стоит вам упомянуть Легаре, как она тут же отводит взгляд.'
    *pl '— Он просто смотрел. Все на танцах смотрят друг на друга, — говорит она слишком быстро.'
---

! ================================================
! FILE: modules/events/dance/amanda_legare_talk_text.qsps
! Ответы Аманды на выбор Стефана
! ================================================

#AmandaTalkAboutLegareActionText
    $AmandaLegareTextChoice = LCASE($ARGS[0])

    if $AmandaLegareTextChoice = 'ask':
        *pl 'Вы не начинаете с запретов.'
        *pl '— Ты сама видела, как он на тебя смотрел?'
        *pl 'Аманда пожимает плечами, но слишком быстро.'
        *pl '— Может, и видела. А что такого? Я же ничего не делала.'
        *pl 'Врёт не до конца. И это уже кое-что: она не закрывается сразу, значит, разговор ещё можно вести по-человечески.'
    elseif $AmandaLegareTextChoice = 'keep_distance':
        *pl 'Вы говорите ей держать дистанцию.'
        *pl '— Легаре не тот человек, с которым стоит играть в простые взгляды. Будь вежливой, если надо, но наедине с ним не оставайся.'
        *pl 'Аманда фыркает, но слушает.'
        *pl '— Хорошо, хозяин. Не улыбаться, не смотреть, не дышать рядом с винной лавкой.'
        *pl 'Язвить она умеет, но смысл, похоже, уловила.'
    elseif $AmandaLegareTextChoice = 'trust_amanda':
        *pl 'Вы решаете не давить.'
        *pl '— Ты уже взрослая. Я не хочу стоять у тебя над душой, но и дурой тебя считать не собираюсь. Сама видишь, где человек просто вежлив, а где уже примеряется.'
        *pl 'Аманда смотрит на вас с неожиданным подозрением.'
        *pl '— То есть ты мне доверяешь?'
        *pl 'Вот так новость. Подействовал не запрет, а спокойное слово. Теперь главное, чтобы это не вышло боком.'
    elseif $AmandaLegareTextChoice = 'forbid':
        *pl 'Вы рубите сплеча.'
        *pl '— С Легаре больше не разговариваешь. Ни на танцах, ни в зале, ни у порога. Всё.'
        *pl 'Аманда вспыхивает мгновенно.'
        *pl '— Ты мне не отец! И не можешь указывать, с кем мне перемолвиться словом!'
        *pl 'Вот и поговорили. Легаре теперь опасен не только сам по себе, но и как запретный плод.'
    else:
        *pl 'Аманда выслушивает вас, но не даёт понять, насколько серьёзно восприняла разговор.'
    end

    killvar '$AmandaLegareTextChoice'
---

! ================================================
! FILE: modules/events/dance/amanda_legare_talk_text.qsps
! Вступление Мелиссы
! ================================================

#MelissaTalkAboutLegareIntroText
    *pl 'Мелисса ждала, что вы вернётесь к этому разговору.'
    *pl 'Она говорит тихо, но собранно:'
    *pl '— Легаре не просто посмотрел на Аманду. Он смотрел так, будто уже решил, что имеет право попробовать.'
    *pl 'Мелисса на миг хмурится.'
    *pl '— И Кларисса это тоже видела.'
---

! ================================================
! FILE: modules/events/dance/amanda_legare_talk_text.qsps
! Ответы Мелиссы
! ================================================

#MelissaTalkAboutLegareActionText
    $MelissaLegareTextChoice = LCASE($ARGS[0])

    if $MelissaLegareTextChoice = 'what_seen':
        *pl '— Что ты видела?'
        *pl 'Мелисса даже не делает вид, будто удивлена вопросом.'
        *pl '— Он смотрел на неё не как на подавальщицу из трактира. Как на лёгкую добычу, которую можно увлечь красивыми речами.'
        *pl 'Она хмурится.'
        *pl '— И Аманда это заметила. Сначала смутилась, а потом перестала отводить глаза. Вот это мне и не нравится.'
    elseif $MelissaLegareTextChoice = 'clarissa':
        *pl '— А Кларисса?'
        *pl 'Мелисса усмехается краем губ.'
        *pl '— Кларисса всё прекрасно видела. Она не станет устраивать скандал на людях, но и дурой её считать не стоит.'
        *pl 'Она смотрит на вас внимательнее.'
        *pl '— Если Легаре продолжит в том же духе, Кларисса может оказаться не помехой, а полезным рычагом. Только рычаг этот опасный, Стефан. Не оступись.'
    elseif $MelissaLegareTextChoice = 'watch_amanda':
        *pl '— Присмотри за Амандой.'
        *pl 'Мелисса кивает, но без особого восторга.'
        *pl '— Присмотрю. Только учти: если она сообразит, что ты приставил меня караулить, устроит нам обоим сладкую жизнь.'
        *pl 'Она вздыхает.'
        *pl '— Но лучше пусть дуется дома, чем слушает Легаре в темноте за углом.'
    elseif $MelissaLegareTextChoice = 'handle_self':
        *pl '— Я сам разберусь.'
        *pl 'Мелисса смотрит на вас с лёгким скепсисом.'
        *pl '— Тогда разбирайся без проволочек. Такие, как Легаре, долго ждать не станут.'
        *pl 'Она чуть тише добавляет:'
        *pl '— И не думай, что это простая ревность. Тут замешаны и лавка, и положение, и его привычка брать всё, что приглянется.'
    else:
        *pl 'Мелисса молча кивает, но тревога в её взгляде никуда не исчезает.'
    end

    killvar '$MelissaLegareTextChoice'
---

! ================================================
! FILE: modules/events/dance/amanda_legare_talk_text.qsps
! Вступление Клариссы
! ================================================

#ClarissaTalkAboutLegareIntroText
    *pl 'Кларисса встречает вас спокойным взглядом.'
    *pl 'Она не называет Аманду по имени сразу, но обоим ясно, о ком идёт речь.'
    *pl '— На танцах люди часто глядят друг на друга, — замечает она ровно. — Но порой один взгляд стоит сотни слов.'
---

! ================================================
! FILE: modules/events/dance/amanda_legare_talk_text.qsps
! Ответы Клариссы
! ================================================

#ClarissaTalkAboutLegareActionText
    $ClarissaLegareTextChoice = LCASE($ARGS[0])

    if $ClarissaLegareTextChoice = 'truth':
        *pl 'Вы прямо признаёте, что Легаре смотрел на Аманду слишком открыто.'
        *pl 'Кларисса медленно кивает.'
        *pl '— Значит, мне не показалось.'
        *pl 'В её голосе нет обиды напоказ — лишь холодный расчёт и давняя привычка.'
    elseif $ClarissaLegareTextChoice = 'pretend':
        *pl 'Вы делаете вид, будто не понимаете, о чём речь.'
        *pl 'Кларисса улыбается, но улыбка выходит совсем не тёплой.'
        *pl '— Ну разумеется. Мужчины редко замечают очевидное, когда им это не с руки.'
    elseif $ClarissaLegareTextChoice = 'ask_legare':
        *pl 'Вы осторожно спрашиваете, часто ли Легаре позволяет себе такое.'
        *pl 'Кларисса слегка отводит глаза.'
        *pl '— Легаре привык думать, будто в этом городке ему позволено всё. Иногда полезно напомнить ему, что это заблуждение.'
    elseif $ClarissaLegareTextChoice = 'private_later':
        *pl 'Вы предлагаете поговорить позже, без посторонних глаз.'
        *pl 'Кларисса несколько мгновений изучает ваше лицо.'
        *pl '— Возможно. По утрам в лавке куда спокойнее, чем на площади.'
        *pl 'Эти слова звучат почти как приглашение.'
    else:
        *pl 'Кларисса выслушивает вас и оставляет разговор незавершённым.'
    end

    killvar '$ClarissaLegareTextChoice'
---
