! USER-OWNED TEXT
! Тексты полной танцевальной ветки Альберта Легаре и Аманды
!
! Визуальные ассеты:
! images/events/dance/amanda_legare_auto_notice/amanda_legare_auto_notice_start — Легаре наблюдает за Амандой у края площади
! images/events/dance/amanda_legare_invite/amanda_legare_invite_start — Приглашение Легаре
! images/events/dance/amanda_legare_invite/amanda_legare_invite_action — Исход приглашения
! images/events/dance/amanda_legare_dance/amanda_legare_dance_start — Легаре замечает Аманду
! images/events/dance/amanda_legare_dance/amanda_legare_dance_action — Легаре и Аманда
! images/events/dance/amanda_legare_dance/amanda_legare_clarissa_reaction — Кларисса наблюдает
! images/events/dance/amanda_legare_dance/amanda_legare_melissa_warning — Предупреждение Мелиссы
! images/events/dance/amanda_legare/alberdanceStep1..3 — Шаги танца Аманды и Легаре
! images/events/dance/amanda_legare_after_dance/amanda_legare_after_dance_start — Легаре шепчет Аманде после танца
! images/events/dance/amanda_legare_after_dance/amanda_legare_after_dance_action — Исход разговора возле танцевальной площадки
! images/events/dance/amanda_legare_friday_race/amanda_legare_friday_race_start — 5-я пятница, Легаре и Аманда
! images/events/dance/amanda_legare_friday_race/amanda_legare_friday_race_action — Подворотня у площади
! ================================================

! ================================================
! 1. ПЕРВОЕ ЗАМЕЧАНИЕ (AUTO-NOTICE)
! ================================================

#AmandaLegareAutoNoticeText
    *pl 'Музыка затихает, и Аманда ещё смеётся, переводя дух после быстрого круга и торопливо заправляя за ухо выбившуюся из косы влажную прядь.'
    *pl 'Но скользнув взглядом по краю площади, вы натыкаетесь на Альбера Легаре.'
    *pl 'Виноторговец стоит у резной опоры навеса, небрежно покачивая кубок в руке. Он не смотрит ни на бродячих скрипачей, ни на городскую знать. Его взгляд неотрывно прикован к Аманде — неспешный, цепкий и откровенно оценивающий, словно у закупщика, примеривающегося к дорогому товару.'
    *pl 'Кларисса, стоящая чуть поодаль среди почтенных горожанок, тоже перехватила этот взгляд мужа. Лицо её остаётся безупречно спокойным, но тонкие пальцы слишком сильно стискивают кружевной платок.'
    *pl 'Мелисса у соседнего помоста мгновенно подмечает заминку. Поймав ваш взгляд, она выразительно вскидывает бровь и едва заметно качает головой: торговец вином явно затевает недоброе, и делать вид, будто ничего не произошло, уже не выйдет.'
---

! ================================================
! 2. ПРИГЛАШЕНИЕ НА ТАНЕЦ (INVITE)
! ================================================

#AmandaLegareInviteIntroText
    *pl 'Следующая мелодия только начинается, а Легаре уже оказывается рядом с Амандой.'
    *pl 'Он улыбается мягко, почти безупречно, как человек, который всю жизнь торговал не вином, а чужим вниманием.'
    *pl '— Позволите следующий танец?'
    *pl 'Аманда на мгновение теряется. Не пугается — именно теряется. И от этого становится только хуже.'
---

#AmandaLegareInviteActionText
    $InviteTextChoice = LCASE($ARGS[0])

    if $InviteTextChoice = 'calm_intervene':
        *pl 'Вы подходите спокойно, без шума и театра.'
        *pl '— Аманда уже обещала мне следующий круг, — говорите вы так, чтобы это звучало почти шуткой.'
        *pl 'Легаре улыбается, но глаза у него становятся холоднее.'
        *pl 'Аманда выдыхает тихо. Не ясно, от облегчения или от того, что выбор сделали за неё.'
    elseif $InviteTextChoice = 'trust_amanda':
        if AmandaLegareDanceResult = 1:
            *pl 'Вы не вмешиваетесь сразу, но остаётесь рядом.'
            *pl 'Аманда смотрит на Легаре, потом на вас — и отвечает ему вежливо, но сдержанно.'
            *pl 'Танец выходит коротким, почти формальным. Не победа, конечно, но и лишнего повода для пересудов она ему не дала.'
        else:
            *pl 'Вы позволяете Аманде самой решить.'
            *pl 'Она принимает руку Легаре чуть быстрее, чем вам хотелось бы.'
            *pl 'Танец получается слишком живым для простой вежливости. Аманда улыбается, Легаре говорит тихо, а вам остаётся стоять и делать вид, что всё под контролем.'
            if sluttiness['amanda'] >= 35 and oralacts['amanda'] > 0:
                *pl 'В какой-то момент Легаре шепчет что-то настолько нагло, что Аманда смеётся — не от радости, а чтобы скрыть смущение.'
                *pl '«Ты думаешь, я члена раньше не видела?» — бросает она, слишком громко для площади. — «Я вовсе не такая наивная.»'
                *pl 'И чтобы подтвердить свои слова, наклоняется, проводит губами по ткани его штанов, затем опускается на колени прямо у края круга — в тени бочек, но не настолько глубоко, чтобы никто не догадался.'
                *pl 'Вот пройдоха. Она играет во взрослую — а вы стоите в двух шагах и понимаете, что слова о контроле звучат уже как насмешка.'
            end
        end
    elseif $InviteTextChoice = 'hard_warning':
        *pl 'Вы осаживаете Легаре сразу.'
        *pl '— Нет, месье. Сегодня без этого.'
        *pl 'На площади становится чуть тише. Легаре медленно убирает руку.'
        *pl '— Как скажете, Стефан. Только не всякий запрет выглядит силой.'
        *pl 'Аманда ограждена от его внимания, но хозяин винной лавки теперь наверняка запомнит ваш тон.'
    elseif $InviteTextChoice = 'ignore':
        *pl 'Вы не вмешиваетесь.'
        *pl 'Аманда принимает приглашение. Легаре ведёт её легко, уверенно, будто заранее знал, что вы промолчите.'
        *pl 'И самое неприятное — Аманда тоже это замечает.'
        *pl 'Если сейчас кто-то и сделал выводы, то сразу все.'
    else:
        *pl 'Момент проходит, но прежним вечер уже не будет.'
    end

    killvar '$InviteTextChoice'
---

! ================================================
! 3. ТАНЕЦ И РЕАКЦИИ (DANCE, CLARISSA, MELISSA)
! ================================================

#AmandaLegareDanceIntroText
    *pl 'Танцы на площади постепенно становятся шумнее. Музыка, смех и разговоры смешиваются в один живой гул.'
    *pl 'В какой-то момент вы замечаете, что Легаре смотрит не на музыкантов и не на свою жену.'
    *pl 'Его взгляд задерживается на Аманде — слишком долго и слишком открыто.'
    *pl 'Аманда сперва не замечает этого, потом всё же ловит чужое внимание и смущённо отворачивается.'
    *pl 'Кларисса, стоящая неподалёку, тоже всё видит. Мелисса бросает короткий взгляд на вас, словно ждёт, что вы решите делать.'
---

#AmandaLegareDanceActionText
    $LegareDanceTextChoice = LCASE($ARGS[0])

    if $LegareDanceTextChoice = 'observe':
        *pl 'Вы не вмешиваетесь сразу и наблюдаете.'
        *pl 'Легаре улыбается Аманде так, будто между ними уже есть какая-то тайна. Аманда смущается, но не сердится.'
        *pl 'Кларисса сжимает губы. Мелисса замечает это и становится ещё настороженнее.'
    elseif $LegareDanceTextChoice = 'approach_amanda':
        *pl 'Вы подходите к Аманде и становитесь рядом так, чтобы Легаре понял намёк.'
        *pl 'Аманда сперва удивляется, потом чуть заметно улыбается. Ей явно приятно, что вы не оставили её одну под этим взглядом.'
        *pl 'Легаре отворачивается, но делает это слишком медленно. Кларисса видит и его интерес, и вашу реакцию.'
    elseif $LegareDanceTextChoice = 'warn_legare':
        *pl 'Вы подходите к Легаре и спокойно, но жёстко даёте понять, что он слишком много смотрит на Аманду.'
        *pl 'Легаре улыбается краем губ, словно услышал хорошую шутку, но взгляд его холодеет.'
        *pl 'Аманда замечает разговор и напряжённо следит за вами. Кларисса тоже всё понимает.'
    elseif $LegareDanceTextChoice = 'ignore':
        *pl 'Вы делаете вид, что ничего не заметили.'
        *pl 'Легаре позволяет себе смотреть смелее. Аманда смущается, но уже не так быстро отворачивается.'
        *pl 'Мелисса замечает ваше молчание, а Кларисса — интерес мужа. Этот вечер точно оставит след.'
    else:
        *pl 'На площади возникает короткая неловкая пауза. Каждый делает вид, что ничего особенного не произошло.'
    end

    killvar '$LegareDanceTextChoice'
---

#AmandaLegareClarissaReactionText
    *pl 'Кларисса стоит у края площади и смотрит на Легаре.'
    *pl 'Она не повышает голос, не устраивает сцену и даже почти не меняется в лице, но по её взгляду понятно: она всё заметила.'
    *pl 'На миг её глаза скользят к Аманде, потом к вам.'
    *pl 'Теперь Кларисса знает, что интерес Легаре к Аманде — не случайный взгляд.'
---

#AmandaLegareMelissaWarningText
    *pl 'Мелисса подходит ближе, будто хочет просто сказать что-то о музыке, но голос у неё тихий и напряжённый.'
    *pl '"Стефан, ты видел, как он на неё смотрит?"'
    *pl 'Она кивает в сторону Легаре.'
    *pl '"Аманда может делать вид, что ничего не понимает, но такие мужчины просто так не смотрят. И Кларисса это тоже заметила."'
    *pl 'Мелисса ненадолго замолкает, потом добавляет ещё тише:'
    *pl '"Лучше поговори с Амандой потом. Пока она сама не решила, что это игра."'
---

! ================================================
! 4. НАБЛЮДЕНИЕ ЗА ТАНЦЕМ ПО ШАГАМ (DANCE FLOOR)
! ================================================

#AmandaLegareDanceFloorStepText
    $DanceStepId = $ARGS[0]
    $AmandaLegareDanceFloorText = ''

    if $DanceStepId = '1':
        $AmandaLegareDanceFloorText = 'Ваша сестрёнка весело болтает с импозантным виноторговцем. Альбер Легаре улыбается, оглаживает холёную бородку и что-то вкрадчиво нашёптывает Аманде, заставляя её то вспыхивать румянцем, то звонко смеяться на виду у всей площади.'
    elseif $DanceStepId = '2':
        $AmandaLegareDanceFloorText = 'Расторопный виноторговец галантно склоняет голову и приглашает Аманду в круг. После секундных раздумий та берёт его под руку, и вот они уже кружатся в танце под звонкие переливы флейт и скрипок.'
    elseif $DanceStepId = '3':
        $AmandaLegareDanceFloorText = 'По ходу танца мессир Легаре как бы невзначай опускает руки на талию Аманды. Пальцы купца уверенно смыкаются на тонкой ткани праздничного платья, притягивая девушку чуть ближе положенного. Аманда не делает ни малейшей попытки отстраниться.'
    elseif $DanceStepId = '4':
        $AmandaLegareDanceFloorText = 'Медленно, но верно руки похотливого торгаша спускаются с талии на попу вашей сестры. Альбер ведёт её в такт мелодии, а его широкие ладони уже покоятся на округлых бёдрах девушки. Аманда лишь кокетливо прикусывает губку, делая вид, что так и надо.'
    elseif $DanceStepId = '5':
        $AmandaLegareDanceFloorText = 'Однако Альберу мало и этого: его пальцы начинают по-хозяйски мять и поглаживать попу Аманды через тонкий шёлк платья. Сестрёнка же и не думает возмущаться — напротив, она улыбается и прижимается к своему кавалеру всем телом, заставляя окружающих горожан неодобрительно переглядываться.'
    elseif $DanceStepId = '6':
        $AmandaLegareDanceFloorText = 'Музыка подходит к концу, и вдруг женатый торговец наклоняется к лицу вашей сестры и страстно впивается в её губы поцелуем. Аманда вздрагивает, но уже через миг отвечает ему со всем пылом юности, повиснув у него на шее под ропот зевак у колоннады.'
    else:
        $AmandaLegareDanceFloorText = 'Аманда и мессир Легаре продолжают кружиться в танце. Торговец держит девушку за талию, довольно ухмыляясь, но пока не спешит заходить дальше.'
    end

    *pl $AmandaLegareDanceFloorText
    killvar '$DanceStepId'
    killvar '$AmandaLegareDanceFloorText'
---

#AmandaLegareDanceFloorInterveneText
    $InterveneMode = $ARGS[0]

    if $InterveneMode = 'shout':
        *pl 'Не желая больше смотреть на это бесстыдство, вы решительно шагаете прямо в круг танцующих и громко окликаете пару:'
        *pl '— Мессир! Что вы себе позволяете?! У вас дети старше Аманды, да и жена дома ждёт! А ты что возомнила?! Разве не видишь, что он возрастом как наш отец был бы, будь жив! А ну, кыш отсюда, и чтоб больше я вас рядом не видел!'
        if AmandaLegareProhibited = 1 or AmandaVar['alberprohibit'] = 1:
            *pl ' '
            *pl '— И ведь я тебе уже строго-настрого запрещал с ним крутиться! — повышаете вы голос на сестру. — Или ты память потеряла, или в уши воска набила?!'
        end

    elseif $InterveneMode = 'legare_leave':
        *pl 'Альбер Легаре бледнеет от неожиданной публичной выволочки, кривит тонкие губы в холодной гримасе и, одёрнув богатый камзол, мрачно ретируется в сторону торговых рядов под насмешливые взгляды соседей.'

    elseif $InterveneMode = 'amanda_rebel':
        *pl '— Как ты смеешь лезть в мою жизнь, братец?! — со слезами ярости выкрикивает Аманда на всю площадь. — Я уже взрослая и сама решаю, с кем мне танцевать! А Альбер мне очень нравится, и плевать, что женат!'
        *pl 'Она резко выдёргивает руку, разворачивается и в слезах убегает прочь с площади.'

    elseif $InterveneMode = 'amanda_submit':
        *pl '— Хорошо, Стефан... — глухо цедит Аманда, опуская покрасневшее лицо в пол.'
        *pl 'Она послушно отходит назад к колоннаде, но в её сжатых кулачках и тяжёлом взгляде читается жгучая, затаённая обида.'
    end

    killvar '$InterveneMode'
---

! ================================================
! 5. РАЗГОВОР ПОСЛЕ ТАНЦА (AFTER DANCE)
! ================================================

#AmandaLegareAfterDanceIntroText
    *pl 'Музыка смолкает, скрипач опускает смычок, чтобы промочить пересохшее горло элем, и разгорячённая толпа с хохотом и гомоном выплёскивается с площади к лавкам.'
    *pl 'Аманда останавливается у резных перил, обмахиваясь подолом передника. Щёки её пылают румянцем, растрёпанная коса выбилась из-под лент, а грудь под тугим корсажем вздымается от частого дыхания.'
    *pl 'Альбер Легаре появляется рядом мягко, будто соткавшись из вечерних теней. Оправив бархатный дублет, торговец вином склоняется к самому уху девушки, источая сладковатый аромат заморских масел и пряного вина.'
    *pl 'Он что-то вкрадчиво шепчет, скользя масленым взглядом по её обнажённой шее. Аманда вспыхивает ещё гуще, теребит край платья и смущённо улыбается в ответ, явно польщённая вниманием богатого господина.'
---

#AmandaLegareAfterDanceActionText
    $AfterDanceTextChoice = LCASE($ARGS[0])

    if $AfterDanceTextChoice = 'approach':
        *pl 'Вы решительно вклиниваетесь в толпу и встаёте прямо между ними, заслоняя сестру плечом.'
        *pl 'Легаре вынужден отступить на полшага. Масляная улыбка на миг застывает на его холёном лице, но купец мгновенно берёт себя в руки и с лёгким поклоном приподнимает шляпу:'
        *pl '— Месье Стефан. Вы так бдительно стережёте сестрицу, точно вокруг рыщут голодные волки.'
        *pl '— Волки не волки, а лисы вокруг крутятся откормленные, — невозмутимо отзываетесь вы, смерив его тяжёлым взглядом. — И норовят за чужую ограду нос сунуть.'
        *pl 'Аманда обиженно сопит за вашей спиной, одёргивая помятые юбки, но спорить на людях не решается. Легаре лишь насмешливо щурится и, поняв намёк, неторопливо растворяется среди подвыпивших горожан.'
    elseif $AfterDanceTextChoice = 'send_melissa':
        *pl 'Вы ловите настороженный взгляд Мелиссы и едва заметно киваете в сторону беседующих.'
        *pl 'Сестре не требуется объяснений. Легко скользнув сквозь людской водоворот, она выныривает у самого плеча Аманды с глиняным кувшином в руках и тут же громко, на всю округу, заводит разговор:'
        *pl '— Аманда, вот ты где! Матушка велела немедленно умыть лицо холодной водой, пока на тебя пыль столбом не осела, да и лента в волосах совсем растрепалась!'
        *pl 'Против звонкого напора Мелиссы изысканная галантность торговца оказывается бессильна. Сестра цепко подхватывает Аманду под локоть и уводит её прочь, пока та бросает досадливые взгляды назад. Легаре остаётся стоять в одиночестве, кривя губы в кислой ухмылке.'
    elseif $AfterDanceTextChoice = 'trust_amanda':
        if AmandaLegareAfterDanceResult = 2:
            *pl 'Вы остаётесь на месте, решив посмотреть, как Аманда поведёт себя сама.'
            *pl 'Поначалу сестра пытается держать строгий вид, но месье Альбер наклоняется ниже, рассыпая витиеватые похвалы её грации и обещая показать редкие столичные шелка. Защита Аманды трещит по швам: она прикрывает порозовевшие губы ладошкой, тихо хихикает и подаётся корпусом ближе к виноторговцу.'
            *pl 'Они шепчутся ещё добрую минуту, обмениваясь многозначительными взглядами, прежде чем Аманда возвращается к помосту. Глаза её лихорадочно блестят, а пальцы нервно перебирают складки юбки, выдавая волнующую тайну.'
        else:
            *pl 'Вы сдерживаете порыв вмешаться, предоставляя сестре право самой осадить назойливого купца.'
            *pl 'Аманда выслушивает сладкие речи Легаре, но когда тот пытается коснуться её локтя, девушка решительно отстраняется и делает широкий шаг назад, к залитому факелами центру площади.'
            *pl 'Бросив купцу несколько коротких и сдержанных слов, она поворачивается и спешит к подругам. Легаре разводит руками с деланым смешком, но задерживать её больше не осмеливается.'
        end
    elseif $AfterDanceTextChoice = 'step_aside':
        if AmandaLegareAfterDanceResult = 3:
            *pl 'Вы нарочно отворачиваетесь и отходите к пивным бочкам, оставив их без присмотра.'
            *pl 'Через плечи галдящих горожан вам удаётся разглядеть лишь обрывки: Легаре осторожно направляет Аманду в полутьму под аркадой ратуши, придерживая за талию. Сестра даже не пытается вырваться и покорно следует за ним в спасительную тень каменных сводов.'
            *pl 'Обратно на свет она возвращается лишь спустя добрых десять минут — растрёпанная, с горящими щеками и опущенными долу глазами, торопливо пряча что-то мелкое в глубине глубокого кармана.'
        else:
            *pl 'Вы делаете вид, что увлечены разговором у винных прилавков, предоставив событиям идти своим чередом.'
            *pl 'Впрочем, без благодарных зрителей беседа не клеится. Пьяная ватага подмастерьев с песнями вваливается между ними, задевая торговца плечом и выплеснув на его камзол добрую кварту сидра.'
            *pl 'Воспользовавшись суматохой, Аманда ускользает в круг танцующих, а Легаре остаётся чертыхаться и оттирать бархат платком, прожигая толпу злым взглядом.'
        end
    else:
        *pl 'Музыка вновь начинает набирать силу, смывая следы короткого разговора переливами лютни и топотом сапог.'
    end

    killvar '$AfterDanceTextChoice'
---

! ================================================
! 6. 5-Я ПЯТНИЦА — ГОНКА К ПОДВОРОТНЕ (FRIDAY RACE)
! ================================================

#AmandaLegareFridayRaceIntroText
    *pl 'Пятая пятница в платье от Ирмы. Аманда уже привыкла к взглядам — и Легаре это замечает.'
    *pl 'Он подходит ближе, чем когда-либо, и предлагает «поговорить без музыки» в узком проходе между домами.'
    *pl 'Она колеблется и смотрит на вас — но взгляд Легаре не отпускает.'
---

#AmandaLegareFridayRaceWatchDetailText
    if AmandaLegareDeflowerDone = 1:
        *pl 'Вы тихо пробираетесь в тень за штабелями бочек на заднем дворе лавки Легаре. Виноторговец времени зря не теряет: он уже прижал Аманду спиной к дубовой винной бочке, заглушая её слабые протесты горячими поцелуями.'
        *pl ' '
        *pl 'Слышно шуршание праздничного шёлка — Легаре сноровисто задирает платье сестры и стягивает с неё тонкие панталончики. До ваших ушей долетает сбивчивый, взволнованный шёпот Аманды:'
        *pl '«Ой, Альберчик… это ведь мой первый раз, я ещё девочка! Может, пока не надо?..»'
        *pl ' '
        *pl 'Но в её голосе нет настоящего страха — лишь сладкий трепет и нетерпение. Торговец присаживается перед ней на корточки, раздвигает её гладкие бёдра и начинает жадно ласкать влажную писечку языком. Спустя пару минут, убедившись, что девочка вся потекла, он разворачивает её лицом к бочке, укладывает её ладошки на шершавую клёпку и пристраивается сзади своим каменным стволом.'
        *pl ' '
        *pl 'Короткий писк Аманды, алая струйка девственной крови на дубовой доске — и виноторговец уже внутри!'
        *pl ' '
        *pl 'Дав ей привыкнуть к непривычной полноте, Легаре начинает двигаться: сначала мерно и тягуче, затем всё напористее и быстрее. Под тихий стук бочки Аманда начинает постанывать в голос — не от боли, а от нарастающего наслаждения, и бесстыдно подмахивает любовнику навстречу!'
        *pl 'Внезапно она замирает, сладко вскрикивает и сотрясается в первом в жизни оргазме. Легаре с хриплым рыком вгоняет член до самых яиц, изливаясь мощными струями прямо внутрь сестры.'
        *pl ' '
        *pl 'Когда он отстраняется, из её лона медленно стекает белое семя, перемешанное с девственной кровью и соками. Аманда поправляет юбку и с сияющей улыбкой шепчет:'
        *pl '«Ох, Альберчик, это был мой первый раз, и он такой прекрасный! Надеюсь, и тебе понравилось?»'
        *pl ' '
        *pl 'Вы понимаете: он опередил вас. Первый раз случился не дома и не с вами — в подворотне на винной бочке, и Аманда отдалась ему с полным восторгом.'

    elseif Fact_AmandaLegareFridayAlley = 1 and virginity['amanda'] = 0:
        *pl 'Вы заглядываете в щель между штабелями бочек. Легаре уже задрал подол платья Аманды, нагнув её над винной бочкой.'
        *pl ' '
        *pl 'Он легко входит в её мокрую, уже знающую мужчину писечку одним уверенным толчком. Аманда звонко смеётся и подмахивает его движениям, не обращая внимания на стук бочки.'
        *pl '«Ох, милая, а ты ведь уже не девочка?» — удивлённо шепчет торговец, насаживая её глубже.'
        *pl ' '
        *pl '«Ни за что не догадаешься, кто меня лишил…» — дразнит его Аманда, довольно изгибая спинку. — «Это был мой похотливый братик!» С этими словами она со сладостным стоном кончает на его члене, а следом Легаре со стоном заливает её своей спермой.'

    else
        LegareWatchRoll = RAND(1, 2)

        if LegareWatchRoll = 1:
            *pl 'Вы идёте в тени и находите их за бочками. Легаре прислонился к стене, а Аманда стоит перед ним на коленях.'
            *pl 'Она делает ему минет со знанием дела — усердно двигает головкой, ласкает язычком ствол и заглядывает торговцу в глаза.'
            *pl 'Легаре даже не предупреждает: кончает ей прямо в ротик. Аманда не паникует — легко всё проглатывает и с гордостью высовывает язычок, показывая, что всё чисто.'
        else
            *pl 'Легаре вытаскивает член изо рта Аманды в последний миг.'
            *pl 'Струя спермы бьёт ей в лицо: белые горячие капли покрывают её щёчки, носик и подбородок.'
            *pl 'Аманда морщится, но тут же лукаво улыбается: «Альберчик, ну предупредить же можно было…»'
        end

        killvar 'LegareWatchRoll'
    end
---

#AmandaLegareFridayRaceActionText
    $FridayRaceTextChoice = LCASE($ARGS[0])

    if $FridayRaceTextChoice = 'stop':
        *pl 'Вы вмешиваетесь резко, но без крика. Легаре отступает с холодной улыбкой, а Аманда облегчённо выдыхает.'
        *pl 'Подворотня на сегодня пуста — но вы чувствуете, что это только начало.'

    elseif $FridayRaceTextChoice = 'claim':
        *pl 'Вы подходите к Аманде и берёте её за руку. Легаре стискивает челюсть, но отступает.'
        *pl '«Пойдём домой», — говорите вы. Она кивает — слишком быстро, чтобы скрыть облегчение.'

    elseif $FridayRaceTextChoice = 'watch':
        if AmandaLegareFridayRaceWatchRollHard = 1:
            *pl 'Вы идёте в тени за ними. В подворотне тесно и пахнет мокрым камнем.'
            *pl 'Легаре прислонился к винной бочке. Аманда подходит вплотную, заглядывая ему в глаза с лукавым трепетом.'
            *pl 'Они пока не знают, что вы здесь.'
        else
            *pl 'Легаре что-то шепчет ей у края прохода. Аманда краснеет, уходит с ним на пару шагов — и быстро возвращается.'
            *pl 'Пока что это лишь опасный флирт. Но вы видели, как быстро всё может сдвинуться дальше.'
        end

    elseif $FridayRaceTextChoice = 'step_aside':
        if AmandaLegareFridayRaceSoftNearMiss = 1:
            *pl 'Вы отворачиваетесь. Легаре уводит Аманду на задний двор лавки к штабелям бочек.'
            *pl 'Когда она возвращается, щёки горят, дыхание сбито, а платье чуть примято. Пауза была слишком долгой — и судя по её довольному взгляду, галантный купец получил своё сполна.'
        else
            *pl 'Вы делаете вид, что заняты разговором с музыкантами. Легаре разочарованно хмурится, но Аманда всё же возвращается на площадь.'
            *pl 'На этот раз всё обошлось — но вы выбрали не вмешиваться.'
        end
    end

    killvar '$FridayRaceTextChoice'
---
