! ================================================
! FILE: modules/events/amanda/legare/amanda_legare_street_intercept.qsps
! MODULE: events/amanda/legare
! Перехват Аманды и Легаре на улице, драка, стража и утренние пробуждения
! ================================================

#AmandaLegareStreetIntercept
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/street_intercept', 'ПЕРЕХВАТ НА УЛИЦЕ', 'large', 'webp'
    gs 'EnsureGirlData', 'amanda'

    AmandaStefanIntimate = 0
    if AmandaHomeSex = 1 or HadSex['amanda'] = 1 or oralacts['amanda'] > 0 or sexacts['amanda'] > 0:
        AmandaStefanIntimate = 1
    end

    if AmandaTrustStefan >= AmandaRebellion and sluttiness['amanda'] < 25:
        AmandaNesluh = 0
    elseif AmandaStefanIntimate = 1:
        AmandaNesluh = 2
    else:
        AmandaNesluh = 1
    end

    gs 'ShowLocationScreenTitle', 'ПЕРЕХВАТ НА УЛИЦЕ'

    gs 'AmandaLegareStreetInterceptIntroText', AmandaNesluh

    *pl ' '

    if AmandaNesluh = 0:
        AmandaObeyedAfterDance = 1
        AmandaTrustStefan += 1
        Friends['amanda'] += 1
        AmandaLegareInterest = MAX(0, AmandaLegareInterest - 1)

        gs 'ActUiPrepare', 'Вернуться на площадь', 'dance'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MarketDance'
        end

        gs 'ActUiPrepare', 'Пойти в трактир', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    else:
        gs 'ActUiPrepare', 'Дать им уйти', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AmandaLegareStreetLetGo'
        end

        gs 'ActUiPrepare', 'Тайно проследить за ними', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AmandaLegareBackyardStart'
        end

        gs 'ActUiPrepare', 'Кулачный бой с месье Легаре', 'fight'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AmandaLegareStreetFight'
        end

        gs 'ActUiPrepare', 'Позвать городскую стражу', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AmandaLegareStreetPolice'
        end
    end

    killvar 'AmandaStefanIntimate'
---

#AmandaLegareStreetLetGo
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/street_intercept', 'ПАРОЧКА УХОДИТ', 'large', 'webp'
    Fact_AmandaLegareFridayAlley = 1
    AmandaLetGoAfterDance = 1
    FridayStreetClashHappened = 1
    FridayClashDay = day
    $FridayClashType = 'letgo'
    TavernScandal += 1

    gs 'ShowLocationScreenTitle', 'ПАРОЧКА УХОДИТ'
    *pl 'Будучи ошарашенным ответом сестры, вы остаётесь стоять посреди ночной улицы.'
    *pl 'Аманда гордо удаляется под ручку с Альбером, скрываясь в темноте переулка.'
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться на площадь', 'dance'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end

    gs 'ActUiPrepare', 'Пойти в трактир', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#AmandaLegareStreetFight
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/fight', 'ДРАКА НА УЛИЦЕ', 'large', 'webp'

    ! Определение исхода драки: 1 — победа, 2 — нокаут Стефана, 3 — ничья со стражей
    FightRoll = RAND(1, 3)
    if strength >= 75 and FightRoll = 2:
        FightRoll = 1
    end

    if FightRoll = 1:
        gt 'AmandaLegareFightWin'
    elseif FightRoll = 2:
        gt 'AmandaLegareFightDefeat'
    else:
        gt 'AmandaLegareFightDraw'
    end

    killvar 'FightRoll'
---

#AmandaLegareFightWin
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/fight_win', 'ПОБЕДА В ДРАКЕ', 'large', 'webp'

    AmandaLockedHomeAfterDance = 1
    FridayStreetClashHappened = 1
    FridayClashDay = day
    $FridayClashType = 'win'
    tavern_reputation += 1
    TavernScandal += 1
    AmandaRebellion += 2
    Friends['amanda'] = MAX(0, Friends['amanda'] - 1)
    Friends['legare'] = MAX(0, Friends['legare'] - 4)
    AmandaLegareInterest = MAX(0, AmandaLegareInterest - 2)

    gs 'ShowLocationScreenTitle', 'ПОБЕДА В ДРАКЕ'

    gs 'AmandaLegareFightWinText'

    *pl ' '

    gs 'ActUiPrepare', 'Спуститься в зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#AmandaLegareFightDefeat
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/fight_lost', 'НОКАУТ НА МОСТОВОЙ', 'large', 'webp'
    Fact_AmandaLegareFridayAlley = 1
    AmandaLegareFirstSexDone = 1
    AmandaLegareNightWithAlber = 1
    AmandaKnockedOutAfterDance = 1
    FridayStreetClashHappened = 1
    FridayClashDay = day
    $FridayClashType = 'defeat'
    tavern_reputation = MAX(0, tavern_reputation - 1)
    TavernScandal += 1
    AmandaLegareInterest = MIN(15, AmandaLegareInterest + 2)
    sluttiness['amanda'] += 2
    AmandaNpcPath = MAX(AmandaNpcPath, 2)
    gs 'ClampGirlSocialStats', 'amanda'

    gs 'ShowLocationScreenTitle', 'ПОРАЖЕНИЕ'

    gs 'AmandaLegareFightDefeatText'

    *pl ' '

    gs 'ActUiPrepare', 'Погрузиться во тьму...', 'sleep'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaLegareKnockoutMorning'
    end
---

#AmandaLegareFightDraw
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/fight_draw', 'СТРАЖА ОСТАНАВЛИВАЕТ ДРАКУ', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'ВМЕШАТЕЛЬСТВО СТРАЖИ'

    gs 'AmandaLegareFightDrawText'

    *pl ' '
    *pl 'Ваши деньги: ' + STR(money) + ' мараведи.'
    *pl ' '

    if money >= 15:
        gs 'ActUiPrepare', 'Заплатить 15 мараведи штрафа', 'money'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AmandaLegarePayFine'
        end
    end

    gs 'ActUiPrepare', 'Отказаться платить (в кутузку)', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaLegareRefuseFine'
    end
---

#AmandaLegarePayFine
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/fight_draw', 'ОПЛАТА ШТРАФА', 'large', 'webp'
    money -= 15
    AmandaTiedFightDone = 1
    FridayStreetClashHappened = 1
    FridayClashDay = day
    $FridayClashType = 'tied'
    TavernScandal += 1
    AmandaRebellion += 1

    gs 'ShowLocationScreenTitle', 'ШТРАФ ОПЛАЧЕН'

    gs 'AmandaLegarePayFineText'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться к трактиру', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Street'
    end
---

#AmandaLegareRefuseFine
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/police', 'ПОД КОНВОЕМ', 'large', 'webp'
    Fact_AmandaLegareFridayAlley = 1
    AmandaJailedAfterDance = 1
    FridayStreetClashHappened = 1
    FridayClashDay = day
    $FridayClashType = 'jail'

    gs 'ShowLocationScreenTitle', 'АРЕСТ'

    gs 'AmandaLegareRefuseFineText'

    *pl ' '

    gs 'ActUiPrepare', 'Провести ночь в кутузке...', 'sleep'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaLegareJailMorning'
    end
---

#AmandaLegareStreetPolice
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/police', 'ГОРОДСКАЯ СТРАЖА', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'ВЫЗОВ СТРАЖИ'

    if sluttiness['amanda'] < 25:
        AmandaObeyedAfterDance = 1
        AmandaTrustStefan += 1
        gs 'AmandaLegareStreetPoliceModestText'

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться к трактиру', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Street'
        end
    else:
        gs 'AmandaLegareStreetPoliceBoldText'

        *pl ' '
        *pl 'Ваши деньги: ' + STR(money) + ' мараведи.'
        *pl ' '

        if money >= 35:
            gs 'ActUiPrepare', 'Дать страже 35 мараведи', 'money'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaLegarePoliceBribe'
            end
        end

        gs 'ActUiPrepare', 'Отказаться платить', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AmandaLegarePoliceNoBribe'
        end
    end
---

#AmandaLegarePoliceBribe
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/police', 'СТРАЖА ВЫРУЧАЕТ', 'large', 'webp'
    money -= 35
    AmandaLockedHomeAfterDance = 1
    FridayStreetClashHappened = 1
    FridayClashDay = day
    $FridayClashType = 'police'
    Friends['legare'] = MAX(0, Friends['legare'] - 2)

    gs 'ShowLocationScreenTitle', 'СТРАЖА ВМЕШИВАЕТСЯ'

    gs 'AmandaLegarePoliceBribeText'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в трактир', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#AmandaLegarePoliceNoBribe
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/street_intercept', 'ЛЕГАРЕ УВОДИТ АМАНДУ', 'large', 'webp'
    Fact_AmandaLegareFridayAlley = 1
    AmandaLetGoAfterDance = 1
    FridayStreetClashHappened = 1
    FridayClashDay = day
    $FridayClashType = 'police_letgo'
    TavernScandal += 1

    gs 'ShowLocationScreenTitle', 'ЛЕГАРЕ УХОДИТ С АМАНДОЙ'

    gs 'AmandaLegarePoliceNoBribeText'

    *pl ' '

    gs 'ActUiPrepare', 'Проводить их мрачным взглядом', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Street'
    end
---

#AmandaLegareKnockoutMorning
    gs 'AdvanceCalendarOneDay'

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/locations/tavern/tavern_room_morning', 'ПРОБУЖДЕНИЕ В ТРАКТИРЕ', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'СУББОТА, УТРО — ПРОБУЖДЕНИЕ В ТРАКТИРЕ'
    *pl 'Вы с трудом приходите в себя. В висках яростно стучит кровь, затылок ноет от тупой боли — ночное падение на мостовой дало о себе знать.'
    *pl 'В памяти всплывают обрывки вчерашней драки: ухмылка Легаре, подлая подножка... и удаляющийся стук девичьих каблучков. Аманда не стала дожидаться, пока вы подниметесь, и ушла вслед за купцом в темноту переулка.'
    *pl ' '
    *pl 'Вас, потерявшего сознание, кто-то подобрал на улице и приволок домой в трактир. Сквозь полудрёму вы чувствуете тепло мягкой постели и слышите знакомые шаги в комнате...'
    *pl ' '

    gs 'ActUiPrepare', 'Открыть глаза в комнате матери (Сандра)', 'bed'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaLegareWakeupSandra'
    end

    gs 'ActUiPrepare', 'Открыть глаза в комнате сестры (Мелисса)', 'bed'
    act $ActUiLabel, $ActUiIconPath:
        gt 'AmandaLegareWakeupMelissa'
    end
---

#AmandaLegareWakeupSandra
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/wakeup_sandra', 'ПРОБУЖДЕНИЕ В КОМНАТЕ САНДРЫ', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'КОМНАТА САНДРЫ — УТРО'

    SandraNeedsOral = 0
    if SandraHomeSex = 1 and (LastSexDay['sandra'] = 0 or (day - LastSexDay['sandra']) > 3):
        SandraNeedsOral = 1
    end

    if SandraNeedsOral = 1:
        LastSexDay['sandra'] = day
        daily_cum_count += 1
        cametoday = 1
        Friends['sandra'] += 1
        SandraTrust += 1

        gs 'AmandaLegareWakeupSandraOralText'

        *pl ' '

        gs 'ActUiPrepare', 'Подняться и пойти в зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    else:
        Friends['sandra'] += 1

        gs 'AmandaLegareWakeupSandraCareText'

        *pl ' '

        gs 'ActUiPrepare', 'Поблагодарить и пойти в зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    killvar 'SandraNeedsOral'
---

#AmandaLegareWakeupMelissa
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/wakeup_melissa', 'ПРОБУЖДЕНИЕ В КОМНАТЕ МЕЛИССЫ', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'КОМНАТА МЕЛИССЫ — УТРО'

    MelissaNeedsSex = 0
    if MelissaHomeSex = 1 and (LastSexDay['melissa'] = 0 or (day - LastSexDay['melissa']) > 3):
        MelissaNeedsSex = 1
    end

    if MelissaNeedsSex = 1:
        LastSexDay['melissa'] = day
        daily_cum_count += 1
        cametoday = 1
        Friends['melissa'] += 1
        MelissaTrustStefan += 1
        vaginalacts['melissa'] += 1

        gs 'AmandaLegareWakeupMelissaRidingText'

        *pl ' '

        gs 'ActUiPrepare', 'Подняться и пойти в зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    else:
        Friends['melissa'] += 1

        gs 'AmandaLegareWakeupMelissaCareText'

        *pl ' '

        gs 'ActUiPrepare', 'Подняться и пойти в зал', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernMain'
        end
    end

    killvar 'MelissaNeedsSex'
---

#AmandaLegareJailMorning
    gs 'AdvanceCalendarOneDay'

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/jail_morning', 'СТОРОЖКА ГОРОДСКОЙ СТРАЖИ', 'large', 'webp'
    tavern_reputation = MAX(0, tavern_reputation - 2)
    TavernScandal += 1

    gs 'ShowLocationScreenTitle', 'УТРО У СТОРОЖКИ СТРАЖИ'

    gs 'AmandaLegareJailMorningText'

    *pl ' '

    gs 'ActUiPrepare', 'Понуро вернуться в трактир', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#AmandaLegareAfterDanceMorningTryShow
    if time <> 1:
        exit
    end

    if AmandaLockedHomeAfterDance = 1:
        AmandaLockedHomeAfterDance = 0
        AmandaSaturdayTalkReady = 1
        *pl ' '
        gs 'AmandaLegareMorningLockedReactionText'
        *pl ' '
    elseif AmandaObeyedAfterDance = 1:
        AmandaObeyedAfterDance = 0
        AmandaSaturdayTalkReady = 1
        *pl ' '
        gs 'AmandaLegareMorningObeyedReactionText'
        *pl ' '
    elseif AmandaTiedFightDone = 1:
        AmandaTiedFightDone = 0
        AmandaSaturdayTalkReady = 1
        *pl ' '
        gs 'AmandaLegareMorningTiedReactionText'
        *pl ' '
    elseif AmandaKnockedOutAfterDance = 1:
        AmandaKnockedOutAfterDance = 0
        AmandaSaturdayTalkReady = 1
        *pl ' '
        gs 'AmandaLegareMorningKnockoutReactionText'
        *pl ' '
    elseif AmandaJailedAfterDance = 1:
        AmandaJailedAfterDance = 0
        AmandaSaturdayTalkReady = 1
        *pl ' '
        gs 'AmandaLegareMorningJailReactionText'
        *pl ' '
    elseif AmandaLetGoAfterDance = 1:
        AmandaLetGoAfterDance = 0
        AmandaSaturdayTalkReady = 1
        *pl ' '
        gs 'AmandaLegareMorningLetGoReactionText'
        *pl ' '
    end
---

#FridayStreetClashPrintHallRumor
    if FridayStreetClashHappened = 0:
        exit
    end

    if week <> 6:
        exit
    end

    if $FridayClashType = 'defeat':
        gs 'PrintMainP', 'За дальним столом пара подвыпивших завсегдатаев негромко пересмеиваются, пересказывая утренним гостям, как хозяин «Дикого Жеребца» вчера ночью полез в драку со старым виноторговцем и поцеловал мостовую.'
    elseif $FridayClashType = 'jail':
        gs 'PrintMainP', 'По залу ходят негромкие шепотки: посетители бросают на вас любопытные взгляды, уже зная, что Стефан только на рассвете вышел из караулки стражи после ночного ареста.'
    elseif $FridayClashType = 'win':
        gs 'PrintMainP', 'У стойки слышны уважительные смешки горожан: до базара долетел слух, что трактирщик вчера от души впечатал кулак в челюсть месье Легаре, когда тот увивался вокруг его сестры.'
    elseif $FridayClashType = 'tied':
        gs 'PrintMainP', 'Гости за кружками эля оживлённо обсуждают ночной переполох у площади: по слухам, стражники содрали со Стефана и Легаре кругленькую сумму за ночную возню на мостовой.'
    elseif $FridayClashType = 'police':
        gs 'PrintMainP', 'Посетители переговариваются о ночном инциденте: говорят, на площади ночью стоял такой крик, что патрулю стражи пришлось растаскивать купца и трактирщика силой.'
    elseif $FridayClashType = 'letgo' or $FridayClashType = 'police_letgo':
        gs 'PrintMainP', 'Несколько зевак у очага вполголоса судачат о том, как старый лис Легаре вчера после танцев средь ночи увёл хорошенькую Аманду, а хозяин и слова поперёк не сказал.'
    end
---

#AmandaTalkAboutLegareStreetClash
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/street_clash_amanda', 'РАЗГОВОР С АМАНДОЙ О НОЧНЫХ СОБЫТИЯХ', 'large', 'webp'
    $LegareTalkReturnLoc = $ARGS[0]

    if $LegareTalkReturnLoc = '':
        $LegareTalkReturnLoc = 'TavernMain'
    end
    if LOC($LegareTalkReturnLoc) = 0:
        $LegareTalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', 'amanda'
    gs 'ShowGirlSidebar', 'amanda'

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С АМАНДОЙ: ПОСЛЕДСТВИЯ НОЧИ'

    if LOC('AmandaTalkAboutLegareStreetClashIntroText') = 1:
        gs 'AmandaTalkAboutLegareStreetClashIntroText'
    else:
        *pl 'Вы подходите к сестре, чтобы прояснить вчерашние события с Легаре.'
    end

    *pl ' '

    gs 'AmandaTalkAboutLegareStreetClashBuildMenu'

    *p 'Что сказать <a href="exec:gs ''Menu.Show'', ''AmandaStreetClashTalkMenu''">Аманде</a>?'
---

#AmandaTalkAboutLegareStreetClashBuildMenu
    gs 'Menu.Destroy', 'AmandaStreetClashTalkMenu'
    gs 'Menu.Create', 'AmandaStreetClashTalkMenu'

    gs 'MenuUiAdd', 'AmandaStreetClashTalkMenu', 'Он видит в тебе лёгкую добычу', ''
    gs 'Menu.AddModule', 'AmandaStreetClashTalkMenu', {
        gt 'AmandaTalkAboutLegareStreetClashAction', 'warn', $LegareTalkReturnLoc
    }

    gs 'MenuUiAdd', 'AmandaStreetClashTalkMenu', 'Ты опозорила семью перед городом', ''
    gs 'Menu.AddModule', 'AmandaStreetClashTalkMenu', {
        gt 'AmandaTalkAboutLegareStreetClashAction', 'shame', $LegareTalkReturnLoc
    }

    gs 'MenuUiAdd', 'AmandaStreetClashTalkMenu', 'Я беспокоился за тебя', ''
    gs 'Menu.AddModule', 'AmandaStreetClashTalkMenu', {
        gt 'AmandaTalkAboutLegareStreetClashAction', 'care', $LegareTalkReturnLoc
    }

    gs 'MenuUiAdd', 'AmandaStreetClashTalkMenu', 'Никаких ночных прогулок. За работу!', ''
    gs 'Menu.AddModule', 'AmandaStreetClashTalkMenu', {
        gt 'AmandaTalkAboutLegareStreetClashAction', 'work', $LegareTalkReturnLoc
    }

    gs 'MenuUiAdd', 'AmandaStreetClashTalkMenu', 'Вернуться', ''
    gs 'Menu.AddModule', 'AmandaStreetClashTalkMenu', {
        gt $LegareTalkReturnLoc
    }
---

#AmandaTalkAboutLegareStreetClashAction
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/street_clash_amanda_action', 'РАЗГОВОР С АМАНДОЙ', 'large', 'webp'
    $AmandaClashChoice = LCASE($ARGS[0])
    $LegareTalkReturnLoc = $ARGS[1]

    if $LegareTalkReturnLoc = '':
        $LegareTalkReturnLoc = 'TavernMain'
    end
    if LOC($LegareTalkReturnLoc) = 0:
        $LegareTalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', 'amanda'
    gs 'ShowGirlSidebar', 'amanda'

    AmandaSaturdayTalkReady = 0
    AmandaSaturdayTalkDone = 1

    if $AmandaClashChoice = 'warn':
        AmandaLegareInterest = MAX(0, AmandaLegareInterest - 1)
        AmandaTrustStefan += 1
        Friends['amanda'] += 1
    elseif $AmandaClashChoice = 'shame':
        AmandaRebellion += 1
        Friends['amanda'] = MAX(0, Friends['amanda'] - 1)
    elseif $AmandaClashChoice = 'care':
        AmandaTrustStefan += 2
        Friends['amanda'] += 1
        AmandaSecretiveness = MAX(0, AmandaSecretiveness - 1)
    elseif $AmandaClashChoice = 'work':
        AmandaWorkDiscipline += 2
        AmandaRebellion += 1
    end

    gs 'ClampGirlSocialStats', 'amanda'

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С АМАНДОЙ'

    if LOC('AmandaTalkAboutLegareStreetClashActionText') = 1:
        gs 'AmandaTalkAboutLegareStreetClashActionText', $AmandaClashChoice
    else:
        *pl 'Аманда выслушивает вас и задумчиво опускает глаза.'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $LegareTalkReturnLoc
    end

    killvar '$AmandaClashChoice'
