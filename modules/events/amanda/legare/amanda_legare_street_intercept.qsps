#SandraTalkAboutLegareStreetClashAction
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/street_clash_sandra_action', 'РАЗГОВОР С САНДРОЙ', 'large', 'webp'
    $SandraClashChoice = LCASE($ARGS[0])
    $LegareTalkReturnLoc = $ARGS[1]

    if $LegareTalkReturnLoc = '':
        $LegareTalkReturnLoc = 'TavernMain'
    end
    if LOC($LegareTalkReturnLoc) = 0:
        $LegareTalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', 'sandra'
    gs 'ShowGirlSidebar', 'sandra'

    SandraLegareClashTalkDone = 1

    if $SandraClashChoice = 'honor':
        SandraTrust += 1
        FamilyTrust += 1
        SandraRespect += 1
        Friends['sandra'] += 1
    elseif $SandraClashChoice = 'revenge':
        SandraPragmatism += 1
        Friends['legare'] = MAX(0, Friends['legare'] - 1)
    elseif $SandraClashChoice = 'strict':
        AmandaWorkDiscipline += 1
        AmandaRebellion += 1
        SandraRespect += 1
    elseif $SandraClashChoice = 'calm':
        SandraFamilyConcern = MAX(0, SandraFamilyConcern - 1)
        SandraTrust += 1
        Friends['sandra'] += 1
    end

    gs 'ClampGirlSocialStats', 'sandra'

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С САНДРОЙ'

    if LOC('SandraTalkAboutLegareStreetClashActionText') = 1:
        gs 'SandraTalkAboutLegareStreetClashActionText', $SandraClashChoice
    else:
        *pl 'Сандра вздыхает и качает головой, выслушав вас.'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $LegareTalkReturnLoc
    end

    killvar '$SandraClashChoice'
