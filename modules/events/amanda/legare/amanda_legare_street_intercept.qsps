#MelissaTalkAboutLegareStreetClashAction
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/amanda/legare/street_clash_melissa_action', 'РАЗГОВОР С МЕЛИССОЙ', 'large', 'webp'
    $MelissaClashChoice = LCASE($ARGS[0])
    $LegareTalkReturnLoc = $ARGS[1]

    if $LegareTalkReturnLoc = '':
        $LegareTalkReturnLoc = 'TavernMain'
    end
    if LOC($LegareTalkReturnLoc) = 0:
        $LegareTalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', 'melissa'
    gs 'ShowGirlSidebar', 'melissa'

    MelissaLegareClashTalkDone = 1

    if $MelissaClashChoice = 'plan':
        MelissaRespectStefan += 1
        MelissaTrustStefan += 1
        ClarissaRouteHint = 1
        Friends['melissa'] += 1
    elseif $MelissaClashChoice = 'amanda':
        MelissaControlNeed += 1
        MelissaFamilyConcern += 1
        Friends['melissa'] += 1
    elseif $MelissaClashChoice = 'force':
        MelissaRespectStefan = MAX(0, MelissaRespectStefan - 1)
        MelissaTrustStefan = MAX(0, MelissaTrustStefan - 1)
    elseif $MelissaClashChoice = 'business':
        MelissaRespectStefan += 1
        management += 1
        trading += 1
        Friends['melissa'] += 1
    end

    gs 'ClampGirlSocialStats', 'melissa'

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С МЕЛИССОЙ'

    if LOC('MelissaTalkAboutLegareStreetClashActionText') = 1:
        gs 'MelissaTalkAboutLegareStreetClashActionText', $MelissaClashChoice
    else:
        *pl 'Мелисса с тонкой усмешкой делает пометку на пергаменте.'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $LegareTalkReturnLoc
    end

    killvar '$MelissaClashChoice'
