! ================================================
! FILE: modules/events/amanda/legare/amanda_legare_major_risk_text.qsps
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты события "Аманда пропала из зала"
! Используется кодом:
! modules/events/amanda/legare/amanda_legare_major_risk.qsps
! ================================================

#AmandaLegareMajorRiskIntroText
    *pl 'Шум в общем зале не стихает, но ваш взгляд натыкается на пустоту.'
    *pl ' '
    *pl 'Там, где минуту назад мелькал белый передник Аманды, теперь никого нет. На краю стола сиротливо остывает недонесённая тарелка с похлёбкой, хмельной плотник с кружкой нетерпеливо озирается по сторонам, а сестры нигде не видно.'
    *pl ' '
    *pl 'Дверь служебного выхода во двор едва заметно приоткрыта, оттуда тянет промозглым ночным сквозняком. После всех намёков Легаре и его вкрадчивых взглядов такое исчезновение пахнет не простой отлучкой, а надвигающейся бедой.'
---

#AmandaLegareMajorRiskSneakSceneText
    MajorSneakRoll = RAND(1, 2)

    *pl 'Вы ступаете бесшумно, стараясь не задеть пустые корзины у заднего крыльца.'
    *pl 'За штабелем высоких пивных бочек у глухой каменной стены слышатся приглушённые голоса — тихие, взволнованные, опасные.'
    *pl ' '
    *pl 'Залезать на бочки нельзя — сырые доски предательски заскрипят под весом тела. Но между массивными дубовыми клёпками есть широкая тёмная щель, сквозь которую открывается весь пятачок задворка.'
    *pl ' '

    if MajorSneakRoll = 1 and (oralacts['amanda'] > 0 or sluttiness['amanda'] >= 35):
        *pl 'Легаре стоит, расслабленно привалившись спиной к шершавому дереву, в расстёгнутом бархатном дублете.'
        *pl 'Аманда опустилась перед ним на колени прямо в сырую траву, придерживая подол платья.'
        *pl ' '
        *pl 'Она берёт его налившийся член в рот не со страхом, а с каким-то жадным, неопытным усердием, стремясь доказать столичного гостю, что она уже взрослая женщина, достойная его дорогих подарков.'
        *pl 'Купец самодовольно щурится, запустив пальцы в её растрёпанные русые волосы. Он резко подаётся вперёд — сестра вздрагивает, едва успевая сглатывать горячую сперму, но белая капля всё равно срывается на её круглую девичью щёку.'
    elseif sluttiness['amanda'] >= 30:
        *pl 'Аманда подаётся вперёд, приподнявшись на цыпочках, и её губы жадно накрывают член купца.'
        *pl 'Она бережно водит языком, робко пробуя незнакомый вкус, а затем, повинуясь его настойчивой руке на своём затылке, принимает его глубже.'
        *pl ' '
        *pl 'Легаре глухо, сладострастно стонет в ночную тишину. За тонкой перегородкой трактира кто-то из пьяных гостей взрывается громким гоготом — и от этого дикого контраста между разгульным залом и тайным падением сестры в темноте перехватывает дыхание.'
    else:
        *pl 'Легаре говорит почти в самые губы Аманды, накрывая её своей ладонью и прижимая к бочке.'
        *pl 'Девушка часто дышит, её грудь высоко вздымается под тугим корсажем. Она слабо упирается руками в его грудь, но пальцы её не отталкивают купца, а словно застыли в нерешительности между робостью и искушением.'
        *pl ' '
        *pl 'Легаре медленно опускает вторую руку ей на талию, оглаживая бедро, и шепчет обещания шелков и столичных балов. Явная черта ещё не перейдена, но яд его речей уже отравил девичью душу.'
    end

    *pl ' '
    *pl 'Теперь вы знаете горькую правду: следующий шаг купца окончательно растопчет девичью честь, если не положить этому конец.'

    killvar 'MajorSneakRoll'
---

#AmandaLegareMajorRiskActionText
    $MajorRiskTextChoice = LCASE($ARGS[0])

    if $MajorRiskTextChoice = 'search_self':
        if AmandaLegareMajorRiskResult = 4:
            *pl 'Вы срываетесь с места, распахиваете служебную дверь и решительно шагаете в темноту заднего двора.'
            *pl ' '
            *pl 'За углом, прямо за штабелем дубовых бочек, натыкаетесь на них: Легаре прижал Аманду к доскам, а его рука уже нагло залезла под её передник.'
            *pl ' '
            *pl '— Аманда! Живо в зал! — гремит ваш голос в тишине двора.'
            *pl ' '
            *pl 'Сестра вскрикивает, отскакивает от купца и судорожно одёргивает смятую юбку, заливаясь краской жгучего стыда.'
            *pl 'Легаре медленно поворачивается к вам. В его взгляде вспыхивает холодная злоба аристократа, пойманного за недостойным занятием:'
            *pl '— Вы слишком много себе позволяете, трактирщик. Дверь вашего кабака открыта для благородных людей, а не для собачьего лая.'
            *pl '— Благородные люди не щупают чужих сестёр по тёмным углам, — цедите вы сквозь зубы, сжимая кулаки. — Убирайтесь вон со двора, пока я не позвал парней с дубьём.'
            *pl ' '
            *pl 'Купец брезгливо отряхивает бархат рукава и уходит во тьму переулка. Стычка кончилась, но этот конфликт трактиру ещё припомнят.'

        else:
            *pl 'Вы быстрым шагом выходите на заднее крыльцо и замечаете Аманду на полпути к дальнему навесу.'
            *pl ' '
            *pl 'Она вздрагивает от скрипа ступеней и испуганно оборачивается, пряча руки за спину:'
            *pl '— Стефан? А я... я за лучиной пошла...'
            *pl '— Лучина лежит в сухом чулане под лестницей, — сухо отрезаете вы. — Марш в зал, пока мать не заметила твоего отсутствия.'
            *pl ' '
            *pl 'Аманда недовольно поджимает губы, но без споров спешит обратно в тепло трактира. В этот раз вы успели перехватить её до того, как стряслась беда.'
        end

    elseif $MajorRiskTextChoice = 'take_melissa':
        *pl 'Вы подходите к Мелиссе и тихо бросаете:'
        *pl '— Аманды нет в зале. Идём со мной.'
        *pl ' '
        *pl 'Мелисса не тратит время на расспросы — её лицо мгновенно становится сосредоточенным и строгим. Вдвоём вы выходите через заднюю дверь.'
        *pl ' '
        *pl 'Возле бочек у забора вы застаёте Аманду и Легаре. Купец как раз склонился к девушке, держа её за руку, но при виде сразу двоих хозяев трактира отстраняется с натянутой светской улыбкой.'
        *pl ' '
        *pl 'Мелисса выступает вперёд, скрестив руки на груди, и произносит ледяным, язвительным тоном:'
        *pl '— Какая трогательная забота о хозяйстве, господин Легаре. Не знала, что закупка винных бочек требует столь глубокого уединения среди навозных куч. Аманда, вернись к своим обязанностям.'
        *pl ' '
        *pl 'Аманда вспыхивает от унижения и пулей несётся в дом. Легаре сухо кланяется, кривя губы, и удаляется прочь. Семейный отпор сработал безукоризненно.'

    elseif $MajorRiskTextChoice = 'sneak':
        if AmandaLegareMajorRiskResult = 2:
            gs 'AmandaLegareMajorRiskSneakSceneText'
        else:
            *pl 'Вы крадётесь вдоль каменной кладки, стараясь не производить лишнего шума.'
            *pl ' '
            *pl 'У выхода во двор вы видите Аманду совершенно одну. Она нервно теребит край фартука и напряжённо всматривается в темноту за воротами, словно ждёт кого-то, кто не пришёл на условленное свидание.'
            *pl ' '
            *pl 'Увидев, как вы выходите из тени, она неловко вздрагивает и тут же напускает на себя деловой вид, хватаясь за пустое ведро. Свидание не состоялось, но её намерения видны как на ладони.'
        end

    elseif $MajorRiskTextChoice = 'wait_hall':
        *pl 'Вы остаётесь за стойкой, заставляя себя сохранять внешнее спокойствие, хотя внутри всё кипит от подозрения.'
        *pl ' '
        *pl 'Минуты тянутся мучительно долго. Наконец боковая дверь скрипит, и Аманда возвращается в общий зал.'
        *pl 'Она судорожно оглаживает платье, торопливо поправляет растрепавшуюся косу и старается не смотреть в вашу сторону. На ваш немой вопрос она лишь бросает короткое:'
        *pl '— Жарко было у печи, вышла продышаться.'
        *pl ' '
        *pl 'Вы молча киваете, но неизвестность грызёт душу сильнее любой открытой ссоры: что именно произошло в темноте за стенами, остаётся для вас тайной.'

    else:
        *pl 'Аманда возвращается в зал, но напряжение между вами становится почти осязаемым.'
    end

    killvar '$MajorRiskTextChoice'
---