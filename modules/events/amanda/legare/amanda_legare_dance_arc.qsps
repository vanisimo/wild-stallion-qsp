    *pl ' ПОДВОРОТНЯ У ПЛОЩАДИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaLegareFridayRaceActionText') = 1:
        gs 'AmandaLegareFridayRaceActionText', $FridayRaceChoice
    else:
        *p 'Вечер делает свой вывод — и вы тоже.'
    end

    *pl ' '

    if $FridayRaceChoice = 'watch':
        if AmandaLegareFridayRaceWatchRollHard = 1:
            gs 'AmandaLegareWitnessRegister', 'amanda_legare_peek_friday'
        else
            gs 'AmandaLegareWitnessRegister', 'amanda_legare_peek_friday_flirt'
        end
    end

    AmandaLegarePeekReactionDone = 0
    gs 'AmandaLegarePeekReactionStart', 'friday_race', 'MarketDance'

