! ================================================
! FILE: modules/events/amanda/legare/amanda_legare_second_meet_text.qsps
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты второй попытки Легаре увести Аманду дальше
! Используется кодом:
! modules/events/amanda/legare/amanda_legare_second_meet.qsps
! ================================================

#AmandaLegareSecondMeetIntroText
    *pl 'Ближе к вечеру в трактире сгущается тёплый полумрак: сальные светильники чадят под балками, а в зале шумно переговариваются засидевшиеся ремесленники.'
    *pl 'Аманда с деревянным подносом направляется в полутёмный боковой коридор, ведущий к винному погребу и выходу на задний двор.'
    *pl ' '
    *pl 'Однако путь ей преграждает фигура, возникшая прямо из тени дверного проёма. Месье Альбер Легаре — без дорожной накидки, в одном изящном шёлковом дублете — вальяжно опирается плечом о косяк, лишая сестру возможности быстро вернуться в светлый зал.'
    *pl ' '
    *pl 'Сквозь общий гул голосов до вас долетает его бархатный, вкрадчивый полушёпот и сдавленный, взволнованный смешок сестры. Купец явно пришёл не за покупками: наклонившись к самому лицу девушки, он манит её разговорами о прохладе за городской стеной, где нет запаха дешёвого пойла и назойливых глаз.'
---

#AmandaLegareSecondMeetActionText
    $SecondMeetTextChoice = LCASE($ARGS[0])

    if $SecondMeetTextChoice = 'bring_back':
        *pl 'Вы решительно шагаете в коридор, не позволяя разговору зайти дальше невинного флирта.'
        *pl 'Подойдя вплотную, вы забираете у растерявшейся сестры поднос и негромко, но твёрдо произносите:'
        *pl '— Аманда, на дальнем столе пролили пиво, а Сандра на кухне с ног сбивается. Живо в зал, работать.'
        *pl ' '
        *pl 'Сестра вспыхивает от досады, закусывает губку и бросает на купца виноватый, извиняющийся взгляд. Ей явно не по душе, что её выдернули из красивой светской беседы обратно к кабацкой рутине, но спорить при госте она не решается и сердито цокает каблучками в сторону стойки.'
        *pl ' '
        *pl 'Легаре остаётся стоять в проёме. На его холёном лице играет спокойная, чуть насмешливая улыбка человека, у которого просто украли лишнюю минуту:'
        *pl '— Какая похвальная строгость, месье Стефан... Впрочем, вечер ещё далёк от завершения. Мы никуда не спешим.'

    elseif $SecondMeetTextChoice = 'confront_legare':
        *pl 'Вы решительным движением отстраняете сестру себе за спину и встаёте вплотную к купцу, глядя ему прямо в глаза.'
        *pl ' '
        *pl '— Месье Легаре, вино в наш погреб вы уже доставили, счета закрыты. Что именно вы вынюхиваете в тёмных коридорах моего заведения?'
        *pl ' '
        *pl 'Легаре медленно выпрямляется. Его светский лоск на мгновение даёт трещину, уступая место холодной барской спеси:'
        *pl '— Попридержите пыл, молодой человек. Вы забываете, чьи поставки делают кассу этому захолустному кабаку. И уж точно не вам указывать, с кем очаровательной барышне вести беседу.'
        *pl '— В своём доме я решаю всё от порога до крыши, — сухо и жёстко отчеканиваете вы. — Выход — там. И советую не испытывать моё терпение.'
        *pl ' '
        *pl 'В зале на секунду повисает настороженная тишина — пара посетителей оборачивается на резкие тона. Взгляд купца темнеет от затаённой злобы. Не говоря больше ни слова, он надменно одёргивает манжеты и скорым шагом покидает трактир.'
        *pl 'Аманда испуганно жмётся к стене: скандал вышел громким, и виноторговец наверняка припомнит эту обиду при следующих сделках, но граница дозволенного в вашем доме проведена железом.'

    elseif $SecondMeetTextChoice = 'follow_more':
        if AmandaLegareSecondMeetResult = 2:
            *pl 'Вы остаётесь в густой тени за бочками у входа в коридор, внимательно вслушиваясь в каждое слово.'
            *pl ' '
            *pl 'Легаре плетёт свою сеть с виртуозностью опытного обольстителя. Он не распускает руки, но его речи звучат сладко и дурманяще: купец обещает показать Аманде заморские шелка, привезённые из столицы, примерить колье с чистейшим гранатом и прокатить её в закрытом экипаже к уединённой беседке у старой крепостной стены.'
            *pl ' '
            *pl 'Аманда слушает, затаив дыхание, её пальчики нервно теребят кружево передника. Она не соглашается сразу, но её прерывистый вздох и пылающий румянец говорят сами за себя. Поцеловав кончики её пальцев, Легаре обещает ждать её условного знака и бесшумно растворяется в сумерках переулка.'
            *pl 'Сестра прижимает руку к пылающей груди и ещё долго стоит без движения. Теперь вы точно знаете: затевается нечто куда более опасное, чем простая болтовня.'
        else:
            *pl 'Вы замираете за штабелем ящиков, готовый вмешаться при малейшей попытке распустить руки.'
            *pl 'Однако купец сегодня осторожничает. Он расточает цветистые комплименты и зовёт Аманду прогуляться на свежем воздухе, но сестра держится на удивление благоразумно.'
            *pl ' '
            *pl 'Памятуя о строгом наказе семьи, Аманда кокетливо отшучивается, ловко ускользает из-под его ладони и со смехом выбегает обратно в освещённый зал к заказам.'
            *pl 'Легаре остаётся в полумраке коридора один. Раздосадованно постучав перстнем по дверному косяку, он понимает, что крепость с наскока не взять, и не солоно хлебавши уходит в вечерний город.'
        end

    elseif $SecondMeetTextChoice = 'ignore':
        *pl 'Вы нарочно отворачиваетесь и возвращаетесь к стойке, делая вид, что полностью поглощены подсчётом выручки.'
        *pl ' '
        *pl 'Легаре мгновенно пользуется отсутствием надзора. Почувствовав, что хозяин трактира не вмешивается, он увлекает Аманду в самую глухую тень бокового выхода.'
        *pl ' '
        *pl 'Вы не слышите их шёпота, но через пару минут замечаете, как купец бережно вкладывает в ладонь девушки что-то маленькое — тонкую шёлковую ленту, пахнущую восточными благовониями.'
        *pl 'Аманда торопливо прячет подарок в декольте корсажа, поправляет растрёпанные волосы и возвращается в зал с затуманенным, мечтательным взглядом.'
        *pl 'Между ней и виноторговцем легла первая общая тайна, и эта тайна очень скоро постучится в двери вашей семьи.'

    else:
        *pl 'Вторая встреча с купцом оставляет после себя тревожное чувство приближающейся развязки.'
    end

    killvar '$SecondMeetTextChoice'
---
