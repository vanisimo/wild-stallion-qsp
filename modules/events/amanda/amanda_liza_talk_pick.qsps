        gs 'AmandaOralOnOverhearPhrase', 'lizette_oral_practice'
    elseif $AmandaLizaTalkEffectId = 'lizette_balls_hint':
        gs 'AmandaLizaTalkApplyInfluence', 28, 20, 30
        gs 'AmandaOralOnOverhearPhrase', 'lizette_balls_hint'
    elseif $AmandaLizaTalkEffectId = 'lizette_atm_clean':
        gs 'AmandaLizaTalkApplyInfluence', 35, 24, 36
        gs 'AmandaOralOnOverhearPhrase', 'lizette_atm_clean'
    elseif $AmandaLizaTalkEffectId = 'lizette_rim_fair':
        gs 'AmandaLizaTalkApplyInfluence', 40, 28, 40
        gs 'AmandaOralOnOverhearPhrase', 'lizette_rim_fair'
    elseif $AmandaLizaTalkEffectId = 'amanda_dream_full_mirror':
        gs 'AmandaLizaTalkApplyInfluence', 8, 6, 12
        PlayerKnows_Dream_FullLengthMirror = 1
        DreamItemKnown['full_length_mirror'] = 1

    elseif $AmandaLizaTalkEffectId = 'marathon_exhausted':
        AmandaLizaInfluence += 1

        if AmandaLizaInfluence > 100:
            AmandaLizaInfluence = 100
        end

        SexMarathonGossipPending['amanda'] = 0
        SexMarathonGossipLastDay['amanda'] = day
    end

    killvar '$AmandaLizaTalkEffectId'
