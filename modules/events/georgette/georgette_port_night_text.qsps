! ================================================
! FILE: modules/events/georgette/georgette_port_night_text.qsps
! MODULE: events/georgette
! [AI-WORKED] 2026-09-08: canon prose overhaul
! Тексты ночного порта (этап B3)
! ================================================

#GeorgettePortNightText
    $GeorgettePortNightTextId = LCASE($ARGS[0])
    $GeorgettePortNightText = ''

    if $GeorgettePortNightTextId = 'intro':
        $GeorgettePortNightText = 'Ночной порт дышит сыростью, скрипом швартовых и терпким запахом просмолённых канатов. Одинокие фонари на столбах покачиваются под порывами ветра, бросая длинные дрожащие тени на мокрые доски набережной. У дальнего пакгауза виднеется Жоржетта — она ждёт полуночных гостей, уверенная и спокойная в привычной стихии.'
    elseif $GeorgettePortNightTextId = 'peek':
        $GeorgettePortNightText = 'Вы задерживаетесь в густой тени между штабелями бочек. Жоржетта у стены склада негромко переговаривается с рослым матросом — смеётся низким грудным смехом, легко парирует его грубоватые шуточки и без лишней суеты договаривается о цене. Она прекрасно знает, чего хотят мужчины, и умеет брать своё.'
    elseif $GeorgettePortNightTextId = 'no_money':
        $GeorgettePortNightText = 'Жоржетта окидывает вас насмешливым взглядом, примечая пустой кошель на поясе, и негромко посмеивается, прислонившись к просмолённой стене склада:'
        $GeorgettePortNightText += '<br><br>— Э нет, Стефанчик, так дело не пойдёт. Десять спинтарий на бочку — и я вся твоя, хоть до рассвета крути, как вздумается. А за красивые глаза и доброе имя твоего папаши сыт не будешь. Приходи, как звякнет серебро — порт никуда не уплывёт, и я отсюда до утра не сбегу.'
    elseif $GeorgettePortNightTextId = 'after_sex':
        if HadSex['georgett'] <= 1:
            $GeorgettePortNightText = 'Жоржетта, тяжело дыша, опускает подол платья и опирается влажной спиной на борт разгрузочной телеги. На бёдрах блестит испарина, светлые золотистые пряди прилипли к разгорячённому лбу, а в ясных голубых глазах пляшут довольные искорки. Она не торопится приводить себя в строгий порядок — лишь поправляет расшнурованный корсет на пышной груди, смакуя послевкусие ночной близости на солёном морском ветру.'
            $GeorgettePortNightText += '<br><br>— А ты хваткий, хозяин трактира, — хрипловато усмехается она, слизывая с верхней губы капельку пота. — Не думала, что за барной стойкой учат так сладко управляться с бабами. Думала, помнёшь для виду да кончишь через минуту, как половина здешних матросов. А ты меня уважил… даже ноги до сих пор гудят.'
            $GeorgettePortNightText += '<br><br>Она пересчитывает монеты на ладони, ловко прячет их в потайной кармашек под юбкой и подмигивает вам:'
            $GeorgettePortNightText += '<br><br>— Только не воображай, будто купил меня насовсем. Ночь была славной, Стефан. Захочешь повторить — ты знаешь, у какого склада меня искать.'
        else:
            $GeorgettePortNightText = 'Жоржетта вытирает ладонью лоб, расправляет складки смятого платья и с наслаждением потягивается всем телом, сладко хрустнув позвонками. В её движениях сквозит привычная, ленивая истома — после хорошей работы тело поёт, а на губах играет сытая полуулыбка.'
            $GeorgettePortNightText += '<br><br>— С каждым разом ты всё увереннее, Стефан, — негромко посмеивается она, оглядывая вас с ног до головы без малейшего стеснения. — Сразу видно: постоянный клиент толк в удовольствии знает. С тобой и серебро приятно брать, и самой покрутиться не грех.'
            $GeorgettePortNightText += '<br><br>Она прячет заработанные спинтарии под корсет, подбирает шаль и поправляет растрепавшиеся волосы:'
            $GeorgettePortNightText += '<br><br>— Ступай, пока стража не заглянула за угол пакгауза, а то набегут с расспросами. А мне ещё до утра стоять — порт длинный, клиентов много, да и ночь только в разгаре.'
        end
    end

    killvar '$GeorgettePortNightTextId'
---