! ================================================
! FILE: modules/events/georgette/georgette_lizette_intro_text.qsps
! [AI-WORKED] 2026-09-07: beautiful rewrite, Georgette & Lizette lore
! Тексты первого знакомства с Жоржеттой и упоминания Лизетты
! Используется логикой:
! modules/events/georgette/georgette_lizette_intro.qsps
! Основные вызывающие локаторы:
! #GeorgetteFirstMeet
! #GeorgettePortTalk
! ================================================

#GeorgetteLizetteIntroText
    $GeorgetteLizetteTextId = LCASE($ARGS[0])
    $GeorgetteLizetteIntroText = ''

    if $GeorgetteLizetteTextId = 'first_meet':
        $GeorgetteLizetteIntroText = 'У самой кромки причала ты замечаешь женщину, которая держится здесь так свободно и легко, будто весь этот шумный порт это озеро а она в нем рыба. Женщина перешучивается с матросами без тени робости, ловко уворачивается от тяжёлых тюков и провожает портовых грузчиков насмешливым взглядом.'
        $GeorgetteLizetteIntroText += '<br><br>Поймав твой взгляд, она медленно оглядывает тебя с ног до головы — не смущаясь, с лёгкой улыбкой опытной женщины, которая сразу подмечает и стать, и уверенность, и вес кошелька на поясе.'
        $GeorgetteLizetteIntroText += '<br><br>— Ты, никак, новый хозяин «Дикого Жеребца»? Стефан, верно? — её голос звучит низко, с мягкой хрипотцой и ленивой усмешкой. — Я Жоржетта. В порту обо всех новостях и делах узнают раньше, чем на городских улочках. Приятно познакомиться, трактирщик.'

    elseif $GeorgetteLizetteTextId = 'port':
        $GeorgetteLizetteIntroText = 'Жоржетта опирается бедром на швартовую тумбу и кивает в сторону пузатого торгового судна у дальнего пирса:'
        $GeorgetteLizetteIntroText += '<br><br>— Когда швартуется столичный борт, порт оживает по-настоящему. Весь город сбегается к причалу: лавочники торгуются за пряности, слуги высматривают шёлк, а девчонки бегут поглазеть на блестящие безделушки. Для нашего тихого угла любая заморская лента — уже диковинка. Маленький городок, Стефан... тут легко потерять голову от заезжего блеска.'
        $GeorgetteLizetteIntroText += '<br><br>Она усмехается, поправляя выбившийся локон:'
        $GeorgetteLizetteIntroText += '<br><br>— А я люблю такие дни. Суета, шум, кошельки развязаны... Где чужие деньги и чужие страсти — там и мне всегда найдётся дело.'

    elseif $GeorgetteLizetteTextId = 'daughter':
        $GeorgetteLizetteIntroText = 'При упоминании дочери лицо Жоржетты на мгновение теплеет, а в глазах появляется мягкая, чуть снисходительная улыбка:'
        $GeorgetteLizetteIntroText += '<br><br>— Лизетта? Моя дочка, да. Нагуляла её по молодости от заезжего чужеземца с южного корабля — смуглая, глаза горячие, вся в отца пошла, а упрямством — чистая я. Только молодая ещё, глупая... думает, жизнь — это сплошной праздник и блеск заморских бус.'
        $GeorgetteLizetteIntroText += '<br><br>Она бросает взгляд сквозь толпу в сторону сходней:'
        $GeorgetteLizetteIntroText += '<br><br>— Ей ведь здесь, в порту, и словом перекинуться не с кем, кроме матросни да грузчиков. А девчонке в восемнадцать лет подружка нужна, понимаешь? Чтобы было с кем посекретничать, ленту к волосам примерить, посмеяться о своём, девичьем. Вот она и тянется к молодым девочкам из города — как мотылёк на огонёк.'
        $GeorgetteLizetteIntroText += '<br><br>— Видела, как она на днях переглядывалась с твоей сестрой у лавок. Ты не хмурься, Стефан. Лиза девка добрая, зла никому не желает. Ей просто до смерти осточертели солёные матросские шутки — хочется с кем-то одного возраста языками почесать: наряды, товары из-за моря, мальчики... мало ли о чём девушки могут трещать без умолку.'

    else:
        $GeorgetteLizetteIntroText = 'Жоржетта держится легко, без фальшивого стыда и притворства. Она повидала в жизни слишком много мужчин, чтобы смущаться простых взглядов или резких слов. В каждом её движении чувствуется женственность и уверенность знатока портовых законов — с ней не нужно строить из себя святого, и от этого дышится удивительно легко.'

    end

    killvar '$GeorgetteLizetteTextId'
---
