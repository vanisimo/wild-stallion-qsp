! ================================================
! FILE: modules/events/georgette/georgette_seek_lizette_text.qsps
! MODULE: events/georgette
! [AI-WORKED] 2026-09-07: beautiful atmospheric rewrite, character voices
! Тексты: Жоржетта ищет Лизетту в порту
! ================================================

#GeorgetteSeekLizetteText
    $GeorgetteSeekTextId = LCASE($ARGS[0])
    $GeorgetteSeekText = ''

    if $GeorgetteSeekTextId = 'intro':
        $GeorgetteSeekText = 'У причала, среди грохота разгружаемых бочек, скрипа сходней и резких криков чаек, стоит Жоржетта. Морской ветер треплет её светлые волосы, выбившиеся из-под простой косынки, и туго облепляет выцветшее, но ладно сидящее по пышной фигуре платье. Она упёрла руки в бока и зорко всматривается в пёструю людскую толпу у торговых рядов, совершенно не обращая внимания на масляные взгляды проходящих мимо матросов.'

    elseif $GeorgetteSeekTextId = 'search':
        $GeorgetteSeekText = '— Лизка! Да где тебя черти носят, негодница?! — её зычный, грудной голос легко перекрывает стук топоров конопатчиков и шум прибоя. — Опять у столичных тюков зависла?! А ну шагай сюда, покуда матросня бока не намяла!'
        $GeorgetteSeekText += '<br><br>Из-за высокой штабели тюков с заморской шерстью мелькает яркая ткань, и оттуда с недовольной миной высовывается девчонка. Смуглая, с точёным личиком и копной тёмных кудрей, она раздражённо отмахивается от матери связкой дешёвых бусин:'
        $GeorgetteSeekText += '<br><br>— Да чего ты разоралась на весь причал, мам?! Никуда я не делась, ленты смотрела! Сама же сказала — товар глянуть!'
        $GeorgetteSeekText += '<br><br>— Я сказала глянуть, а не полдня торчать у чужих сходней! — переругивается Жоржетта через головы грузчиков, но в голосе вместо настоящей злости слышна лишь привычная материнская досада.'

    elseif $GeorgetteSeekTextId = 'meet_stefan':
        $GeorgetteSeekText = 'Ты подходишь ближе. Услышав шаги за спиной, Жоржетта резко оборачивается — рука машинально ложится на бедро, во взгляде вспыхивает мгновенная портовая настороженность. Но, разглядев тебя, она тут же опускает плечи и широко, насмешливо улыбается:'
        $GeorgetteSeekText += '<br><br>— А, трактирщик! Стефан, верно? Извини за шум — с этой вертихвосткой никакого сладу нет. На пять минут к причалу отпустишь — уже среди матросов крутится, ленты щупает да зубы скалит.'
        $GeorgetteSeekText += '<br><br>Она качает головой, скрестив руки под пышной грудью:'
        $GeorgetteLizetteText = '— Дочка моя, Лизетта. Вся в отца-чужеземца пошла: и кожа смуглая, и норов как у дикой кобылицы. Ей ведь здесь скучно одной среди грузчиков да матросни, вот и тянется к городским девчонкам, ищет с кем поболтать не из матросни... Ты, часом, у корабля её не приметил на днях?'
        $GeorgetteSeekText += '<br><br>' + $GeorgetteLizetteText
        killvar '$GeorgetteLizetteText'
        $GeorgetteSeekText += '<br><br>— Видел, — усмехаешься ты, вспоминая их оживлённый шепоток с Амандой у трапа. — Шустрая она у тебя.'
        $GeorgetteSeekText += '<br><br>— Шустрая — не то слово, глаз да глаз нужен, — хмыкает Жоржетта, но по глазам видно, что дерзость дочери ей втайне даже льстит.'

    elseif $GeorgetteSeekTextId = 'night_invite':
        $GeorgetteSeekText = 'Она окидывает тебя долгим, откровенным взглядом — скользит по крепким плечам, широкой груди и задерживается на лице, чуть прикусив нижнюю губу:'
        $GeorgetteSeekText += '<br><br>— Днём здесь разговора не выйдет, Стефан: то бочкой заденут, то криком оглушат. А вот ночью порт совсем другой... Тихий, пустой, только волны о сваи бьются.'
        $GeorgetteSeekText += '<br><br>Она наклоняется чуть ближе, так что до тебя долетает тёплый аромат её кожи и солёного морского ветра:'
        $GeorgetteSeekText += '<br><br>— Если захочешь потолковать по душам — или развеяться от своих трактирных забот — заглядывай к дальним складам после заката. Я знаю укромные углы, где никто не сунет нос не в своё дело. И поболтаем, и... сладкого отведаешь, если монеты в кармане не поют романсы.'

    end

    killvar '$GeorgetteSeekTextId'
---
