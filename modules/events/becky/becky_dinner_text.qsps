#BeckyDinnerUnderTableCumKissText
    if sluttiness['inga'] >= 50 and sluttiness['becky'] >= 50:
        $BeckyHomeText = 'Бекки и Инга почти одновременно выбираются из-под скатерти на всеобщее обозрение. У обеих губы блестят, а рты полны густого горячего семени мужчин!<br>Не обращая внимания на ошарашенных Эдди и Лукаса, мать и дочь жадно смотрят друг другу в глаза, улыбаются — и прямо над обеденным столом сливаются в долгом, влажном поцелуе губы в губы!<br>Их языки сплетаются, перемешивая белую вязкую сперму, часть которой стекает по подбородкам на пышные вырезы платьев. Мужчины за столом сидят оцепеневшие от дикого, нечестивого экстаза!'
    else:
        $BeckyHomeText = 'Бекки и Инга выбираются из-под скатерти, отирая влажные губы льняными салфетками. Они обмениваются смущённым взглядом, быстро приводя себя в благопристойный вид.'
    end
