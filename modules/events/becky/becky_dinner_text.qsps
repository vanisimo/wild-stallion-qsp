#BeckyDinnerWagonSexFinishText
    if $BeckyWagonSexPlace = 'table':
        $BeckyHomeText = 'Финал настигает вас с сокрушительной силой! Ты вдавливаешь девушку в дубовую столешницу и изливаешь реки кипящего семени в самую глубину её лона!<br>Инга бьётся в бешеном, судорожном оргазме, запрокинув голову и сдерживая крик восторга в складках фартука. Её бёдра мелко вздрагивают, плотно сжимая тебя до самого последнего пульсирующего толчка.'
    else:
        $BeckyHomeText = 'Оконное стекло покрывается влажным конденсатом от её горячего дыхания. На пределе страсти ты прижимаешь её к широкому подоконнику и изливаешь семя в её пульсирующую глубину!<br>Инга вздрагивает всем телом, переживая сокрушительный экстаз прямо у окна ночного города. Её пальцы до побелевших костяшек вцепляются в раму, а губы беззвучно ловят холодный воздух.'
    end
