#BeckyHomeGuestDinnerGrope2Text
    if sluttiness['becky'] >= 40:
        $BeckyHomeText = 'Твои пальцы бесцеремонно скользят под подол просторного домашнего платья Бекки. Кожа вдовы обжигающе горячая, шелковистая и влажная. На ней нет панталон — пальцы сразу погружаются в разгорячённую гущу зрелого женского лона!<br>Бекки судорожно втягивает воздух сквозь зубы, закатывая глаза. Под скатертью она сама подаётся навстречу твоей руке, насаживаясь на пальцы. На бытовой вопрос Инги о завтрашней муке мать отвечает сдавленно и невпопад: «Да-да, доченька… всё купим… ах...»'
    else:
        $BeckyHomeText = 'Твои дерзкие пальцы медленно поднимаются выше по бедру, забираясь под мягкую ткань подола. Кожа у вдовы под платьем горячая и нежная.<br>Дыхание Бекки сбивается, на щеках разгорается густой румянец. Под надёжной защитой длинной скатерти она незаметно приоткрывает бёдра шире, позволяя твоей руке добраться до влажной ткани нижнего белья. На реплику Эдди вдова отвечает сбивчиво, прикусив нижнюю губу: «Да, сынок… конечно… ох...»'
