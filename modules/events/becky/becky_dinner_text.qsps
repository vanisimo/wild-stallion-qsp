                if $BeckyPorchCompanion = 'eddie':
                    $BeckyHomeText = 'Бекки под столом сладострастно заглатывает твой член, причмокивая и помогая ладонью. Ты нарочито приподнимаешь край скатерти перед носом Эдди.<br>Парень устремляет взгляд вниз — и застывает с разинутым ртом! Увидев родную мать на коленях перед гостем, Эдди сначала багровеет до корней волос, а затем сдавленно шепчет: «Мама… Ильматер праведный… Стефан, ты… ты прямо хозяин в нашем доме стал…»'
                else:
                    $BeckyHomeText = 'Бекки усердно работает ртом над твоей плотью. Лукас наклоняется и приподнимает скатерть, оценивая происходящее с понимающей усмешкой торговца:<br>— Ай да тётушка Бекки! Знает, кому уважение оказывать. За щедрого трактирщика, Стефан!'
                end
            else:
                $BeckyHomeText = 'Бекки со всей накопившейся женской похотью выжимает из твоего члена последние соки! Её губы скользят до самых яиц, пальцы неистово ласкают ствол. Вдова готова довести дело до сокрушительного финала прямо на глазах у всех!'
            end
        elseif $BeckyUnderTableTarget = 'eddie':
            ! Becky -> Eddie
            if BeckyUnderTableTier = 1:
                $BeckyHomeText = 'Под покровом скатерти Бекки опускается к ногам собственного сына. Эдди сидит неподвижно как истукан, боясь пошевелиться от запретного наслаждения.'
            elseif BeckyUnderTableTier = 2:
                $BeckyHomeText = 'Бекки жадно сосёт уд родного сына. Ты шутливо приподнимаешь скатерть и подмигиваешь ошалевшему парню:<br>— Что, Эдди, мать сыночка без сладкого спать не отпустит? Парень сидит пунцовый, кусая губы от дикого стыда и греховного восторга.'
            else:
                $BeckyHomeText = 'Бекки доводит родного сына до предела сладострастия под общим обеденным столом, готовясь явить плоды своих трудов!'
            end
        else:
            ! Becky -> Lucas
            if BeckyUnderTableTier = 1:
                $BeckyHomeText = 'Бекки под столом одаривает тайными ласками жениха своей дочери. Лукас затаил дыхание, боясь выдать дрожь в голосе.'
            elseif BeckyUnderTableTier = 2:
                $BeckyHomeText = 'Бекки ублажает Лукаса. Ты заглядываешь под скатерть и с усмешкой комментируешь: «Тёщина забота — самая надёжная, правда, Лукас?» Парень лишь судорожно кивает, расплываясь в хмельной улыбке.'
            else:
                $BeckyHomeText = 'Бекки неистово ласкает Лукаса, приближая громкую кульминацию под столовой скатертью.'
            end
        end
    end
---

#BeckyDinnerUnderTableCulminationText
    if $BeckyUnderTableGirl = 'both':
        $BeckyHomeText = 'Бурная развязка накрывает вас обоих! Потоки горячего семени заполняют рты обеих прелестниц под столом!<br><br>Спустя миг Бекки и Инга синхронно выбираются из-под скатерти на свет свечи. У обеих губы влажно блестят, а рты полны густой белой жидкости! Не обращая внимания на оцепеневших мужчин, мать и дочь жадно смотрят друг другу в глаза, улыбаются — и прямо над обеденным столом сливаются в долгом, порочном поцелуе губы в губы!<br>Их языки сплетаются, перемешивая семя, излишки которого стекают по подбородкам на пышные вырезы платьев. Мужчины за столом сидят онемевшие от этого абсолютного триумфа греха и раскрепощения!'
    elseif $BeckyUnderTableGirl = 'inga':
        $BeckyHomeText = 'Горячее семя фонтаном изливается прямо в рот юной Инги! Девушка судорожно принимает всё без остатка.<br><br>Она не спеша выбирается из-под стола, оглаживая помятое платье. Её щёки пылают, а взгляд затуманен сладкой истомой. Инга приоткрывает рот, бесстыдно демонстрируя залитый семенем язык, а затем медленно, с наслаждением сглатывает его на глазах у сидящих за столом мужчин, слизывая белую каплю с губы: «Очень вкусно…»'
    else:
        $BeckyHomeText = 'Вдова с упоением принимает мощный выстрел горячего семени до последней капли в свой ненасытный рот!<br><br>Бекки тяжело и с кряхтением выбирается из-под стола, поправляя фартук на пышной груди. На её зрелом лице сияет довольная, масляная улыбка. Она показательно облизывает пухлые губы, шумно сглатывает и подмигивает: «Вот так-то лучше… Мужчина сыт должен быть со всех сторон!» Мужчины лишь одобрительно поднимают кружки в немом восхищении.'
    end
---

#BeckyDinnerPorchEndText
    $BeckyHomeText = 'Семейная трапеза окончательно подходит к концу. Праздничный кувшин трактирного вина пуст, в печи тихо дотлевают багровые угли.<br>Обменявшись с хозяевами дома многозначительными хмельными взглядами и крепкими рукопожатиями, ты застёгиваешь плащ и выходишь в ночную прохладу спящего города.'
