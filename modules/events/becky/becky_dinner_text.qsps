#BeckyHomeGuestDinnerIntroText
    if BeckyDinnerLucasState = 0:
        $BeckyHomeText = 'В уютной столовой дома Блэнкеншипов тепло и аппетитно пахнет тушёной бараниной с диким луком да травами. Просторный дубовый стол накрыт чистой белёной скатертью, по центру дымится глиняный котелок с сытным рагу, красуется свежий каравай.<br>Напротив сидит Эдди, расправив плечи с важным видом взрослого хозяина дома. Рядом с ним сидит Инга — без жениха, задумчивая и непривычно тихая. Место возле неё пустует: после недавних размолвок Лукас здесь больше не появляется.<br>Младшие ребятишки уже сыты и крутятся у тёплой печи, пока мать строго не цыкает на них: "А ну, марш на полати спать, не мешайте взрослым разговаривать!"<br>Сама хозяйка, улыбчивая и пышная Бекки, ставит перед тобой глубокую тарелку: "Кушай, Стефанчик, налегай! В моём доме гостей голодными не отпускают. У нас всё по-соседски — от чистого сердца!"'
    elseif BeckyDinnerLucasState = 1:
        $BeckyHomeText = 'В уютной столовой дома Блэнкеншипов тепло и аппетитно пахнет тушёной бараниной с диким луком да травами. На столе дымится сытное рагу и свежий хлеб.<br>На скамье напротив сидят Эдди, Инга и Лукас. Между молодыми висит тяжёлое молчание: Лукас сидит насупившись, боясь поднять глаза, а Инга демонстративно отворачивается к стене, не желая даже словом перемолвиться с женихом. Младших детей Бекки быстро отправляет на печь спать.<br>Бекки вздыхает и сглаживает неловкость заботливой улыбкой: "Кушай, Стефанчик, не обращай внимания на этих упрямцев. Горячее рагу любую обиду растопит!"'
    else:
        $BeckyHomeText = 'В уютной столовой дома Блэнкеншипов тепло и аппетитно пахнет тушёной бараниной с диким луком да травами. Просторный дубовый стол накрыт чистой белёной скатертью, по центру дымится пузатый глиняный котелок с сытным рагу, красуется свежеиспечённый хрустящий каравай и миски с соленьями.<br>На скамье напротив чинно сидит Эдди — он старательно расправляет плечи и воротник, пытаясь сойти за солидного хозяина дома. Рядом с ним устраиваются Инга с женихом Лукасом — парочка то и дело переглядывается и хихикает. Младшие ребятишки шумно крутятся у тёплой печи, пока мать строго не отправляет их наверх спать.<br>Сама хозяйка, улыбчивая и пышнотелая Бекки, ставит перед тобой большую глубокую тарелку: "Кушай, Стефанчик, налегай! В моём доме гостей голодными не отпускают. У нас тут всё по-простому, по-соседски — зато от чистого сердца да с пылу с жару!"'
    end
---

#BeckyHomeGuestDinnerWineText
    if BeckyDinnerLucasState = 0:
        $BeckyHomeText = 'Ты щедрым жестом выставляешь на стол пузатый кувшин выдержанного трактирного вина из глубоких погребов «Дикого Жеребца» и узелок с пряными копчёностями.<br>— Ого, истинное из барских погребов! — Эдди мгновенно оживляется, с азартом хватаясь за кружку.<br>Бекки с признательной улыбкой принимает угощение, пригубляет вина и делает глубокий глоток. Её щёки тут же вспыхивают румянцем: "Ай да Стефанчик, ай да молодчина! Настоящее доброе вино, прямо душу греет да кровь разгоняет."<br>Инга украдкой бросает на тебя долгий, благодарный взгляд и пригубляет вино: "За нашего лучшего соседа!"'
    else:
        $BeckyHomeText = 'Ты щедрым жестом выставляешь на стол пузатый кувшин выдержанного трактирного вина из глубоких погребов «Дикого Жеребца» и узелок с пряными копчёностями.<br>— Ого, истинное из барских погребов! — Эдди с Лукасом мгновенно оживляются, с азартом хватаясь за глиняные кружки.<br>Бекки с признательной улыбкой принимает угощение, пригубляет вина и делает глубокий глоток. Её щёки тут же вспыхивают тёплым румянцем, а взгляд расцветает нежностью: "Ай да Стефанчик, ай да молодчина! Настоящее доброе вино, густое, хмельное… Прямо душу греет да кровь разгоняет."<br>Инга с озорной ухмылкой приподнимает свою кружку: "За нашего щедрого соседа!" Напряжение первых минут окончательно рассеивается, уступая место душевным хмельным разговорам.'
    end
---

#BeckyHomeGuestDinnerEatText
    if BeckyDinnerEatTurn = 1:
        $BeckyHomeText = 'Ты с превосходным аппетитом налегаешь на горячее рагу и пышный хлеб, не скупясь на искреннюю похвалу кулинарному таланту хозяйки. Бекки прямо-таки светится от радости, подкладывая тебе самый сочный кусок мяса: "Вот видишь! А покойный мой Эрик вечно повторял: сытый мужчина — смирный да ласковый мужчина. Главное — трав да пряностей не жалеть да томить подольше." Эдди с набитым ртом с уважением мычит, полностью соглашаясь с матерью.'
    elseif BeckyDinnerEatTurn = 2:
        if BeckyDinnerWindowTrigger = 1:
            $BeckyHomeText = 'Беседа за столом заходит о домашних хлопотах. Бекки вздыхает, подливая рагу: "Надо бы, Эдди, в комнате Инги на втором этаже оконную раму подправить да петли маслом смазать. По ночам снизу слыхать, как створки скрипят — сквозняком хлопает, будто кто-то чужой в окно лезет..."<br>Инга в этот миг замирает с ложкой у самого рта, заливаясь густым маковым румянцем, и испуганно стреляет глазами в твою сторону. Лукас рядом торопливо прячет ухмылку в кружку с вином.'
        else:
            $BeckyHomeText = 'За столом течёт неторопливая, располагающая беседа. Лукас восторженно хвастается удачной сделкой на ярмарочной пристани, а Эдди внимательно кивает, с важным видом вставляя дельные замечания про оптовые цены и ящики. Бекки поглядывает на сына со смесью гордости и легкой материнской грусти: "Совсем выросли соколы мои… Скоро и мне за ними не угнаться."'
        end
    else:
        if BeckyDinnerLucasState = 0:
            $BeckyHomeText = 'Инга задумчиво вертит в пальцах салфетку, то и дело бросая украдкой взгляды на тебя через край кружки. Эдди увлечённо рассуждает о ярмарочных пошлинах, а Бекки тихо посмеивается, замечая интерес дочери к молодому трактирщику.'
        else:
            $BeckyHomeText = 'Инга со звоном роняет льняную салфетку под стол и со смешком ныряет за ней. Лукас тут же расплывается в довольной ухмылке, вальяжно откинувшись на спинку скамьи. Бекки мгновенно подмечает этот манёвр, всплескивает пухлыми ручками и со смешком качает головой: "Видит Ильматер всемилостивый, ну что за молодёжь пошла! Ни стыда, ни терпения… Хоть бы матери постеснялись."'
        end
    end
---

#BeckyHomeGuestDinnerGrope1Text
    $BeckyHomeText = 'Пользуясь тем, что внимание домочадцев отвлечено оживлённой беседой, ты незаметно опускаешь руку под свисающий край льняной скатерти и уверенно кладёшь ладонь на тёплое, округлое колено Бекки.<br>Вдова едва заметно вздрагивает, едва не расплескав ложку с подливой, и бросает на тебя быстрый, обжигающий взгляд из-под густых ресниц. Однако отстраняться она и не думает: глубоко вздохнув, Бекки лишь слегка поворачивает ногу, позволяя твоей ладони увереннее закрепиться на её пышном бедре, и с абсолютно невинным видом продолжает слушать Эдди.'
---

#BeckyHomeGuestDinnerGrope2Text
    $BeckyHomeText = 'Твои дерзкие пальцы медленно скользят всё выше по бедру, забираясь под мягкую ткань просторного домашнего платья. Кожа у вдовы под платьем горячая, шелковистая и невероятно гладкая.<br>Дыхание Бекки сбивается, на её аппетитных щёчках разгорается яркий пунцовый румянец. Под надёжной защитой длинной скатерти она незаметно раздвигает бёдра чуть шире, давая твоей ладони полную свободу движений. На бытовой вопрос Инги о завтрашних мучных закупках вдова отвечает невпопад, прикусив нижнюю губу: "Да-да, доченька… конечно, всё купим… ох..."'
---

#BeckyHomeGuestDinnerGrope3Text
    if BeckyDinnerEddieSaw = 1:
        $BeckyHomeText = 'Ты бесстыдно ласкаешь сомлевшую женщину прямо под носом у её собственного семейства. Всё тело Бекки пронзает сладкая судорога нарастающего восторга — она сжимает твои пальцы бёдрами и до побелевших костяшек впивается в край стола, сдерживая стон.<br>И надо же такому случиться: неловкий Эдди случайно роняет ложку и рефлекторно лезет за ней под скатерть! Ты успеваешь отвести руку, но по расширенным от шока глазам парня ясно: он увидел абсолютно всё. Бекки сидит пунцовая как маков цвет, уткнувшись носом в свою тарелку.'
    else:
        $BeckyHomeText = 'Ты доводишь распалённую вдову до сладостной развязки прямо во время семейной трапезы. Бекки сдавленно втягивает воздух сквозь зубы и замирает, сжимая твои пальцы плотными бёдрами. По её телу разливается волна знойного наслаждения, глаза хмельно затуманиваются, а на алых губах застывает блаженная улыбка.<br>Инга, подметив странную истому матери и её пылающие щёки, лишь понимающе прыскает в кружку и толкает соседа локтем.'
    end
---

#BeckyHomeGuestDinnerIngaGrope1Text
    $BeckyHomeText = 'Пока Эдди с матерью увлечённо спорят о расходах на лавку, ты незаметно вытягиваешь ногу под длинной скатертью и легко касаешься носком сапога изящной щиколотки Инги.<br>Девушка вздрагивает, чуть не выронив кружку, и испуганно вскидывает глаза на тебя. Ты сохраняешь абсолютно невозмутимый вид. Инга прикусывает нижнюю губу, её дыхание учащается, но ногу она не убирает, позволяя твоему прикосновению скользнуть выше к её колену.'
---

#BeckyHomeGuestDinnerIngaGrope2Text
    $BeckyHomeText = 'Осмелев, ты опускаешь руку под край скатерти и находишь тёплое девичье бедро Инги под подолом её простого платья. Ткань натянута, и пальцы ощущают нежную, упругую кожу.<br>Инга судорожно втягивает воздух сквозь зубы. Прямо рядом с ней сидят мать и брат, а твоя рука бесстыдно скользит всё выше. Девушка вспыхивает ярким румянцем, прикрывая глаза ресницами и еле слышно сжимая бедра вокруг твоих пальцев.'
---

#BeckyHomeGuestDinnerIngaGrope3Text
    $BeckyHomeText = 'Твои пальцы добираются до самого сокровенного тепла Инги прямо под покровом скатерти. Девушка до побелевших пальцев вцепляется в край деревянной скамьи, боясь издать хоть звук.<br>Сладкая волна окатывает её молодое тело: Инга часто дышит через нос, её губы беззвучно шевелятся, а на лице написано ошеломляющее наслаждение. Когда ты плавно убираешь руку, Инга бросает на тебя полный страсти и скрытой благодарности взгляд.'
---

#BeckyHomeGuestDinnerBothGropeText
    $BeckyHomeText = 'Ты решаешься на неслыханную дерзость прямо за семейным столом. Опустив одну руку под скатерть на бедро сомлевшей Бекки, ты одновременно вытягиваешь ногу, нащупывая ступней упругие колени Инги.<br>Мать и дочь вздрагивают почти синхронно! Бекки замирает с раскрасневшимися щеками, не смея отвести руку Стефана, а Инга напротив часто дышит, понимая, что происходит нечто совершенно безумное. Ни Эдди, ни Лукас не замечают этой тайной двойной игры, увлечённые густым вином и беседой.'
---

#BeckyDinnerWagonIntroText
    $BeckyHomeText = 'Внезапно в тяжёлые ставни с улицы громко стучат. Глухой голос с крыльца возвещает: "Хозяйка Блэнкеншип! Обоз из южного предместья прибыл, пять бочек масла да мешки с крупой! Принимайте товар!"<br>Бекки тут же вскакивает из-за стола, отирая фартук: "Ох, Ильматер всеблагой, среди ночи притащились! Эдди, живо за мной! И ты, Лукас, не сиди — помогите сгрузить мешки на склад!"<br>Бекки ласково поворачивается к тебе: "Стефанчик, ты гость, посиди, отдохни у тёплой печи, мы за полчаса управимся!"<br>Дверь хлопает. В доме воцаряется звенящая тишина. Младшие дети уже крепко спят на печи. За столом остаётесь только ты и Инга.'
---

#BeckyDinnerWagonHugsText
    $BeckyHomeText = 'В тишине полутёмной столовой слышно лишь потрескивание углей в печи да частое дыхание Инги. Девушка поднимается из-за стола и медленно делает шаг к тебе.<br>Ты притягиваешь её к себе за тонкую талию. Инга не сопротивляется: обвив руками твою шею, она жадно приникает к твоим губам, отдаваясь страстному, глубокому поцелую. Её молодое тело трепещет в твоих объятиях от пьянящего ощущения риска.'
---

#BeckyDinnerWagonOralText
    $BeckyHomeText = 'Усадив Ингу на широкую дубовую скамью у печи, ты опускаешься на колени перед ней или притягиваешь её к себе. Инга с горящими глазами и трепетом в груди отдаётся ласкам, зная, что в любую минуту во двор могут вернуться мать и брат.<br>В полумраке кухни звучат лишь сдавленные вздохи и шёпот признаний. Оральная нежность растворяет остатки девичьей робости, наполняя её взор чистым желанием.'
---

#BeckyDinnerWagonSexTableText
    $BeckyHomeText = 'Ты усаживаешь разгорячённую Ингу прямо на широкий дубовый стол, среди оставленных мисок и кружек. Её подол задран, белые бёдра озарены багровым отсветом печи.<br>Полная страсть захлёстывает вас обоих: мощные, размеренные толчки заставляют массивный стол тихо поскрипывать. Инга закусывает тыльную сторону ладони, чтобы не закричать на весь дом от накрывающего её экстаза. Это свидание на столе прямо в сердце семейного гнезда она запомнит навсегда.'
---

#BeckyDinnerWagonSexWindowText
    $BeckyHomeText = 'Подхватив Ингу под бёдра, ты подводишь её к высокому окну столовой и слегка отстраняешь плотную занавеску. За стеклом — тёмный переулок, где вдалеке видны силуэты редких ночных прохожих и факелы стражи.<br>Прижав девушку спиной к подоконнику прямо у окна, ты входишь в неё во всю глубину. Инга задыхается от сладкого ужаса и невероятного возбуждения: её обнажённое тело видно из переулка при каждом отблеске луны! Каждый толчок отдаётся звоном стекла, превращая ночь в чистый запретный восторг.'
---

#BeckyDinnerWagonEndText
    $BeckyHomeText = 'Вдали слышится скрип открывающихся ворот и усталые голоса возвращающихся с разгрузки Бекки и парней. Инга торопливо соскальзывает на пол, судорожно оглаживает подол платья и поправляет растрепавшиеся волосы, тяжело дыша с пылающими щеками.<br>Ты быстро приводишь одежду в порядок. Когда Бекки ступает на порог, ты с невозмутимой вежливой улыбкой благодаришь хозяйку за чудесный вечер и откланиваешься в ночную прохладу города.'
---

#BeckyDinnerPorchIntroText
    $BeckyHomeText = 'Ты с Эдди и Лукасом выходите на широкое деревянное крыльцо дома Блэнкеншипов. Ночной воздух свеж и пахнет сырой землёй да дымом дальних костров.<br>Эдди затягивается глиняной трубкой и с уважением делится планами на расширение торговли: "Хорошо посидели, Стефан. Мать давно такой весёлой не была." Лукас кивает, поддакивая и глядя на звёзды. Мужской разговор течёт неторопливо, укрепляя дружеское доверие между вами.<br>Докурив, парни предлагают вернуться в тепло к столу допить трактирное вино.'
---

#BeckyDinnerUnderTableBeckyGgText
    $BeckyHomeText = 'Вернувшись в столовую, мужчины рассаживаются по местам. Эдди разливает остатки вина, увлечённо рассуждая о ценах на ячмень. В этот момент ты чувствуешь, как под длинной льняной скатертью кто-то мягко опускается перед тобой на колени.<br>Это Бекки! Хозяйка дома ловко расстёгивает твои штаны и с тихим сладострастным вздохом накрывает твою плоть тёплыми, опытными губами. Ты едва сдерживаешь выражение лица, небрежно кивая речам Эдди, пока его мать усердно ублажает тебя прямо под столом.'
---

#BeckyDinnerUnderTableIngaGgText
    $BeckyHomeText = 'Пока Эдди с Лукасом чокаются кружками и спорят о ярмарочных пошлинах, юная Инга незаметно соскальзывает со скамьи и скрывается под скатертью у твоих ног.<br>Её нежные пальчики и влажные девичьи губы бесстыдно смыкаются на твоем члене. Ты сидишь с каменным лицом, сжимая в руке кружку вина, пока дочь лавочницы со всем пылом юности дарит тебе запретные ласки прямо под носом у брата и жениха.'
---

#BeckyDinnerUnderTableBeckyEddieText
    $BeckyHomeText = 'В тёплом полумраке столовой под длинной скатертью творятся невиданные вещи. Бекки, улучив момент, опускается на колени у лавки Эдди. Парень замирает с остекленевшим взглядом, вцепившись в край кружки, пока собственная мать дарит ему ошеломляющие ласки. Заговор в семье Блэнкеншипов окончательно переступает черту приличий.'
---

#BeckyDinnerUnderTableLucasText
    $BeckyHomeText = 'Под покровом скатерти ласки делятся между гостем и женихом. Лукас откидывается на спинку скамьи с блаженной, ошарашенной миной, пытаясь поддерживать светский разговор, пока умелые женские губы доводят его до исступления под мерный звон глиняной посуды.'
---

#BeckyDinnerUnderTableBothText
    $BeckyHomeText = 'Предел порочной раскованности: под широкой скатертью оказываются одновременно и Бекки, и Инга! Мать и дочь делят ласки между мужчинами, жадно сменяя друг друга в сладком безумии.<br>Когда всё свершается, обе женщины бесстыдно выбираются из-под скатерти. Их лица горят румянцем, взгляды полны безграничной страсти. Не стесняясь сидящих за столом, мать и дочь сплетаются в долгом, откровенном поцелуе губы в губы, празднуя полное крушение старых запретов!'
---

#BeckyDinnerPorchEndText
    $BeckyHomeText = 'Трапеза окончательно подходит к концу. Праздничный кувшин пуст, в печи тихо догорают последние угли. Обменявшись с хозяевами многозначительными взглядами и теплыми рукопожатиями, ты застёгиваешь плащ и выходишь на ночные улицы города.'
---

#AmandaTalkAboutBeckyDinnerText
    $GirlTalkText = '— Явился! — Аманда скрещивает руки на груди и смеривает тебя уничтожающим взглядом. — И где это наш благородный трактирщик пропадал заполночь? Опять у вдовушки Блэнкеншип сидел? Или к дочке её дорожку протаптываешь?<br>Она сердито поджимает губки: "Весь рынок шепчется, какими глазами Инга на тебя смотрит! Думаешь, я слепая? Смотри у меня, Стефан, доиграешься со своими соседскими ужинами!"'
---

#MelissaTalkAboutBeckyDinnerText
    $GirlTalkText = 'Мелисса отрывается от гроссбуха за стойкой и одаривает тебя тонкой, язвительной улыбкой:<br>— О, вернулся наш ночной странник. Судя по сытому виду, баранина у Бекки была необычайно мягкой? Только будь осторожнее со своей благотворительностью, Стефан. Эдди парень простодушный, но за сестру кочергой огреет не задумываясь. А уж если слухи дойдут до церкви... Бекки тебе этот кувшин вина до второго пришествия припоминать будет.'
---
