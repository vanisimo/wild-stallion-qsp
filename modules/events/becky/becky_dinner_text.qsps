#BeckyDinnerUnderTableActionText
    if $BeckyUnderTableGirl = 'both':
        ! Обе женщины под столом (Tier 3)
        if $BeckyPorchCompanion = 'eddie':
            $BeckyHomeText = 'Невероятное зрелище под столом семьи Блэнкеншип: и мать, и дочь опустились на колени у ваших ног!<br>Бекки и Инга с порочной слаженностью делят ласки: зрелая хозяйка умело расстёгивает твои штаны и накрывает плоть горячими губами, а юная Инга одновременно ласкает пальчиками и губами своего брата Эдди! Парень сидит, вцепившись белыми пальцами в глиняную кружку, его глаза лезут на лоб от немого шока и греховного восторга.<br><br>Ты приподнимаешь край скатерти и чокаешься с ошарашенным Эдди: «Ну что, сосед, доброе у вас вино и гостеприимный дом!» Эдди судорожно сглатывает, кивая в такт влажным звукам снизу: «И-ильматер всемилостивый… Стефан… вот это вечер…»'
        else:
            $BeckyHomeText = 'И мать, и дочь устроились под широкой скатертью, устроив настоящую вакханалию у ваших ног!<br>Бекки жадно принимает твою плоть глубоко в рот, сладострастно двигая головой, в то время как Инга столь же неистово ублажает своего жениха Лукаса. Под столом раздаются хлюпающие звуки, причмокивания и жаркие стоны обеих женщин.<br><br>Ты и Лукас синхронно приподнимаете скатерть, глядя сверху вниз на работу прелестниц. Лукас пьяно ухмыляется, поднимая кружку: «За щедрого трактирщика и лучших женщин во всём городе!» Женщины снизу лишь озорно стреляют глазами, не прерывая усердных ласк.'
        end
    elseif $BeckyUnderTableGirl = 'inga':
        ! Инга под столом
        if $BeckyUnderTableTarget = 'stefan':
            if BeckyUnderTableTier = 1:
                $BeckyHomeText = 'Под покровом длинной скатерти Инга на коленях расстёгивает твои штаны и аккуратно обхватывает пульсирующую плоть тёплыми девичьими губами.<br>Она сосёт старательно и ритмично, боясь произвести лишний шум. Ты делаешь глоток вина и непринуждённо поддерживаешь разговор со спутником, пока его сестра или невеста тайно дарит тебе неземное наслаждение под столом.'
            elseif BeckyUnderTableTier = 2:
                if $BeckyPorchCompanion = 'eddie':
                    $BeckyHomeText = 'Инга под столом со всем девичьим пылом заглатывает твою плоть до самого основания. Ты с улыбкой приподнимаешь край скатерти, позволяя Эдди взглянуть вниз.<br>Эдди заглядывает под стол — и его кружка едва не падает из рук! Увидев собственную сестру, самозабвенно ублажающую соседа, парень сперва вспыхивает, а затем с кривой ухмылкой присвистывает: «Ого, Стефан… А девка-то наша времени даром не теряет! Похоже, ты её совсем околдовал…»'
