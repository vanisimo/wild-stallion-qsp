#BeckyHomeBedroom

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/becky/becky_home_chain/becky_home_bedroom', 'СПАЛЬНЯ БЕККИ', 'large', 'webp'
    gs 'BeckyHomeBedroomIntroText'

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ БЕККИ'
    *p $BeckyHomeText
    *pl ' '

    if BeckyHomeSex = 0:
        gs 'ActUiPrepare', 'Продолжить', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyHomeFirstSexStep1'
        end
    else:
        if EddieHelpPromised = 1 and BeckyEddieDone = 0 and LOC('BeckyEddieHomeLaunch') = 1:
            gs 'ActUiPrepare', 'Пойти с Бекки в спальню', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gt 'BeckyEddieHomeLaunch'
            end
        elseif LOC('SexSceneStart') = 1:
            gs 'ActUiPrepare', 'Провести вечер с Бекки', 'talk'
            act $ActUiLabel, $ActUiIconPath:
                gt 'SexSceneStart', 'becky', 'BeckyHomeAfterSex', 'becky_repeat'
            end
        end

        gs 'ActUiPrepare', 'Уйти', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Market'
        end
    end
