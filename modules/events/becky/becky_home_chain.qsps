! ================================================
! FILE: modules/events/becky/becky_home_chain.qsps
! MODULE: events/becky
! Дом Бекки: крыльцо, ужин, спальня, первый секс
! ================================================

#BeckyHomeGuestArrival

    if BeckyHomeStage < 3:
        *pl 'Бекки пока не приглашала вас в гости.'
        gs 'ActUiPrepare', 'Назад', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Market'
        end
        exit
    end

    if time <> 4:
        *pl 'Сейчас не время для визита — Бекки принимает гостей по вечерам.'
        gs 'ActUiPrepare', 'Назад', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Market'
        end
        exit
    end

    if StefanRespectableSuit = 0 and charisma < 40:
        gs 'BeckyHomeGuestDressFailText'
        *p $BeckyHomeText
        gs 'ActUiPrepare', 'Назад', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Market'
        end
        exit
    end

    $BeckyArriveMode = 'guest'
    gt 'BeckyHomeFront', 'guest'
---

#BeckyHomeFront

    SceneArtUseReal = 1
    if $ARGS[0] <> '':
        $BeckyArriveMode = $ARGS[0]
    end

    if $BeckyArriveMode = '':
        $BeckyArriveMode = 'guest'
    end

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/becky/becky_home_chain/becky_home_front', 'ДОМ БЕККИ — КРЫЛЬЦО', 'large', 'webp'
    if BeckyHomeStage < 1:
        BeckyHomeStage = 1
    end

    gs 'BeckyHomeFrontRollScene'

    gs 'ShowLocationScreenTitle', 'ДОМ БЕККИ — КРЫЛЬЦО'

    if BeckyHomeFrontIngaScene = 1:
        gs 'BeckyHomeFrontIngaText'
        *p $BeckyHomeText
        *pl ' '

        if $BeckyArriveMode = 'FromDances':
            gs 'ActUiPrepare', 'Сделать вид, что ничего не видели', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gt 'BeckyHomeFrontAfterInga', 'pretend'
            end

            gs 'ActUiPrepare', 'Показать Бекки, что видели', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gt 'BeckyHomeFrontAfterInga', 'tell'
            end
        else:
            gs 'ActUiPrepare', 'Осторожно заглянуть за угол', 'look'
            act $ActUiLabel, $ActUiIconPath:
                gt 'BeckyHomeFrontAfterInga', 'peek'
            end

            gs 'ActUiPrepare', 'Сделать вид, что ничего нет', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gt 'BeckyHomeFrontAfterInga', 'pretend'
            end

            if BeckyHomeStage >= 5:
                gs 'ActUiPrepare', 'Подойти к парочке', 'generic'
                act $ActUiLabel, $ActUiIconPath:
                    gt 'BeckyHomeFrontAfterInga', 'approach'
                end
            end
        end
    else:
        *p 'У крыльца тихо — детей не видно.'
        *pl ' '
        gs 'BeckyHomeFrontRouteInside'
    end
---

#BeckyHomeFrontRollScene

    BeckyHomeFrontIngaScene = 0
    BeckyHomeFrontIngaSex = 0

    if RAND(1, 4) <= 3:
        BeckyHomeFrontIngaScene = 1

        if RAND(1, 2) = 1:
            BeckyHomeFrontIngaSex = 1
        end
    end
---

#BeckyHomeFrontAfterInga

    $BeckyFrontChoice = LCASE($ARGS[0])

    if $BeckyFrontChoice = 'tell' or $BeckyFrontChoice = 'peek':
        otkroven['becky'] += 1
        sluttiness['becky'] += 1
        *p 'Бекки краснеет, но не спорит: "Ну да, молодость… Пошли внутрь, пока они заняты."'
    elseif $BeckyFrontChoice = 'approach':
        otkroven['becky'] += 2
        sluttiness['inga'] += 1
        sluttiness['becky'] += 1
        *p 'Вы задерживаетесь у парочки дольше, чем стоило. Бекки торопит вас в дом с нервным смешком.'
    else:
        *p '"Кошка пробежала, ерунда," — говоришь ты. Бекки хмыкает и кивает.'
    end

    *pl ' '
    gs 'BeckyHomeFrontRouteInside'
---

#BeckyHomeFrontRouteInside

    if SandraBeckyThreesomeReady = 1 and (week = 7 and time = 5 or debug = 1):
        *pl 'Из окон доносится тёплый смех: Сандра и Бекки уже ждут вас внутри за вином в эту воскресную ночь.'
        *pl ' '
        gs 'ActUiPrepare', 'Зайти в дом (Воскресный вечер у Бекки с Сандрой)', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GroupSexSandraBeckyStefanStart'
        end
    end

    if $BeckyArriveMode = 'FromDances' and BeckyHomeStage < 5:
        gt 'BeckyHomeBedroom'
    elseif BeckyHomeSex = 1 and BeckyHomeStage >= 4:
        *pl 'Из кухни доносятся сытные запахи — семья собирается за ужином. Но Бекки уже бросает на вас многозначительный взгляд.'
        *pl ' '
        gs 'ActUiPrepare', 'Пройти к столу на семейный ужин', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyHomeGuestDinner'
        end

        gs 'ActUiPrepare', 'Подняться с Бекки сразу в спальню', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyHomeBedroom'
        end
    else:
        gt 'BeckyHomeGuestDinner'
    end
---

#BeckyHomeGuestDinner

    SceneArtUseReal = 1
    *clr
    clr
    cla

    BeckyTimesVisited += 1
    BeckyDinnerStep = 0
    BeckyDinnerWineServed = 0
    BeckyDinnerGropeStep = 0
    BeckyDinnerIngaGropeStep = 0
    BeckyDinnerBothGropeDone = 0
    BeckyDinnerOrgasm = 0
    BeckyDinnerEddieSaw = 0
    BeckyDinnerEatTurn = 0
    $BeckyDinnerScene = 'intro'

    ! Calculate Lucas presence & status
    if IngaRomanceStage >= 3 or IngaRomanceFinished = 1 or IngaDumpedLucas = 1:
        BeckyDinnerLucasState = 0
    elseif IngaLucasThreesomeCount >= 1:
        BeckyDinnerLucasState = 3
    elseif IngaLucasTense = 1:
        BeckyDinnerLucasState = 1
    else
        BeckyDinnerLucasState = 2
    end

    ! Calculate Window creaking dialogue trigger
    BeckyDinnerWindowTrigger = 0
    if IngaLucasWindowSeen = 1 or IngaRoomUnlocked = 1 or IngaBackroomSex = 1:
        BeckyDinnerWindowTrigger = 1
    end

    gt 'BeckyHomeGuestDinnerLoop'
---

#BeckyHomeGuestDinnerLoop

    SceneArtUseReal = 1
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'УЖИН У БЕККИ'

    if $BeckyDinnerScene = 'wine':
        gs 'SceneShowVisual', 'images/events/becky/dinner/tabledrink', 'УЖИН У БЕККИ — ТРАКТИРНОЕ ВИНО', 'large', 'webp'
        gs 'BeckyHomeGuestDinnerWineText'
    elseif $BeckyDinnerScene = 'eat':
        gs 'SceneShowVisual', 'images/events/becky/dinner/eat', 'УЖИН У БЕККИ — СЕМЕЙНАЯ ТРАПЕЗА', 'large', 'webp'
        gs 'BeckyHomeGuestDinnerEatText'
    elseif $BeckyDinnerScene = 'grope1':
        gs 'SceneShowVisual', 'images/events/becky/dinner/Grope', 'УЖИН У БЕККИ — ПОД СКАТЕРТЬЮ', 'large', 'webp'
        gs 'BeckyHomeGuestDinnerGrope1Text'
    elseif $BeckyDinnerScene = 'grope2':
        gs 'SceneShowVisual', 'images/events/becky/dinner/Grope', 'УЖИН У БЕККИ — ТАЙНЫЕ ЛАСКИ', 'large', 'webp'
        gs 'BeckyHomeGuestDinnerGrope2Text'
    elseif $BeckyDinnerScene = 'grope3':
        if BeckyDinnerEddieSaw = 1:
            gs 'SceneShowVisual', 'images/events/becky/dinner/GropeEddie', 'УЖИН У БЕККИ — ВЗГЛЯД ЭДДИ', 'large', 'webp'
        else:
            gs 'SceneShowVisual', 'images/events/becky/dinner/Grope', 'УЖИН У БЕККИ — СЛАДКАЯ ДРОЖЬ', 'large', 'webp'
        end
        gs 'BeckyHomeGuestDinnerGrope3Text'
    elseif $BeckyDinnerScene = 'inga_grope1':
        gs 'SceneShowVisual', 'images/events/becky/dinner/Grope', 'УЖИН У БЕККИ — НОЖКА ИНГИ', 'large', 'webp'
        gs 'BeckyHomeGuestDinnerIngaGrope1Text'
    elseif $BeckyDinnerScene = 'inga_grope2':
        gs 'SceneShowVisual', 'images/events/becky/dinner/Grope', 'УЖИН У БЕККИ — ЛАСКА ИНГИ', 'large', 'webp'
        gs 'BeckyHomeGuestDinnerIngaGrope2Text'
    elseif $BeckyDinnerScene = 'inga_grope3':
        gs 'SceneShowVisual', 'images/events/becky/dinner/Grope', 'УЖИН У БЕККИ — ВОСТОРГ ИНГИ', 'large', 'webp'
        gs 'BeckyHomeGuestDinnerIngaGrope3Text'
    elseif $BeckyDinnerScene = 'both_grope':
        gs 'SceneShowVisual', 'images/events/becky/dinner/Grope', 'УЖИН У БЕККИ — ДВОЙНАЯ ИГРА', 'large', 'webp'
        gs 'BeckyHomeGuestDinnerBothGropeText'
    else:
        gs 'SceneShowVisual', 'images/events/becky/dinner/DinnerStart', 'УЖИН У БЕККИ', 'large', 'webp'
        gs 'BeckyHomeGuestDinnerIntroText'
    end

    *p $BeckyHomeText
    *pl ' '

    if BeckyDinnerWineServed = 0 and winenum >= 3:
        gs 'ActUiPrepare', 'Поставить на стол трактирное вино (3 ед.)', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            winenum -= 3
            if productnum >= 2:
                productnum -= 2
            end
            Friends['becky'] += 1
            otkroven['becky'] += 1
            Friends['eddie'] += 1
            BeckyDinnerWineServed = 1
            BeckyDinnerStep += 1
            $BeckyDinnerScene = 'wine'
            gt 'BeckyHomeGuestDinnerLoop'
        end
    end

    if BeckyDinnerStep < 5:
        gs 'ActUiPrepare', 'Ужинать и беседовать с семьёй', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            BeckyDinnerStep += 1
            BeckyDinnerEatTurn += 1
            $BeckyDinnerScene = 'eat'
            gt 'BeckyHomeGuestDinnerLoop'
        end
    end

    if BeckyDinnerGropeStep = 0:
        if BeckyDinnerWineServed = 1 or Friends['becky'] >= 10 or BeckyHomeSex = 1:
            gs 'ActUiPrepare', 'Положить руку на колено Бекки под столом', 'look'
            act $ActUiLabel, $ActUiIconPath:
                BeckyDinnerGropeStep = 1
                BeckyDinnerStep += 1
                sluttiness['becky'] += 1
                otkroven['becky'] += 1
                $BeckyDinnerScene = 'grope1'
                gt 'BeckyHomeGuestDinnerLoop'
            end
        end
    elseif BeckyDinnerGropeStep = 1:
        gs 'ActUiPrepare', 'Скользнуть ладонью выше под юбку Бекки', 'look'
        act $ActUiLabel, $ActUiIconPath:
            BeckyDinnerGropeStep = 2
            BeckyDinnerStep += 1
            sluttiness['becky'] += 1
            $BeckyDinnerScene = 'grope2'
            gt 'BeckyHomeGuestDinnerLoop'
        end
    elseif BeckyDinnerGropeStep = 2:
        gs 'ActUiPrepare', 'Ласкать Бекки до дрожи под скатертью', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            BeckyDinnerGropeStep = 3
            BeckyDinnerOrgasm = 1
            BeckyDinnerStep += 1
            GiveOrgasms['becky'] += 1
            sluttiness['becky'] += 2
            Friends['becky'] += 1

            BeckyDinnerEddieSaw = 0
            if RAND(1, 2) = 1 or EddieHelpPromised = 1:
                BeckyDinnerEddieSaw = 1
            end

            $BeckyDinnerScene = 'grope3'
            gt 'BeckyHomeGuestDinnerLoop'
        end
    end

    if (IngaBackroomSex = 1 or sluttiness['inga'] >= 20 or IntimStage['inga'] >= 2):
        if BeckyDinnerIngaGropeStep = 0:
            gs 'ActUiPrepare', 'Коснуться ножки Инги под столом', 'look'
            act $ActUiLabel, $ActUiIconPath:
                BeckyDinnerIngaGropeStep = 1
                BeckyDinnerStep += 1
                sluttiness['inga'] += 1
                otkroven['inga'] += 1
                $BeckyDinnerScene = 'inga_grope1'
                gt 'BeckyHomeGuestDinnerLoop'
            end
        elseif BeckyDinnerIngaGropeStep = 1 and (sluttiness['inga'] >= 30 or IntimStage['inga'] >= 2):
            gs 'ActUiPrepare', 'Скользнуть ладонью по бедру Инги', 'look'
            act $ActUiLabel, $ActUiIconPath:
                BeckyDinnerIngaGropeStep = 2
                BeckyDinnerStep += 1
                sluttiness['inga'] += 1
                $BeckyDinnerScene = 'inga_grope2'
                gt 'BeckyHomeGuestDinnerLoop'
            end
        elseif BeckyDinnerIngaGropeStep = 2 and (sluttiness['inga'] >= 50 or IntimStage['inga'] >= 3):
            gs 'ActUiPrepare', 'Ласкать Ингу до дрожи под скатертью', 'intim'
            act $ActUiLabel, $ActUiIconPath:
                BeckyDinnerIngaGropeStep = 3
                BeckyDinnerStep += 1
                GiveOrgasms['inga'] += 1
                sluttiness['inga'] += 2
                Friends['inga'] += 1
                $BeckyDinnerScene = 'inga_grope3'
                gt 'BeckyHomeGuestDinnerLoop'
            end
        end
    end

    if BeckyDinnerBothGropeDone = 0 and sluttiness['becky'] >= 35 and sluttiness['inga'] >= 35 and (BeckyDinnerGropeStep >= 1 or BeckyDinnerIngaGropeStep >= 1):
        gs 'ActUiPrepare', 'Ласкать Бекки и Ингу одновременно под скатертью', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            BeckyDinnerBothGropeDone = 1
            BeckyDinnerStep += 1
            sluttiness['becky'] += 2
            sluttiness['inga'] += 2
            $BeckyDinnerScene = 'both_grope'
            gt 'BeckyHomeGuestDinnerLoop'
        end
    end

    if BeckyHomeSex = 1 or BeckyDinnerStep >= 2 or BeckyDinnerGropeStep >= 1 or BeckyDinnerWineServed = 1:
        if BeckyHomeSex = 1 or BeckyDinnerOrgasm = 1 or sluttiness['becky'] >= 35:
            gs 'ActUiPrepare', 'Пойти с Бекки в спальню', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                killvar '$BeckyDinnerScene'
                killvar 'BeckyDinnerStep'
                killvar 'BeckyDinnerWineServed'
                killvar 'BeckyDinnerGropeStep'
                killvar 'BeckyDinnerIngaGropeStep'
                killvar 'BeckyDinnerBothGropeDone'
                killvar 'BeckyDinnerOrgasm'
                killvar 'BeckyDinnerEddieSaw'
                killvar 'BeckyDinnerEatTurn'
                gt 'BeckyHomeBedroom'
            end
        end

        if (IngaRoomUnlocked = 1 or IngaBackroomSex = 1 or Friends['inga'] >= 6 or sluttiness['inga'] >= 25):
            gs 'ActUiPrepare', 'Стук в ставни — приезд ночного обоза', 'generic'
            act $ActUiLabel, $ActUiIconPath:
                gt 'BeckyDinnerWagonStart'
            end
        end

        gs 'ActUiPrepare', 'Выйти с мужчинами на крыльцо подышать воздухом', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyDinnerPorchStart'
        end
    end

    gs 'ActUiPrepare', 'Попрощаться и уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        killvar '$BeckyDinnerScene'
        killvar 'BeckyDinnerStep'
        killvar 'BeckyDinnerWineServed'
        killvar 'BeckyDinnerGropeStep'
        killvar 'BeckyDinnerIngaGropeStep'
        killvar 'BeckyDinnerBothGropeDone'
        killvar 'BeckyDinnerOrgasm'
        killvar 'BeckyDinnerEddieSaw'
        killvar 'BeckyDinnerEatTurn'
        gt 'Market'
    end
---

#BeckyDinnerWagonStart
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'ПРИЕЗД НОЧНОГО ОБОЗА'
    gs 'SceneShowVisual', 'images/events/becky/dinner/wagon_arrival', 'ПРИЕЗД НОЧНОГО ОБОЗА', 'large', 'webp'
    gs 'BeckyDinnerWagonIntroText'
    *pl $BeckyHomeText
    *pl ' '

    gs 'ActUiPrepare', 'Подойти к Инге и обнять её', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyDinnerWagonHugs'
    end

    gs 'ActUiPrepare', 'Остаться за столом и дождаться семью', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyDinnerWagonEnd'
    end
---

#BeckyDinnerWagonHugs
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'НАЕДИНЕ В СТОЛОВОЙ'
    gs 'SceneShowVisual', 'images/events/becky/dinner/inga_alone', 'НАЕДИНЕ В СТОЛОВОЙ', 'large', 'webp'
    otkroven['inga'] += 1
    sluttiness['inga'] += 1
    gs 'BeckyDinnerWagonHugsText'
    *pl $BeckyHomeText
    *pl ' '

    if sluttiness['inga'] >= 30:
        gs 'ActUiPrepare', 'Опустить Ингу на скамью для ласк', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyDinnerWagonOral'
        end
    end

    gs 'ActUiPrepare', 'Остановиться — скоро вернется семья', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyDinnerWagonEnd'
    end
---

#BeckyDinnerWagonOral
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'ТАЙНЫЕ ЛАСКИ У ПЕЧИ'
    gs 'SceneShowVisual', 'images/events/becky/dinner/inga_oral', 'ТАЙНЫЕ ЛАСКИ У ПЕЧИ', 'large', 'webp'
    sluttiness['inga'] += 1
    OralCount['inga'] += 1
    gs 'BeckyDinnerWagonOralText'
    *pl $BeckyHomeText
    *pl ' '

    if sluttiness['inga'] >= 50 or HadSex['inga'] > 0:
        gs 'ActUiPrepare', 'Перейти к полной близости', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyDinnerWagonSex'
        end
    end

    gs 'ActUiPrepare', 'Приблизиться к финалу ласк', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyDinnerWagonOralFinish'
    end
---

#BeckyDinnerWagonOralFinish
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'ФИНАЛ ЛАСК У ПЕЧИ'
    gs 'SceneShowVisual', 'images/events/becky/dinner/inga_oral', 'ФИНАЛ ЛАСК У ПЕЧИ', 'large', 'webp'
    sluttiness['inga'] += 1
    gs 'RegisterPlayerCum'
    gs 'BeckyDinnerWagonOralFinishText'
    *pl $BeckyHomeText
    *pl ' '

    gs 'ActUiPrepare', 'Привести себя в порядок — семья возвращается', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyDinnerWagonEnd'
    end
---

#BeckyDinnerWagonSex
    *clr
    clr
    cla

    ! Random choice between Table and Window
    if RAND(1, 2) = 1:
        $BeckyWagonSexPlace = 'table'
        gs 'ShowLocationScreenTitle', 'СТРАСТЬ НА ОБЕДЕННОМ СТОЛЕ'
        gs 'SceneShowVisual', 'images/events/becky/dinner/inga_table_sex', 'СТРАСТЬ НА ОБЕДЕННОМ СТОЛЕ', 'large', 'webp'
    else:
        $BeckyWagonSexPlace = 'window'
        gs 'ShowLocationScreenTitle', 'БЛИЗОСТЬ У ОКНА'
        gs 'SceneShowVisual', 'images/events/becky/dinner/inga_window_sex', 'БЛИЗОСТЬ У ОКНА', 'large', 'webp'
    end

    sluttiness['inga'] += 2
    HadSex['inga'] += 1
    if IntimStage['inga'] < 4: IntimStage['inga'] = 4
    if $BeckyWagonSexPlace = 'window':
        TavernScandal += 2
        CityRumorReady['inga_window'] = 1
    end

    gs 'BeckyDinnerWagonSexProcessText'
    *pl $BeckyHomeText
    *pl ' '

    gs 'ActUiPrepare', 'Достичь бурной развязки', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyDinnerWagonSexFinish'
    end
---

#BeckyDinnerWagonSexFinish
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'КУЛЬМИНАЦИЯ БЛИЗОСТИ'
    if $BeckyWagonSexPlace = 'table':
        gs 'SceneShowVisual', 'images/events/becky/dinner/inga_table_sex', 'КУЛЬМИНАЦИЯ НА СТОЛЕ', 'large', 'webp'
    else:
        gs 'SceneShowVisual', 'images/events/becky/dinner/inga_window_sex', 'КУЛЬМИНАЦИЯ У ОКНА', 'large', 'webp'
    end

    gs 'RegisterPlayerCum'
    sluttiness['inga'] += 1
    gs 'BeckyDinnerWagonSexFinishText'
    *pl $BeckyHomeText
    *pl ' '

    killvar '$BeckyWagonSexPlace'

    gs 'ActUiPrepare', 'Услышать шаги у ворот', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyDinnerWagonEnd'
    end
---

#BeckyDinnerWagonEnd
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'ВОЗВРАЩЕНИЕ ХОЗЯЙКИ'
    gs 'SceneShowVisual', 'images/events/becky/dinner/DinnerStart', 'ВОЗВРАЩЕНИЕ ХОЗЯЙКИ', 'large', 'webp'
    AmandaBeckyDinnerGossipPending = 1
    MelissaBeckyDinnerGossipPending = 1
    BeckyDinnerWagonSexDone = 1

    killvar '$BeckyDinnerScene'
    killvar 'BeckyDinnerStep'
    killvar 'BeckyDinnerWineServed'
    killvar 'BeckyDinnerGropeStep'
    killvar 'BeckyDinnerIngaGropeStep'
    killvar 'BeckyDinnerBothGropeDone'
    killvar 'BeckyDinnerOrgasm'
    killvar 'BeckyDinnerEddieSaw'
    killvar 'BeckyDinnerEatTurn'

    gs 'BeckyDinnerWagonEndText'
    *pl $BeckyHomeText
    *pl ' '

    gs 'ActUiPrepare', 'Выйти в ночной город', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#BeckyDinnerPorchStart
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'РАЗГОВОР НА КРЫЛЬЦЕ'
    gs 'SceneShowVisual', 'images/events/becky/dinner/porch_men', 'РАЗГОВОР НА КРЫЛЬЦЕ', 'large', 'webp'
    Friends['eddie'] += 1
    gs 'BeckyDinnerPorchIntroText'
    *pl $BeckyHomeText
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в дом к столу', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyDinnerPorchReturn'
    end

    gs 'ActUiPrepare', 'Попрощаться и уйти домой', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#BeckyDinnerPorchReturn
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'ВОЗВРАЩЕНИЕ К СТОЛУ'
    gs 'SceneShowVisual', 'images/events/becky/dinner/eat', 'ВОЗВРАЩЕНИЕ К СТОЛУ', 'large', 'webp'

    ! Determine companion
    if BeckyDinnerLucasState >= 1 and RAND(1, 2) = 1:
        $BeckyPorchCompanion = 'lucas'
    else:
        $BeckyPorchCompanion = 'eddie'
    end

    ! Determine who is under table
    ! Pool: 'becky', 'inga', 'both'
    $BeckyUnderTableGirl = 'becky'
    if sluttiness['becky'] >= 75 and sluttiness['inga'] >= 75 and (IngaBackroomSex = 1 or HadSex['inga'] > 0) and RAND(1, 3) = 1:
        $BeckyUnderTableGirl = 'both'
    elseif (IngaBackroomSex = 1 or HadSex['inga'] > 0 or sluttiness['inga'] >= 35) and RAND(1, 2) = 1:
        $BeckyUnderTableGirl = 'inga'
    end

    ! Determine recipient
    if $BeckyUnderTableGirl = 'both':
        $BeckyUnderTableTarget = 'both'
    elseif $BeckyUnderTableGirl = 'inga':
        ! Inga NEVER touches Eddie!
        if $BeckyPorchCompanion = 'lucas' and IngaLucasRelation >= 1 and RAND(1, 3) = 1:
            $BeckyUnderTableTarget = 'lucas'
        else:
            $BeckyUnderTableTarget = 'stefan'
        end
    else:
        ! Becky
        if $BeckyPorchCompanion = 'eddie' and (EddieFamilyArcDone = 1 or (FamilyCorruptionStage >= 4 and sluttiness['becky'] >= 60)) and RAND(1, 3) = 1:
            $BeckyUnderTableTarget = 'eddie'
        elseif $BeckyPorchCompanion = 'lucas' and (BeckyLucasBackroomDone = 1 or sluttiness['becky'] >= 50) and RAND(1, 3) = 1:
            $BeckyUnderTableTarget = 'lucas'
        else:
            $BeckyUnderTableTarget = 'stefan'
        end
    end

    ! Determine tier
    if $BeckyUnderTableGirl = 'both':
        BeckyUnderTableTier = 3
    else:
        if $BeckyUnderTableGirl = 'becky':
            _slut = sluttiness['becky']
        else:
            _slut = sluttiness['inga']
        end
        if _slut >= 65:
            BeckyUnderTableTier = 3
        elseif _slut >= 45:
            BeckyUnderTableTier = 2
        else:
            BeckyUnderTableTier = 1
        end
        killvar '_slut'
    end

    gs 'BeckyDinnerPorchReturnSetupText'
    *pl $BeckyHomeText
    *pl ' '

    gs 'ActUiPrepare', 'Заглянуть под скатерть', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyDinnerUnderTableAction'
    end
---

#BeckyDinnerUnderTableAction
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'СЮРПРИЗ ПОД СТОЛОМ'

    if $BeckyUnderTableGirl = 'both':
        gs 'SceneShowVisual', 'images/events/becky/dinner/undertable_both', 'МАТЬ И ДОЧЬ ПОД СТОЛОМ', 'large', 'webp'
    elseif $BeckyUnderTableGirl = 'inga':
        gs 'SceneShowVisual', 'images/events/becky/dinner/undertable_inga', 'ИНГА ПОД СТОЛОМ', 'large', 'webp'
    else:
        gs 'SceneShowVisual', 'images/events/becky/dinner/undertable_becky', 'БЕККИ ПОД СТОЛОМ', 'large', 'webp'
    end

    if BeckyUnderTableTier < 3 and ($BeckyUnderTableTarget = 'stefan' or $BeckyUnderTableTarget = 'both'):
        gs 'RegisterPlayerCum'
    end

    gs 'BeckyDinnerUnderTableActionText'
    *pl $BeckyHomeText
    *pl ' '

    if BeckyUnderTableTier = 3:
        gs 'ActUiPrepare', 'Наблюдать открытую кульминацию', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyDinnerUnderTableCulmination'
        end
    else:
        gs 'ActUiPrepare', 'Допить вино и попрощаться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyDinnerPorchEnd'
        end
    end
---

#BeckyDinnerUnderTableCulmination
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'КУЛЬМИНАЦИЯ ПОД СТОЛОМ'

    if $BeckyUnderTableGirl = 'both':
        gs 'SceneShowVisual', 'images/events/becky/dinner/undertable_kiss', 'ПОЦЕЛУЙ МАТЕРИ И ДОЧЕРИ', 'large', 'webp'
        sluttiness['becky'] += 3
        sluttiness['inga'] += 3
        FamilyCorruptionStage += 1
        TavernScandal += 2
        gs 'RegisterPlayerCum'
    elseif $BeckyUnderTableGirl = 'inga':
        gs 'SceneShowVisual', 'images/events/becky/dinner/undertable_inga', 'ОТКРЫТЫЙ ФИНАЛ ИНГИ', 'large', 'webp'
        sluttiness['inga'] += 2
        if $BeckyUnderTableTarget = 'stefan': gs 'RegisterPlayerCum'
    else:
        gs 'SceneShowVisual', 'images/events/becky/dinner/undertable_becky', 'ОТКРЫТЫЙ ФИНАЛ БЕККИ', 'large', 'webp'
        sluttiness['becky'] += 2
        if $BeckyUnderTableTarget = 'stefan': gs 'RegisterPlayerCum'
    end

    gs 'BeckyDinnerUnderTableCulminationText'
    *pl $BeckyHomeText
    *pl ' '

    gs 'ActUiPrepare', 'Поблагодарить хозяев и выйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyDinnerPorchEnd'
    end
---

#BeckyDinnerPorchEnd
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'ЗАВЕРШЕНИЕ ВЕЧЕРА'
    gs 'SceneShowVisual', 'images/events/becky/dinner/DinnerStart', 'ЗАВЕРШЕНИЕ ВЕЧЕРА', 'large', 'webp'
    AmandaBeckyDinnerGossipPending = 1
    MelissaBeckyDinnerGossipPending = 1
    BeckyDinnerPorchDone = 1

    killvar '$BeckyDinnerScene'
    killvar 'BeckyDinnerStep'
    killvar 'BeckyDinnerWineServed'
    killvar 'BeckyDinnerGropeStep'
    killvar 'BeckyDinnerIngaGropeStep'
    killvar 'BeckyDinnerBothGropeDone'
    killvar 'BeckyDinnerOrgasm'
    killvar 'BeckyDinnerEddieSaw'
    killvar 'BeckyDinnerEatTurn'
    killvar '$BeckyPorchCompanion'
    killvar '$BeckyUnderTableGirl'
    killvar '$BeckyUnderTableTarget'
    killvar 'BeckyUnderTableTier'

    gs 'BeckyDinnerPorchEndText'
    *pl $BeckyHomeText
    *pl ' '

    gs 'ActUiPrepare', 'Выйти в ночной город', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#AmandaTalkAboutBeckyDinner
    $TalkReturnLoc = $ARGS[0]
    if $TalkReturnLoc = '': $TalkReturnLoc = 'TavernMain'
    AmandaBeckyDinnerGossipPending = 0
    AmandaBeckyDinnerGossipDone = 1
    AmandaJealousy += 1
    *clr
    clr
    cla
    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С АМАНДОЙ'
    gs 'SceneShowVisual', 'images/events/amanda/talk_jealous', 'РЕВНОСТЬ АМАНДЫ', 'large', 'webp'
    gs 'AmandaTalkAboutBeckyDinnerText'
    *pl $GirlTalkText
    *pl ' '
    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $TalkReturnLoc
    end
