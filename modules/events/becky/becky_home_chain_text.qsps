#BeckyHomeFrontIngaText
    if BeckyHomeFrontIngaSex = 1:
        $BeckyHomeText = 'В тёмном углу крыльца, за высокими кадками, Инга стоит на коленях прямо перед Лукасом, а парень судорожно сжимает её за плечи. Бекки с плутовской усмешкой шепчет вам на ушко: "Ой, смотри-ка… так это ж Ингенборг с ухажёром! До спальни даже не дотерпели, вишь как раззадорились… Эх, молодость-молодость!"'
    else:
        $BeckyHomeText = 'В полумраке крыльца Инга нежно обнимает за шею Лукаса и увлечённо целует его. Бекки мечтательно вздыхает: "Славный парень Лукас, статный, да и на дочке моей жениться обещает."'
    end
---

#BeckyHomeFrontBeckyHurryText
    if $BeckyArriveMode = 'FromDances':
        $BeckyHomeText = '"Стефанчик, пошли скорее внутрь, пока молодняк нас тут на пороге не засек!" — Бекки со смешком тянет вас за рукав к массивной дубовой двери.'
    else:
        $BeckyHomeText = '"Раз уж дети своими делами заняты, пойдём-ка в дом," — шепчет Бекки и с тихим щелчком отпирает дверь.'
    end
---

#BeckyHomeGuestDressFailText
    $BeckyHomeText = 'Бекки оглядывает ваш рабочий трактирный наряд, качает головой и сочувственно прицокивает: "Стефанчик, милый, приходи-ка в другой раз, когда оденешься посолиднее. Для гостя в доме вдовы приличный вид — первое дело!"'
---

#BeckyHomeGuestDressOkText
    $BeckyHomeText = 'Бекки просияла, с одобрением оглядывая ваш статный костюм: "Ого, вот это сразу видно — хозяин! Проходи, Стефанчик, дети как раз за столом собрались."'
---

#BeckyHomeGuestDinnerText
    $BeckyHomeText = 'Семейный ужин в доме вдовы проходит в шумной да тёплой обстановке: за длинным столом сидит Эдди, шустро уминают стряпню младшие дети, а подле пристроились Инга с Лукасом. Вы с широким жестом ставите на стол кувшин выдержанного вина из погребов «Жеребца» — ужин мгновенно оживляется! Бекки ловко отшивает сына кокетливой шуткой, когда Эдди начинает слишком удивлённо посматривать на вас, а затем пригибается к вашему уху и лукаво шепчет: "После ужина поговорим наедине…"'
---

#BeckyHomeBedroomIntroText
    if BeckyHomeSex = 1:
        $BeckyHomeText = 'Едва переступив порог спальни, Бекки сразу же горячо прижимается к вам всем своим пышным телом — опытной вдове уже не нужны лишние прелюдии, она прекрасно знает, зачем вы поднялись к ней.'
    elseif $BeckyArriveMode = 'FromDances':
        $BeckyHomeText = 'Бекки бесшумно закрывает тяжелую дверь спальни на засов и, обернувшись с плутовским огоньком в глазах, горячо шепчет: "Тише, Стефанчик… дети ещё внизу. У нас мало времени!"'
    else:
        $BeckyHomeText = 'После тёплого ужина Бекки увлекает вас за собой на второй этаж. В её уютной спальне пахнет сушёными лавандовыми травами, тёплым вином и её сладковатыми духами.'
    end
---

#BeckyHomeFirstSexStep1Text
    $BeckyHomeText = 'Бекки опускается перед вами на колени без единого лишнего слова. Опытная вдова уверенно расстёгивает ваши штаны и с жарким вздохом берёт ваш член в рот, лаская его глубокими движениями с откровенным удовольствием.'
---

#BeckyHomeFirstSexStep2Text
    $BeckyHomeText = 'Она поднимается с колен, расстёгивает корсаж и плотно прижимает свою пышную, тёплую грудь к вашему торсу, водя ею вверх и вниз, пока вы страстно целуете её в шею. Бекки тихо сладостно постанывает, стараясь не шуметь на весь дом.'
---

#BeckyHomeFirstSexStep3Text
    $BeckyHomeText = 'Бекки опускается на мягкую перину и откровенно притягивает вас к себе за бёдра. "Только тише, Стефанчик, милый…" — шепчет она, широко раздвигая пышные бёдра и направляя вас в своё горячее, влажное лоно.'
---

#BeckyHomeAfterSexText
    $BeckyHomeText = 'Бекки присаживается на край кровати, поправляет растрёпанное платье и смущённо, но нежно улыбается вам: "Ну вот, Стефанчик… теперь ты мне точно не просто сосед по ярмарочной лавке."'
---