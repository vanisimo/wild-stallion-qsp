#BeckyHomeFrontIngaText
    if BeckyHomeFrontIngaSex = 1:
        $BeckyHomeText = 'В тёмном углу крыльца, за высокими кадками, Инга стоит на коленях прямо перед Лукасом, а парень судорожно сжимает её за плечи. Бекки с плутовской усмешкой шепчет тебе на ушко: «Ой, смотри-ка… так это ж Ингенборг с ухажёром! До спальни даже не дотерпели, вишь как раззадорились… Эх, молодость-молодость!»'
    else:
        $BeckyHomeText = 'В полумраке крыльца Инга нежно обнимает за шею Лукаса и увлечённо целует его. Бекки мечтательно вздыхает: «Славный парень Лукас, статный, да и на дочке моей жениться обещает.»'
    end
---

#BeckyHomeFrontBeckyHurryText
    if $BeckyArriveMode = 'FromDances':
        $BeckyHomeText = '«Стефанчик, пошли скорее внутрь, пока молодняк нас тут на пороге не засёк!» — Бекки со смешком тянет тебя за рукав к массивной дубовой двери.'
    else:
        $BeckyHomeText = '«Раз уж дети своими делами заняты, пойдём-ка в дом», — шепчет Бекки и с тихим щелчком отпирает дверь.'
    end
---

#BeckyHomeGuestDressFailText
    $BeckyHomeText = 'Бекки оглядывает твой рабочий трактирный наряд, качает головой и сочувственно прицокивает: «Стефанчик, милый, приходи-ка в другой раз, когда оденешься посолиднее. Для гостя в доме вдовы приличный вид — первое дело!»'
---

#BeckyHomeGuestDressOkText
    $BeckyHomeText = 'Бекки просияла, с одобрением оглядывая твой статный костюм: «Ого, вот это сразу видно — хозяин! Проходи, Стефанчик, дети как раз за столом собрались.»'
---

#BeckyHomeGuestDinnerText
    $BeckyHomeText = 'Семейный ужин в доме вдовы проходит в шумной да тёплой обстановке: за длинным столом сидит Эдди, шустро уминают стряпню младшие дети, а подле пристроились Инга с Лукасом. Ты с широким жестом ставишь на стол кувшин выдержанного вина из погребов «Жеребца» — ужин мгновенно оживляется! Бекки ловко отшивает сына кокетливой шуткой, когда Эдди начинает слишком удивлённо посматривать на тебя, а затем пригибается к твоему уху и лукаво шепчет: «После ужина поговорим наедине…»'
---

#BeckyHomeBedroomIntroText
    if BeckyHomeSex = 1:
        $BeckyHomeText = 'Едва ты переступаешь порог спальни, Бекки сразу же горячо прижимается к тебе всем своим пышным телом — опытной вдове уже не нужны лишние прелюдии, она прекрасно знает, зачем ты поднялся к ней.'
    elseif $BeckyArriveMode = 'FromDances':
        $BeckyHomeText = 'Бекки бесшумно закрывает тяжёлую дверь спальни на засов и, обернувшись с плутовским огоньком в глазах, горячо шепчет: «Тише, Стефанчик… дети ещё внизу. У нас мало времени!»'
    else:
        $BeckyHomeText = 'После тёплого ужина Бекки увлекает тебя за собой на второй этаж. В её уютной спальне горит одинокая свеча, отбрасывая мягкие тени на широкую перину и пучки сушёной лаванды у изголовья.'
    end
---

#BeckyHomeFirstSexStep1Text
    $BeckyHomeText = 'Бекки опускается перед тобой на колени без единого лишнего слова. Опытная вдова уверенно расстёгивает твои штаны и с жарким вздохом берёт твой член в рот, лаская его глубокими движениями с откровенным удовольствием.'
---

#BeckyHomeFirstSexStep2Text
    $BeckyHomeText = 'Она поднимается с колен, расстёгивает корсаж и плотно прижимает свою пышную, тёплую грудь к твоему торсу, водя ею вверх и вниз, пока ты страстно целуешь её в шею. Бекки тихо и сладостно постанывает, стараясь не шуметь на весь дом.'
---

#BeckyHomeFirstSexStep3Text
    $BeckyHomeText = 'Бекки опускается на мягкую перину и откровенно притягивает тебя к себе за бёдра. «Только тише, Стефанчик, милый…» — шепчет она, широко раздвигая пышные бёдра и направляя тебя в своё горячее, влажное лоно.'
---

#BeckyHomeAfterSexText
    $BeckyHomeText = 'Бекки присаживается на край кровати, поправляет растрёпанное платье и смущённо, но нежно улыбается тебе: «Ну вот, Стефанчик… теперь ты мне точно не просто сосед по ярмарочной лавке.»'
---
