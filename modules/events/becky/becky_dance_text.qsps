! MODULE: events/becky
! Тексты пятничного танца с Бекки
! ================================================

#BeckyDanceMainText
    if BeckyDanceEnded = 1:
        $BeckyDanceLastText = 'Танец с Бекки на сегодня уже закончен. Вдова, смахнув со лба выбившийся локон, растворилась среди гуляющих.'
    elseif BeckyDanceStage = 0:
        $BeckyDanceLastText = 'Бекки стоит среди танцующих на площади, придерживая пышную юбку, и с лукавой улыбкой встречает твой взгляд.'
    else:
        $BeckyDanceLastText = 'Вы кружитесь с Бекки под весёлую музыку пятничного вечера. Её тёплые руки прижаты к тебе, а пышная юбка мелькает в такт шагам.'
    end
---

#BeckyDanceActionText
    $BeckyDanceActionKey = LCASE($ARGS[0])

    if $BeckyDanceActionKey = 'talk':
        if Friends['becky'] >= 7:
            $BeckyDanceLastText = 'Ты подошёл к весёлой вдовушке и засыпал её бойкими шутками. Бекки заливисто смеётся, прижимая пухлую ладонь к груди: «Ах, Стефанчик, ну и балагур! Весь в отца, тот тоже умел девкам голову заморочить. Но со мной эти штучки не пройдут… хотя слушать тебя одно удовольствие!»'
        else:
            $BeckyDanceLastText = 'Ты подошёл к Бекки и развеселил её свежими городскими байками. Вдова охотно подхватывает шутки, кокетливо поправляет причёску и от души смеётся над твоими словами. За весёлым разговором время пролетает незаметно.'
        end
    elseif $BeckyDanceActionKey = 'invite_eager':
        $BeckyDanceLastText = '«Стефанчик! Ну наконец-то ты вспомнил про бедную вдову!» — просияла Бекки. Она с готовностью подала тебе руку и со смехом увлекла тебя в самый центр танцующего круга.'
    elseif $BeckyDanceActionKey = 'invite_ok':
        $BeckyDanceLastText = '«Стефан, ну вот скажи мне, неужели молодой да статный хозяин трактира правда хочет кружиться с такой старой вдовой? Я ведь старше твоей матушки! Хм, хотя… если уж такой кавалер просит — разве я могу отказать?» — кокетливо улыбается Бекки и уверенно берёт твою руку.'
    elseif $BeckyDanceActionKey = 'invite_fail':
        $BeckyDanceLastText = '«Ох, Стефанчик, милый, не смеши людей! Если тебе так приспичило танцевать со старой тётушкой — иди пригласи маму, она как раз неподалёку», — подмигивает Бекки с хитринкой, но руку не даёт. Вздохнув, ты отходишь в сторону.'
    elseif $BeckyDanceActionKey = 'continue':
        $BeckyDanceLastText = 'Вы продолжаете кружиться в танце с Бекки под весёлые мотивы ярмарочных музыкантов.'
        if $BeckyDanceHands = 'waist':
            $BeckyDanceLastText += ' Твои руки уверенно держат тёплую, пышную талию вдовушки.'
        elseif $BeckyDanceHands = 'ass':
            $BeckyDanceLastText += ' Твои ладони беззастенчиво покоятся на упругой, округлой попе Бекки, ощущая тёплую ткань платья.'
        elseif $BeckyDanceHands = 'ass2':
            $BeckyDanceLastText += ' Твои пальцы откровенно сжимают сочную попу Бекки прямо во время движения, пока вдова прижимается к тебе всё ближе.'
        end
        if BeckyDanceKiss = 1:
            $BeckyDanceLastText += ' Ты нежно касаешься её губ поцелуем, и Бекки с тихим вздохом подаётся навстречу.'
        elseif BeckyDanceKiss = 2:
            $BeckyDanceLastText += ' Ты страстно целуешь Бекки в губы, едва не сбиваясь с ритма под её жаркий, ответный порыв.'
        end
    elseif $BeckyDanceActionKey = 'waist_ok':
        $BeckyDanceLastText = 'Бекки кокетливо улыбается, подаётся к тебе всем пышным телом и прижимается чуть ближе, легко покачиваясь в такт музыке.'
    elseif $BeckyDanceActionKey = 'waist_warn':
        $BeckyDanceLastText = 'Вдова удивлённо приподнимает бровь и цепляет тебя лукавым взглядом: «Ого, Стефанчик, а руки-то у тебя гуляют смелее обычного!» — впрочем, отстраняться она не спешит.'
    elseif $BeckyDanceActionKey = 'waist_fail':
        $BeckyDanceLastText = '«Стефан! Ах ты наглец, мы же договаривались просто потанцевать!» — Бекки с наигранным возмущением высвобождает руку и с улыбкой уходит в толпу.'
    elseif $BeckyDanceActionKey = 'ass_ok':
        $BeckyDanceLastText = 'Бекки сдавленно ахает, чувственно улыбается и лишь сильнее прижимается к тебе, даже не пытаясь смахнуть твои наглые ладони с ягодиц.'
    elseif $BeckyDanceActionKey = 'ass_tease':
        $BeckyDanceLastText = '«Стефанчик, ай-яй-яй! Что ты вытворяешь при всём честном народе?» — шепчет она прямо тебе в ухо, обжигая горячим дыханием. — «Впрочем… продолжай, шалун.»'
    elseif $BeckyDanceActionKey = 'ass_warn':
        $BeckyDanceLastText = '«Так, Стефанчик, ай-яй-яй, остынь!» — со смешком говорит вдова и мягко, но уверенно возвращает твои ладони с ягодиц на талию.'
    elseif $BeckyDanceActionKey = 'ass_fail':
        $BeckyDanceLastText = '«Я твоей матери ровесница, а ты уже за ягодицы хватаешь?!» — вспыхивает Бекки, выдёргивает руку и уходит, оставив тебя посреди площади.'
    elseif $BeckyDanceActionKey = 'squeeze_ok':
        $BeckyDanceLastText = 'Бекки чувственно вздыхает от твоего сжатия. Она без стеснения прижимается к тебе всем телом, трётся пышной грудью о твою грудь и лукаво шепчет на ухо.'
    elseif $BeckyDanceActionKey = 'squeeze_tease':
        $BeckyDanceLastText = '«Стефанчик, ах ты озорной шалун!» — шёпотом отчитывает Бекки, а сама всё сильнее прижимается к тебе своей упругой грудью, едва не пылая от удовольствия.'
    elseif $BeckyDanceActionKey = 'squeeze_warn':
        $BeckyDanceLastText = '«Эк тебя раззадорило, Стефанчик! Ручки-то придержи», — качает головой вдова и аккуратно сдвигает твои пальцы обратно на талию.'
    elseif $BeckyDanceActionKey = 'squeeze_fail':
        $BeckyDanceLastText = '«Ну всё, сопляк, перешёл ты границу!» — Бекки резко отстраняется, одёргивает платье и разворачивается. Вечер на площади для тебя окончен.'
    elseif $BeckyDanceActionKey = 'kiss_passion':
        $BeckyDanceLastText = 'Опытная вдова с жарким вздохом отвечает на поцелуй. Её тёплые губы жадно переплетаются с твоими, пока её пальцы зарываются тебе в волосы.'
    elseif $BeckyDanceActionKey = 'kiss_soft':
        $BeckyDanceLastText = 'Бекки на мгновение ошеломлённо замирает от твоей прямоты, но тут же мягко подаётся навстречу, отвечая на поцелуй с ласковой нежностью.'
    elseif $BeckyDanceActionKey = 'kiss_warn':
        $BeckyDanceLastText = '«Стефанчик, ну ты и сорвиголова! Я ведь почти твоя матушка!» — шепчет она с лёгким смешком и мягко отстраняет твоё лицо.'
    elseif $BeckyDanceActionKey = 'kiss_fail':
        $BeckyDanceLastText = '«Нет уж, милый, это уже лишнее!» — Бекки хмурится, разворачивается и уходит в глубину площади, отказываясь продолжать танец.'
    else:
        $BeckyDanceLastText = 'Вы танцуете с Бекки.'
    end

    killvar '$BeckyDanceActionKey'
---

#BeckyDanceInviteHomeText
    if BeckyHomeSex = 1 and sluttiness['becky'] > 48:
        $BeckyDanceInviteText = '«Стефанчик, милый, ну что мы тут каблуки обиваем на виду у всего города? Пойдём-ка ко мне домой — у меня уже от одного твоего взгляда между ног сладко жжёт!»'
    elseif BeckyHomeSex = 1:
        $BeckyDanceInviteText = '«Стефанчик, яхонтовый мой, а не проведёшь ли бедную вдову до дома? Ну… помнишь ведь, чем у нас всё в прошлый раз закончилось?» — глядя тебе прямо в глаза с плутовской улыбкой, шепчет Бекки.'
    else:
        $BeckyDanceInviteText = '«Стефан, а не заглянешь ко мне в гости на огонёк? У меня и винцо хорошее припрятано, и поговорить есть о чём…» — неожиданно приглашает тебя вдова, наклоняясь ближе.'
    end
---

#BeckyDanceInviteAcceptText
    $BeckyDanceLastText = 'Бекки с довольным смешком берёт тебя под руку и сгорает от нетерпения, увлекая с шумной площади прямо к своему уютному дому.'
---
