    else:
        $BeckyTalkBlock += 'Тебе на миг представляется строгий призрак Эрика, и ты притихаешь.<br>'
    end

    if StefanRespectableSuit = 1:
        $BeckyTalkBlock += '<br>— Ну, хоть одет ты как настоящий дворянин или солидный хозяин, — с явным одобрением замечает вдова, осматривая твой костюм.<br>'
        BeckyTalkHomeInvitePoints += 1
    elseif charisma >= 40:
        $BeckyTalkBlock += '<br>— Ну, хоть держишься ты статно да видно, что парень не промах, — кокетливо соглашается Бекки.<br>'
        BeckyTalkHomeInvitePoints += 1
    else:
        $BeckyTalkBlock += '<br>— А костюмчик-то получше найдётся? А то выглядишь слишком по-простому для визитов к честной вдове.<br>'
    end

    if BeckyTalkHomeInvitePoints >= 4:
        $BeckyTalkBlock += '<br>— Вот чёрт языкастый! — восклицает сдавленно Бекки, со смехом прикрывая лицо ладонями. — Уболтал-таки... Приходи вечерком в гости, да смотри не заставляй бедную вдову долго ждать у окна!'
