#BeckyTalkIngaStory1Text
    $BeckyTalkBlock = '<br>Вы спрашиваешь Бекки про её старшую дочь и её девичьи забавы. Вдова оглаживает фартук и с горделивой улыбкой начинает хвастаться:<br>"Ингеборг-то, доченька моя старшая — такая скромница, прямо глаз радуется!" — рассказывает Бекки. "Вся в меня в её годы! Помню, впервые подсмотрела, как она с юношей в сарай юркнула… Так бедняжка покраснела, уши вжала и потом два дня от меня по углам пряталась — вот до чего стыдливая!"'
---

#BeckyTalkIngaStory2Text
    $BeckyTalkBlock = '<br>Бекки с хитроватой усмешкой продолжает делиться материнскими наблюдениями:<br>"В следующий-то раз, когда я снова наткнулась на неё с тем же юнцом на сеновале, она хоть и залилась краской, а губок уже не разжимала. Ну, пришлось мне вмешаться да показать девке, как правильнее брать да ласкать — а она всё мялась да краснела, пока я её уму-разуму учила!"'
---

#BeckyTalkIngaStory3Text
    $BeckyTalkBlock = '<br>Вдова с готовностью отвечает на ваш вопрос про дочерина ухажёра:<br>"А что Лукас? Парень хваткий, плечистый! Инга-то у меня на вид тихоня, а он на первом же свидании, как она мне со слезами да со смехом потом призналась, от этой девичьей обузы её и избавил. Теперь вот хвостиком за ним вьётся, а он грудь колесом держит да жениться обещает!"'
---

#BeckyTalkHusbandStory1Text
    $BeckyTalkBlock = '<br>Глаза Бекки мечтательно затуманиваются от тёплых воспоминаний о былом:<br>"Эрик мой покойный первый кавалер был на всю улицу! Статный, сильный, да и семья не из бедных. На праздничных танцах подхватил меня — я так прямо у него на груди и растаяла. И всё, стала его постоянной зазнобой. Озорник он был великий — ох, и любил всякие забавы да выдумки!"'
---

#BeckyTalkHusbandStory2Text
    $BeckyTalkBlock = '<br>Вдовушка кокетливо опирается о прилавок и продолжает откровенничать:<br>"Покойник мой Эрик страсть как любил шумные пирушки устраивать. Бывало, соберёмся с подружками и мужиками — да и поменяемся парами на ночь! Весело было, огонь в жилах кипел… хотя перед детьми, конечно, теперь стыдно такое вслух вспоминать."'
---

#BeckyTalkHusbandStory3Text
    $BeckyTalkBlock = '<br>Бекки на секунду задумчиво трогает выбившийся локон:<br>"Роза, подружка моя закадычная, меня с Эриком тогда и познакомила. А потом частым гостем у нас в спальне стала — по старой памяти да под винцо мужиками делились. Эрик Розочку охаживает до пота, а её муженёк со мной забавляется. Ох и весёлые времена были!"'
---

#BeckyTalkHusbandStory4Text
    $BeckyTalkBlock = '<br>Бекки слегка прищипывает подбородок, перебирая в памяти прошлые годы:<br>"Были у Эрика и другие девки. Одна вон служанкой в богатом доме работала, потом замуж вышла, а всё равно к нам ночевать забегала. У нас в доме это чем-то дурным никогда не считалось — лишь бы в радость!"'
---

#BeckyTalkHusbandStory5Text
    $BeckyTalkBlock = '<br>Вдовушка заливисто смеётся, качая головой:<br>"Судя по всему, Эрик умел так легко всё преподнести, что любая забава казалась просто весёлой игрой. Я до сих пор не пойму — то ли каяться перед Ильматером, то ли благодарить покойника за то, какой смышлёной да горячей женщиной я стала!"'
---

#BeckyTalkEddieStory1Text
    $BeckyTalkBlock = '<br>Бекки просияла, расправляя плечи — разговор про сына явно доставляет ей гордость:<br>"Эдди у меня умница! И в лавке первый помощник, и с покупательницами так ласково да куртуазно говорит, прямо загляденье. Правда, иногда уставится в одну точку да задумывается — вот это точно от отца покойного досталось."'
---

#BeckyTalkEddieGeorgText
    $BeckyTalkBlock = '<br>Вы без лишних экивоков ухмыляетесь и рассказываете Бекки, как её сын Эдди упрашивает девицу Жоржетту играть в подсобке роль «строгой мамочки». Вдова мгновенно вспыхивает густым румянцем до самых ушей, хапает ртом воздух, но слушает до конца и смущённо вздыхает: "Ах, озорник… Ну надо же до такого додуматься!"'
---

#BeckyTalkHomeInviteRun
    $BeckyTalkBlock = '<br>Ты подходишь вплотную, обдаёте вдову уверенным взглядом и напрашиваетесь в гости: "Бекки, сладкая моя, а не зайти ли мне к тебе вечерком на огонёк?"<br>'

    if HusbandStory = 0:
        $BeckyTalkBlock += '"Ой, нет, Стефанчик, я же тебя толком и не знаю ещё! Соседи увидят, языками чесать начнут — уж извини, милый, но нет!" — смущённо качает головой вдова.<br>'
        BeckyTalkHomeInvitePoints = 0
        exit
    end

    BeckyTalkHomeInvitePoints = 0
    $BeckyTalkBlock += '"Стефанчик, я бы и рада тебя пригреть, но что дети скажут? Вот Эдди — как я родному сыну в глаза смотреть буду, если молоденького кавалера в дом приведу?" — вздыхает Бекки.<br>'

    if EddieStory >= 2:
        $BeckyTalkBlock += 'Вы усмехаетесь и вворачиваете, что Эдди в трактире и не такое видел, так что его удивить трудно. Бекки ахает, но возразить ей нечего.<br>'
        BeckyTalkHomeInvitePoints += 1
    else:
        $BeckyTalkBlock += 'Вы не находите подходящих слов про Эдди и лишь неопределённо пожимаете плечами.<br>'
    end

    $BeckyTalkBlock += '"А дочка моя старшая, Ингеборг?" — пристально смотрит вам в глаза вдова.<br>'

    if IngaStory >= 3:
        $BeckyTalkBlock += '"А что Инга? Пусть с матери пример берёт и статного парня в дом зовёт, а не по подворотням обнимается," — парируете вы. Бекки кокетливо сдерживает улыбку.<br>'
        BeckyTalkHomeInvitePoints += 1
    else:
        $BeckyTalkBlock += 'Ты пытаешься заговорить ей зубы, но вдова лишь качает головой, и вы сбиваетесь.<br>'
    end

    $BeckyTalkBlock += '"А покойный муженёк мой Эрик как бы на это с того света посмотрел?" — всплескивает пухлыми ручками Бекки.<br>'

    if HusbandStory >= 3:
        $BeckyTalkBlock += '"Судя по твоим же рассказам про его забавы — с полнейшим одобрением да с желанием лично присоединиться," — выдаёте вы. Бекки заливисто смеётся: "И то правда, Эрик бы не отказался!"<br>'
        BeckyTalkHomeInvitePoints += 1
    else:
        $BeckyTalkBlock += 'Вам на миг представляется суровый призрак Эрика, и вы стыдливо притихаете.<br>'
    end

    if StefanRespectableSuit = 1:
        $BeckyTalkBlock += '"Ну, хоть одет ты как настоящий дворянин или солидный хозяин," — с одобрением замечает вдова, осматривая ваш костюм.<br>'
        BeckyTalkHomeInvitePoints += 1
    elseif charisma >= 40:
        $BeckyTalkBlock += '"Ну хоть держишься ты статно да видно, что парень не промах," — кокетливо соглашается Бекки.<br>'
        BeckyTalkHomeInvitePoints += 1
    else:
        $BeckyTalkBlock += '"А костюмчик-то получше найдётся? А то выглядишь слишком по-простому для визитов к честной вдове."<br>'
    end

    if BeckyTalkHomeInvitePoints >= 4:
        $BeckyTalkBlock += '"Вот чёрт языкастый!" — восклицает сдавленно Бекки, со смехом прикрывая рот ладонью. — "Уболтал-таки… Приходи вечерком в гости, да смотри не заставляй бедную вдову долго ждать."<br>'
        if BeckyHomeStage < 3:
            BeckyHomeStage = 3
        end
    else:
        $BeckyTalkBlock += '"Ну вот, сам видишь — в гости тебе ко мне пока рановато!" — с торжествующей улыбкой подводит итог вдова.<br>'
    end
---

#BeckyTalkPastVisitText
    if BeckyHomeSex = 1 and sluttiness['becky'] >= 42:
        $BeckyTalkBlock = '<br>"Стефанчик, милый, ты приходи ко мне почаще," — игриво шепчет Бекки, оглаживая юбку. "А то я без твоей мужской ласки да горячих ночей уже и уснуть спокойно не могу."'
    elseif BeckyTimesVisited <= 2:
        $BeckyTalkBlock = '<br>"Ой, Стефанчик, я так рада, что ты заглянул! Со всей семьёй нашей переведался — у нас-то в доме гостей уже давненько не бывало."'
    else:
        $BeckyTalkBlock = '<br>"Душевно зашёл, Стефанчик. Ты заглядывай ещё, не стесняйся — дверям перед тобой всегда рады!" — тепло улыбается Бекки.'
    end
