! ================================================
! FILE: modules/events/becky/becky_shop_backroom_peek_text.qsps
! MODULE: events/becky
! ! [AI-WORKED] Текст переработан в прямой 18+ 13.10.2026
! Тексты подглядывания в заднюю комнату лавки Бекки
! ================================================

#BeckyShopBackroomPeekText
    $BeckyShopBackroomPeekTextId = LCASE($ARGS[0])
    $BeckyShopBackroomPeekText = ''

    if $BeckyShopBackroomPeekTextId = 'sailors_two':
        $BeckyShopBackroomPeekText = 'В полумраке подсобки Бекки управляется сразу с двумя рослыми моряками. Юбка её задрана до пояса, открывая вид на голую попу, а бёдра ходят ходуном под напором матроса что держит её за бёдра и жёстко входит сзади. Второй устроился спереди: она берёт его член в рот и сосёт в такт толчкам жадно насаживая губы на толстый ствол. На всю каморку раздаются влажные шлепки и её глухие стоны. На миг выпустив мокрый член изо рта, Бекки тяжело переводит дух и с распутной хрипотцой командует:'
        $BeckyShopBackroomPeekText += '<br>— Сильнее насаживай… оба разом… не смейте сбавлять!'
        $BeckyShopBackroomPeekText += '<br>— Ох и жадная же ты баба, Бекки… всю душу вытянешь, — хрипит передний, пока она снова заглатывает его член, выгибая поясницу навстречу второму хую.'

    elseif $BeckyShopBackroomPeekTextId = 'lucas':
        $BeckyShopBackroomPeekText = 'Бекки сидит на краю тяжёлого деревянного ларя, широко раскинув полные бёдра и задрав подол. Лукас стоит между её ног, судорожно вжимаясь в щель хозяйки лавки, отчего пизда Бекки влажно хлюпает. Вдова оплетает шею парня руками, властно притягивая к своему вырезу, и стонет сквозь зубы:'
        $BeckyShopBackroomPeekText += '<br>— Глубже входи… вот так, Лукас… бери, пока женщина даёт.'
        $BeckyShopBackroomPeekText += '<br>— Бекки… ты с ума меня сведёшь… — прерывисто сипит Лукас, сжимая пальцами её ягодицы и вколачивая член до самого упора.'
        $BeckyShopBackroomPeekText += '<br>Она запрокидывает голову и сама подаётся попой навстречу каждому его рывку.'

    elseif $BeckyShopBackroomPeekTextId = 'mayor_clerk':
        $BeckyShopBackroomPeekText = 'Бекки, расставив ноги и задрав юбку, стоит упёршись руками в стену, открыв вид на свою голую вагину клерку из ратуши. Чиновник озирается на дверной засов, но взгляд возвращается к зовущей дырочке:'
        $BeckyShopBackroomPeekText += '<br>— Засов на месте, — с усмешкой говорит она, виляя попой. — Пиши в книгу… недоимку списывай… и я дам не только посмотреть.'
        $BeckyShopBackroomPeekText += '<br>— Да-да… спишу всё, только дай присунуть… — задыхается клерк, стягивая штаны и вставляя член в манящую вагину.'
        $BeckyShopBackroomPeekText += '<br>Бекки, еле слышно охнув, лишь плавно покачивается навстречу ударам, закусывая губу, чтобы стоны не вырвались в торговый зал.'

    elseif $BeckyShopBackroomPeekTextId = 'merchant':
        $BeckyShopBackroomPeekText = 'Купец держит Бекки за пышные бёдра, прижав её грудью к дубовой столешнице. Юбка хозяйки задрана на спину, и мужчина мерно, по-хозяйски входит на всю длину. Никакой спешки: на каждый глубокий толчок Бекки выдыхает, упирается ладонями в край стола и послушно подаёт таз назад, подстраиваясь под темп. В тишине раздаются только мокрые хлопки соприкасающихся тел, и звук хлюпающей пизды хозяйки. Она поворачивает к нему раскрасневшееся лицо через плечо:'
        $BeckyShopBackroomPeekText += '<br>— Хорошая сделка получилась… да и сам ты в деле неплох, купец.'
        $BeckyShopBackroomPeekText += '<br>— С тобой, вдовушка, любой уговор в радость… я завсегда скидку дам, если ты дашь... — гулко басит он, шлёпая ладонью по округлой ягодице и ещё плотнее прижимая её к дереву.'

    else:
        $BeckyShopBackroomPeekText = 'В глубине подсобки виден задранный подол платья и склонённая фигура Бекки. Упёршись ладонями в деревянные полки, вдова выгибает поясницу, пока стоящий сзади мужчина размеренно и глубоко вбивается в её тело. От каждого удара звучат мокрые шлепки кожи и её протяжные, томные вздохи:'
        $BeckyShopBackroomPeekText += '<br>— Ах… давай быстрее, пока не пришел никто…'
        $BeckyShopBackroomPeekText += '<br>— Сейчас, хозяйка, сейчас всё отдам… — глухо отзывается гость, сильнее впиваясь пальцами в её округлые бока.'
        $BeckyShopBackroomPeekText += '<br>Засов на двери надёжно задвинут: Бекки спокойно совмещает учёт припасов с быстрой утехой посреди рабочего дня.'
    end

    killvar '$BeckyShopBackroomPeekTextId'
---
