! ================================================
! FILE: modules/events/kitchen/kitchen_customer_event_text.qsps
! MODULE: events/kitchen
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Тексты клиентского конфликта на кухне
! Используется: kitchen_customer_event.qsps
! ================================================

#KitchenCustomerPrintText
    $KitchenCustomerTextId = LCASE($ARGS[0])

    if $KitchenCustomerGirl = '':
        $KitchenCustomerGirl = 'amanda'
    end

    if $RealName[$KitchenCustomerGirl] = '':
        gs 'KitchenCustomerEnsureName', $KitchenCustomerGirl
    end

    $cg = $KitchenCustomerGirl
    $cName = $RealName[$cg]
    $cClient = LCASE($KitchenCustomerClient)
    $cScene = LCASE($KitchenCustomerScene)
    u_lvl = KitchenCustomerUniform

    if $KitchenCustomerTextId = 'intro':
        if $cScene = 'bad_food':
            if $cClient = 'angry_guest' or $cClient = 'craftsman':
                *pl 'С кухни доносится грохот глиняной миски о деревянную столешницу. Недовольный гость тычет заскорузлым пальцем в похлёбку и шумно возмущается на весь проход:'
                *pl '— Ты чем меня кормишь, девка?! Сало прогоркло, а в миске одна капустная жижа! Зови хозяина, я за это пойло ни медной монеты не дам!'
            else
                *pl 'Из кухни раздаётся раздражённый голос сытого купца. Он брезгливо ковыряет деревянной ложкой похлёбку и качает головой:'
                *pl '— За такие деньги в приличном городе подают пряное рагу с бараниной, а не это варево. Трактирщик на гостях экономит, а ты, красавица, подаёшь и глазом не моргнёшь.'
            end
            *pl ' '
            if $cg = 'sandra':
                *pl 'Сандра даже бровью не ведёт. Она неторопливо вытирает руки о передник, оглядывает гостя тяжёлым, спокойным взглядом опытной хозяйки и забирает миску:'
                *pl '— Бульон на свежих мозговых костях, а капусту только вчера из бочки достали. Не нравится — пей пиво в зале, а на кухне мне под руку орать нечего.'
            elseif $cg = 'melissa':
                *pl 'Мелисса скрещивает руки на груди и меряет гостя холодным, насмешливым взглядом книжной зазнайки:'
                *pl '— Прежде чем рассуждать о вкусе похлёбки, любезный, стоило бы хотя бы вымыть руки после конюшни. Рецепт выверен до грана соли, а претензии ваши продиктованы исключительно нежеланием платить.'
            else
                *pl 'Аманда от неожиданности вздрагивает, прижимая к груди деревянный поднос. Щёки её мгновенно вспыхивают пунцовым румянцем, но в девичьих глазах мелькает упрямая искра:'
                *pl '— Что вы кричите на всю кухню?! Нормальное рагу, все едят и хвалят! Не надо на меня руками махать, заказ на стол подали как положено!'
            end

        elseif $cScene = 'wrong_order':
            *pl 'В кухонную дверь вваливается постоялец с тарелкой в руках. На лице — глухое раздражение:'
            *pl '— Я битый час ждал жаркое с луком, а мне приволокли миску пареной репы! Вы там в зале уши пропили или на кухне всё перепутали?!'
            *pl ' '
            if $cg = 'sandra':
                *pl 'Сандра сурово сдвигает брови, заглядывая в чужую тарелку:'
                *pl '— Не ори у очага. Жаркое ещё томится в печи, а репу тебе подали вприкуску, чтоб брюхо не урчало. Вернись за стол и жди, пока позову.'
            elseif $cg = 'melissa':
                *pl 'Мелисса даже не оборачивается от полки с кувшинами, бросая через плечо с сухой иронией:'
                *pl '— Если бы вы внимательнее слушали, когда делали заказ, то вспомнили бы, что заказали именно дневной набор. Жаркое стоит на четыре медяка дороже, и никто вам его даром не обещал.'
            else
                *pl 'Аманда растерянно хлопает ресницами, судорожно вспоминая, что именно уносила за его стол:'
                *pl '— Подождите... Вы же сами махнули рукой на третье блюдо! Я сейчас всё проверю, не нужно кричать на меня при всех!'
            end

        elseif $cScene = 'drunk_enters':
            *pl 'Дверь кухни с глухим скрипом распахивается, и внутрь заваливается изрядно захмелевший гость. От него за версту несёт кислым хмелем и дешёвым табаком. Заметив фигуру у очага, он похотливо скалится и расставляет руки:'
            *pl '— О-о, а вот и сладенькое... Чё ты в зале не крутишься, а? Поди сюда, хозяюшка, уважь гостя, пока никто не видит... Я не обижу, серебром осыплю!'
            *pl ' '
            if $cg = 'sandra':
                *pl 'Сандра мгновенно подхватывает с разделочной доски увесистую деревянную скалку и делает шаг вперёд с ледяным прищуром:'
                *pl '— А ну стой, где стоишь, образина пьяная! Ещё шаг сделаешь — я тебе лоб расшибу, до утра не очухаешься. Марш в зал, пока я кочергу не нагрела!'
            elseif $cg = 'melissa':
                *pl 'Мелисса брезгливо пятится к столу с ножами, окинув пьяницу взглядом, полным ядовитого презрения:'
                *pl '— Перегар в три локтя, слюни по бороде, а гонору на целый герцогский замок. Развернись на сто восемьдесят градусов и выметайся в общую залу, пока я не позвала Стефана с дубиной.'
            else
                *pl 'Аманда в панике отступает к мешкам с мукой, вжимаясь спиной в деревянные лари. Её девичья грудь тревожно вздымается под тканью платья, а голос срывается от волнения:'
                *pl '— Пошёл вон! Ты с ума сошёл?! Сюда гостям нельзя! Выйди немедленно, а то я закричу!'
            end

        elseif $cScene = 'grab':
            *pl 'Посетитель уверенно пересекает порог кухни, пользуясь тем, что в проходе никого нет. Прижав ' + $cName + ' к краю разделочного стола, он без церемоний хватает её свободной рукой за талию, прижимаясь вплотную:'
            *pl '— Да брось ты эти миски, красавица... Посмотри на меня. Дело есть на пару минут, договоримся по-хорошему, никто и не узнает...'
            *pl ' '
            if $cg = 'sandra':
                *pl 'Сандра с размаху бьёт его железной ложкой по загребущей ладони. Мужик сдавленно ойкает и отдёргивает руку, а Сандра упирает кулаки в пышные бока:'
                *pl '— Лапы убрал, кобель безродный! Об печку обжечься захотел?! Щас кипятком плесну — быстро память о бабах отшибёт!'
            elseif $cg = 'melissa':
                *pl 'Мелисса с ледяным спокойствием упирает рукоять деревянной лопатки прямо в грудь наглеца, не позволяя придвинуться ближе:'
                *pl '— Убери свои грязные пальцы от моей талии. Твоё дыхание оскорбляет моё обоняние, а твоя наглость заслуживает встречи с городским стражником.'
            else
                *pl 'Аманда испуганно вскрикивает, пытаясь выкрутиться из цепких пальцев. Тонкая ткань платья натягивается на девичьей груди, а щёки заливает густой краской стыда и бессильной злости:'
                *pl '— Пусти меня! Слышишь, пусти сейчас же! Не трогай меня своими руками!'
            end

        elseif $cScene = 'private_offer':
            *pl 'В кухню неспешно заходит зажиточный купец. Оглядев горячий очаг и уединённое пространство, он с маслянистой ухмылкой кладёт на мучной стол блестящую серебряную монету:'
            *pl '— Еда хороша, хозяюшка, спору нет. Но, может, сообразим угощение послаще? Отойдём в кладовую на четверть часа — и эта монета окажется в твоём кармашке. А за хорошую ласку я и добавлю.'
            *pl ' '
            if $cg = 'sandra':
                *pl 'Сандра бросает косой взгляд на серебро, затем на лощёную рожу купца. В её глазах мелькает усталая, знающая усмешка женщины, повидавшей на своём веку немало таких предложений:'
                *pl '— Заманчиво звенишь, купец. Только кухня — для работы, а не для твоих похотливых забав. Забирай серебро и иди пей своё вино.'
            elseif $cg = 'melissa':
                *pl 'Мелисса скептически смотрит на монету, слегка изогнув бровь в насмешливой оценке:'
                *pl '— Полновесный серебряный за пару минут вашего сомнительного удовольствия? Любопытно, насколько мужское тщеславие переоценивает свою привлекательность. Спрячьте кошель, сударь, здесь приличный трактир.'
            else
                *pl 'Аманда уставляет круглые глаза на блестящую монету. Кровь приливает к её щекам, сердечко начинает колотиться быстрее от дерзкого намёка:'
                *pl '— Вы... что вы такое говорите?! Заберите свои деньги! Я честная девушка, а не девка из портового вертепа!'
            end

        elseif $cScene = 'backdoor_deal':
            *pl 'Один из гостей проскальзывает вглубь кухни, поближе к тяжёлой задней двери, выходящей на задний двор. Озираясь по сторонам, он негромко окликает ' + $cName + ', многозначительно позвякивая увесистым кошелём:'
            *pl '— Пс-с, красавица... Выйдем на заднее крыльцо на пару минут? Там за поленницей тихо, никто не увидит. Дашь поцеловать да потрогать — полкошеля твои.'
            *pl ' '
            if $cg = 'sandra':
                *pl 'Сандра тяжело вздыхает, глядя на него как на пустое место:'
                *pl '— Ильматер всеблагой, ещё один шустрый нашёлся. Задняя дверь на засов закрыта, а тебе пора на свежий воздух через парадную. Пошёл отсюда.'
            elseif $cg = 'melissa':
                *pl 'Мелисса сухо фыркает, продолжая протирать тарелку полотенцем:'
                *pl '— Предложение столь же банальное, сколь и глупое. За поленницей сыро и воняет помоями. Вы перепутали меня с портовой шлюхой, любезный.'
            else
                *pl 'Аманда кусает нижнюю губу, испуганно поглядывая в сторону главного зала. Искушение монетой борется со страхом, но она упрямо качает головой:'
                *pl '— Не пойду я никуда! Уходите обратно к столу, пока Стефан не увидел!'
            end

        elseif $cScene = 'pantry_corner':
            *pl 'Из тёмной прохладной кладовой доносится приглушённый шорох мешков и настойчивый мужской шёпот. ' + $cName + ' зашла за крупой, а следом за ней юркнул постоялец, загородив собой узкий дверной проём:'
            *pl '— Тихо ты, не егози... В темноте-то оно слаще. Дай хоть за подол подержаться, я ж вижу, как ты бёдрами в зале крутишь...'
            *pl ' '
            if $cg = 'sandra':
                *pl 'В темноте кладовой раздаётся глухой удар и мужское кряхтение. Сандра выходит на свет, отряхивая руки:'
                *pl '— Ещё раз сунешься в кладовку — мешком с овсом по хребту прилетит. Уяснил?'
            elseif $cg = 'melissa':
                *pl 'Из проёма кладовой раздаётся резкий, возмущённый голос Мелиссы:'
                *pl '— Отодвинься от прохода, болван! Ты стоишь на мешке с фасолью, а твои попытки прижать меня к стене выглядят жалко и нелепо!'
            else
                *pl 'Аманда вжимается в полки с банками, часто дыша от волнения и стыда:'
                *pl '— Пустите меня! Выхода нет, а вы... отойдите от двери, немедленно!'
            end

        elseif $cScene = 'satisfied_slap':
            *pl 'Сытый, лоснящийся постоялец заглядывает на кухню, шумно поглаживая набитое брюхо:'
            *pl '— Ай да хозяйка, ай да молодец! Баранина с травами вышла на славу!'
            *pl ' '
            *pl 'Проходя мимо ' + $cName + ', гость широко замахивается и с громким, звонким хлопком от души шлёпает её по мягкой аппетитной заднице!'
            *pl ' '
            if $cg = 'sandra':
                *pl 'Пышные бедра Сандры колышутся от увесистого шлепка. Она круто разворачивается, сжав поварёшку, а в глазах пляшут опасные искры:'
                *pl '— Совсем ошалел, старый хрыч?! Рад похлёбке — скажи спасибо на словах, а руки от моей задницы убери, пока целы!'
            elseif $cg = 'melissa':
                *pl 'Мелисса от неожиданности подпрыгивает на месте. Её лицо заливает краска ярости, а пальцы сжимаются в кулаки:'
                *pl '— Ты что себе позволяешь, животное?! Твои манеры не уступают твоей тупости! Пошёл вон из кухни!'
            else
                *pl 'Аманда взвизгивает от неожиданности, мгновенно прижимая ладошку к пылающей от удара ягодице. Её девичье личико заливает густой румянец:'
                *pl '— Ай! Вы... вы с ума сошли?! Как вам не стыдно распускать руки?!'
            end

        elseif $cScene = 'compliment_food':
            if $cClient = 'rich_merchant' or $cClient = 'craftsman':
                *pl 'В кухонный проём заглядывает степенный гость с масляной улыбкой на сытом лице. Он оглаживает бороду, причмокивая от неподдельного удовольствия:'
                *pl '— Хвала Ильматеру, какой обед! Сколько лет по трактам мотаюсь, а такого сочного, пряного мяса и наваристой похлёбки отродясь не едал! Пришёл лично поклон стряпухе отвесить!'
            else
                *pl 'Широко улыбаясь и утирая усы краем рукава, в кухонную дверь робко стучится довольный постоялец:'
                *pl '— Эй, хозяюшки! Не сочтите за дерзость, просто сил не было молчать — похлёбка ваша сегодня просто великолепна! Вся наша компания миски чуть ли не языком вылизала!'
            end
            *pl ' '
            if $cg = 'sandra':
                *pl 'Сандра от неожиданной похвалы на миг замирает у разделочной доски. На её строгом лице появляется непривычно мягкая, горделивая улыбка истинной хозяйки дома:'
                *pl '— Ну надо же, оценили... — она вытирает муку с пальцев о чистый край передника. — Старалась. Травы свежие пустила, да и мясо доброе Стефан подобрал. Кушайте на здоровье, пока горячее.'
            elseif $cg = 'melissa':
                *pl 'Мелисса с достоинством откладывает поварёшку, с лёгкой иронией вздёрнув бровь, но в её умных глазах искрится искреннее удовлетворение:'
                *pl '— Рада слышать, что в этом городе ещё остались люди с развитым вкусом. Соблюдение точных пропорций пряностей и выверенное время томления творят чудеса даже с обычным рагу.'
            else
                *pl 'Аманда расплывается в сияющей, счастливой улыбке. Её щёки покрываются румянцем искренней девичьей радости:'
                *pl '— Ой, правда понравилось?! Спасибо вам огромное! Мы с утра над этим котлом хлопотали, так переживали, чтоб не подгорело! Приходите к нам почаще!'
            end

        else
            *pl 'На кухне разгорается шумная перепалка. Гость зашёл за перегородку и спорит с ' + $cName + ', нарушая рабочий порядок трактира.'
        end

    elseif $KitchenCustomerTextId = 'thoughts':
        *pl 'На кухне всегда тесно, парит от котлов и пахнет жареным мясом. Любая вольность здесь воспринимается острее, чем в шумном зале.'
        *pl 'Стефан стоит у входа, прикидывая варианты: вмешаться властно и поставить наглеца на место, показав силу хозяина; дать девчонке самой выкрутиться и осадить гостя; или закрыть глаза, если серебро в трактирном кошельке важнее девичьей гордости.'

    elseif $KitchenCustomerTextId = 'stop':
        *pl 'Стефан решительно шагает через порог кухни. Его фигура перекрывает проход, а хозяйский голос звучит веско и глухо, перекрывая гул очага:'
        *pl '— Руки при себе держи, любезный. Заказы ждут в зале, а на кухне распоряжаюсь я. Пошёл вон отсюда, пока я тебя за шкирку не выставил.'
        *pl ' '
        *pl 'Посетитель осекается, видя перед собой молодого, крепкого трактирщика. Бурча под нос невнятные оправдания, мужик неловко пятится спиной к выходу и торопливо скрывается в зале.'
        *pl ' '
        if $cg = 'sandra':
            *pl 'Сандра облегчённо выдыхает и опускает скалку на стол, бросая на Стефана тёплый, одобрительный взгляд:'
            *pl '— Спасибо, Стефан. Вовремя ты подоспел. А то эти мужики от выпивки совсем стыд теряют, думают, раз женщина у плиты — так и прижать можно.'
        elseif $cg = 'melissa':
            *pl 'Мелисса поправляет складки платья и слегка усмехается уголком губ, оценив хозяйский тон Стефана:'
            *pl '— Приятно видеть, что у трактира есть хозяин, умеющий говорить твёрдо. Спасибо, Стефан. Некоторым особям человеческого рода слова понятны только в командном тоне.'
        else
            *pl 'Аманда прерывисто переводит дух, её сердечко всё ещё испуганно колотится, а глаза сияют благодарностью:'
            *pl '— Стефан... спасибо тебе! Видит Ильматер, я уже не знала, что делать! Совсем от хмеля одурел...'
        end

    elseif $KitchenCustomerTextId = 'let_her':
        *pl 'Стефан остаётся в полутени дверного проёма, скрестив руки на груди и давая ' + $cName + ' возможность самой справиться с наглецом.'
        *pl ' '
        if $cg = 'sandra':
            *pl 'Сандра не даёт слабины. Она упирает руки в бока и чеканит каждое слово с непререкаемым весом старшей хозяйки:'
            *pl '— Ты моё слово слышал? Пошёл в зал, говорю. Ещё раз сунешься на кухню — останешься и без похлёбки, и без зубов. Пошёл!'
            *pl ' '
            *pl 'Мужик крякает, стушевавшись под её суровым взглядом, бросает пару монет на угол разделочного стола «на чай хозяйке» и торопливо ретируется.'
        elseif $cg = 'melissa':
            *pl 'Мелисса не повышает голоса, но её слова бьют точнее хлыста:'
            *pl '— Если ваш скудный ум полагает, что такое поведение делает вам честь, вынуждена вас разочаровать. Вы выглядите нелепо и жалко. Вернитесь на своё место и не позорьтесь.'
            *pl ' '
            *pl 'Поражённый столь хладнокровным и умным отпором, гость сконфуженно чешет затылок, оставляет монету на столе за доставленные неудобства и убирается восвояси.'
        else
            *pl 'Аманда глубоко вдыхает, собирает всю девичью смелость в кулак и с гордо вскинутым подбородком указывает клиенту на дверь:'
            *pl '— Я сказала — вон! Я здесь работаю, а не с пьяницами любезничаю! Если сейчас же не уйдёте — позову Стефана, он вас живо проучит!'
            *pl ' '
            *pl 'Напористость девушки сбивает гостя с толку. Ухмыльнувшись, он бросает ей серебряную монету за характер и нехотя выходит обратно в общий зал.'
        end

    elseif $KitchenCustomerTextId = 'client':
        *pl 'Стефан делает шаг назад в тень прохода, делая вид, что занят осмотром мешков с мукой и не замечает происходящего у плиты.'
        *pl ' '
        if $cg = 'sandra':
            *pl 'Сандра бросает на Стефана долгий, знающий и слегка насмешливый взгляд. Поняв негласное согласие хозяина, она мягчеет в голосе, позволяя гостю подойти чуть ближе и положить монеты прямо на край её передника:'
            *pl '— Ладно уж, охальник... Не шуми на кухне. Заказ забирай, а серебро оставь. И чтоб тихо мне в зале сидел.'
            *pl ' '
            *pl 'Довольный гость легонько сжимает её пышное плечо, прячет ухмылку в усы и возвращается к друзьям. Серебро перекочёвывает в карман фартука Сандры.'
        elseif $cg = 'melissa':
            *pl 'Мелисса ловит взгляд Стефана и едва заметно кривит губы в тонкой, ироничной усмешке. Раз хозяин считает, что звон монет важнее чопорных приличий — она примет эти правила:'
            *pl '— Что ж... Глупость должна быть наказуема монетой. Оставьте ваше серебро на столе, сударь, и считайте это платой за науку.'
            *pl ' '
            *pl 'Клиент радостно выкладывает серебро, украдкой проводит пальцами по тонкой талии девушки и довольный выходит в зал.'
        else
            *pl 'Аманда замечает, что Стефан не вмешивается. Её девичьи щёки заливает густой, жаркий румянец смущения, сердечко бешено колотится. Слегка опустив ресницы, она с трепетом позволяет гостю сунуть серебро ей в ладошку:'
            *pl '— Спасибо... только... только в зале никому не говорите, ладно? Идите на место...'
            *pl ' '
            *pl 'Гость плотоядно подмигивает юной работнице и выходит, оставив Аманду с горящими щеками и зажатой в кулачке полновесной монетой.'
        end

    elseif $KitchenCustomerTextId = 'praise_share':
        *pl 'Стефан улыбается и делает шаг вперёд, открыто указывая на ' + $cName + ':'
        *pl '— Вся заслуга — её золотых рук! В «Диком Жеребце» стол держится на наших красавицах, так что все добрые слова по праву принадлежат ей.'
        *pl ' '
        if $cg = 'sandra':
            *pl 'Сандра бросает на Стефана тёплый, благодарный взгляд. Гость расплывается в улыбке и с поклоном оставляет на краю стола серебряную монету лично стряпухе на булавки. Похвала пасынка пришлась ей по сердцу.'
        elseif $cg = 'melissa':
            *pl 'Мелисса слегка склоняет голову, польщённая тем, что Стефан не стал приписывать лавры себе. Гость оставляет серебряный спинтарий, благодаря за изысканный стол.'
        else
            *pl 'Аманда от гордости и смущения сияет как начищенный медный таз. Гость звонко опускает серебро прямо ей в фартук, а девушка ловит взгляд Стефана, полный одобрения.'
        end

    elseif $KitchenCustomerTextId = 'praise_host':
        *pl 'Стефан с достоинством принимает похвалу, скрестив руки на груди:'
        *pl '— В моём заведении иначе и быть не может. Для гостей «Дикого Жеребца» мы держим только лучшие припасы и строгий порядок на кухне. Приходи почаще, добрый человек!'
        *pl ' '
        *pl 'Впечатлённый хозяйской уверенностью, гость довольно кивает и отсчитывает щедрую прибавку в счёт заведения. Трактир крепнет на глазах, а авторитет Стефана только растёт.'

    elseif $KitchenCustomerTextId = 'praise_treat':
        *pl 'Стефан широко улыбается и хлопает гостя по плечу:'
        *pl '— За доброе слово и кружки доброго эля не жалко! Налей-ка нашему другу пенистого за счёт заведения!'
        *pl ' '
        *pl 'Гость в полном восторге: где ещё хозяин встречает доброе слово такой щедростью?! Он клянётся Ильматером, что отныне будет водить сюда всех своих друзей и знакомых купцов.'

    else
        *pl ' '
    end

    killvar '$KitchenCustomerTextId'
    killvar '$cg'
    killvar '$cName'
    killvar '$cClient'
    killvar '$cScene'
    killvar 'u_lvl'
---
