! ================================================
! FILE: modules/events/kitchen/kitchen_customer_event_text.qsps
! MODULE: events/kitchen
! USER-OWNED TEXT
! Тексты клиентского конфликта на кухне
! Используется: kitchen_customer_event.qsps
! ================================================

#KitchenCustomerPrintText
    gs 'KitchenCustomerText', $ARGS[0]

    if $KitchenCustomerText <> '':
        *pl $KitchenCustomerText
    end
---

#KitchenCustomerText
    $KitchenCustomerTextId = LCASE($ARGS[0])
    $KitchenCustomerText = ''

    if $KitchenCustomerGirl = '':
        $KitchenCustomerGirl = 'amanda'
    end

    if $RealName[$KitchenCustomerGirl] = '':
        gs 'KitchenCustomerEnsureName', $KitchenCustomerGirl
    end

    if $KitchenCustomerTextId = 'intro':
        if $KitchenCustomerScene = 'bad_food':
            $KitchenCustomerText = 'С кухни доносится шумок. Посетитель держит миску и громко выражает недовольство похлёбкой. ' + $RealName[$KitchenCustomerGirl] + ' держит половник и спокойно выслушивает претензии, не торопясь уступать.'
        elseif $KitchenCustomerScene = 'wrong_order':
            $KitchenCustomerText = 'На кухню заходит недовольный гость и указывает на тарелку: «Я заказывал совсем другое!» ' + $RealName[$KitchenCustomerGirl] + ' сдерживает вздох, пытаясь уладить спор без шума.'
        elseif $KitchenCustomerScene = 'drunk_enters':
            $KitchenCustomerText = 'Подвыпивший клиент пробирается на кухню: «Красавица, у меня тут кое-какой вопрос... поможешь решить?» — и весьма недвусмысленно намекает на продолжение вечера.'
        elseif $KitchenCustomerScene = 'grab':
            $KitchenCustomerText = 'Посетитель заходит на кухню слишком уверенно. Он придерживает ' + $RealName[$KitchenCustomerGirl] + ' за талию у стола с мукой: «Не сердись, может, договоримся по-хорошему?»'
        elseif $KitchenCustomerScene = 'private_offer':
            $KitchenCustomerText = 'Зажиточный гость заглядывает на кухню и кладёт на стол монету: «Еда неплоха, но, может, обсудим кое-что получше?» Его предложение явно намекает на личную услугу.'
        elseif $KitchenCustomerScene = 'backdoor_deal':
            $KitchenCustomerText = 'Гость протискивается к задней двери кухни и тихо зовёт ' + $RealName[$KitchenCustomerGirl] + ' за мешки с мукой. На столе остаётся серебро, а предложенная тема далека от меню.'
        elseif $KitchenCustomerScene = 'pantry_corner':
            $KitchenCustomerText = 'Из кладовой доносится шорох. ' + $RealName[$KitchenCustomerGirl] + ' зашла за припасами, а следом увязался клиент. Дверь приоткрыта, но разговор там идёт явно не о крупе.'
        elseif $KitchenCustomerScene = 'satisfied_slap':
            $KitchenCustomerText = 'Довольный клиент заглядывает на кухню: «Вкусно готовите!» — и бесцеремонно шлёпает ' + $RealName[$KitchenCustomerGirl] + ' по заднице.'
        else:
            $KitchenCustomerText = 'На кухне начинается шум. Клиент чем-то недоволен, ' + $RealName[$KitchenCustomerGirl] + ' стоит напротив него, пытаясь уладить дело.'
        end

    elseif $KitchenCustomerTextId = 'thoughts':
        $KitchenCustomerText = 'На кухне всегда тесно и жарко. Любая наглость здесь воспринимается острее, чем в зале. Можно вмешаться и быстро навести порядок, можно дать ей самой решить вопрос — пусть учится держать грань с клиентами. А можно не мешать, если серебро важнее тишины.'

    elseif $KitchenCustomerTextId = 'stop':
        if $KitchenCustomerScene = 'satisfied_slap':
            $KitchenCustomerText = 'Вы вмешиваетесь до того, как ситуация разовьётся. Гость отступает. ' + $RealName[$KitchenCustomerGirl] + ' поправляет фартук: «Спасибо, Стефан. Иногда они забывают, где заканчивается зал».'
        elseif $KitchenCustomerScene = 'bad_food' or $KitchenCustomerScene = 'wrong_order':
            $KitchenCustomerText = 'Вы входите и спокойно решаете спор. Клиент получает замену без шума. ' + $RealName[$KitchenCustomerGirl] + ' выдыхает, возвращаясь к работе.'
        elseif $KitchenCustomerScene = 'drunk_enters' or $KitchenCustomerScene = 'grab' or $KitchenCustomerScene = 'backdoor_deal' or $KitchenCustomerScene = 'pantry_corner':
            $KitchenCustomerText = 'Вы подходите твёрдо и наглядно показываете клиенту дорогу в зал: «Руки при себе и на выход». ' + $RealName[$KitchenCustomerGirl] + ' отходит к печи, благодаря вас взглядом.'
        else:
            $KitchenCustomerText = 'Вы останавливаете наглеца до того, как монета решит слишком многое. Он морщится, но уходит в зал. ' + $RealName[$KitchenCustomerGirl] + ' видит, что хозяин держит порядок.'
        end

    elseif $KitchenCustomerTextId = 'let_her':
        if $KitchenCustomerScene = 'satisfied_slap':
            $KitchenCustomerText = $RealName[$KitchenCustomerGirl] + ' сдерживает смущение и сдержанно кивает клиенту: «Рада, что вам понравилось. Заказ примут в зале». Умение держать лицо сохраняет чаевые.'
        elseif KitchenCustomerStage <= 1:
            $KitchenCustomerText = $RealName[$KitchenCustomerGirl] + ' сама осаживает клиента — без лишнего шума, но с такой уверенностью, что тот предпочитает поскорее убраться обратно к своему столу.'
        elseif KitchenCustomerStage = 2:
            $KitchenCustomerText = $RealName[$KitchenCustomerGirl] + ' улаживает спор самостоятельно: где-то сгладит углы, где-то проявит твёрдость. Конфликт гаснет, а касса пополняется.'
        else:
            $KitchenCustomerText = $RealName[$KitchenCustomerGirl] + ' решает вопрос своими силами. Спокойно, без лишних свидетелей. Клиент возвращается в зал довольным, оставляя на столе хорошую монету.'
        end

    elseif $KitchenCustomerTextId = 'client':
        if KitchenCustomerStage <= 1:
            $KitchenCustomerText = 'Вы отступаете, и ' + $RealName[$KitchenCustomerGirl] + ' сама выкручивается из положения. Она справляется, но смотрит на вас с лёгким упрёком. Клиент доволен, а дело сделано.'
        elseif KitchenCustomerStage = 2:
            $KitchenCustomerText = 'Вы делаете вид, что заняты делами. ' + $RealName[$KitchenCustomerGirl] + ' улаживает вопрос мягче обычного — не спорит, позволяет клиенту почувствовать себя главным. Всё заканчивается тихо, и выручка растёт.'
        else:
            $KitchenCustomerText = 'Вы закрываете глаза на происходящее. ' + $RealName[$KitchenCustomerGirl] + ' отлично понимает правила. Через пару минут гость выходит с кухни довольный, а монета остаётся на столе. Касса растёт.'
        end
    else:
        $KitchenCustomerText = ''
    end

    killvar '$KitchenCustomerTextId'
---
