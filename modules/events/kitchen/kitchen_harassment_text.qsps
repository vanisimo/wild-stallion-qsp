! ================================================
! FILE: modules/events/kitchen/kitchen_harassment_text.qsps
! MODULE: events/kitchen
! USER-OWNED TEXT
! Тексты кухонных приставаний (Сандра)
! Используется: kitchen_harassment.qsps
! After-реакции зала; intro — hall_harassment_intro_text (Kitchen T1–T3)
! ================================================

#KitchenHarassmentPrintText
    gs 'KitchenHarassmentText', $ARGS[0]

    if $KitchenHarassmentText <> '':
        *pl $KitchenHarassmentText
    end
---

#KitchenHarassmentText
    $KitchenHarassmentTextId = LCASE($ARGS[0])
    $KitchenHarassmentText = ''

    if $KitchenHarassmentTextId = 'no_repeat':
        $KitchenHarassmentText = 'На кухне уже стихли споры. Сандра молча занята делом, а гости в зале вернулись к своим кружкам.'
    elseif $KitchenHarassmentTextId = 'closed':
        $KitchenHarassmentText = 'Таверна закрыта. На кухне пусто и темно — и тишина.'
    elseif $KitchenHarassmentTextId = 'entry_noise':
        $KitchenHarassmentText = 'С кухни доносится звон посуды, смех и спокойный голос Сандры — гостю явно дают понять, что он зашёл не туда.'
    elseif $KitchenHarassmentTextId = 'entry_chase':
        $KitchenHarassmentText = 'Из прохода вываливается подвыпивший гость, а за ним выходит Сандра. Она вытирает руки о фартук и просто указывает ему на дверь в зал.'
    elseif $KitchenHarassmentTextId = 'hall_reaction_ignore':
        $KitchenHarassmentText = 'За столами в зале переглядываются. Сцена угасла сама, но гости заметили, что хозяин предпочёл не вмешиваться.'
    elseif $KitchenHarassmentTextId = 'hall_reaction_watch':
        $KitchenHarassmentText = 'Несколько гостей отрываются от пива. Шум стих, но взгляды за столами всё ещё обращены к кухне.'
    elseif $KitchenHarassmentTextId = 'hall_reaction_watch_bad':
        $KitchenHarassmentText = 'За дальним столом кто-то хмыкает. Разговор на кухне вышел неловким, и зал это прочувствовал.'
    elseif $KitchenHarassmentTextId = 'hall_reaction_watch_lewd':
        $KitchenHarassmentText = 'По залу пробегает шёпот. Хозяин заметил происходящее на кухне, но предпочёл просто наблюдать со стороны.'
    elseif $KitchenHarassmentTextId = 'hall_reaction_protect':
        $KitchenHarassmentText = 'Шум на кухне быстро обрывается. Гость бурчит что-то под нос и возвращается за свой стол — хозяин чётко обозначил границы.'
    elseif $KitchenHarassmentTextId = 'hall_reaction_protect_fail':
        $KitchenHarassmentText = 'Разговор на кухне вышел слишком громким. В зале ещё какое-то время обсуждают возникший шум.'
    else:
        $KitchenHarassmentText = ''
    end

    killvar '$KitchenHarassmentTextId'
---
