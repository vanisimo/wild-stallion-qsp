! ================================================
! FILE: modules/events/kitchen/kitchen_lewd_sandra_text.qsps
! MODULE: events/kitchen
! STUB-тексты kitchen-lewd Сандры (канон design-hall-scene-unified)
! ================================================

#KitchenLewdPrintText
    $KitchenLewdTextId = LCASE($ARGS[0])
    $KitchenLewdText = ''

    if $RealName['sandra'] = '':
        $RealName['sandra'] = 'Сандра'
    end

    if $KitchenLewdTextId = 'intro':
        if $KitchenLewdScene = 'counter':
            if HallLewdStage >= 3:
                $KitchenLewdText = '[STUB K-LEWD counter/hard] Сандра наклоняется над разделочным столом дольше, чем нужно. Гость на кухне (не место ему) смотрит в вырез и на бёдра. Она не прогоняет — добивает зелень, будто нарочно.'
            else:
                $KitchenLewdText = '[STUB K-LEWD counter/soft] Сандра у стола. Посетитель забрёл «пожаловаться на еду». Она наклоняется — ткань натягивается. Не отшатывается сразу.'
            end
        elseif $KitchenLewdScene = 'waist':
            if HallLewdStage >= 3:
                $KitchenLewdText = '[STUB K-LEWD waist/hard] Рука гостя на бедре Сандры у плиты. Она не сбрасывает сразу — смотрит на него тяжёлым взглядом, потом на дверь в зал, будто спрашивает, где хозяин.'
            else:
                $KitchenLewdText = '[STUB K-LEWD waist/soft] Клиент касается талии Сандры «случайно». Она замирает, губы сжаты — ещё не бьёт, уже не отходит.'
            end
        elseif $KitchenLewdScene = 'corner':
            if HallLewdStage >= 3:
                $KitchenLewdText = '[STUB K-LEWD corner/hard] В углу у бочек Сандра и гость слишком близко. Её грудь колышется от жара плиты; он шепчет — она не улыбается, но и не гонит.'
            else:
                $KitchenLewdText = '[STUB K-LEWD corner/soft] Сандра у двери кладовой. Гость прижал её почти к стене. Пока только разговор и рука на локте — но кухня не для гостей.'
            end
        elseif $KitchenLewdScene = 'lap':
            $KitchenLewdText = '[STUB K-LEWD lap/hard] Сандра оказывается у клиента на коленях на табурете у стола. Жар, пар, смех из зала. Она не выглядит девчонкой — тяжёлая, взрослая, и всё ещё не встаёт.'
        elseif $KitchenLewdScene = 'face_fall':
            $KitchenLewdText = '[STUB K-LEWD face_fall/hard] У плиты Сандра теряет равновесие — гость «ловит» так, что на миг её лицо у его паха. Она поднимается медленно, без крика, взгляд холодный.'
        else:
            $KitchenLewdText = '[STUB K-LEWD] scene=' + $KitchenLewdScene + ' — Сандра на кухне слишком близко к клиенту.'
        end

    elseif $KitchenLewdTextId = 'stop':
        $KitchenLewdText = '[STUB K-LEWD stop] Вы обрываете. Сандра отходит, поправляет платье. Благодарности мало — скорее злость: «Сам пустил, сам орёшь».'
    elseif $KitchenLewdTextId = 'watch':
        $KitchenLewdText = '[STUB K-LEWD watch] Вы стоите в проходе и смотрите. Сандра это чувствует. Не краснеет — каменеет и продолжает на своих условиях.'
    elseif $KitchenLewdTextId = 'ignore':
        $KitchenLewdText = '[STUB K-LEWD ignore] Вы отворачиваетесь к залу. На кухне остаётся жар, шёпот и звяканье монеты. Завтра слух дойдёт быстрее похлёбки.'
    else:
        $KitchenLewdText = '[STUB K-LEWD] id=' + $KitchenLewdTextId
    end

    if $KitchenLewdText <> '':
        *pl $KitchenLewdText
    end

    killvar '$KitchenLewdTextId'
    killvar '$KitchenLewdText'
---
