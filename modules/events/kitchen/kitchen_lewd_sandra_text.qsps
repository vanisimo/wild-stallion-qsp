! ================================================
! FILE: modules/events/kitchen/kitchen_lewd_sandra_text.qsps
! MODULE: events/kitchen
! USER-OWNED TEXT
! Тексты kitchen-lewd Сандры (канон design-hall-scene-unified)
! ================================================

#KitchenLewdPrintText
    $KitchenLewdTextId = LCASE($ARGS[0])
    $KitchenLewdText = ''

    if $RealName['sandra'] = '':
        $RealName['sandra'] = 'Сандра'
    end

    if $KitchenLewdTextId = 'intro':
        if $KitchenLewdScene = 'counter':
            if HallLewdStage >= 3:
                $KitchenLewdText = 'Сандра наклоняется над разделочным столом, нарезая зелень. Назойливый гость заглядывает на кухню и открыто разглядывает её вырез и бёдра. Она не прогоняет его сразу, продолжая работу.'
            else:
                $KitchenLewdText = 'Сандра занята у разделочного стола. Посетитель зашёл якобы узнать про заказ и нагло рассматривает её. Она замечает взгляд, но держится спокойно, не отшатываясь.'
            end
        elseif $KitchenLewdScene = 'waist':
            if HallLewdStage >= 3:
                $KitchenLewdText = 'Ладонь гостя уверенно ложится Сандре на бедро у плиты. Она не сбрасывает её мгновенно — лишь тяжело смотрит на него, а затем бросает взгляд в сторону зала.'
            else:
                $KitchenLewdText = 'Посетитель касается талии Сандры у печи. Она замирает у котелка, сжимая губы — не устроит скандала, но и прощения наглости не обещает.'
            end
        elseif $KitchenLewdScene = 'corner':
            if HallLewdStage >= 3:
                $KitchenLewdText = 'В углу у бочек с запасами гость оказывается слишком близко к Сандре. Она не улыбается и не кокетничает, но и прогонять его в зал не спешит.'
            else:
                $KitchenLewdText = 'Сандра достаёт крупу у кладовой, когда гость прижимает её к полкам. Она спокойно упирается ладонью ему в грудь, удерживая дистанцию.'
            end
        elseif $KitchenLewdScene = 'lap':
            $KitchenLewdText = 'Сандра оказывается силой усажена на колени к гостю на табурет. На кухне жарко от печи, из зала доносится гул. Сандра сохраняет спокойствие, не устраивая сцен, но поднимается при первой возможности.'
        elseif $KitchenLewdScene = 'face_fall':
            $KitchenLewdText = 'Сандра оступается у плиты, и гость подхватывает её, отчего она на миг опускается к нему на пах. Она быстро выпрямляется, молча поправляя фартук.'
        else:
            $KitchenLewdText = 'На кухне гость находится слишком близко к Сандре, пользуясь теснотой у печи.'
        end

    elseif $KitchenLewdTextId = 'stop':
        $KitchenLewdText = 'Вы вмешиваетесь и пресекаете вольности. Сандра отходит к плите, поправляя фартук: «Вовремя. Но в следующий раз помни, что я и сама могу за себя постоять».'
    elseif $KitchenLewdTextId = 'watch':
        $KitchenLewdText = 'Вы остаётесь в проходе и наблюдаете со стороны. Сандра замечает ваш взгляд — не смущается, лишь продолжает работать в привычном темпе.'
    elseif $KitchenLewdTextId = 'ignore':
        $KitchenLewdText = 'Вы отворачиваетесь к залу. На кухне продолжается разговор под шум кипящего котла и звон монет.'
    else:
        $KitchenLewdText = ''
    end

    if $KitchenLewdText <> '':
        *pl $KitchenLewdText
    end

    killvar '$KitchenLewdTextId'
    killvar '$KitchenLewdText'
---
