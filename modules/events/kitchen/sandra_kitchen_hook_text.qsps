        gs 'SandraKitchenHarassAllowCheck'
    else:
        SandraKitchenHarassAllow = 0
    end
    if SandraKitchenHarassAllow = 1 or $SandraKitchenBeat = 'play':
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Вскоре моряк отпускает её, довольно хмыкает и выскальзывает в зал, поправляя пояс. Сандра одёргивает передник, стучит половником по котлу и возвращается к плите.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl 'Мастеровой прощально хлопает её по попе и уходит, бормоча «до завтра». Сандра поправляет передник и принимается мешать в котле, будто ничего не было.'
        else:
            *pl 'Купец довольно кивает, убирает полегчавший кошель и выскальзывает в зал. Сандра одёргивает передник, стучит половником по краю котла — сделка закрыта.'
        end
    else:
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Моряк ворчит, поправляет куртку и пятится к двери под угрозой поварёшки. Сандра одёргивает передник и возвращается к плите.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl 'Мастеровой бурчит под нос и убирается в зал. Сандра опускает поварёшку, поправляет передник и снова берётся за готовку.'
        else:
            *pl 'Купец поправляет кафтан и уходит в зал с пустыми руками. Сандра стучит половником по котлу — разговор окончен.'
        end
    end
    killvar '$c'
