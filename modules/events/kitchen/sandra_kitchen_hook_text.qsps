! ================================================
! FILE: modules/events/kitchen/sandra_kitchen_hook_text.qsps
! MODULE: events/kitchen
! Prose: notice / уговор client×beat / harass watch / escalate / offscreen / protect
! Уговор: ОДИН каркас на client; тон = harass | missing (R5)
! ================================================

#SandraKitchenPrintNotice
    *pl 'Вы окидываете зал привычным взглядом хозяина — и замечаете, как ' + $HallLewdClientWho + ' открывает кухонную дверь и проходит внутрь, туда, где у плиты работает Сандра.'
    *pl ' '
    *pl 'Дверь не хлопнула: из кухни доносится пар, звон миски… и уже не совсем рабочий тон голоса. Можно пройти следом к двери — или сделать вид, что хозяин занят залом.'
---

#SandraKitchenPrintBargain
    $c = LCASE($SandraKitchenClient)
    HallMissingBargainRefused = 0

    if $c = 'drunk_guest' or $c = 'drunk':
        HallMissingBargainRefused = 1
        *pl 'Пьяный горожанин уже у печи, дышит перегаром и тянется к Сандре руками:'
        *pl '— Э-эй, хозяйка… дай обниму, чё ты кастрюлями гремишь…'
        *pl ' '
        if GirlWorkPolicy['sandra'] = 3:
            *pl '— Проспись и вали с кухни, — жёстко цедит Сандра. — Протрезвеешь — тогда и порог перешагивай. А сейчас — марш.'
        else
            *pl '— Пошёл вон, пьянчуга! Ещё шаг — поварёшкой по лбу! — Сандра выталкивает его к занавеске.'
        end
        *pl ' '
        *pl 'Гость ругается и вываливается обратно в сторону зала. Уговора нет.'
        killvar '$c'
        exit
    end

    ! play = уговор «подыгрывание/уединение»; harass = щупать у печи (без play)
    if $SandraKitchenBeat = 'play':
        gs 'SandraKitchenPrintBargainPlay'
    else
        gs 'SandraKitchenPrintBargainHarass'
    end
    killvar '$c'
---

! play-тон (после PlayCoached Сандра↔Бекки): уединение/ласка, не hard-минет-меню
#SandraKitchenPrintBargainPlay
    $c = LCASE($SandraKitchenClient)
    if $c = 'traveler' or $c = 'sailor':
        *pl 'Моряк припирает Сандру к ларю у печи, уже расстёгивая пояс. Голос сиплый, без шуток «просто потрогать»:'
        *pl '— На кухне тихо, хозяйка. Серебро на стол — и уединимся. Ласка по-честному, без зала.'
        *pl ' '
        if HallMissingBargainExplicit = 1 or HallMissingFlagMouthMature['sandra'] = 1:
            *pl '— Монету — и заткнись, — ровно бросает Сандра. — Только не ори, а то вылетишь без штанов.'
        else
            *pl '— Тс-с… Позорник. Монету на край — и без рыка. Я не в портовом кабаке.'
        end
    elseif $c = 'craftsman' or $c = 'local':
        *pl 'Мастеровой упирается ладонью в стол, другой — у Сандры на талии, свойски и уже без «просто шлёпнуть»:'
        *pl '— Сандра, хватит кастрюль. Серебро не жалко — давай у печи, по-тихому, как умеешь.'
        *pl ' '
        if HallMissingBargainExplicit = 1 or HallMissingFlagMouthMature['sandra'] = 1:
            *pl '— Сосед… Ладно. Монету — и молчи. Без гвалта.'
        else
            *pl '— Охальник… Монету положи. И тихо — из залы не услышат.'
        end
    else
        *pl 'Купец кладёт кошель на край печи и не отводит глаз от Сандры:'
        *pl '— Хозяйка, заказ не на рагу. Уединение. Ласка за полновесное серебро. Зал не узнает.'
        *pl ' '
        if HallMissingBargainExplicit = 1 or HallMissingFlagMouthMature['sandra'] = 1:
            *pl '— Деньги на стол. Дальше — без крика, купец.'
        else
            *pl '— Бесстыдник… Монету — и ни слова лишнего, пока не кончишь торговаться.'
        end
    end
    killvar '$c'
---

! R5 harass-тон: щупать у печи, БЕЗ минета в уговоре
! resist / liberation=0 / обида — НЕ разрешает гладить; endure/policy3 — уговор
#SandraKitchenPrintBargainHarass
    $c = LCASE($SandraKitchenClient)
    if LOC('SandraKitchenHarassAllowCheck') = 1:
        gs 'SandraKitchenHarassAllowCheck'
    else
        SandraKitchenHarassAllow = 0
    end

    if GirlOffenseDays['sandra'] > 0:
        HallMissingBargainRefused = 1
        *pl 'Гость тянется к Сандре у печи — и тут же отскакивает: она уже с поварёшкой.'
        *pl ' '
        *pl '— А ну вон с кухни! Сегодня я и так сама не своя. Руки при себе, пока лоб цел.'
        *pl ' '
        *pl 'Гость ругается и вываливается к залу. Уговора нет.'
        killvar '$c'
        exit
    end

    if $c = 'traveler' or $c = 'sailor':
        *pl 'Моряк прижимает Сандру к каменной стене кухни, ладонь — на бедре, голос сиплый:'
        *pl '— К чёрту кастрюли. Дай пощупать, хозяйка — от тебя жаром пышет. Серебро не скупое.'
        *pl ' '
        if SandraKitchenHarassAllow = 1:
            *pl '— Т-тише, полоумный… Монету на стол. Руки — только где разрешу. И тихо.'
        else
            *pl 'Сандра выхватывает поварёшку и со всей силы отталкивает его ладонь:'
            *pl '— А ну руки убрал, полоумный! Я тебе не портовая девка. Пошёл в зал, пока лоб не треснул.'
        end
    elseif $c = 'craftsman' or $c = 'local':
        *pl 'Мастеровой прижимается пахом сзади у очага, руки лезут под подол — свойский натиск:'
        *pl '— Сандра, хватит печь греть. Дай подержать, погладить — у мастера руки дело знают.'
        *pl ' '
        if SandraKitchenHarassAllow = 1:
            *pl '— Сосед… Ладно, коли так припёрло. Быстро и без гвалта — а то поварёшкой по лбу.'
        else
            *pl 'Сандра скидывает его ладони и разворачивается с поварёшкой:'
            *pl '— А ну убрал лапы, сосед! Я тебе не девка на поглаживание. Пошёл вон с кухни — ещё шаг, и лоб тресну.'
        end
    else
        *pl 'Купец ловит запястье Сандры у печи и тянет её ладонь себе на штаны:'
        *pl '— За обед — отдельная плата, хозяйка. Подержи, успокой. Серебро полновесное.'
        *pl ' '
        if SandraKitchenHarassAllow = 1:
            *pl '— Купец… Деньги на ящик. И без крика — кухня не сцена для зала.'
        else
            *pl 'Сандра выдёргивает руку и хлопает ковшом по краю стола:'
            *pl '— Руки у меня для котла, не для твоих штанов! Серебро — на стойке. А сам — в зал, пока я по-доброму.'
        end
    end
    killvar '$c'
---

#SandraKitchenPrintProtect
    *pl 'Вы резко открываете дверь и громко окликаете. Гость вздрагивает, матерится и спешит в зал, оправляя штаны.'
    *pl ' '
    if LOC('HallMissingInterruptAfter_sandra') = 1:
        gs 'HallMissingInterruptAfter_sandra'
    elseif LOC('HallMissingInterrupt_sandra') = 1:
        gs 'HallMissingInterrupt_sandra'
    else
        *pl 'Сандра поправляет передник, утирает испарину и сухо бросает:'
        *pl '— Зачем пришёл? Рагу на плите чуть не пригорело! Пошёл бы лучше за посетителями в зале приглядел...'
    end
---

#SandraKitchenPrintHarassWatch
    $c = LCASE($SandraKitchenClient)
    if $SandraKitchenBeat = 'play':
        *pl 'Вы остаётесь у щели. На кухне уже не «отстань» — Сандра подыгрывает: подаёт бёдрами, ловит монету, шипит «тише», но не сбрасывает руки ' + $HallLewdClientWhoA + '.'
        *pl ' '
        if $c = 'craftsman' or $c = 'local':
            *pl '— Вот так, хозяйка… у плиты тоже можно, — свойски хрипит мастеровой. Сандра фыркает, но подаётся ближе к столу, будто помнит чужой совет «есть чем покрутить».'
        elseif $c = 'rich_merchant' or $c = 'merchant':
            *pl 'Купец мнёт талию, шепчет про заказ. Сандра цедит «серебро на стол» — и сама чуть разворачивается, чтобы ему было удобнее смотреть и трогать.'
        else
            *pl 'Гость шлёпает по юбке; Сандра шипит, но не отталкивает — только смотрит на занавеску, не выглянет ли кто из зала.'
        end
        *pl ' '
        *pl 'Это play у печи: ещё не полное уединение missing, но уже не простое приставание.'
    else
        if LOC('SandraKitchenHarassAllowCheck') = 1:
            gs 'SandraKitchenHarassAllowCheck'
        else
            SandraKitchenHarassAllow = 0
        end
        if SandraKitchenHarassAllow = 1:
            *pl 'Вы остаётесь у щели занавески. На кухне ' + $HallLewdClientWho + ' не стесняется: ладони под юбкой Сандры, шлепок по бедру, сиплый смех у печи.'
            *pl ' '
            if $c = 'traveler' or $c = 'sailor':
                *pl '— Вот так, хозяйка… горячая, — бормочет моряк, мня бедро. Сандра шипит «тише» и не отталкивает сразу — только держит ритм, чтобы кастрюля не упала.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Мастеровой шлёпает по юбке ещё раз, грубо и свойски. Сандра ругается вполголоса, но подаётся — монета на краю стола уже звенит.'
            else
                *pl 'Купец мнёт талию и ниже, шепчет про «особый заказ». Сандра цедит сквозь зубы, но ладонь гостя не сбрасывает — смотрит на кошель.'
            end
            *pl ' '
            *pl 'Обычное приставание. До play (подслушивание Бекки) и missing отсюда пути нет.'
        else
            *pl 'Вы остаётесь у щели занавески. На кухне ' + $HallLewdClientWho + ' не унимается, но Сандра уже не даёт: ловит запястья, отталкивает бедром, поварёшка наготове.'
            *pl ' '
            if $c = 'traveler' or $c = 'sailor':
                *pl '— Руки, сказала! — шипит она. Моряк ещё тянется к бедру, она бьёт его по пальцам краем ковша.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Мастеровой тянется под подол снова. Сандра разворачивается и тычет его поварёшкой в грудь: — В зал, сосед. Пока по-доброму.'
            else
                *pl 'Купец тянет кошель. Сандра не смотрит на монеты: — Серебро на стойке. Руки — при себе.'
            end
            *pl ' '
            *pl 'Приставание без уговора. До play (подслушивание Бекки) и missing отсюда пути нет.'
        end
    end
    killvar '$c'
---

#SandraKitchenPrintHarassEnd
    if LOC('SandraKitchenHarassAllowCheck') = 1:
        gs 'SandraKitchenHarassAllowCheck'
    else
        SandraKitchenHarassAllow = 0
    end
    if SandraKitchenHarassAllow = 1 or $SandraKitchenBeat = 'play':
        *pl 'Вскоре гость отпускает её, довольно хмыкает и выскальзывает в зал, поправляя пояс. Сандра одёргивает передник, хлопает половником по котлу — будто ничего не было — и возвращается к плите.'
    else
        *pl 'Гость бурчит, оправляет кафтан и пятится в зал — поварёшка Сандры не оставляет выбора. Она одёргивает передник, хлопает половником по котлу и возвращается к плите, будто никто не смел лезть.'
    end
---

! α play→missing: 1–2 реплики-мост (не полный уговор)
#SandraKitchenPrintEscalateBridge
    *pl 'Заигрывание у печи не заканчивается на шлепке. ' + $HallLewdClientWho + ' звенит монетой громче, голос ниже:'
    *pl ' '
    *pl '— Раз уж ты не против, хозяйка… ещё серебра — и по-настоящему, за занавеской. Зал не увидит.'
    *pl ' '
    if HallMissingFlagMouthMature['sandra'] = 1 or HallMissingBargainExplicit = 1:
        *pl '— …Чёрт с тобой, — сипло выдыхает Сандра. — Монету докинь. И тихо, слышишь?'
    else
        *pl '— Ты совсем… — она смотрит на дверь, на котёл, на монету. — Ладно. Докинь. И ни звука.'
    end
    *pl ' '
    *pl 'Play переходит в missing. Если останетесь у щели — увидите сцену целиком.'
---

#SandraKitchenPrintOffscreen
    *pl 'Вы остаётесь в зале. К кухне не идёте — только слух режет привычный шум таверны.'
    *pl ' '
    if $SandraKitchenBeat = 'play':
        *pl 'Из-за занавески — смешок, шлепок, сиплый «тише ты…», звяканье монеты. Похоже, Сандра не просто отбивается.'
        *pl ' '
        *pl 'Минут через пять ' + $HallLewdClientWho + ' выходит довольнее обычного. Missing-сцены вы не видели — лесенка не сдвинулась.'
    else
        *pl 'Слышны шлепки по ткани, мужской смешок, голос Сандры — то шипение, то короткая брань.'
        *pl ' '
        if RAND(1, 100) <= 55:
            *pl 'Вскоре ' + $HallLewdClientWho + ' появляется с ухмылкой и заказывает ещё кружку, будто сходил «просто к плите».'
        else
            *pl 'Раздаётся окрик Сандры — и ' + $HallLewdClientWho + ' вылетает с кухни с красными ушами.'
        end
    end
---
