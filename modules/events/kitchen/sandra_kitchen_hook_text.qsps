! α play→missing: 1–2 реплики-мост (не полный уговор; уговор уже на Follow)
! «на большее» — уединение / ласка; не меню минета в тексте уговора (расширение — в Scene)
#SandraKitchenPrintEscalateBridge
    $c = LCASE($SandraKitchenClient)
    *pl $HallLewdClientWho + ' звенит спринтриями громче, перекрывая шипение масла, и наклоняется к самому уху Сандры:'
    *pl ' '
    if $c = 'traveler' or $c = 'sailor':
        *pl '— Ещё три спринтрии, хозяйка, и забудь про этот чёртов котёл. За печь, а то в ушах шумит от отлившей крови. Зал шумит, никто не хватится.'
    elseif $c = 'craftsman' or $c = 'local':
        *pl '— Ещё монету сверху — и отойдём за печь по-тихому. В зале пьют, им дела нет.'
    else:
        *pl '— Ещё серебра — отойдём в угол. Чтобы без спешки.'
    end
    *pl ' '
    *pl 'Сандра выдерживает паузу, глядя на монеты.'
    if HallMissingFlagMouthMature['sandra'] = 1 or HallMissingBargainExplicit = 1:
        *pl '— Дай сюда и не шуми, — голос у неё сиплый, но решительный. — Если хоть звук лишний — вылетишь со спущенными портками в зал.'
    else:
        *pl '— А давай, — она шумно выдыхает, поправляет выбившуюся прядь и кивает за печь. — Только тихо. Люди в зале, за дверью.'
    end
    killvar '$c'
