! H3 ignore / notice-ignore — только слух за дверью
#SandraKitchenPrintOffscreen
    $c = LCASE($SandraKitchenClient)
    *pl 'Ты прикрываешь дверь плотнее, оставшись снаружи. Ладонь ложится на тёплое дерево. Изнутри — шорох ткани, стук поставленного половника и сдавленный выдох Сандры.'
    *pl ' '
    if $SandraKitchenBeat = 'play':
        if $c = 'traveler' or $c = 'sailor':
            *pl 'За дверью глухой удар, скрип половиц, звон монет о стол и её приглушённое шипение: «Тише ты, весь трактир услышит».'
        elseif $c = 'craftsman' or $c = 'local':
            *pl 'За дверью короткая возня, свойский смешок, шлепок по ткани и полушёпот Сандры: «Стой, не рви… я сама».'
        else:
            *pl 'За дверью тихий звон серебра, низкий голос купца, сдержанный вскрик Сандры и её быстрое: «Торопись, а то что-то в зале притихли».'
        end
    else:
        if LOC('SandraKitchenHarassAllowCheck') = 1:
            gs 'SandraKitchenHarassAllowCheck'
        else:
            SandraKitchenHarassAllow = 0
        end
        if SandraKitchenHarassAllow = 1:
            if $c = 'traveler' or $c = 'sailor':
                *pl 'Сквозь дверь — его хриплый смех, шлепки и её твёрдое: «Только сверху, я сказала». Звон монеты и кряхтенье.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Ты слышишь, как он шумно сопит, шлепки и её резкое: «Руки не распускай». Короткая возня и стук крышки.'
            else:
                *pl 'Из-за двери — его вкрадчивый шёпот, её спокойное «монету на стол, купец» и звяканье серебра.'
            end
        else:
            if $c = 'traveler' or $c = 'sailor':
                *pl 'Грохот опрокинутого табурета, злобное шипение моряка и полный ярости голос Сандры: «Пошёл вон, пока я тебя ковшом не огрела!» Быстрые шаги к двери.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Звонкий шлепок по руке, его удивлённый вскрик и её голос, не терпящий возражений: «Убирайся в зал, сосед, пока Ильматера не призвала в свидетели!»'
            else:
                *pl 'Резкий стук ковша о стол и сухой окрик: «Я сказала — нет!» Звук отодвинутого стула, торопливые извинения купца и шаги к выходу.'
            end
        end
    end
    killvar '$c'
