! H3 watch — подсмотр (play / harass allow / resist) × 3 клиента
#SandraKitchenPrintHarassWatch
    $c = LCASE($SandraKitchenClient)
    if $SandraKitchenBeat = 'play':
        *pl 'Ты не уходишь. Припадаешь плечом к косяку, глядя в узкую щель. В мареве над плитой Сандра уже не отбивается. Бедро само ложится в ладонь ' + $HallLewdClientWhoA + ', голова чуть откинута. Слышно, как звякает монета, падая в карман её передника, и её сиплое: «Тише ты, весь трактир услышит».'
        *pl ' '
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Моряк притиснул её к краю стола, ладонь шлёпает по плотной юбке, сминая ткань. Сандра кусает губу и косится на дверь, но не отталкивает. Её рука с половником замирает над кастрюлей.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl 'Мастеровой осмелел вконец: одна рука лезет под передник, вторая сжимает ягодицу. Он шепчет ей в шею по-свойски. Сандра фыркает, но сама подаётся ближе к столу, чтобы звон спринтрий был слышнее.'
        else:
            *pl 'Купец мнёт её талию, пальцы перебирают складки юбки. Губы почти касаются её уха, шепчут про «особый заказ». Сандра, не оборачиваясь, чуть разворачивает бёдра, чтобы его ладони было удобнее. Кошель с серебром лежит рядом с миской.'
        end
    else:
        if LOC('SandraKitchenHarassAllowCheck') = 1:
            gs 'SandraKitchenHarassAllowCheck'
        else:
            SandraKitchenHarassAllow = 0
        end
        if SandraKitchenHarassAllow = 1:
            *pl 'Ты замираешь у щели. ' + $HallLewdClientWho + ' уже не церемонится: юбка приподнята, ладони шарят по попе, слышен сдавленный смешок. Сандра не выгоняет, но и многого не позволяет — спина прямая, а голос твердый: «Руками потрогай — большего не проси».'
            *pl ' '
            if $c = 'traveler' or $c = 'sailor':
                *pl 'Моряк жадно мнёт её попку и хвалит вполголоса. Сандра шипит на него, но одной рукой продолжает мешать варево, а другой лишь слегка придерживает его запястье, не давая залезть под юбку.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Ещё один шлепок, уже громче. Мастеровой смеётся в усы. Сандра ругается сквозь зубы, но на краю стола блестит ещё одна монета — она не отталкивает его, лишь крепче сжимает черенок половника.'
            else:
                *pl 'Купец мнёт талию и тянется ладонью ниже. Сандра цедит сквозь зубы, глядя не на него, а на раскрытый кошель. Её рука ложится поверх его ладони — не сбрасывает, а даёт понять цену.'
            end
        else:
            *pl 'Ты видишь, как ' + $HallLewdClientWho + ' тянет к ней руки, но Сандра сегодня не в духе. Движения резкие и чёткие. Она перехватывает чужое запястье, толкает бедром, и в её пальцах опасно покачивается поварёшка.'
            *pl ' '
            if $c = 'traveler' or $c = 'sailor':
                *pl 'Моряк тянется снова — Сандра без замаха коротко бьёт его краем ковша по костяшкам. Звук — сухой треск. Моряк одёргивает руку, матерясь вполголоса.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Мастеровой лезет под подол, не чувствуя границ. Сандра резко разворачивается, и тупой конец поварёшки упирается ему в грудь. Она молча кивает в сторону зала.'
            else:
                *pl 'Купец трясёт кошелем перед её носом, уговаривая. Сандра не ведётся — её ладонь жёстко перехватывает его руку: «Серебро на стойку. А здесь я решаю, кому что трогать».'
            end
        end
    end
    killvar '$c'
