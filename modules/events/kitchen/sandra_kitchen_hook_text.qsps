! R5 harass-тон: щупать у печи, БЕЗ минета в уговоре
! resist / liberation=0 / обида — НЕ разрешает гладить; endure/policy3 — уговор
#SandraKitchenPrintBargainHarass
    $c = LCASE($SandraKitchenClient)
    if LOC('SandraKitchenHarassAllowCheck') = 1:
        gs 'SandraKitchenHarassAllowCheck'
    else:
        SandraKitchenHarassAllow = 0
    end

    if GirlOffenseDays['sandra'] > 0:
        HallMissingBargainRefused = 1
        *pl 'Сандра злая — месит тесто так, будто бьёт кого-то. Гость подходит сзади, тянет руку:'
        *pl '— Хозяйка, а сколько у тебя…'
        *pl 'Она разворачивается с поварёшкой наотмашь, не слушая:'
        *pl '— Сколько? Вот столько! Ходи отсюда! Быстро, пока я тебя этой кастрюлей не отходила — иди и радуйся, что я сегодня добрая!'
        *pl ' '
        *pl 'Гость пятится и исчезает в зале.'
        killvar '$c'
        exit
    end

    if SandraKitchenHarassAllow = 0:
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Моряк прижимает Сандру к каменной стене, лезет рукой к бедру:'
            *pl '— Не ломайся, пышка. У меня спринтрии есть.'
            *pl 'Сандра отбивает его лапу поварёшкой — хлёстко:'
            *pl '— Сам ты пышка, я хоть и троих родила, но талия на месте. Я тебе не портовая девка, морячок. Пошёл в зал, пока я тебе не отбила что-нибудь.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl 'Мастеровой по-свойски прижимается сзади, лезет под подол:'
            *pl '— Сандра, ну чего ты… свои же…'
            *pl 'Она скидывает его руки и разворачивается:'
            *pl '— Свои — так и веди себя прилично! А то получишь по лбу, и пойдёшь к жене с синяком. За дверь, сосед!'
        else:
            *pl 'Купец ловит запястье Сандры и тянет её руку себе на штаны:'
            *pl '— Подержи, красавица. Полновесные спринтрии — не обижу.'
            *pl 'Сандра выдёргивает руку и звонко бьёт ковшом:'
            *pl '— Свои деньги на стойку неси! А руки держи при себе, пока я их тебе не отбила.'
        end
        killvar '$c'
        exit
    end

    ! SandraKitchenHarassAllow = 1 — живой торг у печи по уровню коррупции
    if FamilyCorruptionStage >= 4:
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Моряк только суётся в дверь, а Сандра уже подбоченилась у печи, откровенно оглядывая гостя:'
            *pl '— Чего топчешься, морячок? Раз зашёл на кухню — не хочешь потрогать? Или думаешь, я тут зря тесёмки распустила?'
            *pl '— Вот это разговор! — скалится он, выкладывая спринтрии.'
            *pl 'Она прячет монеты и чуть прогибается к столу: — Давай, не тяни. Пока заказов немного.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl '— Опять без дела трёшься, соседушка? — Сандра встречает мастерового, уперев руки в бока. — Раз зашёл — подойди ближе. Но сначала кошель покажи, я за спасибо не даюсь.'
            *pl 'Мастеровой широко ухмыляется, высыпая спринтрии на разделочный стол:'
            *pl '— Да у тебя на всё цена есть, хозяйка!'
            *pl '— Ещё бы, — фыркает она, подставляя бедро. — Ну, чего застыл? Времени немного, кухня на мне.'
        else:
            *pl 'Купец входит на кухню, а Сандра сама тянется к его поясу, прикидывая вес кошеля:'
            *pl '— Полновесные. Люблю солидных мужчин. Раз уж заглянул, купец — не хочешь пощупать хозяйку?'
            *pl '— Умеешь ты уговаривать, Сандра, — сглотнул он, отсчитывая монеты.'
            *pl '— А чего тянуть? — она прячет серебро. — Клади руки, только не наглей.'
        end

    elseif FamilyCorruptionStage >= 2:
        if $c = 'traveler' or $c = 'sailor':
            *pl '— Мне бы чего погорячее, хозяйка, — моряк прислоняется к притолоке, звякнув спринтриями в кармане.'
            *pl '— Горячее — только угли в печи, — отвечает она, но взгляд спокойно скользит к монетам. — Клади на стол, если пощупать охота.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl '— Сандра, душа моя, с каждым днём ты всё аппетитнее, — мастеровой подмигивает, кладя монеты на край стола. — Дай хоть потрогать, пока зал не глядит.'
            *pl '— За просмотр и ласку — плата вперёд, сосед, — хмыкает она, не отходя от плиты.'
        else:
            *pl 'Купец ловит запястье Сандры и кивает на свой кошель:'
            *pl '— За обед — отдельная плата, хозяйка. Удели минуту.'
            *pl '— Давай сюда, — спокойно отвечает она, не сильно ломаясь.'
        end
        *pl ' '
        gs 'SandraKitchenPrintMidGesture'
        *pl ' '
        *pl '— Только быстро и без шума — все же кухня.'

    else:
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Моряк подпирает косяк, поигрывая в пальцах парой спринтрий. Сандра стоит к нему вполоборота, яростно трёт и без того чистый стол:'
            *pl '— Мне бы чего погорячее, пока твоя стряпня доспеет, — хмыкает он.'
            *pl '— У меня обед на плите, — она хмурится, но взгляд цепляется за серебро.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl '— Сандра, согрей соседа, пока дочки не видят! — мастеровой ставит пустую кружку на стол и подмигивает.'
            *pl '— Тише ты, дурень! — шипит она, схватывая его за рукав и отводя подальше от прохода.'
        else:
            *pl 'Купец вальяжно осматривает кухню и выкладывает на стол несколько тяжёлых спринтрий. Сандра вытирает руки о передник, стараясь унять дрожь в пальцах:'
            *pl '— Вы, я погляжу, не за похлёбкой.'
            *pl '— За той красотой, что в зале не подают, — улыбается он уголком рта.'
        end
        *pl ' '
        gs 'SandraKitchenPrintLowExcuse'
        *pl ' '
        *pl '— Только недолго, — шепчет она, сжимая край передника. — Ильматер видит, деньги не помешают.'
    end

    killvar '$c'
