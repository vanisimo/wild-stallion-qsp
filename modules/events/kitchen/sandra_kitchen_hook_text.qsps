! ================================================
! FILE: modules/events/kitchen/sandra_kitchen_hook_text.qsps
! MODULE: events/kitchen
! Prose kitchen hook: H1 notice → H2 уговор → H3 действие → H4 после + policy
! Уговор: ОДИН каркас на client; тон = harass | play (R5)
! Место: дверь кухни / у печи (НЕ занавеска)
! Клиенты: traveler · craftsman · rich_merchant · drunk отказ
! ================================================

#SandraKitchenPrintNotice
    *pl 'Вы замечаете, как ' + $HallLewdClientWho + ' стоит у кухонной двери и уже кладёт руку на скобу.'
    *pl ' '
    *pl 'Дверь не хлопнула до конца: из кухни — пар, звон миски и голос, который к готовке уже не относится.'
---

#SandraKitchenPrintBargain
    $c = LCASE($SandraKitchenClient)
    HallMissingBargainRefused = 0

    if $c = 'drunk_guest' or $c = 'drunk':
        HallMissingBargainRefused = 1
        *pl 'Пьяный горожанин уже у печи, дышит перегаром и тянется к Сандре руками:'
        *pl '— Э-эй, хозяйка… дай обниму, чё ты кастрюлями гремишь…'
        *pl ' '
        if GirlWorkPolicy['sandra'] = 3:
            *pl '— Проспись и вали с кухни, — жёстко цедит Сандра. — Протрезвеешь — тогда и порог перешагивай. А сейчас — марш.'
        else
            *pl '— Пошёл вон, пьянчуга! Ещё шаг — поварёшкой по лбу! — Сандра выталкивает его к кухонной двери.'
        end
        *pl ' '
        *pl 'Гость ругается и вываливается обратно в сторону зала. Уговора нет.'
        killvar '$c'
        exit
    end

    ! play = уговор «подыгрывание/уединение»; harass = щупать у печи (без play)
    if $SandraKitchenBeat = 'play':
        gs 'SandraKitchenPrintBargainPlay'
    else
        gs 'SandraKitchenPrintBargainHarass'
    end
    killvar '$c'
---

! play-тон (после PlayCoached Сандра↔Бекки): уединение/ласка, не hard-минет-меню
#SandraKitchenPrintBargainPlay
    $c = LCASE($SandraKitchenClient)
    if $c = 'traveler' or $c = 'sailor':
        *pl 'Моряк припирает Сандру к ларю у печи, уже расстёгивая пояс. Голос сиплый, без шуток «просто потрогать»:'
        *pl '— На кухне тихо, хозяйка. Серебро на стол — и уединимся. Ласка по-честному, без зала.'
        *pl ' '
        if HallMissingBargainExplicit = 1 or HallMissingFlagMouthMature['sandra'] = 1:
            *pl '— Монету — и заткнись, — ровно бросает Сандра. — Только не ори, а то вылетишь без штанов.'
        else
            *pl '— Тс-с… Позорник. Монету на край — и без рыка. Я не в портовом кабаке.'
        end
    elseif $c = 'craftsman' or $c = 'local':
        *pl 'Мастеровой упирается ладонью в стол, другой — у Сандры на талии, свойски и уже без «просто шлёпнуть»:'
        *pl '— Сандра, хватит кастрюль. Серебро не жалко — давай у печи, по-тихому, как умеешь.'
        *pl ' '
        if HallMissingBargainExplicit = 1 or HallMissingFlagMouthMature['sandra'] = 1:
            *pl '— Сосед… Ладно. Монету — и молчи. Без гвалта.'
        else
            *pl '— Охальник… Монету положи. И тихо — из залы не услышат.'
        end
    else
        *pl 'Купец кладёт кошель на край печи и не отводит глаз от Сандры:'
        *pl '— Хозяйка, заказ не на рагу. Уединение. Ласка за полновесное серебро. Зал не узнает.'
        *pl ' '
        if HallMissingBargainExplicit = 1 or HallMissingFlagMouthMature['sandra'] = 1:
            *pl '— Деньги на стол. Дальше — без крика, купец.'
        else
            *pl '— Бесстыдник… Монету — и ни слова лишнего, пока не кончишь торговаться.'
        end
    end
    killvar '$c'
---

! R5 harass-тон: щупать у печи, БЕЗ минета в уговоре
! resist / liberation=0 / обида — НЕ разрешает гладить; endure/policy3 — уговор
#SandraKitchenPrintBargainHarass
    $c = LCASE($SandraKitchenClient)
    if LOC('SandraKitchenHarassAllowCheck') = 1:
        gs 'SandraKitchenHarassAllowCheck'
    else
        SandraKitchenHarassAllow = 0
    end

    if GirlOffenseDays['sandra'] > 0:
        HallMissingBargainRefused = 1
        *pl 'Гость тянется к Сандре у печи — и тут же отскакивает: она уже с поварёшкой.'
        *pl ' '
        *pl '— А ну вон с кухни! Сегодня я и так сама не своя. Руки при себе, пока лоб цел.'
        *pl ' '
        *pl 'Гость ругается и вываливается к залу. Уговора нет.'
        killvar '$c'
        exit
    end

    if $c = 'traveler' or $c = 'sailor':
        *pl 'Моряк прижимает Сандру к каменной стене кухни, ладонь — на бедре, голос сиплый:'
        *pl '— К чёрту кастрюли. Дай пощупать, хозяйка — от тебя жаром пышет. Серебро не скупое.'
        *pl ' '
        if SandraKitchenHarassAllow = 1:
            *pl '— Т-тише, полоумный… Монету на стол. Руки — только где разрешу. И тихо.'
        else
            *pl 'Сандра выхватывает поварёшку и со всей силы отталкивает его ладонь:'
            *pl '— А ну руки убрал, полоумный! Я тебе не портовая девка. Пошёл в зал, пока лоб не треснул.'
        end
    elseif $c = 'craftsman' or $c = 'local':
        *pl 'Мастеровой прижимается пахом сзади у очага, руки лезут под подол — свойский натиск:'
        *pl '— Сандра, хватит печь греть. Дай подержать, погладить — у мастера руки дело знают.'
        *pl ' '
        if SandraKitchenHarassAllow = 1:
            *pl '— Сосед… Ладно, коли так припёрло. Быстро и без гвалта — а то поварёшкой по лбу.'
        else
            *pl 'Сандра скидывает его ладони и разворачивается с поварёшкой:'
            *pl '— А ну убрал лапы, сосед! Я тебе не девка на поглаживание. Пошёл вон с кухни — ещё шаг, и лоб тресну.'
        end
    else
        *pl 'Купец ловит запястье Сандры у печи и тянет её ладонь себе на штаны:'
        *pl '— За обед — отдельная плата, хозяйка. Подержи, успокой. Серебро полновесное.'
        *pl ' '
        if SandraKitchenHarassAllow = 1:
            *pl '— Купец… Деньги на ящик. И без крика — кухня не сцена для зала.'
        else
            *pl 'Сандра выдёргивает руку и хлопает ковшом по краю стола:'
            *pl '— Руки у меня для котла, не для твоих штанов! Серебро — на стойке. А сам — в зал, пока я по-доброму.'
        end
    end
    killvar '$c'
---

! H3 protect — Стефан ворвался (пар, печь, дверь; клиент × тип)
#SandraKitchenPrintProtect
    $c = LCASE($SandraKitchenClient)
    *pl 'Вы резко дёргаете кухонную дверь. Жар и пар бьют в лицо, запах лука и жира. У печи всё обрывается на полуслове.'
    *pl ' '
    if $c = 'traveler' or $c = 'sailor':
        *pl 'Моряк матерится сквозь зубы, одёргивает пояс и проталкивается мимо вас к залу, плечом почти задевая косяк. В глаза не смотрит.'
    elseif $c = 'craftsman' or $c = 'local':
        *pl 'Мастеровой кряхтит, отпускает Сандру и пятится к двери, бормоча «свой человек, не в службу…». Ладони ещё красные от жара плиты.'
    else
        *pl 'Купец мигом подбирает кошель с края стола, оправляет кафтан и спешит в зал — будто зашёл лишь спросить про рагу.'
    end
    *pl ' '
    *pl 'Сандра стоит у плиты. Грудь ходит, пальцы вцепились в край стола; передник сбит набок. Взгляд на вас — короткий, хозяйский, ещё не «спасибо».'
    killvar '$c'
---

! H3 watch — подсмотр (play / harass allow / resist) × 3 клиента
#SandraKitchenPrintHarassWatch
    $c = LCASE($SandraKitchenClient)
    if $SandraKitchenBeat = 'play':
        *pl 'Вы остаётесь у щели двери. Сквозь пар видно: это уже не «отстань». Сандра подыгрывает — подаёт бёдрами, ловит монету, шипит «тише», но рук ' + $HallLewdClientWhoA + ' не сбрасывает.'
        *pl ' '
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Моряк шлёпает по юбке, прижимается пахом ближе к столу. Сандра шипит, кусает губу — и смотрит на дверь: не выглянет ли кто из зала. Кастрюля на плите булькает в такт.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl '— Вот так, хозяйка… у плиты тоже можно, — свойски хрипит мастеровой, ладонь уже увереннее. Сандра фыркает, но подаётся ближе к столу, будто помнит, что серебро звенит громче морали.'
        else
            *pl 'Купец мнёт талию, шепчет про «заказ не на рагу». Сандра цедит «серебро на стол» — и сама чуть разворачивается, чтобы ему было удобнее смотреть и трогать. Кошель лежит у миски, как печать сделки.'
        end
    else
        if LOC('SandraKitchenHarassAllowCheck') = 1:
            gs 'SandraKitchenHarassAllowCheck'
        else
            SandraKitchenHarassAllow = 0
        end
        if SandraKitchenHarassAllow = 1:
            *pl 'Вы остаётесь у щели двери. На кухне ' + $HallLewdClientWho + ' не стесняется: ладони под юбкой, шлепок по бедру, сиплый смех у печи. Сандра не орёт «вон» — держит границу, но не войну.'
            *pl ' '
            if $c = 'traveler' or $c = 'sailor':
                *pl '— Вот так, хозяйка… горячая, — бормочет моряк, мнёт бедро. Сандра шипит «тише» и не отталкивает сразу: одной рукой держит половник, другой — ритм, чтобы кастрюля не съехала.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Мастеровой шлёпает по юбке ещё раз, грубо и свойски. Сандра ругается вполголоса, но подаётся — монета на краю стола уже звенит рядом с солью.'
            else
                *pl 'Купец мнёт талию и ниже, шепчет про «особый заказ». Сандра цедит сквозь зубы, ладонь не сбрасывает — глаза на кошель, не на его ухмылку.'
            end
        else
            *pl 'Вы остаётесь у щели двери. ' + $HallLewdClientWho + ' не унимается, но Сандра уже не даёт: ловит запястья, отталкивает бедром, поварёшка наготове. Пар, звон крышки, ни одного «ладно».'
            *pl ' '
            if $c = 'traveler' or $c = 'sailor':
                *pl '— Руки, сказала! — шипит она. Моряк ещё тянется к бедру — она бьёт по пальцам краем ковша, коротко и без театра.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Мастеровой тянется под подол снова. Сандра разворачивается и тычет поварёшкой ему в грудь:'
                *pl '— В зал, сосед. Пока по-доброму.'
            else
                *pl 'Купец трясёт кошелем. Сандра не смотрит на монеты:'
                *pl '— Серебро — на стойке. Руки — при себе. Кухня не прилавок для твоих штанов.'
            end
        end
    end
    killvar '$c'
---

! хвост H4 watch: гость ушёл, она у плиты (до реплики Стефану)
#SandraKitchenPrintHarassEnd
    $c = LCASE($SandraKitchenClient)
    if LOC('SandraKitchenHarassAllowCheck') = 1:
        gs 'SandraKitchenHarassAllowCheck'
    else
        SandraKitchenHarassAllow = 0
    end
    if SandraKitchenHarassAllow = 1 or $SandraKitchenBeat = 'play':
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Вскоре моряк отпускает её, довольно хмыкает и выскальзывает в зал, поправляя пояс. Сандра одёргивает передник, хлопает половником по котлу — будто мешала соус — и снова к плите.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl 'Мастеровой хлопает её по бедру на прощание и уходит, бормоча «до завтра». Сандра одёргивает передник, хлопает половником по котлу — будто ничего не было — и возвращается к огню.'
        else
            *pl 'Купец довольно кивает, подбирает пустой кошель и выскальзывает в зал. Сандра одёргивает передник, хлопает половником по котлу и снова к плите — счёт закрыт.'
        end
    else
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Моряк бурчит, оправляет куртку и пятится к двери — поварёшка Сандры не оставляет выбора. Она одёргивает передник, хлопает половником по котлу и к плите, будто никто не смел лезть.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl 'Мастеровой бормочет «ну-ну» и пятится в зал. Сандра опускает поварёшку, одёргивает передник, хлопает по котлу — порядок на кухне важнее его лица.'
        else
            *pl 'Купец оправляет кафтан и пятится в зал без монеты на столе. Сандра одёргивает передник, хлопает половником по котлу: тема закрыта.'
        end
    end
    killvar '$c'
---

! α play→missing: 1–2 реплики-мост (не полный уговор; уговор уже на Follow)
! «на большее» — уединение / ласка; не меню минета в тексте уговора (расширение — в Scene)
#SandraKitchenPrintEscalateBridge
    $c = LCASE($SandraKitchenClient)
    *pl 'Заигрывание у печи не заканчивается на шлепке. ' + $HallLewdClientWho + ' звенит монетой громче, голос ниже, ближе к её уху:'
    *pl ' '
    if $c = 'traveler' or $c = 'sailor':
        *pl '— Раз уж ты не против, хозяйка… ещё серебра — и по-настоящему, в угол за печью. Руки твои знают дело. Дверь не глянет — зал не увидит.'
    elseif $c = 'craftsman' or $c = 'local':
        *pl '— Раз уж ты не против… докинь серебра — и по-честному, за печью. Я не скуплюсь. Тихо. Соседи в зале пусть пьют.'
    else
        *pl '— Раз уж заказ принят… ещё монет — и уединение толком, за печью. Без зала. Серебро полновесное.'
    end
    *pl ' '
    if HallMissingFlagMouthMature['sandra'] = 1 or HallMissingBargainExplicit = 1:
        *pl '— …Чёрт с тобой, — сипло выдыхает Сандра, уже глядя на угол за печью. — Монету докинь. И тихо, слышишь? Котлы не для зрителей.'
    else
        *pl '— Ты совсем… — она смотрит на дверь, на котёл, на монету. Пауза. — Ладно. Докинь. И ни звука. Я не в порту.'
    end
    killvar '$c'
---

! H3 ignore / notice-ignore — только слух за дверью
#SandraKitchenPrintOffscreen
    $c = LCASE($SandraKitchenClient)
    *pl 'Вы остаётесь у кухонной двери и не заглядываете. Дерево под ладонью тёплое от пара; из щели — только звук.'
    *pl ' '
    if $SandraKitchenBeat = 'play':
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Из-за двери — тяжёлое дыхание, шлепок по ткани, сиплый «тише ты…», звяканье монеты о стол. Потом — смешок и шарканье.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl 'Из-за двери — свойский смешок, шлепок, голос Сандры полушёпотом: «Сосед… без гвалта». Стук миски. Снова тише.'
        else
            *pl 'Из-за двери — звон монет, низкий купеческий тон, короткий «тише» Сандры. Пауза. Снова звяканье — будто счёт сошёлся.'
        end
    else
        if LOC('SandraKitchenHarassAllowCheck') = 1:
            gs 'SandraKitchenHarassAllowCheck'
        else
            SandraKitchenHarassAllow = 0
        end
        if SandraKitchenHarassAllow = 1:
            if $c = 'traveler' or $c = 'sailor':
                *pl 'Слышны шлепки по ткани, портовой смешок, шипение Сандры — то «тише», то короткая брань, но без «вон с кухни».'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Слышны свойские шлепки, смех соседа, голос Сандры — то шипение, то «руки, сказала» без крика на весь зал.'
            else
                *pl 'Слышны шлепки, низкий смех купца, голос Сандры — то шипение, то «монету на стол», без выгона.'
            end
        else
            if $c = 'traveler' or $c = 'sailor':
                *pl 'Слышны шарканье, брань Сандры, стук ковша о стол — и торопливые шаги к двери: моряка выставляют.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Слышны брань, стук поварёшки, «в зал, сосед» — и шаги прочь. Кухня снова только булькает.'
            else
                *pl 'Слышны хлопок ковша о стол, сухой «руки при себе» — и торопливые шаги купца к двери. Без торга.'
            end
        end
    end
    killvar '$c'
---

! H4 — она к Стефану (protect / watch / ignore); тон: мать + хозяйка, не флирт
#SandraKitchenPrintAfter
    if $SandraKitchenChoice = 'protect':
        if LOC('HallMissingInterruptAfter_sandra') = 1:
            ! offense / policy3 / from play / late / default — agent_sandra USER-OWNED block
            gs 'HallMissingInterruptAfter_sandra'
        else
            *pl 'Сандра поправляет передник, утирает испарину суровым полотенцем. Взгляд теплеет — к сыну, не к гостю.'
            *pl '— Вовремя зашёл, Стефан. Спасибо, что выручил. Иди в зал, я тут сама… котлы не ждут.'
        end
    elseif $SandraKitchenChoice = 'watch':
        gs 'SandraKitchenPrintHarassEnd'
        *pl ' '
        if $SandraKitchenBeat = 'play':
            if FamilyCorruptionStage >= 4 or HallMissingFlagMouthMature['sandra'] = 1:
                *pl 'На пороге она замечает вас. Ухмылка короткая — материнская и чуть виноватая, без кокетства:'
                *pl '— Смотрел? Монету взяла. В зал, сынок — котлы сами не помешают. И не стой в щели, как надзиратель.'
            else
                *pl 'На пороге она замечает вас. Одёргивает передник, взгляд тяжёлый, но ровный:'
                *pl '— Стоял у двери… Ладно. В зал, Стефан. Мне ещё готовить. Разговор потом — если нужен.'
            end
        else
            if LOC('SandraKitchenHarassAllowCheck') = 1:
                gs 'SandraKitchenHarassAllowCheck'
            else
                SandraKitchenHarassAllow = 0
            end
            if SandraKitchenHarassAllow = 1:
                if FamilyCorruptionStage >= 3:
                    *pl 'Она кивает на зал, не оправдываясь. Пальцы ещё чуть дрожат — от жара или от ладоней, не ясно:'
                    *pl '— Видел. Серебро на столе. Не лезь, пока сама не позову. На кухне я порядок знаю.'
                else
                    *pl 'Она одёргивает передник и смотрит чуть виновато — не как девка, как мать, которую застукали:'
                    *pl '— Не стой в щели, Стефан. Иди в зал. Я… сама. И да: руки у него были лишние, но я не звала на помощь.'
                end
            else
                *pl 'Она кивает коротко, ещё сжимая поварёшку. Щёки горят от злости, не от стыда:'
                *pl '— Сама выставила. Иди в зал. На кухне порядок. Хозяину спасибо, что не полез раньше времени — но и не нужен был.'
            end
        end
    else
        ! ignore: notice-ignore или отвернулся после Follow
        $c = LCASE($SandraKitchenClient)
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Моряк выскальзывает в зал, оправляя пояс, и не смотрит на вас — будто вы часть косяка.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl 'Мастеровой выскальзывает в зал, бормоча себе под нос, и растворяется у столов.'
        else
            *pl 'Купец выскальзывает в зал, оправляя кафтан, кошель снова на поясе.'
        end
        *pl ' '
        if $SandraKitchenBeat = 'play':
            *pl 'Сандра появляется в дверном проёме. Утирает испарину, затягивает шнуровку, одёргивает передник. Взгляд короткий — без разговора, без злости, с лёгкой усталостью.'
            *pl '— Котлы… Иди в зал, Стефан. Я на месте.'
        else
            if LOC('SandraKitchenHarassAllowCheck') = 1:
                gs 'SandraKitchenHarassAllowCheck'
            else
                SandraKitchenHarassAllow = 0
            end
            if SandraKitchenHarassAllow = 1:
                *pl 'Сандра в дверном проёме. Передник поправлен, дыхание ещё тяжёлое. Кивает на зал — разговора не будет; и не жди исповеди.'
                *pl '— В зал. Я сама.'
            else
                *pl 'Сандра в дверном проёме, поварёшка ещё в руке. Кивает коротко: гостя выставила, тема закрыта.'
                *pl '— В зал, Стефан. Я на кухне сама. В следующий раз, коли услышишь гвалт — хоть головой кивни, сынок.'
            end
        end
        killvar '$c'
    end
---
