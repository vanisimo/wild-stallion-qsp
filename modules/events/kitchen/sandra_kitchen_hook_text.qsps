! H3 protect — Стефан ворвался (пар, печь, дверь; клиент × тип)
#SandraKitchenPrintProtect
    $c = LCASE($SandraKitchenClient)
    *pl 'Дверь с грохотом открывается. Пар от котла на мгновение скрывает печь, но ты видишь: мать резко выпрямляется у разделочного стола, а фигура рядом с ней шарахается в сторону.'
    *pl ' '
    if $c = 'traveler' or $c = 'sailor':
        *pl '— Твою ж… — моряк закусывает ругательство, дёргает ремень и боком, чуть не задев тебя плечом, выскальзывает в зал.'
    elseif $c = 'craftsman' or $c = 'local':
        *pl '— Хозяин, я это… — мастеровой кашляет в кулак, руки сами одёргивают рубаху. Пятится к двери, бубня под нос что-то про срочный заказ, и исчезает в шуме зала.'
    else:
        *pl 'Купец с неожиданной прытью засовывает кошель за пазуху, оправляет кафтан и, не глядя на тебя, цедит сквозь зубы: «Уже ухожу». Шаги дробно стучат по половицам в сторону зала.'
    end
    *pl ' '
    *pl 'Сандра стоит у плиты, вытирая руки о передник. Ткань сбилась набок, открывая ключицу. Грудь вздымается часто, но лицо — каменная маска хозяйки. Она встречает твой взгляд и коротко кивает на дверь: закрывай, мол, и не стой столбом.'
    killvar '$c'
