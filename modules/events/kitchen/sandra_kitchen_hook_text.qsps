! play-тон (после PlayCoached Сандра↔Бекки): уединение/ласка, не hard-минет-меню
#SandraKitchenPrintBargainPlay
    $c = LCASE($SandraKitchenClient)

    if FamilyCorruptionStage >= 4:
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Моряк только заносит ногу через порог кухни, а Сандра уже тут как тут. Подбоченивается, загораживая проход, и с вызовом кивает на глубокий вырез корсажа:'
            *pl '— Чего топчешься? Заходи, коли пришёл. Раз уж заглянул на кухню — не хочешь потрогать? Или думаешь, я тут просто так у печи кручусь?'
            *pl '— А ты сегодня добрая, — он довольно скалится, сразу запуская руку в карман за спринтриями.'
            *pl '— Добрая, пока платят, — Сандра протягивает ладонь и тут же прячет монеты.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl '— Опять без дела у печи трёшься, соседушка? — Сандра, едва завидев знакомую фигуру, упирает руки в бока. — Или принёс чем побренчать?'
            *pl '— И тебе день добрый, красавица, — мастеровой расплывается в улыбке и хлопает себя по карману со звоном монет.'
            *pl '— Раз зашёл — трогай, — она бедром отодвигает табурет. — Но сначала кошель покажи.'
        else:
            *pl 'Купец только переступает порог, а Сандра уже встречает его у косяка. Не спрашивая разрешения, тянется к его поясу и по-хозяйски ощупывает кошель:'
            *pl '— О, старый знакомый. Полновесные, люблю солидных мужчин. Раз уж заглянул, купец, не хочешь пощупать хозяйку?'
            *pl '— Сразу к делу, хозяйка? — он ухмыляется, перехватывая её пальцы.'
        end
        *pl ' '
        if HallMissingBargainExplicit = 1 or HallMissingFlagMouthMature['sandra'] = 1:
            *pl '— А чего тянуть? — усмехается Сандра, развязывая тесёмки передника. — Монеты на стол, и не наглей, а то вылетишь без штанов.'
        else:
            *pl '— У меня готовки много, так что без лишних сказок, — подмигивает она.'
        end

    elseif FamilyCorruptionStage >= 2:
        if $c = 'traveler' or $c = 'sailor':
            *pl '— Ну что, морячок, опять в гости пожаловал? — Сандра кладёт поварёшку на край котла, поворачивается и смотрит на гостя в упор.'
            *pl '— За твоим теплом, хозяйка, — он подбрасывает на ладони спринтрии. — Слыхал, у тебя на кухне веселее, чем в зале.'
            *pl '— Веселее? Если серебра не пожалеешь, — она протягивает руку за монетами.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl '— Сандра, ей-ей, с каждым днём ты всё аппетитнее, — мастеровой плюхается на табурет. — Может, согреемся по-тихому?'
            *pl '— За твои шуточки — отдельная плата, сосед, — хмыкает она, подставляя ладонь под спринтрии.'
        else:
            *pl 'Купец бросает на стол увесистый кошелёк, не сводя взгляда с Сандры:'
            *pl '— Хозяйка, пришёл не брюхо набить. Отойдём в уголок за серебро — никто и не увидит.'
            *pl '— За серебро? Ну, пойдём, купец, — спокойно отзывается она.'
        end
        *pl ' '
        gs 'SandraKitchenPrintMidGesture'
        *pl ' '
        if HallMissingBargainExplicit = 1 or HallMissingFlagMouthMature['sandra'] = 1:
            *pl '— Хочешь что-то не из меню — развязывай кошелёк, — бросает она.'
        else:
            *pl '— Давай без шума, — добавляет Сандра. — Не в портовом кабаке.'
        end

    else:
        if $c = 'traveler' or $c = 'sailor':
            *pl 'Моряк припирает Сандру к ларю у печи, уже расстёгивая пояс:'
            *pl '— Ой, хозяйка. Спринтрии я выложу — отойди в уголок.'
        elseif $c = 'craftsman' or $c = 'local':
            *pl 'Мастеровой упирается ладонью в стол, другой — у Сандры на талии, голос свойский:'
            *pl '— Хватит кашеварить, Сандра. Серебро не жалко — посмотри на меня.'
        else:
            *pl 'Купец кладёт монеты на край и улыбается уголком рта:'
            *pl '— У меня деловое предложение, красавица. Удели мне минутку за полновесные спринтрии.'
        end
        *pl ' '
        gs 'SandraKitchenPrintLowExcuse'
        *pl ' '
        *pl '— Только тихо, — шепчет она с тревогой, косясь на дверь. — И много себе не позволяй.'
    end

    killvar '$c'
