! H4 — она к Стефану (protect / watch / ignore); тон: мать + хозяйка, не флирт
#SandraKitchenPrintAfter
    if $SandraKitchenChoice = 'protect':
        if LOC('HallMissingInterruptAfter_sandra') = 1:
            ! offense / policy3 / from play / late / default — agent_sandra USER-OWNED block
            gs 'HallMissingInterruptAfter_sandra'
        else:
            *pl 'Сандра поправляет сбившийся передник, утирает испарину со лба чистым полотенцем. Взгляд, брошенный на тебя, теплеет. Она кладёт ладонь тебе на плечо и чуть сжимает:'
            *pl '— Спасибо, сынок. Иди в зал, я тут сама уже.'
        end
    elseif $SandraKitchenChoice = 'watch':
        gs 'SandraKitchenPrintHarassEnd'
        *pl ' '
        if $SandraKitchenBeat = 'play':
            if FamilyCorruptionStage >= 4 or HallMissingFlagMouthMature['sandra'] = 1:
                *pl 'Сандра замечает тебя на пороге. Уголок её губ ползёт вверх в короткой, деловой и чуть виноватой ухмылке. Она не оправдывается — подбрасывает на ладони спринтрию и кивает на дверь:'
                *pl '— Видел? Вот и молодец. А теперь иди работай, нечего торчать в дверях, как святой старец.'
            else:
                *pl 'Сандра одёргивает передник резким движением. Взгляд спокойный — она видела, что ты стоял у двери:'
                *pl '— Иди в зал, Стефан, — говорит она спокойно. — Поговорим потом, если захочешь.'
            end
        else:
            if LOC('SandraKitchenHarassAllowCheck') = 1:
                gs 'SandraKitchenHarassAllowCheck'
            else:
                SandraKitchenHarassAllow = 0
            end
            if SandraKitchenHarassAllow = 1:
                if FamilyCorruptionStage >= 3:
                    *pl 'Сандра не оправдывается. Кивает на блестящие монеты на краю стола и вытирает руки о передник:'
                    *pl '— Серебро на столе. Не суйся на кухню, пока сама не позову. Здесь я хозяйка. Я справлюсь.'
                else:
                    *pl 'Сандра ловит твой взгляд и тут же смущается. Руки сами тянутся поправить и без того безупречный передник:'
                    *pl '— Стефан… — голос срывается, она прочищает горло. — Не стой в дверях, видит Ильматер. Иди в зал, прошу тебя.'
                end
            else:
                *pl 'Щёки Сандры горят от злости. Она всё ещё сжимает поварёшку в побелевших пальцах. Увидев тебя, резко выдыхает:'
                *pl '— Сама справилась. Порядок навела. Иди в зал, хозяин, нечего тут торчать.'
            end
        end
    else:
        ! ignore: notice-ignore или отвернулся после Follow
        $c = LCASE($SandraKitchenClient)
        if $SandraKitchenBeat <> 'play':
            if LOC('SandraKitchenHarassAllowCheck') = 1:
                gs 'SandraKitchenHarassAllowCheck'
            else:
                SandraKitchenHarassAllow = 0
            end
        end

        if $SandraKitchenBeat <> 'play' and SandraKitchenHarassAllow = 0:
            if $c = 'traveler' or $c = 'sailor':
                *pl 'Моряк вылетает из кухни, потирая ухо, а за его спиной громыхает поварёшка. Он бормочет под нос проклятия и натягивает шапку до бровей, не оборачиваясь.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Сосед выскакивает, прижимая к груди скомканную шапку, и пятится от двери. На его щеке алеет свежий след от ладони, а в глазах — испуг пополам с обидой.'
            else:
                *pl 'Купец выходит торопливым шагом, налетая плечом на косяк, и суетливо одёргивает камзол. Он оглядывается на кухню с опаской, словно оттуда сейчас вылетит сковорода.'
            end
        elseif FamilyCorruptionStage >= 4:
            if $c = 'traveler' or $c = 'sailor':
                *pl 'Моряк вываливается из кухни с расстёгнутым воротом и блаженной рожей сытого кота. На ходу он затягивает завязки штанов и, проходя мимо, хлопает тебя по плечу ладонью.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Мастеровой выходит вразвалку, вытирая лоб тыльной стороной ладони, и только потом затягивает ремень. Он не прячет довольной ухмылки и подмигивает тебе, будто вы с ним в одной шайке.'
            else:
                *pl 'Купец появляется размякший, с блестящим лбом и распущенным шнурком на груди. Он затягивает пояс на ходу, смотрит на тебя с ленивым превосходством и поправляет перстень на пальце.'
            end
        elseif FamilyCorruptionStage >= 2:
            if $c = 'traveler' or $c = 'sailor':
                *pl 'Моряк выходит с мокрым пятном на рубахе, дышит шумно и застёгивает пуговицы на груди. Он бросает на тебя осоловевший взгляд и ухмыляется, затягивая пояс потуже.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Горожанин переступает порог, покачиваясь с пятки на носок, и небрежно заправляет рубаху в штаны. Его уши пылают, а руки всё ещё тянутся к ремню, словно он едва успел одеться.'
            else:
                *pl 'Купец выходит, тяжело опираясь на косяк, и шумно выдыхает. Он поправляет сбившийся ворот и торопливо суёт в карман полегчавший кошелёк.'
            end
        else:
            if $c = 'traveler' or $c = 'sailor':
                *pl 'Моряк выскальзывает из кухни, пряча ладонь в кармане и нервно одёргивая рубаху. Встретив твой взгляд, он кривится и спешит к стойке, за пивом.'
            elseif $c = 'craftsman' or $c = 'local':
                *pl 'Мастеровой выходит боком, оглядываясь на дверь, и торопливо трёт пальцы о штанину. На поясе у него болтается незатянутый ремешок, но он этого не замечает.'
            else:
                *pl 'Купец появляется в дверях с натужной улыбкой и приглаживает волосы на затылке. Он откашливается в кулак и, не глядя на тебя, пересчитывает мелочь в кошеле.'
            end
        end
        *pl ' '
        if $SandraKitchenBeat = 'play':
            *pl 'Сандра появляется в проёме, устало вытирая лоб:'
            *pl '— Всё, — бросает она, кивая в зал. — Иди делом займись. У меня тут ещё работы непочатый край.'
        else:
            if SandraKitchenHarassAllow = 1:
                *pl 'Сандра стоит в дверях, дыхание всё ещё сбито. Она одёргивает юбку и кивает в сторону зала:'
                *pl '— Разговора не будет, — говорит она. — Я сама справилась.'
            else:
                *pl 'Сандра выходит к тебе, всё ещё сжимая поварёшку. В глазах — ни капли страха, только досада:'
                *pl '— Выставила, — цедит она. — В следующий раз, Стефан, хоть загляни, если шум услышишь. А не стой как пень.'
            end
        end
        killvar '$c'
    end
