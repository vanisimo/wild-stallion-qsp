! USER-OWNED TEXT
! Prose kitchen hook: H1 notice → H2 уговор → H3 действие → H4 после + policy
! Уговор: ОДИН каркас на client; тон = harass | play + развилки по FamilyCorruptionStage
! Место: дверь кухни / у печи (НЕ занавеска)
! Клиенты: traveler · craftsman · rich_merchant · drunk отказ
! ================================================

#SandraKitchenPrintNotice
    *pl 'Ты замираешь у приоткрытой двери: ' + $HallLewdClientWho + ' уже стоит на пороге кухни и тянется к скобе.'
    *pl ' '
    *pl 'В щель видно край очага и стол. Изнутри вырывается пар, звенит посуда. Сандра стоит вполоборота, раскрасневшаяся, с выбившейся прядью у виска. Голос у неё низкий, совсем не такой, каким она отчитывает разносчиков:'
    *pl '— Ну куда ты лезешь, озорник… дай хоть горшок снять.'
    *pl 'Гость отвечает вполголоса, и из-за двери доносится короткий мужской смешок.'
---

#SandraKitchenPrintBargain
    $c = LCASE($SandraKitchenClient)
    HallMissingBargainRefused = 0

    if $c = 'drunk_guest' or $c = 'drunk':
        HallMissingBargainRefused = 1
        *pl 'Пьяный горожанин качается у печи и тянет к Сандре руку:'
        *pl '— Иди сюда, пышная… покажи, что там у тебя под фартуком…'
        *pl ' '
        if GirlWorkPolicy['sandra'] = 3:
            *pl 'Сандра даже не поворачивает головы. Только черпак в её руке замирает на полпути:'
            *pl '— Руку убрал. И рот закрыл, пока я его тебе не закрыла.'
            *pl '— Да ладно тебе, я ж по-доброму…'
            *pl '— По-доброму — это за дверь и до утра. Проспись, тогда и порог перешагивай. Ещё слово — вылетишь быстрее, чем успеешь икнуть.'
        else:
            *pl 'Сандра перехватывает поварёшку и тычет черенком ему в грудь:'
            *pl '— Уважь? Сейчас уважу — по лбу. Ещё шаг, и будешь у меня носом считать ступеньки.'
            *pl '— Ну и злюка ты…'
            *pl '— Ага. Иди проспись, пока я тебе вторую шишку не наставила.'
        end
        *pl ' '
        *pl 'Пьяница сплёвывает, что-то неразборчиво ворчит и вываливается в зал. Уговора нет.'
        killvar '$c'
        exit
    end

    ! play = уговор «подыгрывание/уединение»; harass = щупать у печи (без play)
    if $SandraKitchenBeat = 'play':
        gs 'SandraKitchenPrintBargainPlay'
    else:
        gs 'SandraKitchenPrintBargainHarass'
    end
    killvar '$c'
---

! Вспомогательная вставка оправданий Сандры на низкой коррупции (Stage 0–1)
#SandraKitchenPrintLowExcuse
    sk_var = RAND(1, 3)
    if sk_var = 1:
        *pl 'Сандра берёт монеты с быстрой оглядкой на дверь и прячет в передник. Щёки у неё краснеют, но смотрит она твёрдо:'
        *pl '— Это не для баловства беру. Серебро пойдёт на заморские специи. Не просто так ведь… не подумай чего.'
    elseif sk_var = 2:
        *pl 'Сандра сглатывает, косится на дверь в зал, потом на монеты. Прячет серебро в передник, голос звучит тише обычного:'
        *pl '— Дочкам пора сундуки собирать — Аманде и Мелиссе, всё ради приданого. Иначе бы и близко не подпустила, так и знай.'
    else:
        *pl 'Сандра прячет монеты в передник, нервно оглядываясь на проём. Взгляд у неё усталый, но упрямый:'
        *pl '— Нужно откладывать на достойную старость, чтобы ни от кого не зависеть. Никогда.'
    end
    killvar 'sk_var'
---

! Вспомогательная вставка жестов Сандры на средней коррупции (Stage 2–3)
#SandraKitchenPrintMidGesture
    sk_var = RAND(1, 3)
    if sk_var = 1:
        *pl 'Сандра спокойно берёт монеты и расправляет плечи. Кладёт обе ладони себе на пышную грудь, поправляя вырез и подчёркивая формы:'
        *pl '— Ну что, так лучше смотрится? Или ещё поправить?'
    elseif sk_var = 2:
        *pl 'Сандра не спеша убирает спринтрии, опирается ладонями о край стола и лениво покачивает бёдрами, отчего юбка ходит ходуном:'
        *pl '— Что, нравится?'
    else:
        *pl 'Сандра взвешивает спринтрии на ладони, смотрит гостю прямо в глаза и медленно приподнимает подол юбки. Открывается гладкая от «Таро» кожа ноги выше колена:'
        *pl '— Вот, полюбуйся. Дальше — только за отдельную плату.'
    end
    killvar 'sk_var'
