! ================================================
! FILE: modules/events/dance/amanda_dark_alley_text.qsps
! USER-OWNED TEXT
! Тексты подворотни после танца с Амандой
! Расширенная версия с глубокими деталями и вариациями
! Лестница строго привязана к AmandaHomeStage
! Невинности в подворотне не лишаем никогда
! ================================================

#AmandaDanceAlleyMainText
    if $AmandaAlleyLastText <> '':
        *p $AmandaAlleyLastText
    elseif AmandaAlleyStage = 1:
        *pl 'Вы с Амандой сворачиваете с залитой факельным светом ярмарочной площади в узкий, тёмный проход меж глухими стенам домов.'
        *pl 'За спиной всё ещё гудит весёлый праздник: слышны скрипки, бухает барабан, слышатся пьяные возгласы и смех танцующих горожан. Но здесь, за поворотом, шум становится приглушённым, а тени — густыми.'
        *pl 'Она прислоняется спиной к шершавой каменной кладке, пытаясь отдышаться после быстрого танца. Её грудь вздымается под шнуровкой, а глаза блестят в темноте с любопытством и лёгкой тревогой.'
    elseif AmandaAlleyStage = 2:
        *pl 'После украдкой сорванного поцелуя Аманда взволнованно смотрит в сторону светлого выхода на площадь.'
        *pl 'Она прижимает кончики пальцев к своим влажным, чуть припухшим губам, прислушиваясь к далёкому гомону толпы.'
        *pl 'Уходить она явно не спешит — её распаляет этот волнующий полумрак.'
    elseif AmandaAlleyStage = 3:
        *pl 'Вы стоите вплотную друг к другу. Стена переулка заслоняет вас от случайных взоров, но близость улицы пьянит.'
        *pl 'Аманда ощущает ваше жаркое дыхание на своей щеке и не делает ни шагу назад — хотя ещё недавно побоялась бы даже взглянуть на вас так открыто.'
    elseif AmandaAlleyStage = 4:
        *pl 'Воздух между вами накалён до предела. После дерзких ласк под юбкой щёки Аманды горят живым румянцем, а пальцы судорожно комкают ткань вашего рукава.'
        *pl 'Она смущённо прячет глаза, но её дыхание выдаёт бурю чувств, разгоревшуюся в её юном теле.'
    else:
        *pl 'Густая тень переулка надёжно скрывает вас обоих от ярмарочного шума, но волнующее чувство запретного риска ни на секунду не покидает это место.'
    end
---

! ================================================
! Текст действия в подворотне — привязан к HomeStage
! ================================================

#AmandaDanceAlleyActionText
    $AmandaAlleyTextAction = LCASE($ARGS[0])

    if $AmandaAlleyTextAction = 'look':
        $AmandaAlleyLastText = 'Вы осторожно выглядываете из-за выступа стены. На площади все идёт своим чередом: торговцы зазывают зевак, пары кружатся в танце у фонарей, а городская стража мирно греется у костра с кружками эля.'
        $AmandaAlleyLastText += '<br>Никто не обращает внимания на тёмную щель между домами. Аманда неслышно подходит к вам сзади, кладёт ладошку на ваше плечо и взволнованно шепчет прямо в ухо: «Ну что там, Стефан? Никто нас не хватился?» — «Пока всё тихо, сестрёнка. Мы здесь одни». Она с облегчением переводит дух, но в её глазах мелькает озорная искра.'

    elseif $AmandaAlleyTextAction = 'kiss':
        if AmandaHomeStage <= 2:
            $AmandaAlleyLastText = 'Вы наклоняетесь к её лицу, желая поцеловать её в губы. Аманда на миг замирает, её дыхание прерывается, но затем она смущённо отворачивает голову и мягко упирается ладошками вам в грудь.'
            $AmandaAlleyLastText += '<br>«Стефан, постой... не здесь, — тихо и умоляюще шепчет она, заливаясь румянцем. — Ильматер видит, кто-нибудь выйдет с площади до ветру и сразу нас застукает! Ну нельзя же прямо вот так посреди улицы...»'
            $AmandaAlleyLastText += '<br>Она смотрит с искренним раскаянием, но её губы дрожат от желания.'
        elseif AmandaHomeStage = 3:
            $AmandaAlleyLastText = 'Вы обнимаете Аманду и накрываете её губы своими. Она вздрагивает всем телом, сладостно выдыхает и послушно прикрывает глаза, отдаваясь поцелую.'
            $AmandaAlleyLastText += '<br>Её губы — мягкие, тёплые. На несколько мгновений шум ярмарки полностью смолкает для вас обоих. Лишь когда дыхание сбивается, Аманда нехотя отстраняется, держась за ворот вашей рубашки: «Ох, Стефан... голова кругом идёт. Но нас же правда могут увидеть...»'
        elseif AmandaHomeStage >= 4:
            $AmandaAlleyLastText = 'Едва вы делаете движение, как Аманда сама льнёт к вам навстречу, обвивая шею тонкими руками. Её поцелуй — глубокий, страстный и удивительно смелый для юной девушки.'
            $AmandaAlleyLastText += '<br>Она прижимается всем телом, отвечая на ласку с жадным упоением и запуская пальцы в ваши волосы. Разорвав поцелуй лишь ради короткого вдоха, она тихо и счастливо шепчет вам в самые губы: «Пусть смотрят, если хотят...»'
        end

    elseif $AmandaAlleyTextAction = 'close':
        if AmandaHomeStage <= 2:
            $AmandaAlleyLastText = 'Вы притягиваете её ближе к себе в полумрак. Аманда осторожно кладёт ладони вам на грудь, удерживая символическую дистанцию.'
            $AmandaAlleyLastText += '<br>«Стефан, потише... мы же не дома, — сбивчиво шепчет она, опуская глаза. — Не прижимайся так сильно, а то подол платья помнёшь, мамка сразу расспрашивать начнёт, где это я обтиралась...»'
        elseif AmandaHomeStage = 3:
            $AmandaAlleyLastText = 'Вы властно привлекаете её к себе за талию. Аманда вспыхивает до корней волос, но не сопротивляется — напротив, доверчиво утыкается носиком в ваше плечо, крепко сжимая ткань вашей куртки.'
            $AmandaAlleyLastText += '<br>Вы чувствуете, как часто и тревожно бьётся её сердце под корсажем, сливаясь с вашим собственным ритмом.'
        elseif AmandaHomeStage >= 4:
            $AmandaAlleyLastText = 'Аманда сама делает шаг вперёд, всем телом вжимаясь в вас и обвивая руками ваш пояс.'
            $AmandaAlleyLastText += '<br>Она поднимает на вас сияющий взгляд и тихо шепчет: «Знаешь... я всю дорогу на площади только и думала о том, как бы оказаться с тобой наедине. Так спокойно, когда ты крепко держишь меня...»'
        end

    elseif $AmandaAlleyTextAction = 'petting':
        if AmandaHomeStage <= 2 or sluttiness['amanda'] < 20:
            $AmandaAlleyLastText = 'Ваша ладонь осторожно скользит вниз по складкам платья, приподнимает  материю и поднимается вверх по её обнажённому бедру. Аманда испуганно ахает, её пальчики судорожно хватают ваше запястье, но в этой хватке нет настоящей силы.'
            $AmandaAlleyLastText += '<br>«Стефан! Туда нельзя... что ты делаешь?! — испуганно шепчет она, озираясь по сторонам расширенными глазами. — Нас же точно увидят! Не надо, Стефанчик...» Её коленки мелко подрагивают, а тело невольно замирает от непривычного жара, волнами расходящегося из-под вашей ладони.'
        elseif AmandaHomeStage <= 4 or sluttiness['amanda'] < 35:
            $AmandaAlleyLastText = 'Вы решительно запускаете руку под подол её платья, нащупывая край тонких полотняных трусиков. Пальцы проскальзывают под ткань, касаясь сочащегося горячего влажного бутона. Аманда закусывает нижнюю губу, её голова запрокидывается вам на плечо, а бёдра сами собой подаются навстречу ласке.'
            $AmandaAlleyLastText += '<br>«Ох, Стефан... Ильматер всеблагой... прямо тут?.. — прерывисто стонет она, обжигая вашу шею прерывистым дыханием. — О-ох... как же сладко... братик, пожалуйста, не останавливайся...»'
        else:
            $AmandaAlleyLastText = 'Аманда лукаво усмехается и сама лёгким движением приподнимает подол платья, прижимаясь бёдрами к вашей руке и помогая пальцам проникнуть под трусики.'
            $AmandaAlleyLastText += '<br>Её влажная, разгорячённая пещерка жадно принимает ласку, а бёдра начинают ритмично двигаться навстречу вашим пальцам: «М-м... наконец-то,я уже думала не дождусь, братец...»'
        end

    else:
        $AmandaAlleyLastText = 'Вы задерживаетесь в подворотне ещё на несколько мгновений, прислушиваясь к звукам ночного города.'
    end

    killvar '$AmandaAlleyTextAction'
