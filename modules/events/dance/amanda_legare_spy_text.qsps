! ================================================
! FILE: modules/events/dance/amanda_legare_spy_text.qsps
! USER-OWNED TEXT
! Тексты сцены слежки за Амандой и Легаре
! Используется кодом:
! modules/events/dance/amanda_legare_spy.qsps
!
! Тип сцены приходит в $ARGS[0]:
!   'talk'    — только разговор
!   'suck'    — первый минет
!   'suck2'   — повторный минет
!   'deflower'— лишение невинности
!   'sex'     — секс (уже не девочка, впервые с Легаре)
!   'sex2'    — секс (уже бывало)
!
! Шаг сцены приходит в $ARGS[1]: 0, 1, 2, 3
! ================================================

#AmandaLegareSpyStartText
    *pl 'Когда пары разошлись после последнего танца, Легаре не спешит к выходу.'
    *pl 'Он подходит к Аманде — неспешно, как человек, у которого всё идёт по плану.'
    *pl 'Наклоняется и говорит что-то тихо.'
    *pl 'Аманда смотрит на него, потом оглядывается на площадь.'
    *pl 'Потом всё-таки идёт за ним.'
    *pl ' '
    *pl 'Он ведёт её не по главной улице — в переулок, за лавки.'
    *pl 'Вы хорошо знаете этот маршрут. Задний двор виноторговца — там, где хранятся бочки и стоит старая повозка.'
---

#AmandaLegareSpyInterceptText
    *pl 'Вы оказываетесь рядом прежде чем они успевают свернуть за угол.'
    *pl 'Легаре смотрит на вас — спокойно, с лёгкой полуулыбкой.'
    *pl '— Стефан. Как хорошо, что вы так внимательно следите за своими близкими.'
    *pl '— Следите за собой, месье.'
    *pl ' '
    *pl 'Он уходит не торопясь. Аманда смотрит на вас — не благодарно, не сердито.'
    *pl 'Просто смотрит. Потом тихо разворачивается к площади.'
---

#AmandaLegareSpyIgnoreText
    *pl 'Вы остаётесь у фонтана. Смотрите как они уходят.'
    *pl ' '
    *pl 'Площадь продолжает праздновать. Кто-то приглашает на танец, кто-то смеётся.'
    *pl 'Вы стоите с кружкой пива, и кружка постепенно становится тёплой.'
    *pl ' '
    *pl 'Аманда возвращается примерно через полчаса. Идёт ровно, не торопится.'
    *pl 'Одежда в порядке. Но она немного по-другому держит плечи — чуть свободнее, что ли.'
    *pl ' '
    if $AmandaLegareSpySexType = 'deflower':
        *pl 'Что-то изменилось. Вы не знаете что именно. Но это чувствуется.'
    elseif $AmandaLegareSpySexType = 'suck' or $AmandaLegareSpySexType = 'suck2':
        *pl 'Она проводит кончиком языка по губам — автоматически, не замечая. Потом видит что вы смотрите и отводит взгляд.'
    end
---

#AmandaLegareSpyBackyardText
    *pl 'Вы идёте за ними на безопасном расстоянии.'
    *pl 'Калитка за задним двором лавки не заперта. Вы заходите через минуту после них.'
    *pl ' '
    *pl 'Между штабелем бочек с вином и старой повозкой — достаточно узкий проход. Со стороны улицы не видно ничего.'
    *pl 'С другой стороны бочек — вполне удобная позиция, если не дышать слишком громко.'
    *pl ' '
    *pl 'Вы слышите их голоса.'
---

#AmandaLegareSpyListenText
    *pl '— А ваша жена, месье? — тихо говорит Аманда. — И дети? Они же могут увидеть...'
    *pl '— Элоиза умная женщина, — отвечает Легаре. — Она давно поняла, что у мужчины бывают свои дела. Это не предательство. Это устройство мира.'
    *pl '— Это честно?'
    *pl '— Это реально, дорогая. Куда реальнее, чем то, чего ждёшь от жизни в твоём возрасте.'
    *pl ' '
    *pl 'Пауза.'
    *pl ' '
    *pl '— А Кларисса? — спрашивает Аманда.'
    *pl '— Кларисса? — Легаре почти смеётся. — Кларисса сама придумала себе историю про нас с вами. Не обращайте внимания.'
    *pl ' '
    *pl 'Вы слышите как она что-то тихо говорит в ответ. Слов не разобрать.'
---

! ================================================
! Основная сцена — по типу и шагу
! $ARGS[0] = тип, $ARGS[1] = шаг
! ================================================

#AmandaLegareSpySceneText
    $SpyTextType = LCASE($ARGS[0])
    SpyTextStep = ARGS[1]

    ! ---- ТОЛЬКО РАЗГОВОР ----
    if $SpyTextType = 'talk':
        if SpyTextStep = 0:
            *pl 'Вы видите как Легаре прижимает Аманду к стене — мягко, без спешки. Целует её.'
            *pl 'Она отвечает после небольшой паузы.'
            *pl 'Потом он что-то говорит ей на ухо. Она качает головой.'
        elseif SpyTextStep = 1:
            *pl 'Легаре не настаивает. Просто кладёт руку ей на щёку и снова целует — долго.'
            *pl 'Потом они расходятся.'
            *pl 'Разговор, поцелуй, уход. На этот раз — не больше.'
        end

    ! ---- МИНЕТ (первый) ----
    elseif $SpyTextType = 'suck':
        if SpyTextStep = 0:
            *pl 'Легаре прижимает Аманду к бочке и целует — настойчиво, но без спешки.'
            *pl 'Его рука ложится ей на грудь поверх платья. Она не убирает.'
        elseif SpyTextStep = 1:
            *pl '— Подожди, — слышите вы голос Аманды. — Не здесь... вот так нельзя.'
            *pl 'Легаре что-то говорит тихо. Потом снова.'
            *pl 'Потом раздаётся шуршание юбки.'
            *pl 'Вы видите через щель между бочками как Аманда расстёгивает ему штаны.'
            *pl 'Встаёт на колени.'
        elseif SpyTextStep = 2:
            *pl 'Она делает это неумело, но старательно.'
            *pl 'Легаре откидывается спиной к бочке и прикрывает глаза.'
            *pl ' '
            *pl 'В конце он не предупреждает. Просто выпускает всё ей в рот.'
            *pl 'Аманда замирает на долю секунды — потом глотает. Нерешительно. Как будто не уверена, правильно ли делает.'
            *pl ' '
            *pl '— Вот так, — говорит Легаре, убирая руку с её волос. — Видишь? Не так страшно.'
        end

    ! ---- МИНЕТ (повторный) ----
    elseif $SpyTextType = 'suck2':
        if SpyTextStep = 0:
            *pl 'Они даже не разговаривают долго. Легаре берёт её за руку и ведёт в проход между бочками.'
            *pl 'Аманда сама расстёгивает ему штаны.'
        elseif SpyTextStep = 1:
            *pl 'Она уже знает как это делается. Работает ртом уверенно, глядит снизу вверх.'
            *pl 'Легаре кладёт руку ей на голову.'
        elseif SpyTextStep = 2:
            *pl 'Финал. Он заканчивает ей на лицо — первая струя попадает в правый глаз.'
            *pl 'Аманда морщится, но не отдёргивается. Вытирает лицо запястьем.'
            *pl '— Альберчик, предупреждай хотя бы... — говорит она, почти без упрёка.'
            *pl '— Ты была бесподобна, — отвечает он. И это, похоже, исчерпывает тему.'
        end

    ! ---- ЛИШЕНИЕ НЕВИННОСТИ ----
    elseif $SpyTextType = 'deflower':
        if SpyTextStep = 0:
            *pl 'Легаре прижимает Аманду к стене. Целует её долго, потом переходит к шее.'
            *pl 'Рука — под платье. Она вздрагивает.'
            *pl '— Ой, — тихо говорит Аманда. Не «нет». Просто «ой».'
        elseif SpyTextStep = 1:
            *pl 'Он сноровисто стягивает с неё платье. Оставляет на какой-то жерди.'
            *pl 'Аманда дрожит — не от холода.'
            *pl 'Легаре поворачивает её, кладёт её руки на бочку, пристраивается сзади.'
            *pl '— Подожди, — шепчет она, — я ещё... я никогда...'
            *pl '— Знаю, — говорит он. — Вот увидишь, это не больно.'
            *pl 'Врёт.'
        elseif SpyTextStep = 2:
            *pl 'Короткий писк. Струйка крови по ноге.'
            *pl 'Вот оно.'
            *pl ' '
            *pl 'Легаре не торопится. Двигается медленно, пока она не успокаивается.'
            *pl 'Потом быстрее.'
            *pl 'Аманда начинает тихо постанывать — уже не от боли.'
        elseif SpyTextStep = 3:
            *pl 'Он заканчивает внутри. Замирает, потом отступает.'
            *pl 'По её ноге стекает — белое и красное вместе.'
            *pl ' '
            *pl '— Ой, Альберчик... ты прямо в меня? — говорит она растерянно. — А я не...'
            *pl '— С первого раза не залетают, — отвечает он без паузы. — Можешь мне верить.'
            *pl '— Правда?'
            *pl '— Ну конечно. Зачем бы я тебя обманывал?'
            *pl ' '
            *pl 'Вы стоите за бочками и молчите.'
        end

    ! ---- СЕКС (первый с Легаре, уже не девственница) ----
    elseif $SpyTextType = 'sex':
        if SpyTextStep = 0:
            *pl 'Они переходят к делу быстро. Легаре помогает ей снять платье — аккуратно, на чистую бочку.'
            *pl 'Аманда не протестует. Кажется, она сама этого хотела.'
        elseif SpyTextStep = 1:
            *pl 'Он прижимает её к бочке, лапает грудь — Аманда закусывает губу, чтобы не издать звук.'
            *pl 'Потом он поворачивает её и входит сзади одним движением.'
            *pl '— Ох, ты уже не девочка? — спрашивает он с удивлением, почти разочарованным.'
            *pl '— Ну конечно нет, — смеётся Аманда, подмахивая его толчкам.'
        elseif SpyTextStep = 2:
            *pl 'Она двигается охотно, не сдерживая звуки — почти. Тихие стоны всё равно прорываются.'
            *pl '— И кто же был тот счастливчик? — спрашивает Легаре с интересом.'
            *pl '— Ни за что не догадаешься! — смеётся она. — Это был мой... мой... мой похотливый братик!'
            *pl 'Легаре от такого откровения явно заводится сильнее.'
        elseif SpyTextStep = 3:
            *pl 'Финал приходит быстро для обоих. Он кончает в неё — Аманда слегка вздрагивает от тепла.'
            *pl ' '
            *pl '— Ой, Альберчик, ну зачем внутрь... а вдруг ребёнок?'
            *pl '— Ты сама виновата, что ты так хороша. Прости, я не устоял.'
            *pl 'Она смеётся. Прощает.'
        end

    ! ---- СЕКС (повторный) ----
    elseif $SpyTextType = 'sex2':
        if SpyTextStep = 0:
            *pl 'На этот раз всё стремительно. Почти без слов.'
            *pl 'Аманда снимает платье сама, вешает на повозку. Поворачивается и наклоняется, положив ладони на бочку.'
            *pl '— Ну? — говорит она через плечо. — Или ты передумал?'
        elseif SpyTextStep = 1:
            *pl 'Легаре не передумал.'
            *pl 'Он входит в неё, она сразу начинает подмахивать — привыкла к его темпу.'
            *pl 'Звуки они оба почти не сдерживают.'
        elseif SpyTextStep = 2:
            *pl 'По телу Аманды проходит дрожь — кончила.'
            *pl 'Легаре заканчивает секундами позже. Выходит наружу и разряжается ей на спину.'
            *pl '— Какой ты умелый, — говорит она с удовольствием, вытираясь. — Всегда доводишь.'
            *pl '— Для тебя я всегда готов стараться.'
            *pl 'Лесть взаимная. Обоих устраивает.'
        elseif SpyTextStep = 3:
            *pl 'Они приводят себя в порядок неторопливо. Легаре что-то говорит — что-то цветистое, про озёра её соков и пещерку её женственности.'
            *pl 'Аманда смеётся.'
            *pl '— Давай я тебя провожу до трактира, а то уже поздно.'
            *pl ' '
            *pl 'Они выходят вместе, рядом — не под ручку, но достаточно близко.'
        end
    end

    killvar '$SpyTextType'
    killvar 'SpyTextStep'
---

#AmandaLegareSpyYellText
    *pl 'Вы не можете больше молча стоять за бочками.'
    *pl ' '
    *pl '— Аманда! — рявкаете вы в темноту. — Что за Ильматер там происходит с этим старым козлом?!'
    *pl ' '
    *pl 'Тишина. Потом шорох.'
    *pl '— Стефан?! — её голос резко меняется.'
    *pl ' '

    if virginity['amanda'] = 0 and AmandaLegareSexDone = 0:
        *pl 'Легаре смотрит в сторону бочек. Мрачно. Ничего не говорит, просто открывает калитку.'
        *pl 'Аманда торопливо приводит себя в порядок, бормоча: «Это не то, что ты подумал...»'
        *pl 'Когда она проходит мимо вас — не смотрит в глаза.'
    else:
        *pl 'Легаре спокойно поднимается. Смотрит в вашу сторону через штабель бочек.'
        *pl '— Стефан. — Он произносит ваше имя как нечто малозначительное. — Вы могли просто подойти.'
        *pl 'Аманда уже одёрнула юбку. Краснеет как рак, но молчит.'
    end
---

#AmandaLegareSpyFinishText
    AmandaSpyFinishWaited = ARGS[0]
    $AmandaSpyFinishType = LCASE($ARGS[1])

    if AmandaSpyFinishWaited = 1:
        *pl 'Вы дожидаетесь пока они выйдут.'
        *pl ' '
        *pl 'Легаре провожает Аманду до угла — почтительно, почти как кавалер. Прощается коротко.'
        *pl 'Уходит неторопливо. С видом человека, у которого всё прошло как надо.'
        *pl ' '
        if $AmandaSpyFinishType = 'deflower':
            *pl 'Аманда идёт чуть медленнее, чем обычно. Что-то явно изменилось.'
        elseif $AmandaSpyFinishType = 'suck' or $AmandaSpyFinishType = 'suck2':
            *pl 'Аманда возвращается к площади. Поправляет волосы. Оглядывается — не видит вас.'
            *pl 'Через минуту уже улыбается кому-то из знакомых, будто ничего не было.'
        elseif $AmandaSpyFinishType = 'sex' or $AmandaSpyFinishType = 'sex2':
            *pl 'Аманда идёт рядом с Легаре до самого угла, потом он прощается. Она смотрит ему вслед.'
            *pl 'Потом поворачивается к площади. Вы видите в темноте её лицо — довольное. Спокойное.'
            *pl 'Чужое.'
        else:
            *pl 'Аманда возвращается к площади. Выглядит нормально.'
        end
    else:
        *pl 'Вы уходите первым. Через калитку, не оглядываясь.'
        *pl ' '
        *pl 'На площади ещё играет музыка. Кто-то смеётся.'
        *pl 'Вы берёте у разносчика кружку пива и стоите у фонтана.'
        *pl 'Аманда вернётся сама. Так или иначе.'
    end

    killvar 'AmandaSpyFinishWaited'
    killvar '$AmandaSpyFinishType'
---
