! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! События пятничных танцев
! Версия: schedule v4 / hard return fix
! Назначение:
! - речь мэра перед танцами
! - наблюдение за площадью
! - слухи и разговоры NPC
! - продвижение раундов праздника
!
! Важно:
! Все внутренние экраны танцев возвращаются напрямую в MarketDance.
! Не используем gt $FridayDanceReturnLoc внутри act, потому что act выполняется позже.
!
! Тексты берутся из:
! modules/events/dance/friday_dance_text.qsps
! ================================================

#FridayDanceInit

    SceneArtUseReal = 1

    if FridayDanceDay <> day:
        FridayDanceDay = day
        FridayDancesCount = 0
        FridayDanceMayorSpeechSeen = 0
        FridayDanceRumorCount = 0
        FridayDanceNpcTalkCount = 0
        FridayDanceSponsorBoostApplied = 0
        BeckyFridayContactToday = 0
    end

    if FridayDanceSponsored = 1 and FridayDanceSponsorBoostApplied = 0:
        gs 'FridayDanceSponsorApplyGirlBoost'
        FridayDanceSponsorBoostApplied = 1
    end
---

! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! Вопрос Сандры при смене дня на пятницу
! ================================================

#FridayDanceSponsorPrompt

    SceneArtUseReal = 1
    cls

    gs 'AddGlobalButtons'

    $PanelRestoreAfterRefresh = ''
    PanelCustomActive = 0

    gs 'PanelPlayerStatus'

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_sponsor_prompt', 'ПЯТНИЧНЫЕ ТАНЦЫ', 'large', 'webp'
    gs 'FridayDanceSponsorPromptText'

    *pl '══════════════════════════════════════════════'
    *pl ' ПЯТНИЧНЫЕ ТАНЦЫ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *p $FridayDanceSponsorPromptText
    *pl ' '
    *pl 'Нужно из запасов: вино ' + STR(FridayDanceSponsorWineCost) + ', пиво ' + STR(FridayDanceSponsorBeerCost) + ', еда ' + STR(FridayDanceSponsorFoodCost)
    *pl 'Сейчас: вино ' + STR(winenum) + ', пиво ' + STR(beernum) + ', еда ' + STR(productnum)
    *pl ' '

    gs 'FridayDanceSponsorCanAfford'

    if FridayDanceSponsorCanAfford = 1:
        gs 'ActUiPrepare', 'Спонсировать танцы', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceSponsorApply', 'yes'
        end
    end

    gs 'ActUiPrepare', 'Не спонсировать', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FridayDanceSponsorApply', 'no'
    end

    killvar 'FridayDanceSponsorCanAfford'
---

#FridayDanceSponsorCanAfford

    FridayDanceSponsorCanAfford = 0

    if winenum >= FridayDanceSponsorWineCost and beernum >= FridayDanceSponsorBeerCost and productnum >= FridayDanceSponsorFoodCost:
        FridayDanceSponsorCanAfford = 1
    end
---

#FridayDanceSponsorApply

    $FridayDanceSponsorChoice = LCASE($ARGS[0])

    FridayDanceSponsorDay = day
    LastDayDanceSponsorWine = 0
    LastDayDanceSponsorBeer = 0
    LastDayDanceSponsorFood = 0
    FridayDanceSponsored = 0

    if $FridayDanceSponsorChoice = 'yes':
        gs 'FridayDanceSponsorCanAfford'

        if FridayDanceSponsorCanAfford = 1:
            winenum -= FridayDanceSponsorWineCost
            beernum -= FridayDanceSponsorBeerCost
            productnum -= FridayDanceSponsorFoodCost

            FridayDanceSponsored = 1
            LastDayDanceSponsorWine = FridayDanceSponsorWineCost
            LastDayDanceSponsorBeer = FridayDanceSponsorBeerCost
            LastDayDanceSponsorFood = FridayDanceSponsorFoodCost
        end

        killvar 'FridayDanceSponsorCanAfford'
    end

    killvar '$FridayDanceSponsorChoice'

    gt 'NextDaySummary'
---

#FridayDanceSponsorApplyGirlBoost

    gs 'UpdateGirlLocations'
    gs 'FridayDanceSponsorBoostGirl', 'amanda'
    gs 'FridayDanceSponsorBoostGirl', 'melissa'
    gs 'FridayDanceSponsorBoostGirl', 'becky'
    gs 'FridayDanceSponsorBoostGirl', 'clarissa'
    gs 'FridayDanceSponsorBoostGirl', 'inga'
---

#FridayDanceSponsorBoostGirl

    $FridayDanceSponsorGirl = LCASE($ARGS[0])

    if $FridayDanceSponsorGirl = '':
        exit
    end

    if $GirlLocation[$FridayDanceSponsorGirl] <> 'DanceHall':
        killvar '$FridayDanceSponsorGirl'
        exit
    end

    if LOC('EnsureGirlData') = 1:
        gs 'EnsureGirlData', $FridayDanceSponsorGirl
    end

    sluttiness[$FridayDanceSponsorGirl] += 2
    otkroven[$FridayDanceSponsorGirl] += 2

    gs 'ClampGirlSocialStats', $FridayDanceSponsorGirl

    killvar '$FridayDanceSponsorGirl'
---

! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! Речь мэра перед танцами
! Возврат напрямую в MarketDance
! ================================================

#FridayDanceMayorSpeech

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_mayor_speech', 'ВЫСТУПЛЕНИЕ МЭРА', 'large', 'webp'
    gs 'FridayDanceMayorSpeechText'

    *pl '══════════════════════════════════════════════'
    *pl ' ВЫСТУПЛЕНИЕ МЭРА'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *p $FridayDanceText
    *pl ' '

    FridayDanceMayorSpeechSeen = 1
    MayorSpeechSeenCount += 1

    if FridayDanceSponsored = 1:
        CityValue += 1
    end

    if debug = 1:
        *pl '[DEBUG DANCE] CityValue: ' + STR(CityValue)
        *pl '[DEBUG DANCE] MayorSpeechSeenCount: ' + STR(MayorSpeechSeenCount)
        *pl '[DEBUG DANCE] return: MarketDance'
        *pl ' '
    end

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! Наблюдение за танцами
! Возврат напрямую в MarketDance
! ================================================

#FridayDanceObserve

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_observe', 'ПЛОЩАДЬ И ТАНЦЫ', 'large', 'webp'
    gs 'FridayDanceObserveText'

    *pl '══════════════════════════════════════════════'
    *pl ' ПЛОЩАДЬ И ТАНЦЫ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *p $FridayDanceText
    *pl ' '

    gs 'FridayDanceAdvanceRound'

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! Слухи горожан
! Возврат напрямую в MarketDance
! ================================================

#FridayDanceRumor

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_rumor', 'ГОРОДСКИЕ СЛУХИ', 'large', 'webp'

    gs 'CityRumorsGetText', 'dance'

    *pl '══════════════════════════════════════════════'
    *pl ' ГОРОДСКИЕ СЛУХИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if $CityRumorText <> '':
        *p $CityRumorText
    else:
        gs 'FridayDanceRumorText'
        *p $FridayDanceText
    end

    if $CityRumorPickedKey = 'tavern_scandal' or $CityRumorPickedKey = 'kitchen_sandra' or $CityRumorPickedKey = 'girls_behavior' or $CityRumorPickedKey = 'legare_amanda':
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl '<i>Если Сандра или сёстры услышат эти пересуды на площади, им будет не по себе среди почтенных горожан. Впрочем, Сандра с юности умеет гордо держать подбородок и делать вид, что чужие толки её не касаются.</i>'
        elseif FamilyCorruptionStage <= 3:
            *pl '<i>Слухи о трактире разносятся по площади, но семью это уже мало трогает. Сандра лишь усмехается: на танцах всегда чешут языками, а доход трактира и свобода семьи важнее чужих вздохов.</i>'
        else:
            *pl '<i>Горожане могут чесать языками сколько угодно: в «Жеребце» и в семье давно свои правила, и на ханжеские сплетни всем глубоко плевать.</i>'
        end
    end

    killvar '$CityRumorText'
    *pl ' '

    FridayDanceRumorCount += 1
    CityRumorLevel += 1

    if debug = 1:
        *pl '[DEBUG DANCE] CityRumorLevel: ' + STR(CityRumorLevel)
        *pl '[DEBUG DANCE] FridayDanceRumorCount: ' + STR(FridayDanceRumorCount)
        *pl '[DEBUG DANCE] PickedKey: ' + $CityRumorPickedKey
        *pl '[DEBUG DANCE] return: MarketDance'
        *pl ' '
    end

    gs 'FridayDanceAdvanceRound'

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! Меню знакомых NPC на танцах
! Возврат напрямую в MarketDance
! ================================================

#FridayDanceNpcTalkMenu

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_npc_talk_menu', 'ЗНАКОМЫЕ НА ПЛОЩАДИ', 'large', 'webp'
    gs 'UpdateGirlLocations'

    *pl '══════════════════════════════════════════════'
    *pl ' ЗНАКОМЫЕ НА ПЛОЩАДИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *p 'Вы оглядываетесь, пытаясь понять, кто из знакомых пришёл сегодня на танцы.'
    *pl ' '

    if $GirlLocation['sandra'] = 'DanceHall':
        gs 'ActUiPrepare', 'Подойти к Сандре', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceNpcTalk', 'sandra'
        end
    end

    if $GirlLocation['melissa'] = 'DanceHall':
        gs 'ActUiPrepare', 'Подойти к Мелиссе', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceNpcTalk', 'melissa'
        end
    end

    if $GirlLocation['amanda'] = 'DanceHall':
        gs 'ActUiPrepare', 'Подойти к Аманде', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceNpcTalk', 'amanda'
        end
    end

    if $GirlLocation['becky'] = 'DanceHall':
        gs 'ActUiPrepare', 'Подойти к Бекки', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceNpcTalk', 'becky'
        end
    end

    if $GirlLocation['clarissa'] = 'DanceHall':
        gs 'ActUiPrepare', 'Подойти к Клариссе', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceNpcTalk', 'clarissa'
        end
    end

    if $GirlLocation['legare'] = 'DanceHall':
        gs 'ActUiPrepare', 'Понаблюдать за Легаре', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceNpcTalk', 'legare'
        end
    end

    if $GirlLocation['lizette'] = 'DanceHall':
        gs 'ActUiPrepare', 'Заметить Лизетту', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceNpcTalk', 'lizette'
        end
    end

    if $GirlLocation['georgett'] = 'DanceHall':
        gs 'ActUiPrepare', 'Поговорить с Жоржеттой', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceNpcTalk', 'georgett'
        end
    end

    if $GirlLocation['irma'] = 'DanceHall':
        gs 'ActUiPrepare', 'Поговорить с Ирмой', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceNpcTalk', 'irma'
        end
    end

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! Короткая сцена с выбранным NPC на танцах
! Возврат напрямую в MarketDance
! ================================================

#FridayDanceNpcTalk

    gs 'NormalizeGirlKey', $ARGS[0]
    $DanceNpc = $GirlKey

    if $DanceNpc = '':
        msg 'Ошибка: FridayDanceNpcTalk вызван без NPC.'
        gt 'MarketDance'
    end

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_npc_talk', 'РАЗГОВОР НА ТАНЦАХ', 'large', 'webp'
    if $RealName[$DanceNpc] = '':
        gs 'EnsureGirlData', $DanceNpc
    end

    gs 'FridayDanceNpcTalkText', $DanceNpc

    *pl '══════════════════════════════════════════════'
    *pl ' РАЗГОВОР НА ТАНЦАХ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *p $FridayDanceText
    *pl ' '

    FridayDanceNpcTalkCount += 1

    if $DanceNpc = 'becky':
        gs 'BeckyFridayContactRegister'
    end

    if $DanceNpc = 'amanda':
        AmandaPublicAttention += 1
    elseif $DanceNpc = 'melissa':
        MelissaFamilyConcern += 1
    elseif $DanceNpc = 'sandra':
        SandraFamilyConcern += 1
    elseif $DanceNpc = 'clarissa':
        ClarissaDanceSeen += 1
    elseif $DanceNpc = 'legare':
        LegareDanceSeen += 1
    elseif $DanceNpc = 'lizette':
        AmandaLizaInfluence += 1
    elseif $DanceNpc = 'georgett':
        GeorgettePublicSeen += 1
    end

    if debug = 1:
        *pl '[DEBUG DANCE] NPC: ' + $DanceNpc
        *pl '[DEBUG DANCE] FridayDanceNpcTalkCount: ' + STR(FridayDanceNpcTalkCount)
        *pl '[DEBUG DANCE] return: MarketDance'
        *pl ' '
    end

    gs 'FridayDanceAdvanceRound'

    gs 'ActUiPrepare', 'Вернуться к знакомым', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FridayDanceNpcTalkMenu'
    end

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end

    killvar '$DanceNpc'
---

! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! Продвижение раунда праздника
! ================================================

#FridayDanceAdvanceRound

    FridayDancesCount += 1

    if FridayDancesCount > 5:
        FridayDancesCount = 5
    end
---

! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! Ограниченный танец сестёр без платья для танцев
! ================================================

#FridayDanceSisterLimited

    gs 'NormalizeGirlKey', $ARGS[0]
    $FridayDanceSisterGirl = $GirlKey

    if $FridayDanceSisterGirl <> 'amanda' and $FridayDanceSisterGirl <> 'melissa':
        killvar '$FridayDanceSisterGirl'
        gt 'MarketDance'
    end

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_sister_limited', 'танцы: сестра без платья — ограниченный танец', 'large', 'webp'
    gs 'EnsureGirlData', $FridayDanceSisterGirl
    gs 'FridayDanceNoDressText', $FridayDanceSisterGirl

    *pl '══════════════════════════════════════════════'
    *pl ' ТАНЕЦ С ' + UCASE($RealName[$FridayDanceSisterGirl])
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *p $FridayDanceText
    *pl ' '

    gs 'ActUiPrepare', 'Поболтать у края площади', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FridayDanceSisterLimitedTalk', $FridayDanceSisterGirl
    end

    if Friends[$FridayDanceSisterGirl] >= 5:
        gs 'ActUiPrepare', 'Осторожно потанцевать', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceSisterLimitedDance', $FridayDanceSisterGirl
        end
    end

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end

    killvar '$FridayDanceSisterGirl'
---

#FridayDanceSisterLimitedTalk

    gs 'NormalizeGirlKey', $ARGS[0]
    $FridayDanceSisterGirl = $GirlKey

    if $FridayDanceSisterGirl = '':
        gt 'MarketDance'
    end

    gs 'FridayDanceSisterLimitedTalkText', $FridayDanceSisterGirl

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_sister_limited_talk', 'РАЗГОВОР НА ТАНЦАХ', 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' РАЗГОВОР НА ТАНЦАХ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *p $FridayDanceText
    *pl ' '

    Friends[$FridayDanceSisterGirl] += 1

    if $FridayDanceSisterGirl = 'amanda':
        AmandaPublicAttention += 1
    elseif $FridayDanceSisterGirl = 'melissa':
        MelissaFamilyConcern += 1
    end

    gs 'FridayDanceAdvanceRound'

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end

    killvar '$FridayDanceSisterGirl'
---

#FridayDanceSisterLimitedDance

    gs 'NormalizeGirlKey', $ARGS[0]
    $FridayDanceSisterGirl = $GirlKey

    if $FridayDanceSisterGirl = '':
        gt 'MarketDance'
    end

    gs 'FridayDanceSisterLimitedDanceText', $FridayDanceSisterGirl

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_sister_limited_dance', 'ОСТОРОЖНЫЙ ТАНЕЦ', 'large', 'webp'
    *pl '══════════════════════════════════════════════'
    *pl ' ОСТОРОЖНЫЙ ТАНЕЦ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *p $FridayDanceText
    *pl ' '

    Friends[$FridayDanceSisterGirl] += 1
    sluttiness[$FridayDanceSisterGirl] += 1
    otkroven[$FridayDanceSisterGirl] += 1

    if $FridayDanceSisterGirl = 'amanda':
        AmandaPublicAttention += 1
        AmandaPlayerPath += 1
    elseif $FridayDanceSisterGirl = 'melissa':
        MelissaFamilyConcern += 1
    end

    gs 'FridayDanceAdvanceRound'

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end

    killvar '$FridayDanceSisterGirl'
---

! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! Стефан без приличного костюма на танцах
! ================================================

#FridayDanceStefanNoSuit

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_stefan_no_suit', 'танцы: Стефан без приличного костюма', 'large', 'webp'

    $FridayDanceNoSuitTarget = LCASE($ARGS[0])

    *pl '══════════════════════════════════════════════'
    *pl ' ПЛОЩАДЬ: НУЖЕН ПРИЛИЧНЫЙ КОСТЮМ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if $FridayDanceNoSuitTarget = 'becky':
        *pl 'Вы направляетесь к Бекки, но вовремя одёргиваете себя.'
        *pl 'Вдова весело переговаривается со знакомыми купцами, на ней нарядное платье с вышивкой. Вы бросаете взгляд на свои заношенные трактирные штаны и протертую на локтях куртку.'
        *pl '«Видит Ильматер... Если я сейчас подойду звать её в круг в таком виде — Бекки поднимет меня на смех, а весь торговый ряд будет неделю зубоскалить. Хозяин заведения должен выглядеть подобающе».'
        *pl ' '
        *pl 'Чтобы уверенно звать Бекки в центр площади, нужно купить приличный костюм у Ирмы (95 монет).'
    elseif $FridayDanceNoSuitTarget = 'inga':
        *pl 'Вы собираетесь подойти к Инге, но останавливаетесь в паре шагов.'
        *pl 'Девушка разодета для ярмарки, рядом крутятся городские стражники в начищенных бляхах. Ваш заношенный рабочий наряд на их фоне смотрится убого.'
        *pl '«Вылезать в центр круга в этих лохмотьях — только позориться. Сначала надо справить нормальную одежду».'
        *pl ' '
        *pl 'Нужно заглянуть к модистке Ирме и купить приличный костюм (95 монет).'
    elseif $FridayDanceNoSuitTarget = 'melissa':
        *pl 'Мелисса надела праздничное платье от Ирмы и держится строго, ловя на себе уважительные взгляды горожан. Вы хотите пригласить её в круг, но смотрите на свои потертые рукава...'
        *pl '«Она принарядилась, а я рядом буду выглядеть как нищий подмастерье. Весь город пальцами тыкать станет: вот он, хозяин "Жеребца", даже приличный наряд купить не в силах. В центр круга в таком виде лезть не стоит — разве что тихо поболтать у края площади».'
        *pl ' '
        *pl 'Для танцев в центре площади нужен приличный костюм от Ирмы (95 монет).'
    elseif $FridayDanceNoSuitTarget = 'amanda':
        *pl 'Аманда в новом наряде от Ирмы с восторгом смотрит на танцующих. Вы делаете шаг вперед, но тут же одёргиваете себя, глядя на свои рабочие штаны.'
        *pl '«Она сияет, а я рядом как оборванец. В центр площади выходить стыдно — только опозорю и себя, и сестру перед всем городом. Разве что отойти к краю площади и тихо перемолвиться парой слов».'
        *pl ' '
        *pl 'Для танцев в центре площади нужен приличный костюм от Ирмы (95 монет).'
    else:
        *pl 'Вы смотрите на праздничный круг танцующих. Вокруг все приоделись, а на вас обычная трактирная одежда. Выходить в центр в таком виде неловко — стоит купить приличный костюм у Ирмы (95 монет).'
    end

    *pl ' '

    if $FridayDanceNoSuitTarget = 'amanda' or $FridayDanceNoSuitTarget = 'melissa':
        gs 'ActUiPrepare', 'Отойти к краю площади (' + $RealName[$FridayDanceNoSuitTarget] + ')', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FridayDanceSisterLimited', $FridayDanceNoSuitTarget
        end
    end

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end

    killvar '$FridayDanceNoSuitTarget'
---

! ================================================
! FILE: modules/events/dance/friday_dance_core.qsps
! Debug-меню пятничных танцев
! Возврат напрямую в MarketDance
! ================================================

#FridayDanceDebugMenu

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/dance/friday_dance/friday_dance_debug_menu', 'DEBUG: ПЯТНИЧНЫЕ ТАНЦЫ', 'large', 'webp'
    gs 'GetCitySchedulePhase'
    gs 'UpdateGirlLocations'

    *pl '══════════════════════════════════════════════'
    *pl ' DEBUG: ПЯТНИЧНЫЕ ТАНЦЫ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *pl 'week: ' + STR(week)
    *pl 'time: ' + STR(time)
    *pl 'phase: ' + $CitySchedulePhase
    *pl 'FridayDanceDay: ' + STR(FridayDanceDay)
    *pl 'FridayDancesCount: ' + STR(FridayDancesCount)
    *pl 'MayorSpeechSeen: ' + STR(FridayDanceMayorSpeechSeen)
    *pl ' '
    *pl 'Аманда: ' + $GirlLocation['amanda']
    *pl 'Мелисса: ' + $GirlLocation['melissa']
    *pl 'Сандра: ' + $GirlLocation['sandra']
    *pl 'Бекки: ' + $GirlLocation['becky']
    *pl 'Кларисса: ' + $GirlLocation['clarissa']
    *pl 'Легаре: ' + $GirlLocation['legare']
    *pl 'Лизетта: ' + $GirlLocation['lizette']
    *pl 'Жоржетта: ' + $GirlLocation['georgett']
    *pl ' '
    *pl 'AmandaDanceDressReady: ' + STR(AmandaDanceDressReady)
    *pl 'MelissaDanceDressReady: ' + STR(MelissaDanceDressReady)
    *pl 'BeckyFridayContacts: ' + STR(BeckyFridayContacts)
    *pl ' '

    gs 'ActUiPrepare', 'Сбросить раунды праздника', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        FridayDancesCount = 0
        gt 'FridayDanceDebugMenu'
    end

    gs 'ActUiPrepare', 'Отметить речь мэра непрослушанной', 'mayor'
    act $ActUiLabel, $ActUiIconPath:
        FridayDanceMayorSpeechSeen = 0
        gt 'FridayDanceDebugMenu'
    end

    gs 'ActUiPrepare', 'Тест: слухи на площади', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FridayDanceRumor'
    end

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

