! ================================================
! FILE: modules/events/mayor/mayor_blackmail_investigation_text.qsps
! MODULE: events/mayor
! [AI-WORKED] Текст переработан / дополнен ассистентом 29.09.2026
! USER-OWNED TEXT
! Тексты расследования контрабанды и шантажа мэра
! ================================================

#MayorBlackmailPrintText
    $MayorBlackmailKey = $ARGS[0]

    if $MayorBlackmailKey = 'rumor_intro_1':
        *pl 'Ты проходишь мимо стойки и случайно слышишь разговор подвыпившего моряка с соседом по столу:'
        *pl ' '
        *pl '— Я тебе говорю, сам видел! Вчера перед закатом с безымянной шхуны свалили ящики — запечатанные, тяжёлые, аж кран трещал. А таможенники наши? Хе! Даже печать не сломали, кивнули и пропустили не глядя, будто там сливочное масло!'

    elseif $MayorBlackmailKey = 'rumor_intro_2':
        *pl 'У дальнего столба сурово перешёптываются наёмники в потрёпанных кожаных куртках:'
        *pl ' '
        *pl '— Нам платит чиновник, а вести велят аккуратно в Дикие Земли. Что в ящиках — хрен его знает, тяжеленное железо. Только вот странно это: обычно контрабанду ОТТУДА везут, а тут в Дикие Земли тащат...'

    elseif $MayorBlackmailKey = 'rumor_intro_3':
        *pl 'У стойки допивает кружку эля зевающий городской стражник, жалуясь приятелю:'
        *pl ' '
        *pl '— Опять привезли какую-то хрень в порт! И нам теперь из-за этого дерьма в двойной наряд ходить, пакгаузы охранять. Ни поспать толком, ни отдохнуть...'

    elseif $MayorBlackmailKey = 'rumor_intro_4':
        *pl 'Неподалёку портовый чиновник в потёртом камзоле размахивает руками перед купцом:'
        *pl ' '
        *pl '— Из-за этого товара, который стабильно раз в месяц прибывает, весь порт встаёт колом! Нормальные корабли разгрузить не можем, все служащие вокруг этого груза носятся, а остальная работа тупо стоит!'

    elseif $MayorBlackmailKey = 'rumor_refuse_1' or $MayorBlackmailKey = 'rumor_refuse_2' or $MayorBlackmailKey = 'rumor_refuse_3' or $MayorBlackmailKey = 'rumor_refuse_4':
        *pl 'Ты пытаешься ненавязчиво расспросить подробности, но собеседник тут же замолкает, бросает на тебя подозрительный взгляд и отрезает:'
        *pl ' '
        *pl '— Ты, парень, лучше пиво наливай да за залом следи. Это не тема для пустых разговоров. Не суй нос, куда не просят, если голова дорога!'

    elseif $MayorBlackmailKey = 'rumor_clerk_advise_1' or $MayorBlackmailKey = 'rumor_clerk_advise_2' or $MayorBlackmailKey = 'rumor_clerk_advise_3':
        *pl 'Ты наклоняешься ближе и пытаешься выведать детали. Собеседник воровато оглядывается, понижает голос до шёпота и качает головой:'
        *pl ' '
        *pl '— Тише ты! Про такие вещи вслух на весь трактир не болтают. Но если уж тебе так свербит и спать не можешь — поговори с портовым чиновником. Он в порту у пакгаузов крутится, может, что и научит...'

    elseif $MayorBlackmailKey = 'clerk_tavern_hint':
        *pl 'Ты аккуратно заводишь разговор с портовым чиновником о странных ночных грузах. Тот хитро прищуривается, делает глоток эля и негромко произносит:'
        *pl ' '
        *pl '— Дела портовые, трактирщик — штука тонкая, официальным отчётам не подлежащая. Если тебе действительно так интересна эта тема — наведайся ко мне в порт. Разговор у нас может выйти весьма любопытный... коли кошелёк твой не будет пуст.'

    elseif $MayorBlackmailKey = 'port_clerk_day_busy':
        *pl 'Ты подходишь к портовому чиновнику, но тот раздражённо машет на тебя папкой с бумагами:'
        *pl ' '
        *pl '— Ты чего тут отираешься, трактирщик? Работы невпроворот, солнце ещё высоко, а пакгаузные ведомости сами себя не заполнят! Не мешай работать. Заходи вечером, когда суета спадёт.'

    elseif $MayorBlackmailKey = 'port_clerk_evening_offer':
        *pl 'Вечерний порт погружается в сумерки. Ты находишь портового чиновника у стен пакгауза. Тот оглядывается по сторонам, улавливает твой взгляд и подходит ближе:'
        *pl ' '
        *pl '— Ну что, всё ещё свербит узнать, что за тайный груз прячут на складах? Изволь слушать внимательно. За небольшое денежное поощрение в сто спинтарий я сегодня вечером просто... "забуду" задвинуть засов на задней двери склада. И ночью ты сможешь залезть внутрь и полностью удовлетворить своё любопытство.'

    elseif $MayorBlackmailKey = 'port_clerk_bribe_paid':
        *pl 'Звонкие монеты моментально исчезают в глубоком кармане чиновника.'
        *pl ' '
        *pl '— Прелестно, трактирщик, — ухмыляется он. — Засов на задней двери пакгауза останется открытым. Приходи ночью, когда стража уйдет на дальний обход. Только смотри — если попадешься, я тебя знать не знаю.'

    elseif $MayorBlackmailKey = 'warehouse_night_first_try':
        *pl 'Под покровом ночной темноты ты пробираешься к задней двери пакгауза. Засов действительно не задвинут.'
        *pl ' '
        *pl 'Ты осторожно проскальзываешь внутрь. На столе у входа висит связка тяжёлых железных ключей от дверей склада. Ты снимаешь ключи и прячешь в карман.'
        *pl ' '
        *pl 'Затем ты подходишь к массивным окованным ящикам и пытаешься вскрыть один из них. Но едва твой инструмент касается замка — на крышке вспыхивает ярко-синяя магическая сигнальная печать! Раздаётся оглушительный гудящий звон, оглашающий весь склад.'
        *pl ' '
        *pl 'Чёрт! Сигнализация! Снаружи уже доносятся крики портовой стражи и топот тяжёлых сапог...'

    elseif $MayorBlackmailKey = 'warehouse_night_repeat_entry':
        *pl 'Используя заветную связку ключей, ты тихо отпираешь заднюю дверь пакгауза и проскальзываешь внутрь.'
        *pl ' '
        *pl 'В полумраке склада всё так же возвышаются ящики с таинственным грузом, запечатанные магическими знаками.'

    elseif $MayorBlackmailKey = 'warehouse_cargo_departed':
        *pl 'Ты оглядываешь склад, но место, где стояли ящики, пусто. Груз уехал в Дикие Земли... Теперь придётся ждать ещё месяц до следующего корабля.'

    elseif $MayorBlackmailKey = 'warehouse_lockpick_success':
        *pl 'Ты аккуратно орудуешь над магической печатью' + IIF(PlayerHasDexterityOil = 1, ', используя мазь «Ловкие пальцы» от Бекки. Мазь снижает трение и заглушает магический импульс', '') + '.'
        *pl ' '
        *pl 'Печать с тихим шипением гаснет! Крышка ящика поддаётся.'
        *pl ' '
        *pl 'Ты приподнимаешь крышку и замираешь: внутри стройными рядами лежат новенькие армейские самострелы, стальные клинки и боеприпасы! Сам факт неоспорим — в ящиках боевое оружие.'
        *pl ' '
        *pl 'Однако на самом верху лежит официальная ведомость с печатью магистрата, на которой чёрным по белому написано: «Сельскохозяйственный инвентарь: лопаты, грабли, мотыги».'
        *pl ' '
        *pl 'Ты забираешь накладную себе. Доказать вину мэра только этой бумажкой не выйдет — в ней записаны «грабли». Нужно копать дальше и привлекать важных горожан!'

    elseif $MayorBlackmailKey = 'warehouse_lockpick_failed_alarm':
        *pl 'Твои пальцы соскальзывают, и магическая печать на ящике вспыхивает ярким синим светом! Оглушительный звон сигнализации оглашает весь пакгауз.'
        *pl ' '
        *pl 'Снаружи доносятся тревожные свистки и топот стражи!'

    elseif $MayorBlackmailKey = 'alarm_escape_georgette':
        *pl 'Ты выбегаешь из пакгауза в ночную тьму. Стража уже настигает тебя, но внезапно из тени переулка выныривает Жоржетта.'
        *pl ' '
        *pl 'Она хвастает тебя за рукав, мгновенно затаскивает за штабель бочек и прижимает палец к губам. Стражники со свистом и руганью пробегают мимо.'
        *pl ' '
        *pl '— Совсем сдурел, парень? — тихо шепчет Жоржетта с ухмылкой. — Уноси ноги, пока они не вернулись.'

    elseif $MayorBlackmailKey = 'alarm_escape_run_success':
        *pl 'Ты выбегаешь из пакгауза, петляешь между штабелями грузов и ныряешь в тёмные портовые подворотни. Стража теряет твой след в ночной тьме.'

    elseif $MayorBlackmailKey = 'alarm_escape_caught_knockout':
        *pl 'Ты выбегаешь на причал, но из-за угла выскакивают двое стражников. Один из них со всего маху опускает тяжелый дубовый дубинец тебе на затылок...'
        *pl ' '
        *pl 'Перед глазами вспыхивают яркие искры, и всё погружается в полную темноту.'

    elseif $MayorBlackmailKey = 'wakeup_home_after_guards':
        *pl 'Ты открываешь глаза. Голова тяжело пульсирует тупой болью, а во рту стоит металлический привкус.'
        *pl ' '
        *pl 'Ты находишься у себя дома, на втором этаже трактира. Похоже, стража просто выкинула тебя у дверей, не став заводить официальное дело, или кто-то из своих притащил тебя домой.'

    elseif $MayorBlackmailKey = 'mayor_blackmail_failed_no_witness':
        *pl 'Ты входишь в кабинет мэра и уверенно выкладываешь на стол обе накладные.'
        *pl ' '
        *pl 'Мэр внимательно вчитывается в бумаги, а затем откидывается на спинку кресла и разражается циничным хохотом:'
        *pl ' '
        *pl '— Молодец, парень! Видна кровь предков, спору нет. Но скажи мне: как ты собираешься связать эти бумажки лично со мной?'
        *pl ' '
        *pl 'Мэр насмешливо щурится и чеканит:'
        *pl ' '
        *pl '— Эта интрига идёт с самого верха. Если ты пойдёшь в столицу — твоё дело развалят на первом же заседании. А тебя самого прибьют в первой же подворотне, чтобы не наболтал лишнего и не подставил важных людей. Посему ступай вон!'
        *pl ' '
        *pl 'Ты понимаешь, что без живого свидетеля одна лишь бумажка в руках обычного трактирщика — не аргумент.'

    elseif $MayorBlackmailKey = 'mayor_blackmail_success_witness':
        *pl 'Ты входишь в кабинет мэра и выкладываешь на стол обе накладные.'
        *pl ' '
        *pl 'Мэр насмешливо щурится: «И как ты собираешься связать эти бумаги со мной, парень? В столице тебя со с потрохами сожрут!»'
        *pl ' '
        *pl 'Ты спокойно смотришь ему в глаза и произносишь:'
        *pl ' '
        *pl '— А у меня есть живой свидетель. Раненый наёмник из вашего каравана прямо сейчас находится под полной защитой отца Герхарда в соборе Ильматера.'
        *pl ' '
        *pl 'Лицо мэра моментально наливается багровой краской. Он сдавленно матерится, хватаясь за край стола:'
        *pl ' '
        *pl '— Ах ты сопляк... Да если вы будете упрямиться, вас обоих прирежут!'
        *pl ' '
        *pl '— Зачем вам такие проблемы, господин мэр? — не отступаешь ты. — Просто ускорьте процесс подтверждения дворянства, не трогайте Сандру и моих сестёр, и я забуду обо всём, что узнал. Я отдам вам накладные, а наёмник будет молчать.'
        *pl ' '
        *pl 'Мэр скрежещет зубами, осознавая, что проиграл:'
        *pl ' '
        *pl '— Видна кровь Лермонтов... Выкрутил-таки мне руки, босяк!'
        *pl ' '
        *pl 'Он достаёт из шкафа дорожный сундук и швыряет тебе роскошный кафтан:'
        *pl ' '
        *pl '— Забирай! Это дворянский костюм моего покойного сына. Но помни: до тех пор, пока столица официально не пришлёт подтверждение, носить его в городе запрещено — стража задержит за самозванство!'
        *pl ' '
        *pl '— Сандру и твоих девиц я больше не трону. Письмо в столицу с личной просьбой ускорить рассмотрение твоего дела я отправлю сегодня же. И в довершение — перед пятничными танцами я лично похвалю твой трактир перед горожанами. А теперь забирай всё и проваливай!'

    end
    killvar '$MayorBlackmailKey'
---
