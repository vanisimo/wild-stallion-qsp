! ================================================
! FILE: modules/events/mayor/mayor_honorable_path_text.qsps
! MODULE: events/mayor
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.10.2026
! Нарративные тексты честного пути (собор, милосердие Герхарда, исцеление свидетеля, признание Герцогини)
! ================================================

#MayorHonorablePrintText
    $HonorableTextId = $ARGS[0]

    if $HonorableTextId = 'mercenary_church_intro':
        *pl 'Отец Герхард торопливо оглядывает полупустой неф собора, берёт тебя под локоть и уводит в полутёмный боковой придел храма, куда обычно не заходят прихожане.'
        *pl ' '
        *pl '— Сын мой Стефан... — священник понижает голос до шёпота и тревожно очерчивает святой круг. — Ильматер заповедал нам милосердие к страждущим, но то, что произошло минувшей ночью, грозит бедой всему городу.'
        *pl ' '
        *pl 'Он указывает на тяжёлую кованую дверь, ведущую в храмовый склеп:'
        *pl ' '
        *pl '— Глухой ночью к ступеням собора приполз человек. Наёмник в изрубленной кольчуге, утыканный стрелами. В бреду он кричал о предательстве чиновников, королевском караване оружия и резне в ущелье за стеной. Он истекает чёрной кровью — орочьи стрелы были отравлены ядом дикарей!'

    elseif $HonorableTextId = 'mercenary_examine_text':
        *pl 'В прохладном склепе храма, на простом соломенном тюфяке, лежит крупный седеющий воин. Его лицо покрыто смертельной пепельной бледностью, а дыхание вырывается из груди с хриплым свистом.'
        *pl ' '
        *pl 'Ты склоняешься над ним. В сжатом окровавленном кулаке воин судорожно сжимает обрывок пергамента с гербовой печатью. Орочий яд расползается от раны в плече тёмными вздувшимися венами.'
        *pl ' '
        *pl '— Обычные травы и молитвы тут бессильны, — сокрушённо шепчет отец Герхард. — Этот яд варят шаманы диких чащоб. Но я знаю: полуэльфийка Ирма хранит древние соки Древа Жизни. Только её бальзам способен очистить кровь и вернуть человека с порога могилы!'

    elseif $HonorableTextId = 'irma_balm_given_text':
        *pl 'Ты приходишь в мастерскую и без утайки рассказываешь Ирме о раненом наёмнике в храмовом склепе.'
        *pl ' '
        *pl 'Полуэльфийка внимательно слушает тебя, и в её глазах вспыхивает уважение:'
        *pl ' '
        *pl '— Ты пришёл не ради золота и не ради шантажа, Стефан. Ты рискуешь собой, чтобы спасти невинную жизнь. Это поступок настоящего мужчины.'
        *pl ' '
        *pl 'Она достаёт из резного ларца хрустальный флакон с густым серебристо-зелёным маслом, пахнущим молодой корой и весенним ветром:'
        *pl ' '
        *pl '— Это вытяжка из смолы Древа Жизни. Напои воина и вотри бальзам прямо в рану. Древняя сила выжжет орочий яд.'

    elseif $HonorableTextId = 'mercenary_heal_success_text':
        *pl 'Ты возвращаешься в собор и осторожно вливаешь целебный настой в пересохшие губы воина, а остаток втираешь в почерневшие края раны.'
        *pl ' '
        *pl 'Спустя пару минут наёмник судорожно вздыхает, смертельная бледность сменяется живым румянцем, а чёрные жилы на коже бледнеют и исчезают. Воин распахивает ясные глаза и опирается на локоть:'
        *pl ' '
        *pl '— Хвала Ильматеру... и тебе, парень... — хрипит он, протягивая тебе пергамент. — Наш конвой наняла мэрия, чтобы тайно провести караван армейских клинков за стену. Но в ущелье налетели дикари клана «Красного Топора». Они перебили половину моих ребят и уволокли мечи к себе в чащу!'
        *pl ' '
        *pl 'Отец Герхард благоговейно очерчивает святой круг и кладёт руку тебе на плечо:'
        *pl ' '
        *pl '— Ты совершил подвиг милосердия, Стефан. Вот священная Булла паломника — с ней стража беспрекословно откроет городские ворота. Ступай за стену, найди следы каравана и отведи угрозу от нашего дома! А свидетель будет укрыт в святой обители.'

    elseif $HonorableTextId = 'honorable_petition_triumph_text':
        *pl 'В парадной зале магистрата непривычно тихо и торжественно. Перед собравшимися старейшинами города, купцами и офицерами гарнизона выступает отец Герхард.'
        *pl ' '
        *pl '— Братья и сестры! Пред лицом Ильматера всеблагого сей молодой человек, Стефан Лонгкок, явил пример истинной рыцарской доблести. Он спас жизнь воину, отвёл от наших стен орочью резню и сохранил мир на рубежах фронтира!'
        *pl ' '
        *pl 'Священник разворачивает свиток с золотой печатью самой герцогини Кончиты дель Семени:'
        *pl ' '
        *pl '— По нашему общему прошению Её Милость Кончита соблаговолила восстановить историческую справедливость. Отныне за Стефаном подтверждается благородное достоинство его отца, барона Лермонта, с присвоением звания рыцаря пограничья!'
        *pl ' '
        *pl 'Мэр Родриго Борджиа, побледневший и с трудом скрывающий волнение, вынужден лично приложить городскую печать и под громкие аплодисменты преподнести тебе великолепный бархатный дворянский наряд со шпагой!'
        *pl ' '
        *pl 'Отныне ни один клерк и ни один сборщик податей не посмеет смотреть на тебя сверху вниз, а имя твоей матери навсегда очищено от пересудов.'
    end
---
