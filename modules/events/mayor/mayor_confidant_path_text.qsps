! ================================================
! FILE: modules/events/mayor/mayor_confidant_path_text.qsps
! MODULE: events/mayor
! [AI-WORKED] Текст переработан / дополнен ассистентом 20.10.2026
! Нарративные тексты грязного пути (циничный союз с мэром, получение пропуска и дворянского патента)
! ================================================

#MayorConfidantPrintText
    $ConfidantTextId = $ARGS[0]

    if $ConfidantTextId = 'confidant_offer_intro':
        *pl 'Ты заходишь в кабинет мэра с совершенно иным выражением лица — без вызова и без затаённой злобы. Мэр Борджиа отрывается от бумаг и вопросительно приподнимает кустистую бровь.'
        *pl ' '
        *pl '— Я всё обдумал, господин мэр, — спокойно произносишь ты. — Мы оба взрослые люди, и я знаю цену взаимной пользе. Семья готова быть сговорчивой, если magistrat готов отплатить настоящим покровительством. Что вам нужно?'
        *pl ' '
        *pl 'На губах Борджиа расползается довольная, сытая улыбка. Он встаёт из-за стола, хлопает тебя по плечу и жестом закрывает засов на двери:'
        *pl ' '
        *pl '— Вот это разговор не мальчика, но настоящего хозяина! Забудь про юношеские обиды, Стефан. В этом городе выживают те, кто умеет делить пирог. У меня есть для тебя дело первостепенной важности.'
        *pl ' '
        *pl 'Он понижает голос почти до свиста:'
        *pl ' '
        *pl '— Из столицы через наш порт прошёл тайный королевский обоз с оружием. Я отправил его за городскую стену, но караван бесследно сгинул в предгорьях. Конвой перебит! Городская стража — трусы и бюрократы, они боятся сунуть нос в чащу. А мне нужен ловкий парень с крепкими кулаками и головой на плечах. Выясни, кто посмел напасть на людей магистрата за стеной. Справишься — я лично вручу тебе дворянский патент, сделаю советником магистрата и навсегда сниму налоговое бремя с твоего кабака!'

    elseif $ConfidantTextId = 'confidant_accept_text':
        *pl '— По рукам, господин мэр. Я найду караван и отведу удар от города.'
        *pl ' '
        *pl 'Борджиа одобрительно кивает, достаёт из ящика стола тяжелый кожаный кошель со ста пятьюдесятью звонкими спинтариями и пергамент с золотой печатью магистрата:'
        *pl ' '
        *pl '— Держи, парень. Это особый Пропуск Магистрата — с ним стража на городских воротах выпустит тебя за стену в любое время суток без лишних вопросов. Плюс в конюшне магистрата для тебя оседлают крепкого боевого коня. Ступай на Северную дорогу. И помни: ни слова церкви!'

    elseif $ConfidantTextId = 'confidant_report_text':
        *pl 'Ты входишь в кабинет мэра и выкладываешь на стол подробный отчёт: караван разграбили дикари клана «Красного Топора», но угроза взята под контроль, а следы ведут к междоусобной резне среди самих дикарей.'
        *pl ' '
        *pl 'Борджиа шумно выдыхает, словно с его плеч свалилась каменная глыба, и наливает два кубка крепкого южного вина:'
        *pl ' '
        *pl '— Ильматер свидетель, Стефан, ты спас мою голову от столичной плахи! Ты доказал, что достоин носить имя своего благородного отца.'
        *pl ' '
        *pl 'Мэр достаёт роскошный ларец из красного дерева, обитый бархатом:'
        *pl ' '
        *pl '— Вот твоё свидетельство о дворянском достоинстве, подписанное моей рукой и скреплённое печатью магистрата. Отныне ты — официально признанный дворянин дома Лермонтов и советник города! А этот бархатный костюм знатного господина — скромный подарок от магистрата.'
        *pl ' '
        *pl 'Борджиа тепло жмёт твою руку:'
        *pl ' '
        *pl '— И насчёт твоей матери, Сандры... Забудь о прошлых визитах. Отныне она мать знатного господина и пользуется моим полным уважением.'
    end
---
