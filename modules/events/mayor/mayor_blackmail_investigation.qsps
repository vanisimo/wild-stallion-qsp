! ================================================
! FILE: modules/events/mayor/mayor_blackmail_investigation.qsps
! MODULE: events/mayor
! [AI-WORKED] Текст переработан / дополнен ассистентом 29.09.2026
! Расследование контрабанды Мэра (слухи у стойки -> портовый чиновник -> склад -> взлом -> накладная -> шантаж)
! ================================================

#TavernBarRumorRoll
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'РАЗГОВОРЫ У СТОЙКИ'
    gs 'SceneShowVisual', 'images/actions/tavern/tavern_bar_work/bar_talk', 'Разговоры посетителей у стойки', 'large', 'webp'

    TavernBarRumorPick = RAND(1, 4)

    gs 'MayorBlackmailPrintText', 'rumor_intro_' + STR(TavernBarRumorPick)
    *pl ' '

    gs 'ActUiPrepare', 'Подробно расспросить', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernBarRumorDetail', TavernBarRumorPick
    end

    gs 'ActUiPrepare', 'Вернуться к работе', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#TavernBarRumorDetail
    *clr
    clr
    cla

    TavernBarRumorPick = ARGS[0]

    gs 'ShowLocationScreenTitle', 'ПОДРОБНОСТИ РАЗГОВОРА'
    gs 'SceneShowVisual', 'images/actions/tavern/tavern_bar_work/bar_talk_detail', 'Разговор у стойки', 'large', 'webp'

    if MayorSecondTalkDone = 0:
        gs 'MayorBlackmailPrintText', 'rumor_refuse_' + STR(TavernBarRumorPick)
    else:
        if TavernBarRumorPick = 4:
            gs 'MayorBlackmailPrintText', 'clerk_tavern_hint'
            PortClerkBribeHint = 1
        else:
            gs 'MayorBlackmailPrintText', 'rumor_clerk_advise_' + STR(TavernBarRumorPick)
            PortClerkBribeHint = 1
        end
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernMain'
    end
---

#PortClerkTalk
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОРТОВЫЙ ЧИНОВНИК'
    gs 'SceneShowVisual', 'images/locations/port/clerk', 'Портовый чиновник у пакгаузов', 'large', 'webp'

    if time <> 4:
        gs 'MayorBlackmailPrintText', 'port_clerk_day_busy'
        *pl ' '

        gs 'ActUiPrepare', 'Вернуться к причалу', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Port'
        end
    else:
        gs 'MayorBlackmailPrintText', 'port_clerk_evening_offer'
        *pl ' '

        PortClerkBribeFee = 100

        if money >= PortClerkBribeFee:
            gs 'ActUiPrepare', 'Дать взятку (100 спинтарий)', 'gift'
            act $ActUiLabel, $ActUiIconPath:
                money -= PortClerkBribeFee
                PortWarehouseUnlocked = 1
                PortWarehouseUnlockedDay = day
                gt 'PortClerkBribePaySuccess'
            end
        else:
            *pl '<i>У тебя недостаточно монет для взятки (' + STR(money) + ' / 100 спинтарий).</i>'
            *pl ' '
        end

        gs 'ActUiPrepare', 'Уйти', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Port'
        end
    end
---

#PortClerkBribePaySuccess
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ДОГОВОРЁННОСТЬ С ЧИНОВНИКОМ'
    gs 'SceneShowVisual', 'images/locations/port/clerk_bribe', 'Взятка портовому чиновнику', 'large', 'webp'

    gs 'MayorBlackmailPrintText', 'port_clerk_bribe_paid'
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться к причалу', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Port'
    end
---

#PortNightWarehouseSneak
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'НОЧНОЙ СКЛАД ПАКГАУЗА'
    gs 'SceneShowVisual', 'images/locations/port/warehouse_night', 'Тайный склад в порту', 'large', 'webp'

    if PlayerHasWarehouseKeys = 0:
        ! Первая ночь: нашли ключи, но первая попытка открыть ящик 100% срывает сигнализацию
        PlayerHasWarehouseKeys = 1
        PortWarehouseLockpickDeadline = day + 3
        PortWarehouseLockpickTriesLeft = 3

        gs 'MayorBlackmailPrintText', 'warehouse_night_first_try'
        *pl ' '

        gs 'ActUiPrepare', 'Пытаться спасаться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'PortWarehouseAlarmEscape'
        end
    else:
        ! Повторные ночи: у игрока уже есть ключи
        gs 'MayorBlackmailPrintText', 'warehouse_night_repeat_entry'
        *pl ' '

        if PortWarehouseLockpickTriesLeft <= 0 or day > PortWarehouseLockpickDeadline:
            gs 'MayorBlackmailPrintText', 'warehouse_cargo_departed'
            *pl ' '

            gs 'ActUiPrepare', 'Покинуть склад', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt 'Port'
            end
        else:
            gs 'ActUiPrepare', 'Пытаться вскрыть печать на ящике', 'work'
            act $ActUiLabel, $ActUiIconPath:
                gt 'PortWarehouseLockpickTry'
            end

            gs 'ActUiPrepare', 'Уйти со склада', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt 'Port'
            end
        end
    end
---

#PortWarehouseLockpickTry
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ВЗЛОМ МАГИЧЕСКОЙ ПЕЧАТИ'
    gs 'SceneShowVisual', 'images/locations/port/warehouse_seal', 'Магическая печать на ящике', 'large', 'webp'

    LockpickChance = 30

    if PlayerHasDexterityOil = 1:
        LockpickChance += 40
    end

    LockpickRoll = RAND(1, 100)

    if LockpickRoll <= LockpickChance:
        ! Успех взлома! Печать снята без шума
        PlayerHasWeaponShipmentInvoice = 1
        PlayerKnows_MayorWeaponsToWildLands = 1

        gs 'MayorBlackmailPrintText', 'warehouse_lockpick_success'
        *pl ' '

        gs 'ActUiPrepare', 'Забрать накладную и уйти', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Port'
        end
    else:
        ! Неудача: сработала сигнализация!
        PortWarehouseLockpickTriesLeft -= 1

        gs 'MayorBlackmailPrintText', 'warehouse_lockpick_failed_alarm'
        *pl ' '

        gs 'ActUiPrepare', 'Спасаться бегством!', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'PortWarehouseAlarmEscape'
        end
    end
---

#PortWarehouseAlarmEscape
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОБЕГ ОТ СТРАЖИ'
    gs 'SceneShowVisual', 'images/locations/port/alarm_escape', 'Побег из портового пакгауза', 'large', 'webp'

    if GeorgetteKnown = 1 and Friends['georgette'] >= 10:
        ! Жоржетта укрывает Стефана в переулке
        gs 'MayorBlackmailPrintText', 'alarm_escape_georgette'
        *pl ' '

        gs 'ActUiPrepare', 'Поблагодарить Жоржетту и уйти', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Street'
        end
    else:
        EscapeRoll = RAND(1, 100)

        if EscapeRoll <= 50:
            ! Успешный побег
            gs 'MayorBlackmailPrintText', 'alarm_escape_run_success'
            *pl ' '

            gs 'ActUiPrepare', 'Замести следы и уйти', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt 'Street'
            end
        else:
            ! Неудача: стража догоняет и бьёт дубинкой по голове
            gs 'MayorBlackmailPrintText', 'alarm_escape_caught_knockout'
            *pl ' '

            gs 'ActUiPrepare', 'Очнуться дома', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt 'PortWarehouseWakeupHome'
            end
        end
    end
---

#PortWarehouseWakeupHome
    *clr
    clr
    cla

    ! Стефан очухался в комнате Сандры или Мелиссы с гудящей головой
    time = 1
    day += 1

    gs 'ShowLocationScreenTitle', 'ПРОБУЖДЕНИЕ ДОМА'
    gs 'SceneShowVisual', 'images/locations/tavern/second_floor', 'Пробуждение с гудящей головой', 'large', 'webp'

    gs 'MayorBlackmailPrintText', 'wakeup_home_after_guards'
    *pl ' '

    gs 'ActUiPrepare', 'Встать с кровати', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#MayorOfficeConfrontBlackmail
    *clr
    clr
    cla

    if EquippedChest = 1 or EquippedHead = 1 or EquippedWeapon = 1:
        gs 'ShowLocationScreenTitle', 'ПРИЁМНАЯ МЭРИИ'
        gs 'SceneShowVisual', 'images/locations/mayor/office/clerk', 'Клерк останавливает у дверей', 'large', 'webp'

        *pl 'Клерк в приёмной с ужасом глядит на твоё снаряжение и выставляет руки вперёд:'
        *pl ' '
        *pl '— Помилуйте, молодой человек! В этих стенах хождение в боевых доспехах и с мечом наголо строжайше запрещено! Извольте немедленно сложить оружие и бронь в сундук у себя дома перед аудиенцией!'
        *pl ' '

        gs 'ActUiPrepare', 'Вернуться в приёмную', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOffice'
        end
        exit
    end

    gs 'ShowLocationScreenTitle', 'КАБИНЕТ МЭРА: ШАНТАЖ'
    gs 'SceneShowVisual', 'images/locations/mayor/office/mayor_confront', 'Шантаж мэра в кабинете', 'large', 'webp'

    if MercenaryAlive = 0:
        ! Наёмник убит: только накладные -> Провал шантажа
        gs 'MayorBlackmailPrintText', 'mayor_blackmail_failed_no_witness'
        BlackmailFailed = 1
    else:
        ! Наёмник спасён: есть свидетель у Отца Герхарда -> Успех шантажа!
        gs 'MayorBlackmailPrintText', 'mayor_blackmail_success_witness'

        SandraMayorVisitsStopped = 1
        MayorWroteCapitalLetter = 1
        PlayerHasNobleSuit = 1
        MayorTavernPublicPraise = 1
        MayorBlackmailSuccess = 1

        if LOC('KnowledgeRegisterFact') = 1:
            gs 'KnowledgeRegisterFact', 'Stefan_MayorBlackmailDone_1'
        end
    end

    *pl ' '

    gs 'ActUiPrepare', 'Покинуть кабинет мэра', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---
