! ================================================
! FILE: modules/events/mayor/mayor_blackmail_investigation_town_text.qsps
! MODULE: events/mayor
! [AI-WORKED] Текст переработан / дополнен ассистентом 29.09.2026
! USER-OWNED TEXT
! Тексты расследования в городе (Ирма, Драупнир, Легаре, Корабль, Отец Герхард, Монгол, Ворота)
! ================================================

#MayorBlackmailTownPrintText
    $TownTextKey = $ARGS[0]

    if $TownTextKey = 'irma_talk_success':
        *pl 'Ты достаёшь из кармана накладную на инструменты и выкладываешь перед Ирмой. Портниха прищуривается, бегло пробегает взглядом по строчкам и качает головой:'
        *pl ' '
        *pl '— А, эта бумага... Мэрия официально заявляет, будто отправляет лояльным оркам инструменты для возделывания почвы. Мэр уверяет, что так они удваивают урожай редких трав, растущих только в Диких Землях — для кремов и мазей. Я лично такое не одобряю — от орков всегда одни проблемы.'
        *pl ' '
        *pl 'Ты тихо наклоняешься и шепчешь, что своими глазами видел в тех ящиках армейское оружие.'
        *pl ' '
        *pl 'Ирма ахает, прикрывая рот рукой, и на её лице вспыхивает праведный гнев:'
        *pl ' '
        *pl '— Невероятно! Те, кто вооружает орков, вооружают собственную смерть! Как они смеют... Но как помочь тебе доказательствами — я не знаю. Раз уж ты влез в столь опасное дело, на держи: плотный кожаный нагрудник. По крайней мере, защитит от удара в грудь. И поговори с другими важными горожанами — им это точно не понравится.'

    elseif $TownTextKey = 'irma_talk_refused':
        *pl 'Ты пытаешься завести с Ирмой разговор про накладные и портовые грузы, но портниха лишь строго сдвигает брови:'
        *pl ' '
        *pl '— Стефан, не суй свой нос в канцелярию мэра и портовые отчёты. У тебя есть свой трактир, вот им и занимайся!'

    elseif $TownTextKey = 'draupnir_talk_success':
        *pl 'Ты находишь Драупнира в мастерской и расскажи ему всю историю про запечатанный склад и оружие под видом лопат.'
        *pl ' '
        *pl 'Гном с уважением похлопывает тебя по плечу:'
        *pl ' '
        *pl '— А ты мне нравишься, парень! Узнал про визиты Сандры, но не стал устраивать глупый скандал и показал себя умом. А то, что мэр творит с оружием для орков — это преступление!'
        *pl ' '
        *pl 'Гном снимает со стены и протягивает тебе короткий, но невероятно массивный и острый клинок:'
        *pl ' '
        *pl '— Держи! Для меня это полноценный меч гномьей работы, для тебя — как длинный кинжал. Но в бою это лучше, чем ничего!'

    elseif $TownTextKey = 'draupnir_talk_refused':
        *pl 'Драупнир лишь хмуро отмахивается от тебя:'
        *pl ' '
        *pl '— У меня работы невпроворот, трактирщик. Не мешай опилки перебирать!'

    elseif $TownTextKey = 'legare_talk_success':
        *pl 'Ты находишь торговца Легаре и без лишних свидетелей рассказываешь ему про тайный груз на складе.'
        *pl ' '
        *pl 'Легаре внимательно выслушивает тебя, хмыкает и задумчиво водит пальцем по подбородку:'
        *pl ' '
        *pl '— Ага... Теперь все кусочки мозаики складываются! Это столичная интрига, Стефан. Высшие чины играют в свои игры с Дикими Землями.'
        *pl ' '
        *pl 'Он качает головой и достаёт крепкий кожаный шлем:'
        *pl ' '
        *pl '— Мой тебе совет: не лезь в эту кашу, целее будешь. Но раз уж не удержишься — на вот, надень кожаный шлем. Голову беречь надо.'

    elseif $TownTextKey = 'legare_talk_refused':
        *pl 'Легаре лицемерно усмехается и сводит разговор на нет:'
        *pl ' '
        *pl '— Сплетни из порта меня не интересуют, парень. Занимайся пивом.'

    elseif $TownTextKey = 'ship_shop_intro':
        *pl 'На палубе столичного корабля торговец раскладывает редкое военное снаряжение.'
        *pl ' '
        *pl '— Ну что, трактирщик? Коли тебе нужно добротное снаряжение для дальних поездок — плати монеты. Цена кусается, но качество гарантирую!'

    elseif $TownTextKey = 'gerhard_talk_text':
        *pl 'Ты приходишь в собор Ильматера и сообщаешь отцу Герхарду о контрабанде оружия, которую покрывает мэр.'
        *pl ' '
        *pl 'Глаза священника вспыхивают торжествующим огнём. Вражда между собором и мэрией тянется давно, и такие новости для падре — настоящий дар:'
        *pl ' '
        *pl '— Святой Ильматер не оставит грешников без карающего перста! Мэр зашёл слишком далеко!'
        *pl ' '
        *pl 'Отец Герхард подписывает и вручает тебе тяжёлый пергамент с красной печатью собора:'
        *pl ' '
        *pl '— Держи, Стефан. Сие есть Булла паломника. С этой бумагой стража у городских ворот обязан беспрепятственно выпустить тебя за черту города и не задаст ни единого вопроса.'
        *pl ' '
        *pl 'Он кладёт руку тебе на плечо и добавляет:'
        *pl ' '
        *pl '— Но помни: куда в Дикие Земли пешком без лошади? Ступай на рынок — там раз в неделю по полдням торгует верховыми конями монгол. Без коня в тех диких местах не выжить!'

    elseif $TownTextKey = 'mongol_offer_text':
        *pl 'В центре рынка стоит коренастый торговец-монгол в меховой шапке, удерживая за поводья крепких, низкорослых верховых коней.'
        *pl ' '
        *pl '— Эй, хозяин! Конь нужен? Крупный, выносливый, в любую степь и в любые дикие леса пройдёт! Всего сто пятьдесят спинтарий — и конь твой!'

    elseif $TownTextKey = 'mongol_already_bought':
        *pl 'Торговец-монгол приветливо кивает тебе:'
        *pl ' '
        *pl '— Твой конь уже ждёт тебя в конюшне за таверной, хозяин! Береги его!'

    elseif $TownTextKey = 'mongol_bought_success':
        *pl 'Ты отдаёшь монеты, и торговец передаёт тебе поводья верного выносливого коня.'
        *pl ' '
        *pl '— Отличная покупка! Слуга отведёт коня прямо в твою конюшню за трактиром «Дикий Жеребец».'

    elseif $TownTextKey = 'guard_hint_text':
        *pl 'Ты подходишь к знакомому стражнику на площади. Тот воровато оглядывается и тихим шёпотом сообщает тебе:'
        *pl ' '
        *pl '— Слушай, парень... По секрету скажу: охраняемый наёмниками груз прошёл через Северные ворота в сторону Эльфийского леса. Коли ищешь их следы — держи путь туда!'

    elseif $TownTextKey = 'gates_no_bulla':
        *pl 'Ты подходишь к городским воротам, но стражники выставляют алебарды:'
        *pl ' '
        *pl '— Стоять! Выезд за черту города без специального разрешения запрещён. Получи Буллу паломника у отца Герхарда в соборе — тогда и поговорим!'

    elseif $TownTextKey = 'gates_no_horse':
        *pl 'Стражник просматривает твою Буллу паломника и качает головой:'
        *pl ' '
        *pl '— Грамота в порядке, но пешком в Дикие Земли мы тебя не выпустим — это верная смерть. Купи лошадь у монгола на рынке, поставь в конюшню — и милости просим!'

    elseif $TownTextKey = 'gates_pass_ready':
        *pl 'Стражники тщательно проверяют Буллу паломника, смотрят на твоего выносливого коня и отдают честь:'
        *pl ' '
        *pl '— Проход открыт! Счастливого пути в Дикие Земли, паломник.'

    elseif $TownTextKey = 'wild_lands_depart_text':
        *pl 'Ты выезжаешь верхом на коне через тяжелые ворота города. Впереди простирается опасная дорога в Дикие Земли...'

    end
    killvar '$TownTextKey'
---
