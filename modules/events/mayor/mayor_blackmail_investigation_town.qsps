#IrmaBlackmailTalk
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С ИРМОЙ'
    gs 'SceneShowVisual', 'images/locations/shops/irma_shop/irma', 'Ирма в ателье', 'large', 'webp'

    IrmaBlackmailTalkDone = 1

    if Friends['irma'] >= 10:
        PlayerArmorChest = 'leather_vest'
        gs 'MayorBlackmailTownPrintText', 'irma_talk_success'
    else:
        gs 'MayorBlackmailTownPrintText', 'irma_talk_refused'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Назад в ателье', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IrmaShop'
    end
---

#DraupnirBlackmailTalk
