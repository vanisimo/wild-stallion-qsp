    end
---

#CityGatesWildLands
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ГОРОДСКИЕ ВОРОТА'
    gs 'SceneShowVisual', 'images/locations/town/city_gates', 'Городские ворота к Диким Землям', 'large', 'webp'

    if PlayerHasPilgrimBulla = 0:
        gs 'MayorBlackmailTownPrintText', 'gates_no_bulla'
        *pl ' '

        gs 'ActUiPrepare', 'Вернуться на улицу', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Street'
        end
    elseif PlayerHasHorse = 0:
        gs 'MayorBlackmailTownPrintText', 'gates_no_horse'
        *pl ' '

        gs 'ActUiPrepare', 'Вернуться на улицу', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Street'
        end
    else:
        gs 'MayorBlackmailTownPrintText', 'gates_pass_ready'
        *pl ' '

        gs 'ActUiPrepare', 'Выехать за ворота в Дикие Земли', 'travel'
        act $ActUiLabel, $ActUiIconPath:
            gt 'WildLandsGatesDepart'
        end

        gs 'ActUiPrepare', 'Остаться в городе', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Street'
        end
    end
---

#WildLandsGatesDepart
