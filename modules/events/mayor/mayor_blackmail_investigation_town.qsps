---

#ShipGearShop
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ТОРГОВЕЦ НА КОРАБЛЕ'
    gs 'SceneShowVisual', 'images/locations/port/capital_ship', 'Капитанский корабль из столицы', 'large', 'webp'

    gs 'MayorBlackmailTownPrintText', 'ship_shop_intro'
    *pl ' '

    if PlayerArmorChest <> 'leather_vest':
        if money >= 150:
            gs 'ActUiPrepare', 'Купить кожаный нагрудник (150 монет)', 'gift'
            act $ActUiLabel, $ActUiIconPath:
                money -= 150
                PlayerArmorChest = 'leather_vest'
                gt 'ShipGearShop'
            end
        else:
            *pl '<i>Недостаточно денег для нагрудника (150 монет).</i>'
        end
    end

    if PlayerWeapon <> 'dwarven_shortsword':
        if money >= 200:
            gs 'ActUiPrepare', 'Купить гномий меч (200 монет)', 'gift'
            act $ActUiLabel, $ActUiIconPath:
                money -= 200
                PlayerWeapon = 'dwarven_shortsword'
                gt 'ShipGearShop'
            end
        else:
            *pl '<i>Недостаточно денег для меча (200 монет).</i>'
        end
    end

    if PlayerArmorHead <> 'leather_helmet':
        if money >= 100:
            gs 'ActUiPrepare', 'Купить кожаный шлем (100 монет)', 'gift'
            act $ActUiLabel, $ActUiIconPath:
                money -= 100
                PlayerArmorHead = 'leather_helmet'
                gt 'ShipGearShop'
            end
        else:
            *pl '<i>Недостаточно денег для шлема (100 монет).</i>'
        end
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться на палубу', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'PortCapitalShipMenu', 'Port'
    end
---

#GerhardBlackmailTalk
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ОТЕЦ ГЕРХАРД В СОБОРЕ'
    gs 'SceneShowVisual', 'images/locations/church/gerhard', 'Отец Герхард в соборе', 'large', 'webp'

    GerhardBlackmailTalkDone = 1
    PlayerHasPilgrimBulla = 1

    gs 'MayorBlackmailTownPrintText', 'gerhard_talk_text'
    *pl ' '

    gs 'ActUiPrepare', 'Поблагодарить и уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Church'
    end
---

#MarketMongolHorseTrader
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ТОРГОВЕЦ ЛОШАДЬМИ (МОНГОЛ)'
    gs 'SceneShowVisual', 'images/locations/market/horse_trader', 'Торговец лошадьми на рынке', 'large', 'webp'

    if PlayerHasHorse = 1:
        gs 'MayorBlackmailTownPrintText', 'mongol_already_bought'
        *pl ' '

        gs 'ActUiPrepare', 'Вернуться на рынок', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Market'
        end
    else:
        gs 'MayorBlackmailTownPrintText', 'mongol_offer_text'
        *pl ' '

        HorsePrice = 150

        if money >= HorsePrice:
            gs 'ActUiPrepare', 'Купить лошадь (150 спинтарий)', 'gift'
            act $ActUiLabel, $ActUiIconPath:
                money -= HorsePrice
                PlayerHasHorse = 1
                TavernStableHasHorse = 1
                gt 'MarketMongolHorseTraderSuccess'
            end
        else:
            *pl '<i>У тебя недостаточно денег для покупки лошади (150 спинтарий).</i>'
            *pl ' '
        end

        gs 'ActUiPrepare', 'Уйти', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Market'
        end
    end
---

#MarketMongolHorseTraderSuccess
