#LegareBlackmailTalk
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С ЛЕГАРЕ'
    gs 'SceneShowVisual', 'images/locations/port/legare', 'Торговец Легаре', 'large', 'webp'

    LegareBlackmailTalkDone = 1

    if LegareConflict = 0:
        PlayerArmorHead = 'leather_helmet'
