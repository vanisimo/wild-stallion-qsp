#GuardPostBlackmailHint
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР СО СТРАЖНИКОМ'
    gs 'SceneShowVisual', 'images/locations/town/guard_post', 'Стражник на городской площади', 'large', 'webp'

    GuardPostHintDone = 1
    WeaponCaravanDirection = 'north'

    gs 'MayorBlackmailTownPrintText', 'guard_hint_text'
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
