! ================================================
! FILE: modules/events/mayor/mayor_blackmail_investigation_town.qsps
! MODULE: events/mayor
! [AI-WORKED] Текст переработан / дополнен ассистентом 29.09.2026
! Расследование контрабанды у горожан (Ирма, Драупнир, Легаре, Корабль, Священник, Монгол, Ворота)
! ================================================

#IrmaBlackmailTalk
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С ИРМОЙ'
    gs 'SceneShowVisual', 'images/locations/shops/irma_shop/irma', 'Ирма в ателье', 'large', 'webp'

    IrmaBlackmailTalkDone = 1

    if Friends['irma'] >= 10:
        PlayerArmorChest = 'leather_vest'
        gs 'MayorBlackmailTownPrintText', 'irma_talk_success'
    else:
        gs 'MayorBlackmailTownPrintText', 'irma_talk_refused'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Назад в ателье', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IrmaShop'
    end
---

#DraupnirBlackmailTalk
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР С ДРАУПНИРОМ'
    gs 'SceneShowVisual', 'images/locations/craftsmen/draupnir', 'Драупнир в мастерской', 'large', 'webp'

    DraupnirBlackmailTalkDone = 1

    if DraupnirOffended = 0:
        PlayerWeapon = 'dwarven_shortsword'
        gs 'MayorBlackmailTownPrintText', 'draupnir_talk_success'
