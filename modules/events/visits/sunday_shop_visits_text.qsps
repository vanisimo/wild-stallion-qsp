    if IngaIrmaBond >= 10:
        $SundayVisitText = 'У закрытой лавки Ирмы вы слышите два спокойных голоса. Инга говорит о нитках и выкройках так, будто это важнее церковной службы, а Ирма отвечает коротко и точно — без суеты, без поучений. Потом разговор касается лавки матери, брата у прилавка и того, как в этом городе девушке приходится учиться быть строгой раньше, чем успеет мечтать.'
    else:
        $SundayVisitText = 'Вы задерживаетесь у закрытой лавки портнихи и слышите приглушённый разговор. Инга спрашивает о шве и строчке, Ирма отвечает ровно. Речь о ткани, заказах и о том, что воскресенье — редкий день, когда можно шить без клиентов у двери.'
    end
---

#SundayVisitIrmaIngaTalkText
    $SundayVisitIrmaIngaTalkTextId = LCASE($ARGS[0])
    $SundayVisitIrmaIngaTalkText = ''

    if $SundayVisitIrmaIngaTalkTextId = 'ambient_sewing_order':
        $SundayVisitIrmaIngaTalkText = 'У закрытой лавки вы слышите спокойный разговор о заказе: отрез, подгиб, петли. Инга перечисляет детали так, будто от этого зависит её будущее, а Ирма кивает: «Хорошо. Сначала выточь линию — потом украшай. Иначе платье развалится на первом танце.»'

    elseif $SundayVisitIrmaIngaTalkTextId = 'ambient_sunday_rest':
        $SundayVisitIrmaIngaTalkText = '— Утром в церкви все косились, — вздыхает Инга. — Будто я уже согрешила за неделю.<br>— А ты только разогреваешься, — ровно Ирма. — Воскресенье для отдыха. Нитки не убегут. Клиенты — убегут, если шов кривой.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'ambient_tavern_dress':
        $SundayVisitIrmaIngaTalkText = '— Для трактира снова просят короче и ярче, — Ирма говорит без удивления. — Слухи дошли до выкроек.<br>— Мать скажет, что это позор, — Инга сдержанно.<br>— Мать продаёт муку, а я продаю ткань, — Ирма не повышает голос. — Кто платит — тот и задаёт длину. Ты учись шить так, чтобы держалось, а не чтобы нравилось священнику.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_irma_reverse_comfort':
        $SundayVisitIrmaIngaTalkText = '— Ты опять себя душишь, — Ирма цокает языком тихо. — Как будто между нами кто-то святой сидит.<br>— У меня лавка матери и брат у прилавка, — Инга стыдливо.<br>— А у меня заказы, которые нельзя вешать на гвоздь у окна, — Ирма фыркает без злости. — И что? Живём. Ты мне про Грюна не читай нотации — сама же краснеешь, когда вспоминаешь, как он смотрел на тебя у рынка.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_sewing_machine':
        $SundayVisitIrmaIngaTalkText = '— В столице машинка, — шепчет Инга. — Строчит быстрее двух учениц.<br>— И сколько? — сухо Ирма.<br>— Приценивалась, — Инга. — То «только под заказ», то дорого как приданое, то «уже ушла на корабль». Хотела бы. Увы. Пока шью руками — и не хуже.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'irma_dream_ancestral_staff':
        $SundayVisitIrmaIngaTalkText = '— Посох предков… — Ирма буднично, как про ножницы. — У Древа им службы ведут. Старое дело.<br>— Ты про это? — Инга удивляется. — Я думала, тебе только ткань.<br>— Ткань кормит, — кивает Ирма. — А посох… сколько ни приценивалась: то дорого, то «не для продажи», то «уехало в столицу». Хотелось бы. Увы. Живём без него — и шьём дальше.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'irma_uniform_gossip':
        $SundayVisitIrmaIngaTalkText = '— В трактире теперь шепчут не только про пиво, — Ирма говорит буднично. — Про юбки, про зал, про то, кто куда смотрит. Я уже подбираю ткань потолще — чтобы слухи не просвечивали.<br>— Мать скажет, что мы все с ума сошли, — Инга кашляет.<br>— Мать продаёт ром соседям втихаря, — Ирма не улыбается. — Шей аккуратно. Скандал любит кривые швы.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_guard_grun':
        $SundayVisitIrmaIngaTalkText = '— Сержант Грюн опять за мной ходил, — Инга говорит тихо и зло. — У лавки. Как будто я воровка, а не дочь Бекки.<br>— Он любит власть, не девушек, — ровно Ирма. — Но власть у него длиннее, чем руки. Запиши: если помогут — не благодари вслух у окна. А если не помогут — шей себе плотный воротник и держи спину прямо.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_lucas_corner':
        $SundayVisitIrmaIngaTalkText = '— Лукас… за углом… — Инга шепчет и сразу жалеет, что сказала. — Не смотри на меня так, Ирма.<br>— Я не смотрю, — спокойно та. — Я слышу. Кузнец крепкий, руки грубые, зато не болтает на рынке. Только не путай страховку с будущим. Машинка стоит дороже поцелуя за сараем.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_eddie_counter':
        $SundayVisitIrmaIngaTalkText = '— Эдди опять у прилавка улыбался клиентке, — Инга раздражённо. — Как будто лавка уже его.<br>— Брат будет наследником, — Ирма без иллюзий. — Ты шьёшь — значит, у тебя другое оружие. Не спорь с ним у мешков муки. Спорь выкройкой: кто лучше держит дом в порядке, тот и останется, когда мать устанет слушать.'

    end

    killvar '$SundayVisitIrmaIngaTalkTextId'
