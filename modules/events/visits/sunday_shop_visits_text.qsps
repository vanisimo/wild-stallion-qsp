! ================================================
! FILE: modules/events/visits/sunday_shop_visits_text.qsps
! Тексты воскресных визитов у закрытых лавок
! Версия: v1
! Используется локаторами из:
! modules/events/visits/sunday_shop_visits.qsps
! ================================================

#SundayVisitBeckySandraText
    if BeckySandraChurchGearGossipCanHear = 1:
        gs 'SundayVisitBeckySandraGearGossipText'
        exit
    end

    if SundayBeckySandraVisitSeen[day] = 1:
        $SundayVisitText = 'Вы снова задерживаетесь у лавки Бекки, но разговор за дверью уже стих. Похоже, сегодня вы услышали всё, что могли.'
        exit
    end

    if LOC('SandraBeckySundayScandalCanHear') = 1:
        gs 'SandraBeckySundayScandalCanHear'

        if SandraBeckySundayScandalCanHear = 1:
            gs 'SundayVisitBeckySandraScandalText'
            exit
        end
    end

    gs 'SundayVisitBeckySandraPickPhrase'

    if SundayVisitBeckySandraPickOk = 1:
        gs 'SundayVisitBeckySandraTalkText', $SundayVisitBeckySandraPickedId
        $SundayVisitText = $SundayVisitBeckySandraTalkText
        killvar '$SundayVisitBeckySandraTalkText'
        exit
    end

    if SandraTrustStefan >= 10:
        $SundayVisitText = 'Вы подходите к закрытой продуктовой лавке и слышите за дверью тихие женские голоса. Бекки говорит мягко, почти по-домашнему, а Сандра отвечает ей куда спокойнее, чем обычно отвечает вам. Они говорят о семье, трактире и о том, как быстро всё меняется. Бекки осторожно напоминает, что город никогда не был таким приличным, каким хочет казаться по воскресеньям. Сандра долго молчит, а потом тихо признаёт, что иногда боится не грехов, а того, что однажды останется совсем одна со своими запретами.'
    else:
        $SundayVisitText = 'Вы подходите к закрытой лавке Бекки и слышите приглушённый разговор. Бекки пытается успокоить Сандру, а та говорит сухо и устало. Речь идёт о доме, дочерях и трактире. Сандра явно не уверена, что всё идёт правильно, но рядом с Бекки она позволяет себе говорить честнее, чем при семье.'
    end
---

#SundayVisitBeckySandraTalkText
    $SundayVisitBeckySandraTalkTextId = LCASE($ARGS[0])
    $SundayVisitBeckySandraTalkText = ''

    if $SundayVisitBeckySandraTalkTextId = 'ambient_family_tavern':
        $SundayVisitBeckySandraTalkText = 'У закрытой лавки Бекки вы слышите спокойный разговор о трактире: запасы, дочери, усталость. Сандра говорит о зале так, будто там всё ещё её дом, а не только работа сына. Бекки кивает: "Дом держится на женщинах, которые не жалуются вслух."'

    elseif $SundayVisitBeckySandraTalkTextId = 'ambient_sunday_church':
        $SundayVisitBeckySandraTalkText = '— Утром в церкви опять косились, — вздыхает Сандра. — Будто я уже сгорела за неделю.<br>— А ты только разогреваешься, — хихикает Бекки. — Я вон исповедь проспала: грехов меньше, зато настроение лучше.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_reverse_comfort':
        $SundayVisitBeckySandraTalkText = '— Ты опять себя душишь, — Бекки цокает языком. — Как будто между нами кто-то святой сидит.<br>— У меня дочери и трактир на виду, — Сандра стыдливо.<br>— А у меня задняя комната лавки и постоянные гости, — Бекки фыркает. — Матросы, купцы, кто попало. И что? Живём. Ты мне про пятничного гнома не читай нотации — сама же краснеешь, когда вспоминаешь, как он стучит молотком по наковальне.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_two_men':
        $SundayVisitBeckySandraTalkText = '— Помнишь заднюю комнату? — Бекки смеётся тихо, самой себе явно нравится. — Двое матросов с корабля. Крепкие, ром на дыхании. Я их сама завела за мешки — и сразу вдвоём, в оба ствола, без очереди.<br>— На рынке шепчут… — Сандра кашляет и косится на окно.<br>— Пусть шепчут, — Бекки не смущается. — Там не только они бывают — кто-то заходит регулярно, я уже и не считаю. Мокрая была заранее, сама провоцировала. А у окна тень была… Стефан, наверное. Пусть смотрит — хоть научится.<br>— Бекки!<br>— Ну что, — подмигивает она в голосе. — Ты мне про Драупнира не рассказывай — гном-то крепкий, молотком по железу стучит, а не по мебели. Или думаешь, я не знаю, куда ты по вечерам к мэру ходишь «по делам трактира»?'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_stefan_gossip':
        $SundayVisitBeckySandraTalkText = '— Стефан у меня мукой не ограничивается, — Бекки говорит буднично. — Заходит в заднюю, запирает дверь — а через час я уже не помню, зачем открывала лавку. Иногда, говорят, подглядывает в щель у окна. Мне плевать.<br>— Я знаю, — тихо Сандра.<br>— Мать — это ты, когда сыну ноги раздвигаешь, — Бекки подкалывает без злости. — А я соседка. Не завидуй — лучше расскажи, как на этой неделе гном в мастерской молотком гремел, пока ты «полки мерила».'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_stefan_marathon':
        $SundayVisitBeckySandraTalkText = '— Бекки… — Сандра еле дышит. — Сын… вчера… семь раз. Семь. Я ходить еле могу.<br>— Ох ты ж, — Бекки присвистывает с завистью. — Вот это наследник. У меня в задней двое матросов сразу — ты одним обошлась и в ноль.<br>— Это не смешно!<br>— Смешно то, что ты краснеешь, — фыркает Бекки. — Запиши: мать тоже кончает. Только мэру не болтай лишнего — ты же сама к нему ползёшь, а он потом смотрит, будто заслужил.'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_stefan_first':
        $SundayVisitBeckySandraTalkText = '— Бекки… со Стефаном… было, — шепчет Сандра. — Я мать. Как это вообще…<br>— Как нормально, — перебивает Бекки. — Мокрая, пустая голова, потом стыд. У меня в задней комнате проще: кто зашёл — тот зашёл. А ты хоть расслабилась?<br>— Нет…<br>— Зря. Драупнир бы тебя научил — гном коренастый, молот берёт уверенно, и там тоже не всё про полки.'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_lewd_hall':
        $SundayVisitBeckySandraTalkText = '— В зале на лестнице… юбка, клиенты, Стефан смотрел и молчал, — бормочет Сандра.<br>— Молчал — одобрил, — Бекки усмехается. — У меня в задней не лестница, а очередь: матросы, постоянные. Стефан у окна торчит — ну и пусть, как сейчас.<br>— Ты неисправима.<br>— А ты завидуешь. И к мэру всё чаще ходишь — тоже признай.'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_gnome_friday':
        $SundayVisitBeckySandraTalkText = '— По пятницам ты к столяру не только за полками, — Бекки смеётся. — Драупнир коренастый, молот по наковальне гремит — а ты краснеешь не от стружки.<br>Сандра шипит: "Тише! У окна кто-то…"<br>— Пусть слушает, — Бекки не затихает. — Стефан любит подглядывать. А ты ещё после мастерской к мэру бегаешь — думаешь, я не связываю вечер пятницы?'

    end

    killvar '$SundayVisitBeckySandraTalkTextId'
---

#SundayVisitBeckySandraGearGossipText
    $SundayVisitText = 'У закрытой лавки продовольствия ты задерживаешься у окна. За ставнями — голоса Сандры и Бекки, слишком тихие для улицы и слишком откровенные для церкви.'
    $SundayVisitText += '<br><br>— Этот гном смешной, — говорит Сандра. — Случай рассказал на днях, я чуть не расхохоталась прямо в мастерской.'
    $SundayVisitText += '<br><br>— Да-да, рассказал, — Бекки фыркает. — Когда? Когда в пятницу в мастерской молотком по наковальне гремел, а ты «заказ проверяла»? Ха-ха.'
    $SundayVisitText += '<br><br>— Перестань. Слушай дальше. Он чинил в церкви комнату чистых сердец и встроил в створку шестерёнку — сам придумал, чтобы подглядывать за исповедями. А теперь бесится: до рукояти не дотягивается, рост маловат, а гномы в собор всё равно не ходят — исповедь, мол, для людей ростом повыше.'
    $SundayVisitText += '<br><br>— Значит, механизм для нас, — хихикает Бекки. — Для тех, кто не крохотный и не святой.'
    $SundayVisitText += '<br><br>Сандра шипит ей затылок словом, но ты уже запомнил главное — у какого окна искать шестерёнку в воскресный полдень.'
---

! ================================================
! FILE: modules/events/visits/sunday_shop_visits_text.qsps
! Текст разговора Клариссы и Мелиссы
! ================================================

#SundayVisitClarissaMelissaText
    if SundayClarissaMelissaVisitSeen[day] = 1:
        $SundayVisitText = 'Вы снова подходите к лавке Легаре, но за дверью уже тихо. Кларисса и Мелисса либо ушли, либо больше не говорят о важном.'
        exit
    end

    if MelissaClarissaBond >= 10:
        $SundayVisitText = 'У закрытой лавки Легаре вы слышите голоса Клариссы и Мелиссы. Они говорят негромко, но достаточно ясно. Кларисса жалуется на мужа, на его взгляды и на то, что мужчины часто считают себя хозяевами даже там, где сами всё испортили. Мелисса отвечает сдержанно, но в её голосе слышно сочувствие. Потом разговор касается трактира, Аманды и того, что внимание мужчин может быть и опасностью, и выгодой. Кларисса смеётся тихо и говорит, что Мелисса слишком хорошо понимает такие вещи для девушки, которая делает вид, будто думает только о порядке.'
    else:
        $SundayVisitText = 'Вы задерживаетесь у закрытой винной лавки и слышите, как Кларисса разговаривает с Мелиссой. Разговор осторожный: немного о поставках, немного о Легаре, немного о том, как женщины в этом городе учатся замечать чужие взгляды раньше, чем мужчины решатся заговорить вслух.'
    end

    if PlayerKnows_MelissaClarissaBrotherGossip = 0 and MelissaHomeSex = 1 and MelissaClarissaBond >= 12:
        $SundayVisitText += '<br><br>Мелисса вдруг говорит тише: "С братом… у нас уже не просто разговоры. Не смотри на меня так, Кларисса. Я знаю, что делаю." Кларисса долго молчит, потом отвечает: "Значит, в этом доме все лгут красиво."'
    end
---
