#SundayVisitIrmaIngaText
    if SundayIrmaIngaVisitSeen[day] = 1:
        $SundayVisitText = 'Вы снова подходите к лавке Ирмы, но за дверью уже тихо. Инга и Ирма либо ушли, либо больше не говорят о важном.'
        exit
    end

    if IrmaMet < 1:
        $SundayVisitText = 'У закрытой лавки портнихи никого нет — только запертая дверь и запах воска от соседней мастерской.'
        exit
    end

    gs 'SundayVisitIrmaIngaPickPhrase'

