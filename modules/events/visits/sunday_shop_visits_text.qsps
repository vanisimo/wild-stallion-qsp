! ================================================
! FILE: modules/events/visits/sunday_shop_visits_text.qsps
! Тексты воскресных визитов у закрытых лавок
! Версия: v1
! Используется локаторами из:
! modules/events/visits/sunday_shop_visits.qsps
! ================================================

#SundayVisitBeckySandraText
    if BeckySandraChurchGearGossipCanHear = 1:
        gs 'SundayVisitBeckySandraGearGossipText'
        exit
    end

    if SundayBeckySandraVisitSeen[day] = 1:
        $SundayVisitText = 'Вы снова задерживаетесь у лавки Бекки, но разговор за дверью уже стих. Похоже, сегодня вы услышали всё, что могли.'
        exit
    end

    ! play coach Бекки↔Сандра — до scandal (сюжетный unlock play)
    if LOC('HallPlayCoachCanOffer') = 1:
        gs 'HallPlayCoachCanOffer', 'sandra'
        if HallPlayCoachCanOffer = 1:
            $SundayVisitBeckySandraPickedId = 'play_coach_sandra'
            gs 'SundayVisitBeckySandraTalkText', 'play_coach_sandra'
            $SundayVisitText = $SundayVisitBeckySandraTalkText
            killvar '$SundayVisitBeckySandraTalkText'
            exit
        end
    end

    if LOC('SandraBeckySundayScandalCanHear') = 1:
        gs 'SandraBeckySundayScandalCanHear'

        if SandraBeckySundayScandalCanHear = 1:
            gs 'SundayVisitBeckySandraScandalText'
            exit
        end
    end

    gs 'SundayVisitBeckySandraPickPhrase'

    if SundayVisitBeckySandraPickOk = 1:
        gs 'SundayVisitBeckySandraTalkText', $SundayVisitBeckySandraPickedId
        $SundayVisitText = $SundayVisitBeckySandraTalkText
        killvar '$SundayVisitBeckySandraTalkText'
        exit
    end

    if SandraTrustStefan >= 10:
        $SundayVisitText = 'Вы подходите к закрытой продуктовой лавке и слышите за дверью тихие женские голоса. Бекки говорит мягко, почти по-домашнему, а Сандра отвечает ей куда спокойнее, чем обычно отвечает вам. Они говорят о семье, трактире и о том, как быстро всё меняется. Бекки осторожно напоминает, что город никогда не был таким приличным, каким хочет казаться по воскресеньям. Сандра долго молчит, а потом тихо признаёт, что иногда боится не грехов, а того, что однажды останется совсем одна со своими запретами.'
    else:
        $SundayVisitText = 'Вы подходите к закрытой лавке Бекки и слышите приглушённый разговор. Бекки пытается успокоить Сандру, а та говорит сухо и устало. Речь идёт о доме, дочерях и трактире. Сандра явно не уверена, что всё идёт правильно, но рядом с Бекки она позволяет себе говорить честнее, чем при семье.'
    end
---

#SundayVisitBeckySandraTalkText
    $SundayVisitBeckySandraTalkTextId = LCASE($ARGS[0])
    $SundayVisitBeckySandraTalkText = ''

    if $SundayVisitBeckySandraTalkTextId = 'play_coach_sandra':
        if LOC('HallPlayCoachBuildCombinedText') = 1:
            gs 'HallPlayCoachBuildCombinedText', 'sandra'
            $SundayVisitBeckySandraTalkText = $HallPlayCoachCombined
            killvar '$HallPlayCoachCombined'
        else
            $SundayVisitBeckySandraTalkText = 'У лавки Бекки вы подслушиваете, как Бекки подначивает Сандру «покрутить попой» у плиты — как сестры в зале. Сандра молчит, но не уходит.'
        end

    elseif $SundayVisitBeckySandraTalkTextId = 'ambient_family_tavern':
        $SundayVisitBeckySandraTalkText = 'У закрытой лавки Бекки вы слышите спокойный разговор о трактире: запасы, дочери, усталость. Сандра говорит о зале так, будто там всё ещё её дом, а не только работа сына. Бекки кивает: "Дом держится на женщинах, которые не жалуются вслух."'

    elseif $SundayVisitBeckySandraTalkTextId = 'ambient_sunday_church':
        $SundayVisitBeckySandraTalkText = '— Утром в церкви опять косились, — вздыхает Сандра. — Будто я уже сгорела за неделю.<br>— А ты только разогреваешься, — хихикает Бекки. — Я вон исповедь проспала: грехов меньше, зато настроение лучше.'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_dream_recipe_codex':
        $SundayVisitBeckySandraTalkText = '— «Рецепты Короны»… — Сандра тихо, без пафоса. — Книга из столицы. Мало экземпляров. С королевской, говорят, списана.<br>— Ну и? — Бекки. — Купила бы?<br>— Сколько ни спрашивала: то дорого, то «не для продажи», то «уехало на корабле». С такой… — вздыхает. — Хоть первым поваром побережья. Хотелось бы. Увы. Котёл и так кипит.'

    elseif $SundayVisitBeckySandraTalkTextId = 'amanda_dream_full_mirror':
        $SundayVisitBeckySandraTalkText = '— Аманда опять про зеркало, — вздыхает Сандра. — Не карманное. Ростовое. Из стекла. Не как наше серебро, где рожа пятном.<br>— С приданым за дворянина, — Бекки хихикает.<br>— Она приценивалась, — Сандра. — То цена как у лошади, то «уже уехало», то «не для трактирных». Хотела бы. Увы. Пока ленты и брошки — из своего.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_dream_stallion_cucumber':
        SundayVisitBeckyCucumberRoll = RAND(1, 4)

        if SundayVisitBeckyCucumberRoll = 1:
            $SundayVisitBeckySandraTalkText = '— «Конский ствол»! — Бекки ржёт так, что ставня дрожит. — Огурец как у коня, с головкой… Представляешь сорт?<br>— Бекки, ради бога, — Сандра давится смехом. — Куда ты его…<br>— В грядку, в салат, и… куда ещё кладут, когда мужа нет, — Бекки. — Семена? Приценивалась: то нет, то «только оптом из столицы», то цена как у жеребца. Хотела бы. Увы. Пока обычные огурцы — и фантазия.'
        elseif SundayVisitBeckyCucumberRoll = 2:
            $SundayVisitBeckySandraTalkText = '— Салат из «Конского ствола», — Бекки хихикает. — Сметана, укроп… На вкус — до того, как… использую, или после?<br>— После — это уже не салат, — Сандра, плечи трясутся. — Преступление против кухни.<br>— Зато против одиночества лекарство, — Бекки. — Семена редкие: не продают, или дорого, или «уже ушли с кораблём». Хотелось бы. Увы.'
        elseif SundayVisitBeckyCucumberRoll = 3:
            $SundayVisitBeckySandraTalkText = '— Какой на салат вкуснее, — Бекки серьёзно, как на рынке. — Короткий толстый или длинный с головкой?<br>— Бекки!<br>— Для грядки, — ржёт. — Хотя критерии те же, что… ну ты поняла. Сандра, не смотри: ты же знаешь, что бывает вместо мужа, когда молоток далеко. А семена — сказка. Искала. Не нашла нормально. Жалко.'
        else:
            $SundayVisitBeckySandraTalkText = '— До салата или после? — Бекки давится смехом. — До — хрустит, после — тёплый и… с характером.<br>— Я уйду, — Сандра, но не уходит; обе ржут «конским» смехом.<br>— Шутки шутками, — Бекки тише. — Таких семян в городе нет, или кусаются. Хотела бы грядку. Увы. Живём на обычных.'
        end

        killvar 'SundayVisitBeckyCucumberRoll'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_reverse_comfort':
        $SundayVisitBeckySandraTalkText = '— Ты опять себя душишь, — Бекки цокает языком. — Как будто между нами кто-то святой сидит.<br>— У меня дочери и трактир на виду, — Сандра стыдливо.<br>— А у меня задняя комната лавки и постоянные гости, — Бекки фыркает. — Матросы, купцы, кто попало. И что? Живём. Ты мне про пятничного гнома не читай нотации — сама же краснеешь, когда вспоминаешь, как он стучит молотком по наковальне.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_two_men':
        $SundayVisitBeckySandraTalkText = '— Помнишь заднюю комнату? — Бекки смеётся тихо, самой себе явно нравится. — Двое матросов с корабля. Крепкие, ром на дыхании. Я их сама завела за мешки — и сразу вдвоём, в оба ствола, без очереди.<br>— На рынке шепчут… — Сандра кашляет и косится на окно.<br>— Пусть шепчут, — Бекки не смущается. — Там не только они бывают — кто-то заходит регулярно, я уже и не считаю. Мокрая была заранее, сама провоцировала. А у окна тень была… Стефан, наверное. Пусть смотрит — хоть научится.<br>— Бекки!<br>— Ну что, — подмигивает она в голосе. — Ты мне про Драупнира не рассказывай — гном-то крепкий, молотком по железу стучит, а не по мебели. Или думаешь, я не знаю, куда ты по вечерам к мэру ходишь «по делам трактира»?'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_guard':
        $SundayVisitBeckySandraTalkText = '— Грюн заходил в заднюю, — Бекки говорит буднично. — «Проверка взятки», говорит. Сел на мешок, как на свой пост.<br>— Сержант? — Сандра кашляет. — У окна кто-то…<br>— Стефан любит щель, — Бекки не смущается. — А Грюн любит власть. Я люблю, когда оба молчат. Ты мне про мэра не читай нотации — клерк из мэрии тоже заходит, только в чистом камзоле.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_neighbor':
        $SundayVisitBeckySandraTalkText = '— Муж соседки опять в задней, — Бекки усмехается. — На рынке вечно жалуется на цены, а у меня на соли стонет тише, чем на прилавке торгуется.<br>— Бекки… — Сандра шипит. — Это же чужой брак.<br>— Чужой, но регулярный, — фыркает та. — Я вдовая, не святая. А ты к мэру ходишь «по делам» — думаешь, я не слышу, как Драупнир по пятницам молотом по наковальне гремит?'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_clerk':
        $SundayVisitBeckySandraTalkText = '— Клерк из мэрии вчера в задней, — Бекки говорит тихо, самой нравится. — С папкой к груди, будто долги — святыня. «В книге спишем по-другому», — шепчу я — и дверь на щеколду.<br>— Сандра… — та краснеет. — Это же налоги…<br>— Это альтернативная оплата, — Бекки не смущается. — Ты к мэру сама бегаешь — не учи меня бухгалтерии. Стефан у окна торчал — пусть запишет в свою книгу.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_old_client':
        $SundayVisitBeckySandraTalkText = '— Старый вдовец с нижнего ряда опять за солью, — Бекки смеётся тихо. — Два года без жены, говорит. Я отвечаю: «Я тоже вдовая, только не святая».<br>— У него же расписание… — Сандра бормочет.<br>— Как у тебя к мэру по вечерам, — Бекки подкалывает. — Ритм ровный, скрип ящика знакомый. В задней не торгуются — уже знают, куда идут.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_lucas':
        $SundayVisitBeckySandraTalkText = '— Лукас заходил в заднюю, — Бекки говорит мягче обычного. — С синяком на щеке. Инга не пустила — не значит, что мальчику нельзя дышать.<br>— Это же дочь Бекки… — Сандра растерянно.<br>— Это моя задняя, не её комната, — Бекки не спорит долго. — Он шептал про Грюна, я затихала его губами. Эдди внизу считал монеты — никто не спросил, куда делась мать.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_eddie_near':
        $SundayVisitBeckySandraTalkText = '— В задней был гость, — Бекки смеётся тихо. — А спереди Эдди насвистывает и кричит: «Мам, сколько за ящик?» Я отвечаю «Сто двадцать! Не мешай!» — и не останавливаюсь.<br>— Боже… — Сандра закрывает лицо ладонью. — Он же сын…<br>— Сын считает монеты, — Бекки без злости. — Мать живёт. Стефан у щели стоял — ну и пусть, как сейчас. Ты мне про трактир не читай — у тебя свой сын в зале смотрит.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_stefan_gossip':
        $SundayVisitBeckySandraTalkText = '— Стефан у меня мукой не ограничивается, — Бекки говорит буднично. — Заходит в заднюю, запирает дверь — а через час я уже не помню, зачем открывала лавку. Иногда, говорят, подглядывает в щель у окна. Мне плевать.<br>— Я знаю, — тихо Сандра.<br>— Мать — это ты, когда сыну ноги раздвигаешь, — Бекки подкалывает без злости. — А я соседка. Не завидуй — лучше расскажи, как на этой неделе гном в мастерской молотком гремел, пока ты «полки мерила».'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_stefan_marathon':
        $SundayVisitBeckySandraTalkText = '— Бекки… — Сандра еле дышит. — Сын… вчера… семь раз. Семь. Я ходить еле могу.<br>— Ох ты ж, — Бекки присвистывает с завистью. — Вот это наследник. У меня в задней двое матросов сразу — ты одним обошлась и в ноль.<br>— Это не смешно!<br>— Смешно то, что ты краснеешь, — фыркает Бекки. — Запиши: мать тоже кончает. Только мэру не болтай лишнего — ты же сама к нему ползёшь, а он потом смотрит, будто заслужил.'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_stefan_first':
        $SundayVisitBeckySandraTalkText = '— Бекки… со Стефаном… было, — шепчет Сандра. — Я мать. Как это вообще…<br>— Как нормально, — перебивает Бекки. — Мокрая, пустая голова, потом стыд. У меня в задней комнате проще: кто зашёл — тот зашёл. А ты хоть расслабилась?<br>— Нет…<br>— Зря. Драупнир бы тебя научил — гном коренастый, молот берёт уверенно, и там тоже не всё про полки.'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_lewd_hall':
        $SundayVisitBeckySandraTalkText = '— В зале на лестнице… юбка, клиенты, Стефан смотрел и молчал, — бормочет Сандра.<br>— Молчал — одобрил, — Бекки усмехается. — У меня в задней не лестница, а очередь: матросы, постоянные. Стефан у окна торчит — ну и пусть, как сейчас.<br>— Ты неисправима.<br>— А ты завидуешь. И к мэру всё чаще ходишь — тоже признай.'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_gnome_friday':
        $SundayVisitBeckySandraTalkText = '— По пятницам ты к столяру не только за полками, — Бекки смеётся. — Драупнир коренастый, молот по наковальне гремит — а ты краснеешь не от стружки.<br>Сандра шипит: "Тише! У окна кто-то…"<br>— Пусть слушает, — Бекки не затихает. — Стефан любит подглядывать. А ты ещё после мастерской к мэру бегаешь — думаешь, я не связываю вечер пятницы?'

    end

    killvar '$SundayVisitBeckySandraTalkTextId'
---

#SundayVisitBeckySandraGearGossipText
    $SundayVisitText = 'У закрытой лавки продовольствия ты задерживаешься у окна. За ставнями — голоса Сандры и Бекки, слишком тихие для улицы и слишком откровенные для церкви.'
    $SundayVisitText += '<br><br>— Этот гном смешной, — говорит Сандра. — Случай рассказал на днях, я чуть не расхохоталась прямо в мастерской.'
    $SundayVisitText += '<br><br>— Да-да, рассказал, — Бекки фыркает. — Когда? Когда в пятницу в мастерской молотком по наковальне гремел, а ты «заказ проверяла»? Ха-ха.'
    $SundayVisitText += '<br><br>— Перестань. Слушай дальше. Он чинил в церкви комнату чистых сердец и встроил в створку шестерёнку — сам придумал, чтобы подглядывать за исповедями. А теперь бесится: до рукояти не дотягивается, рост маловат, а гномы в собор всё равно не ходят — исповедь, мол, для людей ростом повыше.'
    $SundayVisitText += '<br><br>— Значит, механизм для нас, — хихикает Бекки. — Для тех, кто не крохотный и не святой.'
    $SundayVisitText += '<br><br>Сандра шипит ей затылок словом, но ты уже запомнил главное — у какого окна искать шестерёнку в воскресный полдень.'
---

! ================================================
! FILE: modules/events/visits/sunday_shop_visits_text.qsps
! Текст разговора Клариссы и Мелиссы
! ================================================

#SundayVisitClarissaMelissaText
    if SundayClarissaMelissaVisitSeen[day] = 1:
        $SundayVisitText = 'Вы снова подходите к лавке Легаре, но за дверью уже тихо. Кларисса и Мелисса либо ушли, либо больше не говорят о важном.'
        exit
    end

    ! play coach Кларисса↔Мелисса — force (сюжетный unlock play)
    if LOC('HallPlayCoachCanOffer') = 1:
        gs 'HallPlayCoachCanOffer', 'melissa'
        if HallPlayCoachCanOffer = 1:
            $SundayVisitClarissaMelissaPickedId = 'play_coach_melissa'
            gs 'SundayVisitClarissaMelissaTalkText', 'play_coach_melissa'
            $SundayVisitText = $SundayVisitClarissaMelissaTalkText
            killvar '$SundayVisitClarissaMelissaTalkText'
            exit
        end
    end

    gs 'SundayVisitClarissaMelissaPickPhrase'

    if SundayVisitClarissaMelissaPickOk = 1:
        gs 'SundayVisitClarissaMelissaTalkText', $SundayVisitClarissaMelissaPickedId
        $SundayVisitText = $SundayVisitClarissaMelissaTalkText
        killvar '$SundayVisitClarissaMelissaTalkText'
        exit
    end

    if MelissaClarissaBond >= 10:
        $SundayVisitText = 'У закрытой лавки Легаре вы слышите голоса Клариссы и Мелиссы. Они говорят негромко, но достаточно ясно. Кларисса жалуется на мужа, на его взгляды и на то, что мужчины часто считают себя хозяевами даже там, где сами всё испортили. Мелисса отвечает сдержанно, но в её голосе слышно сочувствие. Потом разговор касается трактира, Аманды и того, что внимание мужчин может быть и опасностью, и выгодой. Кларисса смеётся тихо и говорит, что Мелисса слишком хорошо понимает такие вещи для девушки, которая делает вид, будто думает только о порядке.'
    else:
        $SundayVisitText = 'Вы задерживаетесь у закрытой винной лавки и слышите, как Кларисса разговаривает с Мелиссой. Разговор осторожный: немного о поставках, немного о Легаре, немного о том, как женщины в этом городе учатся замечать чужие взгляды раньше, чем мужчины решатся заговорить вслух.'
    end
---

#SundayVisitClarissaMelissaTalkText
    $SundayVisitClarissaMelissaTalkTextId = LCASE($ARGS[0])
    $SundayVisitClarissaMelissaTalkText = ''

    if $SundayVisitClarissaMelissaTalkTextId = 'play_coach_melissa':
        if LOC('HallPlayCoachBuildCombinedText') = 1:
            gs 'HallPlayCoachBuildCombinedText', 'melissa'
            $SundayVisitClarissaMelissaTalkText = $HallPlayCoachCombined
            killvar '$HallPlayCoachCombined'
        else
            $SundayVisitClarissaMelissaTalkText = 'У лавки Легаре вы подслушиваете, как Кларисса подначивает Мелиссу не проигрывать «мелкой» в зале — крутить попой и считать серебро. Мелисса вспыхивает: услышала.'
        end

    elseif $SundayVisitClarissaMelissaTalkTextId = 'ambient_legare_supplies':
        $SundayVisitClarissaMelissaTalkText = 'У закрытой лавки Легаре вы слышите спокойный разговор о поставках: бочки, счета, задержки корабля. Кларисса перечисляет цифры так, будто от этого зависит её дыхание, а Мелисса кивает и вставляет редкие замечания о том, что в трактире тоже всё держится на том, что привезли вовремя.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'ambient_tavern_amanda':
        $SundayVisitClarissaMelissaTalkText = '— В зале опять суетятся вокруг Аманды, — вздыхает Кларисса. — Мужчины смотрят так, будто она уже их.<br>— Она умеет выдерживать взгляд, — отвечает Мелисса. — Я бы на её месте тоже не опускала глаза сразу. Только потом долго не спишь.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_dream_eleanor_vol3':
        $SundayVisitClarissaMelissaTalkText = '— «Королева Элеонора», том третий, — Мелисса тихо. — Первые два у меня. Третьего нет.<br>— В лавке? — Кларисса.<br>— Приценивалась: то «не держат», то дорого как приданое, то «уехало в столицу». Хотела бы дочитать. Увы. Читаю чужое и злюсь.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'amanda_dream_full_mirror':
        $SundayVisitClarissaMelissaTalkText = '— Сестра бредит ростовым зеркалом, — Мелисса сухо. — Стеклянным. Не серебром, где пятном.<br>— С приданым за дворянина, — Кларисса.<br>— Она спрашивала цены, — Мелисса. — То кусается, то «уже нет», то «не для трактира». Хотела бы. Увы. Пока ленты из своего кошелька.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'clarissa_dream_golden_wine':
        $SundayVisitClarissaMelissaTalkText = '— Золотое вино, — Кларисса тихо и зло. — Моё. Не его розовое, которое к королевскому столу таскают и кланяются.<br>— Заткнуть мужа за пояс? — Мелисса.<br>— Нужен рецепт, — Кларисса. — Без него бочка — вода. Приценивалась: то не продают, то «секрет дома», то цена как у лавки целиком. Хотела бы. Увы. Пока его розовое славят — а я считаю бочки.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'clarissa_melissa_reverse_comfort':
        $SundayVisitClarissaMelissaTalkText = '— Ты опять себя душишь, — Кларисса цокает языком. — Как будто между нами кто-то святой сидит.<br>— У меня зал на виду и брат под боком, — Мелисса стыдливо.<br>— А у меня муж, который считает лавку своей крепостью, — Кларисса фыркает. — И что? Живём. Ты мне про Легаре на танцах не читай нотации — сама же краснеешь, когда вспоминаешь, как он смотрел на Аманду.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'clarissa_legare_husband':
        $SundayVisitClarissaMelissaTalkText = 'Кларисса говорит тихо, но зло: муж снова задержал поставку, снова смотрел на прохожую у окна, снова сделал вид, что это её вина. Мелисса молчит долго, потом отвечает: «Он не первый мужчина, который путает власть с правом. Только у тебя это под боком каждый день.»'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_legare_jealousy':
        $SundayVisitClarissaMelissaTalkText = '— На танцах Легаре опять смотрел на Аманду, — Мелисса говорит сухо. — Я видела. Ты тоже видела, Кларисса.<br>— Не начинай, — шипит та. — Это мой муж.<br>— И моя сестра в зале, — Мелисса не отступает. — Я не ревную к тебе. Я злюсь, что он думает, будто мы все его полки на складе.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_musician_interest':
        $SundayVisitClarissaMelissaTalkText = '— Менестрель на площади… — Мелисса говорит негромко, сама себе удивлённая. — Смотрит так, будто я единственная в толпе.<br>— Опасно, — Кларисса усмехается. — Музыканты уезжают, а слухи остаются.<br>— Я знаю, — Мелисса вздыхает. — Просто… впервые за долгое время кто-то смотрел не как на дочь хозяина трактира.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_clarissa_brother':
        $SundayVisitClarissaMelissaTalkText = 'Мелисса вдруг говорит тише: «С братом… у нас уже не просто разговоры. Не смотри на меня так, Кларисса. Я знаю, что делаю.» Кларисса долго молчит, потом отвечает: «Значит, в этом доме все лгут красиво.»'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_stefan_first':
        $SundayVisitClarissaMelissaTalkText = '— Кларисса… со Стефаном… было, — шепчет Мелисса. — Я сестра. Как это вообще…<br>— Как нормально, — перебивает Кларисса без злости. — Мокрая, пустая голова, потом стыд. У меня с мужем проще: он думает, что владеет лавкой, а не мной. А ты хоть расслабилась?<br>— Нет…<br>— Зря. Хоть кто-то в этом доме должен спать спокойно.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_stefan_marathon':
        $SundayVisitClarissaMelissaTalkText = '— Кларисса… — Мелисса еле дышит. — Стефан… вчера… семь раз. Семь. Я ходить еле могу.<br>— Ох ты ж, — Кларисса присвистывает с завистью и ужасом сразу. — Вот это брат. У меня муж раз в неделю считает бочки и думает, что это страсть.<br>— Это не смешно!<br>— Смешно то, что ты краснеешь, — фыркает Кларисса. — Запиши: сестра тоже кончает. Только мужу не болтай лишнего — он и так смотрит на Аманду, будто она его товар.'

    end

    killvar '$SundayVisitClarissaMelissaTalkTextId'
