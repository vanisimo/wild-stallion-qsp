! ================================================
! FILE: modules/events/visits/sunday_irma_inga_text.qsps
! MODULE: events/visits
! [AI-WORKED] Текст переработан / дополнен ассистентом 04.10.2026
! Тексты воскресных разговоров: Ирма-портниха и Инга Блэнкеншип
! Локация: закрытая швейная мастерская Ирмы в ремесленном квартале (воскресенье, день/вечер)
! 
! Характер Ирмы:
! Полуэльфийка-портниха, строгая, уравновешенная, ценит безупречную линию кроя,
! независимость и эльфийские традиции предков; не ханжа, но презирает небрежность.
! Характер Инги:
! Дочь лавочницы Бекки, ученица Ирмы. Внешне скромная и послушная, но под влиянием
! страсти и внимания Стефана раскрывающаяся, эмоциональная и чувственная.
! ================================================

#SundayVisitIrmaIngaText
    if SundayIrmaIngaVisitSeen[day] = 1:
        $SundayVisitText = 'Ты снова подходишь к закрытой мастерской Ирмы, но за плотными ставнями уже тихо: швеи либо закончили раскрой, либо разошлись по домам. На сегодня ты услышал всё, что мог.'
        exit
    end

    if IrmaMet < 1:
        $SundayVisitText = 'У закрытой мастерской портнихи никого нет — лишь запертая на кованый засов дверь да лёгкий запах пчелиного воска и выделанного сукна.'
        exit
    end

    gs 'SundayVisitIrmaIngaPickPhrase'

    if SundayVisitIrmaIngaPickOk = 1:
        gs 'SundayVisitIrmaIngaTalkText', $SundayVisitIrmaIngaPickedId
        $SundayVisitText = $SundayVisitIrmaIngaTalkText
        killvar '$SundayVisitIrmaIngaTalkText'
        exit
    end

    ! Базовый нарратив при отсутствии специфических сюжетных триггеров
    if IngaIrmaBond >= 10:
        $SundayVisitText = 'Ты бесшумно приближаешься к закрытой мастерской Ирмы и задерживаешься у приоткрытой боковой двери. Из полумрака доносятся два спокойных, размеренных голоса. Инга рассуждает о прочности льняных нитей и правильном подгибе подола так увлечённо, будто это важнее всех проповедей отца Герхарда. Ирма отвечает коротко, скупо на похвалу, но с явным профессиональным уважением к трудолюбию ученицы. Затем разговор смещается на лавку матери, заносчивость брата Эдди и то, как в этом портовом городе молодой девушке приходится учиться держать спину прямо задолго до того, как она осмелится мечтать о собственном счастье.'
    else:
        $SundayVisitText = 'Ты задерживаешься у закрытой мастерской портнихи и сквозь щель в ставне слышишь приглушённый диалог. Инга послушно расспрашивает о тонкостях двойного шва, а Ирма ровным, учительским тоном наставляет её. Они говорят о тканях, заказах знати и о том, что воскресенье — единственный день, когда можно шить в тишине, не отвлекаясь на капризных заказчиц у прилавка.'
    end
---

#SundayVisitIrmaIngaTalkText
    $SundayVisitIrmaIngaTalkTextId = LCASE($ARGS[0])
    $SundayVisitIrmaIngaTalkText = ''

    ! -------------------------------------------------------------------------
    ! ФОНОВЫЙ БЫТ И УЧЕНИЧЕСТВО В МАСТЕРСКОЙ
    ! -------------------------------------------------------------------------

    if $SundayVisitIrmaIngaTalkTextId = 'ambient_sewing_order':
        $SundayVisitIrmaIngaTalkText = 'У закрытой лавки ты слышишь мерный шелест разворачиваемого рулона сукна и щёлканье портновских ножниц:<br>'
        $SundayVisitIrmaIngaTalkText += '— Линию проймы держи твёрже, Инга, — наставляет полуэльфийка, постукивая костяным напёрстком по раскройному столу. — Сначала выведи безупречный силуэт, а уж потом нашивай кружева и ленты. Если основа кривая — никакие бархатные банты не спасут платье от позора на первом же балу.<br>'
        $SundayVisitIrmaIngaTalkText += '— Я стараюсь, Ирма... — кротко отзывается Инга. — Просто пальцы к вечеру не слушаются. Так хочется сделать шов идеальным, чтоб ни одна привереда из Верхнего квартала не посмела придраться.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'ambient_sunday_rest':
        $SundayVisitIrmaIngaTalkText = '— Утром в соборе кумушки опять шептались за моей спиной, — со вздохом роняет Инга, аккуратно сматывая нитки в клубок. — Будто я совершила страшный грех только тем, что надела чистое платье без фартука.<br>'
        $SundayVisitIrmaIngaTalkText += '— Праздные языки мелют от безделья, — ровно отзывается Ирма, даже не подняв взгляда от выкройки. — Воскресенье дано для покоя души и рук. Нитки от нас не убегут, а вот заказчицы уйдут к чужим портным, если строчка окажется косой. Учись слушать ткань, а не базарный гул.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'ambient_tavern_dress':
        $SundayVisitIrmaIngaTalkText = '— Для «Дикого Жеребца» Стефан опять заказал форму посмелее, — невозмутимо сообщает Ирма, примеряя лекало к тонкому сатину. — Корсажи глубже, юбки на ладонь выше колен. Слухи о новых порядках в трактире уже дошли до гильдейских портных.<br>'
        $SundayVisitIrmaIngaTalkText += '— Матушка говорит, что это бесстыдство... — смущённо кашляет Инга, пряча глаза.<br>'
        $SundayVisitIrmaIngaTalkText += '— Твоя мать продаёт муку и ром, а я продаю одежду, — спокойно парирует полуэльфийка. — Кто платит звонкой монетой — тот и задаёт длину подола. Твоё дело — сшить так, чтобы швы не разошлись, когда девицы будут крутить бёдрами перед гостями.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_irma_reverse_comfort':
        $SundayVisitIrmaIngaTalkText = '— Ты опять загоняешь себя в раковину, — тихо цокает языком Ирма, откладывая мел. — Вздрагиваешь от каждого шороха, будто за дверью стоит церковная стража.<br>'
        $SundayVisitIrmaIngaTalkText += '— У меня на плечах лавка матери и брат, которому лишь бы погулять, — с грустной робостью говорит Инга.<br>'
        $SundayVisitIrmaIngaTalkText += '— Жизнь коротка, девочка, — мягче обычного замечает Ирма. — Не хорони свою красоту под грубым холстом. Ты молода, миловидна, и если мужчина смотрит на тебя с горящими глазами — не прячься, а учись управлять этим взглядом.'

    ! -------------------------------------------------------------------------
    ! МЕЧТЫ: ШВЕЙНАЯ МАШИНКА И ПОСОХ ПРЕДКОВ
    ! -------------------------------------------------------------------------

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_sewing_machine':
        $SundayVisitIrmaIngaTalkText = 'Инга говорит с затаённым восторгом, глаза её сияют в полумраке мастерской:<br>'
        $SundayVisitIrmaIngaTalkText += '— Ирма, заезжий купец рассказывал про столичную диковинку... Швейная машинка из полированной стали с ножной педалью! Челнок мелькает быстрее птичьего крыла, игла кладёт строчку ровнее натянутой струны — в одиночку за час можно сделать то, над чем три ученицы целый день корпят!<br>'
        $SundayVisitIrmaIngaTalkText += '— Слышала о таких механизмах гномьей работы, — сухо роняет Ирма, но в голосе её мелькает интерес. — И сколько за неё просят?<br>'
        $SundayVisitIrmaIngaTalkText += '— Целое состояние... — вздыхает Инга. — Десятки мараведи! То говорят «только для королевских мануфактур», то «уже погрузили на корабль». Вот бы нам такую в лавку... Мы бы весь город одели!'

    elseif $SundayVisitIrmaIngaTalkTextId = 'irma_dream_ancestral_staff':
        $SundayVisitIrmaIngaTalkText = 'Ирма говорит непривычно тихо, и в её голосе оживает древняя эльфийская печаль:<br>'
        $SundayVisitIrmaIngaTalkText += '— Посох предков... Древнее древо, увитое серебряной лозой. Жрицы священной Рощи держали его в руках, когда мой эльфийский дед ещё пел гимны звёздам над морем. Память нашего угасающего рода.<br>'
        $SundayVisitIrmaIngaTalkText += '— Жрицы Рощи? — удивляется Инга, благоговейно замерев. — Я думала, тебе важны лишь фасоны да заказы знатных дам...<br>'
        $SundayVisitIrmaIngaTalkText += '— Ткань кормит бренное тело, — ровно отзывается полуэльфийка. — А древний посох хранит дух. Сколько я ни пыталась выкупить его у столичных перекупщиков: то заламывают цену целого замка, то вовсе прячут от чужих глаз. Мечтаю вернуть его к корням. Но пока... стежок за стежком, продолжаем жить.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'irma_uniform_gossip':
        $SundayVisitIrmaIngaTalkText = '— В Верхнем квартале только и разговоров, что о трактире Стефана, — делится Ирма, примеряя шёлковую тесьму. — Шепчутся про глубокие декольте, про то, как девицы разносят пиво. Знатные дамы морщат носики, а их мужья всё чаще заглядывают в «Дикий Жеребец» на кружку эля.<br>'
        $SundayVisitIrmaIngaTalkText += '— Матушка считает, что это позор на всю округу, — краснеет Инга.<br>'
        $SundayVisitIrmaIngaTalkText += '— Позором это называют те, кому нечего показать, — усмехается Ирма. — А для трактира это чистая выручка. Шей крепче: слухи улягутся, а золото останется.'

    ! -------------------------------------------------------------------------
    ! СТРАЖНИК ГРЮН: УГРОЗА, СПАСЕНИЕ ИЛИ БЕДА
    ! -------------------------------------------------------------------------

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_guard_grun':
        $SundayVisitIrmaIngaTalkText = '— Сержант Грюн опять крутился у нашего прилавка, — Инга говорит со злым, испуганным надрывом. — Смотрит волком, задевает локтем, грозит проверками пошлин... Будто я воровка какая-то, а не честная дочь лавочницы!<br>'
        $SundayVisitIrmaIngaTalkText += '— Он упивается властью, — холодно роняет Ирма. — Такие псы в латах опаснее бродяг: у них закон за спиной. Запомни, Инга: если найдётся мужчина, способный тебя защитить — не стыдись принять помощь. А пока держи спину прямо и не опускай глаз.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_guard_resolved':
        $SundayVisitIrmaIngaTalkText = '— Сержант Грюн больше не смеет приближаться к нашей лавке! — с глубоким, счастливым облегчением выдыхает Инга, и слышно, как шуршит шёлк под её пальцами. — Стефан вмешался... Сам пошёл к посту стражи, нашёл на него управу и решил всё раз и навсегда! Не знаю, сколько серебра он отдал или как нажал, но Грюн теперь обходит наш угол стороной!<br>'
        $SundayVisitIrmaIngaTalkText += '— Вот как? — Ирма на миг отрывается от раскроя, и в её глазах мелькает искреннее уважение. — А твой Стефан оказался мужчиной с крепким хребтом. Осадить сержанта городской стражи — для этого нужны не только монеты, но и храбрость. Только помни, девочка: молодые трактирщики редко рискуют головой ради чужих девиц из одной лишь доброты. Береги честь, если не хочешь потом расплачиваться совсем иным швом.<br>'
        $SundayVisitIrmaIngaTalkText += '— Он ничего не требовал... — тихо и смущённо роняет Инга, а щёки её вспыхивают жаром. — Просто встал на мою защиту. Как настоящий рыцарь.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_guard_failed':
        $SundayVisitIrmaIngaTalkText = '— Этот проклятый Грюн... — голос Инги срывается на судорожный всхлип, ножницы в её руке мелко дрожат. — Каждый четверг заявляется в лавку. Требует то поборы, то заставляет пройти с ним на задний склад... Лапает за талию, шепчет мерзости прямо в лицо! А я даже матери сказать боюсь — Бекки кинется на него с топором и её бросят в темницу!<br>'
        $SundayVisitIrmaIngaTalkText += '— А трактирщик твой хвалёный? — сухо и строго спрашивает Ирма. — Разве он не обещал помочь?<br>'
        $SundayVisitIrmaIngaTalkText += '— Стефан отвернулся... — горько шепчет девушка, утирая слёзы рукавом. — Сделал вид, что это не его дело. Теперь я совсем одна против этой твари в кирасе. Хоть в реку бросайся...'

    ! -------------------------------------------------------------------------
    ! ЛУКАС: КУЗНЕЧНАЯ СИЛА ПРОТИВ ТРУСОСТИ И РАЗРЫВ
    ! -------------------------------------------------------------------------

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_lucas_coward':
        $SundayVisitIrmaIngaTalkText = '— Знаешь, Ирма... я ведь думала, что Лукас — это гора, несокрушимая опора, — глухо признаётся Инга с горькой усмешкой. — Здоровенный подмастерье, кузнечный молот одной левой крутит, плечи — косая сажень. А как подошёл стражник с угрозами — Лукас глаза в пыль уткнул, за спину к наковальне шмыгнул и слова в мою защиту не вымолвил! Задрожал как осиновый лист перед бляхой стражника!<br>'
        $SundayVisitIrmaIngaTalkText += '— Мускулы кузнеца не делают его храбрецом, — спокойно замечает Ирма, отмеряя тесьму. — Железо ковать мужества не требуется — наковальня сдачи не даст. А вот пойти против вооружённого стражника — тут нужна воля. Стефан куда моложе, а не струсил.<br>'
        $SundayVisitIrmaIngaTalkText += '— Вот и я о том же... — тихо вздыхает Инга. — Смотрю теперь на Лукаса — и видеть его противно. Тело медвежье, а сердечко трусливое.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_lucas_rejected':
        $SundayVisitIrmaIngaTalkText = '— Лукас вчера опять под моими окнами скребся, — Инга усмехается дерзко, и в её голосе звучит непривычная сила. — Свистел, звал впотьмах за сарай, думал, я как дурочка выбегу по первому зову. «Инга, выгляни, я соскучился, давай по-быстрому...» — передразнивает она его бас. — А я подошла к окну, посмотрела ему прямо в зенки — и с размаху захлопнула ставни на кованый засов прямо перед его носом!<br>'
        $SundayVisitIrmaIngaTalkText += '— И правильно сделала, — одобряет полуэльфийка с лёгкой улыбкой. — Привык, что женщины перед его кузнечной силой трепещут. Пусть помёрзнет на сквозняке. Если мужчина видит в тебе лишь бесплатную забаву на задворках — ему самое место за запертой дверью.<br>'
        $SundayVisitIrmaIngaTalkText += '— Он там ещё долго матерился в кулак, — посмеивается Инга. — А у меня будто камень с души упал.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_lucas_corner':
        $SundayVisitIrmaIngaTalkText = '— Вспоминаю, как Лукас раньше зажимал меня по углам... — Инга вздыхает и нервно теребит край фартука. — Руки тяжёлые, грубые, от него всегда гарью и копотью пахнет. Требовал своё, будто я уже его законная собственность.<br>'
        $SundayVisitIrmaIngaTalkText += '— Не путай привычку с будущим, девочка, — наставляет Ирма. — Грубая сила привлекает неопытных дурочек, но в браке она быстро оборачивается синяками. Ищи мужчину, который видит в тебе человека, а не просто грелку для постели.'

    ! -------------------------------------------------------------------------
    ! СТЕФАН: СЛАДОСТЬ ПОДСОБКИ, ПЕРЕУЛОК И ТАНЦЫ
    ! -------------------------------------------------------------------------

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_stefan_backroom':
        $SundayVisitIrmaIngaTalkText = 'Инга долго мнёт в руках шёлковый отрез, а затем, пугливо оглянувшись на дверь, понижает голос до горячего шёпота:<br>'
        $SundayVisitIrmaIngaTalkText += '— Ирма... Стефан на неделе зашёл к нам в лавку. Проскользнул за мной в заднюю каморку, за мешки с мукой... задвинул засов.<br>'
        $SundayVisitIrmaIngaTalkText += '— И ты, разумеется, закричала на весь базар? — с тонким ехидством усмехается портниха.<br>'
        $SundayVisitIrmaIngaTalkText += '— Да какой там крик... — Инга густо краснеет, закрывая пылающие щёки ладонями. — У меня сердце в горле колотилось! В зале матушка ходит, Эдди у весов монетами звенит, доски скрипят, а Стефан прижал меня к стене... Ласкал так нежно, жарко, пальцы сильные, уверенные... У меня земля из-под ног ушла! Я зубами за подол вцепилась, чтоб ни звука не проронить, пока он меня целовал и брал... Ильматер всеблагой, я и представить не могла, что плотская близость может быть такой неземной сладостью!<br>'
        $SundayVisitIrmaIngaTalkText += '— Вся в мать пошла, — качает головой Ирма с понимающей усмешкой. — Бекки в молодости тоже приличиями не страдала. Что ж, дело молодое. Главное, чтоб Стефан ценил твою нежность, а не хвастал победой перед собутыльниками.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_stefan_dance_room':
        $SundayVisitIrmaIngaTalkText = '— В пятницу на танцах... Стефан кружил меня так, что у меня дух захватило! — Инга мечтательно улыбается, за умелыми пальцами мелькает серебряная игла. — Вся площадь на нас смотрела! Лукас в толпе от бессильной ярости кулаки грыз, а Стефан обнял меня за талию, прижал к своей груди... и поцеловал прямо под праздничными фонарями! Так властно, по-хозяйски... А потом увёл за собой в комнату...<br>'
        $SundayVisitIrmaIngaTalkText += '— Стефан знает себе цену и умеет держать удар перед толпой, — ровно замечает Ирма. — В нём проступает благородная кровь. Но помни: город полон завистниц, теперь каждая торговка будет разглядывать твои наряды под микроскопом.<br>'
        $SundayVisitIrmaIngaTalkText += '— Да пусть смотрят! — с горделивым вызовом отзывается Инга. — Зато я впервые почувствовала себя желанной красавицей, а не забитой базарной девкой!'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_stefan_alley':
        $SundayVisitIrmaIngaTalkText = 'Инга опускает голос до пугливого, прерывистого шёпота, в глазах её пляшут испуганные и греховные искры:<br>'
        $SundayVisitIrmaIngaTalkText += '— Ирма... если бы кто-то заглянул за угол — я бы умерла от стыда... После танцев Стефан увлёк меня в тёмный закоулок за складами. В паре шагов ярмарка гудит, пьяные кричат, а он вжал меня спиной в холодный камень... Опустил на колени прямо в пыль, я губами его мужскую силу ласкала, а потом он поднял меня и овладел прямо у стены... Я от страха и дикого восторга чуть с ума не сошла!<br>'
        $SundayVisitIrmaIngaTalkText += '— Безумцы, — строго цокает языком полуэльфийка, но в глазах её мелькает искра одобрения. — Каменные стены в подворотнях сырые — застудишь женское лоно ради пяти минут страсти. Но смелость твоего Стефана мне нравится. Держись за него, девочка.'

    elseif $SundayVisitIrmaIngaTalkTextId = 'inga_eddie_counter':
        $SundayVisitIrmaIngaTalkText = '— Эдди опять весь день у прилавка зубы скалил молоденьким покупательницам, — сердито фыркает Инга. — То яблоко бесплатно сунет, то масляно подмигнёт. Мнит себя первым женихом на рынке!<br>'
        $SundayVisitIrmaIngaTalkText += '— Брат твой глуповат и тщеславен, — безжалостно констатирует Ирма. — Мужчины часто путают вежливость с покорностью. Не спорь с ним у мешков с мукой. Твоё оружие — мастерство и независимость. Кто умеет шить на заказ, тот никогда не пропадёт, когда лавка достанется другим.'

    end

    killvar '$SundayVisitIrmaIngaTalkTextId'
---
