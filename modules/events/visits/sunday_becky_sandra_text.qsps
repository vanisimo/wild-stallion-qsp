! ================================================
! FILE: modules/events/visits/sunday_becky_sandra_text.qsps
! MODULE: events/visits
! [AI-WORKED] Текст переработан / дополнен ассистентом 04.10.2026
! Тексты воскресных разговоров: Бекки Блэнкеншип и Сандра Лонгкок
! Локация: закрытая продуктовая лавка Бекки на рынке (воскресенье, день/вечер)
! 
! Структура:
! - #SundayVisitBeckySandraText — вводный нарратив подслушивания у окна лавки
! - #SundayVisitBeckySandraTalkText — ветки тем из пула (sunday_becky_sandra_talk_pick.qsps)
! - #SundayVisitBeckySandraGearGossipText — сплетня о шестерёнке в соборе (наводка на тайник)
! ================================================

#SundayVisitBeckySandraText
    if BeckySandraChurchGearGossipCanHear = 1:
        gs 'SundayVisitBeckySandraGearGossipText'
        exit
    end

    SundayVisitSlotKey = day * 10 + time
    if SundayBeckySandraVisitSlotSeen[SundayVisitSlotKey] = 1 and SundayVisitSessionListenCount = 0:
        $SundayVisitText = 'Ты снова задерживаешься у окна лавки Бекки, но в помещении уже тихо: подруги либо разошлись по делам, либо закончили свои сокровенные разговоры. На этот час ты услышал всё, что мог.'
        exit
    end

    if $SundayVisitBeckySandraPickedId <> '':
        gs 'SundayVisitBeckySandraTalkText', $SundayVisitBeckySandraPickedId
        $SundayVisitText = $SundayVisitBeckySandraTalkText
        killvar '$SundayVisitBeckySandraTalkText'
        exit
    end

    ! Режиссура сцены тренировки в зале (допустима до роста скандала)
    if LOC('HallPlayCoachCanOffer') = 1:
        gs 'HallPlayCoachCanOffer', 'sandra'
        if HallPlayCoachCanOffer = 1:
            $SundayVisitBeckySandraPickedId = 'play_coach_sandra'
            gs 'SundayVisitBeckySandraTalkText', 'play_coach_sandra'
            $SundayVisitText = $SundayVisitBeckySandraTalkText
            killvar '$SundayVisitBeckySandraTalkText'
            exit
        end
    end

    ! Реакция на публичный скандал вокруг трактира
    if LOC('SandraBeckySundayScandalCanHear') = 1:
        gs 'SandraBeckySundayScandalCanHear'

        if SandraBeckySundayScandalCanHear = 1:
            gs 'SundayVisitBeckySandraScandalText'
            exit
        end
    end

    gs 'SundayVisitBeckySandraPickPhrase'

    if SundayVisitBeckySandraPickOk = 1:
        gs 'SundayVisitBeckySandraTalkText', $SundayVisitBeckySandraPickedId
        $SundayVisitText = $SundayVisitBeckySandraTalkText
        killvar '$SundayVisitBeckySandraTalkText'
        exit
    end

    ! Базовый нарратив при отсутствии специфических сюжетных триггеров
    if SandraTrustStefan >= 10:
        $SundayVisitText = 'Ты осторожно подходишь к закрытой продуктовой лавке и сквозь деревянные ставни слышишь негромкие, задушевные женские голоса. Бекки говорит мягко, с непривычной для неё материнской теплотой, а Сандра отвечает ей куда откровеннее и спокойнее, чем когда-либо говорит в стенах трактира. Они вспоминают молодость, обсуждают хозяйство и то, как быстро выросли дети. Бекки с тихим смешком напоминает подруге, что этот город никогда не был святым, как бы истово горожане ни били поклоны в храме по утрам. Сандра долго молчит в ответ, а затем глухо признаёт: больше всего она боится не людской молвы, а того, что однажды останется совсем одна в пустом доме со своими бесконечными запретами.'
    else:
        $SundayVisitText = 'Ты бесшумно подходишь к закрытой лавке Бекки и замираешь у приоткрытой створки. За ней звучит приглушённый, усталый разговор. Бекки пытается подбодрить подругу, но в голосе Сандры сквозит глухое напряжение: она разрывается между кухней, дочерьми и трактирными счетами. Чувствуется, что Сандра не уверена в завтрашнем дне, однако рядом с давней соседкой она позволяет себе сбросить маску суровой хозяйки и выговориться начистоту.'
    end
---

#SundayVisitBeckySandraTalkText
    $SundayVisitBeckySandraTalkTextId = LCASE($ARGS[0])
    $SundayVisitBeckySandraTalkText = ''

    ! -------------------------------------------------------------------------
    ! СЮЖЕТНЫЕ РЕЖИССУРЫ И СПЕЦИАЛЬНЫЕ СОБЫТИЯ
    ! -------------------------------------------------------------------------

    if $SundayVisitBeckySandraTalkTextId = 'play_coach_sandra':
        if LOC('HallPlayCoachBuildCombinedText') = 1:
            gs 'HallPlayCoachBuildCombinedText', 'sandra'
            $SundayVisitBeckySandraTalkText = $HallPlayCoachCombined
            killvar '$HallPlayCoachCombined'
        else
            $SundayVisitBeckySandraTalkText = 'У приоткрытого окна лавки ты подслушиваешь, как Бекки со звонким хохотом учит Сандру женским хитростям:<br>'
            $SundayVisitBeckySandraTalkText += '— Да ты просто бёдрами у котла поведи, когда похлёбку наливаешь! Девки твои в зале вон как задом крутят — и серебро рекой! А ты встанешь как соляной столб. Мужик любит, когда у плиты баба сочная, а не святая монашка!<br>'
            $SundayVisitBeckySandraTalkText += 'Сандра в ответ лишь стыдливо шипит, но спорить не пытается.'
        end

    ! -------------------------------------------------------------------------
    ! ФОНОВЫЙ БЫТ И АТМОСФЕРА ГОРОДА
    ! -------------------------------------------------------------------------

    elseif $SundayVisitBeckySandraTalkTextId = 'ambient_family_tavern':
        $SundayVisitBeckySandraTalkText = 'У закрытой лавки до тебя доносится неторопливый, домашний разговор под мерный стук глиняных кружек:<br>'
        $SundayVisitBeckySandraTalkText += '— Руки к вечеру отнимаются, — вздыхает Сандра, и слышно, как она с наслаждением растирает натруженные пальцы. — Котёл на сорок кварт, пироги, жар от печи такой, что пот градом... А ведь ещё надо за дочками приглядеть. Аманда опять весь вечер ленты гладит, Мелисса в свои книги уткнётся и слова не вытянешь. Стефан, правда, за дело взялся... Ходит хозяином, брови хмурит, порядок наводит.<br>'
        $SundayVisitBeckySandraTalkText += '— И слава Ильматеру, что взялся, — отзывается Бекки, шурша сушёными травами. — Мальчишка в кость пошёл, стать появилась. А ты перестань всё на своём горбу тащить, подруга. Наш город на женщинах держится только потому, что мы умеем вовремя смолчать и дать мужику почувствовать себя защитником. Ты бы лучше о себе подумала — румянец-то у тебя от жара печи, а не от мужских поцелуев.'

    elseif $SundayVisitBeckySandraTalkTextId = 'ambient_sunday_church':
        $SundayVisitBeckySandraTalkText = '— Утром на проповеди святоши опять на меня косились, — с горьким вздохом роняет Сандра. — Старая вдова Марта губы поджала, будто я грешница из портового кабака. И ведь сама каждое слово отца Герхарда ловит, а в глазах одна злоба...<br>'
        $SundayVisitBeckySandraTalkText += '— Да плюнь ты на них с колокольни! — заливается грудным хохотом Бекки. — Сами от зависти сохнут, что на них уже тридцать лет ни один мужик без содрогания не глянет! А на тебя в твои годы парни заглядываются. Я вот исповедь сегодня проспала — и ничего, солнце так же светит, крупа не сгнила. Отец Герхард сам на исповеди про плоть такие вещи выспрашивает, что уши горят. Ильматер всеблагой заповедал в чистоте тело держать, а не в унынии себя заживо хоронить.'

    ! -------------------------------------------------------------------------
    ! МЕЧТЫ И СТРЕМЛЕНИЯ ЖЕНЩИН
    ! -------------------------------------------------------------------------

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_dream_recipe_codex':
        $SundayVisitBeckySandraTalkText = 'Сандра понижает голос до благоговейного шёпота, в котором звучит затаённая страсть истинного мастера:<br>'
        $SundayVisitBeckySandraTalkText += '— Знаешь, Бекки... есть одна книга. «Рецепты Короны» зовётся. В столице печатали, для гильдии королевских поваров. Говорят, там такие составы пряностей описаны и такие способы запекания дичи, что даже простое баранье плечо становится нежнее лебединого пуха. С такой книгой наш трактир стал бы лучшим на всём побережье — к нам бы дворяне из самого замка на ужины съезжались!<br>'
        $SundayVisitBeckySandraTalkText += '— Ну и чего не купишь? — хмыкает Бекки. — Монет в кассе не хватает?<br>'
        $SundayVisitBeckySandraTalkText += '— Да где её сыщешь... — печально вздыхает Сандра. — Сколько купцов с обозами ни расспрашивала: то цену за фолиант ломят как за породистого жеребца, то «только для знати», то с последним столичным кораблём увезли. Мечта, да и только. А у меня котёл и без королевских трав кипит...'

    elseif $SundayVisitBeckySandraTalkTextId = 'amanda_dream_full_mirror':
        $SundayVisitBeckySandraTalkText = '— Аманда моя совсем голову потеряла, — вполголоса жалуется Сандра, качая головой. — Каждый вечер перед начищенным серебряным подносом вертится. Жалуется, что в нём рожа пятном расплывается, складок не разглядеть. Мечтает о настоящем стеклянном зеркале во весь рост! Чтоб из столицы привезли, в резной раме...<br>'
        $SundayVisitBeckySandraTalkText += '— Ишь чего захотела! — фыркает Бекки с усмешкой. — Ростовое стекло! Да за такое зеркало любой купец приданое дворянское потребует! Девка-то красивая, спору нет, стать точёная. Но зеркало такое — барская блажь.<br>'
        $SundayVisitBeckySandraTalkText += '— Сама знаю, — вздыхает мать. — Приценивалась она на ярмарке у заморских гостей: те как загнули цену — хоть трактир закладывай. Пока лентами да побрякушками обходится, а глазищи всё равно горят.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_dream_stallion_cucumber':
        SundayVisitBeckyCucumberRoll = RAND(1, 4)

        if SundayVisitBeckyCucumberRoll = 1:
            $SundayVisitBeckySandraTalkText = '— «Конский ствол»! — раскатистый хохот Бекки сотрясает деревянную перегородку лавки. — Ты только представь этот сорт огурцов! Длинный, толщиной с запястье кузнеца, да ещё с утолщением на конце, вылитая головка жеребца! Умора!<br>'
            $SundayVisitBeckySandraTalkText += '— Бекки, ради Ильматера, постыдись! — Сандра давится смехом, прикрывая рот фартуком. — Куда тебе такой овощ на грядке?!<br>'
            $SundayVisitBeckySandraTalkText += '— Куда надо! — подмигивает Бекки. — В салат со сметанкой покрошить, ну и... на ночь под подушку положить, раз мужика законного в доме нет! Семена искала у столичных травников: то продают только мешками, то цены дерут. А эх, какая грядка бы вышла — все бабы на рынке слюной бы захлебнулись!'
        elseif SundayVisitBeckyCucumberRoll = 2:
            $SundayVisitBeckySandraTalkText = '— Вот скажи мне, Сандра, как повариха поварихе, — лукаво протягивает Бекки, звякая весами. — Огурец редкого сорта «Конский ствол»... на вкус слаще до того, как его используешь не по назначению, или после?<br>'
            $SundayVisitBeckySandraTalkText += '— Бекки, ты невыносима! — Сандра хохочет до слёз, хлопая подругу по плечу. — После твоего «использования» это уже не огурец, а грех против священной чистоты Ильматера!<br>'
            $SundayVisitBeckySandraTalkText += '— Зато против бабьего одиночества — вернейшее лекарство, — вздыхает та с улыбкой. — Жаль, семян таких в нашем захолустье днем с огнем не сыскать.'
        elseif SundayVisitBeckyCucumberRoll = 3:
            $SundayVisitBeckySandraTalkText = '— Какой огурец для женского стола аппетитнее? — с самым серьёзным видом рассуждает Бекки. — Короткий да пупырчатый крепыш, или гладкий, длинный, с налитой головкой?<br>'
            $SundayVisitBeckySandraTalkText += '— Перестань, умоляю, я сейчас лопну со смеху! — умоляет Сандра.<br>'
            $SundayVisitBeckySandraTalkText += '— Да я про засолку, подруга! Хотя... критерии-то одни и те же, сама понимаешь. Мужа похоронила давно, а тело-то ласки просит. Редкие семена, диковинные. Найти бы — устроила бы праздник для души.'
        else:
            $SundayVisitBeckySandraTalkText = '— Хрустит знатно, соком брызжет, — мечтательно причмокивает Бекки, а затем покатывается со смеху вместе с Сандрой. — Ох, Сандра, грешно смеяться над вдовьей долей! Был бы у меня в огороде такой «Конский ствол» — я б на рынок только к обеду выходила, сытая и довольная. А пока приходится на простых огурчиках перебиваться.'
        end

        killvar 'SundayVisitBeckyCucumberRoll'

    ! -------------------------------------------------------------------------
    ! СЕКРЕТЫ ЗАДНЕЙ КОМНАТЫ БЕККИ И МУЖСКИЕ ПРИКЛЮЧЕНИЯ
    ! -------------------------------------------------------------------------

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_reverse_comfort':
        $SundayVisitBeckySandraTalkText = '— Ты опять сама себя по рукам бьёшь, — с досадой цокает языком Бекки, наливая подруге травяной настой. — Сидишь, вся застёгнутая на все пуговицы, будто святая праведница пред алтарём.<br>'
        $SundayVisitBeckySandraTalkText += '— У меня дочери на выданье и весь трактир на виду! — смущённо возражает Сандра. — Оступись я хоть раз — город костями перемелет.<br>'
        $SundayVisitBeckySandraTalkText += '— Город перемелет в любом случае, — отрезает Бекки. — А молодость и сок утекают, как вино из дырявого бочонка. У меня вон за задней занавеской матросы да торговцы не переводятся — и что? Жива, румяна, спина не болит. Ты мне про скромность сказки не рассказывай: сама-то, небось, ночами ворочаешься и пальцами простыни сжимаешь!'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_two_men':
        $SundayVisitBeckySandraTalkText = 'Бекки заговорщицки наклоняется к Сандре, и голос её дрожит от сытого, похотливого восторга:<br>'
        $SundayVisitBeckySandraTalkText += '— Помнишь прошлую пятницу? Зашли ко мне двое матросов с южного брига. Плечищи — во, пахнут солью, ветром и крепким ромом! Я их сразу за мешки с овсом увлекла, щеколду задвинула — и сразу обоих в оборот! Один спереди в рот заходит, второй сзади подол задрал и наяривает... В два ствола, Сандра, без передышки!<br>'
        $SundayVisitBeckySandraTalkText += '— Ильматер всеблагой... — Сандра испуганно крестится знаком Круга и озирается на окно. — Бекки, да тише ты! На рынке же шепчутся!<br>'
        $SundayVisitBeckySandraTalkText += '— Пусть шепчут! Завидуют, дуры! Я была мокрая заранее, сама им на колени прыгнула. А у окна, кстати, тень мелькала... Стефан твой подглядывал, не иначе. И правильно, пусть парень видит, как зрелая женщина удовольствие берёт. А ты мне про скромность не зуди — думаешь, я не знаю, зачем ты к столяру-гному Драупниру по пятницам бегаешь?'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_guard':
        $SundayVisitBeckySandraTalkText = '— Сержант Грюн опять на днях в заднюю заглядывал, — буднично рассказывает Бекки, пересчитывая медяки. — «Проверка весов», говорит, а сам ладонью в кованой перчатке мне прямо под юбку полез. Пришлось усадить слугу закона на мешок с солью да уважить его сержантский чин губами.<br>'
        $SundayVisitBeckySandraTalkText += '— Сержант стражи?! — ахает Сандра. — Бекки, он же тебя шантажировать может!<br>'
        $SundayVisitBeckySandraTalkText += '— Чем? Тем, что сам стонал как мартовский кот? — ухмыляется вдовушка. — Грюн любит чувствовать власть, а я люблю, когда стражники мою лавку стороной обходят и пошлинами не душат. Дело взаимовыгодное. Ты вон к мэру в ратушу тоже «по делам налогов» ходишь — не учи меня с властями договариваться!'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_neighbor':
        $SundayVisitBeckySandraTalkText = '— Сосед-то наш, лавочник снизу, опять за солью заглядывал, — тихо посмеивается Бекки. — Перед женой ходит тише воды, в храме лоб расшибает, а у меня на мешках стонал так, что голуби под крышей разлетелись!<br>'
        $SundayVisitBeckySandraTalkText += '— Бекки... это же чужой муж, — укоризненно качает головой Сандра.<br>'
        $SundayVisitBeckySandraTalkText += '— Муж чужой, а передок у него свой, — фыркает подруга. — Жена ему раз в месяц под одеялом даёт, а мужчина ласки требует. Я никого не неволю — сами в очередь выстраиваются.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_clerk':
        $SundayVisitBeckySandraTalkText = '— Вчера клерк из ратуши заходил, — ухмыляется Бекки. — Весь из себя важный, в чернилах, с долговой книгой под мышкой. «У вас недоимка по торговой пошлине!» — кричит. Я дверь на засов, платье с плеча спустила, на мешок села: «Давай, говорю, оформлять альтернативную выплату». Через полчаса печать шлёпнул и ушёл на полусогнутых!<br>'
        $SundayVisitBeckySandraTalkText += '— Налоги телом платить... — Сандра качает головой, но в глазах мелькает улыбка. — Ну ты и бестия, Бекки.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_old_client':
        $SundayVisitBeckySandraTalkText = '— Старый бондарь опять заходил, — голос Бекки звучит непривычно мягко. — Два года как овдовел, в глазах тоска смертная. Пришёл за сухарями, а сам дрожит. Завела его, раздела, согрела... Посидел у меня на груди, поплакал, а потом так сладко и благодарно приласкал, как молодые не умеют.<br>'
        $SundayVisitBeckySandraTalkText += 'Сандра сочувственно вздыхает:<br>'
        $SundayVisitBeckySandraTalkText += '— Одиночество — страшная штука, Бекки. Ильматер видит, ты хоть и грешишь, но сердце у тебя доброе.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_lucas':
        $SundayVisitBeckySandraTalkText = '— Лукас на неделе ко мне в заднюю сунулся, — Бекки говорит вполголоса. — Весь насупленный, кулачищи сжаты. Твоя Инга его отшила со свиданием, парень от злости и похоти чуть на стену не лез. Пришлось остудить молотобойца...<br>'
        $SundayVisitBeckySandraTalkText += '— Ты... с женихом собственной дочери?! — Сандра замирает в неподдельном ужасе.<br>'
        $SundayVisitBeckySandraTalkText += '— Какой он жених? Дубина стоеросовая! — отмахивается Бекки. — Инга нос воротит, а у парня соки через край бьют. Лучше пусть у меня спустит, чем на улице девку какую заломает. Ствол у него, конечно, богатырский... Эдди в лавке крупу вешал, а этот увалень мне в подол уткнулся и рычал как медведь.'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_backroom_eddie_near':
        $SundayVisitBeckySandraTalkText = '— На днях такой случай вышел — чуть со стыда не сгорела, — смеётся Бекки. — Затащила купца в заднюю, нагнулась над мешками, юбка задрана, он сзади вовсю пыхтит. И тут мой Эдди в лавку заходит и кричит: «Мам! Почём овёс отдавать?!» А я, задыхаясь от толчков, ору: «По шесть медяков, паразит, не видишь — мать товар принимает!»<br>'
        $SundayVisitBeckySandraTalkText += '— Сын же рядом был! — Сандра прижимает ладони к пылающим щекам. — Безумная ты женщина, Бекки!'

    ! -------------------------------------------------------------------------
    ! СТЕФАН, СЕМЬЯ И СЕКРЕТЫ САНДРЫ
    ! -------------------------------------------------------------------------

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_stefan_gossip':
        $SundayVisitBeckySandraTalkText = '— Стефан твой совсем взрослый стал, — протягивает Бекки с лукавым прищуром. — Намедни за мукой заходил, так пока мешок поднимал, я на его плечи да спину загляделась. Мужчина! А как взглядом меня припечатал — у меня аж между ног потеплело. Силушка в нём баронская просыпается, Сандра. Смотри, уведут парня городские вертихвостки.<br>'
        $SundayVisitBeckySandraTalkText += '— Стефан трактиром занят, — строго обрывает Сандра, но щёки её предательски алеют. — И вообще, не смей на моего сына так плотоядно смотреть, я тебя насквозь вижу!'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_stefan_first':
        $SundayVisitBeckySandraTalkText = 'Сандра сидит ни жива ни мертва, её пальцы судорожно сжимают край передника:<br>'
        $SundayVisitBeckySandraTalkText += '— Бекки... если бы ты знала... Я со Стефаном... Мы перешли черту. Я мать ему, понимаешь?! Мать! А когда он ко мне прикоснулся, когда обнял... у меня вся воля испарилась, я отдалась ему как последняя девка!<br>'
        $SundayVisitBeckySandraTalkText += 'Бекки спокойно подходит, обнимает подругу за плечи и твёрдо говорит:<br>'
        $SundayVisitBeckySandraTalkText += '— Тихо, дурёха, не вой. Земля не разверзлась, Ильматер молнией не ударил. Стефан взрослый, крепкий самец, ты — цветущая, истосковавшаяся баба. В этом городе и не такое творится. Главное — что между вами не насилие, а страсть. Ты лучше скажи: хорошо хоть было?<br>'
        $SundayVisitBeckySandraTalkText += '— Так хорошо... что страшно, — еле слышно выдыхает Сандра, пряча лицо на груди подруги.'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_stefan_marathon':
        $SundayVisitBeckySandraTalkText = '— Я еле до тебя доковыляла, — полушёпотом признаётся Сандра, и в её глазах пылает греховный, сытый огонь. — Стефан вчера... семь раз, Бекки! Семь! Всю ночь переворачивал, как хотел, ни на минуту передохнуть не давал. Ноги до сих пор трясутся, внутри всё пылает... Откуда в нём столько первобытной силы?!<br>'
        $SundayVisitBeckySandraTalkText += '— Ого! — Бекки присвистывает с откровенной белой завистью. — Вот это жеребец! Порода! Сандра, да тебе весь город завидовать должен. Живи и радуйся, пока соки кипят — такой любовник на вес золота, хоть и собственный сын!'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_lewd_hall':
        $SundayVisitBeckySandraTalkText = '— На днях в зале... подол зацепился, юбка задралась прямо на лестнице, — смущённо бормочет Сандра. — Гости рты разинули, а Стефан стоял за стойкой и смотрел... Не подошёл прикрыть, а только улыбнулся и взглядом по моим бёдрам скользнул. У меня аж дыхание перехватило.<br>'
        $SundayVisitBeckySandraTalkText += '— Значит, нравится ему, когда мать желанна, — поддакивает Бекки. — Умный хозяин знает: красивая хозяйка — половина выручки!'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_gnome_friday':
        $SundayVisitBeckySandraTalkText = '— Ты по пятницам к гному Драупниру в мастерскую не только за полочками бегаешь, — со смешком подначивает Бекки. — Коренастый столяр, руки железные, молотом по наковальне гремит, а ты возвращаешься с горящими глазами!<br>'
        $SundayVisitBeckySandraTalkText += '— Перестань! — шипит Сандра, нервно поправляя волосы. — Драупнир уважаемый мастер, он помогает трактиру!<br>'
        $SundayVisitBeckySandraTalkText += '— Помогает, помогает, — хохочет Бекки. — Особенно по части женского здоровья помогает. Не отпирайся, я по походке вижу!'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_about_kids':
        $SundayVisitBeckySandraTalkText = '— Стефан-то совсем взрослым стал, — с затаённой материнской гордостью произносит Сандра. — Вчера вышел на крыльцо — осанка гордая, взгляд хозяйский, чистый барон! А дочки... Мелисса вся в трактатах да язвит, Аманда о танцах бредит. Устаю с ними, конечно, но смотрю на них — и молодость вспоминаю. Как сама когда-то хороводы водила да сердца разбивала!<br>'
        $SundayVisitBeckySandraTalkText += '— Ой, не напоминай! — смеётся Бекки. — За тобой полгорода с высунутыми языками бегало, пока замуж не вышла!'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_ntr_daughters_butt':
        $SundayVisitBeckySandraTalkText = '— Дочки в зале совсем берега потеряли, — жалуется Сандра. — Аманда бёдрами покачивает, Мелисса в глубоком вырезе наклоняется перед пьяницами ради серебра... И ведь выручка растёт, Стефан доволен, слова против не скажешь!<br>'
        $SundayVisitBeckySandraTalkText += '— Девки молодые, своё берут, — резонно замечает Бекки. — А ты на себя в зеркало глянь: стать стать хозяйская, грудь высокая! Не хорони себя у котлов, Сандра, дай и себе волю.'

    elseif $SundayVisitBeckySandraTalkTextId = 'sandra_becky_stefan_quarrel':
        $SundayVisitBeckySandraTalkText = '— Ты что-то больно ласково Стефану улыбаешься, когда он за мукой заходит, — со сталью в голосе роняет Сандра. — Смотри мне, Бекки... Он сын мой, а не очередной матрос для твоей задней каморки!<br>'
        $SundayVisitBeckySandraTalkText += '— Да кому твой Стефан нужен! — фыркает Бекки, но в голосе звенит лукавство. — Мальчишка совсем... Хотя плечист, чертяка. Ты за дочками лучше следи, а меня морали не учи!'

    elseif $SundayVisitBeckySandraTalkTextId = 'becky_sandra_fallback_stub':
        $SundayVisitBeckySandraTalkText = '— Ох, Бекки, кабы ты знала, как у меня к концу недели гудит спина, — доносится из лавки усталый, но мягкий вздох Сандры. Слышен тихий стук глиняных кружек о деревянную столешницу. — С утра у печи, к полудню пироги поспевают, а к вечеру в зале такой гомон, что в висках стучит... Но Стефан, хвала Ильматеру, держит трактир в кулаке. Молодой ещё, ершистый, а хватка хозяйская проступает. Дело понемногу ладится.<br><br>— Да уж видит Ильматер, на твоих плечах весь этот дом держится, Сандра, — тихо и с теплотой усмехается Бекки. Слышно, как она подливает горячий травяной взвар в чашку подруги. — У меня в лавке тоже не мёд: оптовики из Нижнего города опять цены на копчёности взвинтили, приказчики нос воротят, а покупатели за каждый медяк торгуются, будто я с них последнюю рубаху сдираю. Но ничего, пока мы вместе чай пьём — прорвёмся. Посиди спокойно, отдохни, пока ставни закрыты. Хоть в воскресенье дай себе роздых от сковородок и заказов.'

    end

    killvar '$SundayVisitBeckySandraTalkTextId'
---

#SundayVisitBeckySandraGearGossipText
    $SundayVisitText = 'У закрытой продуктовой лавки ты осторожно останавливаешься у окна. За ставнями слышны оживлённые голоса Сандры и Бекки — женщины явно увлеклись свежими сплетнями.'
    $SundayVisitText += '<br><br>— Ой, Драупнир на днях такую историю рассказал, — смеётся Сандра, — я чуть со смеху не упала прямо среди опилок в его мастерской!'
    $SundayVisitText += '<br><br>— Когда рассказал? — с ехидным смешком подначивает Бекки. — Когда кровать тебе стругал? Ха-ха!'
    $SundayVisitText += '<br><br>— Да слушай ты! — фыркает Сандра. — Столяр получил заказ от храма — сделать новые дубовые рамы для собора. И вот в раму окна так называемой «комнаты чистых сердец» он встроил тайную шестерёнку! Если эту шестерёнку снаружи повернуть — створка бесшумно приоткрывается, и всё внутри отлично видно и слышно! А до этого сквозь толстое стекло только гул стоит.'
    $SundayVisitText += '<br><br>— И что дальше? — любопытствует Бекки.'
    $SundayVisitText += '<br><br>— А то! Раму строители вставили высоко, и наш гном теперь до своей же шестерёнки дотянуться не может! Бегал в воскресенье снизу под стеной собора, руками махал, ругался на чём свет стоит!'
    $SundayVisitText += '<br><br>— Не беда, что ростом не вышел, — покатывается со смеху Бекки. — Главное, чтоб молот у него был правильной длины! Правда, Сандра?'
    $SundayVisitText += '<br><br>Обе женщины заливаются дружным, заразительным хохотом.'

    if ChurchSpyWindowMechanismFound = 1:
        $SundayVisitText += '<br><br><i>Ты довольно ухмыляешься: ты уже разыскал эту шестерёнку в створке и на собственном опыте знаешь, какие тайны открываются сквозь приоткрытое соборное окно.</i>'
    else:
        $SundayVisitText += '<br><br><i>Ты довольно ухмыляешься: какая ценная наводка! В отличие от низкорослого столяра Драупнира, ты высокого роста и без труда дотянешься до оконной рамы собора в воскресный полдень. Стоит повернуть потайную шестерёнку — и окно комнаты исповедей приоткроется.</i>'
    end
