! ================================================
! FILE: modules/events/visits/sunday_shop_visits.qsps
! Воскресные визиты и подслушивания у закрытых лавок
! Версия: v1
! Назначение:
! - воскресенье день/вечер (sunday_visits): у лавки Бекки подслушивание
! - слух про шестерёнку — первый визит, до скандала и прочих тем
! - у лавки Легаре можно подслушать Клариссу и Мелиссу
! - у закрытой лавки Ирмы (воскресенье день/вечер): Инга и Ирма
! Большие тексты берутся из:
! modules/events/visits/sunday_shop_visits_text.qsps
! ================================================

#SundayVisitBeckySandraCanEnter
    SundayVisitBeckySandraOpen = 0

    if week <> 7:
        exit
    end

    gs 'GetCitySchedulePhase'

    if $CitySchedulePhase = 'sunday_visits':
        SundayVisitBeckySandraOpen = 1
    end
---

#SundayVisitBeckySandraCanEavesdrop
    SundayVisitBeckySandraCanEavesdrop = 0

    gs 'SundayVisitBeckySandraCanEnter'

    if SundayVisitBeckySandraOpen = 0:
        killvar 'SundayVisitBeckySandraOpen'
        exit
    end

    killvar 'SundayVisitBeckySandraOpen'

    gs 'BeckySandraChurchGearGossipCanHear'

    if BeckySandraChurchGearGossipCanHear = 1:
        SundayVisitBeckySandraCanEavesdrop = 1
        killvar 'BeckySandraChurchGearGossipCanHear'
        exit
    end

    killvar 'BeckySandraChurchGearGossipCanHear'

    if SundayBeckySandraVisitSeen[day] = 1:
        exit
    end

    SundayVisitBeckySandraCanEavesdrop = 1
---

#SundayVisitClarissaMelissaCanEavesdrop
    SundayVisitClarissaMelissaCanEavesdrop = 0

    if week <> 7:
        exit
    end

    gs 'GetCitySchedulePhase'

    if $CitySchedulePhase <> 'sunday_visits':
        exit
    end

    if SundayClarissaMelissaVisitSeen[day] = 1:
        exit
    end

    SundayVisitClarissaMelissaCanEavesdrop = 1
---

#SundayVisitIrmaIngaCanEavesdrop
    SundayVisitIrmaIngaCanEavesdrop = 0

    if week <> 7:
        exit
    end

    gs 'GetCitySchedulePhase'

    if $CitySchedulePhase <> 'sunday_visits':
        exit
    end

    if IrmaMet < 1:
        exit
    end

    if SundayIrmaIngaVisitSeen[day] = 1:
        exit
    end

    SundayVisitIrmaIngaCanEavesdrop = 1
---

#SundayVisitBeckySandra
    *clr
    clr
    cla

    gs 'SundayVisitBeckySandraCanEnter'

    if SundayVisitBeckySandraOpen = 0:
        gt 'Market'
    end

    killvar 'SundayVisitBeckySandraOpen'

    gs 'BeckySandraChurchGearGossipCanHear'
    gs 'SandraBeckySundayScandalCanHear'
    SundayVisitBeckyGearScene = BeckySandraChurchGearGossipCanHear
    gs 'SundayVisitBeckySandraText'

    if SundayVisitBeckyGearScene = 1:
        gs 'ShowImage', 'church', 'window', 'ajar'
    else:
        gs 'ShowImage', 'becky', 'shop', 'closed', 'normal'
    end

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' У ОКНА ЛАВКИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'PrintMainP', 'Вы обходите угол здания и задерживаетесь у приоткрытого окна — оттуда доносятся голоса.'

    *pl ' '

    *p $SundayVisitText
    *pl ' '

    if SundayVisitBeckyGearScene = 1 and ChurchSpyWindowGearGossipHeard = 0:
        ChurchSpyWindowGearGossipHeard = 1
        ChurchSpyWindowHint = 1
    end

    killvar 'SundayVisitBeckyGearScene'

    SundayBeckySandraVisitSeen[day] = 1
    PlayerKnows_SandraBeckySundayTalk = 1

    if $SundayVisitBeckySandraPickedId <> '':
        gs 'SundayVisitBeckySandraApplyPhraseEffects', $SundayVisitBeckySandraPickedId
        killvar '$SundayVisitBeckySandraPickedId'
    else:
        SandraBeckyBond += 1

        if SandraBeckyBond > 100:
            SandraBeckyBond = 100
        end
    end

    if SandraBeckySundayScandalCanHear = 1:
        SandraBeckySundayScandalHeard = 1
        SandraBeckyCrisisReady = 1
        PlayerKnows_BeckyStefanSundayGossip = 1
        FamilyTension += 2
    end

    if SandraBeckyBond > 100:
        SandraBeckyBond = 100
    end

    if debug = 1:
        *pl '[DEBUG VISIT] SandraBeckyBond: ' + STR(SandraBeckyBond)
        *pl '[DEBUG VISIT] PlayerKnows_SandraBeckySundayTalk: ' + STR(PlayerKnows_SandraBeckySundayTalk)
        *pl ' '
    end

    act '<b>Назад</b>', 'images/common/ui/actions/return.png':
        gt 'Market'
    end

    killvar 'BeckySandraChurchGearGossipCanHear'
---

#BeckySandraChurchGearGossipCanHear
    BeckySandraChurchGearGossipCanHear = 0

    if ChurchSpyWindowGearGossipHeard = 1:
        exit
    end

    BeckySandraChurchGearGossipCanHear = 1
---

! ================================================
! FILE: modules/events/visits/sunday_shop_visits.qsps
! Воскресный разговор у лавки Легаре
! ================================================

#SundayVisitClarissaMelissa
    *clr
    clr
    cla

    gs 'SundayVisitClarissaMelissaCanEavesdrop'

    if SundayVisitClarissaMelissaCanEavesdrop = 0:
        killvar 'SundayVisitClarissaMelissaCanEavesdrop'
        gt 'Market'
    end

    killvar 'SundayVisitClarissaMelissaCanEavesdrop'

    gs 'SundayVisitClarissaMelissaText'

    gs 'ShowImage', 'wine', 'shop', 'closed', 'normal'

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' У ОКНА ЛАВКИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'PrintMainP', 'Вы обходите фасад и задерживаетесь у приоткрытого окна — оттуда доносятся голоса.'

    *pl ' '

    *p $SundayVisitText
    *pl ' '

    SundayClarissaMelissaVisitSeen[day] = 1
    PlayerKnows_ClarissaMelissaSundayTalk = 1

    if $SundayVisitClarissaMelissaPickedId <> '':
        gs 'SundayVisitClarissaMelissaApplyPhraseEffects', $SundayVisitClarissaMelissaPickedId
        killvar '$SundayVisitClarissaMelissaPickedId'
    else:
        MelissaClarissaBond += 1

        if MelissaClarissaBond > 100:
            MelissaClarissaBond = 100
        end
    end

    if MelissaClarissaBond > 100:
        MelissaClarissaBond = 100
    end

    if debug = 1:
        *pl '[DEBUG VISIT] MelissaClarissaBond: ' + STR(MelissaClarissaBond)
        *pl '[DEBUG VISIT] PlayerKnows_ClarissaMelissaSundayTalk: ' + STR(PlayerKnows_ClarissaMelissaSundayTalk)
        *pl '[DEBUG VISIT] PlayerKnows_MelissaClarissaBrotherGossip: ' + STR(PlayerKnows_MelissaClarissaBrotherGossip)
        *pl ' '
    end

    act '<b>Назад</b>', 'images/common/ui/actions/return.png':
        gt 'Market'
    end
---

#SundayVisitIrmaInga
    *clr
    clr
    cla

    gs 'SundayVisitIrmaIngaCanEavesdrop'

    if SundayVisitIrmaIngaCanEavesdrop = 0:
        killvar 'SundayVisitIrmaIngaCanEavesdrop'
        gt 'CraftsmenQuarter'
    end

    killvar 'SundayVisitIrmaIngaCanEavesdrop'

    gs 'SundayVisitIrmaIngaText'

    gs 'ShowImage', 'irma', 'shop', 'closed', 'normal'

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' У ЗАКРЫТОЙ ЛАВКИ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'PrintMainP', 'Вы обходите фасад и задерживаетесь у приоткрытой двери — оттуда доносятся голоса.'

    *pl ' '

    *p $SundayVisitText
    *pl ' '

    SundayIrmaIngaVisitSeen[day] = 1
    PlayerKnows_IrmaIngaSundayTalk = 1

    if $SundayVisitIrmaIngaPickedId <> '':
        gs 'SundayVisitIrmaIngaApplyPhraseEffects', $SundayVisitIrmaIngaPickedId
        killvar '$SundayVisitIrmaIngaPickedId'
    else:
        IngaIrmaBond += 1

        if IngaIrmaBond > 100:
            IngaIrmaBond = 100
        end
    end

    if IngaIrmaBond > 100:
        IngaIrmaBond = 100
    end

    if debug = 1:
        *pl '[DEBUG VISIT] IngaIrmaBond: ' + STR(IngaIrmaBond)
        *pl '[DEBUG VISIT] PlayerKnows_IrmaIngaSundayTalk: ' + STR(PlayerKnows_IrmaIngaSundayTalk)
        *pl ' '
    end

    act '<b>Назад</b>', 'images/common/ui/actions/return.png':
        gt 'CraftsmenQuarter'
    end
---

! ================================================
! FILE: modules/events/visits/sunday_shop_visits.qsps
! Debug-меню воскресных визитов
! ================================================

#SundayShopVisitsDebugMenu
    $SundayVisitReturnLoc = $ARGS[0]

    if $SundayVisitReturnLoc = '':
        $SundayVisitReturnLoc = 'Market'
    end

    *clr
    clr
    cla

    *pl '══════════════════════════════════════════════'
    *pl ' DEBUG: ВОСКРЕСНЫЕ ВИЗИТЫ'
    *pl '══════════════════════════════════════════════'
    *pl ' '
    *pl 'week: ' + STR(week)
    *pl 'time: ' + STR(time)
    *pl 'phase: ' + $CitySchedulePhase
    *pl ' '

    gs 'ActUiPrepare', 'Установить воскресенье день', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
        time = 3
        gs 'GetDateTimeNames'
        gt 'Market'
    end

    gs 'ActUiPrepare', 'Установить воскресенье вечер', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
        time = 4
        gs 'GetDateTimeNames'
        gt 'Market'
    end

    gs 'ActUiPrepare', 'Тест: Бекки и Сандра', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: пул (Сандра home sex)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        SandraHomeSex = 1
        SandraBeckyBond = 14
        SundayBeckySandraVisitSeen[day] = 0
        ChurchSpyWindowGearGossipHeard = 1
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: пул (матросы witness)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        FactHappened['becky_two_men'] = 1
        EventWitnessed['becky_two_men'] = 1
        SandraBeckyBond = 14
        SundayBeckySandraVisitSeen[day] = 0
        ChurchSpyWindowGearGossipHeard = 1
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: пул (Грюн в задней)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        FactHappened['becky_backroom_guard'] = 1
        EventWitnessed['becky_backroom_guard'] = 1
        SandraBeckyBond = 14
        SundayBeckySandraVisitSeen[day] = 0
        ChurchSpyWindowGearGossipHeard = 1
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: пул (клерк в задней)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        FactHappened['becky_backroom_clerk'] = 1
        PlayerKnows['becky_backroom_clerk'] = 1
        SandraBeckyBond = 14
        SundayBeckySandraVisitSeen[day] = 0
        ChurchSpyWindowGearGossipHeard = 1
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: пул (Лукас в задней)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        FactHappened['becky_backroom_lucas'] = 1
        PlayerKnows['becky_backroom_lucas'] = 1
        SandraBeckyBond = 14
        SundayBeckySandraVisitSeen[day] = 0
        ChurchSpyWindowGearGossipHeard = 1
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: задняя (Лукас)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        sluttiness['becky'] = 40
        IngaGuardProblem = 1
        IngaLucasInviteDone = 0
        week = 3
        BeckyShopBackroomPeekClientSeenDay['lucas'] = 0
        BeckyShopBackroomPeekActiveModeOpen = 1
        BeckyShopBackroomPeekDebugForce = 1
        time = 3
        gt 'BeckyShop', 'main'
    end

    gs 'ActUiPrepare', 'Тест: задняя (Эдди у прилавка)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        sluttiness['becky'] = 40
        week = 3
        BeckyShopBackroomPeekClientSeenDay['eddie_at_shop'] = 0
        BeckyShopBackroomPeekActiveModeOpen = 1
        BeckyShopBackroomPeekDebugForce = 1
        time = 2
        gt 'BeckyShop', 'main'
    end

    gs 'ActUiPrepare', 'DEBUG: peek шансы/баланс', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShopBackroomPeekDebugPanel'
    end

    gs 'ActUiPrepare', 'Тест: задняя (закрыта)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        sluttiness['becky'] = 40
        week = 3
        BeckyShopBackroomPeekClientSeenDay['old_widower'] = 0
        BeckyShopBackroomPeekActiveModeOpen = 0
        BeckyShopBackroomPeekDebugForce = 1
        time = 5
        gt 'BeckyShop', 'main'
    end

    gs 'ActUiPrepare', 'Тест: Кларисса и Мелисса', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        gt 'SundayVisitClarissaMelissa'
    end

    gs 'ActUiPrepare', 'Тест: пул (Мелисса home sex)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        MelissaHomeSex = 1
        MelissaClarissaBond = 14
        SundayClarissaMelissaVisitSeen[day] = 0
        gt 'SundayVisitClarissaMelissa'
    end

    gs 'ActUiPrepare', 'Тест: пул (marathon)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        MelissaHomeSex = 1
        MelissaClarissaBond = 14
        SexMarathonGossipPending['melissa'] = 1
        SexMarathonGossipLastDay['melissa'] = 0
        SundayClarissaMelissaVisitSeen[day] = 0
        gt 'SundayVisitClarissaMelissa'
    end

    gs 'ActUiPrepare', 'Тест: пул (ревность Легаре)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        MelissaLegareWarningSeen = 1
        MelissaJealousy = 5
        MelissaClarissaBond = 10
        SundayClarissaMelissaVisitSeen[day] = 0
        gt 'SundayVisitClarissaMelissa'
    end

    gs 'ActUiPrepare', 'Тест: Ирма и Инга', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
        time = 3
        gs 'GetDateTimeNames'
        IrmaMet = 1
        SundayIrmaIngaVisitSeen[day] = 0
        gt 'SundayVisitIrmaInga'
    end

    gs 'ActUiPrepare', 'Тест: пул (Грюн)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
        time = 3
        gs 'GetDateTimeNames'
        IrmaMet = 1
        IngaGuardProblem = 1
        IngaIrmaBond = 10
        Friends['inga'] = 14
        SundayIrmaIngaVisitSeen[day] = 0
        gt 'SundayVisitIrmaInga'
    end

    gs 'ActUiPrepare', 'Тест: пул (Лукас)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
        time = 3
        gs 'GetDateTimeNames'
        IrmaMet = 1
        IngaLucasWindowSeen = 1
        IngaIrmaBond = 10
        Friends['inga'] = 14
        SundayIrmaIngaVisitSeen[day] = 0
        gt 'SundayVisitIrmaInga'
    end

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $SundayVisitReturnLoc
    end
---
