! ================================================
! FILE: modules/events/visits/sunday_shop_visits.qsps
! Воскресный разговор у двери комнаты Аманды в трактире
! ================================================

#SundayVisitAmandaLizette

    *clr
    clr
    cla

    gs 'SundayVisitAmandaLizetteCanEavesdrop'

    if SundayVisitAmandaLizetteCanEavesdrop = 0:
        killvar 'SundayVisitAmandaLizetteCanEavesdrop'
        killvar 'SundayVisitSessionListenCount'
        killvar '$SundayVisitLastPickedId'
        killvar 'SundayVisitSlotKey'
        gt 'TavernSecondFloor'
    end

    killvar 'SundayVisitAmandaLizetteCanEavesdrop'

    SundayVisitSessionListenCount += 1
    SundayVisitSlotKey = day * 10 + time
    SundayAmandaLizetteVisitSlotSeen[SundayVisitSlotKey] = 1
    SundayAmandaLizetteVisitSeen[day] = 1

    gs 'SundayVisitAmandaLizetteText'

    gs 'SceneShowVisual', 'images/events/amanda/amanda_events/amanda_lizette_bedroom_gossip', 'Аманда и Лизетта шепчутся в спальне', 'large', 'webp'

    gs 'PrintTitleLine', ' У ДВЕРИ В СПАЛЬНЮ'

    gs 'PrintMainP', 'Ты задерживаешься на цыпочках в коридоре у двери в спальню сестры — изнутри доносятся приглушённые девичьи голоса.'

    *pl ' '

    *p $SundayVisitText
    *pl ' '

    PlayerKnows_AmandaLizetteSundayTalk = 1
    AmandaLizaTalkHeardCount += 1
    AmandaLizaRoomTalksWeek += 1

    if $SundayVisitAmandaLizettePickedId <> '':
        $SundayVisitLastPickedId = $SundayVisitAmandaLizettePickedId
        gs 'SundayVisitAmandaLizetteApplyPhraseEffects', $SundayVisitAmandaLizettePickedId
        if $SundayVisitAmandaLizettePickedId = 'lizette_anal_hint':
            if LOC('AmandaLizetteAnalTalkBump') = 1:
                gs 'AmandaLizetteAnalTalkBump'
            end
        end
        gs 'AmandaLizetteAnalTalkTryUnlock'
        killvar '$SundayVisitAmandaLizettePickedId'
    end

    if debug = 1:
        *pl '[DEBUG VISIT] AmandaLizaInfluence: ' + STR(AmandaLizaInfluence)
        *pl '[DEBUG VISIT] PlayerKnows_AmandaLizetteSundayTalk: ' + STR(PlayerKnows_AmandaLizetteSundayTalk)
        *pl '[DEBUG VISIT] SessionListenCount: ' + STR(SundayVisitSessionListenCount)
        *pl ' '
    end

    if SundayVisitSessionListenCount < 2:
        gs 'ActUiPrepare', 'Слушать дальше', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SundayVisitAmandaLizette'
        end

        gs 'ActUiPrepare', 'Назад в коридор', 'return'
        act $ActUiLabel, $ActUiIconPath:
            killvar 'SundayVisitSessionListenCount'
            killvar '$SundayVisitLastPickedId'
            killvar 'SundayVisitSlotKey'
            gt 'TavernSecondFloor'
        end
    else:
        *pl ' '
        *pl 'Подруги на время переходят на неразборчивый бытовой шёпот... На этот час ты услышал всё, что мог.'

        gs 'ActUiPrepare', 'Назад в коридор', 'return'
        act $ActUiLabel, $ActUiIconPath:
            killvar 'SundayVisitSessionListenCount'
            killvar '$SundayVisitLastPickedId'
            killvar 'SundayVisitSlotKey'
            gt 'TavernSecondFloor'
        end
    end
---

! ================================================
! FILE: modules/events/visits/sunday_shop_visits.qsps
! Debug-меню воскресных визитов
! ================================================

#SundayShopVisitsDebugMenu

    $SundayVisitReturnLoc = $ARGS[0]

    if $SundayVisitReturnLoc = '':
        $SundayVisitReturnLoc = 'Market'
    end

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'DEBUG: ВОСКРЕСНЫЕ ВИЗИТЫ'
    gs 'SceneShowVisual', 'images/events/visits/sunday_shop_visits/sunday_shop_visits_debug_menu', 'DEBUG: ВОСКРЕСНЫЕ ВИЗИТЫ', 'large', 'webp'
    *pl 'week: ' + STR(week)
    *pl 'time: ' + STR(time)
    *pl 'phase: ' + $CitySchedulePhase
    *pl ' '

    gs 'ActUiPrepare', 'Установить воскресенье день', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
        time = 3
        gs 'GetDateTimeNames'
        gt 'Market'
    end

    gs 'ActUiPrepare', 'Установить воскресенье вечер', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
        time = 4
        gs 'GetDateTimeNames'
        gt 'Market'
    end

    gs 'ActUiPrepare', 'Сбросить лимиты визитов', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        SundayBeckySandraVisitSeen[day] = 0
        SundayClarissaMelissaVisitSeen[day] = 0
        SundayIrmaIngaVisitSeen[day] = 0
        SundayAmandaLizetteVisitSeen[day] = 0
        SundayVisitSlotKey = day * 10 + time
        SundayBeckySandraVisitSlotSeen[SundayVisitSlotKey] = 0
        SundayClarissaMelissaVisitSlotSeen[SundayVisitSlotKey] = 0
        SundayIrmaIngaVisitSlotSeen[SundayVisitSlotKey] = 0
        SundayAmandaLizetteVisitSlotSeen[SundayVisitSlotKey] = 0
        killvar 'SundayVisitSlotKey'
        SundayVisitSessionListenCount = 0
        killvar '$SundayVisitLastPickedId'
        AmandaLizaRoomTalksWeek = 0
        gt 'SundayShopVisitsDebugMenu', $SundayVisitReturnLoc
    end

    gs 'ActUiPrepare', 'Тест: Бекки и Сандра', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
        time = 3
        gs 'GetDateTimeNames'
        SundayBeckySandraVisitSeen[day] = 0
        SundayBeckySandraVisitSlotSeen[day * 10 + time] = 0
        SundayVisitSessionListenCount = 0
        killvar '$SundayVisitLastPickedId'
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: заглушка (Бекки и Сандра)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
        time = 3
        gs 'GetDateTimeNames'
        SundayBeckySandraVisitSeen[day] = 0
        SundayBeckySandraVisitSlotSeen[day * 10 + time] = 0
        SundayVisitSessionListenCount = 0
        killvar '$SundayVisitLastPickedId'
        $SundayVisitBeckySandraPickedId = 'becky_sandra_fallback_stub'
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: пул (Сандра home sex)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        SandraHomeSex = 1
        SandraBeckyBond = 14
        SundayBeckySandraVisitSeen[day] = 0
        SundayBeckySandraVisitSlotSeen[day * 10 + time] = 0
        SundayVisitSessionListenCount = 0
        killvar '$SundayVisitLastPickedId'
        ChurchSpyWindowGearGossipHeard = 1
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: пул (матросы witness)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        FactHappened['becky_two_men'] = 1
        EventWitnessed['becky_two_men'] = 1
        SandraBeckyBond = 14
        SundayBeckySandraVisitSeen[day] = 0
        SundayBeckySandraVisitSlotSeen[day * 10 + time] = 0
        SundayVisitSessionListenCount = 0
        killvar '$SundayVisitLastPickedId'
        ChurchSpyWindowGearGossipHeard = 1
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: пул (Грюн в задней)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        FactHappened['becky_backroom_guard'] = 1
        EventWitnessed['becky_backroom_guard'] = 1
        SandraBeckyBond = 14
        SundayBeckySandraVisitSeen[day] = 0
        SundayBeckySandraVisitSlotSeen[day * 10 + time] = 0
        SundayVisitSessionListenCount = 0
        killvar '$SundayVisitLastPickedId'
        ChurchSpyWindowGearGossipHeard = 1
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: пул (клерк в задней)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        FactHappened['becky_backroom_clerk'] = 1
        PlayerKnows['becky_backroom_clerk'] = 1
        SandraBeckyBond = 14
        SundayBeckySandraVisitSeen[day] = 0
        SundayBeckySandraVisitSlotSeen[day * 10 + time] = 0
        SundayVisitSessionListenCount = 0
        killvar '$SundayVisitLastPickedId'
        ChurchSpyWindowGearGossipHeard = 1
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: пул (Лукас в задней)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        FactHappened['becky_backroom_lucas'] = 1
        PlayerKnows['becky_backroom_lucas'] = 1
        SandraBeckyBond = 14
        SundayBeckySandraVisitSeen[day] = 0
        SundayBeckySandraVisitSlotSeen[day * 10 + time] = 0
        SundayVisitSessionListenCount = 0
        killvar '$SundayVisitLastPickedId'
        ChurchSpyWindowGearGossipHeard = 1
        gt 'SundayVisitBeckySandra'
    end

    gs 'ActUiPrepare', 'Тест: задняя (Лукас)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        sluttiness['becky'] = 40
        IngaGuardProblem = 1
        IngaLucasInviteDone = 0
        week = 3
        BeckyShopBackroomPeekClientSeenDay['lucas'] = 0
        BeckyShopBackroomPeekActiveModeOpen = 1
        BeckyShopBackroomPeekDebugForce = 1
        time = 3
        gt 'BeckyShop', 'main'
    end

    gs 'ActUiPrepare', 'Тест: задняя (Эдди у прилавка)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        sluttiness['becky'] = 40
        week = 3
        BeckyShopBackroomPeekClientSeenDay['eddie_at_shop'] = 0
        BeckyShopBackroomPeekActiveModeOpen = 1
        BeckyShopBackroomPeekDebugForce = 1
        time = 2
        gt 'BeckyShop', 'main'
    end

    gs 'ActUiPrepare', 'DEBUG: peek шансы/баланс', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShopBackroomPeekDebugPanel'
    end

    gs 'ActUiPrepare', 'Тест: задняя (закрыта)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        sluttiness['becky'] = 40
        week = 3
        BeckyShopBackroomPeekClientSeenDay['old_widower'] = 0
        BeckyShopBackroomPeekActiveModeOpen = 0
        BeckyShopBackroomPeekDebugForce = 1
        time = 5
        gt 'BeckyShop', 'main'
    end

    gs 'ActUiPrepare', 'Тест: play coach Сандра (Бекки)', 'debug'
    act $ActUiLabel, $ActUiIconPath:
        week = 7
