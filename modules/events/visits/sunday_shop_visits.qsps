        *pl '[DEBUG VISIT] SessionListenCount: ' + STR(SundayVisitSessionListenCount)
        *pl ' '
    end

    if SundayVisitSessionListenCount < 2:
        gs 'ActUiPrepare', 'Слушать дальше', 'look'
