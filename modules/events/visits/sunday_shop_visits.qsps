        gs 'ActUiPrepare', 'Отойти от окна', 'return'
        act $ActUiLabel, $ActUiIconPath:
            killvar 'SundayVisitSessionListenCount'
            killvar '$SundayVisitLastPickedId'
            killvar 'SundayVisitSlotKey'
            gt 'Market'
        end
    else:
        *pl ' '
        *pl 'Подруги на время переходят на неразборчивый бытовой шёпот... На этот час ты услышал всё, что мог.'

        gs 'ActUiPrepare', 'Отойти от окна', 'return'
        act $ActUiLabel, $ActUiIconPath:
            killvar 'SundayVisitSessionListenCount'
            killvar '$SundayVisitLastPickedId'
            killvar 'SundayVisitSlotKey'
            gt 'Market'
        end
    end
---

