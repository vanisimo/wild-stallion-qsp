! ================================================
! FILE: modules/events/visits/sunday_clarissa_melissa_text.qsps
! MODULE: events/visits
! [AI-WORKED] Текст переработан / дополнен ассистентом 04.10.2026
! Тексты воскресных разговоров: Кларисса Легаре и Мелисса Лонгкок
! Локация: закрытая винная лавка купца Легаре на рынке (воскресенье, день/вечер)
! 
! Голос Мелиссы по канону:
! Начитанная умница, книжница («Гермиона Грейнджер»), считает мужскую похоть
! примитивной и предсказуемой; язвит, закатывает глаза, копит серебро на книги и фолианты.
! Голос Клариссы:
! Опытная, раскрепощённая молодая жена богатого купца, умеющая извлекать выгоду
! и удовольствие из мужских пороков.
! ================================================

#SundayVisitClarissaMelissaText
    if SundayClarissaMelissaVisitSeen[day] = 1:
        $SundayVisitText = 'Ты снова подходишь к закрытой лавке Легаре, но за массивными дубовыми дверями уже тихо: подруги либо завершили беседу, либо разошлись. На сегодня ты услышал всё, что мог.'
        exit
    end

    ! Режиссура сцены тренировки в зале (Мелисса)
    if LOC('HallPlayCoachCanOffer') = 1:
        gs 'HallPlayCoachCanOffer', 'melissa'
        if HallPlayCoachCanOffer = 1:
            $SundayVisitClarissaMelissaPickedId = 'play_coach_melissa'
            gs 'SundayVisitClarissaMelissaTalkText', 'play_coach_melissa'
            $SundayVisitText = $SundayVisitClarissaMelissaTalkText
            killvar '$SundayVisitClarissaMelissaTalkText'
            exit
        end
    end

    gs 'SundayVisitClarissaMelissaPickPhrase'

    if SundayVisitClarissaMelissaPickOk = 1:
        gs 'SundayVisitClarissaMelissaTalkText', $SundayVisitClarissaMelissaPickedId
        $SundayVisitText = $SundayVisitClarissaMelissaTalkText
        killvar '$SundayVisitClarissaMelissaTalkText'
        exit
    end

    ! Базовый нарратив при отсутствии специфических сюжетных триггеров
    if MelissaClarissaBond >= 10:
        $SundayVisitText = 'Ты осторожно подходишь к закрытой лавке Легаре и замираешь у приоткрытой оконной створки. За ней звучат голоса Клариссы и Мелиссы. Они беседуют без лишней спешки: Кларисса со спокойной усмешкой рассуждает о повадках своего мужа Альбера, его вечной тяге к свежему женскому телу и о том, как наивны мужчины, воображающие себя хозяевами положения. Мелисса отвечает рассудительно, с привычной книжной иронией, но с неподдельным интересом. Затем разговор касается трактира, Аманды и того, что мужское вожделение — это отличный товар, если уметь правильно выставлять за него счёт. Кларисса тихо смеётся и замечает, что раз мужья не отказывают себе в плотских утехах, то и женщинам не пристало скучать в четырёх стенах — тем более что отец Герхард на исповеди вовсе не считает обоюдные радости грехом пред всеблагим Ильматером.'
    else:
        $SundayVisitText = 'Ты задерживаешься у закрытой винной лавки и сквозь ставни слышишь приглушённый диалог Клариссы и Мелиссы. Беседа течёт осторожно: пара слов о поставках вина, немного о делах Легаре и о том, как женщинам в этом городе приходится учиться просчитывать мужские взгляды задолго до того, как те осмелятся подойти в открытую.'
    end
---

#SundayVisitClarissaMelissaTalkText
    $SundayVisitClarissaMelissaTalkTextId = LCASE($ARGS[0])
    $SundayVisitClarissaMelissaTalkText = ''

    ! -------------------------------------------------------------------------
    ! СЮЖЕТНЫЕ РЕЖИССУРЫ И СПЕЦИАЛЬНЫЕ СОБЫТИЯ
    ! -------------------------------------------------------------------------

    if $SundayVisitClarissaMelissaTalkTextId = 'play_coach_melissa':
        if LOC('HallPlayCoachBuildCombinedText') = 1:
            gs 'HallPlayCoachBuildCombinedText', 'melissa'
            $SundayVisitClarissaMelissaTalkText = $HallPlayCoachCombined
            killvar '$HallPlayCoachCombined'
        else
            $SundayVisitClarissaMelissaTalkText = 'У лавки Легаре ты слышишь, как Кларисса с улыбкой наставляет Мелиссу:<br>'
            $SundayVisitClarissaMelissaTalkText += '— Мелисса, ну право, прекрати прятаться за амбарными книгами! Твоя сестрица Аманда в зале одним взглядом серебро из карманов вытягивает, а ты стоишь надувшись. Мужчины примитивны: повернись боком, покажи изгиб талии, наклонись над кружкой — и любой забудет, сколько сдачи ему причитается!<br>'
            $SundayVisitClarissaMelissaTalkText += 'Мелисса фыркает с лёгким румянцем: «Это ненаучно... хотя, признаю, экономически весьма целесообразно».'
        end

    ! -------------------------------------------------------------------------
    ! ФОНОВАЯ АТМОСФЕРА И ТОРГОВЫЕ БУДНИ
    ! -------------------------------------------------------------------------

    elseif $SundayVisitClarissaMelissaTalkTextId = 'ambient_legare_supplies':
        $SundayVisitClarissaMelissaTalkText = 'У закрытой лавки Легаре ты слышишь мерный шорох пергаментов и стук винных пробок:<br>'
        $SundayVisitClarissaMelissaTalkText += '— Пять бочек южного рислинга и три анкера креплёного портвейна, — диктует Кларисса, аккуратно выводя цифры. — Опять капитан задерживает разгрузку в гавани, ссылаясь на таможню. А муж уже считает недополученную прибыль и рвёт на себе волосы.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Логистика в этом порту отвратительна, — педантично замечает Мелисса. — В исторических хрониках торговой гильдии столицы ещё триста лет назад ввели строгие правила штрафов за простой судов. Если Стефан наладит прямые поставки пива из ремесленного квартала без посредников, наш трактир сэкономит до пятнадцати мараведи в неделю. Я уже рассчитала баланс.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'ambient_tavern_amanda':
        $SundayVisitClarissaMelissaTalkText = '— В зале у вас опять все взгляды к Аманде прикованы, — замечает Кларисса с полуулыбкой. — Мужики сидят с открытыми ртами, будто сирену морскую увидали. Смотрят на её бёдра так, словно уже мысленно юбку с неё содрали.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Психология толпы элементарна, — отзывается Мелисса с лёгким презрением. — Базовые инстинкты подавляют остатки рассудка. Сестра умеет выдерживать эти похотливые взгляды и даже упивается ими. Я бы на её месте со стыда сгорела, но должна признать: пока их глаза прикованы к её корсажу, они охотнее заказывают вторую кружку эля и не замечают, как я округляю счёт в пользу заведения.'

    ! -------------------------------------------------------------------------
    ! МЕЧТЫ, КНИГИ И ВИННЫЕ ТАЙНЫ
    ! -------------------------------------------------------------------------

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_dream_eleanor_vol3':
        $SundayVisitClarissaMelissaTalkText = 'Мелисса говорит с непривычной для неё затаённой нежностью, осторожно касаясь корешка старой книги:<br>'
        $SundayVisitClarissaMelissaTalkText += '— «Королева Элеонора», том третий... Хроники двора Высоких Королей. Первые две книги я заучила наизусть, там описаны такие тонкие интриги, такие блестящие речи министров и коронованных особ! А третий том... его привезли в одном-единственном списке из столицы.<br>'
        $SundayVisitClarissaMelissaTalkText += '— И что, книготорговец не продаёт? — сочувственно спрашивает Кларисса.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Заломил цену, будто это слиток золота, — с досадой вздыхает Мелисса. — «Книга для благородных господ, не для трактирных девиц», говорит. Спесивый глупец! Я бы отдала все свои накопленные чаевые, лишь бы дочитать финал этой хроники...'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'amanda_dream_full_mirror':
        $SundayVisitClarissaMelissaTalkText = '— Аманда опять все уши прожужжала своим стеклянным зеркалом, — сухо роняет Мелисса, поправляя очки. — Настоящее ростовое стекло в серебрёной амальгаме. Говорит, что в начищенной медной посуде она не видит тонких полутонов своей красоты.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Ну, девочку можно понять, — посмеивается Кларисса. — С такой фигурой грех на себя в полный рост не полюбоваться.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Тщеславие — самый нерациональный из пороков, — язвит Мелисса. — Хотя с эстетической точки зрения я понимаю её мотив. Вот только стоит такое зеркало как полугодовой запас вина для всего трактира.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'clarissa_dream_golden_wine':
        $SundayVisitClarissaMelissaTalkText = 'Кларисса говорит тихо, но в голосе её звенит неподдельная страсть винодела:<br>'
        $SundayVisitClarissaMelissaTalkText += '— Мелисса, я хочу создать своё собственное вино. Настоящее «Золотое вино» по тайному старинному рецепту южных монастырей! Не то кислое розовое пойло, которым Альбер кичится перед королевскими чиновниками, а солнечный, тягучий нектар с ароматом персика и горных трав.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Хочешь утереть нос самодовольному супругу? — понимающе усмехается Мелисса.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Хочу доказать, что в этом доме вино делаю я, а не его золотые мешки! Но для этого нужен точный свиток с рецептурой и пропорциями выдержки. За ним охотятся все гильдии виноделов. Если достану — лавка заиграет совсем другими красками.'

    ! -------------------------------------------------------------------------
    ! ИНТИМНЫЕ ОТКРОВЕНИЯ И СОВЕТЫ ПОДРУГ
    ! -------------------------------------------------------------------------

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_clarissa_anal_talk':
        $SundayVisitClarissaMelissaTalkText = 'У прилавка винной лавки тихо переговариваются две подруги. Ты замираешь за высокими дубовыми бочками.<br><br>'
        $SundayVisitClarissaMelissaTalkText += '— Кларисса... поклянись священным кругом Ильматера, что это останется строго между нами, — шепчет Мелисса, и видно, как густой румянец заливает её щёки и шею. — Мы со Стефаном... он использовал благовонное масло, ласкал меня пальцами... там, сзади. Я испытала такое ошеломляющее наслаждение, что едва рассудок не потеряла. Но скажи мне честно, опираясь на свой жизненный опыт: разве это не противоестественно? А если он захочет настоящей, полной близости в эту тайную сладость?<br><br>'
        $SundayVisitClarissaMelissaTalkText += 'Кларисса звонко и искренне смеётся, ласково беря подругу за руку:<br>'
        $SundayVisitClarissaMelissaTalkText += '— Ох, Мелисса, книжница ты моя драгоценная! Противоестественно? Да всеблагой Ильматер создал женское тело способным чувствовать радость каждой клеточкой, а не томиться в ханжеском унынии! Слушай опытную женщину: это абсолютно естественно и безумно, сладостно приятно! Мой Альбер от этого просто теряет голову, да и до замужества я не раз дарила эту радость страстным кавалерам. Если мужчина чуток, не жалеет масла и действует с любовью — ощущения глубже и ярче обычного в сотни раз! Доверься Стефану, милая. Он молодой, сильный, и видно, как дорожит тобой.<br><br>'
        $SundayVisitClarissaMelissaTalkText += 'Мелисса с облегчением выдыхает, пряча благодарную улыбку: «Спасибо, Кларисса... Мой разум часто спорит с телом, но твои слова звучат на редкость убедительно».'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'clarissa_melissa_reverse_comfort':
        $SundayVisitClarissaMelissaTalkText = '— Ты опять загоняешь себя в рамки строгой пуританки, — качает головой Кларисса, подливая подруге сладкого вина. — Вечно хмуришься, будто над тобой висит инквизиция.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Я несу ответственность за репутацию семьи и трактира, — сдержанно парирует Мелисса.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Репутация не согреет тебя холодной ночью, — мягко возражает Кларисса. — Взгляни правде в глаза: кровь в твоих жилах кипит не меньше, чем у сестры. Ты просто пытаешься всё объяснить логикой, а в плотских утехах логика бессильна.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'clarissa_legare_husband':
        $SundayVisitClarissaMelissaTalkText = 'Кларисса говорит тихо, но с нескрываемой горечью:<br>'
        $SundayVisitClarissaMelissaTalkText += '— Альбер вчера опять придрался к отчётам. Напился с портовыми судовладельцами, распустил перья, а дома давай на мне срывать злость. Мнит себя владыкой города, а на деле — мелочный, стареющий брюзга, трясущийся за каждый медяк.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Власть и капитал неизбежно деформируют слабый характер, — спокойно констатирует Мелисса. — Он понимает, что стареет, и пытается компенсировать это грубым доминированием. Держи эмоциональную дистанцию, Кларисса. Ты умнее его.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_legare_jealousy':
        $SundayVisitClarissaMelissaTalkText = '— На танцах твой муж опять пожирал Аманду взглядом, — сухо роняет Мелисса. — Подошёл почти вплотную, сально ухмылялся, разве что слюну не пустил.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Знаю, — холодно отзывается Кларисса. — Альбер считает, что всё молодое и красивое в этом городе можно купить за его кошель.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Пусть только попробует сунуться к ней в трактире, — в голосе Мелиссы звенит сталь. — Стефан спустит его с лестницы невзирая на его золото. И я лично прибавлю пинка.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_musician_interest':
        $SundayVisitClarissaMelissaTalkText = '— Менестрель этот, Эльрик... — Мелисса начинает с привычной строгостью, но щёки её вспыхивают ярким румянцем, а голос вздрагивает. — В рыцарских балладах благородные дамы всегда покровительствовали поэтам, вдохновляя их на подвиги... Я думала, что просто отдаю должное его рифмам...<br>'
        $SundayVisitClarissaMelissaTalkText += '— Покровительница с амбарной книгой, как же, — со смешком подначивает Кларисса. — А чего дыхание перехватило? Неужто проняло книжницу?<br>'
        $SundayVisitClarissaMelissaTalkText += '— Он поёт так, Кларисса... — Мелисса на миг закрывает лицо ладонями, сбрасывая всю свою напускную холодность. — Сердце ухает куда-то вниз, по коже мурашки, а между ног становится сладко и влажно... Днём я считаю выручку и строю служанок, а ночью сгораю от стыда и желания. И какая из меня настоящая — я уже не понимаю.'

    ! -------------------------------------------------------------------------
    ! СТЕФАН, СОЮЗ И ВЛАСТЬ
    ! -------------------------------------------------------------------------

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_clarissa_brother':
        $SundayVisitClarissaMelissaTalkText = 'Мелисса говорит негромко, но с железной уверенностью во взгляде:<br>'
        $SundayVisitClarissaMelissaTalkText += '— Между мной и Стефаном всё изменилось, Кларисса. Это больше не детские ссоры брата и сестры. И не смотри на меня с укором — я взрослая женщина и отдаю себе полный отчёт в своих поступках.<br>'
        $SundayVisitClarissaMelissaTalkText += 'Кларисса внимательно разглядывает подругу и с уважением усмехается:<br>'
        $SundayVisitClarissaMelissaTalkText += '— Какое уж тут осуждение. В нашем мире выживает тот, кто умеет находить сильных союзников. А если делить постель и власть в доме — то лучше с крепким, преданным братом, чем терпеть чужого деспота, как терплю я.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_stefan_first':
        $SundayVisitClarissaMelissaTalkText = '— Кларисса... со Стефаном... это произошло, — спокойно и гордо произносит Мелисса, глядя подруге прямо в глаза. — Я не была жертвой обстоятельств. Я выбрала его сознательно.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Вот это поворот! — Кларисса с изумлением приподнимает брови. — Ни слёз раскаяния, ни жалоб святому отцу? Наша недотрога покорилась хозяину трактира?<br>'
        $SundayVisitClarissaMelissaTalkText += '— Не покорилась, а вступила в равноправный союз, — парирует Мелисса с лёгкой улыбкой. — Он единственный мужчина, который считается с моим интеллектом. Хотя... признаюсь честно: когда его сильные руки легли мне на бёдра, вся моя учёность рассыпалась в прах.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'melissa_stefan_marathon':
        $SundayVisitClarissaMelissaTalkText = '— Кларисса... — Мелисса понижает голос до горячего шёпота, а в глазах пляшет шальной огонёк. — Стефан вчера... продержал меня в спальне до первых лучей солнца. Семь раз. Я еле на ногах стою, мышцы ноют сладостной истомой, а он на рассвете встал — бодрый, плечи расправил и пошёл командовать в зале!<br>'
        $SundayVisitClarissaMelissaTalkText += '— Семь?! — Кларисса присвистывает, качая головой с неподдельной женской завистью. — Вот это мощь! Мой благоверный раз в неделю повозится пару минут и считает, что совершил подвиг. Береги своего жеребца, Мелисса, такой любовник — подарок судьбы!'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'clarissa_amanda_tips':
        $SundayVisitClarissaMelissaTalkText = '— Аманда в зале совсем обнаглела, — делится Мелисса с лёгким раздражением. — Наклонится перед подвыпившим гостем, блеснёт ложбинкой на груди, улыбнётся — и те сыплют серебро прямо в корсаж! За один вечер чаевых больше, чем чистая маржа со всего зала!<br>'
        $SundayVisitClarissaMelissaTalkText += '— А ты не завидуй, а учись! — подмигивает Кларисса. — Мужчины слепы и ведомы: брось им наживку — и они вытряхнут кошельки. Пергамент из столицы и редкие трактаты стоят дорого. Бери с них дань за их же глупость, гордостью сыта не будешь!'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'clarissa_legare_dark_backstory':
        $SundayVisitClarissaMelissaTalkText = 'Кларисса опускает голос до доверительного, мрачноватого шёпота:<br>'
        $SundayVisitClarissaMelissaTalkText += '— Ты думаешь, Альбер стал падким на молоденьких на старости лет? Он всегда был таким. Он приютил мою покойную мать с ребёнком — со мной на руках. Одел, накормил, баловал подарками. А стоило мне чуть войти в возраст — начал приучать к ласкам. Сперва гладил по головке, потом учил шалить губками... Никакого насилия не было, я и сама тянулась к ласке и понимала свою власть над богатым купцом. А как пошла первая кровь — в ту же ночь сделал меня женщиной. Когда мать умерла, он просто оформил брак, сохранив капитал.<br><br>'
        $SundayVisitClarissaMelissaTalkText += '— И ты спокойно живёшь с этим? — с научным интересом спрашивает Мелисса.<br><br>'
        $SundayVisitClarissaMelissaTalkText += '— Вполне, — усмехается Кларисса. — Я взяла от жизни всё, что могла. А в церкви отец Герхард прямо учит: плоть требует своего, и радовать друг друга взаимной страстью — святое благословение Ильматера. Так что пусть Альбер тешит свою спесь, а я своего удовольствия не упущу.'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'clarissa_legare_poses_lust':
        $SundayVisitClarissaMelissaTalkText = 'Кларисса подаётся вперёд и с заговорщицким, горячим смешком делится сокровенным:<br>'
        $SundayVisitClarissaMelissaTalkText += '— Скажу тебе по секрету, Мелисса... Я даже люблю, когда Альбер пытается приударить за чужими девками! Но только когда его там грубо отшивают!<br><br>'
        $SundayVisitClarissaMelissaTalkText += '— В каком смысле? — искренне удивляется Мелисса.<br><br>'
        $SundayVisitClarissaMelissaTalkText += '— А в таком! — сияет Кларисса. — Когда девка ему отказывает, он возвращается домой бешеный, ущемлённый, похоть из ушей брызжет! Запирает спальню на засов — и так меня берёт, что стены ходуном ходят! Нагнёт раком над конторкой, вцепится в бёдра и дерёт до утра без передышки во все дырочки! Я потом ходить не могу, а внутри всё поёт! Так что пусть бегает — мне же больше страсти достанется!'

    elseif $SundayVisitClarissaMelissaTalkTextId = 'clarissa_stefan_legare_conflict':
        $SundayVisitClarissaMelissaTalkText = '— Стефан с моим Альбером опять сцепились на площади, — с тревогой вздыхает Кларисса. — Брат твой дерзок, не признаёт его купеческого авторитета.<br>'
        $SundayVisitClarissaMelissaTalkText += '— Стефан хозяин на своей земле, — гордо отрезает Мелисса. — Легаре привык, что перед его золотом все гнут спины. Но времена меняются: у брата крепкая рука, и мы не позволим помыкать нашим трактиром.'

    end

    killvar '$SundayVisitClarissaMelissaTalkTextId'
---
