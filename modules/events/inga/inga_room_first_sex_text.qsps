#IngaRoomFirstSexText
    $IngaFirstSexScreenKey = LCASE($ARGS[0])

    if $IngaFirstSexScreenKey = 'screen1':
        *pl 'В небольшой комнате Инги под самой крышей царит тихий, согревающий полумрак. Сквозь деревянные ставни едва доносится угасающий гул засыпающей базарной площади.'
        *pl ' '
        *pl 'На прикроватном столике горит оплывающая восковая свеча. В воздухе тонко пахнет мёдом, лавандовым сбором и свежим бельём. Инга осторожно опускает кованую щеколду на двери, отрезая вас от всего остального дома, и поворачивается к тебе.'
        *pl ' '
        *pl 'Её щёки алеют густым, трепетным румянцем, а грудь часто вздымается под корсажем. Но в её взгляде больше нет ни сомнений, ни робости — только глубокое, сияющее доверие.'
        *pl ' '
        *pl '— Стефан... — тихо выдыхает она, делая шаг навстречу. — Я так ждала этого вечера. Когда сержант Грюн начал ко мне лезть, а Лукас только пятился и прятал глаза... я думала, что в этом городе никому нельзя верить. А ты пришёл и всё решил. Ты не хвастался на ярмарке пустыми словами, а защитил меня, как настоящий мужчина и хозяин. Я больше ни на миг не сомневаюсь в тебе.'
        *pl ' '
        *pl 'Её пальцы тянутся к шнуровке платья. Шелковистая лента скользит в её руках, вырез расходится, обнажая нежную льняную сорочку и соблазнительный изгиб ключиц.'
        *pl ' '
        *pl '— Здесь нам никто не помешает, Стефан... Я вся твоя.'

    elseif $IngaFirstSexScreenKey = 'screen2':
        *pl 'Ты подходишь вплотную, обнимаешь Ингу за тонкую талию и привлекаешь к себе. Девушка доверчиво подаётся вперёд, обвивая руками твою шею и прижимаясь горячим телом к твоей груди.'
        *pl ' '
        *pl 'Твои губы касаются её губ. Поцелуй начинается нежно и чутко, но Инга тут же приоткрывает рот, сладостно ахая и отвечая тебе с искренним, пылким упоением. Её дыхание обжигает твою щеку, а пальцы путаются в твоих волосах.'
        *pl ' '
        *pl 'Ты медленно увлекаешь её на широкую кровать с мягкими льняными перинами. Твои руки ловко стягивают с неё платье и сорочку, открывая взгляду стройное девичье тело. В золотистом свете свечи её кожа кажется чистейшим мрамором — священный порошок Таро и канон чистоты Ильматера смыли все лишние волоски, оставив кожу безупречно гладкой, шелковистой и душистой.'
        *pl ' '
        *pl 'Ты осыпаешь поцелуями её шею, нежные плечи и упругую грудь с отвердевшими розовыми сосками. Инга выгибается в твоих руках, её бёдра сладко покачиваются от твоих ласк:'
        *pl ' '
        *pl '— Стефан... как хорошо... твои руки такие тёплые и сильные... Я вся дрожу...'

    elseif $IngaFirstSexScreenKey = 'screen3':
        *pl 'Ты опускаешься между её гладких, стройных бёдер. Инга приподнимает подбородок, глядя тебе прямо в глаза — в её взгляде отражается пляшущее пламя свечи, смешанное с трепетом и предвкушением.'
        *pl ' '
        *pl 'Твоя ладонь медленно скользит по внутренней стороне её бедра, поднимаясь к пылающему сокровенному лону. Инга уже влажная, горячая и жадно готовая принять тебя. Ты направляешь налившийся, пульсирующий уд к её входу и медленно, осторожно подаёшься вперёд.'
        *pl ' '
        *pl 'Узкая, горячая глубина обхватывает тебя, как нежный тугой бархат. Инга прерывисто охает, запрокидывая голову на подушку и до боли в пальцах вцепляясь в твои плечи. Её бёдра невольно вздрагивают, принимая твой размер:'
        *pl ' '
        *pl '— Ах... Стефан... ты такой большой... но не останавливайся... милый, пожалуйста...'
        *pl ' '
        *pl 'Ты на секунду замираешь в ней на самой глубине, давая девушке привыкнуть к полному единению, и чувствуешь, как её сокровенные мышцы пульсируют вокруг твоего ствола.'

    elseif $IngaFirstSexScreenKey = 'screen4':
        if $IngaFirstSexRhythm = 'tender':
            *pl 'Ты наклоняешься к её лицу, ласково целуешь её в полуоткрытые губы и начинаешь двигаться плавно, глубоко и размеренно. Каждое твоё движение наполнено заботой и лаской, раскрывая её тело не спеша.'
            *pl ' '
            *pl 'Инга благодарно прижимается к тебе, обвивая твои бёдра своими ногами. В тишине комнаты разносится её счастливый, прерывистый шёпот:'
            *pl ' '
            *pl '— Да... вот так, Стефан... как сладко... милый мой...'
            *pl ' '
            *pl 'С каждым твоим глубоким проникновением её дыхание учащается, а щёки заливает яркий огонь. Внезапно всё её тело сотрясает сладкая дрожь — Инга протяжно стонет тебе в шею, пряча лицо и задыхаясь от накатившей волны чистейшего, упоительного оргазма.'
        else:
            *pl 'Ты крепко сжимаешь её бёдра ладонями и задаёшь уверенный, страстный и властный ритм. Твои толчки становятся сильными и мощными, заставляя пружины кровати размеренно поскрипывать.'
            *pl ' '
            *pl 'Инга коротко вскрикивает от неожиданного напора, но в её глазах тут же вспыхивает неистовое пламя. Она впивается ноготками в твою спину, послушно подставляясь под каждый мощный удар и полностью отдаваясь твоей силе.'
            *pl ' '
            *pl '— О Ильматер... Стефан... да! Ещё, не жалей меня!.. — стонет она в экстазе, запрокидывая голову.'
            *pl ' '
            *pl 'Её сокровенное лоно судорожно сжимает твой уд в тисках всепоглощающей разрядки, пока её тело сотрясают неистовые, сладкие конвульсии.'
        end
        *pl ' '
        *pl 'Глядя на её разомлевшее, прекрасное лицо, ты чувствуешь, как горячий пожар внизу твоего живота доходит до самого предела, требуя скорейшего выхода.'

    elseif $IngaFirstSexScreenKey = 'screen5':
        if $IngaFirstSexFinish = 'inside':
            *pl 'Не в силах больше сдерживаться, ты прижимаешь Ингу к постели и с глубоким толчком изливаешь горячие, густые струи семени в самую её глубину.'
            *pl ' '
            *pl 'Девушка сладостно стонет, изо всех сил сжимая тебя руками и бёдрами, словно стремясь вобрать в себя каждую горячую каплю. Вы оба замираете, сплетясь телами, тяжело и жадно переводя дыхание.'
        else:
            *pl 'На самом пике ты выскальзываешь наружу. Обжигающие, вязкие струи семени одна за другой выплёскиваются на её плоский, гладкий живот.'
            *pl ' '
            *pl 'Инга с томной, заворожённой улыбкой наблюдает, как белые капли растекаются по её фарфоровой коже. Она протягивает руку, робко касаясь твоего бедра, и тихонько выдыхает, глядя на свидетельства вашей страсти.'
        end
        *pl ' '
        *pl 'Проходит несколько долгих, блаженных минут. Вы лежите на мягкой постели в объятиях друг друга. Свеча тихо догорает, бросая золотые отсветы на побеленный потолок.'
        *pl ' '
        *pl 'Инга прижимается щекой к твоей груди, слушая, как успокаивается твоё сердце, и её пальчики ласково гладят твою кожу:'
        *pl ' '
        *pl '— Стефан... мне ещё никогда в жизни не было так спокойно и хорошо. Теперь я знаю, что поступила правильно. Эта комната... теперь она наша с тобой. Приходи ко мне, когда захочешь — я всегда буду ждать тебя.'

    else:
        *pl 'В комнате Инги тепло, уютно и пахнет мёдом и сушёными травами.'
    end

    killvar '$IngaFirstSexScreenKey'
