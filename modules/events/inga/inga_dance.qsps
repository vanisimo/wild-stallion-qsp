! ================================================
! FILE: modules/events/inga/inga_dance.qsps
! MODULE: events/becky
! Танцы с Ингой: знакомство → приглашение → комната
! ================================================

#IngaDanceMeetCanStart

    IngaDanceMeetCanStart = 0

    if IngaDanceUnlocked = 1:
        exit
    end

    if IngaFridayMet = 1:
        exit
    end

    if IngaPlayerRouteOpen = 0:
        if BeckyHomeSex = 0:
            exit
        end
    end

    IngaDanceMeetCanStart = 1
---

#IngaDanceMeet

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/inga_dance/inga_dance_meet', 'ИНГА НА ТАНЦАХ', 'large', 'webp'
    IngaFridayMet = 1

    gs 'EnsureGirlData', 'inga'

    gs 'ShowLocationScreenTitle', 'ИНГА НА ТАНЦАХ'

    if IngaPlayerRouteOpen = 1:
        if LOC('IngaDanceMeetAfterGuardText') = 1:
            gs 'IngaDanceMeetAfterGuardText'
        end
    else:
        if LOC('IngaDanceMeetMainText') = 1:
            gs 'IngaDanceMeetMainText'
        end
    end

    *pl ' '

    if IngaPlayerRouteOpen = 0:
        *p 'Вы злитесь на себя: «Надо разобраться со стражником» — мысль не даёт покоя.'
    end

    gs 'ActUiPrepare', 'Вернуться к танцам', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

#IngaDance

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/inga_dance/inga_dance', 'ТАНЕЦ С ИНГОЙ', 'large', 'webp'
    if IngaDanceDay <> day:
        IngaDanceStage = 0
        IngaDanceEnded = 0
        IngaDanceKiss = 0
        IngaDanceWaist = 0
        IngaDanceDay = day
        $IngaDanceLastText = ''
    end

    if IngaDanceStage = 0 and IngaDanceEnded = 0:
        gt 'IngaDanceAction', 'dance'
    end

    gs 'EnsureGirlData', 'inga'

    gs 'ShowLocationScreenTitle', 'ТАНЕЦ С ИНГОЙ'

    if LOC('IngaDanceMainText') = 1:
        gs 'IngaDanceMainText'
    elseif $IngaDanceLastText <> '':
        *p $IngaDanceLastText
    end

    *pl ' '

    if IngaDanceEnded = 1:
        *p 'Танец с Ингой на сегодня закончен.'
        gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MarketDance'
        end
        exit
    end

    gs 'IngaDanceBuildMenu'

    *p 'Что вы будете <a href="exec:gs ''Menu.Show'', ''IngaDanceMenu''">делать</a>?'
---

#IngaDanceBuildMenu

    gs 'Menu.Destroy', 'IngaDanceMenu'
    gs 'Menu.Create', 'IngaDanceMenu'

    gs 'MenuUiAdd', 'IngaDanceMenu', 'Кружиться в танце', 'dance'
    gs 'Menu.AddModule', 'IngaDanceMenu', {
        gt 'IngaDanceAction', 'continue'
    }

    if IngaDanceStage >= 1 and IngaDanceWaist = 0:
        gs 'MenuUiAdd', 'IngaDanceMenu', 'Обнять за талию', 'intim'
        gs 'Menu.AddModule', 'IngaDanceMenu', {
            gt 'IngaDanceAction', 'waist'
        }
    end

    if IngaDanceWaist = 1 and IngaDanceKiss = 0:
        gs 'MenuUiAdd', 'IngaDanceMenu', 'Поцеловать', 'intim'
        gs 'Menu.AddModule', 'IngaDanceMenu', {
            gt 'IngaDanceAction', 'kiss'
        }
    end

    if IngaDanceKiss = 1:
        gs 'MenuUiAdd', 'IngaDanceMenu', 'Уйти в комнату Инги', 'home'
        gs 'Menu.AddModule', 'IngaDanceMenu', {
            gt 'IngaDanceAction', 'leave'
        }

        if FamilyCorruptionStage >= 2 or sluttiness['inga'] >= 20:
            gs 'MenuUiAdd', 'IngaDanceMenu', 'Увлечь в тёмный переулок', 'intim'
            gs 'Menu.AddModule', 'IngaDanceMenu', {
                gt 'IngaDanceAction', 'alley'
            }
        end
    end

    gs 'MenuUiAdd', 'IngaDanceMenu', 'Закончить танец', 'return'
    gs 'Menu.AddModule', 'IngaDanceMenu', {
        IngaDanceEnded = 1
        if IngaDanceStage >= 1:
            gs 'FridayDanceAdvanceRound'
        end
        gt 'MarketDance'
    }
---

#IngaDanceAction

    $IngaDanceAction = LCASE($ARGS[0])

    if $IngaDanceAction = 'dance':
        IngaDanceStage = 1
        Friends['inga'] += 1
    elseif $IngaDanceAction = 'continue':
        Friends['inga'] += 1
    elseif $IngaDanceAction = 'waist':
        IngaDanceStage = 2
        IngaDanceWaist = 1
        otkroven['inga'] += 1
    elseif $IngaDanceAction = 'kiss':
        IngaDanceStage = 3
        IngaDanceKiss = 1
        KissCount['inga'] += 1
        love['inga'] += 1
        IngaPlayerPath += 1
    elseif $IngaDanceAction = 'leave':
        IngaDanceEnded = 1
        IngaRoomUnlocked = 1
        gs 'FridayDanceAdvanceRound'
        gs 'ClampGirlSocialStats', 'inga'

        if LOC('IngaDanceActionText') = 1:
            gs 'IngaDanceActionText', 'leave'
        end

        gt 'IngaRoom'
    elseif $IngaDanceAction = 'alley':
        IngaDanceEnded = 1
        gs 'FridayDanceAdvanceRound'
        gs 'ClampGirlSocialStats', 'inga'
        gt 'IngaDanceStreetAlley'
    else:
        IngaDanceStage += 1
    end

    gs 'ClampGirlSocialStats', 'inga'

    if $IngaDanceAction <> 'leave' and $IngaDanceAction <> 'alley':
        if LOC('IngaDanceActionText') = 1:
            gs 'IngaDanceActionText', $IngaDanceAction
        end

        killvar '$IngaDanceAction'
        gt 'IngaDance'
    end

    killvar '$IngaDanceAction'
---

#IngaDanceStreetAlley
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/street_sex/minet1', 'ИНГА В ПЕРЕУЛКЕ У ПЛОЩАДИ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ТЁМНЫЙ ПЕРЕУЛОК У ПЛОЩАДИ'

    if LOC('IngaDanceStreetAlleyIntroText') = 1:
        gs 'IngaDanceStreetAlleyIntroText'
    end
    *pl ' '

    gs 'ActUiPrepare', 'Опустить на колени (минет)', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IngaDanceStreetOral'
    end

    if IngaBackroomSex = 1 or sluttiness['inga'] >= 25:
        gs 'ActUiPrepare', 'Прижать к стене', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaDanceStreetSex'
        end
    end

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

#IngaDanceStreetOral
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/street_sex/minet3', 'ИНГА — МИНЕТ В ПЕРЕУЛКЕ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ИНГА — МИНЕТ В ПЕРЕУЛКЕ'

    OralCount['inga'] += 1
    BlowjobCount['inga'] += 1
    sluttiness['inga'] += 2
    otkroven['inga'] += 1
    love['inga'] += 1
    TavernScandal += 1
    gs 'ClampGirlSocialStats', 'inga'

    if LOC('IngaDanceStreetOralText') = 1:
        gs 'IngaDanceStreetOralText'
    end
    *pl ' '

    gs 'ActUiPrepare', 'Кончить на лицо', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IngaDanceStreetCumFace'
    end

    if IngaBackroomSex = 1 or sluttiness['inga'] >= 25:
        gs 'ActUiPrepare', 'Поднять и прижать к стене', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaDanceStreetSex'
        end
    end

    gs 'ActUiPrepare', 'Закончить и уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

#IngaDanceStreetCumFace
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/street_sex/cumface', 'ИНГА — ФИНАЛ В ПЕРЕУЛКЕ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ИНГА — ФИНАЛ В ПЕРЕУЛКЕ'

    gs 'RegisterSex', 'inga', 'facial', 0, 1
    gs 'RegisterPlayerCum'
    sluttiness['inga'] += 2
    love['inga'] += 1
    gs 'ClampGirlSocialStats', 'inga'

    if LOC('IngaDanceStreetCumFaceText') = 1:
        gs 'IngaDanceStreetCumFaceText'
    end
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

#IngaDanceStreetSex
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/street_sex/fuckyou2', 'ИНГА — СЕКС В ПЕРЕУЛКЕ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ИНГА — СЕКС В ПЕРЕУЛКЕ'

    gs 'RegisterSex', 'inga', 'vaginal', 1, 1
    VaginalCount['inga'] += 1
    sluttiness['inga'] += 3
    otkroven['inga'] += 1
    love['inga'] += 2
    TavernScandal += 1
    if virginity['inga'] = 1:
        virginity['inga'] = 0
    end
    IngaBackroomSex = 1
    IngaDanceUnlocked = 1
    IngaRoomUnlocked = 1
    gs 'ClampGirlSocialStats', 'inga'

    if LOC('IngaDanceStreetSexText') = 1:
        gs 'IngaDanceStreetSexText'
    end
    *pl ' '

    gs 'ActUiPrepare', 'Кончить внутрь', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IngaDanceStreetSexFinish', 'inside'
    end

    gs 'ActUiPrepare', 'Кончить на лицо', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IngaDanceStreetCumFace'
    end

    gs 'ActUiPrepare', 'Кончить наружу', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IngaDanceStreetSexFinish', 'outside'
    end
---

#IngaDanceStreetSexFinish
    *clr
    clr
    cla

    $StreetSexFinishType = LCASE($ARGS[0])

    gs 'SceneShowVisual', 'images/events/inga/street_sex/fuckyou5', 'ИНГА — ПОСЛЕ БЛИЗОСТИ В ПЕРЕУЛКЕ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ИНГА — ПОСЛЕ БЛИЗОСТИ В ПЕРЕУЛКЕ'

    gs 'RegisterPlayerCum'

    if LOC('IngaDanceStreetSexFinishText') = 1:
        gs 'IngaDanceStreetSexFinishText', $StreetSexFinishType
    end
    *pl ' '

    killvar '$StreetSexFinishType'

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

#IngaLucasAlleySpy
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/inga_dance/inga_lucas_alley_spy', 'ИНГА И ЛУКАС В ПОДВОРОТНЕ', 'large', 'webp'

    gs 'ShowLocationScreenTitle', 'ПОДВОРОТНЯ У РЫНОЧНОЙ ПЛОЩАДИ'
    *pl 'Ты неслышно скользишь в тень за угол каменного склада. В полумраке переулка виднеются две фигуры: широкоплечий подмастерье кузнеца Лукас прислонился к стене и нетерпеливо расстёгивает штаны, выпуская на волю свой внушительный, налившийся член.'
    *pl ' '
    *pl 'Инга послушно опускается перед ним на колени прямо в пыль. Она бросает опасливый взгляд в сторону шумящей площади, сглатывает и обеими руками берётся за член парня. Лукас грубовато кладёт ладонь ей на затылок, направляя её головку:'
    *pl ' '
    *pl '— Ну давай, Инга, работай язычком... ты же знаешь, как я люблю. До свадьбы ни-ни, а ротик-то у тебя рабочий, мамаша твоя правильно тебя учила...'
    *pl ' '
    *pl 'Инга глубоко принимает головку в рот, её щёки втягиваются, раздаётся влажное чмоканье. Подмастерье довольно рычит, запрокидывая голову к ночному небу. Девушка усердно сосёт, её светлые волосы растрепались, а в глазах блестят слезинки от подступающего к горлу спазма.'
    *pl ' '
    *pl 'Ты тихо отступаешь назад к праздничным огням площади, пока Лукас не заметил чужого взгляда.'
    *pl ' '

    gs 'FridayDanceAdvanceRound'

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
---

