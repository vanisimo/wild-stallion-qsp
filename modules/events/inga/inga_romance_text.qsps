#IngaRomanceStepText
    $IngaRomanceStepKey = LCASE($ARGS[0])

    if $IngaRomanceStepKey = 'handjob':
        *pl 'Ты проходишь вслед за Ингой за высокую перегородку в глубине лавки, где высятся тугие мешки с зерном и пахнет сушёными травами и мукой.'
        *pl ' '
        *pl 'Девушка нервно теребит край передника, её щёки алеют, но во взгляде нет страха — только живое смущение и облегчение. Она делает шаг ближе и тихо говорит:'
        *pl ' '
        *pl '— Стефан... я ведь до сих пор не могу поверить. Я раньше правда думала, что Лукас такой сильный, что с ним ничего не страшно. Он так хвастался своими кулаками... А когда этот сержант Грюн начал ко мне цепляться — Лукас только глазами хлопал да пятился, как побитый щенок. Если бы не ты... я даже не знаю, что бы со мной было.'
        *pl ' '
        *pl 'Она несмело поднимает руку и касается твоей груди. Тёплые пальчики скользят вниз, к поясу штанов. Инга смущённо закусывает губу, нащупывая сквозь плотную ткань твой затвердевший уд, и тихо выдыхает:'
        *pl ' '
        *pl '— Ты настоящий хозяин, Стефан... За таким мужчиной правда спокойно.'
        *pl ' '
        *pl 'Её ладонь начинает медленно и осторожно поглаживать тебя через сукно. Дыхание девушки сбивается, а в её светлых глазах разгорается неподдельный интерес.'

    elseif $IngaRomanceStepKey = 'cuni':
        *pl 'Утреннее солнце едва пробивается сквозь щели деревянных ставень подсобки. В воздухе кружатся пылинки, пахнет пряной корицей и ванилью.'
        *pl ' '
        *pl 'Инга с порога бросает взгляд на входную дверь, убеждается, что покупателей нет, и с заговорщической улыбкой поворачивается к тебе:'
        *pl ' '
        *pl '— Представляешь, Лукас вчера вечером подходил к нашему дому. Стоял под окном, пытался оправдаться... Кричал, что сержант просто подло напал со спины, и что он мне докажет, какой он жених. А я прямо перед его носом ставни захлопнула и засов задвинула! Сказала, чтоб больше и близко не подходил.'
        *pl ' '
        *pl 'Она лукаво улыбается, поднимая на тебя сияющие глаза:'
        *pl ' '
        *pl '— Хватит с меня пустых слов. Я знаю, кто мне по-настоящему нужен...'
        *pl ' '
        *pl 'Ты привлекаешь Ингу к себе и усаживаешь на мягкий мешок с отрубями. Твои руки приподнимают подол её платья, открывая гладкие, аккуратно выбритые бёдра — благословение Ильматера делает кожу нежной и шелковистой. Инга судорожно ахает, вцепившись пальцами в твои плечи, когда ты касаешься губами её сокровенного девичьего лона.'
        *pl ' '
        *pl 'Она приглушённо стонет, пряча лицо у тебя на груди, чтобы сладостные звуки не вырвались в торговый зал, пока твои ласки дарят ей негу и наслаждение.'

    elseif $IngaRomanceStepKey = 'blowjob':
        *pl 'Как только колокольчик на двери лавки стихает после ухода редкого утреннего покупателя, Инга берёт тебя за руку и решительно увлекает за собой в подсобку.'
        *pl ' '
        *pl 'Она задорно смеётся, прислонившись к штабелю ящиков с солью:'
        *pl ' '
        *pl '— Знаешь, мама сегодня утром так пристально на меня посмотрела... и только головой покачала с улыбкой. Она ведь всё замечает. Сказала: «Инга, главное, чтобы парень надёжный был и умел за себя и за тебя постоять, а не ярмарочный хвастун». Ей совершенно плевать на городские сплетни, Стефан. Она видит, кто ты такой.'
        *pl ' '
        *pl 'Инга опускается на колени прямо на чистую рогожку между ящиками. Её пальцы бережно расстёгивают твой пояс и высвобождают горячую, пульсирующую плоть.'
        *pl ' '
        *pl '— Я хочу сделать тебе приятно, Стефан... подарить тебе всю свою нежность.'
        *pl ' '
        *pl 'Она ласково касается губами твоего уlength, заглядывая снизу вверх тебе прямо в глаза, и с упоением принимает тебя в свой горячий, податливый рот. С каждым её мягким, трепетным движением по твоему телу прокатывается волна густого жара.'
        *pl ' '
        *pl 'Когда ты чувствуешь приближение сладкого финала, Инга отстраняется лишь на миг, смущённо улыбаясь:'
        *pl ' '
        *pl '— Стефан... здесь, на мешках, так суетливо... Приходи на танцы в пятницу или поднимись ко мне в комнату вечером. Я хочу, чтобы наша первая ночь была по-настоящему особенной.'

    elseif $IngaRomanceStepKey = 'presex':
        *pl 'В подсобке царит интимный, полутёмный покой. За деревянной стеной еле слышен далёкий гул просыпающегося рынка.'
        *pl ' '
        *pl 'Инга стоит вплотную к тебе, её грудь часто вздымается под тонким полотном рубашки. Она бережно обнимает тебя за шею, её пальцы зарываются в твои волосы:'
        *pl ' '
        *pl '— Стефан... ты единственный мужчина, о котором я думаю. Я жду вечера, когда мы сможем остаться в моей комнате наедине.'

    else:
        *pl 'В подсобке пахнет пряностями, зерном и чистым деревом — и сладостным теплом между вами.'
    end

    killvar '$IngaRomanceStepKey'
