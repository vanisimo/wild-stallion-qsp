! ================================================
! FILE: modules/events/inga/inga_romance.qsps
! MODULE: events/becky
! Роман Инги: лестница в подсобке → первый секс → танцы
! ================================================

#IngaRomanceTryUnlock

    if IngaRomanceUnlocked = 1:
        exit
    end

    if IngaPlayerRouteOpen = 0:
        exit
    end

    if IngaGuardThanksDone = 0:
        if GuardBribed = 0:
            exit
        end
    end

    IngaRomanceUnlocked = 1
---

#IngaRomanceCanAdvance

    IngaRomanceCanAdvance = 0

    if IngaRomanceUnlocked = 0:
        exit
    end

    if IngaBackroomSex = 1:
        exit
    end

    if IngaBackroomStepToday = 1:
        exit
    end

    if time <> 1:
        exit
    end

    if IngaRomanceStage >= 3:
        exit
    end

    if Friends['inga'] < 14 + IngaRomanceStage * 2:
        exit
    end

    IngaRomanceCanAdvance = 1
---

#IngaRomanceStep

    gs 'IngaRomanceCanAdvance'

    if IngaRomanceCanAdvance = 0:
        gt 'BeckyShop'
    end

    if IngaRomanceStage = 0:
        $IngaRomanceStepKey = 'handjob'
    elseif IngaRomanceStage = 1:
        $IngaRomanceStepKey = 'cuni'
    elseif IngaRomanceStage = 2:
        $IngaRomanceStepKey = 'blowjob'
    else:
        gt 'BeckyShop'
    end

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОДСОБКА ЛАВКИ — ИНГА'
    gs 'SceneShowVisual', 'images/events/inga/inga_romance/inga_romance_step', 'ПОДСОБКА ЛАВКИ — ИНГА', 'large', 'webp'
    gs 'IngaRomanceStepText', $IngaRomanceStepKey
    *pl ' '

    IngaRomanceStage += 1
    IngaBackroomStepToday = 1
    IngaPlayerPath += 1

    if $IngaRomanceStepKey = 'handjob':
        CaressCount['inga'] += 1
        sluttiness['inga'] += 1
        otkroven['inga'] += 2
        love['inga'] += 1
        Friends['inga'] += 1
    elseif $IngaRomanceStepKey = 'cuni':
        CuniCount['inga'] += 1
        OralCount['inga'] += 1
        otkroven['inga'] += 2
        love['inga'] += 1
        sluttiness['inga'] += 1
    elseif $IngaRomanceStepKey = 'blowjob':
        BlowjobCount['inga'] += 1
        OralCount['inga'] += 1
        sluttiness['inga'] += 2
        love['inga'] += 1
    end

    gs 'ClampGirlSocialStats', 'inga'
    killvar '$IngaRomanceStepKey'

    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShop'
    end
---

#IngaBackroomFirstSexLaunch

    if IngaRomanceUnlocked = 0 or IngaRomanceStage < 3:
        gt 'BeckyShop'
    end

    if IngaBackroomSex = 1:
        gt 'BeckyShop'
    end

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПЕРВАЯ БЛИЗОСТЬ В ПОДСОБКЕ'
    gs 'SceneShowVisual', 'images/events/inga/inga_romance/inga_backroom_first_sex_launch', 'ПЕРВАЯ БЛИЗОСТЬ В ПОДСОБКЕ', 'large', 'webp'
    gs 'IngaRomanceStepText', 'presex'
    *pl ' '

    IngaBackroomFirstSexActive = 1
    IngaBackroomStepToday = 1

    if IntimStage['inga'] < 5:
        IntimStage['inga'] = 5
    end

    if otkroven['inga'] < 15:
        otkroven['inga'] = 15
    end

    gs 'ActUiPrepare', 'Прижать Ингу к себе', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'SexSceneStart', 'inga', 'IngaBackroomAfterSex', 'inga_backroom_first'
    end
---

#IngaBackroomAfterSex

    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'ПОСЛЕ БЛИЗОСТИ'
    gs 'SceneShowVisual', 'images/events/inga/inga_romance/inga_backroom_after_sex', 'ПОСЛЕ БЛИЗОСТИ', 'large', 'webp'
    gs 'IngaRomanceAfterSexText'
    *pl ' '

    if IngaBackroomSex = 0 or IngaBackroomFirstSexActive = 1:
        IngaBackroomSex = 1
        IngaDanceUnlocked = 1
        IngaRoomUnlocked = 1
        IngaPlayerRouteOpen = 1
        if virginity['inga'] = 1:
            virginity['inga'] = 0
        end
        IngaBackroomFirstSexActive = 0
        love['inga'] += 2
        Friends['inga'] += 2
        sluttiness['inga'] += 2
        gs 'ClampGirlSocialStats', 'inga'
    end

    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShop'
    end
---

#IngaBackroomCanOffer

    IngaBackroomCanOffer = 0

    if IngaRomanceUnlocked = 0:
        exit
    end

    if time <> 1:
        exit
    end

    if IngaBackroomSex = 1:
        if LOC('SexSceneStart') = 1:
            IngaBackroomCanOffer = 1
        end
        exit
    end

    gs 'IngaRomanceCanAdvance'

    if IngaRomanceCanAdvance = 1:
        IngaBackroomCanOffer = 1
        exit
    end

    if IngaRomanceStage >= 3 and IngaBackroomStepToday = 0:
        IngaBackroomCanOffer = 1
    end
---
