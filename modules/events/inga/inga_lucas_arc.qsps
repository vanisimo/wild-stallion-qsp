#LucasDanceApproachStart
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/inga/inga_lucas_arc/lucas_dance_approach', 'ЛУКАС НА ТАНЦАХ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ТАНЦЫ: РАЗГОВОР С ЛУКАСОМ'

    if IngaLucasThreesomeCount >= 1:
        $IngaLucasBranch = 'mixed'
    else:
        $IngaLucasBranch = 'romance'
    end

    if LOC('LucasDanceApproachStartText') = 1:
        gs 'LucasDanceApproachStartText', $IngaLucasBranch
    end

    *pl ' '
    gs 'ActUiPrepare', 'Разрешить встречи наедине', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'LucasDanceApproachAgree'
    end

    gs 'ActUiPrepare', 'Отказать и прогнать', 'refuse'
    act $ActUiLabel, $ActUiIconPath:
        gt 'LucasDanceApproachRefuse'
    end

    gs 'ActUiPrepare', 'Вернуться к празднику', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MarketDance'
    end
