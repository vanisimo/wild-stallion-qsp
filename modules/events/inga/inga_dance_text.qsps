! ================================================
! FILE: modules/events/inga/inga_dance_text.qsps
! MODULE: events/becky
! ! [AI-WORKED] Текст переработан / дополнен ассистентом 04.10.2026
! Тексты пятничных танцев с Ингой
! ================================================

#IngaDanceMeetMainText
    *pl 'Инга стоит у края площади и оглядывается на проход к рынку — будто ждёт кого-то.'
    *pl ' '
    *pl '— Привет, Стефан. Я… не танцую сегодня. Жду Лукаса. Он обещал прийти после работы.'
    *pl ' '
    *pl 'Она смущённо улыбается:'
    *pl ' '
    *pl '— Он хороший парень. Правда.'
---

#IngaDanceMeetAfterGuardText
    *pl 'Инга узнаёт тебя и вспыхивает ярким румянцем:'
    *pl ' '
    *pl '— Ты… после того, что ты сделал для меня со стражником… я даже не знаю, как благодарить тебя при всех на площади.'
    *pl ' '
    *pl 'Она быстро оглядывается по сторонам и с трепетом шепчет:'
    *pl ' '
    *pl '— Лукас всё ещё обещает прийти, но мне теперь всё равно. Если ты позовёшь меня — я обязательно пойду с тобой.'
---

#IngaDanceMainText
    if IngaDanceStage = 0:
        $IngaDanceLastText = 'Инга в нарядном платье с вышивкой немного нервничает под взглядами толпы, но уверенно берёт твою руку.'
    else:
        $IngaDanceLastText = 'Ты ведёшь Ингу в кругу танцующих. Она легко прижимается к тебе, больше ни на миг не оглядываясь на край площади.'
    end
---

#IngaDanceActionText
    $IngaDanceTextAction = LCASE($ARGS[0])

    if $IngaDanceTextAction = 'dance':
        $IngaDanceLastText = 'Первые движения в хороводе выходят осторожными, но пальцы девушки крепко сжимают твою ладонь.'
    elseif $IngaDanceTextAction = 'waist':
        $IngaDanceLastText = 'Ты уверенно кладёшь ладони ей на талию. Инга сладостно вздрагивает, прижимается теснее и тихо выдыхает: "Стефан... вокруг же столько глаз..."'
    elseif $IngaDanceTextAction = 'kiss':
        $IngaDanceLastText = 'Поцелуй посреди шумного круга заставляет её забыть о музыке и толпе — она пламенно отвечает тебе на глазах у всего города.'
    elseif $IngaDanceTextAction = 'leave':
        $IngaDanceLastText = 'Инга счастливо и заговорщически кивает: "Пойдём скорее. Комната наверху свободна, мама занята — нам никто не помешает."'
    end

    killvar '$IngaDanceTextAction'
---

#IngaRoomIntroText
    *pl 'Комната Инги над лавкой — небольшая, уютная, с окном во внутренний двор. Здесь пахнет чистым бельём, сушёной лавандой и молодой женской кожей.'
    *pl ' '
    *pl 'Инга закрывает дверь на кованую щеколду и поворачивается к тебе с открытым, сияющим взглядом — без тени прежней робости.'
---

#IngaDanceStreetAlleyIntroText
    *pl 'Ты берёшь Ингу за руку и уводишь её прочь от залитой фонарями площади, увлекая в узкий, тёмный переулок за каменными складами.'
    *pl ' '
    *pl 'Инга испуганно, но послушно следует за тобой. Её щёки пылают, дыхание сбилось, а сердечко колотится так громко, что кажется, его слышно в тишине подворотни. Она бросает робкий взгляд назад, туда, где за углом гремит весёлая музыка и доносятся крики гуляющих горожан:'
    *pl ' '
    *pl '— Стефан... ты с ума сошёл? Прямо здесь?.. А если кто-то из парней свернёт за угол отлить? Или матушка решит проверить склады?..'
    *pl ' '
    *pl 'Но в её шёпоте нет настоящего страха — лишь пьянящий азарт опасности. Она теснее прижимается к тебе в прохладной тени каменной стены.'
---

#IngaDanceStreetOralText
    *pl 'Инга послушно опускается перед тобой на колени прямо на прохладные плиты подворотни. Её пальчики дрожат от возбуждения, расстёгивая твой ремень и пуговицы штанов.'
    *pl ' '
    *pl 'Она выпускает твой налившийся уд на свежий ночной воздух, обхватывает его тёплыми ладонями и заглядывает снизу вверх тебе в глаза. Совсем рядом, за каменным выступом, слышны пьяные переклички и смех ярмарочных зевак, но Инга, прикусив губку от дерзости происходящего, припадает ртом к твоей головке.'
    *pl ' '
    *pl 'Её язычок скользит по стволу, губы плотно сжимаются, втягивая плоть глубже. В тишине переулка раздаётся тихое, влажное причмокивание. Инга быстро входит во вкус, двигая головкой всё увереннее и с наслаждением ощущая твою растущую силу.'
---

#IngaDanceStreetCumFaceText
    *pl 'Приближение финала настигает тебя острой, горячей волной. Ты сжимаешь светлые волосы Инги на затылке, вынимая член из её горячего рта, и густые, обжигающие струи семени выплёскиваются ей на лицо.'
    *pl ' '
    *pl 'Белые брызги покрывают её щёки, кончик носа и приоткрытые влажные губы. Инга судорожно жмурится, тихо охает от неожиданного тепла, а затем слизывает каплю с верхней губы кончиком языка.'
    *pl ' '
    *pl 'Она смотрит на тебя снизу вверх с бесстыдной, пьянящей улыбкой, тяжело переводя дух и ничуть не смущаясь своего украшенного лица.'
---

#IngaDanceStreetSexText
    *pl 'Ты подхватываешь Ингу под бёдра и прижимаешь её спиной к шершавой каменной кладке стены склада. Девушка тихо ахает тебе в самое ухо и послушно обхватывает твои бока стройными ножками.'
    *pl ' '
    *pl 'Её юбки задраны, прохладный ночной ветерок обдувает её пылающую плоть. Направив твёрдый уд к её влажному входу, ты решительно толкаешься вперёд, входя в неё одним глубоким, уверенным движением.'
    *pl ' '
    *pl 'Инга закусывает воротник твоей куртки, чтобы не вскрикнуть на всю округу. Её тело жадно сжимает твой уд, пока ты методично и мощно вбиваешься в неё у стены подворотни, покачиваясь в ритме далёких ярмарочных барабанов.'
---

#IngaDanceStreetSexFinishText
    $FinishMode = $ARGS[0]

    if $FinishMode = 'inside':
        *pl 'В последний миг ты прижимаешь Ингу к каменной стене и изливаешь горячую волну своего семени глубоко внутрь её лона.'
        *pl ' '
        *pl 'Инга судорожно вздрагивает, её внутренние мышцы ритмично сжимают твой уд, выжимая всё до последней капли. Она тихо стонет, уткнувшись носом в твою шею, пока сладкая истома разливается по её телу.'
    else:
        *pl 'В самый последний момент ты выдёргиваешь пульсирующий член из девушки и обильно поливаешь семенем её бёдра и подол задранной юбки.'
        *pl ' '
        *pl 'Инга обессиленно сползает по стене, её ноги мелко дрожат, а на губах играет блаженная, шальная улыбка.'
    end

    *pl ' '
    *pl 'Вы переводите дыхание в полумраке переулка. Инга торопливо оправляет юбки, разглаживает передник и бережно вытирает следы вашей бурной страсти, с обожанием глядя на тебя.'

    killvar '$FinishMode'
---
