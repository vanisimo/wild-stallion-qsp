! Тексты первого конфликта с Легаре и последующих разговоров
! Используется кодом:
! modules/events/tavern/legare_first_conflict.qsps
! ================================================

#LegareFirstConflictIntroText
    *pl 'Легаре входит в трактир тяжело, уверенно, по-хозяйски. Дорогой суконный плащ, отороченный мехом, поблескивающие перстни на пухлых пальцах — всем своим видом он показывает, что привык к почёту.'
    *pl 'Он неспешно оглядывает зал, оценивая обстановку, и его маслянистый взгляд на несколько секунд задерживается на Аманде, которая протирает кружки за дальним столом.'
    *pl 'Только после этого купец поворачивается к стойке и подходит вплотную.'
    *pl '— Стефан, — произносит он веско, постукивая тяжелым перстнем по дубовой столешнице. — Нам пора потолковать. О поставках вина и эля. И о том, как в твоём заведении приличествует встречать уважаемых гостей.'
    *pl 'В его полуулыбке нет торговой любезности — это холодная уверенность человека, держащего в кулаке все винные склады города.'
    *pl ' '
    if AmandaLegareInterest >= 4:
        *pl 'Легаре усмехается в усы и добавляет чуть тише:'
        *pl '— Твоя сестрица, к слову, куда приветливее и сообразительнее тебя. Приятно видеть в этой глуши девицу, которая умеет ценить щедрое внимание и красивые вещи.'
    else:
        *pl 'Легаре недовольно кривит губы:'
        *pl '— А сестрица твоя всё дичится, словно в монастыре выросла. Неужто ты держишь её здесь взаперти, как сторожевую собаку? Не по-людски это.'
    end
---

#LegareFirstConflictActionText
    $LegareConflictTextChoice = LCASE($ARGS[0])

    if $LegareConflictTextChoice = 'calm_firm':
        *pl 'Вы спокойно кладёте ладони на стойку и встречаете взгляд купца в упор:'
        *pl '— Аманда здесь работает, Легаре. Но она моя сестра, а не довесок к винным бочкам и не товар из твоей лавки. Будем говорить о деле — говорим о деле.'
        *pl 'Легаре слушает не перебивая, но его сытая улыбка заметно тускнеет, а в глазах мелькает недобрый огонёк.'
        *pl '— О деле так о деле, Стефан, — роняет он с холодной усмешкой. — Только помни: доброе вино — товар капризный. Оно имеет свойство дорожать, когда хозяин трактира забывает о почтении.'

    elseif $LegareConflictTextChoice = 'hard_warning':
        *pl 'Вы подаётесь вперёд через стойку, и ваш голос звучит жёстко, отсекая любые шутки:'
        *pl '— Держись от Аманды подальше, купец. Заметишь её за столом — смотри в свою кружку. Будешь распускать руки или язык — вылетишь на улицу вверх тормашками.'
        *pl 'На несколько мгновений в зале повисает тишина. Ближайшие выпивохи замирают, прислушиваясь к перепалке.'
        *pl 'Легаре медленно приподнимает подбородок. В его взгляде нет страха — лишь задетая купеческая спесь:'
        *pl '— Вот как мы заговорили... Осторожнее со словами, парень. Грубость в торговле обходится слишком дорого. Особенно тем, у кого за душой лишь старая отцовская стойка.'

    elseif $LegareConflictTextChoice = 'supplier_place':
        *pl 'Вы с усмешкой оглядываете пышный наряд купца и ровно напоминаете:'
        *pl '— Ты здесь поставщик, Легаре. Твоя забота — привезти бочки в погреб, забрать оговоренное серебро и ехать к жене. Хозяин в этом доме — я. И порядки здесь устанавливаю я, а не гильдейские купцы.'
        *pl 'Лицо Легаре каменеет, желваки на скулах едва заметно вздрагивают:'
        *pl '— Поставщик... — цедит он сквозь зубы. — Что ж, справедливо. Значит, очень скоро ты узнаешь, сколько стоит единственный надёжный поставщик вина в этом городишке.'

    elseif $LegareConflictTextChoice = 'clarissa_hint':
        *pl 'Вы слегка наклоняетесь к Легаре и негромко, почти доверительно замечаете:'
        *pl '— Твоя супруга, Кларисса, женщина строгих правил и отличный счётчик. Думаю, ей будет небезынтересно узнать, на какие именно «трактирные нужды» уходят подарки и внимание её почтенного мужа.'
        *pl 'Самодовольная ухмылка мгновенно слетает с лица Легаре. В его глазах вспыхивает неподдельная ярость:'
        *pl '— Не смей совать свой нос в мой дом и полоскать имя моей жены, щенок! — шипит он, но тут же сдерживается, оглядывая зал. Стрела попала точно в цель.'

    elseif $LegareConflictTextChoice = 'save_supplies':
        *pl 'Вы делаете глубокий вдох, трезво взвешивая расклад.'
        *pl '«Дикий Жеребец» живёт оборотом. Без вина и эля гости уже завтра уйдут в портовые трущобы, а семье будет нечем платить подати. Аманда — взрослая девушка; если ей льстит внимание купца, она сама вправе решать, с кем перемигиваться. Дело прежде всего.'
        *pl 'Вы спокойно и ровно отвечаете:'
        *pl '— Нам нужно вино, Легаре. И нужен эль — в срок, без задержек и по прежней цене. А насчёт Аманды... она взрослая девушка со своим умом. Ей решать, чьи подарки принимать и с кем говорить, я за ней надзирателем не стою. Но в зале мы ведём торговлю, и договор по бочкам должен соблюдаться строго.'
        *pl 'Легаре удивлённо приподнимает бровь, затем довольно усмехается и оглаживает подбородок:'
        *pl '— Вот это слова рассудительного человека, Стефан. Торговля любит холодные головы, а не мальчишеский гонор. Вино будет в погребе вовремя, и цены я не трону. А с Амандой мы уж как-нибудь сами поладим — девица она смышлёная.'

    elseif $LegareConflictTextChoice = 'kick_out':
        *pl 'Терпение лопается. Вы выходите из-за стойки и указываете пальцем на входную дверь:'
        *pl '— А ну пошёл вон отсюда, Легаре. Забирай свои перстни, свои намёки и катись к воротам. Чтобы духу твоего в моём трактире не было!'
        *pl 'Легаре отступает к дверям, кривя губы в ядовитой усмешке, и громко бросает на весь зал:'
        *pl '— Что ж! Посмотрим, сколько протянет твой сарай без доброго вина! Завтра начнёшь поить бродяг болотной жижей!'
        *pl 'Дверь с грохотом захлопывается, оставляя в зале притихший, тревожный шёпот.'

    else:
        *pl 'Разговор заканчивается без ясного соглашения, но прежнего спокойствия в торговле уже не будет.'
    end

    killvar '$LegareConflictTextChoice'
---

#AmandaTalkAboutLegareFirstConflictIntroText
    *pl 'Аманда отставляет тряпку и осторожно подходит к стойке, нервно теребя краешек передника.'
    *pl '— Стефан... Я видела, как Легаре на тебя налетел. Он ведь приходил из-за меня, да?'
    *pl 'Она смотрит на вас, пытаясь понять, чем закончилась эта стычка.'
---

#AmandaTalkAboutLegareFirstConflictActionText
    $AmandaConflictTalkChoice = LCASE($ARGS[0])

    if $AmandaConflictTalkChoice = 'prudent':
        *pl 'Вы объясняете ей ситуацию спокойно и по-деловому:'
        *pl '— Трактиру нужны поставки каждый день, Аманда. Без вина и пива мы разоримся. А ты уже не маленькая — если купец тебе приятен, решай сама, только помни, что у таких людей на уме всегда выгода.'
        if AmandaLegareInterest >= 4:
            *pl 'Аманда вздыхает с заметным облегчением и чуть смущённо улыбается:'
            *pl '— Спасибо, что не стал устраивать драку, Стефан. Я знаю, что он хитрый лис, но он богат, щедр и обращается со мной как с дамой. Я сама справлюсь, не бойся.'
        else:
            *pl 'Аманда опускает глаза и тихо кивает:'
            *pl '— Я понимаю... без поставок нам конец. Но ты не думай, я к нему на шею не вешаюсь. Смотрит он масляно, мне это не по душе. Буду держаться настороже.'
        end

    elseif $AmandaConflictTalkChoice = 'defended':
        *pl 'Вы кладёте руку ей на плечо:'
        *pl '— Я дал ему понять, что ты здесь не товар. Пусть только попробует сунуться — вылетит вон.'
        *pl 'Аманда благодарно смотрит на вас, в её глазах мелькает теплота:'
        *pl '— Спасибо, Стефан... Мне приятно знать, что ты за меня горой. Только... ты сам из-за него не пострадай. Он ведь купец видный, отомстить может.'

    elseif $AmandaConflictTalkChoice = 'warn_danger':
        *pl 'Вы строго предупреждаете её:'
        *pl '— Держись от него как можно дальше. Он опасный тип и ни во что тебя не ставит.'
        *pl 'Аманда сдержанно кивает, понимая всю серьёзность положения.'
    end

    killvar '$AmandaConflictTalkChoice'
---

#MelissaTalkAboutLegareFirstConflictIntroText
    *pl 'Мелисса захлопывает гроссбух и скрещивает руки на груди, пристально глядя на вас из-за конторки.'
    *pl '— Ну что, хозяин? Видела я, как Легаре тут хвостом крутил. Надеюсь, ты понимаешь, во что ввязываешься?'
---

#MelissaTalkAboutLegareFirstConflictActionText
    $MelissaConflictTalkChoice = LCASE($ARGS[0])

    if $MelissaConflictTalkChoice = 'prudent':
        *pl 'Вы спокойно объясняете Мелиссе свой расчёт: без бочек трактир закроется, а Аманда взрослая.'
        *pl 'Мелисса задумчиво хмыкает, постукивая пальцем по пергаменту:'
        *pl '— Трезво, Стефан. Неожиданно трезво для тебя. Экономика — вещь упрямая, без вина в погребе мы к концу декады пойдём по миру. Но смотри в оба: Легаре — старый волк. Если почует слабину, решит, что может купить здесь всё.'

    elseif $MelissaConflictTalkChoice = 'firm':
        *pl 'Вы говорите, что осадили купца и не позволите ему хозяйничать.'
        *pl 'Мелисса одобрительно кивает, но в её голосе звучит предостережение:'
        *pl '— Гордо, по-мужски. Я рада, что у тебя есть стержень. Но готовься: этот индюк ударит по ценам. Нам придётся туже затянуть пояса.'

    elseif $MelissaConflictTalkChoice = 'scandal':
        *pl 'Вы говорите, что выставили наглеца за дверь.'
        *pl 'Мелисса тяжело вздыхает и прикладывает ладонь ко лбу:'
        *pl '— Скандал на весь зал... Теперь весь город будет судачить, а бочки нам придётся искать на коленях. Готовься к весёлым денечкам, братец.'
    end

    killvar '$MelissaConflictTalkChoice'
---

#ClarissaTalkAboutLegareFirstConflictIntroText
    *pl 'Кларисса отрывается от конторских записей и поднимает на вас встревоженный взгляд.'
    *pl '— Стефан... До меня дошли слухи, что мой супруг вчера бушевал в твоём трактире. Что между вами произошло?'
---

#ClarissaTalkAboutLegareFirstConflictActionText
    $ClarissaConflictTalkChoice = LCASE($ARGS[0])

    if $ClarissaConflictTalkChoice = 'tell_truth':
        *pl 'Вы честно рассказываете о претензиях Легаре и его намёках на Аманду.'
        *pl 'Кларисса бледнеет, сжимая в руке гусиное перо:'
        *pl '— Он не меняется... Ему всегда мало того, что есть. Будь осторожен, Стефан. Легаре злопамятен и никогда не прощает обид.'

    elseif $ClarissaConflictTalkChoice = 'soften':
        *pl 'Вы сглаживаете углы, сказав, что просто поспорили о ценах на поставку.'
        *pl 'Кларисса грустно улыбается:'
        *pl '— Не надо меня оберегать, я слишком хорошо знаю своего мужа. Если он угрожает поставками — дело не только в серебре.'
    end

    killvar '$ClarissaConflictTalkChoice'
---
