    end

    gs 'SceneShowVisual', 'images/events/tavern/legare_first_conflict/melissa_talk_legare_conflict', 'РАЗГОВОР С МЕЛИССОЙ', 'large', 'webp'
    gs 'EnsureGirlData', 'melissa'
    gs 'ShowGirlSidebar', 'melissa'

    MelissaLegareConflictTalkReady = 0
    MelissaLegareConflictTalkDone = 1

    *pl '══════════════════════════════════════════════'
    *pl ' МЕЛИССА О ССОРЕ С ЛЕГАРЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('MelissaTalkAboutLegareFirstConflictIntroText') = 1:
        gs 'MelissaTalkAboutLegareFirstConflictIntroText'
    end

    *pl ' '

    if LegarePrudentDealDone = 1:
        gs 'ActUiPrepare', 'Объяснить практичный расчёт с бочками', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MelissaTalkAboutLegareFirstConflictAction', 'prudent', $MelissaConflictReturnLoc
        end
    elseif LegareFirstConflictResult = 4:
        gs 'ActUiPrepare', 'Сказать, что наглецов нужно выставлять за дверь', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MelissaTalkAboutLegareFirstConflictAction', 'scandal', $MelissaConflictReturnLoc
        end
    else:
        gs 'ActUiPrepare', 'Сказать, что ты осадил купца и не дашь сестру в обиду', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MelissaTalkAboutLegareFirstConflictAction', 'firm', $MelissaConflictReturnLoc
        end
    end
