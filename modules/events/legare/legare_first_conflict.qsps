    end

    gs 'SceneShowVisual', 'images/events/tavern/legare_first_conflict/amanda_talk_legare_conflict', 'РАЗГОВОР С АМАНДОЙ', 'large', 'webp'
    gs 'EnsureGirlData', 'amanda'
    gs 'ShowGirlSidebar', 'amanda'

    *pl '══════════════════════════════════════════════'
    *pl ' АМАНДА О ВИЗИТЕ ЛЕГАРЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if LOC('AmandaTalkAboutLegareFirstConflictActionText') = 1:
        gs 'AmandaTalkAboutLegareFirstConflictActionText', $AmandaTalkChoice
    end

    *pl ' '
    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt $AmandaConflictReturnLoc
    end
    killvar '$AmandaTalkChoice'
