! Тексты торгового давления Легаре
! Используется кодом:
! modules/events/tavern/legare_supply_pressure.qsps
! ================================================

#LegareSupplyPressureIntroText
    *pl 'Утренний холод ещё не выветрился из подвала, а у разгрузочных ворот уже стоит телега Легаре.'
    *pl 'Только в этот раз возчик не спешит сгружать пузатые дубовые бочки. Он сидит на облучке, лениво жуёт соломинку и передаёт вам засаленный клочок пергамента.'
    *pl 'Новый расчёт заставляет зубы скрипнуть: цена на доброе вино подскочила на треть, а эль обещают привезти «как только освободятся гильдейские подводы» — то есть неизвестно когда.'
    *pl '— Господин Легаре велел передать, — усмехается возчик, сплёвывая под копыта лошади, — что на дорогах нынче неспокойно, пошлины растут, а доброе отношение в долг не наливают.'
    *pl 'Формально — обычные торговые тяготы. На деле — первый расчётливый удар купца под дых. Легаре наглядно напоминает, кто держит трактир за горло.'
---

#LegareSupplyPressureActionText
    $SupplyPressureTextChoice = LCASE($ARGS[0])

    if $SupplyPressureTextChoice = 'accept_prices':
        *pl 'Вы сжимаете кулаки в карманах фартука, но молча отсчитываете серебро.'
        *pl 'Трактир не может остаться без вина даже на один вечер — захмелевшие плотники, стражники и купцы не станут слушать оправданий, они просто пойдут пить к конкурентам.'
        *pl 'Возчик с довольной ухмылкой пересчитывает монеты и даёт отмашку подмастерьям катить бочки в погреб.'
        *pl 'Поставки спасены, но кошель трактира заметно похудел. Легаре получил то, чего добивался: заставил вас платить за свою непокорность.'

    elseif $SupplyPressureTextChoice = 'bargain':
        if LegareSupplyPressureResult = 1:
            *pl 'Вы отправляетесь на купеческий склад и вступаете в жёсткий, дотошный торг.'
            *pl 'Вспомнив отцовские накладные и городские торговые правила, вы ловите приказчика Легаре на несостыковках в пошлинах и сбиваете часть наценки.'
            *pl 'Купец соглашается уступить пару медяков с бочки, но даёт понять: прежней лёгкой жизни не будет. Это не мир, а лишь временная передышка.'
        else:
            *pl 'Вы пытаетесь оспорить цену прямо у стойки, требуя соблюдать старый договор.'
            *pl 'Приказчик лишь холодно пожимает плечами:'
            *pl '— Старый договор кончился со старым хозяином, парень. Не хочешь брать по этой цене — не бери. Завтра и пива не привезём, отдадим в порт.'
            *pl 'Разговор заходит в глухой тупик. Это уже не спор о серебре — это прямая угроза задушить заведение.'
        end

    elseif $SupplyPressureTextChoice = 'ask_clarissa':
        *pl 'Вы решаете действовать в обход Легаре и тихо отправляетесь к ратуше, где работает Кларисса.'
        *pl 'Игра чрезвычайно опасная: если купец проведает, что его собственная жена помогает трактирщику за его спиной, в их доме разразится буря.'
        *pl 'Но Кларисса ведёт все купеческие книги, знает каждого возчика в слободе и помнит старые долги, о которых Легаре предпочёл бы забыть.'

    elseif $SupplyPressureTextChoice = 'temporary_suppliers':
        *pl 'Вы разворачиваете телегу Легаре и отправляетесь на окраину города, к мелким слободским пивоварам.'
        *pl 'У них удаётся перехватить несколько бочек мутноватого эля и кислого ягодного вина. Цена кусается, а качество оставляет желать лучшего — завсегдатаи непременно скривятся от такого пойла.'
        *pl 'Зато бочки в трактире полны, и Легаре не держит вас за горло. По крайней мере, до следующей недели.'

    elseif $SupplyPressureTextChoice = 'reduce_sales':
        *pl 'Вы принимаете тяжёлое хозяйское решение: прикрутить краны и продавать вино и эль лишь избранным гостям, мелкими порциями.'
        *pl 'В зале сразу становится тише и мрачнее. Посетители недовольно бурчат, глядя на наполовину налитые кружки, кто-то со стуком ставит олово на стол и уходит в ночь.'
        *pl 'Трактир теряет выручку и шумное веселье, но скудные запасы в погребе растянутся ещё на несколько дней.'

    elseif $SupplyPressureTextChoice = 'do_nothing':
        *pl 'Вы решаете не пороть горячку и выждать, надеясь, что купец остынет.'
        *pl 'Однако чудо не происходит. К вечеру бочки с элями пустеют до самого дна, а новые так и не прибыли.'
        *pl 'Гости требуют выпивки, служанки растерянно разводят руками, а в кассе звенит лишь горстка жалких медяков. Проблема навалилась во весь рост.'

    else:
        *pl 'Вопрос с бочками остаётся подвешенным в воздухе, грозя обернуться сухим погребом.'
    end

    killvar '$SupplyPressureTextChoice'
---

#ClarissaTalkAboutSupplyRouteText
    *pl 'Кларисса оглядывает пустой архив ратуши и, убедившись, что за дверью никого нет, заговорщицки понижает голос:'
    *pl '— У Легаре далеко не все поставки идут через центральные склады гильдии, Стефан. Есть возчики с южного тракта, есть старые векселя и люди, которые обязаны лично мне, а не ему.'
    *pl 'Она на мгновение задерживает на вас серьёзный, испытующий взгляд:'
    *pl '— Я могу направить пару телег с отборным вином прямо к твоему чёрному входу, минуя лавку мужа. Но если Легаре хоть краем уха почует мой след — это будет уже не торговая распря. Он мне этого вовек не простит.'
---
