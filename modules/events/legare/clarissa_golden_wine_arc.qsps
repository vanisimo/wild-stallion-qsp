#ClarissaGoldenWineDreamTalkPlan
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'МЕЧТА КЛАРИССЫ: РЕДКИЕ КОМПОНЕНТЫ'
    SceneArtUseReal = 1
    gs 'SceneShowVisual', 'images/locations/clarissa/shop/stress', 'Кларисса загибает тонкие пальчики, перечисляя редкие ингредиенты', 'large', 'jpg'
