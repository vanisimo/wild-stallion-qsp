! ================================================
! FILE: modules/events/legare/clarissa_golden_wine_arc.qsps
! MODULE: events/legare
! [AI-WORKED] Текст переработан / дополнен ассистентом 27.10.2026
! Ветка «Золотое вино» Клариссы: мечта о купаже -> монастырский свиток -> горная лоза -> закладка террас и виноградника
! ================================================

#ClarissaGoldenWineCanOfferDream
    ClarissaGoldenWineCanOfferDream = 0

    if ClarissaGoldenWineStage <> 0:
        exit
    end

    ! Уже знает о мечте (для совместимости)
    if PlayerKnows_Dream_GoldenWine = 1:
        ClarissaGoldenWineCanOfferDream = 1
        exit
    end

    ! Проверка расположения и доверия Клариссы к Стефану
    if Friends['clarissa'] < 4 and love['clarissa'] < 2 and otkroven['clarissa'] < 6 and ClarissaTrustStefan < 2:
        exit
    end

    ! Проверка сюжетных триггеров:
    ! 1. Внимание / отношения Легаре к Аманде (или подозрения Клариссы)
    _storyTriggered = 0
    if LegareNoticedAmanda = 1 or AmandaLegareNoticeStage >= 1:
        _storyTriggered = 1
    elseif ClarissaSawLegareAmanda = 1 or ClarissaTalkAboutAmandaDone = 1 or ClarissaTalkAboutAmandaReady = 1:
        _storyTriggered = 1
    elseif AmandaLegareInterest >= 1 or LegareAmandaInterest >= 1:
        _storyTriggered = 1
    elseif FactHappened['amanda_dancewithlegare_1'] = 1 or AmandaDanceWithLegare = 1 or Fact_AmandaDanceWithLegare = 1:
        _storyTriggered = 1
    elseif Fact_AmandaLegareOutsideMeet = 1 or AmandaLegareOutsideMeetDone = 1 or Fact_AmandaLegarePrivateTalk = 1:
        _storyTriggered = 1
    elseif AmandaLegareStreetInterceptDone = 1 or AmandaLegareBackyardDone = 1 or Fact_AmandaLegareFridayAlley = 1:
        _storyTriggered = 1
    elseif ClarissaLegareSuspicion >= 1 or ClarissaLegareSuspicionTalkDone = 1 or ClarissaLegareSuspicionTalkReady = 1:
        _storyTriggered = 1
    elseif ClarissaAmandaLegareOutsideTalkDiscussed = 1 or ClarissaAmandaLegareMajorRiskDiscussed = 1 or ClarissaAmandaLegarePrivateTalkDiscussed = 1:
        _storyTriggered = 1
    end

    ! 2. Начало конфликта с Легаре (давление на трактир, цены, ссора)
    if LegareFirstConflictStage >= 1 or LegareFirstConflictResult > 0 or LegareConflictStage >= 1:
        _storyTriggered = 1
    elseif LegarePricesRaised = 1 or LegareWinePressure = 1 or AmandaLegareConflictWithLegareReady = 1:
        _storyTriggered = 1
    elseif ClarissaLegareConflictTalkDone = 1 or ClarissaLegareConflictTalkReady = 1:
        _storyTriggered = 1
    elseif LegareFirstConflictAfterTalkDone = 1 or LegareFirstConflictAfterTalkReady = 1:
        _storyTriggered = 1
    end

    if _storyTriggered = 1:
        ClarissaGoldenWineCanOfferDream = 1
    end

    killvar '_storyTriggered'
---

#ClarissaGoldenWineDreamTalk
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'МЕЧТА КЛАРИССЫ: ЗОЛОТОЕ ВИНО'
    SceneArtUseReal = 1
    gs 'SceneShowVisual', 'images/locations/clarissa/shop/normal', 'Кларисса отставляет хрустальный бокал и закрывает гроссбух', 'large', 'jpg'
    SceneArtUseReal = 0

    gs 'ClarissaGoldenWinePrintText', 'dream_talk_intro'
    *pl ' '

    gs 'ActUiPrepare', '«О выручке и новых клиентах?»', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ClarissaGoldenWineDreamTalkAlbert'
    end

    gs 'ActUiPrepare', '«О чём же? Поделись со мной»', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ClarissaGoldenWineDreamTalkAlbert'
    end

    gs 'ActUiPrepare', 'Пока повременить', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'WineShop', 'main'
    end
---

#ClarissaGoldenWineDreamTalkAlbert
    *clr
    clr
    cla

    gs 'ShowLocationScreenTitle', 'МЕЧТА КЛАРИССЫ: УСПЕХ АЛЬБЕРА'
    SceneArtUseReal = 1
    gs 'SceneShowVisual', 'images/locations/clarissa/shop/talk', 'Кларисса подходит ближе и тихо рассказывает об Альбере', 'large', 'jpg'
    SceneArtUseReal = 0

    gs 'ClarissaGoldenWinePrintText', 'dream_talk_albert'
    *pl ' '

    gs 'ActUiPrepare', '«Но тебе этого мало, верно?»', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ClarissaGoldenWineDreamTalkGoal'
    end

    gs 'ActUiPrepare', '«Альбер доволен покоем, а ты хочешь признания?»', 'talk'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ClarissaGoldenWineDreamTalkGoal'
    end
