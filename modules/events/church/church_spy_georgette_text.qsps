! ================================================
! FILE: modules/events/church/church_spy_georgette_text.qsps
! MODULE: events/church
! Тексты spy: Жоржетта + Герхард, сцены 1–7
! Характер: зрелая, пышная, опытная портовая куртизанка за 35;
! уверенная в себе, любящая плотские утехи, без стыда и ханжества.
! Отношения с Герхардом: давние любовники-сообщники, цинично и сладострастно
! играющие в «покаяние» и «освящение святым семенем Ильматера».
! ================================================

#ChurchSpyGeorgetteSceneText
    $ChurchSpyGeorgetteText = ''

    ! ====================== СЦЕНА 1: ПЕРВОЕ ПОДСЛУШИВАНИЕ ======================

    if ChurchSpyGeorgetteTextScene = 1 and ChurchSpyGeorgetteTextStep = 0:
        $ChurchSpyGeorgetteText = 'Ты осторожно поворачиваешь спрятанную шестерёнку в стене. С тихим щелчком потайная створка приоткрывается, открывая идеальный обзор на комнату чистых сердец.'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта стоит на коленях у низкой скамьи перед отцом Герхардом. Ни тени страха или смирения в её облике нет: пышное платье с вызывающе глубоким вырезом щедро выставляет напоказ зрелую, налитую грудь.'
        $ChurchSpyGeorgetteText += '<br><br>Отец Герхард кладёт тяжёлую ладонь на её круглое бедро и произносит с напускной пастырской строгостью:'
        $ChurchSpyGeorgetteText += '<br><br>— Дочь моя, дошли до меня вести, что предавалась ты блуду прямо в этом соборе во время службы. Но служителю Ильматера всё ведомо! Расскажи мне всё без утайки.'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта томно вскидывает сияющие карие глаза и широко улыбается со знанием дела:'
        $ChurchSpyGeorgetteText += '<br><br>— Ах, отец Герхард, перед вами разве грех скроешь? Грешила, святой отец, ох как грешила! Сами знаете — плоть у меня горячая, чуть зазеваешься, а она уже покаяния требует!'

    elseif ChurchSpyGeorgetteTextScene = 1 and ChurchSpyGeorgetteTextStep = 1:
        $ChurchSpyGeorgetteText = 'Отец Герхард скользит широкой ладонью выше по её тёплому, гладкому бедру:'
        $ChurchSpyGeorgetteText += '<br><br>— Покаяние смывает скверну, Жоржетта. Но всякое прегрешение надлежит изучить досконально. Покажи слуге святого круга, как именно ты грешила! Вот мужской уд — подобный тому, с коим ты впадала в соблазн. Покажи, как прикасалась к нему!'
        $ChurchSpyGeorgetteText += '<br><br>Священник решительно распахивает полы сутаны. Под ней обнаруживается внушительный, давно вздыбленный ствол жреца.'
        $ChurchSpyGeorgetteText += '<br><br>— Да вот так и ласкала, святой отец... — с лукавой усмешкой отзывается зрелая красавица.'
        $ChurchSpyGeorgetteText += '<br><br>Её уверенные, умелые пальцы по-хозяйски обхватывают пульсирующий член священника и начинают плавно разгонять кровь, нежно оглаживая налитую головку.'

    elseif ChurchSpyGeorgetteTextScene = 1 and ChurchSpyGeorgetteTextStep = 2:
        $ChurchSpyGeorgetteText = 'Дыхание отца Герхарда сбивается, но он старается выдерживать наставнический тон:'
        $ChurchSpyGeorgetteText += '<br><br>— А что следовало дальше, дочь моя? Небось и панталоны долой скинула?'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта заливается бархатным,  смехом и решительным жестом взметает подол платья к самому поясу:'
        $ChurchSpyGeorgetteText += '<br><br>— Да помилуйте, отец Герхард, какие ещё панталоны у меня? Только лишняя помеха в моем деле! Вы ведь лучше других знаете: у меня там всегда всё наголо выбрито, умащено да к утехам готово — хоть для матроса, хоть для пастыря!'
        $ChurchSpyGeorgetteText += '<br><br>Перед глазами священника предстаёт сочное зрелое лоно и пухлая, уже сочащаяся возбуждением промежность. Герхард шумно сглатывает слюну:'
        $ChurchSpyGeorgetteText += '<br><br>— Ильматер милосердный... истинное искушение во плоти! Ну... показывай дальше, как грешила!'

    elseif ChurchSpyGeorgetteTextScene = 1 and ChurchSpyGeorgetteTextStep = 3:
        $ChurchSpyGeorgetteText = 'Жоржетта уверенно поднимается с колен, ловко перекидывает ногу через сидящего священника и с сочным, влажным звуком опускается горячей промежностью прямо на его стояк.'
        $ChurchSpyGeorgetteText += '<br><br>— Вот так я и грешила, святой отец! — стонет она, насаживаясь до самого корня.'
        $ChurchSpyGeorgetteText += '<br><br>Герхард утробно рычит от блаженства, расстёгивает её блузку и жадно запускает обе руки в её тяжёлые, колышущиеся груди, сминая пышную зрелую плоть.'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта оглаживает его седую бороду и задаёт глубокий, напористый ритм, раскачивая бёдрами так, что дубовый стул под ними начинает протяжно скрипеть.'

    elseif ChurchSpyGeorgetteTextScene = 1 and ChurchSpyGeorgetteTextStep = 4:
        $ChurchSpyGeorgetteText = 'Бурный оргазм накрывает обоих. Жоржетта стонет во весь голос, запрокинув голову, а священник с яростным рыком накачивает её нутро обильными волнами горячего семени.'
        $ChurchSpyGeorgetteText += '<br><br>Отец Герхард даже не утруждает себя тем, чтобы прикрыть обмякший, лоснящийся член:'
        $ChurchSpyGeorgetteText += '<br><br>— Освятило тебя семя слуги Ильматера во храме Его... Сие омовение отпускает грехи твои, дочь моя. Ступай с миром, а коль плоть вновь запылает — приходи ко мне.'
        $ChurchSpyGeorgetteText += '<br><br>— И грехи смыты, и телу услада! — довольно посмеивается Жоржетта, грациозно спрыгивая с его колен и расправляя подол. — До следующего воскресенья, отец Герхард!'
        $ChurchSpyGeorgetteText += '<br><br>Ты осторожно прикрываешь створку. Вот тебе и благочестивая церковь Ильматера...'

    ! ====================== СЦЕНА 2: ПОВТОРНАЯ ИСПОВЕДЬ И МИНЕТ ======================

    elseif ChurchSpyGeorgetteTextScene = 2 and ChurchSpyGeorgetteTextStep = 0:
        $ChurchSpyGeorgetteText = 'Тихий щелчок механизма — и сквозь прорезь ты снова видишь отца Герхарда и Жоржетту.'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта вплывает в комнату чистых сердец вальяжной, раскованной походкой знающей себе цену женщины. Священник уже ждёт её в кресле, с хозяйской улыбкой поглаживая своё брюшко:'
        $ChurchSpyGeorgetteText += '<br><br>— Снова явилась каяться, ненасытная? Всю седмицу небось в порту срам творила?'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта опускается на подлокотник его кресла, по-свойски кладя руку ему на плечо:'
        $ChurchSpyGeorgetteText += '<br><br>— А как не творить, падре? Мужики в гавани грубые, голодные — каждому женскую ласку подай. Но к вам-то я за особым пастырским благословением шла!'

    elseif ChurchSpyGeorgetteTextScene = 2 and ChurchSpyGeorgetteTextStep = 1:
        $ChurchSpyGeorgetteText = 'Герхард довольно крякает и привычным жестом откидывает полу рясы:'
        $ChurchSpyGeorgetteText += '<br><br>— Показывай без лукавства, грешница. Вот уд, готовый принять твоё покаяние.'
        $ChurchSpyGeorgetteText += '<br><br>— С удовольствием, святой отец, — мурлычет Жоржетта.'
        $ChurchSpyGeorgetteText += '<br><br>Она берёт крепкий ствол обеими руками, умелыми, ласкающими движениями разгоняя кровь от корня к налитой головке.'

    elseif ChurchSpyGeorgetteTextScene = 2 and ChurchSpyGeorgetteTextStep = 2:
        $ChurchSpyGeorgetteText = 'Жоржетта плавно опускается на колени прямо перед ним:'
        $ChurchSpyGeorgetteText += '<br><br>— А когда руками мало — вход идёт ротик. Уж я-то знаю, как с почтенными мужами обходиться...'
        $ChurchSpyGeorgetteText += '<br><br>Она жадно охватывает головку горячими влажными губами и начинает со знанием дела ублажать священника. Ротик у портовой красавицы искусный: язык виртуозно оглаживает уздечку, слюна стекает по набрякшим венам прямо к мошонке.'
        $ChurchSpyGeorgetteText += '<br><br>— О-о-ох, Ильматер всеблагой... — стонет Герхард, вцепившись пальцами в подлокотники кресла. — Истинно блудный, золотой рот...'

    elseif ChurchSpyGeorgetteTextScene = 2 and ChurchSpyGeorgetteTextStep = 3:
        $ChurchSpyGeorgetteText = '— Хватит томить плоть, святой отец, пора делом заняться! — хрипловато шепчет Жоржетта.'
        $ChurchSpyGeorgetteText += '<br><br>Она поднимается с колен, взметает юбку и легко седлает священника. Сочная, готовая киска принимает его стояк с влажным причмокиванием. Женщина упирается ладонями в его плечи и задаёт мощный, сладострастный темп.'

    elseif ChurchSpyGeorgetteTextScene = 2 and ChurchSpyGeorgetteTextStep = 4:
        $ChurchSpyGeorgetteText = 'Герхард сминает её пышную зрелую грудь и подаётся тазом навстречу каждому удару. С громким рыком он заливает щедрую струю семени в самую глубину её ненасытного лона.'
        $ChurchSpyGeorgetteText += '<br><br>— Святое семя очистило душу твою от скверны, дочь моя... — тяжело дышит Герхард.'
        $ChurchSpyGeorgetteText += '<br><br>— И душе покой, и чреву услада! — смеётся Жоржетта, поправляя подол. — В следующий раз ещё жарче службу устроим!'

    ! ====================== СЦЕНА 3: ДИАЛОГ О ЛИЗЕТКЕ ======================

    elseif ChurchSpyGeorgetteTextScene = 3 and ChurchSpyGeorgetteTextStep = 0:
        $ChurchSpyGeorgetteText = 'Ты открываешь механизм. Жоржетта уже сидит на краю дубового стола, беззаботно покачивая аппетитным круглым бедром.'
        $ChurchSpyGeorgetteText += '<br><br>Отец Герхард строго оглядывает её с головы до ног:'
        $ChurchSpyGeorgetteText += '<br><br>— Дочь моя, опять с утра согрешила перед службой? Вижу по твоим масляным глазкам и свежему румянцу.'
        $ChurchSpyGeorgetteText += '<br><br>— Ох, падре, грешна! — смеётся Жоржетта, широко разводя колени. — Прямо с утра успела согрешить, солнце ещё не встало толком! Утро в порту пропускать — грех почище соборного!'

    elseif ChurchSpyGeorgetteTextScene = 3 and ChurchSpyGeorgetteTextStep = 1:
        $ChurchSpyGeorgetteText = 'Священник подходит ближе и привычно распахивает сутану, демонстрируя налитый жаром стержень:'
        $ChurchSpyGeorgetteText += '<br><br>— Показывай, чем тебя брали, и не увиливай от покаяния.'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта ловко перехватывает его член обеими руками:'
        $ChurchSpyGeorgetteText += '<br><br>— Ручками гладила, падре, вверх и вниз, вот так... А он у вас сегодня горячий, прямо как кочерга в кузнице! Только вы не ревнуйте, у вас инструмент всяко почтеннее!'

    elseif ChurchSpyGeorgetteTextScene = 3 and ChurchSpyGeorgetteTextStep = 2:
        $ChurchSpyGeorgetteText = 'Отец Герхард наклоняется, чтобы задрать её подол, и вдруг замирает. На внутренних сторонах её гладких бёдер и возле самого лобка влажно блестят свежие потёки чужого семени.'
        $ChurchSpyGeorgetteText += '<br><br>— Ух, бестия портовая! — в голосе священника сквозит не столько гнев, сколько жадное одобрение. — Уже успела нагуляться! Чужое семя на ножках!'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта лишь озорно облизывает губы:'
        $ChurchSpyGeorgetteText += '<br><br>— Так тем паче смывать надо, святой отец! Ну что, перебьёте чужое семя своим благословением? Или силёнок не хватит?'
        $ChurchSpyGeorgetteText += '<br><br>— Перебью, во имя Ильматера! — рычит Герхард. — Садись!'

    elseif ChurchSpyGeorgetteTextScene = 3 and ChurchSpyGeorgetteTextStep = 3:
        $ChurchSpyGeorgetteText = 'Жоржетта ловко перемахивает через него и с размаху садится лоном на его толстый ствол. Сочное чавканье плоти разносится по всей исповедальне.'
        $ChurchSpyGeorgetteText += '<br><br>Она яростно скачет на священнике, запрокинув голову, а тот расстёгивает её вырез и жадно мнёт её налитые сосцы, тяжело сопя ей в шею.'

    elseif ChurchSpyGeorgetteTextScene = 3 and ChurchSpyGeorgetteTextStep = 4:
        $ChurchSpyGeorgetteText = 'Они достигают бурного оргазма. Герхард содрогается, мощно вбиваясь снизу и заливая её утробу густым семенем поверх утренних следов.'
        $ChurchSpyGeorgetteText += '<br><br>Переводя дух на его коленях, Жоржетта лукаво щурится:'
        $ChurchSpyGeorgetteText += '<br><br>— А ведь дочурка моя, Лизетка, тоже к тебе на исповедь захаживает... Признавайся, святой отец: кто из нас горячее — мать или дочка?'
        $ChurchSpyGeorgetteText += '<br><br>Отец Герхард ни на миг не теряется и с елейным благочестием произносит:'
        $ChurchSpyGeorgetteText += '<br><br>— Обе вы прекрасны, дочь моя! Все важны Ильматеру, все Ему любы. А значит, и мне любы одинаково, как Его верному слуге.'
        $ChurchSpyGeorgetteText += '<br><br>— Ловко вывернулся, святоша! — заливается смехом Жоржетта. — Девчонка-то у меня шустрая, вся в мать пошла. Глядишь, скоро бабушкой меня сделает, хотя я сама ещё в самом соку, мужикам покоя не даю!'

    ! ====================== СЦЕНА 4: СЕМЯ В ЛОНО И ПОРТОВЫЕ ОТКРОВЕНИЯ ======================

    elseif ChurchSpyGeorgetteTextScene = 4 and ChurchSpyGeorgetteTextStep = 0:
        $ChurchSpyGeorgetteText = 'Потайное окно бесшумно распахивается. Отец Герхард нетерпелив, он сжимает плечи Жоржетты:'
        $ChurchSpyGeorgetteText += '<br><br>— Всякий грех плоти должен быть исповедан без утайки, дочь моя. Рассказывай, с кем делила постель на этой неделе.'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта сладко потягивается, выпячивая зрелую грудь:'
        $ChurchSpyGeorgetteText += '<br><br>— Со всеми подряд, падре! И матросы с юга были, и купцы гильдейские... Мужикам ведь всем одного надо. Только суетливые они больно, не то что вы — с толком, с расстановкой!'

    elseif ChurchSpyGeorgetteTextScene = 4 and ChurchSpyGeorgetteTextStep = 1:
        $ChurchSpyGeorgetteText = 'Она сама развязывает шнур на его сутане и вытягивает наружу горячий, налитый член:'
        $ChurchSpyGeorgetteText += '<br><br>— У вас, падре, инструмент самый почтенный. Благословенный, можно сказать!'
        $ChurchSpyGeorgetteText += '<br><br>Она сжимает ствол у основания и неторопливо водит ладонью, лаская уздечку.'

    elseif ChurchSpyGeorgetteTextScene = 4 and ChurchSpyGeorgetteTextStep = 2:
        $ChurchSpyGeorgetteText = 'Жоржетта опускается на колени и со знанием дела заглатывает головку целиком, принимая его глубоко в глотку.'
        $ChurchSpyGeorgetteText += '<br><br>— Ох-х-х... истинное смирение плоти... — хрипит Герхард, зарываясь пальцами в её золотистые волосы.'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта сосёт с влажным причмокиванием, затем опускается ниже и тщательно вылизывает мошонку.'

    elseif ChurchSpyGeorgetteTextScene = 4 and ChurchSpyGeorgetteTextStep = 3:
        $ChurchSpyGeorgetteText = 'Она поднимается с пола, взметает юбку и легко седлает священника на стуле.'
        $ChurchSpyGeorgetteText += '<br><br>— Внутрь давайте, святой отец... прямо в самое нутро! — стонет Жоржетта, раскачивая бёдрами. — В порту вечно норовят на живот спустить, чтоб брюхатой не осталась, а я от слуги Ильматера полного благословения хочу!'
        $ChurchSpyGeorgetteText += '<br><br>Герхард сжимает её упругие ягодицы и подбрасывает её на своём стояке с утробным рычанием.'

    elseif ChurchSpyGeorgetteTextScene = 4 and ChurchSpyGeorgetteTextStep = 4:
        $ChurchSpyGeorgetteText = 'Священник кончает мощными, глубокими толчками, щедро накачивая семя в глубину её лона. Жоржетта судорожно сжимает его член внутренними мышцами, содрогаясь в сладком припадке.'
        $ChurchSpyGeorgetteText += '<br><br>— Счёт закрыт, отец Герхард! — смеётся она, спрыгивая с колен и промокая бедро батистовым платком. — Оргазм и благословение получены в полном объёме!'

    ! ====================== СЦЕНА 5: ЗАПОВЕДЬ О ЧИСТОТЕ ПЛОТИ ======================

    elseif ChurchSpyGeorgetteTextScene = 5 and ChurchSpyGeorgetteTextStep = 0:
        $ChurchSpyGeorgetteText = 'Через щель видно, как Жоржетта с насмешливой улыбкой крутится перед отцом Герхардом:'
        $ChurchSpyGeorgetteText += '<br><br>— Слышала я вашу сегодняшнюю проповедь, падре. Про чистоту помыслов и омовение плоти по заповедям Ильматера!'
        $ChurchSpyGeorgetteText += '<br><br>— Истинно так, дочь моя, — важно кивает Герхард. — Чистота тела есть чистота духа перед святым кругом!'

    elseif ChurchSpyGeorgetteTextScene = 5 and ChurchSpyGeorgetteTextStep = 1:
        $ChurchSpyGeorgetteText = 'Жоржетта решительно лезет ему под рясу и извлекает на свет его торчащий болт:'
        $ChurchSpyGeorgetteText += '<br><br>— А сами-то вы, святой отец, соблюдаете заповедь? Мыли причинное место святой водицей с утра?'
        $ChurchSpyGeorgetteText += '<br><br>Герхард густо краснеет от возмущения и похоти:'
        $ChurchSpyGeorgetteText += '<br><br>— Ты смеешь сомневаться во мне?! Я чистейший из служителей Ильматера! Всё омыто по обряду!'

    elseif ChurchSpyGeorgetteTextScene = 5 and ChurchSpyGeorgetteTextStep = 2:
        $ChurchSpyGeorgetteText = '— А вот мы сейчас и проверим! — хихикает опытная блудница.'
        $ChurchSpyGeorgetteText += '<br><br>Она опускается на колени и начинает тщательно вылизывать его член от самого основания до алой головки. Затем спускается ниже, обсасывает каждое яичко и глубоко проходится кончиком языка по промежности.'
        $ChurchSpyGeorgetteText += '<br><br>— Ах-х-х... бестия портовая... что творишь... — стонет Герхард, закатывая глаза от невыносимого блаженства.'

    elseif ChurchSpyGeorgetteTextScene = 5 and ChurchSpyGeorgetteTextStep = 3:
        $ChurchSpyGeorgetteText = 'Не давая ему опомниться, Жоржетта прыгает к нему на колени и насаживает влажное лоно на его раскалённый стержень:'
        $ChurchSpyGeorgetteText += '<br><br>— Чист, падре, чист как слеза! Теперь моя очередь очищаться!'
        $ChurchSpyGeorgetteText += '<br><br>Она неистово скачет верхом, а священник жадно стискивает её груди, на которых ритмично подпрыгивают тугие соски.'

    elseif ChurchSpyGeorgetteTextScene = 5 and ChurchSpyGeorgetteTextStep = 4:
        $ChurchSpyGeorgetteText = 'Герхард не выдерживает долго — с диким рёвом он извергается в неё до последней капли.'
        $ChurchSpyGeorgetteText += '<br><br>— Завела меня своим бесстыжим языком... за минуту кончил, — со смущённым кряхтением произносит священник, осеняя себя святым кругом.'
        $ChurchSpyGeorgetteText += '<br><br>— Зато заповедь о чистоте плоти исполнили со всей строгостью! — весело подмигивает Жоржетта, оправляя платье.'

    ! ====================== СЦЕНА 6: ПОРТОВЫЕ ГРЕХИ И ШКИПЕРЫ ======================

    elseif ChurchSpyGeorgetteTextScene = 6 and ChurchSpyGeorgetteTextStep = 0:
        $ChurchSpyGeorgetteText = 'Ты приоткрываешь створку. В комнате пахнет ладаном и горячим женским теплом.'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта в красках расписывает священнику свои портовые похождения:'
        $ChurchSpyGeorgetteText += '<br><br>— ...а тут завалился шкипер с южного барка, да ещё двух боцманов с собой приволок! Пришлось всех троих уважить прямо на тюках с шерстью, иначе бы матросы весь трактир разнесли!'
        $ChurchSpyGeorgetteText += '<br><br>Герхард качает головой с показным ужасом:'
        $ChurchSpyGeorgetteText += '<br><br>— Трое сразу... Великий грех блуда, дочь моя! Церковь обязана смыть эту скверну немедленно!'

    elseif ChurchSpyGeorgetteTextScene = 6 and ChurchSpyGeorgetteTextStep = 1:
        $ChurchSpyGeorgetteText = '— Ну так смывайте, падре, кто ж вам не даёт? — смеётся Жоржетта.'
        $ChurchSpyGeorgetteText += '<br><br>Она привычно достаёт его готовый к бою член и начинает размеренно ласкать его тёплой ладонью:'
        $ChurchSpyGeorgetteText += '<br><br>— У того шкипера, кстати, инструмент был почти как у вас. Только ласки никакой — навалился как куль с мукой, и всё. А вы у нас мужчина деликатный, с церковным подходом!'

    elseif ChurchSpyGeorgetteTextScene = 6 and ChurchSpyGeorgetteTextStep = 2:
        $ChurchSpyGeorgetteText = 'Герхард сглатывает ком в горле, глядя на её чувственную улыбку:'
        $ChurchSpyGeorgetteText += '<br><br>— И они... тоже брали тебя без панталон?'
        $ChurchSpyGeorgetteText += '<br><br>— Да откуда у меня панталоны, святой отец! — покатывается со смеху Жоржетта, распахивая подол. — Портовая девка в штанах — это верный убыток! Вот она я, вся нараспашку, берите и благословляйте!'

    elseif ChurchSpyGeorgetteTextScene = 6 and ChurchSpyGeorgetteTextStep = 3:
        $ChurchSpyGeorgetteText = 'Герхард рывком притягивает её к себе. Жоржетта с визгом радости оседлывает его бёдра, и толстый жреческий кол с сочным звуком вонзается в её плоть.'
        $ChurchSpyGeorgetteText += '<br><br>Стул ходит ходуном. Жоржетта отчаянно скачет, впиваясь ногтями в плечи священника. Герхард яростно целует её шею, тяжело хрипя в мочку уха.'

    elseif ChurchSpyGeorgetteTextScene = 6 and ChurchSpyGeorgetteTextStep = 4:
        $ChurchSpyGeorgetteText = 'Мощный оргазм накрывает обоих. Герхард судорожно вдалбливает таз снизу, накачивая семя в её лоно, а Жоржетта стонет во весь голос, забыв обо всех приличиях.'
        $ChurchSpyGeorgetteText += '<br><br>— Смыта скверна южного барка во славу Ильматера! — торжественно хрипит священник.'
        $ChurchSpyGeorgetteText += '<br><br>— Ещё как смыта, падре! До следующего воскресенья! Берегите силушку для новой исповеди!'

    ! ====================== СЦЕНА 7: ВЫСШЕЕ БЛАГОСЛОВЕНИЕ ======================

    elseif ChurchSpyGeorgetteTextScene = 7 and ChurchSpyGeorgetteTextStep = 0:
        $ChurchSpyGeorgetteText = 'Ты поворачиваешь шестерёнку. За перегородкой оба любовника чувствуют себя совершенно свободно — все остатки показной строгости давно отброшены.'
        $ChurchSpyGeorgetteText += '<br><br>Жоржетта заходит в комнату чистых сердец с сияющим, хозяйским видом:'
        $ChurchSpyGeorgetteText += '<br><br>— Ну что, отец Герхард, готов отпустить грехи самой верной прихожанке?'
        $ChurchSpyGeorgetteText += '<br><br>Герхард расплывается в довольной улыбке, поглаживая брюхо:'
        $ChurchSpyGeorgetteText += '<br><br>— Иди ко мне, ненаглядная моя грешница. Врата покаяния всегда открыты!'

    elseif ChurchSpyGeorgetteTextScene = 7 and ChurchSpyGeorgetteTextStep = 1:
        $ChurchSpyGeorgetteText = 'Жоржетта тут же опускается между его ног, по-хозяйски распуская шнуровку на рясе:'
        $ChurchSpyGeorgetteText += '<br><br>— Соскучился по моей исповеди, ненасытный старый лис?'
        $ChurchSpyGeorgetteText += '<br><br>— Ильматер заповедал дарить утешение страждущим, — с елеем в голосе шепчет Герхард, поглаживая её по золотистым волосам.'

    elseif ChurchSpyGeorgetteTextScene = 7 and ChurchSpyGeorgetteTextStep = 2:
        $ChurchSpyGeorgetteText = 'Жоржетта обхватывает его ствол губами и с упоением делает священнику глубокий, влажный минет. Она заглатывает его до самого горла, оттягивает губами кожицу и нежно посасывает мошонку.'
        $ChurchSpyGeorgetteText += '<br><br>Герхард блаженно мычит, откинувшись на спинку стула и почти теряя рассудок от восторга.'

    elseif ChurchSpyGeorgetteTextScene = 7 and ChurchSpyGeorgetteTextStep = 3:
        $ChurchSpyGeorgetteText = '— Хватит баловать ротиком, падре! — шепчет Жоржетта с горящим взглядом. — Пора семя делом выпускать!'
        $ChurchSpyGeorgetteText += '<br><br>Она грациозно взбирается на него, направляя толстый стояк в своё насквозь промокшее нутро, и начинает яростную скачку. Груди её летают ходуном, губы шепчут сладкие бесстыдства, а священник подбрасывает её бёдрами снизу.'

    elseif ChurchSpyGeorgetteTextScene = 7 and ChurchSpyGeorgetteTextStep = 4:
        $ChurchSpyGeorgetteText = 'Оглушительный обоюдный оргазм сотрясает комнату чистых сердец. Герхард рычит, накачивая семя в её лоно, пока Жоржетта бьётся в сладких конвульсиях на его коленях.'
        $ChurchSpyGeorgetteText += '<br><br>Она со вздохом сползает с его члена, поправляет растрёпанные локоны и довольно улыбается:'
        $ChurchSpyGeorgetteText += '<br><br>— Ну вот! Душа легка, грехи смыты, нутро полно святого семени! До следующей недели, отец Герхард!'
        $ChurchSpyGeorgetteText += '<br><br>Священник, тяжело дыша и довольно улыбаясь, очерчивает в воздухе священный круг:'
        $ChurchSpyGeorgetteText += '<br><br>— Иди с миром, дочь моя... И помни: святой круг всегда примет твоё искреннее покаяние!'

    else:
        $ChurchSpyGeorgetteText = '[Текст spy Жоржетты не найден: сцена ' + STR(ChurchSpyGeorgetteTextScene) + ', шаг ' + STR(ChurchSpyGeorgetteTextStep) + ']'

    end
---
