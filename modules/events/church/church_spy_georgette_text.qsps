! ================================================
! FILE: modules/events/church/church_spy_georgette_text.qsps
! MODULE: events/church
! Тексты spy: Жоржетта + Герхард, сцены 1–7 (на основе traktr_old.txt)
! Голос: Жоржетта любит секс, не носит панталончики и не стыдится;
! Герхард требует демонстрации греха и «благословляет святым семенем».
! ================================================

#ChurchSpyGeorgetteSceneText
     = ''

    ! ====================== СЦЕНА 1: ПЕРВОЕ ПОДСЛУШИВАНИЕ (канон: SawChurchAfterCermon = 0) ======================

    if ChurchSpyGeorgetteTextScene = 1 and ChurchSpyGeorgetteTextStep = 0:
         = 'Ты осторожно поворачиваешь спрятанную шестерёнку в стене. С тихим, мягким щелчком потайная створка в деревянной панели приоткрывается, открывая идеальный обзор на комнату чистых сердец.'
         += '<br><br>Жоржетта стоит на коленях у низкой скамьи перед отцом Герхардом. В собор она оделась чуть скромнее обычного, но глубокий вырез блузки всё равно щедро приоткрывает её пышную грудь.'
         += '<br><br>Отец Герхард кладёт тяжёлую ладонь на обнажённое колено девушки и произносит с напускной строгостью:'
         += '<br><br>— Дочь моя, скрыла ты от меня, что совокуплялась прямо в этом храме во время службы. Но служителю Ильматера всё ведомо! Расскажи мне всё без утайки.'
         += '<br><br>Жоржетта чуть раздвигает бёдра и вскидывает на него сияющие карие глаза:'
         += '<br><br>— Ох, падре, постеснялась я перед святым алтарём в таком непотребстве признаться... Грешила я, грешила!'

    elseif ChurchSpyGeorgetteTextScene = 1 and ChurchSpyGeorgetteTextStep = 1:
         = 'Отец Герхард скользит широкой ладонью выше по её гладкому бедру:'
         += '<br><br>— Не печалься, дочь моя, могу я отпустить тебе этот грех, как и грех утайки. Но сначала расскажи и покажи подробно, как именно ты согрешила. Вот член, подобный тому, с коим ты грешила. Если трогала его рукой — покажи как!'
         += '<br><br>Священник решительным движением приподнимает подол сутаны. Под ней обнаруживается внушительный, уже налившийся и торчащий вверх член жреца.'
         += '<br><br>— Да, падре, трогала я член... вот так, — с лукавой усмешкой отзывается Жоржетта.'
         += '<br><br>Её ловкие, наманикюренные пальчики обхватывают пульсирующий ствол священника и начинают плавно, умело подрачивать его, поглаживая бархатную головку.'

    elseif ChurchSpyGeorgetteTextScene = 1 and ChurchSpyGeorgetteTextStep = 2:
         = 'Дыхание отца Герхарда сбивается, но он старается сохранять на лице суровое церковное выражение:'
         += '<br><br>— А что ты потом делала, дочь моя? Панталончики сняла, наверное?'
         += '<br><br>Жоржетта весело прыскает и высоко задирает подол красного платья прямо до талии:'
         += '<br><br>— Нет, падре, не ношу я панталончиков вовсе, вот, смотрите сами!'
         += '<br><br>Перед глазами священника предстаёт абсолютно голый, аккуратно выбритый лобок и пухлая, уже влажная от возбуждения киска. Герхард шумно сглатывает слюну:'
         += '<br><br>— Ильматер всемилостивый... Ни стыда, ни панталончиков! Ну... показывай дальше, как грешила!'

    elseif ChurchSpyGeorgetteTextScene = 1 and ChurchSpyGeorgetteTextStep = 3:
         = 'Жоржетта легко поднимается с колен, ловко перекидывает бедро через сидящего священника и опускается своей сочной влажной щёлкой прямо на его вздыбленный член.'
         += '<br><br>— Вот так я грешила, падре!'
         += '<br><br>Она с чувственным стоном насаживается до самого основания. Отец Герхард рычит от наслаждения, расстёгивает её блузку и жадно запускает обе руки в её тяжёлые, колышущиеся груди, сминая их пальцами.'
         += '<br><br>Жоржетта впивается в священника страстным поцелуем, не прекращая яростной скачки. Стул под ними протяжно скрипит в такт её упругим бёдрам.'

    elseif ChurchSpyGeorgetteTextScene = 1 and ChurchSpyGeorgetteTextStep = 4:
         = 'Парочка достигает оргазма почти одновременно. Жоржетта издаёт протяжный, хриплый стон, содрогаясь всем податливым телом, а священник с глухим мычанием заполняет её нутро горячим семенем.'
         += '<br><br>Отец Герхард даже не думает прикрывать обмякший, блестящий от соков член:'
         += '<br><br>— Заполнило тебя семя слуги Ильматера в храме его... Это отпускает все грехи твои и благословляет тебя, дочь моя. Теперь иди, а если ещё нагрешишь — приходи и покайся мне.'
         += '<br><br>— Спасибо, отец Герхард! — довольно смеётся Жоржетта, спрыгивая с его колен и приводя подол в порядок.'
         += '<br><br>Ты осторожно прикрываешь створку потайного механизма. Вот тебе и благочестивая церковь Ильматера...'

    ! ====================== СЦЕНА 2: ПОВТОРНАЯ ИСПОВЕДЬ И МИНЕТ (канон: SawChurchAfterCermon > 0) ======================

    elseif ChurchSpyGeorgetteTextScene = 2 and ChurchSpyGeorgetteTextStep = 0:
         = 'Щелчок потайного механизма — и сквозь щель ты снова видишь отца Герхарда и Жоржетту.'
         += '<br><br>Жоржетта впорхнула в комнату чистых сердец с широкой улыбкой. Священник уже ждёт её в своём кресле, по-хозяйски положив ладонь на её колено:'
         += '<br><br>— Дочь моя, ты опять грешила на этой неделе. Расскажи мне всё без утайки. А не можешь рассказать — продемонстрируй!'
         += '<br><br>Жоржетта кокетливо раздвигает ножки, приподнимая подол платья выше бёдер:'
         += '<br><br>— Ох, падре, грешила я, сходилась со многими... Мужики в порту ненасытные, да и в соборе у вас воздух больно благодатный!'

    elseif ChurchSpyGeorgetteTextScene = 2 and ChurchSpyGeorgetteTextStep = 1:
         = 'Герхард одобрительно крякает и привычным движением вскидывает край сутаны:'
         += '<br><br>— Не печалься, дочь моя, а показывай подробно. Вот член, подобный тем, с коими ты грешила. Покажи служителю святого круга, что ты с ним делала.'
         += '<br><br>— Падре, трогала я член, вот так, — мурлычет Жоржетта.'
         += '<br><br>Она берёт крепкий стояк в ладонь, быстро разгоняя кровь скользящими движениями.'

    elseif ChurchSpyGeorgetteTextScene = 2 and ChurchSpyGeorgetteTextStep = 2:
         = 'Жоржетта опускается на оба колена между его разведённых ног и лукаво подмигивает:'
         += '<br><br>— А ещё я в рот их брала, вот так!'
         += '<br><br>Она обхватывает головку горячими губами и начинает умело, смачно сосать. Ротик у портовой красавицы искусный: язык оглаживает уздечку, слюна стекает по вздутым венам прямо к мошонке.'
         += '<br><br>— О-о-ох, Ильматер... — стонет Герхард, вцепившись пальцами в подлокотники кресла. — Истинно блудный рот...'

    elseif ChurchSpyGeorgetteTextScene = 2 and ChurchSpyGeorgetteTextStep = 3:
         = '— Ну а дальше, негодница? — хрипит священник, не в силах больше терпеть. — Опять без панталончиков?'
         += '<br><br>— Конечно, падре! Вот, смотрите, всё для вас готово, — посмеивается Жоржетта.'
         += '<br><br>Она поднимается, перекидывает ногу через его бёдра и плавно садится на стоящий кол. Мокрая киска принимает священника с влажным чавканьем. Жоржетта упирается руками в его плечи и начинает неистово наяривать вверх и вниз.'

    elseif ChurchSpyGeorgetteTextScene = 2 and ChurchSpyGeorgetteTextStep = 4:
         = 'Герхард сминает её пышную грудь, вывалившуюся из выреза, и вбивается тазом снизу навстречу каждому её движению. С громким рыком он изливает щедрую струю семени глубоко в её разгорячённое лоно.'
         += '<br><br>— Святое семя служителя очистило твою душу, дочь моя, — переводит дух Герхард.'
         += '<br><br>— Оргазм и благословение — не спинтарии, конечно, но тоже дело хорошее! — весело подмигивает Жоржетта, поправляя юбку.'

    ! ====================== СЦЕНА 3: ДИАЛОГ О ЛИЗЕТКЕ (канон: GeorgettVar['TalkChurchAfterCermonLiza']) ======================

    elseif ChurchSpyGeorgetteTextScene = 3 and ChurchSpyGeorgetteTextStep = 0:
         = 'Ты открываешь механизм. Жоржетта уже сидит прямо на краю дубового стола, беззаботно болтая стройными ножками.'
         += '<br><br>Отец Герхард строго оглядывает её с головы до ног:'
         += '<br><br>— Дочь моя, опять согрешила перед службой? Вижу по твоим масляным глазкам и румянцу.'
         += '<br><br>— Ох, падре, грешна! — смеётся Жоржетта, широко разводя колени. — Прямо с утра успела согрешить, солнце ещё не встало толком!'

    elseif ChurchSpyGeorgetteTextScene = 3 and ChurchSpyGeorgetteTextStep = 1:
         = 'Священник подходит ближе и привычно распахивает сутану, демонстрируя налитый жаром член:'
         += '<br><br>— Показывай, как грешила, и не увиливай от покаяния.'
         += '<br><br>Жоржетта ловко перехватывает его член обеими руками:'
         += '<br><br>— Ручками гладила, падре, вверх и вниз, вот так... А он у вас сегодня горячий, прямо как раскалённая кочерга у кузнеца!'
         += '<br><br>Герхард шумно выдыхает сквозь зубы, подаваясь тазом навстречу её рукам.'

    elseif ChurchSpyGeorgetteTextScene = 3 and ChurchSpyGeorgetteTextStep = 2:
         = 'Отец Герхард наклоняется, чтобы задрать её подол, и вдруг замирает. На внутренних сторонах её белых бёдер и возле самого лобка блестят свежие, не высохшие потёки чужой спермы.'
         += '<br><br>— Ух, негодница! — в голосе священника сквозит не столько гнев, сколько жадное мужское одобрение. — Уже потрахалась с утра пораньше! Чужое семя на ножках!'
         += '<br><br>Жоржетта лишь озорно облизывает губы:'
         += '<br><br>— А чего время терять, святой отец? Утро в порту добрым не бывает без хорошей палки! Ну что, перебьёте чужое семя своим святым благословением?'
         += '<br><br>— Перебью, во имя Ильматера! — рычит Герхард. — Садись!'

    elseif ChurchSpyGeorgetteTextScene = 3 and ChurchSpyGeorgetteTextStep = 3:
         = 'Жоржетта перемахивает через него и с размаху садится киской на его толстый ствол. Мокрое чавканье разносится по всей комнате.'
         += '<br><br>Она скачет на члене священника, запрокинув голову, а тот расстёгивает её блузку и яростно мнёт её налитые сосцы. Жоржетта притягивает его за седую бороду и впивается в губы священника долгим, бесстыдным поцелуем.'

    elseif ChurchSpyGeorgetteTextScene = 3 and ChurchSpyGeorgetteTextStep = 4:
         = 'Вскоре они достигают бурного оргазма. Герхард содрогается, мощно вбиваясь снизу и заливая её утробу густым семенем поверх утренних следов.'
         += '<br><br>Переводя дыхание на его коленях, Жоржетта лукаво щурится:'
         += '<br><br>— А ты ведь и доченьку мою, Лизетку, потрахиваешь... Признавайся, святой отец: и кто из нас лучше?'
         += '<br><br>Отец Герхард ни на секунду не теряется и с елейным благочестием произносит:'
         += '<br><br>— Обе вы прекрасны, дочь моя! Все важны Ильматеру, все ему любы. А значит, и мне любы одинаково, как его верному слуге.'
         += '<br><br>— Ловко вывернулся, святоша! — заливается смехом Жоржетта. — Доча-то моя шустрая, глядишь, такими темпами меня бабушкой скоро сделает, а мне ведь и тридцати ещё не скоро стукнет!'

    ! ====================== СЦЕНА 4: СЕМЯ В МАТОЧКУ И МИНЕТ ДО УПОРА ======================

    elseif ChurchSpyGeorgetteTextScene = 4 and ChurchSpyGeorgetteTextStep = 0:
         = 'Потайное окно бесшумно распахивается. Отец Герхард сегодня нетерпелив, он сжимает плечи Жоржетты:'
         += '<br><br>— Всякий грех плоти должен быть исповедан до капли, дочь моя. Рассказывай, с кем делила ложе на этой неделе.'
         += '<br><br>Жоржетта весело потягивается:'
         += '<br><br>— Со всеми подряд, падре! И матросы были, и купцы заезжие... Члены у всех разные, а хотят одного и того же!'

    elseif ChurchSpyGeorgetteTextScene = 4 and ChurchSpyGeorgetteTextStep = 1:
         = 'Она сама развязывает шнур на его рясе и вытягивает наружу горячий, налитый член:'
         += '<br><br>— Но у вас, падре, инструмент самый почтенный. Благословенный, можно сказать!'
         += '<br><br>Она сжимает ствол у основания и неторопливо водит ладонью, дразня пальцем чувствительную уздечку.'

    elseif ChurchSpyGeorgetteTextScene = 4 and ChurchSpyGeorgetteTextStep = 2:
         = 'Жоржетта опускается на колени и заглатывает головку целиком. Она берёт его глубоко в глотку, носом упираясь в курчавые волосы на его лобке.'
         += '<br><br>— Ох-х-х... истинное смирение плоти... — хрипит Герхард, зарываясь пальцами в её золотистые кудри.'
         += '<br><br>Жоржетта сосёт с влажным хлюпаньем, затем опускается ниже и тщательно, с упоением вылизывает его яйца.'

    elseif ChurchSpyGeorgetteTextScene = 4 and ChurchSpyGeorgetteTextStep = 3:
         = 'Она поднимается с пола, закидывает юбку и легко седлает священника на стуле.'
         += '<br><br>— Внутрь, падре... прямо в маточку брызгай! — стонет Жоржетта, бешено раскачивая бёдрами. — Мужики в порту вечно норовят на живот спустить, а я хочу полное благословение!'
         += '<br><br>Герхард сжимает её упругие ягодицы и подбрасывает её на своём стояке с утробным рычанием.'

    elseif ChurchSpyGeorgetteTextScene = 4 and ChurchSpyGeorgetteTextStep = 4:
         = 'Священник кончает мощными, обжигающими толчками, накачивая семя в самую глубину её матки. Жоржетта судорожно сжимает его член внутренними мышцами, содрогаясь в сладком припадке.'
         += '<br><br>— Счёт закрыт, отец Герхард! — смеётся она, спрыгивая с колен и вытирая испачканную ляжку подолом. — Оргазм и благословение получены в полном объёме!'

    ! ====================== СЦЕНА 5: ЗАПОВЕДЬ О ЧИСТОТЕ ПЛОТИ ======================

    elseif ChurchSpyGeorgetteTextScene = 5 and ChurchSpyGeorgetteTextStep = 0:
         = 'Через щель ты видишь, как Жоржетта с насмешливой улыбкой крутится перед отцом Герхардом.'
         += '<br><br>— Слышала я вашу сегодняшнюю проповедь, падре. Про чистоту помыслов и омовение плоти по заповедям Ильматера!'
         += '<br><br>— Истинно так, дочь моя, — важно кивает Герхард. — Чистота тела есть чистота духа перед святым кругом!'

    elseif ChurchSpyGeorgetteTextScene = 5 and ChurchSpyGeorgetteTextStep = 1:
         = 'Жоржетта решительно лезет ему под рясу и извлекает на свет его торчащий болт:'
         += '<br><br>— А сами-то вы, святой отец, соблюдаете заповедь? Мыли причинное место святой водицей с утра?'
         += '<br><br>Герхард густо краснеет от возмущения и похоти:'
         += '<br><br>— Ты смеешь сомневаться во мне?! Я чистейший из служителей Ильматера! Всё омыто по обряду!'

    elseif ChurchSpyGeorgetteTextScene = 5 and ChurchSpyGeorgetteTextStep = 2:
         = '— А вот мы сейчас и проверим! — хихикает Жоржетта.'
         += '<br><br>Она опускается на колени и начинает тщательно вылизывать его член от самого основания до алой головки. Затем спускается ниже, обсасывает каждое яичко и глубоко проходится кончиком языка по самой промежности.'
         += '<br><br>— Ах-х-х... шлюха портовая... что творишь... — стонет Герхард, закатывая глаза от невыносимого блаженства.'

    elseif ChurchSpyGeorgetteTextScene = 5 and ChurchSpyGeorgetteTextStep = 3:
         = 'Не давая ему опомниться, Жоржетта с размаху прыгает к нему на колени и насаживает свою беззащитную киску на его раскалённый стержень:'
         += '<br><br>— Чист, падре, чист как слеза! Теперь моя очередь очищаться!'
         += '<br><br>Она неистово скачет верхом, а священник жадно стискивает её груди, на которых ритмично подпрыгивают тугие соски.'

    elseif ChurchSpyGeorgetteTextScene = 5 and ChurchSpyGeorgetteTextStep = 4:
         = 'Герхард не выдерживает и двух минут — с диким рёвом он извергается в неё до последней капли.'
         += '<br><br>— Завела меня своим бесстыжим языком... за минуту кончил, — со смущённым кряхтением произносит священник, осеняя себя святым кругом.'
         += '<br><br>— Зато заповедь о чистоте исполнили! — весело подмигивает Жоржетта, оправляя платье.'

    ! ====================== СЦЕНА 6: ПОРТОВЫЕ ГРЕХИ И ШКИПЕРЫ ======================

    elseif ChurchSpyGeorgetteTextScene = 6 and ChurchSpyGeorgetteTextStep = 0:
         = 'Ты приоткрываешь створку. В комнате пахнет ладаном и недавней страстью.'
         += '<br><br>Жоржетта в красках расписывает священнику свои портовые дела:'
         += '<br><br>— ...а тут завалился шкипер с южного барка, да ещё двух боцманов с собой приволок! Пришлось всех троих уважить прямо на тюках с шерстью, иначе бы матросы весь трактир разнесли!'
         += '<br><br>Герхард качает головой с показным ужасом:'
         += '<br><br>— Трое сразу... Великий грех блуда, дочь моя! Церковь обязана смыть эту скверну немедленно!'

    elseif ChurchSpyGeorgetteTextScene = 6 and ChurchSpyGeorgetteTextStep = 1:
         = '— Ну так смывайте, падре, кто ж вам не даёт? — смеётся Жоржетта.'
         += '<br><br>Она привычно достаёт его готовый к бою член и начинает размеренно ласкать его тёплой ладонью:'
         += '<br><br>— У того шкипера, кстати, инструмент был почти как у вас. Только ласки никакой — навалился как куль с мукой, и всё. А вы у нас мужчина деликатный, с церковным подходом!'

    elseif ChurchSpyGeorgetteTextScene = 6 and ChurchSpyGeorgetteTextStep = 2:
         = 'Герхард сглатывает ком в горле, глядя на её задорную улыбку:'
         += '<br><br>— И они... тоже брали тебя без панталончиков?'
         += '<br><br>— Да откуда у меня панталончики, святой отец! — покатывается со смеху Жоржетта, распахивая подол. — Портовая девка в штанах — это верный убыток! Вот она я, вся нараспашку, берите и благословляйте!'

    elseif ChurchSpyGeorgetteTextScene = 6 and ChurchSpyGeorgetteTextStep = 3:
         = 'Герхард рывком притягивает её к себе. Жоржетта с визгом радости оседлывает его бёдра, и толстый жреческий кол с хлюпом вонзается в её плоть.'
         += '<br><br>Стул ходит ходуном. Жоржетта отчаянно скачет, впиваясь ногтями в плечи священника. Герхард яростно целует её шею, оставляя влажные следы и тяжело хрипя в мочку уха.'

    elseif ChurchSpyGeorgetteTextScene = 6 and ChurchSpyGeorgetteTextStep = 4:
         = 'Мощный оргазм накрывает обоих с головой. Герхард судорожно вдалбливает таз снизу, накачивая семя в её лоно, а Жоржетта стонет во весь голос, забыв обо всех приличиях.'
         += '<br><br>— Смыта скверна южного барка во славу Ильматера! — торжественно хрипит священник.'
         += '<br><br>— Ещё как смыта, падре! До следующего воскресенья! Берегите силушку для новой исповеди!'

    ! ====================== СЦЕНА 7: ВЫСШЕЕ БЛАГОСЛОВЕНИЕ (ФИНАЛ ЦЕПОЧКИ) ======================

    elseif ChurchSpyGeorgetteTextScene = 7 and ChurchSpyGeorgetteTextStep = 0:
         = 'Ты поворачиваешь шестерёнку. За деревянной перегородкой оба любовника чувствуют себя совершенно свободно — все остатки показной строгости давно отброшены.'
         += '<br><br>Жоржетта вваливается в комнату чистых сердец с сияющим видом:'
         += '<br><br>— Ну что, отец Герхард, готов отпустить грехи самой верной прихожанке?'
         += '<br><br>Герхард расплывается в довольной улыбке, поглаживая брюшко:'
         += '<br><br>— Иди ко мне, грешница моя ненаглядная. Врата покаяния всегда открыты!'

    elseif ChurchSpyGeorgetteTextScene = 7 and ChurchSpyGeorgetteTextStep = 1:
         = 'Жоржетта тут же опускается между его ног, по-хозяйски распуская шнуровку на рясе:'
         += '<br><br>— Соскучился по моей исповеди, ненасытный вы наш?'
         += '<br><br>— Ильматер заповедал дарить утешение страждущим, — с елеем в голосе шепчет Герхард, поглаживая её по светлым волосам.'

    elseif ChurchSpyGeorgetteTextScene = 7 and ChurchSpyGeorgetteTextStep = 2:
         = 'Жоржетта обхватывает его ствол губами и щедро, с упоением делает священнику глубокий, влажный минет. Она заглатывает его до самых гланд, оттягивает губами кожицу и нежно посасывает мошонку.'
         += '<br><br>Герхард блаженно мычит, откинувшись на спинку стула и почти теряя сознание от восторга.'

    elseif ChurchSpyGeorgetteTextScene = 7 and ChurchSpyGeorgetteTextStep = 3:
         = '— Хватит баловать ротиком, падре! — шепчет Жоржетта с горящим взглядом. — Пора семя делом выпускать!'
         += '<br><br>Она грациозно взбирается на него, заправляя толстый стояк в свою насквозь промокшую щёлочку, и начинает яростную скачку. Груди её летают ходуном, губы шепчут сладкие бесстыдства, а священник подбрасывает её бёдрами с удвоенной силой.'

    elseif ChurchSpyGeorgetteTextScene = 7 and ChurchSpyGeorgetteTextStep = 4:
         = 'Оглушительный, одновременный оргазм сотрясает комнату чистых сердец. Герхард рычит как дикий зверь, накачивая семя в её пульсирующую матку, пока Жоржетта бьётся в конвульсиях экстаза на его коленях.'
         += '<br><br>Она со вздохом сползает с его члена, поправляет растрёпанные волосы и широко улыбается:'
         += '<br><br>— Ну вот! Душа чиста, грехи смыты, животик полон святого семени! До следующей недели, отец Герхард!'
         += '<br><br>Священник, тяжело дыша и довольно улыбаясь, очерчивает в воздухе священный круг:'
         += '<br><br>— Иди с миром, дочь моя... И помни: святой круг всегда примет твоё искреннее покаяние!'

    else:
         = '[Текст spy Жоржетты не найден: сцена ' + STR(ChurchSpyGeorgetteTextScene) + ', шаг ' + STR(ChurchSpyGeorgetteTextStep) + ']'

    end
---
