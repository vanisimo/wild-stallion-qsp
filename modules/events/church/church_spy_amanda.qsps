    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/church/church_spy_amanda/amanda_confession_stage2', 'ПРОВЕРКА ЧИСТОТЫ АМАНДЫ', 'large', 'webp'
    gs 'EnsureGirlData', 'amanda'

    ChurchSpyAmandaDoneDay = day
    ChurchSpyListenDoneDay = day
    ChurchSpyAmandaSeenCount += 1
    GerhardAmandaLastStageDay = day

    *pl '══════════════════════════════════════════════'
    *pl ' ИСПОВЕДЬ АМАНДЫ: ПРОВЕРКА ЧИСТОТЫ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'ChurchSpyAmandaText', 'intro_stage2'
    *pl $AmandaConfessText
    killvar '$AmandaConfessText'

    *pl ' '

    ! Признание в реальном опыте
    if HadVaginalWithPlayer['amanda'] >= 1 or AmandaHomeSex = 1 or AmandaHomeStage >= 2:
        gs 'ChurchSpyAmandaText', 'confess_stage2_stefan'
    elseif AmandaLegareFirstSexDone = 1 or Fact_AmandaLegareFridayAlley = 1 or AmandaLegareAnalDone = 1 or AmandaLegareInterest >= 2:
        gs 'ChurchSpyAmandaText', 'confess_stage2_legare'
    elseif AmandaNeighborBoysStage >= 1 or AmandaNeighborBoysAnalDone = 1 or AmandaEscapeWorkCount >= 1:
        gs 'ChurchSpyAmandaText', 'confess_stage2_boys'
    else:
        gs 'ChurchSpyAmandaText', 'confess_stage2_general'
    end
    *pl $AmandaConfessText
    killvar '$AmandaConfessText'

    *pl ' '

    ! Тактильный осмотр священника
    gs 'ChurchSpyAmandaText', 'gerhard_touch_stage2'
    *pl $AmandaConfessText
    killvar '$AmandaConfessText'

    *pl ' '

    gs 'ActUiPrepare', 'Далее', 'next'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchSpyAmandaStage2Screen2'
    end
---

#ChurchSpyAmandaStage2Screen2
