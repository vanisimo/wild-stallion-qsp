! ========================================================
! ОБЪЕДИНЁННЫЙ ПОВТОРЯЕМЫЙ ЦИКЛ ПОСЛЕ ЛЕСТНИЦЫ (4 ЭКРАНА)
! ========================================================

#ChurchSpyAmandaRepeatLoop
    AmandaLoopStep = $ARGS[0]
    if AmandaLoopStep <= 0:
        AmandaLoopStep = 1
    end

    *clr
    clr
    cla

    if AmandaLoopStep = 1:
        gs 'SceneShowVisual', 'images/events/church/church_spy_amanda/amanda_loop_phase1', 'ТАЙНЫЕ ВСТРЕЧИ: СМИРЕНИЕ', 'large', 'webp'

        ChurchSpyAmandaDoneDay = day
        ChurchSpyListenDoneDay = day
        ChurchSpyAmandaSeenCount += 1
        GerhardAmandaNtrRepeatCount += 1

        *pl '══════════════════════════════════════════════'
        *pl ' ИСПОВЕДЬ АМАНДЫ: ТАЙНЫЕ ВСТРЕЧИ В СОБОРЕ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        gs 'ChurchSpyAmandaText', 'loop_screen1'
        *pl $AmandaConfessText
        killvar '$AmandaConfessText'

        *pl ' '

        gs 'ActUiPrepare', 'Далее (Близость на скамье)', 'next'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchSpyAmandaRepeatLoop', 2
        end

    elseif AmandaLoopStep = 2:
        gs 'SceneShowVisual', 'images/events/church/church_spy_amanda/amanda_loop_phase2', 'ТАЙНЫЕ ВСТРЕЧИ: БЛИЗОСТЬ', 'large', 'webp'

        *pl '══════════════════════════════════════════════'
        *pl ' ИСПОВЕДЬ АМАНДЫ: ТАЙНЫЕ ВСТРЕЧИ В СОБОРЕ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        gs 'ChurchSpyAmandaText', 'loop_screen2'
        *pl $AmandaConfessText
        killvar '$AmandaConfessText'

        *pl ' '

        gs 'ActUiPrepare', 'Далее (Очищение)', 'next'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchSpyAmandaRepeatLoop', 3
        end

    elseif AmandaLoopStep = 3:
        gs 'SceneShowVisual', 'images/events/church/church_spy_amanda/amanda_loop_phase3', 'ТАЙНЫЕ ВСТРЕЧИ: ОЧИЩЕНИЕ', 'large', 'webp'

        *pl '══════════════════════════════════════════════'
        *pl ' ИСПОВЕДЬ АМАНДЫ: ТАЙНЫЕ ВСТРЕЧИ В СОБОРЕ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        gs 'ChurchSpyAmandaText', 'loop_screen3'
        *pl $AmandaConfessText
        killvar '$AmandaConfessText'

        *pl ' '

        gs 'ActUiPrepare', 'Далее (Завершение)', 'next'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchSpyAmandaRepeatLoop', 4
        end

    else:
        gs 'SceneShowVisual', 'images/events/church/church_spy_amanda/amanda_loop_outro', 'ТАЙНЫЕ ВСТРЕЧИ: ФИНАЛ', 'large', 'webp'

        *pl '══════════════════════════════════════════════'
        *pl ' ИСПОВЕДЬ АМАНДЫ: ТАЙНЫЕ ВСТРЕЧИ В СОБОРЕ'
        *pl '══════════════════════════════════════════════'
        *pl ' '

        gs 'ChurchSpyAmandaText', 'loop_screen4'
        *pl $AmandaConfessText
        killvar '$AmandaConfessText'

        *pl ' '

        gs 'ActUiPrepare', 'Отойти от окна в собор', 'return'
        act $ActUiLabel, $ActUiIconPath:
            killvar 'AmandaLoopStep'
            gt 'ChurchSundayNoon'
        end
    end
---

#ChurchSpyAmandaBlockedSafe
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/events/church/church_spy_amanda/amanda_confession_safe', 'БЕЗОПАСНАЯ ИСПОВЕДЬ АМАНДЫ', 'large', 'webp'

    ChurchSpyAmandaDoneDay = day
    ChurchSpyListenDoneDay = day
    ChurchSpyAmandaSeenCount += 1

    *pl '══════════════════════════════════════════════'
    *pl ' ИСПОВЕДЬ АМАНДЫ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'ChurchSpyAmandaText', 'confess_blocked_safe'
    *pl $AmandaConfessText
    killvar '$AmandaConfessText'

    *pl ' '

    gs 'ActUiPrepare', 'Отойти от окна в собор', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchSundayNoon'
    end
---

#ChurchGerhardAmandaConfront
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/locations/church/gerhard_confront', 'РАЗГОВОР С ОТЦОМ ГЕРХАРДОМ', 'large', 'webp'

    *pl '══════════════════════════════════════════════'
    *pl ' РАЗГОВОР С ОТЦОМ ГЕРХАРДОМ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if GerhardAmandaStage = 2:
        ! Безусловный успех шантажа (окно возможностей открыто)
        gs 'ChurchSpyAmandaText', 'confront_success'
        *pl $AmandaConfessText
        killvar '$AmandaConfessText'

        *pl ' '
        *pl '<span style="color:#66CC66"><b>Вы надёжно защитили сестру от посягательств священника. Отец Герхард больше не посмеет переходить границы.</b></span>'

        GerhardAmandaBlocked = 1
        GerhardAmandaWarningAvailable = 0
        tavern_reputation += 1
        AmandaTrustStefan += 2
        gs 'ClampGirlSocialStats', 'amanda'
    else:
        ! Запоздалая попытка шантажа (после 3 этапа)
        gs 'ChurchSpyAmandaText', 'confront_cynical_refusal'
        *pl $AmandaConfessText
        killvar '$AmandaConfessText'

        *pl ' '
        *pl '<span style="color:#CC6666"><b>Священник цинично парировал ваши претензии. Момент для шантажа был упущен.</b></span>'

        GerhardAmandaWarningAvailable = 0
        GerhardAmandaLateBlackmailFailed = 1
    end

    *pl ' '

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        if week = 7 and time = 2:
            gt 'ChurchSundayNoon'
        else:
            gt 'ChurchWeekday'
        end
    end
---
