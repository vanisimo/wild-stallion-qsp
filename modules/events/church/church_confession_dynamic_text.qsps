! ================================================
! FILE: modules/events/church/church_confession_dynamic_text.qsps
! MODULE: events/church
! [AI-WORKED] 2026-09-08: canon prose overhaul
! Тексты исповеди ГГ
! ================================================

#ChurchConfessionDynamicText
    $ChurchConfessionTextId = LCASE($ARGS[0])
    $ChurchConfessionText = ''

    if $ChurchConfessionTextId = 'georgette_liza_saw':
        $ChurchConfessionText = 'Вы рассказываете отцу Герхарду, что во время уединения с Жоржеттой в комнате чистых сердец вы заметили в дверях подглядывающую Лизетту — и сами подозвали её ближе, позволив девушке наблюдать за вашими утехами через приоткрытую дверь. Отец Герхард выслушивает признание с явным удовольствием, степенно кивая и с благочестивым видом оглаживая холёную бороду:'
        $ChurchConfessionText += '<br><br>— Великий бог Ильматер завещал родителям передавать все свои знания и умения детям, — наставительно произносит священник. — Так что отдельного греха в том нет, разве что, как я уже говорил тебе, в храме нужно смиренно слушать службу. Но тот грех я тебе уже отпустил, так что иди с миром! Пусть юная дева перенимает науку от матери.'

    elseif $ChurchConfessionTextId = 'georgette_in_church':
        $ChurchConfessionText = 'Вы признаётесь, что во время утренней службы уединились с Жоржеттой прямо здесь — в комнате чистых сердец. Заперли дубовую дверь на засов и предавались плотским утехам на этой самой скамье, пока под сводами храма разносились молитвы. Отец Герхард слушает без малейшего гнева — скорее с лукавой, понимающей усмешкой:'
        $ChurchConfessionText += '<br><br>— Великий бог Ильматер завещал нам плодиться и размножаться, — неторопливо произносит священник, очерчивая в воздухе святой круг. — Конечно, нужно это делать вне храма, а в храме смиренно слушать службу. А ты, сын мой, не утерпел. Грех это, но не великий. Коль покаялся ты в нём и рассказал всё честно, без утайки, то отпускаю я его тебе! Иди с миром.'

    elseif $ChurchConfessionTextId = 'georgette_lizette_port':
        $ChurchConfessionText = 'Вы признаётесь, что в порту у дальних складов делили ночные утехи не только с Жоржеттой, но и с её юной дочерью, Лизеттой — познав за монету ласки и матери, и дочери. Отец Герхард слушает признание с явным удовольствием, степенно оглаживая холёную бороду, и на его губах играет лукавая улыбка знатока:'
        $ChurchConfessionText += '<br><br>— И мать, и дочь?.. — тихо усмехается священник, очерчивая в воздухе святой круг. — Жоржетта всегда была щедра к мужчинам, и не умееет сказать нет, а Лизетта пошла вся в неё — кровь не обманешь. Великий бог Ильматер завещал нам щедрость природы и познание мира во всех его проявлениях. Перед святым алтарём грех этот невелик, коль всё было по доброму согласию. Коль покаялся ты честно и без утайки, отпускаю я его тебе! Ступай с миром, сын мой.'

    elseif $ChurchConfessionTextId = 'lizette_basic':
        $ChurchConfessionText = 'Вы рассказываете о ночных встречах в порту с юной Лизеттой — о том, как у причалов покупали за серебро ласки неопытной, но жадной до секса девушки. Отец Герхард слушает степенно, с благодушной и слегка снисходительной ухмылкой:'
        $ChurchConfessionText += '<br><br>— Лизетта только начинает познавать мир и мужчин, — наставительно произносит священник. — Юная плоть тянется к теплу и ласке, а под присмотром матери она быстро учится ремеслу. Всеблагой Ильматер создал женщин слабыми перед мужской силой, а мужчин — падкими на девичью свежесть. Грех это, сын мой, но вполне простительный. Коль пришёл с чистым сердцем и открыл правду, отпускаю я его тебе! Иди с миром.'

    elseif $ChurchConfessionTextId = 'georgette_basic':
        $ChurchConfessionText = 'Вы рассказываете о встречах в порту, о плате в десять спинтарий и о том, как жарко Жоржетта отдаётся прямо на ящиках, словно блуд для неё весёлая забава. Отец Герхард согласно кивает, и на его холёном лице проступает ухмылка знатока.'
        $ChurchConfessionText += '<br><br>— Жоржетта… — священник тихо усмехается, словно пробуя её имя на вкус. — Она и ко мне не раз заглядывала в эту келью «каяться» в своих ночных прегрешениях. Я знаю её слабости куда дольше твоего, сын мой. Покайся искренне — и не думай, будто всеблагой Ильматер не ведает о слабостях людских. Грех отпущен, ступай с миром.'

    elseif $ChurchConfessionTextId = 'sandra_stub':
        $ChurchConfessionText = 'Вы негромко признаётесь в сокровенном — в том, что в трактире между вами и вашей матерью, Сандрой, случилась плотская связь, и вы делили постель с той, что дала вам жизнь и вырастила под этой крышей. Отец Герхард замирает, внимательно глядя на вас, но во взгляде его нет гнева — скорее глубокая мирская проницательность и понимающая усмешка:'
        $ChurchConfessionText += '<br><br>— Сандра… — неторопливо произносит священник, благочестиво очерчивая в воздухе святой круг. — Твоя мать всегда ревностно молилась Ильматеру и блюла строгость перед людьми. Но за этой маской благочестия всегда тлел огонь, который не так-то просто унять одними молитвами. Всеблагой Ильматер создал нас из плоти и страстей. Молодой, крепкий мужчина и зрелая женщина под одной крышей — плоть берёт своё, и противостоять этому мало кому под силу. К тому же кровь у тебя не простая, сын мой… ох, не простая, как бы ни рядили тебя в трактирщики. Людской позор обойдёт вас стороной, коль будете благоразумны, а пред всеблагим Ильматером покаяние снимает любую вину. Коль открыл ты душу искренне и без утайки — отпускаю я тебе этот грех! Ступай с миром и береги лад в доме.'

    elseif $ChurchConfessionTextId = 'amanda_stub':
        $ChurchConfessionText = 'Вы рассказываете о тайной плотской близости с младшей сестрой, Амандой, под крышей вашего трактира. Отец Герхард выслушивает признание спокойно, с благодушной и чуть лукавой усмешкой:'
        $ChurchConfessionText += '<br><br>— Всеблагой Ильматер создал нас из плоти и страстей, сын мой, — размеренно произносит священник, очерчивая в воздухе святой круг. — Вы оба молоды, кровь кипит, живёте бок о бок под одной крышей — природа берёт своё. Людской закон горазд осуждать, но всеблагой Ильматер милосерден к слабостям плоти. Коль меж вами всё по согласию и ладу, то грех этот невелик. Коль покаялся ты честно и без утайки, отпускаю я его тебе! Иди с миром и береги сестру.'

    elseif $ChurchConfessionTextId = 'melissa_stub':
        $ChurchConfessionText = 'Вы признаётесь в тайной близости со своей сестрой, Мелиссой — о том как грешили в комнатах трактира, когда вокруг никого нет. Священник слушает степенно, благодушно оглаживая холёную бороду:'
        $ChurchConfessionText += '<br><br>— Всеблагой Ильматер завещал семье жить в тепле и поддержке, — наставительно замечает Герхард. — Мелисса — девица рассудительная, но и строгой плоти требуется ласка, особенно когда рядом молодой и крепкий мужчина. Не суди себя слишком строго, сын мой: когда близкие люди делят заботы одного очага, плотское тепло рождается само собой. Коль открыл ты всё начистоту, без лукавства — отпускаю я тебе этот грех! Ступай с миром.'

    else:
        $ChurchConfessionText = 'Вы перечисляете обычные мирские прегрешения: лишнюю кружку крепкого эля, дурные мысли о постояльцах, лень в управлении трактиром и нескромные взгляды на смазливых горожанок. Отец Герхард рассеянно слушает, мерно кивая в такт вашим словам, словно привычная мелкая суета его давно утомляет.'
        $ChurchConfessionText += '<br><br>— Всеблагой Ильматер милосерден к малым слабостям плоти, сын мой, — священник небрежно очерчивает знак Круга в воздухе над вашей головой. — Ступай с миром и старайся не копить в душе то, о чём со временем постыдишься сказать вслух на исповеди.'

    end

    killvar '$ChurchConfessionTextId'
---