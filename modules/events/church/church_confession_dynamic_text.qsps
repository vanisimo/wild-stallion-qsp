! ================================================
! FILE: modules/events/church/church_confession_dynamic_text.qsps
! MODULE: events/church
! [AI-WORKED] 2026-09-08: canon prose overhaul
! Тексты исповеди ГГ
! ================================================

#ChurchConfessionDynamicText
    $ChurchConfessionTextId = LCASE($ARGS[0])
    $ChurchConfessionText = ''

    if $ChurchConfessionTextId = 'georgette_liza_saw':
        $ChurchConfessionText = 'Вы рассказываете, как зажали Жоржетту в подсобке за колоннами прямо во время утренней службы — и как из полумрака за вами неотрывно наблюдала её дочь, Лизетта. Отец Герхард слушает с нескрываемым, жадным интересом, нервно перебирая чётки и лишь для вида неторопливо очерчивая в воздухе святой круг.'
        $ChurchConfessionText += '<br><br>— Значит, девчонка стояла рядом и смотрела, как ты овладевал её матерью… — глухо произносит священник, и в его голосе сквозит затаённое возбуждение. — Грех соблазна пускает глубокие корни, сын мой. Дочь учится быстрее матери, впитывая похоть глазами. Иди с миром… И не удивляйся, если однажды она сама переступит порог этой комнаты, чтобы вымолить у меня «особое покаяние».'

    elseif $ChurchConfessionTextId = 'georgette_in_church':
        $ChurchConfessionText = 'Вы признаётесь, что брали Жоржетту в пыльной подсобке за тяжёлыми портьерами — прямо в то время, когда голос священника разносился под сводами храма с проповедью о смирении плоти. Отец Герхард слушает без малейшего гнева — скорее с тайным, плотоядным удовольствием, словно смакует каждую подробность.'
        $ChurchConfessionText += '<br><br>— Осквернить святилище в час воскресного молебна… — медленно качает головой святоша, пряча скользкую усмешку в бороде. — Храм Ильматера — не вертеп для утоления похоти, сын мой. Но раз ты пришёл ко мне с чистым сердцем и не стал утаивать содеянного, я отпускаю твой грех. Ступай. И впредь хотя бы не оставляй пятен на храмовых покрывалах, пока паства внемлет моим речам.'

    elseif $ChurchConfessionTextId = 'georgette_basic':
        $ChurchConfessionText = 'Вы рассказываете о ночных встречах у дальнего склада в порту, о плате в десять спинтарий и о том, как бесстыдно и жарко Жоржетта отдаётся прямо на просмолённых ящиках, словно блуд для неё — не постыдный порок, а весёлая забава. Отец Герхард согласно кивает, и на его холёном лице проступает циничная ухмылка знатока.'
        $ChurchConfessionText += '<br><br>— Жоржетта… — священник тихо усмехается, словно пробуя её имя на вкус. — Она и ко мне не раз заглядывала в эту келью «каяться» в своих ночных прегрешениях. Я знаю изгибы её плоти куда дольше твоего, сын мой. Покайся искренне — и не думай, будто всеблагой Ильматер не ведает о слабостях людских. Грех отпущен, ступай с миром.'

    elseif $ChurchConfessionTextId = 'amanda_stub':
        $ChurchConfessionText = 'Вы глухо, запинаясь, рассказываете о греховной тяге и тайной плотской близости с сестрой под крышей собственного трактира. Отец Герхард замирает, его взгляд темнеет, буравя вас насквозь с пугающей проницательностью:'
        $ChurchConfessionText += '<br><br>— Семья — священный оплот, который плотское искушение сокрушает в первую очередь, — негромко, размеренно произносит он, складывая ладони в святом знаке Круга. — Близость единокровных — тяжкое бремя для совести, но исповедь облегчает душу. Молись Ильматеру о стойкости, сын мой… и помни: стены этой комнаты хранят любые тайны, пока ты верен святой церкви.'

    elseif $ChurchConfessionTextId = 'melissa_stub':
        $ChurchConfessionText = 'Вы признаётесь в тайной связи со старшей сестрой, Мелиссой — о запретных ласках в полумраке кухни, среди ароматов трав, дыма очага и постоянного страха быть застигнутыми врасплох. Священник выслушивает признание не моргнув глазом, с бесстрастием судьи, повидавшего немало грязи.'
        $ChurchConfessionText += '<br><br>— Старшая из сестёр привыкла служить опорой вашему очагу, — неторопливо говорит Герхард, глядя на вас с холодной снисходительностью. — Но когда рушатся границы дозволенного, плоть берёт верх над разумом. Я отпускаю тебе этот грех, сын мой. Однако помни: не превращай надёжную стену дома в распахнутую дверь, куда легко войдёт позор.'

    else:
        $ChurchConfessionText = 'Вы перечисляете обычные мирские прегрешения: лишнюю кружку крепкого эля, дурные мысли о постояльцах, лень в управлении трактиром и нескромные взгляды на смазливых горожанок. Отец Герхард рассеянно слушает, мерно кивая в такт вашим словам, словно привычная мелкая суета его давно утомляет.'
        $ChurchConfessionText += '<br><br>— Всеблагой Ильматер милосерден к малым слабостям плоти, сын мой, — священник небрежно очерчивает знак Круга в воздухе над вашей головой. — Ступай с миром и старайся не копить в душе то, о чём со временем постыдишься сказать вслух на исповеди.'

    end

    killvar '$ChurchConfessionTextId'
---