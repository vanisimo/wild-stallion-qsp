! ================================================
! FILE: modules/events/church/church_georgette_service_sex.qsps
! MODULE: events/church
! Секс с Жоржеттой в комнате чистых сердец (воскресная служба)
! Неинтерактивная нарративная сцена: Жоржетта на скамье
! (наедине или с обучением Лизетты)
! ================================================

#GeorgetteChurchSexCanOffer

    GeorgetteChurchSexCanOffer = 0
    $GeorgetteChurchSexBlockReason = ''

    if week <> 7:
        exit
    end

    if time <> 1:
        exit
    end

    if GeorgetteKnown = 0:
        $GeorgetteChurchSexBlockReason = 'unknown'
        exit
    end

    if GeorgettePortSexDone = 0:
        $GeorgetteChurchSexBlockReason = 'no_port_sex'
        exit
    end

    if GeorgetteChurchAlone = 0 and LizetteChurchWithGeorgette = 0:
        $GeorgetteChurchSexBlockReason = 'not_sunday'
        exit
    end

    if HadSex['georgett'] < 1:
        $GeorgetteChurchSexBlockReason = 'no_port_sex'
        exit
    end

    if GeorgetteTalkBioDone = 0:
        $GeorgetteChurchSexBlockReason = 'no_talk'
        exit
    end

    if Friends['georgett'] < 12:
        $GeorgetteChurchSexBlockReason = 'low_friends'
        exit
    end

    if GeorgetteChurchSexDoneDay = day:
        $GeorgetteChurchSexBlockReason = 'already_today'
        exit
    end

    if daily_cum_count >= max_daily_cum:
        $GeorgetteChurchSexBlockReason = 'cum_limit'
        exit
    end

    GeorgetteChurchSexCanOffer = 1
    killvar '$GeorgetteChurchSexBlockReason'
---

#GeorgetteChurchSexHintText

    gs 'GeorgetteChurchSexCanOffer'

    $GeorgetteChurchSexHint = ''

    if GeorgetteChurchSexCanOffer = 1:
        killvar 'GeorgetteChurchSexCanOffer'
        exit
    end

    if $GeorgetteChurchSexBlockReason = 'no_port_sex':
        $GeorgetteChurchSexHint = 'Жоржетта смотрит на вас оценивающе. Пока вы не были с ней ночью в порту, в церкви она делает вид, что вы чужие.'
    elseif $GeorgetteChurchSexBlockReason = 'not_sunday':
        $GeorgetteChurchSexHint = 'Сегодня Жоржетты нет на службе — или она пришла не в том составе, в каком ждёт вашего шёпота.'
    elseif $GeorgetteChurchSexBlockReason = 'no_talk':
        $GeorgetteChurchSexHint = 'Она кивает вам вежливо, но не подводит к разговору. Сначала поговорите с ней ночью в порту — хотя бы о её жизни.'
    elseif $GeorgetteChurchSexBlockReason = 'low_friends':
        $GeorgetteChurchSexHint = 'Жоржетта улыбается уголком губ, но не зовёт в подсобку. Ей ещё мало доверяют для такого риска.'
    elseif $GeorgetteChurchSexBlockReason = 'already_today':
        $GeorgetteChurchSexHint = 'Жоржетта лукаво подмигивает: на сегодня согрешений под носом у святого отца более чем достаточно.'
    elseif $GeorgetteChurchSexBlockReason = 'cum_limit':
        $GeorgetteChurchSexHint = 'Жоржетта усмехается: вы выглядите слишком уставшим, чтобы одолеть её на церковной лавке прямо сейчас.'
    else:
        $GeorgetteChurchSexHint = ''
    end

    killvar 'GeorgetteChurchSexCanOffer'
    killvar '$GeorgetteChurchSexBlockReason'
---

#GeorgetteChurchSexStart

    $GeorgetteChurchSexReturnLoc = $ARGS[0]

    if $GeorgetteChurchSexReturnLoc = '':
        $GeorgetteChurchSexReturnLoc = 'ChurchSundayService'
    end

    gt 'GeorgetteChurchSexApproach', $GeorgetteChurchSexReturnLoc
---

#GeorgetteChurchSexApproach

    $GeorgetteChurchSexReturnLoc = $ARGS[0]

    if $GeorgetteChurchSexReturnLoc = '':
        $GeorgetteChurchSexReturnLoc = 'ChurchSundayService'
    end

    gs 'GeorgetteChurchSexCanOffer'

    if GeorgetteChurchSexCanOffer = 0:
        killvar 'GeorgetteChurchSexCanOffer'
        gt $GeorgetteChurchSexReturnLoc
    end

    killvar 'GeorgetteChurchSexCanOffer'

    cls

    gs 'ShowImage', 'georgett', 'normal', 'normal'

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' ЖОРЖЕТТА В СОБОРЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'GeorgetteChurchSexText', 'approach'
    *p $GeorgetteChurchSexText

    *pl ' '

    act '<b>Согласиться (15 спинтарий)</b>', 'images/common/ui/actions/intim.png':
        gt 'GeorgetteChurchSexPay', $GeorgetteChurchSexReturnLoc
    end

    act '<b>Отказаться</b>', 'images/common/ui/actions/return.png':
        $TargetReturn = $GeorgetteChurchSexReturnLoc
        if $TargetReturn = '':
            $TargetReturn = 'ChurchSundayService'
        end
        killvar '$GeorgetteChurchSexReturnLoc'
        gt $TargetReturn
    end

    killvar '$GeorgetteChurchSexText'
---

#GeorgetteChurchSexPay

    $GeorgetteChurchSexReturnLoc = $ARGS[0]

    if $GeorgetteChurchSexReturnLoc = '':
        $GeorgetteChurchSexReturnLoc = 'ChurchSundayService'
    end

    if money < 15:
        cls
        gs 'ShowImage', 'georgett', 'normal', 'normal'
        gs 'GeorgetteChurchSexText', 'no_money'
        gs 'PrintMainP', $GeorgetteChurchSexText
        killvar '$GeorgetteChurchSexText'
        act '<b>Вернуться в собор</b>', 'images/common/ui/actions/return.png':
            $TargetReturn = $GeorgetteChurchSexReturnLoc
            if $TargetReturn = '':
                $TargetReturn = 'ChurchSundayService'
            end
            killvar '$GeorgetteChurchSexReturnLoc'
            gt $TargetReturn
        end
        exit
    end

    money -= 15
    IntimStage['georgett'] = 5

    if otkroven['georgett'] < 18:
        otkroven['georgett'] = 18
    end

    gt 'GeorgetteChurchSexStep1', $GeorgetteChurchSexReturnLoc
---

#GeorgetteChurchSexStep1

    $GeorgetteChurchSexReturnLoc = $ARGS[0]

    if $GeorgetteChurchSexReturnLoc = '':
        $GeorgetteChurchSexReturnLoc = 'ChurchSundayService'
    end

    cls

    if LizetteChurchWithGeorgette = 1:
        gs 'ShowImagePath', 'images/events/church/georgette_church_sex/withliza1', '', 'event', 'jpg'
        *pl '══════════════════════════════════════════════'
        gs 'PrintTitleLine', ' КОМНАТА ЧИСТЫХ СЕРДЕЦ — ЖОРЖЕТТА И ЛИЗЕТТА'
        *pl '══════════════════════════════════════════════'
        *pl ' '
        gs 'GeorgetteChurchSexText', 'enter_liza'
    else:
        gs 'ShowImagePath', 'images/events/church/georgette_church_sex/bench1', '', 'event', 'jpg'
        *pl '══════════════════════════════════════════════'
        gs 'PrintTitleLine', ' КОМНАТА ЧИСТЫХ СЕРДЕЦ — ЖОРЖЕТТА НА ЛАВКЕ'
        *pl '══════════════════════════════════════════════'
        *pl ' '
        gs 'GeorgetteChurchSexText', 'enter_alone'
    end

    *p $GeorgetteChurchSexText
    *pl ' '

    act '<b>Подойти к лавке</b>', 'images/common/ui/actions/intim.png':
        gt 'GeorgetteChurchSexStep2', $GeorgetteChurchSexReturnLoc
    end

    killvar '$GeorgetteChurchSexText'
---

#GeorgetteChurchSexStep2

    $GeorgetteChurchSexReturnLoc = $ARGS[0]

    if $GeorgetteChurchSexReturnLoc = '':
        $GeorgetteChurchSexReturnLoc = 'ChurchSundayService'
    end

    cls

    if LizetteChurchWithGeorgette = 1:
        gs 'ShowImagePath', 'images/events/church/georgette_church_sex/withliza4', '', 'event', 'jpg'
        *pl '══════════════════════════════════════════════'
        gs 'PrintTitleLine', ' УРОК ДЛЯ ЛИЗЕТТЫ'
        *pl '══════════════════════════════════════════════'
        *pl ' '
        gs 'GeorgetteChurchSexText', 'action_liza'
    else:
        gs 'ShowImagePath', 'images/events/church/georgette_church_sex/bench4', '', 'event', 'jpg'
        *pl '══════════════════════════════════════════════'
        gs 'PrintTitleLine', ' СТРАСТЬ В ПОЛУМРАКЕ'
        *pl '══════════════════════════════════════════════'
        *pl ' '
        gs 'GeorgetteChurchSexText', 'action_alone'
    end

    *p $GeorgetteChurchSexText
    *pl ' '

    act '<b>Кончить</b>', 'images/common/ui/actions/intim.png':
        gt 'GeorgetteChurchSexStepFinish', $GeorgetteChurchSexReturnLoc
    end

    killvar '$GeorgetteChurchSexText'
---

#GeorgetteChurchSexStepFinish

    $GeorgetteChurchSexReturnLoc = $ARGS[0]

    if $GeorgetteChurchSexReturnLoc = '':
        $GeorgetteChurchSexReturnLoc = 'ChurchSundayService'
    end

    cls

    if LizetteChurchWithGeorgette = 1:
        gs 'ShowImagePath', 'images/events/church/georgette_church_sex/withliza6', '', 'event', 'jpg'
        *pl '══════════════════════════════════════════════'
        gs 'PrintTitleLine', ' ЗАВЕРШЕНИЕ — НАГЛЯДНЫЙ УРОК'
        *pl '══════════════════════════════════════════════'
        *pl ' '
        gs 'GeorgetteChurchSexText', 'finish_liza'
    else:
        gs 'ShowImagePath', 'images/events/church/georgette_church_sex/bench6', '', 'event', 'jpg'
        *pl '══════════════════════════════════════════════'
        gs 'PrintTitleLine', ' ЗАВЕРШЕНИЕ БЛИЗОСТИ'
        *pl '══════════════════════════════════════════════'
        *pl ' '
        gs 'GeorgetteChurchSexText', 'finish_alone'
    end

    *p $GeorgetteChurchSexText
    *pl ' '

    gs 'RegisterPlayerCum'
    gs 'GeorgetteChurchSexApplyArcFlags'

    Friends['georgett'] += 1
    sluttiness['georgett'] += 1
    vaginalacts['georgett'] += 1
    sexacts['georgett'] += 1
    cuminside['georgett'] += 1
    orgasms['georgett'] += 1
    GeorgetteChurchSexDoneDay = day

    if LizetteChurchWithGeorgette = 1:
        sluttiness['lizette'] += 2
        otkroven['lizette'] += 2
        Friends['lizette'] += 1
        LizaSawSexInChurch = 1
        gs 'ClampGirlSocialStats', 'lizette'
    end

    if TavernScandal < 100:
        TavernScandal += 1
    end

    gs 'ClampGirlSocialStats', 'georgett'

    *pl ' '
    gs 'PrintMainP', 'Вы быстро оправляете одежду и тихо выскальзываете обратно в собор, где служба подходит к своему полуденному завершению.'
    *pl ' '

    act '<b>Вернуться в собор</b>', 'images/common/ui/actions/return.png':
        $TargetReturn = $GeorgetteChurchSexReturnLoc
        if $TargetReturn = '':
            $TargetReturn = 'ChurchSundayService'
        end
        killvar '$GeorgetteChurchSexReturnLoc'
        gt $TargetReturn
    end

    killvar '$GeorgetteChurchSexText'
---

#GeorgetteChurchSexApplyArcFlags

    if GeorgetteFuckInChurch = 0:
        GeorgetteFuckInChurch = 1
    end

    if LizetteChurchWithGeorgette = 1 and LizaSawSexInChurch = 0:
        LizaSawSexInChurch = 1
    end
---
