#GeorgetteChurchSexHint
    $GeorgetteChurchSexBlockReason = $ARGS[0]
    $GeorgetteChurchSexHint = ''

    if $GeorgetteChurchSexBlockReason = 'no_port_sex':
        $GeorgetteChurchSexHint = 'Жоржетта скользит по вам взглядом, словно вы чужие. Пока вы не провели с ней ночь у портовых пакгаузов, здесь, в соборе, она держит благочестивую дистанцию.'
    elseif $GeorgetteChurchSexBlockReason = 'not_sunday':
        $GeorgetteChurchSexHint = 'Жоржетты сегодня нет среди молящихся — или она пришла не в том окружении, чтобы отвечать на тайные знаки.'
    elseif $GeorgetteChurchSexBlockReason = 'no_talk':
        $GeorgetteChurchSexHint = 'Она лишь вежливо кланяется вам в ответ. Сначала стоит сблизиться и поговорить с ней ночью в порту о её жизни.'
    elseif $GeorgetteChurchSexBlockReason = 'low_friends':
        $GeorgetteChurchSexHint = 'Жоржетта лукаво щурится, но держит дистанцию. Доверия между вами пока маловато для столь дерзкого риска прямо в соборе.'
    elseif $GeorgetteChurchSexBlockReason = 'already_today':
        $GeorgetteChurchSexHint = 'Жоржетта прикладывает палец к губам и тихо улыбается: на сегодня плотских утех за спиной отца Герхарда более чем достаточно.'
    elseif $GeorgetteChurchSexBlockReason = 'cum_limit':
        $GeorgetteChurchSexHint = 'Жоржетта с усмешкой оглядывает вашу стать: вы выглядите слишком истощённым, чтобы взять её на храмовой скамье прямо сейчас.'
    end

    killvar '$GeorgetteChurchSexBlockReason'
---

#GeorgetteChurchSexText
    $GeorgetteChurchSexTextId = LCASE($ARGS[0])
    $GeorgetteChurchSexText = ''

    if $GeorgetteChurchSexTextId = 'approach':
        if LizetteChurchWithGeorgette = 1:
            $GeorgetteChurchSexText = 'Во время торжественной паузы между храмовыми молитвами во славу Ильматера Жоржетта незаметно ловит ваш взгляд. На её красивом чувственном лице сохраняется маска благочестивой прихожанки, но в уголках пухлых губ играет задорная насмешливая улыбка, а глаза выразительно указывают на боковую дверь — в комнату чистых сердец, где отец Герхард принимает исповедь.'
            $GeorgetteChurchSexText += '<br><br>Рядом с ней переминается с ноги на ногу юная Лизетта, с живым любопытством поглядывая то на мать, то на вас.'
            $GeorgetteChurchSexText += '<br><br>— Пятнадцать спинтарий, Стефанчик, — одними губами, едва слышно шепчет Жоржетта, чуть склоняясь к вашему плечу. — Зайдём в комнату чистых сердец втроём. Пора моей девочке наглядно поглядеть, как взрослые ладят и как с мужчинами обходиться. Ты ведь не против юной зрительницы?.. Идёшь?'
        else:
            $GeorgetteChurchSexText = 'Во время торжественной паузы между храмовыми молитвами во славу Ильматера Жоржетта незаметно ловит ваш взгляд. На её красивом чувственном лице сохраняется маска благочестивой прихожанки, но в уголках пухлых губ играет задорная насмешливая улыбка, а глаза выразительно указывают на боковую дверь — в комнату чистых сердец.'
            $GeorgetteChurchSexText += '<br><br>— Пятнадцать спинтарий, Стефан, — одними губами, едва слышно шепчет она, чуть наклоняясь к вам и прикрываясь молитвенником. — Зайдём на пару минут в комнату чистых сердец. Риск двойной, зато и сладость острее. Пока отец Герхард готовится к проповеди, мы как раз успеем согрешить за его спиной. Идёшь?'
        end

    elseif $GeorgetteChurchSexTextId = 'no_money':
        $GeorgetteChurchSexText = 'Жоржетта бросает мимолётный взгляд на ваш пустой кошель, чуть заметно пожимает плечами и тихонько фыркает, не теряя степенного благочестивого вида:'
        $GeorgetteChurchSexText += '<br><br>— Десять спинтарий на ночном причале, пятнадцать — под носом у святого отца, Стефанчик, — шёпотом наставляет она, снова складывая ладони в жесте святого Круга. — Без щедрого подаяния грех не сладок. Копи серебро, а пока стой смирно и внимай службе — глядишь, благочестия наберёшься.'

    elseif $GeorgetteChurchSexTextId = 'enter_alone':
        $GeorgetteChurchSexText = 'Вы бесшумно проскальзываете в узкую боковую пристройку. Тяжёлая дубовая дверь с глухим щелчком запирается на внутренний засов, отрезая вас от храмового гула. В комнате чистых сердец пахнет старым резным деревом, ладаном, пчелиным воском и горячим женским теплом. Сквозь толстую каменную стену едва доносятся отголоски литургии.'
        $GeorgetteChurchSexText += '<br><br>Жоржетта одаривает вас плутовским, жадным взглядом и без лишних слов опускается на массивную дубовую скамью, где обычно сидят кающиеся прихожане. Её ловкие пальцы подхватывают подол длинного платья и решительно взметают его вверх, подбирая к самому поясу.'
        $GeorgetteChurchSexText += '<br><br>Она широко разводит в стороны аппетитные, пышные бёдра, обнажая абсолютно гладкую, умащённую душистым бальзамом промежность. Розовые половые губки уже темнеют от горячего возбуждения и сочатся сладким девичьим соком.'
        $GeorgetteChurchSexText += '<br><br>— Иди сюда, милый... — томным, обжигающим шёпотом зовёт Жоржетта, поглаживая ладонью обнажённое бедро. — Видишь, как я подготовилась к службе? Всё чисто, гладко и готово к покаянию... Расстёгивай штаны, Стефан. Только быстро, пока падре не закончил молитву!'

    elseif $GeorgetteChurchSexTextId = 'enter_liza':
        $GeorgetteChurchSexText = 'Жоржетта приоткрывает тяжёлую дубовую дверь комнаты чистых сердец и властно увлекает за собой и вас, и смущённую Лизетту. Железный засов глухо встаёт на место, запирая вас в прохладном полумраке исповедальни.'
        $GeorgetteChurchSexText += '<br><br>— Мама... а вдруг кто заглянет?.. Это же собор... — испуганным шёпотом лепечет Лизетта, прижимаясь спиной к стене рядом с зарешёченным витражным окном. Её смуглые щёчки заливает густой девичий румянец, а тёмные глаза блестят от отчаянного, неодолимого любопытства.'
        $GeorgetteChurchSexText += '<br><br>— Не трусь, дурёха, засов надёжный, — усмехается Жоржетта. Она опускается на дубовую скамью, подтягивает подол платья к поясу и широко раскидывает крепкие, гладкие бёдра навстречу Стефану. Её сочная, аккуратно выбритая промежность темнеет соблазнительным влажным блеском.'
        $GeorgetteChurchSexText += '<br><br>— Смотри во все глаза, Лизетточка, — наставляет мать, призывно поглаживая своё лоно. — Вот так девица должна встречать мужчину: без ложного стыда, с раскрытым сердцем и влажным лоном. Стефанчик, доставай своего красавца, покажи моей девочке, с чем ей предстоит иметь дело!'

    elseif $GeorgetteChurchSexTextId = 'action_alone':
        $GeorgetteChurchSexText = 'Вы быстро освобождаете из штанов твёрдый, налитый кровью член, встаёте вплотную к скамье между раздвинутых ног Жоржетты и, придерживая её за круглое бедро, одним уверенным движением входите в горячую, влажную глубину.'
        $GeorgetteChurchSexText += '<br><br>Жоржетта запрокидывает голову, впиваясь пальцами в ваши плечи, и судорожно втягивает воздух сквозь сжатые зубы:'
        $GeorgetteChurchSexText += '<br><br>— Ах-х-м-м... всеблагой Ильматер... как глубоко вошёл... — сдавленно стонет она вам в шею, покачивая бёдрами навстречу каждому напористому толчку. — Давай, Стефанчик... глубже... только тихо, ради святого круга... если падре услышит скрип лавки — наложит епитимью на весь город!'
        $GeorgetteChurchSexText += '<br><br>Вы мерно и мощно вколачиваете член в её податливое нутро. Запретность места лишь подстёгивает страсть: звуки шлепков плоти о плоть глушатся шорохом складок платья, Жоржетта сладко дрожит, в такт подмахивая навстречу и прикусывая губу, чтобы не сорваться на откровенный стон.'

    elseif $GeorgetteChurchSexTextId = 'action_liza':
        $GeorgetteChurchSexText = 'Вы достаёте из штанов налитый тяжёлой кровью жеребец. Стоящая в полушаге Лизетта невольно ахает и прикрывает рот ладошкой: её большие глаза жадно прикованы к вашему внушительному мужскому достоинству.'
        $GeorgetteChurchSexText += '<br><br>Стефан притягивает Жоржетту к краю лавки, приставляет багровую головку к её влажной расщелине и с сочным звуком плавно погружается до самого корня.'
        $GeorgetteChurchSexText += '<br><br>Жоржетта сладострастно выгибается, обвивая ваши бёдра стройными икрами, но взгляда от дочери не отрывает. Пока вы размеренно и глубоко двигаетесь в её тугом лоне, женщина ласково и спокойно, словно опытная наставница, говорит в полумрак:'
        $GeorgetteChurchSexText += '<br><br>— Видишь, Лизетточка?.. Ничего страшного и больного в этом нет. Мужской член — он ласку любит и тепло. Смотри, как нужно подавать бёдра навстречу... плавно, в такт его движениям, словно волна в гавани... Не зажимайся, не лежи бревном. Чем нежнее ты его принимаешь, тем мужчине слаще, а когда мужчине сладко — он для тебя горы свернёт и всё серебро к ногам бросит...'
        $GeorgetteChurchSexText += '<br><br>Лизетта заворожённо наклоняется ближе, не в силах оторвать взгляд от того, как толстый ствол скользит между маминых губок, разводя блестящие капли сока:'
        $GeorgetteChurchSexText += '<br><br>— Ой, мам... а ему... правда так хорошо?.. — едва слышно шепчет девушка, её пальцы нервно перебирают тесьму на платье, а дыхание сбивается от увиденного.'
        $GeorgetteChurchSexText += '<br><br>— А ты погляди на его лицо, глупышка, — с томным стоном усмехается Жоржетта, сильнее насаживаясь на ваш член. — Видишь, как жилы на висках налились? Он сейчас от восторга в небеса улетит...'

    elseif $GeorgetteChurchSexTextId = 'finish_alone':
        $GeorgetteChurchSexText = 'Чувствуя, как сладостная судорога подступает к основанию ствола, вы прижимаете Жоржетту к деревянной спинке лавки и делаете серию предельно мощных, глубоких финальных толчков. Горячее, обильное семя толчками выплёскивается в самую глубину её лона.'
        $GeorgetteChurchSexText += '<br><br>Жоржетта сладко всхлипывает, её влагалище конвульсивно пульсирует, выжимая из вас последние капли. Несколько секунд вы оба жадно хватаете ртом воздух в душной тишине исповедальни.'
        $GeorgetteChurchSexText += '<br><br>— Ох, Стефанчик... прямо до нутра пронял, шельмец, — с блаженной улыбкой шепчет она. Жоржетта ловко достаёт платочек, промокает стекающую по бёдрам влагу и одёргивает подол платья. — Прячь своё добро в штаны. Бежим скорее в собор, пока служба не кончилась, и делай вид, что молился за спасение души!'

    elseif $GeorgetteChurchSexTextId = 'finish_liza':
        $GeorgetteChurchSexText = 'Предел наступает внезапно. Вы прижимаете Жоржетту к сиденью и мощными толчками разряжаетесь прямо внутрь её пульсирующего лона. Жоржетта сладострастно стонет вполголоса, её тело мелко вздрагивает в ярком оргазме.'
        $GeorgetteChurchSexText += '<br><br>Когда вы медленно выскальзываете наружу, часть густого, горячего семени переполняет её лоно и струйками стекает по бёдрам на полированное дерево скамьи.'
        $GeorgetteChurchSexText += '<br><br>Жоржетта томно переводит дух и с гордой улыбкой указывает пальцем Лизетте:'
        $GeorgetteChurchSexText += '<br><br>— Вот, погляди, доченька. Видишь семя? Когда мужчина кончает в тебя вот так — до капли, значит, ты всё сделала правильно и довела его до высшей точки. Запомни этот вид и никогда не стыдись мужской страсти.'
        $GeorgetteChurchSexText += '<br><br>Лизетта застенчиво, но с жадным девичьим восторгом разглядывает парящие дорожки спермы на скамье, сглатывая слюну:'
        $GeorgetteChurchSexText += '<br><br>— Ого... сколько его... И он... правда теперь доволен, мам?..'
        $GeorgetteChurchSexText += '<br><br>— Довольнее сытого мартовского кота, — смеётся Жоржетта, аккуратно отираясь батистовым платком. — Учись, пока мать рядом! А теперь живо одёрнули платья, заправили локоны — и на цыпочках в собор, сделаем вид, будто каялись пред алтарём!'

    elseif $GeorgetteChurchSexTextId = 'aftercare':
        $GeorgetteChurchSexText = 'Вы быстро оправляете одежду, застёгиваете пояс и тихо выскальзываете обратно в собор, где служба подходит к своему полуденному завершению.'

    end

    killvar '$GeorgetteChurchSexTextId'
---
