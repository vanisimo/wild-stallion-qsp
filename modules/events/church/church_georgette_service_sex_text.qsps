        if GeorgetteFuckInChurch >= 1:
            $GeorgetteChurchSexText = 'Во время торжественной паузы между храмовыми молитвами во славу Ильматера Жоржетта незаметно ловит ваш взгляд. На её чувственном лице играет плутовская улыбка, а глаза выразительно указывают на боковую дверь — в комнату чистых сердец, где отец Герхард принимает исповеди.'
            $GeorgetteChurchSexText += '<br><br>Рядом с ней теперь всегда держится юная Лизетта, с живым любопытством и румянцем поглядывая то на мать, то на вас.'
            $GeorgetteChurchSexText += '<br><br>— Пятнадцать спинтарий, Стефанчик, — одними губами, едва слышно шепчет Жоржетта, чуть склоняясь к вашему плечу. — Зайдём в комнату чистых сердец втроём. Моей девочке полюбились наши уроки. Ты ведь не против юной зрительницы?.. Идёшь?'
        else:
            $GeorgetteChurchSexText = 'Во время торжественной паузы между храмовыми молитвами во славу Ильматера Жоржетта незаметно ловит ваш взгляд. На её красивом чувственном лице сохраняется маска благочестивой прихожанки, но в уголках пухлых губ играет задорная насмешливая улыбка, а глаза выразительно указывают на боковую дверь — в комнату чистых сердец.'
            $GeorgetteChurchSexText += '<br><br>— Пятнадцать спинтарий, Стефан, — одними губами, едва слышно шепчет она, чуть наклоняясь к вам и прикрываясь молитвенником. — Зайдём на пару минут в комнату чистых сердец. Риск двойной, зато и сладость острее. Пока отец Герхард готовится к проповеди, мы как раз успеем согрешить за его спиной. Идёшь?'
        end

    elseif $GeorgetteChurchSexTextId = 'no_money':
        $GeorgetteChurchSexText = 'Жоржетта бросает мимолётный взгляд на ваш пустой кошель, чуть заметно пожимает плечами и тихонько фыркает, не теряя степенного благочестивого вида:'
        $GeorgetteChurchSexText += '<br><br>— Десять спинтарий на ночном причале, пятнадцать — под носом у святого отца, Стефанчик, — шёпотом наставляет она, снова складывая ладони в жесте святого Круга. — Без щедрого подаяния грех не сладок. Копи серебро, а пока стой смирно и внимай службе — глядишь, благочестия наберёшься.'

    elseif $GeorgetteChurchSexTextId = 'enter_first':
        $GeorgetteChurchSexText = 'Вы бесшумно проскальзываете вслед за Жоржеттой в узкую боковую пристройку собора. В полумраке комнаты чистых сердец пахнет старым деревом, ладаном, свечным воском и горячим женским теплом.'
        $GeorgetteChurchSexText += '<br><br>Жоржетта одаривает вас жадным, плутовским взглядом и опускается на массивную дубовую скамью. Её ловкие пальцы подхватывают подол длинного платья и взметают его вверх, обнажая гладкие, пышные бёдра и влажно блестящую аккуратную промежность.'
        $GeorgetteChurchSexText += '<br><br>Тяжёлая дверь осталась приоткрытой на ладонь — и вдруг в этой щели вы замечаете движение. В дверном проёме застыла юная Лизетта! Прижавшись к дубовому косяку, девушка жадно заглядывает внутрь; её смуглые щёчки пылают густым румянцем, а тёмные глаза горят от отчаянного, неодолимого любопытства.'
