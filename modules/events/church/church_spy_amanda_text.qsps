! ================================================
! FILE: modules/events/church/church_spy_amanda_text.qsps
! MODULE: events/church
! [AI-WORKED] Текст переработан / дополнен ассистентом 16.09.2026
! Тексты подслушивания исповеди Аманды у отца Герхарда
! ================================================

#ChurchSpyAmandaText
    $AmandaConfessTextId = LCASE($ARGS[0])
    $AmandaConfessText = ''

    if $AmandaConfessTextId = 'intro':
        $AmandaConfessText = 'Вы крадётесь вдоль каменной стены собора к высокому витражному окну комнаты чистых сердец.'
        $AmandaConfessText += '<br><br>Створка приоткрыта ровно настолько, чтобы свежий полуденный ветерок уносил запах ладана и лампадного масла, а наружу доносились приглушённые голоса. Прижавшись к нагретому солнцем камню, вы осторожно заглядываете внутрь.'
        $AmandaConfessText += '<br><br>На коленях перед резной дубовой перегородкой стоит Аманда. Её пальчики судорожно сжимают край кружевного платка, плечи слегка подрагивают от волнения. По ту сторону перегородки степенно восседает отец Герхард. Его холёная рука медленно оглаживает окладистую бороду, а внимательный, цепкий взгляд с жадным любопытством скользит по тонкому стану девушки.'

    elseif $AmandaConfessTextId = 'confess_stefan':
        $AmandaConfessText = '— Отче Герхард... — голос Аманды дрожит и срывается на тихий шёпот, её щёки заливает густой девичий румянец. — Самый тяжкий грех мой... это мой брат, Стефан.'
        $AmandaConfessText += '<br><br>Она судорожно переводит дух, пряча лицо в ладонях:'
        $AmandaConfessText += '<br><br>— Мы живём под одной крышей, и... между нами случилось то, о чём грешно даже подумать. Он приходил ко мне в комнату. Он обнимал меня, целовал... трогал моё тело там, где положено прикасаться только законному мужу. А я... я не прогнала его, отче! Мне было так жарко, так сладко... Я сама прижималась к нему и молила не останавливаться! Всеблагой Ильматер, я делю греховные ласки с родным братом... Простит ли меня церковь за такое падение?!'

    elseif $AmandaConfessTextId = 'confess_legare':
        $AmandaConfessText = '— И ещё, отче... — Аманда всхлипывает, судорожно сжимая ткань платка. — В город приехал столичный господин... Легаре. Он такой обходительный, говорит такие сладкие речи...'
        $AmandaConfessText += '<br><br>Она опускает голову почти до самого каменного пола:'
        $AmandaConfessText += '<br><br>— Он подкараулил меня в тёмном переулке. Прижал к стене, гладил мои бёдра, целовал в шею и губы... Я знала, что дворянам нельзя верить, но голова кружилась, и я позволила его рукам зайти слишком далеко... Мне казалось, что если я откажу — он посмеётся надо мной, а мне так хотелось быть взрослой и красивой для него!'

    elseif $AmandaConfessTextId = 'confess_boys':
        $AmandaConfessText = '— А ещё... соседские парни, отче... — Аманда задыхается от стыда, её плечи судорожно вздрагивают. — Ханс, Курт... они подкарауливали меня за сараем у трактира, когда я выходила со смены.'
        $AmandaConfessText += '<br><br>Она судорожно сглатывает, не смея поднять глаз:'
        $AmandaConfessText += '<br><br>— Они лезли ко мне под юбку, хватали за грудь, а я... я стояла на коленях в пыли и ласкала их мужскую плоть... чтобы они никому не разболтали и не ославили меня перед трактиром! Я вела себя так легкомысленно, отче!'

    elseif $AmandaConfessTextId = 'confess_innocent':
        $AmandaConfessText = '— Отче... — доносится робкий, невинный шепоток Аманды. — В трактире гости смотрят на меня с неприкрытой жадностью. Руки тянут, сальности шепчут... А я ловлю себя на мысли, что мне приятно это внимание. И когда Стефан подходит близко — у меня сердце колотится в груди так сильно, будто я согрешила. Мне стыдно перед Ильматером за эти нескромные мысли!'

    elseif $AmandaConfessTextId = 'gerhard_response':
        $AmandaConfessText = 'Отец Герхард слушает с жадным вниманием. В полумраке исповедальни его глаза маслянисто блестят — он впитывает каждую подробность, словно смакуя запретную тайну. Затем он медленно, благочестиво поднимает руку и чертит широкий знак Священного Круга:'
        $AmandaConfessText += '<br><br>— Успокойся, дочь моя. Отри слёзы. Всеблагой Ильматер милосерден к раскаявшимся сердцам. Наша плоть слаба, и кровь в юности кипит жарче полуденного солнца. Ступай к алтарю, возьми дар Ильматера — священный порошок Таро, омой тело в чистоте и смой телесную скверну.'
        $AmandaConfessText += '<br><br>Священник наклоняется к самой решётке, его голос звучит вкрадчиво, бархатно и тягуче:'
        $AmandaConfessText += '<br><br>— Но помни, Аманда: страсть твоя сильна, а душа нежна и податлива. В миру полно волков, и неопытной девушке легко сгинуть в грехе. Тебе нужно особое духовное водительство. Приходи ко мне в комнату чистых сердец почаще, дитя моё... Наедине, в тишине монастырского покоя, мы станем творить особые очистительные молитвы. Я сам присмотрю за спасением твоей души и научу тебя усмирять этот плотский жар.'
        $AmandaConfessText += '<br><br>Герхард торжественно произносит:'
        $AmandaConfessText += '<br><br>— Именем Всеблагого Ильматера — отпускаю тебе грехи твои! Ступай с миром, и жду тебя на тайную беседу.'

    elseif $AmandaConfessTextId = 'outro':
        $AmandaConfessText = 'Аманда поднимается с колен. На её лице больше нет слепого страха — слова священника сняли тяжкий камень с души, хотя в её глазах всё ещё читается наивное девичье волнение.'
        $AmandaConfessText += '<br><br>Она выходит из комнаты чистых сердец лёгкими шагами.'
        $AmandaConfessText += '<br><br>Вы осторожно отступаете от витражного окна собора. Вы слышали всё: и тайные признания сестры, и то, какими глазами святой отец смотрел на неё. Отец Герхард явно положил глаз на Аманду, и его «духовное окормление» грозит обернуться куда более опасной игрой...'

    ! ========================================================
    ! ЭТАП 2: ИСПОВЕДЬ ОБ ОПЫТЕ И ПРОВЕРКА ЧИСТОТЫ
    ! ========================================================

    elseif $AmandaConfessTextId = 'intro_stage2':
        $AmandaConfessText = 'Вы снова у знакомого витражного окна комнаты чистых сердец. Сквозь резной переплёт открывается привычная картина: мягкий полумрак, запах восковых свечей и дубовая исповедальня.'
        $AmandaConfessText += '<br><br>Аманда сидит на коленях, но в её позе уже нет прежней зажатости. Она поправляет выбившуюся из причёски прядь светлых волос, а отец Герхард смотрит на неё с неподдельным, выжидающим нетерпением.'
        $AmandaConfessText += '<br><br>— Здравствуй, дитя моё, — раздаётся бархатный голос священника. — Прошла неделя с тех пор, как ты омылась порошком Таро. Чисты ли помыслы твои? И что скажет твоё сердце перед Всеблагим Ильматером сегодня?'

    elseif $AmandaConfessTextId = 'confess_stage2_stefan':
        $AmandaConfessText = 'Аманда слегка заминается, на её щеках играет живой, лукавый румянец:'
        $AmandaConfessText += '<br><br>— Отче Герхард... вы велели быть честной до конца. Я больше не невинная девушка. Между мной и Стефаном всё зашло слишком далеко... Мы делим постель не один раз, и не два. Когда он касается меня — я теряю голову. Я знаю, что это запретно, но моё тело само откликается на его ласки, и я отдаюсь ему без остатка!'

    elseif $AmandaConfessTextId = 'confess_stage2_legare':
        $AmandaConfessText = 'Аманда опускает ресницы, но в её голосе звучит скорее смущённая похвальба, чем истинное раскаяние:'
        $AmandaConfessText += '<br><br>— Отче... господин Легаре не просто целовал меня. В тёмном переулке после танцев он взял меня прямо у кирпичной стены. Он был так напорист и опытен... Я уже не девочка, отче. Он показал мне взрослую страсть, и это случалось с нами снова... Моя плоть жаждала его рук, и я покорилась.'

    elseif $AmandaConfessTextId = 'confess_stage2_boys':
        $AmandaConfessText = 'Аманда вздыхает, теребя подол юбки:'
        $AmandaConfessText += '<br><br>— Отче... соседские парни у забора таверны... я отдалась им без утайки. Сначала один, потом другой... Они брали меня в пыли за телегами, сжимали мои бёдра, а я лишь постанывала и не могла сказать «нет». Я уже потеряла девичество, святой отец, и грех плоти стал для меня привычным делом.'

    elseif $AmandaConfessTextId = 'confess_stage2_general':
        $AmandaConfessText = 'Аманда потупляет взор, её дыхание учащается:'
        $AmandaConfessText += '<br><br>— Отче... в моём сердце бушует пожар. Я больше не невинна душой и телом. Взгляды мужчин волнуют меня, я позволяю им трогать меня за корсаж и заглядывать под подол... Мне нравится чувствовать чужие руки на своей коже, и я не в силах противиться этому сладкому искушению.'

    elseif $AmandaConfessTextId = 'gerhard_touch_stage2':
        $AmandaConfessText = 'Отец Герхард слушает, не сводя глаз с порозовевшего лица девушки. Его ноздри раздуваются, на бледных скулах проступает хищный румянец. Он понимает: перед ним вовсе не застенчивая монашка, а ветреная, податливая красотка, вкусившая запретный плод и открытая для плотских забав.'
        $AmandaConfessText += '<br><br>— Вот как... — священник медленно поднимается со скамьи. — Скверна проникла глубже, чем я предполагал, дитя моё. Одних слов покаяния здесь мало. Ильматер заповедал свято блюсти чистоту телесную.'
        $AmandaConfessText += '<br><br>Он выходит из-за резной дубовой перегородки и оказывается вплотную к Аманде!'
        $AmandaConfessText += '<br><br>Священник опускает свои холёные, тяжёлые ладони на открытые девичьи плечи. Его пальцы скользят по нежной коже ключиц, нагло задевая край корсажа:'
        $AmandaConfessText += '<br><br>— Кожа горяча... Кровь бьётся слишком неистово, — вкрадчиво шепчет Герхард, наклоняясь к самому её уху. Его ладони медленно скользят вниз — по талии, задерживаясь на округлых бёдрах девушки, будто он священным правом прощупывает каждый изгиб. — Ты омывала тело порошком Таро, Аманда? Ни волоска не осталось на теле, как велел Ильматер? Я должен чувствовать чистоту твоей плоти...'
        $AmandaConfessText += '<br><br>Аманда вздрагивает от дерзких прикосновений пастыря, часто дышит и прикусывает нижнюю губу. Её щёки пылают, но в силу своего легкомыслия она не смеет оттолкнуть святого отца — напротив, её забавляет и будоражит такое дерзкое внимание от городского священника.'

    elseif $AmandaConfessTextId = 'outro_stage2':
        $AmandaConfessText = 'Герхард медленно убирает руки, тяжело переводя дыхание, и отступает за перегородку:'
        $AmandaConfessText += '<br><br>— Твоя плоть слаба, Аманда, но Ильматер милостив. В следующее воскресенье приходи сюда же, в комнату чистых сердец. Мы запрём дверь от мирской суеты и совершим особый, полный чин очищения. Ты очистишься до самого донышка души. Ступай с миром.'
        $AmandaConfessText += '<br><br>Аманда поднимается с колен, смущённо оглаживая примятую юбку, и выходит из комнаты чистых сердец с пылающим лицом и рассеянной улыбкой.'
        $AmandaConfessText += '<br><br>Вы у витража едва сдерживаете гнев. Картина ясна как день:'
        $AmandaConfessText += '<br><br><span style="color:#E6C280"><b>[Мысли Стефана]:</b> <i>«Святой отец совсем потерял берега... Он прикрывается Ильматером, а сам нагло распускает руки, пользуясь легкомыслием Аманды. Если я не прижму его прямо сейчас — в следующее воскресенье он запрёт дверь и зайдёт куда дальше! Нужно поймать его в соборе и пригрозить скандалом, пока не поздно.»</i></span>'

    ! ========================================================
    ! ДИАЛОГ С ГЕРХАРДОМ: ШАНТАЖ ИЛИ ЦИНИЧНЫЙ ОТВЕТ
    ! ========================================================

    elseif $AmandaConfessTextId = 'confront_success':
        $AmandaConfessText = 'Вы решительно подходите к отцу Герхарду в соборе. Священник благообразно складывает руки на животе и снисходительно улыбается:'
        $AmandaConfessText += '<br><br>— С чем пришёл, сын мой Стефан? Ищешь духовного совета?'
        $AmandaConfessText += '<br><br>Вы подступаете вплотную, глядя ему прямо в глаза, и говорите негромко, но твёрдо и чеканно:'
        $AmandaConfessText += '<br><br>— Оставь этот елейный тон, Герхард. Держи свои загребущие руки подальше от моей сестры Аманды. Я видел в витражное окно, как ты «проверял чистоту» её тела своими пальцами.'
        $AmandaConfessText += '<br><br>Лицо Герхарда мгновенно каменеет, краска отливает от щёк:'
        $AmandaConfessText += '<br><br>— Что ты себе позволяешь, дерзкий щегол?! Как ты смеешь клеветать на пастыря Ильматера...'
        $AmandaConfessText += '<br><br>— Если ты ещё хоть раз попробуешь запереться с ней в комнате чистых сердец или распустить руки — я лично подниму на уши епископа, магистрат и весь город. Прихожанам на соборной площади будет крайне любопытно узнать, какими «особыми чинами» занимается их святой отец наедине с молодыми прихожанками. Посмотрим, сколько дней после этого ты продержишься в соборе.'
        $AmandaConfessText += '<br><br>Герхард судорожно сглатывает, его взгляд испуганно мечется по сторонам. Он понимает: молодой хозяин трактира не шутит, а репутация городского пастыря — вещь хрупкая.'
        $AmandaConfessText += '<br><br>— Тс-с... тише, Стефан, — быстро, примирительно шипит священник, нервно поправляя складки рясы. — Зачем же поднимать пустой шум в храме? Ты... не так всё понял. Это было лишь строгое пастырское испытание веры. Но... я услышал тебя. Трактир Лонгкоков — уважаемое заведение, а твоя семья исправно платит десятину. Никаких лишних бесед и проверок с Амандой больше не будет. Ступай с миром.'

    elseif $AmandaConfessTextId = 'confront_cynical_refusal':
        $AmandaConfessText = 'Вы подходите к отцу Герхарду, кипя от негодования, и с порога бросаете ему в лицо:'
        $AmandaConfessText += '<br><br>— Герхард! Ты зашёл слишком далеко с Амандой! Думаешь, раз заперся в комнате чистых сердец, никто ничего не узнает?! Я выведу тебя на чистую воду перед всем городом!'
        $AmandaConfessText += '<br><br>Однако священник даже бровью не ведёт. На его холёных губах появляется холодная, снисходительная и откровенно циничная усмешка:'
        $AmandaConfessText += '<br><br>— О чём ты шумишь, сын мой? — спокойно произносит Герхард, лениво оглаживая бороду. — Ты опоздал со своими угрозами. Всё уже свершилось и было освящено Всеблагим Ильматером.'
        $AmandaConfessText += '<br><br>Он делает шаг вперёд, понижая голос до ехидного шёпота:'
        $AmandaConfessText += '<br><br>— И кому ты побежишь жаловаться? Молодой трактирщик против уважаемого пастыря собора? Тебе никто не поверит. К тому же, твоя ветреная сестрица и без меня крутит шашни со всеми подряд — то столичный купец Легаре, то деревенские оборванцы за сараями... Весь город знает её легкомысленный нрав. Так какая разница, Стефан, если в её длинном списке появится ещё одно почтенное имя? Аманда довольна, её грехи отпущены, а тебе лучше закрыть рот и не позорить семью пустым лаем. Ступай.'

    ! ========================================================
    ! ЭТАП 3: ИНТИМНЫЙ ОСМОТР ПАСТЫРЕМ (2 ЭКРАНА)
    ! ========================================================

    elseif $AmandaConfessTextId = 'stage3_screen1':
        $AmandaConfessText = 'Вы приникаете к витражному окну, приоткрытому гномьим механизмом. В комнате чистых сердец дубовая дверь заперта на массивный засов.'
        $AmandaConfessText += '<br><br>Отец Герхард стоит рядом с Амандой, положив руку ей на плечо:'
        $AmandaConfessText += '<br><br>— Ты говоришь, что искренне раскаялась, дочь моя? Но Ильматер требует удостовериться, смыт ли телесный жар греха до конца. Одежды скрывают неправду, истина открывается лишь взору пастыря.'
        $AmandaConfessText += '<br><br>Аманда, слегка краснея, но с привычным легкомысленным послушанием, позволяет священнику приподнять подол её платья. Герхард опускается на одно колено. Его холёные пальцы неторопливо и бесцеремонно проникают под тонкое кружево белья, проверяя сокровенные девичьи складки под предлогом церковного испытания чистоты. Аманда прерывисто вздыхает, неловко переминаясь с ноги на ногу, пока пальцы пастыря уверенно скользят по её сокровенному лону.'
        $AmandaConfessText += '<br><br>Затем священник медленно поднимает влажные пальцы к лицу девушки:'
        $AmandaConfessText += '<br><br>— Вкуси плоды своего раскаяния, Аманда. Познай смирение плоти перед святым саном.'
