! ================================================
! FILE: modules/events/church/church_spy_amanda_text.qsps
! MODULE: events/church
! Тексты подслушивания исповеди Аманды у отца Герхарда
! ================================================

#ChurchSpyAmandaText
    $AmandaConfessTextId = LCASE($ARGS[0])
    $AmandaConfessText = ''

    if $AmandaConfessTextId = 'intro':
        $AmandaConfessText = 'Вы крадётесь вдоль каменной стены собора к высокому витражному окну комнаты чистых сердец.'
        $AmandaConfessText += '<br><br>Створка приоткрыта ровно настолько, чтобы свежий полуденный ветерок уносил запах ладана и лампадного масла, а наружу доносились приглушённые голоса. Прижавшись к нагретому солнцем камню, вы осторожно заглядываете внутрь.'
        $AmandaConfessText += '<br><br>На коленях перед резной дубовой перегородкой стоит Аманда. Её пальчики судорожно сжимают край кружевного платка, плечи слегка подрагивают от волнения. По ту сторону перегородки степенно восседает отец Герхард. Его холёная рука медленно оглаживает окладистую бороду, а внимательный, цепкий взгляд с жадным любопытством скользит по тонкому стану девушки.'

    elseif $AmandaConfessTextId = 'confess_stefan':
        $AmandaConfessText = '— Отче Герхард... — голос Аманды дрожит и срывается на тихий шёпот, её щёки заливает густой девичий румянец. — Самый тяжкий грех мой... это мой брат, Стефан.'
        $AmandaConfessText += '<br><br>Она судорожно переводит дух, пряча лицо в ладонях:'
        $AmandaConfessText += '<br><br>— Мы живём под одной крышей, и... между нами случилось то, о чём грешно даже подумать. Он приходил ко мне в комнату. Он обнимал меня, целовал... трогал моё тело там, где положено прикасаться только законному мужу. А я... я не прогнала его, отче! Мне было так жарко, так сладко... Я сама прижималась к нему и молила не останавливаться! Всеблагой Ильматер, я делю греховные ласки с родным братом... Простит ли меня церковь за такое падение?!'

    elseif $AmandaConfessTextId = 'confess_legare':
        $AmandaConfessText = '— И ещё, отче... — Аманда всхлипывает, судорожно сжимая ткань платка. — В город приехал столичный господин... Легаре. Он такой обходительный, говорит такие сладкие речи...'
        $AmandaConfessText += '<br><br>Она опускает голову почти до самого каменного пола:'
        $AmandaConfessText += '<br><br>— Он подкараулил меня в тёмном переулке. Прижал к стене, гладил мои бёдра, целовал в шею и губы... Я знала, что дворянам нельзя верить, но голова кружилась, и я позволила его рукам зайти слишком далеко... Мне казалось, что если я откажу — он посмеётся надо мной, а мне так хотелось быть взрослой и красивой для него!'

    elseif $AmandaConfessTextId = 'confess_boys':
        $AmandaConfessText = '— А ещё... соседские парни, отче... — Аманда задыхается от стыда, её плечи судорожно вздрагивают. — Ханс, Курт... они подкарауливали меня за сараем у трактира, когда я выходила со смены.'
        $AmandaConfessText += '<br><br>Она судорожно сглатывает, не смея поднять глаз:'
        $AmandaConfessText += '<br><br>— Они лезли ко мне под юбку, хватали за грудь, а я... я стояла на коленях в пыли и брала их мужскую плоть в рот... глотала семя, чтобы они никому не разболтали и не ославили меня перед трактиром... Я вела себя как последняя потаскуха из портового кабака!'

    elseif $AmandaConfessTextId = 'confess_innocent':
        $AmandaConfessText = '— Отче... — доносится робкий, невинный шепоток Аманды. — В трактире гости смотрят на меня с неприкрытой жадностью. Руки тянут, сальности шепчут... А я ловлю себя на мысли, что мне приятно это внимание. И когда Стефан подходит близко — у меня сердце колотится в груди так сильно, будто я согрешила. Мне стыдно перед Ильматером за эти нескромные мысли!'

    elseif $AmandaConfessTextId = 'gerhard_response':
        $AmandaConfessText = 'Отец Герхард слушает с жадным вниманием. В полумраке исповедальни его глаза маслянисто блестят — он впитывает каждую подробность, словно смакуя запретную тайну. Затем он медленно, благочестиво поднимает руку и чертит широкий знак Священного Круга:'
        $AmandaConfessText += '<br><br>— Успокойся, дочь моя. Отри слёзы. Всеблагой Ильматер милосерден к раскаявшимся сердцам. Наша плоть слаба, и кровь в юности кипит жарче полуденного солнца. Ступай к алтарю, возьми дар Ильматера — священный порошок Таро, омой тело в чистоте и смой телесную скверну.'
        $AmandaConfessText += '<br><br>Священник наклоняется к самой решётке, его голос звучит вкрадчиво, бархатно и тягуче:'
        $AmandaConfessText += '<br><br>— Но помни, Аманда: страсть твоя сильна, а душа нежна и податлива. В миру полно волков, и неопытной девушке легко сгинуть в грехе. Тебе нужно особое духовное водительство. Приходи ко мне в келью почаще, дитя моё... Наедине, в тишине монастырских покоев, мы станем творить особые очистительные молитвы. Я сам присмотрю за спасением твоей души и научу тебя усмирять этот плотский жар.'
        $AmandaConfessText += '<br><br>Герхард торжественно произносит:'
        $AmandaConfessText += '<br><br>— Именем Всеблагого Ильматера — отпускаю тебе грехи твои! Ступай с миром, и жду тебя на тайную беседу.'

    elseif $AmandaConfessTextId = 'outro':
        $AmandaConfessText = 'Аманда поднимается с колен. На её лице больше нет слепого ужаса — слова священника сняли тяжкий камень с души, хотя в её глазах всё ещё читается наивное смятение.'
        $AmandaConfessText += '<br><br>Она выходит из комнаты чистых сердец лёгкими шагами.'
        $AmandaConfessText += '<br><br>Вы осторожно отступаете от витражного окна собора. Вы слышали всё: и тайные похождения сестры, и то, какими глазами святой отец смотрел на неё. Отец Герхард явно положил глаз на Аманду, и его «духовное окормление» грозит обернуться куда более опасной игрой...'

    end

    killvar '$AmandaConfessTextId'
---
