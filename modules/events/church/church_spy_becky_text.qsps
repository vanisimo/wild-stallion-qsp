! ================================================
! FILE: modules/events/church/church_spy_becky_text.qsps
! MODULE: events/church
! Тексты подслушивания Бекки + отец Герхард (ongoing)
! ================================================

#ChurchSpyBeckyPickStepText
    $ChurchSpyMode = 'p1'

    if BeckyPriestSpyCount > 0:
        $ChurchSpyMode = 'repeat'
    end

    gs 'ChurchSpyBeckyStepText', $ChurchSpyMode, STR(BeckyPriestSpyStep)
    killvar '$ChurchSpyMode'
---

#ChurchSpyBeckyStepText
    $ChurchSpyMode = LCASE($ARGS[0])
    $ChurchSpyStep = LCASE($ARGS[1])

    if $ChurchSpyMode = 'p1':
        if $ChurchSpyStep = '1':
            gs 'ChurchSpyBeckyP1Step1Text'
        elseif $ChurchSpyStep = '2':
            gs 'ChurchSpyBeckyP1Step2Text'
        else
            gs 'ChurchSpyBeckyP1Step3Text'
        end
    else
        if $ChurchSpyStep = '1':
            gs 'ChurchSpyBeckyRepeatStep1Text'
        elseif $ChurchSpyStep = '2':
            gs 'ChurchSpyBeckyRepeatStep2Text'
        else
            gs 'ChurchSpyBeckyRepeatStep3Text'
        end
    end

    killvar '$ChurchSpyMode'
    killvar '$ChurchSpyStep'
---

#ChurchSpyBeckyP1Step1Text
    $ChurchSpyText = 'Через щель в ризнице вы видишь Ребекку Блэнкеншип и отца Герхарда.<br><br>— Рад видеть, дочь моя, что почитаешь ты Ильматера и захаживаешь в этот святой храм, — говорит священник, сноровисто залезая ей под платье. — Так расскажи мне, как ты нагрешила со времени последней исповеди.<br><br>— Ох, грешила, падре, грешила… — смиренно отвечает вдовушка, чуть раздвигая ноги, чтобы слуге Ильматера было удобнее. Не обнаружив под подолом белья, отец Герхард удовлетворенно укладывает её на кушетку.'
---

#ChurchSpyBeckyP1Step2Text
    if BeckyEddieDone = 1:
        $ChurchSpyText = 'Отец Герхард входит во вдову по самые бёдра и спрашивает между толчками:<br><br>— Отдалась ли ты сыну своему Эдди, как собиралась?<br><br>— Ох, падре, согрешила я, перед родным сыном ноги раздвинула! — ахает Бекки, подмахивая священнику. — А он ни секунды не колебался, вошёл в мать. Только тревожит меня: Эдди молодой еще, в меня кончает… Вдруг младенчика от сына приживу?<br><br>— Этот грех я тебе отпускаю, — благочестиво ответовствует жрец. — А насчет младенчика не переживай: я в свою матушку тоже столько семени закачал, так что беда невеликая!'
    elseif BeckyPriestOk = 1 or BeckyVar['PriestAdvice'] >= 3:
        $ChurchSpyText = 'Отец Герхард входит в Бекки и шепчет:<br><br>— Ну, дочь моя, расскажи, что за сомнения тебя мучают?<br><br>— Ох, падре… сынишка мой Эдди на меня как на женщину посматривать начал. А я ведь одна… Ежели дать ему — великий то грех будет али малый?<br><br>— Сказать по правде — грех небольшой, — отрывисто выдыхает священник, набирая темп. — Сам я в юности со своей матерью Франческой не удержался… Так что не сдерживай себя, отдайся сыну во благо его смирения!'
    else:
        $ChurchSpyText = 'Отец Герхард входит в Бекки и шепчет: — Расскажи всё — без утайки.<br><br>— После смерти мужа уступала домогательствам… А потом и Стефан из трактира заходил, — краснеет Бекки. — Стыдно, падре, но сладко было.<br><br>Священник только увеличивает темп, будто слушает исповедь телом, а не ушами.'
    end
---

#ChurchSpyBeckyP1Step3Text
    if BeckyEddieDone = 1:
        $ChurchSpyText = 'Отец Герхард закряхтел и кончает прямо внутрь вдовушки. Бекки содрогается в оргазме: — Ах, святой отец, спасибо вам, успокоили вы меня, тяжесть с души сняли…<br><br>Обмякший священник осеняет её святым кругом: — Иди с миром, дочь моя. А нагрешишь — приходи опять исповедоваться. — Бекки аккуратно поправляет платье и уходит.'
    elseif BeckyPriestOk = 1 or BeckyVar['PriestAdvice'] >= 3:
        $ChurchSpyText = 'Священник кончает глубоко во вдову. Бекки счастливо выдыхает: — Спасибо вам, святой отец, значит не столь греховны мои мысли, как я считала…<br><br>Отец Герхард осеняет её святым кругом: — Иди с миром. Нагрешишь — приходи снова. — Вдова поправляет одежду и уходит.'
    else:
        $ChurchSpyText = '— Ах, греховодница, — восклицает священник, не сбавляя темпа, — и думать не смей о позоре! — Но через мгновение он всё равно кончает внутрь. Бекки шепчет: — Спасибо, что уберегли меня, падре…<br><br>Она приводит себя в порядок и уходит, будто после обычной исповеди — хотя вы видели совсем другое.'
    end
---

#ChurchSpyBeckyRepeatStep1Text
    $ChurchSpyText = 'Снова воскресный полдень. Бекки заходит в комнату чистых сердец, а отец Герхард встретит её не только наставлениями.<br><br>— Рад видеть тебя, дочь моя. Расскажи, как твой дом и твои грехи, — строго говорит он, задирая её юбки.<br><br>— Знаю, падре… трудно одинокой вдове удержаться, — отвечает Бекки и сама раздвигает ноги на кушетке.'
---

#ChurchSpyBeckyRepeatStep2Text
    if BeckyEddieDone = 1 and BeckyHomeStage >= 5:
        $ChurchSpyText = '— Продолжаешь ли отдаваться сыну и трактирщику? — спрашивает священник, с размаху входя в неё.<br><br>— Ох, падре… почитай каждый день Эдди меня имеет как хочет, а то и на пару со Стефанчиком совокупляются и стыда не знают! — вопит Бекки от удовольствия.<br><br>Отец Герхард только кивает и ускоряется: — Что ж, парни они молодые, а ты женщина одинокая. Этот грех я тебе отпускаю!'
    elseif BeckyEddieDone = 1:
        $ChurchSpyText = '— Как поживает Эдди? — бормочет священник между толчками.<br><br>— Сыночек… привык. Кажется, каждый день готов во мне бывать, — признаётся Бекки. — Грех есть грех, но дома теперь иначе.<br><br>— Вот и ладно, — ворчит Герхард.'
    else:
        $ChurchSpyText = '— Снова уступала искушениям? — спрашивает священник.<br><br>— Да, падре… Стефан бывает в гостях. Вдова без мужа — слаба, — шепчет Бекки. Отец Герхард ворчит о грехе, но движения его говорят обратное.'
    end
---

#ChurchSpyBeckyRepeatStep3Text
    $ChurchSpyText = 'Старый жрец закряхтел и щедро заполняет влагалище Бекки своей спермой, после чего лениво осеняет её святым кругом:<br><br>— Теперь иди, а нагрешишь — приходи опять исповедоваться.<br><br>Бекки пальчиками собирает сперму жреца с ляжек, облизывает их, поправляет платье и удаляется.'
---