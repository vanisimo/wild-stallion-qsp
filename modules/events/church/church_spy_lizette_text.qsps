! ================================================
! FILE: modules/events/church/church_spy_lizette_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! Агентам: НЕ переписывать prose без явного «можно править тексты».
! Перед любой переделкой файла — спросить пользователя; сохранять формулировки.
! MODULE: events/church
! Тексты spy: Лизетта + Герхард (два акта)
! Акт 2: диалоги из legacy IntLizettAfterCermon + действия персонажей
! ================================================

#ChurchSpyLizetteText
    $ChurchSpyLizetteTextId = LCASE($ARGS[0])
    $ChurchSpyLizetteText = ''

    if $ChurchSpyLizetteTextId = 'intro_1':
        $ChurchSpyLizetteText = 'В комнате чистых сердец Лизетта осталась наедине со священником — без матери и без привычной защитной маски бойкой портовой девчонки. Отец Герхард сидит напротив, грузно подавшись вперёд и не спуская с неё внимательного взгляда.'

    elseif $ChurchSpyLizetteTextId = 'act1_step_1':
        $ChurchSpyLizetteText = '— Ты видела мать и хозяина трактира в соборе? — негромко спрашивает он. — Не отводи глаз, дочь моя. Я спрашиваю не из праздного любопытства.'
        $ChurchSpyLizetteText += '<br><br>— Видела... — смущённо шепчет Лизетта, теребя пальцами край подола. — Через приоткрытую дверь исповедальни заглядывала... Мама стонала и улыбалась... А хозяин трактира заметил меня в дверях. Сначала я испугалась, думала — закричит или прогонит... А он не прогнал — улыбнулся и пальцем подозвал ближе... И я стояла в дверях и смотрела, как он с мамой... как двигался, как входил в неё...'

    elseif $ChurchSpyLizetteTextId = 'act1_step_2':
        $ChurchSpyLizetteText = '— Хотела бы сама испытать такое? — повисшая пауза давит тяжелее самого вопроса. — С ним? С другим мужчиной? Или пока лишь в мыслях, о которых стыдно признаться вслух?'
        $ChurchSpyLizetteText += '<br><br>Лизетта заливается краской, но взгляд не отводит — девичье любопытство пересиливает робость:'
        $ChurchSpyLizetteText += '<br><br>— Хотела бы… узнать, каково это — когда мужчина смотрит на тебя так, как он смотрел тогда в дверях, а не как на сопливую дочку у причала. А хозяин... он интересный. Глуповатый, но интересный.'

    elseif $ChurchSpyLizetteTextId = 'act1_step_3':
        $ChurchSpyLizetteText = '— А прикасалась к себе? Втайне, оставшись одна — после того, как подглядывала за ними через дверь?'
        $ChurchSpyLizetteText += '<br><br>Она едва заметно кивает, пряча зардевшееся лицо:'
        $ChurchSpyLizetteText += '<br><br>— Да... Вспоминала, как он меня подозвал, и как они там... И совестно было, и... всё равно сладко. До дрожи. И хочется повторить.'
        $ChurchSpyLizetteText += '<br><br>Отец Герхард медленно поднимается и опускает тяжёлую ладонь ей на плечо — короткое, весомое прикосновение, лишь на миг притворяющееся отеческим:'
        $ChurchSpyLizetteText += '<br><br>— Ты ещё молода, дитя. Не торопи грех — плоть сама возьмёт своё, когда пробьёт час.'

    elseif $ChurchSpyLizetteTextId = 'intro_2':
        $ChurchSpyLizetteText = 'Сквозь узкую щель приоткрытого окна комнаты чистых сердец видно: Лизетта снова пришла к священнику. На этот раз без тени прежней робости — она стоит у скамьи, подол платья слегка задран, открывая смуглые круглые коленки. Отец Герхард сидит вплотную, не шевелясь и глядя на неё в упор — так, словно заранее знал, что девчонка непременно вернётся.'

    elseif $ChurchSpyLizetteTextId = 'act2_step_1':
        $ChurchSpyLizetteText = '— Дочь моя, наверняка ты опять поддалась искушению со времени нашей прошлой беседы, — говорит отец Герхард и властно опускает тяжёлую ладонь на её обнажённое колено. Пальцы крепко сжимают тёплую смуглую кожу. — Расскажи всё без утайки пред ликом Ильматера. Ничего не скрывай.'
        $ChurchSpyLizetteText += '<br><br>Лизетта вздрагивает, но ноги не убирает. Смуглое личико густо заливает румянец.'
        $ChurchSpyLizetteText += '<br><br>— Ох, падре… грешила. И стыдно признаться, и... мальчишки портовые совсем проходу не дают — то на сеновал зовут, то за рыбные сараи. А как им откажешь, коли телу так приятно?'
        $ChurchSpyLizetteText += '<br><br>Она невольно поводит бёдрами и поглаживает ткань между ног — плоть отзывается на воспоминания раньше языка.'
        $ChurchSpyLizetteText += '<br><br>— Только прошу их каждый раз: внутрь не изливать. А они будто глухие, от похоти рассудок теряют. Всё норовят в самое нутро брызнуть. А если брюхатой останусь? — сдавленно шепчет она, и в её голосе звучит не столько страх, сколько пьянящее возбуждение.'

    elseif $ChurchSpyLizetteTextId = 'act2_step_2':
        $ChurchSpyLizetteText = 'Отец Герхард наставительно и тяжело вздыхает — точно так же, как перед церковной проповедью о воздержании и плотской скверне.'
        $ChurchSpyLizetteText += '<br><br>— Не печалься о грехе, дочь моя, ибо покаяние очищает. Вот мужской уд — подобный тем, с коими ты впадала в соблазн. — Он медленно распахивает полы сутаны, под которой уже упруго вздымается налитый кровью член. — Покажи мне в точности, как ты грешила с ними. Я, слуга всеблагого Ильматера, должен знать каждую подробность, дабы отпустить вину.'
        $ChurchSpyLizetteText += '<br><br>— Падре... всякое бывало... и гладила, и губами ласкала, — Лизетта судорожно сглатывает слюну, не отрывая зачарованного взгляда от священника. — Матушка ведь кое-чему учила...'
        $ChurchSpyLizetteText += '<br><br>— Показывай. Без лукавства.'
        $ChurchSpyLizetteText += '<br><br>Девушка покорно опускается на колени прямо между его бёдер. Несколько мгновений она нерешительно сжимает пальцами горячий ствол, мысленно сравнивая его с мальчишескими, а затем склоняется ниже. Влажные пухлые губы жадно охватывают головку и скользят по гладкой коже; с каждым новым движением девичье смущение тает, а прерывистое дыхание сбивается. Жрец властно опускает широкую ладонь ей на затылок, направляя и не позволяя отстраниться.'

    elseif $ChurchSpyLizetteTextId = 'act2_step_3':
        $ChurchSpyLizetteText = 'Отец Герхард слегка приподнимает её за подбородок, отрывая от члена ровно настолько, чтобы задать следующий вопрос:'
        $ChurchSpyLizetteText += '<br><br>— А что следовало за этим? Снимали ли с тебя панталоны?'
        $ChurchSpyLizetteText += '<br><br>— Сама... сама скидывала, когда от страсти совсем промокали, — шепчет юная мулатка, зардевшись до кончиков ушей. — Прямо как сейчас...'
        $ChurchSpyLizetteText += '<br><br>Не дожидаясь приказа, она запускает тонкие пальцы под юбку и плавным, отточенным движением стягивает влажные панталончики к щиколоткам, сбрасывая их на деревянный пол у скамьи. Жрец следит за каждым её жестом с жадным прищуром — в его взгляде нет и тени пастырского укора, лишь неприкрытое плотское вожделение.'
        $ChurchSpyLizetteText += '<br><br>— И как же они брали тебя дальше?'
        $ChurchSpyLizetteText += '<br><br>— Укладывали на спину... я раздвигала коленки... и они входили в меня... — еле слышно выдавливает Лизетта, пылая щеками.'
        $ChurchSpyLizetteText += '<br><br>— Вот так? — священник решительно опрокидывает её на узкую кожаную кушетку у окна, задирает юбку к самому поясу и одним уверенным, мощным движением вонзается в податливую мокрую плоть.'
        $ChurchSpyLizetteText += '<br><br>— Ах-х, да, падре!.. Именно так! — звонкий, протяжный стон наслаждения срывается с её губ, слишком громкий для священных стен храма.'

    elseif $ChurchSpyLizetteTextId = 'act2_step_4':
        $ChurchSpyLizetteText = 'Священник мерно и напористо вбивается в податливое девичье тело, осыпая её шею и ключицы жадными поцелуями. Тонкая блузка Лизетты оказывается расстёгнутой — трудно даже уловить миг, когда это произошло. Грубые ладони жреца сминают упругую смуглую грудь с торчащими сосками; девушка послушно изгибается навстречу каждому удару, впиваясь ногтями в обивку кушетки и пряча сладострастные стоны в подушку, дабы её голос не разнёсся эхом под сводами собора.'

    elseif $ChurchSpyLizetteTextId = 'act2_step_5':
        $ChurchSpyLizetteText = 'От неустанных ласк и глубоких, неистовых толчков тело Лизетты пронзает сладкая судорога; она мелко вздрагивает и заходится в тонком, прерывистом вскрике первого оргазма. Отец Герхард, шумно и хрипло дыша, тоже приближается к неизбежной развязке.'

        if sluttiness['lizette'] >= 50:
            $ChurchSpyLizetteText += '<br><br>Почувствовав его близкий предел, девушка накрепко обвивает стройными ножками его поясницу и с упоением шепчет прямо в разгорячённое ухо:'
            $ChurchSpyLizetteText += '<br><br>— Кончайте, святой отец… кончайте прямо в меня, я уже всё!..'
            $ChurchSpyLizetteText += '<br><br>Герхард с глухим рыком до упора вдавливает бёдра и щедро изливает горячее семя в глубину её лона. Лизетта сладко выдыхает, жмурясь от удовольствия:'
            $ChurchSpyLizetteText += '<br><br>— Ох, всеблагой Ильматер... как же хорошо было!'
        else:
            $ChurchSpyLizetteText += '<br><br>Почувствовав, как напряглось его тело перед извержением, девушка испуганно хватается за складки сутаны:'
            $ChurchSpyLizetteText += '<br><br>— Ой, только не внутрь, падре… умоляю, не надо… я же понесу!'
            $ChurchSpyLizetteText += '<br><br>Но охваченный похотью жрец даже не думает отстраняться — с хриплым стоном он глубоко изливает своё семя прямо в беззащитную девичью щёлку. Лизетта бессильно роняет голову на подушку, жалобно вздыхая:'
            $ChurchSpyLizetteText += '<br><br>— Вот ведь... сколько парней ни моли вытаскивать вовремя — всё равно каждый норовит в меня кончить...'
        end

    elseif $ChurchSpyLizetteTextId = 'act2_step_6':
        $ChurchSpyLizetteText = 'Отец Герхард неторопливо поднимается, даже не утруждая себя тем, чтобы прикрыть обмякший уд полами сутаны. Лизетта остаётся лежать на кушетке, прерывисто дыша; на её бёдрах и смуглом лобке влажно блестят свежие следы пастырского семени.'

        $ChurchSpyLizetteText += '<br><br>— Приняла ты семя слуги Ильматера под священными сводами храма Его, — с невозмутимым благочестием возвещает жрец, осенив девушку святым кругом. — Сие омовение отпускает грехи твои и дарует благословение, дочь моя. Ступай же с миром. А коль плоть вновь склонит ко греху — приходи за очищением ко мне.'

        $ChurchSpyLizetteText += '<br><br>— Благодарю вас, отец Герхард, — лукаво шепчет мулатка. Она легко соскальзывает с кушетки и начинает неторопливо приводить себя в порядок: натягивает панталончики, застёгивает пуговки блузки и оглаживает подол — словно заново примеряя на себя личину кроткой прихожанки.'

        if GeorgetteConfessLizaSaw = 1:
            $ChurchSpyLizetteText += '<br><br>У самой двери она вдруг задерживается и с лукавым прищуром тихо спрашивает:'
            $ChurchSpyLizetteText += '<br><br>— А признайтесь, святой отец… кто из нас лучше — я или матушка?'
            $ChurchSpyLizetteText += '<br><br>— Обе вы прекрасны, чадо моё, — ни на миг не смутившись, наставительно молвит жрец. — Всякая плоть угодна Ильматеру, коль служит утешению ближнего. А посему и служителю Его вы обе одинаково дороги.'
            $ChurchSpyLizetteText += '<br><br>Лизетта лишь тихо фыркает в ответ, пряча довольную усмешку, и грациозно выскальзывает в соборный коридор, поправляя пышные кудри так, будто только что выслушала самую душеспасительную проповедь.'
        end

    end

    killvar '$ChurchSpyLizetteTextId'
---
