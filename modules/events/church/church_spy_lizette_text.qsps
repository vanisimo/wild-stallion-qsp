! ================================================
! FILE: modules/events/church/church_spy_lizette_text.qsps
! USER-OWNED TEXT — правки игрового текста: владелец-пользователь
! Агентам: НЕ переписывать prose без явного «можно править тексты».
! Перед любой переделкой файла — спросить пользователя; сохранять формулировки.
! MODULE: events/church
! Тексты spy: Лизетта + Герхард (два акта)
! Акт 1: допрос жреца о матери и тайных желаниях
! Акт 2: взрослая исповедь и соитие в комнате чистых сердец
! ================================================

#ChurchSpyLizetteText
    $ChurchSpyLizetteTextId = LCASE($ARGS[0])
    $ChurchSpyLizetteText = ''

    ! ====================== АКТ 1: ПЕРВЫЙ РАЗГОВОР В КЕЛЬЕ ======================

    if $ChurchSpyLizetteTextId = 'intro_1':
        $ChurchSpyLizetteText = 'Лизетта в комнате чистых сердец — без матери, без маски привычной портовой беззаботности. Отец Герхард сидит напротив, внимательно и цепко оглядывая юную смуглянку.'

    elseif $ChurchSpyLizetteTextId = 'act1_step_1':
        $ChurchSpyLizetteText = '— Ты ведь видела мать и хозяина трактира в соборе? — негромко, но властно спрашивает жрец. — Не отводи глаз, дочь моя. Служителю святого круга ты обязана открыть всю правду.'
        $ChurchSpyLizetteText += '<br><br>Лизетта вздрагивает, но в её карих глазах мелькает не испуг, а лукавый блеск:'
        $ChurchSpyLizetteText += '<br><br>— Видела, падре... Она не сопротивлялась. Ей было сладко. А он думал, что кругом ни души. Я всё разглядела, от начала до конца.'

    elseif $ChurchSpyLizetteTextId = 'act1_step_2':
        $ChurchSpyLizetteText = '— И что шевельнулось в твоём сердце? — Герхард подаётся ближе, понижая голос. — Зависть? Или похоть плотская? Хотела бы сама оказаться на её месте — с ним или с другим мужчиной?'
        $ChurchSpyLizetteText += '<br><br>Лизетта зардеется румянцем сквозь смуглую кожу, но дерзко вскидывает подбородок:'
        $ChurchSpyLizetteText += '<br><br>— Хотела, падре... Хотела узнать, каково это — когда взрослый мужчина сжимает тебя так жадно. Смотрит не как на девчонку у причала, а как на желанную женщину.'

    elseif $ChurchSpyLizetteTextId = 'act1_step_3':
        $ChurchSpyLizetteText = '— А потом? Грешила ли ты наедине с собой, вспоминая увиденное соитие?'
        $ChurchSpyLizetteText += '<br><br>Лизетта закусывает губу, глядя прямо на священника:'
        $ChurchSpyLizetteText += '<br><br>— Грешила. Пальцами трогала там, внизу... Вспоминала их стоны, и сладко было так, что дух захватывало.'
        $ChurchSpyLizetteText += '<br><br>Отец Герхард поднимается и кладёт тяжёлую ладонь ей на плечо, задерживая тёплые пальцы у шеи:'
        $ChurchSpyLizetteText += '<br><br>— Похвально твоё чистосердечие. Ты молода, но огонь плоти в тебе уже разгорается. Не противься ему — благодать Ильматера снизойдёт и на твоё покаяние, когда придёт срок.'

    ! ====================== АКТ 2: ВЗРОСЛАЯ ИСПОВЕДЬ И СОИТИЕ ======================

    elseif $ChurchSpyLizetteTextId = 'intro_2':
        $ChurchSpyLizetteText = 'Через приоткрытую потайную створку в комнату чистых сердец открывается превосходный обзор. Лизетта снова здесь. На ней нарядное лёгкое платье с глубоким вырезом, приоткрывающим аппетитную смуглую ложбинку. Подол приподнят, обнажая стройные загорелые бёдра. Отец Герхард сидит в кресле вплотную к ней, его широкая ладонь уже по-хозяйски лежит на её колене, медленно поднимаясь всё выше.'

    elseif $ChurchSpyLizetteTextId = 'act2_step_1':
        $ChurchSpyLizetteText = '— Дочь моя, чует моё сердце, что за эту неделю ты снова поддалась плотскому искушению, — говорит отец Герхард елейным, но требовательным тоном, поглаживая шелковистую кожу её бедра. — Ничего не утаивай от слуги Ильматера. Расскажи всё до единого вздоха!'
        $ChurchSpyLizetteText += '<br><br>Лизетта чуть разводит колени, томно прикрыв веки. В её улыбке нет ни капли стыда — лишь дерзкая, волнующая чувственность:'
        $ChurchSpyLizetteText += '<br><br>— Ох, грешила, святой отец... Истинная правда! В порту от моряков да заезжих купцов отбоя нет. Глазищами так и пожирают, руки распускают, шепчут на ухо всякое бесстыдство... А кровь-то молодая, горячая! Как тут устоять, когда от ласк всё внутри огнём горит?'
        $ChurchSpyLizetteText += '<br><br>Она с томным вздохом проводит ладонью по своему бедру, дразня священника:'
        $ChurchSpyLizetteText += '<br><br>— Сама к ним льну, падре. Сладко это... Никаких сил нет отказать, когда мужская рука под юбку лезет!'

    elseif $ChurchSpyLizetteTextId = 'act2_step_2':
        $ChurchSpyLizetteText = 'Отец Герхард шумно втягивает ноздрями воздух. Его напускная строгость мгновенно сменяется жадным мужским голодом:'
        $ChurchSpyLizetteText += '<br><br>— Не печалься, дочь моя. Служитель святого круга очистит тебя от скверны, но сначала ты должна показать подробно, как грешила! Вот член плотский — подобный тем, коими тебя искушали. Покажи, как ты ублажала блудников!'
        $ChurchSpyLizetteText += '<br><br>Жрец решительно откидывает полу сутаны. Его внушительный, налитый кровью член уже торчит вперёд, горячий и твёрдый.'
        $ChurchSpyLizetteText += '<br><br>— Всё покажу, святой отец, — с лукавой усмешкой шепчет Лизетта. — Мама толк в удовольствиях знает, да и я не промах...'
        $ChurchSpyLizetteText += '<br><br>Она опускается на колени прямо перед ним. Её гибкие смуглые пальчики ласково и уверенно обхватывают пульсирующий ствол, поглаживая бархатистую головку. Затем девушка наклоняется, одаривает Герхарда задорным взглядом из-под ресниц и медленно, с наслаждением обхватывает головку горячими губами. Влажное, аппетитное причмокивание заполняет тишину кельи; её язычок искусно скользит по уздечке, заставляя жреца хрипло постанывать и судорожно сжимать пальцами подлокотники кресла.'

    elseif $ChurchSpyLizetteTextId = 'act2_step_3':
        $ChurchSpyLizetteText = 'Отец Герхард тяжело дышит, зарываясь пальцами в густые волосы девушки, и наконец осторожно приподнимает её за плечи:'
        $ChurchSpyLizetteText += '<br><br>— Довольно уст твоих, искусительница... А одежду сбрасывала перед ними? Стыд девичий забывала?'
        $ChurchSpyLizetteText += '<br><br>— Сама всё сбрасывала, падре, — без тени смущения посмеивается мулатка, поднимаясь с колен. — Зачем лишние тряпки, когда между ножек уже всё течёт? Вот, глядите, разве можно такую красоту прятать?'
        $ChurchSpyLizetteText += '<br><br>Она запускает руки под юбку, стягивает шёлковые панталончики и небрежно роняет их к ногам священника. Высоко подобрав подол платья к самому поясу, Лизетта демонстрирует аккуратный гладкий лобок и сочную, истекающую смазкой щёлку.'
        $ChurchSpyLizetteText += '<br><br>— Ильматер всемилостивый... — благоговейно выдыхает жрец, окинув жадным взглядом её разгорячённое лоно.'
        $ChurchSpyLizetteText += '<br><br>Он увлекает девушку на узкую мягкую кушетку, широко раздвигает её гладкие шоколадные бёдра и одним мощным, уверенным толчком входит в неё до упора.'
        $ChurchSpyLizetteText += '<br><br>— А-а-ах, падре!.. — вырывается у Лизетты громкий, сладострастный стон. — Вот так... прямо до самого донышка!'

    elseif $ChurchSpyLizetteTextId = 'act2_step_4':
        $ChurchSpyLizetteText = 'Отец Герхард начинает мощно и глубоко вбиваться в податливое тело девушки. Скрип кушетки и влажные шлепки плоти о плоть эхом отдаются в келье. Блузка на груди Лизетты распахивается — Герхард жадно впивается губами в её смуглую шею, а широкими ладонями сминает её крепкие, упругие груди с затвердевшими тёмными сосками.'
        $ChurchSpyLizetteText += '<br><br>Лизетта не думает прятаться или сдерживаться: она обвивает стройными ножками его поясницу, прижимая жреца к себе всё сильнее, и ритмично двигает тазом навстречу каждому удару, упиваясь развратным соитием.'

    elseif $ChurchSpyLizetteTextId = 'act2_step_5':
        $ChurchSpyLizetteText = 'От неистовых толчков и терзания груди Лизетта закатывает глаза. Её бёдра начинают мелко и сладко дрожать, а внутренние мышцы жадно пульсируют, сжимая член священника в горячие тиски. Герхард тоже тяжело хрипит, будучи уже на самом краю.'

        if sluttiness['lizette'] >= 50:
            $ChurchSpyLizetteText += '<br><br>Она чувствует, как вздуваются вены на его стояке, и с бесстыдным восторгом шепчет прямо в губы священника:'
            $ChurchSpyLizetteText += '<br><br>— Кончайте, святой отец! Излейте всё благословение... залейте меня до самого края!'
            $ChurchSpyLizetteText += '<br><br>Герхард с яростным рыком вонзается до упора и выстреливает мощную струю горячего семени глубоко в её разверзнутую матку. Лизетта вскрикивает, содрогаясь всем телом от неистового оргазма:'
            $ChurchSpyLizetteText += '<br><br>— О-о-ох, как сладко... святой круг, как же хорошо!'
        else:
            $ChurchSpyLizetteText += '<br><br>Она чувствует его близкую развязку, прижимается к нему всем разгорячённым телом и прерывисто шепчет:'
            $ChurchSpyLizetteText += '<br><br>— Падре... кончайте... я уже не могу!..'
            $ChurchSpyLizetteText += '<br><br>Герхард не сдерживается и с утробным стоном щедро заливает её нутро густыми волнами кипящего семени. Лизетта в экстазе запрокидывает голову, судорожно сжимая пальцами его сутану:'
            $ChurchSpyLizetteText += '<br><br>— Ах-х-х... горячо-то как... прямо внутрь... Ильматер милосердный!..'
        end

    elseif $ChurchSpyLizetteTextId = 'act2_step_6':
        $ChurchSpyLizetteText = 'Отец Герхард с трудом переводит дыхание, медленно выскальзывая из девушки. Густое белое семя лениво вытекает из её влажной щёлки, блестя на внутренней стороне бедер. Жрец с благочестивым величием осеняет её святым кругом, даже не заботясь прикрыть свой обмякший член:'
        $ChurchSpyLizetteText += '<br><br>— Заполнило тебя семя служителя Ильматера во храме Его. Это великая благодать — она очищает плоть твою от всякой скверны и дарует отпущение грехов. Ступай с миром, дочь моя. А коль снова одолеет похоть — приходи ко мне за очищением.'
        $ChurchSpyLizetteText += '<br><br>— Непременно приду, святой отец... — с хитрой, довольной улыбкой мурлычет Лизетта.'
        $ChurchSpyLizetteText += '<br><br>Она легко соскальзывает с кушетки, подбирает панталоны и неторопливо приводит в порядок одежду, застёгивая пуговки на груди и расправляя подол.'

        if GeorgetteConfessLizaSaw = 1:
            $ChurchSpyLizetteText += '<br><br>У самой двери она оборачивается, лукаво прищурив блестящие карие глаза:'
            $ChurchSpyLizetteText += '<br><br>— Кстати, отец Герхард... признайтесь честно: кто из нас горячее — я или маменька?'
            $ChurchSpyLizetteText += '<br><br>Священник, не дрогнув ни единым мускулом лица, наставительно поднимает палец:'
            $ChurchSpyLizetteText += '<br><br>— Обе вы прекрасны, дочь моя. Всякая плоть угодна Ильматеру, коль служит радости и утешению. А значит, и служителю Его вы обе одинаково любы.'
            $ChurchSpyLizetteText += '<br><br>Лизетта звонко и беззаботно смеётся, встряхивая копной тёмных кудрей:'
            $ChurchSpyLizetteText += '<br><br>— Ай да святой отец! Ловко ответили. Ну, до следующей службы! — и с кошачьей грацией выскальзывает в коридор собора.'
        end

    end

    killvar '$ChurchSpyLizetteTextId'
---