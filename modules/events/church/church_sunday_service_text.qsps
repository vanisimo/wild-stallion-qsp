! ================================================
! FILE: modules/events/church/church_sunday_service_text.qsps
! MODULE: events/church
! [AI-WORKED] Текст переработан / дополнен ассистентом
! USER-OWNED TEXT
! Тексты воскресной утренней службы
! ================================================

#ChurchSundayServiceText
    $ChurchServiceTextId = LCASE($ARGS[0])
    $ChurchServiceText = ''

    if $ChurchServiceTextId = 'family':
        $ChurchServiceText = 'Сандра сидит с безупречной осанкой, сложив руки на коленях, но едва ты подсаживаешься ближе, она вполголоса шипит, строго глядя перед собой:<br>— Стефан, выпрямись! И святой круг очерти как положено, перед всем приходом стоим. Не вздумай ссутулиться — мэр Борджиа в первом ряду сидит, незачем позорить наш дом пересудами.'
        $ChurchServiceText += '<br><br>Мелисса сидит рядом, раскрыв молитвенник, но даже не смотрит в строки. Она ловит твой взгляд и негромко, с едкой усмешкой шепчет:<br>— Полюбуйся на почтенных господ в первом ряду. Стоят, благочестиво закатывают глаза к куполу... А вчера в трактире каждый второй из них чуть шею не свернул, пытаясь заглянуть нам под юбки. Святая вера в Ильматера удивительно легко уживается с блудливыми ручонками.'
        $ChurchServiceText += '<br><br>Аманда откровенно изнывает от скуки: теребит кружевной манжет, украдкой зевает в кулачок и то и дело поглядывает ко входу собора, высматривая кого-нибудь поинтереснее отца Герхарда.'

    elseif $ChurchServiceTextId = 'legare':
        $ChurchServiceText = 'Кларисса сидит в первом ряду — безупречная, набожная жена торговца, держащая лицо перед всем городом. Альбер Легаре стоит чуть позади, расправив бархатный дублет.'
        $ChurchServiceText += '<br><br>— Доброго утра, Стефан, — негромко бросает он с масляной ухмылкой, лишь на миг повернув к тебе холёное лицо. Его взгляд тут же скользит мимо твоих плеч — жадно цепляясь за декольте молоденьких прихожанок и задерживаясь на Аманде. — Чудесное утро для службы, не правда ли? В церкви женщины особенно хороши... когда смиренно опускают глазки.'
        $ChurchServiceText += '<br><br>Кларисса даже не поворачивает головы, лишь уголок её губ трогает снисходительная усмешка: к слабостям мужа она относится спокойно — все мужчины таковы, да и отец Герхард на исповеди напоминает, что плотские радости не грех. А раз Альбер заглядывается на чужих девиц, то и сама она вовсе не против внимания молодых крепких парней.'

    elseif $ChurchServiceTextId = 'becky':
        $ChurchServiceText = 'Бекки пришла с детьми и смотрит на алтарь так, будто просит у Ильматера не новых грехов, а хотя бы тишины на неделю.'
        $ChurchServiceText += '<br><br>Инга держится рядом, Эдди — чуть поодаль, краснея чаще, чем кивает. В такие утра даже вдова Блэнкеншип выглядит просто матерью, а не центром сплетен.'

    elseif $ChurchServiceTextId = 'georgette':
        if LizetteChurchWithGeorgette = 1:
            if LizetteProstPort = 1 and LizetteLegarePortSeen >= 1 and EddieSawGeorg >= 1:
                $ChurchServiceText = 'Жоржетта и Лизетта стоят в полутени бокового придела, склонив головы друг к другу. До тебя доносится их приглушённый, откровенный шёпот:'
                $ChurchServiceText += '<br><br>— Альбер-то наш, виноторговец, опять на неделе в порт наведался, — тихо прыскает Лизетта, пряча улыбку за ладонью. — Всё мнит себя молодым жеребцом, жадный до дрожи, а запросов — будто королевскую шлюху нанимает. Зато гонора сколько!'
                $ChurchServiceText += '<br><br>— Ой, помолчи, — усмехается Жоржетта уголком ярко накрашенных губ. — У меня увалень Эдди Блэнкеншип на днях был. Краснел до корней волос, дыхание сбивалось, будто его святым кругом пришибло... Зато монетку оставил честно.'
                $ChurchServiceText += '<br><br>Обе замечают тебя и весело переглядываются, ничуть не смущаясь своих пересудов прямо посреди собора.'
            else:
                $ChurchServiceText = 'Жоржетта держит Лизетту ближе, чем нужно для матери. Дочь улыбается слишком открыто — будто церковь для неё театр, а не стыд.'
                $ChurchServiceText += '<br><br>— Не смотри на хозяина трактира, — шипит Жоржетта. — Смотри на падре. — Но сама улыбается уголком губ, глядя на дверь, за которой после полудня принимают исповеди.'
            end
        else:
            $ChurchServiceText = 'Жоржетта одна в зале — без дочери, спокойно, без притворной смиренности. Она кивнула тебе едва заметно, будто вы уже делите тайну, которую город делает вид, что не замечает.'
        end

    elseif $ChurchServiceTextId = 'inspect_gerhard':
        $ChurchServiceText = 'Отец Герхард стоит у алтаря неподвижно, как колонна. Ряса без пятен, голос ровный — он ведёт службу так, будто каждый грех в зале уже записан у него в памяти.'

    elseif $ChurchServiceTextId = 'inspect_mayor':
        $ChurchServiceText = 'Родриго Борджиа на почётном месте — безупречный костюм, взгляд в пол. Мэр слушает проповедь так, будто завтра снова будет считать налоги и штрафы. Заговорить с ним на службе бесполезно: максимум — короткий кивок.'

    elseif $ChurchServiceTextId = 'inspect_irma':
        $ChurchServiceText = 'Ирма в тени колонны — не молится, а смотрит. Портниха замечает шов на чужом рукаве, красный румянец у вдовы и то, как мэр кашляет в кулак. В церкви она тоже работает — только глазами.'

    elseif $ChurchServiceTextId = 'inspect_becky':
        $ChurchServiceText = 'Бекки Блэнкеншип держит детей ближе, чем требует приличие. Инга стоит смирно, Эдди краснеет чаще, чем кивает. На службе вдова выглядит просто матерью — если не знать, сколько сплетен она собирает за неделю.'

    elseif $ChurchServiceTextId = 'inspect_legare':
        $ChurchServiceText = 'Альбер Легаре и Кларисса — образцовая пара для воскресной службы. Кларисса держит спину безупречно прямо, с лёгким превосходством поглядывая на мужа: к его слабостям она относится без лишней драмы, зная, что и самой себе отказывать в мужском внимании незачем. Альбер же лишь делает вид, что слушает литургию: его блудливый, оценивающий взгляд ни на секунду не задерживается на алтаре, беззастенчиво скользя по фигурам молодых прихожанок.'

    elseif $ChurchServiceTextId = 'inspect_family':
        $ChurchServiceText = 'Твоя семья занимает скамью в среднем ряду. Сандра держит спину прямо, как на параде: статус и приличие для неё закон, хотя внутри она куда спокойнее относится к мирским слабостям, чем пытается казаться перед соседками. Мелисса с холодным сарказмом наблюдает за лицемерием первого ряда, а Аманда откровенно скучает, поправляя подол и высматривая интересных парней у входа.'

    elseif $ChurchServiceTextId = 'inspect_georgette':
        if LizetteChurchWithGeorgette = 1:
            if LizetteProstPort = 1 and LizetteLegarePortSeen >= 1 and EddieSawGeorg >= 1:
                $ChurchServiceText = 'Жоржетта и Лизетта шушукаются у боковой колонны. Лизетта дерзко стреляет глазами по сторонам, а мать с насмешкой слушает её шёпот о ночных клиентах порта. Для обеих этот собор — лишь забавное прикрытие и повод посмеяться над ханжеством горожан.'
            else:
                $ChurchServiceText = 'Жоржетта держит дочь слишком близко к проходу. Лизетта улыбается открыто — для неё собор похож на сцену. Мать шипит вполголоса, но сама улыбается уголком губ, глядя на дверь, за которой после полудня принимают исповеди.'
            end
        else:
            $ChurchServiceText = 'Жоржетта одна у бокового прохода — без дочери, спокойно, без притворной смиренности. Она кивнула вам едва заметно, будто вы уже делите тайну, которую город делает вид, что не замечает.'
        end

    elseif $ChurchServiceTextId = 'inspect_shadow':
        $ChurchServiceText = 'Тень у колонны то вырастает, то сжимается — женщина в тёмном плаще, лицо скрыто. Пахнет дешёвыми духами и солью порта. Имя вы не знаете, но кто-то в зале уже оборачивается.'

    elseif $ChurchServiceTextId = 'mayor':
        $ChurchServiceText = 'Родриго Борджиа сидит на почётном месте и слушает проповедь лицом человека, который завтра снова будет считать налоги. Разговаривать он не собирается — только кивок, если вы слишком долго смотрите.'

    elseif $ChurchServiceTextId = 'irma':
        $ChurchServiceText = 'Ирма прячется в тени колонны — не из стыда, а из привычки наблюдать. Портниха видит, как сидят платья и как говорят губы, и редко ошибается в догадках.'

    elseif $ChurchServiceTextId = 'sermon_default':
        $ChurchServiceText = 'Отец Герхард говорит о чистоте сердца — и о чистоте тела: мыть причинные места, беречь уд и седалище. И о даре Таро — порошке, что Ильматер положил у алтаря: не продаётся, не кончается, берут все с детства, как только появляется первая шерсть. Мужчине — волосы только на лобке, над удом; женщине — снять всё. Так заповедано. Видит не только грех, но и оправдание. Город слушает вполуха — каждый думает о своём.'

    elseif $ChurchServiceTextId = 'sermon_shield_quiet':
        $ChurchServiceText = 'В проповеди есть намёк на щедрого дарителя храма — без имени, без фамилии. Только благодарность «тем, кто помнит о камне и свечах». Ты узнаёшь свой жест.'

    elseif $ChurchServiceTextId = 'sermon_shield_praise':
        $ChurchServiceText = 'Отец Герхард благодарит трактир «Дикий Жеребец» и семью Лонгкоков за щедрый дар. Несколько голов поворачиваются к тебе. Репутация пахнет ладаном.'

    elseif $ChurchServiceTextId = 'rumor_1':
        $ChurchServiceText = 'У задней двери две старухи шепчут о мэре и портнихе. Вы ловите только: «…после танцев…» и «…не первый раз…» — дальше очерчивают круг и замолкают.'

    elseif $ChurchServiceTextId = 'rumor_2':
        $ChurchServiceText = 'Матрос у колонны жалуется, что в порту ночью снова «слишком много материнской заботы». Кто-то хмыкает: мол, дочь красивее матери — и городу это не нравится.'

    elseif $ChurchServiceTextId = 'rumor_3':
        $ChurchServiceText = 'Служка шепчет приходящему купцу, что хозяин «Жеребца» слишком часто смотрит не на проповедь, а на чужие спины. Купец усмехается: в маленьком городе это тоже вера — в чужие слабости.'

    elseif $ChurchServiceTextId = 'rumor_4':
        $ChurchServiceText = 'У боковой двери старик бормочет, что отец Герхард слишком долго принимает одних и тех же женщин в комнате чистых сердец. Сосед дёргает его за рукав: «Ты что, грех на себя берёшь?»'

    elseif $ChurchServiceTextId = 'rumor_5':
        $ChurchServiceText = 'У колонны шепчутся две хозяйки — не из ваших знакомых, платья из переулка у мельницы. Кивают на молодую соседку у входа.'
        $ChurchServiceText += '<br><br>— Мать застала её без Таро… лишняя шерсть, как у зверя, — бормочет одна. — Дар у алтаря всегда есть, а она ленится. В нашем городе так не живут.'

    elseif $ChurchServiceTextId = 'rumor_tavern_scandal':
        $ChurchServiceText = 'Несколько степенных горожан за вашей спиной негромко судачат о делах на Трипербан:'
        $ChurchServiceText += '<br><br>— В «Диком Жеребце» в последнее время совсем стыд потеряли, — сокрушается один из них. — Девки разносят пиво в таких вырезах, что у молодёжи глаза на лоб лезут, а из подсобок по вечерам такие звуки несутся, будто там не трактир, а портовый вертеп. Стефан совсем за порядком не смотрит... Если так пойдёт дальше, отец Герхард прямо с алтаря их помянет.'
        $ChurchServiceText += '<br><br><i>Слухи о вольных нравах в вашем заведении уже докатились до храма.</i>'

    elseif $ChurchServiceTextId = 'rumor_legare_amanda':
        $ChurchServiceText = 'У колонны две кумушки бросают косые взгляды на стоящего неподалёку виноторговца:'
        $ChurchServiceText += '<br><br>— Видала, как Легаре на юную Аманду поглядывает? — шепчет одна. — Сам с женой в церкви стоит, набожного корчит, а на прошлой неделе чуть не каждый день в «Жеребец» бегал. И всё норовит девчонку то за руку прихватить, то на танец позвать. Кларисса-то, бедняжка, лицо держит, а сама вся белая от обиды...'

    elseif $ChurchServiceTextId = 'rumor_done':
        $ChurchServiceText = 'На этой службе ты уже слышал достаточно шёпота. Дальше — те же слова.'

    end

    killvar '$ChurchServiceTextId'
---