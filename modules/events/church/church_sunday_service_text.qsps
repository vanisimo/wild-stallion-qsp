#ChurchSundayServiceText
    $ChurchServiceTextId = LCASE($ARGS[0])
    $ChurchServiceText = ''

    if $ChurchServiceTextId = 'family':
        if HadSex['sandra'] >= 1 or SandraHomeSex = 1:
            $ChurchServiceText = 'Сандра сидит с безупречной осанкой, сложив руки на коленях, но едва ты подсаживаешься ближе, её щёки едва заметно заливает краска. Она не поворачивает головы, строго глядя на алтарь, но её пальцы судорожно стискивают ткань платья:<br>— Стефан, не прижимайся так близко... — вполголоса шепчет она, и голос её на миг предательски вздрагивает. — Выпрямись и очерти святой круг как положено. Мы перед всем приходом стоим, мэр Борджиа в первом ряду... Не смей так смотреть на меня в доме Ильматера. Подумай лучше о молитве, а не о том... что было ночью.'
        else:
            $ChurchServiceText = 'Сандра сидит с безупречной осанкой, сложив руки на коленях, но едва ты подсаживаешься ближе, она вполголоса шипит, строго глядя перед собой:<br>— Стефан, выпрямись! И святой круг очерти как положено, перед всем приходом стоим. Не вздумай ссутулиться — мэр Борджиа в первом ряду сидит, незачем позорить наш дом пересудами.'
        end

        if HadSex['melissa'] >= 1 or MelissaHomeSex = 1:
            $ChurchServiceText += '<br><br>Мелисса сидит рядом, раскрыв молитвенник, но строки её явно не заботят. Почувствовав твоё плечо, она лукаво косится на тебя из-под ресниц, и уголок её губ дёргается в едкой усмешке:<br>— Полюбуйся на почтенных господ в первом ряду, — вкрадчиво шепчет она, слегка задев твоё колено своим сквозь подол платья. — Стоят, благочестиво закатывают глаза к куполу... А вчера в трактире каждый второй из них чуть шею не свернул, пытаясь заглянуть нам под юбки. Впрочем, тебе ли их судить, господин трактирщик? После того, как ты сам без всякого стыда терзал меня в спальне, изображать пред Ильматером праведника — просто смешно. Сиди смирно и держи руки при себе, а не то весь приход заметит, как ты зарделся.'
        else:
            $ChurchServiceText += '<br><br>Мелисса сидит рядом, раскрыв молитвенник, но даже не смотрит в строки. Она ловит твой взгляд и негромко, с едкой усмешкой шепчет:<br>— Полюбуйся на почтенных господ в первом ряду. Стоят, благочестиво закатывают глаза к куполу... А вчера в трактире каждый второй из них чуть шею не свернул, пытаясь заглянуть нам под юбки. Святая вера в Ильматера удивительно легко уживается с блудливыми ручонками.'
        end

        if HadSex['amanda'] >= 1 or AmandaHomeSex = 1:
            $ChurchServiceText += '<br><br>Аманда, едва ты опускаешься на скамью рядом, нервно ёрзает на жёстком дереве и кусает губу, бросая на тебя быстрый, пылающий взгляд. Она украдкой обмахивается пальцами, будто в соборе вдруг стало нестерпимо душно, и тихо, прерывисто шепчет тебе на ухо:<br>— Стефан... прекрати так пялиться, у меня всё тело горит... После твоих ночных безумств мне вообще сидеть больно, а тут ещё эта бесконечная служба! Если матушка заметит, как я на тебя смотрю, она нас обоих заставит на горохе перед алтарём каяться.'
        else:
            $ChurchServiceText += '<br><br>Аманда откровенно изнывает от скуки: теребит кружевной манжет, украдкой зевает в кулачок и то и дело поглядывает ко входу собора, высматривая кого-нибудь поинтереснее отца Герхарда.'
        end

    elseif $ChurchServiceTextId = 'legare':
        $ChurchServiceText = 'Кларисса сидит в первом ряду — безупречная, набожная жена торговца, держащая лицо перед всем городом. Альбер Легаре стоит чуть позади, расправив бархатный дублет.'

