    elseif $ChurchServiceTextId = 'inspect_legare':
        if LegareReconciledWithStefan = 0 and (LegareConflictStage >= 2 or LegarePricesRaised = 1 or LegareWinePressure = 1 or LegareFirstConflictResult = 4 or LegareConflictStage = 7):
            $ChurchServiceText = 'Альбер Легаре и Кларисса стоят в первом ряду, но семейного согласия в их позах нет. Альбер стоит с каменным, перекошенным лицом, сжимая кулаки за спиной: поймав твой взгляд, он одаряет тебя ледяной, ядовитой ненавистью человека, готового задушить трактирщика торговой петлёй.'
        else:
