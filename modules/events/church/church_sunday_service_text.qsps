        else:
            if GeorgetteFuckInChurch = 1 or GeorgetteChurchSexCount >= 1:
                $ChurchServiceText = 'Жоржетта стоит одна в боковом приделе — без тени раскаяния или фальшивого смирения. Завидев тебя, она медленно облизывает яркие губы и с плутовской, порочной усмешкой кивает в сторону дверей ризницы:<br>— Что, Стефан, пришёл покаяться пред Ильматером за то, как бесчинствовал со мной прямо за алтарём? — её шёпот звучит с дерзким вызовом. — Или рассчитываешь повторить, пока падре заливается проповедью?'
            elseif HadSex['georgett'] >= 1 or GeorgettePortSexDone = 1:
                $ChurchServiceText = 'Жоржетта одна в зале — вальяжная, уверенная, не обременённая показным благочестием. Поймав твой взгляд, она усмехается уголком губ и неспешно скользит по тебе оценивающим, чувственным взглядом любовницы, ничуть не стесняясь общей памяти даже посреди прихода.'
            else:
