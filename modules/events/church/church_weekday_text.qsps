! ================================================
! FILE: modules/events/church/church_weekday_text.qsps
! MODULE: events/church
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты церкви в будни
! ================================================

#ChurchWeekdayText
    $ChurchWeekdayTextId = LCASE($ARGS[0])
    $ChurchWeekdayText = ''

    if $ChurchWeekdayTextId = 'inspect_gerhard':
        $ChurchWeekdayText = 'В будний день собор кажется ещё более величественным и отрешённым от суеты. Под высокими стрельчатыми сводами царит благоговейная полутьма, нарушаемая лишь трепетными отблесками восковых свечей да косыми столбами света, пробивающимися сквозь цветные витражи. Воздух здесь густой, прохладный, напоённый горьковатым ароматом ладана, запахом тёсаного векового дуба и сухих трав.'
        $ChurchWeekdayText += '<br><br>Отец Герхард стоит у алтарной преграды в строгом величии. Его тёмная ряса без единого пятнышка падает к самым каменным плитам, а суровое лицо хранит печать глубокого, бесстрастного спокойствия. В будни в нём нет показной торжественности воскресных служб — священник встречает редких прихожан тяжёлым, проницательным взглядом пастыря, видящего не пышные наряды, а скрытую изнанку человеческих душ.'
        $ChurchWeekdayText += '<br><br>Чуть поодаль, в полукруглой нише у массивной колонны, белеют пузатые глиняные кувшины с благословением Ильматера — порошком Таро, пахнущим терпкой травой и щёлочью. Напротив них, подле алтарных ступеней, примостился тяжёлый, окованный потускневшим железом ящик для пожертвований: в дни трудов алтарь молча принимает лепту каждого, кто ищет заступничества или благословения.'

    elseif $ChurchWeekdayTextId = 'donations':
        $ChurchWeekdayText = 'Ты подходишь к ступеням алтаря. Тяжёлый деревянный ящик, сбитый из вековых дубовых досок и скреплённый коваными железными полосами, стоит в полумраке перед образом священного круга. Его тёмная крышка с узкой прорезью отполирована до зеркального блеска ладонями сотен прихожан — от мозолистых рук портовых грузчиков до холёных пальцев гильдейских купцов.'
        $ChurchWeekdayText += '<br><br>Отец Герхард медленно переводит на тебя внимательный, испытующий взор и чуть склоняет седую голову. В соборе нет ни звона монет, ни праздного любопытства толпы — в дни трудов жертва остаётся негромким делом совести. Священник не станет заглядывать в твой кошель, но взгляд его ясно напоминает: всеблагой Ильматер видит не только сам металл, но и то, с каким сердцем ты опускаешь его в щель.'

    elseif $ChurchWeekdayTextId = 'donation_info':
        $ChurchWeekdayText = 'Отец Герхард неслышно складывает руки на груди, очерчивая святой круг, и негромко заговаривает. Его глубокий, низкий голос звучит размеренно, мягко отдаваясь эхом под высокими гулкими сводами собора:'
        $ChurchWeekdayText += '<br><br>— В дни трудов и забот храм принимает дар без шума и суеты, — ровно произносит священник. — Но щедрость человеческая не растворяется в камне. Когда настанет день воскресной службы и весь город соберётся под этими сводами, весть о твоём приношении отзовётся пред народом так, как подобает.'
        $ChurchWeekdayText += '<br><br>— <b>Пять или пятнадцать спинтарий</b> — лепта скромная, но угодная Ильматеру. Пойдёт на масло для лампад, воск да пищу для храмовых послушников. Я не стану тревожить приход твоим именем с кафедры, но благая молитва о доме твоём и твоём очаге вознесётся под купол.'
        $ChurchWeekdayText += '<br><br>— <b>Тридцать спинтарий</b> — жертва весомая, знак того, что трактир заботится о мире с храмом. В воскресенье я произнесу благодарение тем, «кто помнит о камне и свечах обители Ильматера». Ни имени твоего, ни фамилии вслух не прозвучит, но слово пастыря ляжет незримым щитом на твоё заведение, и лишние сплетни утихнут среди прихожан.'
        $ChurchWeekdayText += '<br><br>— <b>Пятьдесят спинтарий</b> — щедрый дар истинного покровителя. За такое приношение подобает воздать честь в открытую. Перед лицом мэра, именитых купцов и простых горожан я громко нареку «Дикий Жеребец» и род Лонгкоков оплотом порядка, чести и благочестия. Слава о таком поступке быстро разлетится по улицам, а репутация твоего дома окрепнет пред всем Верхним городом.'

    elseif $ChurchWeekdayTextId = 'taro_urns':
        $ChurchWeekdayText = 'В глубокой арочной нише соборной стены, вдали от сквозняков и пыли проходов, стоят широкие глиняные кувшины с пористой матовой глазурью. Они доверху наполнены тонко перемолотой, шелковистой сероватой пудрой, источающей едва уловимый, свежий аромат речной глины, полевой полыни и щёлочи.'
        $ChurchWeekdayText += '<br><br>Это порошок Таро — драгоценный дар всеблагого Ильматера, символ чистоты духа и тела. По древнему завету веры, Ильматер не пожелал, чтобы его дети терпели боль от острых лезвий или зарастали дикой шерстью, уподобляясь зверям. Достаточно развести щепоть этой серой пыли чистой водой до состояния нежной кашицы и нанести на кожу: спустя пару минут все нежелательные волоски безболезненно сходят, оставляя кожу безупречно гладкой, чистой и бархатистой.'
        $ChurchWeekdayText += '<br><br>Канон чистоты непреложен для всякого жителя города: женщинам заповедано содержать своё тело в совершенной гладкости от шеи до ступней, мужчинам же предписано начисто снимать волосы на лице, сохраняя лишь аккуратный треугольник на лобке над удом. Неряшливость и лень считаются дикостью и отступлением от заповедей.'
        $ChurchWeekdayText += '<br><br>Порошок у алтаря не иссякает и никогда не продаётся за серебро: каждый горожанин — от богатейшего патриция до бедного портового бродяги — вправе свободно подойти и зачерпнуть из сосудов столько благословенного Таро, сколько потребно его телу.'

    elseif $ChurchWeekdayTextId = 'gerhard_talk':
        $ChurchWeekdayText = 'Отец Герхард на миг задерживает на тебе свой тяжёлый, проницательный взгляд из-под густых бровей. Его руки спокойно лежат на поясе рясы, а голос звучит негромко, но весомо, заполняя пространство между колоннами:'
        $ChurchWeekdayText += '<br><br>— Дар храму принимается в дни трудов и забот, Стефан. В воскресенье я стою перед собравшимся народом с молитвой, а не перед деревянным ящиком с монетами. Если твоё сердце велит помочь обители Ильматера — принеси лепту до рассвета службы, пока суета не заполнила собор. И всеблагой зачтёт твою щедрость в свой час.'

    end

    killvar '$ChurchWeekdayTextId'
---