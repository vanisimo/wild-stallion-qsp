! ================================================
! FILE: modules/events/church/church_weekday_menus.qsps
! MODULE: events/church
! Церковь в будни — меню отца Герхарда в тексте
! ================================================

#ChurchWeekdayEmbedGerhardLink
    gs 'FormatTextByStyle', 'отец Герхард', 'npc_link'
    gs 'NpcTalkIconInline'
    $ChurchWeekdayGerhardLink = $NpcTalkIconInline + ' <a href="exec:gs ''ChurchWeekdayShowGerhardMenu''">' + $FormattedText + '</a>'

    killvar '$FormattedText'
    killvar '$NpcTalkIconInline'
---

#ChurchWeekdayShowGerhardMenu
    gs 'ChurchWeekdayBuildGerhardMenu'
    gs 'Menu.Show', 'ChurchWeekdayGerhardMenu'
---

#GerhardImportantCheck
    GerhardImportantReady = 0
    $GerhardImportantAction = ''

    ! 1. Накладная на партию оружия / расследование по мэру
    if PlayerHasWeaponShipmentInvoice = 1 and GerhardBlackmailTalkDone = 0 and LOC('GerhardBlackmailTalk') = 1:
        GerhardImportantReady = 1
        $GerhardImportantAction = 'blackmail'
        exit
    end

    ! 2. Визит в парадном облачении
    if StefanWearingNobleSuit = 1 and StefanNobleTourGerhardDone = 0 and LOC('StefanNobleTourGerhard') = 1:
        GerhardImportantReady = 1
        $GerhardImportantAction = 'noble_tour'
        exit
    end

    ! 3. Об Аманде
    if GerhardAmandaWarningAvailable = 1 and LOC('ChurchGerhardAmandaConfront') = 1:
        GerhardImportantReady = 1
        $GerhardImportantAction = 'amanda_confront'
        exit
    end
---

#ChurchWeekdayBuildGerhardMenu
    gs 'Menu.Destroy', 'ChurchWeekdayGerhardMenu'
    gs 'Menu.Create', 'ChurchWeekdayGerhardMenu'

    ! ==================== 1. ВАЖНАЯ БЕСЕДА (ЕСЛИ ЕСТЬ) ====================
    if LOC('GerhardImportantCheck') = 1:
        gs 'GerhardImportantCheck'
        if GerhardImportantReady = 1:
            gs 'MenuUiAdd', 'ChurchWeekdayGerhardMenu', 'Важная беседа', 'important'
            gs 'Menu.AddModule', 'ChurchWeekdayGerhardMenu', { gt 'GerhardImportantScreen' }
        end
        killvar 'GerhardImportantReady'
        killvar '$GerhardImportantAction'
    end

    ! ==================== 2. РАЗГОВОР (ВСЕГДА) ====================
    gs 'MenuUiAdd', 'ChurchWeekdayGerhardMenu', 'Разговор', 'talk'
    gs 'Menu.AddModule', 'ChurchWeekdayGerhardMenu', {
        gt 'GerhardChatScreen'
    }

    ! ==================== 3. ПОЖЕРТВОВАТЬ ХРАМУ ====================
    gs 'MenuUiAdd', 'ChurchWeekdayGerhardMenu', 'Пожертвовать храму', 'circle'
    gs 'Menu.AddModule', 'ChurchWeekdayGerhardMenu', {
        gt 'ChurchDonationInfo'
    }
---

#ChurchWeekdayPrintIntro
    gs 'ChurchWeekdayEmbedGerhardLink'

    $ChurchWeekdayIntroText = 'В соборе тихо. У алтаря горят свечи, в проходах пахнет воском и старым деревом. Неподалёку от алтаря стоит ' + $ChurchWeekdayGerhardLink + '.'

    killvar '$ChurchWeekdayGerhardLink'
---

#ChurchWeekdayGerhardInspect
    cls

    gs 'PrintTitleLine', ' ОСМОТР'

    gs 'ShowImage', 'gerhard', 'normal', 'normal'

    *pl ' '

    gs 'ChurchWeekdayText', 'inspect_gerhard'
    *p $ChurchWeekdayText

    *pl ' '

    gs 'ActUiPrepare', 'Назад в зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchInterior'
    end

    killvar '$ChurchWeekdayText'
---