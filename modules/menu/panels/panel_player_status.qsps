! ================================================
! FILE: modules/menu/panel_player_status.qsps
! Стандартное дополнительное описание главного героя
! Использует данные из InitSteve и GetDateTimeNames
! Показывается по умолчанию, если не открыта другая панель
! ================================================

#PanelPlayerStatus
    clr

    gs 'PanelUiBanner', 'item', 'time'
    gs 'PanelUiHeader', 'СТЕФАН ЛОНГКОК'
    gs 'PanelUiDivider'
    pl ' '

    gs 'GetDateTimeNames'

    gs 'UpdatePlayerClothes'

    PanelYearsPassed = year - 1100

    if PanelYearsPassed < 0:
        PanelYearsPassed = 0
    end

    PanelDaysPassed = day - 1

    if PanelDaysPassed < 0:
        PanelDaysPassed = 0
    end

    $PanelTimeText = LCASE($TimeOfDay)

    gs 'PrintPanelLine', 'Сейчас ' + $PanelTimeText + '.'
    gs 'PrintPanelLine', 'Сейчас ' + $WeekDay + ', ' + STR(day) + ' ' + $MonthName + ' ' + STR(year) + ' года.'
    gs 'PrintPanelLine', 'Прошло ' + STR(PanelYearsPassed) + ' лет (' + STR(PanelDaysPassed) + ' дней) от начала игры.'
    pl ' '

    gs 'PrintPanelLine', 'Тебе ' + STR(age) + ' лет.'
    gs 'PrintPanelLine', 'Ты одет в ' + $PlayerClothesDesc + '.'
    gs 'FormatSpintry', money
    $FormatSpintry_money = $FormatSpintry
    killvar '$FormatSpintry'
    gs 'PrintPanelLine', 'У тебя в кошельке ' + $FormatSpintry_money + '.'

    if PlayerVirgin = 1:
        gs 'PrintPanelLine', 'Ты девственник.'
    else:
        gs 'PrintPanelLine', 'У тебя уже был сексуальный опыт.'
        gs 'PrintPanelLine', 'Половых актов: ' + STR(PlayerSexCount) + '.'
    end
    gs 'PrintPanelLine', 'Ты можешь кончить ' + STR(max_daily_cum) + ' раз за день.'
    gs 'PrintPanelLine', 'Сегодня ты кончил ' + STR(daily_cum_count) + ' раз.'

    killvar 'PanelYearsPassed'
    killvar 'PanelDaysPassed'
    killvar '$PanelTimeText'
---

#UpdatePlayerClothes
    if StefanRespectableSuit = 1 and PlayerHasRespectableSuit = 0:
        PlayerHasRespectableSuit = 1
        StefanWearingRespectableSuit = 1
    end

    if StefanWearingNobleSuit = 1 and PlayerHasNobleSuit = 0:
        PlayerHasNobleSuit = 1
    end

    if StefanWearingNobleSuit = 1:
        StefanRespectableSuit = 1
        $PlayerClothesDesc = 'парадный дворянский наряд с фамильным гербом и серебряным шитьём'
        $StefanCurrentSuitName = 'Парадный дворянский наряд'
    elseif StefanWearingRespectableSuit = 1:
        StefanRespectableSuit = 1
        $PlayerClothesDesc = 'приличный тёмный костюм из добротной шерсти от Ирмы'
        $StefanCurrentSuitName = 'Приличный костюм от Ирмы'
    else:
        StefanRespectableSuit = 0
        $PlayerClothesDesc = 'простые холщовые штаны, подпоясанные веревкой и рубаху из грубого полотна'
        $StefanCurrentSuitName = 'Простая повседневная одежда'
    end
---
