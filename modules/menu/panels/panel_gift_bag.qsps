! ================================================
! FILE: modules/menu/panels/panel_gift_bag.qsps
! MODULE: menu/panels
! Панель «Сумка» — подарки в инвентаре игрока
! ================================================

#PanelGiftBag
    PanelCustomActive = 1

    clr

    gs 'PanelUiBanner', 'item', 'bag'
    gs 'PanelUiHeader', ' СУМКА'
    gs 'PanelUiDivider'
    pl ' '

    if GiftInventoryMaxCheap <= 0:
        GiftInventoryMaxCheap = 2
    end

    if GiftInventoryMaxExpensive <= 0:
        GiftInventoryMaxExpensive = 1
    end

    gs 'PanelUiLine', 'Обычные подарки: ' + STR(GiftInventory['gift_cheap']) + ' / ' + STR(GiftInventoryMaxCheap)
    gs 'PanelUiLine', 'Дорогие подарки: ' + STR(GiftInventory['gift_expensive']) + ' / ' + STR(GiftInventoryMaxExpensive)

    gs 'GiftHasAnyInInventory'

    if GiftHasAny = 0:
        pl ' '
        gs 'PanelUiWarnLine', 'Сумка пуста. Подарки покупают у корабля из столицы в порту.'
        killvar 'GiftHasAny'
        exit
    end

    killvar 'GiftHasAny'

    pl ' '
    gs 'GiftBagPanelLine', 'gift_cheap'
    gs 'GiftBagPanelLine', 'gift_expensive'

    pl ' '
    gs 'PanelUiLine', 'Вручить подарок можно через меню девушки — «Подарить подарок».'
---