! ================================================
! FILE: modules/menu/npc/npc_clickable_link.qsps
! Кликабельные имена NPC: иконка «поболтать» + синее крупное имя
! ================================================

#NpcTalkIconInline
    $NpcTalkIconInline = '<span style="color:#C59B3F; font-size:12px; vertical-align:middle; margin-right:4px;">◆</span>'
---

#NpcIntimIconInline
    $NpcIntimIconInline = '<span style="color:#C59B3F; font-size:12px; vertical-align:middle; margin-right:4px;">◆</span>'
---

#FormatNpcIntimLink
    $FmtNpcIntimKey = LCASE($ARGS[0])
    $FmtNpcIntimExec = $ARGS[1]

    if $FmtNpcIntimKey = '':
        killvar '$FmtNpcIntimKey'
        killvar '$FmtNpcIntimExec'
        exit
    end

    if $RealName[$FmtNpcIntimKey] = '':
        $RealName[$FmtNpcIntimKey] = UCASE(MID($FmtNpcIntimKey, 1, 1)) + LCASE(MID($FmtNpcIntimKey, 2))
    end

    if $FmtNpcIntimExec = '':
        $FmtNpcIntimExec = 'gt ''GirlIntimClosedScreen'', ''' + $FmtNpcIntimKey + ''', ''' + $CURLOC + ''''
    end

    gs 'FormatTextByStyle', $RealName[$FmtNpcIntimKey], 'npc_link'
    gs 'NpcIntimIconInline'
    $NpcIntimLink = '<a style="text-decoration:none; color:#C59B3F; font-weight:bold; border-bottom:1px dotted rgba(197,155,63,0.6);" href="exec:' + $FmtNpcIntimExec + '">' + $NpcIntimIconInline + $FormattedText + '</a>'
    $FmtNpcIntimLink = $NpcIntimLink
    killvar '$FormattedText'
    killvar '$NpcIntimIconInline'

    killvar '$FmtNpcIntimKey'
    killvar '$FmtNpcIntimExec'
---

#FormatNpcTalkLink
    $FmtNpcTalkKey = LCASE($ARGS[0])
    $FmtNpcTalkExec = $ARGS[1]

    if $FmtNpcTalkKey = '':
        killvar '$FmtNpcTalkKey'
        killvar '$FmtNpcTalkExec'
        exit
    end

    if $RealName[$FmtNpcTalkKey] = '':
        $RealName[$FmtNpcTalkKey] = UCASE(MID($FmtNpcTalkKey, 1, 1)) + LCASE(MID($FmtNpcTalkKey, 2))
    end

    if $FmtNpcTalkExec = '':
        $FmtNpcTalkExec = 'gs ''NPC_Click'', ''' + $FmtNpcTalkKey + ''''
    end

    gs 'FormatTextByStyle', $RealName[$FmtNpcTalkKey], 'npc_link'
    gs 'NpcTalkIconInline'
    $NpcTalkLink = '<a style="text-decoration:none; color:#C59B3F; font-weight:bold; border-bottom:1px dotted rgba(197,155,63,0.6);" href="exec:' + $FmtNpcTalkExec + '">' + $NpcTalkIconInline + $FormattedText + '</a>'
    $FmtNpcTalkLink = $NpcTalkLink
    killvar '$FormattedText'
    killvar '$NpcTalkIconInline'

    killvar '$FmtNpcTalkKey'
    killvar '$FmtNpcTalkExec'
---

#NpcClickableLink
    $group = LCASE($Args[0])

    if $group = 'family' or $group = 'семья':
        gs 'NpcClickableLink', 'sandra'
        gs 'NpcClickableLink', 'melissa'
        gs 'NpcClickableLink', 'amanda'
        killvar '$group'
        exit
    end

    if $group = 'all' or $group = 'все' or $group = 'girls':
        counter = 0
        :loopgirls
        if counter < arrsize('$AllGirlNames'):
            gs 'NpcClickableLink', $AllGirlNames[counter]
            counter += 1
            jump 'loopgirls'
        end
        killvar '$group'
        exit
    end

    $girl = LCASE($Args[0])
    gs 'FormatNpcTalkLink', $girl
    *pl $NpcTalkLink
    killvar '$girl'
    killvar '$group'
    killvar '$NpcTalkLink'
---

#NpcMenuTalkOpenLink
    $NpcTalkOpenLabel = $ARGS[0]
    $NpcTalkOpenGirl = LCASE($ARGS[1])
    $NpcTalkOpenLoc = $ARGS[2]
    $NpcTalkOpenOutput = LCASE($ARGS[3])
    $NpcTalkOpenReturnLoc = $ARGS[4]

    if $NpcTalkOpenGirl = '' or $NpcTalkOpenLabel = '':
        killvar '$NpcTalkOpenLabel'
        killvar '$NpcTalkOpenGirl'
        killvar '$NpcTalkOpenLoc'
        killvar '$NpcTalkOpenOutput'
        exit
    end

    if $NpcTalkOpenLoc = '':
        $NpcTalkOpenLoc = $CURLOC
    end

    if $NpcTalkOpenOutput = '':
        $NpcTalkOpenOutput = 'main'
    end

    if $NpcTalkOpenReturnLoc = '':
        $NpcTalkOpenReturnLoc = $NpcTalkOpenLoc
    end

    gs 'FormatTextByStyle', $NpcTalkOpenLabel, 'npc_link'
    gs 'NpcTalkIconInline'
    $NpcTalkOpenHref = '<a style="text-decoration:none; color:#C59B3F; font-weight:bold; border-bottom:1px dotted rgba(197,155,63,0.6);" href="exec:gs ''GirlTalkOpenNpcMenu'', ''' + $NpcTalkOpenGirl + ''', ''' + $NpcTalkOpenLoc + ''', ''' + $NpcTalkOpenReturnLoc + '''">' + $NpcTalkIconInline + $FormattedText + '</a>'
    killvar '$FormattedText'
    killvar '$NpcTalkIconInline'
    $NpcTalkOpenLine = $NpcTalkOpenHref

    killvar '$NpcTalkOpenLabel'
    killvar '$NpcTalkOpenGirl'
    killvar '$NpcTalkOpenLoc'
    killvar '$NpcTalkOpenOutput'
    killvar '$NpcTalkOpenReturnLoc'
    killvar '$NpcTalkOpenHref'
---

#NpcMenuIntimOpenLink
    $NpcIntimOpenLabel = $ARGS[0]
    $NpcIntimOpenGirl = LCASE($ARGS[1])
    $NpcIntimOpenLoc = $ARGS[2]
    $NpcIntimOpenOutput = LCASE($ARGS[3])

    if $NpcIntimOpenGirl = '' or $NpcIntimOpenLabel = '':
        killvar '$NpcIntimOpenLabel'
        killvar '$NpcIntimOpenGirl'
        killvar '$NpcIntimOpenLoc'
        killvar '$NpcIntimOpenOutput'
        exit
    end

    if $NpcIntimOpenLoc = '':
        $NpcIntimOpenLoc = $CURLOC
    end

    if $NpcIntimOpenOutput = '':
        $NpcIntimOpenOutput = 'main'
    end

    gs 'FormatTextByStyle', $NpcIntimOpenLabel, 'npc_link'
    gs 'NpcIntimIconInline'
    $NpcIntimOpenHref = '<a style="text-decoration:none; color:#C59B3F; font-weight:bold; border-bottom:1px dotted rgba(197,155,63,0.6);" href="exec:gs ''GirlIntimOpenNpcMenu'', ''' + $NpcIntimOpenGirl + ''', ''' + $NpcIntimOpenLoc + '''">' + $NpcIntimIconInline + $FormattedText + '</a>'
    killvar '$FormattedText'
    killvar '$NpcIntimIconInline'
    $NpcIntimOpenLine = $NpcIntimOpenHref

    killvar '$NpcIntimOpenLabel'
    killvar '$NpcIntimOpenGirl'
    killvar '$NpcIntimOpenLoc'
    killvar '$NpcIntimOpenOutput'
    killvar '$NpcIntimOpenHref'
    killvar '$NpcIntimOpenLine'
---

#NpcMenuIntimOpenIconLink
    $NpcIntimIconGirl = LCASE($ARGS[0])
    $NpcIntimIconLoc = $ARGS[1]
    $NpcIntimIconReturnLoc = $ARGS[2]

    if $NpcIntimIconGirl = '':
        killvar '$NpcIntimIconGirl'
        killvar '$NpcIntimIconLoc'
        killvar '$NpcIntimIconReturnLoc'
        exit
    end

    if $NpcIntimIconLoc = '':
        $NpcIntimIconLoc = $CURLOC
    end

    if $ARGS[3] <> '':
        $NpcIntimIconReturnLoc = $ARGS[3]
    end

    if $NpcIntimIconReturnLoc = '' or $NpcIntimIconReturnLoc = 'main' or LOC($NpcIntimIconReturnLoc) = 0:
        $NpcIntimIconReturnLoc = $NpcIntimIconLoc
    end

    if LOC($NpcIntimIconReturnLoc) = 0:
        $NpcIntimIconReturnLoc = 'TavernMain'
    end

    gs 'NpcIntimIconInline'
    $NpcIntimOpenIconLine = '<a href="exec:gs ''GirlIntimOpenNpcMenu'', ''' + $NpcIntimIconGirl + ''', ''' + $NpcIntimIconLoc + ''', ''' + $NpcIntimIconReturnLoc + '''">' + $NpcIntimIconInline + '</a>'

    killvar '$NpcIntimIconGirl'
    killvar '$NpcIntimIconLoc'
    killvar '$NpcIntimIconReturnLoc'
    killvar '$NpcIntimIconInline'
---

#NpcMenuLink
    $NpcMenuLabel = $ARGS[0]
    $NpcMenuName = $ARGS[1]
    $NpcMenuOutputTarget = LCASE($ARGS[2])

    if $NpcMenuLabel = '' or $NpcMenuName = '':
        killvar '$NpcMenuLabel'
        killvar '$NpcMenuName'
        killvar '$NpcMenuOutputTarget'
        exit
    end

    if $NpcMenuOutputTarget = '':
        $NpcMenuOutputTarget = 'main'
    end

    gs 'FormatTextByStyle', $NpcMenuLabel, 'npc_link'
    gs 'NpcTalkIconInline'
    $NpcMenuHref = '<a style="text-decoration:none; color:#C59B3F; font-weight:bold; border-bottom:1px dotted rgba(197,155,63,0.6);" href="exec:gs ''Menu.Show'', ''' + $NpcMenuName + '''">' + $NpcTalkIconInline + $FormattedText + '</a>'
    killvar '$FormattedText'
    killvar '$NpcTalkIconInline'
    $NpcMenuLine = $NpcMenuHref

    if $NpcMenuOutputTarget = 'panel':
        pl $NpcMenuLine
    else:
        *pl $NpcMenuLine
    end

    killvar '$NpcMenuLabel'
    killvar '$NpcMenuName'
    killvar '$NpcMenuOutputTarget'
    killvar '$NpcMenuHref'
    killvar '$NpcMenuLine'
---

#NpcMenuIntimLink
    $NpcIntimMenuLabel = $ARGS[0]
    $NpcIntimMenuName = $ARGS[1]
    $NpcIntimMenuOutputTarget = LCASE($ARGS[2])

    if $NpcIntimMenuLabel = '' or $NpcIntimMenuName = '':
        killvar '$NpcIntimMenuLabel'
        killvar '$NpcIntimMenuName'
        killvar '$NpcIntimMenuOutputTarget'
        exit
    end

    if $NpcIntimMenuOutputTarget = '':
        $NpcIntimMenuOutputTarget = 'main'
    end

    gs 'FormatTextByStyle', $NpcIntimMenuLabel, 'npc_link'
    gs 'NpcIntimIconInline'
    $NpcIntimMenuHref = '<a style="text-decoration:none; color:#C59B3F; font-weight:bold; border-bottom:1px dotted rgba(197,155,63,0.6);" href="exec:gs ''Menu.Show'', ''' + $NpcIntimMenuName + '''">' + $NpcIntimIconInline + $FormattedText + '</a>'
    killvar '$FormattedText'
    killvar '$NpcIntimIconInline'
    $NpcIntimMenuLine = $NpcIntimMenuHref

    if $NpcIntimMenuOutputTarget = 'panel':
        pl $NpcIntimMenuLine
    else:
        *pl $NpcIntimMenuLine
    end

    killvar '$NpcIntimMenuLabel'
    killvar '$NpcIntimMenuName'
    killvar '$NpcIntimMenuOutputTarget'
    killvar '$NpcIntimMenuHref'
    killvar '$NpcIntimMenuLine'
---

#NpcNavLink
    $NpcNavLabel = $ARGS[0]
    $NpcNavIcon = LCASE($ARGS[1])
    $NpcNavExec = $ARGS[2]
    $NpcNavOutputTarget = LCASE($ARGS[3])

    if $NpcNavLabel = '' or $NpcNavExec = '':
        killvar '$NpcNavLabel'
        killvar '$NpcNavIcon'
        killvar '$NpcNavExec'
        killvar '$NpcNavOutputTarget'
        exit
    end

    if $NpcNavOutputTarget = '':
        $NpcNavOutputTarget = 'main'
    end

    if $NpcNavIcon = 'intim':
        gs 'NpcIntimIconInline'
        $NpcNavIconInline = $NpcIntimIconInline
    else:
        gs 'NpcTalkIconInline'
        $NpcNavIconInline = $NpcTalkIconInline
    end

    gs 'FormatTextByStyle', $NpcNavLabel, 'npc_link'
    $NpcNavHref = '<a style="text-decoration:none; color:#C59B3F; font-weight:bold; border-bottom:1px dotted rgba(197,155,63,0.6);" href="exec:' + $NpcNavExec + '">' + $NpcNavIconInline + $FormattedText + '</a>'
    killvar '$FormattedText'
    killvar '$NpcNavIconInline'

    $NpcNavLine = $NpcNavHref

    if $NpcNavOutputTarget = 'panel':
        pl $NpcNavLine
    else:
        *pl $NpcNavLine
    end

    killvar '$NpcNavLabel'
    killvar '$NpcNavIcon'
    killvar '$NpcNavExec'
    killvar '$NpcNavOutputTarget'
    killvar '$NpcNavHref'
    killvar '$NpcNavIconInline'
    killvar '$NpcNavLine'
---

#GetMenuOpenLinkHref
    $MenuOpenLinkName = $ARGS[0]
    $MenuOpenLinkLabel = $ARGS[1]
    $MenuOpenLinkHref = ''

    if $MenuOpenLinkName = '':
        killvar '$MenuOpenLinkName'
        killvar '$MenuOpenLinkLabel'
        exit
    end

    if $MenuOpenLinkLabel = '':
        $MenuOpenLinkLabel = 'выбрать действие'
    end

    gs 'FormatTextByStyle', $MenuOpenLinkLabel, 'npc_link'
    $MenuOpenLinkHref = '<a href="exec:gs ''Menu.Show'', ''' + $MenuOpenLinkName + '''">' + $FormattedText + '</a>'
    killvar '$FormattedText'

    killvar '$MenuOpenLinkName'
    killvar '$MenuOpenLinkLabel'
---

#GetNpcGtLinkHref
    $NpcGtLinkLabel = $ARGS[0]
    $NpcGtLinkExec = $ARGS[1]
    $NpcGtLinkHref = ''

    if $NpcGtLinkLabel = '' or $NpcGtLinkExec = '':
        killvar '$NpcGtLinkLabel'
        killvar '$NpcGtLinkExec'
        exit
    end

    gs 'FormatTextByStyle', $NpcGtLinkLabel, 'npc_link'
    $NpcGtLinkHref = '<a href="exec:' + $NpcGtLinkExec + '">' + $FormattedText + '</a>'
    killvar '$FormattedText'

    killvar '$NpcGtLinkLabel'
    killvar '$NpcGtLinkExec'
---

#PrintThoughtMenuPromptP
    $ThoughtMenuPromptName = $ARGS[0]
    $ThoughtMenuPromptLabel = $ARGS[1]
    $ThoughtMenuPromptBody = $ARGS[2]
    $ThoughtMenuPromptBefore = $ARGS[3]
    $ThoughtMenuPromptAfter = $ARGS[4]

    if $ThoughtMenuPromptBody = '':
        killvar '$ThoughtMenuPromptName'
        killvar '$ThoughtMenuPromptLabel'
        killvar '$ThoughtMenuPromptBody'
        killvar '$ThoughtMenuPromptBefore'
        killvar '$ThoughtMenuPromptAfter'
        exit
    end

    if $ThoughtMenuPromptBefore = '':
        $ThoughtMenuPromptBefore = 'что же '
    end

    if $ThoughtMenuPromptAfter = '':
        $ThoughtMenuPromptAfter = ' делать: '
    end

    gs 'GetMenuOpenLinkHref', $ThoughtMenuPromptName, $ThoughtMenuPromptLabel
    gs 'FormatTextByStyle', $ThoughtMenuPromptBefore + $MenuOpenLinkHref + $ThoughtMenuPromptAfter + $ThoughtMenuPromptBody, 'thought'
    *p $FormattedText

    killvar '$FormattedText'
    killvar '$MenuOpenLinkHref'
    killvar '$ThoughtMenuPromptName'
    killvar '$ThoughtMenuPromptLabel'
    killvar '$ThoughtMenuPromptBody'
    killvar '$ThoughtMenuPromptBefore'
    killvar '$ThoughtMenuPromptAfter'
---

#PrintMenuOpenLink
    $PrintMenuOpenName = $ARGS[0]
    $PrintMenuOpenLabel = $ARGS[1]

    if $PrintMenuOpenName = '':
        killvar '$PrintMenuOpenName'
        killvar '$PrintMenuOpenLabel'
        exit
    end

    if $PrintMenuOpenLabel = '':
        $PrintMenuOpenLabel = 'выбрать действие'
    end

    gs 'FormatTextByStyle', $PrintMenuOpenLabel, 'npc_link'
    $PrintMenuOpenHref = '<a href="exec:gs ''Menu.Show'', ''' + $PrintMenuOpenName + '''">' + $FormattedText + '</a>'
    killvar '$FormattedText'

    gs 'NpcTalkIconInline'
    *p $NpcTalkIconInline + ' ' + $PrintMenuOpenHref

    killvar '$PrintMenuOpenName'
    killvar '$PrintMenuOpenLabel'
    killvar '$PrintMenuOpenHref'
    killvar '$NpcTalkIconInline'
---