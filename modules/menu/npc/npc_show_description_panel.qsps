! ================================================
! FILE: modules/menu/npc_show_description_panel.qsps
! Полное описание NPC в дополнительном описании
! Не очищает главное окно
! Не закрывает текущую локацию
! ================================================

#NpcShowDescriptionPanel
    PanelCustomActive = 1

    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlName = $GirlKey

    if $GirlName = '':
        msg 'Ошибка: NpcShowDescriptionPanel вызван без имени NPC.'
        exit
    end

    if LOC('EnsureGirlData') = 1:
        gs 'EnsureGirlData', $GirlName
    end

    if $RealName[$GirlName] = '':
        $RealName[$GirlName] = UCASE(MID($GirlName, 1, 1)) + LCASE(MID($GirlName, 2))
    end

    clr

    gs 'PanelUiHeader', 'ОПИСАНИЕ: ' + $RealName[$GirlName]
    gs 'PanelUiDivider'
    pl ' '

    gs 'ShowPortraitToPanel', $GirlName, 'small'

    if $girltextdesc[$GirlName] <> '':
        pl $girltextdesc[$GirlName]
        pl ' '
    end

    pl 'Возраст: ' + STR(age[$GirlName]) + ' лет'
    pl 'Красота: ' + STR(beauty[$GirlName])
    pl 'Дружба: ' + STR(Friends[$GirlName])
    pl 'Любовь: ' + STR(love[$GirlName])
    pl 'Страх: ' + STR(fear[$GirlName])
    pl 'Ненависть: ' + STR(hate[$GirlName])
    pl 'Откровенность: ' + STR(otkroven[$GirlName])
    pl 'Развращённость: ' + STR(sluttiness[$GirlName])
    pl ' '

    if virginity[$GirlName] = 1:
        pl 'Вагинальная девственница'
    else:
        pl 'Вагинально опытна'
    end

    if analvirgin[$GirlName] = 1:
        pl 'Анальная девственница'
    else:
        pl 'Анально опытна'
    end

    pl ' '

    pl 'Навыки:'
    pl 'Кулинария: ' + FUNC('ArtLevelText', cooking[$GirlName])
    pl 'Уборка: ' + FUNC('ArtLevelText', cleaning[$GirlName])
    pl 'Обслуживание: ' + FUNC('ArtLevelText', waitress[$GirlName])
    pl 'Соблазнение: ' + FUNC('ArtLevelText', seduction[$GirlName])

    if dance[$GirlName] > 0:
        pl 'Танцы: ' + FUNC('ArtLevelText', dance[$GirlName])
    end

    pl ' '

    pl 'Текущая работа:'

    if jobkitchen[$GirlName] = 1:
        pl 'Работает на кухне'
    end

    if jobwaitress[$GirlName] = 1:
        pl 'Работает официанткой'
    end

    if jobcleaning[$GirlName] = 1:
        pl 'Работает уборщицей'
    end

    if jobwhore[$GirlName] = 1:
        pl 'Работает шлюхой'
    end

    if jobkitchen[$GirlName] = 0 and jobwaitress[$GirlName] = 0 and jobcleaning[$GirlName] = 0 and jobwhore[$GirlName] = 0:
        pl 'Сейчас свободна'
    end

    if $GirlName = 'amanda' or $GirlName = 'melissa' or $GirlName = 'sandra':
        pl ' '
        if GirlWorkPolicy[$GirlName] = 3:
            $DescPolName = 'раскованно'
        elseif GirlWorkPolicy[$GirlName] = 2:
            $DescPolName = 'по обстановке'
        else:
            $DescPolName = 'сдержанно'
        end
        pl 'Поведение в зале: <a href="exec:gs ''GirlWorkPolicyPanelCycle'', ''' + $GirlName + ''', ''desc_panel''">[' + $DescPolName + ']</a>'
        pl ' '

        pl '<b>Действующие правила:</b>'
        if $GirlName = 'amanda':
            if AmandaProhibitGuys = 1:
                pl '• Встречи с парнями: <b>Запрещены</b>'
            else:
                pl '• Встречи с парнями: Разрешены'
            end

            gs 'GirlTalkPersonalLegareBanned'
            if GirlTalkPersonalLegareBanned = 1:
                pl '• Общение с Легаре: <b>Запрещено</b>'
            else:
                pl '• Общение с Легаре: Разрешено'
            end
            killvar 'GirlTalkPersonalLegareBanned'

            if LizetteBanned = 1:
                pl '• Общение с Лизеттой: <b>Запрещено</b>'
            else:
                pl '• Общение с Лизеттой: Разрешено'
            end

            if GirlNoPantiesWork['amanda'] = 1:
                pl '• Ношение белья в зале: <b>Запрещено (без белья)</b>'
            else:
                pl '• Ношение белья в зале: Разрешено'
            end

        elseif $GirlName = 'melissa':
            if MelissaProhibitMinstrel = 1:
                pl '• Встречи с менестрелем: <b>Запрещены</b>'
            else:
                pl '• Встречи с менестрелем: Разрешены'
            end

            if MelissaProhibitGuys = 1:
                pl '• Вечерние прогулки: <b>Запрещены</b>'
            else:
                pl '• Вечерние прогулки: Разрешены'
            end

            if GirlNoPantiesWork['melissa'] = 1:
                pl '• Ношение белья в зале: <b>Запрещено (без белья)</b>'
            else:
                pl '• Ношение белья в зале: Разрешено'
            end

        elseif $GirlName = 'sandra':
            if GirlNoPantiesWork['sandra'] = 1:
                pl '• Ношение белья: <b>Запрещено (без белья)</b>'
            else:
                pl '• Ношение белья: Разрешено'
            end
        end

        killvar '$DescPolName'
    end

    pl ' '
    gs 'PanelUiDivider'

    killvar '$GirlName'
---

