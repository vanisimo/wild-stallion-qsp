! ================================================
! FILE: modules/menu/show_girl_sidebar.qsps
! Краткая информация о девушке в дополнительном описании
! Не очищает главное окно
! Использует NormalizeGirlKey для защиты от русских имён
! ================================================

#ShowGirlSidebar
    PanelCustomActive = 1

    gs 'NormalizeGirlKey', $ARGS[0]
    $GirlName = $GirlKey

    if $GirlName = '':
        exit
    end

    if LOC('EnsureGirlData') = 1:
        gs 'EnsureGirlData', $GirlName
    end

    if $RealName[$GirlName] = '':
        $RealName[$GirlName] = UCASE(MID($GirlName, 1, 1)) + LCASE(MID($GirlName, 2))
    end

    clr

    gs 'PanelUiHeader', $RealName[$GirlName]
    gs 'PanelUiDivider'
    pl ' '

    gs 'ShowPortraitToPanel', $GirlName, 'small'

    pl 'Красота: ' + STR(beauty[$GirlName])
    pl 'Развращённость: ' + STR(sluttiness[$GirlName])
    pl 'Дружба: ' + STR(Friends[$GirlName])
    pl 'Любовь: ' + STR(love[$GirlName])
    pl 'Страх: ' + STR(fear[$GirlName])
    pl 'Ненависть: ' + STR(hate[$GirlName])
    pl ' '

    if $GirlName = 'amanda' or $GirlName = 'melissa' or $GirlName = 'sandra':
        if $GirlName = 'amanda':
            GirlSidebarWallet = AmandaMoney
        elseif $GirlName = 'melissa':
            GirlSidebarWallet = MelissaMoney
        else:
            GirlSidebarWallet = SandraMoney
        end

        gs 'FormatSpintry', GirlSidebarWallet
        $FormatSpintry_GirlSidebarWallet = $FormatSpintry
        killvar '$FormatSpintry'
        pl 'Кошелёк: ' + $FormatSpintry_GirlSidebarWallet
        pl ' '

        if GirlWorkPolicy[$GirlName] = 3:
            $SidebarPolName = 'раскованно'
        elseif GirlWorkPolicy[$GirlName] = 2:
            $SidebarPolName = 'по обстановке'
        else:
            $SidebarPolName = 'сдержанно'
        end
        pl 'Поведение в зале: <a href="exec:gs ''GirlWorkPolicyPanelCycle'', ''' + $GirlName + ''', ''sidebar''">[' + $SidebarPolName + ']</a>'
        pl ' '

        pl '<b>Действующие правила:</b>'
        if $GirlName = 'amanda':
            if AmandaProhibitGuys = 1:
                pl '• Встречи с парнями: <b>Запрещены</b>'
            else:
                pl '• Встречи с парнями: Разрешены'
            end

            gs 'GirlTalkPersonalLegareBanned'
            if GirlTalkPersonalLegareBanned = 1:
                pl '• Общение с Легаре: <b>Запрещено</b>'
            else:
                pl '• Общение с Легаре: Разрешено'
            end
            killvar 'GirlTalkPersonalLegareBanned'

            if LizetteBanned = 1:
                pl '• Общение с Лизеттой: <b>Запрещено</b>'
            else:
                pl '• Общение с Лизеттой: Разрешено'
            end

            if GirlNoPantiesWork['amanda'] = 1:
                pl '• Ношение белья в зале: <b>Запрещено (без белья)</b>'
            else:
                pl '• Ношение белья в зале: Разрешено'
            end

        elseif $GirlName = 'melissa':
            if MelissaProhibitMinstrel = 1:
                pl '• Встречи с менестрелем: <b>Запрещены</b>'
            else:
                pl '• Встречи с менестрелем: Разрешены'
            end

            if MelissaProhibitGuys = 1:
                pl '• Вечерние прогулки: <b>Запрещены</b>'
            else:
                pl '• Вечерние прогулки: Разрешены'
            end

            if GirlNoPantiesWork['melissa'] = 1:
                pl '• Ношение белья в зале: <b>Запрещено (без белья)</b>'
            else:
                pl '• Ношение белья в зале: Разрешено'
            end

        elseif $GirlName = 'sandra':
            if GirlNoPantiesWork['sandra'] = 1:
                pl '• Ношение белья: <b>Запрещено (без белья)</b>'
            else:
                pl '• Ношение белья: Разрешено'
            end
        end
        pl ' '

        killvar 'GirlSidebarWallet'
        killvar '$FormatSpintry_GirlSidebarWallet'
        killvar '$SidebarPolName'
    end

    if virginity[$GirlName] = 1:
        pl 'Девственница'
    else:
        pl 'Опытная'
    end

    pl ' '
    gs 'PanelUiDivider'

    killvar '$GirlName'
---

