#DraupnirTalkIntroText
    DraupnirKnowsAffair = 0
    if PlayerKnows_SandraDraupnirFriday = 1 or PlayerKnows_SandraDraupnirAffair = 1 or SandraCarpenterSecret = 1:
        DraupnirKnowsAffair = 1
