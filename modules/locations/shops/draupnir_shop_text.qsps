#DraupnirShopText
    DraupnirShopVisitVar = ARGS[0]
    DraupnirKnowsAffair = 0
    if PlayerKnows_SandraDraupnirFriday = 1 or PlayerKnows_SandraDraupnirAffair = 1 or SandraCarpenterSecret = 1:
        DraupnirKnowsAffair = 1
    end

    if DraupnirShopVisitVar = 0:
        if DraupnirKnowsAffair = 1:
            if FamilyCorruptionStage >= 3:
                *pl 'Стружка хрустит под сапогом, едва ты переступаешь порог. Солнечный луч пробивается сквозь запылённое окно, и в нём медленно кружится пыльца. На верстаке лежит тяжёлая дубовая доска — свежая, с ровным спилом.'
                *pl ' '
                *pl 'Драупнир отрывает взгляд от работы. В его глазах — весёлый прищур.'
                *pl ' '
                *pl '— Заглянул, хозяин? — гном откладывает рубанок и вытирает ладони о кожаный фартук. — В трактире всё ровно, мать не гоняет?'
                *pl ' '
                *pl 'Ты усмехаешься. С таким прищуром он смотрит только когда в голове у него что-то своё, понимающее.'
                *pl ' '
            else:
                *pl 'Стружка хрустит под сапогом, едва ты переступаешь порог. Солнечный луч пробивается сквозь запылённое окно, и в нём медленно кружится пыльца. На верстаке лежит тяжёлая дубовая доска — свежая, с ровным спилом.'
                *pl ' '
                *pl 'Драупнир поднимает голову. Седая борода заплетена в тугую косицу, взгляд спокойный, без лишнего тепла, но и без холода.'
                *pl ' '
                *pl '— Заходи, Стефан. Без стука, свои люди.'
                *pl ' '
                *pl 'Ты киваешь. Гном возвращается к доске, но плечи его чуть расслаблены — он не против компании.'
                *pl ' '
            end
        else:
            *pl 'Стружка хрустит под сапогом, едва ты переступаешь порог. Солнечный луч пробивается сквозь запылённое окно, и в нём медленно кружится пыльца. На верстаке лежит тяжёлая дубовая доска — свежая, с ровным спилом.'
            *pl ' '
            *pl 'Драупнир стоит над верстаком, уперев ладони в столешницу. Седая борода заплетена в тугую косицу, кустистые брови нависают над глазами. Он оглядывает тебя с головы до ног и басовито спрашивает:'
            *pl ' '
            *pl '— Что хотел, хозяин?'
            *pl ' '
            *pl 'Ты делаешь шаг вперёд. Гном не двигается с места, ждёт.'
            *pl ' '
        end
    else:
        if DraupnirKnowsAffair = 1:
            if FamilyCorruptionStage >= 3:
                *pl 'Драупнир прогоняет рубанок по кромке бруса — длинная стружка завивается спиралью и падает на пол. Гном кивает тебе по-свойски, не прерывая движения.'
                *pl ' '
                *pl '— Стефан. — Он сдувает опилки с древесины и щурится. — Смотрю, держишься крепко. Это хорошо. Крепкая работа любит крепкие руки.'
                *pl ' '
                *pl 'Ты хмыкаешь. Гном откладывает рубанок и поворачивается к тебе всем корпусом.'
                *pl ' '
                *pl '— По делу пришёл или передохнуть от гомона в зале?'
                *pl ' '
            else:
                *pl 'Драупнир прогоняет рубанок по кромке бруса — длинная стружка завивается спиралью и падает на пол. Гном кивает тебе по-свойски, не прерывая движения.'
                *pl ' '
                *pl '— Стефан. — Он сдувает опилки с древесины и щурится. — Заходи. Работы много, но для хозяина «Дикого Жеребца» минутка найдётся.'
                *pl ' '
                *pl 'Ты проходишь внутрь. Гном откладывает рубанок и поворачивается к тебе всем корпусом.'
                *pl ' '
                *pl '— По делу пришёл или передохнуть от гомона в зале?'
                *pl ' '
            end
        else:
            *pl 'Драупнир точит стамеску — мерно, с нажимом, проводя лезвием по оселку. Смахнув опилки с кожаного фартука, он поднимает голову и прищуривается из-под кустистых бровей.'
            *pl ' '
            *pl '— А, трактирщик. — Голос у него низкий, с хрипотцой. — Чего топчешься на пороге? Заходи, коли пришёл.'
            *pl ' '
            *pl 'Ты киваешь. Гном возвращается к стамеске, но взглядом всё ещё держит тебя.'
            *pl ' '
            *pl '— Ну? Говори, чего надо.'
            *pl ' '
        end
    end
    killvar 'DraupnirKnowsAffair'
    *pl ' '
    killvar 'DraupnirShopVisitVar'
---

#DraupnirShopClosedText
    if time = 5:
        *pl 'Мастерская закрыта на ночь. Тяжёлые дубовые ставни опущены, на двери висит массивный замок. Внутри темно и тихо — столяр давно спит.'
    elseif week = 7:
        *pl 'Мастерская закрыта. В воскресенье столяр не работает — в городе день отдыха и молитвы Ильматеру.'
    else:
        *pl 'Мастерская закрыта. Причина: ' + $ClosedReason + '.'
    end
    *pl ' '
