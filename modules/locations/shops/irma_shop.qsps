! ================================================
! FILE: modules/locations/shops/irma_shop.qsps
! MODULE: modules/locations/shops
! Лавка портнихи Ирмы
! Версия: v12 / подэкраны: main + форма + подарки + «Назад»
! ================================================

#IrmaShop

    *clr
    clr
    cla

    if MayorClerkAdviceGiven = 1 and Act1MoralUnlocked = 0:
        Act1SurveySuit = 1
    end

    $IrmaShopTabIncoming = LCASE($ARGS[0])
    $IrmaShopReturnIncoming = $ARGS[1]

    if $IrmaShopTabIncoming = 'main' or $IrmaShopTabIncoming = 'uniforms':
        $IrmaShopTab = $IrmaShopTabIncoming
    elseif $IrmaShopTabIncoming = 'craftsmenquarter' or $IrmaShopTabIncoming = 'craftsmen_quarter':
        $IrmaShopReturnLoc = 'CraftsmenQuarter'
        $IrmaShopTab = 'main'
    elseif $IrmaShopTabIncoming = '':
        if $IrmaShopHoldTab <> '':
            $IrmaShopTab = $IrmaShopHoldTab
        else:
            $IrmaShopTab = 'main'
        end
    else:
        $IrmaShopReturnLoc = $IrmaShopTabIncoming
        $IrmaShopTab = 'main'
    end

    if $IrmaShopReturnIncoming <> '':
        if LOC($IrmaShopReturnIncoming) = 1:
            $IrmaShopReturnLoc = $IrmaShopReturnIncoming
        end
    end

    if $IrmaShopReturnLoc = '':
        $IrmaShopReturnLoc = 'CraftsmenQuarter'
    end

    if LOC($IrmaShopReturnLoc) = 0:
        $IrmaShopReturnLoc = 'CraftsmenQuarter'
    end

    $IrmaShopHoldTab = $IrmaShopTab

    killvar '$IrmaShopTabIncoming'
    killvar '$IrmaShopReturnIncoming'

    ShopOpen = 1
    $ClosedReason = ''

    if time = 5:
        ShopOpen = 0
        $ClosedReason = 'сейчас ночь, лавки закрыты'
    elseif week = 5 and time = 4:
        ShopOpen = 0
        $ClosedReason = 'сейчас пятничный вечер, лавки закрыты, горожане идут на танцы'
    elseif week = 7:
        ShopOpen = 0

        if time = 1:
            $ClosedReason = 'сейчас воскресное утро, все ушли на службу в церковь'
        elseif time = 2:
            $ClosedReason = 'сейчас воскресный полдень, в церкви идут исповеди'
        else:
            $ClosedReason = 'сейчас воскресенье, лавки закрыты'
        end
    end

    if ShopOpen < 1:
        *clr
        gs 'ShowLocationScreenTitle', 'ЛАВКА ПОРТНИХИ ИРМЫ — ЗАКРЫТО'
        gs 'ShowImage', 'irma', 'shop', 'closed', 'normal'

        *p 'Лавка закрыта. Причина: ' + $ClosedReason + '.'

        *pl ' '

        gs 'SundayVisitIrmaIngaCanEavesdrop'

        if SundayVisitIrmaIngaCanEavesdrop = 1:
            gs 'ActUiPrepare', 'Подслушать', 'look'
            act $ActUiLabel, $ActUiIconPath:
                killvar '$IrmaShopHoldTab'
                gt 'SundayVisitIrmaInga'
            end
        end

        killvar 'SundayVisitIrmaIngaCanEavesdrop'

        if time = 5 and IrmaMet = 1:
            gs 'ActUiPrepare', 'Постучать в ночную мастерскую', 'talk'
            act $ActUiLabel, $ActUiIconPath:
                killvar '$IrmaShopHoldTab'
                gt 'IrmaNightVisit'
            end
        end

        gs 'ActUiPrepare', 'Квартал ремесленников', 'craftsmen'
        act $ActUiLabel, $ActUiIconPath:
            killvar '$IrmaShopHoldTab'
            gt 'CraftsmenQuarter'
        end

        exit
    end

    if $IrmaShopTab = 'uniforms':
        _uniform_allowed = 0
        if IrmaUniformOfferUnlocked = 1:
            _uniform_allowed = 1
        elseif LOC('IrmaUniformOfferCanStart') = 1:
            gs 'IrmaUniformOfferCanStart'
            if IrmaUniformOfferCanStart = 1 and IrmaUniformOfferDeclined = 0:
                _uniform_allowed = 1
            end
        end
        if _uniform_allowed = 0:
            $IrmaShopTab = 'main'
        end
        killvar '_uniform_allowed'
    end

    gs 'IrmaShopRenderCommonHeader'

    if $IrmaShopMessage <> '':
        gs 'PrintMainP', $IrmaShopMessage
        *pl ' '
        killvar '$IrmaShopMessage'
    end

    if $IrmaShopTab = 'uniforms':
        gs 'IrmaShopRenderUniformsTab'
        *pl ' '
        gs 'IrmaShopRenderBackButton'
    else:
        gs 'IrmaShopRenderMainTab'
        *pl ' '
        gs 'IrmaShopRenderMainExtraActions'
        *pl ' '
        gs 'IrmaShopRenderMainNavButtons'
    end
---

#IrmaShopRenderCommonHeader

    gs 'ShowLocationScreenTitle', 'ЛАВКА ПОРТНИХИ ИРМЫ'
    gs 'ShowImage', 'irma', 'shop', 'talk', 'normal'

    *pl 'Ты заходишь в уютную лавку, где повсюду висят отрезы ткани, кружева и готовые платья. За прилавком стоит полуэльфийка Ирма.'

    if revealing_uniform_all_bought = 1 and revealing_uniform_worn = 0:
        *pl 'Ирма тепло улыбается: "Всё уже готово. Твои девушки будут выглядеть просто сногсшибательно."'
    end

    *pl ' '

    if LOC('IrmaIngaWorkshopCheck') = 1:
        gs 'IrmaIngaWorkshopCheck'
    end

    if IngaAtIrmaShop = 1:
        *pl 'В глубине лавки у раскройного стола хлопочет Инга, сосредоточенно намётывая подол под чутким присмотром Ирмы.'
        *pl ' '
    end
    if IrmaMet >= 1:
        if IrmaLastVisitDay <> day:
            IrmaVisits += 1
            IrmaLastVisitDay = day
        end
    end

    if IrmaMet < 1:
        *pl 'Ирма поднимает на тебя взгляд — кажется, видит в лавке впервые.'
    end

    *pl ' '

    gs 'ShowGirlTalkLink', 'irma', 'IrmaShop'
    *pl ' '
---

#IrmaShopRenderMainTab

    *pl 'На стенах — выкройки, на полках — катушки ниток. Здесь шьют платья для танцев и заказывают рабочую форму для трактира.'
    *pl ' '

    if StefanRespectableSuit = 0:
        *pl 'На манекене в углу лавки выставлен добротный шерстяной костюм строгого городского покроя — удобный, сдержанный и солидный.'
    else:
        *pl 'Твой приличный костюм от Ирмы сидит безупречно — в таком не стыдно показаться ни перед мэром, ни на танцах.'
    end
---

#IrmaShopRenderMainExtraActions

    if StefanRespectableSuit = 0:
        gs 'ActUiPrepare', 'Приличный костюм (95 спинтарий)', 'shop'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IrmaShopFittingRespectableSuit', $IrmaShopReturnLoc
        end
    end

    if LOC('IrmaDanceDressHandleVisit') = 1:
        gs 'IrmaDanceDressHandleVisit'
    end

    if LOC('IrmaUniformHandleVisit') = 1:
        gs 'IrmaUniformHandleVisit'
    end

    if IrmaUniformOfferUnlocked <> 1:
        if LOC('IrmaUniformOfferCanStart') = 1:
            gs 'IrmaUniformOfferCanStart'

            if IrmaUniformOfferCanStart = 1 and IrmaUniformOfferDeclined = 0:
                *pl 'Ирма смотрит на тебя так, будто давно ждала подходящего момента для неприятно выгодного разговора.'
                *pl ' '
            end
        end
    end
---

#IrmaShopRenderUniformsTab

    gs 'PrintMainLine', 'Рабочая форма для трактира'
    *pl ' '

    if IrmaUniformOfferUnlocked = 0:
        if IrmaUniformOfferDeclined = 1:
            *pl 'Ирма с лёгкой усмешкой посматривает на тебя из-за раскройного стола:'
            *pl ' '
            *pl '— Надумал вернуться к нашему разговору о нарядах для твоих работниц, Стефан? Моё предложение всё ещё в силе.'
            *pl ' '
            gs 'ActUiPrepare', 'Вернуться к предложению о форме', 'talk'
            act $ActUiLabel, $ActUiIconPath:
                gt 'IrmaUniformOfferStart', $IrmaShopReturnLoc
            end
        else:
            *pl 'Ирма откладывает мерную ленту и внимательно смотрит на тебя. До неё уже дошли городские слухи о трактире, и у полуэльфийки есть деловое предложение, сулящее немалую выгоду.'
            *pl ' '
            gs 'ActUiPrepare', 'Выслушать предложение Ирмы', 'talk'
            act $ActUiLabel, $ActUiIconPath:
                gt 'IrmaUniformOfferStart', $IrmaShopReturnLoc
            end
        end
    else:
        if LOC('IrmaUniformOrders') = 1:
            *pl 'На рабочем столе Ирмы лежат готовые выкройки и образцы тонких тканей. Здесь ты можешь заказать пошив откровенных нарядов для девушек твоего трактира.'
            *pl ' '
            gs 'IrmaUniformPrintStatus'
            *pl ' '

            gs 'ActUiPrepare', 'Перейти к заказам формы', 'shop'
            act $ActUiLabel, $ActUiIconPath:
                gt 'IrmaUniformOrders', 'IrmaShop'
            end
        else:
            *pl 'Модуль заказов формы не подключён.'
        end
    end
---

#IrmaShopRenderMainNavButtons

    if PlayerHasWeaponShipmentInvoice = 1 and IrmaBlackmailTalkDone = 0:
        gs 'ActUiPrepare', 'Показать накладную на инструменты', 'policy'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IrmaBlackmailTalk'
        end
    end

    if IrmaMet = 1:
        gs 'ActUiPrepare', 'Беседы о мире за чаем', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IrmaLoreMenu'
        end
    end

    if MercenaryNeedsBalm = 1 and PlayerHasTreeBalm = 0:
        gs 'ActUiPrepare', 'Попросить бальзам Древа для спасения раненого', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IrmaGetBalmForMercenary'
        end
    end

    if IngaAtIrmaShop = 1:
        gs 'ActUiPrepare', 'Подойти к Ирме и Инге', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IrmaIngaApprenticeTalk'
        end
    end

    if AmandaWantsNobleDress = 1 and AmandaHasNobleDress = 0:
        gs 'ActUiPrepare', 'Заказать благородное шёлковое платье для Аманды', 'shop'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IrmaOrderAmandaNobleDress'
        end
    end

    if StefanWearingNobleSuit = 1 and StefanNobleTourIrmaDone = 0:
        gs 'ActUiPrepare', 'Ирма: визит в дворянском наряде', 'policy'
        act $ActUiLabel, $ActUiIconPath:
            gt 'StefanNobleTourIrma'
        end
    end

    _show_uniform_btn = 0
    if IrmaUniformOfferUnlocked = 1:
        _show_uniform_btn = 1
    elseif LOC('IrmaUniformOfferCanStart') = 1:
        gs 'IrmaUniformOfferCanStart'
        if IrmaUniformOfferCanStart = 1 and IrmaUniformOfferDeclined = 0:
            _show_uniform_btn = 1
        end
    end

    if _show_uniform_btn = 1:
        gs 'ActUiPrepare', 'Рабочая форма', 'shop'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IrmaShop', 'uniforms', $IrmaShopReturnLoc
        end
    end
    killvar '_show_uniform_btn'

    gs 'ActUiPrepare', 'Квартал ремесленников', 'craftsmen'
    act $ActUiLabel, $ActUiIconPath:
        killvar '$IrmaShopHoldTab'
        gt $IrmaShopReturnLoc
    end
---

#IrmaShopFittingRespectableSuit

    *clr
    clr
    cla

    $IrmaSuitReturnLoc = $ARGS[0]
    if $IrmaSuitReturnLoc = '':
        $IrmaSuitReturnLoc = 'CraftsmenQuarter'
    end

    gs 'ShowLocationScreenTitle', 'ПРИЛИЧНЫЙ КОСТЮМ — СНЯТИЕ МЕРОК'
    gs 'SceneShowVisual', 'images/locations/shops/irma_shop/suit_fitting', 'Ирма снимает мерки со Стефана', 'large', 'webp'

    *pl 'Ты подходишь к манекену и указываешь на тёмный добротный костюм. Полуэльфийка оценивающе прищуривается, достаёт из кармана фартука гибкую мерную ленту и делает шаг к тебе.'
    *pl ' '
    *pl '— Дело хорошее, Стефан. Хозяин трактира не должен выглядеть так, будто донашивает обноски за грузчиками из доков. Но вещь с чужого плеча — это всегда видно. Стой прямо и расправь плечи.'
    *pl ' '
    *pl 'Ирма быстро и привычно снимает мерки: охват груди, ширина плеч, длина рукава и спины. Её пальцы касаются ткани твоей рубахи, точными движениями прикидывая посадку камзола и брюк. Затем она отступает на полшага, критически оглядывает тебя и убирает ленту.'
    *pl ' '
    *pl '— Шерсть отличная, плотная, ложится строго. Лишнее подколю, ворот и плечи посажу точно по твоей фигуре. Но добротная работа и хорошая ткань стоят денег. Девяносто пять спинтарий — и ни монетой меньше. За меньшее пусть тебе нищие на пристани рубахи латают.'
    *pl ' '

    if money >= 95:
        *pl 'У тебя в кошельке достаточно монет: ' + STR(money) + ' спинтарий.'
        *pl ' '
        gs 'ActUiPrepare', 'Оплатить костюм (95 спинтарий)', 'coin'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IrmaShopPayRespectableSuit', $IrmaSuitReturnLoc
        end
    else:
        *pl 'Тебе не хватает денег на оплату костюма: в кошельке сейчас всего ' + STR(money) + ' спинтарий из необходимых 95.'
        *pl ' '
    end

    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IrmaShop', 'main', $IrmaSuitReturnLoc
    end
---

#IrmaShopPayRespectableSuit

    *clr
    clr
    cla

    $IrmaSuitReturnLoc = $ARGS[0]
    if $IrmaSuitReturnLoc = '':
        $IrmaSuitReturnLoc = 'CraftsmenQuarter'
    end

    if money < 95:
        gt 'IrmaShopFittingRespectableSuit', $IrmaSuitReturnLoc
    end

    money -= 95
    StefanRespectableSuit = 1

    gs 'ShowLocationScreenTitle', 'ПРИЛИЧНЫЙ КОСТЮМ'
    gs 'SceneShowVisual', 'images/locations/shops/irma_shop/suit_ready', 'Стефан примеряет готовый приличный костюм', 'large', 'webp'

    *pl 'Ты достаёшь кошель и отсчитываешь Ирме девяносто пять спинтарий. Полуэльфийка ловко сгребает серебро, взвешивает монеты на ладони и с лёгким звоном убирает их в ящик прилавка.'
    *pl ' '
    *pl '— Договорились. Стой смирно, не крутись. Сейчас подгоню плечи и ворот.'
    *pl ' '
    *pl 'Она снимает костюм с манекена и помогает тебе облачиться в обнову. Её ловкие пальцы быстро и уверенно правят ткань, скалывают лишнее булавками и подгоняют камзол точно по твоей фигуре. Ткань плотная, глубокого тёмного цвета, без кричащей роскоши, но с той неброской добротностью, которую сразу замечают в приличном обществе.'
    *pl ' '
    *pl 'Ты поворачиваешься к высокому зеркалу у стены: плечи кажутся шире, осанка строже, а от прежнего вида беспутного парня не осталось и следа.'
    *pl ' '
    *pl '— Ну вот, — довольно усмехается портниха, оглядев тебя с головы до ног. — Теперь ты похож на молодого хозяина дела, а не на портового оборванца, сбежавшего с кухни. В таком наряде и к мэру в приёмную не стыдно, и на танцах девушки нос воротить не станут.'
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IrmaShop', 'main', $IrmaSuitReturnLoc
    end
---

#IrmaShopBuyRespectableSuit
    gt 'IrmaShopFittingRespectableSuit', $ARGS[0]
---

#IrmaShopRenderBackButton

    gs 'ActUiPrepare', 'Назад', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IrmaShop', 'main', $IrmaShopReturnLoc
    end
---
