! ================================================
! FILE: modules/locations/shops/irma_dance_dress.qsps
! [AI-WORKED] Текст переработан / дополнен ассистентом 28.10.2026
! Платья для пятничных танцев: диалог в таверне → визит к Ирме утром → подгонка и примерка
! ================================================

#DanceDressNormalizeGirl

    if LOC('NormalizeGirlKey') = 1:
        gs 'NormalizeGirlKey', $ARGS[0]
        $DanceDressGirlKey = $GirlKey
    else:
        $DanceDressGirlKey = LCASE($ARGS[0])
    end

    if $DanceDressGirlKey <> 'amanda' and $DanceDressGirlKey <> 'melissa':
        $DanceDressGirlKey = ''
    end
---

#DanceDressEnsureName

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressNameGirl = $DanceDressGirlKey

    if $DanceDressNameGirl = '':
        exit
    end

    if $RealName[$DanceDressNameGirl] = '':
        if $DanceDressNameGirl = 'amanda':
            $RealName[$DanceDressNameGirl] = 'Аманда'
        elseif $DanceDressNameGirl = 'melissa':
            $RealName[$DanceDressNameGirl] = 'Мелисса'
        end
    end

    killvar '$DanceDressNameGirl'
---

#DanceDressShopIsOpen

    DanceDressShopOpen = 1

    if time = 5:
        DanceDressShopOpen = 0
    elseif week = 5 and time = 4:
        DanceDressShopOpen = 0
    elseif week = 7:
        DanceDressShopOpen = 0
    end
---

#DanceDressTalkCanStart

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressTalkGirl = $DanceDressGirlKey
    DanceDressTalkCanStart = 0

    if $DanceDressTalkGirl = '':
        killvar '$DanceDressTalkGirl'
        exit
    end

    if Friends[$DanceDressTalkGirl] <= 10:
        killvar '$DanceDressTalkGirl'
        exit
    end

    if $DanceDressTalkGirl = 'amanda':
        if AmandaDanceDressReady = 1 or AmandaDanceDressSelfBought = 1 or AmandaDanceDressAgreed = 1 or AmandaDanceDressOrdered = 1 or AmandaDanceDressRefused = 1:
            killvar '$DanceDressTalkGirl'
            exit
        end
    elseif $DanceDressTalkGirl = 'melissa':
        if MelissaDanceDressReady = 1 or MelissaDanceDressSelfBought = 1 or MelissaDanceDressAgreed = 1 or MelissaDanceDressOrdered = 1 or MelissaDanceDressRefused = 1:
            killvar '$DanceDressTalkGirl'
            exit
        end
    end

    DanceDressTalkCanStart = 1
    killvar '$DanceDressTalkGirl'
---

#DanceDressMissedCanStart

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressMissedGirl = $DanceDressGirlKey
    DanceDressMissedCanStart = 0

    if $DanceDressMissedGirl = '':
        killvar '$DanceDressMissedGirl'
        exit
    end

    if $DanceDressMissedGirl = 'amanda':
        if AmandaDanceDressAgreed = 1 and AmandaDanceDressReady = 0:
            if day > AmandaDanceDressMeetDay or (day = AmandaDanceDressMeetDay and time >= 2):
                DanceDressMissedCanStart = 1
            end
        end
    elseif $DanceDressMissedGirl = 'melissa':
        if MelissaDanceDressAgreed = 1 and MelissaDanceDressReady = 0:
            if day > MelissaDanceDressMeetDay or (day = MelissaDanceDressMeetDay and time >= 2):
                DanceDressMissedCanStart = 1
            end
        end
    end

    killvar '$DanceDressMissedGirl'
---

#DanceDressEscortCanStart

    DanceDressEscortCanStart = 0
---

#DanceDressFittingEscortCanStart

    DanceDressFittingEscortCanStart = 0
---

! ================================================
! ЭКРАН 1: Интро со смущением девушки
! ================================================

#GirlTalkDanceDressStart

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $TalkGirl = $DanceDressGirlKey
    $TalkReturnLoc = $ARGS[1]

    if $TalkGirl = '':
        gt $TalkReturnLoc
    end

    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    gs 'DanceDressEnsureName', $TalkGirl

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $TalkGirl
    end

    gs 'ShowLocationScreenTitle', 'ПЛАТЬЕ ДЛЯ ТАНЦЕВ — ' + UCASE($RealName[$TalkGirl])
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/' + $TalkGirl + '_dance_dress_intro', 'Разговор: ' + $RealName[$TalkGirl] + ' смущается и начинает разговор'

    if $TalkGirl = 'amanda':
        gs 'DanceDressPrintText', 'talk_amanda_hesitate', $TalkGirl
    else:
        gs 'DanceDressPrintText', 'talk_melissa_hesitate', $TalkGirl
    end

    *pl ' '

    act '<b>Выслушать</b>', 'images/common/ui/actions/talk.png':
        gt 'GirlTalkDanceDressRequest', $TalkGirl, $TalkReturnLoc
    end

    act '<b>Вернуться</b>', 'images/common/ui/actions/return.png':
        gt 'GirlTalk', $TalkGirl, $TalkReturnLoc
    end
---

! ================================================
! ЭКРАН 2: Просьба о платье для танцев
! ================================================

#GirlTalkDanceDressRequest

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $TalkGirl = $DanceDressGirlKey
    $TalkReturnLoc = $ARGS[1]

    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    gs 'DanceDressEnsureName', $TalkGirl

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $TalkGirl
    end

    gs 'ShowLocationScreenTitle', 'ПЛАТЬЕ ДЛЯ ТАНЦЕВ — ' + UCASE($RealName[$TalkGirl])
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/' + $TalkGirl + '_dance_dress_request', 'Разговор: ' + $RealName[$TalkGirl] + ' просит платье для танцев'

    if $TalkGirl = 'amanda':
        gs 'DanceDressPrintText', 'talk_amanda_intro', $TalkGirl
    else:
        gs 'DanceDressPrintText', 'talk_melissa_intro', $TalkGirl
    end

    *pl ' '

    act '<b>Согласиться сходить завтра утром к Ирме</b>', 'images/common/ui/actions/shop.png':
        gt 'GirlTalkDanceDressAgree', $TalkGirl, $TalkReturnLoc
    end

    act '<b>Отказать: деньги нужны трактиру</b>', 'images/common/ui/actions/talk.png':
        gt 'GirlTalkDanceDressRefuse', $TalkGirl, $TalkReturnLoc
    end

    act '<b>Отложить разговор</b>', 'images/common/ui/actions/return.png':
        gt 'GirlTalk', $TalkGirl, $TalkReturnLoc
    end
---

! ================================================
! ЭКРАН 3А: Согласие — уговор встретиться утром у Ирмы
! ================================================

#GirlTalkDanceDressAgree

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $TalkGirl = $DanceDressGirlKey
    $TalkReturnLoc = $ARGS[1]

    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    gs 'DanceDressEnsureName', $TalkGirl

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $TalkGirl
    end

    gs 'ShowLocationScreenTitle', 'ПЛАТЬЕ ДЛЯ ТАНЦЕВ — ' + UCASE($RealName[$TalkGirl])
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/' + $TalkGirl + '_dance_dress_agree', 'Разговор: радостная ' + $RealName[$TalkGirl] + ', договор пойти к Ирме'

    if $TalkGirl = 'amanda':
        AmandaDanceDressAgreed = 1
        AmandaDanceDressMeetDay = day + 1
        AmandaDanceDressRefused = 0
        gs 'DanceDressPrintText', 'talk_amanda_agree', $TalkGirl
    elseif $TalkGirl = 'melissa':
        MelissaDanceDressAgreed = 1
        MelissaDanceDressMeetDay = day + 1
        MelissaDanceDressRefused = 0
        gs 'DanceDressPrintText', 'talk_melissa_agree', $TalkGirl
    end

    Friends[$TalkGirl] += 1
    otkroven[$TalkGirl] += 1

    *pl ' '

    act '<b>Договорились</b>', 'images/common/ui/actions/return.png':
        gt $TalkReturnLoc
    end
---

! ================================================
! ЭКРАН 3Б: Отказ Стефана — деньги нужны на закупки
! ================================================

#GirlTalkDanceDressRefuse

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $TalkGirl = $DanceDressGirlKey
    $TalkReturnLoc = $ARGS[1]

    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    gs 'DanceDressEnsureName', $TalkGirl

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $TalkGirl
    end

    gs 'ShowLocationScreenTitle', 'ПЛАТЬЕ ДЛЯ ТАНЦЕВ — ' + UCASE($RealName[$TalkGirl])
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/' + $TalkGirl + '_dance_dress_refuse', 'Разговор: обиженная ' + $RealName[$TalkGirl] + ', отказ Стефана'

    if $TalkGirl = 'amanda':
        AmandaDanceDressRefused = 1
        AmandaDanceDressAgreed = 0
        Friends['amanda'] -= 2
        GirlOffenseDays['amanda'] = 1
        gs 'DanceDressPrintText', 'talk_amanda_refuse', $TalkGirl
    elseif $TalkGirl = 'melissa':
        MelissaDanceDressRefused = 1
        MelissaDanceDressAgreed = 0
        Friends['melissa'] -= 2
        GirlOffenseDays['melissa'] = 1
        gs 'DanceDressPrintText', 'talk_melissa_refuse', $TalkGirl
    end

    *pl ' '

    act '<b>Отойти</b>', 'images/common/ui/actions/return.png':
        gt $TalkReturnLoc
    end
---

#GirlTalkDanceDressLater

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $TalkGirl = $DanceDressGirlKey
