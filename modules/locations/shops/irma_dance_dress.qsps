! ================================================
! ЭКРАН 4: Упрёк — Стефан не пришёл утром в лавку к Ирме
! ================================================

#GirlTalkDanceDressMissed

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $TalkGirl = $DanceDressGirlKey
    $TalkReturnLoc = $ARGS[1]

    if $TalkReturnLoc = '':
