---

! ================================================
! ЭКРАН 2 В ЛАВКЕ: Подгонка за ширмой
! ================================================

#IrmaDanceDressFittingRoom

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressGirl = $DanceDressGirlKey

    gs 'DanceDressEnsureName', $DanceDressGirl
    gs 'ShowLocationScreenTitle', 'ПОДГОНКА ПЛАТЬЯ — ' + UCASE($RealName[$DanceDressGirl])
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/irma_dance_dress_screen_' + $DanceDressGirl, 'Ирма: ' + $RealName[$DanceDressGirl] + ' за ширмой на подгонке платья'

    *pl 'Ирма заводит ' + $RealName[$DanceDressGirl] + ' за плотную ширму в углу мастерской. Из-за ткани доносится шорох снимаемой одежды, позвякивание булавок и негромкие наставления портнихи.'
    *pl ' '

    act '<b>Подсмотреть за ширму</b>', 'images/common/ui/actions/look.png':
        gt 'IrmaDanceDressPeep', $DanceDressGirl
    end

    act '<b>Дождаться окончания примерки</b>', 'images/common/ui/actions/generic.png':
        gt 'IrmaDanceDressFinish', $DanceDressGirl
    end
---

! ================================================
! ЭКРАН 2А В ЛАВКЕ: Подглядывание за ширму (кадр 1)
! ================================================

#IrmaDanceDressPeep

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressGirl = $DanceDressGirlKey

    gs 'DanceDressEnsureName', $DanceDressGirl
    gs 'ShowLocationScreenTitle', 'ПОДГОНКА ПЛАТЬЯ — ' + UCASE($RealName[$DanceDressGirl])
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/irma_dance_dress_peep1_' + $DanceDressGirl, 'Подглядывание за ширму: ' + $RealName[$DanceDressGirl] + ' перед примеркой платья'

    gs 'DanceDressPrintText', 'shop_fitting_peep1', $DanceDressGirl

    *pl ' '

    act '<b>Смотреть дальше</b>', 'images/common/ui/actions/look.png':
        gt 'IrmaDanceDressPeep2', $DanceDressGirl
    end

    act '<b>Дождаться окончания примерки</b>', 'images/common/ui/actions/generic.png':
        gt 'IrmaDanceDressFinish', $DanceDressGirl
    end
---

! ================================================
! ЭКРАН 2Б В ЛАВКЕ: Подглядывание за ширму (кадр 2)
! ================================================

#IrmaDanceDressPeep2

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressGirl = $DanceDressGirlKey

    gs 'DanceDressEnsureName', $DanceDressGirl
    gs 'ShowLocationScreenTitle', 'ПОДГОНКА ПЛАТЬЯ — ' + UCASE($RealName[$DanceDressGirl])
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/irma_dance_dress_peep2_' + $DanceDressGirl, 'Подглядывание за ширму: ' + $RealName[$DanceDressGirl] + ' примеряет новое платье'

    gs 'DanceDressPrintText', 'shop_fitting_peep2', $DanceDressGirl

    *pl ' '

    act '<b>Дождаться окончания примерки</b>', 'images/common/ui/actions/generic.png':
        gt 'IrmaDanceDressFinish', $DanceDressGirl
    end
---

! ================================================
! ЭКРАН 3 В ЛАВКЕ: Готовый наряд и восторг девушки
! ================================================

#IrmaDanceDressFinish

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressGirl = $DanceDressGirlKey

    gs 'DanceDressEnsureName', $DanceDressGirl
    gs 'ShowLocationScreenTitle', 'ГОТОВЫЙ НАРЯД — ' + UCASE($RealName[$DanceDressGirl])
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/irma_dance_dress_finish_' + $DanceDressGirl, 'Ирма: счастливая ' + $RealName[$DanceDressGirl] + ' в новом платье у зеркала'

    if $DanceDressGirl = 'amanda':
        AmandaDanceDressReady = 1
        AmandaDanceDressPlayerBought = 1
        AmandaDanceDressAgreed = 0
        AmandaDanceDressOrdered = 0
        AmandaDanceDressFittingDue = 0
        Friends['amanda'] += 2
        otkroven['amanda'] += 1
        $GirlLocation['amanda'] = 'TavernMain'
        gs 'DanceDressPrintText', 'shop_fitting_finish_amanda', $DanceDressGirl
    elseif $DanceDressGirl = 'melissa':
        MelissaDanceDressReady = 1
        MelissaDanceDressPlayerBought = 1
        MelissaDanceDressAgreed = 0
        MelissaDanceDressOrdered = 0
        MelissaDanceDressFittingDue = 0
        Friends['melissa'] += 2
        otkroven['melissa'] += 1
        $GirlLocation['melissa'] = 'TavernMain'
        gs 'DanceDressPrintText', 'shop_fitting_finish_melissa', $DanceDressGirl
    end

    Friends['irma'] += 1
    $IrmaDanceDressCompanion = ''
    $GirlTalkPendingNotice[$DanceDressGirl] = ''

    *pl ' '

    act '<b>Выйти из лавки</b>', 'images/common/ui/actions/return.png':
        gt 'CraftsmenQuarter'
    end
---

