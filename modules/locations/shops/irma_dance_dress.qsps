    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/' + $TalkGirl + '_dance_dress_missed', 'Разговор: разозлённая ' + $RealName[$TalkGirl] + ' упрекает за пропущенную встречу'

    if $TalkGirl = 'amanda':
        gs 'DanceDressPrintText', 'talk_amanda_missed', $TalkGirl
    elseif $TalkGirl = 'melissa':
        gs 'DanceDressPrintText', 'talk_melissa_missed', $TalkGirl
    end

    *pl ' '

    act '<b>Извиниться и пообещать прийти завтра утром</b>', 'images/common/ui/actions/talk.png':
        gt 'GirlTalkDanceDressForgive', $TalkGirl, $TalkReturnLoc
    end

    act '<b>Отказать: у трактира нет лишних денег</b>', 'images/common/ui/actions/talk.png':
        gt 'GirlTalkDanceDressRefuse', $TalkGirl, $TalkReturnLoc
    end
---

! ================================================
! ЭКРАН 4А: Извинение принято — перенос на завтрашнее утро
! ================================================

#GirlTalkDanceDressForgive

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $TalkGirl = $DanceDressGirlKey
    $TalkReturnLoc = $ARGS[1]

    if $TalkReturnLoc = '':
        $TalkReturnLoc = 'TavernMain'
    end

    gs 'EnsureGirlData', $TalkGirl
    gs 'DanceDressEnsureName', $TalkGirl

    if LOC('ShowGirlSidebar') = 1:
        gs 'ShowGirlSidebar', $TalkGirl
    end

    gs 'ShowLocationScreenTitle', 'ПЛАТЬЕ ДЛЯ ТАНЦЕВ — ' + UCASE($RealName[$TalkGirl])
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/' + $TalkGirl + '_dance_dress_forgive', 'Разговор: ' + $RealName[$TalkGirl] + ' соглашается перенести поход к Ирме на завтра'

    if $TalkGirl = 'amanda':
        AmandaDanceDressMeetDay = day + 1
        gs 'DanceDressPrintText', 'talk_amanda_forgive', $TalkGirl
    elseif $TalkGirl = 'melissa':
        MelissaDanceDressMeetDay = day + 1
        gs 'DanceDressPrintText', 'talk_melissa_forgive', $TalkGirl
    end

    *pl ' '

