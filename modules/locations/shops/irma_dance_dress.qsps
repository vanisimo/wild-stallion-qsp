---

#IrmaDanceDressEscortStart

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressEscortGirl = $DanceDressGirlKey
    $DanceDressEscortReturn = $ARGS[1]

    if $DanceDressEscortReturn <> '':
        gt $DanceDressEscortReturn
    else:
        gt 'CraftsmenQuarter'
    end
---

! ================================================
! ПРОВЕРКА ПРИХОДА СТЕФАНА В ЛАВКУ ИРМЫ УТРОМ
! ================================================

#IrmaDanceDressHandleVisit

    if time = 1 and week <> 7:
        if AmandaDanceDressAgreed = 1 and AmandaDanceDressReady = 0 and day = AmandaDanceDressMeetDay:
            gt 'IrmaDanceDressShopScene', 'amanda'
        elseif MelissaDanceDressAgreed = 1 and MelissaDanceDressReady = 0 and day = MelissaDanceDressMeetDay:
            gt 'IrmaDanceDressShopScene', 'melissa'
        end
    end
---

#IrmaDanceDressBlockedNoGirl

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressBlockedGirl = $DanceDressGirlKey

    gs 'ShowLocationScreenTitle', 'ИРМА: ПЛАТЬЕ ДЛЯ ТАНЦЕВ'
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/irma_dance_dress_blocked_no_girl', 'Ирма: платье — нет девушки'

    gs 'DanceDressPrintText', 'blocked_no_girl', $DanceDressBlockedGirl

    *pl ' '

    if $DanceDressBlockedGirl = 'amanda' and AmandaDanceDressAgreed = 0 and Friends['amanda'] > 10:
        gs 'PrintMainP', 'Сначала поговори с Амандой в трактире — без её согласия заказ не начнётся.'
    elseif $DanceDressBlockedGirl = 'melissa' and MelissaDanceDressAgreed = 0 and Friends['melissa'] > 10:
        gs 'PrintMainP', 'Сначала поговори с Мелиссой в трактире — без её согласия заказ не начнётся.'
    end

    *pl ' '

    act '<b>Вернуться в лавку</b>', 'images/common/ui/actions/return.png':
        gt 'IrmaShop'
    end

    killvar '$DanceDressBlockedGirl'
---

! ================================================
! ЭКРАН 1 В ЛАВКЕ: Выбор готового платья из столицы (70 спинтарий)
! ================================================

#IrmaDanceDressShopScene

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressGirl = $DanceDressGirlKey
    DanceDressOrderPrice = 70

    gs 'DanceDressEnsureName', $DanceDressGirl
    gs 'ShowLocationScreenTitle', 'ЛАВКА ПОРТНИХИ ИРМЫ — ПЛАТЬЕ ДЛЯ ' + UCASE($RealName[$DanceDressGirl])
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/irma_dance_dress_shop_' + $DanceDressGirl, 'Ирма: готовые платья из столицы, ' + $RealName[$DanceDressGirl] + ' выбирает наряд'

    if $DanceDressGirl = 'amanda':
        gs 'DanceDressPrintText', 'shop_amanda_scene', $DanceDressGirl
    else:
        gs 'DanceDressPrintText', 'shop_melissa_scene', $DanceDressGirl
    end

    *pl ' '
    gs 'FormatSpintry', DanceDressOrderPrice
    $FormatSpintry_Price = $FormatSpintry
    killvar '$FormatSpintry'
    gs 'FormatSpintry', money
    $FormatSpintry_money = $FormatSpintry
    killvar '$FormatSpintry'
    gs 'PrintMainLine', 'Цена: ' + $FormatSpintry_Price + '. У тебя: ' + $FormatSpintry_money + '.'
    *pl ' '

    if money >= DanceDressOrderPrice:
        act '<b>Оплатить платье (70 спинтарий)</b>', 'images/common/ui/actions/gift.png':
            money -= DanceDressOrderPrice
            gt 'IrmaDanceDressFittingRoom', $DanceDressGirl
        end
    else:
        act '<b>Сказать, что сейчас не хватает денег</b>', 'images/common/ui/actions/return.png':
            gt 'IrmaDanceDressNoMoney', $DanceDressGirl
        end
    end

    act '<b>Отказаться от покупки</b>', 'images/common/ui/actions/talk.png':
        gt 'IrmaDanceDressCancel', $DanceDressGirl
    end
---

! ================================================
! ЭКРАН 1А В ЛАВКЕ: Денег не хватило
! ================================================

#IrmaDanceDressNoMoney

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressGirl = $DanceDressGirlKey

    gs 'DanceDressEnsureName', $DanceDressGirl
    gs 'ShowLocationScreenTitle', 'ЛАВКА ПОРТНИХИ ИРМЫ'
    gs 'SceneShowVisual', 'images/locations/shops/irma_dance_dress/irma_dance_dress_no_money_' + $DanceDressGirl, 'Ирма: не хватило денег на платье'

    if $DanceDressGirl = 'amanda':
        AmandaDanceDressAgreed = 0
        AmandaDanceDressRefused = 1
        $GirlLocation['amanda'] = 'TavernMain'
        gs 'DanceDressPrintText', 'shop_amanda_no_money', $DanceDressGirl
    else:
        MelissaDanceDressAgreed = 0
        MelissaDanceDressRefused = 1
        $GirlLocation['melissa'] = 'TavernMain'
        gs 'DanceDressPrintText', 'shop_melissa_no_money', $DanceDressGirl
    end

    Friends[$DanceDressGirl] -= 2
    GirlOffenseDays[$DanceDressGirl] = 1
    $IrmaDanceDressCompanion = ''

    *pl ' '

    act '<b>Выйти из лавки</b>', 'images/common/ui/actions/return.png':
        gt 'CraftsmenQuarter'
    end
---

! ================================================
! ЭКРАН 1Б В ЛАВКЕ: Стефан отказался оплачивать
! ================================================

#IrmaDanceDressCancel

    *clr
    clr
    cla

    gs 'DanceDressNormalizeGirl', $ARGS[0]
    $DanceDressGirl = $DanceDressGirlKey

    gs 'DanceDressEnsureName', $DanceDressGirl
