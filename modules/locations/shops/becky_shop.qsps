! ================================================
! FILE: modules/locations/shops/becky_shop.qsps
! Лавка продовольствия Блэнкеншип
! Версия: v10 / подэкраны: таблица цен + товары + «Назад»
! ================================================

#BeckyShop
    *clr
    clr
    cla

    $BeckyShopTabIncoming = LCASE($ARGS[0])

    if $BeckyShopTabIncoming = 'main' or $BeckyShopTabIncoming = 'food':
        $BeckyShopTab = $BeckyShopTabIncoming
    elseif $BeckyShopTabIncoming = '':
        if $BeckyShopHoldTab <> '':
            $BeckyShopTab = $BeckyShopHoldTab
        else:
            $BeckyShopTab = 'main'
        end
    else:
        $BeckyShopTab = 'main'
    end

    $BeckyShopHoldTab = $BeckyShopTab

    killvar '$BeckyShopTabIncoming'

    ShopOpen = 1
    $ClosedReason = ''

    if time = 5:
        ShopOpen = 0
        $ClosedReason = 'сейчас ночь, лавки закрыты'
    elseif week = 5 and time = 4:
        ShopOpen = 0
        $ClosedReason = 'сейчас пятничный вечер, лавки закрыты, горожане идут на танцы'
    elseif week = 7:
        ShopOpen = 0

        if time = 1:
            $ClosedReason = 'сейчас воскресное утро, все ушли на службу в церковь'
        elseif time = 2:
            $ClosedReason = 'сейчас воскресный полдень, в церкви идут исповеди'
        else:
            $ClosedReason = 'сейчас воскресенье, лавки закрыты'
        end
    end

    if ShopOpen < 1:
        *clr
        gs 'ShowLocationScreenTitle', 'ЛАВКА ПРОДОВОЛЬСТВИЯ БЛЭНКЕНШИП — ЗАКРЫТО'
        gs 'ShowImage', 'becky', 'shop', 'closed', 'normal'

        *p 'Лавка закрыта. Причина: ' + $ClosedReason + '.'

        *pl ' '

        gs 'SundayVisitBeckySandraCanEavesdrop'

        if SundayVisitBeckySandraCanEavesdrop = 1:
            act '<b>Подслушать</b>', 'images/common/ui/actions/look.png':
                killvar '$BeckyShopHoldTab'
                gt 'SundayVisitBeckySandra'
            end
        end

        killvar 'SundayVisitBeckySandraCanEavesdrop'

        gs 'BeckyShopBackroomPeekTryOffer', 'closed'

        if BeckyShopBackroomPeekOffer = 1:
            gs 'ActUiPrepare', 'Подсмотреть в заднюю', 'look'
            act $ActUiLabel, $ActUiIconPath:
                killvar '$BeckyShopHoldTab'
                gt 'BeckyShopBackroomPeek', 'Market'
            end
        end

        killvar 'BeckyShopBackroomPeekOffer'

        act '<b>Назад</b>', 'images/common/ui/actions/return.png':
            killvar '$BeckyShopHoldTab'
            gt 'Market'
        end

        exit
    end

    if debug = 1:
        *pl '[DEBUG BECKY SHOP] OPEN | week=' + STR(week) + ' | time=' + STR(time) + ' | tab=' + $BeckyShopTab
        *pl ' '
    end

    if LOC('IngaGuardCheckVisitTick') = 1:
        gs 'IngaGuardCheckVisitTick'
    end

    gs 'BeckyShopBackroomPeekTryOffer', 'open'

    if LOC('AmandaCucumberBeckyShopCanStart') = 1:
        gs 'AmandaCucumberBeckyShopCanStart'
        if AmandaCucumberBeckyShopCanStart = 1:
            killvar 'AmandaCucumberBeckyShopCanStart'
            killvar '$BeckyShopHoldTab'
            gt 'AmandaCucumberBeckyShopEvent'
        end
        killvar 'AmandaCucumberBeckyShopCanStart'
    end

    gs 'BeckyShopResolveSeller'
    gs 'BeckyShopRenderCommonHeader'

    if $BeckyShopMessage <> '':
        gs 'PrintMainP', $BeckyShopMessage
        *pl ' '
        killvar '$BeckyShopMessage'
    end

    if $BeckyShopTab = 'food':
        gs 'BeckyShopRenderFoodTab'
        *pl ' '
        gs 'BeckyShopRenderBackButton'
    else:
        gs 'BeckyShopRenderMainTab'
        *pl ' '
        gs 'BeckyShopRenderMainExtraActions'
        *pl ' '
        gs 'BeckyShopRenderMainNavButtons'
    end
---

#BeckyShopResolveSeller
    if time = 1:
        $CurrentSeller = 'inga'
        $BeckyShopSellerLabel = 'Ингеборга'
        $BeckyShopSellerDesc = 'Утром за прилавком дежурит Ингеборга. Она быстро сметает, быстро считает и не любит, когда торгуются без уважения.'
    elseif time = 2:
        $CurrentSeller = 'eddie'
        $BeckyShopSellerLabel = 'Эдди'
        $BeckyShopSellerDesc = 'За прилавком стоит Эдди. Он ещё молод, но уже уверенно знает, где лежит каждый мешок и сколько стоит каждый ящик.'
    else:
        $CurrentSeller = 'becky'
        $BeckyShopSellerLabel = 'Бекки Блэнкеншип'
        $BeckyShopSellerDesc = 'За прилавком стоит Бекки Блэнкеншип. Она знает ваш трактир, помнит долги и не терпит пустых разговоров у продуктового прилавка.'
    end
---

#BeckyShopRenderCommonHeader
    gs 'ShowLocationScreenTitle', 'ЛАВКА ПРОДОВОЛЬСТВИЯ БЛЭНКЕНШИП'

    ! Интерьер лавки всегда Бекки (мать): Инга/Эдди за прилавком, но комната одна
    if BeckyShopBigPurchaseFlash = 1:
        gs 'ShowImage', 'becky', 'shop', 'happy', 'big_purchase'
        BeckyShopBigPurchaseFlash = 0
    else:
        gs 'ShowImage', 'becky', 'shop', 'normal', 'normal'
    end

    gs 'BeckyShopRenderSellerLine'
    *pl ' '
---

#BeckyShopRenderSellerLine
    if $CurrentSeller = 'becky':
        gs 'BeckyShopPrintGirlTalkInText', 'becky', 'Бекки Блэнкеншип', 'За прилавком стоит ', '. Она знает ваш трактир, помнит долги и не терпит пустых разговоров у продуктового прилавка.'
    elseif $CurrentSeller = 'inga':
        gs 'BeckyShopPrintGirlTalkInText', 'inga', 'Ингеборга', 'Утром за прилавком дежурит ', '. Она быстро сметает, быстро считает и не любит, когда торгуются без уважения.'
    else:
        gs 'BeckyShopPrintEddieTalkInText'
    end

    killvar '$BeckyShopSellerLabel'
    killvar '$BeckyShopSellerDesc'
---

#BeckyShopPrintGirlTalkInText
    $BeckyShopTalkGirl = LCASE($ARGS[0])
    $BeckyShopTalkLabel = $ARGS[1]
    $BeckyShopTalkPrefix = $ARGS[2]
    $BeckyShopTalkSuffix = $ARGS[3]

    gs 'GirlTalkCheckNpcLinkAvailable', $BeckyShopTalkGirl, 'BeckyShop'

    if GirlTalkMenuReady = 1:
        gs 'FormatTextByStyle', $BeckyShopTalkLabel, 'npc_link'
        $BeckyShopTalkHref = '<a href="exec:gs ''GirlTalkOpenNpcMenu'', ''' + $BeckyShopTalkGirl + ''', ''BeckyShop'', ''BeckyShop''">' + $FormattedText + '</a>'
        killvar '$FormattedText'
        *pl $BeckyShopTalkPrefix + $BeckyShopTalkHref + $BeckyShopTalkSuffix
        killvar '$BeckyShopTalkHref'
    else:
        *pl $BeckyShopTalkPrefix + '**' + $BeckyShopTalkLabel + '**' + $BeckyShopTalkSuffix
    end

    killvar 'GirlTalkMenuReady'
    killvar '$BeckyShopTalkGirl'
    killvar '$BeckyShopTalkLabel'
    killvar '$BeckyShopTalkPrefix'
    killvar '$BeckyShopTalkSuffix'
---

#BeckyShopPrintEddieTalkInText
    gs 'BuildEddieShopTalkMenu'
    gs 'FormatTextByStyle', 'Эдди', 'npc_link'
    $BeckyShopTalkHref = '<a href="exec:gs ''Menu.Show'', ''EddieShopTalkMenu''">' + $FormattedText + '</a>'
    killvar '$FormattedText'
    *pl 'За прилавком стоит ' + $BeckyShopTalkHref + '. Он ещё молод, но уже уверенно знает, где лежит каждый мешок и сколько стоит каждый ящик.'
    killvar '$BeckyShopTalkHref'
---

#BeckyShopRenderMainTab
    *p 'На полках ящики с зерном, солью и провизией. Здесь закупают всё, что потом уходит на кухню трактира.'

    if SandraDiscoveryCrisisStage = 2:
        *pl ' '
        gs 'ActUiPrepare', 'Подслушать разговор Сандры и Бекки', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyDiscoverySandraBeckyTalk'
        end
    end

    if (FamilySisterSuspicionStage >= 1 or FamilyCorruptionStage >= 2) and time <> 5 and day <> SisterVegetableSceneDay:
        *pl ' '
        gs 'ActUiPrepare', 'Сестра у лотка с овощами', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyShopSisterVegetablesScene'
        end
    end

    if BeckyHomeStage >= 3 and time = 4 and LOC('BeckyHomeGuestArrival') = 1:
        *pl ' '

        act '<b>Постучать в дверь дома Бекки</b>', 'images/common/ui/actions/talk.png':
            gt 'BeckyHomeGuestArrival'
        end
    end
---

#BeckyShopRenderFoodTab
    gs 'PrintMainLine', 'Ящики продуктов'
    *pl ' '
    gs 'BeckyShopRenderFoodPriceTable'
    *pl ' '

    if $CurrentSeller = 'becky' and Friends['becky'] < 20:
        *p 'Бекки холодно смотрит на вас: "После всего, что было, я не собираюсь тебе ничего продавать."'
        *pl ' '
    end

    act '<b>Малый ящик</b>', 'images/common/ui/actions/shop.png':
        $BeckyShopTab = 'food'
        gs 'BeckyShopBuyBox', 'small'
    end

    act '<b>Средний ящик</b>', 'images/common/ui/actions/shop.png':
        $BeckyShopTab = 'food'
        gs 'BeckyShopBuyBox', 'medium'
    end

    act '<b>Большой ящик</b>', 'images/common/ui/actions/shop.png':
        $BeckyShopTab = 'food'
        gs 'BeckyShopBuyBox', 'large'
    end

    act '<b>Огромный ящик</b>', 'images/common/ui/actions/shop.png':
        $BeckyShopTab = 'food'
        gs 'BeckyShopBuyBox', 'huge'
    end
---

#BeckyShopRenderFoodPriceTable
    $BeckyShopTableStyle = 'border-collapse:collapse; width:100%; max-width:540px; margin:6px 0;'
    $BeckyShopCellStyle = 'border:1px solid #555; padding:5px 10px;'
    $BeckyShopThStyle = $BeckyShopCellStyle + ' text-align:left; font-weight:bold;'

    $BeckyShopFoodTableHtml = '<table style="' + $BeckyShopTableStyle + '"><tr>'
    $BeckyShopFoodTableHtml += '<th style="' + $BeckyShopThStyle + '">Ящик</th>'
    $BeckyShopFoodTableHtml += '<th style="' + $BeckyShopThStyle + '">Количество</th>'
    $BeckyShopFoodTableHtml += '<th style="' + $BeckyShopThStyle + '">Цена</th></tr>'
    $BeckyShopFoodTableHtml += '<tr><td style="' + $BeckyShopCellStyle + '">Малый</td><td style="' + $BeckyShopCellStyle + '">15 ед.</td><td style="' + $BeckyShopCellStyle + '">60 монет</td></tr>'
    $BeckyShopFoodTableHtml += '<tr><td style="' + $BeckyShopCellStyle + '">Средний</td><td style="' + $BeckyShopCellStyle + '">40 ед.</td><td style="' + $BeckyShopCellStyle + '">150 монет</td></tr>'
    $BeckyShopFoodTableHtml += '<tr><td style="' + $BeckyShopCellStyle + '">Большой</td><td style="' + $BeckyShopCellStyle + '">80 ед.</td><td style="' + $BeckyShopCellStyle + '">280 монет</td></tr>'
    $BeckyShopFoodTableHtml += '<tr><td style="' + $BeckyShopCellStyle + '">Огромный</td><td style="' + $BeckyShopCellStyle + '">150 ед.</td><td style="' + $BeckyShopCellStyle + '">500 монет</td></tr>'
    $BeckyShopFoodTableHtml += '</table>'

    *p $BeckyShopFoodTableHtml
    gs 'PrintMainLine', '4 монеты за единицу.'

    killvar '$BeckyShopFoodTableHtml'
    killvar '$BeckyShopTableStyle'
    killvar '$BeckyShopCellStyle'
    killvar '$BeckyShopThStyle'
---

#BeckyShopRenderChildrenFoodBuy
    *pl 'Дети Бекки готовы помочь, если у вас с ними хорошие отношения:'
    *pl ' '

    if Friends['inga'] >= 18 and becky_children_bought_today = 0:
        act '<b>Малый ящик у Инги — 15 ед., 60 монет</b>', 'images/common/ui/actions/shop.png':
            $BeckyShopTab = 'food'
            gs 'BeckyShopBuyBoxChild', 'inga'
        end
    end

    if Friends['eddie'] >= 18 and becky_children_bought_today = 0:
        act '<b>Малый ящик у Эдди — 15 ед., 60 монет</b>', 'images/common/ui/actions/shop.png':
            $BeckyShopTab = 'food'
            gs 'BeckyShopBuyBoxChild', 'eddie'
        end
    end
---

#BeckyShopRenderMainNavButtons
    act '<b>Продовольствие</b>', 'images/common/ui/actions/shop.png':
        gt 'BeckyShop', 'food'
    end

    act '<b>Назад</b>', 'images/common/ui/actions/return.png':
        killvar '$BeckyShopHoldTab'
        gt 'Market'
    end
---

#BeckyShopRenderBackButton
    act '<b>Назад</b>', 'images/common/ui/actions/return.png':
        gt 'BeckyShop', 'main'
    end
---

#BeckyShopRenderMainExtraActions
    if BeckyShopBackroomPeekOffer = 1:
        *pl ' '

        gs 'PrintMainP', 'Из задней комнаты доносится приглушённый смех и скрип ящика — будто мать ушла не на склад, а к кому-то ещё.'

        gs 'ActUiPrepare', 'Заглянуть в заднюю', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyShopBackroomPeek', 'BeckyShop'
        end
    end

    if $CurrentSeller = 'becky' and Friends['becky'] < 20:
        gs 'BeckyShopRenderChildrenFoodBuy'
    end

    if $CurrentSeller = 'inga' and IngaOffenseStefan = 1:
        *pl '<i>Инга стоит за прилавком, опустив ресницы и теребя фартук. Девушка обижена на тебя за то, что ты скрывал от неё правду о Лукасе и её матери. Она ждёт красивого знака внимания и искренних слов.</i>'
        *pl ' '
        if GiftInventory['gift_cheap'] > 0 or GiftInventory['gift_expensive'] > 0 or money >= 25:
            gs 'ActUiPrepare', 'Подарить подарок и помириться с Ингой', 'gift'
            act $ActUiLabel, $ActUiIconPath:
                gt 'IngaGiftForgive'
            end
        end
    end

    if $CurrentSeller = 'inga' and IngaOffenseStefan = 0 and IngaRomanceUnlocked = 1 and Friends['inga'] >= 18:
        *pl ' '

        act '<b>Флиртовать с Ингой</b>', 'images/common/ui/actions/flirt.png':
            gt 'IngaFlirt'
        end
    end

    if $CurrentSeller = 'inga' and IngaOffenseStefan = 0 and LOC('IngaRomanceTryUnlock') = 1:
        gs 'IngaRomanceTryUnlock'
    end

    if $CurrentSeller = 'inga' and IngaOffenseStefan = 0 and LOC('IngaBackroomCanOffer') = 1:
        gs 'IngaBackroomCanOffer'

        if IngaBackroomCanOffer = 1:
            if IngaRoomFirstSexDone = 0 and IngaRomanceStage < 3:
                gs 'ActUiPrepare', 'Зайти в подсобку с Ингой', 'intim'
                act $ActUiLabel, $ActUiIconPath:
                    gt 'IngaRomanceStep'
                end
            elseif IngaRoomFirstSexDone = 0 and IngaRomanceStage >= 3:
                gs 'ActUiPrepare', 'Уединиться в подсобке (ласки)', 'intim'
                act $ActUiLabel, $ActUiIconPath:
                    gt 'IngaRomanceRepeatOral'
                end
            elseif IngaRoomFirstSexDone = 1 or IngaBackroomSex = 1:
                gs 'ActUiPrepare', 'Провести время в подсобке', 'intim'
                act $ActUiLabel, $ActUiIconPath:
                    gt 'SexSceneStart', 'inga', 'IngaBackroomAfterSex', 'inga_repeat'
                end

                gs 'ActUiPrepare', 'Ласки в подсобке (минет)', 'intim'
                act $ActUiLabel, $ActUiIconPath:
                    gt 'IngaRomanceRepeatOral'
                end
            end

            if IngaRomanceUnlocked = 1 and LOC('IngaOralCanAdvance') = 1:
                gs 'IngaOralCanAdvance'

                if IngaOralCanAdvance = 1:
                    gs 'ActUiPrepare', 'Учиться дальше (минет)', 'intim'
                    act $ActUiLabel, $ActUiIconPath:
                        gt 'IngaOralStep'
                    end
                end
            end
        end
    end

    if (IngaRoomUnlocked = 1 or IngaRomanceStage >= 3) and time >= 3:
        *pl '<i>(Лестница на второй этаж на виду у хозяйки лавки: днём в комнату Инги не пройти. Нужно приходить ночью во вторник, когда Бекки уезжает за товаром, и подниматься через окно.)</i>'
    end

    if $CurrentSeller = 'inga' and IngaGuardVisitPendingTalk = 1:
        *pl ' '
        gs 'ActUiPrepare', 'Поговорить с Ингой о стражнике', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaGuardComplaintTalk'
        end
    end

    if $CurrentSeller = 'inga' and IngaGuardResolved > 0 and IngaGuardThanksDone = 0:
        *pl ' '
        gs 'ActUiPrepare', 'Поговорить с Ингой (благодарность)', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaGuardThanks'
        end
    end

    if $CurrentSeller = 'inga' and LOC('IngaGuardHarassmentTryActivate') = 1:
        gs 'IngaGuardHarassmentTryActivate'
    end

    if $CurrentSeller = 'becky' and BeckyOffenseStefan = 1:
        *pl '<i>Бекки демонстративно перекладывает мешочки с крупой, поджав губы и не глядя в твою сторону. Тётушка всё ещё дуется на тебя за то, что ты обольстил её дочку, пока сама она делила с тобой постель. Без хорошего подарка к ней не подступиться.</i>'
        *pl ' '
        if GiftInventory['gift_cheap'] > 0 or GiftInventory['gift_expensive'] > 0 or money >= 25:
            gs 'ActUiPrepare', 'Подарить подарок и помириться с Бекки', 'gift'
            act $ActUiLabel, $ActUiIconPath:
                gt 'BeckyGiftForgive'
            end
        end
    end

    if $CurrentSeller = 'becky' and BeckyOffenseStefan = 0 and LOC('BeckyIngaThreesomeCanStart') = 1:
        gs 'BeckyIngaThreesomeCanStart'

        if BeckyIngaThreesomeCanStart = 1:
            act '<b>Встретиться с Бекки и Ингой втроём</b>', 'images/common/ui/actions/intim.png':
                gt 'GroupSexBeckyIngaStefanStart'
            end
        end
    end

    if BeckyCatchChoice = 'backroom' and LucasBannedUntilDay <= day and IngaOffenseStefan = 0 and LucasPeaceDinnerDone = 0 and (time = 3 or time = 4):
        *pl ' '
        gs 'ActUiPrepare', 'Примирительный ужин с Лукасом', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyIngaLucasPeaceDinner'
        end
    end

    if $CurrentSeller = 'becky' and LOC('SandraBeckyTalkBecky') = 1 and SandraBeckyCrisisDone = 1 and SandraBeckyTalkBeckyDone = 0 and SandraBeckyHardOffense = 0:
        gs 'ActUiPrepare', 'Поговорить о Сандре', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraBeckyTalkBecky'
        end
    end
---

#BeckyGiftForgive
    *clr
    clr
    cla

    gs 'EnsureGirlData', 'becky'
    gs 'SceneShowVisual', 'images/events/becky/becky_gift_forgive', 'ПРИМИРЕНИЕ С БЕККИ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ЛАВКА БЛЭНКЕНШИП: ПРИМИРЕНИЕ С БЕККИ'

    if GiftInventory['gift_expensive'] > 0:
        GiftInventory['gift_expensive'] -= 1
        $GiftGivenName = 'роскошный шёлковый платок с золотой нитью'
    elseif GiftInventory['gift_cheap'] > 0:
        GiftInventory['gift_cheap'] -= 1
        $GiftGivenName = 'изящную гребёнку из полированного рога'
    else:
        money -= 25
        $GiftGivenName = 'коробочку заморских пряностей и сладких цукатов'
    end

    *pl 'Ты достаёшь ' + $GiftGivenName + ' и с тёплой улыбкой преподносишь его тётушке Бекки.'
    *pl ' '
    *pl 'Вдова замирает, окинув подарок жадным, восторженным взглядом. Её обиженная мина мгновенно сменяется привычной, лукавой и чувственной улыбкой:'
    *pl ' '
    *pl '— Ох, Стефан... Ну вот как на тебя сердиться, окаянный? — со вздохом смеётся вдова, прижимая подарок к пышной груди и звонко целуя тебя в щёку. — Ладно уж, мир! Кровь у нас у всех горячая, чего там скрывать. Только Ингушу мою не обижай, слышишь? А к тётушке на огонёк дорожку не забывай...'
    *pl ' '
    *pl 'Обида развеялась без следа. Бекки снова смотрит на тебя с привычной томной теплотой.'

    BeckyOffenseStefan = 0
    Friends['becky'] += 3
    love['becky'] += 2
    BeckyIngaThreesomeCanStart = 1
    gs 'ClampGirlSocialStats', 'becky'
    killvar '$GiftGivenName'

    *pl ' '
    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShop'
    end
---

#IngaGiftForgive
    *clr
    clr
    cla

    gs 'EnsureGirlData', 'inga'
    gs 'SceneShowVisual', 'images/events/inga/inga_gift_forgive', 'ПРИМИРЕНИЕ С ИНГОЙ', 'large', 'webp'
    gs 'ShowLocationScreenTitle', 'ЛАВКА БЛЭНКЕНШИП: ПРИМИРЕНИЕ С ИНГОЙ'

    if GiftInventory['gift_expensive'] > 0:
        GiftInventory['gift_expensive'] -= 1
        $GiftGivenName = 'тонкую серебряную брошь тонкой работы'
    elseif GiftInventory['gift_cheap'] > 0:
        GiftInventory['gift_cheap'] -= 1
        $GiftGivenName = 'шёлковые ленты для кос редкого василькового оттенка'
    else:
        money -= 25
        $GiftGivenName = 'набор тончайших портновских игл и флакон цветочной воды'
    end

    *pl 'Ты подходишь к Инге, берёшь её за тонкие пальцы и протягиваешь ' + $GiftGivenName + '.'
    *pl ' '
    *pl 'Ты искренне извиняешься за молчание и объясняешь, что не хотел причинить ей боль или посеять раздор между ней и матерью.'
    *pl ' '
    *pl 'Инга бережно принимает подарок, щёки её вспыхивают румянцем, а обида в глазах тает:'
    *pl ' '
    *pl '— Я... я понимаю, Стефан, — тихо шепчет девушка, робко прижимаясь к твоему плечу. — Ты просто берёг наш покой. Спасибо тебе за заботу. Я больше не сержусь на тебя!'
    *pl ' '
    *pl 'Девушка ласково обнимает тебя, полностью забывая былые обиды.'

    IngaOffenseStefan = 0
    Friends['inga'] += 3
    love['inga'] += 3
    gs 'ClampGirlSocialStats', 'inga'
    killvar '$GiftGivenName'

    *pl ' '
    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShop'
    end
---

#BuildEddieShopTalkMenu
    gs 'Menu.Destroy', 'EddieShopTalkMenu'
    gs 'Menu.Create', 'EddieShopTalkMenu'

    ! ==================== 1. ВАЖНАЯ БЕСЕДА (ЕСЛИ ЕСТЬ) ====================
    if LOC('EddieImportantCheck') = 1:
        gs 'EddieImportantCheck'
        if EddieImportantReady = 1:
            gs 'MenuUiAdd', 'EddieShopTalkMenu', 'Важная беседа', 'important'
            gs 'Menu.AddModule', 'EddieShopTalkMenu', { gt 'EddieImportantScreen', 'BeckyShop' }
        end
        killvar 'EddieImportantReady'
        killvar '$EddieImportantAction'
    end

    ! ==================== 2. РАЗГОВОР (ВСЕГДА) ====================
    gs 'MenuUiAdd', 'EddieShopTalkMenu', 'Разговор', 'talk'
    gs 'Menu.AddModule', 'EddieShopTalkMenu', {
        gt 'EddieChatScreen', 'BeckyShop'
    }
---

#BeckyShopSisterVegetablesScene
    *clr
    clr
    cla

    SisterVegetableSceneDay = day

    if RAND(1, 2) = 1:
        $VegGirl = 'amanda'
    else
        $VegGirl = 'melissa'
    end

    gs 'ShowLocationScreenTitle', 'ЛАВКА БЛЭНКЕНШИП: ВЫБОР ОВОЩЕЙ'
    gs 'SceneShowVisual', 'images/events/shops/vegetables_butt_slap', 'СЕСТРА У ЛОТКА С ОВОЩАМИ', 'large', 'webp'

    *pl 'У лотков с овощами стоит ' + $RealName[$VegGirl] + ', склонившись над корзиной огурцов.'
    *pl 'Она вертит в пальцах крупный изогнутый огурец, прикидывает длину, обхватывает ладонью — проверяет толщину.'
    *pl 'Платье туго натянуто на выставленных назад бёдрах.'
    *pl ' '
    *pl 'Ты подходишь сзади и звонко шлёпаешь её по ягодице.'
    *pl ' '

    if FamilyCorruptionStage >= 4:
        *pl 'Она даже не вздрагивает. Только медленно оглядывается через плечо и прогибается чуть сильнее:'
        *pl '— Ещё раз, — шепчет она. — Только посильнее.'
        *pl ' '
        *pl '— Ты лучше скажи, зачем тебе огурец, когда дома я есть? — ухмыляешься ты.'
        *pl ' '
        *pl '— Ты днём в трактире, а я днём скучаю. — Она проводит огурцом по губам, не сводя глаз с твоего паха. — Этот будет дневным. А ты — ночным.'
        *pl ' '
        *pl 'Бекки за прилавком довольно крякает:'
        *pl '— Вот это хозяйственная девка! Бери два, ' + $RealName[$VegGirl] + ', второй в подарок. Чтоб братцу отдых давать, хе-хе!'
        *pl ' '
        *pl $RealName[$VegGirl] + ' кладёт в корзину оба огурца, расплачивается и, уходя, нарочно трётся о тебя бедром.'
    elseif FamilyCorruptionStage >= 2:
        *pl '— Ой! — она подскакивает и оборачивается, щёки пылают. — Стефан! Здесь же люди!'
        *pl ' '
        *pl '— А куда тебе такой длинный, сестрёнка? — ты киваешь на огурец. — Размерчик под себя подбираешь, чтобы ночью не скучать?'
        *pl ' '
        *pl '— Дурак! — шипит она, но огурец из рук не выпускает. — Не твоё дело, что я к ужину беру.'
        *pl ' '
        *pl '— К ужину? — ты наклоняешься к её уху. — Так я тебе и к ужину могу, и после.'
        *pl ' '
        *pl 'Бекки хохочет, уперев руки в бока:'
        *pl '— А что, парень дело говорит! Бери, ' + $RealName[$VegGirl] + ', огурчик крепкий, в руке лежит как влитой. А коли братец обленится — вот тебе и замена, хе-хе!'
        *pl ' '
        *pl $RealName[$VegGirl] + ' заливается краской, прячет огурец в сумку и, проходя мимо, щиплет тебя за бок. Но взгляд у неё горячий.'
    else
        *pl '— Ай! — ' + $RealName[$VegGirl] + ' роняет огурец и разворачивается, красная до ушей. — Стефан! Ты одурел?! Люди же смотрят!'
        *pl ' '
        *pl '— Пусть смотрят, — ухмыляешься ты. — Огурчик-то не мелковат? Ты его так щупала, будто жениха выбирала.'
        *pl ' '
        *pl 'Бекки за прилавком прыскает в кулак:'
        *pl '— Бери, бери, деточка! Для салата самое то. А для чего ещё — не моё дело, хе-хе!'
        *pl ' '
        *pl $RealName[$VegGirl] + ' хватает корзину, испепеляет тебя взглядом и вылетает из лавки. Огурец, впрочем, на лоток так и не вернулся.'
    end

    sluttiness[$VegGirl] += 1
    otkroven[$VegGirl] += 1
    killvar '$VegGirl'

    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShop'
    end
---