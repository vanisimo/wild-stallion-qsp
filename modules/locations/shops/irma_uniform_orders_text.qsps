! ================================================
! FILE: modules/locations/shops/irma_uniform_orders_text.qsps
! MODULE: modules/locations/shops
! [AI-WORKED] Текст переработан / дополнен ассистентом 28.10.2026
! USER-OWNED TEXT
! Тексты Ирмы: рабочая форма для девушек
! Используется логикой:
! modules/locations/shops/irma_uniform_orders.qsps
!
! Тон:
! - Ирма говорит как опытная портниха, без ханжества
! - Стефан понимает, что форма даст деньги, взгляды, слухи и неприятности
! - Индивидуальные фасоны для Аманды, Мелиссы и Сандры
! - Обращение к Стефану: строго на «ты»
! ================================================

#IrmaUniformPrintText
    $IrmaOrdersPrintId = LCASE($ARGS[0])

    if $IrmaUniformGirl <> '':
        gs 'IrmaUniformEnsureName', $IrmaUniformGirl
    end

    if $IrmaOrdersPrintId = 'intro':
        *pl 'Ирма раскладывает на широком столе отрезы материи и смотрит на тебя с прищуром мастера, который уже понял заказ раньше, чем ты успел его высказать:'
        *pl ' '
        *pl '— Рабочая форма для трактира бывает двух сортов, Стефан. Первая — чтобы просто посуду мыть да кружки носить. Вторая — чтобы захмелевшие гости забывали счёт выпитому, лезли в кошели за серебром и заказывали ещё и ещё.'

    elseif $IrmaOrdersPrintId = 'confirm_one':
        if $IrmaUniformGirl = 'amanda':
            *pl 'Ирма достаёт лоскут лёгкой материи и улыбается:'
            *pl ' '
            *pl '— Для Аманды? Ей пойдёт озорной крой: короткий подол, открытые плечи и тонкий корсаж, выгодно подчеркивающий девичью талию. Она девушка гибкая, быстрая, между столами так и порхает. Мужики в зале шеи посворачивают, пока она кружки носит. Только гляди в оба, чтобы гости руки не распускали — платье дразнит так, что у многих в голове помутится.'
        elseif $IrmaUniformGirl = 'melissa':
            *pl 'Ирма довольно прищуривается и проводит пальцами по плотному шёлку:'
            *pl ' '
            *pl '— Для Мелиссы? Девушка она строгая, умная, но фигура у неё — на зависть. Скрою строго, с воротником на шнуровке, но так подчеркну грудь и бёдра, что ни один посетитель взгляда не оторвёт. Это выглядит почти благородно, но чертовски маняще. Ей придётся непросто под сальными взглядами, но чаевые потекут рекой.'
        elseif $IrmaUniformGirl = 'sandra':
            *pl 'Ирма уважительно кивает и разворачивает отрез глубокого тёмно-красного сукна:'
            *pl ' '
            *pl '— Для Сандры? Твоя старшая сестра знает себе цену, и стати у неё роскошные. Тут нужен зрелый, смелый фасон: глубокое декольте, плотный лиф, подчёркивающий пышную грудь, и подол, открывающий щиколотки при каждом шаге. Мужики за кружкой будут сидеть до полуночи, лишь бы поймать её улыбку. За такое зрелище в городе платят щедро.'
        else:
            *pl 'Ирма снимает мерку с воздуха, будто уже видит девушку в новом наряде:'
            *pl ' '
            *pl '— Короткая юбка, глубокий вырез, ткань крепкая, но лёгкая. Двигаться сможет, работать сможет, а смотреть на неё будут так, что кружки сами продаваться начнут. Только не делай потом вид, что не понимал, что заказываешь.'
        end

    elseif $IrmaOrdersPrintId = 'confirm_all':
        *pl 'Ирма довольно всплёскивает руками и перебирает стопку тканей:'
        *pl ' '
        *pl '— Для всех троих сразу? Вот это размах настоящего хозяина! Решил не просто кормить город, а заставить весь квартал гудеть о твоём заведении. Сошью каждой по её стати: Аманде — дерзкое и лёгкое, Мелиссе — строгое, но волнующее, Сандре — зрелое и роскошное.'
        *pl ' '
        *pl 'Она подмигивает тебе с лукавой ухмылкой:'
        *pl ' '
        *pl '— Когда они втроём выйдут в зал, в трактире отбоя от гостей не будет. Только помни, Стефан: слухи и ревнивые пересуды я в комплект не зашиваю — с этим будешь разбираться сам.'

    elseif $IrmaOrdersPrintId = 'no_money':
        *pl 'Ирма с сочувственной усмешкой разводит руками:'
        *pl ' '
        *pl '— С такими желаниями, Стефан, приходят не с пустым кошелём. Тонкая ткань, ровная строчка и крепкие швы стоят денег, а хорошая провокация — тем более. Приходи, когда в кошельке зазвенит серебро.'

    elseif $IrmaOrdersPrintId = 'bought_one':
        *pl 'Ирма аккуратно разглаживает ткань, складывает готовый наряд и протягивает тебе плотный свёрток:'
        *pl ' '
        *pl '— Держи, работа закончена. С виду — опрятное трактирное платье, а на деле — безотказная приманка для взглядов. Теперь поговори с девушкой в трактире, чтобы она начала надевать этот наряд на смену. И приготовься: зал загудит.'

    elseif $IrmaOrdersPrintId = 'ordered_one':
        *pl 'Ирма аккуратно разглаживает выкройку и кивает тебе:'
        *pl ' '
        *pl '— Заказ оплачен, Стефан. Ткань отложена, основа готова. Но чтобы откровенный наряд сидел как вторая кожа и не топорщился при каждом наклоне, мне обязательно нужна примерка. Поговори с девушкой в трактире: пусть приходит ко мне в лавку с утра!'

    elseif $IrmaOrdersPrintId = 'ordered_all':
        *pl 'Ирма довольно пересчитывает монеты и подмигивает тебе:'
        *pl ' '
        *pl '— Общий заказ оплачен, милый! Отрезы для всех троих уже на раскройном столе. Но примерять будем строго по одной, чтобы я могла усадить каждый лиф безупречно. Договаривайся с девушками в трактире и присылай их ко мне по очереди — в любое удобное утро!'

    elseif $IrmaOrdersPrintId = 'bought_all':
        *pl 'Ирма бережно укладывает перед тобой три аккуратно перевязанных свёртка:'
        *pl ' '
        *pl '— Вот теперь твой трактир готов к новой жизни. Все три комплекта закончены. Ткань сама по себе никого не развращает, Стефан — она просто показывает людям то, о чём они и так мечтают. Поговори с каждой из девушек в трактире, чтобы они вышли в зал при параде.'


    ! --- Новые тексты цепочки примерки формы: разговор в таверне ---
    elseif $IrmaOrdersPrintId = 'talk_amanda_fitting':
        *pl 'Ты сообщаешь Аманде, что оплатил у Ирмы пошив новой рабочей формы для кабака, и завтра утром нужно прийти в лавку на примерку.'
        *pl ' '
        *pl 'Аманда густо краснеет, теребя край передника:'
        *pl '— Новая форма? Я слышала от девчонок, какие наряды шьёт Ирма... Гости же глаз оторвать не смогут, мужики прямо в зале слюни распустят! Но если ты считаешь, что так нужно для зала... Хорошо, Стефанчик, завтра утром я приду к Ирме к самому открытию!'

    elseif $IrmaOrdersPrintId = 'talk_melissa_fitting':
        *pl 'Ты объясняешь Мелиссе, что заказал у Ирмы комплект формы для зала, и завтра с утра портниха ждёт её для точной подгонки по фигуре.'
        *pl ' '
        *pl 'Мелисса приподнимает бровь, задумчиво прикусив губу:'
        *pl '— Ты решил одеть нас в наряды от Ирмы? Значит, слухи о трактире подтвердятся. Наряд будет откровенным, и гости станут вести себя смелее... Впрочем, для выручки и чаевых это верный ход. Хорошо. Завтра утром я буду в лавке у Ирмы.'

    elseif $IrmaOrdersPrintId = 'talk_sandra_fitting':
        *pl 'Ты сообщаешь Сандре, что оплатил заказ новой формы у Ирмы, и завтра утром её ждут в лавке на примерку.'
        *pl ' '
        *pl 'Сандра замирает, вытирая руки полотенцем, и упирает кулак в бок:'
        *pl '— Что?! Стефан, ты в своём уме? Я старшая сестра и хозяйка кухни, а не девка из портового вертепа! ...Но если трактиру позарез нужны звонкие монеты и богатые гости, я не стану упрямиться. Только если фасон окажется совсем уж бесстыдным — пеняй на себя. Завтра утром схожу к Ирме.'

    ! --- Упрёк при пропуске встречи утром ---
    elseif $IrmaOrdersPrintId = 'talk_amanda_fitting_missed':
        *pl 'Аманда встречает тебя надутыми губами и сердитым взглядом:'
        *pl '— Ты же сам велел прийти к Ирме с утра! Я просидела там среди тюков ткани, ждала тебя, а ты так и не пришёл! Какая стыдоба перед Ирмой!'

    elseif $IrmaOrdersPrintId = 'talk_melissa_fitting_missed':
        *pl 'Мелисса холодно смотрит на тебя, сложив руки на груди:'
        *pl '— Я потратила всё утро, дожидаясь тебя в лавке у Ирмы. Ты обещал быть на примерке, Стефан, и подвёл меня.'

    elseif $IrmaOrdersPrintId = 'talk_sandra_fitting_missed':
        *pl 'Сандра с грохотом ставит медный ковш на стол и сверлит тебя строгим взглядом:'
        *pl '— Мало того, что ты заставил меня идти примерять эти тряпки, так ещё и сам не соизволил явиться! Я прождала тебя у Ирмы всё утро. Ты хозяин заведения или безответственный мальчишка?'

    ! --- Согласие перенести на завтра ---
    elseif $IrmaOrdersPrintId = 'talk_amanda_fitting_forgive':
        *pl 'Ты извиняешься за накладку и обещаешь быть у Ирмы завтра с самого утра. Аманда шумно вздыхает:'
        *pl '— Ладно, поверю ещё раз. Но если опять забудешь — я эту форму даже в руки не возьму!'

    elseif $IrmaOrdersPrintId = 'talk_melissa_fitting_forgive':
        *pl 'Ты признаёшь оплошность и просишь дать второй шанс завтра на рассвете. Мелисса медленно кивает:'
        *pl '— Хорошо. Завтра утром я снова буду ждать у Ирмы. Не опаздывай.'

    elseif $IrmaOrdersPrintId = 'talk_sandra_fitting_forgive':
        *pl 'Ты просишь прощения, ссылаясь на срочные дела в трактире. Сандра устало качает головой:'
        *pl '— Ладно, Стефан. Завтра утром схожу к Ирме ещё раз. Но только ради дела.'

    ! --- Встреча в лавке у Ирмы утром ---
    elseif $IrmaOrdersPrintId = 'shop_amanda_fitting_scene':
        *pl 'Ирма встречает вас с лукавой улыбкой, держа в руках раскроенный наряд:'
        *pl '— А вот и хозяин! Аманда уже на месте. Ткань лёгкая, вырез глубокий, подол игривый — как раз для молодой подавальщицы. Пойдём за ширму, милая, скидывай рабочее платье, посадим наряд прямо по твоей точёной фигурке!'

    elseif $IrmaOrdersPrintId = 'shop_melissa_fitting_scene':
        *pl 'Ирма приветствует вас деловым кивком, поглаживая отрез тёмного шёлка:'
        *pl '— Доброе утро, Стефан. Мелисса пришла вовремя. Фасон строгий, но корсаж подчеркнёт грудь и талию так, что ни один купец не удержится от чаевых. Пойдём за ширму, снимем мерки прямо на теле.'

    elseif $IrmaOrdersPrintId = 'shop_sandra_fitting_scene':
        *pl 'Ирма уважительно кивает вам двоим, придерживая ткань глубокого бордового цвета:'
        *pl '— Здравствуй, Стефан. Твоя старшая сестра держится гордо, и стати у неё царственные. Наряд выйдет роскошным: пышная грудь будет подана во всей красе. Пойдём за ширму, Сандра, снимем платье и подгоним корсаж.'

    ! --- Подглядывание за ширму (2 экрана, формат диалога) ---
    ! Экран 1: Ирма просит снять одежду и бельё, реакция по коррупции
    elseif $IrmaOrdersPrintId = 'shop_amanda_fitting_peep1':
        *pl 'Ты бесшумно отводишь край шторы мастерской. Из-за ширмы звучат голоса:'
        *pl ' '
        *pl '— Скидывай платье, Аманда, — командует Ирма, примеривая ленту. — И бельё тоже снимай. Посмотрим, как лежит форма на голом теле, чтобы ни одна линия не проступала под тканью.'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl '— Прямо совсем всё?.. — Аманда вспыхивает яркой краской и смущённо прижимает руки к бокам. — Стыдно же... А вдруг кто-нибудь заглянет?'
            *pl '— Кому сюда заглядывать? — усмехается портниха. — Снимай, милая, иначе перекосится.'
            *pl 'Аманда снимает бельё, представая перед зеркалом с алеющими от смущения щеками. Тонкая талия и юные девичие сисечки открыты взору.'
        elseif FamilyCorruptionStage <= 3:
            *pl '— Без белья?.. — Аманда тихо хихикает, сбрасывая рабочую одежду. — Ну ладно, тебе виднее. Главное, чтобы сидело красиво!'
            *pl 'Она легко снимает бельё, с живым любопытством поворачиваясь перед зеркалом, сжимая сисечки, и корча в зеркало рожицы.'
        else:
            *pl '— И то верно! — смело подхватывает Аманда, легко стягивая с себя всё до нитки. — В зале все равно их насить не буду, без трусиков, чайвые больше будут. Смотри, Ирма, как тебе мои формы?'
            *pl 'Она игриво крутится перед зеркалом, похлопав себя по писечке, и покрутив соски.'
        end

    elseif $IrmaOrdersPrintId = 'shop_melissa_fitting_peep1':
        *pl 'Ты осторожно заглядываешь в зазор между портьерами:'
        *pl ' '
        *pl '— Раздевайся, Мелисса, — деловито говорит Ирма. — И бельё тоже долой. Посмотрим, как ляжет глубокий вырез и облегающий крой. Здесь ни единого лишнего шва быть не должно.'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl '— Совсем всё? — Мелисса с лёгким недовольством хмурит брови. — Я не привыкла оголятся даже в мастерской.'
            *pl '— Это хорошая ткань, милая, а не холщовый мешок, — парирует Ирма. — Доверься мастеру, если хочешь достойный вид.'
            *pl 'Мелисса сдержанно кивает и снимает бельё, открывая взору идеальные грудь и попку.'
        elseif FamilyCorruptionStage <= 3:
            *pl '— Хорошо, — спокойно отзывается Мелисса, снимая остатки одежды. — Пусть сидит идеально, я должна выглядит безупречно.'
            *pl 'Она встаёт перед зеркалом, расправив плечи и проодит руками по своему телу, задерживаяст на груди и попе.'
        else:
            *pl '— Без белья даже приятнее, — Мелисса с уверенной улыбкой сбрасывает бельё на стул. — Пусть ткань облегает тело как вторая кожа. Гости "Жеребца" должны терять дар речи, когда я накланяюсь за упавшей вилкой.'
            *pl 'Она с видимым наслаждением ложит руку на промежность, и со стоном вдавливает пальцы внутрь.'
        end

    elseif $IrmaOrdersPrintId = 'shop_sandra_fitting_peep1':
        *pl 'Ты приоткрываешь занавеску в глубине лавки:'
        *pl ' '
        *pl '— Снимай платье, Сандра, — требует Ирма, раскладывая булавки. — И бельё тоже снимай. Посмотрим, как ляжет наряд на твоей фигуре.'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl '— Ирма, побойся святого Ильматера! — всплёскивает руками Сандра, краснея до корней волос. — Чтобы взрослая баба стояла перед тобой без исподнего?!'
            *pl '— Брось ханжество, Сандра! — смеётся портниха. — Я твои стати наизусть знаю. Снимай, иначе корсаж зажмёт тело и будет душить.'
            *pl 'Сандра с тяжёлым вздохом снимает бельё, прикрывая пышную грудь ладонью и сгорая от неловкости.'
        elseif FamilyCorruptionStage <= 3:
            *pl '— Ох, грехи одни с этими выдумками... — вздыхает Сандра, но послушно снимает бельё. — Ладно, смотри, как сидит. Лишь бы выглядело достойно.'
            *pl 'Она поворачивается к зеркалу, оглаживая бёдра и любуясь соблазнительными линиями тела.'
        else:
            *pl '— А ведь ты права, Ирма, будто я буду их носить! — довольно усмехается Сандра, без стеснения сбрасывая бельё. Такие формы нужно показывать, а не прятать.'
            *pl 'Она широко расправляет плечи, с гордостью выставляя напоказ пышный бюст и большую попу.'
        end

    ! Экран 2: Наряд надет, проверка подола и реакция по коррупции
    elseif $IrmaOrdersPrintId = 'shop_amanda_fitting_peep2':
        *pl 'Форма надета. Ирма ловко подтягивает корсаж и приподнимает короткий подол у бедра:'
        *pl '— Вот так! Без белья ткань скользит свободно, ничего не трёт и не жмёт. А если захочешь порадовать щедрого гостя в тихом углу зала — просто подол приподняла, и готово!'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl 'Аманда вспыхивает яркой краской и торопливо одёргивает подол вниз:'
            *pl '— Ирма! Перестань болтать глупости! Я в кабаке разношу кружки, а не заигрываю с пьяными мужиками!'
             *pl '- Конечно, солнышко, - говорит Ирма, - только зачем тебе тогда такое платье.'

        elseif FamilyCorruptionStage <= 3:
            *pl 'Аманда смущённо улыбается, глядя на своё отражение и покачивая бёдрами:'
            *pl '— Ну... если гость окажется щедрым и вежливым, пусть любуется. Главное, чтобы серебро в карман упало!'
            *pl '- Я так и думала, когда делала эти платья, - говорит Ирма, - удобство обзора, ты наклонилась, а чайвые в два раза болше.'
        else:
            *pl 'Аманда смело усмехается и сама приподнимает край подола ещё выше перед зеркалом, похлопав себя по писечке:'
            *pl '— Пусть только попробуют не оставить серебра за такой вид! А если будет совсем щедрым, то может и еще как нибудь порадую!'
            *pl '- Я так и думала, когда делала эти платья, - говорит Ирма, - удобство, и доступ ко всем дырочкам.'
        end

    elseif $IrmaOrdersPrintId = 'shop_melissa_fitting_peep2':
        *pl 'Мелисса уже облачена в форму. Ирма расправляет узкий лиф и приподнимает край юбки с глубоким разрезом:'
        *pl '— Превосходно. Без белья  сидит идеально ровно, движения лёгкие. Если богатый купец захочет под подол залезть — сразу почувствует сладкую писечку!'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl 'Мелисса сдвигает брови и строго одёргивает ткань:'
            *pl '— Ирма, держи свои шутки при себе. Я работаю ради доброго имени семьи, и лишних вольностей от постояльцев терпеть не стану.'
             *pl '- Конечно, солнышко, - говорит Ирма, - только зачем тебе тогда такое платье.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Мелисса сдержанно усмехается, любуясь точёным силуэтом в ростовом зеркале:'
            *pl '— Если богатые купцы начнут сорить монетами ради подержатся за писечку - то я не против. Мне спринтрии нужны.'
             *pl '- Я так и думала, когда делала эти платья, - говорит Ирма, - удобство обзора, ты наклонилась, а чайвые в два раза болше.'
        else:
            *pl 'Мелисса задрав юбку уверенно проводит ладонью по голой пизденке, глядя в отражение с гордой улыбкой:'
            *pl '— Пусть трогает и платят. Если человек щедрый так я и сама потрогать могу.'
            *pl '- Я так и думала, когда делала эти платья, - говорит Ирма, - удобство, и доступ ко всем дырочкам.'
        end

    elseif $IrmaOrdersPrintId = 'shop_sandra_fitting_peep2':
        *pl 'Ирма затягивает шёлковые ленты корсажа на Сандре, подчеркивая глубокое декольте и приподнимая край подола:'
        *pl '— Вот это красота! Без белья наряд сидит как влитой. А если достойный гость захочет "десерт" прямо на кухне — наряд ничему мешать не станет!'
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl 'Сандра прикрывает вырез ладонью, бросая на портниху укоризненный взгляд:'
            *pl '— Ирма, побойся Ильматера! Мне перед честными людьми в зал выходить, а не на базаре стоять. Сделай вырез хоть немного скромнее!'
             *pl '- Все обговорено со Стефаном, - говорит Ирма, - у него проси вырез поменьше.'
        elseif FamilyCorruptionStage <= 3:
            *pl 'Сандра со вздохом поправляет лиф, невольно любуясь своей фигурой:'
            *pl '— Ох, Стефан меня с ума сведёт этими новшествами... Но сидит наряд и вправду ладно. Мужики ко мне на кхню в очередь выстроются, "благодарить" за вкусный ужин.'
             *pl '- Ха ха, "благодорить" - смеется Ирма, - в такое богатство, монеты будут засовывать не по одной, - сжав руками грудь Сандры.'
        else:
            *pl 'Сандра довольно расправляет плечи, выставляя грудь, еще ниже спустив такнь, так что становятся видны ореолы сосков и весело подмигивает портнихе:'
            *pl '— Да ты права, Ирма! "Десерт" я выдать никогда не против, если у человека есть деньги в кармане, то десер может быть особенно вкусным, - томно говорит Сандра, задрав юбку, до самой пизды и смотря на свое отражение в зеркале.'
             *pl '- Ох, Сандра - смеется Ирма, - глядя на такое, - ирма положила ладонь на голую киску сандры, -  любой мужик, у тебя на кхне все деньги осавит со штанами.'
        end

    ! Старые идентификаторы для обратной совместимости
    elseif $IrmaOrdersPrintId = 'shop_amanda_fitting_peep':
        gs 'IrmaUniformPrintText', 'shop_amanda_fitting_peep1'

    elseif $IrmaOrdersPrintId = 'shop_melissa_fitting_peep':
        gs 'IrmaUniformPrintText', 'shop_melissa_fitting_peep1'

    elseif $IrmaOrdersPrintId = 'shop_sandra_fitting_peep':
        gs 'IrmaUniformPrintText', 'shop_sandra_fitting_peep1'

    ! --- Финальный показ у зеркала ---
    elseif $IrmaOrdersPrintId = 'shop_amanda_fitting_finish':
        *pl 'Ширма распахивается! Аманда робко, но с горящими глазами выходит к ростовому зеркалу. Новая форма преобразила её: смелое декольте выгодно подчёркивает юную грудь, а короткий подол игриво колышется при каждом шаге. Она делает полуоборот, смущённо улыбаясь:'
        *pl '— Стефан... ну как? Не слишком бесстыдно? Мужики в трактире шеи посворачивают!'
        *pl ' '
        *pl 'Ирма вручает аккуратно упакованный свёрток с нарядом:'
        *pl '— Готово! Носи и радуй гостей!'

    elseif $IrmaOrdersPrintId = 'shop_melissa_fitting_finish':
        *pl 'Ширма отодвигается. Мелисса выходит к зеркалу уверенной походкой. Облегающий крой подчёркивает тонкую талию и бёдра, глубокий вырез приковывает взгляд, но наряд выглядит строго и благородно. Мелисса сдержанно улыбается:'
        *pl '— Сидит идеально. Теперь ни один богатый гость не посмеет смотреть мимо. Спасибо за наряд, Стефан.'
        *pl ' '
        *pl 'Ирма передаёт перевязанный свёрток:'
        *pl '— Готово, милая, покажи им всем!'

    elseif $IrmaOrdersPrintId = 'shop_sandra_fitting_finish':
        *pl 'Ширма распахивается, и Сандра предстаёт перед тобой во всём великолепии. Глубокое декольте и приталенный лиф подчёркивают её зрелые пышные формы. На щеках горит румянец, но осанка царственная. Сандра смотрит на тебя с лёгкой усмешкой:'
        *pl '— Ну что уставился, Стефан? Добился своего? Вырез такой, что святой Ильматер отвернётся... Но для кабака это золото. Посмотрим, сколько серебра гости выложат за кружку.'
        *pl ' '
        *pl 'Ирма с улыбкой передаёт свёрток:'
        *pl '— Носи на радость, Сандра! В трактире будет жарко!'

    end
    killvar '$IrmaOrdersPrintId'
---

#IrmaUniformText
    ! Совместимость
    $IrmaUniformTextId = LCASE($ARGS[0])
    $IrmaUniformText = ''
    if $IrmaUniformTextId = 'intro':
        $IrmaUniformText = '— Рабочая форма для трактира бывает двух сортов, Стефан. Первая — чтобы просто посуду мыть да кружки носить. Вторая — чтобы захмелевшие гости забывали счёт выпитому...'
    end
    killvar '$IrmaUniformTextId'
---
