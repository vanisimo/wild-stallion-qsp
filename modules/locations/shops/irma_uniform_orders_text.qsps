! ================================================
! FILE: modules/locations/shops/irma_uniform_orders_text.qsps
! MODULE: modules/locations/shops
! [AI-WORKED] Текст переработан / дополнен ассистентом 21.10.2026
! USER-OWNED TEXT
! Тексты Ирмы: рабочая форма для девушек
! Используется логикой:
! modules/locations/shops/irma_uniform_orders.qsps
!
! Тон:
! - Ирма говорит как опытная портниха, без ханжества
! - Стефан понимает, что форма даст деньги, взгляды, слухи и неприятности
! - Индивидуальные фасоны для Аманды, Мелиссы и Сандры
! - Обращение к Стефану: строго на «ты»
! ================================================

#IrmaUniformPrintText
    $IrmaOrdersPrintId = LCASE($ARGS[0])

    if $IrmaUniformGirl <> '':
        gs 'IrmaUniformEnsureName', $IrmaUniformGirl
    end

    if $IrmaOrdersPrintId = 'intro':
        *pl 'Ирма раскладывает на широком столе отрезы материи и смотрит на тебя с прищуром мастера, который уже понял заказ раньше, чем ты успел его высказать:'
        *pl ' '
        *pl '— Рабочая форма для трактира бывает двух сортов, Стефан. Первая — чтобы просто посуду мыть да кружки носить. Вторая — чтобы захмелевшие гости забывали счёт выпитому, лезли в кошели за серебром и заказывали ещё и ещё.'

    elseif $IrmaOrdersPrintId = 'confirm_one':
        if $IrmaUniformGirl = 'amanda':
            *pl 'Ирма достаёт лоскут лёгкой материи и улыбается:'
            *pl ' '
            *pl '— Для Аманды? Ей пойдёт озорной крой: короткий подол, открытые плечи и тонкий корсаж, выгодно подчеркивающий девичью талию. Она девушка гибкая, быстрая, между столами так и порхает. Мужики в зале шеи посворачивают, пока она кружки носит. Только гляди в оба, чтобы гости руки не распускали — платье дразнит так, что у многих в голове помутится.'
        elseif $IrmaUniformGirl = 'melissa':
            *pl 'Ирма довольно прищуривается и проводит пальцами по плотному шёлку:'
            *pl ' '
            *pl '— Для Мелиссы? Девушка она строгая, умная, но фигура у неё — на зависть. Скрою строго, с воротником на шнуровке, но так подчеркну грудь и бёдра, что ни один посетитель взгляда не оторвёт. Это выглядит почти благородно, но чертовски маняще. Ей придётся непросто под сальными взглядами, но чаевые потекут рекой.'
        elseif $IrmaUniformGirl = 'sandra':
            *pl 'Ирма уважительно кивает и разворачивает отрез глубокого тёмно-красного сукна:'
            *pl ' '
            *pl '— Для Сандры? Твоя старшая сестра знает себе цену, и стати у неё роскошные. Тут нужен зрелый, смелый фасон: глубокое декольте, плотный лиф, подчёркивающий пышную грудь, и подол, открывающий щиколотки при каждом шаге. Мужики за кружкой будут сидеть до полуночи, лишь бы поймать её улыбку. За такое зрелище в городе платят щедро.'
        else:
            *pl 'Ирма снимает мерку с воздуха, будто уже видит девушку в новом наряде:'
            *pl ' '
            *pl '— Короткая юбка, глубокий вырез, ткань крепкая, но лёгкая. Двигаться сможет, работать сможет, а смотреть на неё будут так, что кружки сами продаваться начнут. Только не делай потом вид, что не понимал, что заказываешь.'
        end

    elseif $IrmaOrdersPrintId = 'confirm_all':
        *pl 'Ирма довольно всплёскивает руками и перебирает стопку тканей:'
        *pl ' '
        *pl '— Для всех троих сразу? Вот это размах настоящего хозяина! Решил не просто кормить город, а заставить весь квартал гудеть о твоём заведении. Сошью каждой по её стати: Аманде — дерзкое и лёгкое, Мелиссе — строгое, но волнующее, Сандре — зрелое и роскошное.'
        *pl ' '
        *pl 'Она подмигивает тебе с лукавой ухмылкой:'
        *pl ' '
        *pl '— Когда они втроём выйдут в зал, в трактире отбоя от гостей не будет. Только помни, Стефан: слухи и ревнивые пересуды я в комплект не зашиваю — с этим будешь разбираться сам.'

    elseif $IrmaOrdersPrintId = 'no_money':
        *pl 'Ирма с сочувственной усмешкой разводит руками:'
        *pl ' '
        *pl '— С такими желаниями, Стефан, приходят не с пустым кошелём. Тонкая ткань, ровная строчка и крепкие швы стоят денег, а хорошая провокация — тем более. Приходи, когда в кошельке зазвенит серебро.'

    elseif $IrmaOrdersPrintId = 'bought_one':
        *pl 'Ирма аккуратно разглаживает ткань, складывает готовый наряд и протягивает тебе плотный свёрток:'
        *pl ' '
        *pl '— Держи, работа закончена. С виду — опрятное трактирное платье, а на деле — безотказная приманка для взглядов. Теперь поговори с девушкой в трактире, чтобы она начала надевать этот наряд на смену. И приготовься: зал загудит.'

    elseif $IrmaOrdersPrintId = 'bought_all':
        *pl 'Ирма бережно укладывает перед тобой три аккуратно перевязанных свёртка:'
        *pl ' '
        *pl '— Вот теперь твой трактир готов к новой жизни. Все три комплекта закончены. Ткань сама по себе никого не развращает, Стефан — она просто показывает людям то, о чём они и так мечтают. Поговори с каждой из девушек в трактире, чтобы они вышли в зал при параде.'
    end

    killvar '$IrmaOrdersPrintId'
---

#IrmaUniformText
    ! Совместимость
    $IrmaUniformTextId = LCASE($ARGS[0])
    $IrmaUniformText = ''
    if $IrmaUniformTextId = 'intro':
        $IrmaUniformText = '— Рабочая форма для трактира бывает двух сортов, Стефан. Первая — чтобы просто посуду мыть да кружки носить. Вторая — чтобы захмелевшие гости забывали счёт выпитому...'
    end
    killvar '$IrmaUniformTextId'
---
