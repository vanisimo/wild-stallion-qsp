! ================================================
! FILE: modules/locations/shops/irma_uniform_offer_text.qsps
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты предложения Ирмы об откровенной форме
! Используется логикой:
! modules/locations/shops/irma_uniform_offer.qsps
!
! Тон:
! - Ирма не ханжа и не святоша
! - она слышит городские слухи и предлагает заработать на том,
!   о чём город уже всё равно шепчется
! ================================================

#IrmaUniformOfferPrintText
    gs 'IrmaUniformOfferText', $ARGS[0]

    if $IrmaUniformOfferText <> '':
        *pl $IrmaUniformOfferText
    end
---

#IrmaUniformOfferText
    $IrmaUniformOfferTextId = LCASE($ARGS[0])
    $IrmaUniformOfferText = ''

    if $IrmaUniformOfferTextId = 'intro':
        if $IrmaUniformOfferReason = 'pastor':
            $IrmaUniformOfferText = 'Ирма встречает вас не обычной торговой улыбкой, а хитрым прищуром. — Слышала, падре опять грозил пальцем в сторону твоего трактира. Благочестие, распущенность, девичья скромность — весь этот привычный набор для воскресной проповеди. Значит, слухи уже достаточно громкие, чтобы дойти даже до собора.'
        elseif $IrmaUniformOfferReason = 'rumor' or $IrmaUniformOfferReason = 'lewd_fame' or $IrmaUniformOfferReason = 'backroom' or $IrmaUniformOfferReason = 'kitchen':
            $IrmaUniformOfferText = 'Ирма откладывает иглу и смотрит на вас так, будто примеряет не ткань, а вашу совесть. — Город болтает, Стефан. Шепчутся, будто у тебя в трактире девицы умеют не только кружки разносить. Кто-то поглядывает на дальние столы, кто-то на кухню, а кто-то просто многозначительно ухмыляется.'
        elseif $IrmaUniformOfferReason = 'trust':
            $IrmaUniformOfferText = 'Ирма мягко улыбается: — Ты заходишь ко мне уже не первый раз, Стефан. Я прекрасно вижу, куда движется твой трактир и какие взгляды ловит твоя родня. Могу, конечно, сделать вид, что ничего не замечаю... Но это было бы скучно.'
        else:
            $IrmaUniformOfferText = 'Ирма смотрит на вас поверх отреза ткани: — У твоего трактира меняется запах, Стефан. Раньше пахло элем, хлебом и дымом. Теперь ещё и слухами. А слухи, если их правильно подать, иногда приносят звонкую монету.'
        end

    elseif $IrmaUniformOfferTextId = 'offer':
        $IrmaUniformOfferText = '— Слышала, вы там не слишком печётесь о святой скромности, а вот о прибыли — совсем наоборот, — Ирма усмехается и вытягивает из стопки тонкую ткань. — В таком случае я могу помочь. Сошью особую рабочую форму: юбка покороче, декольте поглубже, но швы крепкие, чтобы выдержали рабочую смену. С виду — аккуратное платье для зала. На деле — безотказная приманка для жадных мужских взглядов и щедрых чаевых. Только потом не строй из себя невинного ягнёнка: ты сам прекрасно понимаешь, что заказываешь.'

    elseif $IrmaUniformOfferTextId = 'accept':
        $IrmaUniformOfferText = 'Вы не спорите. Ирма понимающе кивает, будто именно этого ответа и ждала: — Вот теперь разговор честный. Я берусь за раскройку, ты сам решаешь, кто из девушек её наденет, а город додумает остальное. И поверь — городские языки нафантазируют куда грязнее, чем я сошью.'

    elseif $IrmaUniformOfferTextId = 'later':
        $IrmaUniformOfferText = 'Вы говорите, что подумаете. Ирма ничуть не обижается — лишь улыбается уголками губ: — Думай. Слухи никуда не денутся. Они, знаешь ли, как въевшиеся пятна: чем дольше сохнут, тем труднее отстирать. Либо... тем выгоднее их обыграть.'

    elseif $IrmaUniformOfferTextId = 'refuse_hard':
        $IrmaUniformOfferText = 'Вы резко осаживаете портниху. Она медленно убирает отрез обратно на полку: — Как скажешь, Стефан. Моё дело маленькое — я всего лишь швея. Не я заставляю мужиков пялиться на твоих работниц. Я лишь умею сделать так, чтобы за эти взгляды исправно платили.'

    else:
        $IrmaUniformOfferText = ''
    end

    killvar '$IrmaUniformOfferTextId'
---
