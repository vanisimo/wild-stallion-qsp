! ================================================
! FILE: modules/locations/shops/irma_uniform_offer_text.qsps
! MODULE: modules/locations/shops
! [AI-WORKED] Текст переработан / дополнен ассистентом 21.10.2026
! USER-OWNED TEXT
! Тексты предложения Ирмы об откровенной форме
! Используется логикой:
! modules/locations/shops/irma_uniform_offer.qsps
!
! Тон:
! - Ирма не ханжа и не святоша
! - слышит городские слухи и предлагает заработать на том,
!   о чём город уже всё равно шепчется
! - канон религии: Ильматер, отец Герхард, храм Ильматера
! - обращение к Стефану: строго на «ты»
! ================================================

#IrmaUniformOfferPrintText
    $IrmaOfferPrintId = LCASE($ARGS[0])

    if $IrmaOfferPrintId = 'intro':
        if $IrmaUniformOfferReason = 'pastor':
            *pl 'Ирма встречает тебя не привычной деловой улыбкой, а хитрым, понимающим прищуром:'
            *pl ' '
            *pl '— Слышала я, отец Герхард опять в храме Ильматера грозил пальцем в сторону твоего заведения. Благочестие, скромность Ильматера, девичья чистота — весь этот привычный набор для проповеди. Значит, слухи о твоих девушках уже достаточно громкие, раз докатились даже до алтаря.'
        elseif $IrmaUniformOfferReason = 'rumor' or $IrmaUniformOfferReason = 'lewd_fame' or $IrmaUniformOfferReason = 'backroom' or $IrmaUniformOfferReason = 'kitchen':
            *pl 'Ирма откладывает иглу и смотрит на тебя так, будто оценивает не сукно, а твою готовность идти до конца:'
            *pl ' '
            *pl '— Город болтает, Стефан. Шепчутся, будто у тебя в трактире девицы умеют не только кружки разносить. Кто-то поглядывает на дальние столы, кто-то на кухню, а кто-то просто многозначительно ухмыляется в кружку.'
        elseif $IrmaUniformOfferReason = 'trust':
            *pl 'Ирма мягко улыбается, опершись ладонями о прилавок:'
            *pl ' '
            *pl '— Ты заходишь ко мне уже не первый раз, Стефан. Я прекрасно вижу, как растёт твой трактир и какие взгляды ловит твоя родня в зале. Могу, конечно, сделать вид, что ничего не замечаю... но это было бы глупо и скучно.'
        else:
            *pl 'Ирма смотрит на тебя поверх широкого отреза ткани:'
            *pl ' '
            *pl '— У твоего трактира меняется слава, Стефан. Раньше пахло просто элем, жарким и дымом. Теперь к этому примешались сплетни. А сплетни, если их правильно подать, иногда приносят куда больше серебра, чем честная торговля.'
        end

    elseif $IrmaOfferPrintId = 'offer':
        *pl '— Слышала я, ты не слишком держишься за проповеди о благочестии, если на кону хорошая выручка, — полуэльфийка усмехается и вытягивает из стопки кусок тонкой, но прочной ткани. — В таком случае я могу предложить дело. Сошью для твоих девушек особую рабочую форму.'
        *pl ' '
        *pl 'Она раскладывает лоскут на ладони, показывая текстуру:'
        *pl ' '
        *pl '— Юбка покороче, ворот и декольте посмелее, но швы — на совесть, чтобы выдержали и суету в зале, и грубые мужские руки. С виду — опрятное трактирное платье, без дешёвой портовой вульгарности. А на деле — безотказная приманка для жадных взглядов и щедрых чаевых.'
        *pl ' '
        *pl 'Ирма наклоняется чуть ближе и понижает голос:'
        *pl ' '
        *pl '— Только не строй потом невинного ягнёнка перед родными. Ты сам прекрасно понимаешь, что именно заказываешь и зачем.'

    elseif $IrmaOfferPrintId = 'accept':
        *pl 'Ты не споришь с очевидным. Заведение должно приносить доход, а полуэльфийка попала в самую точку.'
        *pl ' '
        *pl 'Ирма понимающе кивает, явно довольная твоим решением:'
        *pl ' '
        *pl '— Вот теперь разговор деловой. Я берусь за выкройки. Ты сам решишь, кого из девушек нарядить в такую форму, а городские зеваки пусть пялятся и раскошеливаются. Поверь мне: их фантазии всё равно будут куда грязнее, чем мои платья.'

    elseif $IrmaOfferPrintId = 'later':
        *pl 'Ты качаешь головой и говоришь, что сперва нужно всё как следует взвесить.'
        *pl ' '
        *pl 'Ирма ничуть не обижается — лишь сдержанно улыбается уголками губ:'
        *pl ' '
        *pl '— Дело твоё, Стефан. Подумай. Слухи никуда не денутся — они как въевшаяся копоть: чем дольше тянешь, тем глубже въедаются. Вопрос лишь в том, пропадёт ли этот интерес даром или принесёт тебе монету.'

    elseif $IrmaOfferPrintId = 'refuse_hard':
        *pl 'Ты резко осаживаешь портниху, дав понять, что подобным предложениям не место в твоём заведении.'
        *pl ' '
        *pl 'Полуэльфийка молча убирает отрез ткани обратно на полку, и взгляд её становится холодным:'
        *pl ' '
        *pl '— Как знаешь, хозяин. Моё дело малое — я всего лишь швея. Не я заставляю пьяных гостей глазеть на твоих девиц. Я лишь предлагала способ сделать так, чтобы эти взгляды окупались звонким серебром.'
    end

    killvar '$IrmaOfferPrintId'
---

#IrmaUniformOfferText
    ! Совместимость
    $IrmaUniformOfferTextId = LCASE($ARGS[0])
    $IrmaUniformOfferText = ''
    if $IrmaUniformOfferTextId = 'offer':
        $IrmaUniformOfferText = '— Слышала я, ты не слишком держишься за проповеди о благочестии, если на кону хорошая выручка... Сошью для твоих девушек особую рабочую форму: юбка покороче, ворот и декольте посмелее, но швы — на совесть.'
    end
    killvar '$IrmaUniformOfferTextId'
---
