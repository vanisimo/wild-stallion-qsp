! ================================================
! FILE: modules/locations/shops/irma_dance_dress_text.qsps
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Тексты: платья для пятничных танцев у Ирмы
! ================================================

#DanceDressPrintText
    gs 'DanceDressText', $ARGS[0], $ARGS[1]

    if $DanceDressText <> '':
        gs 'PrintMainLine', $DanceDressText
    end

    killvar '$DanceDressText'
---

#DanceDressText
    $DanceDressTextId = LCASE($ARGS[0])
    gs 'DanceDressNormalizeGirl', $ARGS[1]
    $DanceDressTextGirl = $DanceDressGirlKey
    $DanceDressText = ''

    if $DanceDressTextGirl <> '':
        gs 'DanceDressEnsureName', $DanceDressTextGirl
    end

    if $DanceDressTextId = 'talk_amanda_intro':
        $DanceDressText = 'Аманда отводит взгляд, но затем всё же произносит: — На площади все в нарядных платьях, а я в рабочем... Стыдно. Ирма шьёт для танцев, но одна я не пойду. Мама нас убьёт.'

    elseif $DanceDressTextId = 'talk_amanda_agree':
        $DanceDressText = 'Аманда краснеет и кивает: — Ладно. Сходим к Ирме вместе. Только не выбирай слишком откровенное, Стефан. И платишь ты — я на такое не копила.'

    elseif $DanceDressTextId = 'talk_amanda_later':
        $DanceDressText = '— Подумаю, — уклончиво бросает она. — Может, к пятнице и без нового обойдусь. — Но по взгляду ясно: оставаться без обновки ей совсем не хочется.'

    elseif $DanceDressTextId = 'talk_melissa_intro':
        $DanceDressText = '— На танцах смотрят на платья, а не на то, что внутри, — вздыхает Мелисса. — Ирма шьёт отлично, но одна я не пойду. Мама сразу заладит: «Хватит того, что подавальщицей работаешь, зачем тебе ещё и танцы».'

    elseif $DanceDressTextId = 'talk_melissa_agree':
        $DanceDressText = 'Мелисса поправляет прядь волос: — Ладно. Пойдём вместе. Но платье сугубо для танцев, не для зала. И мерки снимает Ирма — ты не подглядываешь.'

    elseif $DanceDressTextId = 'talk_melissa_later':
        $DanceDressText = '— Не сейчас. Сначала работа, а платье подождёт. — Впрочем, по голосу слышно: откладывать покупку ей тоже не по душе.'

    elseif $DanceDressTextId = 'blocked_no_girl':
        $DanceDressText = 'Ирма откладывает ножницы и смотрит вам за спину: — Стефан, я портниха, а не ясновидящая. Без самой девушки я мерок не сниму. Приведи ' + $RealName[$DanceDressTextGirl] + ' — тогда и поговорим.'

    elseif $DanceDressTextId = 'order_amanda':
        $DanceDressText = 'Ирма с улыбкой обводит Аманду взглядом: — Вот так. Сама пришла, сама ткань выбрала. Крой игривый — как раз для площади, а не для кабака. Семьдесят спинтарий, завтра примерка. Без примерки на танцы не пущу: наряд должен сидеть безупречно.'

    elseif $DanceDressTextId = 'order_melissa':
        if AmandaDanceDressOrdered = 1 or AmandaDanceDressReady = 1 or AmandaDanceDressPlayerBought = 1:
            $DanceDressText = 'Ирма откладывает отрез ткани: — Для Мелиссы фасон построже, чем для сестрицы. Семьдесят спинтарий, завтра жду на примерку. Мерки сняла — завтра подгоним, где нужно.'
        else:
            $DanceDressText = 'Ирма откладывает отрез ткани: — Строгий крой, как раз для площади. Семьдесят спинтарий, завтра на примерку. Мерки сняла — завтра подгоним, где нужно.'
        end

    elseif $DanceDressTextId = 'order_no_money':
        $DanceDressText = 'Ирма с сочувствием качает головой: — За нарядами приходят с полным кошельком, милый. Семьдесят спинтарий — и я сразу примусь за работу.'

    elseif $DanceDressTextId = 'ordered_amanda':
        $DanceDressText = '— Записала заказ, — кивает Ирма Аманде. — Завтра приходите вдвоём. Примерка быстрая, но без неё на площадь ни ногой.'

    elseif $DanceDressTextId = 'ordered_melissa':
        $DanceDressText = 'Ирма кивает Мелиссе: — Завтра жду на примерку. Опоздаешь — сошью по памяти. А память у меня на монеты, не на бёдра.'

    elseif $DanceDressTextId = 'fitting_amanda':
        $DanceDressText = 'Ирма подтягивает лиф и расправляет подол. Аманда с восторгом крутится у зеркала: — Ну вот... на танцах теперь совсем не стыдно показаться! Спасибо, Стефанчик!'

    elseif $DanceDressTextId = 'fitting_melissa':
        $DanceDressText = 'Ирма поправляет линию плеча и отступает в сторону. Мелисса непривычно долго смотрит на своё отражение: — Строго. Но очень красиво. На площади на меня не будут коситься как на простую кабатчицу.'

    elseif $DanceDressTextId = 'fitting_ready':
        $DanceDressText = 'Ирма вручает аккуратно упакованное платье: — Готово! В пятницу танцуй, пока ноги держат!'

    end

    killvar '$DanceDressTextId'
    killvar '$DanceDressTextGirl'
---