! ================================================
! FILE: modules/locations/shops/irma_dance_dress_text.qsps
! USER-OWNED TEXT
! [AI-WORKED] Текст переработан / дополнен ассистентом 28.10.2026
! Тексты: платья для пятничных танцев у Ирмы
! ================================================

#DanceDressPrintText
    gs 'DanceDressText', $ARGS[0], $ARGS[1]

    if $DanceDressText <> '':
        gs 'PrintMainLine', $DanceDressText
    end

    killvar '$DanceDressText'
---

#DanceDressText
    $DanceDressTextId = LCASE($ARGS[0])
    gs 'DanceDressNormalizeGirl', $ARGS[1]
    $DanceDressTextGirl = $DanceDressGirlKey
    $DanceDressText = ''

    if $DanceDressTextGirl <> '':
        gs 'DanceDressEnsureName', $DanceDressTextGirl
    end

    ! --- 1. Интро со смущением (Экран 1) ---
    if $DanceDressTextId = 'talk_amanda_hesitate':
        $DanceDressText = 'Аманда смущённо мнётся на месте, теребит край фартука и украдкой поглядывает на тебя, собираясь заговорить.'

    elseif $DanceDressTextId = 'talk_melissa_hesitate':
        $DanceDressText = 'Мелисса неловко пербирает руками край подноса и несколько раз бросает на тебя задумчивый, неуверенный взгляд.'

    ! --- 2. Сама просьба о платье (Экран 2) ---
    elseif $DanceDressTextId = 'talk_amanda_intro':
        $DanceDressText = 'Аманда отводит взгляд, но затем всё же произносит: — На площади все в нарядных платьях, а у меня нечего надеть... А в рабочем стыдно, подружки засмеют. Ирма шьёт красивые платья, помоги Стефанчик, сходи со мной, и это... денег дай.'

    elseif $DanceDressTextId = 'talk_melissa_intro':
        $DanceDressText = '— Знаешь Стефан, я бы хотела ходить на пятничные танцы, нет ты конечно можешь сказать: "хочешь так иди", я как бы раньше так и делала, но теперь я не девочка соплюшка, которая в чем попало может туда пойти, мне нужен соответствующий наряд. Не слишком сложно для тебя? Так вот не мог бы ты со мной посетить лавку Ирмы, и оплатить мне там платье, у меня нехватает, на нормальное платье.'

    ! --- 3. Согласие встретиться завтра утром в лавке (Экран 3А) ---
    elseif $DanceDressTextId = 'talk_amanda_agree':
        $DanceDressText = 'Аманда краснеет и радостно кивает: — Спасибо, Стефан! Договорились: завтра утром я буду ждать тебя прямо в лавке у Ирмы. Только приходи обязательно к открытию, не опаздывай!'

    elseif $DanceDressTextId = 'talk_melissa_agree':
        $DanceDressText = 'Мелисса с благодарностью смотрит на тебя: — Хорошо. Я пойду к Ирме завтра с самого утра и буду ждать тебя там. Не подведи меня, Стефан.'

    ! --- 4. Отказ Стефана: деньги нужны на закупки кабака (Экран 3Б) ---
    elseif $DanceDressTextId = 'talk_amanda_refuse':
        $DanceDressText = 'Ты объясняешь Аманде, что у неё есть свои чаевые и доля от таверны, и на наряд она вполне может накопить сама — сейчас трактиру нужны деньги на закупку товара. Аманда обиженно поджимает губы: — Ясно... Для трактира всё, а родной сестре на праздник пожалел.'

    elseif $DanceDressTextId = 'talk_melissa_refuse':
        $DanceDressText = 'Ты раскладываешь всё по полочкам: Мелисса получает свою долю прибыли и сама ведёт кошелёк, а таверне нужны средства на оборот и провизию. Мелисса холодно выпрямляет спину: — Деловые расчёты, понимаю. Мог бы просто сказать «нет», не читая нотаций. Обойдусь своими силами.'

    ! --- 5. Отложить разговор ---
    elseif $DanceDressTextId = 'talk_amanda_later':
        $DanceDressText = '— Подумаю, — уклончиво бросает она. — Может, к пятнице и без нового обойдусь. — Но по взгляду ясно: оставаться без обновки ей совсем не хочется.'

    elseif $DanceDressTextId = 'talk_melissa_later':
        $DanceDressText = '— Не сейчас. Сначала работа, а платье подождёт. — Впрочем, по голосу слышно: откладывать покупку ей тоже не по душе.'

    ! --- 6. Упрёк: Стефан не пришёл утром в лавку (Экран 4) ---
    elseif $DanceDressTextId = 'talk_amanda_missed':
        $DanceDressText = 'Аманда с порога встречает тебя с упрёком: — Ты же обещал прийти утром! Я ждала в лавке, а ты не пришёл!'

    elseif $DanceDressTextId = 'talk_melissa_missed':
        $DanceDressText = 'Мелисса скрещивает руки на груди, глядя на тебя ледяным взглядом: — Я прождала тебя у Ирмы всё утро. Ты обещал прийти, Стефан, а сам не пришёл.'

    elseif $DanceDressTextId = 'talk_amanda_forgive':
        $DanceDressText = 'Ты извиняешься, ссылаясь на срочные дела в таверне, и обещаешь прийти завтра с самого утра. Аманда шумно вздыхает: — Ладно... Поверю ещё раз. Но если снова обманешь — я с тобой неделю разговаривать не буду!'

    elseif $DanceDressTextId = 'talk_melissa_forgive':
        $DanceDressText = 'Ты спокойно признаёшь оплошность и просишь дать ещё один шанс завтра на рассвете. Мелисса медленно опускает руки: — Хорошо. Завтра утром я снова буду ждать у Ирмы. Но только один раз.'

    ! --- 7. В лавке у Ирмы: готовые платья со скидкой и подгонкой ---
    elseif $DanceDressTextId = 'shop_amanda_scene':
        $DanceDressText = 'Ирма откладывает ножницы и с улыбкой приветствует вас: — А вот и наш хозяин трактира! Шить наряд с нуля — дело долгое и дорогое, милый. А у меня как раз новая партия готовых платьев из столицы! Ткань великолепная, фасоны свежие. Нужно лишь выбрать, примерить и прямо сейчас подогнать по фигуре — выйдет и быстрее, и куда дешевле! Аманда с горящими глазами указывает на приталенный наряд с игривым, открытым вырезом: — Вот это! Стефанчик, посмотри, какое оно красивое! — Семьдесят спинтарий, — кивает Ирма. — И прямо сейчас сниму мерки и подгоню швы.'

    elseif $DanceDressTextId = 'shop_melissa_scene':
        $DanceDressText = 'Ирма откладывает мерную ленту и с уважением смотрит на вас: — Доброе утро, Стефан. За платьем пришли? Шить с нуля сейчас слишком накладно. Но у меня есть отличные готовые наряды из тонкой ткани! Нужно только выбрать фасон и быстро посадить по фигуре. Мелисса придирчиво разглядывает элегантное платье строгого, благородного кроя: — Вот это сидит достойно. Никаких лишних оборок, но подчеркивает всё, что нужно. — Семьдесят спинтарий, — говорит Ирма. — И сразу приступаем к подгонке.'

    ! --- 8. Подглядывание за ширму (2 экрана, формат диалога) ---
    ! Экран 1: Ирма просит снять одежду и бельё для идеальной посадки
    elseif $DanceDressTextId = 'shop_fitting_peep1':
        if $DanceDressTextGirl = 'amanda':
                        *pl 'Ты бесшумно отводишь край плотной шторы. Из-за ширмы доносится негромкий диалог:'
            *pl ' '
            *pl '— Раздевайся, Аманда, — командует Ирма, раскладывая булавки. — И трусики тоже снимай. Посмотрим, как лежит ткань, чтобы ни единый шов не проступал и не портил силуэт.'
            *pl ' '
            *pl '— Прямо совсем всё?.. — Аманда заливается краской и неловко прижимает руки к груди. — Стыдно же...'
            *pl ' '
            *pl '— Кого ты стесняешься, милая? — усмехается портниха. — Я за годы работы сотни девиц перемерила. Снимай, не упрямься.'
            *pl ' '
            *pl 'Аманда со вздохом скидывает остатки одежды, оставаясь перед зеркалом. Маленькие груди задорно торчат, соски вытали, то ли от прохлады в комнате, то ли от смущения.'
        else:
                        *pl 'Ты осторожно заглядываешь в зазор шторы. За ней идёт примерка:'
            *pl ' '
            *pl '— Снимай  платье, Мелисса, — деловито говорит Ирма, разглаживая мерную ленту. — И нижнее бельё тоже снимай. Посмотрим, как ляжет ткань на голое тело.'
            *pl ' '
            *pl '— Без белья? — Мелисса с лёгким сомнением приподнимает бровь. — Это действительно необходимо?'
            *pl ' '
            *pl '— Конечно, — объясняет портниха. — Любая тесьма испортит линию бёдер. Хочешь выглядеть достойно — доверься мастеру.'
            *pl ' '
            *pl 'Мелисса сдержанно кивает и сбрасывет трусики, поворачиваясь к ростовому зеркалу. Её грудь покачивается в так ее движениям, попка сестры кажется смотрит прямо на тебя, Ирма одобрительно прищелкивает языком.'
        end

    ! Экран 2: Наряд надет, проверка подола и реакция на шутки Ирмы
    elseif $DanceDressTextId = 'shop_fitting_peep2':
        if $DanceDressTextGirl = 'amanda':
                        *pl 'Ирма накидывает на Аманду нарядное платье и слегка приподнимает подол у бедра:'
            *pl ' '
            *pl '— Вот теперь видно! Без белья ткань ложится идеально гладко, нигде не топорщится. А если на танцах понгравившийся мальчик потянет в тёмный переулок — и снимать ничего не придётся, просто юбку приподняла и готово!'
            *pl ' '
            *pl '— Ирма! — Аманда вспыхивает до кончиков ушей и испуганно машет руками. — Что ты говоришь! Я на площадь иду только танцевать, и ни о каких мальчиках даже не думаю! Да и трусы буду одевать.'
            *pl ' '
            *pl '— Ну ну, а то я не знаю для чего на танцы ходят, - смеется Ирма'
        else:
                        *pl 'Платье надето, и Ирма аккуратно приподнимает край подола, проверяя свободу движения:'
            *pl ' '
            *pl '— Великолепно. Подол лег ровно, юбка взлетает при каждом шаге. Любой городской парень голову потеряет, а если захочешь кому то дать, так и всего делов юбку подняла, и готово!'
            *pl ' '
            *pl '— Ирма, держи свои намёки при себе, — отзывается Мелисса, одёргивая подол. — Я иду на праздник ради танцев, а не ради кому то дать...'
            *pl ' '
            *pl '— Ну ну, а то я не знаю для чего на танцы ходят, - смеется Ирма'
        end

    elseif $DanceDressTextId = 'shop_fitting_peep':
        $DanceDressText = 'Ты бесшумно приоткрываешь зазор шторы, наблюдая за примеркой нового наряда.'

    ! --- 9. Финальный показ и восторг ---
    elseif $DanceDressTextId = 'shop_fitting_finish_amanda':
        $DanceDressText = 'Ширма распахивается, и Аманда предстаёт перед тобой в готовом, безупречно подогнанном платье. Глаза её горят восторгом, щёки залиты румянцем. Она кружится перед ростовым зеркалом, любуясь каждой складкой: — Ну как я тебе? Теперь на танцах я точно буду самая красивая! Спасибо тебе огромное, Стефан! Ирма с улыбкой вручает аккуратно упакованный наряд: — Готово! Теперь в пятницу пляшите, пока ноги держат!'

    elseif $DanceDressTextId = 'shop_fitting_finish_melissa':
        $DanceDressText = 'Ширма отодвигается, и Мелисса выходит к зеркалу. Новое платье преображает её: строгие линии подчёркивают гибкую талию и осанку, придавая ей вид благородной городской дамы. Она сдержанно, но с явной гордостью улыбается: — Сидит безукоризненно. Теперь на площади никто не посмеет смотреть на меня сверху вниз. Спасибо, Стефан. Ирма передаёт свёрток с нарядом: — Носи на радость, милая! В пятницу покажи им всем!'

    ! --- 10. Если не хватило денег или отказ в лавке ---
    elseif $DanceDressTextId = 'shop_amanda_no_money' or $DanceDressTextId = 'shop_melissa_no_money':
        $DanceDressText = 'Ирма сочувственно разводит руками: — За нарядами приходят с серебром, милый. Семьдесят спинтарий — и я сразу примусь за работу. Девушка сгорает от неловкости и опускает глаза: — Стефан... зачем ты позвал меня сюда, если у тебя нет денег? Какая стыдоба...'

    elseif $DanceDressTextId = 'shop_cancel':
        $DanceDressText = 'Ты говоришь, что семьдесят спинтарий — слишком дорого, и таверне сейчас нужнее эти деньги на закупку товара. Девушка обиженно поджимает губы, бросая грустный взгляд на выбранное платье: — Понятно... Зачем тогда вообще было обещать и приводить меня сюда?'

    ! --- 11. Прежние тексты для совместимости ---
    elseif $DanceDressTextId = 'blocked_no_girl':
        if $DanceDressTextGirl = 'amanda':
            $DanceDressText = 'Ирма откладывает ножницы и смотрит тебе за спину: — Стефан, я портниха, а не ясновидящая. Без самой девушки я мерок не сниму. Приведи Аманду — тогда и поговорим.'
        elseif $DanceDressTextGirl = 'melissa':
            $DanceDressText = 'Ирма откладывает ножницы и смотрит тебе за спину: — Стефан, я портниха, а не ясновидящая. Без самой девушки я мерок не сниму. Приведи Мелиссу — тогда и поговорим.'
        else:
            $DanceDressText = 'Ирма откладывает ножницы и смотрит тебе за спину: — Стефан, я портниха, а не ясновидящая. Без самой девушки я мерок не сниму.'
        end

    elseif $DanceDressTextId = 'order_amanda':
        $DanceDressText = 'Ирма с улыбкой обводит Аманду взглядом: — Вот так. Сама пришла, сама ткань выбрала. Крой игривый — как раз для площади, а не для кабака. Семьдесят спинтарий, и прямо сейчас подгоним по фигуре.'

    elseif $DanceDressTextId = 'order_melissa':
        $DanceDressText = 'Ирма откладывает отрез ткани: — Для Мелиссы фасон построже, чем для сестрицы. Семьдесят спинтарий, и сразу сниму мерки и подгоню швы.'

    elseif $DanceDressTextId = 'order_no_money':
        $DanceDressText = 'Ирма с сочувствием качает головой: — За нарядами приходят с полным кошельком, милый. Семьдесят спинтарий — и я сразу примусь за работу.'

    elseif $DanceDressTextId = 'fitting_amanda':
        $DanceDressText = 'Ирма подтягивает лиф и расправляет подол. Аманда с восторгом крутится у зеркала: — Ну вот... на танцах теперь совсем не стыдно показаться! Спасибо, Стефанчик!'

    elseif $DanceDressTextId = 'fitting_melissa':
        $DanceDressText = 'Ирма поправляет линию плеча и отступает в сторону. Мелисса непривычно долго смотрит на своё отражение: — Строго. Но очень красиво. На площади на меня не будут коситься как на простую кабатчицу.'

    elseif $DanceDressTextId = 'fitting_ready':
        $DanceDressText = 'Ирма вручает аккуратно упакованное платье: — Готово! В пятницу танцуй, пока ноги держат!'

    end

    killvar '$DanceDressTextId'
    killvar '$DanceDressTextGirl'
---
