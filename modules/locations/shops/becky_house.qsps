! ================================================
! FILE: modules/locations/shops/becky_house.qsps
! MODULE: locations
! Точки входа в дом Бекки (обёртки над becky_home_chain)
! ================================================

#BeckyHouse
    gt 'BeckyHomeFront', 'guest'
---

#IngaRoom
    cls

    gs 'ShowLocationScreenTitle', 'КОМНАТА ИНГИ'

    if time >= 3 or IngaDanceEnded = 1:
        $GirlLocation['inga'] = 'IngaRoom'
    end

    gs 'ShowGirlInLocation', 'inga', 'IngaRoom'

    if LOC('IngaRoomIntroText') = 1:
        gs 'IngaRoomIntroText'
    else:
        *p 'Небольшая комната над лавкой. Здесь Инга прячется от матери и Лукаса — когда выбирает тебя.'
    end

    *pl ' '

    if $GirlLocation['inga'] <> 'IngaRoom':
        *p 'Инги сейчас нет в комнате.'
    else:
        if IngaRoomFirstSexDone = 0 and (IngaRomanceStage >= 3 or IngaRomanceUnlocked = 1):
            gs 'ActUiPrepare', 'Остаться на ночь с Ингой', 'intim'
            act $ActUiLabel, $ActUiIconPath:
                gt 'IngaRoomFirstSex'
            end
        elseif (IngaRoomFirstSexDone = 1 or IngaBackroomSex = 1) and LOC('SexSceneStart') = 1 and time >= 3:
            gs 'ActUiPrepare', 'Провести вечер с Ингой', 'intim'
            act $ActUiLabel, $ActUiIconPath:
                gt 'SexSceneStart', 'inga', 'IngaRoomAfterSex', 'inga_repeat'
            end
        end

        if LOC('IngaLucasWindowCanOffer') = 1:
            gs 'IngaLucasWindowCanOffer'

            if IngaLucasWindowCanOffer = 1:
                gs 'ActUiPrepare', 'Заглянуть в окно', 'look'
                act $ActUiLabel, $ActUiIconPath:
                    gt 'IngaLucasWindowEvent'
                end
            end
        end

        if LOC('IngaLucasThreesomeCanStart') = 1:
            gs 'IngaLucasThreesomeCanStart'

            if IngaLucasThreesomeCanStart = 1:
                if IngaLucasThreesomeCount = 0:
                    gs 'ActUiPrepare', 'Продолжить с Лукасом', 'generic'
                    act $ActUiLabel, $ActUiIconPath:
                        gt 'IngaLucasThreesome1Start'
                    end
                elseif IngaLucasThreesomeCount = 1:
                    gs 'ActUiPrepare', 'Снова втроём', 'generic'
                    act $ActUiLabel, $ActUiIconPath:
                        gt 'IngaLucasThreesome2Start'
                    end
                end
            end
        end

        if LOC('IngaLucasAnalCanStart') = 1:
            gs 'IngaLucasAnalCanStart'

            if IngaLucasAnalCanStart = 1:
                gs 'ActUiPrepare', 'Предложить анальную близость', 'intim'
                act $ActUiLabel, $ActUiIconPath:
                    gt 'IngaLucasAnalSceneStart'
                end
            end
        end

        if LOC('IngaLucasThreesomeDpCanStart') = 1:
            gs 'IngaLucasThreesomeDpCanStart'

            if IngaLucasThreesomeDpCanStart = 1:
                if IngaLucasDpDone = 0:
                    gs 'ActUiPrepare', 'Предложить в два ствола', 'generic'
                    act $ActUiLabel, $ActUiIconPath:
                        gt 'GroupSexIngaLucasDpStart'
                    end
                else:
                    gs 'ActUiPrepare', 'Снова в два ствола', 'generic'
                    act $ActUiLabel, $ActUiIconPath:
                        gt 'GroupSexIngaLucasDpStart'
                    end
                end
            end
        end
    end

    killvar 'LocationGirlShown'

    *pl ' '

    gs 'ActUiPrepare', 'Спуститься в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'BeckyShop'
    end

    gs 'ActUiPrepare', 'Выйти на рынок', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#IngaRoomAfterSex
    *p 'Инга поправляет одежду и смотрит на тебя с тихой улыбкой.'
    *pl ' '

    if IngaRoomFirstSexDone = 0 or IngaBackroomSex = 0:
        IngaRoomFirstSexDone = 1
        IngaBackroomSex = 1
        IngaDanceUnlocked = 1
        IngaRoomUnlocked = 1
        if virginity['inga'] = 1:
            virginity['inga'] = 0
        end
        love['inga'] += 2
        Friends['inga'] += 2
        sluttiness['inga'] += 2
        gs 'ClampGirlSocialStats', 'inga'
    end

    if LOC('BeckyCatchIngaLucasCanStart') = 1:
        gs 'BeckyCatchIngaLucasCanStart'

        if BeckyCatchIngaLucasCanStart = 1 and IngaLucasThreesomeCount >= 1:
            gt 'BeckyCatchIngaLucasStart'
        end
    end

    gs 'ActUiPrepare', 'Остаться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IngaRoom'
    end
---