! ================================================
! FILE: modules/locations/shops/draupnir_upgrades_text.qsps
! MODULE: locations/shops
! [AI-WORKED] Текст переработан / дополнен ассистентом 25.11.2026
! Тексты улучшений у Драупнира
! ================================================

#DraupnirUpgradesIntroText
    gs 'TavernUpgradeCountCompleted'
    DraupnirKnowsAffair = 0
    if PlayerKnows_SandraDraupnirFriday = 1 or PlayerKnows_SandraDraupnirAffair = 1 or SandraCarpenterSecret = 1:
        DraupnirKnowsAffair = 1
    end
    if DraupnirKnowsAffair = 1:
        if TavernUpgradeSignDone = 0:
            *pl 'Драупнир усмехается в седую бороду, заплетённую в две косы, и кивает на улицу.'
            *pl ' '
            *pl '— Вывеска у тебя облезлая, как старый пень. С неё и начнём — дом, где твоя мать хозяйничает, должен сиять.'
        elseif TavernUpgradesCompletedCount >= 5:
            *pl 'Гном хлопает ладонью по столу и расплывается в довольной ухмылке.'
            *pl ' '
            *pl '— Полтрактира мы уже перебрали на славу, Стефан. Осталось чуть-чуть довести до ума — и Сандра с девчонками нарадоваться не смогут.'
        else:
            *pl 'Драупнир одобрительно кивает, скрестив руки на груди.'
            *pl ' '
            *pl '— Вывеска на месте, дело пошло. Что дальше по трактиру? Для дома Сандры схалтурить не дам.'
        end
    else:
        if TavernUpgradeSignDone = 0:
            *pl 'Гном скупо меряет тебя взглядом из-под кустистых бровей.'
            *pl ' '
            *pl '— Видел твою вывеску. Облезла до безобразия. Хочешь оживить трактир — начни с лица. Остальное потом.'
        elseif TavernUpgradesCompletedCount >= 5:
            *pl 'Драупнир кивает уважительно, поправляя инструмент на поясе.'
            *pl ' '
            *pl '— Половину дела уже осилили, хозяин. Крепкий трактир выходит. Говори, за что ещё берёмся.'
        else:
            *pl 'Гном пожимает плечами и проводит мозолистой ладонью по верстаку.'
            *pl ' '
            *pl '— Вывеска теперь как надо. Дело пошло. Что дальше заказываешь?'
        end
    end
    if MelissaMusicStageOfferDone = 1 and TavernUpgradeStageDone = 0:
        *pl '— Кстати, — добавляет гном, прищурившись, — сестрица твоя учёная заикалась о сцене для музыкантов. Надумаешь поставить — доска у меня найдётся звонкая.'
    end
    *pl ' '
    killvar 'DraupnirKnowsAffair'
---

#DraupnirUpgradeOrderDoneText
    $DraupnirDoneKey = LCASE($ARGS[0])
    DraupnirKnowsAffair = 0
    if PlayerKnows_SandraDraupnirFriday = 1 or PlayerKnows_SandraDraupnirAffair = 1 or SandraCarpenterSecret = 1:
        DraupnirKnowsAffair = 1
    end
    if $DraupnirDoneKey = 'sign':
        *pl 'Драупнир оглаживает бороду и прищуривается на стену, будто уже видит готовую работу.'
        *pl ' '
        *pl '— Резная дубовая доска, буквы глубокие — с улицы за полверсты видно будет. Пропитка от дождя, три слоя. Лет десять не облезет.'
    elseif $DraupnirDoneKey = 'exterior':
        *pl 'Гном прикидывает что-то в уме, шевеля губами, и коротко кивает.'
        *pl ' '
        *pl '— Залатаю щели, сменю гнилые доски наличников, укреплю крыльцо. Гости увидят добротный дом ещё с дороги.'
    elseif $DraupnirDoneKey = 'kitchen':
        *pl 'Драупнир достаёт из-за уха огрызок плотницкого карандаша и чиркает по дощечке.'
        *pl ' '
        *pl '— Сменю разделочные столы, проложу сухие полки, подгоню вытяжной короб. Жара и тесноты поубавится.'
        if DraupnirKnowsAffair = 1:
            *pl 'Он делает паузу и добавляет тише, с тёплой хрипотцой:'
            *pl ' '
            *pl '— Пусть Сандре работается легче. Спину ей ломить не должно.'
        end
    elseif $DraupnirDoneKey = 'bar':
        *pl 'Гном хлопает ладонью по верстаку — глухо и весомо.'
        *pl ' '
        *pl '— Толстый выдержанный дуб, гладкая полировка без единой занозы. Выдержит любую пьяную потасовку и любую кружку.'
    elseif $DraupnirDoneKey = 'cellar':
        *pl 'Драупнир скрещивает руки и смотрит исподлобья, будто оценивая невидимый подвал.'
        *pl ' '
        *pl '— Прочные стеллажи и брусья под бочки и припасы. Не просядут, не загниют. Хоть кабанью тушу клади.'
    elseif $DraupnirDoneKey = 'doors':
        *pl 'Гном берёт с верстака тяжёлую кованую петлю и подкидывает на ладони.'
        *pl ' '
        *pl '— Кованые петли и тяжёлые скобы на дверях. Хоть ногами бей — не вылетят. Засовы сам проверю.'
    elseif $DraupnirDoneKey = 'lamp':
        *pl 'Драупнир поднимает взгляд к потолку мастерской и чертит пальцем в воздухе круг.'
        *pl ' '
        *pl '— Кованая люстра под потолок на цепях. Вечером в зале светло и уютно, девчонкам сподручнее работать.'
    elseif $DraupnirDoneKey = 'stage':
        *pl 'Гном усмехается в усы и притопывает ногой по половице.'
        *pl ' '
        *pl '— Звонкая сухая сосна, прочный помост. Даже если твоя книжница и этот её лютнист начнут плясать — не прогнётся.'
    else:
        *pl 'Драупнир кивает и делает пометку на дощечке.'
        *pl ' '
        *pl '— Записал. Сделаю в срок.'
    end
    if DraupnirKnowsAffair = 1:
        *pl 'Гном протягивает тебе мозолистую ладонь и сжимает крепко, по-мужски.'
        *pl ' '
        *pl '— Свои люди, Стефан. Сделаю как для себя.'
    else:
        *pl 'Драупнир убирает карандаш за ухо и поправляет ремень.'
        *pl ' '
        *pl '— Приду и сделаю без суеты. Зал закрывать не придётся.'
    end
    *pl ' '
    killvar '$DraupnirDoneKey'
    killvar 'DraupnirKnowsAffair'
---

#DraupnirUpgradeOrderNoMoneyText
    DraupnirKnowsAffair = 0
    if PlayerKnows_SandraDraupnirFriday = 1 or PlayerKnows_SandraDraupnirAffair = 1 or SandraCarpenterSecret = 1:
        DraupnirKnowsAffair = 1
    end
    if DraupnirKnowsAffair = 1:
        *pl 'Драупнир качает головой, и в уголках глаз собираются добродушные морщины.'
        *pl ' '
        *pl '— Свои мы или нет, а дуб и железо на слово не купишь. Донесёшь спринтрии — сразу займусь.'
    else:
        *pl 'Драупнир хмурится и звонко пристукивает молотком по наковаленке.'
        *pl ' '
        *pl '— Молотком по воздуху за «спасибо» не машу. Принесёшь спринтрии — тогда и начнём.'
    end
    *pl ' '
    killvar 'DraupnirKnowsAffair'
---
#DraupnirUpgradeOrderBlockedText
    if $TavernUpgradeOrderBlockReason <> '':
        *pl '— ' + $TavernUpgradeOrderBlockReason
        *pl ' '
    end
---

#DraupnirUpgradeLineText
    if $DraupnirUpgradeLineStatus = 'done':
        $DraupnirUpgradeLineText = $DraupnirUpgradeLineTitle + ': готово'
    elseif $DraupnirUpgradeLineStatus = 'pending':
        $DraupnirUpgradeLineText = $DraupnirUpgradeLineTitle + ': в работе, осталось ' + STR(DraupnirUpgradeLineDaysLeft) + ' дн.'
    elseif $DraupnirUpgradeLineStatus = 'locked':
        $DraupnirUpgradeLineText = $DraupnirUpgradeLineTitle + ': пока недоступно'
    else:
        gs 'FormatSpintry', DraupnirUpgradeLineCost
        $FormatSpintry_DraupnirUpgradeLineCost = $FormatSpintry
        killvar '$FormatSpintry'
        $DraupnirUpgradeLineText = $DraupnirUpgradeLineTitle + ': ' + $FormatSpintry_DraupnirUpgradeLineCost + ', ' + STR(DraupnirUpgradeLineDays) + ' дн.'
    end
---
