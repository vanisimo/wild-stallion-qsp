! ================================================
! FILE: modules/locations/shops/irma_first_meet.qsps
! [AI-WORKED] Текст переработан / дополнен ассистентом 16.11.2026
! Первое знакомство с Ирмой в лавке
! Версия: v3
! ================================================

#IrmaFirstMeet
    $IrmaFirstMeetReturnLoc = $ARGS[0]

    if $IrmaFirstMeetReturnLoc = '':
        $IrmaFirstMeetReturnLoc = 'IrmaShop'
    end

    if LOC($IrmaFirstMeetReturnLoc) = 0:
        $IrmaFirstMeetReturnLoc = 'IrmaShop'
    end

    cls

    gs 'ShowLocationScreenTitle', 'ИРМА'
    gs 'ShowImage', 'irma', 'shop', 'talk', 'normal'

    *pl 'Полуэльфийка откладывает ножницы и внимательно смотрит на тебя — не враждебно, скорее оценивающе, как портниха оценивает фигуру клиента:'
    *pl ' '
    *pl '— Стефан Лонгкок, верно? Слышала про молодого хозяина «Дикого Жеребца». Добро пожаловать в мою лавку.'
    *pl ' '
    *pl 'Она обводит взглядом твой наряд и чуть усмехается:'
    *pl ' '
    *pl '— Солидный молодой человек, а одет… как будто вчера ещё таскал полные кружки за стойкой. Тебе давно пора завести новый костюм — приличный, чтобы и в мэрию можно было зайти, и на площади не стыдно стоять рядом с нарядными дамами.'
    *pl ' '
    *pl 'Ирма кивает на вешалки с платьями:'
    *pl ' '
    *pl '— И если соберёшься водить сестёр на танцы — тоже приходи ко мне. Без хорошего платья в пятницу на площади не показываются.'

    IrmaMet = 1
    Friends['irma'] += 2

    if IrmaLastVisitDay <> day:
        IrmaVisits = 1
        IrmaLastVisitDay = day
    end

    $TalkGirl = 'irma'
    $TalkReturnLoc = $IrmaFirstMeetReturnLoc

    gs 'GirlTalkSessionBegin'
    gs 'EnsureGirlData', 'irma'
    gs 'GirlTalkBuildIrmaMainMenu'

    gs 'GirlTalkShowSidebarWithAnchor', 'irma'

    *pl ' '
    gs 'GirlTalkShowNpcMenuAnchor', 'main'
    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в лавку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'GirlTalkMenuReturn'
    end

    killvar '$IrmaFirstMeetReturnLoc'
---
