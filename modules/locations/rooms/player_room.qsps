! ================================================
! FILE: modules/locations/player_room.qsps
! Личная комната Стефана
! Сундук, сон и личные действия
! Картинка зависит от времени суток
! ================================================

#PlayerRoom
    cls

    gs 'AddGlobalButtons'

    if SandraBirthRevealNightPending = 1 and time = 5:
        gt 'SandraBirthRevealNightScene'
        exit
    end

    gs 'ShowLocationScreenTitle', 'ЛИЧНАЯ КОМНАТА СТЕФАНА'

    gs 'ShowLocationImage', 'player_room', 'full', 'png'

    *p 'Это ваша комната на втором этаже трактира.'
    *p 'Здесь стоит простая кровать, рабочий стол, сундук с вещами и небольшое окно, выходящее во двор.'
    *p 'Комната скромная, но это единственное место, где можно спокойно остаться наедине с собой.'

    *pl ' '

    act '<b>Осмотреть комнату</b>', 'images/common/ui/actions/look.png':
        *pl ' '
        *p 'Вы осматриваете комнату внимательнее. Кровать грубая, но достаточно удобная. В сундуке лежат ваши вещи, а на столе можно найти несколько записей о делах трактира.'
    end

    act '<b>Сундук</b>', 'images/common/ui/actions/gift.png':
        gt 'PlayerRoomChest'
    end

    act '<b>Умывальник (бритьё)</b>', 'images/common/ui/actions/look.png':
        gt 'PlayerRoomGroom'
    end

    act '<b>Лечь спать до утра</b>', 'images/common/ui/actions/sleep.png':
        gt 'NextDay'
    end

    act '<b>Мастурбировать</b>', 'images/common/ui/actions/intim.png':
        gt 'PlayerRoomMasturbate'
    end

    act '<b>Выйти в коридор</b>', 'images/common/ui/actions/floor.png':
        gt 'TavernSecondFloor'
    end
---

#PlayerRoomMasturbate
    gs 'CanCumToday'

    cls

    gs 'ShowLocationImage', 'rooms/player/masturbate', 'full', 'png'

    if PlayerCanCumToday = 0:
        *pl ' '
        *p 'Вы слишком устали. Сегодня вы уже не сможете кончить.'
        *pl ' '
        *pl 'Оргазмы сегодня: ' + STR(daily_cum_count) + ' / ' + STR(max_daily_cum)

        act '<b>Продолжить</b>', 'images/common/ui/actions/return.png':
            gt 'PlayerRoom'
        end

        exit
    end

    *pl ' '
    *p 'Вы решили снять напряжение в одиночестве.'

    gs 'RegisterPlayerCum'

    if Result = 1:
        *p 'Напряжение наконец отпускает. Вы тяжело переводите дыхание и приводите себя в порядок.'
        *pl ' '
        *pl 'Оргазмы сегодня: ' + STR(daily_cum_count) + ' / ' + STR(max_daily_cum)
    end

    *pl ' '

    act '<b>Продолжить</b>', 'images/common/ui/actions/return.png':
        gt 'PlayerRoom'
    end
---

#PlayerRoomGroom
    cls

    gs 'ShowLocationScreenTitle', 'УМЫВАЛЬНИК'
    gs 'ShowLocationImage', 'player_room', 'full', 'png'

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' УМЫВАЛЬНИК В КОМНАТЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if PlayerHasTaro > 0:
        if PlayerShavedDay = day:
            *pl 'Ты уже приводил себя в порядок сегодня: щёки и подбородок безупречно гладкие, щетина ещё не успела пробиться.'
            *pl 'Ты просто ополаскиваешь лицо прохладной водой, чувствуя приятную свежесть.'
        else:
            PlayerHasTaro -= 1
            PlayerShavedDay = day

            *pl 'Ты наливаешь в глиняную плошку немного воды из кувшина и всыпаешь щепоть серого порошка Таро. По комнате разносится слабый знакомый запах сушёных трав и щёлочи.'
            *pl ' '
            *pl 'Размешав пальцем порошок в мягкую кашицу, ты щедро наносишь её на подбородок и щёки, аккуратно подравнивая линию на теле по завету Ильматера. Спустя минуту ты смываешь всё свежей водой из таза.'
            *pl ' '
            *pl 'Вся щетина исчезла без следа: кожа лица стала безупречно чистой, свежей и гладкой, как шёлк — ни малейшего намёка на волоски или порезы. Ощущение бодрости и опрятности наполняет уверенностью.'

            if charisma < 50:
                charisma += 1
            end
        end

        *pl ' '
        *pl 'Запас порошка Таро в мешочке: ' + STR(PlayerHasTaro) + ' / 5'
    else:
        *pl 'Ты плещешь в лицо холодной водой из таза, стирая остатки сна и усталости.'
        *pl ' '
        *pl 'Проведя ладонью по щеке, ты чувствуешь колючую щетину. Порошка Таро у тебя с собой нет — стоит наведаться в собор Ильматера и бесплатно набрать немного из глиняных кувшинов у алтаря.'
    end

    *pl ' '

    act '<b>Вернуться в комнату</b>', 'images/common/ui/actions/return.png':
        gt 'PlayerRoom'
    end
---
