! ================================================
! FILE: modules/locations/rooms/player_room_chest.qsps
! MODULE: locations/rooms
! Сундук Стефана: гардероб, снаряжение и тайное отделение
! ================================================

#PlayerRoomChest
    *clr
    clr
    cla

    gs 'UpdatePlayerClothes'

    gs 'ShowLocationScreenTitle', 'СУНДУК СТЕФАНА'
    gs 'ShowLocationImage', 'rooms/player/chest', 'full', 'png'

    *pl 'Ты открываешь тяжелый дубовый сундук в углу своей комнаты.'
    *pl 'Здесь аккуратно сложены твои сменные вещи, личные бумаги и дорожное снаряжение.'
    *pl ' '
    *pl '<b>Сейчас на тебе надето:</b>'
    *pl '• Одежда: <b>' + $StefanCurrentSuitName + '</b>'

    if PlayerArmorChest = 'leather_vest':
        *pl '• Нагрудник: ' + IIF(EquippedChest = 1, 'Кожаный нагрудник [НАДЕТ]', 'Снят (в сундуке)')
    end
    if PlayerArmorHead = 'leather_helmet':
        *pl '• Шлем: ' + IIF(EquippedHead = 1, 'Кожаный шлем [НАДЕТ]', 'Снят (в сундуке)')
    end
    if PlayerWeapon = 'dwarven_shortsword':
        *pl '• Оружие: ' + IIF(EquippedWeapon = 1, 'Гномий короткий меч [НАДЕТ]', 'Снят (в сундуке)')
    end

    if PlayerChestSecretKnown = 1 and BirthCertificateFound = 0:
        *pl ' '
        *pl '<i>Ты помнишь слова матери о двойном дне под старым кожаным ремнём.</i>'
    end

    *pl ' '

    ! ==================== ГАРДЕРОБ: СМЕНА ОДЕЖДЫ ====================

    if StefanWearingRespectableSuit = 1 or StefanWearingNobleSuit = 1:
        gs 'ActUiPrepare', 'Надеть простую одежду (холщовые штаны и рубаху)', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            StefanWearingRespectableSuit = 0
            StefanWearingNobleSuit = 0
            gs 'UpdatePlayerClothes'
            gt 'PlayerRoomChest'
        end
    end

    if PlayerHasRespectableSuit = 1 and StefanWearingRespectableSuit = 0:
        gs 'ActUiPrepare', 'Надеть приличный костюм от Ирмы', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            StefanWearingRespectableSuit = 1
            StefanWearingNobleSuit = 0
            gs 'UpdatePlayerClothes'
            gt 'PlayerRoomChest'
        end
    end

    if PlayerHasNobleSuit = 1 and StefanWearingNobleSuit = 0:
        gs 'ActUiPrepare', 'Надеть парадный дворянский наряд', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            StefanWearingNobleSuit = 1
            StefanWearingRespectableSuit = 0
            gs 'UpdatePlayerClothes'
            gt 'PlayerRoomChest'
        end
    end

    ! ==================== БОЕВОЕ СНАРЯЖЕНИЕ ====================

    if PlayerArmorChest = 'leather_vest':
        if EquippedChest = 1:
            gs 'ActUiPrepare', 'Снять кожаный нагрудник', 'return'
            act $ActUiLabel, $ActUiIconPath:
                EquippedChest = 0
                gt 'PlayerRoomChest'
            end
        else:
            gs 'ActUiPrepare', 'Надеть кожаный нагрудник', 'policy'
            act $ActUiLabel, $ActUiIconPath:
                EquippedChest = 1
                gt 'PlayerRoomChest'
            end
        end
    end

    if PlayerArmorHead = 'leather_helmet':
        if EquippedHead = 1:
            gs 'ActUiPrepare', 'Снять кожаный шлем', 'return'
            act $ActUiLabel, $ActUiIconPath:
                EquippedHead = 0
                gt 'PlayerRoomChest'
            end
        else:
            gs 'ActUiPrepare', 'Надеть кожаный шлем', 'policy'
            act $ActUiLabel, $ActUiIconPath:
                EquippedHead = 1
                gt 'PlayerRoomChest'
            end
        end
    end

    if PlayerWeapon = 'dwarven_shortsword':
        if EquippedWeapon = 1:
            gs 'ActUiPrepare', 'Снять гномий меч', 'return'
            act $ActUiLabel, $ActUiIconPath:
                EquippedWeapon = 0
                gt 'PlayerRoomChest'
            end
        else:
            gs 'ActUiPrepare', 'Надеть гномий меч', 'policy'
            act $ActUiLabel, $ActUiIconPath:
                EquippedWeapon = 1
                gt 'PlayerRoomChest'
            end
        end
    end

    ! ==================== ТАЙНИК И ДОКУМЕНТЫ ====================

    if PlayerChestSecretKnown = 1 and BirthCertificateFound = 0:
        gs 'ActUiPrepare', 'Осмотреть тайное отделение', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'PlayerRoomChestSecret'
        end
    end

    if BirthCertificateFound = 1:
        gs 'ActUiPrepare', 'Перечитать свидетельство о рождении', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'PlayerRoomBirthCertificateRead'
        end
    end

    gs 'ActUiPrepare', 'Закрыть сундук', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'PlayerRoom'
    end
---

#PlayerRoomChestSecret
    cls

    gs 'ShowLocationScreenTitle', 'ТАЙНОЕ ОТДЕЛЕНИЕ'

    *pl 'Ты отстёгиваешь старый кожаный ремень и приподнимаешь двойное дно. Под ним — узкий отсек, пахнущий сухой травой и воском.'
    *pl 'Там лежит сложенный пергамент в потемневшей кожаной обложке.'

    BirthCertificateFound = 1
    BirthCertificateFatherSealOnly = 1

    if LOC('KnowledgeRegisterFact') = 1:
        gs 'KnowledgeRegisterFact', 'Stefan_BirthCertificateFound_1'
    end

    Fact_StefanBirthCertificateFound = 1

    *pl ' '

    gs 'ActUiPrepare', 'Прочитать свидетельство', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'PlayerRoomBirthCertificateRead'
    end

    gs 'ActUiPrepare', 'Вернуться к сундуку', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'PlayerRoomChest'
    end
---

#PlayerRoomBirthCertificateRead
    cls

    gs 'ShowLocationScreenTitle', 'СВИДЕТЕЛЬСТВО О РОЖДЕНИИ'

    if LOC('ShowImagePath') = 1:
        gs 'ShowImagePath', 'images/events/family/birth_certificate', '', 'event', 'png'
    end

    gs 'InitBirthCertificateArc'
    gs 'BirthCertificateReadText'

    BirthCertificateRead = 1

    if BirthCertificateMagistrateConfirmed = 1:
        *pl ' '
        *pl 'Рядом с отцовской печатью теперь стоит магистратский штамп — документ признан законом.'
    elseif BirthCertificateMagistratePending = 1:
        *pl ' '
        *pl 'Документ уже подан в мэрию. Окончательного ответа ещё нет.'
    elseif BirthCertificateMagistrateSubmitted = 0:
        *pl ' '
        *pl 'Чтобы документ имел силу, его нужно подтвердить у магистрата в мэрии — по средам и четвергам, в полдень или днём.'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Убрать документ', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        gt 'PlayerRoomChest'
    end
---
