! ================================================
! FILE: modules/locations/rooms/room_night_events.qsps
! MODULE: locations/rooms
! [AI-WORKED] Текст переработан / дополнен ассистентом 01.11.2026
! Ночные события в спальнях: спящие девушки и уединение
! ================================================

#FamilySleepingGirlScene
    *clr
    clr
    cla

    $SleepGirl = LCASE($ARGS[0])

    ! Фиксируем ночное посещение и сбрасываем флаг глубокого сна
    FamilySleepingGirlVisitedDay = day
    FamilyDeepSleepTonight[$SleepGirl] = 0
    FamilyGirlSleepingDeep = 0

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: ТИХИЙ СОН'
    gs 'SceneShowVisual', 'images/events/family/sleeping_' + $SleepGirl, 'Спящая ' + $RealName[$SleepGirl], 'large', 'webp'

    if $SleepGirl = 'amanda':
        *pl 'Ты бесшумно приоткрываешь дверь в спальню Аманды. В мягком лунном свете, струящемся из окна, она кажется совсем юной и безмятежной.'
        *pl 'Сестра свернулась калачиком, подложив ладонь под щёку, и ровно, сладко дышит. Тонкая ночная сорочка чуть сбилась, приоткрывая стройные бёдра и мягкую линию талии. Дневное упрямство и капризы растаяли без следа — во сне её черты удивительно кротки.'

    elseif $SleepGirl = 'melissa':
        *pl 'Ты тихо ступаешь через порог спальни Мелиссы. На прикроватном столике аккуратно сложены книги и бумаги, а рядом лежат её очки.'
        *pl 'Сама Мелисса спит, раскинув тёмные волосы по подушке. Даже во сне её брови иногда чуть вздрагивают, будто она продолжает решать в уме сложные расчёты или спорить с кем-то в библиотеке. Лёгкая ткань мягко облегает её фигуру, вздымающуюся в такт мерному дыханию.'

    else
        *pl 'Ты осторожно заходишь в спальню Сандры. В комнате царит густой полумрак и глубокий покой. Хозяйка таверны спит крепким сном человека, на чьих плечах держится всё хозяйство.'
        *pl 'Одеяло сползло на край постели, открывая её зрелые, пышные формы, расслабленные после долгого хлопотного дня. В полутьме её лицо смягчилось — исчезла обычная строгая деловитость, уступив место редкой, глубокой безмятежности.'
    end

    gs 'ActUiPrepare', 'Тихо укрыть и уйти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end

    if daily_cum_count < max_daily_cum:
        gs 'ActUiPrepare', 'Осторожно разбудить лаской', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilySleepingGirlAction', $SleepGirl
        end
    else
        *pl ' '
        *pl '<i>Ты чувствуешь, что на сегодня твоих мужских сил уже не осталось — лучше не тревожить её сладкий сон.</i>'
    end
---

#FamilySleepingGirlAction
    *clr
    clr
    cla

    $SleepActGirl = LCASE($ARGS[0])

    FamilySleepingGirlVisitedDay = day
    FamilyDeepSleepTonight[$SleepActGirl] = 0
    FamilyGirlSleepingDeep = 0

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: ПРОБУЖДЕНИЕ'
    gs 'SceneShowVisual', 'images/events/family/sleep_act_' + $SleepActGirl, 'Ночная близость: ' + $RealName[$SleepActGirl], 'large', 'webp'

    if $SleepActGirl = 'amanda':
        *pl 'Ты опускаешься на край постели и мягко проводишь ладонью по её тёплому плечу и шее. Аманда сонно шевелится, приоткрывает тёмные ресницы и, узнав тебя в полутьме, тихо выдыхает:'
        *pl '— Стефан?.. Ты опять не спишь?..'
        *pl 'На её губах расцветает сонная, тёплая улыбка. Вместо того чтобы возмутиться, она потягивается и обвивает руками твою шею, притягивая к себе в постель. Твои ладони скользят по её нежной, разгорячённой коже, пробуждая в ней волну ответной ласки и трепетной страсти.'

    elseif $SleepActGirl = 'melissa':
        *pl 'Ты садишься рядом и осторожно касаешься её щеки, убирая растрепавшуюся прядь волос. Мелисса вздрагивает, приоткрывает затуманенные сном глаза и слегка щурится.'
        *pl '— Стефан?.. — её голос звучит чуть хрипло со сна, но в нём тут же проскальзывает привычная ироничная нотка. — Опять бродишь по ночам вместо отдыха?.. Впрочем... я не стану жаловаться.'
        *pl 'Её обычная строгость тает на глазах. Мелисса вздыхает, подаётся навстречу твоим рукам и пальцами зарывается в твои волосы, отвечая на твои поцелуи с неожиданной, жадной пылкостью.'

    else
        *pl 'Ты ложишься рядом и бережно обнимаешь Сандру за талию, прижимаясь к ней и согревая дыханием её шею. Сандра медленно просыпается, поворачивается к тебе и тихо, грудно выдыхает:'
        *pl '— Стефан... Это ты... Я уж думала, мне это снится.'
        *pl 'Она кладёт тёплую руку тебе на грудь, заглядывая в глаза с доверием и зрелой нежностью. Притянув тебя ближе, она раскрывает объятия, и в её ласках чувствуется глубокая, истосковавшаяся по заботе женственность.'
    end

    gs 'ActUiPrepare', 'Разделить страсть до конца', 'intim'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FamilySleepingGirlClimax', $SleepActGirl
    end
---

#FamilySleepingGirlClimax
    *clr
    clr
    cla

    $SleepActGirl = LCASE($ARGS[0])

    gs 'RegisterPlayerCum'
    LastSexDay[$SleepActGirl] = day
    HadSex[$SleepActGirl] += 1
    SexUsedToday[$SleepActGirl] = 1

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: ПИК ЧУВСТВ'
    gs 'SceneShowVisual', 'images/events/family/sleep_climax_' + $SleepActGirl, 'Кульминация: ' + $RealName[$SleepActGirl], 'large', 'webp'

    if $SleepActGirl = 'amanda':
        *pl 'Движения становятся всё глубже и жарче. Аманда прижимает тебя к себе изо всех сил, пряча пылающее лицо у тебя на плече и сдерживая прерывистые стоны.'
        *pl 'Её тело содрогается в волне сладкого трепета. Ты чувствуешь, как накатывает жаркая волна освобождения, и отдаёшься ей целиком, разделяя с сестрой сокрушительную вспышку наслаждения под её счастливый прерывистый шёпот.'

    elseif $SleepActGirl = 'melissa':
        *pl 'Ритм нарастает, заполняя полумрак спальни сбивчивым дыханием и шорохом смятых простыней. Мелисса впивается пальцами в твои плечи, запрокидывая голову на подушку.'
        *pl 'Вся её рассудительность окончательно растворяется в накатившей волне блаженства. Она прерывисто выдыхает твоё имя, когда сладкая истома сотрясает всё её тело, и ты отдаёшься бурной разрядке, чувствуя её податливую, трепещущую податливость.'

    else
        *pl 'Страсть захватывает вас обоих с неодолимой зрелой силой. Сандра крепко держит тебя в объятиях, её горячее дыхание обжигает твою кожу.'
        *pl 'Когда глубокая судорога наслаждения проходит по её телу, она глухо ахает, до побелевших пальцев сжимая покрывало. На пике близости ты изливаешь накопившийся жар, чувствуя, как её тело благодарно и жадно принимает каждое твоё движение.'
    end

    gs 'ActUiPrepare', 'Перевести дыхание', 'heart'
    act $ActUiLabel, $ActUiIconPath:
        gt 'FamilySleepingGirlAftermath', $SleepActGirl
    end
---

#FamilySleepingGirlAftermath
    *clr
    clr
    cla

    $SleepActGirl = LCASE($ARGS[0])

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: ПОСЛЕ БЛИЗОСТИ'
    gs 'SceneShowVisual', 'images/events/family/sleep_aftermath_' + $SleepActGirl, 'После близости: ' + $RealName[$SleepActGirl], 'large', 'webp'

    if $SleepActGirl = 'amanda':
        *pl 'Дыхание постепенно выравнивается. Аманда лежит рядом, тесно прижавшись к твоему боку и уткнувшись носом в твою грудь. На её лице сияет умиротворённая, сонная улыбка.'
        *pl '— Ты такой ненасытный... — едва слышно шепчет она и сладко зевает, закрывая глаза. — Спи тоже... или иди к себе, пока в коридоре тихо.'
        *pl 'Ты осторожно целуешь её в висок, бережно натягиваешь мягкое одеяло до самых плеч и на цыпочках выскальзываешь из комнаты, бесшумно прикрыв за собой дверь.'

    elseif $SleepActGirl = 'melissa':
        *pl 'Мелисса лежит на подушках, тяжело и размеренно дыша, на её щеках играет яркий румянец. Она слабо улыбается, бросая на тебя лукавый, полный нежности взгляд:'
        *pl '— Если ты думаешь, что после этой ночи я стану мягче проверять твои записи в гроссбухе... ты глубоко заблуждаешься, Стефан.'
        *pl 'Она тихо посмеивается, позволяя тебе бережно укрыть её одеялом. Погладив её тёплую ладонь, ты тихо выходишь в коридор, оставляя девушку погружаться в безмятежный сон.'

    else
        *pl 'Сандра медленно и ласково гладит тебя по спине, утихомиривая оставшуюся дрожь в теле. В её взгляде сквозит глубокое женское спокойствие и признательность.'
        *pl '— Спасибо тебе, Стефан... — шепчет она, убирая прядь волос с твоего лба. — Давно я не чувствовала себя такой спокойной. А теперь ступай, тебе тоже нужно поспать перед рассветом.'
        *pl 'Ты бережно укрываешь её тёплым одеялом, проверяешь, закрыто ли плотно окно, и тихо покидаешь спальню.'
    end

    gs 'ActUiPrepare', 'Выйти в коридор', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---

#FamilyMasturbationScene
    *clr
    clr
    cla

    $MastGirl = LCASE($ARGS[0])

    gs 'ShowLocationScreenTitle', 'СПАЛЬНЯ: ТАЙНОЕ ВОЗБУЖДЕНИЕ'
    gs 'SceneShowVisual', 'images/events/family/masturbation_' + $MastGirl, 'Уединение: ' + $RealName[$MastGirl], 'large', 'webp'

    *pl 'Ты осторожно заглядываешь в комнату. В полутьме ' + $RealName[$MastGirl] + ' лежит на кровати, забыв про осторожность.'
    *pl 'Её рука под тонкой сорочкой медленно и чувственно ласкает тело. Губы закушены, дыхание прерывистое — ночи без ласки дают о себе знать, заставляя искать облегчения в тайных прикосновениях.'

    gs 'ActUiPrepare', 'Тихо наблюдать из дверей', 'look'
    act $ActUiLabel, $ActUiIconPath:
        *pl ' '
        *pl 'Ты стоишь в дверях и смотришь, затаив дыхание. Она вздрагивает в сладкой волне истомы — и только тогда замечает тебя. Вместо испуга на её губах появляется томная улыбка:'
        *pl '— Долго же ты шёл... Мог бы и помочь.'
        gs 'ActUiPrepare', 'Уйти', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'TavernSecondFloor'
        end
    end

    if daily_cum_count < max_daily_cum:
        gs 'ActUiPrepare', 'Перехватить и взять её в объятия', 'intim'
        act $ActUiLabel, $ActUiIconPath:
            *pl ' '
            *pl 'Ты подходишь, перехватываешь её ладонь и заменяешь её прикосновения своими. Девушка прерывисто ахает — и подаётся навстречу:'
            *pl '— Наконец-то... Я так тебя ждала.'
            *pl 'Близость накрывает вас обоих горячей волной. Она обвивает тебя руками, не отпуская ни на мгновение, пока страсть не затихает в сладком изнеможении.'
            gs 'RegisterPlayerCum'
            LastSexDay[$MastGirl] = day
            HadSex[$MastGirl] += 1
            SexUsedToday[$MastGirl] = 1
            gs 'ActUiPrepare', 'Закончить ночь', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt 'TavernSecondFloor'
            end
        end
    end
