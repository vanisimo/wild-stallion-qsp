! ================================================
! FILE: modules/locations/rooms/melissa_room.qsps
! [AI-WORKED] 18.09.2026
! Комната Мелиссы
! Порядок: заголовок → картинка → сцена с именем → текст
! ================================================

#MelissaRoom
    cls

    gs 'AddGlobalButtons'
    gs 'UpdateGirlLocations'

    gs 'ShowLocationScreenTitle', 'КОМНАТА МЕЛИССЫ'

    LocationGirlShown = 0
    gs 'CheckGirlInLocation', 'melissa', 'MelissaRoom'

    if GirlInLocation = 1:
        LocationGirlShown = 1
    end

    killvar 'GirlInLocation'

    gs 'ShowLocationImage', 'melissa_room', 'full', 'png'

    if LocationGirlShown = 1:
        gs 'ShowGirlRoomPresence', 'melissa', 'MelissaRoom'
    end

    *pl 'Комната Мелиссы хранит отпечаток её книжного и педантичного нрава.'
    *pl 'На письменном столике ровными стопками сложены исписанные листы бумаги, чернильница с гусиным пером и несколько книг в плотных кожаных переплётах — среди них потёртый корешок «Королевы Элеоноры».'
    *pl 'Возле аккуратно заправленной кровати стоит сундук с одеждой, а на полочке у зеркала — костяной гребень, флакон розовой воды и коробочка с порошком «Таро» для идеальной чистоты кожи.'

    *pl ' '

    if time = 1:
        *pl 'Утренний свет мягко падает на страницы открытой книги, оставленной на столе с вечера.'
    elseif time = 5:
        *pl 'В ночной тишине комната кажется особенно уютной — лишь тени от лунного света ложатся на стопки рукописей.'
    else:
        *pl 'Днём в комнате прохладно и спокойно, воздух пахнет сухими травами и пергаментом.'
    end

    *pl ' '

    if LocationGirlShown = 0:
        *pl 'Мелиссы сейчас нет в комнате.'
    end

    killvar 'LocationGirlShown'

    *pl ' '

    gs 'ActUiPrepare', 'Осмотреть комнату', 'look'
    act $ActUiLabel, $ActUiIconPath:
        *pl ' '
        *pl 'Ты осматриваешь комнату сестры внимательнее.'
        *pl 'Вся обстановка говорит о её стремлении к порядку и знаниям — книги расставлены строго по корешкам, а бумаги прижаты гладким речным голышом.'

        if MelissaDanceDressOrdered = 1 and MelissaDanceDressReady = 0:
            *pl 'На стуле лежит аккуратная записка от модистки Ирмы с напоминанием о примерке платья к пятничным танцам.'
        elseif MelissaDanceDressReady = 1 and MelissaDanceDressPlayerBought = 1:
            *pl 'В приоткрытом платяном шкафу висит новое нарядное платье для танцев, купленное тобой — тонкая праздничная ткань и строгий, подчеркивающий фигуру крой.'
        elseif MelissaDanceDressSelfBought = 1:
            *pl 'Платье для танцев, купленное Мелиссой на свои сбережения, бережно уложено на комоде.'
        end
    end

    gs 'ActUiPrepare', 'Выйти в коридор', 'floor'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernSecondFloor'
    end
---