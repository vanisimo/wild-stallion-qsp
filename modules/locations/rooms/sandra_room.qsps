! ================================================
! FILE: modules/locations/rooms/sandra_room.qsps
! [AI-WORKED] 20.09.2026
! Комната Сандры
! Порядок: заголовок → картинка → сцена с именем → текст
! ================================================

#SandraRoom
    cls

    gs 'AddGlobalButtons'
    gs 'UpdateGirlLocations'

    gs 'ShowLocationScreenTitle', 'КОМНАТА САНДРЫ'

    LocationGirlShown = 0
    gs 'CheckGirlInLocation', 'sandra', 'SandraRoom'

    if GirlInLocation = 1:
        LocationGirlShown = 1
    end

    killvar 'GirlInLocation'

    gs 'ShowLocationImage', 'sandra_room', 'full', 'png'

    if LocationGirlShown = 1:
        gs 'ShowGirlRoomPresence', 'sandra', 'SandraRoom'
    end

    *pl 'Комната Сандры выглядит аккуратнее остальных.'
    *pl 'Здесь стоит широкая кровать, небольшой столик, сундук с одеждой и несколько заботливо сложенных вещей.'
    *pl 'В комнате ощущается порядок, тепло и спокойная женская строгость.'

    *pl ' '

    if time = 1:
        *pl 'Утренний свет мягко ложится на деревянный пол и делает комнату особенно спокойной.'
    elseif time = 5:
        *pl 'Ночью комната кажется тише и темнее. Только слабый свет подчёркивает очертания мебели.'
    else:
        *pl 'В это время дня комната выглядит жилой и тёплой, будто Сандра совсем недавно была здесь.'
    end

    *pl ' '

    if LocationGirlShown = 0:
        *pl 'Сандры сейчас нет в комнате.'
    else:
        if SandraHomeUnlocked = 0 and LOC('SandraHomeUnlockTry') = 1:
            gs 'SandraHomeUnlockTry'

            if SandraHomeUnlockTry = 1:
                act '<b>Пожелать спокойной ночи</b>', 'images/common/ui/actions/talk.png':
                    gt 'SandraHomeGoodnightUnlock'
                end
            end
        end


    end

    killvar 'LocationGirlShown'

    *pl ' '

    act '<b>Осмотреть комнату</b>', 'images/common/ui/actions/look.png':
        gt 'SandraRoomInspect'
    end

    act '<b>Выйти в коридор</b>', 'images/common/ui/actions/floor.png':
        gt 'TavernSecondFloor'
    end
---

#SandraRoomInspect
    cls

    gs 'AddGlobalButtons'
    gs 'UpdateGirlLocations'

    gs 'ShowLocationScreenTitle', 'КОМНАТА САНДРЫ'

    gs 'ShowLocationImage', 'sandra_room', 'full', 'png'

    *p 'Вы осматриваете комнату Сандры внимательнее.'
    *p 'Вещи лежат аккуратно, кровать застелена ровно, на столике — расчёска и узелок сушёных трав.'

    *pl ' '

    if LOC('SandraLermontLetterCanSearch') = 1:
        gs 'SandraLermontLetterCanSearch'
    end

    if SandraLermontLetterCanSearch = 1:
        gs 'SandraRoomInspectLetterHintText'
    else:
        *p 'Возле стены стоит сундук с одеждой и личными мелочами — всё на своих местах, без намёка на чужое любопытство.'
    end

    *pl ' '

    if SandraLermontLetterCanSearch = 1:
        gs 'ActUiPrepare', 'Осмотреть сундук', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SandraLermontLetterSearchChest'
        end
    end

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'SandraRoom'
    end
---