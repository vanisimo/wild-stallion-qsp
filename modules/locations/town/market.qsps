! ================================================
! FILE: modules/locations/town/market.qsps
! Городской рынок
! Версия: v3 / лавки, пост стражи, улица
! ================================================

#Market
    *clr
    clr
    cla

    gs 'GetCitySchedulePhase'

    if $CitySchedulePhase = 'friday_dance':
        gt 'MarketDance'
    end

    if week = 6 and time = 4 and LOC('IngaGuardSaturdayCanStart') = 1:
        gs 'IngaGuardSaturdayCanStart'

        if IngaGuardSaturdayCanStart = 1 and LOC('IngaGuardSaturday') = 1:
            gt 'IngaGuardSaturday'
        end
    end

    if LOC('ShowLocationTimeImage') = 1:
        gs 'ShowLocationTimeImage', 'images/locations/market/market', 'jpg'
    elseif LOC('ShowLocationImage') = 1:
        gs 'ShowLocationImage', 'market'
    end

    *pl '══════════════════════════════════════════════'
    *pl ' ГОРОДСКОЙ РЫНОК'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if time = 5:
        *p 'Ночь. Рыночная площадь почти пуста. Лавки закрыты, ставни опущены, а между рядами гуляет только холодный ветер.'
        *p 'Сейчас здесь нечего покупать, но днём это место снова наполнится голосами торговцев.'
        *pl ' '

        gs 'ActUiPrepare', 'Улица Трипербан', 'street'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Street'
        end

        exit
    end

    if time = 1:
        *p 'Утро. Торговцы раскрывают лавки, поправляют вывески и раскладывают товар.'
    elseif time = 2:
        *p 'Полдень. Рынок шумит громче всего: покупатели спорят о ценах, лавочники перекрикивают друг друга.'
    elseif time = 3:
        *p 'День. Торговля идёт ровно, без утренней спешки, но покупателей всё ещё хватает.'
    else:
        *p 'Вечер. Лавки ещё работают, но торговцы уже поглядывают на небо и начинают думать о закрытии.'
    end


    *pl ' '

    if week = 2 and (time >= 2 and time <= 4) and MelissaDanceDressReady = 1 and MelissaMinstrelWagonStage < 4 and MelissaMinstrelWagonToday = 0:
        MelissaMinstrelMet = 1
        *pl '<i>В стороне от торговых рядов мелькает знакомая фигура: Мелисса, прижимая к груди стопку пергаментов, украдкой направляется к жилой повозке менестреля. Элрик уже стоит на деревянных ступенях, с улыбкой подавая ей руку.</i>'
        *pl ' '
        gs 'ActUiPrepare', 'Мелисса у повозки', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MelissaMinstrelTuesdaySpot'
        end
    end

    gs 'ActUiPrepare', 'Лавка продовольствия', 'shop'
    act $ActUiLabel, $ActUiIconPath:
        killvar '$BeckyShopHoldTab'
        gt 'BeckyShop', 'main'
    end

    if BeckyHomeStage >= 3 and time = 4 and LOC('BeckyHomeGuestArrival') = 1:
        gs 'ActUiPrepare', 'Бекки в гости', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'BeckyHomeGuestArrival'
        end
    end

    gs 'ActUiPrepare', 'Лавка виноторговца', 'shop'
    act $ActUiLabel, $ActUiIconPath:
        killvar '$WineShopHoldTab'
        gt 'WineShop', 'main'
    end

    if LOC('GuardPost') = 1:
        gs 'ActUiPrepare', 'Пост стражи', 'guard'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GuardPost'
        end
    end

    if time >= 1 and time <= 4 and LOC('CityRumorsGetText') = 1:
        gs 'ActUiPrepare', 'Прислушаться к разговорам', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MarketRumors'
        end
    end

    if debug = 1:
        gs 'ActUiPrepare', 'DEBUG: Танцы (с платьями)', 'debug'
        act $ActUiLabel, $ActUiIconPath:
            week = 5
            time = 4
            AmandaDanceDressReady = 1
            MelissaDanceDressReady = 1
            StefanRespectableSuit = 0
            FridayDanceDay = 0
            FridayDancesCount = 0
            gt 'MarketDance'
        end
    end

    gs 'ActUiPrepare', 'Улица Трипербан', 'street'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Street'
    end
---

#MarketRumors
    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/locations/market/market', 'Шум торговых рядов на рынке', 'large', 'jpg'

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' СЛУХИ НА РЫНКЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'CityRumorsGetText', 'becky'

    if $CityRumorText <> '':
        *pl $CityRumorText
    else:
        *pl 'Торговцы спорят о ценах на муку, пересчитывают медяки и зазывают покупателей к лоткам.'
    end

    if $CityRumorPickedKey = 'tavern_scandal' or $CityRumorPickedKey = 'girls_behavior' or $CityRumorPickedKey = 'kitchen_sandra' or $CityRumorPickedKey = 'legare_amanda':
        *pl ' '
        if FamilyCorruptionStage <= 1:
            *pl '<i>Если Сандра услышит подобные толки на рынке за покупками, ей наверняка будет неловко перед кумушками, хотя она привыкла держать лицо.</i>'
        elseif FamilyCorruptionStage <= 3:
            *pl '<i>Сандра, закупая провизию на рынке, наверняка слышала эти сплетни, но лишь сдержанно усмехнулась: за годы бурной молодости она привыкла к пересудам, а выгода важнее кривотолков.</i>'
        else:
            *pl '<i>Сандра давно не обращает внимания на пересуды рыночных торговок: в семье теперь свои порядки.</i>'
        end
    end

    killvar '$CityRumorText'

    *pl ' '

    gs 'ActUiPrepare', 'Назад на рынок', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---
