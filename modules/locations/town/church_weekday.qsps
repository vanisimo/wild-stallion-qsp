! ================================================
! FILE: modules/locations/town/church_weekday.qsps
! MODULE: locations/town
! Церковь в будни (пн–сб)
! ================================================

#ChurchWeekday
    *clr
    clr
    cla

    gs 'AddGlobalButtons'

    gs 'ShowLocationScreenTitle', 'ЦЕРКОВЬ ИЛЬМАТЕРА'

    gs 'ShowImage', 'church', 'general', 'normal'

    gs 'ChurchWeekdayPrintIntro'
    *p $ChurchWeekdayIntroText
    killvar '$ChurchWeekdayIntroText'

    *pl ' '

    if ChurchDonatedToday <> 1:
        gs 'ActUiPrepare', 'Пожертвования', 'circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchWeekdayDonations'
        end
    end

    if PlayerHasWeaponShipmentInvoice = 1 and GerhardBlackmailTalkDone = 0:
        gs 'ActUiPrepare', 'Доложить отцу Герхарду о контрабанде', 'holy_circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GerhardBlackmailTalk'
        end
    end

    if MayorSecondTalkDone = 1 and PlayerHasWeaponShipmentInvoice = 0 and MayorConfidantPath = 0 and GerhardHonorablePath = 0:
        gs 'ActUiPrepare', 'Отец Герхард: тревожная тайна храма', 'holy_circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchGerhardMercenaryEvent'
        end
    end

    if MercenaryNeedsBalm = 1 and PlayerHasTreeBalm = 1:
        gs 'ActUiPrepare', 'Исцелить раненого воина бальзамом Древа', 'holy_circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchGerhardMercenaryHeal'
        end
    end

    if ClarissaGoldenWineActive = 1 and PlayerHasGoldenWineRecipe = 0:
        gs 'ActUiPrepare', 'Отец Герхард: свиток монастырского купажа', 'holy_circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ClarissaGoldenWineGerhardTalk'
        end
    end

    if StefanWearingNobleSuit = 1 and StefanNobleTourGerhardDone = 0:
        gs 'ActUiPrepare', 'Отец Герхард: предстать в благородном статусе', 'holy_circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'StefanNobleTourGerhard'
        end
    end

    if GerhardHonorablePath = 1 and PlayerHasTrueInvoice = 1 and HonorableTriumphDone = 0:
        gs 'ActUiPrepare', 'Предстать перед советом за патентом', 'policy'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchHonorablePetitionTriumph'
        end
    end

    if GerhardAmandaWarningAvailable = 1:
        gs 'ActUiPrepare', 'Отец Герхард: об Аманде', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchGerhardAmandaConfront'
        end
    end

    if PlayerHasTaro < 5:
        gs 'ActUiPrepare', 'Кувшины с даром Таро (' + STR(PlayerHasTaro) + '/5)', 'gift'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchTaroUrns'
        end
    end

    gs 'ChurchRenderStreetExit'
---

#ChurchWeekdayDonations
    cls

    gs 'AddGlobalButtons'

    gs 'ShowLocationScreenTitle', 'ЦЕРКОВЬ ИЛЬМАТЕРА: ПОЖЕРТВОВАНИЯ'

    gs 'ShowImage', 'church', 'general', 'normal'

    gs 'ChurchWeekdayText', 'donations'
    *pl $ChurchWeekdayText
    killvar '$ChurchWeekdayText'

    *pl ' '
    *pl 'У тебя в кошельке: <b>' + STR(money) + '</b> спинтарий.'
    *pl ' '

    if ChurchDonatedToday = 1:
        *pl '<span style="color:#888"><i>Сегодня ты уже совершил пожертвование храму Ильматера. Твоя лепта принята, приходи снова в следующий будний день.</i></span>'
        *pl ' '
    else:
        gs 'ChurchWeekdayDonationAct'
    end

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchInterior'
    end
---

#ChurchGerhardWeekdayTalk
    cls

    gs 'ShowLocationScreenTitle', 'ОТЕЦ ГЕРХАРД'
    gs 'ShowImagePath', 'images/locations/church/gerhard', '', 'portrait', 'webp'

    *pl 'Отец Герхард стоит у аналоя, неторопливо перебирая деревянные чётки. Его лицо строго и спокойно, но взгляд внимательно следит за твоими движениями.'
    *pl '— Мир тебе, Стефан. Зачем пришёл под сень всеблагого Ильматера?'
    *pl ' '
    gs 'GerhardBuildMainMenu'
    gs 'GetNpcMenuLinkHref', 'GerhardMainMenu', 'отец Герхард'

    *pl $NpcMenuLinkHref + ' стоит у аналоя, перебирая деревянные чётки.'
    killvar '$NpcMenuLinkHref'

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchInterior'
    end
---

#GerhardBuildMainMenu
    gs 'Menu.Destroy', 'GerhardMainMenu'
    gs 'Menu.Create', 'GerhardMainMenu'

    if LOC('GerhardImportantCheck') = 1:
        gs 'GerhardImportantCheck'
    end
    if GerhardImportantReady = 1:
        gs 'MenuUiAdd', 'GerhardMainMenu', 'Важная беседа', 'important'
        gs 'Menu.AddModule', 'GerhardMainMenu', {
            gt 'GerhardImportantScreen'
        }
    end

    gs 'MenuUiAdd', 'GerhardMainMenu', 'Разговор', 'talk'
    gs 'Menu.AddModule', 'GerhardMainMenu', {
        gt 'GerhardChatScreen'
    }

    gs 'MenuUiAdd', 'GerhardMainMenu', 'Пожертвовать храму', 'circle'
    gs 'Menu.AddModule', 'GerhardMainMenu', {
        gt 'ChurchDonationInfo'
    }
---

#GerhardImportantScreen
    cls

    gs 'ShowLocationScreenTitle', 'ВАЖНЫЙ РАЗГОВОР: ОТЕЦ ГЕРХАРД'
    gs 'ShowImagePath', 'images/locations/church/gerhard', '', 'portrait', 'webp'

    gs 'GerhardBuildImportantMenu'
    gs 'GetNpcMenuLinkHref', 'GerhardImportantMenu', 'отцу Герхарду'

    *pl 'У тебя есть важные дела или вопросы к ' + $NpcMenuLinkHref + '.'
    killvar '$NpcMenuLinkHref'

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchInterior'
    end
---

#GerhardBuildImportantMenu
    gs 'Menu.Destroy', 'GerhardImportantMenu'
    gs 'Menu.Create', 'GerhardImportantMenu'

    if PlayerHasWeaponShipmentInvoice = 1 and GerhardBlackmailTalkDone = 0 and LOC('GerhardBlackmailTalk') = 1:
        gs 'MenuUiAdd', 'GerhardImportantMenu', 'Поговорить о накладной на оружие', 'talk'
        gs 'Menu.AddModule', 'GerhardImportantMenu', {
            gt 'GerhardBlackmailTalk'
        }
    end

    if StefanWearingNobleSuit = 1 and StefanNobleTourGerhardDone = 0 and LOC('StefanNobleTourGerhard') = 1:
        gs 'MenuUiAdd', 'GerhardImportantMenu', 'Визит в парадном облачении', 'talk'
        gs 'Menu.AddModule', 'GerhardImportantMenu', {
            gt 'StefanNobleTourGerhard'
        }
    end

    if GerhardAmandaWarningAvailable = 1 and LOC('ChurchGerhardAmandaConfront') = 1:
        gs 'MenuUiAdd', 'GerhardImportantMenu', 'Поговорить об Аманде', 'talk'
        gs 'Menu.AddModule', 'GerhardImportantMenu', {
            gt 'ChurchGerhardAmandaConfront'
        }
    end
---

#GerhardChatScreen
    cls

    gs 'ShowLocationScreenTitle', 'ОТЕЦ ГЕРХАРД'
    gs 'ShowImagePath', 'images/locations/church/gerhard', '', 'portrait', 'webp'

    gs 'GerhardUnifiedTalkRun'
    *pl ' '

    gs 'UsefulTalkCheck', 'gerhard', 'gerhard_weekday'
    if UsefulTalkResult = 1:
        gs 'GerhardBuildMainMenu'
        gs 'GetNpcMenuLinkHref', 'GerhardMainMenu', 'Отец Герхард'
        *pl $NpcMenuLinkHref + ' осеняет тебя знаком Святого Круга.'
        killvar '$NpcMenuLinkHref'
    else:
        *pl 'Отец Герхард возвращается к молитвеннику.'
    end
    *pl ' '

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchInterior'
    end
---

#GerhardUnifiedTalkRun
    ! 1. Проверка лимита полезных разговоров
    gs 'UsefulTalkCheck', 'gerhard', 'gerhard_unified'
    if UsefulTalkResult = 0:
        gs 'GerhardTalkLimitReachedText'
        exit
    end

    ! 2. Регистрация полезного разговора
    gs 'UsefulTalkRegister', 'gerhard', 'gerhard_unified'

    ! 3. Прогрессивная иерархия тем:
    ! --- О семье и благословении дома ---
    if Friends['gerhard'] >= 25 and GerhardFamilyTalkFirstDone = 0:
        GerhardFamilyTalkFirstDone = 1
        gs 'GerhardTalkFamilyRun'

    ! --- О чистоте и порошке Таро ---
    elseif GerhardTaroTalkFirstDone = 0:
        GerhardTaroTalkFirstDone = 1
        gs 'GerhardTalkTaroRun'

    ! --- О трактире и мирских соблазнах ---
    elseif GerhardTavernTalkFirstDone = 0:
        GerhardTavernTalkFirstDone = 1
        gs 'GerhardTalkTavernRun'

    ! --- Циклическая ротация лор-пулов ---
    else:
        GerhardLorePoolCycle += 1
        if GerhardLorePoolCycle > 3:
            GerhardLorePoolCycle = 0
        end

        if GerhardLorePoolCycle = 0:
            gs 'GerhardTalkTavernRun'
        elseif GerhardLorePoolCycle = 1:
            gs 'GerhardTalkTaroRun'
        elseif GerhardLorePoolCycle = 2 and Friends['gerhard'] >= 25:
            gs 'GerhardTalkFamilyRun'
        else:
            gs 'GerhardTalkServiceRun'
        end
    end
---

#GerhardTalkLimitReachedText
    *pl 'Отец Герхард поднимает ладонь в плавном останавливающем жесте и негромко произносит:'
    *pl '— Всему свой час под оком Всеблагого, Стефан. Слова, сказанные сверх меры, обращаются в праздный шум. Если на душе есть тяжкий груз — приди на исповедь в назначенный день, а пока вернись к своим мирским заботам с чистым сердцем.'
---

#GerhardTalkFamilyRun
    *pl 'Взгляд священника смягчается, в голосе звучит пастырская забота:'
    *pl '— Твоя семья пережила немало невзгод, Стефан. Сандра годами несла этот трактир на своих плечах, а сёстры смотрят на тебя в ожидании опоры. Будь для них щитом, а не источником раздора. Когда в семье царит мир и взаимное доверие — благословение Ильматера пребывает на этом доме.'
    Friends['gerhard'] += 1
    Reputation['church'] += 1
    Talked['gerhard'] += 1
---

#GerhardTalkTaroRun
    *pl 'Священник бросает взгляд на глиняные кувшины у алтарной преграды:'
    *pl '— Ильматер заповедал держать в чистоте не только душу, но и бренную плоть, Стефан. Пыль и неряшливость рождают леность духа. Серый порошок у алтаря открыт каждому горожанину без платы: прими его с благодарностью, смой с себя скверну и помни, что опрятность — первая ступень к смирению перед Святым Кругом.'
    if Friends['gerhard'] < 30:
        Friends['gerhard'] += 1
    end
    Talked['gerhard'] += 1
---

#GerhardTalkTavernRun
    *pl 'Отец Герхард внимательно смотрит на тебя:'
    *pl '— «Дикий Жеребец» — шумное место, Стефан. Туда стекаются люди с трактов, усталые, озлобленные, ищущие забвения в хмеле. Хозяин трактира несёт бремя не меньшее, чем пастырь: ты видишь человеческие пороки без прикрас. Не позволяй жажде серебра заглушить совесть. Если в твоём доме будет порядок, то и в городе станет чуть меньше греха.'
    if Friends['gerhard'] < 25:
        Friends['gerhard'] += 1
    end
    Talked['gerhard'] += 1
---

#GerhardTalkServiceRun
    gs 'ChurchWeekdayText', 'gerhard_talk'
    *pl $ChurchWeekdayText
    killvar '$ChurchWeekdayText'
    if Friends['gerhard'] < 20:
        Friends['gerhard'] += 1
    end
    Talked['gerhard'] += 1
---

#ChurchDonationInfo
    cls

    gs 'ShowLocationScreenTitle', 'О ДАРЕ ХРАМУ'
    gs 'ShowImage', 'church', 'general', 'normal'

    gs 'ChurchWeekdayText', 'donation_info'
    *pl $ChurchWeekdayText
    killvar '$ChurchWeekdayText'

    *pl ' '

    if week <> 7 and ChurchDonatedToday <> 1:
        gs 'ActUiPrepare', 'Сделать пожертвование', 'circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchWeekdayDonations'
        end
    end

    gs 'ActUiPrepare', 'Назад к отцу Герхарду', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchGerhardWeekdayTalk'
    end
---

#ChurchTaroUrns
    cls

    gs 'AddGlobalButtons'

    gs 'ShowLocationScreenTitle', 'ДАР ТАРО — БЛАГОСЛОВЕНИЕ ИЛЬМАТЕРА'
    gs 'ShowImage', 'church', 'general', 'normal'

    *pl ' '

    gs 'ChurchWeekdayText', 'taro_urns'
    *p $ChurchWeekdayText
    killvar '$ChurchWeekdayText'

    *pl ' '

    if PlayerHasTaro < 5:
        *pl 'В твоём холщовом мешочке: <b>' + STR(PlayerHasTaro) + ' из 5</b> порций порошка Таро.'
        *pl ' '
        gs 'ActUiPrepare', 'Набрать порошок Таро', 'gift'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchTaroUrnsTake'
        end
    else:
        *pl 'В твоём холщовом мешочке: <b>5 из 5</b> порций порошка Таро.'
        *pl '<span style="color:#888"><i>Твой мешочек полон благословения Ильматера — запаса с лихвой хватит на долгое время.</i></span>'
        *pl ' '
    end

    gs 'ActUiPrepare', 'Отойти от кувшинов', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchInterior'
    end
---

#ChurchTaroUrnsTake
    *clr
    clr
    cla

    gs 'AddGlobalButtons'

    PlayerHasTaro = 5

    gs 'ShowLocationScreenTitle', 'ДАР ТАРО — НАПОЛНЕНИЕ МЕШОЧКА'
    gs 'SceneShowVisual', 'images/locations/church/taro_urns', 'Наполнение мешочка порошком Таро', 'large', 'webp'

    *pl 'Ты достаёшь холщовый мешочек, развязываешь пеньковый шнурок и опускаешь ладонь в прохладную глубину глиняного кувшина.'
    *pl ' '
    *pl 'Серый порошок Таро мягкий, шелковистый, пахнет сухой степной полынью, речной глиной и лёгкой щёлочью. Ты зачерпываешь несколько щедрых горстей и аккуратно ссыпаешь в мешочек, наполнив его до самого верха.'
    *pl ' '
    *pl 'Затянув шнурок, ты убираешь тугой мешочек за пояс. Теперь у тебя полный запас благословения Ильматера (<b>5 из 5</b>) — этого с лихвой хватит на множество дней чистоты и гладкого бритья.'
    *pl ' '

    gs 'ActUiPrepare', 'Отойти от кувшинов', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchInterior'
    end
---
