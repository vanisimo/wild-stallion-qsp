! ================================================
! FILE: modules/locations/town/church_weekday.qsps
! MODULE: locations/town
! Церковь в будни (пн–сб)
! ================================================

#ChurchWeekday
    *clr
    clr
    cla

    gs 'AddGlobalButtons'

    gs 'ShowLocationScreenTitle', 'ЦЕРКОВЬ ИЛЬМАТЕРА'

    gs 'ShowImage', 'church', 'general', 'normal'

    gs 'ChurchWeekdayPrintIntro'
    *p $ChurchWeekdayIntroText
    killvar '$ChurchWeekdayIntroText'

    *pl ' '

    if ChurchDonatedToday <> 1:
        gs 'ActUiPrepare', 'Пожертвования', 'circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchWeekdayDonations'
        end
    end

    if PlayerHasWeaponShipmentInvoice = 1 and GerhardBlackmailTalkDone = 0:
        gs 'ActUiPrepare', 'Доложить отцу Герхарду о контрабанде', 'holy_circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GerhardBlackmailTalk'
        end
    end

    if MayorSecondTalkDone = 1 and PlayerHasWeaponShipmentInvoice = 0 and MayorConfidantPath = 0 and GerhardHonorablePath = 0:
        gs 'ActUiPrepare', 'Отец Герхард: тревожная тайна храма', 'holy_circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchGerhardMercenaryEvent'
        end
    end

    if MercenaryNeedsBalm = 1 and PlayerHasTreeBalm = 1:
        gs 'ActUiPrepare', 'Исцелить раненого воина бальзамом Древа', 'holy_circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchGerhardMercenaryHeal'
        end
    end

    if ClarissaGoldenWineActive = 1 and PlayerHasGoldenWineRecipe = 0:
        gs 'ActUiPrepare', 'Отец Герхард: свиток монастырского купажа', 'holy_circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ClarissaGoldenWineGerhardTalk'
        end
    end

    if GerhardHonorablePath = 1 and PlayerHasTrueInvoice = 1 and HonorableTriumphDone = 0:
        gs 'ActUiPrepare', 'Предстать перед советом за патентом', 'policy'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchHonorablePetitionTriumph'
        end
    end

    if GerhardAmandaWarningAvailable = 1:
        gs 'ActUiPrepare', 'Отец Герхард: об Аманде', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchGerhardAmandaConfront'
        end
    end

    gs 'ActUiPrepare', 'Кувшины с даром Таро', 'gift'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchTaroUrns'
    end

    gs 'ChurchRenderStreetExit'
---

#ChurchWeekdayDonations
    cls

    gs 'AddGlobalButtons'

    gs 'ShowLocationScreenTitle', 'ЦЕРКОВЬ ИЛЬМАТЕРА: ПОЖЕРТВОВАНИЯ'

    gs 'ShowImage', 'church', 'general', 'normal'

    gs 'ChurchWeekdayText', 'donations'
    *p $ChurchWeekdayText
    killvar '$ChurchWeekdayText'

    *pl ' '

    gs 'ChurchWeekdayDonationAct'

    gs 'ActUiPrepare', 'Назад', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Church'
    end
---

#ChurchGerhardWeekdayTalk
    cls

    gs 'ShowLocationScreenTitle', 'ОТЕЦ ГЕРХАРД'
    gs 'ShowImage', 'gerhard', 'normal', 'normal'

    gs 'ChurchWeekdayText', 'gerhard_talk'
    *p $ChurchWeekdayText
    killvar '$ChurchWeekdayText'

    *pl ' '

    gs 'ActUiPrepare', 'Назад в зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Church'
    end
---

#ChurchDonationInfo
    cls

    gs 'ShowLocationScreenTitle', 'О ДАРЕ ХРАМУ'
    gs 'ShowImage', 'church', 'general', 'normal'

    gs 'ChurchWeekdayText', 'donation_info'
    *p $ChurchWeekdayText
    killvar '$ChurchWeekdayText'

    *pl ' '

    gs 'ActUiPrepare', 'Назад в зал', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Church'
    end
---

#ChurchTaroUrns
    cls

    gs 'AddGlobalButtons'

    gs 'ShowLocationScreenTitle', 'ДАР ТАРО — БЛАГОСЛОВЕНИЕ ИЛЬМАТЕРА'

    gs 'ShowImage', 'church', 'general', 'normal'

    *pl ' '

    gs 'ChurchWeekdayText', 'taro_urns'
    *p $ChurchWeekdayText
    killvar '$ChurchWeekdayText'

    *pl ' '

    if PlayerHasTaro < 5:
        gs 'ActUiPrepare', 'Набрать порошок Таро', 'gift'
        act $ActUiLabel, $ActUiIconPath:
            PlayerHasTaro = 5
            *pl ' '
            gs 'PrintMainP', 'Ты зачерпываешь из глиняного кувшина несколько щедрых горстей серого порошка и ссыпаешь в небольшой холщовый мешочек. Теперь у тебя есть запас благословения Ильматера для бритья и ухода за собой.'
            *pl ' '
            gs 'ActUiPrepare', 'Отойти от кувшинов', 'return'
            act $ActUiLabel, $ActUiIconPath:
                gt 'ChurchInterior'
            end
        end
    else:
        *pl '<span style="color:#888"><i>Твой мешочек полон порошка Таро — запаса с лихвой хватит на долгое время.</i></span>'
        *pl ' '
    end

    gs 'ActUiPrepare', 'Отойти от кувшинов', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchInterior'
    end
---
