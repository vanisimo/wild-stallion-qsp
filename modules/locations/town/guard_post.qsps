! ================================================
! FILE: modules/locations/guard_post.qsps
! Пост стражников на рынке
! Работает только в первые 4 дня недели (Пн–Чт)
! и только в Полдень (time=2) и День (time=3)
! ================================================

#GuardPost
    cls

    ! ====================== ПРОВЕРКА РАБОЧЕГО ВРЕМЕНИ ======================
    GuardPostOpen = 0
    if week >= 1 and week <= 4:
        if time = 2 or time = 3:
            GuardPostOpen = 1
        end
    end

    if GuardPostOpen = 0:
        *clr
        gs 'ShowLocationScreenTitle', 'ПОСТ СТРАЖНИКОВ — ЗАКРЫТО'
        gs 'ShowImage', 'guard', 'post', 'closed', 'normal'

        if week >= 5:
            *p 'Сегодня выходные или пятница. Пост стражников не работает.'
        elseif time = 1:
            *p 'Сейчас утро. Стражники ещё не заступили на смену.'
        elseif time = 4:
            *p 'Сейчас вечер. Стражники уже ушли.'
        elseif time = 5:
            *p 'Сейчас ночь. Пост закрыт.'
        end

        gs 'ActUiPrepare', 'Рынок', 'market'
        act $ActUiLabel, $ActUiIconPath:
            gt 'Market'
        end
        killvar 'GuardPostOpen'
        exit
    end

    killvar 'GuardPostOpen'
    ! =====================================================================

    gs 'ShowLocationScreenTitle', 'ПОСТ СТРАЖНИКОВ НА РЫНКЕ'
    gs 'ShowImage', 'guard', 'post', 'normal'

    *p 'Ты подходишь к небольшому посту стражников рядом с рынком.'
    *p 'Здесь дежурит сержант Грюн — крупный, грубый мужчина средних лет.'

    *pl ' '
    *pl 'Грюн смотрит на тебя с лёгкой ухмылкой.'

    gs 'BuildGuardPostMenu'
    gs 'NpcMenuLink', 'Грюн', 'GuardPostMenu'

    if PlayerHasWeaponShipmentInvoice = 1 and GuardPostHintDone = 0:
        gs 'ActUiPrepare', 'Расспросить о следствии каравана', 'talk'
        act $ActUiLabel, $ActUiIconPath:
            gt 'GuardPostBlackmailHint'
        end
    end

    if IngaDanceRefusedCount >= 2 and IngaGuardSchemeActive = 0 and IngaGuardResolved = 0:
        gs 'ActUiPrepare', 'Договориться насчёт лавки Блэнкеншип', 'guard'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaGuardSchemeProposal'
        end
    end

    if IngaGuardHelpPromise > 0 and IngaGuardResolved = 0:
        gs 'ActUiPrepare', 'Потребовать оставить Ингу в покое', 'guard'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaGuardIntervene'
        end
    end

    if IngaGuardHelpStage = 2 and IngaGuardLadderDone = 0 and IngaGuardWeeklyActive = 1 and IngaGuardBribedExit = 0:
        gs 'ActUiPrepare', 'Откупить Ингу у сержанта Грюна', 'money'
        act $ActUiLabel, $ActUiIconPath:
            gt 'IngaGuardBribeExit'
        end
    end

    if IngaGuardProblem = 1 and GuardBribed = 0 and IngaGuardHelpIntent > 0:
        gs 'ActUiPrepare', 'Лавка Бекки', 'shop'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MeetGuard'
        end
    end

    gs 'ActUiPrepare', 'Рынок', 'market'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Market'
    end
---

#GuardImportantCheck
    GuardImportantReady = 0
    $GuardImportantAction = ''

    ! 1. Подсказка по накладной на оружие
    if PlayerHasWeaponShipmentInvoice = 1 and GuardPostHintDone = 0 and LOC('GuardPostBlackmailHint') = 1:
        GuardImportantReady = 1
        $GuardImportantAction = 'blackmail_hint'
        exit
    end

    ! 2. Вступиться за Ингу
    if IngaGuardHelpPromise > 0 and IngaGuardResolved = 0 and LOC('IngaGuardIntervene') = 1:
        GuardImportantReady = 1
        $GuardImportantAction = 'inga_intervene'
        exit
    end

    ! 3. Предложение сделки по Инге
    if IngaDanceRefusedCount >= 2 and IngaGuardSchemeActive = 0 and IngaGuardResolved = 0 and LOC('IngaGuardSchemeProposal') = 1:
        GuardImportantReady = 1
        $GuardImportantAction = 'inga_scheme'
        exit
    end

    ! 4. Деньги за проход
    if IngaGuardHelpStage = 2 and IngaGuardLadderDone = 0 and IngaGuardWeeklyActive = 1 and IngaGuardBribedExit = 0 and LOC('IngaGuardBribeExit') = 1:
        GuardImportantReady = 1
        $GuardImportantAction = 'inga_bribe'
        exit
    end

    ! 5. Встреча со стражником
    if IngaGuardProblem = 1 and GuardBribed = 0 and IngaGuardHelpIntent > 0 and LOC('MeetGuard') = 1:
        GuardImportantReady = 1
        $GuardImportantAction = 'meet_guard'
        exit
    end
---

#GuardTalk
    cls

    gs 'ShowLocationScreenTitle', 'РАЗГОВОР СО СТРАЖНИКОМ'
    gs 'ShowImage', 'guard', 'post', 'talk', 'normal'

    *pl 'Стражник у ворот опирается на древко копья и смеривает тебя цепким взглядом из-под шлема.'
    *pl '— Здорово, трактирщик. Чего замер, язык проглотил?'
    *pl ' '
    gs 'GuardBuildMainMenu'
    gs 'GetNpcMenuLinkHref', 'GuardMainMenu', 'стражник'

    *pl $NpcMenuLinkHref + ' стоит на посту, опираясь на древко копья.'
    killvar '$NpcMenuLinkHref'

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'GuardPost'
    end
---

#GuardBuildMainMenu
    gs 'Menu.Destroy', 'GuardMainMenu'
    gs 'Menu.Create', 'GuardMainMenu'

    gs 'GuardImportantCheck'
    if GuardImportantReady = 1:
        gs 'MenuUiAdd', 'GuardMainMenu', 'Важная беседа', 'important'
        gs 'Menu.AddModule', 'GuardMainMenu', {
            gt 'GuardImportantScreen'
        }
    end

    gs 'MenuUiAdd', 'GuardMainMenu', 'Разговор', 'talk'
    gs 'Menu.AddModule', 'GuardMainMenu', {
        gt 'GuardChatScreen'
    }
---

#GuardImportantScreen
    cls
    gs 'ShowLocationScreenTitle', 'ВАЖНЫЙ РАЗГОВОР: СТРАЖНИК'
    gs 'ShowImage', 'guard', 'post', 'talk', 'normal'

    gs 'GuardBuildImportantMenu'
    gs 'GetNpcMenuLinkHref', 'GuardImportantMenu', 'стражнику'

    *pl 'У тебя есть важное дело к ' + $NpcMenuLinkHref + '.'
    killvar '$NpcMenuLinkHref'

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'GuardPost'
    end
---

#GuardBuildImportantMenu
    gs 'Menu.Destroy', 'GuardImportantMenu'
    gs 'Menu.Create', 'GuardImportantMenu'

    if PlayerHasWeaponShipmentInvoice = 1 and GuardPostHintDone = 0 and LOC('GuardPostBlackmailHint') = 1:
        gs 'MenuUiAdd', 'GuardBuildImportantMenu', 'О накладной на оружие', 'talk'
        gs 'Menu.AddModule', 'GuardBuildImportantMenu', {
            gt 'GuardPostBlackmailHint'
        }
    end
---

#GuardChatScreen
    cls
    gs 'ShowLocationScreenTitle', 'ПОСТ ГОРОДСКОЙ СТРАЖИ'
    gs 'ShowImage', 'guard', 'post', 'talk', 'normal'

    gs 'GuardUnifiedTalkRun'
    *pl ' '

    gs 'UsefulTalkCheck', 'guard', 'guard_unified'
    if UsefulTalkResult = 1:
        gs 'GuardBuildMainMenu'
        gs 'GetNpcMenuLinkHref', 'GuardMainMenu', 'Стражник'
        *pl $NpcMenuLinkHref + ' поправляет кожаный ремень кирасы.'
        killvar '$NpcMenuLinkHref'
    else:
        *pl 'Стражник возвращается к наблюдению за воротами.'
    end
    *pl ' '

    gs 'ActUiPrepare', 'Отойти', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'GuardPost'
    end
---

#GuardUnifiedTalkRun
    ! 1. Проверка лимита полезных разговоров
    gs 'UsefulTalkCheck', 'guard', 'guard_unified'
    if UsefulTalkResult = 0:
        gs 'GuardTalkLimitReachedText'
        exit
    end

    ! 2. Регистрация полезного разговора
    gs 'UsefulTalkRegister', 'guard', 'guard_unified'

    ! 3. Прогрессивная иерархия тем:
    ! --- О контрабанде и обозах ---
    if GuardSmuggleTalkDone = 0:
        GuardSmuggleTalkDone = 1
        gs 'GuardTalkSmuggleRun'

    ! --- О порядке в городе и портовой матросне ---
    elseif GuardPortTalkDone = 0:
        GuardPortTalkDone = 1
        gs 'GuardTalkPortRun'

    ! --- Циклическая ротация тем ---
    else:
        GuardLorePoolCycle += 1
        if GuardLorePoolCycle > 2:
            GuardLorePoolCycle = 0
        end

        if GuardLorePoolCycle = 0:
            gs 'GuardTalkPortRun'
        elseif GuardLorePoolCycle = 1:
            gs 'GuardTalkSmuggleRun'
        else:
            gs 'GuardTalkDutyRun'
        end
    end
---

#GuardTalkLimitReachedText
    *pl 'Стражник поправляет копьё, оглядывая улицу, и скучающим тоном цедит:'
    *pl '— Слушай, парень, у меня караульная служба, а не посиделки в твоём трактире. Капитан каждые полчаса проверяет посты. Если есть дело по службе или донос — говори, а лясы точить иди на рынок.'
---

#GuardTalkSmuggleRun
    *pl 'Стражник оглядывается по сторонам и негромко цедит сквозь зубы:'
    *pl '— Через южные ворота то и дело идут обозы с холмов. Кто-то платит пошлину честно, а кто-то суёт сержанту серебро в рукав. Если видишь в городе подозрительные ящики с клеймами столичных оружейников — лучше не суйся, Стефан, пока голова на плечах.'
    Talked['guard'] += 1
---

#GuardTalkPortRun
    *pl 'Стражник лениво опирается на древко копья:'
    *pl '— В Верхнем городе всё тихо: там патриции да мэр со своими клерками. А вот у порта вечно шваль со всех морей. Капитаны гребут золото, а мы потом вытаскиваем утопленников да разнимаем пьяную матросню. Твой трактир пока на хорошем счету, Стефан, но смотри, чтоб девки в зале не буянили.'
    Talked['guard'] += 1
---

#GuardTalkDutyRun
    *pl 'Стражник окидывает тебя цепким взглядом стража ворот:'
    *pl '— День на ногах в железном панцире — то ещё удовольствие, парень. Солнце печёт, пыль от телег скрипит на зубах. Одно радует: вечером сменюсь и зайду к тебе в «Дикий Жеребец» пропустить кружку холодного пива.'
    Talked['guard'] += 1
---

#BuildGuardPostMenu
    gs 'Menu.Destroy', 'GuardPostMenu'
    gs 'Menu.Create', 'GuardPostMenu'

    ! ==================== 1. ВАЖНАЯ БЕСЕДА (ЕСЛИ ЕСТЬ) ====================
    if LOC('GuardImportantCheck') = 1:
        gs 'GuardImportantCheck'
        if GuardImportantReady = 1:
            gs 'MenuUiAdd', 'GuardPostMenu', 'Важная беседа', 'important'
            gs 'Menu.AddModule', 'GuardPostMenu', { gt 'GuardImportantScreen' }
        end
        killvar 'GuardImportantReady'
        killvar '$GuardImportantAction'
    end

    ! ==================== 2. РАЗГОВОР (ВСЕГДА) ====================
    gs 'MenuUiAdd', 'GuardPostMenu', 'Разговор', 'talk'
    gs 'Menu.AddModule', 'GuardPostMenu', {
        gt 'GuardChatScreen'
    }
---
