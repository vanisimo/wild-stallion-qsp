! ================================================
! FILE: modules/locations/town/mayor_office.qsps
! MODULE: locations/town
! Мэрия: налоговый гейт и первый приём у мэра
! ================================================

#MayorOfficeInit

    gs 'MayorCityTaxGateInit'

    if MayorAudienceBribe <= 0:
        MayorAudienceBribe = 180
    end

    if TaxPercent <= 0:
        TaxPercent = 10
    end
---

#MayorOfficeShowClerkImage

    gs 'ShowImagePath', 'images/locations/mayor/office/clerk', '', 'location', 'png'
---

#MayorOfficeShowClerkMoneyImage

    gs 'ShowImagePath', 'images/locations/mayor/office/clerk_money', '', 'location', 'png'
---

#MayorOfficeShowMayorImage

    gs 'ShowImagePath', 'images/locations/mayor/office/mayor', '', 'location', 'png'
---

#MayorOffice

    *clr
    clr
    cla

    gs 'SceneShowVisual', 'images/locations/town/mayor_office/mayor_office', 'кабинет мэра', 'large', 'webp'
    gs 'AddGlobalButtons'
    gs 'MayorOfficeInit'
    gs 'IsBusinessOpen', 'mayor'

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' МЭРИЯ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if BusinessOpen = 0:
        gs 'MayorOfficeClosedText'

        *pl ' '

        act '<b>Улица Трипербан</b>', 'images/common/ui/actions/street.png':
            gt 'Street'
        end

        exit
    end

    gs 'MayorOfficeShowClerkImage'
    gs 'MayorOfficeIntroText'

    *pl ' '

    act '<b>Налоги трактира</b>', 'images/common/ui/actions/policy.png':
        gt 'MayorOfficeCityTaxTalk'
    end

    if BirthCertificateFound = 1 and BirthCertificateRead = 1 and MayorFirstTalkDone = 0 and BirthCertificateMagistrateConfirmed = 0:
        act '<b>Подать свидетельство</b>', 'images/common/ui/actions/policy.png':
            gt 'MayorOfficeSubmitCertificate'
        end
    end

    if MayorBribePaid = 1 and MayorAudienceRefused = 1 and MayorClerkAdviceGiven = 0:
        act '<b>Потребовать деньги</b>', 'images/common/ui/actions/gift.png':
            gt 'MayorOfficeClerkRefundTalk'
        end
    end

    if MayorClerkAdviceGiven = 1 and MayorFirstTalkDone = 0:
        act '<b>Доложить о делах</b>', 'images/common/ui/tavern.png':
            gt 'MayorOfficeWorkoffGate'
        end
    end

    if MayorClerkAdviceGiven = 1 or MayorFirstTalkDone = 1 or (BirthCertificateMagistratePending = 1 and BirthCertificateMagistrateConfirmed = 0):
        gs 'BuildMayorOfficeTalkMenu'
        gs 'PrintMenuOpenLink', 'MayorOfficeTalkMenu', 'Разговоры в мэрии'
        *pl ' '
    end

    if BirthCertificateFound = 1 and BirthCertificateRead = 1 and BirthCertificateMagistrateConfirmed = 0 and MayorFirstTalkDone = 1:
        act '<b>Подтвердить свидетельство</b>', 'images/common/ui/actions/policy.png':
            gt 'MayorOfficeMagistrateSubmit'
        end
    end

    if BirthCertificateMagistrateConfirmed = 1:
        *p 'Магистрат уже подтвердил ваше свидетельство. Клерки больше не задают лишних вопросов.'
        *pl ' '
    end

    if BirthCertificateMagistratePending = 1 and BirthCertificateMagistrateConfirmed = 0:
        *p 'Ваше дело всё ещё на проверке. Магистрат ждёт ответ из столицы.'
        *pl ' '
    end

    act '<b>Улица Трипербан</b>', 'images/common/ui/actions/street.png':
        gt 'Street'
    end
---

#MayorOfficeSubmitCertificate

    cls

    gs 'MayorOfficeInit'
    gs 'MayorOfficeShowClerkImage'
    gs 'MayorOfficeSubmitCertificateText'

    *pl ' '

    if MayorBribePaid = 0 and MayorAudienceRefused = 0:
        gs 'ActUiPrepare', 'Приём у мэра', 'mayor'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOfficeAudienceGate'
        end
    elseif MayorBribePaid = 1 and MayorAudienceRefused = 0:
        gs 'ActUiPrepare', 'Приём у мэра', 'mayor'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOfficeMayorCabinet'
        end
    end

    gs 'ActUiPrepare', 'Вернуться в приёмную', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeCityTaxTalk

    cls

    gs 'MayorOfficeInit'
    gs 'MayorCityTaxGateIsReady'
    gs 'MayorOfficeShowClerkImage'
    gs 'MayorOfficeCityTaxTalkText'

    if PlayerKnows['becky_backroom_clerk'] = 1 or EventWitnessed['becky_backroom_clerk'] = 1:
        *pl ' '
        gs 'MayorOfficeCityTaxClerkPeekAddonText'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeAudienceGate

    cls

    gs 'MayorOfficeInit'

    MayorAudienceAttempted = 1

    if MayorFirstTalkDone = 1:
        gs 'MayorOfficeShowClerkImage'
        gs 'MayorOfficeAudienceAlreadyDoneText'

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться в приёмную', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOffice'
        end

        exit
    end

    if MayorBribePaid = 1 and MayorAudienceRefused = 1:
        gs 'MayorOfficeShowClerkImage'
        gs 'MayorOfficeAudienceRefusedDoneText'

        *pl ' '

        gs 'ActUiPrepare', 'Потребовать деньги', 'gift'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOfficeClerkRefundTalk'
        end

        gs 'ActUiPrepare', 'Вернуться в приёмную', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOffice'
        end

        exit
    end

    if MayorBribePaid = 1 and MayorAudienceRefused = 0:
        gt 'MayorOfficeMayorCabinet'
        exit
    end

    gs 'MayorOfficeShowClerkImage'
    gs 'MayorOfficeAudienceBribeOfferText'

    *pl ' '

    if money < MayorAudienceBribe:
        gs 'ActUiPrepare', 'У меня не хватает денег', 'generic'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOfficeBribeNoMoney'
        end
    else:
        gs 'ActUiPrepare', 'Дать взятку', 'gift'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOfficeBribePay'
        end
    end

    gs 'ActUiPrepare', 'Вернуться в приёмную', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeBribeNoMoney

    cls

    gs 'MayorOfficeInit'
    gs 'MayorOfficeShowClerkImage'
    gs 'MayorOfficeBribeNoMoneyText'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в приёмную', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeBribePay

    cls

    gs 'MayorOfficeInit'

    if money < MayorAudienceBribe:
        gt 'MayorOfficeBribeNoMoney'
        exit
    end

    money -= MayorAudienceBribe
    MayorBribePaid = 1

    gs 'MayorOfficeShowClerkMoneyImage'
    gs 'MayorOfficeBribePaidText'

    *pl ' '

    gs 'ActUiPrepare', 'Приём у мэра', 'mayor'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOfficeMayorCabinet'
    end
---

#MayorOfficeMayorCabinet

    cls

    gs 'MayorOfficeInit'
    gs 'MayorOfficeShowMayorImage'
    gs 'MayorOfficeMayorCabinetRefusedText'

    MayorAudienceRefused = 1

    *pl ' '

    gs 'ActUiPrepare', 'Выход', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOfficeReception'
    end
---

#MayorOfficeReception

    cls

    gs 'MayorOfficeInit'
    gs 'MayorOfficeShowClerkImage'
    gs 'MayorOfficeReceptionText'

    *pl ' '

    if MayorClerkAdviceGiven = 0:
        gs 'ActUiPrepare', 'Потребовать деньги', 'gift'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOfficeClerkRefundTalk'
        end
    end

    gs 'ActUiPrepare', 'Вернуться в приёмную', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeClerkRefundTalk

    cls

    gs 'MayorOfficeInit'
    gs 'MayorOfficeShowClerkImage'

    if MayorClerkAdviceGiven = 1:
        gt 'MayorOfficeClerkAdviceReplay'
        exit
    end

    gs 'MayorOfficeClerkRefundOpenText'

    *pl ' '

    if MayorClerkBackroomMentioned = 0:
        if PlayerKnows['becky_backroom_clerk'] = 1 or EventWitnessed['becky_backroom_clerk'] = 1:
            gs 'ActUiPrepare', 'Намекнуть про заднюю лавки', 'talk'
            act $ActUiLabel, $ActUiIconPath:
                gt 'MayorOfficeClerkBackroomMention'
            end
        end
    end

    gs 'ActUiPrepare', 'Слушать дальше', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOfficeClerkAdviceTalk'
    end
---

#MayorOfficeClerkBackroomMention

    cls

    gs 'MayorOfficeInit'
    gs 'MayorOfficeClerkBackroomMentionText'

    MayorClerkBackroomMentioned = 1

    *pl ' '

    gs 'ActUiPrepare', 'Слушать совет', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOfficeClerkAdviceTalk'
    end

    gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeClerkAdviceTalk

    cls

    gs 'MayorOfficeInit'
    gs 'MayorOfficeShowClerkImage'
    gs 'MayorOfficeClerkAdviceText'

    if PlayerKnows['becky_backroom_clerk'] = 1 or EventWitnessed['becky_backroom_clerk'] = 1:
        *pl ' '
        gs 'MayorOfficeClerkAdvicePeekAddonText'
    end

    MayorClerkAdviceGiven = 1
    MayorClerkAdviceDay = day
    TavernCarpenterUpgradesUnlocked = 1
    MayorClerkMentionedStaff = 1

    if LOC('KnowledgeRegisterFact') = 1:
        gs 'KnowledgeRegisterFact', 'Stefan_MayorClerkAdvice_1'
    end

    *pl ' '

    act '<b>Улица Трипербан</b>', 'images/common/ui/actions/street.png':
        gt 'Street'
    end
---

#MayorOfficeClerkAdviceReplay

    cls

    gs 'MayorOfficeInit'
    gs 'MayorOfficeClerkAdviceReplayText'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorClerkWorkoffEvaluate

    MayorWorkoffReady = 0
    MayorWorkoffSignOk = 0
    MayorWorkoffStaffOk = 0
    MayorWorkoffProfitOk = 0

    if TavernUpgradeSignDone = 1:
        MayorWorkoffSignOk = 1
    end

    if SandraStaffHired = 1:
        MayorWorkoffStaffOk = 1
    end

    if MayorWorkoffProfitDays >= 2:
        MayorWorkoffProfitOk = 1
    elseif tavern_reputation >= 45:
        MayorWorkoffProfitOk = 1
    end

    if MayorWorkoffSignOk = 1 and MayorWorkoffStaffOk = 1 and MayorWorkoffProfitOk = 1:
        MayorWorkoffReady = 1
    end
---

#MayorOfficeWorkoffGate

    cls

    gs 'MayorOfficeInit'
    gs 'MayorCityTaxGateIsReady'
    gs 'MayorClerkWorkoffEvaluate'

    gs 'MayorOfficeWorkoffReportIntroText'

    if MayorCityTaxGateReady = 0:
        gs 'MayorOfficeWorkoffNeedTaxText'

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOffice'
        end

        exit
    end

    if MayorWorkoffReady = 0:
        if MayorWorkoffSignOk = 0:
            gs 'MayorOfficeWorkoffNeedSignText'
        end

        if MayorWorkoffStaffOk = 0:
            gs 'MayorOfficeWorkoffNeedStaffText'
        end

        if MayorWorkoffProfitOk = 0:
            gs 'MayorOfficeWorkoffNeedProfitText'
        end

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOffice'
        end

        exit
    end

    gs 'MayorOfficeWorkoffReadyText'

    *pl ' '

    gs 'ActUiPrepare', 'Войти в кабинет мэра', 'mayor'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOfficeFirstTalk'
    end

    gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeFirstTalk

    cls

    gs 'MayorOfficeInit'
    gs 'MayorOfficeFirstTalkText'

    MayorFirstTalkDone = 1

    if tavern_reputation < 100:
        tavern_reputation += 3

        if tavern_reputation > 100:
            tavern_reputation = 100
        end
    end

    if LOC('KnowledgeRegisterFact') = 1:
        gs 'KnowledgeRegisterFact', 'Stefan_MayorFirstTalk_1'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeMayorTalk

    cls

    gs 'MayorOfficeMayorTalkText'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeMagistrateGate

    cls

    gs 'MayorOfficeMagistrateGateText'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeMagistrateSubmit

    cls

    gs 'MayorOfficeInit'
    gs 'IsBusinessOpen', 'mayor'

    if BusinessOpen = 0:
        gt 'MayorOffice'
        exit
    end

    if BirthCertificateFound = 0 or BirthCertificateRead = 0 or MayorFirstTalkDone = 0:
        gt 'MayorOfficeMagistrateGate'
        exit
    end

    BirthCertificateMagistrateFee = 100

    if BirthCertificateFatherSealOnly = 1:
        BirthCertificateMagistrateFee += 25
    end

    if charisma < 30:
        BirthCertificateMagistrateFee += 20
    end

    *pl '══════════════════════════════════════════════'
    *pl ' МАГИСТРАТ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'MayorOfficeMagistrateSubmitText'

    *pl ' '
    gs 'FormatSpintry', money
    $FormatSpintry_money = $FormatSpintry
    killvar '$FormatSpintry'
    *pl 'У вас: ' + $FormatSpintry_money
    gs 'FormatSpintry', BirthCertificateMagistrateFee
    $FormatSpintry_BirthCertificateMagistrateFee = $FormatSpintry
    killvar '$FormatSpintry'
    *pl 'Госпошлина: ' + $FormatSpintry_BirthCertificateMagistrateFee
    *pl ' '

    if money < BirthCertificateMagistrateFee:
        gs 'MayorOfficeMagistrateNoMoneyText'

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOffice'
        end

        exit
    end

    gs 'ActUiPrepare', 'Оплатить госпошлину и подать документ', 'generic'
    act $ActUiLabel, $ActUiIconPath:
        money -= BirthCertificateMagistrateFee
        BirthCertificateMagistrateSubmitted = 1
        BirthCertificateMagistrateSubmitDay = day

        gs 'MayorOfficeMagistrateResolve'

        if BirthCertificateMagistrateConfirmed = 1:
            gs 'MayorOfficeMagistrateSuccessText'
        else:
            gs 'MayorOfficeMagistrateWeakCaseText'
        end

        if LOC('KnowledgeRegisterFact') = 1:
            if BirthCertificateMagistrateConfirmed = 1:
                gs 'KnowledgeRegisterFact', 'Stefan_BirthCertificateConfirmed_1'
            else:
                gs 'KnowledgeRegisterFact', 'Stefan_BirthCertificatePending_1'
            end
        end

        *pl ' '

        gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'MayorOffice'
        end
    end

    gs 'ActUiPrepare', 'Подумать и вернуться позже', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeMagistrateResolve

    BirthCertificateMagistrateConfirmed = 0
    BirthCertificateMagistratePending = 0

    if charisma >= 38 or management >= 32:
        BirthCertificateMagistrateConfirmed = 1
        BirthCertificateMagistratePending = 0
        StefanNobleLineUnlocked = 1
        exit
    end

    if charisma >= 28 or management >= 24 or tavern_reputation >= 45:
        if RAND(1, 100) <= 55:
            BirthCertificateMagistrateConfirmed = 1
            StefanNobleLineUnlocked = 1
            exit
        end
    end

    BirthCertificateMagistratePending = 1
---

#MayorOfficeMagistratePendingScreen

    cls

    *pl '══════════════════════════════════════════════'
    *pl ' МАГИСТРАТ: ОЖИДАНИЕ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    if BirthCertificateMagistrateSubmitDay > 0 and day >= BirthCertificateMagistrateSubmitDay + 5:
        BirthCertificateMagistratePending = 0
        BirthCertificateMagistrateConfirmed = 1
        StefanNobleLineUnlocked = 1

        gs 'MayorOfficeMagistrateSuccessText'

        if LOC('KnowledgeRegisterFact') = 1:
            gs 'KnowledgeRegisterFact', 'Stefan_BirthCertificateConfirmed_1'
        end
    else:
        *pl 'Клерк листает толстую книгу и качает головой.'
        *pl '— Ответ из столицы ещё не пришёл. Приходите через несколько дней.'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#MayorOfficeClerkBackroomMenu

    cls

    gs 'MayorOfficeInit'
    gs 'MayorOfficeClerkBackroomMenuText'

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться в мэрию', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'MayorOffice'
    end
---

#BuildMayorOfficeTalkMenu

    gs 'Menu.Destroy', 'MayorOfficeTalkMenu'
    gs 'Menu.Create', 'MayorOfficeTalkMenu'

    if MayorClerkAdviceGiven = 1:
        gs 'MenuUiAdd', 'MayorOfficeTalkMenu', 'Как добиться приёма', 'talk'
        gs 'Menu.AddModule', 'MayorOfficeTalkMenu', {
            gt 'MayorOfficeClerkAdviceReplay'
        }
    end

    if MayorFirstTalkDone = 1:
        gs 'MenuUiAdd', 'MayorOfficeTalkMenu', 'Мэр', 'mayor'
        gs 'Menu.AddModule', 'MayorOfficeTalkMenu', {
            gt 'MayorOfficeMayorTalk'
        }
    end

    if BirthCertificateMagistratePending = 1 and BirthCertificateMagistrateConfirmed = 0:
        gs 'MenuUiAdd', 'MayorOfficeTalkMenu', 'Ход дела', 'talk'
        gs 'Menu.AddModule', 'MayorOfficeTalkMenu', {
            gt 'MayorOfficeMagistratePendingScreen'
        }
    end

    if PlayerKnows['becky_backroom_clerk'] = 1 or EventWitnessed['becky_backroom_clerk'] = 1:
        gs 'MenuUiAdd', 'MayorOfficeTalkMenu', 'Про долги и книгу', 'policy'
        gs 'Menu.AddModule', 'MayorOfficeTalkMenu', {
            gt 'MayorOfficeClerkBackroomMenu'
        }
    end

    gs 'MenuUiAdd', 'MayorOfficeTalkMenu', 'Назад', 'return'
    gs 'Menu.AddModule', 'MayorOfficeTalkMenu', {
        gt 'MayorOffice'
    }
---