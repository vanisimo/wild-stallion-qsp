! ================================================
! FILE: modules/locations/town/craftsmen_quarter.qsps
! Квартал ремесленников
! ================================================

#CraftsmenQuarter
    *clr
    clr
    cla

    gs 'AddGlobalButtons'

    gs 'ShowLocationScreenTitle', 'КВАРТАЛ РЕМЕСЛЕННИКОВ'

    gs 'ShowImage', 'general', 'street', 'craftsmen'

    gs 'PrintMainP', 'Узкие улочки, стук молотков и запах свежей стружки. У дальней стены — мастерская гнома Драупнира, чуть ближе к площади — лавка портнихи Ирмы.'

    *pl ' '

    gs 'ActUiPrepare', 'Мастерская столяра', 'craftsmen'
    act $ActUiLabel, $ActUiIconPath:
        gt 'DraupnirShop'
    end

    gs 'ActUiPrepare', 'Лавка портнихи', 'shop'
    act $ActUiLabel, $ActUiIconPath:
        gt 'IrmaShop', 'main', 'CraftsmenQuarter'
    end

    gs 'ActUiPrepare', 'Улица Трипербан', 'street'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Street'
    end
---