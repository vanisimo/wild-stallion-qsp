! ================================================
! FILE: modules/locations/town/church.qsps
! MODULE: locations/town
! Церковь Ильматера — Соборная площадь и навигация
! ================================================

#Church
    *clr
    clr
    cla

    gs 'AddGlobalButtons'
    gs 'GetCitySchedulePhase'

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' ЦЕРКОВЬ ИЛЬМАТЕРА'
    gs 'PrintTitleLine', ' СОБОРНАЯ ПЛОЩАДЬ'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'ShowImage', 'church', 'general', 'normal'

    if week = 7:
        if time = 1:
            gs 'PrintMainP', 'Воскресное утро. Перед широкими каменными ступенями собора Ильматера собираются прихожане. В воздухе разносится мерный звон колокола, возвещающий начало утренней службы. Из распахнутых дубовых дверей тянет ароматом воска и ладана.'
        elseif time = 2:
            gs 'PrintMainP', 'Воскресный полдень. Утренняя служба закончилась, и на мощёной площади перед собором слышны негромкие разговоры расходящихся по домам горожан. Двери храма открыты — отец Герхард принимает прихожан на исповедь в комнате чистых сердец.'
        else:
            gs 'PrintMainP', 'Воскресенье после полудня. Площадь перед собором опустела, горожане разошлись по домам. Тяжёлые дубовые двери храма притворены.'
        end
    else:
        if time = 4:
            gs 'PrintMainP', 'Ночная соборная площадь погружена в густую тень. Высокие шпили собора Ильматера уходят в звёздное небо. Массивные кованые двери храма заперты до самого утра.'
        else:
            gs 'PrintMainP', 'Широкая мощёная площадь перед собором Ильматера. Высокие каменные ступени ведут к массивным дубовым дверям храма, над которыми высечен священный круг. В будний день здесь тихо: редкие горожане спешат по своим делам, да голуби бродят по старым плитам.'
        end
    end

    *pl ' '

    if time <> 4:
        gs 'ActUiPrepare', 'Войти в церковь', 'holy_circle'
        act $ActUiLabel, $ActUiIconPath:
            gt 'ChurchInterior'
        end
    else:
        *pl '<span style="color:#888"><i>Двери собора на ночь заперты.</i></span>'
        *pl ' '
    end

    gs 'ActUiPrepare', 'Прогуляться вокруг', 'look'
    act $ActUiLabel, $ActUiIconPath:
        gt 'ChurchWalkAround'
    end

    gs 'ActUiPrepare', 'Улица Трипербан', 'street'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Street'
    end
---

#ChurchInterior
    gs 'GetCitySchedulePhase'

    if week = 7:
        if time = 1:
            gt 'ChurchSundayService'
        elseif time = 2:
            gt 'ChurchSundayNoon'
        else:
            gt 'ChurchSundayQuiet'
        end
    else:
        if time = 4:
            gt 'Church'
        else:
            gt 'ChurchWeekday'
        end
    end
---

#ChurchWalkAround
    if week = 7 and time = 2:
        gt 'ChurchWalkAroundStart'
    end

    *clr
    clr
    cla

    gs 'AddGlobalButtons'

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' ЦЕРКОВЬ ИЛЬМАТЕРА'
    gs 'PrintTitleLine', ' ВОКРУГ СОБОРА'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'ShowImage', 'church', 'general', 'walk_around'

    if week = 7 and time = 1:
        gs 'PrintMainP', 'Ты неторопливо обходишь собор по мощёной дорожке. Стены сложены из циклопических серых плит, укреплённых массивными контрфорсами. Из высоких стрельчатых окон с цветными витражами доносятся приглушённые звуки молитвы — утренняя служба вот-вот начнётся, и прихожане собираются у главного входа.'
    elseif time = 4:
        gs 'PrintMainP', 'Ты обходишь храм в ночной тишине. Вдоль холодных каменных стен ложатся глубокие тени. Сквозь витражи не пробивается ни луча света — собор заперт и спит.'
    else:
        gs 'PrintMainP', 'Ты обходишь массивное здание собора снаружи. Мощная каменная кладка, узкие готические арки и вытянутые вверх шпили внушают почтение к Ильматеру. С восточной стороны виднеется пристройка с комнатами священника и зарешёченными окнами, где в глубине слабо мерцает лампада.'
    end

    *pl ' '

    gs 'ActUiPrepare', 'Вернуться на площадь', 'return'
    act $ActUiLabel, $ActUiIconPath:
        gt 'Church'
    end
---

#ChurchSundayQuiet
    *clr
    clr
    cla

    gs 'AddGlobalButtons'

    *pl '══════════════════════════════════════════════'
    gs 'PrintTitleLine', ' ЦЕРКОВЬ ИЛЬМАТЕРА'
    *pl '══════════════════════════════════════════════'
    *pl ' '

    gs 'ShowImage', 'church', 'general', 'normal'

    gs 'PrintMainP', 'Воскресенье после полудня. Обычный бизнес закрыт — горожане в гостях, а собор пустеет. Слухи ещё долго не улетают с Трипербана.'

    *pl ' '

    act '<b>Кувшины с даром Таро</b>', 'images/common/ui/actions/gift.png':
        gt 'ChurchTaroUrns'
    end

    gs 'ChurchRenderStreetExit'
---