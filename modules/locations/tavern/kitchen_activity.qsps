! ================================================
! FILE: modules/locations/tavern/kitchen_activity.qsps
! [AI-WORKED] Текст переработан / дополнен ассистентом
! Единый вход для осмотра кухни
! Версия: v1 / work-осмотр как в зале v16
! Назначение:
! - сюжет -> приоритет, считается в лимит 3 (отдельно от зала)
! - редко KitchenCustomerEvent (12%) -> бонус, лимит не тратит
! - KitchenHarassmentTry -> сцена, считается в лимит
! - иначе work-фото + текст, считается в лимит
! - лимит 3 осмотра за часть дня, серая кнопка -> фон кухни
! ================================================

#KitchenLookGetKey
    $KitchenLookKey = STR(day) + '_' + STR(time)
---

#KitchenLookDebugReset
    gs 'KitchenLookGetKey'
    KitchenLookCount[$KitchenLookKey] = 0
    KitchenLookClick = 0
    KitchenLookLastResult = 0
    KitchenImageModeCode = 0
    $KitchenLookLastImageMode = ''
    gs 'KitchenLookCheckLimit'
---

#KitchenLookCheckLimit
    gs 'KitchenLookGetKey'

    if KitchenLookMaxPerPart <= 0:
        KitchenLookMaxPerPart = 3
    end

    KitchenLookCanUse = 1
    KitchenLookRemaining = KitchenLookMaxPerPart - KitchenLookCount[$KitchenLookKey]

    if KitchenLookRemaining <= 0:
        KitchenLookCanUse = 0
        KitchenLookRemaining = 0
    end
---

#KitchenLookRegister
    gs 'KitchenLookGetKey'
    KitchenLookCount[$KitchenLookKey] += 1
    KitchenLookClick += 1
    gs 'KitchenLookCheckLimit'
---

#KitchenLookBuildNoEventMessage
    if TavernOpen = 0:
        $KitchenLookMessage = 'Кухня сейчас закрыта. Очаг почти погас, широкие разделочные столы выскоблены до белизны, а тяжёлые медные котлы начищены и остыли до утра.'
        exit
    end

    ! Проверяем фоновые дневные макро-события
    if $TavernDayEventId = 'caravan':
        $KitchenLookMessage = 'На кухне стоит дым коромыслом! Торговый караван у ворот требует горячего варева: в котлах шумно булькает наваристая похлёбка, над плитой стоит густой пар, а на столах горой громоздятся нарезанный хлеб и копчёное сало. Все силы брошены на то, чтобы вовремя накормить проезжих обозников.'
        exit
    elseif $TavernDayEventId = 'rats':
        $KitchenLookMessage = 'У кладовой ещё видны следы недавней тревоги из-за крыс: мешки с мукой тщательно перевязаны и подняты на верхние полки, пол подметён до скрипа, а у порога положена порция сушёной полыни для отпугивания грызунов. На кухне работают с удвоенной бережливостью к припасам.'
        exit
    elseif $TavernDayEventId = 'broken':
        $KitchenLookMessage = 'В углу у задней двери рассыпан слой свежих сосновых опилок: лопнувшая ранее бочка с солониной наделала сырости, и воздух до сих пор хранит кисловатый рассольный дух. Впрочем, порядок уже наведён, и работа у очага идёт своим чередом.'
        exit
    elseif $TavernDayEventId = 'harvest':
        $KitchenLookMessage = 'Кухня ломится от свежих припасов с праздничной ярмарки: на столах лежат пучки лука, свежая речная рыба, ядрёные кочаны капусты и сочные мочёные яблоки. Очаг весело потрескивает, обещая гостям щедрый и сытный праздничный обед.'
        exit
    elseif $TavernDayEventId = 'storm':
        $KitchenLookMessage = 'За узкими окнами кухни шумит серый ливень, но внутри у очага тепло и сухо. От тяжёлого чугунного чана поднимается густой пар с ароматом жареного сала и тмина — в такую непогоду добрая миска горячей похлёбки ценится гостями на вес серебра.'
        exit
    elseif $TavernDayEventId = 'delicious_kitchen':
        $KitchenLookMessage = 'По всей кухне разлит головокружительный, пряный дух заморских приправ. В широком закопчённом котле неторопливо томится густое рагу с майораном и тимьяном, от которого слюнки текут даже у сытого. Подрумяненные пироги с пряным фаршем остывают на деревянных досках, а работа у очага спорится легко и в охотку.'
        exit
    elseif $TavernDayEventId = 'tavern_praise':
        $KitchenLookMessage = 'На кухне царит приподнятое, деловое настроение: из зала возвращаются пустые миски, выскобленные чуть ли не дочиста. Посетители передают искреннюю благодарность за сытный стол, и заказы на горячее поступают один за другим. Очаг пышет щедрым жаром, а работа кипит без суеты и брани.'
        exit
    end

    ! Проверяем, кто конкретно сейчас работает на кухне
    KitchenWorkerCount = 0
    $PrimaryKitchenWorker = ''

    if jobkitchen['sandra'] = 1 and ($GirlLocation['sandra'] = 'Kitchen' or $GirlLocation['sandra'] = ''):
        KitchenWorkerCount += 1
        $PrimaryKitchenWorker = 'sandra'
    end
    if jobkitchen['melissa'] = 1 and ($GirlLocation['melissa'] = 'Kitchen' or $GirlLocation['melissa'] = ''):
        KitchenWorkerCount += 1
        if $PrimaryKitchenWorker = '':
            $PrimaryKitchenWorker = 'melissa'
        end
    end
    if jobkitchen['amanda'] = 1 and ($GirlLocation['amanda'] = 'Kitchen' or $GirlLocation['amanda'] = ''):
        KitchenWorkerCount += 1
        if $PrimaryKitchenWorker = '':
            $PrimaryKitchenWorker = 'amanda'
        end
    end

    if KitchenWorkerCount = 0:
        $KitchenLookMessage = 'На кухне непривычно тихо. Угли в очаге ровно тлеют, поблёскивают пустые миски на полках. Без рабочих рук готовка замирает — если не отправить кого-то к плите, трактир останется без дохода от горячей еды.'
        exit
    end

    ! Вариации по девушкам
    KitchenScenePick = RAND(1, 3)

    if $PrimaryKitchenWorker = 'sandra':
        if KitchenScenePick = 1:
            $KitchenLookMessage = 'Сандра стоит у большого чугунного котла, неторопливо помешивая бульон длинной деревянной поварёшкой. Зачерпнув немного на пробу, она одобрительно цокает языком и бросает в варево щепотку сушёных кореньев — опытная рука хозяйки чувствуется в каждом её движении.'
        elseif KitchenScenePick = 2:
            $KitchenLookMessage = 'Сандра с ловкостью достаёт деревянной лопатой из раскалённой печи круглые караваи свежего хлеба. По всей кухне плывёт густой дух подпечённой ржаной корочки, а её закатанные рукава открывают крепкие, уверенные руки.'
        else
            $KitchenLookMessage = 'Сандра сосредоточенно рубит увесистым тесаком свиную грудинку на широкой колоде. Мясо споро разлетается на ровные сочные куски для вечерней тушёнки, а на плите уже весело закипает вода в кастрюлях.'
        end

    elseif $PrimaryKitchenWorker = 'melissa':
        if KitchenScenePick = 1:
            $KitchenLookMessage = 'Мелисса склонилась над столом с небольшими латунными весами, с аптекарской точностью отмеряя сушёный чабрец и майоран. Заметив взгляд Стефана, она сухо замечает: «В хорошей кухне важна выверенная мера, а не слепой авось. Переборщишь с травами — испортишь всё рагу».'
        elseif KitchenScenePick = 2:
            $KitchenLookMessage = 'Мелисса методично проверяет глиняные кувшины с маслом и мочёными травами, делая пометки мелком на грифельной дощечке. Её аккуратный, строгий подход помогает держать припасы в идеальном порядке.'
        else
            $KitchenLookMessage = 'Мелисса с сосредоточенным видом раскатывает упругое тесто на деревянной доске, слегка припорошенной белой мукой. Прядь волос выбилась из причёски, но девушка сдержанно смахивает её запястьем, не отвлекаясь от дела.'
        end

    elseif $PrimaryKitchenWorker = 'amanda':
        if KitchenScenePick = 1:
            $KitchenLookMessage = 'Аманда споро нарезает копчёные колбаски и острый сыр тонкими ломтиками, раскладывая их аккуратной горкой на деревянные блюда. Заметив Стефана, она слегка краснеет и с улыбкой протягивает ему свежий кусочек прямо с кончика ножа: «Попробуй, Стефан... Только гостям оставь!»'
        elseif KitchenScenePick = 2:
            $KitchenLookMessage = 'Аманда напевает под нос весёлую городскую песенку, усердно надраивая песком медный сотейник до ослепительного солнечного блеска. На её девичьем носике виднеется след золы, придающий ей трогательный и задорный вид.'
        else
            $KitchenLookMessage = 'Аманда легко кружится между столом и очагом, ловко разливая кипящий суп по мискам для разноса в зал. Ленты её передника покачиваются в такт быстрым шагам, а румянец от жара печи очень к лицу юной работнице.'
        end
    end

    killvar 'KitchenWorkerCount'
    killvar '$PrimaryKitchenWorker'
    killvar 'KitchenScenePick'
---

#KitchenLookCountWorkers
    KitchenLookCanShowWork = 0

    if jobkitchen['sandra'] = 1 and $GirlLocation['sandra'] = 'Kitchen':
        KitchenLookCanShowWork = 1
    end

    if jobkitchen['melissa'] = 1 and $GirlLocation['melissa'] = 'Kitchen':
        KitchenLookCanShowWork = 1
    end

    if jobkitchen['amanda'] = 1 and $GirlLocation['amanda'] = 'Kitchen':
        KitchenLookCanShowWork = 1
    end
---

#KitchenLookGoKitchenWork
    KitchenLookLastResult = 1
    KitchenImageModeCode = 1
    gt 'Kitchen'
---

#KitchenLookGoKitchenBg
    KitchenImageModeCode = 2
    gt 'Kitchen'
---

#KitchenLookReturnToKitchen
    gs 'KitchenLookRegister'
    gs 'UpdateGirlLocations'
    gs 'KitchenLookCountWorkers'

    if KitchenLookCanShowWork = 1 and time <> 5:
        gt 'KitchenLookGoKitchenWork'
    else:
        gt 'KitchenLookGoKitchenBg'
    end
---

#KitchenAddLookButton
    gs 'KitchenLookCheckLimit'

    if KitchenLookCanUse = 1:
        act '<b>Осмотреть кухню</b>', 'images/common/ui/actions/look.png':
            gt 'KitchenActivityStart', 'look'
        end
    else:
        act '<font color="#808080"><b>Осмотреть кухню</b></font>', 'images/common/ui/actions/look.png':
            KitchenLookLastResult = 5
            gt 'KitchenLookGoKitchenBg'
        end
    end
---

#KitchenActivityStart
    $KitchenActivityMode = LCASE($ARGS[0])

    if $KitchenActivityMode = '':
        $KitchenActivityMode = 'look'
    end

    gs 'KitchenLookCheckLimit'

    if KitchenLookCanUse = 0:
        KitchenLookLastResult = 5
        gt 'KitchenLookGoKitchenBg'
    end

    KitchenActivityStoryStarted = 0
    KitchenActivityNoEventReason = 0

    gs 'IsTavernOpen'
    gs 'UpdateGirlLocations'

    if TavernOpen = 0:
        KitchenActivityNoEventReason = 1
        gt 'KitchenLookReturnToKitchen'
    end

    gs 'KitchenActivityTryStoryEvents'

    if KitchenActivityStoryStarted = 1:
        gs 'KitchenLookRegister'
        KitchenLookLastResult = 2
        exit
    end

    KitchenHarassmentStarted = 0
    gs 'KitchenHarassmentTry', 'Kitchen'

    if KitchenHarassmentStarted = 1:
        gs 'KitchenLookRegister'
        KitchenLookLastResult = 3
        exit
    end

    gs 'KitchenLookTryRareBonusEvents'

    if KitchenLookRareEventStarted = 1:
        KitchenLookLastResult = 6
        exit
    end

    KitchenActivityNoEventReason = 4

    gt 'KitchenLookReturnToKitchen'
---

! ================================================
! FILE: modules/locations/tavern/kitchen_activity.qsps
! Редкий бонус: конфликт на кухне (не тратит лимит осмотра)
! ================================================

#KitchenLookTryRareBonusEvents
    KitchenLookRareEventStarted = 0

    if KitchenLookRareChance <= 0:
        KitchenLookRareChance = 12
    end

    KitchenLookRareRoll = RAND(1, 100)

    if KitchenLookRareRoll > KitchenLookRareChance:
        exit
    end

    KitchenLookRarePick = RAND(1, 100)

    ! v2: kitchen-lewd auto выкл (HallLewdAutoDisabled); иначе customer
    if HallLewdAutoDisabled <> 1 and KitchenLookRarePick <= 55 and LOC('KitchenLewdSandraCanStart') = 1:
        gs 'KitchenLewdSandraCanStart'

        if KitchenLewdSandraCanStart = 1:
            KitchenLookRareEventStarted = 1
            gt 'KitchenLewdSandraStart', 'Kitchen'
        end
    end

    if KitchenLookRareEventStarted = 0 and LOC('KitchenCustomerEventCanStart') = 1:
        gs 'KitchenCustomerEventCanStart'

        if KitchenCustomerEventCanStart = 1:
            KitchenLookRareEventStarted = 1
            gt 'KitchenCustomerEventStart', $KitchenCustomerSelectedGirl, 'Kitchen'
        end
    end

    killvar 'KitchenLookRarePick'
---

! ================================================
! FILE: modules/locations/tavern/kitchen_activity.qsps
! Проверка сюжетных событий кухни (приоритет, хук на будущее)
! ================================================

#KitchenActivityTryStoryEvents
    KitchenActivityStoryStarted = 0
---