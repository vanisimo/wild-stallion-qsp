! ================================================
! FILE: modules/locations/tavern_main.qsps
! Главный зал трактира
! Версия: v11 / ночью без девушек и без work-фото
! Назначение:
! - кнопка Осмотреть зал теперь идёт через tavern_hall_activity.qsps
! - кнопка Встать за стойку тоже идёт через общий activity-wrapper
! - старые локаторы TavernMainLookHall и TavernMainBarWork сохранены для совместимости
! ================================================

#TavernMain
    *clr
    clr
    cla

    TavernMainWorkLookMode = 0
    $TavernMainResolvedImageMode = ''

    if TavernMainImageModeCode = 1:
        TavernMainWorkLookMode = 1
        $TavernMainResolvedImageMode = 'work'
        TavernMainImageModeCode = 0
    elseif TavernMainImageModeCode = 2:
        $TavernMainResolvedImageMode = 'hall'
        TavernMainImageModeCode = 0
    else:
        $TavernMainIncomingImageMode = LCASE($ARGS[0])

        if $TavernMainIncomingImageMode = 'work':
            TavernMainWorkLookMode = 1
            $TavernMainResolvedImageMode = 'work'
        elseif $TavernMainIncomingImageMode = 'hall':
            $TavernMainResolvedImageMode = 'hall'
        end

        killvar '$TavernMainIncomingImageMode'
    end

    if TavernMainWorkLookMode = 1:
        gs 'TavernHallLookBuildNoEventMessage'
    end

    gs 'AddGlobalButtons'
    gs 'IsTavernOpen'
    gs 'UpdateGirlLocations'
    gs 'AmandaLizaTalkPrepareHallVisit'
    gs 'GetCitySchedulePhase'
    if LOC('TavernStageCheckState') = 1:
        gs 'TavernStageCheckState'
    end

    if time = 5 and LOC('FamilyCouncilCanStart') = 1:
        gs 'FamilyCouncilCanStart'

        if FamilyCouncilCanStart = 1:
            gt 'FamilyCouncilScreen', 1
        end
    end

    TavernMainOpen = TavernOpen
    $TavernMainClosedReason = $TavernClosedReason

    gs 'ShowLocationScreenTitle', 'ТРАКТИР "ДИКИЙ ЖЕРЕБЕЦ"'
    gs 'TavernMainShowLocationImage'

    gs 'FamilyFirstSexMorningTryShow'
    gs 'AmandaLegareAfterDanceMorningTryShow'

    if TavernMainOpen = 1 and time <> 5:
        ! Сандра: клиент на кухню — авто enter hall
        ! (до liberation: только harass + меню «Защитить»; missing — после ужина)
        if TavernMainWorkLookMode = 0 and LOC('SandraKitchenNoticeTry') = 1:
            gs 'SandraKitchenNoticeTry'
            if SandraKitchenNoticeStarted = 1:
                gt 'SandraKitchenNotice'
            end
        end

        gs 'SparkQueueOfferHallOnEnter'

        if $SparkQueueHallNotice <> '':
            *pl ' '
            gs 'PrintMainP', $SparkQueueHallNotice
            *pl ' '
        end
    end

    TavernHallLookMessageShown = 0

    if $TavernHallLookMessage <> '':
        TavernHallLookMessageShown = 1
        *pl ' '
        gs 'PrintMainP', $TavernHallLookMessage
        *pl ' '
        killvar '$TavernHallLookMessage'
    end

    if TavernMainOpen = 1:
        gs 'PrintMainLine', 'Статус: открыто'
    else:
        gs 'PrintMainLine', 'Статус: закрыто'
        gs 'PrintMainLine', $TavernMainClosedReason
    end

    *pl ' '

    if TavernMainWorkLookMode = 0:
        gs 'TavernMainPrintHallDescription'
    end

    *pl ' '

    ! ====================== ДЕВУШКИ В ГЛАВНОМ ЗАЛЕ ======================

    if time <> 5:
        LocationGirlShown = 0

        if TavernMainOpen = 1:
            gs 'PrintMainLine', 'В зале сейчас:'
            *pl ' '

            gs 'ShowGirlInLocation', 'sandra', 'TavernMain'
            gs 'ShowGirlInLocation', 'melissa', 'TavernMain'
            gs 'ShowGirlInLocation', 'amanda', 'TavernMain'

            if AmandaAtPortShip = 1:
                gs 'AmandaPortShipHintText', 'hall_note'
                *pl '<i>' + $AmandaPortShipHintText + '</i>'
                killvar '$AmandaPortShipHintText'
            end

            if LocationGirlShown = 0 and AmandaAtPortShip = 0:
                gs 'PrintMainLine', 'Сейчас в зале нет никого из девушек.'
            end

            if TavernStageWorking = 1 and $TavernStagePerformer <> '':
                *pl 'На сцене: менестрель ' + $TavernStagePerformer + ' развлекает публику песнями и игрой на лютне.'
            end
        else:
            if week = 7 and time = 1:
                gs 'PrintMainLine', 'Воскресное утро: Сандра повязала праздничный платок и перед уходом напомнила, что вся семья идёт на утреннюю службу к отцу Герхарду в собор Ильматера.'
            else:
                gs 'PrintMainLine', 'Девушки не работают в зале, пока таверна закрыта.'
            end
        end

        killvar 'LocationGirlShown'
    end

    *pl ' '

    if debug = 1:
        gs 'TavernHallLookCheckLimit'
        gs 'TavernHallLookGetKey'
        *pl '[DEBUG TAVERN MAIN] TavernMain v11 time: ' + STR(time)
        *pl '[DEBUG TAVERN MAIN] look message shown: ' + IIF(TavernHallLookMessageShown = 1, 'yes', 'no')
        *pl '[DEBUG TAVERN MAIN] look remaining: ' + STR(TavernHallLookRemaining) + ' / ' + STR(TavernHallLookMaxPerPart)
        *pl '[DEBUG TAVERN MAIN] look key: ' + $TavernHallLookKey + ' used: ' + STR(TavernHallLookCount[$TavernHallLookKey])
        *pl '[DEBUG TAVERN MAIN] last look result: ' + STR(TavernHallLookLastResult) + ' (1=work 2=story 3=harass 5=limit 6=bonus)'
        *pl '[DEBUG TAVERN MAIN] image mode: ' + $TavernHallLookLastImageMode + ' work look: ' + STR(TavernMainWorkLookMode)

        if TavernHallLookLastResult = 1:
            *pl '[DEBUG TAVERN MAIN] итог: обычный осмотр — work-фото и текст.'
        elseif TavernHallLookLastResult = 2:
            *pl '[DEBUG TAVERN MAIN] итог: сюжетное событие — work-фото на этот клик не показывается.'
        elseif TavernHallLookLastResult = 3:
            *pl '[DEBUG TAVERN MAIN] итог: приставание — work-фото на этот клик не показывается.'
        elseif TavernHallLookLastResult = 6:
            *pl '[DEBUG TAVERN MAIN] итог: бонус (пропажа/пошлое) — лимит не потрачен, work-фото на этот клик нет.'
        elseif TavernHallLookLastResult = 5:
            *pl '[DEBUG TAVERN MAIN] итог: лимит исчерпан — серая кнопка, только фон зала.'
        end
        killvar 'TavernHallLookMessageShown'
        *pl '[DEBUG TAVERN MAIN] AmandaLegareMajorRiskReady: ' + STR(AmandaLegareMajorRiskReady)
        *pl '[DEBUG TAVERN MAIN] AmandaLegareSecondMeetReady: ' + STR(AmandaLegareSecondMeetReady)
        *pl '[DEBUG TAVERN MAIN] AmandaLegareOutsideWallReady: ' + STR(AmandaLegareOutsideWallReady)
        *pl '[DEBUG TAVERN MAIN] AmandaLegareNextRiskReady: ' + STR(AmandaLegareNextRiskReady)
        *pl '[DEBUG TAVERN MAIN] AmandaLegareOutsideMeetReady: ' + STR(AmandaLegareOutsideMeetReady)
        *pl '[DEBUG TAVERN MAIN] week: ' + STR(week) + ' day: ' + STR(day) + ' phase: ' + $CitySchedulePhase
        *pl '[DEBUG TAVERN MAIN] sandra loc=' + $GirlLocation['sandra'] + ' k=' + STR(jobkitchen['sandra']) + ' w=' + STR(jobwaitress['sandra'])
        *pl '[DEBUG TAVERN MAIN] melissa loc=' + $GirlLocation['melissa'] + ' k=' + STR(jobkitchen['melissa']) + ' w=' + STR(jobwaitress['melissa'])
        *pl '[DEBUG TAVERN MAIN] amanda loc=' + $GirlLocation['amanda'] + ' k=' + STR(jobkitchen['amanda']) + ' w=' + STR(jobwaitress['amanda'])
        *pl ' '
    end

    ! ====================== ДЕЙСТВИЯ В ГЛАВНОМ ЗАЛЕ ======================
    ! Искра AFK — через обычный «Осмотреть зал», без отдельной кнопки.

    gs 'ActUiPrepare', 'Работать за стойкой', 'work'
    act $ActUiLabel, $ActUiIconPath:
        gt 'TavernHallActivityStart', 'work'
    end

    gs 'TavernHallAddLookButton'
    gs 'TavernHallAddWaitButton'

    if TavernUpgradeStageDone = 1 and TavernMainOpen = 1:
        if TavernStageWorking = 1:
            gs 'ActUiPrepare', 'Подойти к сцене', 'dance'
            act $ActUiLabel, $ActUiIconPath:
                gt 'TavernMusicStage'
            end
        else:
            gs 'ActUiPrepare', 'Осмотреть сцену', 'look'
            act $ActUiLabel, $ActUiIconPath:
                gt 'TavernMusicStage'
            end
        end
    end

    if PlayerIsNoble = 1 and FamilyNobleCelebrationDone = 0:
        gs 'ActUiPrepare', 'Праздничный ужин: объявить о дворянстве семье', 'policy'
        act $ActUiLabel, $ActUiIconPath:
            gt 'FamilyNobleDinnerCelebration'
        end
    end

    if StefanWearingNobleSuit = 1:
        gs 'ActUiPrepare', 'Снять дворянский наряд (убрать в шкаф)', 'return'
        act $ActUiLabel, $ActUiIconPath:
            gt 'StefanNobleTourFinish'
        end
    end

    ! ====================== ПЕРЕХОДЫ ======================

    act '<b>Второй этаж</b>', 'images/common/ui/actions/floor.png':
        gt 'TavernSecondFloor'
    end

    act '<b>Кухня</b>', 'images/common/ui/actions/kitchen.png':
        if LOC('Kitchen') = 1:
            gt 'Kitchen'
        else:
            msg 'Локация "Kitchen" пока не найдена.'
        end
    end

    act '<b>Улица Трипербан</b>', 'images/common/ui/actions/street.png':
        if LOC('Street') = 1:
            gt 'Street'
        else:
            msg 'Локация "Street" пока не найдена.'
        end
    end

    killvar 'TavernMainOpen'
    killvar '$TavernMainClosedReason'
    killvar 'TavernMainWorkLookMode'
    killvar '$TavernMainResolvedImageMode'
---

#TavernSecondFloor
    cls

    gs 'AddGlobalButtons'
    gs 'GetDateTimeNames'
    gs 'UpdateGirlLocations'

    gs 'ShowLocationScreenTitle', 'ВТОРОЙ ЭТАЖ ТРАКТИРА'

    gs 'ShowTavernSecondFloorImage'

    *p 'Ты поднимаешься по скрипучей деревянной лестнице на второй этаж трактира.'
    *p 'Здесь заметно тише, чем внизу. Шум главного зала доносится приглушённо, а узкий коридор пахнет старым деревом, тканью и свечным воском.'
    *p 'По обе стороны коридора расположены личные комнаты семьи.'

    *pl ' '

    if time = 1:
        *p 'Утренний свет ложится на половицы, и коридор кажется спокойным и прохладным.'
    elseif time = 5:
        *p 'Ночью второй этаж почти погружён в тишину. За дверями личных комнат слышны только редкие шорохи.'
    else:
        *p 'Днём коридор выглядит простым и обжитым, но основная жизнь всё равно кипит внизу.'
    end

    *pl ' '

    *pl 'Личные комнаты:'
    *pl ' '

    gs 'ShowSecondFloorRoomStatus', 'sandra', 'SandraRoom', 'Комната Сандры'
    gs 'ShowSecondFloorRoomStatus', 'melissa', 'MelissaRoom', 'Комната Мелиссы'
    gs 'ShowSecondFloorRoomStatus', 'amanda', 'AmandaRoom', 'Комната Аманды'

    *pl ' '

    if time = 5 and (sluttiness['melissa'] >= 30 or MelissaNpcPath >= 3 or FamilyCorruptionStage >= 2):
        if (AmandaBrothersMelissaTalkPending = 1 or AmandaMelissaTrainingPending = 1) and AmandaMelissaTrainingStage = 0:
            *pl 'Из приоткрытой двери комнаты Мелиссы слышен взволнованный шёпот Аманды...'
            gs 'ActUiPrepare', 'Подслушать разговор сестёр', 'look'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaMelissaNightTraining'
            end
        elseif AmandaMelissaTrainingStage = 1 and day >= AmandaMelissaNextDay:
            *pl 'Из комнаты Мелиссы снова доносятся голоса — Аманда пришла с уговорами...'
            gs 'ActUiPrepare', 'Подслушать разговор сестёр (уговоры)', 'look'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaMelissaNightTraining'
            end
        elseif AmandaMelissaTrainingStage = 2 and day >= AmandaMelissaNextDay:
            *pl 'В комнате Мелиссы горит свет — сёстры начинают первый урок...'
            gs 'ActUiPrepare', 'Подглядывать за уроком (1-й этап: 3 пальца)', 'look'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaMelissaNightTraining'
            end
        elseif AmandaMelissaTrainingStage = 3 and day >= AmandaMelissaNextDay:
            *pl 'Из комнаты Мелиссы слышны сдавленные вздохи — второй урок подготовки...'
            gs 'ActUiPrepare', 'Подглядывать за уроком (2-й этап: 4 пальца)', 'look'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaMelissaNightTraining'
            end
        elseif AmandaMelissaTrainingStage = 4 and day >= AmandaMelissaNextDay and AmandaWildOilFound = 1:
            *pl 'В комнате Мелиссы мерцает лампа — сёстры собираются применить масло из Диких земель...'
            gs 'ActUiPrepare', 'Подглядывать за уроком (3-й этап: кулак с маслом)', 'look'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaMelissaNightTraining'
            end
        elseif AmandaMelissaTrainingStage = 5 and day >= AmandaMelissaNextDay and AmandaMelissaTrainingDone = 0:
            *pl 'Из комнаты Мелиссы доносятся тихие стоны — сёстры начинают финальный четвёртый урок...'
            gs 'ActUiPrepare', 'Подглядывать за уроком (4-й этап: глубинная растяжка)', 'look'
            act $ActUiLabel, $ActUiIconPath:
                gt 'AmandaMelissaNightTraining'
            end
        end
    end

    if AmandaHomeAnalStage = 2 and time = 5:
        *pl 'Из комнаты Аманды виден узкий луч света от свечи и слышны прерывистые вздохи...'
        gs 'ActUiPrepare', 'Подглядывать в щёлку за тренировкой Аманды', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'AmandaCucumberNightPeepEvent'
        end
    end

    gs 'SundayVisitAmandaLizetteCanEavesdrop'
    if SundayVisitAmandaLizetteCanEavesdrop = 1:
        *pl 'Из-за закрытой двери комнаты Аманды доносятся приглушённые девичьи голоса и смех...'
        gs 'ActUiPrepare', 'Подслушать у двери (Аманда и Лизетта)', 'look'
        act $ActUiLabel, $ActUiIconPath:
            gt 'SundayVisitAmandaLizette'
        end
    end
    killvar 'SundayVisitAmandaLizetteCanEavesdrop'

    act '<b>Комната Стефана</b>', 'images/common/ui/actions/travel.png':
        gt 'PlayerRoom'
    end

    act '<b>Комната Сандры</b>', 'images/common/ui/family.png':
        gt 'SandraRoom'
    end

    act '<b>Комната Мелиссы</b>', 'images/common/ui/family.png':
        gt 'MelissaRoom'
    end

    act '<b>Комната Аманды</b>', 'images/common/ui/family.png':
        gt 'AmandaRoom'
    end

    act '<b>Главный зал</b>', 'images/common/ui/tavern.png':
        gt 'TavernMain'
    end
---

! ================================================
! FILE: modules/locations/tavern_main.qsps
! Описание главного зала по времени суток
! Читает TavernOpen после вызова IsTavernOpen
! Сначала — тексты дневных событий, иначе — базовое описание
! ================================================

#TavernMainShowLocationImage
    $TavernMainImageModeForDraw = LCASE($TavernMainResolvedImageMode)

    if $TavernMainImageModeForDraw = '':
        $TavernMainImageModeForDraw = LCASE($TavernMainImageMode)
    end

    $TavernHallLookLastImageMode = $TavernMainImageModeForDraw

    if $TavernHallLookLastImageMode = '':
        $TavernHallLookLastImageMode = 'default'
    end

    killvar '$TavernMainImageMode'

    if $TavernMainImageModeForDraw = 'work' and time <> 5:
        gs 'ShowTavernHallWorkImage'
    else:
        gs 'TavernMainShowHallBackgroundImage'
    end

    killvar '$TavernMainImageModeForDraw'
---

#TavernMainShowHallBackgroundImage
    if LOC('ShowTavernHallImage') = 1:
        gs 'ShowTavernHallImage'
    elseif LOC('ShowLocationTimeImage') = 1:
        gs 'ShowLocationTimeImage', 'images/locations/tavern/hall', 'jpg'
    elseif LOC('ShowLocationImage') = 1:
        gs 'ShowLocationImage', 'tavern', 'full', 'png'
    end
---

#TavernMainPrintHallDescription
    if TavernOpen = 0:
        gs 'PrintMainLine', 'Главный зал пуст. Столы убраны, в очаге тлеют угли, и только лёгкий серый пепел напоминает о прошедшем дне.'
        exit
    end

    TavernDayEventHallDescPrinted = 0

    if LOC('TavernDayEventPrintHallDescription') = 1:
        gs 'TavernDayEventPrintHallDescription'
    end

    if LOC('TavernDayEventPrintCarryOverHall') = 1:
        gs 'TavernDayEventPrintCarryOverHall'
    end

    if LOC('TavernDayEventPrintCarpenterEveningRepair') = 1:
        gs 'TavernDayEventPrintCarpenterEveningRepair'
    end

    if TavernDayEventHallDescPrinted = 0:
        TavernStageDescPrinted = 0

        if LOC('TavernStagePrintHallDescription') = 1:
            gs 'TavernStagePrintHallDescription'
        end

        if TavernStageDescPrinted = 0:
            gs 'TavernMainBuildDynamicHallDescription'
        end
    end

    if LOC('TavernStagePrintHallNote') = 1:
        gs 'TavernStagePrintHallNote'
    end

    if LOC('FridayStreetClashPrintHallRumor') = 1:
        gs 'FridayStreetClashPrintHallRumor'
    end

    killvar 'TavernDayEventHallDescPrinted'
    killvar 'TavernStageDescPrinted'
---

#TavernMainBuildDynamicHallDescription
    $HallText1 = ''
    $HallText2 = ''

    ! 1. Атмосфера по времени суток и стадии коррупции семьи
    if time = 1:
        if FamilyCorruptionStage >= 4:
            $HallText1 = 'Утренний зал просыпается неспешно. Сквозь пыльные окна падают косые лучи солнца, освещая начисто выскобленные дубовые столы. За стойкой уже мелькают полурасстёгнутые корсажи девушек: утренний холод ничуть не мешает им двигаться свободно и дразняще, выставляя напоказ округлые формы. Первые посетители тянут горячий взвар и украдкой пожирают глазами хозяек.'
        elseif FamilyCorruptionStage >= 2:
            $HallText1 = 'Утро в зале начинается с ровного гула. Столы расставлены по местам, в очаге весело потрескивают сухие дрова. Девушки снуют между стойкой и кухней в лёгких домашних платьях, перешучиваясь и ловя на себе оценивающие взгляды ранних гостей с тракта.'
        else:
            $HallText1 = 'Утро в зале тихое и размеренное. Столы чисто вытерты, в очаге разгорается огонь. Первые посетители неторопливо тянут эль с дороги, грея озябшие руки у пламени и обсуждая городские дела.'
        end

    elseif time = 2:
        if FamilyCorruptionStage >= 4:
            $HallText1 = 'К полудню в зале становится жарко. Торговцы и городские стражники с гомоном занимают лавки, требуя кружек и жадного внимания. Девушки лавируют между столами, покачивая бёдрами в тесных юбках; гости не стесняются тянуть руки и ронять на дубовые доски серебро за лишнюю улыбку.'
        elseif FamilyCorruptionStage >= 2:
            $HallText1 = 'В полуденный час зал оживает на глазах. За столами спорят ремесленники, у стойки звенит медь, подносы мелькают над головами. Взгляды гостей то и дело задерживаются на глубоких вырезах подавальщиц, а смех за дальними столиками звучит всё вольнее.'
        else:
            $HallText1 = 'К полудню зал наполняется деловым шумом. Торговцы и ремесленники заказывают похлёбку и свежий хлеб, степенно переговариваясь у стойки. Работа спорится без суеты — город занят делами, и до хмельного разгула ещё далеко.'
        end

    elseif time = 3:
        if FamilyCorruptionStage >= 4:
            $HallText1 = 'В разгар дня в зале не протолкнуться. За грубыми столами звучат сальные шутки, хриплый смех и звон тяжёлых кружек. Публика разогрета: мужчины жадно следят за каждым наклоном девушек, выставляющих пышную грудь в глубоких декольте. В каждом жесте хозяек сквозит бесстыдная уверенность, а кошельки клиентов пустеют с удвоенной скоростью.'
        elseif FamilyCorruptionStage >= 2:
            $HallText1 = 'Днём зал работает в полную силу. За столами шумно спорят, торгуются и стучат кружками по дубовым столешницам. Девушки ловко лавируют в проходах, отвечая на дерзкие мужские взгляды острыми ухмылками и не давая гостям спуску.'
        else:
            $HallText1 = 'Днём в зале кипит привычная кабацкая работа. Посетители обедают, шумно делятся новостями с тракта и требуют добавки эля. У стойки слышны заказы, с кухни без перебоя подают горячие блюда, а порядок держится под строгим присмотром хозяина.'
        end

    else:
        if FamilyCorruptionStage >= 4:
            $HallText1 = 'Вечером зал погружается в хмельной и чувственный угар. Масляные лампы отбрасывают мягкие тени на разгорячённые лица гостей, кружки стучат без умолку. Девушки чувствуют себя полными хозяйками положения: открытые сорочки едва прикрывают налившуюся плоть, а захмелевшие мужики готовы платить серебром за одно лишь мимолётное прикосновение.'
        elseif FamilyCorruptionStage >= 2:
            $HallText1 = 'Вечер собирает под крышей самую разношёрстную публику. Огни ламп освещают захмелевшие лица, смех звучит громко и раскованно. Завсегдатаи не сводят глаз с подавальщиц, а девушки с дерзкой улыбкой собирают щедрые чаевые.'
        else:
            $HallText1 = 'Вечером зал согревается пламенем очага и неспешными беседами. Лампы мягко освещают лица уставших за день людей. У стойки шумно и оживлённо, но без лишнего буйства — гости наслаждаются отдыхом после трудового дня.'
        end
    end

    ! 2. Ситуация в таверне (скандал, перегрузка, репутация, поломки)
    if TavernScandal >= 45 or TavernLewdFame >= 35:
        $HallText2 = 'По углам то и дело шепчутся, бросая на хозяек масленые взгляды. Пикантная слава трактира разлетелась по всему городу, и многие заходят сюда не ради кружки эля, а в надежде поглазеть на раскованных красавиц.'
    elseif tavern_overload_penalty >= 20 or tavern_work_efficiency < 45:
        $HallText2 = 'Свободных мест за столами почти не осталось — гостей набилось столько, что в проходах приходится протискиваться боком. Девушки едва успевают разносить заказы, а стук кружек сливается в непрерывный гул.'
    elseif tavern_reputation >= 60 and TavernScandal < 25:
        $HallText2 = 'За лучшими столами у окна расположились зажиточные купцы и приличные горожане. Заказы делают щедро, монеты звякают исправно, а зал выглядит респектабельно и солидно.'
    elseif tavern_reputation > 0 and tavern_reputation < 30:
        $HallText2 = 'Публика подобралась хмурая: подозрительные оборванцы и бродяги в пыльных плащах косятся на стойку и подолгу считают каждую медную кроху.'
    elseif TavernRepairNeeded = 1 and TavernRepairOrdered = 0:
        $HallText2 = 'В зале заметны следы недавних потасовок: расшатанные лавки и треснувшие столешницы явно требуют руки мастера.'
    else:
        $HallText2 = 'С кухни доносится звон посуды и уверенные команды Сандры — трактир живёт своим слаженным ритмом.'
    end

    if $HallText1 <> '':
        gs 'PrintMainLine', $HallText1
    end
    if $HallText2 <> '':
        gs 'PrintMainLine', $HallText2
    end

    killvar '$HallText1'
    killvar '$HallText2'
---

! ================================================
! FILE: modules/locations/tavern_main.qsps
! Осмотр зала через wrapper
! ================================================

#TavernMainLookHall
    ! Сначала проверяем сюжетные авто-события Легаре.
    ! Если ни одно событие не сработало, показываем обычный осмотр зала.
    ! Случайные события зала НЕ запускаются здесь.

    if LOC('AmandaLegareMajorRiskCanStart') = 1:
        gs 'AmandaLegareMajorRiskCanStart'

        if AmandaLegareMajorRiskCanStart = 1:
            gt 'AmandaLegareMajorRiskStart', 'TavernMain'
        end
    end

    if LOC('AmandaLegareSecondMeetCanStart') = 1:
        gs 'AmandaLegareSecondMeetCanStart'

        if AmandaLegareSecondMeetCanStart = 1:
            gt 'AmandaLegareSecondMeetStart', 'TavernMain'
        end
    end

    if LOC('AmandaLegareOutsideWallCanStart') = 1:
        gs 'AmandaLegareOutsideWallCanStart'

        if AmandaLegareOutsideWallCanStart = 1:
            gt 'AmandaLegareOutsideWallStart', 'TavernMain'
        end
    end

    if LOC('AmandaLegareTavernVisitCanStart') = 1:
        gs 'AmandaLegareTavernVisitCanStart'

        if AmandaLegareTavernVisitCanStart = 1:
            gt 'AmandaLegareTavernVisitStart', 'TavernMain'
        end
    end

    if LOC('AmandaLegareOutsideMeetCanStart') = 1:
        gs 'AmandaLegareOutsideMeetCanStart'

        if AmandaLegareOutsideMeetCanStart = 1:
            gt 'AmandaLegareOutsideMeetStart', 'TavernMain'
        end
    end

    if LOC('LegareFirstConflictCanStart') = 1:
        gs 'LegareFirstConflictCanStart'

        if LegareFirstConflictCanStart = 1:
            gt 'LegareFirstConflictStart'
        end
    end

    if LOC('AmandaEscapeWorkTryAutoStart') = 1:
        gs 'AmandaEscapeWorkTryAutoStart', 'TavernMain'
    end

    if LOC('LegareSupplyPressureCanStart') = 1:
        gs 'LegareSupplyPressureCanStart'

        if LegareSupplyPressureCanStart = 1:
            gt 'LegareSupplyPressureStart'
        end
    end

    if LOC('LegareClarissaSuspicionCanStart') = 1:
        gs 'LegareClarissaSuspicionCanStart'

        if LegareClarissaSuspicionCanStart = 1:
            gt 'LegareClarissaSuspicionStart'
        end
    end

    if $GirlLocation['amanda'] = 'TavernMain' and LOC('AmandaNeighborBoysTryStart') = 1:
        gs 'AmandaNeighborBoysTryStart'

        if AmandaNeighborBoysStarted = 1:
            exit
        end
    end

    if LOC('AmandaLegareAnalTryStart') = 1:
        gs 'AmandaLegareAnalTryStart', 'TavernMain'

        if AmandaLegareAnalStarted = 1:
            exit
        end
    end

    if $GirlLocation['amanda'] = 'TavernMain' and LOC('AmandaNeighborBoysAnalTryStart') = 1:
        gs 'AmandaNeighborBoysAnalTryStart'

        if AmandaNeighborBoysAnalStarted = 1:
            exit
        end
    end

    gt 'TavernMainLookHallNormal'
---

! ================================================
! FILE: modules/locations/tavern_main.qsps
! Обычный осмотр зала без случайного ивента
! ================================================

#TavernMainLookHallNormal
    *clr
    clr
    cla

    gs 'AddGlobalButtons'
    gs 'GetDateTimeNames'
    gs 'IsTavernOpen'
    gs 'UpdateGirlLocations'

    gs 'ShowLocationScreenTitle', 'ГЛАВНЫЙ ЗАЛ ТРАКТИРА'

    if LOC('ShowTavernHallImage') = 1:
        gs 'ShowTavernHallImage'
    elseif LOC('ShowLocationTimeImage') = 1:
        gs 'ShowLocationTimeImage', 'images/locations/tavern/hall', 'jpg'
    elseif LOC('ShowLocationImage') = 1:
        gs 'ShowLocationImage', 'tavern', 'full', 'png'
    end

    if TavernOpen = 1:
        gs 'PrintMainP', 'Вы некоторое время наблюдаете за залом.'
        gs 'PrintMainP', 'Посетители переговариваются за столами, кто-то требует ещё пива, кто-то спорит о цене вина, а у стойки привычно шумит трактирная жизнь.'
    else:
        gs 'PrintMainP', 'Зал сейчас тихий. Столы убраны, лавки пустуют, и только запах дыма, дерева и вчерашнего пива напоминает, каким шумным это место бывает в рабочие часы.'
    end

    *pl ' '

    LocationGirlShown = 0

    if TavernOpen = 1 and time <> 5:
        gs 'PrintMainLine', 'В зале сейчас:'
        *pl ' '

        gs 'ShowGirlInLocation', 'sandra', 'TavernMain'
        gs 'ShowGirlInLocation', 'melissa', 'TavernMain'
        gs 'ShowGirlInLocation', 'amanda', 'TavernMain'

        if LocationGirlShown = 0:
            gs 'PrintMainP', 'Сейчас в зале нет никого из девушек.'
        end
    elseif TavernOpen = 0:
        gs 'PrintMainP', 'Девушки сейчас не работают в зале.'
    end

    killvar 'LocationGirlShown'

    *pl ' '

    if debug = 1:
        *pl '[DEBUG LOOK HALL] Normal look hall, no random event.'
        *pl ' '
    end

    gs 'TavernHallAddLookButton'
    gs 'TavernHallAddWaitButton'

    act '<b>Главный зал</b>', 'images/common/ui/tavern.png':
        gt 'TavernMain'
    end
---

! ================================================
! FILE: modules/locations/tavern_main.qsps
! Работа за стойкой через wrapper
! ================================================

#TavernMainBarWork
    ! Сначала проверяем сюжетные авто-события Легаре.
    ! Если событий нет, запускаем обычную работу за стойкой.

    if LOC('AmandaLegareMajorRiskCanStart') = 1:
        gs 'AmandaLegareMajorRiskCanStart'

        if AmandaLegareMajorRiskCanStart = 1:
            gt 'AmandaLegareMajorRiskStart', 'TavernMain'
        end
    end

    if LOC('AmandaLegareSecondMeetCanStart') = 1:
        gs 'AmandaLegareSecondMeetCanStart'

        if AmandaLegareSecondMeetCanStart = 1:
            gt 'AmandaLegareSecondMeetStart', 'TavernMain'
        end
    end

    if LOC('AmandaLegareOutsideWallCanStart') = 1:
        gs 'AmandaLegareOutsideWallCanStart'

        if AmandaLegareOutsideWallCanStart = 1:
            gt 'AmandaLegareOutsideWallStart', 'TavernMain'
        end
    end

    if LOC('AmandaLegareTavernVisitCanStart') = 1:
        gs 'AmandaLegareTavernVisitCanStart'

        if AmandaLegareTavernVisitCanStart = 1:
            gt 'AmandaLegareTavernVisitStart', 'TavernMain'
        end
    end

    if LOC('AmandaLegareOutsideMeetCanStart') = 1:
        gs 'AmandaLegareOutsideMeetCanStart'

        if AmandaLegareOutsideMeetCanStart = 1:
            gt 'AmandaLegareOutsideMeetStart', 'TavernMain'
        end
    end

    if LOC('AmandaEscapeWorkTryAutoStart') = 1:
        gs 'AmandaEscapeWorkTryAutoStart', 'TavernMain'
    end

    gt 'TavernBarWorkStart'
---

