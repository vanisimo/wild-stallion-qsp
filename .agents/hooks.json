{
  "qsp-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pre_edit_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "qsp-post-turn-validator": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python hooks/stop_qsp_check.py",
        "timeout": 15
      }
    ]
  }
}
