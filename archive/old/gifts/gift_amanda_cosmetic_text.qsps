! ================================================
! FILE: modules/core/gifts/gift_amanda_cosmetic_text.qsps
! MODULE: core/gifts
! Косметика для Аманды — карточки лавки и реплики при дарении
! ================================================

#GiftAmandaCosmeticCardText
    $GiftCosmeticCardId = LCASE($ARGS[0])
    $GiftCosmeticCardText = ''

    if $GiftCosmeticCardId = 'pearl_lip_gloss':
        $GiftCosmeticCardText = '<b>Жемчужный блеск для губ</b>'
        $GiftCosmeticCardText += '<br><br>Столичная пудра с перламутром. На этикетке обещают: губы блестят, как у куртизанок дворца, а поцелуй оставляет сладкий след на коже мужчины.'
    elseif $GiftCosmeticCardId = 'rouge_sin_berries':
        $GiftCosmeticCardText = '<b>Румяна «Ягоды греха»</b>'
        $GiftCosmeticCardText += '<br><br>Порошок из ягод, собранных на закате у виноградников. Пахнет сладко и пьяняще; щёки горят раньше, чем вино дойдёт до губ.'
    elseif $GiftCosmeticCardId = 'musk_eyelash_dye':
        $GiftCosmeticCardText = '<b>Краска для ресниц с мускусом</b>'
        $GiftCosmeticCardText += '<br><br>Тёмная смесь с каплей мускуса. Взгляд становится тяжелее; торговец шепчет, что мужчины забывают, зачем пришли в зал.'
    elseif $GiftCosmeticCardId = 'silk_body_powder':
        $GiftCosmeticCardText = '<b>Шёлковая пудра для тела</b>'
        $GiftCosmeticCardText += '<br><br>Мелкая пудра, скользкая на коже. Оставляет шелест при движении; для тех, кто хочет, чтобы рука соскальзывала, а не цеплялась за лён.'
    elseif $GiftCosmeticCardId = 'nymph_bath_oil':
        $GiftCosmeticCardText = '<b>Масло для ванны «Нимфа у причала»</b>'
        $GiftCosmeticCardText += '<br><br>Масло с солью и цветами порта. В тёплой воде кожа розовеет; на карточке намёк, что после ванны не хочется одеваться.'
    elseif $GiftCosmeticCardId = 'mirror_kiss_balm':
        $GiftCosmeticCardText = '<b>Бальзам для поцелуев у зеркала</b>'
        $GiftCosmeticCardText += '<br><br>Блестящий бальзам с мятой и медом. Губы сияют в зеркальце; продавец клянётся, что один поцелуй запоминается дольше танца.'
    end

    killvar '$GiftCosmeticCardId'
---

#GiftAmandaCosmeticReactionText
    $GiftCosmeticReactionId = LCASE($ARGS[0])
    $GiftReactionText = ''

    if $GiftCosmeticReactionId = 'pearl_lip_gloss':
        $GiftReactionText = 'Аманда выдавливает каплю на палец, проводит по губе и смотрит в зеркало.<br><br>— Ох… блестит, как у столицы.'
        $GiftReactionText += '<br><br>Облизывает губу и усмехается:<br><br>— Стефан, ты хотел, чтобы в зале смотрели? Получишь. Только не думай, что купил меня… хотя почти.'
    elseif $GiftCosmeticReactionId = 'rouge_sin_berries':
        $GiftReactionText = 'Аманда открывает коробочку, принюхивается и сразу краснеет сильнее, чем от румян.<br><br>— Пахнет так, что стыдно ещё до зеркала.'
        $GiftReactionText += '<br><br>Наносит на щёку, кивает себе:<br><br>— Легаре бы одобрил. А я — для зала. Спасибо. Этикетку в комнате не вешай.'
    elseif $GiftCosmeticReactionId = 'musk_eyelash_dye':
        $GiftReactionText = 'Аманда красит ресницы, моргает, смотрит на вас снизу вверх.<br><br>— Глаза как у портовых кошек, да?'
        $GiftReactionText += '<br><br>Хихикает:<br><br>— Мелисса скажет — слишком. А клиенты всё равно не отведут. Ладно, спасибо. Опасная вещь.'
    elseif $GiftCosmeticReactionId = 'silk_body_powder':
        $GiftReactionText = 'Аманда посыпает кисть, проводит по запястью — кожа блестит.<br><br>— Шёлк на теле… для кого ты это покупал, Стефан?'
        $GiftReactionText += '<br><br>Прячет коробку в комнату:<br><br>— Маме не показывай. Спасибо. Буду носить там, где зал не видит.'
    elseif $GiftCosmeticReactionId = 'nymph_bath_oil':
        $GiftReactionText = 'Аманда откупоривает, вдыхает и на секунду закрывает глаза.<br><br>— Хочу ванну. Сегодня вечером. Одна…'
        $GiftReactionText += '<br><br>Смотрит на вас с двусмысленной улыбкой:<br><br>— …Ладно, может и не одна. Спасибо. Запах — как у корабля, только для кожи.'
    elseif $GiftCosmeticReactionId = 'mirror_kiss_balm':
        $GiftReactionText = 'Аманда мажет губы перед зеркалом и задерживает взгляд.<br><br>— Блестят — будто уже целовалась.'
        $GiftReactionText += '<br><br>Щёлкает баночкой:<br><br>— Опасная штука, Стефан. Спасибо. Только не спрашивай потом, кого я пробовала на вкус.'
    end

    killvar '$GiftCosmeticReactionId'
---