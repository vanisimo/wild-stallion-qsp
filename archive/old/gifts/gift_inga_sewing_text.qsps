! ================================================
! FILE: modules/core/gifts/gift_inga_sewing_text.qsps
! MODULE: core/gifts
! Шитьё для Инги — карточки лавки и реплики при дарении
! ================================================

#GiftIngaSewingCardText
    $GiftSewingCardId = LCASE($ARGS[0])
    $GiftSewingCardText = ''

    if $GiftSewingCardId = 'golden_thread_spool':
        $GiftSewingCardText = '<b>Моток золотой нити</b>'
        $GiftSewingCardText += '<br><br>Нить с настоящей позолотой. Для воротника, который блестит при свечах; на карточке — «королевский шов для тайного платья».'
    elseif $GiftSewingCardId = 'lace_collar_pattern':
        $GiftSewingCardText = '<b>Выкройка кружевного воротника</b>'
        $GiftSewingCardText += '<br><br>Тонкий рисунок на пергаменте. Кружево обвивает шею; продавец шепчет, что под таким воротником хочется наклониться ближе.'
    elseif $GiftSewingCardId = 'hidden_pocket_kit':
        $GiftSewingCardText = '<b>Набор для потайных карманов</b>'
        $GiftSewingCardText += '<br><br>Иглы, нитки и схема кармана в подоле. Для писем, монет или «того, что нельзя показывать матери».'
    elseif $GiftSewingCardId = 'dance_hem_weights':
        $GiftSewingCardText = '<b>Грузы для подола танцевального платья</b>'
        $GiftSewingCardText += '<br><br>Свинцовые капсулы в тканевых мешочках. Подол не взлетает на ветру; на площади движения становятся медленнее и… заметнее.'
    elseif $GiftSewingCardId = 'silk_lining_roll':
        $GiftSewingCardText = '<b>Отрез шёлковой подкладки</b>'
        $GiftSewingCardText += '<br><br>Шёлк скользит по коже. Для платья, которое шуршит при ходьбе и не терпит грубого белья под собой.'
    elseif $GiftSewingCardId = 'embroidery_needle_set':
        $GiftSewingCardText = '<b>Набор игл для вышивки</b>'
        $GiftSewingCardText += '<br><br>Тонкие иглы и пяльцы. Для монограмм на белье или для узоров, которые видишь только при свечах в спальне.'
    end

    killvar '$GiftSewingCardId'
---

#GiftIngaSewingReactionText
    $GiftSewingReactionId = LCASE($ARGS[0])
    $GiftReactionText = ''

    if $GiftSewingReactionId = 'golden_thread_spool':
        $GiftReactionText = 'Инга проводит нитью между пальцами, глаза загораются — и тут же гаснут от смущения.<br><br>— Золото… для воротника, который мама не одобрит.'
        $GiftReactionText += '<br><br>Прячет моток в ладонь:<br><br>— Спасибо, Стефан. Только не спрашивай, куда я это пришью.'
    elseif $GiftSewingReactionId = 'lace_collar_pattern':
        $GiftReactionText = 'Инга разворачивает выкройку и замирает.<br><br>— Кружево… Ирма бы сшила лучше, но… красиво.'
        $GiftReactionText += '<br><br>Складывает аккуратно:<br><br>— Буду шить по вечерам. Спасибо. Не при всех показывай.'
    elseif $GiftSewingReactionId = 'hidden_pocket_kit':
        $GiftReactionText = 'Инга открывает набор и краснеет сильнее, чем от нити.<br><br>— Потайной карман… для чего, Стефан?'
        $GiftReactionText += '<br><br>Отводит взгляд:<br><br>— Ладно. Пригодится. Спасибо. Только не расспрашивай, что туда положу.'
    elseif $GiftSewingReactionId = 'dance_hem_weights':
        $GiftReactionText = 'Инга взвешивает грузики на ладони.<br><br>— Чтобы подол не летал на танцах… Мелисса знает, зачем. Я тоже.'
        $GiftReactionText += '<br><br>Кивает тихо:<br><br>— Полезно. Спасибо. Такие вещи не стыдно показать матери — почти.'
    elseif $GiftSewingReactionId = 'silk_lining_roll':
        $GiftReactionText = 'Инга гладит шёлк — глаза мягче обычного.<br><br>— Мягко… для платья, которое нельзя носить в церкви.'
        $GiftReactionText += '<br><br>Улыбается на секунду:<br><br>— Спасибо. Я запомню. Ты… ты умеешь выбирать не только для зала.'
    elseif $GiftSewingReactionId = 'embroidery_needle_set':
        $GiftReactionText = 'Инга перебирает иглы, выбирает самую тонкую.<br><br>— Буду вышивать по вечерам. Монограммы… или что-то другое.'
        $GiftReactionText += '<br><br>Шепчет:<br><br>— Спасибо. Только не заглядывай в пяльцы без спроса.'
    end

    killvar '$GiftSewingReactionId'
---