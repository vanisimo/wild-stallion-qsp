! ================================================
! FILE: modules/core/gifts/gift_exotic_spice_text.qsps
! MODULE: core/gifts
! Карточки заморских специй и реплики Сандры при дарении
! ================================================

#GiftExoticSpiceCardText
    $GiftSpiceCardId = LCASE($ARGS[0])
    $GiftSpiceCardText = ''

    if $GiftSpiceCardId = 'tentacle_seed_spice':
        $GiftSpiceCardText = '<b>Специи из семян тентаклей</b>'
        $GiftSpiceCardText += '<br><br>Легенда запретных удовольствий с дальних рифов. В горячем блюде семена словно пульсируют — торговец клянётся, что после приёма мужчина держит стояк часами, пока не схватит кошмар.'
    elseif $GiftSpiceCardId = 'mermaid_squirt_salt':
        $GiftSpiceCardText = '<b>Соль из сквирта русалок</b>'
        $GiftSpiceCardText += '<br><br>Кристаллы перламутрового оттенка, пахнут мускусом и «диким морем». На этикетке советуют посолить губы любимой перед поцелуем — и не спрашивать, откуда взялась соль.'
    elseif $GiftSpiceCardId = 'dragon_fire_pepper':
        $GiftSpiceCardText = '<b>Перец «Огненная щель драконихи»</b>'
        $GiftSpiceCardText += '<br><br>Пурпурный порошок из желёз интимной зоны ящера. Продавец шепчет: вход жарким, выход адским. Для кухни — на свой страх и риск.'
    elseif $GiftSpiceCardId = 'harvest_sin_herbs':
        $GiftSpiceCardText = '<b>Травы «Выживший в свальном грехе»</b>'
        $GiftSpiceCardText += '<br><br>Связка после пира урожая: чабер, зверобой, любисток. Склеивает похмелье, возвращает силы — и то, что между ног, тоже.'
    elseif $GiftSpiceCardId = 'naughty_splash_oil':
        $GiftSpiceCardText = '<b>Масло шаловливых брызг</b>'
        $GiftSpiceCardText += '<br><br>Для кухни и для тела. Разогревается от трения, оставляет скользкую текстуру на чувствительной коже. Продавец не уточняет, что именно вы будете смазывать.'
    elseif $GiftSpiceCardId = 'forgotten_caress_essence':
        $GiftSpiceCardText = '<b>Эссенция забытых ласк</b>'
        $GiftSpiceCardText += '<br><br>Уксус вдовьего винограда и слёзы редких цветов. Капля в вино — лёгкая эйфория, остывший брак вспоминает, зачем женились.'
    end

    killvar '$GiftSpiceCardId'
---

#GiftSandraSpiceReactionText
    $GiftSpiceReactionId = LCASE($ARGS[0])
    $GiftReactionText = ''

    if $GiftSpiceReactionId = 'tentacle_seed_spice':
        $GiftReactionText = 'Сандра крутит банку, прищуривается:<br><br>— Это что, шевелится? Фу, Стефан.'
        $GiftReactionText += '<br><br>Нюхает, хмыкает.<br><br>— Пахнет морем и грехом. На вкус... язык немеет, а потом в жар кидает.'
        $GiftReactionText += '<br><br>Суёт банку на полку.<br><br>— Ладно. Для похлёбки с мидиями будет в самый раз. И для тех, кому в постели одного хера мало. Спасибо.'
    elseif $GiftSpiceReactionId = 'mermaid_squirt_salt':
        $GiftReactionText = 'Берёт щепотку, пробует на язык. Молчит долго.<br><br>— Твою ж мать...'
        $GiftReactionText += '<br><br>Облизывает губы.<br><br>— Это не соль. Это похоть в кристаллах.'
        $GiftReactionText += '<br><br>Прячет банку подальше от девчонок.<br><br>— Дорогая, зараза. Но дело своё делает. Мясо с ней — как будто его сам морской чёрт солил. Спасибо, сын. Только Аманде не давай. Она и так от клиентов отбиваться не успевает.'
    elseif $GiftSpiceReactionId = 'dragon_fire_pepper':
        $GiftReactionText = 'Открывает, чихает, матерится.<br><br>— Чтоб тебя, Стефан! Ты решил мне кухню спалить?'
        $GiftReactionText += '<br><br>Смотрит на пурпурный порошок.<br><br>— Пахнет серой и срамом.'
        $GiftReactionText += '<br><br>Тычет пальцем в банку:<br><br>— Этим я буду только на спор кормить. Кто выживет — тот мужик. Кто сдохнет — туда ему дорога.'
        $GiftReactionText += '<br><br>Усмехается:<br><br>— Спасибо. В хозяйстве пригодится. Особенно когда какой-нибудь хлыщ начнёт к дочкам моим лезть. Насыплю ему в кружку.'
    elseif $GiftSpiceReactionId = 'harvest_sin_herbs':
        $GiftReactionText = 'Разворачивает пучок, нюхает, морщится.<br><br>— Пахнет сеновалом, потом и мёдом. Знакомо.'
        $GiftReactionText += '<br><br>Кивает.<br><br>— После праздника урожая я этой дрянью ползала отпаивала. На ноги ставит. И то, что между ног — тоже.'
        $GiftReactionText += '<br><br>Закидывает пучок к остальным травам.<br><br>— Дельная вещь. Спасибо. Хоть не бесполезную дрянь притащил. А то вечно то пудру, то шелка. А тут — для дела.'
    elseif $GiftSpiceReactionId = 'naughty_splash_oil':
        $GiftReactionText = 'Откупоривает, нюхает, брови вверх.<br><br>— Ох ты ж...'
        $GiftReactionText += '<br><br>Растирает каплю между пальцами.<br><br>— Скользкое. И греется само.'
        $GiftReactionText += '<br><br>Смотрит на тебя в упор:<br><br>— Стефан, ты куда это масло тащить собрался? На кухню или к девкам своим?'
        $GiftReactionText += '<br><br>Хмыкает, затыкает пробкой.<br><br>— Ладно. Для рыбы отлично. И для тех, кто рыбу не ловит, но хочет и рыбку съесть и нахер сесть. Спасибо. Только чтоб я вас с этим не застукала.'
    elseif $GiftSpiceReactionId = 'forgotten_caress_essence':
        $GiftReactionText = 'Капает на ложку, пробует кончиком языка. Замирает.<br><br>— Кислятина... а потом...'
        $GiftReactionText += '<br><br>Облизывается, глаза мутнеют на секунду.<br><br>— Тьфу ты. Аж взмокла вся.'
        $GiftReactionText += '<br><br>Ставит пузырёк аккуратно.<br><br>— Этим я буду старый брак лечить. Капну в вино мужу с женой, что друг на друга как на пустое место смотрят. Глядишь, и вспомнят, зачем женились.'
        $GiftReactionText += '<br><br>Кивает тебе:<br><br>— Умный подарок. Редкость. Спасибо, сын.'
    end

    killvar '$GiftSpiceReactionId'
---