! ================================================
! FILE: modules/core/gifts/gift_irma_aromatic_text.qsps
! MODULE: core/gifts
! Ароматика для Ирмы — карточки лавки и реплики при дарении
! ================================================

#GiftIrmaAromaticCardText
    $GiftAromaticCardId = LCASE($ARGS[0])
    $GiftAromaticCardText = ''

    if $GiftAromaticCardId = 'silk_boudoir_sachet':
        $GiftAromaticCardText = '<b>Саше «Шёлковая будуар»</b>'
        $GiftAromaticCardText += '<br><br>Мешочек с лепестками и мускусом для белья и подкладки. Пахнет телом после ванны; на карточке — «один вдох — и платье помнит ночь дольше хозяйки».'
    elseif $GiftAromaticCardId = 'neckline_musk_vial':
        $GiftAromaticCardText = '<b>Флакон мускуса для декольте</b>'
        $GiftAromaticCardText += '<br><br>Капля между ключиц — и кожа теплеет. Торговец шепчет: для воротника, который опускают ниже, чем позволяет церковь.'
    elseif $GiftAromaticCardId = 'linen_sunset_perfume':
        $GiftAromaticCardText = '<b>Духи «Льняной закат»</b>'
        $GiftAromaticCardText += '<br><br>Лёгкий аромат сена, мёда и пота после работы. «Для тех, кто хочет пахнуть деревней — но не девственницей».'
    elseif $GiftAromaticCardId = 'velvet_wrist_tincture':
        $GiftAromaticCardText = '<b>Настойка для запястий на бархате</b>'
        $GiftAromaticCardText += '<br><br>Густая настойка с дубовой смолой. Каплю на внутреннюю сторону запястья — пульс слышнее; для танца, где руку не отпускают.'
    elseif $GiftAromaticCardId = 'hidden_lace_essence':
        $GiftAromaticCardText = '<b>Эссенция «Скрытое кружево»</b>'
        $GiftAromaticCardText += '<br><br>Масло с запахом воска и жасмина. Для подола и корсета; легенда обещает, что ткань «шепчет», когда её снимают.'
    elseif $GiftAromaticCardId = 'midnight_seamstress_oil':
        $GiftAromaticCardText = '<b>Масло «Ночная портниха»</b>'
        $GiftAromaticCardText += '<br><br>Тёплое масло для кожи после долгого шитья. Разогревает пальцы и грудь; на этикетке — «для мастерской, где ночь длиннее, чем метраж».'
    end

    killvar '$GiftAromaticCardId'
---

#GiftIrmaAromaticReactionText
    $GiftAromaticReactionId = LCASE($ARGS[0])
    $GiftReactionText = ''

    if $GiftAromaticReactionId = 'silk_boudoir_sachet':
        $GiftReactionText = 'Ирма нюхает саше и на секунду закрывает глаза.<br><br>— Шёлковая будуар… слишком точное название.'
        $GiftReactionText += '<br><br>Убирает в шкатулку:<br><br>— Положу к подкладке. Клиенты не узнают — а ткань запомнит. Спасибо, Стефан.'
    elseif $GiftAromaticReactionId = 'neckline_musk_vial':
        $GiftReactionText = 'Ирма крутит флакон и смотрит на вас профессионально.<br><br>— Для декольте. Значит, вы уже видите, куда шьёт мода.'
        $GiftReactionText += '<br><br>Тише:<br><br>— Не капну при всех. Спасибо. Это… деловой подарок. Почти.'
    elseif $GiftAromaticReactionId = 'linen_sunset_perfume':
        $GiftReactionText = 'Ирма распыляет каплю на запястье и усмехается.<br><br>— Льняной закат. Пахну деревней, но не девственницей — формулировка смелая.'
        $GiftReactionText += '<br><br>Кивает:<br><br>— Возьму. Для вечера, когда лавка закрыта. Не спрашивай, зачем.'
    elseif $GiftAromaticReactionId = 'velvet_wrist_tincture':
        $GiftReactionText = 'Ирма проверяет пробку и кивает одобрительно.<br><br>— На бархат — на запястье. Танцам и тем, кто держит руку слишком долго.'
        $GiftReactionText += '<br><br>Убирает в ящик:<br><br>— Спасибо. Я не краснею от запахов — я краснею от того, что ты угадал.'
    elseif $GiftAromaticReactionId = 'hidden_lace_essence':
        $GiftReactionText = 'Ирма читает этикетку и тихо смеётся.<br><br>— Скрытое кружево. Моя профессия в одном флаконе.'
        $GiftReactionText += '<br><br>Ставит на полку за тканями:<br><br>— Использую на выкройках… и не только. Спасибо. Без пересказа карточки.'
    elseif $GiftAromaticReactionId = 'midnight_seamstress_oil':
        $GiftReactionText = 'Ирма разогревает каплю на ладони и выдыхает.<br><br>— Ночная портниха. Знакомая должность.'
        $GiftReactionText += '<br><br>Ровно:<br><br>— После закрытия лавки — моё. Спасибо. Ты даришь не украшение — ты даришь передышку.'
    end

    killvar '$GiftAromaticReactionId'
---