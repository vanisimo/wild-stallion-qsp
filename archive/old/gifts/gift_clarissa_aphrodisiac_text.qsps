! ================================================
! FILE: modules/core/gifts/gift_clarissa_aphrodisiac_text.qsps
! MODULE: core/gifts
! Афродизиаки для Клариссы — карточки лавки и реплики при дарении
! ================================================

#GiftClarissaAphrodisiacCardText
    $GiftAphroCardId = LCASE($ARGS[0])
    $GiftAphroCardText = ''

    if $GiftAphroCardId = 'widow_wine_drops':
        $GiftAphroCardText = '<b>Капли «Вдовье терпение»</b>'
        $GiftAphroCardText += '<br><br>Три капли в бокал — и терпение тает. Для женщины, которая слишком долго ждала, пока муж поднимет глаза с молодых.'
    elseif $GiftAphroCardId = 'barrel_musk_tincture':
        $GiftAphroCardText = '<b>Настойка «Мускус бочонка»</b>'
        $GiftAphroCardText += '<br><br>Густая настойка с запахом дуба и тела. Капля на язык — жар в животе; для тех, кто торгуется не только вином.'
    elseif $GiftAphroCardId = 'hidden_desire_candy':
        $GiftAphroCardText = '<b>Леденцы «Скрытое желание»</b>'
        $GiftAphroCardText += '<br><br>Сладкие леденцы с центром из трав. Сначала сахар, потом пульс в висках; не едят у прилавка — на этикетке предупреждение.'
    elseif $GiftAphroCardId = 'married_couple_syrup':
        $GiftAphroCardText = '<b>Сироп «Супруги без сна»</b>'
        $GiftAphroCardText += '<br><br>Густой сироп для вина. Разжигает остывший брак; продавец не спрашивает, чей именно брак вы хотите согреть.'
    elseif $GiftAphroCardId = 'jealousy_root_powder':
        $GiftAphroCardText = '<b>Порошок «Корень ревности»</b>'
        $GiftAphroCardText += '<br><br>Корень, смолотый в пыль. Щепотка в кружку — взгляд острее, ревность слаще; опасный товар для лавки у бочонков.'
    elseif $GiftAphroCardId = 'night_barrel_essence':
        $GiftAphroCardText = '<b>Эссенция «Ночь у бочонков»</b>'
        $GiftAphroCardText += '<br><br>Маслянистая эссенция с дубовой смолой. Пахнет ночной лавкой и телом после закрытия; для тех, кто знает цену тишине.'
    end

    killvar '$GiftAphroCardId'
---

#GiftClarissaAphrodisiacReactionText
    $GiftAphroReactionId = LCASE($ARGS[0])
    $GiftReactionText = ''

    if $GiftAphroReactionId = 'widow_wine_drops':
        $GiftReactionText = 'Кларисса читает этикетку и прячет флакон под прилавок.<br><br>— Вдовье терпение… у меня его и так хватает.'
        $GiftReactionText += '<br><br>Сухая усмешка:<br><br>— Альбер не заметит каплю. А я замечу. Спасибо, Стефан. Не пересказывай карточку вслух.'
    elseif $GiftAphroReactionId = 'barrel_musk_tincture':
        $GiftReactionText = 'Кларисса откупоривает, нюхает — не морщится.<br><br>— Мускус бочонка. Знакомый запах.'
        $GiftReactionText += '<br><br>Ставит в тень:<br><br>— Для клиента, который торгуется телом. Или для ночи, когда длинная. Спасибо.'
    elseif $GiftAphroReactionId = 'hidden_desire_candy':
        $GiftReactionText = 'Кларисса берёт леденец, сосёт, замирает на секунду.<br><br>— Сладко… и потом жар.'
        $GiftReactionText += '<br><br>Отводит глаза:<br><br>— Не у прилавка ем. Спасибо. Вы умеете выбирать без лишнего шума — редкость в этом городе.'
    elseif $GiftAphroReactionId = 'married_couple_syrup':
        $GiftReactionText = 'Кларисса крутит пузырёк и усмехается без радости.<br><br>— Супруги без сна… знакомая песня.'
        $GiftReactionText += '<br><br>Тише:<br><br>— Может, в вино… шучу. Почти. Спасибо. Это даёт мне воздух — и не только в буквальном смысле.'
    elseif $GiftAphroReactionId = 'jealousy_root_powder':
        $GiftReactionText = 'Кларисса не открывает сразу — смотрит на вас.<br><br>— Корень ревности. Опасный товар.'
        $GiftReactionText += '<br><br>Кивает:<br><br>— Ты кому это принёс — мне или Аманде? Ладно. Забираю. Не думай, что я буду носить это у бочонков.'
    elseif $GiftAphroReactionId = 'night_barrel_essence':
        $GiftReactionText = 'Кларисса прячет эссенцию в ящик, будто это не подарок, а товар.<br><br>— Ночь у бочонков — моя профессия.'
        $GiftReactionText += '<br><br>Ровно:<br><br>— Спасибо. Не читай этикетку при Альбере. И не спрашивай, куда капну.'
    end

    killvar '$GiftAphroReactionId'
---