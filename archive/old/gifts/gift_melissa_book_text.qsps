! ================================================
! FILE: modules/core/gifts/gift_melissa_book_text.qsps
! MODULE: core/gifts
! Книги для Мелиссы — карточки лавки и реплики при дарении
! ================================================

#GiftMelissaBookCardText
    $GiftBookCardId = LCASE($ARGS[0])
    $GiftBookCardText = ''

    if $GiftBookCardId = 'maiden_ten_knights_tale':
        $GiftBookCardText = '<b>«Баллада о Деве и Десяти Рыцарских Копьях»</b>'
        $GiftBookCardText += '<br><br>Благородная дева держит осаду в башне. Рыцари по очереди предлагают ей своё «копьё» для защиты. Она выбирает… всех. По очереди. И не только.'
        $GiftBookCardText += '<br><br>Написано высоким стилем: рифма, размер. От содержания краснеют даже стражники.'
    elseif $GiftBookCardId = 'gardener_pear_fable':
        $GiftBookCardText = '<b>«Сказ о Юной Огороднице и Созревших Грушах»</b>'
        $GiftBookCardText += '<br><br>Девушка ухаживает за садом. К ней ходит садовник, пекарь, кузнец. Все «проверяют», созрели ли груши. Проверяют руками. Ртом. Всем.'
        $GiftBookCardText += '<br><br>Вроде сказка. Мораль: «плод надо рвать вовремя» — а то соседи сорвут.'
    elseif $GiftBookCardId = 'stable_lady_romance':
        $GiftBookCardText = '<b>«Трактат о Смазке для Доспехов и Не Только»</b>'
        $GiftBookCardText += '<br><br>Псевдонаучный труд: как ухаживать за латами, чтоб не ржавели — и как ухаживать за телом под латами, чтоб не натёрло. С иллюстрациями. Подробными.'
        $GiftBookCardText += '<br><br>Официально — для оруженосцев. Читают — все.'
    elseif $GiftBookCardId = 'minstrel_thighs_story':
        $GiftBookCardText = '<b>«Сонетник Вдовы-Распутницы»</b>'
        $GiftBookCardText += '<br><br>Сборник сонетов. Вдова оплакивает мужа — по одному сонету на каждого любовника, что пришёл «утешить». Четырнадцать штук: по числу строк в сонете.'
        $GiftBookCardText += '<br><br>Горечь, страсть, метафоры. «Он вошёл в мой дом… и не только в дом».'
    elseif $GiftBookCardId = 'damp_seals_castle_cache':
        $GiftBookCardText = '<b>«Житие Святой Блудницы из Портового Квартала»</b>'
        $GiftBookCardText += '<br><br>Житие как житие: родилась, грешила, раскаялась, творила чудеса. Чудеса — специфические. Исцеляла «немощь мужскую» наложением рук. И не только рук.'
        $GiftBookCardText += '<br><br>Церковь запретила. Поэтому все хотят прочесть.'
    elseif $GiftBookCardId = 'capital_cook_diary':
        $GiftBookCardText = '<b>«Учебник Эльфийской Гимнастики для Гибкости в Браке»</b>'
        $GiftBookCardText += '<br><br>Картинки. Позы. Подписи: «Для зачатия наследника», «Для примирения после ссоры», «Для тихого часа, пока муж на охоте».'
        $GiftBookCardText += '<br><br>Эльфы же. У них всё искусство. Даже это.'
    end

    killvar '$GiftBookCardId'
---

#GiftMelissaBookReactionText
    $GiftBookReactionId = LCASE($ARGS[0])
    $GiftReactionText = ''

    if $GiftBookReactionId = 'maiden_ten_knights_tale':
        $GiftReactionText = 'Мелисса берёт книгу двумя руками — как реликвию.<br><br>Читает название вслух, медленно:<br><br>— «…и Десяти Рыцарских Копьях».'
        $GiftReactionText += '<br><br>Открывает наугад. Глаза бегают по строчкам. На щеках — румянец, но не от стыда. От азарта.<br><br>— Ямб. Хореем. А вот тут… ох.'
        $GiftReactionText += '<br><br>Закрывает, прижимает к груди:<br><br>— Похабщина, Стефан. Талантливая похабщина.'
        $GiftReactionText += '<br><br>Смотрит прямо:<br><br>— Спасибо. За то, что не побоялся мне такое дать. И за то, что думаешь, будто я пойму не только про копья.'
        $GiftReactionText += '<br><br>Уносит. Быстро. Пока Аманда не увидела.'
    elseif $GiftBookReactionId = 'gardener_pear_fable':
        $GiftReactionText = 'Мелисса листает. Находит картинку с «проверкой груш». Замирает.<br><br>— Мораль: «плод надо рвать вовремя»…'
        $GiftReactionText += '<br><br>Хмыкает:<br><br>— А садовников-то сколько. На одну грушу.'
        $GiftReactionText += '<br><br>Поднимает глаза, в них смех:<br><br>— Бедная девочка. Или счастливая?'
        $GiftReactionText += '<br><br>Захлопывает, но палец держит между страниц:<br><br>— Спасибо. За сказку. Злую. Честную. Как жизнь.'
        $GiftReactionText += '<br><br>Тихо:<br><br>— Аманде не дам. Она решит, что это руководство.'
    elseif $GiftBookReactionId = 'stable_lady_romance':
        $GiftReactionText = 'Мелисса открывает. Видит схемы.<br><br>— О. Иллюстрации.'
        $GiftReactionText += '<br><br>Листает дальше. Видит «не только». Замирает.<br><br>— Подробные…'
        $GiftReactionText += '<br><br>Краснеет, но не закрывает. Изучает.<br><br>— Для оруженосцев, значит.'
        $GiftReactionText += '<br><br>Поднимает бровь:<br><br>— У нас в зале такие оруженосцы, что им этот трактат надо вслух читать. По три раза.'
        $GiftReactionText += '<br><br>Откладывает бережно:<br><br>— Спасибо, Стефан. За науку. И за то, что считаешь меня достаточно взрослой для… анатомии.'
        $GiftReactionText += '<br><br>Пауза:<br><br>— Я перерисую пару схем. Для учёта. В зале.'
    elseif $GiftBookReactionId = 'minstrel_thighs_story':
        $GiftReactionText = 'Мелисса читает первый сонет про себя. Губы шевелятся.<br><br>— «Он вошёл в мой дом…».'
        $GiftReactionText += '<br><br>Переворачивает страницу. Второй. Третий.<br><br>— Четырнадцать.'
        $GiftReactionText += '<br><br>Закрывает глаза на секунду:<br><br>— Это не похоть. Это горе. Которое устало быть горем.'
        $GiftReactionText += '<br><br>Открывает глаза. Они влажные. Не от слёз.<br><br>— Рифма безупречна. Боль — настоящая.'
        $GiftReactionText += '<br><br>Прижимает книгу к сердцу:<br><br>— Спасибо. За поэзию. За то, что не побоялся дать мне читать про женщину, а не про деву.'
        $GiftReactionText += '<br><br>Шепчет:<br><br>— Я пойму её. Лучше, чем хотела бы.'
    elseif $GiftBookReactionId = 'damp_seals_castle_cache':
        $GiftReactionText = 'Мелисса читает название.<br><br>— Запрещённая.'
        $GiftReactionText += '<br><br>Открывает. Читает про «чудеса наложением рук».<br><br>— «Исцеляла немощь мужскую»…'
        $GiftReactionText += '<br><br>Фыркает. Но читает дальше. Жадно.<br><br>— Её сожгли? Или канонизировали?'
        $GiftReactionText += '<br><br>Дочитывает страницу. Поднимает взгляд:<br><br>— И то, и другое, да? Сначала используют, потом боятся.'
        $GiftReactionText += '<br><br>Заворачивает книгу в платок:<br><br>— Спасибо. Спрячу. Прочту. Помолюсь за неё. Она заслужила. Больше, чем многие святые.'
    elseif $GiftBookReactionId = 'capital_cook_diary':
        $GiftReactionText = 'Мелисса листает картинки. Лицо — камень. Только уши розовеют.<br><br>— Поза «для зачатия наследника»…'
        $GiftReactionText += '<br><br>Страница.<br><br>— Поза «для примирения после ссоры»…'
        $GiftReactionText += '<br><br>Захлопывает. Смотрит на тебя в упор:<br><br>— Стефан Лонгкок.'
        $GiftReactionText += '<br><br>Пауза.<br><br>— Ты на что намекаешь?'
        $GiftReactionText += '<br><br>Потом — едва заметная улыбка:<br><br>— Эльфы… всё у них искусство. Даже грех.'
        $GiftReactionText += '<br><br>Убирает книгу под мышку:<br><br>— Спасибо. За науку. И за наглость.'
        $GiftReactionText += '<br><br>Уходя, бросает через плечо:<br><br>— Практику будем проводить без свидетелей. Когда-нибудь. Может быть.'
    end

    killvar '$GiftBookReactionId'
---