! ================================================
! FILE: modules/core/gifts/gift_becky_seed_text.qsps
! MODULE: core/gifts
! Семена для Бекки — карточки лавки и реплики при дарении
! ================================================

#GiftBeckySeedCardText
    $GiftSeedCardId = LCASE($ARGS[0])
    $GiftSeedCardText = ''

    if $GiftSeedCardId = 'stallion_cucumber_seeds':
        $GiftSeedCardText = '<b>Семена огурца «Конский ствол»</b>'
        $GiftSeedCardText += '<br><br>Редкий сорт с толстой мякотью и крупной головкой. На пакете шутка: «Растёт быстро, сочный, не для салата одного» — и рисунок, от которого краснеют даже вдовы.'
    elseif $GiftSeedCardId = 'nightshade_tomato_seeds':
        $GiftSeedCardText = '<b>Семена томата «Ночная тень»</b>'
        $GiftSeedCardText += '<br><br>Томат с тёмной кожицей, сладкий внутри. Собирают после заката; говорят, сок оставляет пятна на губах и на простыне.'
    elseif $GiftSeedCardId = 'aphrodisiac_carrot_seeds':
        $GiftSeedCardText = '<b>Семена моркови «Разжигатель»</b>'
        $GiftSeedCardText += '<br><br>Морковь нежная, сладкая, с острым послевкусием. В легенде — «согревает кровь»; для супа или для ночи — продавец не уточняет.'
    elseif $GiftSeedCardId = 'vine_pepper_cuttings':
        $GiftSeedCardText = '<b>Черенки перца «Вьющийся огонь»</b>'
        $GiftSeedCardText += '<br><br>Перец обвивает шест, плоды жгут язык. На этикетке: «Кто не выдержит жара — пусть не лезет к грядке».'
    elseif $GiftSeedCardId = 'garden_knife_set':
        $GiftSeedCardText = '<b>Набор садовых ножей</b>'
        $GiftSeedCardText += '<br><br>Три лезвия в чехле: для овощей, для жёсткой корки и для «особых» ночных дел в огороде. Острые — торговец клянётся.'
    elseif $GiftSeedCardId = 'moon_melon_seeds':
        $GiftSeedCardText = '<b>Семена дыни «Лунная сладость»</b>'
        $GiftSeedCardText += '<br><br>Дыня с мякотью, что тает во рту. Созревает под полной луной; сок липкий, сладкий, пахнет телом после купания.'
    end

    killvar '$GiftSeedCardId'
---

#GiftBeckySeedReactionText
    $GiftSeedReactionId = LCASE($ARGS[0])
    $GiftReactionText = ''

    if $GiftSeedReactionId = 'stallion_cucumber_seeds':
        $GiftReactionText = 'Бекки читает этикетку и ржёт так, что слышно за прилавком.<br><br>— Огурец как у коня? Стефан, ты с ума сошёл?'
        $GiftReactionText += '<br><br>Прижимает пакет к груди:<br><br>— Посажу за лавкой. Если вырастет — Сандра молитву прочитает, а я хохотать буду. Спасибо, милый.'
    elseif $GiftSeedReactionId = 'nightshade_tomato_seeds':
        $GiftReactionText = 'Бекки вертит пакет и подмигивает.<br><br>— Томат ночной… для салата или для задней комнаты?'
        $GiftReactionText += '<br><br>Суёт в фартук:<br><br>— Посажу. Сок, говорят, на губах остаётся. У меня и так губы заняты. Спасибо.'
    elseif $GiftSeedReactionId = 'aphrodisiac_carrot_seeds':
        $GiftReactionText = 'Бекки хихикает и тычет пальцем в рисунок.<br><br>— Морковь-разжигатель. Эдди спросит — скажу, для супа.'
        $GiftReactionText += '<br><br>Кивает:<br><br>— А сама знаю, зачем. Спасибо. Ты хоть иногда думаешь о деле, а не только о девчонках.'
    elseif $GiftSeedReactionId = 'vine_pepper_cuttings':
        $GiftReactionText = 'Бекки нюхает черенок и морщится, но улыбается.<br><br>— Вьющийся огонь. В грядке и… где скажешь.'
        $GiftReactionText += '<br><br>Убирает в ящик:<br><br>— Кто не выдержит жара — пусть не лезет ко мне торговаться. Спасибо, Стефан.'
    elseif $GiftSeedReactionId = 'garden_knife_set':
        $GiftReactionText = 'Бекки вынимает нож, проверяет лезвие и свистит.<br><br>— Острые. Для овощей и для тех, кто жмётся на цене.'
        $GiftReactionText += '<br><br>Обнимает вас одной рукой:<br><br>— Хороший подарок. Практичный. Как я люблю.'
    elseif $GiftSeedReactionId = 'moon_melon_seeds':
        $GiftReactionText = 'Бекки крутит пакет на ладони.<br><br>— Лунная сладость… сладкая ночь, да?'
        $GiftReactionText += '<br><br>Усмехается:<br><br>— Посажу. Если созреет — угощу. Не всех. Спасибо, милый.'
    end

    killvar '$GiftSeedReactionId'
---